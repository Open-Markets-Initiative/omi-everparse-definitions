} MessageHeader;

// ---- Logon: 44 bytes ---------------------------------------------------------

// Client initiates a session by submitting a Logon message
entrypoint typedef struct _Logon {
  UINT8 user_id[20];    // bytes 0 to 19
  UINT8 password[20];   // bytes 20 to 39
  UINT32BE session_id;  // bytes 40 to 43, signed, read here as unsigned
} Logon;

// ---- Logout: 27 bytes --------------------------------------------------------

// Terminate a session by sending a Logout message
entrypoint typedef struct _Logout {
  UINT8 user_id[20];    // bytes 0 to 19
  UINT32BE session_id;  // bytes 20 to 23, signed, read here as unsigned
  UINT8 reason[3];      // bytes 24 to 26
} Logout;

// ---- Heartbeat: 4 bytes ------------------------------------------------------

// Keep-alive ping sent every three seconds; client must respond
entrypoint typedef struct _Heartbeat {
  UINT32BE session_id;  // bytes 0 to 3, signed, read here as unsigned
} Heartbeat;

// ---- Instrument Info Request: 4 bytes ----------------------------------------

// Request list of supported instruments
entrypoint typedef struct _InstrumentInfoRequest {
