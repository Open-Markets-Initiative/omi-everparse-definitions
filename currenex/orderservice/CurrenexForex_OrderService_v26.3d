// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out CurrenexForex_OrderService_v26.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_LOGON 0x41                            // Logon
#define MESSAGE_TYPE_LOGOUT 0x42                           // Logout
#define MESSAGE_TYPE_HEARTBEAT 0x43                        // Heartbeat
#define MESSAGE_TYPE_INSTRUMENT_INFO_REQUEST 0x45          // Instrument Info Request
#define MESSAGE_TYPE_INSTRUMENT_INFO 0x44                  // Instrument Info
#define MESSAGE_TYPE_NEW_ORDER_REQUEST 0x4C                // New Order Request
#define MESSAGE_TYPE_NEW_ORDER_ACK 0x4D                    // New Order Ack
#define MESSAGE_TYPE_ORDER_CANCEL_REQUEST 0x4E             // Order Cancel Request
#define MESSAGE_TYPE_ORDER_CANCEL_REJECT 0x4F              // Order Cancel Reject
#define MESSAGE_TYPE_ORDER_REPLACE_OR_CANCEL_REQUEST 0x50  // Order Replace Or Cancel Request
#define MESSAGE_TYPE_ORDER_REPLACE_OR_CANCEL_ACK 0x51      // Order Replace Or Cancel Ack
#define MESSAGE_TYPE_ORDER_CANCELED_OR_EXPIRED 0x52        // Order Canceled Or Expired
#define MESSAGE_TYPE_TRADE 0x54                            // Trade
#define MESSAGE_TYPE_PENDING_FILL 0x55                     // Pending Fill
#define MESSAGE_TYPE_PENDING_FILL_CANCEL 0x56              // Pending Fill Cancel
#define MESSAGE_TYPE_TRADE_PENDING 0x74                    // Trade Pending
#define MESSAGE_TYPE_RESEND_REQUEST 0x32                   // Resend Request
#define MESSAGE_TYPE_GAP_FILL 0x34                         // Gap Fill

// Instrument Type: one byte code
#define INSTRUMENT_TYPE_FOREIGN_EXCHANGE 0x31  // Foreign Exchange
#define INSTRUMENT_TYPE_CASH_METALS 0x32       // Cash Metals

// Order Type: one byte code
#define ORDER_TYPE_LIMIT 0x46    // Limit
#define ORDER_TYPE_ICEBERG 0x5A  // Iceberg

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Expire Type: one byte code
#define EXPIRE_TYPE_GTC 0x47  // Gtc
#define EXPIRE_TYPE_IOC 0x49  // Ioc

// Ack Status: one byte code
#define ACK_STATUS_REJECTED 0x52   // Rejected
#define ACK_STATUS_CONFIRMED 0x43  // Confirmed

// Status: one byte code
#define STATUS_REJECTED 0x52   // Rejected
#define STATUS_REPLACED 0x50   // Replaced
#define STATUS_CANCELLED 0x43  // Cancelled
#define STATUS_EXPIRED 0x45    // Expired

// Type: 2 byte code
#define TYPE_USER 0x0000       // User
#define TYPE_SYSTEM 0x0001     // System
#define TYPE_BELOW_MIN 0x0002  // Below Min

// Exec Type: one byte code
#define EXEC_TYPE_NEW_TRADE 0x31  // New Trade

// Aggressor Flag: one byte code
#define AGGRESSOR_FLAG_AGGRESSOR 0x31      // Aggressor
#define AGGRESSOR_FLAG_NOT_AGGRESSOR 0x32  // Not Aggressor

// Reason Code: one byte code
#define REASON_CODE_NOT_RESENDABLE 0x31  // Not Resendable
#define REASON_CODE_NOT_AVAILABLE 0x32   // Not Available

// ---- Types -------------------------------------------------------------------

// Client initiates a session by submitting a Logon message
typedef struct _Logon {
  UINT8 user_id[20];    // bytes 0 to 19
  UINT8 password[20];   // bytes 20 to 39
  UINT32BE session_id;  // bytes 40 to 43, signed, read here as unsigned
} Logon;

// Terminate a session by sending a Logout message
typedef struct _Logout {
  UINT8 user_id[20];    // bytes 0 to 19
  UINT32BE session_id;  // bytes 20 to 23, signed, read here as unsigned
  UINT8 reason[3];      // bytes 24 to 26
} Logout;

// Keep-alive ping sent every three seconds; client must respond
typedef struct _Heartbeat {
  UINT32BE session_id;  // bytes 0 to 3, signed, read here as unsigned
} Heartbeat;

// Request list of supported instruments
typedef struct _InstrumentInfoRequest {
  UINT32BE session_id;  // bytes 0 to 3, signed, read here as unsigned
} InstrumentInfoRequest;

// Definition of a currency or metal instrument
typedef struct _InstrumentInfo {
  UINT32BE session_id;        // bytes 0 to 3, signed, read here as unsigned
  UINT16BE instrument_index;  // bytes 4 to 5, signed, read here as unsigned
  UINT8 instrument_type;      // byte 6
  UINT8 instrument_id[20];    // bytes 7 to 26
  UINT64BE settlement_date;   // bytes 27 to 34, signed, read here as unsigned
} InstrumentInfo;

// Submit a new order request
typedef struct _NewOrderRequest {
  UINT32BE cl_order_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 order_type;           // byte 4
  UINT16BE instrument_index;  // bytes 5 to 6, signed, read here as unsigned
  UINT8 side;                 // byte 7
  UINT64BE order_amt;         // bytes 8 to 15, signed, read here as unsigned
  UINT64BE min_amt;           // bytes 16 to 23, signed, read here as unsigned
  UINT32BE price;             // bytes 24 to 27, signed, read here as unsigned
  UINT64BE show_amt;          // bytes 28 to 35, signed, read here as unsigned
  UINT8 expire_type;          // byte 36
} NewOrderRequest;

// Acknowledge new order
typedef struct _NewOrderAck {
  UINT32BE cl_order_id;  // bytes 0 to 3, signed, read here as unsigned
  UINT64BE order_id;     // bytes 4 to 11, signed, read here as unsigned
  UINT8 ack_status;      // byte 12
  UINT16BE error_code;   // bytes 13 to 14, signed, read here as unsigned
} NewOrderAck;

// Request cancellation of an order
typedef struct _OrderCancelRequest {
  UINT32BE new_cl_order_id;   // bytes 0 to 3, signed, read here as unsigned
  UINT32BE prev_cl_order_id;  // bytes 4 to 7, signed, read here as unsigned
  UINT16BE instrument_index;  // bytes 8 to 9, signed, read here as unsigned
} OrderCancelRequest;

// Rejection of Order Cancel Request
typedef struct _OrderCancelReject {
  UINT32BE new_cl_order_id;   // bytes 0 to 3, signed, read here as unsigned
  UINT32BE prev_cl_order_id;  // bytes 4 to 7, signed, read here as unsigned
  UINT16BE error_code;        // bytes 8 to 9, signed, read here as unsigned
} OrderCancelReject;

// Replace or cancel an order
typedef struct _OrderReplaceOrCancelRequest {
  UINT32BE new_cl_order_id;   // bytes 0 to 3, signed, read here as unsigned
  UINT32BE orig_cl_order_id;  // bytes 4 to 7, signed, read here as unsigned
  UINT64BE order_amt;         // bytes 8 to 15, signed, read here as unsigned
  UINT32BE price;             // bytes 16 to 19, signed, read here as unsigned
  UINT16BE instrument_index;  // bytes 20 to 21, signed, read here as unsigned
} OrderReplaceOrCancelRequest;

// Acknowledge replace/cancel
typedef struct _OrderReplaceOrCancelAck {
  UINT32BE new_cl_order_id;   // bytes 0 to 3, signed, read here as unsigned
  UINT32BE prev_cl_order_id;  // bytes 4 to 7, signed, read here as unsigned
  UINT8 status;               // byte 8
  UINT16BE error_code;        // bytes 9 to 10, signed, read here as unsigned
} OrderReplaceOrCancelAck;

// Unsolicited cancellation/expiry notice
typedef struct _OrderCanceledOrExpired {
  UINT32BE cl_order_id;  // bytes 0 to 3, signed, read here as unsigned
  UINT64BE order_id;     // bytes 4 to 11, signed, read here as unsigned
  UINT8 status;          // byte 12
  UINT16BE type_;        // bytes 13 to 14, signed, read here as unsigned
} OrderCanceledOrExpired;

// Trade execution notification
typedef struct _Trade {
  UINT32BE cl_order_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT64BE order_id;          // bytes 4 to 11, signed, read here as unsigned
  UINT16BE instrument_index;  // bytes 12 to 13, signed, read here as unsigned
  UINT8 side;                 // byte 14
  UINT64BE fill_amt;          // bytes 15 to 22, signed, read here as unsigned
  UINT32BE fill_rate;         // bytes 23 to 26, signed, read here as unsigned
  UINT8 exec_broker[4];       // bytes 27 to 30
  UINT8 execution_id[20];     // bytes 31 to 50
  UINT8 exec_type;            // byte 51
  UINT64BE settle_date;       // bytes 52 to 59, signed, read here as unsigned
  UINT64BE trade_date;        // bytes 60 to 67, signed, read here as unsigned
  UINT64BE transact_time;     // bytes 68 to 75, signed, read here as unsigned
  UINT64BE leaves_amt;        // bytes 76 to 83, signed, read here as unsigned
  UINT8 aggressor_flag;       // byte 84
} Trade;

// Notification of expected fill
typedef struct _PendingFill {
  UINT32BE cl_order_id;    // bytes 0 to 3, signed, read here as unsigned
  UINT64BE order_id;       // bytes 4 to 11, signed, read here as unsigned
  UINT32BE trade_link_id;  // bytes 12 to 15, signed, read here as unsigned
  UINT64BE fill_amt;       // bytes 16 to 23, signed, read here as unsigned
  UINT32BE fill_rate;      // bytes 24 to 27, signed, read here as unsigned
  UINT8 aggressor_flag;    // byte 28
  UINT8 exec_broker[4];    // bytes 29 to 32
} PendingFill;

// Notification of pending fill cancellation
typedef struct _PendingFillCancel {
  UINT32BE cl_order_id;    // bytes 0 to 3, signed, read here as unsigned
  UINT64BE order_id;       // bytes 4 to 11, signed, read here as unsigned
  UINT32BE trade_link_id;  // bytes 12 to 15, signed, read here as unsigned
} PendingFillCancel;

// Trade notification linked to pending fill
typedef struct _TradePending {
  UINT8 exec_type;         // byte 0
  UINT64BE settle_date;    // bytes 1 to 8, signed, read here as unsigned
  UINT64BE trade_date;     // bytes 9 to 16, signed, read here as unsigned
  UINT64BE transact_time;  // bytes 17 to 24, signed, read here as unsigned
  UINT64BE leaves_amt;     // bytes 25 to 32, signed, read here as unsigned
  UINT8 aggressor_flag;    // byte 33
} TradePending;

// Request retransmission of missed messages
typedef struct _ResendRequest {
  UINT32BE begin_seq_no;  // bytes 0 to 3, signed, read here as unsigned
} ResendRequest;

// Skip non-resendable or unavailable messages
typedef struct _GapFill {
  UINT32BE new_seq_no;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 reason_code;    // byte 4
} GapFill;

// Branch
casetype _MessageBody (UINT8 selector) {
  switch (selector) {
    case 0x41: Logon logon;
    case 0x42: Logout logout;
    case 0x43: Heartbeat heartbeat;
    case 0x45: InstrumentInfoRequest instrument_info_request;
    case 0x44: InstrumentInfo instrument_info;
    case 0x4C: NewOrderRequest new_order_request;
    case 0x4D: NewOrderAck new_order_ack;
    case 0x4E: OrderCancelRequest order_cancel_request;
    case 0x4F: OrderCancelReject order_cancel_reject;
    case 0x50: OrderReplaceOrCancelRequest order_replace_or_cancel_request;
    case 0x51: OrderReplaceOrCancelAck order_replace_or_cancel_ack;
    case 0x52: OrderCanceledOrExpired order_canceled_or_expired;
    case 0x54: Trade trade;
    case 0x55: PendingFill pending_fill;
    case 0x56: PendingFillCancel pending_fill_cancel;
    case 0x74: TradePending trade_pending;
    case 0x32: ResendRequest resend_request;
    case 0x34: GapFill gap_fill;
  }
} MessageBody;

// One Currenex message, framed Soh .. Etx
typedef struct _Frame {
  UINT8 soh;                               // byte 0
  UINT32BE sequence_number;                // bytes 1 to 4
  UINT32BE timestamp;                      // bytes 5 to 8
  UINT8 message_type;                      // byte 9
  MessageBody(message_type) message_body;
  UINT8 etx;
} Frame;

// ---- Packet: Packet ----------------------------------------------------------

// Currenex Tcp session: a run of messages
entrypoint typedef struct _Packet (UINT32 available) {
  Frame frame[:byte-size available];
} Packet;

