// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out IexOptions_MarketData_v1_03.3d

// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_UNDERLYING_REF_DATA_MESSAGE 0x0001                // Underlying Ref Data Message
#define TEMPLATE_ID_SYMBOL_MAPPING_MESSAGE 0x0002                     // Symbol Mapping Message
#define TEMPLATE_ID_INSTRUMENT_CLEAR_MESSAGE 0x0003                   // Instrument Clear Message
#define TEMPLATE_ID_TRADING_STATUS_MESSAGE 0x0004                     // Trading Status Message
#define TEMPLATE_ID_OPTIONS_AUCTION_SUMMARY_MESSAGE 0x0005            // Options Auction Summary Message
#define TEMPLATE_ID_OPTIONS_AUCTION_WIDTH_UPDATE_MESSAGE 0x0006       // Options Auction Width Update Message
#define TEMPLATE_ID_LIQUIDITY_EVENT_NOTIFICATION_MESSAGE 0x0007       // Liquidity Event Notification Message
#define TEMPLATE_ID_LIQUIDITY_EVENT_EXECUTION_MESSAGE 0x0008          // Liquidity Event Execution Message
#define TEMPLATE_ID_LIQUIDITY_EVENT_CANCEL_MESSAGE 0x0009             // Liquidity Event Cancel Message
#define TEMPLATE_ID_ADD_ORDER_NON_CUSTOMER_MESSAGE 0x0064             // Add Order Non Customer Message
#define TEMPLATE_ID_ADD_ORDER_CUSTOMER_MESSAGE 0x0065                 // Add Order Customer Message
#define TEMPLATE_ID_MODIFY_ORDER_MESSAGE 0x0066                       // Modify Order Message
#define TEMPLATE_ID_DELETE_ORDER_MESSAGE 0x0067                       // Delete Order Message
#define TEMPLATE_ID_ORDER_EXECUTION_MESSAGE 0x0068                    // Order Execution Message
#define TEMPLATE_ID_DEEP_TRADE_BREAK_MESSAGE 0x0069                   // Deep Trade Break Message
#define TEMPLATE_ID_QUOTE_UPDATE_NO_CUSTOMER_INTEREST_MESSAGE 0x00C8  // Quote Update No Customer Interest Message
#define TEMPLATE_ID_QUOTE_UPDATE_CUSTOMER_INTEREST_MESSAGE 0x00C9     // Quote Update Customer Interest Message
#define TEMPLATE_ID_TRADE_MESSAGE 0x00CA                              // Trade Message
#define TEMPLATE_ID_TRADE_CORRECTION_MESSAGE 0x00CB                   // Trade Correction Message
#define TEMPLATE_ID_TOPS_TRADE_BREAK_MESSAGE 0x00CC                   // Tops Trade Break Message
#define TEMPLATE_ID_HEARTBEAT_MESSAGE 0x012C                          // Heartbeat Message
#define TEMPLATE_ID_SEQUENCED_PACKET_MESSAGE 0x012D                   // Sequenced Packet Message
#define TEMPLATE_ID_SESSION_SHUTDOWN_MESSAGE 0x012E                   // Session Shutdown Message
#define TEMPLATE_ID_SERVER_HEARTBEAT_MESSAGE 0x0190                   // Server Heartbeat Message
#define TEMPLATE_ID_CLIENT_HEARTBEAT_MESSAGE 0x0191                   // Client Heartbeat Message
#define TEMPLATE_ID_RETRANSMISSION_REQUEST_MESSAGE 0x0192             // Retransmission Request Message
#define TEMPLATE_ID_RETRANSMISSION_RESPONSE_MESSAGE 0x0193            // Retransmission Response Message
#define TEMPLATE_ID_SNAPSHOT_HEADER_MESSAGE 0x0259                    // Snapshot Header Message

// Mpv Group: one byte code
#define MPV_GROUP_ALL_PENNY 0x00     // All Penny
#define MPV_GROUP_PENNY_NICKEL 0x01  // Penny Nickel
#define MPV_GROUP_NICKEL_DIME 0x02   // Nickel Dime

// Close Indicator: one byte code
#define CLOSE_INDICATOR_DEFAULT 0x00            // Default
#define CLOSE_INDICATOR_UNDERLYING_CLOSED 0x01  // Underlying Closed

// Closing Only Series: one byte code
#define CLOSING_ONLY_SERIES_FALSE 0x00  // False
#define CLOSING_ONLY_SERIES_TRUE 0x01   // True

// Option Type: one byte code
#define OPTION_TYPE_PUT 0x00   // Put
#define OPTION_TYPE_CALL 0x01  // Call

// Orp Enablement: one byte code
#define ORP_ENABLEMENT_ORP_PROTECTION_ENABLED 0x00   // Orp Protection Enabled
#define ORP_ENABLEMENT_ORP_PROTECTION_DISABLED 0x01  // Orp Protection Disabled

// Trading Status: one byte code
#define TRADING_STATUS_HALTED 0x00              // Halted
#define TRADING_STATUS_PRE_OPENING 0x01         // Pre Opening
#define TRADING_STATUS_OPENING_PROCESS 0x02     // Opening Process
#define TRADING_STATUS_CONTINUOUS_TRADING 0x03  // Continuous Trading
#define TRADING_STATUS_RE_OPENING_PROCESS 0x04  // Re Opening Process
#define TRADING_STATUS_SUSPENDED 0x05           // Suspended
#define TRADING_STATUS_QUEUEING 0x06            // Queueing

// Auction Summary Type: one byte code
#define AUCTION_SUMMARY_TYPE_OPENING 0x00          // Opening
#define AUCTION_SUMMARY_TYPE_HALT_RE_OPENING 0x01  // Halt Re Opening

// Liquidity Event Type: one byte code
#define LIQUIDITY_EVENT_TYPE_SUM 0x00  // Sum

// Side: one byte code
#define SIDE_BUY 0x01   // Buy
#define SIDE_SELL 0x02  // Sell

// Capacity: one byte code
#define CAPACITY_CUSTOMER 0x00           // Customer
#define CAPACITY_FIRM 0x01               // Firm
#define CAPACITY_BROKER_DEALER 0x02      // Broker Dealer
#define CAPACITY_MARKET_MAKER 0x03       // Market Maker
#define CAPACITY_AWAY_MARKET_MAKER 0x04  // Away Market Maker
#define CAPACITY_PROF_CUSTOMER 0x05      // Prof Customer
#define CAPACITY_NOT_DISCLOSED 0x06      // Not Disclosed

// Customer Indicator: one byte code
#define CUSTOMER_INDICATOR_CUSTOMER 0x00      // Customer
#define CUSTOMER_INDICATOR_NON_CUSTOMER 0x01  // Non Customer

// Mod Flag: one byte code
#define MOD_FLAG_RESET_PRIORITY 0x00     // Reset Priority
#define MOD_FLAG_MAINTAIN_PRIORITY 0x01  // Maintain Priority

// Status Status Type: one byte code
#define STATUS_STATUS_TYPE_REGULAR_TRADING 0x00  // Regular Trading
#define STATUS_STATUS_TYPE_TRADING_HALTED 0x01   // Trading Halted

// Feed: one byte code
#define FEED_DEEP 0x00  // Deep
#define FEED_TOPS 0x01  // Tops

// Status Retransmission Status Type: one byte code
#define STATUS_RETRANSMISSION_STATUS_TYPE_SUCCESS 0x00                      // Success
#define STATUS_RETRANSMISSION_STATUS_TYPE_INVALID_CHANNEL_ID 0x01           // Invalid Channel Id
#define STATUS_RETRANSMISSION_STATUS_TYPE_INVALID_FEED 0x02                 // Invalid Feed
#define STATUS_RETRANSMISSION_STATUS_TYPE_INVALID_LOGON_ID 0x03             // Invalid Logon Id
#define STATUS_RETRANSMISSION_STATUS_TYPE_INVALID_REQUEST_ID 0x04           // Invalid Request Id
#define STATUS_RETRANSMISSION_STATUS_TYPE_INVALID_PACKET_LENGTH 0x05        // Invalid Packet Length
#define STATUS_RETRANSMISSION_STATUS_TYPE_INVALID_MESSAGE 0x06              // Invalid Message
#define STATUS_RETRANSMISSION_STATUS_TYPE_INVALID_SEQ_NUM_RANGE 0x07        // Invalid Seq Num Range
#define STATUS_RETRANSMISSION_STATUS_TYPE_DENIAL_OF_SERVICE 0x08            // Denial Of Service
#define STATUS_RETRANSMISSION_STATUS_TYPE_MAX_DAILY_REQUESTS_EXCEEDED 0x09  // Max Daily Requests Exceeded
#define STATUS_RETRANSMISSION_STATUS_TYPE_MAX_SEQ_NUM_RANGE_EXCEEDED 0x0A   // Max Seq Num Range Exceeded
#define STATUS_RETRANSMISSION_STATUS_TYPE_SEQ_NUM_TTL_EXPIRED 0x0B          // Seq Num Ttl Expired
#define STATUS_RETRANSMISSION_STATUS_TYPE_INTERNAL_ERROR 0x0C               // Internal Error

// ---- Types -------------------------------------------------------------------

// UnderlyingRefDataMessage
typedef struct _UnderlyingRefDataMessage {
  UINT64 time;                  // bytes 0 to 7
  UINT32 underlying_id;         // bytes 8 to 11
  UINT8 underlying_symbol[16];  // bytes 12 to 27
  UINT8 exchange_code;          // byte 28
  UINT8 mpv_group;              // byte 29, signed, read here as unsigned
  UINT8 close_indicator;        // byte 30, signed, read here as unsigned
} UnderlyingRefDataMessage;

// SymbolMappingMessage
typedef struct _SymbolMappingMessage {
  UINT64 time;                // bytes 0 to 7
  UINT32 instrument_id;       // bytes 8 to 11
  UINT8 osi_symbol[32];       // bytes 12 to 43
  UINT8 trading_ring;         // byte 44, signed, read here as unsigned
  UINT8 closing_only_series;  // byte 45
  UINT32 underlying_id;       // bytes 46 to 49
  UINT8 maturity_date[8];     // bytes 50 to 57
  UINT8 option_type;          // byte 58, signed, read here as unsigned
  UINT64 strike_price;        // bytes 59 to 66, signed, read here as unsigned
  UINT8 orp_enablement;       // byte 67, signed, read here as unsigned
} SymbolMappingMessage;

// InstrumentClearMessage
typedef struct _InstrumentClearMessage {
  UINT64 time;           // bytes 0 to 7
  UINT32 instrument_id;  // bytes 8 to 11
} InstrumentClearMessage;

// TradingStatusMessage
typedef struct _TradingStatusMessage {
  UINT64 time;           // bytes 0 to 7
  UINT32 instrument_id;  // bytes 8 to 11
  UINT8 trading_status;  // byte 12, signed, read here as unsigned
} TradingStatusMessage;

// OptionsAuctionSummaryMessage
typedef struct _OptionsAuctionSummaryMessage {
  UINT64 time;                 // bytes 0 to 7
  UINT32 instrument_id;        // bytes 8 to 11
  UINT8 auction_summary_type;  // byte 12, signed, read here as unsigned
  UINT64 price;                // bytes 13 to 20, signed, read here as unsigned
  UINT32 contracts;            // bytes 21 to 24
} OptionsAuctionSummaryMessage;

// OptionsAuctionWidthUpdateMessage
typedef struct _OptionsAuctionWidthUpdateMessage {
  UINT64 time;                    // bytes 0 to 7
  UINT32 underlying_id;           // bytes 8 to 11
  UINT8 quote_relief_multiplier;  // byte 12
} OptionsAuctionWidthUpdateMessage;

// LiquidityEventNotificationMessage
typedef struct _LiquidityEventNotificationMessage {
  UINT64 time;                 // bytes 0 to 7
  UINT32 instrument_id;        // bytes 8 to 11
  UINT32 event_id;             // bytes 12 to 15
  UINT8 liquidity_event_type;  // byte 16, signed, read here as unsigned
  UINT8 side;                  // byte 17, signed, read here as unsigned
  UINT64 price;                // bytes 18 to 25, signed, read here as unsigned
  UINT32 contracts;            // bytes 26 to 29
  UINT8 capacity;              // byte 30, signed, read here as unsigned
  UINT8 participant_id[4];     // bytes 31 to 34
  UINT32 event_end_offset;     // bytes 35 to 38
} LiquidityEventNotificationMessage;

// LiquidityEventExecutionMessage
typedef struct _LiquidityEventExecutionMessage {
  UINT64 time;           // bytes 0 to 7
  UINT32 instrument_id;  // bytes 8 to 11
  UINT32 event_id;       // bytes 12 to 15
  UINT64 trade_id;       // bytes 16 to 23
  UINT64 price;          // bytes 24 to 31, signed, read here as unsigned
  UINT32 contracts;      // bytes 32 to 35
} LiquidityEventExecutionMessage;

// LiquidityEventCancelMessage
typedef struct _LiquidityEventCancelMessage {
  UINT64 time;           // bytes 0 to 7
  UINT32 instrument_id;  // bytes 8 to 11
  UINT32 event_id;       // bytes 12 to 15
} LiquidityEventCancelMessage;

// AddOrderNonCustomerMessage
typedef struct _AddOrderNonCustomerMessage {
  UINT64 time;           // bytes 0 to 7
  UINT32 instrument_id;  // bytes 8 to 11
  UINT64 order_id;       // bytes 12 to 19
  UINT8 side;            // byte 20, signed, read here as unsigned
  UINT64 price;          // bytes 21 to 28, signed, read here as unsigned
  UINT32 contracts;      // bytes 29 to 32
} AddOrderNonCustomerMessage;

// AddOrderCustomerMessage
typedef struct _AddOrderCustomerMessage {
  UINT64 time;               // bytes 0 to 7
  UINT32 instrument_id;      // bytes 8 to 11
  UINT64 order_id;           // bytes 12 to 19
  UINT8 side;                // byte 20, signed, read here as unsigned
  UINT64 price;              // bytes 21 to 28, signed, read here as unsigned
  UINT32 contracts;          // bytes 29 to 32
  UINT8 customer_indicator;  // byte 33, signed, read here as unsigned
} AddOrderCustomerMessage;

// ModifyOrderMessage
typedef struct _ModifyOrderMessage {
  UINT64 time;           // bytes 0 to 7
  UINT32 instrument_id;  // bytes 8 to 11
  UINT64 order_id;       // bytes 12 to 19
  UINT64 price;          // bytes 20 to 27, signed, read here as unsigned
  UINT32 contracts;      // bytes 28 to 31
  UINT8 mod_flag;        // byte 32, signed, read here as unsigned
} ModifyOrderMessage;

// DeleteOrderMessage
typedef struct _DeleteOrderMessage {
  UINT64 time;           // bytes 0 to 7
  UINT32 instrument_id;  // bytes 8 to 11
  UINT64 order_id;       // bytes 12 to 19
} DeleteOrderMessage;

// OrderExecutionMessage
typedef struct _OrderExecutionMessage {
  UINT64 time;                 // bytes 0 to 7
  UINT32 instrument_id;        // bytes 8 to 11
  UINT64 order_id;             // bytes 12 to 19
  UINT64 trade_id;             // bytes 20 to 27
  UINT64 price;                // bytes 28 to 35, signed, read here as unsigned
  UINT32 executed_contracts;   // bytes 36 to 39
  UINT32 remaining_contracts;  // bytes 40 to 43
  UINT8 trade_condition;       // byte 44
} OrderExecutionMessage;

// DEEPTradeBreakMessage
typedef struct _DeepTradeBreakMessage {
  UINT64 time;           // bytes 0 to 7
  UINT32 instrument_id;  // bytes 8 to 11
  UINT64 trade_id;       // bytes 12 to 19
} DeepTradeBreakMessage;

// QuoteUpdateNoCustomerInterestMessage
typedef struct _QuoteUpdateNoCustomerInterestMessage {
  UINT64 time;               // bytes 0 to 7
  UINT32 instrument_id;      // bytes 8 to 11
  UINT32 bid_size;           // bytes 12 to 15
  UINT64 bid_price;          // bytes 16 to 23, signed, read here as unsigned
  UINT32 ask_size;           // bytes 24 to 27
  UINT64 ask_price;          // bytes 28 to 35, signed, read here as unsigned
  UINT8 status_status_type;  // byte 36, signed, read here as unsigned
} QuoteUpdateNoCustomerInterestMessage;

// QuoteUpdateCustomerInterestMessage
typedef struct _QuoteUpdateCustomerInterestMessage {
  UINT64 time;               // bytes 0 to 7
  UINT32 instrument_id;      // bytes 8 to 11
  UINT32 bid_size;           // bytes 12 to 15
  UINT32 bid_customer_size;  // bytes 16 to 19
  UINT64 bid_price;          // bytes 20 to 27, signed, read here as unsigned
  UINT32 ask_size;           // bytes 28 to 31
  UINT32 ask_customer_size;  // bytes 32 to 35
  UINT64 ask_price;          // bytes 36 to 43, signed, read here as unsigned
  UINT8 status_status_type;  // byte 44, signed, read here as unsigned
} QuoteUpdateCustomerInterestMessage;

// TradeMessage
typedef struct _TradeMessage {
  UINT64 time;            // bytes 0 to 7
  UINT32 instrument_id;   // bytes 8 to 11
  UINT64 trade_id;        // bytes 12 to 19
  UINT64 price;           // bytes 20 to 27, signed, read here as unsigned
  UINT32 contracts;       // bytes 28 to 31
  UINT8 trade_condition;  // byte 32
} TradeMessage;

// TradeCorrectionMessage
typedef struct _TradeCorrectionMessage {
  UINT64 time;               // bytes 0 to 7
  UINT32 instrument_id;      // bytes 8 to 11
  UINT64 original_trade_id;  // bytes 12 to 19
  UINT64 trade_id;           // bytes 20 to 27
  UINT64 price;              // bytes 28 to 35, signed, read here as unsigned
  UINT32 contracts;          // bytes 36 to 39
  UINT8 trade_condition;     // byte 40
} TradeCorrectionMessage;

// TOPSTradeBreakMessage
typedef struct _TopsTradeBreakMessage {
  UINT64 time;            // bytes 0 to 7
  UINT32 instrument_id;   // bytes 8 to 11
  UINT64 trade_id;        // bytes 12 to 19
  UINT8 trade_condition;  // byte 20
} TopsTradeBreakMessage;

// HeartbeatMessage
typedef struct _HeartbeatMessage {
  UINT32 channel_id;       // bytes 0 to 3
  UINT64 sequence_number;  // bytes 4 to 11
} HeartbeatMessage;

casetype _OptionalMessageData (Bool present, UINT32 length) {
  switch (present) {
    case true: UINT8 message_data[length];
    case false: unit absent;
  }
} OptionalMessageData;

// message data struct
typedef struct _Message {
  UINT16 message_length;                                                                   // bytes 0 to 1
  OptionalMessageData((message_length > 0x0000), ((UINT32) message_length)) message_data;
} Message;

// messages
typedef struct _SequencedPacketMessageMessagesGroup (mutable UINT32 * tally) {
  Message message;
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} SequencedPacketMessageMessagesGroup;

// messages Block
typedef struct _SequencedPacketMessageMessagesGroups (UINT32 available, mutable UINT32 * tally) where (available >= 2) {
  UINT8 block_length_short;                                                                                                                                // byte 0
  UINT8 num_in_group;                                                                                                                                      // byte 1
  unit sequenced_packet_message_messages_group_tally_start {:on-success *tally = 0; return true; };
  SequencedPacketMessageMessagesGroup(tally) sequenced_packet_message_messages_group[:byte-size (available - 2)];
  unit sequenced_packet_message_messages_group_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) num_in_group); };
} SequencedPacketMessageMessagesGroups;

// SequencedPacketMessage
typedef struct _SequencedPacketMessage (UINT32 available, mutable UINT32 * tally) where (available >= 12) {
  UINT32 channel_id;                                                                                       // bytes 0 to 3
  UINT64 sequence_number;                                                                                  // bytes 4 to 11
  SequencedPacketMessageMessagesGroups((available - 12), tally) sequenced_packet_message_messages_groups;
} SequencedPacketMessage;

// SessionShutdownMessage
typedef struct _SessionShutdownMessage {
  UINT32 channel_id;       // bytes 0 to 3
  UINT64 sequence_number;  // bytes 4 to 11
} SessionShutdownMessage;

// RetransmissionRequestMessage
typedef struct _RetransmissionRequestMessage {
  UINT64 begin_sequence;  // bytes 0 to 7
  UINT64 end_sequence;    // bytes 8 to 15
  UINT8 logon_id[16];     // bytes 16 to 31
  UINT32 request_id;      // bytes 32 to 35
  UINT32 channel_id;      // bytes 36 to 39
  UINT8 feed;             // byte 40, signed, read here as unsigned
} RetransmissionRequestMessage;

// RetransmissionResponseMessage
typedef struct _RetransmissionResponseMessage {
  UINT8 logon_id[16];                       // bytes 0 to 15
  UINT32 request_id;                        // bytes 16 to 19
  UINT32 channel_id;                        // bytes 20 to 23
  UINT8 feed;                               // byte 24, signed, read here as unsigned
  UINT8 status_retransmission_status_type;  // byte 25
} RetransmissionResponseMessage;

// SnapshotHeaderMessage
typedef struct _SnapshotHeaderMessage {
  UINT32 snapshot_id;            // bytes 0 to 3
  UINT32 current_packet_number;  // bytes 4 to 7
  UINT32 total_packet_count;     // bytes 8 to 11
  UINT64 as_of_sequence_number;  // bytes 12 to 19
} SnapshotHeaderMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0001: UnderlyingRefDataMessage underlying_ref_data_message;
    case 0x0002: SymbolMappingMessage symbol_mapping_message;
    case 0x0003: InstrumentClearMessage instrument_clear_message;
    case 0x0004: TradingStatusMessage trading_status_message;
    case 0x0005: OptionsAuctionSummaryMessage options_auction_summary_message;
    case 0x0006: OptionsAuctionWidthUpdateMessage options_auction_width_update_message;
    case 0x0007: LiquidityEventNotificationMessage liquidity_event_notification_message;
    case 0x0008: LiquidityEventExecutionMessage liquidity_event_execution_message;
    case 0x0009: LiquidityEventCancelMessage liquidity_event_cancel_message;
    case 0x0064: AddOrderNonCustomerMessage add_order_non_customer_message;
    case 0x0065: AddOrderCustomerMessage add_order_customer_message;
    case 0x0066: ModifyOrderMessage modify_order_message;
    case 0x0067: DeleteOrderMessage delete_order_message;
    case 0x0068: OrderExecutionMessage order_execution_message;
    case 0x0069: DeepTradeBreakMessage deep_trade_break_message;
    case 0x00C8: QuoteUpdateNoCustomerInterestMessage quote_update_no_customer_interest_message;
    case 0x00C9: QuoteUpdateCustomerInterestMessage quote_update_customer_interest_message;
    case 0x00CA: TradeMessage trade_message;
    case 0x00CB: TradeCorrectionMessage trade_correction_message;
    case 0x00CC: TopsTradeBreakMessage tops_trade_break_message;
    case 0x012C: HeartbeatMessage heartbeat_message;
    case 0x012D: SequencedPacketMessage(available, tally) sequenced_packet_message;
    case 0x012E: SessionShutdownMessage session_shutdown_message;
    case 0x0190: unit server_heartbeat_message;
    case 0x0191: unit client_heartbeat_message;
    case 0x0192: RetransmissionRequestMessage retransmission_request_message;
    case 0x0193: RetransmissionResponseMessage retransmission_response_message;
    case 0x0259: SnapshotHeaderMessage snapshot_header_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Iex Options length-framed Sbe Message
typedef struct _SbeMessage (mutable UINT32 * tally) {
  UINT16 packet_length { packet_length >= 12 };                                                                                                       // bytes 0 to 1
  UINT16 block_length;                                                                                                                                // bytes 2 to 3
  UINT16 template_id;                                                                                                                                 // bytes 4 to 5
  UINT16 schema_id;                                                                                                                                   // bytes 6 to 7
  UINT16 version;                                                                                                                                     // bytes 8 to 9
  Payload(template_id, ((((UINT32) packet_length) - 2) - 10), tally) payload[:byte-size-single-element-array ((((UINT32) packet_length) - 2) - 10)];
} SbeMessage;

// ---- Packet: Packet ----------------------------------------------------------

// Iex Options Market Data Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) {
  SbeMessage(tally) sbe_message[:byte-size available];
} Packet;

