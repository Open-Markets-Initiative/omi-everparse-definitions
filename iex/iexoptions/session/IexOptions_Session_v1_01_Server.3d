// Investors Exchange Session
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out IexOptions_Session_v1_01_Server.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - the dispatch that chooses a message by its type
// - a block whose stated length holds more than its fields
// - a run counted by a field
//
// License: MIT No Attribution

// ---- Message Header: 8 bytes -------------------------------------------------

// Iex Options Sbe message header message identifiers and length of message root
entrypoint typedef struct _MessageHeader {
  UINT16 block_length;  // bytes 0 to 1
  UINT16 template_id;   // bytes 2 to 3
  UINT16 schema_id;     // bytes 4 to 5
  UINT16 version;       // bytes 6 to 7
} MessageHeader;

// ---- Login Response Message: 17 bytes ----------------------------------------

// LoginResponseMessage
entrypoint typedef struct _LoginResponseMessage {
  UINT8 logon_id[16];  // bytes 0 to 15
  UINT8 status;        // byte 16
} LoginResponseMessage;

// ---- Session Info Group Encoding: 2 bytes ------------------------------------

// sessionInfoGroupEncoding
entrypoint typedef struct _SessionInfoGroupEncoding {
  UINT8 block_length_short;  // byte 0
  UINT8 num_in_group;        // byte 1
} SessionInfoGroupEncoding;

// ---- Terminate Message: 1 byte -----------------------------------------------

// TerminateMessage
entrypoint typedef struct _TerminateMessage {
  UINT8 reason;  // byte 0
} TerminateMessage;

// ---- Sequenced Message Header Message: 20 bytes ------------------------------

// SequencedMessageHeaderMessage
entrypoint typedef struct _SequencedMessageHeaderMessage {
  UINT64 subsession_id;  // bytes 0 to 7
  UINT32 sequence;       // bytes 8 to 11
  UINT64 timestamp;      // bytes 12 to 19
} SequencedMessageHeaderMessage;

// ---- Subsession Join Response Message: 9 bytes -------------------------------

// SubsessionJoinResponseMessage
entrypoint typedef struct _SubsessionJoinResponseMessage {
  UINT64 subsession_id;  // bytes 0 to 7
  UINT8 status;          // byte 8
} SubsessionJoinResponseMessage;

// ---- Subsession Leave Response Message: 9 bytes ------------------------------

// SubsessionLeaveResponseMessage
entrypoint typedef struct _SubsessionLeaveResponseMessage {
  UINT64 subsession_id;  // bytes 0 to 7
  UINT8 reason;          // byte 8
} SubsessionLeaveResponseMessage;

