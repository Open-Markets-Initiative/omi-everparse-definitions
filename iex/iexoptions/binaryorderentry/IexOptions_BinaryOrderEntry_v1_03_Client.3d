// LoginRequestMessage
typedef struct _LoginRequestMessage {
  UINT8 logon_id[16];  // bytes 0 to 15
  UINT8 token[32];     // bytes 16 to 47
} LoginRequestMessage;

// SequencedMessageHeaderMessage
typedef struct _SequencedMessageHeaderMessage {
  UINT64 subsession_id;  // bytes 0 to 7
  UINT32 sequence;       // bytes 8 to 11
  UINT64 timestamp;      // bytes 12 to 19
} SequencedMessageHeaderMessage;

// SubsessionJoinMessage
typedef struct _SubsessionJoinMessage {
  UINT64 subsession_id;   // bytes 0 to 7
  UINT32 start_sequence;  // bytes 8 to 11
  UINT32 end_sequence;    // bytes 12 to 15
} SubsessionJoinMessage;

// SubsessionLeaveMessage
typedef struct _SubsessionLeaveMessage {
  UINT64 subsession_id;  // bytes 0 to 7
} SubsessionLeaveMessage;

// Branch
casetype _ClientSessionPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0001: LoginRequestMessage login_request_message;
    case 0x0004: unit client_heartbeat_message;
    case 0x0005: unit logout_request_message;
    case 0x0007: SequencedMessageHeaderMessage sequenced_message_header_message;
    case 0x0008: SubsessionJoinMessage subsession_join_message;
    case 0x000A: SubsessionLeaveMessage subsession_leave_message;
    default: UINT8 unknown[available];
  }
} ClientSessionPayload;

// Message of sbe schema iex.options.boe.session (schema id 20000)
typedef struct _ClientSessionMessage (UINT16 template_id, UINT32 available) {
  ClientSessionPayload(template_id, available) client_session_payload[:byte-size-single-element-array available];
} ClientSessionMessage;

