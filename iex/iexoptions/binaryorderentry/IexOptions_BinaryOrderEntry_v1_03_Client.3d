// Branch
casetype _ClientBusinessPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0001: NewOrderSingleMessage new_order_single_message;
    case 0x0002: OrderCancelReplaceRequestMessage order_cancel_replace_request_message;
    case 0x0003: OrderCancelRequestMessage order_cancel_request_message;
    case 0x0004: NewBulkQuoteMessage new_bulk_quote_message;
    case 0x0005: MassCancelRequestMessage mass_cancel_request_message;
    case 0x0006: PurgeRequestMessage purge_request_message;
    case 0x0033: RiskLimitUpdateRequestMessage risk_limit_update_request_message;
    case 0x0034: RiskActionRequestMessage risk_action_request_message;
    default: UINT8 unknown[available];
  }
} ClientBusinessPayload;

// Message of sbe schema iex.options.boe.business (schema id 20001)
typedef struct _ClientBusinessMessage (UINT16 template_id, UINT32 available) {
  ClientBusinessPayload(template_id, available) client_business_payload[:byte-size-single-element-array available];
} ClientBusinessMessage;

// Branch
casetype _ClientPayload (UINT16 selector, UINT16 template_id, UINT32 available) {
  switch (selector) {
    case 0x4E20: ClientSessionMessage(template_id, available) client_session_message;
    case 0x4E21: ClientBusinessMessage(template_id, available) client_business_message;
    default: UINT8 unknown[available];
  }
} ClientPayload;

// Iex Options length-framed Sbe Message sent by the User to Iex Options
typedef struct _ClientSbeMessage {
  UINT16 packet_length { packet_length >= 10 };                                                                                                            // bytes 0 to 1
  UINT16 block_length;                                                                                                                                     // bytes 2 to 3
  UINT16 template_id;                                                                                                                                      // bytes 4 to 5
  UINT16 schema_id;                                                                                                                                        // bytes 6 to 7
  UINT16 version;                                                                                                                                          // bytes 8 to 9
  ClientPayload(schema_id, template_id, (((UINT32) packet_length) - 10)) client_payload[:byte-size-single-element-array (((UINT32) packet_length) - 10)];
} ClientSbeMessage;

// ---- Packet: ClientPacket ----------------------------------------------------

// Iex Options Binary Session Tcp Packet sent by the User to Iex Options
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientSbeMessage client_sbe_message[:byte-size available];
} ClientPacket;

