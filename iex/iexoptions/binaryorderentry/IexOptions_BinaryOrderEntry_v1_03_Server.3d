// NewIocQuoteAckMessage
typedef struct _NewIocQuoteAckMessage {
  UINT64 transact_time;            // bytes 0 to 7
  UINT8 market_participant_id[4];  // bytes 8 to 11
  UINT64 cl_ord_id;                // bytes 12 to 19
  UINT8 clearing_account[4];       // bytes 20 to 23
