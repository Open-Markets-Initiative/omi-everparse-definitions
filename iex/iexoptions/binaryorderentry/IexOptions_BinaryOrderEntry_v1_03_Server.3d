// Branch
casetype _ServerBusinessPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0065: OrderAckMessage order_ack_message;
    case 0x0066: UnsolicitedModifyAckMessage unsolicited_modify_ack_message;
    case 0x0067: OrderCancelAckMessage order_cancel_ack_message;
    case 0x0068: MassCancelAckMessage mass_cancel_ack_message;
    case 0x0069: BulkQuoteAckMessage bulk_quote_ack_message;
    case 0x006A: NewIocQuoteAckMessage new_ioc_quote_ack_message;
    case 0x006B: QuoteRestatedMessage quote_restated_message;
    case 0x006C: QuoteCanceledMessage quote_canceled_message;
    case 0x006D: PurgeAckMessage purge_ack_message;
    case 0x006E: ExecutionReportMessage execution_report_message;
    case 0x006F: TradeBustCorrectMessage trade_bust_correct_message;
    case 0x0070: ApplicationLayerRejectMessage application_layer_reject_message;
    case 0x0097: UnderlyingRefDataMessage underlying_ref_data_message;
    case 0x0098: InstrumentRefDataMessage instrument_ref_data_message;
    case 0x0099: MpidConfigurationAcknowledgementMessage mpid_configuration_acknowledgement_message;
    case 0x009A: MarketMakerSymbolAppointmentMessage market_maker_symbol_appointment_message;
    case 0x009B: SessionConfigurationAcknowledgementMessage session_configuration_acknowledgement_message;
    case 0x009C: RiskControlAcknowledgmentMessage risk_control_acknowledgment_message;
    case 0x009D: RiskControlAlertMessage risk_control_alert_message;
    default: UINT8 unknown[available];
  }
} ServerBusinessPayload;

// Message of sbe schema iex.options.boe.business (schema id 20001)
typedef struct _ServerBusinessMessage (UINT16 template_id, UINT32 available) {
  ServerBusinessPayload(template_id, available) server_business_payload[:byte-size-single-element-array available];
} ServerBusinessMessage;

// Branch
casetype _ServerPayload (UINT16 selector, UINT16 template_id, UINT32 available) {
  switch (selector) {
    case 0x4E20: ServerSessionMessage(template_id, available) server_session_message;
    case 0x4E21: ServerBusinessMessage(template_id, available) server_business_message;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Iex Options length-framed Sbe Message sent by Iex Options to the User
typedef struct _ServerSbeMessage {
  UINT16 packet_length { packet_length >= 10 };                                                                                                            // bytes 0 to 1
  UINT16 block_length;                                                                                                                                     // bytes 2 to 3
  UINT16 template_id;                                                                                                                                      // bytes 4 to 5
  UINT16 schema_id;                                                                                                                                        // bytes 6 to 7
  UINT16 version;                                                                                                                                          // bytes 8 to 9
  ServerPayload(schema_id, template_id, (((UINT32) packet_length) - 10)) server_payload[:byte-size-single-element-array (((UINT32) packet_length) - 10)];
} ServerSbeMessage;

// ---- Packet: ServerPacket ----------------------------------------------------

// Iex Options Binary Session Tcp Packet sent by Iex Options to the User
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSbeMessage server_sbe_message[:byte-size available];
} ServerPacket;

