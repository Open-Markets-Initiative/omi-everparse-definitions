// ---- Types -------------------------------------------------------------------

// LoginResponseMessage
typedef struct _LoginResponseMessage {
  UINT8 logon_id[16];  // bytes 0 to 15
  UINT8 status;        // byte 16
} LoginResponseMessage;

// SubSessions
typedef struct _SubSessionsGroup {
  UINT8 subsession_type;  // byte 0, signed, read here as unsigned
  UINT64 subsession_id;   // bytes 1 to 8
  UINT8 joined;           // byte 9
  UINT32 next_seq_no;     // bytes 10 to 13
} SubSessionsGroup;

// SubSessions Block
typedef struct _SubSessionsGroups {
  UINT8 block_length_short;                                                        // byte 0
  UINT8 num_in_group;                                                              // byte 1
  SubSessionsGroup sub_sessions_group[:byte-size (((UINT32) num_in_group) * 14)];
} SubSessionsGroups;

// GatewayHeartbeatMessage
typedef struct _GatewayHeartbeatMessage {
  UINT8 keep_alive;                       // byte 0
  SubSessionsGroups sub_sessions_groups;
} GatewayHeartbeatMessage;

// TerminateMessage
typedef struct _TerminateMessage {
  UINT8 reason;  // byte 0
} TerminateMessage;

// SequencedMessageHeaderMessage
typedef struct _SequencedMessageHeaderMessage {
  UINT64 subsession_id;  // bytes 0 to 7
  UINT32 sequence;       // bytes 8 to 11
  UINT64 timestamp;      // bytes 12 to 19
} SequencedMessageHeaderMessage;

// SubsessionJoinResponseMessage
typedef struct _SubsessionJoinResponseMessage {
  UINT64 subsession_id;  // bytes 0 to 7
  UINT8 status;          // byte 8
} SubsessionJoinResponseMessage;

// SubsessionLeaveResponseMessage
typedef struct _SubsessionLeaveResponseMessage {
  UINT64 subsession_id;  // bytes 0 to 7
  UINT8 reason;          // byte 8
} SubsessionLeaveResponseMessage;

// Branch
casetype _ServerSessionPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0002: LoginResponseMessage login_response_message;
    case 0x0003: GatewayHeartbeatMessage gateway_heartbeat_message;
    case 0x0006: TerminateMessage terminate_message;
    case 0x0007: SequencedMessageHeaderMessage sequenced_message_header_message;
    case 0x0009: SubsessionJoinResponseMessage subsession_join_response_message;
    case 0x000B: SubsessionLeaveResponseMessage subsession_leave_response_message;
    default: UINT8 unknown[available];
  }
} ServerSessionPayload;

// Message of sbe schema iex.options.boe.session (schema id 20000)
typedef struct _ServerSessionMessage (UINT16 template_id, UINT32 available) {
  ServerSessionPayload(template_id, available) server_session_payload[:byte-size-single-element-array available];
} ServerSessionMessage;

// OrderAckMessage
typedef struct _OrderAckMessage {
  UINT8 account_account_optional[16];  // bytes 0 to 15
  UINT64 transact_time;                // bytes 16 to 23
  UINT32 instrument_id;                // bytes 24 to 27
  UINT8 market_participant_id[4];      // bytes 28 to 31
  UINT64 cl_ord_id;                    // bytes 32 to 39
  UINT8 clearing_account_optional[4];  // bytes 40 to 43
  UINT64 orig_cl_ord_id_optional;      // bytes 44 to 51
  UINT64 order_id;                     // bytes 52 to 59
  UINT8 customer_or_firm;              // byte 60, signed, read here as unsigned
  UINT8 open_close;                    // byte 61, signed, read here as unsigned
  UINT8 attributed_quote;              // byte 62, signed, read here as unsigned
  UINT8 time_in_force;                 // byte 63, signed, read here as unsigned
  UINT8 cancel_instead_of_slide;       // byte 64, signed, read here as unsigned
  UINT8 display_inst;                  // byte 65, signed, read here as unsigned
  UINT8 exec_inst;                     // byte 66, signed, read here as unsigned
  UINT8 ord_type;                      // byte 67, signed, read here as unsigned
  UINT8 target_party_id[4];            // bytes 68 to 71
  UINT32 auction_id;                   // bytes 72 to 75
  UINT32 clearing_firm;                // bytes 76 to 79
  UINT8 optional_data[16];             // bytes 80 to 95
  UINT8 routing_firm_id[4];            // bytes 96 to 99
  UINT8 aiq[3];                        // bytes 100 to 102
  UINT8 side;                          // byte 103, signed, read here as unsigned
  UINT64 price_price_8_optional;       // bytes 104 to 111, signed, read here as unsigned
  UINT32 order_qty;                    // bytes 112 to 115
  UINT32 leaves_qty;                   // bytes 116 to 119
  UINT64 effective_limit_price;        // bytes 120 to 127, signed, read here as unsigned
  UINT64 display_price;                // bytes 128 to 135, signed, read here as unsigned
  UINT8 reason_code_optional;          // byte 136
  UINT8 ack_type;                      // byte 137, signed, read here as unsigned
  UINT8 throttle_indicator;            // byte 138, signed, read here as unsigned
} OrderAckMessage;

// UnsolicitedModifyAckMessage
typedef struct _UnsolicitedModifyAckMessage {
  UINT64 transact_time;            // bytes 0 to 7
  UINT32 instrument_id;            // bytes 8 to 11
  UINT8 market_participant_id[4];  // bytes 12 to 15
  UINT64 orig_cl_ord_id;           // bytes 16 to 23
  UINT64 order_id;                 // bytes 24 to 31
  UINT64 price_price_8;            // bytes 32 to 39, signed, read here as unsigned
  UINT32 order_qty;                // bytes 40 to 43
  UINT32 leaves_qty;               // bytes 44 to 47
  UINT64 effective_limit_price;    // bytes 48 to 55, signed, read here as unsigned
  UINT64 display_price;            // bytes 56 to 63, signed, read here as unsigned
  UINT8 restatement_reason;        // byte 64, signed, read here as unsigned
  UINT8 reason_code_optional;      // byte 65
  UINT8 ack_type;                  // byte 66, signed, read here as unsigned
} UnsolicitedModifyAckMessage;

