// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out IexEquities_Deep_v1_6.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SNAPSHOT_REQUEST_MESSAGE 0x72  // Snapshot Request Message
#define MESSAGE_TYPE_ERROR_RESPONSE_MESSAGE 0x65    // Error Response Message
#define MESSAGE_TYPE_SNAPSHOT_START_MESSAGE 0x73    // Snapshot Start Message
#define MESSAGE_TYPE_SNAPSHOT_DATA_MESSAGE 0x64     // Snapshot Data Message
#define MESSAGE_TYPE_SNAPSHOT_END_MESSAGE 0x78      // Snapshot End Message

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_AUTHENTICATION_FAILURE 0x41           // Authentication Failure
#define REJECT_REASON_CODE_INCORRECT_CHANNEL_ID 0x43             // Incorrect Channel Id
#define REJECT_REASON_CODE_SNAPSHOT_REQUEST_ALREADY_ACTIVE 0x45  // Snapshot Request Already Active
#define REJECT_REASON_CODE_QUOTA_EXCEEDED 0x51                   // Quota Exceeded
#define REJECT_REASON_CODE_SNAPSHOT_NOT_YET_AVAILABLE 0x52       // Snapshot Not Yet Available
#define REJECT_REASON_CODE_INCORRECT_SESSION_ID 0x53             // Incorrect Session Id
#define REJECT_REASON_CODE_UNKNOWN_MESSAGE 0x55                  // Unknown Message

// Iex Tp Message Type: one byte code
#define IEX_TP_MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                  // System Event Message
#define IEX_TP_MESSAGE_TYPE_SECURITY_DIRECTORY_MESSAGE 0x44            // Security Directory Message
#define IEX_TP_MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x48                // Trading Status Message
#define IEX_TP_MESSAGE_TYPE_RETAIL_LIQUIDITY_INDICATOR_MESSAGE 0x49    // Retail Liquidity Indicator Message
#define IEX_TP_MESSAGE_TYPE_OPERATIONAL_HALT_STATUS_MESSAGE 0x4F       // Operational Halt Status Message
#define IEX_TP_MESSAGE_TYPE_SHORT_SALE_PRICE_TEST_STATUS_MESSAGE 0x50  // Short Sale Price Test Status Message
#define IEX_TP_MESSAGE_TYPE_SECURITY_EVENT_MESSAGE 0x45                // Security Event Message
#define IEX_TP_MESSAGE_TYPE_PRICE_LEVEL_BUY_UPDATE_MESSAGE 0x38        // Price Level Buy Update Message
#define IEX_TP_MESSAGE_TYPE_PRICE_LEVEL_SELL_UPDATE_MESSAGE 0x35       // Price Level Sell Update Message
#define IEX_TP_MESSAGE_TYPE_TRADE_REPORT_MESSAGE 0x54                  // Trade Report Message
#define IEX_TP_MESSAGE_TYPE_OFFICIAL_PRICE_MESSAGE 0x58                // Official Price Message
#define IEX_TP_MESSAGE_TYPE_TRADE_BREAK_MESSAGE 0x42                   // Trade Break Message
#define IEX_TP_MESSAGE_TYPE_AUCTION_INFORMATION_MESSAGE 0x41           // Auction Information Message

// System Event: one byte code
#define SYSTEM_EVENT_START_OF_MESSAGES 0x4F              // Start Of Messages
#define SYSTEM_EVENT_START_OF_SYSTEM_HOURS 0x53          // Start Of System Hours
#define SYSTEM_EVENT_START_OF_REGULAR_MARKET_HOURS 0x52  // Start Of Regular Market Hours
#define SYSTEM_EVENT_END_OF_REGULAR_MARKET_HOURS 0x4D    // End Of Regular Market Hours
#define SYSTEM_EVENT_END_OF_SYSTEM_HOURS 0x45            // End Of System Hours
#define SYSTEM_EVENT_END_OF_MESSAGES 0x43                // End Of Messages

// Luld Tier: one byte code
#define LULD_TIER_NOT_APPLICABLE 0x00    // Not Applicable
#define LULD_TIER_TIER_1_NMS_STOCK 0x01  // Tier 1 Nms Stock
#define LULD_TIER_TIER_2_NMS_STOCK 0x02  // Tier 2 Nms Stock

// Trading Status: one byte code
#define TRADING_STATUS_TRADING_HALTED_ACROSS_ALL_US_EQUITY_MARKETS 0x48                   // Trading Halted Across All Us Equity Markets
#define TRADING_STATUS_TRADING_HALT_RELEASED_INTO_AN_ORDER_ACCEPTANCE_PERIOD_ON_IEX 0x4F  // Trading Halt Released Into An Order Acceptance Period On Iex
#define TRADING_STATUS_TRADING_PAUSED_AND_ORDER_ACCEPTANCE_PERIOD_ON_IEX 0x50             // Trading Paused And Order Acceptance Period On Iex
#define TRADING_STATUS_TRADING_ON_IEX 0x54                                                // Trading On Iex

// Retail Liquidity Indicator: one byte code
#define RETAIL_LIQUIDITY_INDICATOR_NOT_APPLICABLE 0x20         // Not Applicable
#define RETAIL_LIQUIDITY_INDICATOR_BUY_INTEREST 0x41           // Buy Interest
#define RETAIL_LIQUIDITY_INDICATOR_SELL_INTEREST 0x42          // Sell Interest
#define RETAIL_LIQUIDITY_INDICATOR_BUY_AND_SELL_INTEREST 0x43  // Buy And Sell Interest

// Operational Halt Status: one byte code
#define OPERATIONAL_HALT_STATUS_IEX_SPECIFIC_OPERATIONAL_TRADING_HALT 0x4F  // Iex Specific Operational Trading Halt
#define OPERATIONAL_HALT_STATUS_NOT_OPERATIONALLY_HALTED_ON_IEX 0x4E        // Not Operationally Halted On Iex

// Short Sale Price Test Status: one byte code
#define SHORT_SALE_PRICE_TEST_STATUS_NOT_IN_EFFECT 0x00  // Not In Effect
#define SHORT_SALE_PRICE_TEST_STATUS_IN_EFFECT 0x01      // In Effect

// Detail: one byte code
#define DETAIL_NO_PRICE_TEST_IN_PLACE 0x20                                                            // No Price Test In Place
#define DETAIL_SHORT_SALE_PRICE_TEST_RESTRICTION_IN_EFFECT_DUE_TO_AN_INTRADAY_PRICE_DROP_svuwmq 0x41  // Short Sale Price Test Restriction In Effect Due To An Intraday Price Drop In The Security
#define DETAIL_SHORT_SALE_PRICE_TEST_RESTRICTION_REMAINS_IN_EFFECT_FROM_PRIOR_DAY 0x43                // Short Sale Price Test Restriction Remains In Effect From Prior Day
#define DETAIL_SHORT_SALE_PRICE_TEST_RESTRICTION_DEACTIVATED 0x44                                     // Short Sale Price Test Restriction Deactivated
#define DETAIL_NOT_AVAILABLE 0x4E                                                                     // Not Available

// Security Event: one byte code
#define SECURITY_EVENT_OPENING_PROCESS_COMPLETE 0x4F  // Opening Process Complete
#define SECURITY_EVENT_CLOSING_PROCESS_COMPLETE 0x43  // Closing Process Complete

// Event Flags: one byte code
#define EVENT_FLAGS_ORDER_BOOK_IS_PROCESSING_AN_EVENT 0x00  // Order Book Is Processing An Event
#define EVENT_FLAGS_EVENT_PROCESSING_COMPLETE 0x01          // Event Processing Complete

// Price Type: one byte code
#define PRICE_TYPE_IEX_OFFICIAL_OPENING_PRICE 0x51  // Iex Official Opening Price
#define PRICE_TYPE_IEX_OFFICIAL_CLOSING_PRICE 0x4D  // Iex Official Closing Price

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING_AUCTION 0x4F     // Opening Auction
#define AUCTION_TYPE_CLOSING_AUCTION 0x43     // Closing Auction
#define AUCTION_TYPE_IPO_AUCTION 0x49         // Ipo Auction
#define AUCTION_TYPE_HALT_AUCTION 0x48        // Halt Auction
#define AUCTION_TYPE_VOLATILITY_AUCTION 0x56  // Volatility Auction

// Imbalance Side: one byte code
#define IMBALANCE_SIDE_BUY 0x42   // Buy
#define IMBALANCE_SIDE_SELL 0x53  // Sell
#define IMBALANCE_SIDE_NONE 0x4E  // None

// ---- Types -------------------------------------------------------------------

// The Snapshot Request message is sent from the client to the Deep Snap server to authenticate and request a Snapshot Response
typedef struct _SnapshotRequestMessage {
  UINT8 authentication_token[40];  // bytes 0 to 39
  UINT32 channel_id;               // bytes 40 to 43
  UINT32 session_id;               // bytes 44 to 47
  UINT64 minimum_sequence_number;  // bytes 48 to 55
} SnapshotRequestMessage;

// Sent by the Deep Snap server to the client when a Snapshot Request is rejected
typedef struct _ErrorResponseMessage {
  UINT8 reject_reason_code;  // byte 0
} ErrorResponseMessage;

// First message of a Snapshot Response sent from the Deep Snap server when a Snapshot Request is successful
typedef struct _SnapshotStartMessage {
  UINT64 snapshot_length;  // bytes 0 to 7
} SnapshotStartMessage;

// IexTp header of the wrapped feed message
typedef struct _IextpHeader {
  UINT8 version;                         // byte 0
  UINT8 reserved;                        // byte 1
  UINT16 message_protocol_id;            // bytes 2 to 3
  UINT32 channel_id;                     // bytes 4 to 7
  UINT32 session_id;                     // bytes 8 to 11
  UINT16 payload_length;                 // bytes 12 to 13
  UINT16 message_count;                  // bytes 14 to 15
  UINT64 stream_offset;                  // bytes 16 to 23
  UINT64 first_message_sequence_number;  // bytes 24 to 31
  UINT64 send_time;                      // bytes 32 to 39, signed, read here as unsigned
} IextpHeader;

// The System Event Message is used to indicate events that apply to the market or the data feed.
typedef struct _SystemEventMessage {
  UINT8 system_event;  // byte 0
  UINT64 timestamp;    // bytes 1 to 8, signed, read here as unsigned
} SystemEventMessage;

// The System Event Message is used to indicate events that apply to the market or the data feed.
typedef struct _SecurityDirectoryMessage {
  UINT8 unused_5 : 5;         // byte 0
  UINT8 etp : 1;              // byte 0
  UINT8 when_issued : 1;      // byte 0
  UINT8 test_security : 1;    // byte 0
  UINT64 timestamp;           // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];            // bytes 9 to 16
  UINT32 round_lot_size;      // bytes 17 to 20
  UINT64 adjusted_poc_price;  // bytes 21 to 28, signed, read here as unsigned
  UINT8 luld_tier;            // byte 29
} SecurityDirectoryMessage;

// The Trading Status Message is used to indicate the current trading status of a security.
typedef struct _TradingStatusMessage {
  UINT8 trading_status;  // byte 0
  UINT64 timestamp;      // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];       // bytes 9 to 16
  UINT8 reason[4];       // bytes 17 to 20
} TradingStatusMessage;

// broadcasts a real-time Retail Liquidity Indicator Message each time there is an update to IEX's eligible retail liquidity interest during the trading day
typedef struct _RetailLiquidityIndicatorMessage {
  UINT8 retail_liquidity_indicator;  // byte 0
  UINT64 timestamp;                  // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];                   // bytes 9 to 16
} RetailLiquidityIndicatorMessage;

// The Exchange may suspend trading of one or more securities on IEX for operational reasons and indicates such operational halt using the Operational Halt Status Message.
typedef struct _OperationalHaltStatusMessage {
  UINT8 operational_halt_status;  // byte 0
  UINT64 timestamp;               // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];                // bytes 9 to 16
} OperationalHaltStatusMessage;

// The Short Sale Price Test Message is used to indicate when a short sale price test restriction is in effect for a security.
typedef struct _ShortSalePriceTestStatusMessage {
  UINT8 short_sale_price_test_status;  // byte 0
  UINT64 timestamp;                    // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];                     // bytes 9 to 16
  UINT8 detail;                        // byte 17
} ShortSalePriceTestStatusMessage;

// The Security Event Message is used to indicate events that apply to a security
typedef struct _SecurityEventMessage {
  UINT8 security_event;  // byte 0
  UINT64 timestamp;      // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];       // bytes 9 to 16
} SecurityEventMessage;

// Deep broadcasts a real-time Price Level Update Message each time a displayed price level on IEX is updated during the trading day
typedef struct _PriceLevelBuyUpdateMessage {
  UINT8 event_flags;  // byte 0
  UINT64 timestamp;   // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];    // bytes 9 to 16
  UINT32 size;        // bytes 17 to 20
  UINT64 price;       // bytes 21 to 28, signed, read here as unsigned
} PriceLevelBuyUpdateMessage;

// Trade Report Messages are sent when an order on the IEX Order Book is executed in whole or in part
typedef struct _TradeReportMessage {
  UINT8 unused_3 : 3;                  // byte 0
  UINT8 single_price_cross_trade : 1;  // byte 0
  UINT8 trade_through_exempt : 1;      // byte 0
  UINT8 odd_lot : 1;                   // byte 0
  UINT8 extended_hours : 1;            // byte 0
  UINT8 intermarket_sweep : 1;         // byte 0
  UINT64 timestamp;                    // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];                     // bytes 9 to 16
  UINT32 size;                         // bytes 17 to 20
  UINT64 price;                        // bytes 21 to 28, signed, read here as unsigned
  UINT64 trade_id;                     // bytes 29 to 36
} TradeReportMessage;

// Official Price Messages are sent for each IEX-listed security to indicate the IEX Official Opening Price and IEX Official Closing Price.
typedef struct _OfficialPriceMessage {
  UINT8 price_type;       // byte 0
  UINT64 timestamp;       // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];        // bytes 9 to 16
  UINT64 official_price;  // bytes 17 to 24, signed, read here as unsigned
} OfficialPriceMessage;

// Trade Break Messages are sent when an execution on IEX is broken on that same trading day
typedef struct _TradeBreakMessage {
  UINT8 unused_3 : 3;                  // byte 0
  UINT8 single_price_cross_trade : 1;  // byte 0
  UINT8 trade_through_exempt : 1;      // byte 0
  UINT8 odd_lot : 1;                   // byte 0
  UINT8 extended_hours : 1;            // byte 0
  UINT8 intermarket_sweep : 1;         // byte 0
  UINT64 timestamp;                    // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];                     // bytes 9 to 16
  UINT32 size;                         // bytes 17 to 20
  UINT64 price;                        // bytes 21 to 28, signed, read here as unsigned
  UINT64 trade_id;                     // bytes 29 to 36
} TradeBreakMessage;

// Broadcasts an Auction Information Message every one second between the Lock-in Time and the auction match for Opening and Closing Auctions, and during the Display Only Period for IPO, Halt, and Volatility Auctions.
typedef struct _AuctionInformationMessage {
  UINT8 auction_type;                  // byte 0
  UINT64 timestamp;                    // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];                     // bytes 9 to 16
  UINT32 paired_shares;                // bytes 17 to 20
  UINT64 reference_price;              // bytes 21 to 28, signed, read here as unsigned
  UINT64 indicative_clearing_price;    // bytes 29 to 36, signed, read here as unsigned
  UINT32 imbalance_shares;             // bytes 37 to 40
  UINT8 imbalance_side;                // byte 41
  UINT8 extension_number;              // byte 42
  UINT32 scheduled_auction_time;       // bytes 43 to 46
  UINT64 auction_book_clearing_price;  // bytes 47 to 54, signed, read here as unsigned
  UINT64 collar_reference_price;       // bytes 55 to 62, signed, read here as unsigned
  UINT64 lower_auction_collar;         // bytes 63 to 70, signed, read here as unsigned
  UINT64 upper_auction_collar;         // bytes 71 to 78, signed, read here as unsigned
} AuctionInformationMessage;

// One complete Iex Deep formatted message, may be any Deep message type, see the Iex Transport specification
casetype _IexTpMessageData (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x44: SecurityDirectoryMessage security_directory_message;
    case 0x48: TradingStatusMessage trading_status_message;
    case 0x49: RetailLiquidityIndicatorMessage retail_liquidity_indicator_message;
    case 0x4F: OperationalHaltStatusMessage operational_halt_status_message;
    case 0x50: ShortSalePriceTestStatusMessage short_sale_price_test_status_message;
    case 0x45: SecurityEventMessage security_event_message;
    case 0x38: PriceLevelBuyUpdateMessage price_level_buy_update_message;
    case 0x35: PriceLevelBuyUpdateMessage price_level_sell_update_message;
    case 0x54: TradeReportMessage trade_report_message;
    case 0x58: OfficialPriceMessage official_price_message;
    case 0x42: TradeBreakMessage trade_break_message;
    case 0x41: AuctionInformationMessage auction_information_message;
    default: UINT8 unknown[available];
  }
} IexTpMessageData;

// Carries one complete Deep feed message wrapped with an IexTp header providing Deep feed sequencing and timing information
typedef struct _SnapshotDataMessage {
  IextpHeader iextp_header;                                                                                                                                                   // bytes 0 to 39
  UINT16 iex_tp_message_block_length;                                                                                                                                         // bytes 40 to 41
  UINT16 iex_tp_message_length { iex_tp_message_length >= 1 };                                                                                                                // bytes 42 to 43
  UINT8 iex_tp_message_type;                                                                                                                                                  // byte 44
  IexTpMessageData(iex_tp_message_type, (((UINT32) iex_tp_message_length) - 1)) iex_tp_message_data[:byte-size-single-element-array (((UINT32) iex_tp_message_length) - 1)];
} SnapshotDataMessage;

// Final message of a Snapshot Response, carries the sequence number at which the snapshot was created
typedef struct _SnapshotEndMessage {
  UINT64 snapshot_sequence_number;  // bytes 0 to 7
} SnapshotEndMessage;

// Branch
casetype _MessageData (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x72: SnapshotRequestMessage snapshot_request_message;
    case 0x65: ErrorResponseMessage error_response_message;
    case 0x73: SnapshotStartMessage snapshot_start_message;
    case 0x64: SnapshotDataMessage snapshot_data_message;
    case 0x78: SnapshotEndMessage snapshot_end_message;
    default: UINT8 unknown[available];
  }
} MessageData;

// Snap message
typedef struct _Message {
  UINT16 message_length { message_length >= 1 };                                                                                                         // bytes 0 to 1
  UINT8 message_type;                                                                                                                                    // byte 2
  MessageData(message_type, ((((UINT32) message_length) + 2) - 3)) message_data[:byte-size-single-element-array ((((UINT32) message_length) + 2) - 3)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Snap Tcp Packet
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

