// ---- Iextp Header: 40 bytes --------------------------------------------------

// IexTp packet header
entrypoint typedef struct _IextpHeader {
  UINT8 version;                         // byte 0
  UINT8 reserved;                        // byte 1
  UINT16 message_protocol_id;            // bytes 2 to 3
  UINT32 channel_id;                     // bytes 4 to 7
  UINT32 session_id;                     // bytes 8 to 11
  UINT16 payload_length;                 // bytes 12 to 13
  UINT16 message_count;                  // bytes 14 to 15
  UINT64 stream_offset;                  // bytes 16 to 23
  UINT64 first_message_sequence_number;  // bytes 24 to 31
  UINT64 send_time;                      // bytes 32 to 39
} IextpHeader;

// ---- Message Header: 3 bytes -------------------------------------------------

// IexTp message header
entrypoint typedef struct _MessageHeader {
  UINT16 message_length;  // bytes 0 to 1
  UINT8 message_type;     // byte 2
} MessageHeader;

// ---- System Event Message: 9 bytes -------------------------------------------

// The System Event Message is used to indicate events that apply to the market or the data feed.
entrypoint typedef struct _SystemEventMessage {
  UINT8 system_event;  // byte 0
  UINT64 timestamp;    // bytes 1 to 8, signed, read here as unsigned
} SystemEventMessage;

// ---- Trading Status Message: 21 bytes ----------------------------------------

// The Trading Status Message is used to indicate the current trading status of a security.
entrypoint typedef struct _TradingStatusMessage {
  UINT8 trading_status;  // byte 0
  UINT64 timestamp;      // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];       // bytes 9 to 16
  UINT8 reason[4];       // bytes 17 to 20
} TradingStatusMessage;

// ---- Retail Liquidity Indicator Message: 17 bytes ----------------------------

// broadcasts a real-time Retail Liquidity Indicator Message each time there is an update to IEX's eligible retail liquidity interest during the trading day
entrypoint typedef struct _RetailLiquidityIndicatorMessage {
  UINT8 retail_liquidity_indicator;  // byte 0
  UINT64 timestamp;                  // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];                   // bytes 9 to 16
} RetailLiquidityIndicatorMessage;

// ---- Operational Halt Status Message: 17 bytes -------------------------------

// The Exchange may suspend trading of one or more securities on IEX for operational reasons and indicates such operational halt using the Operational Halt Status Message.
entrypoint typedef struct _OperationalHaltStatusMessage {
  UINT8 operational_halt_status;  // byte 0
  UINT64 timestamp;               // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];                // bytes 9 to 16
} OperationalHaltStatusMessage;

// ---- Short Sale Price Test Status Message: 18 bytes --------------------------

// The Short Sale Price Test Message is used to indicate when a short sale price test restriction is in effect for a security.
entrypoint typedef struct _ShortSalePriceTestStatusMessage {
  UINT8 short_sale_price_test_status;  // byte 0
  UINT64 timestamp;                    // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];                     // bytes 9 to 16
