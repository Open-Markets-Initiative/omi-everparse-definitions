} ShortSalePriceTestStatusMessage;

// ---- Security Event Message: 17 bytes ----------------------------------------

// The Security Event Message is used to indicate events that apply to a security
entrypoint typedef struct _SecurityEventMessage {
  UINT8 security_event;  // byte 0
  UINT64 timestamp;      // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];       // bytes 9 to 16
} SecurityEventMessage;

// ---- Add Order Message: 37 bytes ---------------------------------------------

// A displayed order that has been added to the IEX Book
entrypoint typedef struct _AddOrderMessage {
  UINT8 side;        // byte 0
  UINT64 timestamp;  // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];   // bytes 9 to 16
  UINT64 order_id;   // bytes 17 to 24
  UINT32 size;       // bytes 25 to 28
  UINT64 price;      // bytes 29 to 36, signed, read here as unsigned
} AddOrderMessage;

// ---- Order Delete Message: 25 bytes ------------------------------------------

// A displayed order that was removed from the IEX Book
entrypoint typedef struct _OrderDeleteMessage {
  UINT8 reserved_1;           // byte 0
  UINT64 timestamp;           // bytes 1 to 8, signed, read here as unsigned
  UINT8 symbol[8];            // bytes 9 to 16
