} OrderDeleteMessage;

// ---- Clear Book Message: 17 bytes --------------------------------------------

// This message is used to indicate that the IEX Book for a symbol has been cleared of all orders
entrypoint typedef struct _ClearBookMessage {
  UINT8 reserved_1;  // byte 0
  UINT64 timestamp;  // bytes 1 to 8, signed, read here as unsigned
