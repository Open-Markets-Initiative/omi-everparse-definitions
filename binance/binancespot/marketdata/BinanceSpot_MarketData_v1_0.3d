// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_TRADES_STREAM_EVENT_MESSAGE 0x2710          // Trades Stream Event Message
#define TEMPLATE_ID_BEST_BID_ASK_STREAM_EVENT_MESSAGE 0x2711    // Best Bid Ask Stream Event Message
#define TEMPLATE_ID_DEPTH_SNAPSHOT_STREAM_EVENT_MESSAGE 0x2712  // Depth Snapshot Stream Event Message
#define TEMPLATE_ID_DEPTH_DIFF_STREAM_EVENT_MESSAGE 0x2713      // Depth Diff Stream Event Message

// Is Buyer Maker: one byte code
#define IS_BUYER_MAKER_FALSE 0x00  // False
#define IS_BUYER_MAKER_TRUE 0x01   // True

// ---- Types -------------------------------------------------------------------

// trades
typedef struct _TradesStreamEventMessageTradesGroup {
  UINT64 id;             // bytes 0 to 7, signed, read here as unsigned
  UINT64 price;          // bytes 8 to 15, signed, read here as unsigned
  UINT64 qty;            // bytes 16 to 23, signed, read here as unsigned
  UINT8 is_buyer_maker;  // byte 24
} TradesStreamEventMessageTradesGroup;

// trades Block
typedef struct _TradesStreamEventMessageTradesGroups {
  UINT16 block_length;                                                                                                   // bytes 0 to 1
  UINT32 num_in_group_uint_32 { num_in_group_uint_32 <= 171798691 };                                                     // bytes 2 to 5
  TradesStreamEventMessageTradesGroup trades_stream_event_message_trades_group[:byte-size (num_in_group_uint_32 * 25)];
} TradesStreamEventMessageTradesGroups;

casetype _OptionalSymbolData (Bool present, UINT32 length) {
  switch (present) {
    case true: UINT8 symbol_data[length];
    case false: unit absent;
  }
} OptionalSymbolData;

// symbol data struct
typedef struct _Symbol {
  UINT8 symbol_length;                                                               // byte 0
  OptionalSymbolData((symbol_length > 0x00), ((UINT32) symbol_length)) symbol_data;
} Symbol;

// TradesStreamEventMessage
typedef struct _TradesStreamEventMessage {
  UINT64 event_time;                                                               // bytes 0 to 7, signed, read here as unsigned
  UINT64 transact_time;                                                            // bytes 8 to 15, signed, read here as unsigned
  UINT8 price_exponent;                                                            // byte 16, signed, read here as unsigned
  UINT8 qty_exponent;                                                              // byte 17, signed, read here as unsigned
  TradesStreamEventMessageTradesGroups trades_stream_event_message_trades_groups;
  Symbol symbol;
} TradesStreamEventMessage;

// BestBidAskStreamEventMessage
typedef struct _BestBidAskStreamEventMessage {
  UINT64 event_time;      // bytes 0 to 7, signed, read here as unsigned
  UINT64 book_update_id;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 price_exponent;   // byte 16, signed, read here as unsigned
  UINT8 qty_exponent;     // byte 17, signed, read here as unsigned
  UINT64 bid_price;       // bytes 18 to 25, signed, read here as unsigned
  UINT64 bid_qty;         // bytes 26 to 33, signed, read here as unsigned
  UINT64 ask_price;       // bytes 34 to 41, signed, read here as unsigned
  UINT64 ask_qty;         // bytes 42 to 49, signed, read here as unsigned
  Symbol symbol;
} BestBidAskStreamEventMessage;

