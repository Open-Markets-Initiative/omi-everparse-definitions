} DepthDiffStreamEventMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x2710: TradesStreamEventMessage trades_stream_event_message;
    case 0x2711: BestBidAskStreamEventMessage best_bid_ask_stream_event_message;
    case 0x2712: DepthSnapshotStreamEventMessage depth_snapshot_stream_event_message;
    case 0x2713: DepthDiffStreamEventMessage depth_diff_stream_event_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Binance Sbe message
typedef struct _SbeMessage (UINT32 available) where (available >= 8) {
  UINT16 block_length;                                                                             // bytes 0 to 1
  UINT16 template_id;                                                                              // bytes 2 to 3
  UINT16 schema_id;                                                                                // bytes 4 to 5
  UINT16 version;                                                                                  // bytes 6 to 7
  Payload(template_id, (available - 8)) payload[:byte-size-single-element-array (available - 8)];
} SbeMessage;

// ---- Packet: Frame -----------------------------------------------------------

// Binance WebSocket binary frame payload: one Sbe message
entrypoint typedef struct _Frame (UINT32 available) {
  SbeMessage(available) sbe_message;
} Frame;

