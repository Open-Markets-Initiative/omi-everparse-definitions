typedef struct _DepthDiffStreamEventMessage {
  UINT64 event_time;                                                                  // bytes 0 to 7, signed, read here as unsigned
  UINT64 first_book_update_id;                                                        // bytes 8 to 15, signed, read here as unsigned
  UINT64 last_book_update_id;                                                         // bytes 16 to 23, signed, read here as unsigned
  UINT8 price_exponent;                                                               // byte 24, signed, read here as unsigned
  UINT8 qty_exponent;                                                                 // byte 25, signed, read here as unsigned
