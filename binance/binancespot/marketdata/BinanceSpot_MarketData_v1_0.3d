// Binance Market Data
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out BinanceSpot_MarketData_v1_0.3d
//
// What this definition does not state, and the model does:
// - the dispatch that chooses a message by its type
// - a block whose stated length holds more than its fields
// - a run counted by a field
// - a field present only on a condition
//
// License: MIT No Attribution

// ---- Message Header: 8 bytes -------------------------------------------------

// Binance Sbe message header block length, template id, schema id and version of the message root
entrypoint typedef struct _MessageHeader {
  UINT16 block_length;  // bytes 0 to 1
  UINT16 template_id;   // bytes 2 to 3
  UINT16 schema_id;     // bytes 4 to 5
  UINT16 version;       // bytes 6 to 7
} MessageHeader;

// ---- Group Size Encoding: 6 bytes --------------------------------------------

// groupSizeEncoding
entrypoint typedef struct _GroupSizeEncoding {
  UINT16 block_length;          // bytes 0 to 1
  UINT32 num_in_group_uint_32;  // bytes 2 to 5
} GroupSizeEncoding;

// ---- Group Size 16 Encoding: 4 bytes -----------------------------------------

// groupSize16Encoding
entrypoint typedef struct _GroupSize16Encoding {
  UINT16 block_length;          // bytes 0 to 1
  UINT16 num_in_group_uint_16;  // bytes 2 to 3
} GroupSize16Encoding;

