// FIX SBE message body
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x4E21: HeartbeatMessage heartbeat_message;
    case 0x4E22: TestRequestMessage test_request_message;
    case 0x4E23: RejectMessage reject_message;
    case 0x4E24: LogoutMessage logout_message;
    case 0x00C6: ExecutionReportAckMessage execution_report_ack_message;
    case 0x0062: ExecutionReportMessage execution_report_message;
    case 0x0060: OrderCancelRejectMessage order_cancel_reject_message;
    case 0x0061: OrderCancelRequestAndNewOrderSingleMessage order_cancel_request_and_new_order_single_message;
    case 0x4E28: LogonMessage logon_message;
    case 0x4E29: LogonAckMessage logon_ack_message;
    case 0x0063: NewOrderSingleMessage new_order_single_message;
    case 0x0064: NewOrderListMessage new_order_list_message;
    case 0x0065: OrderCancelRequestMessage order_cancel_request_message;
    case 0x0066: ListStatusMessage list_status_message;
    case 0x0067: OrderMassCancelRequestMessage order_mass_cancel_request_message;
    case 0x0068: OrderMassCancelReportMessage order_mass_cancel_report_message;
    case 0x0069: OrderAmendKeepPriorityRequestMessage order_amend_keep_priority_request_message;
    case 0x006A: OrderAmendRejectMessage order_amend_reject_message;
    case 0x0078: LimitQueryMessage limit_query_message;
    case 0x0079: LimitResponseMessage limit_response_message;
    case 0x00C8: InstrumentListRequestMessage instrument_list_request_message;
    case 0x00C9: InstrumentListMessage instrument_list_message;
    case 0x00CA: MarketDataRequestMessage market_data_request_message;
    case 0x00CB: MarketDataRequestRejectMessage market_data_request_reject_message;
    case 0x00CC: MarketDataSnapshotMessage market_data_snapshot_message;
    case 0x00CD: MarketDataIncrementalTradeMessage market_data_incremental_trade_message;
    case 0x00CE: MarketDataIncrementalBookTickerMessage market_data_incremental_book_ticker_message;
    case 0x00CF: MarketDataIncrementalDepthMessage market_data_incremental_depth_message;
    case 0x4E84: NewsMessage news_message;
    default: UINT8 unknown[available];
  }
} Payload;

// One FIX SBE message: the unit the Tcp stream repeats
typedef struct _Message {
  UINT32 message_length { message_length >= 26 };                                                              // bytes 0 to 3
  UINT16 encoding_type;                                                                                        // bytes 4 to 5
  UINT16 block_length;                                                                                         // bytes 6 to 7
  UINT16 template_id;                                                                                          // bytes 8 to 9
  UINT16 schema_id;                                                                                            // bytes 10 to 11
  UINT16 version;                                                                                              // bytes 12 to 13
  UINT32 seq_num;                                                                                              // bytes 14 to 17
  UINT64 sending_time;                                                                                         // bytes 18 to 25, signed, read here as unsigned
  Payload(template_id, (message_length - 26)) payload[:byte-size-single-element-array (message_length - 26)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Binance Spot FIX SBE messages carried by a Tcp segment
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

