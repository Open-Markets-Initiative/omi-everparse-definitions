// Bjse Bjtg Session Message
entrypoint typedef struct _Message {
  UINT32BE msg_type;                                                                    // bytes 0 to 3
  UINT32BE body_length;                                                                 // bytes 4 to 7
  Payload(msg_type, body_length) payload[:byte-size-single-element-array body_length];
  MessageTail message_tail;
} Message;

