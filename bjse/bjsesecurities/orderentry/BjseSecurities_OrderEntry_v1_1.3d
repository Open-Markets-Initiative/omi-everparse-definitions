#define TRADE_REPORT_REJECT_REASON_SETTLEMENT_PERIOD_VALUE_INVALID 0x0040                                        // Settlement Period Value Invalid
#define TRADE_REPORT_REJECT_REASON_TIME_IN_FORCE_TYPE_VALUE_INVALID 0x0041                                       // Time In Force Type Value Invalid
#define TRADE_REPORT_REJECT_REASON_SECURITY_CODE_SOURCE_VALUE_INVALID 0x0042                                     // Security Code Source Value Invalid
#define TRADE_REPORT_REJECT_REASON_MAXIMUM_PRICE_LEVELS_VALUE_INVALID 0x0043                                     // Maximum Price Levels Value Invalid
#define TRADE_REPORT_REJECT_REASON_CLEARING_FIRM_CODE_VALUE_INVALID 0x0044                                       // Clearing Firm Code Value Invalid
#define TRADE_REPORT_REJECT_REASON_ORDER_RESTRICTIONS_VALUE_INVALID 0x0045                                       // Order Restrictions Value Invalid
#define TRADE_REPORT_REJECT_REASON_ORDER_OWNER_TYPE_VALUE_INVALID 0x0046                                         // Order Owner Type Value Invalid
#define TRADE_REPORT_REJECT_REASON_SECURITIES_HOLDING_ACCOUNTS_ABOVE_LIMIT 0x0047                                // Securities Holding Accounts Above Limit
#define TRADE_REPORT_REJECT_REASON_INVALID_CODE 0x005F                                                           // Invalid Code
#define TRADE_REPORT_REJECT_REASON_SECURITY_CODE_DOES_NOT_EXIST 0x251D                                           // Security Code Does Not Exist
#define TRADE_REPORT_REJECT_REASON_SECURITY_CODE_VALUE_INVALID 0x251E                                            // Security Code Value Invalid
#define TRADE_REPORT_REJECT_REASON_SECURITY_CODE_FORMAT_INVALID 0x251F                                           // Security Code Format Invalid
#define TRADE_REPORT_REJECT_REASON_ORDER_TIME_FORMAT_INVALID 0x0060                                              // Order Time Format Invalid
#define TRADE_REPORT_REJECT_REASON_ORDER_NUMBER_INVALID 0x0062                                                   // Order Number Invalid
#define TRADE_REPORT_REJECT_REASON_CLIENT_ORDER_OR_TRADE_REPORT_NUMBER_FORMAT_INVALID 0x2649                     // Client Order Or Trade Report Number Format Invalid
#define TRADE_REPORT_REJECT_REASON_ORIGINAL_CLIENT_ORDER_OR_TRADE_REPORT_NUMBER_FORMAT_INVALID 0x264A            // Original Client Order Or Trade Report Number Format Invalid
#define TRADE_REPORT_REJECT_REASON_CLIENT_ORDER_OR_TRADE_REPORT_NUMBER_DUPLICATE 0x264B                          // Client Order Or Trade Report Number Duplicate
#define TRADE_REPORT_REJECT_REASON_OTHER_ERROR 0x0063                                                            // Other Error
#define TRADE_REPORT_REJECT_REASON_ORDER_VALIDATION_METHOD_DOES_NOT_EXIST 0x26AE                                 // Order Validation Method Does Not Exist
#define TRADE_REPORT_REJECT_REASON_ORDER_EXCEPTION_INCONSISTENT_WITH_MESSAGE_DEFINITION 0x26AF                   // Order Exception Inconsistent With Message Definition
#define TRADE_REPORT_REJECT_REASON_PLATFORM_CLOSED 0x4E61                                                        // Platform Closed
#define TRADE_REPORT_REJECT_REASON_APPLICATION_IDENTIFIER_ERROR 0x4E85                                           // Application Identifier Error
#define TRADE_REPORT_REJECT_REASON_SECURITY_DOES_NOT_SUPPORT_THE_BUSINESS 0x4E86                                 // Security Does Not Support The Business
#define TRADE_REPORT_REJECT_REASON_UNPACKING_FAILED 0x4E87                                                       // Unpacking Failed
#define TRADE_REPORT_REJECT_REASON_PLATFORM_NOT_OPEN 0x4E88                                                      // Platform Not Open
#define TRADE_REPORT_REJECT_REASON_GATEWAY_HAS_NO_PERMISSION_FOR_TRADING_UNIT 0x4E89                             // Gateway Has No Permission For Trading Unit
#define TRADE_REPORT_REJECT_REASON_FIELD_VALUE_ERROR 0x4E8A                                                      // Field Value Error
#define TRADE_REPORT_REJECT_REASON_MESSAGE_TYPE_NOT_SUPPORTED 0x4E8B                                             // Message Type Not Supported
#define TRADE_REPORT_REJECT_REASON_ORDER_PLATFORM_ERROR 0x4E8C                                                   // Order Platform Error
#define TRADE_REPORT_REJECT_REASON_GATEWAY_HAS_NO_ORDER_SUBMISSION_PERMISSION 0x4E90                             // Gateway Has No Order Submission Permission
#define TRADE_REPORT_REJECT_REASON_OTHER_ERROR_29999 0x752F                                                      // Other Error 29999

// ---- Types -------------------------------------------------------------------

// The first message the order management system sends to the trading gateway, which confirms a successful logon with a Logon of its own, so both sides transmit this message type.
typedef struct _LogonMessage {
  UINT8 sender_comp_id[20];       // bytes 0 to 19
  UINT8 target_comp_id[20];       // bytes 20 to 39
  UINT32BE heart_bt_int;          // bytes 40 to 43, signed, read here as unsigned
  UINT8 password[16];             // bytes 44 to 59
  UINT8 default_appl_ver_id[32];  // bytes 60 to 91
} LogonMessage;

// Sent by the trading gateway to refuse a logon, and by either side to end the session; the receiver answers with a Logout of its own, so both sides transmit this message type.
typedef struct _LogoutMessage {
  UINT32BE session_status;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 text[200];          // bytes 4 to 203
} LogoutMessage;

// Sent by the trading gateway when a submission fails a basic validity check, such as an unknown security code or a submission outside its time window.
typedef struct _BusinessRejectMessage {
  UINT8 appl_id[3];                  // bytes 0 to 2
  UINT64BE transact_time;            // bytes 3 to 10, signed, read here as unsigned
  UINT8 submitting_pbuid[6];         // bytes 11 to 16
  UINT8 security_id[8];              // bytes 17 to 24
  UINT8 security_id_source[4];       // bytes 25 to 28
  UINT64BE ref_seq_num;              // bytes 29 to 36, signed, read here as unsigned
  UINT32BE ref_msg_type;             // bytes 37 to 40
  UINT8 business_reject_ref_id[10];  // bytes 41 to 50
  UINT16BE business_reject_reason;   // bytes 51 to 52
  UINT8 business_reject_text[50];    // bytes 53 to 102
} BusinessRejectMessage;

// One entry per platform partition the order management system expects to receive
typedef struct _PartitionReports {
  UINT32BE partition_no;  // bytes 0 to 3, signed, read here as unsigned
  UINT64BE report_index;  // bytes 4 to 11, signed, read here as unsigned
} PartitionReports;

// Sent by the order management system after logon to give, for each platform partition, the record number of the next report it expects; the gateway sends no reports for a partition the message omits.
typedef struct _ReportSynchronizationMessage {
  UINT32BE no_partitions { no_partitions <= 357913941 };                // bytes 0 to 3
  PartitionReports partition_reports[:byte-size (no_partitions * 12)];
} ReportSynchronizationMessage;

// Sent by the trading gateway after logon and whenever a platform changes state, so the order management system can control when it submits orders.
typedef struct _PlatformStateInfoMessage {
  UINT16BE platform_id;     // bytes 0 to 1
  UINT16BE platform_state;  // bytes 2 to 3
} PlatformStateInfoMessage;

// Sent by the trading gateway when every report of the trading day for a platform partition has been sent; its record number continues the numbering of the partition's reports.
typedef struct _ReportFinishedMessage {
  UINT32BE partition_no;  // bytes 0 to 3, signed, read here as unsigned
  UINT64BE report_index;  // bytes 4 to 11, signed, read here as unsigned
  UINT16BE platform_id;   // bytes 12 to 13
} ReportFinishedMessage;

// One entry per platform partition
typedef struct _Partitions {
  UINT32BE partition_no;  // bytes 0 to 3, signed, read here as unsigned
} Partitions;

// Sent by the trading gateway after logon, giving the number of partitions of the platform and their numbers, which need not be consecutive.
typedef struct _PlatformInfoMessage {
  UINT16BE platform_id;                                    // bytes 0 to 1
  UINT32BE no_partitions { no_partitions <= 1073741823 };  // bytes 2 to 5
  Partitions partitions[:byte-size (no_partitions * 4)];
} PlatformInfoMessage;

// Sent by the trading gateway after logon and whenever the trading session of the connected platform changes; only the fixed income platform currently sends it.
typedef struct _TradingSessionStatusMessage {
  UINT8 market_id[8];               // bytes 0 to 7
  UINT8 market_segment_id[8];       // bytes 8 to 15
  UINT8 trading_session_id[4];      // bytes 16 to 19
  UINT8 trading_session_sub_id[4];  // bytes 20 to 23
  UINT16BE trad_ses_status;         // bytes 24 to 25
  UINT64BE trad_ses_start_time;     // bytes 26 to 33, signed, read here as unsigned
  UINT64BE trad_ses_end_time;       // bytes 34 to 41, signed, read here as unsigned
} TradingSessionStatusMessage;

// New order for spot bond trading by matching, ApplID 010.
typedef struct _BondSpotMatchingNewOrderMessage {
  UINT8 appl_id[3];             // bytes 0 to 2
  UINT8 submitting_pbuid[6];    // bytes 3 to 8
  UINT8 security_id[8];         // bytes 9 to 16
  UINT8 security_id_source[4];  // bytes 17 to 20
  UINT16BE owner_type;          // bytes 21 to 22
  UINT8 clearing_firm[2];       // bytes 23 to 24
  UINT64BE transact_time;       // bytes 25 to 32, signed, read here as unsigned
  UINT8 user_info[32];          // bytes 33 to 64
  UINT8 cl_ord_id[10];          // bytes 65 to 74
  UINT8 account_id[10];         // bytes 75 to 84
  UINT8 branch_id[2];           // bytes 85 to 86
  UINT8 order_restrictions[4];  // bytes 87 to 90
  UINT8 side;                   // byte 91
  UINT8 ord_type;               // byte 92
  UINT64BE order_qty;           // bytes 93 to 100, signed, read here as unsigned
  UINT64BE price;               // bytes 101 to 108, signed, read here as unsigned
  UINT64BE stop_px;             // bytes 109 to 116, signed, read here as unsigned
  UINT64BE min_qty;             // bytes 117 to 124, signed, read here as unsigned
  UINT16BE max_price_levels;    // bytes 125 to 126
  UINT8 time_in_force;          // byte 127
  UINT8 cash_margin;            // byte 128
  UINT8 settl_type;             // byte 129
  UINT8 settl_period;           // byte 130
} BondSpotMatchingNewOrderMessage;

// New order for centralized auction stock trading, ApplID 040. Not yet enabled.
typedef struct _CentralizedAuctionNewOrderMessage {
  UINT8 appl_id[3];             // bytes 0 to 2
  UINT8 submitting_pbuid[6];    // bytes 3 to 8
  UINT8 security_id[8];         // bytes 9 to 16
  UINT8 security_id_source[4];  // bytes 17 to 20
  UINT16BE owner_type;          // bytes 21 to 22
  UINT8 clearing_firm[2];       // bytes 23 to 24
  UINT64BE transact_time;       // bytes 25 to 32, signed, read here as unsigned
  UINT8 user_info[32];          // bytes 33 to 64
  UINT8 cl_ord_id[10];          // bytes 65 to 74
  UINT8 account_id[10];         // bytes 75 to 84
  UINT8 branch_id[2];           // bytes 85 to 86
  UINT8 order_restrictions[4];  // bytes 87 to 90
  UINT8 side;                   // byte 91
  UINT8 ord_type;               // byte 92
  UINT64BE order_qty;           // bytes 93 to 100, signed, read here as unsigned
  UINT64BE price;               // bytes 101 to 108, signed, read here as unsigned
  UINT64BE stop_px;             // bytes 109 to 116, signed, read here as unsigned
  UINT64BE min_qty;             // bytes 117 to 124, signed, read here as unsigned
  UINT16BE max_price_levels;    // bytes 125 to 126
  UINT8 time_in_force;          // byte 127
  UINT8 cash_margin;            // byte 128
} CentralizedAuctionNewOrderMessage;

