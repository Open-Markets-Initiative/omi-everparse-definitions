// Trade Report Type: one byte code
#define TRADE_REPORT_TYPE_SUBMIT 0x00   // Submit
#define TRADE_REPORT_TYPE_ALLEGED 0x01  // Alleged
#define TRADE_REPORT_TYPE_ACCEPT 0x02   // Accept
#define TRADE_REPORT_TYPE_DECLINE 0x03  // Decline

// Trade Report Trans Type: one byte code
#define TRADE_REPORT_TRANS_TYPE_NEW 0x00      // New
#define TRADE_REPORT_TRANS_TYPE_CANCEL 0x01   // Cancel
#define TRADE_REPORT_TRANS_TYPE_REPLACE 0x02  // Replace

// Trade Handling Instr: one byte code
#define TRADE_HANDLING_INSTR_TRADE_CONFIRM 0x30                      // Trade Confirm
#define TRADE_HANDLING_INSTR_TWO_PARTY_REPORT 0x31                   // Two Party Report
