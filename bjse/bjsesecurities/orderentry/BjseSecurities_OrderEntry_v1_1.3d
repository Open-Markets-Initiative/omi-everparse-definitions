// New order for refinancing securities lending without agreement, ApplID 050. Not yet enabled.
typedef struct _RefinancingSecuritiesLendingNonAgreedNewOrderMessage {
  UINT8 appl_id[3];             // bytes 0 to 2
  UINT8 submitting_pbuid[6];    // bytes 3 to 8
  UINT8 security_id[8];         // bytes 9 to 16
  UINT8 security_id_source[4];  // bytes 17 to 20
