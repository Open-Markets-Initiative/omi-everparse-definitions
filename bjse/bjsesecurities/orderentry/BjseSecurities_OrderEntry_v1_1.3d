  UINT8 expiration_type;        // byte 111
  UINT8 share_property[2];      // bytes 112 to 113
} RefinancingSecuritiesLendingNonAgreedNewOrderMessage;

// Cancels an order; the exchange does not check the original order quantity it carries.
typedef struct _OrderCancelRequestMessage {
  UINT8 appl_id[3];             // bytes 0 to 2
  UINT8 submitting_pbuid[6];    // bytes 3 to 8
  UINT8 security_id[8];         // bytes 9 to 16
  UINT8 security_id_source[4];  // bytes 17 to 20
  UINT16BE owner_type;          // bytes 21 to 22
  UINT8 clearing_firm[2];       // bytes 23 to 24
  UINT64BE transact_time;       // bytes 25 to 32, signed, read here as unsigned
  UINT8 user_info[32];          // bytes 33 to 64
  UINT8 cl_ord_id[10];          // bytes 65 to 74
  UINT8 orig_cl_ord_id[10];     // bytes 75 to 84
  UINT8 account_id[10];         // bytes 85 to 94
  UINT8 branch_id[2];           // bytes 95 to 96
  UINT8 order_id[16];           // bytes 97 to 112
  UINT64BE order_qty;           // bytes 113 to 120, signed, read here as unsigned
} OrderCancelRequestMessage;

// Sent by the trading gateway when an order cancel request fails.
typedef struct _CancelRejectMessage {
  UINT32BE partition_no;        // bytes 0 to 3, signed, read here as unsigned
  UINT64BE report_index;        // bytes 4 to 11, signed, read here as unsigned
  UINT8 appl_id[3];             // bytes 12 to 14
  UINT8 reporting_pbuid[6];     // bytes 15 to 20
  UINT8 submitting_pbuid[6];    // bytes 21 to 26
  UINT8 security_id[8];         // bytes 27 to 34
  UINT8 security_id_source[4];  // bytes 35 to 38
  UINT16BE owner_type;          // bytes 39 to 40
  UINT8 clearing_firm[2];       // bytes 41 to 42
  UINT64BE transact_time;       // bytes 43 to 50, signed, read here as unsigned
  UINT8 user_info[32];          // bytes 51 to 82
  UINT8 cl_ord_id[10];          // bytes 83 to 92
  UINT8 orig_cl_ord_id[10];     // bytes 93 to 102
  UINT8 account_id[10];         // bytes 103 to 112
  UINT8 branch_id[2];           // bytes 113 to 114
  UINT8 ord_status;             // byte 115
  UINT16BE cxl_rej_reason;      // bytes 116 to 117
  UINT8 reject_text[16];        // bytes 118 to 133
  UINT8 order_id[16];           // bytes 134 to 149
} CancelRejectMessage;

// Order response and cancel execution report for spot bond trading by matching, ApplID 010: confirms or rejects a new order, a successful cancel, or an order the system cancels itself.
typedef struct _BondSpotMatchingExecutionReportMessage {
  UINT32BE partition_no;        // bytes 0 to 3, signed, read here as unsigned
  UINT64BE report_index;        // bytes 4 to 11, signed, read here as unsigned
  UINT8 appl_id[3];             // bytes 12 to 14
  UINT8 reporting_pbuid[6];     // bytes 15 to 20
  UINT8 submitting_pbuid[6];    // bytes 21 to 26
  UINT8 security_id[8];         // bytes 27 to 34
  UINT8 security_id_source[4];  // bytes 35 to 38
  UINT16BE owner_type;          // bytes 39 to 40
  UINT8 clearing_firm[2];       // bytes 41 to 42
  UINT64BE transact_time;       // bytes 43 to 50, signed, read here as unsigned
  UINT8 user_info[32];          // bytes 51 to 82
  UINT8 order_id[16];           // bytes 83 to 98
  UINT8 cl_ord_id[10];          // bytes 99 to 108
  UINT8 orig_cl_ord_id[10];     // bytes 109 to 118
  UINT8 exec_id[16];            // bytes 119 to 134
  UINT8 exec_type;              // byte 135
  UINT8 ord_status;             // byte 136
  UINT16BE ord_rej_reason;      // bytes 137 to 138
  UINT64BE leaves_qty;          // bytes 139 to 146, signed, read here as unsigned
  UINT64BE cum_qty;             // bytes 147 to 154, signed, read here as unsigned
  UINT8 side;                   // byte 155
  UINT8 ord_type;               // byte 156
  UINT64BE order_qty;           // bytes 157 to 164, signed, read here as unsigned
  UINT64BE price;               // bytes 165 to 172, signed, read here as unsigned
  UINT8 account_id[10];         // bytes 173 to 182
  UINT8 branch_id[2];           // bytes 183 to 184
  UINT8 order_restrictions[4];  // bytes 185 to 188
  UINT64BE stop_px;             // bytes 189 to 196, signed, read here as unsigned
  UINT64BE min_qty;             // bytes 197 to 204, signed, read here as unsigned
  UINT16BE max_price_levels;    // bytes 205 to 206
  UINT8 time_in_force;          // byte 207
  UINT8 cash_margin;            // byte 208
} BondSpotMatchingExecutionReportMessage;

