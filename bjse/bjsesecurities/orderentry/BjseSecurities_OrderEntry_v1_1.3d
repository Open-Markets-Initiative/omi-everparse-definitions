#define OWNER_TYPE_LIQUIDITY_PROVIDER 0x0069      // Liquidity Provider
#define OWNER_TYPE_CLEARING_FIRM 0x006A           // Clearing Firm

// Side: one byte code
#define SIDE_BUY 0x31        // Buy
#define SIDE_SELL 0x32       // Sell
#define SIDE_BORROW 0x47     // Borrow
#define SIDE_LEND 0x46       // Lend
#define SIDE_SUBSCRIBE 0x44  // Subscribe
#define SIDE_REDEEM 0x45     // Redeem

// Ord Type: one byte code
#define ORD_TYPE_MARKET 0x31         // Market
#define ORD_TYPE_LIMIT 0x32          // Limit
#define ORD_TYPE_BEST_OWN_SIDE 0x55  // Best Own Side

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY 0x30                  // Day
