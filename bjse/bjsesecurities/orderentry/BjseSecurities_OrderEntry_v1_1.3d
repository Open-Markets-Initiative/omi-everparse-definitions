  UINT64BE transact_time;       // bytes 25 to 32, signed, read here as unsigned
  UINT8 user_info[32];          // bytes 33 to 64
  UINT8 cl_ord_id[10];          // bytes 65 to 74
  UINT8 account_id[10];         // bytes 75 to 84
  UINT8 branch_id[2];           // bytes 85 to 86
  UINT8 order_restrictions[4];  // bytes 87 to 90
  UINT8 side;                   // byte 91
