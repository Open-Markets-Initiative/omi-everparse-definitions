} LogonMessage;

// ---- Logout Message: 204 bytes -----------------------------------------------

// Sent by the gateway to refuse a logon request it does not accept; the Vendor Supplied System may also send it to end the connection, so both sides transmit this message type.
entrypoint typedef struct _LogoutMessage {
  UINT32BE session_status;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 text[200];          // bytes 4 to 203
} LogoutMessage;

// ---- Channel Heartbeat Message: 20 bytes -------------------------------------

// Sent on a market data channel every 3 seconds, carrying the sequence number of the last tick message on the channel.
entrypoint typedef struct _ChannelHeartbeatMessage {
  UINT16BE channel_no;         // bytes 0 to 1
  UINT64BE appl_last_seq_num;  // bytes 2 to 9, signed, read here as unsigned
  UINT16BE end_of_channel;     // bytes 10 to 11
  UINT64BE orig_time;          // bytes 12 to 19, signed, read here as unsigned
} ChannelHeartbeatMessage;

// ---- Retransmission Message: 52 bytes ----------------------------------------

// Sent by the Vendor Supplied System to request tick data or announcements again; the gateway returns the data and then the same message type to mark the retransmission complete or report why it failed, so both sides transmit this message type.
entrypoint typedef struct _RetransmissionMessage {
  UINT8 resend_type;          // byte 0
  UINT16BE channel_no;        // bytes 1 to 2
  UINT64BE appl_beg_seq_num;  // bytes 3 to 10, signed, read here as unsigned
  UINT64BE appl_end_seq_num;  // bytes 11 to 18, signed, read here as unsigned
  UINT8 news_id[16];          // bytes 19 to 34
  UINT8 resend_status;        // byte 35
  UINT8 reject_text[16];      // bytes 36 to 51
} RetransmissionMessage;

// ---- Business Reject Message: 74 bytes ---------------------------------------

// Rejects an application message that satisfies the session layer rules but not the business layer rules, mainly an invalid retransmission request.
entrypoint typedef struct _BusinessRejectMessage {
  UINT64BE ref_seq_num;              // bytes 0 to 7, signed, read here as unsigned
