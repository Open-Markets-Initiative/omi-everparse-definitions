// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Cse_Retransmission_v2_8.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_TIME_MESSAGE 0x54                        // Time Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                // System Event Message
#define MESSAGE_TYPE_SYMBOL_DIRECTORY_MESSAGE 0x52            // Symbol Directory Message
#define MESSAGE_TYPE_SYMBOL_DYNAMICS_MESSAGE 0x4F             // Symbol Dynamics Message
#define MESSAGE_TYPE_TRADING_ACTION_MESSAGE 0x48              // Trading Action Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x41                   // Add Order Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45              // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_WITH_PRICE_MESSAGE 0x43   // Order Executed With Price Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x50                       // Trade Message
#define MESSAGE_TYPE_BROKEN_TRADE_MESSAGE 0x42                // Broken Trade Message
#define MESSAGE_TYPE_ORDER_DELETE_MESSAGE 0x44                // Order Delete Message
#define MESSAGE_TYPE_ORDER_REPLACE_MESSAGE 0x55               // Order Replace Message
#define MESSAGE_TYPE_INDICATIVE_PRICE_QUANTITY_MESSAGE 0x49   // Indicative Price Quantity Message
#define MESSAGE_TYPE_BEST_BID_OFFER_MESSAGE 0x51              // Best Bid Offer Message
#define MESSAGE_TYPE_CLOSING_PRICE_MESSAGE 0x46               // Closing Price Message
#define MESSAGE_TYPE_GENERAL_MESSAGE 0x47                     // General Message
#define MESSAGE_TYPE_MOC_IMBALANCE_NOTIFICATION_MESSAGE 0x4D  // Moc Imbalance Notification Message
#define MESSAGE_TYPE_EOP_MOC_IMBALANCE_MESSAGE 0x4C           // Eop Moc Imbalance Message
#define MESSAGE_TYPE_LOGIN_REQUEST_MESSAGE 0x6C               // Login Request Message
#define MESSAGE_TYPE_LOGIN_RESPONSE_MESSAGE 0x61              // Login Response Message
#define MESSAGE_TYPE_RETRANSMISSION_REQUEST_MESSAGE 0x72      // Retransmission Request Message
#define MESSAGE_TYPE_RETRANSMISSION_RESPONSE_MESSAGE 0x62     // Retransmission Response Message
#define MESSAGE_TYPE_SPIN_REQUEST_MESSAGE 0x73                // Spin Request Message
#define MESSAGE_TYPE_SPIN_RESPONSE_MESSAGE 0x63               // Spin Response Message
#define MESSAGE_TYPE_HEARTBEAT_MESSAGE 0x68                   // Heartbeat Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES_THE_FIRST_MESSAGE_IS_SENT 0x4F                                       // Start Of Messages The First Message Is Sent
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53                                                             // Start Of System Hours
#define EVENT_CODE_PRE_OPEN_AUCTION_PERIOD_BEGINS_THE_EXCHANGE_IS_OPEN_AND_READY_TO_START_AC_bn2tna 0x56  // Pre Open Auction Period Begins The Exchange Is Open And Ready To Start Accepting Orders
#define EVENT_CODE_START_OF_MARKET_HOURS_THE_PRE_OPEN_AUCTION_IS_CONCLUDED_AND_CONTINUOUS_TR_ysz6h5 0x51  // Start Of Market Hours The Pre Open Auction Is Concluded And Continuous Trading Begins
#define EVENT_CODE_END_OF_MARKET_HOURS_INDICATES_THE_END_OF_CONTINUOUS_TRADING 0x4D                       // End Of Market Hours Indicates The End Of Continuous Trading
#define EVENT_CODE_END_OF_SYSTEM_HOURS_INDICATES_THE_EXCHANGE_IS_CLOSED 0x45                              // End Of System Hours Indicates The Exchange Is Closed
#define EVENT_CODE_END_OF_MESSAGES_THE_LAST_MESSAGE_SENT 0x43                                             // End Of Messages The Last Message Sent
#define EVENT_CODE_CCP_EXTENDED_SESSION_IS_OPEN 0x58                                                      // Ccp Extended Session Is Open
#define EVENT_CODE_CCP_EXTENDED_SESSION_IS_CLOSED 0x4E                                                    // Ccp Extended Session Is Closed
#define EVENT_CODE_FAILOVER_EVENT 0x5A                                                                    // Failover Event
#define EVENT_CODE_MOC_IMBALANCE 0x49                                                                     // Moc Imbalance
#define EVENT_CODE_MOC_FREEZE 0x46                                                                        // Moc Freeze
#define EVENT_CODE_MOC_CLOSING_PRICE_DETERMINATION 0x41                                                   // Moc Closing Price Determination
#define EVENT_CODE_EOP_STARTS 0x50                                                                        // Eop Starts
#define EVENT_CODE_EOP_CLOSING_PRICE_DETERMINATION 0x42                                                   // Eop Closing Price Determination

// Stock Group: 8 byte code
#define STOCK_GROUP_C_S_E_LISTED_SECURITIES 0x0000000000000001           // CSE Listed Securities
#define STOCK_GROUP_OTHER_CANADIAN_LISTED_SECURITIES 0x0000000000000002  // Other Canadian Listed Securities

// Listing Market: one byte code
#define LISTING_MARKET_CSE 0x43          // Cse
#define LISTING_MARKET_TSE 0x54          // Tse
#define LISTING_MARKET_TSXV 0x56         // Tsxv
#define LISTING_MARKET_ALPHA 0x41        // Alpha
#define LISTING_MARKET_CBOE_CANADA 0x4E  // Cboe Canada

// Listing Tier: one byte code
#define LISTING_TIER_NO_TIER 0x00       // No Tier
#define LISTING_TIER_SENIOR_TIER 0x01   // Senior Tier
#define LISTING_TIER_VENTURE_TIER 0x02  // Venture Tier

// Gmf Setting: one byte code
#define GMF_SETTING_GMF_ENABLED 0x59   // Gmf Enabled
#define GMF_SETTING_GMF_DISABLED 0x4E  // Gmf Disabled

// Anonymous Setting: one byte code
#define ANONYMOUS_SETTING_ANONYMOUS_ENABLED 0x59   // Anonymous Enabled
#define ANONYMOUS_SETTING_ANONYMOUS_DISABLED 0x4E  // Anonymous Disabled

// Moc Eligible: one byte code
#define MOC_ELIGIBLE_MOC_ELIGIBLE 0x59      // Moc Eligible
#define MOC_ELIGIBLE_NOT_MOC_ELIGIBLE 0x4E  // Not Moc Eligible

// Trading State: one byte code
#define TRADING_STATE_NORMAL_TRADING 0x4E   // Normal Trading
#define TRADING_STATE_SUSPEND_TRADING 0x56  // Suspend Trading
#define TRADING_STATE_HALT 0x48             // Halt
#define TRADING_STATE_DELAYED_OPEN 0x44     // Delayed Open
#define TRADING_STATE_CLOSING_DELAYED 0x45  // Closing Delayed

// Order Verb: one byte code
#define ORDER_VERB_BUY 0x42   // Buy
#define ORDER_VERB_SELL 0x53  // Sell

// Odd Lot Flag: one byte code
#define ODD_LOT_FLAG_ODD_LOT_ORDER 0x59   // Odd Lot Order
#define ODD_LOT_FLAG_NOT_AN_ODD_LOT 0x4E  // Not An Odd Lot

// Trade Attribute: one byte code
#define TRADE_ATTRIBUTE_BY_PASS_ORDER 0x42  // By Pass Order
#define TRADE_ATTRIBUTE_DEFAULT 0x20        // Default

// Cross Type: one byte code
#define CROSS_TYPE_REGULAR 0x52                               // Regular
#define CROSS_TYPE_INTERNAL 0x49                              // Internal
#define CROSS_TYPE_CONTINGENT 0x43                            // Contingent
#define CROSS_TYPE_BASIS 0x42                                 // Basis
#define CROSS_TYPE_VWAP 0x56                                  // Vwap
#define CROSS_TYPE_DERIVATIVE_RELATED 0x44                    // Derivative Related
#define CROSS_TYPE_OTHERWISE_EMPTY_STRING_NOT_SPECIFIED 0x20  // Otherwise Empty String Not Specified
#define CROSS_TYPE_CCP_CLOSING_PRICE 0x53                     // Ccp Closing Price
#define CROSS_TYPE_NET_ASSET_VALUE_NAV 0x4E                   // Net Asset Value Nav

// Sets The Last Price: one byte code
#define SETS_THE_LAST_PRICE_LAST_SALE 0x59      // Last Sale
#define SETS_THE_LAST_PRICE_NOT_LAST_SALE 0x4E  // Not Last Sale

// Opening Trade: one byte code
#define OPENING_TRADE_OPENING_TRADE 0x59      // Opening Trade
#define OPENING_TRADE_NOT_OPENING_TRADE 0x4E  // Not Opening Trade

// Ccp Session Trade: one byte code
#define CCP_SESSION_TRADE_CCP_SESSION_TRADE 0x59      // Ccp Session Trade
#define CCP_SESSION_TRADE_NOT_CCP_SESSION_TRADE 0x4E  // Not Ccp Session Trade

// Moc Trade Marker: one byte code
#define MOC_TRADE_MARKER_MOC_OR_LOC_TRADE 0x59      // Moc Or Loc Trade
#define MOC_TRADE_MARKER_NOT_MOC_OR_LOC_TRADE 0x4E  // Not Moc Or Loc Trade

// Reason: one byte code
#define REASON_SUPERVISORY_THE_TRADE_WAS_MANUALLY_BROKEN_BY_THE_EXCHANGE 0x53  // Supervisory The Trade Was Manually Broken By The Exchange
#define REASON_AMENDED 0x41                                                    // Amended

// Moc And Loc Only Imbalance Side: one byte code
#define MOC_AND_LOC_ONLY_IMBALANCE_SIDE_BUY 0x42             // Buy
#define MOC_AND_LOC_ONLY_IMBALANCE_SIDE_SELL 0x53            // Sell
#define MOC_AND_LOC_ONLY_IMBALANCE_SIDE_NOT_APPLICABLE 0x20  // Not Applicable

// Market Order Imbalance Side: one byte code
#define MARKET_ORDER_IMBALANCE_SIDE_BUY 0x42             // Buy
#define MARKET_ORDER_IMBALANCE_SIDE_SELL 0x53            // Sell
#define MARKET_ORDER_IMBALANCE_SIDE_NOT_APPLICABLE 0x20  // Not Applicable

// System Event: one byte code
#define SYSTEM_EVENT_CLOSING_DELAYED 0x45  // Closing Delayed

// Login Status: one byte code
#define LOGIN_STATUS_LOGIN_ACCEPTED 0x59  // Login Accepted

// Retransmission Status: one byte code
#define RETRANSMISSION_STATUS_RETRANSMISSION_WILL_FOLLOW 0x59  // Retransmission Will Follow
#define RETRANSMISSION_STATUS_REQUEST_IGNORED 0x4E             // Request Ignored

// Spin Status: one byte code
#define SPIN_STATUS_SPIN_ACKNOWLEDGED 0x53  // Spin Acknowledged
#define SPIN_STATUS_END_OF_SPIN 0x45        // End Of Spin

// ---- Types -------------------------------------------------------------------

// Anchors the feed clock. Every following message states its own time as nanoseconds elapsed since this message.
typedef struct _TimeMessage {
  UINT32BE second;       // bytes 0 to 3
  UINT16BE millisecond;  // bytes 4 to 5
} TimeMessage;

// Signals a market or data feed handler event, either for the system as a whole or for one symbol group.
typedef struct _SystemEventMessage {
  UINT32BE time_offset;         // bytes 0 to 3
  UINT64BE group;               // bytes 4 to 11
  UINT8 event_code;             // byte 12
  UINT64BE exchange_timestamp;  // bytes 13 to 20
} SystemEventMessage;

// Static properties of a symbol. Sent for every symbol in the morning, and again during the day if a symbol changes.
typedef struct _SymbolDirectoryMessage {
  UINT32BE time_offset;                 // bytes 0 to 3
  UINT8 symbol[12];                     // bytes 4 to 15
  UINT8 cusip[12];                      // bytes 16 to 27
  UINT8 sec_name[15];                   // bytes 28 to 42
  UINT8 currency[3];                    // bytes 43 to 45
  UINT64BE stock_group;                 // bytes 46 to 53
  UINT64BE listing;                     // bytes 54 to 61
  UINT64BE expiry;                      // bytes 62 to 69
  UINT32BE lot_size;                    // bytes 70 to 73
  UINT8 settlement_term[8];             // bytes 74 to 81
  UINT8 listing_market;                 // byte 82
  UINT32BE previous_closing_price;      // bytes 83 to 86
  UINT8 listing_tier;                   // byte 87
  UINT8 market_maker_name[20];          // bytes 88 to 107
  UINT8 market_maker_phone_number[12];  // bytes 108 to 119
  UINT8 full_sec_name[75];              // bytes 120 to 194
} SymbolDirectoryMessage;

// Values and rules for a symbol that can be updated intra-day. Sent for every symbol in the morning, and again during the day if a symbol changes.
typedef struct _SymbolDynamicsMessage {
  UINT32BE time_offset;      // bytes 0 to 3
  UINT8 symbol[12];          // bytes 4 to 15
  UINT8 settlement_term[8];  // bytes 16 to 23
  UINT8 gmf_setting;         // byte 24
  UINT64BE gmf_volume;       // bytes 25 to 32
  UINT8 anonymous_setting;   // byte 33
  UINT8 moc_eligible;        // byte 34
} SymbolDynamicsMessage;

// Current trading state for a symbol. A symbol suspended intra-day with V is unsuspended with N .
typedef struct _TradingActionMessage {
  UINT32BE time_offset;         // bytes 0 to 3
  UINT8 symbol[12];             // bytes 4 to 15
  UINT8 trading_state;          // byte 16
  UINT64BE exchange_timestamp;  // bytes 17 to 24
} TradingActionMessage;

// A new order added to the displayed book.
typedef struct _AddOrderMessage {
  UINT32BE time_offset;         // bytes 0 to 3
  UINT8 order_number[18];       // bytes 4 to 21
  UINT8 order_verb;             // byte 22
  UINT32BE quantity;            // bytes 23 to 26
  UINT8 symbol[12];             // bytes 27 to 38
  UINT32BE price;               // bytes 39 to 42
  UINT8 firm_id[3];             // bytes 43 to 45
  UINT8 settlement_term[8];     // bytes 46 to 53
  UINT8 odd_lot_flag;           // byte 54
  UINT64BE exchange_timestamp;  // bytes 55 to 62
  UINT64BE priority_timestamp;  // bytes 63 to 70
} AddOrderMessage;

// An order on the book executed in whole or in part at the price it was displayed at.
typedef struct _OrderExecutedMessage {
  UINT32BE time_offset;         // bytes 0 to 3
  UINT8 order_number[18];       // bytes 4 to 21
  UINT32BE executed_quantity;   // bytes 22 to 25
  UINT8 match_number[18];       // bytes 26 to 43
  UINT64BE exchange_timestamp;  // bytes 44 to 51
} OrderExecutedMessage;

// An order on the book executed in whole or in part at a price other than the one it was displayed at.
typedef struct _OrderExecutedWithPriceMessage {
  UINT32BE time_offset;         // bytes 0 to 3
  UINT8 order_number[18];       // bytes 4 to 21
  UINT32BE executed_quantity;   // bytes 22 to 25
  UINT8 match_number[18];       // bytes 26 to 43
  UINT32BE execution_price;     // bytes 44 to 47
  UINT64BE exchange_timestamp;  // bytes 48 to 55
} OrderExecutedWithPriceMessage;

// A trade that does not change the displayed book, carrying the full attribution and classification of the execution.
typedef struct _TradeMessage {
  UINT32BE time_offset;         // bytes 0 to 3
  UINT32BE executed_quantity;   // bytes 4 to 7
  UINT8 symbol[12];             // bytes 8 to 19
  UINT32BE execution_price;     // bytes 20 to 23
  UINT8 match_number[18];       // bytes 24 to 41
  UINT8 firm_id[3];             // bytes 42 to 44
  UINT8 contra_firm_id[3];      // bytes 45 to 47
  UINT8 settlement_term[8];     // bytes 48 to 55
  UINT8 trade_attribute;        // byte 56
  UINT8 cross_type;             // byte 57
  UINT8 odd_lot_flag;           // byte 58
  UINT8 sets_the_last_price;    // byte 59
  UINT64BE exchange_timestamp;  // bytes 60 to 67
  UINT8 opening_trade;          // byte 68
  UINT8 ccp_session_trade;      // byte 69
  UINT8 moc_trade_marker;       // byte 70
} TradeMessage;

// A previously transmitted execution that has been broken, naming the match number it cancels.
typedef struct _BrokenTradeMessage {
  UINT32BE time_offset;         // bytes 0 to 3
  UINT8 match_number[18];       // bytes 4 to 21
  UINT8 reason;                 // byte 22
  UINT64BE exchange_timestamp;  // bytes 23 to 30
} BrokenTradeMessage;

// An order cancelled and removed from the displayed book.
typedef struct _OrderDeleteMessage {
  UINT32BE time_offset;         // bytes 0 to 3
  UINT8 order_number[18];       // bytes 4 to 21
  UINT64BE exchange_timestamp;  // bytes 22 to 29
} OrderDeleteMessage;

// An order on the book replaced with a new quantity and price, keeping its order number.
typedef struct _OrderReplaceMessage {
  UINT32BE time_offset;         // bytes 0 to 3
  UINT8 order_number[18];       // bytes 4 to 21
  UINT32BE quantity;            // bytes 22 to 25
  UINT32BE price;               // bytes 26 to 29
  UINT64BE exchange_timestamp;  // bytes 30 to 37
} OrderReplaceMessage;

// The theoretical opening price and matchable quantity for a symbol during an auction.
typedef struct _IndicativePriceQuantityMessage {
  UINT32BE time_offset;                   // bytes 0 to 3
  UINT64BE theoretical_opening_quantity;  // bytes 4 to 11
  UINT8 symbol[12];                       // bytes 12 to 23
  UINT32BE theoretical_opening_price;     // bytes 24 to 27
  UINT64BE exchange_timestamp;            // bytes 28 to 35
} IndicativePriceQuantityMessage;

// The best bid and offer for a symbol with the quantity at each. During an auction with an indicative price set, the indicative price overwrites both sides.
typedef struct _BestBidOfferMessage {
  UINT32BE time_offset;         // bytes 0 to 3
  UINT8 symbol[12];             // bytes 4 to 15
  UINT32BE best_bid;            // bytes 16 to 19
  UINT32BE best_bid_size;       // bytes 20 to 23
  UINT32BE best_offer;          // bytes 24 to 27
  UINT32BE best_offer_size;     // bytes 28 to 31
  UINT64BE exchange_timestamp;  // bytes 32 to 39
} BestBidOfferMessage;

// The closing price for a symbol.
typedef struct _ClosingPriceMessage {
  UINT32BE time_offset;  // bytes 0 to 3
  UINT8 symbol[12];      // bytes 4 to 15
  UINT32BE price;        // bytes 16 to 19
} ClosingPriceMessage;

// Free text bulletin from the exchange.
typedef struct _GeneralMessage {
  UINT32BE time_offset;     // bytes 0 to 3
  UINT8 message_text[128];  // bytes 4 to 131
} GeneralMessage;

// The market-on-close imbalance for a symbol, disseminated at regular intervals from the beginning of the MOC Imbalance state until 10 seconds before the close.
typedef struct _MocImbalanceNotificationMessage {
  UINT32BE time_offset;                        // bytes 0 to 3
  UINT8 symbol[12];                            // bytes 4 to 15
  UINT8 moc_and_loc_only_imbalance_side;       // byte 16
  UINT32BE moc_imbalance_reference_price;      // bytes 17 to 20
  UINT64BE moc_and_loc_only_imbalance_volume;  // bytes 21 to 28
  UINT64BE moc_and_loc_only_paired_volume;     // bytes 29 to 36
  UINT8 market_order_imbalance_side;           // byte 37
  UINT64BE market_order_imbalance_volume;      // bytes 38 to 45
  UINT32BE moc_indicative_closing_price;       // bytes 46 to 49
  UINT32BE moc_and_loc_only_closing_price;     // bytes 50 to 53
  UINT8 price_variation[5];                    // bytes 54 to 58
  UINT64BE exchange_timestamp;                 // bytes 59 to 66
} MocImbalanceNotificationMessage;

// The market-on-close imbalance during an Extended Offset Period, which affects only symbols in a Closing Delayed state. Transmitted once, after the MOC closing price calculation is complete.
typedef struct _EopMocImbalanceMessage {
  UINT32BE time_offset;                        // bytes 0 to 3
  UINT8 system_event;                          // byte 4
  UINT8 symbol[12];                            // bytes 5 to 16
  UINT32BE moc_imbalance_reference_price;      // bytes 17 to 20
  UINT8 moc_and_loc_only_imbalance_side;       // byte 21
  UINT64BE moc_and_loc_only_imbalance_volume;  // bytes 22 to 29
  UINT64BE exchange_timestamp;                 // bytes 30 to 37
} EopMocImbalanceMessage;

// The first message a client sends once a Tcp connection to the Retransmission or Spin server is established.
typedef struct _LoginRequestMessage {
  UINT8 user_id[16];   // bytes 0 to 15
  UINT8 password[16];  // bytes 16 to 31
} LoginRequestMessage;

// Reply to a Login Request. Always Y : an invalid user id or password is signalled by the exchange closing the socket after 5 seconds without a response.
typedef struct _LoginResponseMessage {
  UINT8 user_id[16];   // bytes 0 to 15
  UINT8 login_status;  // byte 16
} LoginResponseMessage;

// Asks the exchange to replay a range of sequenced messages the client missed.
typedef struct _RetransmissionRequestMessage {
  UINT32BE start_sequence;      // bytes 0 to 3
  UINT32BE number_of_messages;  // bytes 4 to 7
} RetransmissionRequestMessage;

// States whether the requested retransmission will follow. The replayed messages are framed exactly as the multicast feed sent them.
typedef struct _RetransmissionResponseMessage {
  UINT32BE start_sequence;      // bytes 0 to 3
  UINT32BE number_of_messages;  // bytes 4 to 7
  UINT8 retransmission_status;  // byte 8
} RetransmissionResponseMessage;

// Asks for a snapshot of the whole order book, used by a client that has lost its book rather than detected a gap.
typedef struct _SpinRequestMessage {
  UINT32BE client_identifier;  // bytes 0 to 3
} SpinRequestMessage;

// Brackets a book snapshot. The exchange acknowledges the spin request with S , retransmits the book over the same socket, then sends a second response with E to mark the end.
typedef struct _SpinResponseMessage {
  UINT32BE client_identifier;  // bytes 0 to 3
  UINT8 spin_status;           // byte 4
} SpinResponseMessage;

// Sent by the exchange once per defined period for line integrity testing. The client must send the same message back on receipt, and two consecutive missed heartbeats terminate the connection.
typedef struct _HeartbeatMessage {
  UINT32BE client_identifier;  // bytes 0 to 3
} HeartbeatMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: TimeMessage time_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x52: SymbolDirectoryMessage symbol_directory_message;
    case 0x4F: SymbolDynamicsMessage symbol_dynamics_message;
    case 0x48: TradingActionMessage trading_action_message;
    case 0x41: AddOrderMessage add_order_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceMessage order_executed_with_price_message;
    case 0x50: TradeMessage trade_message;
    case 0x42: BrokenTradeMessage broken_trade_message;
    case 0x44: OrderDeleteMessage order_delete_message;
    case 0x55: OrderReplaceMessage order_replace_message;
    case 0x49: IndicativePriceQuantityMessage indicative_price_quantity_message;
    case 0x51: BestBidOfferMessage best_bid_offer_message;
    case 0x46: ClosingPriceMessage closing_price_message;
    case 0x47: GeneralMessage general_message;
    case 0x4D: MocImbalanceNotificationMessage moc_imbalance_notification_message;
    case 0x4C: EopMocImbalanceMessage eop_moc_imbalance_message;
    case 0x6C: LoginRequestMessage login_request_message;
    case 0x61: LoginResponseMessage login_response_message;
    case 0x72: RetransmissionRequestMessage retransmission_request_message;
    case 0x62: RetransmissionResponseMessage retransmission_response_message;
    case 0x73: SpinRequestMessage spin_request_message;
    case 0x63: SpinResponseMessage spin_response_message;
    case 0x68: HeartbeatMessage heartbeat_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Cnsx Mmd sub message: a two byte sub header and a payload the message type selects
typedef struct _Message (mutable UINT32 * tally) {
  UINT8 sub_length { sub_length >= 2 };                                                                                                                            // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) sub_length) - 2)) payload[:byte-size-single-element-array (((UINT32) sub_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// A block header followed by Number of Messages message(s)
typedef struct _Block (mutable UINT32 * tally) {
  UINT16BE block_length { block_length >= 7 };                                                                                         // bytes 0 to 1
  UINT8 block_number_of_messages;                                                                                                      // byte 2
  UINT32BE block_start_sequence;                                                                                                       // bytes 3 to 6
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (((UINT32) block_length) - 7)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) block_number_of_messages); };
} Block;

// ---- Packet: Packet ----------------------------------------------------------

// Cnsx Mmd Tcp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) {
  Block(tally) block[:byte-size available];
} Packet;

