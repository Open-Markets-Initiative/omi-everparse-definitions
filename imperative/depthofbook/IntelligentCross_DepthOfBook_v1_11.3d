// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out IntelligentCross_DepthOfBook_v1_11.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_MARKET_EVENT_MESSAGE 0x41          // Market Event Message
#define MESSAGE_TYPE_SYMBOL_INFORMATION_MESSAGE 0x42    // Symbol Information Message
#define MESSAGE_TYPE_SYMBOL_STATE_MESSAGE 0x43          // Symbol State Message
#define MESSAGE_TYPE_NEW_ORDER_ADD_MESSAGE 0x44         // New Order Add Message
#define MESSAGE_TYPE_ORDER_PARTIAL_CANCEL_MESSAGE 0x46  // Order Partial Cancel Message
#define MESSAGE_TYPE_ORDER_CANCEL_ALL_MESSAGE 0x47      // Order Cancel All Message
#define MESSAGE_TYPE_ORDER_UPDATED_MESSAGE 0x48         // Order Updated Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x4A        // Order Executed Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x4B                 // Trade Message
#define MESSAGE_TYPE_TRADE_BREAK_MESSAGE 0x4D           // Trade Break Message

// Event: one byte code
#define EVENT_START_OF_SESSION 0x4F              // Start Of Session
#define EVENT_MARKET_ACCEPTING_ORDERS 0x53       // Market Accepting Orders
#define EVENT_MARKET_OPEN_FOR_TRADING 0x51       // Market Open For Trading
#define EVENT_MARKET_TRADING_ENDED_FOR_DAY 0x45  // Market Trading Ended For Day
#define EVENT_END_OF_SESSION 0x43                // End Of Session

// Listing Market: one byte code
#define LISTING_MARKET_NYSE 0x4E    // Nyse
#define LISTING_MARKET_NASDAQ 0x51  // Nasdaq
#define LISTING_MARKET_ARCA 0x50    // Arca
#define LISTING_MARKET_BATS_Z 0x5A  // Bats Z
#define LISTING_MARKET_AMEX 0x41    // Amex
#define LISTING_MARKET_IEX 0x56     // Iex

// State: one byte code
#define STATE_MATCHING_INACTIVE 0x49  // Matching Inactive
#define STATE_MATCHING_ACTIVE 0x41    // Matching Active
#define STATE_DISABLED 0x44           // Disabled
#define STATE_ENABLED 0x45            // Enabled

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// ---- Types -------------------------------------------------------------------

// This message appears on all quote channels and indicates the beginning of a spin message cycle
typedef struct _MarketEventMessage {
  UINT8 reserved_2[2];  // bytes 0 to 1
  UINT64 timestamp;     // bytes 2 to 9
  UINT8 event;          // byte 10
} MarketEventMessage;

// Symbol Information
typedef struct _SymbolInformationMessage {
  UINT16 symbol_id;       // bytes 0 to 1
  UINT64 timestamp;       // bytes 2 to 9
  UINT8 symbol[11];       // bytes 10 to 20
  UINT8 listing_market;   // byte 21
  UINT8 reserved_1;       // byte 22
  UINT32 round_lot_size;  // bytes 23 to 26
} SymbolInformationMessage;

// Symbol State
typedef struct _SymbolStateMessage {
  UINT16 symbol_id;  // bytes 0 to 1
  UINT64 timestamp;  // bytes 2 to 9
  UINT8 symbol[11];  // bytes 10 to 20
  UINT8 state;       // byte 21
  UINT8 reserved_1;  // byte 22
  UINT8 info[4];     // bytes 23 to 26
} SymbolStateMessage;

// New Order Add
typedef struct _NewOrderAddMessage {
  UINT16 symbol_id;     // bytes 0 to 1
  UINT64 timestamp;     // bytes 2 to 9
  UINT64 order_id;      // bytes 10 to 17
  UINT8 side;           // byte 18
  UINT32 shares;        // bytes 19 to 22
  UINT8 symbol[11];     // bytes 23 to 33
  UINT64 price;         // bytes 34 to 41, signed, read here as unsigned
  UINT8 reserved_4[4];  // bytes 42 to 45
} NewOrderAddMessage;

// Order Partial Cancel
typedef struct _OrderPartialCancelMessage {
  UINT16 symbol_id;        // bytes 0 to 1
  UINT64 timestamp;        // bytes 2 to 9
  UINT64 order_id;         // bytes 10 to 17
  UINT32 shares_canceled;  // bytes 18 to 21
} OrderPartialCancelMessage;

// Order Cancel All
typedef struct _OrderCancelAllMessage {
  UINT16 symbol_id;  // bytes 0 to 1
  UINT64 timestamp;  // bytes 2 to 9
  UINT64 order_id;   // bytes 10 to 17
} OrderCancelAllMessage;

// Order Updated
typedef struct _OrderUpdatedMessage {
  UINT16 symbol_id;  // bytes 0 to 1
  UINT64 timestamp;  // bytes 2 to 9
  UINT64 order_id;   // bytes 10 to 17
  UINT32 shares;     // bytes 18 to 21
  UINT64 price;      // bytes 22 to 29, signed, read here as unsigned
} OrderUpdatedMessage;

// Sent when a visible order is executed
typedef struct _OrderExecutedMessage {
  UINT16 symbol_id;     // bytes 0 to 1
  UINT64 timestamp;     // bytes 2 to 9
  UINT64 order_id;      // bytes 10 to 17
  UINT32 shares;        // bytes 18 to 21
  UINT64 execution_id;  // bytes 22 to 29
  UINT8 reserved_1;     // byte 30
  UINT64 price;         // bytes 31 to 38, signed, read here as unsigned
} OrderExecutedMessage;

// Sent when a hidden order is executed
typedef struct _TradeMessage {
  UINT16 symbol_id;     // bytes 0 to 1
  UINT64 timestamp;     // bytes 2 to 9
  UINT64 reserved_8;    // bytes 10 to 17
  UINT8 reserved_1;     // byte 18
  UINT32 shares;        // bytes 19 to 22
  UINT8 symbol[11];     // bytes 23 to 33
  UINT64 price;         // bytes 34 to 41, signed, read here as unsigned
  UINT64 execution_id;  // bytes 42 to 49
} TradeMessage;

// Trade Break
typedef struct _TradeBreakMessage {
  UINT16 symbol_id;     // bytes 0 to 1
  UINT64 timestamp;     // bytes 2 to 9
  UINT64 execution_id;  // bytes 10 to 17
} TradeBreakMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: MarketEventMessage market_event_message;
    case 0x42: SymbolInformationMessage symbol_information_message;
    case 0x43: SymbolStateMessage symbol_state_message;
    case 0x44: NewOrderAddMessage new_order_add_message;
    case 0x46: OrderPartialCancelMessage order_partial_cancel_message;
    case 0x47: OrderCancelAllMessage order_cancel_all_message;
    case 0x48: OrderUpdatedMessage order_updated_message;
    case 0x4A: OrderExecutedMessage order_executed_message;
    case 0x4B: TradeMessage trade_message;
    case 0x4D: TradeBreakMessage trade_break_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16 length { length >= 1 };                                                                                                                                   // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, ((((UINT32) length) + 2) - 3)) payload[:byte-size-single-element-array ((((UINT32) length) + 2) - 3)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Aspen Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 market_day_identifier[9];                                                                                   // bytes 0 to 8
  UINT8 feed_identifier;                                                                                            // byte 9
  UINT64 sequence;                                                                                                  // bytes 10 to 17
  UINT16 count;                                                                                                     // bytes 18 to 19
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 20)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) count); };
} Packet;

