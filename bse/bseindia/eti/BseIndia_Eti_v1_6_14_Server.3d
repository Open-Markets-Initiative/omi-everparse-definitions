#define RISK_MODE_STATUS_IN 0x01   // In
#define RISK_MODE_STATUS_OUT 0x02  // Out

// List Update Action: one byte code
#define LIST_UPDATE_ACTION_ADD 0x41     // Add
#define LIST_UPDATE_ACTION_DELETE 0x44  // Delete

// Risk Limit Action: one byte code
#define RISK_LIMIT_ACTION_WARNING 0x04        // Warning
#define RISK_LIMIT_ACTION_QUEUE_INBOUND 0x00  // Queue Inbound
#define RISK_LIMIT_ACTION_REJECT 0x02         // Reject

