// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out BseIndia_Eobi_v1_4.3d

// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_HEARTBEAT_MESSAGE 0x32C9                   // Heartbeat Message
#define TEMPLATE_ID_PRODUCT_SUMMARY_MESSAGE 0x3520             // Product Summary Message
#define TEMPLATE_ID_SNAPSHOT_ORDER_MESSAGE 0x3522              // Snapshot Order Message
#define TEMPLATE_ID_INSTRUMENT_SUMMARY_MESSAGE 0x3521          // Instrument Summary Message
#define TEMPLATE_ID_AUCTION_BEST_BID_OFFER_MESSAGE 0x34BC      // Auction Best Bid Offer Message
#define TEMPLATE_ID_AUCTION_CLEARING_PRICE_MESSAGE 0x34BD      // Auction Clearing Price Message
#define TEMPLATE_ID_TOP_OF_BOOK_MESSAGE 0x34C0                 // Top Of Book Message
#define TEMPLATE_ID_ORDER_ADD_MESSAGE 0x332C                   // Order Add Message
#define TEMPLATE_ID_ORDER_MODIFY_MESSAGE 0x332D                // Order Modify Message
#define TEMPLATE_ID_ORDER_MODIFY_SAME_PRIORITY_MESSAGE 0x3332  // Order Modify Same Priority Message
#define TEMPLATE_ID_ORDER_DELETE_MESSAGE 0x332E                // Order Delete Message
#define TEMPLATE_ID_ORDER_MASS_DELETE_MESSAGE 0x332F           // Order Mass Delete Message
#define TEMPLATE_ID_PARTIAL_ORDER_EXECUTION_MESSAGE 0x3331     // Partial Order Execution Message
#define TEMPLATE_ID_FULL_ORDER_EXECUTION_MESSAGE 0x3330        // Full Order Execution Message
#define TEMPLATE_ID_TRADE_REVERSAL_MESSAGE 0x3390              // Trade Reversal Message
#define TEMPLATE_ID_EXECUTION_SUMMARY_MESSAGE 0x3392           // Execution Summary Message
#define TEMPLATE_ID_INSTRUMENT_INFO_MESSAGE 0x3393             // Instrument Info Message
#define TEMPLATE_ID_LPP_RANGE_MESSAGE 0x3394                   // Lpp Range Message
#define TEMPLATE_ID_PRODUCT_STATE_CHANGE_MESSAGE 0x33F4        // Product State Change Message
#define TEMPLATE_ID_INSTRUMENT_STATE_CHANGE_MESSAGE 0x33F5     // Instrument State Change Message
#define TEMPLATE_ID_ADD_COMPLEX_INSTRUMENT_MESSAGE 0x3458      // Add Complex Instrument Message
#define TEMPLATE_ID_PACKET_HEADER 0x32CA                       // Packet Header

// Trading Session Id: one byte code
#define TRADING_SESSION_ID_DAY 0x01      // Day
#define TRADING_SESSION_ID_MORNING 0x03  // Morning
#define TRADING_SESSION_ID_EVENING 0x05  // Evening
#define TRADING_SESSION_ID_HOLIDAY 0x07  // Holiday

// Trading Session Sub Id: one byte code
#define TRADING_SESSION_SUB_ID_PRE_TRADING 0x01   // Pre Trading
#define TRADING_SESSION_SUB_ID_TRADING 0x03       // Trading
#define TRADING_SESSION_SUB_ID_CLOSING 0x04       // Closing
#define TRADING_SESSION_SUB_ID_POST_TRADING 0x05  // Post Trading
#define TRADING_SESSION_SUB_ID_POST_CLOSING 0x06  // Post Closing
#define TRADING_SESSION_SUB_ID_QUIESCENT 0x07     // Quiescent

// Trad Ses Status: one byte code
#define TRAD_SES_STATUS_HALTED 0x01  // Halted
#define TRAD_SES_STATUS_OPEN 0x02    // Open
#define TRAD_SES_STATUS_CLOSED 0x03  // Closed

// Fast Market Indicator: one byte code
#define FAST_MARKET_INDICATOR_NO 0x00   // No
#define FAST_MARKET_INDICATOR_YES 0x01  // Yes

// Side: one byte code
#define SIDE_BUY 0x01   // Buy
#define SIDE_SELL 0x02  // Sell

// Security Status: one byte code
#define SECURITY_STATUS_ACTIVE 0x01     // Active
#define SECURITY_STATUS_INACTIVE 0x02   // Inactive
#define SECURITY_STATUS_EXPIRED 0x04    // Expired
#define SECURITY_STATUS_SUSPENDED 0x09  // Suspended

// Security Trading Status: one byte code
#define SECURITY_TRADING_STATUS_CLOSED 0xC8                          // Closed
#define SECURITY_TRADING_STATUS_RESTRICTED 0xC9                      // Restricted
#define SECURITY_TRADING_STATUS_BOOK 0xCA                            // Book
#define SECURITY_TRADING_STATUS_CONTINUOUS 0xCB                      // Continuous
#define SECURITY_TRADING_STATUS_OPENING_AUCTION 0xCC                 // Opening Auction
#define SECURITY_TRADING_STATUS_OPENING_AUCTION_FREEZE 0xCD          // Opening Auction Freeze
#define SECURITY_TRADING_STATUS_INTRADAY_AUCTION 0xCE                // Intraday Auction
#define SECURITY_TRADING_STATUS_INTRADAY_AUCTION_FREEZE 0xCF         // Intraday Auction Freeze
#define SECURITY_TRADING_STATUS_CIRCUIT_BREAKER_AUCTION 0xD0         // Circuit Breaker Auction
#define SECURITY_TRADING_STATUS_CIRCUIT_BREAKER_AUCTION_FREEZE 0xD1  // Circuit Breaker Auction Freeze
#define SECURITY_TRADING_STATUS_CLOSING_AUCTION 0xD2                 // Closing Auction
#define SECURITY_TRADING_STATUS_CLOSING_AUCTION_FREEZE 0xD3          // Closing Auction Freeze

// Md Entry Type: one byte code
#define MD_ENTRY_TYPE_TRADE 0x02                    // Trade
#define MD_ENTRY_TYPE_OPENING_PRICE 0x04            // Opening Price
#define MD_ENTRY_TYPE_CLOSING_PRICE 0x05            // Closing Price
#define MD_ENTRY_TYPE_HIGH_PRICE 0x07               // High Price
#define MD_ENTRY_TYPE_LOW_PRICE 0x08                // Low Price
#define MD_ENTRY_TYPE_PREVIOUS_CLOSING_PRICE 0x65   // Previous Closing Price
#define MD_ENTRY_TYPE_OPENING_AUCTION 0xC8          // Opening Auction
#define MD_ENTRY_TYPE_INTRADAY_AUCTION 0xC9         // Intraday Auction
#define MD_ENTRY_TYPE_CIRCUIT_BREAKER_AUCTION 0xCA  // Circuit Breaker Auction
#define MD_ENTRY_TYPE_CLOSING_AUCTION 0xCB          // Closing Auction
#define MD_ENTRY_TYPE_UPPER_CKT_LIMIT 0xCC          // Upper Ckt Limit
#define MD_ENTRY_TYPE_LOWER_CKT_LIMIT 0xCD          // Lower Ckt Limit
#define MD_ENTRY_TYPE_GROSS_TRADE_AMT 0xCE          // Gross Trade Amt
#define MD_ENTRY_TYPE_UPPER_EXEC_LIMIT 0xD0         // Upper Exec Limit
#define MD_ENTRY_TYPE_LOWER_EXEC_LIMIT 0xD1         // Lower Exec Limit

// Aggressor Side: one byte code
#define AGGRESSOR_SIDE_BUY 0x01   // Buy
#define AGGRESSOR_SIDE_SELL 0x02  // Sell

// Trade Condition: one byte code
#define TRADE_CONDITION_IMPLIED_TRADE 0x01  // Implied Trade

// Product Complex: one byte code
#define PRODUCT_COMPLEX_FUTURES_SPREAD 0x05  // Futures Spread

// Implied Market Indicator: one byte code
#define IMPLIED_MARKET_INDICATOR_NOT_IMPLIED 0x00     // Not Implied
#define IMPLIED_MARKET_INDICATOR_IMPLIED_IN_OUT 0x03  // Implied In Out

// Leg Side: one byte code
#define LEG_SIDE_BUY 0x01   // Buy
#define LEG_SIDE_SELL 0x02  // Sell

// ---- Types -------------------------------------------------------------------

// Body Len, Template Id, and Msg Seq Num opening the Packet Header
typedef struct _EobiHeader {
  UINT16 body_len;     // bytes 0 to 1
  UINT16 template_id;  // bytes 2 to 3
  UINT32 msg_seq_num;  // bytes 4 to 7
} EobiHeader;

// Technical header delivered in every Udp datagram, identifying the product, the partition, and the send time
typedef struct _PacketHeader {
  EobiHeader eobi_header;          // bytes 0 to 7
  UINT32 appl_seq_num;             // bytes 8 to 11
  UINT32 market_segment_id;        // bytes 12 to 15, signed, read here as unsigned
  UINT8 partition_id;              // byte 16
  UINT8 completion_indicator;      // byte 17
  UINT8 appl_seq_reset_indicator;  // byte 18
  UINT8 pad_5[5];                  // bytes 19 to 23
  UINT64 transact_time;            // bytes 24 to 31
} PacketHeader;

// Published regularly when there is no activity on the snapshot or the incremental channel.
typedef struct _HeartbeatMessage {
  UINT32 last_msg_seq_num_processed;  // bytes 0 to 3
  UINT8 pad_4[4];                     // bytes 4 to 7
} HeartbeatMessage;

// Published once each snapshot cycle, carrying attributes that are equal for all instruments in the product.
typedef struct _ProductSummaryMessage {
  UINT32 last_msg_seq_num_processed;  // bytes 0 to 3
  UINT8 trading_session_id;           // byte 4
  UINT8 trading_session_sub_id;       // byte 5
  UINT8 trad_ses_status;              // byte 6
  UINT8 fast_market_indicator;        // byte 7
} ProductSummaryMessage;

// OrderDetails
typedef struct _OrderDetails {
  UINT64 trd_reg_ts_time_priority;  // bytes 0 to 7
  UINT64 display_qty;               // bytes 8 to 15, signed, read here as unsigned
  UINT8 side;                       // byte 16
  UINT8 pad_7[7];                   // bytes 17 to 23
  UINT64 price;                     // bytes 24 to 31, signed, read here as unsigned
} OrderDetails;

// Represents each individual order or quote in a snapshot cycle on the snapshot channel.
typedef struct _SnapshotOrderMessage {
  OrderDetails order_details;  // bytes 0 to 31
} SnapshotOrderMessage;

// Instrument trade statistics repeated NoMDEntries times in the Instrument Summary Message. The group is not cut off by design.
typedef struct _MdInstrumentEntryGrp {
  UINT64 md_entry_px;    // bytes 0 to 7, signed, read here as unsigned
  UINT64 md_entry_size;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 md_entry_type;   // byte 16
  UINT8 pad_7[7];        // bytes 17 to 23
} MdInstrumentEntryGrp;

// Published for each instrument in one snapshot cycle, carrying instrument state information and trade statistics.
typedef struct _InstrumentSummaryMessage {
  UINT64 security_id;                                            // bytes 0 to 7, signed, read here as unsigned
  UINT64 last_update_time;                                       // bytes 8 to 15
  UINT64 trd_reg_ts_execution_time;                              // bytes 16 to 23
  UINT32 tot_no_orders;                                          // bytes 24 to 27
  UINT8 security_status;                                         // byte 28
  UINT8 security_trading_status;                                 // byte 29
  UINT8 fast_market_indicator;                                   // byte 30
  UINT8 no_md_entries;                                           // byte 31
  UINT64 trade_volume;                                           // bytes 32 to 39, signed, read here as unsigned
  UINT32 no_of_trades;                                           // bytes 40 to 43
  UINT8 pad_4[4];                                                // bytes 44 to 47
  MdInstrumentEntryGrp md_instrument_entry_grp[:byte-size 360];  // bytes 48 to 407
} InstrumentSummaryMessage;

// Carries the best bid and offer of a non crossed order book during an auction call phase.
typedef struct _AuctionBestBidOfferMessage {
  UINT64 transact_time;  // bytes 0 to 7
  UINT64 security_id;    // bytes 8 to 15, signed, read here as unsigned
  UINT64 bid_px;         // bytes 16 to 23, signed, read here as unsigned
  UINT64 offer_px;       // bytes 24 to 31, signed, read here as unsigned
} AuctionBestBidOfferMessage;

// Published for a crossed order book in an auction, indicating the potential auction price.
typedef struct _AuctionClearingPriceMessage {
  UINT64 transact_time;  // bytes 0 to 7
  UINT64 security_id;    // bytes 8 to 15, signed, read here as unsigned
  UINT64 last_px;        // bytes 16 to 23, signed, read here as unsigned
  UINT64 last_qty;       // bytes 24 to 31, signed, read here as unsigned
} AuctionClearingPriceMessage;

// Carries the best bid and offer of an order book outside continuous trading.
typedef struct _TopOfBookMessage {
  UINT64 transact_time;  // bytes 0 to 7
  UINT64 security_id;    // bytes 8 to 15, signed, read here as unsigned
  UINT64 bid_px;         // bytes 16 to 23, signed, read here as unsigned
  UINT64 offer_px;       // bytes 24 to 31, signed, read here as unsigned
} TopOfBookMessage;

// Published for each new order that was entered in the order book.
typedef struct _OrderAddMessage {
  UINT64 trd_reg_ts_time_in;   // bytes 0 to 7
  UINT64 security_id;          // bytes 8 to 15, signed, read here as unsigned
  OrderDetails order_details;  // bytes 16 to 47
} OrderAddMessage;

// Published if an existing order in the book is modified, whereby the new parameters might cause a change in time priority.
typedef struct _OrderModifyMessage {
  UINT64 trd_reg_ts_time_in;             // bytes 0 to 7
  UINT64 trd_reg_ts_prev_time_priority;  // bytes 8 to 15
  UINT64 prev_price;                     // bytes 16 to 23, signed, read here as unsigned
  UINT64 prev_display_qty;               // bytes 24 to 31, signed, read here as unsigned
  UINT64 security_id;                    // bytes 32 to 39, signed, read here as unsigned
  OrderDetails order_details;            // bytes 40 to 71
} OrderModifyMessage;

// Published if the time priority of an existing order is not changed.
typedef struct _OrderModifySamePriorityMessage {
  UINT64 trd_reg_ts_time_in;   // bytes 0 to 7
  UINT64 transact_time;        // bytes 8 to 15
  UINT64 prev_display_qty;     // bytes 16 to 23, signed, read here as unsigned
  UINT64 security_id;          // bytes 24 to 31, signed, read here as unsigned
  OrderDetails order_details;  // bytes 32 to 63
} OrderModifySamePriorityMessage;

// Published whenever an existing order is deleted from the order book.
typedef struct _OrderDeleteMessage {
  UINT64 trd_reg_ts_time_in;   // bytes 0 to 7
  UINT64 transact_time;        // bytes 8 to 15
  UINT64 security_id;          // bytes 16 to 23, signed, read here as unsigned
  OrderDetails order_details;  // bytes 24 to 55
} OrderDeleteMessage;

// Published when the order book is expected to be emptied.
typedef struct _OrderMassDeleteMessage {
  UINT64 security_id;    // bytes 0 to 7, signed, read here as unsigned
  UINT64 transact_time;  // bytes 8 to 15
} OrderMassDeleteMessage;

// Published whenever a visible order is partially executed at its displayed price.
typedef struct _PartialOrderExecutionMessage {
  UINT8 side;                       // byte 0
  UINT8 pad_7[7];                   // bytes 1 to 7
  UINT64 price;                     // bytes 8 to 15, signed, read here as unsigned
  UINT64 trd_reg_ts_time_priority;  // bytes 16 to 23
  UINT64 security_id;               // bytes 24 to 31, signed, read here as unsigned
  UINT32 trd_match_id;              // bytes 32 to 35
  UINT8 pad_4[4];                   // bytes 36 to 39
  UINT64 last_qty;                  // bytes 40 to 47, signed, read here as unsigned
  UINT64 last_px;                   // bytes 48 to 55, signed, read here as unsigned
} PartialOrderExecutionMessage;

// Published whenever a visible order is fully executed at its displayed price.
typedef struct _FullOrderExecutionMessage {
  UINT8 side;                       // byte 0
  UINT8 pad_7[7];                   // bytes 1 to 7
  UINT64 price;                     // bytes 8 to 15, signed, read here as unsigned
  UINT64 trd_reg_ts_time_priority;  // bytes 16 to 23
  UINT64 security_id;               // bytes 24 to 31, signed, read here as unsigned
  UINT32 trd_match_id;              // bytes 32 to 35
  UINT8 pad_4[4];                   // bytes 36 to 39
  UINT64 last_qty;                  // bytes 40 to 47, signed, read here as unsigned
  UINT64 last_px;                   // bytes 48 to 55, signed, read here as unsigned
} FullOrderExecutionMessage;

// Trade statistics repeated NoMDEntries times in the Trade Reversal Message.
typedef struct _MdTradeEntryGrp {
  UINT64 md_entry_px;    // bytes 0 to 7, signed, read here as unsigned
  UINT64 md_entry_size;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 md_entry_type;   // byte 16
  UINT8 pad_7[7];        // bytes 17 to 23
} MdTradeEntryGrp;

// Published when a trade is reversed.
typedef struct _TradeReversalMessage {
  UINT64 security_id;                                  // bytes 0 to 7, signed, read here as unsigned
  UINT64 transact_time;                                // bytes 8 to 15
  UINT32 trd_match_id;                                 // bytes 16 to 19
  UINT8 pad_4[4];                                      // bytes 20 to 23
  UINT64 last_qty;                                     // bytes 24 to 31, signed, read here as unsigned
  UINT64 last_px;                                      // bytes 32 to 39, signed, read here as unsigned
  UINT64 trd_reg_ts_execution_time;                    // bytes 40 to 47
  UINT8 no_md_entries;                                 // byte 48
  UINT8 pad_7[7];                                      // bytes 49 to 55
  MdTradeEntryGrp md_trade_entry_grp[:byte-size 360];  // bytes 56 to 415
} TradeReversalMessage;

// Published whenever an incoming order is executed, carrying information on the execution of that incoming order.
typedef struct _ExecutionSummaryMessage {
  UINT64 security_id;          // bytes 0 to 7, signed, read here as unsigned
  UINT64 aggressor_timestamp;  // bytes 8 to 15
  UINT64 exec_id;              // bytes 16 to 23
  UINT64 last_qty;             // bytes 24 to 31, signed, read here as unsigned
  UINT8 aggressor_side;        // byte 32
  UINT8 trade_condition;       // byte 33
  UINT8 pad_6[6];              // bytes 34 to 39
  UINT64 last_px;              // bytes 40 to 47, signed, read here as unsigned
  UINT64 resting_hidden_qty;   // bytes 48 to 55, signed, read here as unsigned
} ExecutionSummaryMessage;

// Published whenever there is a change in the daily price range of the instrument.
typedef struct _InstrumentInfoMessage {
  UINT64 security_id;       // bytes 0 to 7, signed, read here as unsigned
  UINT64 close_price;       // bytes 8 to 15, signed, read here as unsigned
  UINT64 prev_close_price;  // bytes 16 to 23, signed, read here as unsigned
  UINT64 upper_ckt_limit;   // bytes 24 to 31, signed, read here as unsigned
  UINT64 lower_ckt_limit;   // bytes 32 to 39, signed, read here as unsigned
} InstrumentInfoMessage;

// Published whenever there is a change in the limit price protection range of the instrument.
typedef struct _LppRangeMessage {
  UINT64 security_id;       // bytes 0 to 7, signed, read here as unsigned
  UINT64 upper_exec_limit;  // bytes 8 to 15, signed, read here as unsigned
  UINT64 lower_exec_limit;  // bytes 16 to 23, signed, read here as unsigned
} LppRangeMessage;

// Provides updates on the trading state for all instruments in a particular product.
typedef struct _ProductStateChangeMessage {
  UINT8 trading_session_id;      // byte 0
  UINT8 trading_session_sub_id;  // byte 1
  UINT8 trad_ses_status;         // byte 2
  UINT8 fast_market_indicator;   // byte 3
  UINT8 pad_4[4];                // bytes 4 to 7
  UINT64 transact_time;          // bytes 8 to 15
} ProductStateChangeMessage;

// Provides state information for a single instrument.
typedef struct _InstrumentStateChangeMessage {
  UINT64 security_id;             // bytes 0 to 7, signed, read here as unsigned
  UINT8 security_status;          // byte 8
  UINT8 security_trading_status;  // byte 9
  UINT8 fast_market_indicator;    // byte 10
  UINT8 pad_5[5];                 // bytes 11 to 15
  UINT64 transact_time;           // bytes 16 to 23
} InstrumentStateChangeMessage;

// Leg definitions repeated NoLegs times in the Add Complex Instrument Message.
typedef struct _InstrmtLegGrp {
  UINT64 leg_security_id;  // bytes 0 to 7, signed, read here as unsigned
  UINT32 leg_ratio_qty;    // bytes 8 to 11, signed, read here as unsigned
  UINT8 leg_side;          // byte 12
  UINT8 pad_3[3];          // bytes 13 to 15
} InstrmtLegGrp;

// Published whenever a new complex instrument is created intraday or an existing complex instrument is modified.
typedef struct _AddComplexInstrumentMessage {
  UINT64 security_id;                            // bytes 0 to 7, signed, read here as unsigned
  UINT64 transact_time;                          // bytes 8 to 15
  UINT32 security_sub_type;                      // bytes 16 to 19, signed, read here as unsigned
  UINT8 product_complex;                         // byte 20
  UINT8 implied_market_indicator;                // byte 21
  UINT8 no_legs;                                 // byte 22
  UINT8 pad_1;                                   // byte 23
  InstrmtLegGrp instrmt_leg_grp[:byte-size 80];  // bytes 24 to 103
} AddComplexInstrumentMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x32C9: HeartbeatMessage heartbeat_message;
    case 0x3520: ProductSummaryMessage product_summary_message;
    case 0x3522: SnapshotOrderMessage snapshot_order_message;
    case 0x3521: InstrumentSummaryMessage instrument_summary_message;
    case 0x34BC: AuctionBestBidOfferMessage auction_best_bid_offer_message;
    case 0x34BD: AuctionClearingPriceMessage auction_clearing_price_message;
    case 0x34C0: TopOfBookMessage top_of_book_message;
    case 0x332C: OrderAddMessage order_add_message;
    case 0x332D: OrderModifyMessage order_modify_message;
    case 0x3332: OrderModifySamePriorityMessage order_modify_same_priority_message;
    case 0x332E: OrderDeleteMessage order_delete_message;
    case 0x332F: OrderMassDeleteMessage order_mass_delete_message;
    case 0x3331: PartialOrderExecutionMessage partial_order_execution_message;
    case 0x3330: FullOrderExecutionMessage full_order_execution_message;
    case 0x3390: TradeReversalMessage trade_reversal_message;
    case 0x3392: ExecutionSummaryMessage execution_summary_message;
    case 0x3393: InstrumentInfoMessage instrument_info_message;
    case 0x3394: LppRangeMessage lpp_range_message;
    case 0x33F4: ProductStateChangeMessage product_state_change_message;
    case 0x33F5: InstrumentStateChangeMessage instrument_state_change_message;
    case 0x3458: AddComplexInstrumentMessage add_complex_instrument_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Bse Eobi Message
typedef struct _Message {
  UINT16 body_len { body_len >= 8 };                                                                                   // bytes 0 to 1
  UINT16 template_id;                                                                                                  // bytes 2 to 3
  UINT32 msg_seq_num;                                                                                                  // bytes 4 to 7
  Payload(template_id, (((UINT32) body_len) - 8)) payload[:byte-size-single-element-array (((UINT32) body_len) - 8)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Bse Eobi Packet
entrypoint typedef struct _Packet (UINT32 available) where (available >= 32) {
  PacketHeader packet_header;                    // bytes 0 to 31
  Message message[:byte-size (available - 32)];
} Packet;

