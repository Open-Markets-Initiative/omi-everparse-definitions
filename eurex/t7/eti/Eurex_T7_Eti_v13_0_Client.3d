// Eurex Exchange Enhanced Trading Interface
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out Eurex_T7_Eti_v13_0_Client.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - a length prefix framing what follows
// - a run counted by a field
//
// License: MIT No Attribution

// ---- Message Header: 6 bytes -------------------------------------------------

// Eurex T7 Eti message header
entrypoint typedef struct _MessageHeader {
  UINT32 body_len;     // bytes 0 to 3
  UINT16 template_id;  // bytes 4 to 5
} MessageHeader;

// ---- Request Header Comp: 8 bytes --------------------------------------------

entrypoint typedef struct _RequestHeaderComp {
  UINT32 msg_seq_num;    // bytes 0 to 3
  UINT32 sender_sub_id;  // bytes 4 to 7
} RequestHeaderComp;

// ---- Old Basket Data Grp Comp: 64 bytes --------------------------------------

entrypoint typedef struct _OldBasketDataGrpComp {
  UINT64 basket_trd_match_id;          // bytes 0 to 7
  UINT32 basket_exec_id;               // bytes 8 to 11
  UINT8 trade_report_id[20];           // bytes 12 to 31
  UINT32 maturity_month_year;          // bytes 32 to 35
  UINT8 basket_trade_report_type;      // byte 36
  UINT8 basket_trade_report_text[20];  // bytes 37 to 56
  UINT8 pad7[7];                       // bytes 57 to 63
} OldBasketDataGrpComp;

// ---- New Basket Data Grp Comp: 48 bytes --------------------------------------

entrypoint typedef struct _NewBasketDataGrpComp {
  UINT8 trade_report_id[20];           // bytes 0 to 19
  UINT32 maturity_month_year;          // bytes 20 to 23
  UINT8 basket_trade_report_type;      // byte 24
  UINT8 basket_trade_report_text[20];  // bytes 25 to 44
  UINT8 pad3[3];                       // bytes 45 to 47
} NewBasketDataGrpComp;

