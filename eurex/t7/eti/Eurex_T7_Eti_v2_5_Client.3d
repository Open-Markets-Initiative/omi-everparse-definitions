  UINT32 security_sub_type;                                                      // bytes 30 to 33, signed, read here as unsigned
  UINT8 product_complex;                                                         // byte 34
  UINT8 no_legs;                                                                 // byte 35
  UINT8 compliance_text[20];                                                     // bytes 36 to 55
  UINT8 pad2v2[2];                                                               // bytes 56 to 57
  InstrmtLegGrpComp instrmt_leg_grp_comp[:byte-size (((UINT32) no_legs) * 32)];
} AddComplexInstrumentRequest;

