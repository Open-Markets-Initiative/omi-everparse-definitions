// Event Type: one byte code
#define EVENT_TYPE_SWAP_START_DATE 0x08  // Swap Start Date
#define EVENT_TYPE_SWAP_END_DATE 0x09    // Swap End Date

// Instr Attrib Type: one byte code
#define INSTR_ATTRIB_TYPE_VARIABLE_RATE 0x05                  // Variable Rate
#define INSTR_ATTRIB_TYPE_COUPON_RATE 0x64                    // Coupon Rate
#define INSTR_ATTRIB_TYPE_OFFSETTOTHEVARIABLECOUPONRATE 0x65  // Offsettothevariablecouponrate
#define INSTR_ATTRIB_TYPE_SWAP_CUSTOMER_1 0x66                // Swap Customer 1
#define INSTR_ATTRIB_TYPE_SWAP_CUSTOMER_2 0x67                // Swap Customer 2
#define INSTR_ATTRIB_TYPE_CASH_BASKET_REFERENCE 0x68          // Cash Basket Reference

// Risk Limit Platform: one byte code
#define RISK_LIMIT_PLATFORM_ON_BOOK 0x00   // On Book
#define RISK_LIMIT_PLATFORM_OFF_BOOK 0x01  // Off Book

// Appl Usage Orders: one byte code
#define APPL_USAGE_ORDERS_AUTOMATED 0x41    // Automated
#define APPL_USAGE_ORDERS_MANUAL 0x4D       // Manual
#define APPL_USAGE_ORDERS_AUTO_SELECT 0x42  // Auto Select
#define APPL_USAGE_ORDERS_NONE 0x4E         // None

// Appl Usage Quotes: one byte code
#define APPL_USAGE_QUOTES_AUTOMATED 0x41    // Automated
#define APPL_USAGE_QUOTES_MANUAL 0x4D       // Manual
#define APPL_USAGE_QUOTES_AUTO_SELECT 0x42  // Auto Select
#define APPL_USAGE_QUOTES_NONE 0x4E         // None

// Order Routing Indicator: one byte code
#define ORDER_ROUTING_INDICATOR_YES 0x59  // Yes
#define ORDER_ROUTING_INDICATOR_NO 0x4E   // No

// Price Validity Check Type: one byte code
#define PRICE_VALIDITY_CHECK_TYPE_NONE 0x00       // None
#define PRICE_VALIDITY_CHECK_TYPE_OPTIONAL 0x01   // Optional
#define PRICE_VALIDITY_CHECK_TYPE_MANDATORY 0x02  // Mandatory

// Value Check Type Value: one byte code
#define VALUE_CHECK_TYPE_VALUE_DONOTCHECK 0x00  // Donotcheck
#define VALUE_CHECK_TYPE_VALUE_CHECK 0x01       // Check

// Quote Size Type: one byte code
#define QUOTE_SIZE_TYPE_TOTAL_SIZE 0x01  // Total Size
#define QUOTE_SIZE_TYPE_OPEN_SIZE 0x02   // Open Size

// Quote Type: one byte code
#define QUOTE_TYPE_INDICATIVE 0x00     // Indicative
#define QUOTE_TYPE_TRADEABLE 0x01      // Tradeable
#define QUOTE_TYPE_TRADEABLE_BOC 0x64  // Tradeable Boc

// Appl Seq Indicator: one byte code
#define APPL_SEQ_INDICATOR_NO_RECOVERY_REQUIRED 0x00  // No Recovery Required
#define APPL_SEQ_INDICATOR_RECOVERY_REQUIRED 0x01     // Recovery Required

// Ord Type: one byte code
#define ORD_TYPE_MARKET 0x01      // Market
#define ORD_TYPE_LIMIT 0x02       // Limit
#define ORD_TYPE_STOP 0x03        // Stop
#define ORD_TYPE_STOP_LIMIT 0x04  // Stop Limit

// Exec Inst: one byte code
#define EXEC_INST_H 0x01    // H
#define EXEC_INST_Q 0x02    // Q
#define EXEC_INST_HQ 0x03   // Hq
#define EXEC_INST_H_6 0x05  // H 6
#define EXEC_INST_Q_6 0x06  // Q 6

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY 0x00  // Day
#define TIME_IN_FORCE_GTC 0x01  // Gtc
#define TIME_IN_FORCE_IOC 0x03  // Ioc
#define TIME_IN_FORCE_GTD 0x06  // Gtd

// Ownership Indicator: one byte code
#define OWNERSHIP_INDICATOR_NO_CHANGEOF_OWNERSHIP 0x00      // No Changeof Ownership
#define OWNERSHIP_INDICATOR_CHANGETO_EXECUTING_TRADER 0x01  // Changeto Executing Trader

// Trading Session Sub Id: one byte code
#define TRADING_SESSION_SUB_ID_CLOSINGAUCTION 0x04  // Closingauction

// Party Detail Status: one byte code
#define PARTY_DETAIL_STATUS_ACTIVE 0x00    // Active
#define PARTY_DETAIL_STATUS_SUSPEND 0x01   // Suspend
#define PARTY_DETAIL_STATUS_REJECTED 0x02  // Rejected

// Risk Limit Type: one byte code
#define RISK_LIMIT_TYPE_LONGLIMIT 0x04   // Longlimit
#define RISK_LIMIT_TYPE_SHORTLIMIT 0x05  // Shortlimit

// Mass Action Type: one byte code
#define MASS_ACTION_TYPE_SUSPENDQUOTES 0x01  // Suspendquotes
#define MASS_ACTION_TYPE_RELEASEQUOTES 0x02  // Releasequotes

// Mass Action Sub Type: one byte code
#define MASS_ACTION_SUB_TYPE_BOOKOR_CANCEL 0x01  // Bookor Cancel

// Ref Appl Id: one byte code
#define REF_APPL_ID_TRADE 0x01                        // Trade
#define REF_APPL_ID_NEWS 0x02                         // News
#define REF_APPL_ID_SERVICEAVAILABILITY 0x03          // Serviceavailability
#define REF_APPL_ID_SESSIONDATA 0x04                  // Sessiondata
#define REF_APPL_ID_LISTENERDATA 0x05                 // Listenerdata
#define REF_APPL_ID_RISK_CONTROL 0x06                 // Risk Control
#define REF_APPL_ID_TES_MAINTENANCE 0x07              // Tes Maintenance
#define REF_APPL_ID_TES_TRADE 0x08                    // Tes Trade
#define REF_APPL_ID_SRQS_MAINTENANCE 0x09             // Srqs Maintenance
#define REF_APPL_ID_SERVICE_AVAILABILITY_MARKET 0x0A  // Service Availability Market

// Hedging Instruction: one byte code
#define HEDGING_INSTRUCTION_ON_CLOSE 0x01  // On Close

// Eurex Volume Ranking: one byte code
#define EUREX_VOLUME_RANKING_LOW 0x01     // Low
#define EUREX_VOLUME_RANKING_MEDIUM 0x02  // Medium
#define EUREX_VOLUME_RANKING_HIGH 0x03    // High

// Enlight Rfq Avg Resp Time Ranking: one byte code
#define ENLIGHT_RFQ_AVG_RESP_TIME_RANKING_LOW 0x01     // Low
#define ENLIGHT_RFQ_AVG_RESP_TIME_RANKING_MEDIUM 0x02  // Medium
#define ENLIGHT_RFQ_AVG_RESP_TIME_RANKING_HIGH 0x03    // High

// Enlight Rfq Avg Resp Rate Ranking: one byte code
#define ENLIGHT_RFQ_AVG_RESP_RATE_RANKING_LOW 0x01     // Low
#define ENLIGHT_RFQ_AVG_RESP_RATE_RANKING_MEDIUM 0x02  // Medium
#define ENLIGHT_RFQ_AVG_RESP_RATE_RANKING_HIGH 0x03    // High

// Trade To Quote Ratio Ranking: one byte code
#define TRADE_TO_QUOTE_RATIO_RANKING_LOW 0x01     // Low
#define TRADE_TO_QUOTE_RATIO_RANKING_MEDIUM 0x02  // Medium
#define TRADE_TO_QUOTE_RATIO_RANKING_HIGH 0x03    // High

// Quote Sub Type: one byte code
#define QUOTE_SUB_TYPE_WORKING_DELTA 0x01                          // Working Delta
#define QUOTE_SUB_TYPE_BASIS_TRADE 0x02                            // Basis Trade
#define QUOTE_SUB_TYPE_REGULAR 0x03                                // Regular
#define QUOTE_SUB_TYPE_NEGOTIATE_UNDERLYING_OUTSIDE_EXCHANGE 0x04  // Negotiate Underlying Outside Exchange
#define QUOTE_SUB_TYPE_VOLA_STRATEGY_FIX 0x05                      // Vola Strategy Fix
#define QUOTE_SUB_TYPE_VOLA_STRATEGY_NEGOTIATE_UNDERLYING 0x06     // Vola Strategy Negotiate Underlying

// Number Of Resp Disclosure Instruction: one byte code
#define NUMBER_OF_RESP_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define NUMBER_OF_RESP_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Respondent Type: one byte code
#define RESPONDENT_TYPE_ALL_MARKET_PARTICIPANTS 0x01  // All Market Participants
#define RESPONDENT_TYPE_ANONYMOUS 0x66                // Anonymous

// Show Last Deal On Closure: one byte code
#define SHOW_LAST_DEAL_ON_CLOSURE_NO 0x00   // No
#define SHOW_LAST_DEAL_ON_CLOSURE_YES 0x01  // Yes

// Leaves Qty Disclosure Instruction: one byte code
#define LEAVES_QTY_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define LEAVES_QTY_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Last Px Disclosure Instruction: one byte code
#define LAST_PX_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define LAST_PX_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Last Qty Disclosure Instruction: one byte code
#define LAST_QTY_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define LAST_QTY_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Free Text 5 Disclosure Instruction: one byte code
#define FREE_TEXT_5_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define FREE_TEXT_5_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Party Order Origination Disclosure Instruction: one byte code
#define PARTY_ORDER_ORIGINATION_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define PARTY_ORDER_ORIGINATION_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Quote Instruction: one byte code
#define QUOTE_INSTRUCTION_DO_NOT_QUOTE 0x00  // Do Not Quote
#define QUOTE_INSTRUCTION_QUOTE 0x01         // Quote

// Party Detail Status Information: one byte code
#define PARTY_DETAIL_STATUS_INFORMATION_TRRTHRESHOLDTOOBIG 0x01  // Trrthresholdtoobig
#define PARTY_DETAIL_STATUS_INFORMATION_BLOCKALLANONYMOUS 0x02   // Blockallanonymous

// Quoting Status: one byte code
#define QUOTING_STATUS_OPEN_ACTIVE 0x01      // Open Active
#define QUOTING_STATUS_OPEN_IDLE 0x02        // Open Idle
#define QUOTING_STATUS_CLOSED_INACTIVE 0x03  // Closed Inactive

// Trd Rpt Status: one byte code
#define TRD_RPT_STATUS_ACCEPTED 0x00         // Accepted
#define TRD_RPT_STATUS_REJECTED 0x01         // Rejected
#define TRD_RPT_STATUS_CANCELLED 0x02        // Cancelled
#define TRD_RPT_STATUS_PENDING_NEW 0x04      // Pending New
#define TRD_RPT_STATUS_PENDING_CANCEL 0x05   // Pending Cancel
#define TRD_RPT_STATUS_TERMINATED 0x07       // Terminated
#define TRD_RPT_STATUS_DEEMED_VERIFIED 0x09  // Deemed Verified

// Quote Cancel Type: one byte code
#define QUOTE_CANCEL_TYPE_CANCEL_ALL_QUOTES 0x04  // Cancel All Quotes

// Compression Action: one byte code
#define COMPRESSION_ACTION_START_COMPRESSION 0x01   // Start Compression
#define COMPRESSION_ACTION_COMMIT_COMPRESSION 0x02  // Commit Compression
#define COMPRESSION_ACTION_CANCEL_COMPRESSION 0x03  // Cancel Compression

// Skip Validations: one byte code
#define SKIP_VALIDATIONS_FALSE 0x00  // False
#define SKIP_VALIDATIONS_TRUE 0x01   // True

// Trade Platform: one byte code
#define TRADE_PLATFORM_OFF_BOOK 0x00  // Off Book
#define TRADE_PLATFORM_ON_BOOK 0x01   // On Book

// Value Check Type Min Lot Size: one byte code
#define VALUE_CHECK_TYPE_MIN_LOT_SIZE_DONOTCHECK 0x00  // Donotcheck
#define VALUE_CHECK_TYPE_MIN_LOT_SIZE_CHECK 0x01       // Check

// ---- Types -------------------------------------------------------------------

typedef struct _RequestHeaderComp {
  UINT32 msg_seq_num;    // bytes 0 to 3
  UINT32 sender_sub_id;  // bytes 4 to 7
} RequestHeaderComp;

typedef struct _InstrmtLegGrpComp {
  UINT64 leg_security_id;   // bytes 0 to 7, signed, read here as unsigned
  UINT64 leg_price;         // bytes 8 to 15, signed, read here as unsigned
  UINT32 leg_symbol;        // bytes 16 to 19, signed, read here as unsigned
  UINT32 leg_ratio_qty;     // bytes 20 to 23
  UINT8 leg_side;           // byte 24
  UINT8 leg_security_type;  // byte 25
  UINT8 pad6[6];            // bytes 26 to 31
} InstrmtLegGrpComp;

typedef struct _AddComplexInstrumentRequest {
  UINT8 network_msg_id[8];                                                       // bytes 0 to 7
  UINT8 pad2[2];                                                                 // bytes 8 to 9
  RequestHeaderComp request_header_comp;                                         // bytes 10 to 17
  UINT32 market_segment_id;                                                      // bytes 18 to 21, signed, read here as unsigned
  UINT32 security_sub_type;                                                      // bytes 22 to 25, signed, read here as unsigned
  UINT8 product_complex;                                                         // byte 26
  UINT8 no_legs;                                                                 // byte 27
  UINT8 compliance_text[20];                                                     // bytes 28 to 47
  UINT8 pad2v2[2];                                                               // bytes 48 to 49
  InstrmtLegGrpComp instrmt_leg_grp_comp[:byte-size (((UINT32) no_legs) * 32)];
} AddComplexInstrumentRequest;

typedef struct _AddFlexibleInstrumentRequest {
  UINT8 network_msg_id[8];                // bytes 0 to 7
  UINT8 pad2[2];                          // bytes 8 to 9
  RequestHeaderComp request_header_comp;  // bytes 10 to 17
  UINT64 strike_price;                    // bytes 18 to 25, signed, read here as unsigned
  UINT32 market_segment_id;               // bytes 26 to 29, signed, read here as unsigned
  UINT32 maturity_date;                   // bytes 30 to 33
  UINT8 settl_method;                     // byte 34
  UINT8 opt_attribute;                    // byte 35
  UINT8 put_or_call;                      // byte 36
  UINT8 exercise_style;                   // byte 37
  UINT8 compliance_text[20];              // bytes 38 to 57
} AddFlexibleInstrumentRequest;

typedef struct _BasketRootPartyGrpComp {
  UINT16 root_party_sub_id_type;          // bytes 0 to 1
  UINT8 root_party_contra_firm[5];        // bytes 2 to 6
  UINT8 root_party_contra_trader[6];      // bytes 7 to 12
  UINT8 basket_side_trade_report_id[20];  // bytes 13 to 32
  UINT8 pad7[7];                          // bytes 33 to 39
} BasketRootPartyGrpComp;

typedef struct _InstrmtMatchSideGrpComp {
  UINT64 security_id;             // bytes 0 to 7, signed, read here as unsigned
  UINT64 last_px;                 // bytes 8 to 15, signed, read here as unsigned
  UINT64 trans_bkd_time;          // bytes 16 to 23
  UINT64 related_close_price;     // bytes 24 to 31, signed, read here as unsigned
  UINT32 package_id;              // bytes 32 to 35
  UINT32 side_market_segment_id;  // bytes 36 to 39, signed, read here as unsigned
  UINT16 side_trd_sub_typ;        // bytes 40 to 41
  UINT8 product_complex;          // byte 42
  UINT8 trade_publish_indicator;  // byte 43
  UINT8 instrmt_match_side_id;    // byte 44
  UINT8 effect_on_basket;         // byte 45
  UINT8 trade_report_text[20];    // bytes 46 to 65
  UINT8 pad6[6];                  // bytes 66 to 71
} InstrmtMatchSideGrpComp;

typedef struct _BasketSideAllocGrpComp {
  UINT64 alloc_qty;                 // bytes 0 to 7, signed, read here as unsigned
  UINT32 individual_alloc_id;       // bytes 8 to 11
  UINT16 party_sub_id_type;         // bytes 12 to 13
  UINT8 side;                       // byte 14
  UINT8 instrmt_match_side_id;      // byte 15
  UINT8 trade_alloc_status;         // byte 16
  UINT8 party_executing_firm[5];    // bytes 17 to 21
  UINT8 party_executing_trader[6];  // bytes 22 to 27
  UINT8 pad4[4];                    // bytes 28 to 31
} BasketSideAllocGrpComp;

typedef struct _AmendBasketTradeRequest {
  UINT8 network_msg_id[8];                                                                                    // bytes 0 to 7
  UINT8 pad2[2];                                                                                              // bytes 8 to 9
  RequestHeaderComp request_header_comp;                                                                      // bytes 10 to 17
  UINT64 basket_trd_match_id;                                                                                 // bytes 18 to 25
  UINT32 basket_exec_id;                                                                                      // bytes 26 to 29
  UINT32 market_segment_id;                                                                                   // bytes 30 to 33, signed, read here as unsigned
  UINT32 maturity_month_year;                                                                                 // bytes 34 to 37
  UINT32 basket_profile_id;                                                                                   // bytes 38 to 41
  UINT16 trd_type;                                                                                            // bytes 42 to 43
  UINT16 no_basket_side_alloc;                                                                                // bytes 44 to 45
  UINT8 trade_report_type;                                                                                    // byte 46
  UINT8 basket_trade_report_type;                                                                             // byte 47
  UINT8 no_basket_root_party_grps;                                                                            // byte 48
  UINT8 no_instrmt_match_sides;                                                                               // byte 49
  UINT8 basket_trade_report_text[20];                                                                         // bytes 50 to 69
  UINT8 trade_report_id[20];                                                                                  // bytes 70 to 89
  BasketRootPartyGrpComp basket_root_party_grp_comp[:byte-size (((UINT32) no_basket_root_party_grps) * 40)];
  InstrmtMatchSideGrpComp instrmt_match_side_grp_comp[:byte-size (((UINT32) no_instrmt_match_sides) * 72)];
  BasketSideAllocGrpComp basket_side_alloc_grp_comp[:byte-size (((UINT32) no_basket_side_alloc) * 32)];
} AmendBasketTradeRequest;

typedef struct _BasketSideAllocExtGrpComp {
  UINT64 alloc_qty;                                    // bytes 0 to 7, signed, read here as unsigned
  UINT64 party_id_client_id;                           // bytes 8 to 15
  UINT64 party_id_investment_decision_maker;           // bytes 16 to 23
  UINT64 executing_trader;                             // bytes 24 to 31
  UINT32 package_id;                                   // bytes 32 to 35
  UINT32 side_market_segment_id;                       // bytes 36 to 39, signed, read here as unsigned
  UINT32 alloc_id;                                     // bytes 40 to 43
  UINT8 side;                                          // byte 44
  UINT8 position_effect;                               // byte 45
  UINT8 trading_capacity;                              // byte 46
  UINT8 order_attribute_liquidity_provision;           // byte 47
  UINT8 executing_trader_qualifier;                    // byte 48
  UINT8 party_id_investment_decision_maker_qualifier;  // byte 49
  UINT8 order_attribute_risk_reduction;                // byte 50
  UINT8 order_origination;                             // byte 51
  UINT8 party_executing_firm[5];                       // bytes 52 to 56
  UINT8 party_executing_trader[6];                     // bytes 57 to 62
  UINT8 account[2];                                    // bytes 63 to 64
  UINT8 free_text_1[12];                               // bytes 65 to 76
  UINT8 free_text_2[12];                               // bytes 77 to 88
  UINT8 free_text_3[12];                               // bytes 89 to 100
  UINT8 party_id_take_up_trading_firm[5];              // bytes 101 to 105
  UINT8 party_id_order_origination_firm[7];            // bytes 106 to 112
  UINT8 party_id_beneficiary[9];                       // bytes 113 to 121
  UINT8 party_id_position_account[32];                 // bytes 122 to 153
  UINT8 party_id_location_id[2];                       // bytes 154 to 155
  UINT8 cust_order_handling_inst;                      // byte 156
  UINT8 compliance_text[20];                           // bytes 157 to 176
  UINT8 pad7[7];                                       // bytes 177 to 183
} BasketSideAllocExtGrpComp;

typedef struct _ApproveBasketTradeRequest {
  UINT8 network_msg_id[8];                                                                                       // bytes 0 to 7
  UINT8 pad2[2];                                                                                                 // bytes 8 to 9
  RequestHeaderComp request_header_comp;                                                                         // bytes 10 to 17
  UINT64 basket_trd_match_id;                                                                                    // bytes 18 to 25
  UINT32 basket_exec_id;                                                                                         // bytes 26 to 29
  UINT32 market_segment_id;                                                                                      // bytes 30 to 33, signed, read here as unsigned
  UINT16 root_party_sub_id_type;                                                                                 // bytes 34 to 35
  UINT16 no_basket_side_alloc;                                                                                   // bytes 36 to 37
  UINT16 trd_type;                                                                                               // bytes 38 to 39
  UINT8 trade_report_type;                                                                                       // byte 40
  UINT8 basket_trade_report_text[20];                                                                            // bytes 41 to 60
  UINT8 trade_report_id[20];                                                                                     // bytes 61 to 80
  UINT8 basket_side_trade_report_id[20];                                                                         // bytes 81 to 100
  UINT8 pad5[5];                                                                                                 // bytes 101 to 105
  BasketSideAllocExtGrpComp basket_side_alloc_ext_grp_comp[:byte-size (((UINT32) no_basket_side_alloc) * 184)];
} ApproveBasketTradeRequest;

typedef struct _ApproveReverseTesTradeRequest {
