} BasketExecGrpComp;

typedef struct _BasketExecutionBroadcast {
  UINT8 pad2[2];                                                                                // bytes 0 to 1
  RbcHeaderComp rbc_header_comp;                                                                // bytes 2 to 33
  UINT64 basket_trd_match_id;                                                                   // bytes 34 to 41
  UINT64 transact_time;                                                                         // bytes 42 to 49
  UINT32 basket_exec_id;                                                                        // bytes 50 to 53
  UINT32 market_segment_id;                                                                     // bytes 54 to 57, signed, read here as unsigned
  UINT32 basket_profile_id;                                                                     // bytes 58 to 61
  UINT16 trd_type;                                                                              // bytes 62 to 63
