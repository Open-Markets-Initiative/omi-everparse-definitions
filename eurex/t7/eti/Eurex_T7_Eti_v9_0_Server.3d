#define LEAVES_QTY_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define LEAVES_QTY_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Last Px Disclosure Instruction: one byte code
#define LAST_PX_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define LAST_PX_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Last Qty Disclosure Instruction: one byte code
#define LAST_QTY_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define LAST_QTY_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Free Text 5 Disclosure Instruction: one byte code
#define FREE_TEXT_5_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define FREE_TEXT_5_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Party Order Origination Disclosure Instruction: one byte code
#define PARTY_ORDER_ORIGINATION_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define PARTY_ORDER_ORIGINATION_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Party Detail Status Information: one byte code
#define PARTY_DETAIL_STATUS_INFORMATION_TRRTHRESHOLDTOOBIG 0x01  // Trrthresholdtoobig
#define PARTY_DETAIL_STATUS_INFORMATION_BLOCKALLANONYMOUS 0x02   // Blockallanonymous

// Trade Underlying: one byte code
#define TRADE_UNDERLYING_NO 0x01   // No
#define TRADE_UNDERLYING_YES 0x02  // Yes

// Negotiate Underlying: one byte code
#define NEGOTIATE_UNDERLYING_NO 0x00   // No
#define NEGOTIATE_UNDERLYING_YES 0x01  // Yes

// Respondent Type: one byte code
#define RESPONDENT_TYPE_ALL_MARKET_PARTICIPANTS 0x01  // All Market Participants
#define RESPONDENT_TYPE_ANONYMOUS 0x66                // Anonymous

// Quoting Status: one byte code
#define QUOTING_STATUS_OPEN_ACTIVE 0x01      // Open Active
#define QUOTING_STATUS_OPEN_IDLE 0x02        // Open Idle
#define QUOTING_STATUS_CLOSED_INACTIVE 0x03  // Closed Inactive

// Trad Ses Event: one byte code
#define TRAD_SES_EVENT_STARTOF_SERVICE 0x65    // Startof Service
#define TRAD_SES_EVENT_MARKET_RESET 0x66       // Market Reset
#define TRAD_SES_EVENT_ENDOF_RESTATEMENT 0x67  // Endof Restatement
#define TRAD_SES_EVENT_ENDOF_DAY_SERVICE 0x68  // Endof Day Service
#define TRAD_SES_EVENT_SERVICE_RESUMED 0x69    // Service Resumed

// Matching Engine Status: one byte code
#define MATCHING_ENGINE_STATUS_UNAVAILABLE 0x00  // Unavailable
#define MATCHING_ENGINE_STATUS_AVAILABLE 0x01    // Available

// Trade Manager Status: one byte code
#define TRADE_MANAGER_STATUS_UNAVAILABLE 0x00  // Unavailable
#define TRADE_MANAGER_STATUS_AVAILABLE 0x01    // Available

// Appl Seq Status: one byte code
#define APPL_SEQ_STATUS_UNAVAILABLE 0x00  // Unavailable
#define APPL_SEQ_STATUS_AVAILABLE 0x01    // Available

// T 7 Entry Service Status: one byte code
#define T_7_ENTRY_SERVICE_STATUS_UNAVAILABLE 0x00  // Unavailable
#define T_7_ENTRY_SERVICE_STATUS_AVAILABLE 0x01    // Available

// T 7 Entry Service Rtm Status: one byte code
#define T_7_ENTRY_SERVICE_RTM_STATUS_UNAVAILABLE 0x00  // Unavailable
#define T_7_ENTRY_SERVICE_RTM_STATUS_AVAILABLE 0x01    // Available

// Selective Request For Quote Service Status: one byte code
#define SELECTIVE_REQUEST_FOR_QUOTE_SERVICE_STATUS_UNAVAILABLE 0x00  // Unavailable
#define SELECTIVE_REQUEST_FOR_QUOTE_SERVICE_STATUS_AVAILABLE 0x01    // Available

// Party Id Settlement Location: one byte code
#define PARTY_ID_SETTLEMENT_LOCATION_CLEARSTREM_BANKING_FRANKFURT 0x01  // Clearstrem Banking Frankfurt
#define PARTY_ID_SETTLEMENT_LOCATION_CLEARSTREM_BANKING_LUXEMBURG 0x02  // Clearstrem Banking Luxemburg
#define PARTY_ID_SETTLEMENT_LOCATION_CLS_GROUP 0x03                     // Cls Group
#define PARTY_ID_SETTLEMENT_LOCATION_EUROCLEAR 0x04                     // Euroclear

// Hedge Type: one byte code
#define HEDGE_TYPE_DURATION_HEDGE 0x00      // Duration Hedge
#define HEDGE_TYPE_NOMINAL_HEDGE 0x01       // Nominal Hedge
#define HEDGE_TYPE_PRICE_FACTOR_HEDGE 0x02  // Price Factor Hedge

// Event Type: one byte code
#define EVENT_TYPE_SWAP_START_DATE 0x08  // Swap Start Date
#define EVENT_TYPE_SWAP_END_DATE 0x09    // Swap End Date

// Instr Attrib Type: one byte code
#define INSTR_ATTRIB_TYPE_VARIABLE_RATE 0x05                  // Variable Rate
#define INSTR_ATTRIB_TYPE_COUPON_RATE 0x64                    // Coupon Rate
#define INSTR_ATTRIB_TYPE_OFFSETTOTHEVARIABLECOUPONRATE 0x65  // Offsettothevariablecouponrate
#define INSTR_ATTRIB_TYPE_SWAP_CUSTOMER_1 0x66                // Swap Customer 1
#define INSTR_ATTRIB_TYPE_SWAP_CUSTOMER_2 0x67                // Swap Customer 2
#define INSTR_ATTRIB_TYPE_CASH_BASKET_REFERENCE 0x68          // Cash Basket Reference

// Compression Action: one byte code
#define COMPRESSION_ACTION_START_COMPRESSION 0x01    // Start Compression
#define COMPRESSION_ACTION_COMMIT_COMPRESSION 0x02   // Commit Compression
#define COMPRESSION_ACTION_CANCEL_COMPRESSION 0x03   // Cancel Compression
#define COMPRESSION_ACTION_INQUIRE_COMPRESSION 0x04  // Inquire Compression

// Compression Status: one byte code
#define COMPRESSION_STATUS_OPEN 0x01                 // Open
#define COMPRESSION_STATUS_EXECUTED 0x02             // Executed
#define COMPRESSION_STATUS_CANCELLED_BY_USER 0x03    // Cancelled By User
#define COMPRESSION_STATUS_CANCELLED_BY_SYSTEM 0x04  // Cancelled By System

// Reversal Cancellation Reason: one byte code
#define REVERSAL_CANCELLATION_REASON_TAS_CHANGE 0x01             // Tas Change
#define REVERSAL_CANCELLATION_REASON_INTRADAY_EXPIRATION 0x02    // Intraday Expiration
#define REVERSAL_CANCELLATION_REASON_INSTRUMENT_DELETION 0x03    // Instrument Deletion
#define REVERSAL_CANCELLATION_REASON_INSTRUMENT_SUSPENSION 0x04  // Instrument Suspension

// Related Product Complex: one byte code
#define RELATED_PRODUCT_COMPLEX_STANDARDOPTIONSTRATEGY 0x02     // Standardoptionstrategy
#define RELATED_PRODUCT_COMPLEX_NONSTANDARDOPTIONSTRATEGY 0x03  // Nonstandardoptionstrategy
#define RELATED_PRODUCT_COMPLEX_VOLATILITYSTRATEGY 0x04         // Volatilitystrategy
#define RELATED_PRODUCT_COMPLEX_FUTURES_SPREAD 0x05             // Futures Spread
#define RELATED_PRODUCT_COMPLEX_INTERPRODUCTSPREAD 0x06         // Interproductspread
#define RELATED_PRODUCT_COMPLEX_STANDARDFUTURESTRATEGY 0x07     // Standardfuturestrategy
#define RELATED_PRODUCT_COMPLEX_PACKANDBUNDLE 0x08              // Packandbundle
#define RELATED_PRODUCT_COMPLEX_STRIP 0x09                      // Strip

// Transfer Reason: one byte code
#define TRANSFER_REASON_OWNER 0x01    // Owner
#define TRANSFER_REASON_CLEARER 0x02  // Clearer

// Multi Leg Reporting Type: one byte code
#define MULTI_LEG_REPORTING_TYPE_SINGLESECURITY 0x01                    // Singlesecurity
#define MULTI_LEG_REPORTING_TYPE_INDIVIDUALLEGOFAMULTILEGSECURITY 0x02  // Individuallegofamultilegsecurity

// Multileg Price Model: one byte code
#define MULTILEG_PRICE_MODEL_STANDARD 0x00      // Standard
#define MULTILEG_PRICE_MODEL_USER_DEFINED 0x01  // User Defined

// Order Attribute Liquidity Provision: one byte code
#define ORDER_ATTRIBUTE_LIQUIDITY_PROVISION_Y 0x01  // Y
#define ORDER_ATTRIBUTE_LIQUIDITY_PROVISION_N 0x00  // N

// Order Attribute Risk Reduction: one byte code
#define ORDER_ATTRIBUTE_RISK_REDUCTION_Y 0x01  // Y
#define ORDER_ATTRIBUTE_RISK_REDUCTION_N 0x00  // N

// Executing Trader Qualifier: one byte code
#define EXECUTING_TRADER_QUALIFIER_ALGO 0x16   // Algo
#define EXECUTING_TRADER_QUALIFIER_HUMAN 0x18  // Human

// Root Party Id Investment Decision Maker Qualifier: one byte code
#define ROOT_PARTY_ID_INVESTMENT_DECISION_MAKER_QUALIFIER_ALGO 0x16   // Algo
#define ROOT_PARTY_ID_INVESTMENT_DECISION_MAKER_QUALIFIER_HUMAN 0x18  // Human

// Order Origination: one byte code
#define ORDER_ORIGINATION_DIRECTACCESSORSPONSOREDACCESSCUSTOMER 0x05  // Directaccessorsponsoredaccesscustomer

// Reversal Indicator: one byte code
#define REVERSAL_INDICATOR_NO 0x00   // No
#define REVERSAL_INDICATOR_YES 0x01  // Yes

// Trade Platform: one byte code
#define TRADE_PLATFORM_OFF_BOOK 0x00  // Off Book
#define TRADE_PLATFORM_ON_BOOK 0x01   // On Book

// Party Id Investment Decision Maker Qualifier: one byte code
#define PARTY_ID_INVESTMENT_DECISION_MAKER_QUALIFIER_ALGO 0x16   // Algo
#define PARTY_ID_INVESTMENT_DECISION_MAKER_QUALIFIER_HUMAN 0x18  // Human

// Match Sub Type: one byte code
#define MATCH_SUB_TYPE_OPENING_AUCTION 0x01          // Opening Auction
#define MATCH_SUB_TYPE_CLOSING_AUCTION 0x02          // Closing Auction
#define MATCH_SUB_TYPE_INTRADAY_AUCTION 0x03         // Intraday Auction
#define MATCH_SUB_TYPE_CIRCUIT_BREAKER_AUCTION 0x04  // Circuit Breaker Auction
#define MATCH_SUB_TYPE_OUTSIDE_BBO 0x06              // Outside Bbo

// Side Liquidity Ind: one byte code
#define SIDE_LIQUIDITY_IND_ADDED_LIQUIDITY 0x01    // Added Liquidity
#define SIDE_LIQUIDITY_IND_REMOVED_LIQUIDITY 0x02  // Removed Liquidity
#define SIDE_LIQUIDITY_IND_AUCTION 0x04            // Auction

// Order Category: one byte code
#define ORDER_CATEGORY_ORDER 0x31  // Order
#define ORDER_CATEGORY_QUOTE 0x32  // Quote

// Order Side: one byte code
#define ORDER_SIDE_BUY 0x01   // Buy
#define ORDER_SIDE_SELL 0x02  // Sell

// ---- Types -------------------------------------------------------------------

typedef struct _NrResponseHeaderMeComp {
  UINT64 request_time;         // bytes 0 to 7
  UINT64 trd_reg_ts_time_in;   // bytes 8 to 15
  UINT64 trd_reg_ts_time_out;  // bytes 16 to 23
  UINT64 response_in;          // bytes 24 to 31
  UINT64 sending_time;         // bytes 32 to 39
  UINT32 msg_seq_num;          // bytes 40 to 43
  UINT8 last_fragment;         // byte 44
  UINT8 pad3[3];               // bytes 45 to 47
} NrResponseHeaderMeComp;

typedef struct _InstrmtLegGrpComp {
  UINT64 leg_security_id;   // bytes 0 to 7, signed, read here as unsigned
  UINT64 leg_price;         // bytes 8 to 15, signed, read here as unsigned
  UINT32 leg_symbol;        // bytes 16 to 19, signed, read here as unsigned
  UINT32 leg_ratio_qty;     // bytes 20 to 23
  UINT8 leg_side;           // byte 24
  UINT8 leg_security_type;  // byte 25
  UINT8 pad6[6];            // bytes 26 to 31
} InstrmtLegGrpComp;

typedef struct _AddComplexInstrumentResponse {
  UINT8 pad2[2];                                                                 // bytes 0 to 1
  NrResponseHeaderMeComp nr_response_header_me_comp;                             // bytes 2 to 49
  UINT64 low_limit_price;                                                        // bytes 50 to 57, signed, read here as unsigned
  UINT64 high_limit_price;                                                       // bytes 58 to 65, signed, read here as unsigned
  UINT64 security_id;                                                            // bytes 66 to 73, signed, read here as unsigned
  UINT64 last_update_time;                                                       // bytes 74 to 81
  UINT64 security_response_id;                                                   // bytes 82 to 89
  UINT32 market_segment_id;                                                      // bytes 90 to 93, signed, read here as unsigned
  UINT32 number_of_securities;                                                   // bytes 94 to 97, signed, read here as unsigned
  UINT32 security_sub_type;                                                      // bytes 98 to 101, signed, read here as unsigned
  UINT8 multileg_model;                                                          // byte 102
  UINT8 implied_market_indicator;                                                // byte 103
  UINT8 product_complex;                                                         // byte 104
  UINT8 no_legs;                                                                 // byte 105
  InstrmtLegGrpComp instrmt_leg_grp_comp[:byte-size (((UINT32) no_legs) * 32)];
} AddComplexInstrumentResponse;

typedef struct _AddFlexibleInstrumentResponse {
  UINT8 pad2[2];                                      // bytes 0 to 1
  NrResponseHeaderMeComp nr_response_header_me_comp;  // bytes 2 to 49
  UINT64 security_response_id;                        // bytes 50 to 57
  UINT64 security_id;                                 // bytes 58 to 65, signed, read here as unsigned
  UINT64 strike_price;                                // bytes 66 to 73, signed, read here as unsigned
  UINT32 market_segment_id;                           // bytes 74 to 77, signed, read here as unsigned
  UINT32 maturity_date;                               // bytes 78 to 81
  UINT8 product_complex;                              // byte 82
  UINT8 settl_method;                                 // byte 83
  UINT8 opt_attribute;                                // byte 84
  UINT8 put_or_call;                                  // byte 85
  UINT8 exercise_style;                               // byte 86
  UINT8 pad3[3];                                      // bytes 87 to 89
} AddFlexibleInstrumentResponse;

typedef struct _RbcHeaderComp {
  UINT64 sending_time;     // bytes 0 to 7
  UINT64 appl_seq_num;     // bytes 8 to 15
  UINT32 appl_sub_id;      // bytes 16 to 19
  UINT16 partition_id;     // bytes 20 to 21
  UINT8 appl_resend_flag;  // byte 22
  UINT8 appl_id;           // byte 23
  UINT8 last_fragment;     // byte 24
  UINT8 pad7[7];           // bytes 25 to 31
} RbcHeaderComp;

typedef struct _BasketRootPartyGrpComp {
  UINT16 root_party_sub_id_type;          // bytes 0 to 1
  UINT8 root_party_contra_firm[5];        // bytes 2 to 6
  UINT8 root_party_contra_trader[6];      // bytes 7 to 12
  UINT8 basket_side_trade_report_id[20];  // bytes 13 to 32
  UINT8 pad7[7];                          // bytes 33 to 39
} BasketRootPartyGrpComp;

typedef struct _BasketSideAllocExtBcGrpComp {
  UINT64 alloc_qty;                          // bytes 0 to 7, signed, read here as unsigned
  UINT64 security_id;                        // bytes 8 to 15, signed, read here as unsigned
  UINT64 last_px;                            // bytes 16 to 23, signed, read here as unsigned
  UINT64 trans_bkd_time;                     // bytes 24 to 31
  UINT64 related_close_price;                // bytes 32 to 39, signed, read here as unsigned
  UINT32 package_id;                         // bytes 40 to 43
  UINT32 side_market_segment_id;             // bytes 44 to 47, signed, read here as unsigned
  UINT32 alloc_id;                           // bytes 48 to 51
  UINT32 negotiation_id;                     // bytes 52 to 55
  UINT32 srqs_related_trade_id;              // bytes 56 to 59
  UINT16 side_trd_sub_typ;                   // bytes 60 to 61
  UINT16 party_sub_id_type;                  // bytes 62 to 63
  UINT8 side;                                // byte 64
  UINT8 position_effect;                     // byte 65
  UINT8 effect_on_basket;                    // byte 66
  UINT8 trading_capacity;                    // byte 67
  UINT8 trade_alloc_status;                  // byte 68
  UINT8 product_complex;                     // byte 69
  UINT8 trade_publish_indicator;             // byte 70
  UINT8 party_executing_firm[5];             // bytes 71 to 75
  UINT8 party_executing_trader[6];           // bytes 76 to 81
  UINT8 account[2];                          // bytes 82 to 83
  UINT8 free_text_1[12];                     // bytes 84 to 95
  UINT8 free_text_2[12];                     // bytes 96 to 107
  UINT8 free_text_3[12];                     // bytes 108 to 119
  UINT8 party_id_take_up_trading_firm[5];    // bytes 120 to 124
  UINT8 party_id_order_origination_firm[7];  // bytes 125 to 131
  UINT8 party_id_beneficiary[9];             // bytes 132 to 140
  UINT8 party_id_position_account[32];       // bytes 141 to 172
  UINT8 party_id_location_id[2];             // bytes 173 to 174
  UINT8 cust_order_handling_inst;            // byte 175
  UINT8 compliance_text[20];                 // bytes 176 to 195
  UINT8 pad4[4];                             // bytes 196 to 199
} BasketSideAllocExtBcGrpComp;

typedef struct _BasketApproveBroadcast {
  UINT8 pad2[2];                                                                                                      // bytes 0 to 1
  RbcHeaderComp rbc_header_comp;                                                                                      // bytes 2 to 33
  UINT64 basket_trd_match_id;                                                                                         // bytes 34 to 41
  UINT64 transact_time;                                                                                               // bytes 42 to 49
  UINT32 basket_exec_id;                                                                                              // bytes 50 to 53
  UINT32 market_segment_id;                                                                                           // bytes 54 to 57, signed, read here as unsigned
  UINT32 basket_profile_id;                                                                                           // bytes 58 to 61
  UINT16 trd_type;                                                                                                    // bytes 62 to 63
  UINT8 trade_report_type;                                                                                            // byte 64
  UINT8 basket_trade_report_type;                                                                                     // byte 65
  UINT8 message_event_source;                                                                                         // byte 66
  UINT8 no_basket_side_alloc;                                                                                         // byte 67
  UINT8 no_basket_root_party_grps;                                                                                    // byte 68
  UINT8 party_id_entering_firm;                                                                                       // byte 69
  UINT8 party_entering_trader[6];                                                                                     // bytes 70 to 75
  UINT8 basket_trade_report_text[20];                                                                                 // bytes 76 to 95
  UINT8 trade_report_id[20];                                                                                          // bytes 96 to 115
  UINT8 pad6[6];                                                                                                      // bytes 116 to 121
  BasketRootPartyGrpComp basket_root_party_grp_comp[:byte-size (((UINT32) no_basket_root_party_grps) * 40)];
  BasketSideAllocExtBcGrpComp basket_side_alloc_ext_bc_grp_comp[:byte-size (((UINT32) no_basket_side_alloc) * 200)];
} BasketApproveBroadcast;

typedef struct _InstrmtMatchSideGrpComp {
  UINT64 security_id;             // bytes 0 to 7, signed, read here as unsigned
  UINT64 last_px;                 // bytes 8 to 15, signed, read here as unsigned
  UINT64 trans_bkd_time;          // bytes 16 to 23
  UINT64 related_close_price;     // bytes 24 to 31, signed, read here as unsigned
  UINT32 package_id;              // bytes 32 to 35
  UINT32 side_market_segment_id;  // bytes 36 to 39, signed, read here as unsigned
  UINT32 negotiation_id;          // bytes 40 to 43
  UINT32 srqs_related_trade_id;   // bytes 44 to 47
  UINT16 side_trd_sub_typ;        // bytes 48 to 49
  UINT8 product_complex;          // byte 50
  UINT8 trade_publish_indicator;  // byte 51
  UINT8 instrmt_match_side_id;    // byte 52
  UINT8 effect_on_basket;         // byte 53
  UINT8 trade_report_text[20];    // bytes 54 to 73
  UINT8 pad6[6];                  // bytes 74 to 79
} InstrmtMatchSideGrpComp;

typedef struct _BasketSideAllocGrpComp {
  UINT64 alloc_qty;                 // bytes 0 to 7, signed, read here as unsigned
  UINT32 individual_alloc_id;       // bytes 8 to 11
  UINT16 party_sub_id_type;         // bytes 12 to 13
  UINT8 side;                       // byte 14
  UINT8 instrmt_match_side_id;      // byte 15
  UINT8 trade_alloc_status;         // byte 16
  UINT8 party_executing_firm[5];    // bytes 17 to 21
  UINT8 party_executing_trader[6];  // bytes 22 to 27
  UINT8 pad4[4];                    // bytes 28 to 31
} BasketSideAllocGrpComp;

typedef struct _BasketBroadcast {
  UINT8 pad2[2];                                                                                                 // bytes 0 to 1
  RbcHeaderComp rbc_header_comp;                                                                                 // bytes 2 to 33
  UINT64 basket_trd_match_id;                                                                                    // bytes 34 to 41
  UINT64 transact_time;                                                                                          // bytes 42 to 49
  UINT32 basket_exec_id;                                                                                         // bytes 50 to 53
  UINT32 market_segment_id;                                                                                      // bytes 54 to 57, signed, read here as unsigned
  UINT32 maturity_month_year;                                                                                    // bytes 58 to 61
  UINT32 basket_profile_id;                                                                                      // bytes 62 to 65
  UINT16 trd_type;                                                                                               // bytes 66 to 67
  UINT8 trade_report_type;                                                                                       // byte 68
  UINT8 basket_trade_report_type;                                                                                // byte 69
  UINT8 message_event_source;                                                                                    // byte 70
  UINT8 no_basket_root_party_grps_bc;                                                                            // byte 71
  UINT8 no_instrmt_match_sides;                                                                                  // byte 72
  UINT8 no_basket_side_alloc;                                                                                    // byte 73
  UINT8 basket_trade_report_text[20];                                                                            // bytes 74 to 93
  UINT8 trade_report_id[20];                                                                                     // bytes 94 to 113
  BasketRootPartyGrpComp basket_root_party_grp_comp[:byte-size (((UINT32) no_basket_root_party_grps_bc) * 40)];
  InstrmtMatchSideGrpComp instrmt_match_side_grp_comp[:byte-size (((UINT32) no_instrmt_match_sides) * 80)];
  BasketSideAllocGrpComp basket_side_alloc_grp_comp[:byte-size (((UINT32) no_basket_side_alloc) * 32)];
} BasketBroadcast;

typedef struct _BasketDeleteBroadcast {
  UINT8 pad2[2];                  // bytes 0 to 1
  RbcHeaderComp rbc_header_comp;  // bytes 2 to 33
