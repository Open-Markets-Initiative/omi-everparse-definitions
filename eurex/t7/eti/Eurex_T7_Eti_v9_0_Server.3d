typedef struct _ResponseHeaderComp {
  UINT64 request_time;  // bytes 0 to 7
  UINT64 sending_time;  // bytes 8 to 15
  UINT32 msg_seq_num;   // bytes 16 to 19
  UINT8 pad4[4];        // bytes 20 to 23
} ResponseHeaderComp;

typedef struct _BasketResponse {
  UINT8 pad2[2];                            // bytes 0 to 1
  ResponseHeaderComp response_header_comp;  // bytes 2 to 25
  UINT32 basket_exec_id;                    // bytes 26 to 29
  UINT8 trade_report_id[20];                // bytes 30 to 49
} BasketResponse;

typedef struct _NotifHeaderComp {
  UINT64 sending_time;  // bytes 0 to 7
} NotifHeaderComp;

typedef struct _BroadcastErrorNotification (UINT32 available) where (available >= 26) {
  UINT8 pad2[2];                                                          // bytes 0 to 1
  NotifHeaderComp notif_header_comp;                                      // bytes 2 to 9
  UINT32 appl_id_status;                                                  // bytes 10 to 13
  UINT32 ref_appl_sub_id;                                                 // bytes 14 to 17
  UINT16 var_text_len { ((UINT32) var_text_len) <= (available - 26) };    // bytes 18 to 19
  UINT8 ref_appl_id;                                                      // byte 20
  UINT8 session_status;                                                   // byte 21
  UINT8 pad4[4];                                                          // bytes 22 to 25
  UINT8 var_text[((UINT32) var_text_len)];
  UINT8 alignment_padding[((available - 26) - ((UINT32) var_text_len))];
} BroadcastErrorNotification;

typedef struct _RbcHeaderMeComp {
  UINT64 trd_reg_ts_time_out;  // bytes 0 to 7
  UINT64 notification_in;      // bytes 8 to 15
  UINT64 sending_time;         // bytes 16 to 23
  UINT32 appl_sub_id;          // bytes 24 to 27
  UINT16 partition_id;         // bytes 28 to 29
  UINT8 appl_msg_id[16];       // bytes 30 to 45
  UINT8 appl_id;               // byte 46
  UINT8 appl_resend_flag;      // byte 47
  UINT8 last_fragment;         // byte 48
  UINT8 pad7[7];               // bytes 49 to 55
} RbcHeaderMeComp;

typedef struct _ClipDeletionNotification {
  UINT8 pad2[2];                       // bytes 0 to 1
  RbcHeaderMeComp rbc_header_me_comp;  // bytes 2 to 57
  UINT64 order_id;                     // bytes 58 to 65
  UINT64 exec_id;                      // bytes 66 to 73
  UINT64 security_id;                  // bytes 74 to 81, signed, read here as unsigned
  UINT64 cxl_qty;                      // bytes 82 to 89, signed, read here as unsigned
  UINT32 market_segment_id;            // bytes 90 to 93, signed, read here as unsigned
  UINT16 exec_restatement_reason;      // bytes 94 to 95
  UINT8 product_complex;               // byte 96
  UINT8 side;                          // byte 97
  UINT8 ord_status;                    // byte 98
  UINT8 exec_type;                     // byte 99
