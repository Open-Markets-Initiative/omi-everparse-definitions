  UINT64 transact_time;           // bytes 42 to 49
  UINT32 market_segment_id;       // bytes 50 to 53, signed, read here as unsigned
  UINT32 basket_exec_id;          // bytes 54 to 57
  UINT32 basket_profile_id;       // bytes 58 to 61
  UINT16 trd_type;                // bytes 62 to 63
  UINT8 delete_reason;            // byte 64
  UINT8 message_event_source;     // byte 65
  UINT8 trade_report_id[20];      // bytes 66 to 85
  UINT8 pad4[4];                  // bytes 86 to 89
} BasketDeleteBroadcast;

typedef struct _BasketExecGrpComp {
