// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Eurex_T7_Eobi_v6_1.3d

// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_ADD_COMPLEX_INSTRUMENT 0x3458   // Add Complex Instrument
#define TEMPLATE_ID_AUCTION_BBO 0x34BC              // Auction Bbo
#define TEMPLATE_ID_AUCTION_CLEARING_PRICE 0x34BD   // Auction Clearing Price
#define TEMPLATE_ID_CROSS_REQUEST 0x34BE            // Cross Request
#define TEMPLATE_ID_EXECUTION_SUMMARY 0x3392        // Execution Summary
#define TEMPLATE_ID_FULL_ORDER_EXECUTION 0x3330     // Full Order Execution
#define TEMPLATE_ID_HEARTBEAT 0x32C9                // Heartbeat
#define TEMPLATE_ID_INSTRUMENT_STATE_CHANGE 0x33F5  // Instrument State Change
#define TEMPLATE_ID_INSTRUMENT_SUMMARY 0x3521       // Instrument Summary
#define TEMPLATE_ID_ORDER_ADD 0x332C                // Order Add
#define TEMPLATE_ID_ORDER_DELETE 0x332E             // Order Delete
#define TEMPLATE_ID_ORDER_MASS_DELETE 0x332F        // Order Mass Delete
#define TEMPLATE_ID_ORDER_MODIFY 0x332D             // Order Modify
#define TEMPLATE_ID_ORDER_MODIFY_SAME_PRIO 0x3332   // Order Modify Same Prio
#define TEMPLATE_ID_PACKET_HEADER 0x32CB            // Packet Header
#define TEMPLATE_ID_PARTIAL_ORDER_EXECUTION 0x3331  // Partial Order Execution
#define TEMPLATE_ID_PRODUCT_STATE_CHANGE 0x33F4     // Product State Change
#define TEMPLATE_ID_PRODUCT_SUMMARY 0x3520          // Product Summary
#define TEMPLATE_ID_QUOTE_REQUEST 0x34BF            // Quote Request
#define TEMPLATE_ID_SNAPSHOT_ORDER 0x3522           // Snapshot Order
#define TEMPLATE_ID_TOP_OF_BOOK 0x34C0              // Top Of Book
#define TEMPLATE_ID_TRADE_REPORT 0x3391             // Trade Report
#define TEMPLATE_ID_TRADE_REVERSAL 0x3390           // Trade Reversal

// Completion Indicator: one byte code
#define COMPLETION_INDICATOR_INCOMPLETE 0x00  // Incomplete
#define COMPLETION_INDICATOR_COMPLETE 0x01    // Complete

// Appl Seq Reset Indicator: one byte code
#define APPL_SEQ_RESET_INDICATOR_NO_RESET 0x00  // No Reset
#define APPL_SEQ_RESET_INDICATOR_RESET 0x01     // Reset

// Product Complex: one byte code
#define PRODUCT_COMPLEX_STANDARD_OPTION_STRATEGY 0x02      // Standard Option Strategy
#define PRODUCT_COMPLEX_NON_STANDARD_OPTION_STRATEGY 0x03  // Non Standard Option Strategy
#define PRODUCT_COMPLEX_VOLATILITY_STRATEGY 0x04           // Volatility Strategy
#define PRODUCT_COMPLEX_FUTURES_SPREAD 0x05                // Futures Spread
#define PRODUCT_COMPLEX_INTER_PRODUCT_SPREAD 0x06          // Inter Product Spread
#define PRODUCT_COMPLEX_STANDARD_FUTURES_STRATEGY 0x07     // Standard Futures Strategy
#define PRODUCT_COMPLEX_PACK_AND_BUNDLE 0x08               // Pack And Bundle
#define PRODUCT_COMPLEX_STRIP 0x09                         // Strip

// Implied Market Indicator: one byte code
#define IMPLIED_MARKET_INDICATOR_NOT_IMPLIED 0x00     // Not Implied
#define IMPLIED_MARKET_INDICATOR_IMPLIED_IN_OUT 0x03  // Implied In Out

// Leg Side: one byte code
#define LEG_SIDE_BUY 0x01   // Buy
#define LEG_SIDE_SELL 0x02  // Sell

// Potential Security Trading Event: one byte code
#define POTENTIAL_SECURITY_TRADING_EVENT_NONE 0x00                                  // None
#define POTENTIAL_SECURITY_TRADING_EVENT_PRICE_VOLATILITY_AUCTION_IS_EXTENDED 0x0A  // Price Volatility Auction Is Extended

// Security Trading Status: one byte code
#define SECURITY_TRADING_STATUS_TRADING_HALT 0x02                    // Trading Halt
#define SECURITY_TRADING_STATUS_MARKET_IMBALANCE_BUY 0x07            // Market Imbalance Buy
#define SECURITY_TRADING_STATUS_MARKET_IMBALANCE_SELL 0x08           // Market Imbalance Sell
#define SECURITY_TRADING_STATUS_CLOSED 0xC8                          // Closed
#define SECURITY_TRADING_STATUS_RESTRICTED 0xC9                      // Restricted
#define SECURITY_TRADING_STATUS_BOOK 0xCA                            // Book
#define SECURITY_TRADING_STATUS_CONTINUOUS 0xCB                      // Continuous
#define SECURITY_TRADING_STATUS_OPENING_AUCTION 0xCC                 // Opening Auction
#define SECURITY_TRADING_STATUS_OPENING_AUCTION_FREEZE 0xCD          // Opening Auction Freeze
#define SECURITY_TRADING_STATUS_INTRADAY_AUCTION 0xCE                // Intraday Auction
#define SECURITY_TRADING_STATUS_INTRADAY_AUCTION_FREEZE 0xCF         // Intraday Auction Freeze
#define SECURITY_TRADING_STATUS_CIRCUIT_BREAKER_AUCTION 0xD0         // Circuit Breaker Auction
#define SECURITY_TRADING_STATUS_CIRCUIT_BREAKER_AUCTION_FREEZE 0xD1  // Circuit Breaker Auction Freeze
#define SECURITY_TRADING_STATUS_CLOSING_AUCTION 0xD2                 // Closing Auction
#define SECURITY_TRADING_STATUS_CLOSING_AUCTION_FREEZE 0xD3          // Closing Auction Freeze
#define SECURITY_TRADING_STATUS_IPO_AUCTION 0xD4                     // Ipo Auction
#define SECURITY_TRADING_STATUS_IPO_AUCTION_FREEZE 0xD5              // Ipo Auction Freeze

// Aggressor Side: one byte code
#define AGGRESSOR_SIDE_BUY 0x01   // Buy
#define AGGRESSOR_SIDE_SELL 0x02  // Sell

// Trade Condition: one byte code
#define TRADE_CONDITION_IMPLIED_TRADE 0x01            // Implied Trade
#define TRADE_CONDITION_SYSTEMATIC_INTERNALIZER 0x99  // Systematic Internalizer
#define TRADE_CONDITION_MIDPOINT_PRICE 0x9B           // Midpoint Price

// Side: one byte code
#define SIDE_BUY 0x01   // Buy
#define SIDE_SELL 0x02  // Sell

// Ord Type: one byte code
#define ORD_TYPE_MARKET 0x01  // Market

// Algorithmic Trade Indicator: one byte code
#define ALGORITHMIC_TRADE_INDICATOR_ALGORITHMIC_TRADE 0x01  // Algorithmic Trade

// Security Status: one byte code
#define SECURITY_STATUS_ACTIVE 0x01            // Active
#define SECURITY_STATUS_INACTIVE 0x02          // Inactive
#define SECURITY_STATUS_EXPIRED 0x04           // Expired
#define SECURITY_STATUS_SUSPENDED 0x09         // Suspended
#define SECURITY_STATUS_PENDING_DELETION 0x0B  // Pending Deletion

// Market Condition: one byte code
#define MARKET_CONDITION_NORMAL 0x00    // Normal
#define MARKET_CONDITION_STRESSED 0x01  // Stressed

// Fast Market Indicator: one byte code
#define FAST_MARKET_INDICATOR_NO 0x00   // No
#define FAST_MARKET_INDICATOR_YES 0x01  // Yes

// Security Trading Event: one byte code
#define SECURITY_TRADING_EVENT_PRICE_VOLATILITY_AUCTION_IS_EXTENDED 0x0A        // Price Volatility Auction Is Extended
#define SECURITY_TRADING_EVENT_PRICE_VOLATILITY_AUCTION_IS_EXTENDED_AGAIN 0x0B  // Price Volatility Auction Is Extended Again

// Md Entry Type: one byte code
#define MD_ENTRY_TYPE_TRADE 0x02                    // Trade
#define MD_ENTRY_TYPE_OPENING_PRICE 0x04            // Opening Price
#define MD_ENTRY_TYPE_CLOSING_PRICE 0x05            // Closing Price
#define MD_ENTRY_TYPE_HIGH_PRICE 0x07               // High Price
#define MD_ENTRY_TYPE_LOW_PRICE 0x08                // Low Price
#define MD_ENTRY_TYPE_TRADE_VOLUME 0x42             // Trade Volume
#define MD_ENTRY_TYPE_PREVIOUS_CLOSING_PRICE 0x65   // Previous Closing Price
#define MD_ENTRY_TYPE_OPENING_AUCTION 0xC8          // Opening Auction
#define MD_ENTRY_TYPE_INTRADAY_AUCTION 0xC9         // Intraday Auction
#define MD_ENTRY_TYPE_CIRCUIT_BREAKER_AUCTION 0xCA  // Circuit Breaker Auction
#define MD_ENTRY_TYPE_CLOSING_AUCTION 0xCB          // Closing Auction
#define MD_ENTRY_TYPE_IPO_AUCTION 0xCC              // Ipo Auction

// Trading Session Id: one byte code
#define TRADING_SESSION_ID_DAY 0x01          // Day
#define TRADING_SESSION_ID_MORNING 0x03      // Morning
#define TRADING_SESSION_ID_EVENING 0x05      // Evening
#define TRADING_SESSION_ID_AFTER_HOURS 0x06  // After Hours
#define TRADING_SESSION_ID_HOLIDAY 0x07      // Holiday

// Trading Session Sub Id: one byte code
#define TRADING_SESSION_SUB_ID_PRE_TRADING 0x01   // Pre Trading
#define TRADING_SESSION_SUB_ID_CONTINUOUS 0x03    // Continuous
#define TRADING_SESSION_SUB_ID_CLOSING 0x04       // Closing
#define TRADING_SESSION_SUB_ID_POST_TRADING 0x05  // Post Trading
#define TRADING_SESSION_SUB_ID_QUIESCENT 0x07     // Quiescent

// Trad Ses Status: one byte code
#define TRAD_SES_STATUS_HALTED 0x01  // Halted
#define TRAD_SES_STATUS_OPEN 0x02    // Open
#define TRAD_SES_STATUS_CLOSED 0x03  // Closed

// Match Type: one byte code
#define MATCH_TYPE_CONFIRMED_TRADE_REPORT 0x03  // Confirmed Trade Report
#define MATCH_TYPE_CROSS_AUCTION 0x05           // Cross Auction
#define MATCH_TYPE_CALL_AUCTION 0x07            // Call Auction

// Match Sub Type: one byte code
#define MATCH_SUB_TYPE_OPENING_AUCTION 0x01          // Opening Auction
#define MATCH_SUB_TYPE_CLOSING_AUCTION 0x02          // Closing Auction
#define MATCH_SUB_TYPE_INTRADAY_AUCTION 0x03         // Intraday Auction
#define MATCH_SUB_TYPE_CIRCUIT_BREAKER_AUCTION 0x04  // Circuit Breaker Auction
#define MATCH_SUB_TYPE_IPO_AUCTION 0x05              // Ipo Auction

// ---- Types -------------------------------------------------------------------

// EOBI PacketHeader MessageHeaderComp (BodyLen + TemplateID + MsgSeqNum) first 8 bytes of every Eurex T7 EOBI packet.
typedef struct _EobiHeader {
  UINT16 body_len;     // bytes 0 to 1
  UINT16 template_id;  // bytes 2 to 3
  UINT32 msg_seq_num;  // bytes 4 to 7
} EobiHeader;

// Eurex Eobi Packet Header
typedef struct _PacketHeader {
  EobiHeader eobi_header;          // bytes 0 to 7
  UINT32 appl_seq_num;             // bytes 8 to 11
  UINT32 market_segment_id;        // bytes 12 to 15, signed, read here as unsigned
  UINT8 partition_id;              // byte 16
  UINT8 completion_indicator;      // byte 17
  UINT8 appl_seq_reset_indicator;  // byte 18
  UINT8 pad5[5];                   // bytes 19 to 23
  UINT64 transact_time;            // bytes 24 to 31
} PacketHeader;

typedef struct _InstrmtLegGrpComp {
  UINT32 leg_symbol;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 pad4[4];           // bytes 4 to 7
  UINT64 leg_security_id;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 leg_ratio_qty;    // bytes 16 to 19, signed, read here as unsigned
  UINT8 leg_side;          // byte 20
  UINT8 pad3[3];           // bytes 21 to 23
} InstrmtLegGrpComp;

typedef struct _AddComplexInstrument {
  UINT64 security_id;                                      // bytes 0 to 7, signed, read here as unsigned
  UINT64 transact_time;                                    // bytes 8 to 15
  UINT32 security_sub_type;                                // bytes 16 to 19, signed, read here as unsigned
  UINT8 product_complex;                                   // byte 20
  UINT8 implied_market_indicator;                          // byte 21
  UINT8 no_legs;                                           // byte 22
  UINT8 pad1;                                              // byte 23
  InstrmtLegGrpComp instrmt_leg_grp_comp[:byte-size 480];  // bytes 24 to 503
} AddComplexInstrument;

typedef struct _AuctionBbo {
  UINT64 transact_time;                    // bytes 0 to 7
  UINT64 security_id;                      // bytes 8 to 15, signed, read here as unsigned
  UINT64 bid_px;                           // bytes 16 to 23, signed, read here as unsigned
  UINT64 offer_px;                         // bytes 24 to 31, signed, read here as unsigned
  UINT32 bid_size;                         // bytes 32 to 35, signed, read here as unsigned
  UINT32 offer_size;                       // bytes 36 to 39, signed, read here as unsigned
  UINT8 potential_security_trading_event;  // byte 40
  UINT8 pad7[7];                           // bytes 41 to 47
} AuctionBbo;

typedef struct _AuctionClearingPrice {
  UINT64 transact_time;                    // bytes 0 to 7
  UINT64 security_id;                      // bytes 8 to 15, signed, read here as unsigned
  UINT64 last_px;                          // bytes 16 to 23, signed, read here as unsigned
  UINT32 last_qty;                         // bytes 24 to 27, signed, read here as unsigned
  UINT32 imbalance_qty;                    // bytes 28 to 31, signed, read here as unsigned
  UINT8 security_trading_status;           // byte 32
  UINT8 potential_security_trading_event;  // byte 33
  UINT8 pad6[6];                           // bytes 34 to 39
} AuctionClearingPrice;

typedef struct _CrossRequest {
  UINT64 security_id;    // bytes 0 to 7, signed, read here as unsigned
  UINT32 last_qty;       // bytes 8 to 11, signed, read here as unsigned
  UINT8 pad4[4];         // bytes 12 to 15
  UINT64 transact_time;  // bytes 16 to 23
} CrossRequest;

typedef struct _ExecutionSummary {
  UINT64 security_id;         // bytes 0 to 7, signed, read here as unsigned
  UINT64 aggressor_time;      // bytes 8 to 15
  UINT64 request_time;        // bytes 16 to 23
  UINT64 exec_id;             // bytes 24 to 31
  UINT32 last_qty;            // bytes 32 to 35, signed, read here as unsigned
  UINT8 aggressor_side;       // byte 36
  UINT8 trade_condition;      // byte 37
  UINT8 pad2[2];              // bytes 38 to 39
  UINT64 last_px;             // bytes 40 to 47, signed, read here as unsigned
  UINT32 resting_hidden_qty;  // bytes 48 to 51, signed, read here as unsigned
  UINT32 resting_cxl_qty;     // bytes 52 to 55, signed, read here as unsigned
} ExecutionSummary;

typedef struct _FullOrderExecution {
  UINT8 side;                         // byte 0
  UINT8 ord_type;                     // byte 1
  UINT8 algorithmic_trade_indicator;  // byte 2
  UINT8 pad5[5];                      // bytes 3 to 7
  UINT64 price;                       // bytes 8 to 15, signed, read here as unsigned
  UINT64 trd_reg_ts_time_priority;    // bytes 16 to 23
  UINT64 security_id;                 // bytes 24 to 31, signed, read here as unsigned
  UINT32 trd_match_id;                // bytes 32 to 35
  UINT32 last_qty;                    // bytes 36 to 39, signed, read here as unsigned
  UINT64 last_px;                     // bytes 40 to 47, signed, read here as unsigned
} FullOrderExecution;

typedef struct _Heartbeat {
  UINT32 last_msg_seq_num_processed;  // bytes 0 to 3
  UINT8 pad4[4];                      // bytes 4 to 7
} Heartbeat;

typedef struct _InstrumentStateChange {
  UINT64 security_id;             // bytes 0 to 7, signed, read here as unsigned
  UINT8 security_status;          // byte 8
  UINT8 security_trading_status;  // byte 9
  UINT8 market_condition;         // byte 10
  UINT8 fast_market_indicator;    // byte 11
  UINT8 security_trading_event;   // byte 12
  UINT8 pad3[3];                  // bytes 13 to 15
  UINT64 transact_time;           // bytes 16 to 23
} InstrumentStateChange;

typedef struct _MdInstrumentEntryGrpComp {
  UINT64 md_entry_px;     // bytes 0 to 7, signed, read here as unsigned
  UINT32 md_entry_size;   // bytes 8 to 11, signed, read here as unsigned
  UINT8 md_entry_type;    // byte 12
  UINT8 trade_condition;  // byte 13
  UINT8 pad2[2];          // bytes 14 to 15
} MdInstrumentEntryGrpComp;

typedef struct _InstrumentSummary {
  UINT64 security_id;                                                     // bytes 0 to 7, signed, read here as unsigned
  UINT64 last_update_time;                                                // bytes 8 to 15
  UINT64 trd_reg_ts_execution_time;                                       // bytes 16 to 23
  UINT16 tot_no_orders;                                                   // bytes 24 to 25
  UINT8 security_status;                                                  // byte 26
  UINT8 security_trading_status;                                          // byte 27
  UINT8 market_condition;                                                 // byte 28
  UINT8 fast_market_indicator;                                            // byte 29
  UINT8 security_trading_event;                                           // byte 30
  UINT8 no_md_entries;                                                    // byte 31
  MdInstrumentEntryGrpComp md_instrument_entry_grp_comp[:byte-size 240];  // bytes 32 to 271
} InstrumentSummary;

typedef struct _OrderDetailsComp {
  UINT64 trd_reg_ts_time_priority;  // bytes 0 to 7
  UINT32 display_qty;               // bytes 8 to 11, signed, read here as unsigned
  UINT8 side;                       // byte 12
  UINT8 ord_type;                   // byte 13
  UINT8 pad2[2];                    // bytes 14 to 15
  UINT64 price;                     // bytes 16 to 23, signed, read here as unsigned
} OrderDetailsComp;

typedef struct _OrderAdd {
  UINT64 trd_reg_ts_time_in;            // bytes 0 to 7
  UINT64 security_id;                   // bytes 8 to 15, signed, read here as unsigned
  OrderDetailsComp order_details_comp;  // bytes 16 to 39
} OrderAdd;

typedef struct _OrderDelete {
  UINT64 trd_reg_ts_time_in;            // bytes 0 to 7
  UINT64 transact_time;                 // bytes 8 to 15
  UINT64 security_id;                   // bytes 16 to 23, signed, read here as unsigned
  OrderDetailsComp order_details_comp;  // bytes 24 to 47
} OrderDelete;

typedef struct _OrderMassDelete {
  UINT64 security_id;    // bytes 0 to 7, signed, read here as unsigned
  UINT64 transact_time;  // bytes 8 to 15
} OrderMassDelete;

typedef struct _OrderModify {
  UINT64 trd_reg_ts_time_in;             // bytes 0 to 7
  UINT64 trd_reg_ts_prev_time_priority;  // bytes 8 to 15
  UINT64 prev_price;                     // bytes 16 to 23, signed, read here as unsigned
  UINT32 prev_display_qty;               // bytes 24 to 27, signed, read here as unsigned
  UINT8 pad4[4];                         // bytes 28 to 31
  UINT64 security_id;                    // bytes 32 to 39, signed, read here as unsigned
  OrderDetailsComp order_details_comp;   // bytes 40 to 63
} OrderModify;

typedef struct _OrderModifySamePrio {
  UINT64 trd_reg_ts_time_in;            // bytes 0 to 7
  UINT64 transact_time;                 // bytes 8 to 15
  UINT32 prev_display_qty;              // bytes 16 to 19, signed, read here as unsigned
  UINT8 pad4[4];                        // bytes 20 to 23
  UINT64 security_id;                   // bytes 24 to 31, signed, read here as unsigned
  OrderDetailsComp order_details_comp;  // bytes 32 to 55
} OrderModifySamePrio;

typedef struct _ProductStateChange {
  UINT8 trading_session_id;      // byte 0
  UINT8 trading_session_sub_id;  // byte 1
  UINT8 trad_ses_status;         // byte 2
  UINT8 market_condition;        // byte 3
  UINT8 fast_market_indicator;   // byte 4
  UINT8 pad3[3];                 // bytes 5 to 7
  UINT64 transact_time;          // bytes 8 to 15
} ProductStateChange;

typedef struct _ProductSummary {
  UINT32 last_msg_seq_num_processed;  // bytes 0 to 3
  UINT8 trading_session_id;           // byte 4
  UINT8 trading_session_sub_id;       // byte 5
  UINT8 trad_ses_status;              // byte 6
  UINT8 market_condition;             // byte 7
  UINT8 fast_market_indicator;        // byte 8
  UINT8 pad7[7];                      // bytes 9 to 15
} ProductSummary;

typedef struct _QuoteRequest {
  UINT64 security_id;    // bytes 0 to 7, signed, read here as unsigned
  UINT32 last_qty;       // bytes 8 to 11, signed, read here as unsigned
  UINT8 side;            // byte 12
  UINT8 pad3[3];         // bytes 13 to 15
  UINT64 transact_time;  // bytes 16 to 23
} QuoteRequest;

typedef struct _SnapshotOrder {
  OrderDetailsComp order_details_comp;  // bytes 0 to 23
} SnapshotOrder;

typedef struct _TopOfBook {
  UINT64 transact_time;  // bytes 0 to 7
  UINT64 security_id;    // bytes 8 to 15, signed, read here as unsigned
  UINT64 bid_px;         // bytes 16 to 23, signed, read here as unsigned
  UINT64 offer_px;       // bytes 24 to 31, signed, read here as unsigned
} TopOfBook;

typedef struct _TradeReport {
  UINT64 security_id;                 // bytes 0 to 7, signed, read here as unsigned
  UINT64 transact_time;               // bytes 8 to 15
  UINT32 trd_match_id;                // bytes 16 to 19
  UINT32 last_qty;                    // bytes 20 to 23, signed, read here as unsigned
  UINT64 last_px;                     // bytes 24 to 31, signed, read here as unsigned
  UINT8 match_type;                   // byte 32
  UINT8 match_sub_type;               // byte 33
  UINT8 algorithmic_trade_indicator;  // byte 34
  UINT8 trade_condition;              // byte 35
  UINT8 pad4[4];                      // bytes 36 to 39
} TradeReport;

typedef struct _MdTradeEntryGrpComp {
  UINT64 md_entry_px;    // bytes 0 to 7, signed, read here as unsigned
  UINT32 md_entry_size;  // bytes 8 to 11, signed, read here as unsigned
  UINT8 md_entry_type;   // byte 12
  UINT8 pad3[3];         // bytes 13 to 15
} MdTradeEntryGrpComp;

typedef struct _TradeReversal {
  UINT64 security_id;                                           // bytes 0 to 7, signed, read here as unsigned
  UINT64 transact_time;                                         // bytes 8 to 15
  UINT32 trd_match_id;                                          // bytes 16 to 19
  UINT32 last_qty;                                              // bytes 20 to 23, signed, read here as unsigned
  UINT64 last_px;                                               // bytes 24 to 31, signed, read here as unsigned
  UINT64 trd_reg_ts_execution_time;                             // bytes 32 to 39
  UINT8 trade_condition;                                        // byte 40
  UINT8 pad6[6];                                                // bytes 41 to 46
  UINT8 no_md_entries;                                          // byte 47
  MdTradeEntryGrpComp md_trade_entry_grp_comp[:byte-size 240];  // bytes 48 to 287
} TradeReversal;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x3458: AddComplexInstrument add_complex_instrument;
    case 0x34BC: AuctionBbo auction_bbo;
    case 0x34BD: AuctionClearingPrice auction_clearing_price;
    case 0x34BE: CrossRequest cross_request;
    case 0x3392: ExecutionSummary execution_summary;
    case 0x3330: FullOrderExecution full_order_execution;
    case 0x32C9: Heartbeat heartbeat;
    case 0x33F5: InstrumentStateChange instrument_state_change;
    case 0x3521: InstrumentSummary instrument_summary;
    case 0x332C: OrderAdd order_add;
    case 0x332E: OrderDelete order_delete;
    case 0x332F: OrderMassDelete order_mass_delete;
    case 0x332D: OrderModify order_modify;
    case 0x3332: OrderModifySamePrio order_modify_same_prio;
    case 0x3331: FullOrderExecution partial_order_execution;
    case 0x33F4: ProductStateChange product_state_change;
    case 0x3520: ProductSummary product_summary;
    case 0x34BF: QuoteRequest quote_request;
    case 0x3522: SnapshotOrder snapshot_order;
    case 0x34C0: TopOfBook top_of_book;
    case 0x3391: TradeReport trade_report;
    case 0x3390: TradeReversal trade_reversal;
    default: UINT8 unknown[available];
  }
} Payload;

// Eurex Eobi Message
typedef struct _Message {
  UINT16 body_len { body_len >= 8 };                                                                                   // bytes 0 to 1
  UINT16 template_id;                                                                                                  // bytes 2 to 3
  UINT32 msg_seq_num;                                                                                                  // bytes 4 to 7
  Payload(template_id, (((UINT32) body_len) - 8)) payload[:byte-size-single-element-array (((UINT32) body_len) - 8)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Eurex Eobi Packet
entrypoint typedef struct _Packet (UINT32 available) where (available >= 32) {
  PacketHeader packet_header;                    // bytes 0 to 31
  Message message[:byte-size (available - 32)];
} Packet;

