// Eurex T7 Eti message body sent by the participant to Eurex
casetype _ClientPayload (UINT16 selector, UINT32 length, UINT32 length_2, UINT32 length_3, UINT32 length_4, UINT32 length_5, UINT32 length_6, UINT32 length_7, UINT32 length_8, UINT32 length_9, UINT32 length_10, UINT32 length_11, UINT32 length_12, UINT32 length_13, UINT32 length_14, UINT32 length_15, UINT32 length_16, UINT32 length_17, UINT32 length_18, UINT32 length_19, UINT32 length_20, UINT32 length_21, UINT32 length_22, UINT32 length_23, UINT32 length_24, UINT32 length_25, UINT32 available) {
  switch (selector) {
    case 0x2786: CrossRequest cross_request[:byte-size-single-element-array length];
    case 0x2788: DeleteAllOrderRequest delete_all_order_request[:byte-size-single-element-array length_2];
    case 0x28A8: DeleteAllQuoteRequest delete_all_quote_request[:byte-size-single-element-array length_3];
    case 0x277D: DeleteOrderSingleRequest delete_order_single_request[:byte-size-single-element-array length_4];
    case 0x28AC: EnterBestQuoteRequest enter_best_quote_request[:byte-size-single-element-array length_5];
    case 0x2724: GatewayRequest gateway_request[:byte-size-single-element-array length_6];
    case 0x271B: Heartbeat heartbeat[:byte-size-single-element-array length_7];
    case 0x2738: InquireEnrichmentRuleIdListRequest inquire_enrichment_rule_id_list_request[:byte-size-single-element-array length_8];
    case 0x2733: InquireSessionListRequest inquire_session_list_request[:byte-size-single-element-array length_9];
    case 0x2736: InquireEnrichmentRuleIdListRequest inquire_user_request[:byte-size-single-element-array length_10];
    case 0x2710: LogonRequest logon_request[:byte-size-single-element-array length_11];
    case 0x2712: InquireSessionListRequest logout_request[:byte-size-single-element-array length_12];
    case 0x28A5: MassQuoteRequest mass_quote_request[:byte-size-single-element-array length_13];
    case 0x277A: ModifyOrderSingleRequest modify_order_single_request[:byte-size-single-element-array length_14];
    case 0x278E: ModifyOrderSingleShortRequest modify_order_single_short_request[:byte-size-single-element-array length_15];
    case 0x2774: NewOrderSingleRequest new_order_single_request[:byte-size-single-element-array length_16];
    case 0x278D: NewOrderSingleShortRequest new_order_single_short_request[:byte-size-single-element-array length_17];
    case 0x28A3: QuoteActivationRequest quote_activation_request[:byte-size-single-element-array length_18];
    case 0x28A1: RfqRequest rfq_request[:byte-size-single-element-array length_19];
    case 0x272A: RetransmitMeMessageRequest retransmit_me_message_request[:byte-size-single-element-array length_20];
    case 0x2718: RetransmitRequest retransmit_request[:byte-size-single-element-array length_21];
    case 0x2729: SubscribeRequest subscribe_request[:byte-size-single-element-array length_22];
    case 0x2716: UnsubscribeRequest unsubscribe_request[:byte-size-single-element-array length_23];
    case 0x2722: UserLoginRequest user_login_request[:byte-size-single-element-array length_24];
    case 0x272D: UserLogoutRequest user_logout_request[:byte-size-single-element-array length_25];
    default: UINT8 unknown[available];
  }
} ClientPayload;

