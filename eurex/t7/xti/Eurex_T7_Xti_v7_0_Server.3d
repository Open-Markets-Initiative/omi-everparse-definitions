// ---- Types -------------------------------------------------------------------

typedef struct _RbcHeaderMeComp {
  UINT64 trd_reg_ts_time_out;  // bytes 0 to 7
  UINT64 notification_in;      // bytes 8 to 15
  UINT64 sending_time;         // bytes 16 to 23
  UINT32 appl_sub_id;          // bytes 24 to 27
  UINT16 partition_id;         // bytes 28 to 29
  UINT8 appl_msg_id[16];       // bytes 30 to 45
  UINT8 appl_id;               // byte 46
  UINT8 appl_resend_flag;      // byte 47
  UINT8 last_fragment;         // byte 48
  UINT8 pad7[7];               // bytes 49 to 55
} RbcHeaderMeComp;

typedef struct _BestQuoteExecutionReport {
  UINT8 pad2[2];                       // bytes 0 to 1
  RbcHeaderMeComp rbc_header_me_comp;  // bytes 2 to 57
  UINT64 exec_id;                      // bytes 58 to 65
  UINT64 quote_msg_id;                 // bytes 66 to 73
  UINT64 security_id;                  // bytes 74 to 81, signed, read here as unsigned
  UINT64 quote_event_px;               // bytes 82 to 89, signed, read here as unsigned
  UINT64 quote_event_qty;              // bytes 90 to 97, signed, read here as unsigned
  UINT64 reserved_size;                // bytes 98 to 105, signed, read here as unsigned
  UINT32 market_segment_id;            // bytes 106 to 109, signed, read here as unsigned
  UINT32 quote_event_match_id;         // bytes 110 to 113
  UINT32 quote_event_exec_id;          // bytes 114 to 117, signed, read here as unsigned
  UINT8 quote_event_type;              // byte 118
  UINT8 quote_event_side;              // byte 119
  UINT8 pad2v2[2];                     // bytes 120 to 121
} BestQuoteExecutionReport;

typedef struct _NrResponseHeaderMeComp {
  UINT64 request_time;         // bytes 0 to 7
  UINT64 trd_reg_ts_time_in;   // bytes 8 to 15
  UINT64 trd_reg_ts_time_out;  // bytes 16 to 23
  UINT64 response_in;          // bytes 24 to 31
  UINT64 sending_time;         // bytes 32 to 39
  UINT32 msg_seq_num;          // bytes 40 to 43
  UINT8 last_fragment;         // byte 44
  UINT8 pad3[3];               // bytes 45 to 47
} NrResponseHeaderMeComp;

typedef struct _BestQuoteResponse {
  UINT8 pad2[2];                                      // bytes 0 to 1
  NrResponseHeaderMeComp nr_response_header_me_comp;  // bytes 2 to 49
  UINT64 quote_id;                                    // bytes 50 to 57
  UINT64 quote_response_id;                           // bytes 58 to 65
  UINT64 security_id;                                 // bytes 66 to 73, signed, read here as unsigned
  UINT64 bid_cxl_size;                                // bytes 74 to 81, signed, read here as unsigned
  UINT64 offer_cxl_size;                              // bytes 82 to 89, signed, read here as unsigned
  UINT32 market_segment_id;                           // bytes 90 to 93, signed, read here as unsigned
  UINT8 pad4[4];                                      // bytes 94 to 97
} BestQuoteResponse;

typedef struct _NotifHeaderComp {
  UINT64 sending_time;  // bytes 0 to 7
} NotifHeaderComp;

typedef struct _BroadcastErrorNotification (UINT32 available) where (available >= 26) {
  UINT8 pad2[2];                                                          // bytes 0 to 1
  NotifHeaderComp notif_header_comp;                                      // bytes 2 to 9
  UINT32 appl_id_status;                                                  // bytes 10 to 13
  UINT32 ref_appl_sub_id;                                                 // bytes 14 to 17
  UINT16 var_text_len { ((UINT32) var_text_len) <= (available - 26) };    // bytes 18 to 19
  UINT8 ref_appl_id;                                                      // byte 20
  UINT8 session_status;                                                   // byte 21
  UINT8 pad4[4];                                                          // bytes 22 to 25
  UINT8 var_text[((UINT32) var_text_len)];
  UINT8 alignment_padding[((available - 26) - ((UINT32) var_text_len))];
} BroadcastErrorNotification;

typedef struct _CrossRequestResponse {
  UINT8 pad2[2];                                      // bytes 0 to 1
  NrResponseHeaderMeComp nr_response_header_me_comp;  // bytes 2 to 49
  UINT64 exec_id;                                     // bytes 50 to 57
} CrossRequestResponse;

typedef struct _NotAffectedOrdersGrpComp {
  UINT64 not_affected_order_id;   // bytes 0 to 7
  UINT64 not_aff_orig_cl_ord_id;  // bytes 8 to 15
} NotAffectedOrdersGrpComp;

typedef struct _AffectedOrdGrpComp {
  UINT64 affected_order_id;        // bytes 0 to 7
  UINT64 affected_orig_cl_ord_id;  // bytes 8 to 15
} AffectedOrdGrpComp;

typedef struct _DeleteAllOrderBroadcast {
  UINT8 pad2[2];                                                                                               // bytes 0 to 1
  RbcHeaderMeComp rbc_header_me_comp;                                                                          // bytes 2 to 57
  UINT64 mass_action_report_id;                                                                                // bytes 58 to 65
  UINT64 security_id;                                                                                          // bytes 66 to 73, signed, read here as unsigned
  UINT64 price;                                                                                                // bytes 74 to 81, signed, read here as unsigned
  UINT32 market_segment_id;                                                                                    // bytes 82 to 85, signed, read here as unsigned
  UINT32 target_party_id_session_id;                                                                           // bytes 86 to 89
  UINT32 target_party_id_executing_trader;                                                                     // bytes 90 to 93
  UINT32 party_id_entering_trader;                                                                             // bytes 94 to 97
  UINT16 no_not_affected_orders;                                                                               // bytes 98 to 99
  UINT16 no_affected_orders;                                                                                   // bytes 100 to 101
  UINT8 party_id_entering_firm;                                                                                // byte 102
  UINT8 mass_action_reason;                                                                                    // byte 103
  UINT8 exec_inst;                                                                                             // byte 104
  UINT8 side;                                                                                                  // byte 105
  NotAffectedOrdersGrpComp not_affected_orders_grp_comp[:byte-size (((UINT32) no_not_affected_orders) * 16)];
  AffectedOrdGrpComp affected_ord_grp_comp[:byte-size (((UINT32) no_affected_orders) * 16)];
} DeleteAllOrderBroadcast;

typedef struct _DeleteAllOrderNrResponse {
  UINT8 pad2[2];                                      // bytes 0 to 1
  NrResponseHeaderMeComp nr_response_header_me_comp;  // bytes 2 to 49
  UINT64 mass_action_report_id;                       // bytes 50 to 57
} DeleteAllOrderNrResponse;

typedef struct _DeleteAllOrderQuoteEventBroadcast {
  UINT8 pad2[2];                       // bytes 0 to 1
  RbcHeaderMeComp rbc_header_me_comp;  // bytes 2 to 57
  UINT64 mass_action_report_id;        // bytes 58 to 65
  UINT64 security_id;                  // bytes 66 to 73, signed, read here as unsigned
  UINT32 market_segment_id;            // bytes 74 to 77, signed, read here as unsigned
  UINT8 mass_action_reason;            // byte 78
  UINT8 exec_inst;                     // byte 79
  UINT8 pad2v2[2];                     // bytes 80 to 81
} DeleteAllOrderQuoteEventBroadcast;

typedef struct _ResponseHeaderMeComp {
  UINT64 request_time;         // bytes 0 to 7
  UINT64 trd_reg_ts_time_in;   // bytes 8 to 15
  UINT64 trd_reg_ts_time_out;  // bytes 16 to 23
  UINT64 response_in;          // bytes 24 to 31
  UINT64 sending_time;         // bytes 32 to 39
  UINT32 msg_seq_num;          // bytes 40 to 43
  UINT16 partition_id;         // bytes 44 to 45
  UINT8 appl_id;               // byte 46
  UINT8 appl_msg_id[16];       // bytes 47 to 62
  UINT8 last_fragment;         // byte 63
} ResponseHeaderMeComp;

typedef struct _DeleteAllOrderResponse {
  UINT8 pad2[2];                                                                                               // bytes 0 to 1
  ResponseHeaderMeComp response_header_me_comp;                                                                // bytes 2 to 65
  UINT64 mass_action_report_id;                                                                                // bytes 66 to 73
  UINT16 no_not_affected_orders;                                                                               // bytes 74 to 75
  UINT16 no_affected_orders;                                                                                   // bytes 76 to 77
  UINT8 pad4[4];                                                                                               // bytes 78 to 81
  NotAffectedOrdersGrpComp not_affected_orders_grp_comp[:byte-size (((UINT32) no_not_affected_orders) * 16)];
  AffectedOrdGrpComp affected_ord_grp_comp[:byte-size (((UINT32) no_affected_orders) * 16)];
} DeleteAllOrderResponse;

typedef struct _NotAffectedSecuritiesGrpComp {
  UINT64 not_affected_security_id;  // bytes 0 to 7
} NotAffectedSecuritiesGrpComp;

typedef struct _DeleteAllQuoteBroadcast {
  UINT8 pad2[2];                                                                                                          // bytes 0 to 1
