  UINT8 no_side_allocs;                                                               // byte 61
  UINT8 trade_report_text[20];                                                        // bytes 62 to 81
  UINT8 trade_report_id[20];                                                          // bytes 82 to 101
  UINT8 pad4[4];                                                                      // bytes 102 to 105
  SideAllocGrpComp side_alloc_grp_comp[:byte-size (((UINT32) no_side_allocs) * 32)];
} EnterTesTradeRequest;

