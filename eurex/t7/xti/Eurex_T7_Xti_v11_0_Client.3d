// Eurex T7 Eti message body sent by the participant to Eurex
casetype _ClientPayload (UINT16 selector, UINT32 length, UINT32 length_2, UINT32 length_3, UINT32 length_4, UINT32 length_5, UINT32 length_6, UINT32 length_7, UINT32 length_8, UINT32 length_9, UINT32 length_10, UINT32 length_11, UINT32 length_12, UINT32 length_13, UINT32 length_14, UINT32 length_15, UINT32 length_16, UINT32 length_17, UINT32 length_18, UINT32 length_19, UINT32 length_20, UINT32 length_21, UINT32 length_22, UINT32 length_23, UINT32 length_24, UINT32 length_25, UINT32 length_26, UINT32 length_27, UINT32 length_28, UINT32 length_29, UINT32 length_30, UINT32 length_31, UINT32 length_32, UINT32 length_33, UINT32 length_34, UINT32 length_35, UINT32 length_36, UINT32 length_37, UINT32 length_38, UINT32 length_39, UINT32 length_40, UINT32 length_41, UINT32 length_42, UINT32 length_43, UINT32 available) {
