#define REF_APPL_ID_SERVICE_AVAILABILITY_MARKET 0x0A  // Service Availability Market
#define REF_APPL_ID_SPECIALIST_DATA 0x0B              // Specialist Data

// Quote Request Reject Reason: one byte code
#define QUOTE_REQUEST_REJECT_REASON_EXCHANGECLOSED 0x02          // Exchangeclosed
#define QUOTE_REQUEST_REJECT_REASON_OTHER 0x63                   // Other
#define QUOTE_REQUEST_REJECT_REASON_REQUESTEDSIZETOOSMALL 0x64   // Requestedsizetoosmall
#define QUOTE_REQUEST_REJECT_REASON_REQUESTEDSIZETOOBIG 0x65     // Requestedsizetoobig
#define QUOTE_REQUEST_REJECT_REASON_NOVALIDQUOTEFROMISSUER 0x66  // Novalidquotefromissuer
#define QUOTE_REQUEST_REJECT_REASON_SOLDOUT 0x67                 // Soldout
#define QUOTE_REQUEST_REJECT_REASON_TRADINGRESTRICTION 0x68      // Tradingrestriction
#define QUOTE_REQUEST_REJECT_REASON_PENDINGREQUESTTIMEDOUT 0x69  // Pendingrequesttimedout

// Quoting Frequency: one byte code
#define QUOTING_FREQUENCY_HF 0x00  // Hf
#define QUOTING_FREQUENCY_LF 0x01  // Lf

// Alloc Method: one byte code
#define ALLOC_METHOD_AUTOMATIC_RANDOM 0x01  // Automatic Random
#define ALLOC_METHOD_MANUAL 0x03            // Manual

// Number Of Resp Disclosure Instruction: one byte code
#define NUMBER_OF_RESP_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define NUMBER_OF_RESP_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Respondent Type: one byte code
#define RESPONDENT_TYPE_SPECIFIEDMARKETPARTICIPANTS 0x02                  // Specifiedmarketparticipants
#define RESPONDENT_TYPE_SPECIFIEDAND_SMART_RF_QSELECTEDPARTICIPANTS 0x64  // Specifiedand Smart Rf Qselectedparticipants
#define RESPONDENT_TYPE_SMART_RF_QSELECTEDPARTICIPANTS 0x65               // Smart Rf Qselectedparticipants

// Bid Px Is Locked: one byte code
#define BID_PX_IS_LOCKED_NO 0x00   // No
#define BID_PX_IS_LOCKED_YES 0x01  // Yes

// Offer Px Is Locked: one byte code
#define OFFER_PX_IS_LOCKED_NO 0x00   // No
#define OFFER_PX_IS_LOCKED_YES 0x01  // Yes

// Side Is Locked: one byte code
#define SIDE_IS_LOCKED_NO 0x00   // No
#define SIDE_IS_LOCKED_YES 0x01  // Yes

// Auto Exec Type: one byte code
#define AUTO_EXEC_TYPE_MID_POINT_BBO 0x01  // Mid Point Bbo
#define AUTO_EXEC_TYPE_BEST_BID 0x02       // Best Bid
#define AUTO_EXEC_TYPE_BEST_ASK 0x03       // Best Ask
#define AUTO_EXEC_TYPE_LIMIT_PRICE 0x04    // Limit Price

// Side Disclosure Instruction: one byte code
#define SIDE_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define SIDE_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Quote Condition: one byte code
#define QUOTE_CONDITION_ACTIVE 0x41     // Active
#define QUOTE_CONDITION_CLOSED 0x42     // Closed
#define QUOTE_CONDITION_SUSPENDED 0x7A  // Suspended
#define QUOTE_CONDITION_EXPIRED 0x38    // Expired
#define QUOTE_CONDITION_LOCKED 0x45     // Locked

// Quoting Status: one byte code
#define QUOTING_STATUS_OPEN_ACTIVE 0x01               // Open Active
#define QUOTING_STATUS_OPEN_IDLE 0x02                 // Open Idle
#define QUOTING_STATUS_CLOSED_INACTIVE 0x03           // Closed Inactive
#define QUOTING_STATUS_OPEN_NOT_RESPONDED 0x04        // Open Not Responded
#define QUOTING_STATUS_PRE_FUNDINGNOTSUFFICIENT 0x05  // Pre Fundingnotsufficient

// ---- Types -------------------------------------------------------------------

typedef struct _RequestHeaderComp {
  UINT32 msg_seq_num;    // bytes 0 to 3
  UINT32 sender_sub_id;  // bytes 4 to 7
} RequestHeaderComp;

typedef struct _ApproveTesTradeRequest {
  UINT8 network_msg_id[8];                             // bytes 0 to 7
  UINT8 pad2[2];                                       // bytes 8 to 9
  RequestHeaderComp request_header_comp;               // bytes 10 to 17
  UINT64 party_id_client_id;                           // bytes 18 to 25
  UINT64 party_id_investment_decision_maker;           // bytes 26 to 33
  UINT64 executing_trader;                             // bytes 34 to 41
  UINT64 alloc_qty;                                    // bytes 42 to 49, signed, read here as unsigned
  UINT32 package_id;                                   // bytes 50 to 53
  UINT32 alloc_id;                                     // bytes 54 to 57
  UINT32 tes_exec_id;                                  // bytes 58 to 61
  UINT32 market_segment_id;                            // bytes 62 to 65, signed, read here as unsigned
  UINT16 trd_type;                                     // bytes 66 to 67
  UINT8 trading_capacity;                              // byte 68
  UINT8 trade_report_type;                             // byte 69
  UINT8 side;                                          // byte 70
  UINT8 value_check_type_value;                        // byte 71
  UINT8 value_check_type_quantity;                     // byte 72
  UINT8 order_attribute_liquidity_provision;           // byte 73
  UINT8 party_id_investment_decision_maker_qualifier;  // byte 74
  UINT8 executing_trader_qualifier;                    // byte 75
  UINT8 order_origination;                             // byte 76
  UINT8 trade_report_id[20];                           // bytes 77 to 96
  UINT8 party_executing_firm[5];                       // bytes 97 to 101
  UINT8 party_executing_trader[6];                     // bytes 102 to 107
  UINT8 free_text_1[12];                               // bytes 108 to 119
  UINT8 free_text_2[12];                               // bytes 120 to 131
  UINT8 free_text_4[16];                               // bytes 132 to 147
  UINT8 pad6[6];                                       // bytes 148 to 153
} ApproveTesTradeRequest;

typedef struct _CrossRequest {
  UINT8 network_msg_id[8];                // bytes 0 to 7
  UINT8 pad2[2];                          // bytes 8 to 9
  RequestHeaderComp request_header_comp;  // bytes 10 to 17
  UINT64 security_id;                     // bytes 18 to 25, signed, read here as unsigned
  UINT64 order_qty;                       // bytes 26 to 33, signed, read here as unsigned
  UINT32 market_segment_id;               // bytes 34 to 37, signed, read here as unsigned
  UINT8 pad4[4];                          // bytes 38 to 41
} CrossRequest;

