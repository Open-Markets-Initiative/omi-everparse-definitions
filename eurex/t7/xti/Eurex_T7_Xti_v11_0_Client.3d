  UINT64 security_id;                                                                 // bytes 18 to 25, signed, read here as unsigned
  UINT64 last_px;                                                                     // bytes 26 to 33, signed, read here as unsigned
  UINT64 trans_bkd_time;                                                              // bytes 34 to 41
  UINT64 settl_curr_fx_rate;                                                          // bytes 42 to 49, signed, read here as unsigned
  UINT32 market_segment_id;                                                           // bytes 50 to 53, signed, read here as unsigned
  UINT32 settl_date;                                                                  // bytes 54 to 57
  UINT16 trd_type;                                                                    // bytes 58 to 59
