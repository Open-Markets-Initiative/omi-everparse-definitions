  UINT8 pad6[6];                                                                                                          // bytes 68 to 73
  NotAffectedSecuritiesGrpComp not_affected_securities_grp_comp[:byte-size (((UINT32) no_not_affected_securities) * 8)];
} DeleteAllQuoteResponse;

typedef struct _DeleteOrderBroadcast {
  UINT8 pad2[2];                       // bytes 0 to 1
  RbcHeaderMeComp rbc_header_me_comp;  // bytes 2 to 57
