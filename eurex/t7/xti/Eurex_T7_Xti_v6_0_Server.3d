  UINT64 peg_offset_value_abs;         // bytes 130 to 137, signed, read here as unsigned
  UINT64 peg_offset_value_pct;         // bytes 138 to 145, signed, read here as unsigned
  UINT32 market_segment_id;            // bytes 146 to 149, signed, read here as unsigned
  UINT32 order_id_sfx;                 // bytes 150 to 153
  UINT32 leaves_qty;                   // bytes 154 to 157, signed, read here as unsigned
  UINT32 cum_qty;                      // bytes 158 to 161, signed, read here as unsigned
  UINT32 cxl_qty;                      // bytes 162 to 165, signed, read here as unsigned
  UINT32 order_qty;                    // bytes 166 to 169, signed, read here as unsigned
  UINT32 display_qty;                  // bytes 170 to 173, signed, read here as unsigned
  UINT32 display_low_qty;              // bytes 174 to 177, signed, read here as unsigned
  UINT32 display_high_qty;             // bytes 178 to 181, signed, read here as unsigned
  UINT32 expire_date;                  // bytes 182 to 185
  UINT32 match_inst_cross_id;          // bytes 186 to 189
