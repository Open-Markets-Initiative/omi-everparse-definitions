  UINT8 trading_session_sub_id;        // byte 215
  UINT8 appl_seq_indicator;            // byte 216
  UINT8 ex_destination_type;           // byte 217
  UINT8 free_text_1[12];               // bytes 218 to 229
  UINT8 free_text_2[12];               // bytes 230 to 241
  UINT8 free_text_4[16];               // bytes 242 to 257
  UINT8 fix_cl_ord_id[20];             // bytes 258 to 277
  UINT8 triggered;                     // byte 278
  UINT8 pad3[3];                       // bytes 279 to 281
} ExtendedDeletionReport;

typedef struct _ForcedLogoutNotification (UINT32 available) where (available >= 18) {
  UINT8 pad2[2];                                                          // bytes 0 to 1
  NotifHeaderComp notif_header_comp;                                      // bytes 2 to 9
  UINT16 var_text_len { ((UINT32) var_text_len) <= (available - 18) };    // bytes 10 to 11
  UINT8 pad6[6];                                                          // bytes 12 to 17
  UINT8 var_text[((UINT32) var_text_len)];
  UINT8 alignment_padding[((available - 18) - ((UINT32) var_text_len))];
} ForcedLogoutNotification;

typedef struct _ForcedUserLogoutNotification (UINT32 available) where (available >= 26) {
  UINT8 pad2[2];                                                          // bytes 0 to 1
  NotifHeaderComp notif_header_comp;                                      // bytes 2 to 9
  UINT8 user_status;                                                      // byte 10
  UINT8 pad3[3];                                                          // bytes 11 to 13
  UINT32 username;                                                        // bytes 14 to 17
  UINT16 var_text_len { ((UINT32) var_text_len) <= (available - 26) };    // bytes 18 to 19
  UINT8 pad6[6];                                                          // bytes 20 to 25
  UINT8 var_text[((UINT32) var_text_len)];
  UINT8 alignment_padding[((available - 26) - ((UINT32) var_text_len))];
} ForcedUserLogoutNotification;

typedef struct _ResponseHeaderComp {
  UINT64 request_time;  // bytes 0 to 7
  UINT64 sending_time;  // bytes 8 to 15
  UINT32 msg_seq_num;   // bytes 16 to 19
  UINT8 pad4[4];        // bytes 20 to 23
} ResponseHeaderComp;

typedef struct _GatewayResponse {
  UINT8 pad2[2];                            // bytes 0 to 1
  ResponseHeaderComp response_header_comp;  // bytes 2 to 25
  UINT32 gateway_id;                        // bytes 26 to 29
  UINT32 gateway_sub_id;                    // bytes 30 to 33
  UINT32 secondary_gateway_id;              // bytes 34 to 37
