#define MATCH_TYPE_AUTOMATCHATMIDPOINT 0x0C      // Automatchatmidpoint

// Fill Liquidity Ind: one byte code
#define FILL_LIQUIDITY_IND_ADDED_LIQUIDITY 0x01         // Added Liquidity
#define FILL_LIQUIDITY_IND_REMOVED_LIQUIDITY 0x02       // Removed Liquidity
#define FILL_LIQUIDITY_IND_TRIGGERED_STOP_ORDER 0x05    // Triggered Stop Order
#define FILL_LIQUIDITY_IND_TRIGGERED_OCO_ORDER 0x06     // Triggered Oco Order
#define FILL_LIQUIDITY_IND_TRIGGERED_MARKET_ORDER 0x07  // Triggered Market Order

// Requesting Party Id Executing System: 4 byte code
#define REQUESTING_PARTY_ID_EXECUTING_SYSTEM_T_7 0x00000002  // T 7

// Party Action Type: one byte code
#define PARTY_ACTION_TYPE_HALT_TRADING 0x01  // Halt Trading
#define PARTY_ACTION_TYPE_REINSTATE 0x02     // Reinstate

// Requesting Party Id Entering Firm: one byte code
#define REQUESTING_PARTY_ID_ENTERING_FIRM_PARTICIPANT 0x01         // Participant
#define REQUESTING_PARTY_ID_ENTERING_FIRM_MARKET_SUPERVISION 0x02  // Market Supervision

// List Update Action: one byte code
#define LIST_UPDATE_ACTION_ADD 0x41     // Add
#define LIST_UPDATE_ACTION_DELETE 0x44  // Delete

// Mass Action Type: one byte code
#define MASS_ACTION_TYPE_SUSPENDQUOTES 0x01  // Suspendquotes
#define MASS_ACTION_TYPE_RELEASEQUOTES 0x02  // Releasequotes

// Quote Event Liquidity Ind: one byte code
#define QUOTE_EVENT_LIQUIDITY_IND_ADDED_LIQUIDITY 0x01    // Added Liquidity
#define QUOTE_EVENT_LIQUIDITY_IND_REMOVED_LIQUIDITY 0x02  // Removed Liquidity

// Quote Event Reason: one byte code
#define QUOTE_EVENT_REASON_PENDINGCANCELLATIONEXECUTED 0x0E  // Pendingcancellationexecuted
#define QUOTE_EVENT_REASON_INVALIDPRICE 0x0F                 // Invalidprice
#define QUOTE_EVENT_REASON_CROSSREJECTED 0x10                // Crossrejected

// Session Reject Reason: 4 byte code
#define SESSION_REJECT_REASON_REQUIRED_TAG_MISSING 0x00000001                              // Required Tag Missing
#define SESSION_REJECT_REASON_VALUEISINCORRECT 0x00000005                                  // Valueisincorrect
#define SESSION_REJECT_REASON_DECRYPTIONPROBLEM 0x00000007                                 // Decryptionproblem
#define SESSION_REJECT_REASON_INVALID_MSG_ID 0x0000000B                                    // Invalid Msg Id
#define SESSION_REJECT_REASON_INCORRECT_NUM_IN_GROUPCOUNT 0x00000010                       // Incorrect Num In Groupcount
#define SESSION_REJECT_REASON_OTHER 0x00000063                                             // Other
#define SESSION_REJECT_REASON_THROTTLE_LIMIT_EXCEEDED 0x00000064                           // Throttle Limit Exceeded
#define SESSION_REJECT_REASON_EXPOSURE_LIMIT_EXCEEDED 0x00000065                           // Exposure Limit Exceeded
#define SESSION_REJECT_REASON_SERVICE_TEMPORARILY_NOT_AVAILABLE 0x00000066                 // Service Temporarily Not Available
#define SESSION_REJECT_REASON_SERVICE_NOT_AVAILABLE 0x00000067                             // Service Not Available
#define SESSION_REJECT_REASON_RESULT_OF_TRANSACTION_UNKNOWN 0x00000068                     // Result Of Transaction Unknown
#define SESSION_REJECT_REASON_OUTBOUNDCONVERSIONERROR 0x00000069                           // Outboundconversionerror
#define SESSION_REJECT_REASON_HEARTBEAT_VIOLATION 0x00000098                               // Heartbeat Violation
#define SESSION_REJECT_REASON_INTERNALTECHNICALERROR 0x000000C8                            // Internaltechnicalerror
#define SESSION_REJECT_REASON_VALIDATION_ERROR 0x000000D2                                  // Validation Error
#define SESSION_REJECT_REASON_USER_ALREADY_LOGGED_IN 0x000000D3                            // User Already Logged In
#define SESSION_REJECT_REASON_SESSION_GATEWAY_ASSIGNMENT_EXPIRED 0x000000D6                // Session Gateway Assignment Expired
#define SESSION_REJECT_REASON_GATEWAY_NOT_RESERVED_TO_SESSION 0x000000D7                   // Gateway Not Reserved To Session
#define SESSION_REJECT_REASON_GATEWAY_IS_STANDBY 0x000000D8                                // Gateway Is Standby
#define SESSION_REJECT_REASON_SESSION_LOGIN_LIMIT_REACHED 0x000000D9                       // Session Login Limit Reached
#define SESSION_REJECT_REASON_PARTITION_NOT_REACHABLE_BY_HF_GATEWAY 0x000000DA             // Partition Not Reachable By Hf Gateway
#define SESSION_REJECT_REASON_PARTITION_NOT_REACHABLE_BY_PS_GATEWAY 0x000000DB             // Partition Not Reachable By Ps Gateway
#define SESSION_REJECT_REASON_NO_GATEWAY_AVAILABLE 0x000000DE                              // No Gateway Available
#define SESSION_REJECT_REASON_USER_ENTITLEMENT_DATA_TIMEOUT 0x000000DF                     // User Entitlement Data Timeout
#define SESSION_REJECT_REASON_ORDER_NOT_FOUND 0x00002710                                   // Order Not Found
#define SESSION_REJECT_REASON_PRICE_NOT_REASONABLE 0x00002711                              // Price Not Reasonable
#define SESSION_REJECT_REASON_CLIENT_ORDER_ID_NOT_UNIQUE 0x00002712                        // Client Order Id Not Unique
#define SESSION_REJECT_REASON_QUOTE_ACTIVATION_IN_PROGRESS 0x00002713                      // Quote Activation In Progress
#define SESSION_REJECT_REASON_BU_BOOK_ORDER_LIMIT_EXCEEDED 0x00002714                      // Bu Book Order Limit Exceeded
#define SESSION_REJECT_REASON_SESSION_BOOK_ORDER_LIMIT_EXCEEDED 0x00002715                 // Session Book Order Limit Exceeded
#define SESSION_REJECT_REASON_STOP_BID_PRICE_NOT_REASONABLE 0x00002716                     // Stop Bid Price Not Reasonable
#define SESSION_REJECT_REASON_STOP_ASK_PRICE_NOT_REASONABLE 0x00002717                     // Stop Ask Price Not Reasonable
#define SESSION_REJECT_REASON_ORDER_NOT_EXECUTABLE_WITHIN_VALIDITY 0x00002718              // Order Not Executable Within Validity
#define SESSION_REJECT_REASON_INVALID_TRADING_RESTRICTION_FOR_INSTRUMENT_STATE 0x00002719  // Invalid Trading Restriction For Instrument State
#define SESSION_REJECT_REASON_TRANSACTION_NOT_ALLOWED_IN_CURRENT_STATE 0x0000271B          // Transaction Not Allowed In Current State

// Matching Engine Status: one byte code
#define MATCHING_ENGINE_STATUS_UNAVAILABLE 0x00  // Unavailable
#define MATCHING_ENGINE_STATUS_AVAILABLE 0x01    // Available

// Trade Manager Status: one byte code
#define TRADE_MANAGER_STATUS_UNAVAILABLE 0x00  // Unavailable
#define TRADE_MANAGER_STATUS_AVAILABLE 0x01    // Available

// Appl Seq Status: one byte code
#define APPL_SEQ_STATUS_UNAVAILABLE 0x00  // Unavailable
#define APPL_SEQ_STATUS_AVAILABLE 0x01    // Available

// Trad Ses Event: one byte code
#define TRAD_SES_EVENT_STARTOF_SERVICE 0x65    // Startof Service
#define TRAD_SES_EVENT_MARKET_RESET 0x66       // Market Reset
#define TRAD_SES_EVENT_ENDOF_RESTATEMENT 0x67  // Endof Restatement
#define TRAD_SES_EVENT_ENDOF_DAY_SERVICE 0x68  // Endof Day Service
#define TRAD_SES_EVENT_SERVICE_RESUMED 0x69    // Service Resumed

// Last Mkt: 2 byte code
#define LAST_MKT_XETR 0x0003  // Xetr
#define LAST_MKT_XVIE 0x0004  // Xvie
#define LAST_MKT_XDUB 0x0005  // Xdub

// Trade Report Type: one byte code
#define TRADE_REPORT_TYPE_SUBMIT 0x00       // Submit
#define TRADE_REPORT_TYPE_TRADE_BREAK 0x07  // Trade Break

// Transfer Reason: one byte code
#define TRANSFER_REASON_OWNER 0x01    // Owner
#define TRANSFER_REASON_CLEARER 0x02  // Clearer

// Match Sub Type: one byte code
#define MATCH_SUB_TYPE_OPENING_AUCTION 0x01          // Opening Auction
#define MATCH_SUB_TYPE_CLOSING_AUCTION 0x02          // Closing Auction
#define MATCH_SUB_TYPE_INTRADAY_AUCTION 0x03         // Intraday Auction
#define MATCH_SUB_TYPE_CIRCUIT_BREAKER_AUCTION 0x04  // Circuit Breaker Auction

// Side Liquidity Ind: one byte code
#define SIDE_LIQUIDITY_IND_ADDED_LIQUIDITY 0x01    // Added Liquidity
#define SIDE_LIQUIDITY_IND_REMOVED_LIQUIDITY 0x02  // Removed Liquidity
#define SIDE_LIQUIDITY_IND_AUCTION 0x04            // Auction

// Delivery Type: one byte code
#define DELIVERY_TYPE_AKV 0x01  // Akv
#define DELIVERY_TYPE_GS 0x02   // Gs
#define DELIVERY_TYPE_STR 0x03  // Str
#define DELIVERY_TYPE_WPR 0x04  // Wpr

// Order Category: one byte code
#define ORDER_CATEGORY_ORDER 0x31  // Order
#define ORDER_CATEGORY_QUOTE 0x32  // Quote

// ---- Types -------------------------------------------------------------------

typedef struct _RbcHeaderMeComp {
  UINT64 trd_reg_ts_time_out;  // bytes 0 to 7
  UINT64 notification_in;      // bytes 8 to 15
  UINT64 sending_time;         // bytes 16 to 23
  UINT32 appl_sub_id;          // bytes 24 to 27
  UINT16 partition_id;         // bytes 28 to 29
  UINT8 appl_msg_id[16];       // bytes 30 to 45
  UINT8 appl_id;               // byte 46
  UINT8 appl_resend_flag;      // byte 47
  UINT8 last_fragment;         // byte 48
  UINT8 pad7[7];               // bytes 49 to 55
} RbcHeaderMeComp;

typedef struct _BestQuoteExecutionReport {
  UINT8 pad2[2];                       // bytes 0 to 1
  RbcHeaderMeComp rbc_header_me_comp;  // bytes 2 to 57
  UINT64 exec_id;                      // bytes 58 to 65
  UINT64 quote_msg_id;                 // bytes 66 to 73
  UINT64 security_id;                  // bytes 74 to 81, signed, read here as unsigned
  UINT64 quote_event_px;               // bytes 82 to 89, signed, read here as unsigned
  UINT32 market_segment_id;            // bytes 90 to 93, signed, read here as unsigned
  UINT32 quote_event_match_id;         // bytes 94 to 97
  UINT32 quote_event_exec_id;          // bytes 98 to 101, signed, read here as unsigned
  UINT32 quote_event_qty;              // bytes 102 to 105, signed, read here as unsigned
  UINT32 reserved_size;                // bytes 106 to 109
  UINT8 quote_event_type;              // byte 110
  UINT8 quote_event_side;              // byte 111
  UINT8 pad2v2[2];                     // bytes 112 to 113
} BestQuoteExecutionReport;

typedef struct _NrResponseHeaderMeComp {
  UINT64 request_time;         // bytes 0 to 7
  UINT64 request_out;          // bytes 8 to 15
  UINT64 trd_reg_ts_time_in;   // bytes 16 to 23
  UINT64 trd_reg_ts_time_out;  // bytes 24 to 31
  UINT64 response_in;          // bytes 32 to 39
  UINT64 sending_time;         // bytes 40 to 47
  UINT32 msg_seq_num;          // bytes 48 to 51
  UINT8 last_fragment;         // byte 52
  UINT8 pad3[3];               // bytes 53 to 55
} NrResponseHeaderMeComp;

typedef struct _BestQuoteResponse {
  UINT8 pad2[2];                                      // bytes 0 to 1
  NrResponseHeaderMeComp nr_response_header_me_comp;  // bytes 2 to 57
  UINT64 quote_id;                                    // bytes 58 to 65
  UINT64 quote_response_id;                           // bytes 66 to 73
  UINT64 security_id;                                 // bytes 74 to 81, signed, read here as unsigned
  UINT32 market_segment_id;                           // bytes 82 to 85, signed, read here as unsigned
  UINT32 bid_cxl_size;                                // bytes 86 to 89, signed, read here as unsigned
  UINT32 offer_cxl_size;                              // bytes 90 to 93, signed, read here as unsigned
  UINT8 pad4[4];                                      // bytes 94 to 97
} BestQuoteResponse;

typedef struct _NotifHeaderComp {
  UINT64 sending_time;  // bytes 0 to 7
} NotifHeaderComp;

typedef struct _BroadcastErrorNotification (UINT32 available) where (available >= 26) {
  UINT8 pad2[2];                                                          // bytes 0 to 1
  NotifHeaderComp notif_header_comp;                                      // bytes 2 to 9
  UINT32 appl_id_status;                                                  // bytes 10 to 13
  UINT32 ref_appl_sub_id;                                                 // bytes 14 to 17
  UINT16 var_text_len { ((UINT32) var_text_len) <= (available - 26) };    // bytes 18 to 19
  UINT8 ref_appl_id;                                                      // byte 20
  UINT8 session_status;                                                   // byte 21
  UINT8 pad4[4];                                                          // bytes 22 to 25
  UINT8 var_text[((UINT32) var_text_len)];
  UINT8 alignment_padding[((available - 26) - ((UINT32) var_text_len))];
} BroadcastErrorNotification;

typedef struct _CrossRequestResponse {
  UINT8 pad2[2];                                      // bytes 0 to 1
  NrResponseHeaderMeComp nr_response_header_me_comp;  // bytes 2 to 57
  UINT64 exec_id;                                     // bytes 58 to 65
} CrossRequestResponse;

typedef struct _NotAffectedOrdersGrpComp {
  UINT64 not_affected_order_id;   // bytes 0 to 7
  UINT64 not_aff_orig_cl_ord_id;  // bytes 8 to 15
} NotAffectedOrdersGrpComp;

typedef struct _AffectedOrdGrpComp {
  UINT64 affected_order_id;        // bytes 0 to 7
  UINT64 affected_orig_cl_ord_id;  // bytes 8 to 15
} AffectedOrdGrpComp;

typedef struct _DeleteAllOrderBroadcast {
  UINT8 pad2[2];                                                                                               // bytes 0 to 1
  RbcHeaderMeComp rbc_header_me_comp;                                                                          // bytes 2 to 57
  UINT64 mass_action_report_id;                                                                                // bytes 58 to 65
  UINT64 security_id;                                                                                          // bytes 66 to 73, signed, read here as unsigned
  UINT64 price;                                                                                                // bytes 74 to 81, signed, read here as unsigned
  UINT32 market_segment_id;                                                                                    // bytes 82 to 85, signed, read here as unsigned
  UINT32 target_party_id_session_id;                                                                           // bytes 86 to 89
  UINT32 target_party_id_executing_trader;                                                                     // bytes 90 to 93
  UINT32 party_id_entering_trader;                                                                             // bytes 94 to 97
  UINT16 no_not_affected_orders;                                                                               // bytes 98 to 99
  UINT16 no_affected_orders;                                                                                   // bytes 100 to 101
  UINT8 party_id_entering_firm;                                                                                // byte 102
  UINT8 mass_action_reason;                                                                                    // byte 103
  UINT8 exec_inst;                                                                                             // byte 104
  UINT8 side;                                                                                                  // byte 105
  NotAffectedOrdersGrpComp not_affected_orders_grp_comp[:byte-size (((UINT32) no_not_affected_orders) * 16)];
  AffectedOrdGrpComp affected_ord_grp_comp[:byte-size (((UINT32) no_affected_orders) * 16)];
} DeleteAllOrderBroadcast;

typedef struct _DeleteAllOrderNrResponse {
  UINT8 pad2[2];                                      // bytes 0 to 1
  NrResponseHeaderMeComp nr_response_header_me_comp;  // bytes 2 to 57
  UINT64 mass_action_report_id;                       // bytes 58 to 65
} DeleteAllOrderNrResponse;

typedef struct _DeleteAllOrderQuoteEventBroadcast {
  UINT8 pad2[2];                       // bytes 0 to 1
  RbcHeaderMeComp rbc_header_me_comp;  // bytes 2 to 57
  UINT64 mass_action_report_id;        // bytes 58 to 65
  UINT64 security_id;                  // bytes 66 to 73, signed, read here as unsigned
  UINT32 market_segment_id;            // bytes 74 to 77, signed, read here as unsigned
  UINT8 mass_action_reason;            // byte 78
  UINT8 exec_inst;                     // byte 79
  UINT8 pad2v2[2];                     // bytes 80 to 81
} DeleteAllOrderQuoteEventBroadcast;

typedef struct _ResponseHeaderMeComp {
  UINT64 request_time;         // bytes 0 to 7
  UINT64 request_out;          // bytes 8 to 15
  UINT64 trd_reg_ts_time_in;   // bytes 16 to 23
  UINT64 trd_reg_ts_time_out;  // bytes 24 to 31
  UINT64 response_in;          // bytes 32 to 39
  UINT64 sending_time;         // bytes 40 to 47
  UINT32 msg_seq_num;          // bytes 48 to 51
  UINT16 partition_id;         // bytes 52 to 53
  UINT8 appl_id;               // byte 54
  UINT8 appl_msg_id[16];       // bytes 55 to 70
  UINT8 last_fragment;         // byte 71
} ResponseHeaderMeComp;

typedef struct _DeleteAllOrderResponse {
  UINT8 pad2[2];                                                                                               // bytes 0 to 1
  ResponseHeaderMeComp response_header_me_comp;                                                                // bytes 2 to 73
  UINT64 mass_action_report_id;                                                                                // bytes 74 to 81
  UINT16 no_not_affected_orders;                                                                               // bytes 82 to 83
  UINT16 no_affected_orders;                                                                                   // bytes 84 to 85
  UINT8 pad4[4];                                                                                               // bytes 86 to 89
  NotAffectedOrdersGrpComp not_affected_orders_grp_comp[:byte-size (((UINT32) no_not_affected_orders) * 16)];
  AffectedOrdGrpComp affected_ord_grp_comp[:byte-size (((UINT32) no_affected_orders) * 16)];
} DeleteAllOrderResponse;

typedef struct _NotAffectedSecuritiesGrpComp {
  UINT64 not_affected_security_id;  // bytes 0 to 7
} NotAffectedSecuritiesGrpComp;

typedef struct _DeleteAllQuoteBroadcast {
  UINT8 pad2[2];                                                                                                          // bytes 0 to 1
  RbcHeaderMeComp rbc_header_me_comp;                                                                                     // bytes 2 to 57
  UINT64 mass_action_report_id;                                                                                           // bytes 58 to 65
  UINT64 security_id;                                                                                                     // bytes 66 to 73, signed, read here as unsigned
  UINT32 market_segment_id;                                                                                               // bytes 74 to 77, signed, read here as unsigned
  UINT32 target_party_id_session_id;                                                                                      // bytes 78 to 81
  UINT32 party_id_entering_trader;                                                                                        // bytes 82 to 85
  UINT32 target_party_id_executing_trader;                                                                                // bytes 86 to 89
  UINT16 no_not_affected_securities;                                                                                      // bytes 90 to 91
  UINT8 mass_action_reason;                                                                                               // byte 92
  UINT8 party_id_entering_firm;                                                                                           // byte 93
  UINT8 target_party_id_desk_id[3];                                                                                       // bytes 94 to 96
  UINT8 pad1;                                                                                                             // byte 97
  NotAffectedSecuritiesGrpComp not_affected_securities_grp_comp[:byte-size (((UINT32) no_not_affected_securities) * 8)];
} DeleteAllQuoteBroadcast;

typedef struct _DeleteAllQuoteResponse {
  UINT8 pad2[2];                                                                                                          // bytes 0 to 1
  NrResponseHeaderMeComp nr_response_header_me_comp;                                                                      // bytes 2 to 57
  UINT64 mass_action_report_id;                                                                                           // bytes 58 to 65
