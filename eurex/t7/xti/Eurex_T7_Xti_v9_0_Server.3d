#define ROOT_PARTY_ID_INVESTMENT_DECISION_MAKER_QUALIFIER_HUMAN 0x18  // Human

// Order Origination: one byte code
#define ORDER_ORIGINATION_DIRECTACCESSORSPONSOREDACCESSCUSTOMER 0x05  // Directaccessorsponsoredaccesscustomer

// Trad Ses Event: one byte code
#define TRAD_SES_EVENT_STARTOF_SERVICE 0x65    // Startof Service
#define TRAD_SES_EVENT_MARKET_RESET 0x66       // Market Reset
#define TRAD_SES_EVENT_ENDOF_RESTATEMENT 0x67  // Endof Restatement
#define TRAD_SES_EVENT_ENDOF_DAY_SERVICE 0x68  // Endof Day Service
#define TRAD_SES_EVENT_SERVICE_RESUMED 0x69    // Service Resumed

// Match Sub Type: one byte code
#define MATCH_SUB_TYPE_OPENING_AUCTION 0x01          // Opening Auction
#define MATCH_SUB_TYPE_CLOSING_AUCTION 0x02          // Closing Auction
#define MATCH_SUB_TYPE_INTRADAY_AUCTION 0x03         // Intraday Auction
#define MATCH_SUB_TYPE_CIRCUIT_BREAKER_AUCTION 0x04  // Circuit Breaker Auction
#define MATCH_SUB_TYPE_TRADEATCLOSE 0x05             // Tradeatclose

// Side Liquidity Ind: one byte code
#define SIDE_LIQUIDITY_IND_ADDED_LIQUIDITY 0x01    // Added Liquidity
#define SIDE_LIQUIDITY_IND_REMOVED_LIQUIDITY 0x02  // Removed Liquidity
#define SIDE_LIQUIDITY_IND_AUCTION 0x04            // Auction

// Order Category: one byte code
#define ORDER_CATEGORY_ORDER 0x31  // Order
#define ORDER_CATEGORY_QUOTE 0x32  // Quote

// Trd Rpt Status: one byte code
#define TRD_RPT_STATUS_ACCEPTED 0x00         // Accepted
#define TRD_RPT_STATUS_REJECTED 0x01         // Rejected
#define TRD_RPT_STATUS_CANCELLED 0x02        // Cancelled
#define TRD_RPT_STATUS_PENDING_NEW 0x04      // Pending New
#define TRD_RPT_STATUS_TERMINATED 0x07       // Terminated
#define TRD_RPT_STATUS_DEEMED_VERIFIED 0x09  // Deemed Verified

// Alloc Method: one byte code
#define ALLOC_METHOD_AUTOMATIC_RANDOM 0x01  // Automatic Random
#define ALLOC_METHOD_MANUAL 0x03            // Manual

// Party Id Investment Decision Maker Qualifier: one byte code
#define PARTY_ID_INVESTMENT_DECISION_MAKER_QUALIFIER_ALGO 0x16   // Algo
#define PARTY_ID_INVESTMENT_DECISION_MAKER_QUALIFIER_HUMAN 0x18  // Human

// Md Book Type: one byte code
#define MD_BOOK_TYPE_TOP_OF_BOOK 0x01  // Top Of Book
#define MD_BOOK_TYPE_PRICE_DEPTH 0x02  // Price Depth

// Md Sub Book Type: one byte code
#define MD_SUB_BOOK_TYPE_VOLUME_WEIGHTED_AVERAGE 0x02  // Volume Weighted Average

// Quote Status: one byte code
#define QUOTE_STATUS_REMOVED 0x06  // Removed
#define QUOTE_STATUS_EXPIRED 0x07  // Expired
#define QUOTE_STATUS_ACTIVE 0x10   // Active

// Number Of Resp Disclosure Instruction: one byte code
#define NUMBER_OF_RESP_DISCLOSURE_INSTRUCTION_NO 0x00   // No
#define NUMBER_OF_RESP_DISCLOSURE_INSTRUCTION_YES 0x01  // Yes

// Respondent Type: one byte code
#define RESPONDENT_TYPE_SPECIFIEDMARKETPARTICIPANTS 0x02                  // Specifiedmarketparticipants
#define RESPONDENT_TYPE_SPECIFIEDAND_SMART_RF_QSELECTEDPARTICIPANTS 0x64  // Specifiedand Smart Rf Qselectedparticipants
#define RESPONDENT_TYPE_SMART_RF_QSELECTEDPARTICIPANTS 0x65               // Smart Rf Qselectedparticipants

// Quoting Status: one byte code
#define QUOTING_STATUS_OPEN_ACTIVE 0x01         // Open Active
#define QUOTING_STATUS_OPEN_IDLE 0x02           // Open Idle
#define QUOTING_STATUS_CLOSED_INACTIVE 0x03     // Closed Inactive
#define QUOTING_STATUS_OPEN_NOT_RESPONDED 0x04  // Open Not Responded

// ---- Types -------------------------------------------------------------------

typedef struct _NotifHeaderComp {
  UINT64 sending_time;  // bytes 0 to 7
} NotifHeaderComp;

typedef struct _BroadcastErrorNotification (UINT32 available) where (available >= 26) {
  UINT8 pad2[2];                                                          // bytes 0 to 1
  NotifHeaderComp notif_header_comp;                                      // bytes 2 to 9
  UINT32 appl_id_status;                                                  // bytes 10 to 13
  UINT32 ref_appl_sub_id;                                                 // bytes 14 to 17
  UINT16 var_text_len { ((UINT32) var_text_len) <= (available - 26) };    // bytes 18 to 19
  UINT8 ref_appl_id;                                                      // byte 20
  UINT8 session_status;                                                   // byte 21
  UINT8 pad4[4];                                                          // bytes 22 to 25
  UINT8 var_text[((UINT32) var_text_len)];
  UINT8 alignment_padding[((available - 26) - ((UINT32) var_text_len))];
} BroadcastErrorNotification;

typedef struct _NrResponseHeaderMeComp {
  UINT64 request_time;         // bytes 0 to 7
  UINT64 trd_reg_ts_time_in;   // bytes 8 to 15
  UINT64 trd_reg_ts_time_out;  // bytes 16 to 23
  UINT64 response_in;          // bytes 24 to 31
  UINT64 sending_time;         // bytes 32 to 39
  UINT32 msg_seq_num;          // bytes 40 to 43
  UINT8 last_fragment;         // byte 44
