typedef struct _DeleteAllOrderBroadcast {
  UINT8 pad2[2];                                                                                                          // bytes 0 to 1
  RbcHeaderMeComp rbc_header_me_comp;                                                                                     // bytes 2 to 57
  UINT64 mass_action_report_id;                                                                                           // bytes 58 to 65
  UINT64 security_id;                                                                                                     // bytes 66 to 73, signed, read here as unsigned
  UINT64 price;                                                                                                           // bytes 74 to 81, signed, read here as unsigned
  UINT32 market_segment_id;                                                                                               // bytes 82 to 85, signed, read here as unsigned
  UINT32 target_party_id_session_id;                                                                                      // bytes 86 to 89
  UINT32 target_party_id_executing_trader;                                                                                // bytes 90 to 93
  UINT32 party_id_entering_trader;                                                                                        // bytes 94 to 97
  UINT16 no_not_affected_orders;                                                                                          // bytes 98 to 99
  UINT16 no_affected_orders;                                                                                              // bytes 100 to 101
  UINT16 no_affected_order_requests;                                                                                      // bytes 102 to 103
  UINT8 party_id_entering_firm;                                                                                           // byte 104
  UINT8 mass_action_reason;                                                                                               // byte 105
  UINT8 exec_inst;                                                                                                        // byte 106
  UINT8 side;                                                                                                             // byte 107
  UINT8 pad6[6];                                                                                                          // bytes 108 to 113
  NotAffectedOrdersGrpComp not_affected_orders_grp_comp[:byte-size (((UINT32) no_not_affected_orders) * 16)];
  AffectedOrdGrpComp affected_ord_grp_comp[:byte-size (((UINT32) no_affected_orders) * 16)];
  AffectedOrderRequestsGrpComp affected_order_requests_grp_comp[:byte-size (((UINT32) no_affected_order_requests) * 8)];
} DeleteAllOrderBroadcast;

