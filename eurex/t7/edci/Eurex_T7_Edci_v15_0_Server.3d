#define TRAD_SES_MODE_TESTING 0x01            // Testing
#define TRAD_SES_MODE_SIMULATED 0x02          // Simulated
#define TRAD_SES_MODE_PRODUCTION 0x03         // Production
#define TRAD_SES_MODE_ACCEPTANCE 0x04         // Acceptance
