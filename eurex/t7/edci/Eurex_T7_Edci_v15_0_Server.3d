// ---- Types -------------------------------------------------------------------

typedef struct _RbcHeaderComp {
  UINT64 sending_time;             // bytes 0 to 7
  UINT64 appl_seq_num;             // bytes 8 to 15
  UINT32 party_id_executing_unit;  // bytes 16 to 19
  UINT32 party_id_group;           // bytes 20 to 23
  UINT16 partition_id;             // bytes 24 to 25
  UINT8 appl_resend_flag;          // byte 26
  UINT8 appl_id;                   // byte 27
  UINT8 last_fragment;             // byte 28
  UINT8 pad3[3];                   // bytes 29 to 31
} RbcHeaderComp;

typedef struct _CrossRequestNotification {
  UINT8 pad2[2];                     // bytes 0 to 1
  RbcHeaderComp rbc_header_comp;     // bytes 2 to 33
  UINT64 security_id;                // bytes 34 to 41, signed, read here as unsigned
  UINT64 order_qty;                  // bytes 42 to 49, signed, read here as unsigned
  UINT64 exec_id;                    // bytes 50 to 57
  UINT32 market_segment_id;          // bytes 58 to 61, signed, read here as unsigned
  UINT32 party_id_session_id;        // bytes 62 to 65
  UINT32 party_id_executing_trader;  // bytes 66 to 69
  UINT8 pad4[4];                     // bytes 70 to 73
} CrossRequestNotification;

typedef struct _AffectedOrdGrpComp {
  UINT64 affected_order_id;               // bytes 0 to 7
  UINT64 affected_cl_ord_id;              // bytes 8 to 15
  UINT64 affected_orig_cl_ord_id;         // bytes 16 to 23
  UINT64 security_id;                     // bytes 24 to 31, signed, read here as unsigned
  UINT32 party_id_session_id;             // bytes 32 to 35
  UINT32 party_id_executing_trader;       // bytes 36 to 39
  UINT8 ord_status;                       // byte 40
  UINT8 exec_type;                        // byte 41
  UINT8 affected_fix_cl_ord_id[20];       // bytes 42 to 61
  UINT8 affected_fix_orig_cl_ord_id[20];  // bytes 62 to 81
  UINT8 pad6[6];                          // bytes 82 to 87
} AffectedOrdGrpComp;

typedef struct _DeleteOrderBroadcast {
  UINT8 pad2[2];                                                                              // bytes 0 to 1
  RbcHeaderComp rbc_header_comp;                                                              // bytes 2 to 33
  UINT64 exec_id;                                                                             // bytes 34 to 41
  UINT32 market_segment_id;                                                                   // bytes 42 to 45, signed, read here as unsigned
  UINT16 no_affected_orders;                                                                  // bytes 46 to 47
  UINT8 pad2v2[2];                                                                            // bytes 48 to 49
  AffectedOrdGrpComp affected_ord_grp_comp[:byte-size (((UINT32) no_affected_orders) * 88)];
} DeleteOrderBroadcast;

typedef struct _CrossRequestSideGrpComp {
  UINT64 cl_ord_id;                                    // bytes 0 to 7
  UINT64 order_id;                                     // bytes 8 to 15
  UINT64 party_id_client_id;                           // bytes 16 to 23
  UINT64 party_id_investment_decision_maker;           // bytes 24 to 31
  UINT64 executing_trader;                             // bytes 32 to 39
  UINT64 maximum_price;                                // bytes 40 to 47, signed, read here as unsigned
  UINT32 match_inst_cross_id;                          // bytes 48 to 51
  UINT8 input_source;                                  // byte 52
  UINT8 side;                                          // byte 53
  UINT8 self_match_prevention_instruction;             // byte 54
  UINT8 cross_match_instruction;                       // byte 55
  UINT8 trading_capacity;                              // byte 56
  UINT8 party_id_investment_decision_maker_qualifier;  // byte 57
  UINT8 executing_trader_qualifier;                    // byte 58
  UINT8 cust_order_handling_inst;                      // byte 59
  UINT8 party_end_client_identification[20];           // bytes 60 to 79
  UINT8 order_origination;                             // byte 80
  UINT8 pad7[7];                                       // bytes 81 to 87
} CrossRequestSideGrpComp;

typedef struct _EnterClipRequestNotification {
  UINT8 pad2[2];                                                                               // bytes 0 to 1
  RbcHeaderComp rbc_header_comp;                                                               // bytes 2 to 33
  UINT64 security_id;                                                                          // bytes 34 to 41, signed, read here as unsigned
  UINT64 price;                                                                                // bytes 42 to 49, signed, read here as unsigned
  UINT64 order_qty;                                                                            // bytes 50 to 57, signed, read here as unsigned
  UINT64 exec_id;                                                                              // bytes 58 to 65
  UINT32 market_segment_id;                                                                    // bytes 66 to 69, signed, read here as unsigned
  UINT32 cross_id;                                                                             // bytes 70 to 73, signed, read here as unsigned
  UINT32 party_id_session_id;                                                                  // bytes 74 to 77
  UINT32 party_id_executing_trader;                                                            // bytes 78 to 81
  UINT8 product_complex;                                                                       // byte 82
  UINT8 no_sides;                                                                              // byte 83
  UINT8 cross_request_type;                                                                    // byte 84
  UINT8 root_party_contra_firm[5];                                                             // bytes 85 to 89
  UINT8 root_party_contra_trader[6];                                                           // bytes 90 to 95
  UINT8 pad2v2[2];                                                                             // bytes 96 to 97
  CrossRequestSideGrpComp cross_request_side_grp_comp[:byte-size (((UINT32) no_sides) * 88)];
} EnterClipRequestNotification;

typedef struct _NotifHeaderComp {
  UINT64 sending_time;  // bytes 0 to 7
} NotifHeaderComp;

typedef struct _ForcedLogoutNotification (UINT32 available) where (available >= 12) {
  UINT8 pad2[2];                                                          // bytes 0 to 1
  NotifHeaderComp notif_header_comp;                                      // bytes 2 to 9
  UINT16 var_text_len { ((UINT32) var_text_len) <= (available - 12) };    // bytes 10 to 11
  UINT8 var_text[((UINT32) var_text_len)];
  UINT8 alignment_padding[((available - 12) - ((UINT32) var_text_len))];
} ForcedLogoutNotification;

typedef struct _HeartbeatNotification {
  UINT8 pad2[2];                      // bytes 0 to 1
  NotifHeaderComp notif_header_comp;  // bytes 2 to 9
} HeartbeatNotification;

typedef struct _LegalNotificationBroadcast (UINT32 available) where (available >= 45) {
  UINT8 pad2[2];                                                          // bytes 0 to 1
  RbcHeaderComp rbc_header_comp;                                          // bytes 2 to 33
  UINT64 transact_time;                                                   // bytes 34 to 41
  UINT16 var_text_len { ((UINT32) var_text_len) <= (available - 45) };    // bytes 42 to 43
  UINT8 user_status;                                                      // byte 44
  UINT8 var_text[((UINT32) var_text_len)];
  UINT8 alignment_padding[((available - 45) - ((UINT32) var_text_len))];
} LegalNotificationBroadcast;

typedef struct _ResponseHeaderComp {
  UINT64 request_time;  // bytes 0 to 7
  UINT64 sending_time;  // bytes 8 to 15
  UINT32 msg_seq_num;   // bytes 16 to 19
  UINT8 last_fragment;  // byte 20
  UINT8 pad3[3];        // bytes 21 to 23
} ResponseHeaderComp;

typedef struct _LogonResponse {
  UINT8 pad2[2];                            // bytes 0 to 1
  ResponseHeaderComp response_header_comp;  // bytes 2 to 25
  UINT32 heart_bt_int;                      // bytes 26 to 29
  UINT32 session_instance_id;               // bytes 30 to 33
  UINT16 market_id;                         // bytes 34 to 35
  UINT8 trad_ses_mode;                      // byte 36
  UINT8 default_cstm_appl_ver_id[30];       // bytes 37 to 66
  UINT8 default_cstm_appl_ver_sub_id[5];    // bytes 67 to 71
  UINT8 pad2v2[2];                          // bytes 72 to 73
} LogonResponse;

typedef struct _LogoutResponse {
  UINT8 pad2[2];                            // bytes 0 to 1
  ResponseHeaderComp response_header_comp;  // bytes 2 to 25
} LogoutResponse;

typedef struct _FillsGrpComp {
  UINT64 fill_px;        // bytes 0 to 7, signed, read here as unsigned
  UINT64 fill_qty;       // bytes 8 to 15, signed, read here as unsigned
  UINT32 fill_match_id;  // bytes 16 to 19
  UINT32 fill_exec_id;   // bytes 20 to 23, signed, read here as unsigned
