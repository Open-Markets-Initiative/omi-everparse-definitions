// Risk Control Rtm Service Status: one byte code
#define RISK_CONTROL_RTM_SERVICE_STATUS_UNAVAILABLE 0x00  // Unavailable
#define RISK_CONTROL_RTM_SERVICE_STATUS_AVAILABLE 0x01    // Available

// Marketwide Analytics And Risk Service Status: one byte code
#define MARKETWIDE_ANALYTICS_AND_RISK_SERVICE_STATUS_UNAVAILABLE 0x00  // Unavailable
#define MARKETWIDE_ANALYTICS_AND_RISK_SERVICE_STATUS_AVAILABLE 0x01    // Available

