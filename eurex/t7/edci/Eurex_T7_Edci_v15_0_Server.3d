#define TRIGGERED_NOTTRIGGERED 0x00    // Nottriggered
#define TRIGGERED_TRIGGERED_STOP 0x01  // Triggered Stop
#define TRIGGERED_TRIGGERED_OCO 0x02   // Triggered Oco

// Trading Session Sub Id: one byte code
#define TRADING_SESSION_SUB_ID_OPENINGAUCTION 0x02  // Openingauction
#define TRADING_SESSION_SUB_ID_CLOSINGAUCTION 0x04  // Closingauction
#define TRADING_SESSION_SUB_ID_ANY_AUCTION 0x08     // Any Auction

// Appl Seq Indicator: one byte code
#define APPL_SEQ_INDICATOR_NO_RECOVERY_REQUIRED 0x00  // No Recovery Required
#define APPL_SEQ_INDICATOR_RECOVERY_REQUIRED 0x01     // Recovery Required

// Crossed Indicator: one byte code
#define CROSSED_INDICATOR_NOCROSSING 0x00     // Nocrossing
#define CROSSED_INDICATOR_CROSSREJECTED 0x01  // Crossrejected

// Session Reject Reason: 4 byte code
#define SESSION_REJECT_REASON_REQUIRED_TAG_MISSING 0x00000001                      // Required Tag Missing
#define SESSION_REJECT_REASON_VALUEISINCORRECT 0x00000005                          // Valueisincorrect
#define SESSION_REJECT_REASON_DECRYPTIONPROBLEM 0x00000007                         // Decryptionproblem
#define SESSION_REJECT_REASON_INVALID_MSG_ID 0x0000000B                            // Invalid Msg Id
#define SESSION_REJECT_REASON_INCORRECT_NUM_IN_GROUPCOUNT 0x00000010               // Incorrect Num In Groupcount
#define SESSION_REJECT_REASON_OTHER 0x00000063                                     // Other
#define SESSION_REJECT_REASON_EXPOSURE_LIMIT_EXCEEDED 0x00000065                   // Exposure Limit Exceeded
#define SESSION_REJECT_REASON_SERVICE_NOT_AVAILABLE 0x00000067                     // Service Not Available
#define SESSION_REJECT_REASON_OUTBOUNDCONVERSIONERROR 0x00000069                   // Outboundconversionerror
#define SESSION_REJECT_REASON_HEARTBEAT_VIOLATION 0x00000098                       // Heartbeat Violation
#define SESSION_REJECT_REASON_INTERNALTECHNICALERROR 0x000000C8                    // Internaltechnicalerror
#define SESSION_REJECT_REASON_VALIDATION_ERROR 0x000000D2                          // Validation Error
#define SESSION_REJECT_REASON_SESSION_LOGIN_LIMIT_REACHED 0x000000D9               // Session Login Limit Reached
#define SESSION_REJECT_REASON_OUTSTANDING_LOGINS_BU_LIMIT_REACHED 0x000000E2       // Outstanding Logins Bu Limit Reached
#define SESSION_REJECT_REASON_OUTSTANDING_LOGINS_SESSION_LIMIT_REACHED 0x000000E3  // Outstanding Logins Session Limit Reached
#define SESSION_REJECT_REASON_PASSWORD_TIMESTAMP_NOT_IN_GRACE_PERIOD 0x000000E4    // Password Timestamp Not In Grace Period
#define SESSION_REJECT_REASON_PRICE_NOT_REASONABLE 0x00002711                      // Price Not Reasonable
#define SESSION_REJECT_REASON_STOP_BID_PRICE_NOT_REASONABLE 0x00002716             // Stop Bid Price Not Reasonable
#define SESSION_REJECT_REASON_STOP_ASK_PRICE_NOT_REASONABLE 0x00002717             // Stop Ask Price Not Reasonable
#define SESSION_REJECT_REASON_PRETRADE_RISK_LIMIT_EXCEEDED 0x00002720              // Pretrade Risk Limit Exceeded
#define SESSION_REJECT_REASON_MAX_ORDER_QUANTITY_EXCEEDED 0x00002725               // Max Order Quantity Exceeded
#define SESSION_REJECT_REASON_MAX_ORDER_VALUE_EXCEEDED 0x00002726                  // Max Order Value Exceeded
#define SESSION_REJECT_REASON_PRICE_NOT_REASONABLE_EXTENDED 0x00002727             // Price Not Reasonable Extended

// Requesting Party Id Executing System: 4 byte code
#define REQUESTING_PARTY_ID_EXECUTING_SYSTEM_EUREX_CLEARING 0x00000001  // Eurex Clearing
#define REQUESTING_PARTY_ID_EXECUTING_SYSTEM_T_7 0x00000002             // T 7

// Order Deletion Instruction: one byte code
#define ORDER_DELETION_INSTRUCTION_NO 0x00   // No
