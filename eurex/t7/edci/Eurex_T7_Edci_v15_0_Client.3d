// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Eurex_T7_Edci_v15_0_Client.3d

// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_CROSS_REQUEST_NOTIFICATION 0x2A9B             // Cross Request Notification
#define TEMPLATE_ID_DELETE_ORDER_BROADCAST 0x2A96                 // Delete Order Broadcast
#define TEMPLATE_ID_ENTER_CLIP_REQUEST_NOTIFICATION 0x2A9A        // Enter Clip Request Notification
#define TEMPLATE_ID_FORCED_LOGOUT_NOTIFICATION 0x271C             // Forced Logout Notification
#define TEMPLATE_ID_HEARTBEAT 0x271B                              // Heartbeat
#define TEMPLATE_ID_HEARTBEAT_NOTIFICATION 0x2727                 // Heartbeat Notification
#define TEMPLATE_ID_LEGAL_NOTIFICATION_BROADCAST 0x2733           // Legal Notification Broadcast
#define TEMPLATE_ID_LOGON_REQUEST 0x2710                          // Logon Request
#define TEMPLATE_ID_LOGON_RESPONSE 0x2711                         // Logon Response
#define TEMPLATE_ID_LOGOUT_REQUEST 0x2712                         // Logout Request
#define TEMPLATE_ID_LOGOUT_RESPONSE 0x2713                        // Logout Response
#define TEMPLATE_ID_ORDER_EXEC_REPORT_BROADCAST 0x2A95            // Order Exec Report Broadcast
#define TEMPLATE_ID_ORDER_REJECT_NOTIFICATION 0x271E              // Order Reject Notification
#define TEMPLATE_ID_PARTITION_LIST_NOTIFICATION 0x2735            // Partition List Notification
#define TEMPLATE_ID_PARTY_ACTION_REPORT 0x2736                    // Party Action Report
#define TEMPLATE_ID_PARTY_ENTITLEMENTS_UPDATE_REPORT 0x2732       // Party Entitlements Update Report
#define TEMPLATE_ID_REJECT 0x271A                                 // Reject
#define TEMPLATE_ID_RETRANSMIT_REQUEST 0x2718                     // Retransmit Request
#define TEMPLATE_ID_RETRANSMIT_RESPONSE 0x2719                    // Retransmit Response
#define TEMPLATE_ID_RFQ_NOTIFICATION 0x2A99                       // Rfq Notification
#define TEMPLATE_ID_RISK_NOTIFICATION_BROADCAST 0x2731            // Risk Notification Broadcast
#define TEMPLATE_ID_SERVICE_AVAILABILITY_MARKET_BROADCAST 0x273C  // Service Availability Market Broadcast
#define TEMPLATE_ID_SESSION_LIST_NOTIFICATION 0x2734              // Session List Notification
#define TEMPLATE_ID_SESSION_STATUS_BROADCAST 0x2A97               // Session Status Broadcast
#define TEMPLATE_ID_STATUS_BROADCAST 0x273D                       // Status Broadcast
#define TEMPLATE_ID_TRADING_ACTION_REQUEST 0x2A9C                 // Trading Action Request
#define TEMPLATE_ID_TRADING_ACTION_RESPONSE 0x2A9D                // Trading Action Response
#define TEMPLATE_ID_USER_LOGIN_REQUEST 0x2722                     // User Login Request
#define TEMPLATE_ID_USER_LOGIN_RESPONSE 0x2723                    // User Login Response
#define TEMPLATE_ID_USER_LOGOUT_REQUEST 0x272D                    // User Logout Request
#define TEMPLATE_ID_USER_LOGOUT_RESPONSE 0x2728                   // User Logout Response

// Ref Appl Id: one byte code
#define REF_APPL_ID_RISK_CONTROL 0x06     // Risk Control
#define REF_APPL_ID_ORDER_DROP_COPY 0x0C  // Order Drop Copy

// Risk Limit Platform: one byte code
#define RISK_LIMIT_PLATFORM_ON_BOOK 0x00   // On Book
#define RISK_LIMIT_PLATFORM_OFF_BOOK 0x01  // Off Book

// Order Deletion Instruction: one byte code
#define ORDER_DELETION_INSTRUCTION_NO 0x00   // No
#define ORDER_DELETION_INSTRUCTION_YES 0x01  // Yes

// Party Action Type: one byte code
#define PARTY_ACTION_TYPE_HALT_TRADING 0x01  // Halt Trading
#define PARTY_ACTION_TYPE_REINSTATE 0x02     // Reinstate

// ---- Types -------------------------------------------------------------------

typedef struct _Heartbeat {
  UINT8 pad2[2];  // bytes 0 to 1
} Heartbeat;

typedef struct _RequestHeaderComp {
  UINT32 msg_seq_num;    // bytes 0 to 3
  UINT32 sender_sub_id;  // bytes 4 to 7
} RequestHeaderComp;

typedef struct _LogonRequest {
  UINT8 pad2[2];                          // bytes 0 to 1
  RequestHeaderComp request_header_comp;  // bytes 2 to 9
  UINT32 heart_bt_int;                    // bytes 10 to 13
  UINT32 party_id_session_id;             // bytes 14 to 17
  UINT8 default_cstm_appl_ver_id[30];     // bytes 18 to 47
  UINT8 password[32];                     // bytes 48 to 79
  UINT8 pad2v2[2];                        // bytes 80 to 81
} LogonRequest;

typedef struct _LogoutRequest {
  UINT8 pad2[2];                          // bytes 0 to 1
  RequestHeaderComp request_header_comp;  // bytes 2 to 9
} LogoutRequest;

typedef struct _RetransmitRequest {
  UINT8 pad2[2];                          // bytes 0 to 1
  RequestHeaderComp request_header_comp;  // bytes 2 to 9
  UINT64 appl_beg_seq_num;                // bytes 10 to 17
  UINT64 appl_end_seq_num;                // bytes 18 to 25
  UINT32 party_id_group;                  // bytes 26 to 29
  UINT16 partition_id;                    // bytes 30 to 31
  UINT8 ref_appl_id;                      // byte 32
  UINT8 pad1;                             // byte 33
} RetransmitRequest;

typedef struct _TradingActionRequest {
  UINT8 pad2[2];                          // bytes 0 to 1
  RequestHeaderComp request_header_comp;  // bytes 2 to 9
  UINT8 risk_limit_platform;              // byte 10
  UINT8 order_deletion_instruction;       // byte 11
  UINT8 party_action_type;                // byte 12
  UINT8 pad1;                             // byte 13
  UINT32 party_id_executing_unit;         // bytes 14 to 17
  UINT32 target_party_id_executing_unit;  // bytes 18 to 21
  UINT8 pad4[4];                          // bytes 22 to 25
} TradingActionRequest;

typedef struct _UserLoginRequest {
  UINT8 pad2[2];                          // bytes 0 to 1
  RequestHeaderComp request_header_comp;  // bytes 2 to 9
  UINT32 username;                        // bytes 10 to 13
  UINT8 password[32];                     // bytes 14 to 45
  UINT8 pad4[4];                          // bytes 46 to 49
} UserLoginRequest;

typedef struct _UserLogoutRequest {
  UINT8 pad2[2];                          // bytes 0 to 1
  RequestHeaderComp request_header_comp;  // bytes 2 to 9
  UINT32 username;                        // bytes 10 to 13
  UINT8 pad4[4];                          // bytes 14 to 17
} UserLogoutRequest;

// Eurex T7 Edci message body sent by the participant to Eurex
casetype _ClientPayload (UINT16 selector, UINT32 length, UINT32 length_2, UINT32 length_3, UINT32 length_4, UINT32 length_5, UINT32 length_6, UINT32 length_7, UINT32 available) {
  switch (selector) {
    case 0x271B: Heartbeat heartbeat[:byte-size-single-element-array length];
    case 0x2710: LogonRequest logon_request[:byte-size-single-element-array length_2];
    case 0x2712: LogoutRequest logout_request[:byte-size-single-element-array length_3];
    case 0x2718: RetransmitRequest retransmit_request[:byte-size-single-element-array length_4];
    case 0x2A9C: TradingActionRequest trading_action_request[:byte-size-single-element-array length_5];
    case 0x2722: UserLoginRequest user_login_request[:byte-size-single-element-array length_6];
    case 0x272D: UserLogoutRequest user_logout_request[:byte-size-single-element-array length_7];
    default: UINT8 unknown[available];
  }
} ClientPayload;

// Eurex T7 Edci Message sent by the participant to Eurex
typedef struct _ClientMessage {
  UINT32 body_len { body_len >= 6 };                                                                                                                                                                                          // bytes 0 to 3
  UINT16 template_id;                                                                                                                                                                                                         // bytes 4 to 5
  ClientPayload(template_id, (body_len - 6), (body_len - 6), (body_len - 6), (body_len - 6), (body_len - 6), (body_len - 6), (body_len - 6), (body_len - 6)) client_payload[:byte-size-single-element-array (body_len - 6)];
} ClientMessage;

// ---- Packet: ClientPacket ----------------------------------------------------

// T7 Tcp Message Block sent by the participant to Eurex
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientMessage client_message[:byte-size available];
} ClientPacket;

