  UINT8 uptick_rule_unapplied_covered_short_selling_trading_value[22];   // bytes 92 to 113
  UINT8 end_keyword;                                                     // byte 114
} SecuritiesShortSellingMessage;

// Treasury Stocks Traded Information. Real-time treasury-stock trade dissemination per issue.
typedef struct _SecuritiesTreasuryStocksTradedMessage {
  UINT8 session_id[2];                         // bytes 0 to 1
  UINT8 isin_code[12];                         // bytes 2 to 13
  UINT8 a_designated_number_for_an_issue[6];   // bytes 14 to 19
  UINT8 trading_price[11];                     // bytes 20 to 30
  UINT8 trading_volume[10];                    // bytes 31 to 40
  UINT8 bid_treasury_stock_declaration_id[5];  // bytes 41 to 45
  UINT8 ask_treasury_stock_declaration_id[5];  // bytes 46 to 50
  UINT8 end_keyword;                           // byte 51
} SecuritiesTreasuryStocksTradedMessage;

// Buy-in Volume reference.
typedef struct _SecuritiesBuyInVolumeMessage {
  UINT8 message_sequence_number[8];  // bytes 0 to 7
  UINT8 isin_code[12];               // bytes 8 to 19
  UINT8 transmission_date[8];        // bytes 20 to 27
