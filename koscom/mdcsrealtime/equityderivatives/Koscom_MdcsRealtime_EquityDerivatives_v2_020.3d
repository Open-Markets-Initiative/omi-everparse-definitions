  UINT8 accumulated_trading_volume[12];               // bytes 73 to 84
  UINT8 accumulated_trading_value[22];                // bytes 85 to 106
  UINT8 trading_halt;                                 // byte 107
  UINT8 the_best_ask[11];                             // bytes 108 to 118
  UINT8 the_best_bid[11];                             // bytes 119 to 129
  UINT8 end_keyword;                                  // byte 130
} EquityDerivativesUnderlyingSnapshotKospiMessage;

