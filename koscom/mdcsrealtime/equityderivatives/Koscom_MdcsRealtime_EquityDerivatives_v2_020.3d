typedef struct _SecuritiesEquityIndexIndicatorMessage {
  UINT8 message_sequence_number[8];           // bytes 0 to 7
  UINT8 isin_code[12];                        // bytes 8 to 19
  UINT8 a_designated_number_for_an_issue[6];  // bytes 20 to 25
  UINT8 security_group_id[2];                 // bytes 26 to 27
  UINT8 eps_calculation;                      // byte 28
  UINT8 eps[22];                              // bytes 29 to 50
  UINT8 loss_category;                        // byte 51
  UINT8 per[13];                              // bytes 52 to 64
  UINT8 bps_calculation;                      // byte 65
  UINT8 bps[22];                              // bytes 66 to 87
  UINT8 pbr[13];                              // bytes 88 to 100
  UINT8 dps_calculation;                      // byte 101
  UINT8 dps[22];                              // bytes 102 to 123
  UINT8 dividend_yield[13];                   // bytes 124 to 136
  UINT8 market_capitalization_type_code;      // byte 137
  UINT8 filler_1;                             // byte 138
  UINT8 index_classification_level_1[6];      // bytes 139 to 144
  UINT8 index_classification_level_2[6];      // bytes 145 to 150
  UINT8 index_classification_level_3[6];      // bytes 151 to 156
  UINT8 kospi_200_sector_code_1;              // byte 157
  UINT8 kospi_200_sector_code_2;              // byte 158
  UINT8 kospi;                                // byte 159
  UINT8 kosdaq;                               // byte 160
  UINT8 kospi_100;                            // byte 161
  UINT8 kospi_50;                             // byte 162
  UINT8 kosdaq_150;                           // byte 163
  UINT8 krx_100;                              // byte 164
  UINT8 krx_300;                              // byte 165
  UINT8 kospi_200_high_dividend_yield_index;  // byte 166
  UINT8 krx_bbig_index;                       // byte 167
  UINT8 krx_secondary_battery_top_10_index;   // byte 168
  UINT8 krx_bio_top_10_index;                 // byte 169
  UINT8 korea_value_up_index;                 // byte 170
  UINT8 filler_8[8];                          // bytes 171 to 178
  UINT8 end_keyword;                          // byte 179
} SecuritiesEquityIndexIndicatorMessage;

// Dividend Yield per Industry reference (IFMSBTD0003) KOSPI variant.
typedef struct _SecuritiesDividendYieldPerIndustryMessage {
  UINT8 message_sequence_number[8];  // bytes 0 to 7
  UINT8 index_id[6];                 // bytes 8 to 13
  UINT8 dividend_yield[13];          // bytes 14 to 26
  UINT8 filler_3[3];                 // bytes 27 to 29
  UINT8 end_keyword;                 // byte 30
} SecuritiesDividendYieldPerIndustryMessage;

// Bonds Batch Data. Per-issue reference data dumped at start-of-day for General Bonds, KTB, and Baby Bonds.
typedef struct _BondsBatchDataMessage {
  UINT8 message_sequence_number[8];                      // bytes 0 to 7
  UINT8 total_number_of_instruments_of_the_contract[6];  // bytes 8 to 13
  UINT8 business_date[8];                                // bytes 14 to 21
  UINT8 isin_code[12];                                   // bytes 22 to 33
  UINT8 a_designated_number_for_an_issue[6];             // bytes 34 to 39
  UINT8 retail_bond_type_code[2];                        // bytes 40 to 41
  UINT8 abbreviated_issue_name[40];                      // bytes 42 to 81
  UINT8 abbreviated_issue_name_in_en[40];                // bytes 82 to 121
  UINT8 market_operation_product_id[3];                  // bytes 122 to 124
  UINT8 bond_listing_type_code;                          // byte 125
  UINT8 bond_category_code[6];                           // bytes 126 to 131
  UINT8 bond_guaranteed_type_code;                       // byte 132
  UINT8 coupon_payment_type_code[2];                     // bytes 133 to 134
  UINT8 listing_date[8];                                 // bytes 135 to 142
  UINT8 issue_date[8];                                   // bytes 143 to 150
  UINT8 redemption_date[8];                              // bytes 151 to 158
  UINT8 sale_date[8];                                    // bytes 159 to 166
  UINT8 bond_issuance_rate[13];                          // bytes 167 to 179
  UINT8 coupon_rate[14];                                 // bytes 180 to 193
  UINT8 monthly_cycle_of_coupon_payment[4];              // bytes 194 to 197
  UINT8 coupon_payment_timing_code;                      // byte 198
  UINT8 interest_payment;                                // byte 199
  UINT8 coupon_payment_date_type_code;                   // byte 200
  UINT8 decimal_point_of_coupon_type_code;               // byte 201
  UINT8 pre_issue_sale_coupon_payment_type_code;         // byte 202
  UINT8 issuing_amount[22];                              // bytes 203 to 224
  UINT8 listed_amount[22];                               // bytes 225 to 246
  UINT8 redemption_ratio_at_maturity[13];                // bytes 247 to 259
  UINT8 amortization_type_code;                          // byte 260
  UINT8 number_of_months_for_grace[4];                   // bytes 261 to 264
  UINT8 number_of_amortization[5];                       // bytes 265 to 269
  UINT8 trading_halt;                                    // byte 270
  UINT8 prior_coupon_payment_date[8];                    // bytes 271 to 278
  UINT8 next_coupon_payment_date[8];                     // bytes 279 to 286
  UINT8 perpetual_bond_maturity_structure_status;        // byte 287
  UINT8 strip_bond_type_code;                            // byte 288
  UINT8 base_price[11];                                  // bytes 289 to 299
  UINT8 liquidation_trade;                               // byte 300
  UINT8 investment_caution_bond_type_code;               // byte 301
  UINT8 end_keyword;                                     // byte 302
} BondsBatchDataMessage;

// REPO Batch Data. Per-issue reference data dumped at start-of-day for REPO instruments.
typedef struct _RepoBatchDataMessage {
  UINT8 message_sequence_number[8];                      // bytes 0 to 7
  UINT8 total_number_of_instruments_of_the_contract[6];  // bytes 8 to 13
  UINT8 business_date[8];                                // bytes 14 to 21
  UINT8 isin_code[12];                                   // bytes 22 to 33
  UINT8 a_designated_number_for_an_issue[6];             // bytes 34 to 39
  UINT8 market_operation_product_id[3];                  // bytes 40 to 42
  UINT8 abbreviated_issue_name[40];                      // bytes 43 to 82
  UINT8 market_value[11];                                // bytes 83 to 93
  UINT8 end_keyword;                                     // byte 94
} RepoBatchDataMessage;

// Issue Event. Per-issue lifecycle event log.
typedef struct _IssueEventMessage {
  UINT8 message_sequence_number[8];  // bytes 0 to 7
  UINT8 isin_code[12];               // bytes 8 to 19
  UINT8 event_type_code[2];          // bytes 20 to 21
  UINT8 event_reason_code[4];        // bytes 22 to 25
  UINT8 event_start_date[8];         // bytes 26 to 33
  UINT8 event_end_date[8];           // bytes 34 to 41
  UINT8 end_keyword;                 // byte 42
} IssueEventMessage;

// Corporate Bonds related to Securities and Baby Bonds Issue reference data.
typedef struct _CorporateBondsReferenceMessage {
  UINT8 message_sequence_number[8];                                // bytes 0 to 7
  UINT8 isin_code[12];                                             // bytes 8 to 19
  UINT8 abbreviated_issue_name[40];                                // bytes 20 to 59
  UINT8 issue_date[8];                                             // bytes 60 to 67
  UINT8 redemption_date[8];                                        // bytes 68 to 75
  UINT8 listing_date[8];                                           // bytes 76 to 83
  UINT8 coupon_payment_type_code[2];                               // bytes 84 to 85
  UINT8 issuing_amount[22];                                        // bytes 86 to 107
  UINT8 listed_amount[22];                                         // bytes 108 to 129
  UINT8 coupon_payment_timing_code;                                // byte 130
  UINT8 number_of_months_for_grace[4];                             // bytes 131 to 134
  UINT8 number_of_amortization[5];                                 // bytes 135 to 139
  UINT8 interest_payment;                                          // byte 140
  UINT8 coupon_payment_date_type_code;                             // byte 141
  UINT8 coupon_rate[14];                                           // bytes 142 to 155
  UINT8 substitute_price_of_securities[11];                        // bytes 156 to 166
  UINT8 isin[12];                                                  // bytes 167 to 178
  UINT8 date_to_start_exercising[8];                               // bytes 179 to 186
  UINT8 date_to_end_exercising[8];                                 // bytes 187 to 194
  UINT8 record_date_of_dividend_payout;                            // byte 195
  UINT8 exercise_ratio[7];                                         // bytes 196 to 202
  UINT8 yield_to_maturity[13];                                     // bytes 203 to 215
  UINT8 corporate_bonds_related_to_securities_exercise_price[11];  // bytes 216 to 226
  UINT8 abbreviated_issue_code[9];                                 // bytes 227 to 235
  UINT8 baby_bonds_type_code[3];                                   // bytes 236 to 238
  UINT8 end_keyword;                                               // byte 239
} CorporateBondsReferenceMessage;

// Regular Bonds installment repayment date.
typedef struct _RegularBondsInstallmentRepaymentDateMessage {
  UINT8 message_sequence_number[8];     // bytes 0 to 7
  UINT8 isin_code[12];                  // bytes 8 to 19
  UINT8 installment_repayment_date[8];  // bytes 20 to 27
  UINT8 end_keyword;                    // byte 28
} RegularBondsInstallmentRepaymentDateMessage;

// REPO Classification Data.
typedef struct _RepoClassificationDataMessage {
  UINT8 message_sequence_number[8];    // bytes 0 to 7
  UINT8 business_date[8];              // bytes 8 to 15
  UINT8 repo_classification_code[2];   // bytes 16 to 17
  UINT8 repo_classification_name[20];  // bytes 18 to 37
  UINT8 end_keyword;                   // byte 38
} RepoClassificationDataMessage;

// REPO Trade Availability per Term.
typedef struct _RepoTradeAvailabilityPerTermMessage {
  UINT8 message_sequence_number[8];       // bytes 0 to 7
  UINT8 isin_code[12];                    // bytes 8 to 19
  UINT8 number_of_repo_trade_periods[3];  // bytes 20 to 22
  UINT8 repo_trade_period_1[3];           // bytes 23 to 25
  UINT8 repo_trade_period_2[3];           // bytes 26 to 28
  UINT8 repo_trade_period_3[3];           // bytes 29 to 31
  UINT8 repo_trade_period_4[3];           // bytes 32 to 34
  UINT8 repo_trade_period_5[3];           // bytes 35 to 37
  UINT8 repo_trade_period_6[3];           // bytes 38 to 40
  UINT8 repo_trade_period_7[3];           // bytes 41 to 43
  UINT8 repo_trade_period_8[3];           // bytes 44 to 46
  UINT8 repo_trade_period_9[3];           // bytes 47 to 49
  UINT8 repo_trade_period_10[3];          // bytes 50 to 52
  UINT8 end_keyword;                      // byte 53
} RepoTradeAvailabilityPerTermMessage;

// Retail Bonds Type Code reference (IFMSBTD0018) Bonds A BND variant.
typedef struct _RetailBondsTypeCodeMessage {
  UINT8 message_sequence_number[8];           // bytes 0 to 7
  UINT8 retail_bond_type_code[2];             // bytes 8 to 9
  UINT8 retail_bond_category_name[20];        // bytes 10 to 29
  UINT8 retail_bond_category_name_in_en[20];  // bytes 30 to 49
  UINT8 retail_bond_generated_quotes;         // byte 50
  UINT8 end_keyword;                          // byte 51
} RetailBondsTypeCodeMessage;

// Branch
casetype _Payload (UINT64 selector, UINT32 available) {
  switch (selector) {
    case 0x4932303030: PollingDataMessage polling_data_message;
    case 0x4941303030: KrxIndexMessage krx_index_message;
    case 0x4942303030: KrxEstimatedIndexMessage krx_estimated_index_message;
    case 0x4A32303030: GlobalIndexMessage global_index_message;
    case 0x4A34303030: BondPrimeIndexMessage bond_prime_index_message;
    case 0x4B31303030: BondKtbIndexMessage bond_ktb_index_message;
    case 0x4B38303030: BondKtbIndexTermStructureMessage bond_ktb_index_term_structure_message;
    case 0x4947303030: BondIndexKrxMessage bond_index_krx_message;
    case 0x4232303153: EquityDerivativesUnderlyingSnapshotKospiMessage equity_derivatives_underlying_snapshot_kospi_message;
    case 0x4232303151: EquityDerivativesUnderlyingSnapshotKosdaqMessage equity_derivatives_underlying_snapshot_kosdaq_message;
    case 0x4232303253: EquityDerivativesUnderlyingSnapshotKospiMmLpIncludedMessage equity_derivatives_underlying_snapshot_kospi_mm_lp_included_message;
    case 0x4232303353: EquityDerivativesUnderlyingSnapshotKospiMmLpIncludedMessage equity_derivatives_underlying_snapshot_kospi_mm_lp_included_message_2;
    case 0x4232303453: EquityDerivativesUnderlyingSnapshotKospiMmLpIncludedMessage equity_derivatives_underlying_snapshot_kospi_mm_lp_included_message_3;
    case 0x4232303553: EquityDerivativesUnderlyingSnapshotKospiMmLpIncludedMessage equity_derivatives_underlying_snapshot_kospi_mm_lp_included_message_4;
    case 0x4130303153: SecuritiesEquitiesBatchDataMessage securities_equities_batch_data_message;
    case 0x4130303253: SecuritiesEquitiesBatchDataMessage securities_equities_batch_data_message_2;
    case 0x4130303353: SecuritiesEquitiesBatchDataMessage securities_equities_batch_data_message_3;
    case 0x4130303453: SecuritiesEquitiesBatchDataMessage securities_equities_batch_data_message_4;
    case 0x4130303553: SecuritiesEquitiesBatchDataMessage securities_equities_batch_data_message_5;
    case 0x4130303151: SecuritiesEquitiesBatchDataMessage securities_equities_batch_data_message_6;
    case 0x4130303158: SecuritiesEquitiesBatchDataMessage securities_equities_batch_data_message_7;
    case 0x4935303153: SecuritiesClosingDateMessage securities_closing_date_message;
    case 0x4935303353: SecuritiesClosingDateMessage securities_closing_date_message_2;
    case 0x4935303453: SecuritiesClosingDateMessage securities_closing_date_message_3;
    case 0x4935303553: SecuritiesClosingDateMessage securities_closing_date_message_4;
    case 0x4935303151: SecuritiesClosingDateMessage securities_closing_date_message_5;
    case 0x4935303158: SecuritiesClosingDateMessage securities_closing_date_message_6;
    case 0x4937303153: SecuritiesMmLpInformationMessage securities_mm_lp_information_message;
    case 0x4937303253: SecuritiesMmLpInformationMessage securities_mm_lp_information_message_2;
    case 0x4937303353: SecuritiesMmLpInformationMessage securities_mm_lp_information_message_3;
    case 0x4937303453: SecuritiesMmLpInformationMessage securities_mm_lp_information_message_4;
    case 0x4937303553: SecuritiesMmLpInformationMessage securities_mm_lp_information_message_5;
    case 0x4937303151: SecuritiesMmLpInformationMessage securities_mm_lp_information_message_6;
    case 0x4937303158: SecuritiesMmLpInformationMessage securities_mm_lp_information_message_7;
    case 0x4D39303053: SecuritiesMemberInformationMessage securities_member_information_message;
    case 0x4D39303051: SecuritiesMemberInformationMessage securities_member_information_message_2;
    case 0x4D39303058: SecuritiesMemberInformationMessage securities_member_information_message_3;
    case 0x4139303153: SecuritiesTreasuryStocksBatchMessage securities_treasury_stocks_batch_message;
    case 0x4139303151: SecuritiesTreasuryStocksBatchMessage securities_treasury_stocks_batch_message_2;
    case 0x4139303158: SecuritiesTreasuryStocksBatchMessage securities_treasury_stocks_batch_message_3;
    case 0x4341303153: SecuritiesEquityIndexIndicatorMessage securities_equity_index_indicator_message;
    case 0x4341303151: SecuritiesEquityIndexIndicatorMessage securities_equity_index_indicator_message_2;
    case 0x5032303053: SecuritiesDividendYieldPerIndustryMessage securities_dividend_yield_per_industry_message;
    case 0x5032303051: SecuritiesDividendYieldPerIndustryMessage securities_dividend_yield_per_industry_message_2;
    case 0x4130303142: BondsBatchDataMessage bonds_batch_data_message;
    case 0x4130303152: RepoBatchDataMessage repo_batch_data_message;
    case 0x4936303153: IssueEventMessage issue_event_message;
    case 0x4936303253: IssueEventMessage issue_event_message_2;
    case 0x4936303353: IssueEventMessage issue_event_message_3;
    case 0x4936303453: IssueEventMessage issue_event_message_4;
    case 0x4936303553: IssueEventMessage issue_event_message_5;
    case 0x4936303151: IssueEventMessage issue_event_message_6;
    case 0x4936303158: IssueEventMessage issue_event_message_7;
    case 0x4936303142: IssueEventMessage issue_event_message_8;
    case 0x493630314D: IssueEventMessage issue_event_message_9;
    case 0x493630314B: IssueEventMessage issue_event_message_10;
    case 0x4936303152: IssueEventMessage issue_event_message_11;
    case 0x4639303142: CorporateBondsReferenceMessage corporate_bonds_reference_message;
    case 0x463930314D: CorporateBondsReferenceMessage corporate_bonds_reference_message_2;
    case 0x424E303142: RegularBondsInstallmentRepaymentDateMessage regular_bonds_installment_repayment_date_message;
    case 0x4342303152: RepoClassificationDataMessage repo_classification_data_message;
    case 0x5330303152: RepoTradeAvailabilityPerTermMessage repo_trade_availability_per_term_message;
    case 0x4733303042: RetailBondsTypeCodeMessage retail_bonds_type_code_message;
    default: UINT8 unknown[available];
  }
} Payload;

// ---- Packet: Packet ----------------------------------------------------------

// Koscom MDCS Exture Udp Packet
entrypoint typedef struct _Packet (UINT32 available) where (available >= 5) {
  UINT32BE tr_code_0;                                                                                                                       // bytes 0 to 3, the first 4 of 5 characters a choice is made on
  UINT8 tr_code_1;                                                                                                                          // byte 4
  Payload(((((UINT64) tr_code_0) << 8) | ((UINT64) tr_code_1)), (available - 5)) payload[:byte-size-single-element-array (available - 5)];
} Packet;

