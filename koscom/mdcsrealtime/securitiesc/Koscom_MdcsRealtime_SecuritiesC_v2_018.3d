// ---- Values ------------------------------------------------------------------

// End Keyword: one byte code
#define END_KEYWORD_END_OF_MESSAGE 0xFF  // End Of Message

// Index Change Sign Against The Previous Day: one byte code
#define INDEX_CHANGE_SIGN_AGAINST_THE_PREVIOUS_DAY_ASCENDED 0x2B   // Ascended
#define INDEX_CHANGE_SIGN_AGAINST_THE_PREVIOUS_DAY_UNCHANGED 0x20  // Unchanged
#define INDEX_CHANGE_SIGN_AGAINST_THE_PREVIOUS_DAY_DECLINED 0x2D   // Declined

// Index Constituent: one byte code
#define INDEX_CONSTITUENT_INCLUDED_IN_ETF_NOT_IN_INDEX 0x30  // Included In Etf Not In Index
#define INDEX_CONSTITUENT_INCLUDED_IN_INDEX 0x31             // Included In Index

// Average Spread Sign: one byte code
#define AVERAGE_SPREAD_SIGN_ASCENDED 0x2B   // Ascended
#define AVERAGE_SPREAD_SIGN_UNCHANGED 0x20  // Unchanged
#define AVERAGE_SPREAD_SIGN_DECLINED 0x2D   // Declined

// Final Ask Bid Type Code: one byte code
#define FINAL_ASK_BID_TYPE_CODE_SINGLE_PRICE 0x20    // Single Price
#define FINAL_ASK_BID_TYPE_CODE_NOT_APPLICABLE 0x30  // Not Applicable
#define FINAL_ASK_BID_TYPE_CODE_ASK 0x31             // Ask
#define FINAL_ASK_BID_TYPE_CODE_BID 0x32             // Bid

// ---- Types -------------------------------------------------------------------

// Polling data transmitted at one-minute intervals on every market data feed. Carries Current Time as a heartbeat.
typedef struct _PollingDataMessage {
  UINT8 current_time[4];  // bytes 0 to 3
  UINT8 end_keyword;      // byte 4
} PollingDataMessage;

// Krx Index real-time message. Reports current index value, change against previous day, accumulated trading volume, and accumulated trading value for one index. The Index ID field identifies which index group (KRX Index Group 1/2/3, Sector A/B, Gold Spot, or Equity Derivatives) this record belongs to.
typedef struct _KrxIndexMessage {
  UINT8 index_id[6];                                 // bytes 0 to 5
  UINT8 isin_code[12];                               // bytes 6 to 17
  UINT8 calculation_time[6];                         // bytes 18 to 23
  UINT8 index[9];                                    // bytes 24 to 32
  UINT8 index_change_sign_against_the_previous_day;  // byte 33
  UINT8 index_change_against_the_previous_day[9];    // bytes 34 to 42
  UINT8 accumulated_trading_volume[12];              // bytes 43 to 54
  UINT8 index_accumulated_trading_value[12];         // bytes 55 to 66
  UINT8 filler_4[4];                                 // bytes 67 to 70
  UINT8 end_keyword;                                 // byte 71
} KrxIndexMessage;

// Krx Estimated Index real-time message. Reports the estimated index value during the pre-opening simultaneous-trading window or during regular session estimation. Identical field layout to the Krx Index Message.
typedef struct _KrxEstimatedIndexMessage {
  UINT8 index_id[6];                                 // bytes 0 to 5
  UINT8 isin_code[12];                               // bytes 6 to 17
  UINT8 calculation_time[6];                         // bytes 18 to 23
  UINT8 index[9];                                    // bytes 24 to 32
  UINT8 index_change_sign_against_the_previous_day;  // byte 33
  UINT8 index_change_against_the_previous_day[9];    // bytes 34 to 42
  UINT8 accumulated_trading_volume[12];              // bytes 43 to 54
  UINT8 index_accumulated_trading_value[12];         // bytes 55 to 66
  UINT8 filler_4[4];                                 // bytes 67 to 70
  UINT8 end_keyword;                                 // byte 71
} KrxEstimatedIndexMessage;

// Global Index real-time message. Reports the current value of a foreign index referenced by KRX (e.g. Korea-Taiwan IT Premier, Korea-China Index) in the index's native currency.
typedef struct _GlobalIndexMessage {
  UINT8 index_id[6];                                 // bytes 0 to 5
  UINT8 isin_code[12];                               // bytes 6 to 17
  UINT8 business_date[8];                            // bytes 18 to 25
  UINT8 calculation_time[6];                         // bytes 26 to 31
  UINT8 index[9];                                    // bytes 32 to 40
  UINT8 index_change_sign_against_the_previous_day;  // byte 41
  UINT8 index_change_against_the_previous_day[9];    // bytes 42 to 50
  UINT8 currency_code[3];                            // bytes 51 to 53
  UINT8 filler_4[4];                                 // bytes 54 to 57
  UINT8 end_keyword;                                 // byte 58
} GlobalIndexMessage;

// Bond Prime Index intraday calculation. Reports clean and total-earnings index values plus their weighted variants and average duration / convexity / yield for one Group Code and Maturity Code pair.
typedef struct _BondPrimeIndexMessage {
  UINT8 calculating_date[8];                                         // bytes 0 to 7
  UINT8 calculating_time[8];                                         // bytes 8 to 15
  UINT8 group_code[5];                                               // bytes 16 to 20
  UINT8 maturity_code[3];                                            // bytes 21 to 23
  UINT8 clean_price_index_krx[16];                                   // bytes 24 to 39
  UINT8 total_earnings_index[16];                                    // bytes 40 to 55
  UINT8 clean_price_index_weight[16];                                // bytes 56 to 71
  UINT8 total_earnings_index_weight[16];                             // bytes 72 to 87
  UINT8 weight_of_clean_index_value_for_integrity_index_weight[16];  // bytes 88 to 103
  UINT8 weight_of_sum_index_value_for_integrity_index_weight[16];    // bytes 104 to 119
  UINT8 average_duration[16];                                        // bytes 120 to 135
  UINT8 average_convexity[16];                                       // bytes 136 to 151
  UINT8 average_yld[16];                                             // bytes 152 to 167
  UINT8 transmission_time[8];                                        // bytes 168 to 175
  UINT8 end_keyword;                                                 // byte 176
} BondPrimeIndexMessage;

// Bond KTB Index intraday calculation. Reports total profit, clean price, market price, call and zero re-investment indices, futures basis price, duration, convexity, and YTM for one KTB-based Bond Index ID.
typedef struct _BondKtbIndexMessage {
  UINT8 bond_index_id[6];                  // bytes 0 to 5
  UINT8 base_date[8];                      // bytes 6 to 13
  UINT8 base_time[6];                      // bytes 14 to 19
  UINT8 total_profit_index[11];            // bytes 20 to 30
