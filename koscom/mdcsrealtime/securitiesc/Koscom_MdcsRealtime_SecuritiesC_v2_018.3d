  UINT8 market_price_index_ktb[11];        // bytes 42 to 52
  UINT8 call_re_investment_index_ktb[11];  // bytes 53 to 63
  UINT8 zero_re_investment_index_ktb[11];  // bytes 64 to 74
  UINT8 futures_basis_price[10];           // bytes 75 to 84
  UINT8 duration[7];                       // bytes 85 to 91
  UINT8 convexity[7];                      // bytes 92 to 98
  UINT8 average_ytm[7];                    // bytes 99 to 105
  UINT8 average_forward_ytm[7];            // bytes 106 to 112
  UINT8 end_keyword;                       // byte 113
} BondKtbIndexMessage;

// Bond KTB Index TermStructure. One record per ISIN constituent of a KTB Index showing its basis price, clean price, YTM, and the Index Constituent flag.
typedef struct _BondKtbIndexTermStructureMessage {
  UINT8 bond_index_id[6];   // bytes 0 to 5
  UINT8 base_date[8];       // bytes 6 to 13
  UINT8 base_time[6];       // bytes 14 to 19
  UINT8 isin_code[12];      // bytes 20 to 31
