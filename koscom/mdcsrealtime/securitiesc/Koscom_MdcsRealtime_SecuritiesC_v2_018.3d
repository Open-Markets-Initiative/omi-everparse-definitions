  UINT8 clean_price[10];    // bytes 42 to 51
  UINT8 average_ytm[7];     // bytes 52 to 58
  UINT8 index_constituent;  // byte 59
  UINT8 end_keyword;        // byte 60
} BondKtbIndexTermStructureMessage;

