  UINT8 previous_days_tax_base_nav_before_dividend[9];                                // bytes 125 to 133
  UINT8 previous_days_cash_dividend_amount[12];                                       // bytes 134 to 145
  UINT8 tax_base_nav_as_of_the_day_before_the_previous_day[9];                        // bytes 146 to 154
  UINT8 previous_days_non_taxable_base_price_for_overseas_stocks[9];                  // bytes 155 to 163
  UINT8 previous_days_non_taxable_base_price_before_dividend_for_overseas_stocks[9];  // bytes 164 to 172
  UINT8 day_before_previous_days_non_taxable_base_price_for_overseas_stocks[9];       // bytes 173 to 181
  UINT8 number_of_free_floating_etf_shares[16];                                       // bytes 182 to 197
  UINT8 filler_46[46];                                                                // bytes 198 to 243
  UINT8 end_keyword;                                                                  // byte 244
} EtpTransferAgentBatchMessage;

// Synthetic ETF risk appraisement daily trading data.
typedef struct _EtfRiskAppraisementMessage {
  UINT8 isin[12];                                            // bytes 0 to 11
  UINT8 data_seq_number[8];                                  // bytes 12 to 19
  UINT8 date[8];                                             // bytes 20 to 27
  UINT8 office_consignment_companys_registration_number[3];  // bytes 28 to 30
  UINT8 name_of_counterparty[50];                            // bytes 31 to 80
  UINT8 otc_derivatives_type;                                // byte 81
  UINT8 net_assets_amount[15];                               // bytes 82 to 96
  UINT8 total_danger_exposure_amount[15];                    // bytes 97 to 111
  UINT8 security_appraisal_amount[15];                       // bytes 112 to 126
  UINT8 security_rate[7];                                    // bytes 127 to 133
  UINT8 risk_appraisal_amount[15];                           // bytes 134 to 148
  UINT8 risk_appraisal_amount_rate[7];                       // bytes 149 to 155
  UINT8 filler_38[38];                                       // bytes 156 to 193
  UINT8 end_keyword;                                         // byte 194
} EtfRiskAppraisementMessage;

// Synthetic ETF basic index composition constituents.
typedef struct _SyntheticEtfConstituentsMessage {
  UINT8 isin[12];                                            // bytes 0 to 11
  UINT8 data_seq_number[8];                                  // bytes 12 to 19
  UINT8 date[8];                                             // bytes 20 to 27
  UINT8 office_consignment_companys_registration_number[3];  // bytes 28 to 30
  UINT8 composition_constituents_number[4];                  // bytes 31 to 34
  UINT8 composition_constituents_code[12];                   // bytes 35 to 46
  UINT8 composition_constituents_name[80];                   // bytes 47 to 126
  UINT8 composition_ratio[7];                                // bytes 127 to 133
  UINT8 filler_60[60];                                       // bytes 134 to 193
  UINT8 end_keyword;                                         // byte 194
} SyntheticEtfConstituentsMessage;

// ELW Investment Indicator Sensitivity. Theoretical warrant price plus signed Delta/Gamma/Theta/Vega/Rho sensitivities, intrinsic volatility, and prerequisite cost.
typedef struct _ElwInvestmentIndicatorSensitivityMessage {
  UINT8 isin[12];                       // bytes 0 to 11
  UINT8 time[6];                        // bytes 12 to 17
  UINT8 theoretical_warrant_price[10];  // bytes 18 to 27
  UINT8 sensitivity_delta_sign;         // byte 28
  UINT8 sensitivity_delta[7];           // bytes 29 to 35
  UINT8 sensitivity_gamma_sign;         // byte 36
  UINT8 sensitivity_gamma[7];           // bytes 37 to 43
  UINT8 sensitivity_theta_sign;         // byte 44
  UINT8 sensitivity_theta[12];          // bytes 45 to 56
  UINT8 sensitivity_vega_sign;          // byte 57
  UINT8 sensitivity_vega[12];           // bytes 58 to 69
  UINT8 sensitivity_rho_sign;           // byte 70
  UINT8 sensitivity_rho[12];            // bytes 71 to 82
  UINT8 intrinsic_volatility[5];        // bytes 83 to 87
  UINT8 prerequisite_cost[10];          // bytes 88 to 97
  UINT8 filler_6[6];                    // bytes 98 to 103
  UINT8 end_keyword;                    // byte 104
} ElwInvestmentIndicatorSensitivityMessage;

// ETN intraday indicative value. Previous-day and during-market/final iIV per ETN.
typedef struct _EtnIivMessage {
  UINT8 isin[12];                         // bytes 0 to 11
  UINT8 hours[6];                         // bytes 12 to 17
  UINT8 previous_days_iv[9];              // bytes 18 to 26
  UINT8 during_market_hours_final_iv[9];  // bytes 27 to 35
  UINT8 filler_28[28];                    // bytes 36 to 63
  UINT8 end_keyword;                      // byte 64
} EtnIivMessage;

// ETN signed disparate ratio per ETN.
typedef struct _EtnDisparateRatioMessage {
  UINT8 isin[12];              // bytes 0 to 11
  UINT8 seq_number[8];         // bytes 12 to 19
  UINT8 date[8];               // bytes 20 to 27
  UINT8 disparate_ratio_sign;  // byte 28
  UINT8 disparate_ratio[9];    // bytes 29 to 37
  UINT8 filler_56[56];         // bytes 38 to 93
  UINT8 end_keyword;           // byte 94
} EtnDisparateRatioMessage;

// Loan transaction available quantity public disclosure. Reports the available stock lending quantity for one issue (ISIN) in shares.
typedef struct _LoanTransactionAvailableQuantityMessage {
  UINT8 issue_code[12];                  // bytes 0 to 11
  UINT8 business_code[3];                // bytes 12 to 14
  UINT8 available_lending_quantity[10];  // bytes 15 to 24
  UINT8 filler_19[19];                   // bytes 25 to 43
  UINT8 end_keyword;                     // byte 44
} LoanTransactionAvailableQuantityMessage;

// Branch
casetype _Payload (UINT64 selector, UINT32 available) {
  switch (selector) {
    case 0x4136303133: KOtcIssueClosingMessage k_otc_issue_closing_message;
    case 0x4137303133: KOtcMarketOperationMessage k_otc_market_operation_message;
    case 0x4735303133: KOtcMarketActionMessage k_otc_market_action_message;
    case 0x4132303133: KOtcQuoteMessage k_otc_quote_message;
    case 0x4133303133: KOtcOrderFilledMessage k_otc_order_filled_message;
    case 0x4A36303737: OtcBondTradedInfoMessage otc_bond_traded_info_message;
    case 0x4A37303737: OtcBondTradesPerInstitutionMessage otc_bond_trades_per_institution_message;
    case 0x4331303737: OtcBondTypesPerInvestorMessage otc_bond_types_per_investor_message;
    case 0x4C39303737: KBondMessage k_bond_message;
    case 0x4532303030: MkfIndexMessage mkf_index_message;
    case 0x4F39303030: MkfIndexJpyMessage mkf_index_jpy_message;
    case 0x5033303030: WisefnIndexMessage wisefn_index_message;
    case 0x4250303030: KisIndexMessage kis_index_message;
    case 0x4B30303030: MkfBondIndexMessage mkf_bond_index_message;
    case 0x4C36303030: KisBondIndexMessage kis_bond_index_message;
    case 0x4B36303030: KebiBondIndexMessage kebi_bond_index_message;
    case 0x5136303030: KabiBondIndexMessage kabi_bond_index_message;
    case 0x4345303030: NicepniBondIndexMessage nicepni_bond_index_message;
    case 0x4256303353: DomesticEtfInavMessage domestic_etf_inav_message;
    case 0x4257303353: DomesticEtfEstimatedInavMessage domestic_etf_estimated_inav_message;
    case 0x4C35303353: GlobalEtfInavMessage global_etf_inav_message;
    case 0x5036303353: EtfTrackingErrorMessage etf_tracking_error_message;
    case 0x5037303353: GlobalEtfTrackingErrorMessage global_etf_tracking_error_message;
    case 0x4638303353: EtpPdfMessage etp_pdf_message;
    case 0x4D38303353: EtpOperatorInformationMessage etp_operator_information_message;
    case 0x4D38303553: EtpOperatorInformationMessage etp_operator_information_message_2;
    case 0x4D38303151: EtpOperatorInformationMessage etp_operator_information_message_3;
    case 0x4E38303353: EtpTransferAgentBatchMessage etp_transfer_agent_batch_message;
    case 0x4E38303553: EtpTransferAgentBatchMessage etp_transfer_agent_batch_message_2;
    case 0x4E38303151: EtpTransferAgentBatchMessage etp_transfer_agent_batch_message_3;
    case 0x5134303353: EtfRiskAppraisementMessage etf_risk_appraisement_message;
    case 0x5135303353: SyntheticEtfConstituentsMessage synthetic_etf_constituents_message;
    case 0x4337303253: ElwInvestmentIndicatorSensitivityMessage elw_investment_indicator_sensitivity_message;
    case 0x5333303453: EtnIivMessage etn_iiv_message;
    case 0x5834303453: EtnDisparateRatioMessage etn_disparate_ratio_message;
    case 0x4343303030: LoanTransactionAvailableQuantityMessage loan_transaction_available_quantity_message;
    default: UINT8 unknown[available];
  }
} Payload;

// ---- Packet: Packet ----------------------------------------------------------

// Koscom MDCS Exture Udp Packet
entrypoint typedef struct _Packet (UINT32 available) where (available >= 5) {
  UINT32BE tr_code_0;                                                                                                                       // bytes 0 to 3, the first 4 of 5 characters a choice is made on
  UINT8 tr_code_1;                                                                                                                          // byte 4
  Payload(((((UINT64) tr_code_0) << 8) | ((UINT64) tr_code_1)), (available - 5)) payload[:byte-size-single-element-array (available - 5)];
} Packet;

