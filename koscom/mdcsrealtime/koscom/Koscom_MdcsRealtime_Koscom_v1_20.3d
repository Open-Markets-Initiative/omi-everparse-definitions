  UINT8 trading_price_compare_remaining_quantity_of_ask[10];  // bytes 184 to 193
  UINT8 trading_price_compare_remaining_quantity_of_bid[10];  // bytes 194 to 203
  UINT8 filler_40[40];                                        // bytes 204 to 243
  UINT8 end_keyword;                                          // byte 244
} KOtcOrderFilledMessage;

