  UINT8 total_trading_accumulated_volume[12];                 // bytes 90 to 101
  UINT8 total_trading_accumulated_value[14];                  // bytes 102 to 115
  UINT8 total_remaining_quantity_of_ask[10];                  // bytes 116 to 125
  UINT8 total_remaining_quantity_of_bid[10];                  // bytes 126 to 135
  UINT8 best_ask_order[9];                                    // bytes 136 to 144
