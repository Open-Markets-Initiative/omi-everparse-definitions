// ---- Values ------------------------------------------------------------------

// Quotation Category: one byte code
#define QUOTATION_CATEGORY_WEIGHTED_AVERAGE_PRICE 0x30  // Weighted Average Price
#define QUOTATION_CATEGORY_QUOTATION 0x31               // Quotation
#define QUOTATION_CATEGORY_NO_TRADE 0x32                // No Trade

// End Keyword: one byte code
#define END_KEYWORD_END_OF_MESSAGE 0xFF  // End Of Message

// Type: one byte code
#define TYPE_TRADING_HALT 0x31             // Trading Halt
#define TYPE_LIFT_AFTER_TRADING_HALT 0x32  // Lift After Trading Halt

// Process Type: one byte code
#define PROCESS_TYPE_NORMAL 0x31        // Normal
#define PROCESS_TYPE_CORRECTION 0x32    // Correction
#define PROCESS_TYPE_CANCELLATION 0x33  // Cancellation

// Bidask Type: one byte code
#define BIDASK_TYPE_ASK 0x31  // Ask
#define BIDASK_TYPE_BID 0x32  // Bid

// Compared To Previous Day Type: one byte code
#define COMPARED_TO_PREVIOUS_DAY_TYPE_UP 0x2B          // Up
#define COMPARED_TO_PREVIOUS_DAY_TYPE_STEADINESS 0x20  // Steadiness
#define COMPARED_TO_PREVIOUS_DAY_TYPE_DOWN 0x2D        // Down

// Sign: one byte code
#define SIGN_ASCENDED 0x2B    // Ascended
#define SIGN_STEADINESS 0x20  // Steadiness
#define SIGN_DECLINED 0x2D    // Declined

// ---- Types -------------------------------------------------------------------

// K-OTC Issue Closing. Reports closing price and the quotation category per ISIN.
typedef struct _KOtcIssueClosingMessage {
  UINT8 isin[12];            // bytes 0 to 11
  UINT8 data_seq_number[8];  // bytes 12 to 19
  UINT8 closing_price[9];    // bytes 20 to 28
  UINT8 quotation_category;  // byte 29
  UINT8 filler_4[4];         // bytes 30 to 33
  UINT8 end_keyword;         // byte 34
} KOtcIssueClosingMessage;

// K-OTC Market Operation. Trading halt / lift-after-halt events with reason code.
typedef struct _KOtcMarketOperationMessage {
  UINT8 isin[12];            // bytes 0 to 11
  UINT8 data_seq_number[8];  // bytes 12 to 19
  UINT8 type_;               // byte 20
  UINT8 reason[2];           // bytes 21 to 22
  UINT8 filler_1;            // byte 23
  UINT8 end_keyword;         // byte 24
} KOtcMarketOperationMessage;

// K-OTC Market Action. Basis price and upper/lower limit price changes.
typedef struct _KOtcMarketActionMessage {
  UINT8 isin_nullable[12];                   // bytes 0 to 11
  UINT8 data_type[2];                        // bytes 12 to 13
  UINT8 change_date[8];                      // bytes 14 to 21
  UINT8 change_time[8];                      // bytes 22 to 29
  UINT8 basis_price_before_action[9];        // bytes 30 to 38
  UINT8 upper_limit_price_before_action[9];  // bytes 39 to 47
  UINT8 lower_limit_price_before_action[9];  // bytes 48 to 56
  UINT8 basis_price_after_action[9];         // bytes 57 to 65
  UINT8 upper_limit_price_after_action[9];   // bytes 66 to 74
  UINT8 lower_limit_price_after_action[9];   // bytes 75 to 83
  UINT8 filler_10[10];                       // bytes 84 to 93
  UINT8 end_keyword;                         // byte 94
} KOtcMarketActionMessage;

// K-OTC Quote. Bid/ask quote with remaining quantity at the best price.
typedef struct _KOtcQuoteMessage {
  UINT8 isin[12];                                                // bytes 0 to 11
  UINT8 data_seq_number[8];                                      // bytes 12 to 19
  UINT8 process_type;                                            // byte 20
  UINT8 quote_number[6];                                         // bytes 21 to 26
  UINT8 original_quote_number[6];                                // bytes 27 to 32
  UINT8 original_quote_price[9];                                 // bytes 33 to 41
  UINT8 bidask_type;                                             // byte 42
  UINT8 price[9];                                                // bytes 43 to 51
  UINT8 quantity[10];                                            // bytes 52 to 61
  UINT8 subscription_time[6];                                    // bytes 62 to 67
  UINT8 total_remaining_quantity_of_ask[10];                     // bytes 68 to 77
  UINT8 total_remaining_quantity_of_bid[10];                     // bytes 78 to 87
  UINT8 ask_best_order[9];                                       // bytes 88 to 96
  UINT8 remaining_quantity_of_ask_best_order[10];                // bytes 97 to 106
  UINT8 bid_best_order[9];                                       // bytes 107 to 115
  UINT8 remaining_quantity_of_bid_best_order[10];                // bytes 116 to 125
  UINT8 price_compare_remaining_quantity_of_order[10];           // bytes 126 to 135
  UINT8 original_price_compare_remaining_quantity_of_order[10];  // bytes 136 to 145
  UINT8 securities_company_number[3];                            // bytes 146 to 148
  UINT8 branch_name[12];                                         // bytes 149 to 160
  UINT8 filler_33[33];                                           // bytes 161 to 193
  UINT8 end_keyword;                                             // byte 194
} KOtcQuoteMessage;

// K-OTC Order Filled. Trade prints with running totals, high/low, weighted average price, and previous-day comparison.
typedef struct _KOtcOrderFilledMessage {
  UINT8 isin[12];                                             // bytes 0 to 11
