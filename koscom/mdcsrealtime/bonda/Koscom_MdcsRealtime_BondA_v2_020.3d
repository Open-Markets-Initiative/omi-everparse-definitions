// Branch
casetype _Payload (UINT64 selector, UINT32 available) {
  switch (selector) {
    case 0x4932303030: PollingDataMessage polling_data_message;
    case 0x4941303030: KrxIndexMessage krx_index_message;
    case 0x4942303030: KrxEstimatedIndexMessage krx_estimated_index_message;
    case 0x4A32303030: GlobalIndexMessage global_index_message;
    case 0x4A34303030: BondPrimeIndexMessage bond_prime_index_message;
    case 0x4B31303030: BondKtbIndexMessage bond_ktb_index_message;
    case 0x4B38303030: BondKtbIndexTermStructureMessage bond_ktb_index_term_structure_message;
    case 0x4947303030: BondIndexKrxMessage bond_index_krx_message;
    case 0x4137303153: MarketOperationTsMessage market_operation_ts_message;
    case 0x4137303253: MarketOperationTsMessage market_operation_ts_message_2;
    case 0x4137303353: MarketOperationTsMessage market_operation_ts_message_3;
    case 0x4137303453: MarketOperationTsMessage market_operation_ts_message_4;
    case 0x4137303553: MarketOperationTsMessage market_operation_ts_message_5;
    case 0x4137303151: MarketOperationTsMessage market_operation_ts_message_6;
    case 0x4137303158: MarketOperationTsMessage market_operation_ts_message_7;
