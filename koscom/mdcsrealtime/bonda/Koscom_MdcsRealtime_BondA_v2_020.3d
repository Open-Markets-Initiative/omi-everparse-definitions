  UINT8 session_id[2];                                         // bytes 24 to 25
  UINT8 isin_code[12];                                         // bytes 26 to 37
  UINT8 isin_code_of_a_common_stock[12];                       // bytes 38 to 49
  UINT8 product_id[11];                                        // bytes 50 to 60
  UINT8 trading_halt_reason_code[3];                           // bytes 61 to 63
  UINT8 trading_halt_type_code;                                // byte 64
  UINT8 step_applied[2];                                       // bytes 65 to 66
  UINT8 price_limit_range_expansion_for_base_issue_type_code;  // byte 67
  UINT8 expected_time_of_expanding_price_limit_range[9];       // bytes 68 to 76
  UINT8 end_keyword;                                           // byte 77
} MarketOperationScheduleMessage;

// Bonds Issue Closing. Reports per-issue closing event with closing price.
typedef struct _IssueClosingMessage {
