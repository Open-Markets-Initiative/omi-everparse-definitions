// Branch
casetype _Payload (UINT64 selector, UINT32 available) {
  switch (selector) {
    case 0x4932303030: PollingDataMessage polling_data_message;
    case 0x4941303030: KrxIndexMessage krx_index_message;
    case 0x4942303030: KrxEstimatedIndexMessage krx_estimated_index_message;
    case 0x4A32303030: GlobalIndexMessage global_index_message;
    case 0x4A34303030: BondPrimeIndexMessage bond_prime_index_message;
    case 0x4B31303030: BondKtbIndexMessage bond_ktb_index_message;
    case 0x4B38303030: BondKtbIndexTermStructureMessage bond_ktb_index_term_structure_message;
    case 0x4947303030: BondIndexKrxMessage bond_index_krx_message;
    case 0x4236303147: SpotGoldQuoteMessage spot_gold_quote_message;
    case 0x4133303147: SpotGoldOrderFilledMessage spot_gold_order_filled_message;
    case 0x4737303147: SpotGoldOrderFilledPlusQuoteMessage spot_gold_order_filled_plus_quote_message;
    case 0x5231303147: SpotGoldMarketOperationTsPlusQuoteMessage spot_gold_market_operation_ts_plus_quote_message;
    case 0x4232303147: SpotGoldSnapshotMessage spot_gold_snapshot_message;
    case 0x4334303147: SpotGoldNegotiatedTradeMessage spot_gold_negotiated_trade_message;
    case 0x4236303145: EmissionsQuoteMessage emissions_quote_message;
    case 0x4133303145: EmissionsOrderFilledMessage emissions_order_filled_message;
    case 0x4737303145: EmissionsOrderFilledPlusQuoteMessage emissions_order_filled_plus_quote_message;
    case 0x5231303145: EmissionsMarketOperationTsPlusQuoteMessage emissions_market_operation_ts_plus_quote_message;
    case 0x4232303145: EmissionsSnapshotMessage emissions_snapshot_message;
    case 0x4334303145: EmissionsNegotiatedTradeMessage emissions_negotiated_trade_message;
    case 0x4134303145: EmissionsDeterminationOfBasePriceMessage emissions_determination_of_base_price_message;
    case 0x4143303145: EmissionsAuctionResultsMessage emissions_auction_results_message;
    case 0x4130303147: SpotGoldBatchDataMessage spot_gold_batch_data_message;
    case 0x4130303145: EmissionsBatchDataMessage emissions_batch_data_message;
    case 0x4D32303047: ExternalGoldSpotClosingPriceMessage external_gold_spot_closing_price_message;
    case 0x4137303147: SpotGoldMarketOperationTsMessage spot_gold_market_operation_ts_message;
    case 0x4136303147: SpotGoldIssueClosingMessage spot_gold_issue_closing_message;
    case 0x4D34303147: SpotGoldMarketOperationScheduleMessage spot_gold_market_operation_schedule_message;
    case 0x4137303145: EmissionsMarketOperationTsMessage emissions_market_operation_ts_message;
    case 0x4136303145: EmissionsIssueClosingMessage emissions_issue_closing_message;
    case 0x4D34303145: EmissionsMarketOperationScheduleMessage emissions_market_operation_schedule_message;
    case 0x4135303158: SpotGoldRandomEndMessage spot_gold_random_end_message;
    case 0x4135303147: SpotGoldRandomEndMessage spot_gold_random_end_message_2;
    default: UINT8 unknown[available];
  }
} Payload;

// ---- Packet: Packet ----------------------------------------------------------

// Koscom MDCS Exture Udp Packet
entrypoint typedef struct _Packet (UINT32 available) where (available >= 5) {
  UINT32BE tr_code_0;                                                                                                                       // bytes 0 to 3, the first 4 of 5 characters a choice is made on
  UINT8 tr_code_1;                                                                                                                          // byte 4
  Payload(((((UINT64) tr_code_0) << 8) | ((UINT64) tr_code_1)), (available - 5)) payload[:byte-size-single-element-array (available - 5)];
} Packet;

