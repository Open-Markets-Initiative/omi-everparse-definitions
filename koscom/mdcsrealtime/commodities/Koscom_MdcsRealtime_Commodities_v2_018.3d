  UINT8 closing_price_short[9];             // bytes 58 to 66
  UINT8 change_from_previous_day_sign;      // byte 67
  UINT8 change_from_previous_day[9];        // bytes 68 to 76
  UINT8 fluctuating_rate[9];                // bytes 77 to 85
  UINT8 bid_quote[9];                       // bytes 86 to 94
  UINT8 ask_quote[9];                       // bytes 95 to 103
  UINT8 currency_code_long[6];              // bytes 104 to 109
  UINT8 conversion_basic_exchange_rate[9];  // bytes 110 to 118
  UINT8 end_keyword;                        // byte 119
} ExternalGoldSpotClosingPriceMessage;

