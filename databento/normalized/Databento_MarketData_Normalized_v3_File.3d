// ---- Imbalance Msg: 96 bytes -------------------------------------------------

// An auction imbalance message; the record of the imbalance schema
entrypoint typedef struct _ImbalanceMsg {
  UINT64 ts_recv;                  // bytes 0 to 7
  UINT64 ref_price;                // bytes 8 to 15, signed, read here as unsigned
  UINT64 auction_time;             // bytes 16 to 23
  UINT64 cont_book_clr_price;      // bytes 24 to 31, signed, read here as unsigned
  UINT64 auct_interest_clr_price;  // bytes 32 to 39, signed, read here as unsigned
  UINT64 ssr_filling_price;        // bytes 40 to 47, signed, read here as unsigned
  UINT64 ind_match_price;          // bytes 48 to 55, signed, read here as unsigned
  UINT64 upper_collar;             // bytes 56 to 63, signed, read here as unsigned
  UINT64 lower_collar;             // bytes 64 to 71, signed, read here as unsigned
  UINT32 paired_qty;               // bytes 72 to 75
  UINT32 total_imbalance_qty;      // bytes 76 to 79
  UINT32 market_imbalance_qty;     // bytes 80 to 83
  UINT32 unpaired_qty;             // bytes 84 to 87
  UINT8 auction_type;              // byte 88
  UINT8 side;                      // byte 89
  UINT8 auction_status;            // byte 90
  UINT8 freeze_status;             // byte 91
  UINT8 num_extensions;            // byte 92
  UINT8 unpaired_side;             // byte 93
  UINT8 significant_imbalance;     // byte 94
  UINT8 reserved_1;                // byte 95
} ImbalanceMsg;

// ---- Error Msg: 304 bytes ----------------------------------------------------

// An error message from the Databento Live Subscription Gateway (LSG)
entrypoint typedef struct _ErrorMsg {
  UINT8 err[302];    // bytes 0 to 301
  UINT8 error_code;  // byte 302
  UINT8 is_last;     // byte 303
} ErrorMsg;

// ---- Symbol Mapping Msg: 160 bytes -------------------------------------------

// A symbol mapping message, which maps a symbol of one SType to another
entrypoint typedef struct _SymbolMappingMsg {
  UINT8 stype_in;              // byte 0
  UINT8 stype_in_symbol[71];   // bytes 1 to 71
  UINT8 stype_out;             // byte 72
  UINT8 stype_out_symbol[71];  // bytes 73 to 143
  UINT64 start_ts;             // bytes 144 to 151
  UINT64 end_ts;               // bytes 152 to 159
} SymbolMappingMsg;

// ---- System Msg: 304 bytes ---------------------------------------------------

// A non-error message from the Databento Live Subscription Gateway (LSG); also used for heartbeating
entrypoint typedef struct _SystemMsg {
  UINT8 msg[303];     // bytes 0 to 302
  UINT8 system_code;  // byte 303
} SystemMsg;

// ---- Stat Msg: 64 bytes ------------------------------------------------------

// A statistics message; the record of the statistics schema
entrypoint typedef struct _StatMsg {
  UINT64 ts_recv;         // bytes 0 to 7
  UINT64 ts_ref;          // bytes 8 to 15
  UINT64 price;           // bytes 16 to 23, signed, read here as unsigned
  UINT64 quantity;        // bytes 24 to 31, signed, read here as unsigned
  UINT32 sequence;        // bytes 32 to 35
  UINT32 ts_in_delta;     // bytes 36 to 39, signed, read here as unsigned
  UINT16 stat_type;       // bytes 40 to 41
  UINT16 channel;         // bytes 42 to 43
  UINT8 update_action;    // byte 44
  UINT8 stat_flags;       // byte 45
  UINT8 reserved_18[18];  // bytes 46 to 63
} StatMsg;

// ---- Consolidated Bid Ask Pair: 32 bytes -------------------------------------

// A price level consolidated from multiple venues
entrypoint typedef struct _ConsolidatedBidAskPair {
  UINT64 bid_px;               // bytes 0 to 7, signed, read here as unsigned
  UINT64 ask_px;               // bytes 8 to 15, signed, read here as unsigned
  UINT32 bid_sz;               // bytes 16 to 19
  UINT32 ask_sz;               // bytes 20 to 23
  UINT16 bid_pb;               // bytes 24 to 25
  UINT8 reserved_2[2];         // bytes 26 to 27
  UINT16 ask_pb;               // bytes 28 to 29
  UINT8 second_reserved_2[2];  // bytes 30 to 31
} ConsolidatedBidAskPair;

