// Message sent by the server to inform on the status of one security
typedef struct _SecurityStatusMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 security_trading_status;     // byte 16
  UINT8 non_availability_reason;     // byte 17
  UINT64 high_limit_price;           // bytes 18 to 25, signed, read here as unsigned
  UINT64 low_limit_price;            // bytes 26 to 33, signed, read here as unsigned
} SecurityStatusMessage;

// Message sent by the server in the Derivatives environment to inform about the status a Family of products
typedef struct _FamilyStatusMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT8 security_group[2];           // bytes 4 to 5
  UINT8 family_code[5];              // bytes 6 to 10
  UINT64 transaction_date_and_time;  // bytes 11 to 18, signed, read here as unsigned
  UINT8 security_trading_status;     // byte 19
  UINT8 non_availability_reason;     // byte 20
} FamilyStatusMessage;

// Used by the server to communicate trade information related to trades resulting from order matching in channels C/D and E/F. It is also used in channels A/B when the trade is the result of order matching at the end of an auction period (where only top-of-book information is shown)
typedef struct _TradeMarketPostTransparencyInformationTopOfBookMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 market_segment_id[4];        // bytes 16 to 19
  UINT8 trading_session_id;          // byte 20
  UINT32 trd_match_id;               // bytes 21 to 24
  UINT8 trade_type;                  // byte 25
  UINT64 last_px;                    // bytes 26 to 33, signed, read here as unsigned
  UINT32 last_qty;                   // bytes 34 to 37
  UINT64 gross_trade_amt;            // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                 // byte 46
  UINT8 market_mechanism;            // byte 47
  UINT8 algo_flag;                   // byte 48
  UINT8 transaction_category;        // byte 49
  UINT32 strategy_trd_match_id;      // bytes 50 to 53
} TradeMarketPostTransparencyInformationTopOfBookMessage;

// Sent by the server to inform about a trade produced due to any reason other than order matching, also to inform about trades produced due to order matching in a Dark pool. In this message, all fields with the suffix 2 refer to the sell order, and the ones without the suffix refer either to both legs or the buy order
typedef struct _TradeTradeAmendmentOrCancellationMessage {
  UINT32 sequence_number;                // bytes 0 to 3
  UINT32 security_code;                  // bytes 4 to 7
  UINT64 transaction_date_and_time;      // bytes 8 to 15, signed, read here as unsigned
  UINT8 market_segment_id[4];            // bytes 16 to 19
  UINT8 trading_session_id;              // byte 20
  UINT32 trd_match_id;                   // bytes 21 to 24
  UINT8 trade_type;                      // byte 25
  UINT64 last_px;                        // bytes 26 to 33, signed, read here as unsigned
  UINT32 last_qty;                       // bytes 34 to 37
  UINT64 gross_trade_amt;                // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                     // byte 46
  UINT8 market_mechanism;                // byte 47
  UINT8 algo_flag;                       // byte 48
  UINT8 transaction_category;            // byte 49
  UINT32 strategy_trd_match_id;          // bytes 50 to 53
  UINT8 last_change_flag;                // byte 54
  UINT8 benc_rfpt_flag;                  // byte 55
  UINT8 trade_price_condition;           // byte 56
  UINT8 pre_trade_transparency_waiver;   // byte 57
  UINT8 deferral_waiver;                 // byte 58
  UINT8 post_deferral_publication_type;  // byte 59
  UINT64 publish_date_and_time;          // bytes 60 to 67, signed, read here as unsigned
  UINT64 trade_date;                     // bytes 68 to 75, signed, read here as unsigned
  UINT32 trade_session_date;             // bytes 76 to 79, signed, read here as unsigned
  UINT8 amended_trade_type;              // byte 80
  UINT32 exec_ref_id;                    // bytes 81 to 84
  UINT32 amended_trade_date;             // bytes 85 to 88, signed, read here as unsigned
} TradeTradeAmendmentOrCancellationMessage;

// Used by the Server to notify an indication of interest on a specific instrument. This functionality is available in Fixed Income and Derivatives
typedef struct _IndicationOfInterestMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 ioiid;                      // bytes 16 to 19
  UINT8 ioi_trans_type;              // byte 20
  UINT8 side;                        // byte 21
  UINT32 ioi_qty;                    // bytes 22 to 25
  UINT64 ioi_price;                  // bytes 26 to 33, signed, read here as unsigned
  UINT8 ioi_qlty_ind;                // byte 34
  UINT8 trading_session_id;          // byte 35
} IndicationOfInterestMessage;

// Used by the server to communicate price information about RFQs. The contents of the RFQID field match those of the field IOIID in the corresponding Indication of Interest message
typedef struct _RfqMarketPreTransparencyInformationMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 rfqid;                      // bytes 4 to 7
  UINT8 trading_session_id;          // byte 8
  UINT32 security_code;              // bytes 9 to 12
  UINT64 transaction_date_and_time;  // bytes 13 to 20, signed, read here as unsigned
  UINT64 mid_buy_price;              // bytes 21 to 28, signed, read here as unsigned
  UINT32 mid_buy_volume;             // bytes 29 to 32
  UINT16 buy_rf_qs_number;           // bytes 33 to 34
  UINT64 mid_sell_price;             // bytes 35 to 42, signed, read here as unsigned
  UINT32 mid_sell_volume;            // bytes 43 to 46
  UINT16 sell_rf_qs_number;          // bytes 47 to 48
  UINT16 bid_orders_1;               // bytes 49 to 50
  UINT32 bid_size_1;                 // bytes 51 to 54
  UINT64 bid_px_1;                   // bytes 55 to 62, signed, read here as unsigned
  UINT16 ask_orders_1;               // bytes 63 to 64
  UINT32 ask_size_1;                 // bytes 65 to 68
  UINT64 ask_px_1;                   // bytes 69 to 76, signed, read here as unsigned
  UINT16 bid_orders_2;               // bytes 77 to 78
  UINT32 bid_size_2;                 // bytes 79 to 82
  UINT64 bid_px_2;                   // bytes 83 to 90, signed, read here as unsigned
  UINT16 ask_orders_2;               // bytes 91 to 92
  UINT32 ask_size_2;                 // bytes 93 to 96
  UINT64 ask_px_2;                   // bytes 97 to 104, signed, read here as unsigned
  UINT16 bid_orders_3;               // bytes 105 to 106
  UINT32 bid_size_3;                 // bytes 107 to 110
  UINT64 bid_px_3;                   // bytes 111 to 118, signed, read here as unsigned
  UINT16 ask_orders_3;               // bytes 119 to 120
  UINT32 ask_size_3;                 // bytes 121 to 124
  UINT64 ask_px_3;                   // bytes 125 to 132, signed, read here as unsigned
  UINT16 bid_orders_4;               // bytes 133 to 134
  UINT32 bid_size_4;                 // bytes 135 to 138
  UINT64 bid_px_4;                   // bytes 139 to 146, signed, read here as unsigned
  UINT16 ask_orders_4;               // bytes 147 to 148
  UINT32 ask_size_4;                 // bytes 149 to 152
  UINT64 ask_px_4;                   // bytes 153 to 160, signed, read here as unsigned
  UINT16 bid_orders_5;               // bytes 161 to 162
  UINT32 bid_size_5;                 // bytes 163 to 166
  UINT64 bid_px_5;                   // bytes 167 to 174, signed, read here as unsigned
  UINT16 ask_orders_5;               // bytes 175 to 176
  UINT32 ask_size_5;                 // bytes 177 to 180
  UINT64 ask_px_5;                   // bytes 181 to 188, signed, read here as unsigned
} RfqMarketPreTransparencyInformationMessage;

// Used by the UDP Servers to communicate Top-of-book price information during auctions. When there is an indicative match price, the fields BidPx1 and AskPx1 will have the same value
typedef struct _TopOfBookMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT16 bid_orders_1;               // bytes 16 to 17
  UINT32 bid_size_1;                 // bytes 18 to 21
  UINT64 bid_px_1;                   // bytes 22 to 29, signed, read here as unsigned
  UINT8 retail_cl_bid_flag_1;        // byte 30
  UINT16 ask_orders_1;               // bytes 31 to 32
  UINT32 ask_size_1;                 // bytes 33 to 36
  UINT64 ask_px_1;                   // bytes 37 to 44, signed, read here as unsigned
  UINT8 retail_cl_ask_flag_1;        // byte 45
} TopOfBookMessage;

// Used by the UDP 5 level top-of-book Servers to communicate Top-of-book price information during open market. During auctions, only the first level is shown, and therefore this message is not published, and the message Top-of-book (Msg Type = 0x82) is used instead
typedef struct _TopOfBook5LevelsMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT16 bid_orders_1;               // bytes 16 to 17
  UINT32 bid_size_1;                 // bytes 18 to 21
  UINT64 bid_px_1;                   // bytes 22 to 29, signed, read here as unsigned
  UINT8 retail_cl_bid_flag_1;        // byte 30
  UINT16 ask_orders_1;               // bytes 31 to 32
  UINT32 ask_size_1;                 // bytes 33 to 36
  UINT64 ask_px_1;                   // bytes 37 to 44, signed, read here as unsigned
  UINT8 retail_cl_ask_flag_1;        // byte 45
  UINT16 bid_orders_2;               // bytes 46 to 47
  UINT32 bid_size_2;                 // bytes 48 to 51
  UINT64 bid_px_2;                   // bytes 52 to 59, signed, read here as unsigned
  UINT8 retail_cl_bid_flag_2;        // byte 60
  UINT16 ask_orders_2;               // bytes 61 to 62
  UINT32 ask_size_2;                 // bytes 63 to 66
  UINT64 ask_px_2;                   // bytes 67 to 74, signed, read here as unsigned
  UINT8 retail_cl_ask_flag_2;        // byte 75
  UINT16 bid_orders_3;               // bytes 76 to 77
  UINT32 bid_size_3;                 // bytes 78 to 81
  UINT64 bid_px_3;                   // bytes 82 to 89, signed, read here as unsigned
  UINT8 retail_cl_bid_flag_3;        // byte 90
  UINT16 ask_orders_3;               // bytes 91 to 92
  UINT32 ask_size_3;                 // bytes 93 to 96
  UINT64 ask_px_3;                   // bytes 97 to 104, signed, read here as unsigned
  UINT8 retail_cl_ask_flag_3;        // byte 105
  UINT16 bid_orders_4;               // bytes 106 to 107
  UINT32 bid_size_4;                 // bytes 108 to 111
  UINT64 bid_px_4;                   // bytes 112 to 119, signed, read here as unsigned
  UINT8 retail_cl_bid_flag_4;        // byte 120
  UINT16 ask_orders_4;               // bytes 121 to 122
  UINT32 ask_size_4;                 // bytes 123 to 126
  UINT64 ask_px_4;                   // bytes 127 to 134, signed, read here as unsigned
  UINT8 retail_cl_ask_flag_4;        // byte 135
  UINT16 bid_orders_5;               // bytes 136 to 137
  UINT32 bid_size_5;                 // bytes 138 to 141
  UINT64 bid_px_5;                   // bytes 142 to 149, signed, read here as unsigned
  UINT8 retail_cl_bid_flag_5;        // byte 150
  UINT16 ask_orders_5;               // bytes 151 to 152
  UINT32 ask_size_5;                 // bytes 153 to 156
  UINT64 ask_px_5;                   // bytes 157 to 164, signed, read here as unsigned
  UINT8 retail_cl_ask_flag_5;        // byte 165
} TopOfBook5LevelsMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x08: LogonResponseMessage logon_response_message;
    case 0x0B: LogoutResponseMessage logout_response_message;
    case 0x30: HeartbeatMessage heartbeat_message;
    case 0x0A: NetworkStatusMessage network_status_message;
    case 0x68: TradingSessionStatusMessage trading_session_status_message;
    case 0x42: NewsMessage news_message;
    case 0x78: SecurityListCancellationReportMessage security_list_cancellation_report_message;
    case 0x84: StatisticsMessage statistics_message;
    case 0x79: SecurityListMessage security_list_message;
    case 0x80: SecurityListUpdateReportMessage security_list_update_report_message;
    case 0x66: SecurityStatusMessage security_status_message;
    case 0x89: FamilyStatusMessage family_status_message;
    case 0x10: TradeMarketPostTransparencyInformationTopOfBookMessage trade_market_post_transparency_information_top_of_book_message;
    case 0x18: TradeTradeAmendmentOrCancellationMessage trade_trade_amendment_or_cancellation_message;
    case 0x36: IndicationOfInterestMessage indication_of_interest_message;
    case 0x85: RfqMarketPreTransparencyInformationMessage rfq_market_pre_transparency_information_message;
    case 0x82: TopOfBookMessage top_of_book_message;
    case 0x83: TopOfBook5LevelsMessage top_of_book_5_levels_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Bme BmeGate Message
typedef struct _Message {
  UINT16 message_size { message_size >= 3 };                                                                                    // bytes 0 to 1
  UINT8 message_type;                                                                                                           // byte 2
  Payload(message_type, (((UINT32) message_size) - 3)) payload[:byte-size-single-element-array (((UINT32) message_size) - 3)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// A Bme binary feed carries no packet header of its own: section 2.1 states that every feed is a series of sequenced messages, each stating its own length, so a datagram holds whole messages to its end
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

