#define AMENDED_TRADE_TYPE_RFQ_X_ROLLING_DURING_AUCTION_AMENDMENT 0x39              // Rfq X Rolling During Auction Amendment

// Cancel Pre Amendment: one byte code
#define CANCEL_PRE_AMENDMENT_FALSE 0x00  // False
#define CANCEL_PRE_AMENDMENT_TRUE 0x01   // True

// Risk Reduction: one byte code
#define RISK_REDUCTION_FALSE 0x00  // False
#define RISK_REDUCTION_TRUE 0x01   // True

// Algorithmic Trade Indicator 2: one byte code
#define ALGORITHMIC_TRADE_INDICATOR_2_FALSE 0x00  // False
#define ALGORITHMIC_TRADE_INDICATOR_2_TRUE 0x01   // True

// Dea Flag 2: one byte code
#define DEA_FLAG_2_FALSE 0x00  // False
#define DEA_FLAG_2_TRUE 0x01   // True

// Liquidity Provision Activity 2: one byte code
#define LIQUIDITY_PROVISION_ACTIVITY_2_FALSE 0x00  // False
#define LIQUIDITY_PROVISION_ACTIVITY_2_TRUE 0x01   // True

// Last Capacity 2: one byte code
#define LAST_CAPACITY_2_DEALING_ON_OWN_ACCOUNT 0x44             // Dealing On Own Account
#define LAST_CAPACITY_2_MATCHED_PRINCIPAL 0x4D                  // Matched Principal
#define LAST_CAPACITY_2_ANY_OTHER_TRADING_CAPACITY_BLANCO 0x41  // Any Other Trading Capacity Blanco

// Persistence 2: one byte code
#define PERSISTENCE_2_CANCEL_ON_DISCONNECTION 0x43   // Cancel On Disconnection
#define PERSISTENCE_2_PERSIST_ON_DISCONNECTION 0x50  // Persist On Disconnection

// Self Match Prevention Type 2: one byte code
#define SELF_MATCH_PREVENTION_TYPE_2_NA_OR_DEFAULT_BEHAVIOUR_AGGRESSIVE_ORDER_IS_REJECTED 0x20  // Na Or Default Behaviour Aggressive Order Is Rejected
#define SELF_MATCH_PREVENTION_TYPE_2_REJECT_AGGRESSIVE_ORDER 0x31                               // Reject Aggressive Order
#define SELF_MATCH_PREVENTION_TYPE_2_CANCEL_PASIVE_ORDER 0x32                                   // Cancel Pasive Order
#define SELF_MATCH_PREVENTION_TYPE_2_CANCEL_BOTH_PASSIVE_AND_AGGRESSIVE_ORDER 0x33              // Cancel Both Passive And Aggressive Order
#define SELF_MATCH_PREVENTION_TYPE_2_NO_ORDER_CANCELLED 0x34                                    // No Order Cancelled

// Risk Reduction 2: one byte code
#define RISK_REDUCTION_2_FALSE 0x00  // False
#define RISK_REDUCTION_2_TRUE 0x01   // True

// ---- Types -------------------------------------------------------------------

// The Logon Response message is used by the Server to accept a new session. In this message the sequence number will always be 0
typedef struct _LogonResponseMessage {
  UINT32 sequence_number;           // bytes 0 to 3
  UINT8 heart_bt_int;               // byte 4
  UINT8 protocol_version[6];        // bytes 5 to 10
  UINT8 test_production_ind;        // byte 11
  UINT8 environment_code[2];        // bytes 12 to 13
  UINT32 session_date;              // bytes 14 to 17, signed, read here as unsigned
  UINT32 expected_sequence_number;  // bytes 18 to 21
  UINT32 sequence_number_to;        // bytes 22 to 25
} LogonResponseMessage;

// The Logout message is used by the Server to notify the end of a session, whether it is solicited or unsolicited. It may also be the answer to a failed logon attempt (see Logon message)
typedef struct _LogoutResponseMessage {
  UINT32 sequence_number;  // bytes 0 to 3
  UINT8 logout_reason;     // byte 4
} LogoutResponseMessage;

// The Heartbeat message is used by the Server to indicate that the communication is active. In the Heartbeat message, the SequenceNumber of the previously received message will be repeated
typedef struct _HeartbeatMessage {
  UINT32 sequence_number;  // bytes 0 to 3
} HeartbeatMessage;

// Message sent by the server with information about the connectivity between the Server and the central systems. In the Network Status message, the SequenceNumber of the previously received message will be repeated
typedef struct _NetworkStatusMessage {
  UINT32 sequence_number;      // bytes 0 to 3
  UINT8 network_status_value;  // byte 4
} NetworkStatusMessage;

// The Logon message is used to start a session by the client application
typedef struct _LogonMessage {
  UINT8 username[7];                // bytes 0 to 6
  UINT8 password[10];               // bytes 7 to 16
  UINT8 software_name[25];          // bytes 17 to 41
  UINT32 expected_sequence_number;  // bytes 42 to 45
  UINT8 subscriptions;              // byte 46
  UINT8 protocol_version[6];        // bytes 47 to 52
} LogonMessage;

// It may be sent by the server to inform about the rejection of an unsupported or syntactically incorrect message. In the Reject message, the SequenceNumber of the previously received message will be repeated
typedef struct _RejectMessage {
  UINT32 sequence_number;           // bytes 0 to 3
  UINT8 session_reject_reason;      // byte 4
  UINT8 text_c_58[58];              // bytes 5 to 62
  UINT8 msg_rejected_reference[7];  // bytes 63 to 69
} RejectMessage;

// Sent by the server to inform about the session status in each Trading Mode
typedef struct _TradingSessionStatusMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT8 trading_session_id;          // byte 4
  UINT8 trading_session_sub_id;      // byte 5
  UINT8 trad_ses_status;             // byte 6
  UINT64 transaction_date_and_time;  // bytes 7 to 14, signed, read here as unsigned
} TradingSessionStatusMessage;

// Used by the Server to communicate a Market Surveillance or system-wide text message
typedef struct _NewsMessage {
  UINT32 sequence_number;  // bytes 0 to 3
  UINT8 news_text[78];     // bytes 4 to 81
} NewsMessage;

// Message sent by the server for cancelling previously defined securities
typedef struct _SecurityListCancellationReportMessage {
  UINT32 sequence_number;      // bytes 0 to 3
  UINT8 market_id[4];          // bytes 4 to 7
  UINT8 market_segment_id[4];  // bytes 8 to 11
  UINT32 security_code;        // bytes 12 to 15
  UINT8 symbol[22];            // bytes 16 to 37
  UINT8 symbol_isin[12];       // bytes 38 to 49
} SecurityListCancellationReportMessage;

// Repeating group of the Statistics message, one entry per data value, DataCount entries
typedef struct _StatisticsRepeatingGroup {
  UINT8 data_code;    // byte 0
  UINT64 data_value;  // bytes 1 to 8, signed, read here as unsigned
} StatisticsRepeatingGroup;

// Message sent by the server to inform about closing prices and other statistics
typedef struct _StatisticsMessage {
  UINT32 sequence_number;                                                                       // bytes 0 to 3
  UINT32 security_code;                                                                         // bytes 4 to 7
  UINT64 transaction_date_and_time;                                                             // bytes 8 to 15, signed, read here as unsigned
  UINT8 data_count;                                                                             // byte 16
  StatisticsRepeatingGroup statistics_repeating_group[:byte-size (((UINT32) data_count) * 9)];
} StatisticsMessage;

// Message sent by the server to provide the definition of one security. It shares the same layout as the Security List Update Report message, but with a different Message Type
typedef struct _SecurityListMessage {
  UINT32 sequence_number;                       // bytes 0 to 3
  UINT8 market_id[4];                           // bytes 4 to 7
  UINT8 market_segment_id[4];                   // bytes 8 to 11
  UINT32 security_code;                         // bytes 12 to 15
  UINT8 symbol[22];                             // bytes 16 to 37
  UINT8 symbol_isin[12];                        // bytes 38 to 49
  UINT8 fisn[35];                               // bytes 50 to 84
  UINT8 issuer_lei[20];                         // bytes 85 to 104
  UINT8 security_group[2];                      // bytes 105 to 106
  UINT8 family_code[5];                         // bytes 107 to 111
  UINT8 cfi_code[6];                            // bytes 112 to 117
  UINT8 security_type[2];                       // bytes 118 to 119
  UINT32 maturity_date;                         // bytes 120 to 123, signed, read here as unsigned
  UINT32 issue_date;                            // bytes 124 to 127, signed, read here as unsigned
  UINT64 contract_multiplier;                   // bytes 128 to 135, signed, read here as unsigned
  UINT64 li_spre;                               // bytes 136 to 143, signed, read here as unsigned
  UINT64 sst_ipre;                              // bytes 144 to 151, signed, read here as unsigned
  UINT64 li_spost;                              // bytes 152 to 159, signed, read here as unsigned
  UINT64 sst_ipost;                             // bytes 160 to 167, signed, read here as unsigned
  UINT8 liquid_instrument;                      // byte 168
  UINT8 admission_requested_by_issuer;          // byte 169
  UINT32 min_trade_vol;                         // bytes 170 to 173
  UINT32 round_lot;                             // bytes 174 to 177
  UINT8 currency[3];                            // bytes 178 to 180
  UINT32 modality_mask_b_4;                     // bytes 181 to 184
  UINT8 security_description[80];               // bytes 185 to 264
  UINT8 trading_obligation;                     // byte 265
  UINT8 sec_description[20];                    // bytes 266 to 285
  UINT8 underlying_asset[22];                   // bytes 286 to 307
  UINT8 security_sub_type[12];                  // bytes 308 to 319
  UINT8 maturity_month_year[8];                 // bytes 320 to 327
  UINT64 strike_price;                          // bytes 328 to 335, signed, read here as unsigned
  UINT64 strike_value;                          // bytes 336 to 343, signed, read here as unsigned
  UINT8 opt_attribute;                          // byte 344
  UINT64 min_price_increment;                   // bytes 345 to 352, signed, read here as unsigned
  UINT8 unit_of_measure[20];                    // bytes 353 to 372
  UINT8 settl_method;                           // byte 373
  UINT8 exercise_style;                         // byte 374
  UINT8 put_or_call;                            // byte 375
  UINT8 flexible_indicator;                     // byte 376
  UINT32 last_trading_day;                      // bytes 377 to 380, signed, read here as unsigned
  UINT8 number_of_decimals;                     // byte 381
  UINT8 order_number_of_decimals;               // byte 382
  UINT8 adjustments_rule;                       // byte 383
  UINT64 maximum_order_size;                    // bytes 384 to 391, signed, read here as unsigned
  UINT8 self_match_prevention;                  // byte 392
  UINT8 commodity_derivative_indicator;         // byte 393
  UINT8 stock_when_underlying_is_dividend[22];  // bytes 394 to 415
  UINT8 base_product[4];                        // bytes 416 to 419
  UINT8 sub_product[4];                         // bytes 420 to 423
  UINT8 further_sub_product[4];                 // bytes 424 to 427
  UINT8 base_currency[3];                       // bytes 428 to 430
  UINT8 quoted_currency[3];                     // bytes 431 to 433
  UINT8 maturity_month_year_increment_units;    // byte 434
  UINT8 start_maturity_month_year[8];           // bytes 435 to 442
  UINT8 end_maturity_month_year[8];             // bytes 443 to 450
  UINT8 maturity_month_year_increment;          // byte 451
  UINT8 underlying_symbol[22];                  // bytes 452 to 473
  UINT8 underlying_isin[12];                    // bytes 474 to 485
  UINT8 underlying_currency[3];                 // bytes 486 to 488
  UINT8 underlying_security_issuer_lei[20];     // bytes 489 to 508
  UINT8 x_rolling_closing_type;                 // byte 509
  UINT8 x_rolling_reference_buyer_rate;         // byte 510
  UINT64 x_rolling_buyer_markup;                // bytes 511 to 518, signed, read here as unsigned
  UINT8 x_rolling_reference_seller_rate;        // byte 519
  UINT64 x_rolling_seller_markup;               // bytes 520 to 527, signed, read here as unsigned
  UINT64 x_rolling_dividend_percentage;         // bytes 528 to 535, signed, read here as unsigned
  UINT16 x_rolling_dividend_pay_date_diff;      // bytes 536 to 537
  UINT8 leg_symbol_1[22];                       // bytes 538 to 559
  UINT32 leg_ratio_qty_1;                       // bytes 560 to 563
  UINT8 leg_side_1;                             // byte 564
  UINT64 leg_price_1;                           // bytes 565 to 572, signed, read here as unsigned
  UINT8 leg_symbol_2[22];                       // bytes 573 to 594
  UINT32 leg_ratio_qty_2;                       // bytes 595 to 598
  UINT8 leg_side_2;                             // byte 599
  UINT64 leg_price_2;                           // bytes 600 to 607, signed, read here as unsigned
  UINT8 leg_symbol_3[22];                       // bytes 608 to 629
  UINT32 leg_ratio_qty_3;                       // bytes 630 to 633
  UINT8 leg_side_3;                             // byte 634
  UINT64 leg_price_3;                           // bytes 635 to 642, signed, read here as unsigned
  UINT8 leg_symbol_4[22];                       // bytes 643 to 664
  UINT32 leg_ratio_qty_4;                       // bytes 665 to 668
  UINT8 leg_side_4;                             // byte 669
  UINT64 leg_price_4;                           // bytes 670 to 677, signed, read here as unsigned
  UINT8 leg_symbol_5[22];                       // bytes 678 to 699
  UINT32 leg_ratio_qty_5;                       // bytes 700 to 703
  UINT8 leg_side_5;                             // byte 704
  UINT64 leg_price_5;                           // bytes 705 to 712, signed, read here as unsigned
} SecurityListMessage;

// Message sent by the server for reporting updates, during the session, to the security definition
typedef struct _SecurityListUpdateReportMessage {
  UINT32 sequence_number;                       // bytes 0 to 3
  UINT8 market_id[4];                           // bytes 4 to 7
  UINT8 market_segment_id[4];                   // bytes 8 to 11
  UINT32 security_code;                         // bytes 12 to 15
  UINT8 symbol[22];                             // bytes 16 to 37
  UINT8 symbol_isin[12];                        // bytes 38 to 49
  UINT8 fisn[35];                               // bytes 50 to 84
  UINT8 issuer_lei[20];                         // bytes 85 to 104
  UINT8 security_group[2];                      // bytes 105 to 106
  UINT8 family_code[5];                         // bytes 107 to 111
  UINT8 cfi_code[6];                            // bytes 112 to 117
  UINT8 security_type[2];                       // bytes 118 to 119
  UINT32 maturity_date;                         // bytes 120 to 123, signed, read here as unsigned
  UINT32 issue_date;                            // bytes 124 to 127, signed, read here as unsigned
  UINT64 contract_multiplier;                   // bytes 128 to 135, signed, read here as unsigned
  UINT64 li_spre;                               // bytes 136 to 143, signed, read here as unsigned
  UINT64 sst_ipre;                              // bytes 144 to 151, signed, read here as unsigned
  UINT64 li_spost;                              // bytes 152 to 159, signed, read here as unsigned
  UINT64 sst_ipost;                             // bytes 160 to 167, signed, read here as unsigned
  UINT8 liquid_instrument;                      // byte 168
  UINT8 admission_requested_by_issuer;          // byte 169
  UINT32 min_trade_vol;                         // bytes 170 to 173
  UINT32 round_lot;                             // bytes 174 to 177
  UINT8 currency[3];                            // bytes 178 to 180
  UINT32 modality_mask_b_4;                     // bytes 181 to 184
  UINT8 security_description[80];               // bytes 185 to 264
  UINT8 trading_obligation;                     // byte 265
  UINT8 sec_description[20];                    // bytes 266 to 285
  UINT8 underlying_asset[22];                   // bytes 286 to 307
  UINT8 security_sub_type[12];                  // bytes 308 to 319
  UINT8 maturity_month_year[8];                 // bytes 320 to 327
  UINT64 strike_price;                          // bytes 328 to 335, signed, read here as unsigned
  UINT64 strike_value;                          // bytes 336 to 343, signed, read here as unsigned
  UINT8 opt_attribute;                          // byte 344
  UINT64 min_price_increment;                   // bytes 345 to 352, signed, read here as unsigned
  UINT8 unit_of_measure[20];                    // bytes 353 to 372
  UINT8 settl_method;                           // byte 373
  UINT8 exercise_style;                         // byte 374
  UINT8 put_or_call;                            // byte 375
  UINT8 flexible_indicator;                     // byte 376
  UINT32 last_trading_day;                      // bytes 377 to 380, signed, read here as unsigned
  UINT8 number_of_decimals;                     // byte 381
  UINT8 order_number_of_decimals;               // byte 382
  UINT8 adjustments_rule;                       // byte 383
  UINT64 maximum_order_size;                    // bytes 384 to 391, signed, read here as unsigned
  UINT8 self_match_prevention;                  // byte 392
  UINT8 commodity_derivative_indicator;         // byte 393
  UINT8 stock_when_underlying_is_dividend[22];  // bytes 394 to 415
  UINT8 base_product[4];                        // bytes 416 to 419
  UINT8 sub_product[4];                         // bytes 420 to 423
  UINT8 further_sub_product[4];                 // bytes 424 to 427
  UINT8 base_currency[3];                       // bytes 428 to 430
  UINT8 quoted_currency[3];                     // bytes 431 to 433
  UINT8 maturity_month_year_increment_units;    // byte 434
  UINT8 start_maturity_month_year[8];           // bytes 435 to 442
  UINT8 end_maturity_month_year[8];             // bytes 443 to 450
  UINT8 maturity_month_year_increment;          // byte 451
  UINT8 underlying_symbol[22];                  // bytes 452 to 473
  UINT8 underlying_isin[12];                    // bytes 474 to 485
  UINT8 underlying_currency[3];                 // bytes 486 to 488
  UINT8 underlying_security_issuer_lei[20];     // bytes 489 to 508
  UINT8 x_rolling_closing_type;                 // byte 509
  UINT8 x_rolling_reference_buyer_rate;         // byte 510
  UINT64 x_rolling_buyer_markup;                // bytes 511 to 518, signed, read here as unsigned
  UINT8 x_rolling_reference_seller_rate;        // byte 519
  UINT64 x_rolling_seller_markup;               // bytes 520 to 527, signed, read here as unsigned
  UINT64 x_rolling_dividend_percentage;         // bytes 528 to 535, signed, read here as unsigned
  UINT16 x_rolling_dividend_pay_date_diff;      // bytes 536 to 537
  UINT8 leg_symbol_1[22];                       // bytes 538 to 559
  UINT32 leg_ratio_qty_1;                       // bytes 560 to 563
  UINT8 leg_side_1;                             // byte 564
  UINT64 leg_price_1;                           // bytes 565 to 572, signed, read here as unsigned
