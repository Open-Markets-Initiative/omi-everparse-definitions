// ---- Rfq Market Pre Transparency Information Message: 189 bytes --------------

// Used by the server to communicate price information about RFQs. The contents of the RFQID field match those of the field IOIID in the corresponding Indication of Interest message
entrypoint typedef struct _RfqMarketPreTransparencyInformationMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 rfqid;                      // bytes 4 to 7
  UINT8 trading_session_id;          // byte 8
  UINT32 security_code;              // bytes 9 to 12
  UINT64 transaction_date_and_time;  // bytes 13 to 20, signed, read here as unsigned
  UINT64 mid_buy_price;              // bytes 21 to 28, signed, read here as unsigned
  UINT32 mid_buy_volume;             // bytes 29 to 32
  UINT16 buy_rf_qs_number;           // bytes 33 to 34
  UINT64 mid_sell_price;             // bytes 35 to 42, signed, read here as unsigned
  UINT32 mid_sell_volume;            // bytes 43 to 46
  UINT16 sell_rf_qs_number;          // bytes 47 to 48
  UINT16 bid_orders_1;               // bytes 49 to 50
  UINT32 bid_size_1;                 // bytes 51 to 54
  UINT64 bid_px_1;                   // bytes 55 to 62, signed, read here as unsigned
  UINT16 ask_orders_1;               // bytes 63 to 64
  UINT32 ask_size_1;                 // bytes 65 to 68
  UINT64 ask_px_1;                   // bytes 69 to 76, signed, read here as unsigned
  UINT16 bid_orders_2;               // bytes 77 to 78
  UINT32 bid_size_2;                 // bytes 79 to 82
  UINT64 bid_px_2;                   // bytes 83 to 90, signed, read here as unsigned
  UINT16 ask_orders_2;               // bytes 91 to 92
  UINT32 ask_size_2;                 // bytes 93 to 96
  UINT64 ask_px_2;                   // bytes 97 to 104, signed, read here as unsigned
  UINT16 bid_orders_3;               // bytes 105 to 106
  UINT32 bid_size_3;                 // bytes 107 to 110
  UINT64 bid_px_3;                   // bytes 111 to 118, signed, read here as unsigned
  UINT16 ask_orders_3;               // bytes 119 to 120
  UINT32 ask_size_3;                 // bytes 121 to 124
  UINT64 ask_px_3;                   // bytes 125 to 132, signed, read here as unsigned
  UINT16 bid_orders_4;               // bytes 133 to 134
  UINT32 bid_size_4;                 // bytes 135 to 138
  UINT64 bid_px_4;                   // bytes 139 to 146, signed, read here as unsigned
  UINT16 ask_orders_4;               // bytes 147 to 148
  UINT32 ask_size_4;                 // bytes 149 to 152
  UINT64 ask_px_4;                   // bytes 153 to 160, signed, read here as unsigned
  UINT16 bid_orders_5;               // bytes 161 to 162
  UINT32 bid_size_5;                 // bytes 163 to 166
  UINT64 bid_px_5;                   // bytes 167 to 174, signed, read here as unsigned
  UINT16 ask_orders_5;               // bytes 175 to 176
  UINT32 ask_size_5;                 // bytes 177 to 180
  UINT64 ask_px_5;                   // bytes 181 to 188, signed, read here as unsigned
} RfqMarketPreTransparencyInformationMessage;

// ---- Top Of Book Message: 46 bytes -------------------------------------------

// Used by the UDP Servers to communicate Top-of-book price information during auctions. When there is an indicative match price, the fields BidPx1 and AskPx1 will have the same value
entrypoint typedef struct _TopOfBookMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT16 bid_orders_1;               // bytes 16 to 17
  UINT32 bid_size_1;                 // bytes 18 to 21
  UINT64 bid_px_1;                   // bytes 22 to 29, signed, read here as unsigned
  UINT8 retail_cl_bid_flag_1;        // byte 30
  UINT16 ask_orders_1;               // bytes 31 to 32
  UINT32 ask_size_1;                 // bytes 33 to 36
  UINT64 ask_px_1;                   // bytes 37 to 44, signed, read here as unsigned
  UINT8 retail_cl_ask_flag_1;        // byte 45
} TopOfBookMessage;

