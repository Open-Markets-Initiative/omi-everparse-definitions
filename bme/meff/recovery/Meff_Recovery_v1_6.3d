  UINT64 low_limit_price;            // bytes 26 to 33, signed, read here as unsigned
} SecurityStatusMessage;

// ---- Family Status Message: 21 bytes -----------------------------------------

// Message sent by the server in the Derivatives environment to inform about the status a Family of products
entrypoint typedef struct _FamilyStatusMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT8 security_group[2];           // bytes 4 to 5
  UINT8 family_code[5];              // bytes 6 to 10
  UINT64 transaction_date_and_time;  // bytes 11 to 18, signed, read here as unsigned
  UINT8 security_trading_status;     // byte 19
  UINT8 non_availability_reason;     // byte 20
} FamilyStatusMessage;

// ---- Order Book Clear Message: 16 bytes --------------------------------------

// Message sent by the UDP full-depth server whenever the information about order prices must be reset. In particular, it is sent by the server when the trading mode changes from auction to open market and vice versa
entrypoint typedef struct _OrderBookClearMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
} OrderBookClearMessage;

// ---- Order Market Pre Transparency Information Message: 42 bytes -------------

// Used by the Server to communicate information about all active visible orders. During a session, any order is uniquely identified by the SecondaryOrderID
entrypoint typedef struct _OrderMarketPreTransparencyInformationMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
