#define TIME_IN_FORCE_IMMEDIATE_OR_CANCEL_I_O_C 0x33  // Immediate Or Cancel IOC
#define TIME_IN_FORCE_FILL_OR_KILL_F_O_K 0x34         // Fill Or Kill FOK

// Cancellation Type: one byte code
#define CANCELLATION_TYPE_STANDARD 0x53  // Standard
#define CANCELLATION_TYPE_PANIC 0x50     // Panic

// Order Or Quote Cancel: one byte code
#define ORDER_OR_QUOTE_CANCEL_ORDERS_ONLY 0x4E                           // Orders Only
#define ORDER_OR_QUOTE_CANCEL_QUOTES_ONLY 0x51                           // Quotes Only
#define ORDER_OR_QUOTE_CANCEL_TOTAL_CANCELLATION_ORDERS_AND_QUOTES 0x54  // Total Cancellation Orders And Quotes

// Status: one byte code
#define STATUS_FALSE 0x00  // False
#define STATUS_TRUE 0x01   // True

// Ord Status: one byte code
#define ORD_STATUS_PENDING_NO_VOLUME_FILLED 0x30              // Pending No Volume Filled
#define ORD_STATUS_REJECTED 0x38                              // Rejected
#define ORD_STATUS_PARCIALLY_FILLED 0x31                      // Parcially Filled
#define ORD_STATUS_TOTALLY_FILLED 0x32                        // Totally Filled
#define ORD_STATUS_CANCELLED_NOT_FILLED 0x34                  // Cancelled Not Filled
#define ORD_STATUS_CANCELLED_PARTIALLY_FILLED 0x50            // Cancelled Partially Filled
#define ORD_STATUS_NON_WORKING_ORDER_PENDING_VALIDATION 0x41  // Non Working Order Pending Validation
#define ORD_STATUS_NON_WORKING_ORDER_PENDING_ACTIVATION 0x53  // Non Working Order Pending Activation
#define ORD_STATUS_EXPIRED 0x43                               // Expired

// Ord Rej Reason: one byte code
#define ORD_REJ_REASON_BY_TRADER 0x31                                                       // By Trader
#define ORD_REJ_REASON_BY_SUPERVISOR 0x33                                                   // By Supervisor
#define ORD_REJ_REASON_VOLUME_MODIFICATION_INCORRECT_NEW_VOLUME_TOTAL_VOLUME_FILLED 0x34    // Volume Modification Incorrect New Volume Total Volume Filled
#define ORD_REJ_REASON_NOT_EXECUTED_IMMEDIATELY 0x35                                        // Not Executed Immediately
#define ORD_REJ_REASON_SECURITY_NOT_CURRENT_OR_NOT_TRADEABLE_FOR_THIS_MEMBER 0x36           // Security Not Current Or Not Tradeable For This Member
#define ORD_REJ_REASON_BY_LIMITS 0x37                                                       // By Limits
#define ORD_REJ_REASON_CANCELLED_BY_MARKET_STATUS 0x38                                      // Cancelled By Market Status
#define ORD_REJ_REASON_INVALID_DATA 0x39                                                    // Invalid Data
#define ORD_REJ_REASON_DISCONNECTION_OF_THE_CLIENT_APPLICATION 0x45                         // Disconnection Of The Client Application
#define ORD_REJ_REASON_QUOTE_PARAMETERS_MISSING 0x46                                        // Quote Parameters Missing
#define ORD_REJ_REASON_BY_PERMISSIONS 0x47                                                  // By Permissions
#define ORD_REJ_REASON_QUOTE_OR_CL_ORD_ID_INCORRECT 0x48                                    // Quote Or Cl Ord Id Incorrect
#define ORD_REJ_REASON_QUOTE_CANCELLED_BY_SUBSTITUTION 0x51                                 // Quote Cancelled By Substitution
#define ORD_REJ_REASON_BY_END_OF_VALIDITY_OF_THE_ORDER 0x58                                 // By End Of Validity Of The Order
#define ORD_REJ_REASON_OTHER 0x5A                                                           // Other
#define ORD_REJ_REASON_BY_MINIMUM_TRADING_VOLUME 0x62                                       // By Minimum Trading Volume
#define ORD_REJ_REASON_PRICE_NOT_ACCORDING_TO_THE_SIZE_TYPOLOGY 0x63                        // Price Not According To The Size Typology
#define ORD_REJ_REASON_THE_ORDER_VOLUMEMUST_BE_A_MULTIPLE_OF_THE_TRADING_LOT_SIZE 0x64      // The Order Volumemust Be A Multiple Of The Trading Lot Size
#define ORD_REJ_REASON_INCORRECT_PRICE 0x67                                                 // Incorrect Price
#define ORD_REJ_REASON_INCORRECT_VOLUME 0x68                                                // Incorrect Volume
#define ORD_REJ_REASON_INCORRECT_DATE 0x69                                                  // Incorrect Date
#define ORD_REJ_REASON_BY_CONTRACT_STATUS 0x6B                                              // By Contract Status
#define ORD_REJ_REASON_BY_SELF_MATCH_PREVENTION 0x6F                                        // By Self Match Prevention
#define ORD_REJ_REASON_INVALID_ORK_FIELDS 0x78                                              // Invalid Ork Fields
#define ORD_REJ_REASON_PRIORITY_CHANGE_DUE_TO_CHANGE_IN_PRICE 0x4C                          // Priority Change Due To Change In Price
#define ORD_REJ_REASON_PRIORITY_CHANGE_DUE_TO_VOLUME_INCREASE 0x4D                          // Priority Change Due To Volume Increase
#define ORD_REJ_REASON_PRIORITY_CHANGE_DUE_TO_NEW_CLIENT_ACCOUNT_CAPACITY 0x4E              // Priority Change Due To New Client Account Capacity
#define ORD_REJ_REASON_PRIORITY_CHANGE_DUE_TO_BOTH_PRICE_CHANGE_AND_VOLUME_INCREASE 0x50    // Priority Change Due To Both Price Change And Volume Increase
#define ORD_REJ_REASON_PRIORITY_CHANGE_DUE_TO_BOTH_PRICE_AND_CLIENT_ACCOUNT 0x52            // Priority Change Due To Both Price And Client Account
#define ORD_REJ_REASON_PRIORITY_CHANGE_DUE_TO_BOTH_VOLUME_INCREASE_AND_CLIENT_ACCOUNT 0x53  // Priority Change Due To Both Volume Increase And Client Account
#define ORD_REJ_REASON_MODIFICATION_WITHOUT_PRIORITY_CHANGE 0x54                            // Modification Without Priority Change
#define ORD_REJ_REASON_STOP_ORDER_TRIGGERED_AT_THE_CLOSE_ORDER_ACTIVATION 0x55              // Stop Order Triggered At The Close Order Activation
#define ORD_REJ_REASON_NOT_A_MEMBER_OF_PIT 0x56                                             // Not A Member Of Pit
#define ORD_REJ_REASON_NEW_VOLUME_SHOWN 0x59                                                // New Volume Shown
#define ORD_REJ_REASON_NOT_EXECUTED_DUE_TO_EXCEDED_VOLUME_CAP 0x71                          // Not Executed Due To Exceded Volume Cap

