  UINT64 gross_trade_amt;            // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                 // byte 46
  UINT8 market_mechanism;            // byte 47
  UINT8 algo_flag;                   // byte 48
  UINT64 alt_last_px;                // bytes 49 to 56, signed, read here as unsigned
  UINT64 accrued_interest_amt;       // bytes 57 to 64, signed, read here as unsigned
  UINT64 accrued_interest_rate_p_8;  // bytes 65 to 72, signed, read here as unsigned
  UINT32 settl_date;                 // bytes 73 to 76, signed, read here as unsigned
  UINT8 transaction_category;        // byte 77
  UINT32 secondary_order_id;         // bytes 78 to 81
  UINT32 entry_date;                 // bytes 82 to 85, signed, read here as unsigned
  UINT32 priority;                   // bytes 86 to 89
  UINT64 price;                      // bytes 90 to 97, signed, read here as unsigned
  UINT32 display_qty;                // bytes 98 to 101
  UINT64 alt_price;                  // bytes 102 to 109, signed, read here as unsigned
  UINT32 secondary_order_id_2;       // bytes 110 to 113
  UINT32 entry_date_2;               // bytes 114 to 117, signed, read here as unsigned
  UINT32 priority_2;                 // bytes 118 to 121
  UINT64 price_2;                    // bytes 122 to 129, signed, read here as unsigned
  UINT32 display_qty_2;              // bytes 130 to 133
  UINT64 alt_price_2;                // bytes 134 to 141, signed, read here as unsigned
  UINT32 order_id_2;                 // bytes 142 to 145
  UINT32 secondary_exec_id_2;        // bytes 146 to 149
  UINT32 order_qty_2;                // bytes 150 to 153
  UINT8 ord_status_2;                // byte 154
  UINT8 ccp_code_2;                  // byte 155
  UINT8 aggressor_indicator_2;       // byte 156
  UINT32 request_id_2;               // bytes 157 to 160
  UINT16 client_data_id_2;           // bytes 161 to 162
} ExecutionPrivateInformation1LegSellMarketOrderMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x08: LogonResponseMessage logon_response_message;
    case 0x0B: LogoutResponseMessage logout_response_message;
    case 0x30: HeartbeatMessage heartbeat_message;
    case 0x0A: NetworkStatusMessage network_status_message;
    case 0x41: LogonMessage logon_message;
    case 0x35: unit logout_message;
    case 0x0D: RejectMessage reject_message;
    case 0x68: TradingSessionStatusMessage trading_session_status_message;
    case 0x42: NewsMessage news_message;
    case 0x78: SecurityListCancellationReportMessage security_list_cancellation_report_message;
    case 0x84: StatisticsMessage statistics_message;
    case 0x79: SecurityListMessage security_list_message;
    case 0x80: SecurityListUpdateReportMessage security_list_update_report_message;
    case 0x66: SecurityStatusMessage security_status_message;
    case 0x81: OrderBookClearMessage order_book_clear_message;
    case 0x03: OrderMarketPreTransparencyInformationMessage order_market_pre_transparency_information_message;
    case 0x07: QuoteMarketPreTransparencyInformationMessage quote_market_pre_transparency_information_message;
    case 0x01: OrderCancellationMarketMemberMessage order_cancellation_market_member_message;
    case 0x05: QuoteCancellationMarketMemberMessage quote_cancellation_market_member_message;
    case 0x10: TradeMarketPostTransparencyInformationTopOfBookMessage trade_market_post_transparency_information_top_of_book_message;
    case 0x18: TradeTradeAmendmentOrCancellationMessage trade_trade_amendment_or_cancellation_message;
    case 0x11: TradeMarketPostTransparencyInformationFullDepthMessage trade_market_post_transparency_information_full_depth_message;
    case 0x36: IndicationOfInterestMessage indication_of_interest_message;
    case 0x85: RfqMarketPreTransparencyInformationMessage rfq_market_pre_transparency_information_message;
    case 0x82: TopOfBookMessage top_of_book_message;
    case 0x6F: OrderAndQuoteClientDataMessage order_and_quote_client_data_message;
    case 0x44: SimpleNewOrderMessage simple_new_order_message;
    case 0x45: SimpleNewOrderWithClientDataMessage simple_new_order_with_client_data_message;
    case 0x47: SimpleOrderModificationMessage simple_order_modification_message;
    case 0x48: SimpleOrderModificationWithClientDataMessage simple_order_modification_with_client_data_message;
    case 0x46: OrderCancellationRequestMessage order_cancellation_request_message;
    case 0x53: NewQuoteMessage new_quote_message;
    case 0x61: QuoteModificationRequestMessage quote_modification_request_message;
    case 0x5A: QuoteCancellationRequestMessage quote_cancellation_request_message;
    case 0x71: MassOrderquoteCancellationMessage mass_orderquote_cancellation_message;
    case 0x87: OrderAndQuoteClientDataParametersAckNackMessage order_and_quote_client_data_parameters_ack_nack_message;
    case 0x02: SimpleOrderStatusMessage simple_order_status_message;
    case 0x06: QuoteStatusMessage quote_status_message;
    case 0x39: OrderCancelRejectMessage order_cancel_reject_message;
    case 0x72: MassOrderquoteCancellationCompletionMessage mass_orderquote_cancellation_completion_message;
    case 0x73: MassOrderquoteCancellationRejectMessage mass_orderquote_cancellation_reject_message;
    case 0x6A: BusinessMessageRejectMessage business_message_reject_message;
    case 0x17: ExecutionPrivateInformation2LegsMessage execution_private_information_2_legs_message;
    case 0x1A: TradeTradeAmendmentOrCancellation1LegBuyPrivateInformatio_lt8bv1 trade_trade_amendment_or_cancellation_1_leg_buy_private_information_message;
    case 0x1C: TradeTradeAmendmentOrCancellation1LegSellPrivateInformati_tynsxv trade_trade_amendment_or_cancellation_1_leg_sell_private_information_message;
    case 0x1E: TradeTradeAmendmentOrCancellation2LegsPrivateInformationMessage trade_trade_amendment_or_cancellation_2_legs_private_information_message;
    case 0x13: ExecutionPrivateInformation1LegBuyMarketOrderMessage execution_private_information_1_leg_buy_market_order_message;
    case 0x15: ExecutionPrivateInformation1LegSellMarketOrderMessage execution_private_information_1_leg_sell_market_order_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Bme BmeGate Message
typedef struct _Message {
  UINT16 message_size { message_size >= 3 };                                                                                    // bytes 0 to 1
  UINT8 message_type;                                                                                                           // byte 2
  Payload(message_type, (((UINT32) message_size) - 3)) payload[:byte-size-single-element-array (((UINT32) message_size) - 3)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// A Bme binary feed carries no packet header of its own: section 2.1 states that every feed is a series of sequenced messages, each stating its own length, so a segment holds whole messages to its end
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

