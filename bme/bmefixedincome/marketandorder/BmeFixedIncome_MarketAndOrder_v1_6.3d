#define LAST_CAPACITY_2_DEALING_ON_OWN_ACCOUNT 0x44             // Dealing On Own Account
#define LAST_CAPACITY_2_MATCHED_PRINCIPAL 0x4D                  // Matched Principal
#define LAST_CAPACITY_2_ANY_OTHER_TRADING_CAPACITY_BLANCO 0x41  // Any Other Trading Capacity Blanco

// Received Dept Id 2: one byte code
#define RECEIVED_DEPT_ID_2_ORDERS_PLACED_THROUGH_THE_INTERNET 0x49               // Orders Placed Through The Internet
#define RECEIVED_DEPT_ID_2_ORDERS_PLACED_THROUGH_THE_BANK_BRANCH_NETWORK 0x42    // Orders Placed Through The Bank Branch Network
#define RECEIVED_DEPT_ID_2_ORDERS_PLACED_THROUGH_AUTOMATIC_TRADING_SYSTEMS 0x54  // Orders Placed Through Automatic Trading Systems
#define RECEIVED_DEPT_ID_2_ORDERS_PLACED_BY_IMPORTANT_CLIENTS 0x43               // Orders Placed By Important Clients
#define RECEIVED_DEPT_ID_2_OTHERS 0x4F                                           // Others
#define RECEIVED_DEPT_ID_2_NA_WORKSTATION 0x20                                   // Na Workstation

// Persistence 2: one byte code
#define PERSISTENCE_2_CANCEL_ON_DISCONNECTION 0x43   // Cancel On Disconnection
#define PERSISTENCE_2_PERSIST_ON_DISCONNECTION 0x50  // Persist On Disconnection

// ---- Types -------------------------------------------------------------------

// The Logon Response message is used by the Server to accept a new session. In this message the sequence number will always be 0
typedef struct _LogonResponseMessage {
  UINT32 sequence_number;           // bytes 0 to 3
  UINT8 heart_bt_int;               // byte 4
  UINT8 protocol_version[6];        // bytes 5 to 10
  UINT8 test_production_ind;        // byte 11
  UINT8 environment_code[2];        // bytes 12 to 13
  UINT32 session_date;              // bytes 14 to 17, signed, read here as unsigned
  UINT32 expected_sequence_number;  // bytes 18 to 21
  UINT32 sequence_number_to;        // bytes 22 to 25
} LogonResponseMessage;

// The Logout message is used by the Server to notify the end of a session, whether it is solicited or unsolicited. It may also be the answer to a failed logon attempt (see Logon message)
typedef struct _LogoutResponseMessage {
  UINT32 sequence_number;  // bytes 0 to 3
  UINT8 logout_reason;     // byte 4
} LogoutResponseMessage;

// The Heartbeat message is used by the Server to indicate that the communication is active. In the Heartbeat message, the SequenceNumber of the previously received message will be repeated
typedef struct _HeartbeatMessage {
  UINT32 sequence_number;  // bytes 0 to 3
} HeartbeatMessage;

// Message sent by the server with information about the connectivity between the Server and the central systems. In the Network Status message, the SequenceNumber of the previously received message will be repeated
typedef struct _NetworkStatusMessage {
  UINT32 sequence_number;      // bytes 0 to 3
  UINT8 network_status_value;  // byte 4
} NetworkStatusMessage;

// The Logon message is used to start a session by the client application
typedef struct _LogonMessage {
  UINT8 username[7];                // bytes 0 to 6
  UINT8 password[10];               // bytes 7 to 16
  UINT8 software_name[25];          // bytes 17 to 41
  UINT32 expected_sequence_number;  // bytes 42 to 45
  UINT8 subscriptions;              // byte 46
  UINT8 protocol_version[6];        // bytes 47 to 52
} LogonMessage;

// It may be sent by the server to inform about the rejection of an unsupported or syntactically incorrect message. In the Reject message, the SequenceNumber of the previously received message will be repeated
typedef struct _RejectMessage {
  UINT32 sequence_number;           // bytes 0 to 3
  UINT8 session_reject_reason;      // byte 4
  UINT8 text_c_58[58];              // bytes 5 to 62
  UINT8 msg_rejected_reference[7];  // bytes 63 to 69
} RejectMessage;

// Sent by the server to inform about the session status in each Trading Mode
typedef struct _TradingSessionStatusMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT8 trading_session_id;          // byte 4
  UINT8 trading_session_sub_id;      // byte 5
  UINT8 trad_ses_status;             // byte 6
  UINT64 transaction_date_and_time;  // bytes 7 to 14, signed, read here as unsigned
} TradingSessionStatusMessage;

// Used by the Server to communicate a Market Surveillance or system-wide text message
typedef struct _NewsMessage {
  UINT32 sequence_number;  // bytes 0 to 3
  UINT8 news_text[78];     // bytes 4 to 81
} NewsMessage;

// Message sent by the server for cancelling previously defined securities
typedef struct _SecurityListCancellationReportMessage {
  UINT32 sequence_number;      // bytes 0 to 3
  UINT8 market_id[4];          // bytes 4 to 7
  UINT8 market_segment_id[4];  // bytes 8 to 11
  UINT32 security_code;        // bytes 12 to 15
  UINT8 symbol[22];            // bytes 16 to 37
  UINT8 symbol_isin[12];       // bytes 38 to 49
} SecurityListCancellationReportMessage;

// Repeating group of the Statistics message, one entry per data value, DataCount entries
typedef struct _StatisticsRepeatingGroup {
  UINT8 data_code;    // byte 0
  UINT64 data_value;  // bytes 1 to 8, signed, read here as unsigned
} StatisticsRepeatingGroup;

// Message sent by the server to inform about closing prices and other statistics
typedef struct _StatisticsMessage {
  UINT32 sequence_number;                                                                       // bytes 0 to 3
  UINT32 security_code;                                                                         // bytes 4 to 7
  UINT64 transaction_date_and_time;                                                             // bytes 8 to 15, signed, read here as unsigned
  UINT8 data_count;                                                                             // byte 16
  StatisticsRepeatingGroup statistics_repeating_group[:byte-size (((UINT32) data_count) * 9)];
} StatisticsMessage;

// Message sent by the server to provide the definition of one security. It shares the same layout as the Security List Update Report message, but with a different Message Type
typedef struct _SecurityListMessage {
  UINT32 sequence_number;                        // bytes 0 to 3
  UINT8 market_id[4];                            // bytes 4 to 7
  UINT8 market_segment_id[4];                    // bytes 8 to 11
  UINT32 security_code;                          // bytes 12 to 15
  UINT8 symbol[22];                              // bytes 16 to 37
  UINT8 symbol_isin[12];                         // bytes 38 to 49
  UINT8 fisn[35];                                // bytes 50 to 84
  UINT8 issuer_lei[20];                          // bytes 85 to 104
  UINT8 security_group[2];                       // bytes 105 to 106
  UINT8 cfi_code[6];                             // bytes 107 to 112
  UINT8 security_type[2];                        // bytes 113 to 114
  UINT32 maturity_date;                          // bytes 115 to 118, signed, read here as unsigned
  UINT32 issue_date;                             // bytes 119 to 122, signed, read here as unsigned
  UINT64 contract_multiplier;                    // bytes 123 to 130, signed, read here as unsigned
  UINT64 li_spre;                                // bytes 131 to 138, signed, read here as unsigned
  UINT64 sst_ipre;                               // bytes 139 to 146, signed, read here as unsigned
  UINT64 li_spost;                               // bytes 147 to 154, signed, read here as unsigned
  UINT64 sst_ipost;                              // bytes 155 to 162, signed, read here as unsigned
  UINT8 liquid_instrument;                       // byte 163
  UINT8 admission_requested_by_issuer;           // byte 164
  UINT32 min_trade_vol;                          // bytes 165 to 168
  UINT32 round_lot;                              // bytes 169 to 172
  UINT8 currency[3];                             // bytes 173 to 175
  UINT32 modality_mask_b_4;                      // bytes 176 to 179
  UINT8 security_description[80];                // bytes 180 to 259
  UINT8 trading_obligation;                      // byte 260
  UINT8 security_name[40];                       // bytes 261 to 300
  UINT8 security_status;                         // byte 301
  UINT32 coupon_payment_date;                    // bytes 302 to 305, signed, read here as unsigned
  UINT64 min_price_increment;                    // bytes 306 to 313, signed, read here as unsigned
  UINT8 number_of_decimals;                      // byte 314
  UINT8 order_number_of_decimals;                // byte 315
  UINT64 coupon_rate;                            // bytes 316 to 323, signed, read here as unsigned
  UINT8 issuer[12];                              // bytes 324 to 335
  UINT8 trading_scope_b_1;                       // byte 336
  UINT32 first_trading_date;                     // bytes 337 to 340, signed, read here as unsigned
  UINT8 settlement_system;                       // byte 341
  UINT64 maturity;                               // bytes 342 to 349, signed, read here as unsigned
  UINT8 coupon_periodicity;                      // byte 350
  UINT8 benchmark;                               // byte 351
  UINT8 strippable;                              // byte 352
  UINT64 volume_issued;                          // bytes 353 to 360, signed, read here as unsigned
  UINT64 alive_volume;                           // bytes 361 to 368, signed, read here as unsigned
  UINT8 coupon_type;                             // byte 369
  UINT8 coupon_quotation;                        // byte 370
  UINT8 accrued_interest_calculation_procedure;  // byte 371
  UINT32 next_redemption_date;                   // bytes 372 to 375, signed, read here as unsigned
  UINT8 type_of_redemption[2];                   // bytes 376 to 377
  UINT64 facial;                                 // bytes 378 to 385, signed, read here as unsigned
  UINT8 calculation_method;                      // byte 386
  UINT32 date_last_coupon_was_paid;              // bytes 387 to 390, signed, read here as unsigned
  UINT8 bond_seniority[4];                       // bytes 391 to 394
  UINT32 interest_accrual_date;                  // bytes 395 to 398, signed, read here as unsigned
  UINT32 start_date;                             // bytes 399 to 402, signed, read here as unsigned
  UINT8 price_type;                              // byte 403
  UINT64 spread_to_index;                        // bytes 404 to 411, signed, read here as unsigned
  UINT8 benchmark_curve_points_units[4];         // bytes 412 to 415
  UINT8 benchmark_curve_points_value;            // byte 416
  UINT8 benchmark_security_id[25];               // bytes 417 to 441
  UINT64 accrued_interest_rate_r_8;              // bytes 442 to 449, signed, read here as unsigned
} SecurityListMessage;

// Message sent by the server for reporting updates, during the session, to the security definition
typedef struct _SecurityListUpdateReportMessage {
  UINT32 sequence_number;                        // bytes 0 to 3
  UINT8 market_id[4];                            // bytes 4 to 7
  UINT8 market_segment_id[4];                    // bytes 8 to 11
  UINT32 security_code;                          // bytes 12 to 15
  UINT8 symbol[22];                              // bytes 16 to 37
  UINT8 symbol_isin[12];                         // bytes 38 to 49
  UINT8 fisn[35];                                // bytes 50 to 84
  UINT8 issuer_lei[20];                          // bytes 85 to 104
  UINT8 security_group[2];                       // bytes 105 to 106
  UINT8 cfi_code[6];                             // bytes 107 to 112
  UINT8 security_type[2];                        // bytes 113 to 114
  UINT32 maturity_date;                          // bytes 115 to 118, signed, read here as unsigned
  UINT32 issue_date;                             // bytes 119 to 122, signed, read here as unsigned
  UINT64 contract_multiplier;                    // bytes 123 to 130, signed, read here as unsigned
  UINT64 li_spre;                                // bytes 131 to 138, signed, read here as unsigned
  UINT64 sst_ipre;                               // bytes 139 to 146, signed, read here as unsigned
  UINT64 li_spost;                               // bytes 147 to 154, signed, read here as unsigned
  UINT64 sst_ipost;                              // bytes 155 to 162, signed, read here as unsigned
  UINT8 liquid_instrument;                       // byte 163
  UINT8 admission_requested_by_issuer;           // byte 164
  UINT32 min_trade_vol;                          // bytes 165 to 168
  UINT32 round_lot;                              // bytes 169 to 172
  UINT8 currency[3];                             // bytes 173 to 175
  UINT32 modality_mask_b_4;                      // bytes 176 to 179
  UINT8 security_description[80];                // bytes 180 to 259
  UINT8 trading_obligation;                      // byte 260
  UINT8 security_name[40];                       // bytes 261 to 300
  UINT8 security_status;                         // byte 301
  UINT32 coupon_payment_date;                    // bytes 302 to 305, signed, read here as unsigned
  UINT64 min_price_increment;                    // bytes 306 to 313, signed, read here as unsigned
  UINT8 number_of_decimals;                      // byte 314
  UINT8 order_number_of_decimals;                // byte 315
  UINT64 coupon_rate;                            // bytes 316 to 323, signed, read here as unsigned
  UINT8 issuer[12];                              // bytes 324 to 335
  UINT8 trading_scope_b_1;                       // byte 336
  UINT32 first_trading_date;                     // bytes 337 to 340, signed, read here as unsigned
  UINT8 settlement_system;                       // byte 341
  UINT64 maturity;                               // bytes 342 to 349, signed, read here as unsigned
  UINT8 coupon_periodicity;                      // byte 350
  UINT8 benchmark;                               // byte 351
  UINT8 strippable;                              // byte 352
  UINT64 volume_issued;                          // bytes 353 to 360, signed, read here as unsigned
  UINT64 alive_volume;                           // bytes 361 to 368, signed, read here as unsigned
  UINT8 coupon_type;                             // byte 369
  UINT8 coupon_quotation;                        // byte 370
  UINT8 accrued_interest_calculation_procedure;  // byte 371
  UINT32 next_redemption_date;                   // bytes 372 to 375, signed, read here as unsigned
  UINT8 type_of_redemption[2];                   // bytes 376 to 377
  UINT64 facial;                                 // bytes 378 to 385, signed, read here as unsigned
  UINT8 calculation_method;                      // byte 386
  UINT32 date_last_coupon_was_paid;              // bytes 387 to 390, signed, read here as unsigned
  UINT8 bond_seniority[4];                       // bytes 391 to 394
  UINT32 interest_accrual_date;                  // bytes 395 to 398, signed, read here as unsigned
  UINT32 start_date;                             // bytes 399 to 402, signed, read here as unsigned
  UINT8 price_type;                              // byte 403
  UINT64 spread_to_index;                        // bytes 404 to 411, signed, read here as unsigned
  UINT8 benchmark_curve_points_units[4];         // bytes 412 to 415
  UINT8 benchmark_curve_points_value;            // byte 416
  UINT8 benchmark_security_id[25];               // bytes 417 to 441
  UINT64 accrued_interest_rate_r_8;              // bytes 442 to 449, signed, read here as unsigned
} SecurityListUpdateReportMessage;

// Message sent by the server to inform on the status of one security
typedef struct _SecurityStatusMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT64 reference_price;            // bytes 16 to 23, signed, read here as unsigned
  UINT8 security_trading_status;     // byte 24
  UINT8 non_availability_reason;     // byte 25
  UINT64 high_limit_price;           // bytes 26 to 33, signed, read here as unsigned
  UINT64 low_limit_price;            // bytes 34 to 41, signed, read here as unsigned
  UINT8 static_range_type;           // byte 42
  UINT64 order_static_range;         // bytes 43 to 50, signed, read here as unsigned
  UINT64 block_static_range;         // bytes 51 to 58, signed, read here as unsigned
} SecurityStatusMessage;

// Message sent by the UDP full-depth server whenever the information about order prices must be reset. In particular, it is sent by the server when the trading mode changes from auction to open market and vice versa
typedef struct _OrderBookClearMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
} OrderBookClearMessage;

// Used by the Server to communicate information about all active visible orders. During a session, any order is uniquely identified by the SecondaryOrderID
typedef struct _OrderMarketPreTransparencyInformationMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 entry_date;                 // bytes 20 to 23, signed, read here as unsigned
  UINT8 side;                        // byte 24
  UINT32 priority;                   // bytes 25 to 28
  UINT64 price;                      // bytes 29 to 36, signed, read here as unsigned
  UINT32 display_qty;                // bytes 37 to 40
  UINT64 alt_price;                  // bytes 41 to 48, signed, read here as unsigned
} OrderMarketPreTransparencyInformationMessage;

// Used by the Server to communicate information about active quotes. In a session, a Quote is univoquely identified by its two orders: SecurityCode and SecondaryOrderID (buy order) and SecondaryOrderID2 (sell order)
typedef struct _QuoteMarketPreTransparencyInformationMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 secondary_order_id_2;       // bytes 20 to 23
  UINT32 priority;                   // bytes 24 to 27
  UINT64 price;                      // bytes 28 to 35, signed, read here as unsigned
  UINT32 display_qty;                // bytes 36 to 39
  UINT64 alt_price;                  // bytes 40 to 47, signed, read here as unsigned
  UINT32 priority_2;                 // bytes 48 to 51
  UINT64 price_2;                    // bytes 52 to 59, signed, read here as unsigned
  UINT32 display_qty_2;              // bytes 60 to 63
  UINT64 alt_price_2;                // bytes 64 to 71, signed, read here as unsigned
} QuoteMarketPreTransparencyInformationMessage;

// Used by the Server to communicate information order cancellation. The same message is used in Full-Depth data feeds (for order cancellations of any user), in the Order Entry Server (for cancellations of user orders) and in the Market Order Server (for order cancellations of any user)
typedef struct _OrderCancellationMarketMemberMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 entry_date;                 // bytes 20 to 23, signed, read here as unsigned
} OrderCancellationMarketMemberMessage;

// Used by the Server to communicate information about quote cancellation. The same message is used in Full-Depth data feeds (for quote cancellations of any user), in the Order Entry Server (for cancellations of user quotes) and in the Market Order Server (for quote cancellations of any user)
typedef struct _QuoteCancellationMarketMemberMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 secondary_order_id_2;       // bytes 20 to 23
} QuoteCancellationMarketMemberMessage;

// Used by the server to communicate trade information related to trades resulting from order matching in channels C/D and E/F. It is also used in channels A/B when the trade is the result of order matching at the end of an auction period (where only top-of-book information is shown)
typedef struct _TradeMarketPostTransparencyInformationTopOfBookMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 market_segment_id[4];        // bytes 16 to 19
  UINT8 trading_session_id;          // byte 20
  UINT32 trd_match_id;               // bytes 21 to 24
  UINT8 trade_type;                  // byte 25
  UINT64 last_px;                    // bytes 26 to 33, signed, read here as unsigned
  UINT32 last_qty;                   // bytes 34 to 37
  UINT64 gross_trade_amt;            // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                 // byte 46
  UINT8 market_mechanism;            // byte 47
  UINT8 algo_flag;                   // byte 48
  UINT64 alt_last_px;                // bytes 49 to 56, signed, read here as unsigned
  UINT64 accrued_interest_amt;       // bytes 57 to 64, signed, read here as unsigned
  UINT64 accrued_interest_rate_p_8;  // bytes 65 to 72, signed, read here as unsigned
  UINT32 settl_date;                 // bytes 73 to 76, signed, read here as unsigned
  UINT8 transaction_category;        // byte 77
} TradeMarketPostTransparencyInformationTopOfBookMessage;

// Sent by the server to inform about a trade produced due to any reason other than order matching, also to inform about trades produced due to order matching in a Dark pool. In this message, all fields with the suffix 2 refer to the sell order, and the ones without the suffix refer either to both legs or the buy order
typedef struct _TradeTradeAmendmentOrCancellationMessage {
  UINT32 sequence_number;                // bytes 0 to 3
  UINT32 security_code;                  // bytes 4 to 7
  UINT64 transaction_date_and_time;      // bytes 8 to 15, signed, read here as unsigned
  UINT8 market_segment_id[4];            // bytes 16 to 19
  UINT8 trading_session_id;              // byte 20
  UINT32 trd_match_id;                   // bytes 21 to 24
  UINT8 trade_type;                      // byte 25
  UINT64 last_px;                        // bytes 26 to 33, signed, read here as unsigned
  UINT32 last_qty;                       // bytes 34 to 37
  UINT64 gross_trade_amt;                // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                     // byte 46
  UINT8 market_mechanism;                // byte 47
  UINT8 algo_flag;                       // byte 48
  UINT64 alt_last_px;                    // bytes 49 to 56, signed, read here as unsigned
  UINT64 accrued_interest_amt;           // bytes 57 to 64, signed, read here as unsigned
  UINT64 accrued_interest_rate_p_8;      // bytes 65 to 72, signed, read here as unsigned
  UINT32 settl_date;                     // bytes 73 to 76, signed, read here as unsigned
  UINT8 transaction_category;            // byte 77
  UINT8 last_change_flag;                // byte 78
  UINT8 benc_rfpt_flag;                  // byte 79
  UINT8 trade_price_condition;           // byte 80
  UINT8 pre_trade_transparency_waiver;   // byte 81
  UINT8 deferral_waiver;                 // byte 82
  UINT8 post_deferral_publication_type;  // byte 83
  UINT64 publish_date_and_time;          // bytes 84 to 91, signed, read here as unsigned
  UINT64 trade_date;                     // bytes 92 to 99, signed, read here as unsigned
  UINT32 trade_session_date;             // bytes 100 to 103, signed, read here as unsigned
  UINT32 settl_date_2;                   // bytes 104 to 107, signed, read here as unsigned
  UINT64 end_cash;                       // bytes 108 to 115, signed, read here as unsigned
  UINT8 amended_trade_type;              // byte 116
  UINT32 exec_ref_id;                    // bytes 117 to 120
  UINT32 amended_trade_date;             // bytes 121 to 124, signed, read here as unsigned
} TradeTradeAmendmentOrCancellationMessage;

// Used by the server to communicate trade information related to trades resulting from order matching. The message also contains the situation in which the relevant orders will remain in the books
typedef struct _TradeMarketPostTransparencyInformationFullDepthMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 market_segment_id[4];        // bytes 16 to 19
  UINT8 trading_session_id;          // byte 20
  UINT32 trd_match_id;               // bytes 21 to 24
  UINT8 trade_type;                  // byte 25
  UINT64 last_px;                    // bytes 26 to 33, signed, read here as unsigned
  UINT32 last_qty;                   // bytes 34 to 37
  UINT64 gross_trade_amt;            // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                 // byte 46
  UINT8 market_mechanism;            // byte 47
  UINT8 algo_flag;                   // byte 48
  UINT64 alt_last_px;                // bytes 49 to 56, signed, read here as unsigned
  UINT64 accrued_interest_amt;       // bytes 57 to 64, signed, read here as unsigned
  UINT64 accrued_interest_rate_p_8;  // bytes 65 to 72, signed, read here as unsigned
  UINT32 settl_date;                 // bytes 73 to 76, signed, read here as unsigned
  UINT8 transaction_category;        // byte 77
  UINT32 secondary_order_id;         // bytes 78 to 81
  UINT32 entry_date;                 // bytes 82 to 85, signed, read here as unsigned
  UINT32 priority;                   // bytes 86 to 89
  UINT64 price;                      // bytes 90 to 97, signed, read here as unsigned
  UINT32 display_qty;                // bytes 98 to 101
  UINT64 alt_price;                  // bytes 102 to 109, signed, read here as unsigned
  UINT32 secondary_order_id_2;       // bytes 110 to 113
  UINT32 entry_date_2;               // bytes 114 to 117, signed, read here as unsigned
  UINT32 priority_2;                 // bytes 118 to 121
  UINT64 price_2;                    // bytes 122 to 129, signed, read here as unsigned
  UINT32 display_qty_2;              // bytes 130 to 133
  UINT64 alt_price_2;                // bytes 134 to 141, signed, read here as unsigned
} TradeMarketPostTransparencyInformationFullDepthMessage;

// Used by the Server to notify an indication of interest on a specific instrument. This functionality is available in Fixed Income and Derivatives
typedef struct _IndicationOfInterestMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 ioiid;                      // bytes 16 to 19
  UINT8 ioi_trans_type;              // byte 20
  UINT8 side;                        // byte 21
  UINT32 ioi_qty;                    // bytes 22 to 25
  UINT64 ioi_price;                  // bytes 26 to 33, signed, read here as unsigned
  UINT8 trading_session_id;          // byte 34
} IndicationOfInterestMessage;

// Used by the server to communicate price information about RFQs. The contents of the RFQID field match those of the field IOIID in the corresponding Indication of Interest message
typedef struct _RfqMarketPreTransparencyInformationMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 rfqid;                      // bytes 4 to 7
  UINT8 trading_session_id;          // byte 8
  UINT32 security_code;              // bytes 9 to 12
  UINT64 transaction_date_and_time;  // bytes 13 to 20, signed, read here as unsigned
  UINT64 mid_buy_price;              // bytes 21 to 28, signed, read here as unsigned
  UINT32 mid_buy_volume;             // bytes 29 to 32
  UINT16 buy_rf_qs_number;           // bytes 33 to 34
  UINT64 mid_sell_price;             // bytes 35 to 42, signed, read here as unsigned
  UINT32 mid_sell_volume;            // bytes 43 to 46
  UINT16 sell_rf_qs_number;          // bytes 47 to 48
  UINT16 bid_orders_1;               // bytes 49 to 50
  UINT32 bid_size_1;                 // bytes 51 to 54
  UINT64 bid_px_1;                   // bytes 55 to 62, signed, read here as unsigned
  UINT16 ask_orders_1;               // bytes 63 to 64
  UINT32 ask_size_1;                 // bytes 65 to 68
  UINT64 ask_px_1;                   // bytes 69 to 76, signed, read here as unsigned
  UINT16 bid_orders_2;               // bytes 77 to 78
  UINT32 bid_size_2;                 // bytes 79 to 82
  UINT64 bid_px_2;                   // bytes 83 to 90, signed, read here as unsigned
  UINT16 ask_orders_2;               // bytes 91 to 92
  UINT32 ask_size_2;                 // bytes 93 to 96
  UINT64 ask_px_2;                   // bytes 97 to 104, signed, read here as unsigned
  UINT16 bid_orders_3;               // bytes 105 to 106
  UINT32 bid_size_3;                 // bytes 107 to 110
  UINT64 bid_px_3;                   // bytes 111 to 118, signed, read here as unsigned
  UINT16 ask_orders_3;               // bytes 119 to 120
  UINT32 ask_size_3;                 // bytes 121 to 124
  UINT64 ask_px_3;                   // bytes 125 to 132, signed, read here as unsigned
  UINT16 bid_orders_4;               // bytes 133 to 134
  UINT32 bid_size_4;                 // bytes 135 to 138
  UINT64 bid_px_4;                   // bytes 139 to 146, signed, read here as unsigned
  UINT16 ask_orders_4;               // bytes 147 to 148
  UINT32 ask_size_4;                 // bytes 149 to 152
  UINT64 ask_px_4;                   // bytes 153 to 160, signed, read here as unsigned
  UINT16 bid_orders_5;               // bytes 161 to 162
  UINT32 bid_size_5;                 // bytes 163 to 166
  UINT64 bid_px_5;                   // bytes 167 to 174, signed, read here as unsigned
  UINT16 ask_orders_5;               // bytes 175 to 176
  UINT32 ask_size_5;                 // bytes 177 to 180
  UINT64 ask_px_5;                   // bytes 181 to 188, signed, read here as unsigned
} RfqMarketPreTransparencyInformationMessage;

// Used by the UDP Servers to communicate Top-of-book price information during auctions. When there is an indicative match price, the fields BidPx1 and AskPx1 will have the same value
typedef struct _TopOfBookMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT16 bid_orders_1;               // bytes 16 to 17
  UINT32 bid_size_1;                 // bytes 18 to 21
  UINT64 bid_px_1;                   // bytes 22 to 29, signed, read here as unsigned
  UINT64 alt_bid_px_1;               // bytes 30 to 37, signed, read here as unsigned
  UINT16 ask_orders_1;               // bytes 38 to 39
  UINT32 ask_size_1;                 // bytes 40 to 43
  UINT64 ask_px_1;                   // bytes 44 to 51, signed, read here as unsigned
  UINT64 alt_sell_px_1;              // bytes 52 to 59, signed, read here as unsigned
} TopOfBookMessage;

// Sent by the client to set default attributes for subsequent orders and quotes. Please note that in Fixed Income it is possible to enter orders on behalf of other members (AccountMember), based on the corresponding brokerage permissions
typedef struct _OrderAndQuoteClientDataMessage {
  UINT32 request_id;                   // bytes 0 to 3
  UINT16 client_data_id;               // bytes 4 to 5
  UINT8 algorithmic_trade_indicator;   // byte 6
  UINT32 client_id;                    // bytes 7 to 10
  UINT8 account_bolsa[16];             // bytes 11 to 26
  UINT8 account[5];                    // bytes 27 to 31
  UINT8 dea_flag;                      // byte 32
  UINT32 decisor_id;                   // bytes 33 to 36
  UINT32 executor_id;                  // bytes 37 to 40
  UINT8 liquidity_provision_activity;  // byte 41
  UINT8 account_member[4];             // bytes 42 to 45
  UINT8 last_capacity;                 // byte 46
  UINT8 received_dept_id;              // byte 47
  UINT8 persistence;                   // byte 48
  UINT8 client_data_reference[15];     // bytes 49 to 63
} OrderAndQuoteClientDataMessage;

// Message sent by the client to enter a new order
typedef struct _SimpleNewOrderMessage {
  UINT32 request_id;      // bytes 0 to 3
  UINT32 security_code;   // bytes 4 to 7
  UINT16 client_data_id;  // bytes 8 to 9
  UINT32 order_id;        // bytes 10 to 13
  UINT8 side;             // byte 14
  UINT64 price;           // bytes 15 to 22, signed, read here as unsigned
  UINT32 order_qty;       // bytes 23 to 26
  UINT8 time_in_force;    // byte 27
} SimpleNewOrderMessage;

// Message sent by the client to enter a new order and, at the same time, the values for the Client Data parmeters. Note that no ClientDataID may be assigned
typedef struct _SimpleNewOrderWithClientDataMessage {
  UINT32 request_id;                   // bytes 0 to 3
  UINT32 security_code;                // bytes 4 to 7
  UINT32 order_id;                     // bytes 8 to 11
  UINT8 side;                          // byte 12
  UINT64 price;                        // bytes 13 to 20, signed, read here as unsigned
  UINT32 order_qty;                    // bytes 21 to 24
  UINT8 time_in_force;                 // byte 25
  UINT8 algorithmic_trade_indicator;   // byte 26
  UINT32 client_id;                    // bytes 27 to 30
  UINT8 account_bolsa[16];             // bytes 31 to 46
  UINT8 account[5];                    // bytes 47 to 51
  UINT8 dea_flag;                      // byte 52
  UINT32 decisor_id;                   // bytes 53 to 56
  UINT32 executor_id;                  // bytes 57 to 60
  UINT8 liquidity_provision_activity;  // byte 61
  UINT8 account_member[4];             // bytes 62 to 65
  UINT8 last_capacity;                 // byte 66
  UINT8 received_dept_id;              // byte 67
  UINT8 persistence;                   // byte 68
  UINT8 client_data_reference[15];     // bytes 69 to 83
} SimpleNewOrderWithClientDataMessage;

// Message sent by the client to modify an order. The field OrderID must contain the client reference of the order that is to be modified
typedef struct _SimpleOrderModificationMessage {
  UINT32 request_id;      // bytes 0 to 3
  UINT32 security_code;   // bytes 4 to 7
  UINT32 order_id;        // bytes 8 to 11
  UINT8 side;             // byte 12
  UINT64 price;           // bytes 13 to 20, signed, read here as unsigned
  UINT32 order_qty;       // bytes 21 to 24
  UINT16 client_data_id;  // bytes 25 to 26
} SimpleOrderModificationMessage;

// Message sent by the client to modify an order. The field OrderID must contain the client reference of the order that is to be modified
typedef struct _SimpleOrderModificationWithClientDataMessage {
  UINT32 request_id;                   // bytes 0 to 3
  UINT32 security_code;                // bytes 4 to 7
  UINT32 order_id;                     // bytes 8 to 11
  UINT8 side;                          // byte 12
  UINT64 price;                        // bytes 13 to 20, signed, read here as unsigned
  UINT32 order_qty;                    // bytes 21 to 24
  UINT8 algorithmic_trade_indicator;   // byte 25
  UINT32 client_id;                    // bytes 26 to 29
  UINT8 account_bolsa[16];             // bytes 30 to 45
  UINT8 account[5];                    // bytes 46 to 50
  UINT8 dea_flag;                      // byte 51
  UINT32 decisor_id;                   // bytes 52 to 55
  UINT32 executor_id;                  // bytes 56 to 59
  UINT8 liquidity_provision_activity;  // byte 60
  UINT8 account_member[4];             // bytes 61 to 64
  UINT8 last_capacity;                 // byte 65
  UINT8 received_dept_id;              // byte 66
  UINT8 persistence;                   // byte 67
  UINT8 client_data_reference[15];     // bytes 68 to 82
} SimpleOrderModificationWithClientDataMessage;

// Message sent by the client to cancel an order. The field OrderID must contain a reference to the order that is to be cancelled
typedef struct _OrderCancellationRequestMessage {
  UINT32 request_id;     // bytes 0 to 3
  UINT32 security_code;  // bytes 4 to 7
  UINT32 order_id;       // bytes 8 to 11
} OrderCancellationRequestMessage;

// Message sent by the client application to create a new quote. A new quote by the same user on the same SecurityCode and with the same ClientDataID cancels the previous one
typedef struct _NewQuoteMessage {
  UINT32 request_id;      // bytes 0 to 3
  UINT32 security_code;   // bytes 4 to 7
  UINT16 client_data_id;  // bytes 8 to 9
  UINT32 bid_size_1;      // bytes 10 to 13
  UINT64 bid_px_1;        // bytes 14 to 21, signed, read here as unsigned
  UINT32 ask_size_1;      // bytes 22 to 25
  UINT64 ask_px_1;        // bytes 26 to 33, signed, read here as unsigned
} NewQuoteMessage;

// Message sent by the client to modify a quote. Field ClientDataID is required in RF to identify a quote
typedef struct _QuoteModificationRequestMessage {
  UINT32 request_id;      // bytes 0 to 3
  UINT32 security_code;   // bytes 4 to 7
  UINT16 client_data_id;  // bytes 8 to 9
  UINT64 bid_px_1;        // bytes 10 to 17, signed, read here as unsigned
  UINT64 ask_px_1;        // bytes 18 to 25, signed, read here as unsigned
} QuoteModificationRequestMessage;

// Message sent by the client to cancel a quote
typedef struct _QuoteCancellationRequestMessage {
  UINT32 request_id;      // bytes 0 to 3
  UINT32 security_code;   // bytes 4 to 7
  UINT16 client_data_id;  // bytes 8 to 9
} QuoteCancellationRequestMessage;

