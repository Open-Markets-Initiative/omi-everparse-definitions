#define DEFERRAL_WAIVER_NON_IMMEDIATE_PUBLICATION_DEFERRAL_FOR_VERY_LARGE_SIZE_ILLIQUID_MARKET_VIF_5 0x46  // Non Immediate Publication Deferral For Very Large Size Illiquid Market Vif 5
