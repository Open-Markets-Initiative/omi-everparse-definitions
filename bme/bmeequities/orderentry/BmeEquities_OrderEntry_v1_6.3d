  UINT8 ord_status;                  // byte 91
  UINT8 ccp_code;                    // byte 92
  UINT8 aggressor_indicator;         // byte 93
  UINT32 request_id;                 // bytes 94 to 97
  UINT16 client_data_id;             // bytes 98 to 99
} ExecutionPrivateInformation1LegBuyOrderEntryMessage;

// ---- Execution Private Information 1 Leg Sell Order Entry Message: 100 bytes ----

