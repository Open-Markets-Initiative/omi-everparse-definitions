// Message sent by the server to inform on the status of one security
typedef struct _SecurityStatusMessage {
  UINT32 sequence_number;                      // bytes 0 to 3
  UINT32 security_code;                        // bytes 4 to 7
  UINT64 transaction_date_and_time;            // bytes 8 to 15, signed, read here as unsigned
  UINT64 reference_price;                      // bytes 16 to 23, signed, read here as unsigned
  UINT64 static_price;                         // bytes 24 to 31, signed, read here as unsigned
  UINT64 dynamic_price_oscilation_percentage;  // bytes 32 to 39, signed, read here as unsigned
  UINT8 dynamic_range_multiplier;              // byte 40
  UINT64 auction_trigger_price;                // bytes 41 to 48, signed, read here as unsigned
  UINT64 auction_end_time;                     // bytes 49 to 56, signed, read here as unsigned
  UINT32 liquidative_value_date;               // bytes 57 to 60, signed, read here as unsigned
  UINT8 bonus_warrants_with_active_bonus;      // byte 61
  UINT8 security_trading_status;               // byte 62
  UINT8 auction_origin;                        // byte 63
  UINT8 non_availability_reason;               // byte 64
  UINT8 exemption_situation;                   // byte 65
  UINT64 block_oscilation_percentage;          // bytes 66 to 73, signed, read here as unsigned
  UINT64 high_limit_price;                     // bytes 74 to 81, signed, read here as unsigned
  UINT64 low_limit_price;                      // bytes 82 to 89, signed, read here as unsigned
  UINT64 liquidative_value;                    // bytes 90 to 97, signed, read here as unsigned
  UINT8 static_range_type;                     // byte 98
  UINT64 order_static_range;                   // bytes 99 to 106, signed, read here as unsigned
  UINT64 block_static_range;                   // bytes 107 to 114, signed, read here as unsigned
} SecurityStatusMessage;

// Message sent by the UDP full-depth server whenever the information about order prices must be reset. In particular, it is sent by the server when the trading mode changes from auction to open market and vice versa
typedef struct _OrderBookClearMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
} OrderBookClearMessage;

// Used by the Server to communicate information about all active visible orders. During a session, any order is uniquely identified by the SecondaryOrderID
typedef struct _OrderMarketPreTransparencyInformationMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 entry_date;                 // bytes 20 to 23, signed, read here as unsigned
  UINT8 retail_flag;                 // byte 24
  UINT8 side;                        // byte 25
  UINT32 priority;                   // bytes 26 to 29
  UINT64 price;                      // bytes 30 to 37, signed, read here as unsigned
  UINT32 display_qty;                // bytes 38 to 41
} OrderMarketPreTransparencyInformationMessage;

// Used by the Server to communicate information about active quotes. In a session, a Quote is univoquely identified by its two orders: SecurityCode and SecondaryOrderID (buy order) and SecondaryOrderID2 (sell order)
typedef struct _QuoteMarketPreTransparencyInformationMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 secondary_order_id_2;       // bytes 20 to 23
  UINT8 retail_flag;                 // byte 24
  UINT32 priority;                   // bytes 25 to 28
  UINT64 price;                      // bytes 29 to 36, signed, read here as unsigned
  UINT32 display_qty;                // bytes 37 to 40
  UINT32 priority_2;                 // bytes 41 to 44
  UINT64 price_2;                    // bytes 45 to 52, signed, read here as unsigned
  UINT32 display_qty_2;              // bytes 53 to 56
} QuoteMarketPreTransparencyInformationMessage;

// Used by the Server to communicate information order cancellation. The same message is used in Full-Depth data feeds (for order cancellations of any user), in the Order Entry Server (for cancellations of user orders) and in the Market Order Server (for order cancellations of any user)
typedef struct _OrderCancellationMarketMemberMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 entry_date;                 // bytes 20 to 23, signed, read here as unsigned
  UINT8 retail_flag;                 // byte 24
} OrderCancellationMarketMemberMessage;

// Used by the Server to communicate information about quote cancellation. The same message is used in Full-Depth data feeds (for quote cancellations of any user), in the Order Entry Server (for cancellations of user quotes) and in the Market Order Server (for quote cancellations of any user)
typedef struct _QuoteCancellationMarketMemberMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 secondary_order_id_2;       // bytes 20 to 23
  UINT8 retail_flag;                 // byte 24
} QuoteCancellationMarketMemberMessage;

// Used by the server to communicate trade information related to trades resulting from order matching in channels C/D and E/F. It is also used in channels A/B when the trade is the result of order matching at the end of an auction period (where only top-of-book information is shown)
typedef struct _TradeMarketPostTransparencyInformationTopOfBookMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 market_segment_id[4];        // bytes 16 to 19
  UINT8 trading_session_id;          // byte 20
  UINT32 trd_match_id;               // bytes 21 to 24
  UINT8 trade_type;                  // byte 25
  UINT64 last_px;                    // bytes 26 to 33, signed, read here as unsigned
  UINT32 last_qty;                   // bytes 34 to 37
  UINT64 gross_trade_amt;            // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                 // byte 46
  UINT8 market_mechanism;            // byte 47
  UINT8 algo_flag;                   // byte 48
  UINT8 buyer_bolsa_code;            // byte 49
  UINT32 settl_date;                 // bytes 50 to 53, signed, read here as unsigned
  UINT8 transaction_category;        // byte 54
} TradeMarketPostTransparencyInformationTopOfBookMessage;

// Sent by the server to inform about a trade produced due to any reason other than order matching, also to inform about trades produced due to order matching in a Dark pool. In this message, all fields with the suffix 2 refer to the sell order, and the ones without the suffix refer either to both legs or the buy order
typedef struct _TradeTradeAmendmentOrCancellationMessage {
  UINT32 sequence_number;               // bytes 0 to 3
  UINT32 security_code;                 // bytes 4 to 7
  UINT64 transaction_date_and_time;     // bytes 8 to 15, signed, read here as unsigned
  UINT8 market_segment_id[4];           // bytes 16 to 19
  UINT8 trading_session_id;             // byte 20
  UINT32 trd_match_id;                  // bytes 21 to 24
  UINT8 trade_type;                     // byte 25
  UINT64 last_px;                       // bytes 26 to 33, signed, read here as unsigned
  UINT32 last_qty;                      // bytes 34 to 37
  UINT64 gross_trade_amt;               // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                    // byte 46
  UINT8 market_mechanism;               // byte 47
  UINT8 algo_flag;                      // byte 48
  UINT8 buyer_bolsa_code;               // byte 49
  UINT32 settl_date;                    // bytes 50 to 53, signed, read here as unsigned
  UINT8 transaction_category;           // byte 54
  UINT8 last_change_flag;               // byte 55
  UINT8 benc_rfpt_flag;                 // byte 56
  UINT8 trade_price_condition;          // byte 57
  UINT8 pre_trade_transparency_waiver;  // byte 58
  UINT8 deferral_waiver;                // byte 59
  UINT64 publish_date_and_time;         // bytes 60 to 67, signed, read here as unsigned
  UINT64 trade_date;                    // bytes 68 to 75, signed, read here as unsigned
  UINT32 trade_session_date;            // bytes 76 to 79, signed, read here as unsigned
  UINT64 volume_float;                  // bytes 80 to 87
  UINT8 sicav_fund_counterparty_side;   // byte 88
  UINT8 amended_trade_type;             // byte 89
  UINT32 exec_ref_id;                   // bytes 90 to 93
  UINT32 amended_trade_date;            // bytes 94 to 97, signed, read here as unsigned
} TradeTradeAmendmentOrCancellationMessage;

// Used by the server to communicate trade information related to trades resulting from order matching. The message also contains the situation in which the relevant orders will remain in the books
typedef struct _TradeMarketPostTransparencyInformationFullDepthMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 market_segment_id[4];        // bytes 16 to 19
  UINT8 trading_session_id;          // byte 20
  UINT32 trd_match_id;               // bytes 21 to 24
  UINT8 trade_type;                  // byte 25
  UINT64 last_px;                    // bytes 26 to 33, signed, read here as unsigned
  UINT32 last_qty;                   // bytes 34 to 37
  UINT64 gross_trade_amt;            // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                 // byte 46
  UINT8 market_mechanism;            // byte 47
  UINT8 algo_flag;                   // byte 48
  UINT8 buyer_bolsa_code;            // byte 49
  UINT32 settl_date;                 // bytes 50 to 53, signed, read here as unsigned
  UINT8 transaction_category;        // byte 54
  UINT32 secondary_order_id;         // bytes 55 to 58
  UINT32 entry_date;                 // bytes 59 to 62, signed, read here as unsigned
  UINT32 priority;                   // bytes 63 to 66
  UINT64 price;                      // bytes 67 to 74, signed, read here as unsigned
  UINT32 display_qty;                // bytes 75 to 78
  UINT8 retail_flag;                 // byte 79
  UINT32 secondary_order_id_2;       // bytes 80 to 83
  UINT32 entry_date_2;               // bytes 84 to 87, signed, read here as unsigned
  UINT32 priority_2;                 // bytes 88 to 91
  UINT64 price_2;                    // bytes 92 to 99, signed, read here as unsigned
  UINT32 display_qty_2;              // bytes 100 to 103
  UINT8 retail_flag_2;               // byte 104
} TradeMarketPostTransparencyInformationFullDepthMessage;

// Used by the UDP Servers to communicate Top-of-book price information during auctions. When there is an indicative match price, the fields BidPx1 and AskPx1 will have the same value
typedef struct _TopOfBookMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT16 bid_orders_1;               // bytes 16 to 17
  UINT32 bid_size_1;                 // bytes 18 to 21
  UINT64 bid_px_1;                   // bytes 22 to 29, signed, read here as unsigned
  UINT16 ask_orders_1;               // bytes 30 to 31
  UINT32 ask_size_1;                 // bytes 32 to 35
  UINT64 ask_px_1;                   // bytes 36 to 43, signed, read here as unsigned
} TopOfBookMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x08: LogonResponseMessage logon_response_message;
    case 0x0B: LogoutResponseMessage logout_response_message;
    case 0x30: HeartbeatMessage heartbeat_message;
    case 0x0A: NetworkStatusMessage network_status_message;
    case 0x68: TradingSessionStatusMessage trading_session_status_message;
    case 0x42: NewsMessage news_message;
    case 0x78: SecurityListCancellationReportMessage security_list_cancellation_report_message;
    case 0x84: StatisticsMessage statistics_message;
    case 0x79: SecurityListMessage security_list_message;
    case 0x80: SecurityListUpdateReportMessage security_list_update_report_message;
    case 0x66: SecurityStatusMessage security_status_message;
    case 0x81: OrderBookClearMessage order_book_clear_message;
    case 0x03: OrderMarketPreTransparencyInformationMessage order_market_pre_transparency_information_message;
    case 0x07: QuoteMarketPreTransparencyInformationMessage quote_market_pre_transparency_information_message;
    case 0x01: OrderCancellationMarketMemberMessage order_cancellation_market_member_message;
    case 0x05: QuoteCancellationMarketMemberMessage quote_cancellation_market_member_message;
    case 0x10: TradeMarketPostTransparencyInformationTopOfBookMessage trade_market_post_transparency_information_top_of_book_message;
    case 0x18: TradeTradeAmendmentOrCancellationMessage trade_trade_amendment_or_cancellation_message;
    case 0x11: TradeMarketPostTransparencyInformationFullDepthMessage trade_market_post_transparency_information_full_depth_message;
    case 0x82: TopOfBookMessage top_of_book_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Bme BmeGate Message
typedef struct _Message {
  UINT16 message_size { message_size >= 3 };                                                                                    // bytes 0 to 1
  UINT8 message_type;                                                                                                           // byte 2
  Payload(message_type, (((UINT32) message_size) - 3)) payload[:byte-size-single-element-array (((UINT32) message_size) - 3)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// A Bme binary feed carries no packet header of its own: section 2.1 states that every feed is a series of sequenced messages, each stating its own length, so a datagram holds whole messages to its end
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

