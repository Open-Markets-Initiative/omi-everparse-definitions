// Pre Trade Transparency Waiver: one byte code
#define PRE_TRADE_TRANSPARENCY_WAIVER_NEGOTIATED_TRADE_IN_LIQUID_FINANCIAL_INSTRUMENTS_NLIQ 0x30     // Negotiated Trade In Liquid Financial Instruments Nliq
#define PRE_TRADE_TRANSPARENCY_WAIVER_NEGOTIATED_TRADE_IN_ILLIQUID_FINANCIAL_INSTRUMENTS_OILQ 0x31   // Negotiated Trade In Illiquid Financial Instruments Oilq
#define PRE_TRADE_TRANSPARENCY_WAIVER_NEGOTIATED_TRADE_OTHER_THAN_CURRENT_MARKET_PRICE_P_R_I_C 0x32  // Negotiated Trade Other Than Current Market Price PRIC

// Deferral Waiver: one byte code
#define DEFERRAL_WAIVER_IMMEDIATE_PUBLICATION 0x20  // Immediate Publication

// Sicav Fund Counterparty Side: one byte code
#define SICAV_FUND_COUNTERPARTY_SIDE_BUYER 0x31   // Buyer
#define SICAV_FUND_COUNTERPARTY_SIDE_SELLER 0x32  // Seller

// Amended Trade Type: one byte code
#define AMENDED_TRADE_TYPE_MARKET 0x4D                                              // Market
#define AMENDED_TRADE_TYPE_CANCELLATION 0x58                                        // Cancellation
#define AMENDED_TRADE_TYPE_TRADE_AMENDMENT 0x54                                     // Trade Amendment
#define AMENDED_TRADE_TYPE_BLOCK_TRADE 0x48                                         // Block Trade
#define AMENDED_TRADE_TYPE_COMMUNICATED_APPLICATION 0x31                            // Communicated Application
#define AMENDED_TRADE_TYPE_AUTHORISED_APPLICATION_TRADES 0x32                       // Authorised Application Trades
#define AMENDED_TRADE_TYPE_AUTHORISED_APPLICATION_CORPORATE_INTEREST 0x33           // Authorised Application Corporate Interest
#define AMENDED_TRADE_TYPE_AUTHORISED_APPLICATION_EXECUTION_OF_CONTRACTS 0x34       // Authorised Application Execution Of Contracts
#define AMENDED_TRADE_TYPE_AUTHORISED_APPLICATION_OTHER_CAUSES 0x35                 // Authorised Application Other Causes
#define AMENDED_TRADE_TYPE_VALIDATION_COMMUNICATED 0x36                             // Validation Communicated
#define AMENDED_TRADE_TYPE_AUTHORISED_VALIDATION_TRADES 0x37                        // Authorised Validation Trades
#define AMENDED_TRADE_TYPE_AUTHORISED_VALIDATION_CORPORATE_INTEREST 0x38            // Authorised Validation Corporate Interest
#define AMENDED_TRADE_TYPE_AUTHORISED_VALIDATION_EXECUTION_OF_CONTRACTS 0x39        // Authorised Validation Execution Of Contracts
#define AMENDED_TRADE_TYPE_AUTHORISED_VALIDATION_OTHER_CAUSES 0x30                  // Authorised Validation Other Causes
#define AMENDED_TRADE_TYPE_TRANSACTION_BETWEEN_MEMBERS_COMMUNICATED 0x41            // Transaction Between Members Communicated
#define AMENDED_TRADE_TYPE_TRANSACTION_BETWEEN_MEMBERS_TRADES 0x42                  // Transaction Between Members Trades
#define AMENDED_TRADE_TYPE_TRANSACTION_BETWEEN_MEMBERS_CORPORATE_INTEREST 0x43      // Transaction Between Members Corporate Interest
#define AMENDED_TRADE_TYPE_TRANSACTION_BETWEEN_MEMBERS_EXECUTION_OF_CONTRACTS 0x46  // Transaction Between Members Execution Of Contracts
#define AMENDED_TRADE_TYPE_TRANSACTION_BETWEEN_MEMBERS_OTHER_CAUSES 0x47            // Transaction Between Members Other Causes
#define AMENDED_TRADE_TYPE_APPLICATION_TO_CATER_FOR_A_LINKED_POSITION 0x49          // Application To Cater For A Linked Position
#define AMENDED_TRADE_TYPE_TRANSACTION_TO_CATER_FOR_A_LINKED_POSITION 0x4A          // Transaction To Cater For A Linked Position
#define AMENDED_TRADE_TYPE_TRANSACTION_OF_EXERCISE_OF_OPTIONS 0x45                  // Transaction Of Exercise Of Options
#define AMENDED_TRADE_TYPE_PUBLIC_SHARE_BID_OFFER_TYPE_TRANSACTION 0x4E             // Public Share Bid Offer Type Transaction
#define AMENDED_TRADE_TYPE_PUBLIC_SHARE_ASK_OFFER_TYPE_TRANSACTION 0x4F             // Public Share Ask Offer Type Transaction
#define AMENDED_TRADE_TYPE_PUBLIC_SHARE_SUBSCRIPTION_OFFER_TYPE_TRANSACTION 0x50    // Public Share Subscription Offer Type Transaction
#define AMENDED_TRADE_TYPE_SPECIAL_TRADES_DELTA_TYPE 0x4C                           // Special Trades Delta Type
#define AMENDED_TRADE_TYPE_NET_ASSET_VALUE_SPECIAL_TRADE_D_PLUS_1 0x61              // Net Asset Value Special Trade D Plus 1
#define AMENDED_TRADE_TYPE_NET_ASSET_VALUE_SPECIAL_TRADE_D_PLUS_2 0x62              // Net Asset Value Special Trade D Plus 2
#define AMENDED_TRADE_TYPE_NET_ASSET_VALUE_SPECIAL_TRADE_D_PLUS_3 0x63              // Net Asset Value Special Trade D Plus 3
#define AMENDED_TRADE_TYPE_APPLICATION_WITHOUT_C_C_P 0x44                           // Application Without CCP
#define AMENDED_TRADE_TYPE_TRANSACTION_WITHOUT_C_C_P 0x4B                           // Transaction Without CCP
#define AMENDED_TRADE_TYPE_INVESTMENT_FUND_D_PLUS_1 0x64                            // Investment Fund D Plus 1
#define AMENDED_TRADE_TYPE_INVESTMENT_FUND_D_PLUS_2 0x65                            // Investment Fund D Plus 2
#define AMENDED_TRADE_TYPE_INVESTMENT_FUND_D_PLUS_3 0x66                            // Investment Fund D Plus 3
#define AMENDED_TRADE_TYPE_V_W_A_P 0x57                                             // VWAP

// Retail Flag 2: one byte code
#define RETAIL_FLAG_2_FALSE 0x00  // False
#define RETAIL_FLAG_2_TRUE 0x01   // True

// ---- Types -------------------------------------------------------------------

// The Logon Response message is used by the Server to accept a new session. In this message the sequence number will always be 0
typedef struct _LogonResponseMessage {
  UINT32 sequence_number;           // bytes 0 to 3
  UINT8 heart_bt_int;               // byte 4
  UINT8 protocol_version[6];        // bytes 5 to 10
  UINT8 test_production_ind;        // byte 11
  UINT8 environment_code[2];        // bytes 12 to 13
  UINT32 session_date;              // bytes 14 to 17, signed, read here as unsigned
  UINT32 expected_sequence_number;  // bytes 18 to 21
  UINT32 sequence_number_to;        // bytes 22 to 25
} LogonResponseMessage;

// The Logout message is used by the Server to notify the end of a session, whether it is solicited or unsolicited. It may also be the answer to a failed logon attempt (see Logon message)
typedef struct _LogoutResponseMessage {
  UINT32 sequence_number;  // bytes 0 to 3
  UINT8 logout_reason;     // byte 4
} LogoutResponseMessage;

// The Heartbeat message is used by the Server to indicate that the communication is active. In the Heartbeat message, the SequenceNumber of the previously received message will be repeated
typedef struct _HeartbeatMessage {
  UINT32 sequence_number;  // bytes 0 to 3
} HeartbeatMessage;

// Message sent by the server with information about the connectivity between the Server and the central systems. In the Network Status message, the SequenceNumber of the previously received message will be repeated
typedef struct _NetworkStatusMessage {
  UINT32 sequence_number;      // bytes 0 to 3
  UINT8 network_status_value;  // byte 4
} NetworkStatusMessage;

// Sent by the server to inform about the session status in each Trading Mode
typedef struct _TradingSessionStatusMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT8 trading_session_id;          // byte 4
  UINT8 trading_session_sub_id;      // byte 5
  UINT8 trad_ses_status;             // byte 6
  UINT64 transaction_date_and_time;  // bytes 7 to 14, signed, read here as unsigned
} TradingSessionStatusMessage;

// Used by the Server to communicate a Market Surveillance or system-wide text message
typedef struct _NewsMessage {
  UINT32 sequence_number;  // bytes 0 to 3
  UINT8 news_text[78];     // bytes 4 to 81
} NewsMessage;

// Message sent by the server for cancelling previously defined securities
typedef struct _SecurityListCancellationReportMessage {
  UINT32 sequence_number;      // bytes 0 to 3
  UINT8 market_id[4];          // bytes 4 to 7
  UINT8 market_segment_id[4];  // bytes 8 to 11
  UINT32 security_code;        // bytes 12 to 15
  UINT8 symbol[22];            // bytes 16 to 37
  UINT8 symbol_isin[12];       // bytes 38 to 49
} SecurityListCancellationReportMessage;

// Repeating group of the Statistics message, one entry per data value, DataCount entries
typedef struct _StatisticsRepeatingGroup {
  UINT8 data_code;    // byte 0
  UINT64 data_value;  // bytes 1 to 8, signed, read here as unsigned
} StatisticsRepeatingGroup;

// Message sent by the server to inform about closing prices and other statistics
typedef struct _StatisticsMessage {
  UINT32 sequence_number;                                                                       // bytes 0 to 3
  UINT32 security_code;                                                                         // bytes 4 to 7
  UINT64 transaction_date_and_time;                                                             // bytes 8 to 15, signed, read here as unsigned
  UINT8 data_count;                                                                             // byte 16
  StatisticsRepeatingGroup statistics_repeating_group[:byte-size (((UINT32) data_count) * 9)];
} StatisticsMessage;

// Message sent by the server to provide the definition of one security. It shares the same layout as the Security List Update Report message, but with a different Message Type
typedef struct _SecurityListMessage {
  UINT32 sequence_number;                              // bytes 0 to 3
  UINT8 market_id[4];                                  // bytes 4 to 7
  UINT8 market_segment_id[4];                          // bytes 8 to 11
  UINT32 security_code;                                // bytes 12 to 15
  UINT8 symbol[22];                                    // bytes 16 to 37
  UINT8 symbol_isin[12];                               // bytes 38 to 49
  UINT8 fisn[35];                                      // bytes 50 to 84
  UINT8 issuer_lei[20];                                // bytes 85 to 104
  UINT8 security_group[2];                             // bytes 105 to 106
  UINT8 cfi_code[6];                                   // bytes 107 to 112
  UINT8 security_type[2];                              // bytes 113 to 114
  UINT32 maturity_date;                                // bytes 115 to 118, signed, read here as unsigned
  UINT32 issue_date;                                   // bytes 119 to 122, signed, read here as unsigned
  UINT64 contract_multiplier;                          // bytes 123 to 130, signed, read here as unsigned
  UINT64 li_spre;                                      // bytes 131 to 138, signed, read here as unsigned
  UINT64 sst_ipre;                                     // bytes 139 to 146, signed, read here as unsigned
  UINT64 li_spost;                                     // bytes 147 to 154, signed, read here as unsigned
  UINT64 sst_ipost;                                    // bytes 155 to 162, signed, read here as unsigned
  UINT8 liquid_instrument;                             // byte 163
  UINT8 admission_requested_by_issuer;                 // byte 164
  UINT32 min_trade_vol;                                // bytes 165 to 168
  UINT32 round_lot;                                    // bytes 169 to 172
  UINT8 currency[3];                                   // bytes 173 to 175
  UINT32 modality_mask_b_4;                            // bytes 176 to 179
  UINT8 security_description[80];                      // bytes 180 to 259
  UINT8 trading_obligation;                            // byte 260
  UINT8 security_name[40];                             // bytes 261 to 300
  UINT8 net_asset_value_identifier[7];                 // bytes 301 to 307
  UINT8 security_sub_type[2];                          // bytes 308 to 309
  UINT8 maturity_month_year[8];                        // bytes 310 to 317
  UINT8 security_status;                               // byte 318
  UINT64 strike_price;                                 // bytes 319 to 326, signed, read here as unsigned
  UINT64 strike_value;                                 // bytes 327 to 334, signed, read here as unsigned
  UINT8 exercise_style;                                // byte 335
  UINT8 put_or_call;                                   // byte 336
  UINT64 position_limit;                               // bytes 337 to 344, signed, read here as unsigned
  UINT64 nt_position_limit;                            // bytes 345 to 352
  UINT8 issuer[12];                                    // bytes 353 to 364
  UINT8 cp_reg_type;                                   // byte 365
  UINT64 barrier;                                      // bytes 366 to 373, signed, read here as unsigned
  UINT32 last_trading_day;                             // bytes 374 to 377, signed, read here as unsigned
  UINT8 automatic_expiration;                          // byte 378
  UINT8 fee_type[2];                                   // bytes 379 to 380
  UINT64 barrier_2;                                    // bytes 381 to 388, signed, read here as unsigned
  UINT64 trigger_barrier;                              // bytes 389 to 396, signed, read here as unsigned
  UINT64 trigger_upper_barrier;                        // bytes 397 to 404, signed, read here as unsigned
  UINT64 average_quarterly_turnover;                   // bytes 405 to 412, signed, read here as unsigned
  UINT8 trading_scope;                                 // byte 413
  UINT8 sicav_counterparty_member[4];                  // bytes 414 to 417
  UINT8 net_asset_value_indicator;                     // byte 418
  UINT8 reference_trading_venue;                       // byte 419
  UINT64 outstanding_capital;                          // bytes 420 to 427, signed, read here as unsigned
  UINT32 first_trading_date;                           // bytes 428 to 431, signed, read here as unsigned
  UINT8 settlement_system;                             // byte 432
  UINT8 number_of_decimals;                            // byte 433
  UINT32 number_of_holders;                            // bytes 434 to 437
  UINT32 outstanding_shares;                           // bytes 438 to 441
  UINT32 minimum_authorized_shares;                    // bytes 442 to 445
  UINT64 minimum_capital;                              // bytes 446 to 453, signed, read here as unsigned
  UINT32 last_admission_date;                          // bytes 454 to 457, signed, read here as unsigned
  UINT64 barrier_return;                               // bytes 458 to 465, signed, read here as unsigned
  UINT8 investment_fund_manager[80];                   // bytes 466 to 545
  UINT64 effective_amount_filters_routed_orders;       // bytes 546 to 553, signed, read here as unsigned
  UINT8 order_number_of_decimals;                      // byte 554
  UINT8 investment_fund_class;                         // byte 555
  UINT8 master_fund_name[80];                          // bytes 556 to 635
  UINT8 investment_fund_management_company[80];        // bytes 636 to 715
  UINT8 investment_fund_depository[80];                // bytes 716 to 795
  UINT8 investment_fund_category[80];                  // bytes 796 to 875
  UINT64 investment_fund_minimum_subscription_amount;  // bytes 876 to 883, signed, read here as unsigned
  UINT64 investment_fund_minimum_maintenance_amount;   // bytes 884 to 891, signed, read here as unsigned
  UINT64 investment_fund_cut_off_time;                 // bytes 892 to 899, signed, read here as unsigned
  UINT8 nav_communication_term;                        // byte 900
  UINT8 investment_fund_number_of_decimals;            // byte 901
  UINT8 commodity_derivative_indicator;                // byte 902
  UINT8 double_volume_cap_reached;                     // byte 903
  UINT64 adt;                                          // bytes 904 to 911, signed, read here as unsigned
  UINT8 base_product[4];                               // bytes 912 to 915
  UINT8 sub_product[4];                                // bytes 916 to 919
  UINT8 further_sub_product[4];                        // bytes 920 to 923
  UINT64 adnt;                                         // bytes 924 to 931, signed, read here as unsigned
  UINT8 price_tick_rule;                               // byte 932
  UINT8 underlying_symbol[22];                         // bytes 933 to 954
  UINT8 underlying_isin[12];                           // bytes 955 to 966
  UINT8 underlying_currency[3];                        // bytes 967 to 969
  UINT32 minimum_display_qty;                          // bytes 970 to 973
  UINT8 retail_service_flag;                           // byte 974
  UINT8 self_match_prevention;                         // byte 975
} SecurityListMessage;

// Message sent by the server for reporting updates, during the session, to the security definition
typedef struct _SecurityListUpdateReportMessage {
  UINT32 sequence_number;                              // bytes 0 to 3
  UINT8 market_id[4];                                  // bytes 4 to 7
  UINT8 market_segment_id[4];                          // bytes 8 to 11
  UINT32 security_code;                                // bytes 12 to 15
  UINT8 symbol[22];                                    // bytes 16 to 37
  UINT8 symbol_isin[12];                               // bytes 38 to 49
  UINT8 fisn[35];                                      // bytes 50 to 84
  UINT8 issuer_lei[20];                                // bytes 85 to 104
  UINT8 security_group[2];                             // bytes 105 to 106
  UINT8 cfi_code[6];                                   // bytes 107 to 112
  UINT8 security_type[2];                              // bytes 113 to 114
  UINT32 maturity_date;                                // bytes 115 to 118, signed, read here as unsigned
  UINT32 issue_date;                                   // bytes 119 to 122, signed, read here as unsigned
  UINT64 contract_multiplier;                          // bytes 123 to 130, signed, read here as unsigned
  UINT64 li_spre;                                      // bytes 131 to 138, signed, read here as unsigned
  UINT64 sst_ipre;                                     // bytes 139 to 146, signed, read here as unsigned
  UINT64 li_spost;                                     // bytes 147 to 154, signed, read here as unsigned
  UINT64 sst_ipost;                                    // bytes 155 to 162, signed, read here as unsigned
  UINT8 liquid_instrument;                             // byte 163
  UINT8 admission_requested_by_issuer;                 // byte 164
  UINT32 min_trade_vol;                                // bytes 165 to 168
  UINT32 round_lot;                                    // bytes 169 to 172
  UINT8 currency[3];                                   // bytes 173 to 175
  UINT32 modality_mask_b_4;                            // bytes 176 to 179
  UINT8 security_description[80];                      // bytes 180 to 259
  UINT8 trading_obligation;                            // byte 260
  UINT8 security_name[40];                             // bytes 261 to 300
  UINT8 net_asset_value_identifier[7];                 // bytes 301 to 307
  UINT8 security_sub_type[2];                          // bytes 308 to 309
  UINT8 maturity_month_year[8];                        // bytes 310 to 317
  UINT8 security_status;                               // byte 318
  UINT64 strike_price;                                 // bytes 319 to 326, signed, read here as unsigned
  UINT64 strike_value;                                 // bytes 327 to 334, signed, read here as unsigned
  UINT8 exercise_style;                                // byte 335
  UINT8 put_or_call;                                   // byte 336
  UINT64 position_limit;                               // bytes 337 to 344, signed, read here as unsigned
  UINT64 nt_position_limit;                            // bytes 345 to 352
  UINT8 issuer[12];                                    // bytes 353 to 364
  UINT8 cp_reg_type;                                   // byte 365
  UINT64 barrier;                                      // bytes 366 to 373, signed, read here as unsigned
  UINT32 last_trading_day;                             // bytes 374 to 377, signed, read here as unsigned
  UINT8 automatic_expiration;                          // byte 378
  UINT8 fee_type[2];                                   // bytes 379 to 380
  UINT64 barrier_2;                                    // bytes 381 to 388, signed, read here as unsigned
  UINT64 trigger_barrier;                              // bytes 389 to 396, signed, read here as unsigned
  UINT64 trigger_upper_barrier;                        // bytes 397 to 404, signed, read here as unsigned
  UINT64 average_quarterly_turnover;                   // bytes 405 to 412, signed, read here as unsigned
  UINT8 trading_scope;                                 // byte 413
  UINT8 sicav_counterparty_member[4];                  // bytes 414 to 417
  UINT8 net_asset_value_indicator;                     // byte 418
  UINT8 reference_trading_venue;                       // byte 419
  UINT64 outstanding_capital;                          // bytes 420 to 427, signed, read here as unsigned
  UINT32 first_trading_date;                           // bytes 428 to 431, signed, read here as unsigned
  UINT8 settlement_system;                             // byte 432
  UINT8 number_of_decimals;                            // byte 433
  UINT32 number_of_holders;                            // bytes 434 to 437
  UINT32 outstanding_shares;                           // bytes 438 to 441
  UINT32 minimum_authorized_shares;                    // bytes 442 to 445
  UINT64 minimum_capital;                              // bytes 446 to 453, signed, read here as unsigned
  UINT32 last_admission_date;                          // bytes 454 to 457, signed, read here as unsigned
  UINT64 barrier_return;                               // bytes 458 to 465, signed, read here as unsigned
  UINT8 investment_fund_manager[80];                   // bytes 466 to 545
  UINT64 effective_amount_filters_routed_orders;       // bytes 546 to 553, signed, read here as unsigned
  UINT8 order_number_of_decimals;                      // byte 554
  UINT8 investment_fund_class;                         // byte 555
  UINT8 master_fund_name[80];                          // bytes 556 to 635
  UINT8 investment_fund_management_company[80];        // bytes 636 to 715
  UINT8 investment_fund_depository[80];                // bytes 716 to 795
  UINT8 investment_fund_category[80];                  // bytes 796 to 875
  UINT64 investment_fund_minimum_subscription_amount;  // bytes 876 to 883, signed, read here as unsigned
  UINT64 investment_fund_minimum_maintenance_amount;   // bytes 884 to 891, signed, read here as unsigned
