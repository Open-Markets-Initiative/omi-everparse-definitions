// Bme BmeGate Message
typedef struct _Message {
  UINT16 message_size { message_size >= 3 };                                                                                    // bytes 0 to 1
  UINT8 message_type;                                                                                                           // byte 2
  Payload(message_type, (((UINT32) message_size) - 3)) payload[:byte-size-single-element-array (((UINT32) message_size) - 3)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// A Bme binary feed carries no packet header of its own: section 2.1 states that every feed is a series of sequenced messages, each stating its own length, so a segment holds whole messages to its end
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

