  UINT64 investment_fund_minimum_subscription_amount;  // bytes 876 to 883, signed, read here as unsigned
  UINT64 investment_fund_minimum_maintenance_amount;   // bytes 884 to 891, signed, read here as unsigned
  UINT64 investment_fund_cut_off_time;                 // bytes 892 to 899, signed, read here as unsigned
  UINT8 nav_communication_term;                        // byte 900
  UINT8 investment_fund_number_of_decimals;            // byte 901
  UINT8 commodity_derivative_indicator;                // byte 902
  UINT8 double_volume_cap_reached;                     // byte 903
  UINT64 adt;                                          // bytes 904 to 911, signed, read here as unsigned
  UINT8 base_product[4];                               // bytes 912 to 915
  UINT8 sub_product[4];                                // bytes 916 to 919
  UINT8 further_sub_product[4];                        // bytes 920 to 923
  UINT64 adnt;                                         // bytes 924 to 931, signed, read here as unsigned
  UINT8 price_tick_rule;                               // byte 932
  UINT8 underlying_symbol[22];                         // bytes 933 to 954
  UINT8 underlying_isin[12];                           // bytes 955 to 966
  UINT8 underlying_currency[3];                        // bytes 967 to 969
  UINT32 minimum_display_qty;                          // bytes 970 to 973
  UINT8 retail_service_flag;                           // byte 974
  UINT8 self_match_prevention;                         // byte 975
} SecurityListUpdateReportMessage;

// Message sent by the server to inform on the status of one security
typedef struct _SecurityStatusMessage {
  UINT32 sequence_number;                      // bytes 0 to 3
  UINT32 security_code;                        // bytes 4 to 7
  UINT64 transaction_date_and_time;            // bytes 8 to 15, signed, read here as unsigned
  UINT64 reference_price;                      // bytes 16 to 23, signed, read here as unsigned
  UINT64 static_price;                         // bytes 24 to 31, signed, read here as unsigned
  UINT64 dynamic_price_oscilation_percentage;  // bytes 32 to 39, signed, read here as unsigned
  UINT8 dynamic_range_multiplier;              // byte 40
  UINT64 auction_trigger_price;                // bytes 41 to 48, signed, read here as unsigned
  UINT64 auction_end_time;                     // bytes 49 to 56, signed, read here as unsigned
  UINT32 liquidative_value_date;               // bytes 57 to 60, signed, read here as unsigned
  UINT8 bonus_warrants_with_active_bonus;      // byte 61
  UINT8 security_trading_status;               // byte 62
  UINT8 auction_origin;                        // byte 63
  UINT8 non_availability_reason;               // byte 64
  UINT8 exemption_situation;                   // byte 65
  UINT64 block_oscilation_percentage;          // bytes 66 to 73, signed, read here as unsigned
  UINT64 high_limit_price;                     // bytes 74 to 81, signed, read here as unsigned
  UINT64 low_limit_price;                      // bytes 82 to 89, signed, read here as unsigned
  UINT64 liquidative_value;                    // bytes 90 to 97, signed, read here as unsigned
  UINT8 static_range_type;                     // byte 98
  UINT64 order_static_range;                   // bytes 99 to 106, signed, read here as unsigned
  UINT64 block_static_range;                   // bytes 107 to 114, signed, read here as unsigned
} SecurityStatusMessage;

// Message sent by the UDP full-depth server whenever the information about order prices must be reset. In particular, it is sent by the server when the trading mode changes from auction to open market and vice versa
typedef struct _OrderBookClearMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
} OrderBookClearMessage;

// Used by the Server to communicate information about all active visible orders. During a session, any order is uniquely identified by the SecondaryOrderID
typedef struct _OrderMarketPreTransparencyInformationMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 entry_date;                 // bytes 20 to 23, signed, read here as unsigned
  UINT8 retail_flag;                 // byte 24
  UINT8 side;                        // byte 25
  UINT32 priority;                   // bytes 26 to 29
  UINT64 price;                      // bytes 30 to 37, signed, read here as unsigned
  UINT32 display_qty;                // bytes 38 to 41
} OrderMarketPreTransparencyInformationMessage;

// Used by the Server to communicate information about active quotes. In a session, a Quote is univoquely identified by its two orders: SecurityCode and SecondaryOrderID (buy order) and SecondaryOrderID2 (sell order)
typedef struct _QuoteMarketPreTransparencyInformationMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 secondary_order_id_2;       // bytes 20 to 23
  UINT8 retail_flag;                 // byte 24
  UINT32 priority;                   // bytes 25 to 28
  UINT64 price;                      // bytes 29 to 36, signed, read here as unsigned
  UINT32 display_qty;                // bytes 37 to 40
  UINT32 priority_2;                 // bytes 41 to 44
  UINT64 price_2;                    // bytes 45 to 52, signed, read here as unsigned
  UINT32 display_qty_2;              // bytes 53 to 56
} QuoteMarketPreTransparencyInformationMessage;

// Used by the Server to communicate information order cancellation. The same message is used in Full-Depth data feeds (for order cancellations of any user), in the Order Entry Server (for cancellations of user orders) and in the Market Order Server (for order cancellations of any user)
typedef struct _OrderCancellationMarketMemberMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 entry_date;                 // bytes 20 to 23, signed, read here as unsigned
  UINT8 retail_flag;                 // byte 24
} OrderCancellationMarketMemberMessage;

// Used by the Server to communicate information about quote cancellation. The same message is used in Full-Depth data feeds (for quote cancellations of any user), in the Order Entry Server (for cancellations of user quotes) and in the Market Order Server (for quote cancellations of any user)
typedef struct _QuoteCancellationMarketMemberMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 secondary_order_id_2;       // bytes 20 to 23
  UINT8 retail_flag;                 // byte 24
} QuoteCancellationMarketMemberMessage;

// Used by the server to communicate trade information related to trades resulting from order matching in channels C/D and E/F. It is also used in channels A/B when the trade is the result of order matching at the end of an auction period (where only top-of-book information is shown)
typedef struct _TradeMarketPostTransparencyInformationTopOfBookMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 market_segment_id[4];        // bytes 16 to 19
  UINT8 trading_session_id;          // byte 20
  UINT32 trd_match_id;               // bytes 21 to 24
  UINT8 trade_type;                  // byte 25
  UINT64 last_px;                    // bytes 26 to 33, signed, read here as unsigned
  UINT32 last_qty;                   // bytes 34 to 37
  UINT64 gross_trade_amt;            // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                 // byte 46
  UINT8 market_mechanism;            // byte 47
  UINT8 algo_flag;                   // byte 48
  UINT8 buyer_bolsa_code;            // byte 49
  UINT32 settl_date;                 // bytes 50 to 53, signed, read here as unsigned
  UINT8 transaction_category;        // byte 54
} TradeMarketPostTransparencyInformationTopOfBookMessage;

// Sent by the server to inform about a trade produced due to any reason other than order matching, also to inform about trades produced due to order matching in a Dark pool. In this message, all fields with the suffix 2 refer to the sell order, and the ones without the suffix refer either to both legs or the buy order
typedef struct _TradeTradeAmendmentOrCancellationMessage {
  UINT32 sequence_number;               // bytes 0 to 3
  UINT32 security_code;                 // bytes 4 to 7
  UINT64 transaction_date_and_time;     // bytes 8 to 15, signed, read here as unsigned
  UINT8 market_segment_id[4];           // bytes 16 to 19
  UINT8 trading_session_id;             // byte 20
  UINT32 trd_match_id;                  // bytes 21 to 24
  UINT8 trade_type;                     // byte 25
  UINT64 last_px;                       // bytes 26 to 33, signed, read here as unsigned
  UINT32 last_qty;                      // bytes 34 to 37
  UINT64 gross_trade_amt;               // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                    // byte 46
  UINT8 market_mechanism;               // byte 47
  UINT8 algo_flag;                      // byte 48
  UINT8 buyer_bolsa_code;               // byte 49
  UINT32 settl_date;                    // bytes 50 to 53, signed, read here as unsigned
  UINT8 transaction_category;           // byte 54
  UINT8 last_change_flag;               // byte 55
  UINT8 benc_rfpt_flag;                 // byte 56
  UINT8 trade_price_condition;          // byte 57
  UINT8 pre_trade_transparency_waiver;  // byte 58
  UINT8 deferral_waiver;                // byte 59
  UINT64 publish_date_and_time;         // bytes 60 to 67, signed, read here as unsigned
  UINT64 trade_date;                    // bytes 68 to 75, signed, read here as unsigned
  UINT32 trade_session_date;            // bytes 76 to 79, signed, read here as unsigned
  UINT64 volume_float;                  // bytes 80 to 87
  UINT8 sicav_fund_counterparty_side;   // byte 88
  UINT8 amended_trade_type;             // byte 89
  UINT32 exec_ref_id;                   // bytes 90 to 93
  UINT32 amended_trade_date;            // bytes 94 to 97, signed, read here as unsigned
} TradeTradeAmendmentOrCancellationMessage;

// Used by the server to communicate trade information related to trades resulting from order matching. The message also contains the situation in which the relevant orders will remain in the books
typedef struct _TradeMarketPostTransparencyInformationFullDepthMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 market_segment_id[4];        // bytes 16 to 19
  UINT8 trading_session_id;          // byte 20
  UINT32 trd_match_id;               // bytes 21 to 24
  UINT8 trade_type;                  // byte 25
  UINT64 last_px;                    // bytes 26 to 33, signed, read here as unsigned
  UINT32 last_qty;                   // bytes 34 to 37
  UINT64 gross_trade_amt;            // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                 // byte 46
  UINT8 market_mechanism;            // byte 47
  UINT8 algo_flag;                   // byte 48
  UINT8 buyer_bolsa_code;            // byte 49
  UINT32 settl_date;                 // bytes 50 to 53, signed, read here as unsigned
  UINT8 transaction_category;        // byte 54
  UINT32 secondary_order_id;         // bytes 55 to 58
  UINT32 entry_date;                 // bytes 59 to 62, signed, read here as unsigned
  UINT32 priority;                   // bytes 63 to 66
  UINT64 price;                      // bytes 67 to 74, signed, read here as unsigned
  UINT32 display_qty;                // bytes 75 to 78
  UINT8 retail_flag;                 // byte 79
  UINT32 secondary_order_id_2;       // bytes 80 to 83
  UINT32 entry_date_2;               // bytes 84 to 87, signed, read here as unsigned
  UINT32 priority_2;                 // bytes 88 to 91
  UINT64 price_2;                    // bytes 92 to 99, signed, read here as unsigned
  UINT32 display_qty_2;              // bytes 100 to 103
  UINT8 retail_flag_2;               // byte 104
} TradeMarketPostTransparencyInformationFullDepthMessage;

// Used by the UDP Servers to communicate Top-of-book price information during auctions. When there is an indicative match price, the fields BidPx1 and AskPx1 will have the same value
typedef struct _TopOfBookMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT16 bid_orders_1;               // bytes 16 to 17
  UINT32 bid_size_1;                 // bytes 18 to 21
  UINT64 bid_px_1;                   // bytes 22 to 29, signed, read here as unsigned
  UINT16 ask_orders_1;               // bytes 30 to 31
  UINT32 ask_size_1;                 // bytes 32 to 35
  UINT64 ask_px_1;                   // bytes 36 to 43, signed, read here as unsigned
} TopOfBookMessage;

// Sent by the client to set default attributes for subsequent orders and quotes. Please note that in Fixed Income it is possible to enter orders on behalf of other members (AccountMember), based on the corresponding brokerage permissions
typedef struct _OrderAndQuoteClientDataMessage {
  UINT32 request_id;                   // bytes 0 to 3
  UINT16 client_data_id;               // bytes 4 to 5
  UINT8 algorithmic_trade_indicator;   // byte 6
  UINT32 client_id;                    // bytes 7 to 10
  UINT8 account_bolsa[16];             // bytes 11 to 26
  UINT8 account[5];                    // bytes 27 to 31
  UINT8 dea_flag;                      // byte 32
  UINT32 decisor_id;                   // bytes 33 to 36
  UINT32 executor_id;                  // bytes 37 to 40
  UINT8 liquidity_provision_activity;  // byte 41
  UINT8 give_in_member[4];             // bytes 42 to 45
  UINT8 firm_mnemonic[10];             // bytes 46 to 55
  UINT8 alloc_text[18];                // bytes 56 to 73
  UINT8 last_capacity;                 // byte 74
  UINT16 self_match_prevention_id;     // bytes 75 to 76
  UINT8 automatic_order_filter_flag;   // byte 77
  UINT8 received_dept_id;              // byte 78
  UINT8 persistence;                   // byte 79
  UINT8 account_type;                  // byte 80
  UINT8 self_match_prevention_type;    // byte 81
  UINT8 client_data_reference[15];     // bytes 82 to 96
} OrderAndQuoteClientDataMessage;

// Message sent by the client to enter a new order
typedef struct _SimpleNewOrderMessage {
  UINT32 request_id;      // bytes 0 to 3
  UINT32 security_code;   // bytes 4 to 7
  UINT16 client_data_id;  // bytes 8 to 9
  UINT32 order_id;        // bytes 10 to 13
  UINT8 side;             // byte 14
  UINT64 price;           // bytes 15 to 22, signed, read here as unsigned
  UINT32 order_qty;       // bytes 23 to 26
  UINT8 time_in_force;    // byte 27
  UINT8 order_placement;  // byte 28
} SimpleNewOrderMessage;

// Message sent by the client to enter a new order and, at the same time, the values for the Client Data parmeters. Note that no ClientDataID may be assigned
typedef struct _SimpleNewOrderWithClientDataMessage {
  UINT32 request_id;                   // bytes 0 to 3
  UINT32 security_code;                // bytes 4 to 7
  UINT32 order_id;                     // bytes 8 to 11
  UINT8 side;                          // byte 12
  UINT64 price;                        // bytes 13 to 20, signed, read here as unsigned
  UINT32 order_qty;                    // bytes 21 to 24
  UINT8 time_in_force;                 // byte 25
  UINT8 order_placement;               // byte 26
  UINT8 algorithmic_trade_indicator;   // byte 27
  UINT32 client_id;                    // bytes 28 to 31
  UINT8 account_bolsa[16];             // bytes 32 to 47
  UINT8 account[5];                    // bytes 48 to 52
  UINT8 dea_flag;                      // byte 53
  UINT32 decisor_id;                   // bytes 54 to 57
  UINT32 executor_id;                  // bytes 58 to 61
  UINT8 liquidity_provision_activity;  // byte 62
  UINT8 give_in_member[4];             // bytes 63 to 66
  UINT8 firm_mnemonic[10];             // bytes 67 to 76
  UINT8 alloc_text[18];                // bytes 77 to 94
  UINT8 last_capacity;                 // byte 95
  UINT16 self_match_prevention_id;     // bytes 96 to 97
  UINT8 automatic_order_filter_flag;   // byte 98
  UINT8 received_dept_id;              // byte 99
  UINT8 persistence;                   // byte 100
  UINT8 account_type;                  // byte 101
  UINT8 self_match_prevention_type;    // byte 102
  UINT8 client_data_reference[15];     // bytes 103 to 117
} SimpleNewOrderWithClientDataMessage;

// Message sent by the client to modify an order. The field OrderID must contain the client reference of the order that is to be modified
typedef struct _SimpleOrderModificationMessage {
  UINT32 request_id;      // bytes 0 to 3
  UINT32 security_code;   // bytes 4 to 7
  UINT32 order_id;        // bytes 8 to 11
  UINT8 side;             // byte 12
  UINT64 price;           // bytes 13 to 20, signed, read here as unsigned
  UINT32 order_qty;       // bytes 21 to 24
  UINT16 client_data_id;  // bytes 25 to 26
} SimpleOrderModificationMessage;

// Message sent by the client to modify an order. The field OrderID must contain the client reference of the order that is to be modified
typedef struct _SimpleOrderModificationWithClientDataMessage {
  UINT32 request_id;                   // bytes 0 to 3
  UINT32 security_code;                // bytes 4 to 7
  UINT32 order_id;                     // bytes 8 to 11
  UINT8 side;                          // byte 12
  UINT64 price;                        // bytes 13 to 20, signed, read here as unsigned
  UINT32 order_qty;                    // bytes 21 to 24
  UINT8 algorithmic_trade_indicator;   // byte 25
  UINT32 client_id;                    // bytes 26 to 29
  UINT8 account_bolsa[16];             // bytes 30 to 45
  UINT8 account[5];                    // bytes 46 to 50
  UINT8 dea_flag;                      // byte 51
  UINT32 decisor_id;                   // bytes 52 to 55
  UINT32 executor_id;                  // bytes 56 to 59
  UINT8 liquidity_provision_activity;  // byte 60
  UINT8 give_in_member[4];             // bytes 61 to 64
  UINT8 firm_mnemonic[10];             // bytes 65 to 74
  UINT8 alloc_text[18];                // bytes 75 to 92
  UINT8 last_capacity;                 // byte 93
  UINT16 self_match_prevention_id;     // bytes 94 to 95
  UINT8 automatic_order_filter_flag;   // byte 96
  UINT8 received_dept_id;              // byte 97
  UINT8 persistence;                   // byte 98
  UINT8 account_type;                  // byte 99
  UINT8 self_match_prevention_type;    // byte 100
  UINT8 client_data_reference[15];     // bytes 101 to 115
} SimpleOrderModificationWithClientDataMessage;

// Message sent by the client to cancel an order. The field OrderID must contain a reference to the order that is to be cancelled
typedef struct _OrderCancellationRequestMessage {
  UINT32 request_id;     // bytes 0 to 3
  UINT32 security_code;  // bytes 4 to 7
  UINT32 order_id;       // bytes 8 to 11
} OrderCancellationRequestMessage;

// Message sent by the client application to create a new quote. A new quote by the same user on the same SecurityCode and with the same ClientDataID cancels the previous one
typedef struct _NewQuoteMessage {
  UINT32 request_id;      // bytes 0 to 3
  UINT32 security_code;   // bytes 4 to 7
  UINT16 client_data_id;  // bytes 8 to 9
  UINT32 bid_size_1;      // bytes 10 to 13
  UINT64 bid_px_1;        // bytes 14 to 21, signed, read here as unsigned
  UINT32 ask_size_1;      // bytes 22 to 25
  UINT64 ask_px_1;        // bytes 26 to 33, signed, read here as unsigned
} NewQuoteMessage;

// Message sent by the client to modify a quote. Field ClientDataID is required in RF to identify a quote
typedef struct _QuoteModificationRequestMessage {
  UINT32 request_id;      // bytes 0 to 3
  UINT32 security_code;   // bytes 4 to 7
  UINT16 client_data_id;  // bytes 8 to 9
  UINT64 bid_px_1;        // bytes 10 to 17, signed, read here as unsigned
  UINT64 ask_px_1;        // bytes 18 to 25, signed, read here as unsigned
} QuoteModificationRequestMessage;

// Message sent by the client to cancel a quote
typedef struct _QuoteCancellationRequestMessage {
  UINT32 request_id;      // bytes 0 to 3
  UINT32 security_code;   // bytes 4 to 7
  UINT16 client_data_id;  // bytes 8 to 9
} QuoteCancellationRequestMessage;

// Message sent by the client to request the cancellation of multiple orders and or quotes, based on the specified selection criteria
typedef struct _MassOrderquoteCancellationMessage {
  UINT32 request_id;            // bytes 0 to 3
  UINT32 security_code;         // bytes 4 to 7
  UINT8 side;                   // byte 8
  UINT8 issuer[12];             // bytes 9 to 20
  UINT8 account_bolsa[16];      // bytes 21 to 36
  UINT8 order_or_quote_cancel;  // byte 37
} MassOrderquoteCancellationMessage;

// Sent by the server to confirm an Order and Quote Client Data Parameters message
typedef struct _OrderAndQuoteClientDataParametersAckNackMessage {
  UINT32 sequence_number;              // bytes 0 to 3
  UINT32 request_id;                   // bytes 4 to 7
  UINT8 status;                        // byte 8
  UINT16 client_data_id;               // bytes 9 to 10
  UINT8 algorithmic_trade_indicator;   // byte 11
  UINT32 client_id;                    // bytes 12 to 15
  UINT8 account_bolsa[16];             // bytes 16 to 31
  UINT8 account[5];                    // bytes 32 to 36
  UINT8 dea_flag;                      // byte 37
  UINT32 decisor_id;                   // bytes 38 to 41
  UINT32 executor_id;                  // bytes 42 to 45
  UINT8 liquidity_provision_activity;  // byte 46
  UINT8 give_in_member[4];             // bytes 47 to 50
  UINT8 firm_mnemonic[10];             // bytes 51 to 60
  UINT8 alloc_text[18];                // bytes 61 to 78
  UINT8 last_capacity;                 // byte 79
  UINT16 self_match_prevention_id;     // bytes 80 to 81
  UINT8 automatic_order_filter_flag;   // byte 82
  UINT8 received_dept_id;              // byte 83
  UINT8 persistence;                   // byte 84
  UINT8 account_type;                  // byte 85
  UINT8 self_match_prevention_type;    // byte 86
  UINT8 client_data_reference[15];     // bytes 87 to 101
} OrderAndQuoteClientDataParametersAckNackMessage;

// Sent by the server to inform about the order status. Please note that the first fields of this message are the same as the ones for Order Market Pre- Transparency Information (Msg Type = 0x03) (see section 5.4.12)
typedef struct _SimpleOrderStatusMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 entry_date;                 // bytes 20 to 23, signed, read here as unsigned
  UINT8 side;                        // byte 24
  UINT32 priority;                   // bytes 25 to 28
  UINT64 price;                      // bytes 29 to 36, signed, read here as unsigned
  UINT32 display_qty;                // bytes 37 to 40
  UINT32 order_id;                   // bytes 41 to 44
  UINT32 secondary_exec_id;          // bytes 45 to 48
  UINT32 order_qty;                  // bytes 49 to 52
  UINT8 ord_status;                  // byte 53
  UINT8 ord_rej_reason;              // byte 54
  UINT8 exec_type;                   // byte 55
  UINT32 request_id;                 // bytes 56 to 59
  UINT16 client_data_id;             // bytes 60 to 61
} SimpleOrderStatusMessage;

// Sent by the server to inform about the status of a Quote
typedef struct _QuoteStatusMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT32 secondary_order_id;         // bytes 16 to 19
  UINT32 secondary_order_id_2;       // bytes 20 to 23
  UINT32 priority;                   // bytes 24 to 27
  UINT64 price;                      // bytes 28 to 35, signed, read here as unsigned
  UINT32 display_qty;                // bytes 36 to 39
  UINT32 priority_2;                 // bytes 40 to 43
  UINT64 price_2;                    // bytes 44 to 51, signed, read here as unsigned
  UINT32 display_qty_2;              // bytes 52 to 55
  UINT32 order_id;                   // bytes 56 to 59
  UINT32 secondary_exec_id;          // bytes 60 to 63
  UINT32 order_qty;                  // bytes 64 to 67
  UINT8 ord_status;                  // byte 68
  UINT8 ord_rej_reason;              // byte 69
  UINT8 exec_type;                   // byte 70
  UINT32 order_id_2;                 // bytes 71 to 74
  UINT32 secondary_exec_id_2;        // bytes 75 to 78
  UINT32 order_qty_2;                // bytes 79 to 82
  UINT8 ord_status_2;                // byte 83
  UINT8 ord_rej_reason_2;            // byte 84
  UINT8 exec_type_2;                 // byte 85
  UINT32 request_id;                 // bytes 86 to 89
  UINT16 client_data_id;             // bytes 90 to 91
} QuoteStatusMessage;

// Sent by the server to inform about the rejection of a Simple order modification (MsgType = 0x47) or an Order cancellation request (MsgType = 0x46)
typedef struct _OrderCancelRejectMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT64 transaction_date_and_time;  // bytes 4 to 11, signed, read here as unsigned
  UINT32 order_id;                   // bytes 12 to 15
  UINT8 ord_status;                  // byte 16
  UINT8 cxl_rej_response_to;         // byte 17
  UINT8 cxl_rej_reason;              // byte 18
  UINT32 request_id;                 // bytes 19 to 22
} OrderCancelRejectMessage;

// Message reporting the completion of a valid mass order cancellation request. More than one message may be sent for a single RequestID
typedef struct _MassOrderquoteCancellationCompletionMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT64 transaction_date_and_time;  // bytes 4 to 11, signed, read here as unsigned
  UINT8 trading_unit;                // byte 12
  UINT8 order_or_quote_cancel;       // byte 13
  UINT32 request_id;                 // bytes 14 to 17
} MassOrderquoteCancellationCompletionMessage;

// Message reporting the rejection of a mass order cancellation request. More than one message may be sent for a single RequestID
typedef struct _MassOrderquoteCancellationRejectMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT64 transaction_date_and_time;  // bytes 4 to 11, signed, read here as unsigned
  UINT8 trading_unit;                // byte 12
  UINT8 mass_cancel_reject_reason;   // byte 13
} MassOrderquoteCancellationRejectMessage;

// It may be sent by the server to inform about the rejection of a supported message that is syntactically correct in an unsupported situation
typedef struct _BusinessMessageRejectMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT64 transaction_date_and_time;  // bytes 4 to 11, signed, read here as unsigned
  UINT8 ref_msg_type;                // byte 12
  UINT8 business_reject_reason;      // byte 13
  UINT8 text_c_65[65];               // bytes 14 to 78
  UINT32 request_id;                 // bytes 79 to 82
} BusinessMessageRejectMessage;

// Sent by the server to inform about a trade where two orders of the user are involved both as Buyer and Seller
typedef struct _ExecutionPrivateInformation2LegsMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT32 security_code;              // bytes 4 to 7
  UINT64 transaction_date_and_time;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 market_segment_id[4];        // bytes 16 to 19
  UINT8 trading_session_id;          // byte 20
  UINT32 trd_match_id;               // bytes 21 to 24
  UINT8 trade_type;                  // byte 25
  UINT64 last_px;                    // bytes 26 to 33, signed, read here as unsigned
  UINT32 last_qty;                   // bytes 34 to 37
  UINT64 gross_trade_amt;            // bytes 38 to 45, signed, read here as unsigned
  UINT8 designation;                 // byte 46
  UINT8 market_mechanism;            // byte 47
  UINT8 algo_flag;                   // byte 48
  UINT8 buyer_bolsa_code;            // byte 49
  UINT32 settl_date;                 // bytes 50 to 53, signed, read here as unsigned
