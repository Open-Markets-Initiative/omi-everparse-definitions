#define ORD_REJ_REASON_2_PRIORITY_CHANGE_DUE_TO_BOTH_PRICE_AND_CLIENT_ACCOUNT 0x52            // Priority Change Due To Both Price And Client Account
#define ORD_REJ_REASON_2_PRIORITY_CHANGE_DUE_TO_BOTH_VOLUME_INCREASE_AND_CLIENT_ACCOUNT 0x53  // Priority Change Due To Both Volume Increase And Client Account
#define ORD_REJ_REASON_2_MODIFICATION_WITHOUT_PRIORITY_CHANGE 0x54                            // Modification Without Priority Change
#define ORD_REJ_REASON_2_STOP_ORDER_TRIGGERED_AT_THE_CLOSE_ORDER_ACTIVATION 0x55              // Stop Order Triggered At The Close Order Activation
#define ORD_REJ_REASON_2_NOT_A_MEMBER_OF_PIT 0x56                                             // Not A Member Of Pit
#define ORD_REJ_REASON_2_NEW_VOLUME_SHOWN 0x59                                                // New Volume Shown
#define ORD_REJ_REASON_2_NOT_EXECUTED_DUE_TO_EXCEDED_VOLUME_CAP 0x71                          // Not Executed Due To Exceded Volume Cap

// Exec Type 2: one byte code
#define EXEC_TYPE_2_NEW_ORDER_CONFIRMATION 0x41  // New Order Confirmation
#define EXEC_TYPE_2_ORDER_CANCELLATION 0x42      // Order Cancellation
#define EXEC_TYPE_2_ORDER_MODIFICATION 0x4D      // Order Modification
#define EXEC_TYPE_2_ORDER_REFRESH 0x52           // Order Refresh
#define EXEC_TYPE_2_ORDER_REJECTION 0x38         // Order Rejection
#define EXEC_TYPE_2_EXPIRED_ORDER 0x58           // Expired Order
#define EXEC_TYPE_2_ORDER_STATUS 0x57            // Order Status

// Cxl Rej Response To: one byte code
#define CXL_REJ_RESPONSE_TO_SIMPLE_ORDER_MODIFICATION 0x31   // Simple Order Modification
#define CXL_REJ_RESPONSE_TO_ORDER_CANCELLATION_REQUEST 0x32  // Order Cancellation Request

// Cxl Rej Reason: one byte code
#define CXL_REJ_REASON_BY_TRADER 0x31                                                     // By Trader
#define CXL_REJ_REASON_BY_SUPERVISOR 0x33                                                 // By Supervisor
#define CXL_REJ_REASON_VOLUME_MODIFICATION_INCORRECT_NEW_VOLUME_TOTAL_VOLUME_FILLED 0x34  // Volume Modification Incorrect New Volume Total Volume Filled
#define CXL_REJ_REASON_NOT_EXECUTED_IMMEDIATELY 0x35                                      // Not Executed Immediately
#define CXL_REJ_REASON_SECURITY_NOT_CURRENT_OR_NOT_TRADEABLE_FOR_THIS_MEMBER 0x36         // Security Not Current Or Not Tradeable For This Member
#define CXL_REJ_REASON_BY_LIMITS 0x37                                                     // By Limits
#define CXL_REJ_REASON_CANCELLED_BY_MARKET_STATUS 0x38                                    // Cancelled By Market Status
#define CXL_REJ_REASON_INVALID_DATA 0x39                                                  // Invalid Data
#define CXL_REJ_REASON_DISCONNECTION_OF_THE_CLIENT_APPLICATION 0x45                       // Disconnection Of The Client Application
#define CXL_REJ_REASON_QUOTE_PARAMETERS_MISSING 0x46                                      // Quote Parameters Missing
#define CXL_REJ_REASON_BY_PERMISSIONS 0x47                                                // By Permissions
#define CXL_REJ_REASON_QUOTE_OR_CL_ORD_ID_INCORRECT 0x48                                  // Quote Or Cl Ord Id Incorrect
#define CXL_REJ_REASON_QUOTE_CANCELLED_BY_SUBSTITUTION 0x51                               // Quote Cancelled By Substitution
#define CXL_REJ_REASON_NOT_PRICES_FOR_PROCESSING_THE_ORDER 0x57                           // Not Prices For Processing The Order
#define CXL_REJ_REASON_BY_END_OF_VALIDITY_OF_THE_ORDER 0x58                               // By End Of Validity Of The Order
#define CXL_REJ_REASON_OTHER 0x5A                                                         // Other
#define CXL_REJ_REASON_NOT_AUTHORIZED 0x61                                                // Not Authorized
#define CXL_REJ_REASON_BY_MINIMUM_TRADING_VOLUME 0x62                                     // By Minimum Trading Volume
#define CXL_REJ_REASON_PRICE_NOT_ACCORDING_TO_THE_SIZE_TYPOLOGY 0x63                      // Price Not According To The Size Typology
#define CXL_REJ_REASON_THE_ORDER_VOLUMEMUST_BE_A_MULTIPLE_OF_THE_TRADING_LOT_SIZE 0x64    // The Order Volumemust Be A Multiple Of The Trading Lot Size
#define CXL_REJ_REASON_ORDER_REJECTED_FOR_TRIGGERING_AUCTION 0x65                         // Order Rejected For Triggering Auction
#define CXL_REJ_REASON_BY_QUANTITY_TO_BE_DISPLAYED 0x66                                   // By Quantity To Be Displayed
#define CXL_REJ_REASON_INCORRECT_PRICE 0x67                                               // Incorrect Price
#define CXL_REJ_REASON_INCORRECT_VOLUME 0x68                                              // Incorrect Volume
#define CXL_REJ_REASON_INCORRECT_DATE 0x69                                                // Incorrect Date
#define CXL_REJ_REASON_IOC_ORDER_FAILS_THE_AUTHORIZED_TRADER_FILTER 0x6A                  // Ioc Order Fails The Authorized Trader Filter
#define CXL_REJ_REASON_BY_CONTRACT_STATUS 0x6B                                            // By Contract Status
#define CXL_REJ_REASON_KILL_BUTTON 0x6D                                                   // Kill Button
#define CXL_REJ_REASON_INVALID_ORK_FIELDS 0x78                                            // Invalid Ork Fields

// Mass Cancel Reject Reason: one byte code
#define MASS_CANCEL_REJECT_REASON_NO_PERMISSION 0x47                      // No Permission
#define MASS_CANCEL_REJECT_REASON_CANCELLED_BECAUSE_OF_MARKET_STATE 0x38  // Cancelled Because Of Market State
#define MASS_CANCEL_REJECT_REASON_INVALID_DATA 0x39                       // Invalid Data

// Business Reject Reason: one byte code
#define BUSINESS_REJECT_REASON_OTHER 0x00                     // Other
#define BUSINESS_REJECT_REASON_UNSUPPORTED_MESSAGE_TYPE 0x03  // Unsupported Message Type
#define BUSINESS_REJECT_REASON_INVALID_CLIENT_DATA_ID 0x1E    // Invalid Client Data Id
#define BUSINESS_REJECT_REASON_SPONSORED_ACCESS 0x1F          // Sponsored Access
#define BUSINESS_REJECT_REASON_QUOTE_OPERATION_REJECTED 0x20  // Quote Operation Rejected
#define BUSINESS_REJECT_REASON_INVALID_SECURITY 0x21          // Invalid Security

// Ccp Code: one byte code
#define CCP_CODE_BME_CLEARING_OTHERS_TO_BE_DEFINED 0x31  // Bme Clearing Others To Be Defined

// Aggressor Indicator: one byte code
#define AGGRESSOR_INDICATOR_PASSIVE 0x50    // Passive
#define AGGRESSOR_INDICATOR_AGGRESIVE 0x41  // Aggresive

// Ccp Code 2: one byte code
#define CCP_CODE_2_BME_CLEARING_OTHERS_TO_BE_DEFINED 0x31  // Bme Clearing Others To Be Defined

// Aggressor Indicator 2: one byte code
#define AGGRESSOR_INDICATOR_2_PASSIVE 0x50     // Passive
#define AGGRESSOR_INDICATOR_2_AGGRESSIVE 0x41  // Aggressive

// Bolsa Code: one byte code
#define BOLSA_CODE_VALENCIA 0x33   // Valencia
#define BOLSA_CODE_BARCELONA 0x34  // Barcelona
#define BOLSA_CODE_BILBAO 0x35     // Bilbao
#define BOLSA_CODE_MADRID 0x36     // Madrid

// Algorithmic Trade Indicator 2: one byte code
#define ALGORITHMIC_TRADE_INDICATOR_2_FALSE 0x00  // False
#define ALGORITHMIC_TRADE_INDICATOR_2_TRUE 0x01   // True

// Dea Flag 2: one byte code
#define DEA_FLAG_2_FALSE 0x00  // False
#define DEA_FLAG_2_TRUE 0x01   // True

// Liquidity Provision Activity 2: one byte code
#define LIQUIDITY_PROVISION_ACTIVITY_2_FALSE 0x00  // False
#define LIQUIDITY_PROVISION_ACTIVITY_2_TRUE 0x01   // True

// Last Capacity 2: one byte code
#define LAST_CAPACITY_2_DEALING_ON_OWN_ACCOUNT 0x44             // Dealing On Own Account
#define LAST_CAPACITY_2_MATCHED_PRINCIPAL 0x4D                  // Matched Principal
#define LAST_CAPACITY_2_ANY_OTHER_TRADING_CAPACITY_BLANCO 0x41  // Any Other Trading Capacity Blanco

// Automatic Order Filter Flag 2: one byte code
#define AUTOMATIC_ORDER_FILTER_FLAG_2_FOR_ORDERS_ENTERED_BY_AN_AUTHORIZED_TRADER 0x32      // For Orders Entered By An Authorized Trader
#define AUTOMATIC_ORDER_FILTER_FLAG_2_FOR_AUTHORIZED_ARBITRATION_ORDERS 0x67               // For Authorized Arbitration Orders
#define AUTOMATIC_ORDER_FILTER_FLAG_2_FOR_ORDERS_NOT_ENTERED_BY_AN_AUTHORIZED_TRADER 0x43  // For Orders Not Entered By An Authorized Trader

// Received Dept Id 2: one byte code
#define RECEIVED_DEPT_ID_2_ORDERS_PLACED_THROUGH_THE_INTERNET 0x49               // Orders Placed Through The Internet
#define RECEIVED_DEPT_ID_2_ORDERS_PLACED_THROUGH_THE_BANK_BRANCH_NETWORK 0x42    // Orders Placed Through The Bank Branch Network
#define RECEIVED_DEPT_ID_2_ORDERS_PLACED_THROUGH_AUTOMATIC_TRADING_SYSTEMS 0x54  // Orders Placed Through Automatic Trading Systems
#define RECEIVED_DEPT_ID_2_ORDERS_PLACED_BY_IMPORTANT_CLIENTS 0x43               // Orders Placed By Important Clients
#define RECEIVED_DEPT_ID_2_OTHERS 0x4F                                           // Others
#define RECEIVED_DEPT_ID_2_NA_WORKSTATION 0x20                                   // Na Workstation

// Persistence 2: one byte code
#define PERSISTENCE_2_CANCEL_ON_DISCONNECTION 0x43   // Cancel On Disconnection
#define PERSISTENCE_2_PERSIST_ON_DISCONNECTION 0x50  // Persist On Disconnection

// Account Type 2: one byte code
#define ACCOUNT_TYPE_2_RETAIL_SERVICE_SPECIALIST 0x39                    // Retail Service Specialist
#define ACCOUNT_TYPE_2_ON_BEHALF_OF_THIRD_PARTIES 0x41                   // On Behalf Of Third Parties
#define ACCOUNT_TYPE_2_HOUSE_TRADER 0x50                                 // House Trader
#define ACCOUNT_TYPE_2_SPECIALIST 0x45                                   // Specialist
#define ACCOUNT_TYPE_2_RETAIL_CUSTOMER_SUPPORTED_FOR_COMPATIBILITY 0x38  // Retail Customer Supported For Compatibility

// Self Match Prevention Type 2: one byte code
#define SELF_MATCH_PREVENTION_TYPE_2_NA_OR_DEFAULT_BEHAVIOUR_AGGRESSIVE_ORDER_IS_REJECTED 0x20  // Na Or Default Behaviour Aggressive Order Is Rejected
#define SELF_MATCH_PREVENTION_TYPE_2_REJECT_AGGRESSIVE_ORDER 0x31                               // Reject Aggressive Order
#define SELF_MATCH_PREVENTION_TYPE_2_CANCEL_PASIVE_ORDER 0x32                                   // Cancel Pasive Order
#define SELF_MATCH_PREVENTION_TYPE_2_CANCEL_BOTH_PASSIVE_AND_AGGRESSIVE_ORDER 0x33              // Cancel Both Passive And Aggressive Order
#define SELF_MATCH_PREVENTION_TYPE_2_NO_ORDER_CANCELLED 0x34                                    // No Order Cancelled

// Bolsa Code 2: one byte code
#define BOLSA_CODE_2_VALENCIA 0x33   // Valencia
#define BOLSA_CODE_2_BARCELONA 0x34  // Barcelona
#define BOLSA_CODE_2_BILBAO 0x35     // Bilbao
#define BOLSA_CODE_2_MADRID 0x36     // Madrid

// ---- Types -------------------------------------------------------------------

// The Logon Response message is used by the Server to accept a new session. In this message the sequence number will always be 0
typedef struct _LogonResponseMessage {
  UINT32 sequence_number;           // bytes 0 to 3
  UINT8 heart_bt_int;               // byte 4
  UINT8 protocol_version[6];        // bytes 5 to 10
  UINT8 test_production_ind;        // byte 11
  UINT8 environment_code[2];        // bytes 12 to 13
  UINT32 session_date;              // bytes 14 to 17, signed, read here as unsigned
  UINT32 expected_sequence_number;  // bytes 18 to 21
  UINT32 sequence_number_to;        // bytes 22 to 25
} LogonResponseMessage;

// The Logout message is used by the Server to notify the end of a session, whether it is solicited or unsolicited. It may also be the answer to a failed logon attempt (see Logon message)
typedef struct _LogoutResponseMessage {
  UINT32 sequence_number;  // bytes 0 to 3
  UINT8 logout_reason;     // byte 4
} LogoutResponseMessage;

// The Heartbeat message is used by the Server to indicate that the communication is active. In the Heartbeat message, the SequenceNumber of the previously received message will be repeated
typedef struct _HeartbeatMessage {
  UINT32 sequence_number;  // bytes 0 to 3
} HeartbeatMessage;

// Message sent by the server with information about the connectivity between the Server and the central systems. In the Network Status message, the SequenceNumber of the previously received message will be repeated
typedef struct _NetworkStatusMessage {
  UINT32 sequence_number;      // bytes 0 to 3
  UINT8 network_status_value;  // byte 4
} NetworkStatusMessage;

// The Logon message is used to start a session by the client application
typedef struct _LogonMessage {
  UINT8 username[7];                // bytes 0 to 6
  UINT8 password[10];               // bytes 7 to 16
  UINT8 software_name[25];          // bytes 17 to 41
  UINT32 expected_sequence_number;  // bytes 42 to 45
  UINT8 subscriptions;              // byte 46
  UINT8 protocol_version[6];        // bytes 47 to 52
} LogonMessage;

// It may be sent by the server to inform about the rejection of an unsupported or syntactically incorrect message. In the Reject message, the SequenceNumber of the previously received message will be repeated
typedef struct _RejectMessage {
  UINT32 sequence_number;           // bytes 0 to 3
  UINT8 session_reject_reason;      // byte 4
  UINT8 text_c_58[58];              // bytes 5 to 62
  UINT8 msg_rejected_reference[7];  // bytes 63 to 69
} RejectMessage;

// Sent by the server to inform about the session status in each Trading Mode
typedef struct _TradingSessionStatusMessage {
  UINT32 sequence_number;            // bytes 0 to 3
  UINT8 trading_session_id;          // byte 4
  UINT8 trading_session_sub_id;      // byte 5
  UINT8 trad_ses_status;             // byte 6
  UINT64 transaction_date_and_time;  // bytes 7 to 14, signed, read here as unsigned
} TradingSessionStatusMessage;

// Used by the Server to communicate a Market Surveillance or system-wide text message
typedef struct _NewsMessage {
  UINT32 sequence_number;  // bytes 0 to 3
  UINT8 news_text[78];     // bytes 4 to 81
} NewsMessage;

// Message sent by the server for cancelling previously defined securities
typedef struct _SecurityListCancellationReportMessage {
  UINT32 sequence_number;      // bytes 0 to 3
  UINT8 market_id[4];          // bytes 4 to 7
  UINT8 market_segment_id[4];  // bytes 8 to 11
  UINT32 security_code;        // bytes 12 to 15
  UINT8 symbol[22];            // bytes 16 to 37
  UINT8 symbol_isin[12];       // bytes 38 to 49
} SecurityListCancellationReportMessage;

// Repeating group of the Statistics message, one entry per data value, DataCount entries
typedef struct _StatisticsRepeatingGroup {
  UINT8 data_code;    // byte 0
  UINT64 data_value;  // bytes 1 to 8, signed, read here as unsigned
} StatisticsRepeatingGroup;

// Message sent by the server to inform about closing prices and other statistics
typedef struct _StatisticsMessage {
  UINT32 sequence_number;                                                                       // bytes 0 to 3
  UINT32 security_code;                                                                         // bytes 4 to 7
  UINT64 transaction_date_and_time;                                                             // bytes 8 to 15, signed, read here as unsigned
  UINT8 data_count;                                                                             // byte 16
  StatisticsRepeatingGroup statistics_repeating_group[:byte-size (((UINT32) data_count) * 9)];
} StatisticsMessage;

// Message sent by the server to provide the definition of one security. It shares the same layout as the Security List Update Report message, but with a different Message Type
typedef struct _SecurityListMessage {
  UINT32 sequence_number;                              // bytes 0 to 3
  UINT8 market_id[4];                                  // bytes 4 to 7
  UINT8 market_segment_id[4];                          // bytes 8 to 11
  UINT32 security_code;                                // bytes 12 to 15
  UINT8 symbol[22];                                    // bytes 16 to 37
  UINT8 symbol_isin[12];                               // bytes 38 to 49
  UINT8 fisn[35];                                      // bytes 50 to 84
  UINT8 issuer_lei[20];                                // bytes 85 to 104
  UINT8 security_group[2];                             // bytes 105 to 106
  UINT8 cfi_code[6];                                   // bytes 107 to 112
  UINT8 security_type[2];                              // bytes 113 to 114
  UINT32 maturity_date;                                // bytes 115 to 118, signed, read here as unsigned
  UINT32 issue_date;                                   // bytes 119 to 122, signed, read here as unsigned
  UINT64 contract_multiplier;                          // bytes 123 to 130, signed, read here as unsigned
  UINT64 li_spre;                                      // bytes 131 to 138, signed, read here as unsigned
  UINT64 sst_ipre;                                     // bytes 139 to 146, signed, read here as unsigned
  UINT64 li_spost;                                     // bytes 147 to 154, signed, read here as unsigned
  UINT64 sst_ipost;                                    // bytes 155 to 162, signed, read here as unsigned
  UINT8 liquid_instrument;                             // byte 163
  UINT8 admission_requested_by_issuer;                 // byte 164
  UINT32 min_trade_vol;                                // bytes 165 to 168
  UINT32 round_lot;                                    // bytes 169 to 172
  UINT8 currency[3];                                   // bytes 173 to 175
  UINT32 modality_mask_b_4;                            // bytes 176 to 179
  UINT8 security_description[80];                      // bytes 180 to 259
  UINT8 trading_obligation;                            // byte 260
  UINT8 security_name[40];                             // bytes 261 to 300
  UINT8 net_asset_value_identifier[7];                 // bytes 301 to 307
  UINT8 security_sub_type[2];                          // bytes 308 to 309
  UINT8 maturity_month_year[8];                        // bytes 310 to 317
  UINT8 security_status;                               // byte 318
  UINT64 strike_price;                                 // bytes 319 to 326, signed, read here as unsigned
  UINT64 strike_value;                                 // bytes 327 to 334, signed, read here as unsigned
  UINT8 exercise_style;                                // byte 335
  UINT8 put_or_call;                                   // byte 336
  UINT64 position_limit;                               // bytes 337 to 344, signed, read here as unsigned
  UINT64 nt_position_limit;                            // bytes 345 to 352
  UINT8 issuer[12];                                    // bytes 353 to 364
  UINT8 cp_reg_type;                                   // byte 365
  UINT64 barrier;                                      // bytes 366 to 373, signed, read here as unsigned
  UINT32 last_trading_day;                             // bytes 374 to 377, signed, read here as unsigned
  UINT8 automatic_expiration;                          // byte 378
  UINT8 fee_type[2];                                   // bytes 379 to 380
  UINT64 barrier_2;                                    // bytes 381 to 388, signed, read here as unsigned
  UINT64 trigger_barrier;                              // bytes 389 to 396, signed, read here as unsigned
  UINT64 trigger_upper_barrier;                        // bytes 397 to 404, signed, read here as unsigned
  UINT64 average_quarterly_turnover;                   // bytes 405 to 412, signed, read here as unsigned
  UINT8 trading_scope;                                 // byte 413
  UINT8 sicav_counterparty_member[4];                  // bytes 414 to 417
  UINT8 net_asset_value_indicator;                     // byte 418
  UINT8 reference_trading_venue;                       // byte 419
  UINT64 outstanding_capital;                          // bytes 420 to 427, signed, read here as unsigned
  UINT32 first_trading_date;                           // bytes 428 to 431, signed, read here as unsigned
  UINT8 settlement_system;                             // byte 432
  UINT8 number_of_decimals;                            // byte 433
  UINT32 number_of_holders;                            // bytes 434 to 437
  UINT32 outstanding_shares;                           // bytes 438 to 441
  UINT32 minimum_authorized_shares;                    // bytes 442 to 445
  UINT64 minimum_capital;                              // bytes 446 to 453, signed, read here as unsigned
  UINT32 last_admission_date;                          // bytes 454 to 457, signed, read here as unsigned
  UINT64 barrier_return;                               // bytes 458 to 465, signed, read here as unsigned
  UINT8 investment_fund_manager[80];                   // bytes 466 to 545
  UINT64 effective_amount_filters_routed_orders;       // bytes 546 to 553, signed, read here as unsigned
  UINT8 order_number_of_decimals;                      // byte 554
  UINT8 investment_fund_class;                         // byte 555
  UINT8 master_fund_name[80];                          // bytes 556 to 635
  UINT8 investment_fund_management_company[80];        // bytes 636 to 715
  UINT8 investment_fund_depository[80];                // bytes 716 to 795
  UINT8 investment_fund_category[80];                  // bytes 796 to 875
  UINT64 investment_fund_minimum_subscription_amount;  // bytes 876 to 883, signed, read here as unsigned
  UINT64 investment_fund_minimum_maintenance_amount;   // bytes 884 to 891, signed, read here as unsigned
  UINT64 investment_fund_cut_off_time;                 // bytes 892 to 899, signed, read here as unsigned
  UINT8 nav_communication_term;                        // byte 900
  UINT8 investment_fund_number_of_decimals;            // byte 901
  UINT8 commodity_derivative_indicator;                // byte 902
  UINT8 double_volume_cap_reached;                     // byte 903
  UINT64 adt;                                          // bytes 904 to 911, signed, read here as unsigned
  UINT8 base_product[4];                               // bytes 912 to 915
  UINT8 sub_product[4];                                // bytes 916 to 919
  UINT8 further_sub_product[4];                        // bytes 920 to 923
  UINT64 adnt;                                         // bytes 924 to 931, signed, read here as unsigned
  UINT8 price_tick_rule;                               // byte 932
  UINT8 underlying_symbol[22];                         // bytes 933 to 954
  UINT8 underlying_isin[12];                           // bytes 955 to 966
  UINT8 underlying_currency[3];                        // bytes 967 to 969
  UINT32 minimum_display_qty;                          // bytes 970 to 973
  UINT8 retail_service_flag;                           // byte 974
  UINT8 self_match_prevention;                         // byte 975
} SecurityListMessage;

