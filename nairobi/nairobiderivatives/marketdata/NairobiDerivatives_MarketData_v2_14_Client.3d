// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NairobiDerivatives_MarketData_v2_14_Client.3d

// ---- Values ------------------------------------------------------------------

// Client Message Type: one byte code
#define CLIENT_MESSAGE_TYPE_LOG_IN_MESSAGE 0x00                          // Log In Message
#define CLIENT_MESSAGE_TYPE_RE_REQUEST_MESSAGE 0x03                      // Re Request Message
#define CLIENT_MESSAGE_TYPE_LOG_OUT_MESSAGE 0x04                         // Log Out Message
#define CLIENT_MESSAGE_TYPE_REQUEST_DATA_RETRIEVAL_MESSAGE 0x24          // Request Data Retrieval Message
#define CLIENT_MESSAGE_TYPE_REQUEST_DATA_RETRIEVAL_MESSAGE_X25 0x25      // Request Data Retrieval Message
#define CLIENT_MESSAGE_TYPE_UNSUBSCRIBE_CONTRACT_MESSAGE 0x2A            // Unsubscribe Contract Message
#define CLIENT_MESSAGE_TYPE_REQUEST_DAILY_TREND_MESSAGE 0x3D             // Request Daily Trend Message
#define CLIENT_MESSAGE_TYPE_OPTION_CONTRACT_SUBSCRIPTION_MESSAGE 0x43    // Option Contract Subscription Message
#define CLIENT_MESSAGE_TYPE_HEART_BEATS_MESSAGE 0x54                     // Heart Beats Message
#define CLIENT_MESSAGE_TYPE_SUBSCRIBING_TO_INDICES_SERVICE_MESSAGE 0x62  // Subscribing To Indices Service Message
#define CLIENT_MESSAGE_TYPE_FUTURE_CONTRACT_SUBSCRIPTION_MESSAGE 0x63    // Future Contract Subscription Message
#define CLIENT_MESSAGE_TYPE_OPTION_STATISTICS_REQUEST_MESSAGE 0x87       // Option Statistics Request Message

// Data Type: one byte code
#define DATA_TYPE_MARKET_DISPLAY_DATA 0x01      // Market Display Data
#define DATA_TYPE_INSTRUMENTS_DATA 0x02         // Instruments Data
#define DATA_TYPE_CONTRACT_DATES 0x03           // Contract Dates
#define DATA_TYPE_STRIKE_DATA 0x04              // Strike Data
#define DATA_TYPE_MEMBER_DATA 0x0F              // Member Data
#define DATA_TYPE_MTM_DATA 0x10                 // Mtm Data
#define DATA_TYPE_HOLIDAY 0x12                  // Holiday
#define DATA_TYPE_CLEARING_MEMBER_DATA 0x41     // Clearing Member Data
#define DATA_TYPE_EXCHANGE_ANNOUNCEMENTS 0x59   // Exchange Announcements
#define DATA_TYPE_NEWS 0x81                     // News
#define DATA_TYPE_COUPON_INFORMATION 0x83       // Coupon Information
#define DATA_TYPE_TRADING_SESSIONS 0x88         // Trading Sessions
#define DATA_TYPE_INDICES 0x8A                  // Indices
#define DATA_TYPE_INDICES_DATA 0x8B             // Indices Data
#define DATA_TYPE_INSTRUMENT_TYPES 0x27         // Instrument Types
#define DATA_TYPE_INDICES_PRICE_DATA 0x89       // Indices Price Data
#define DATA_TYPE_SHARES_IN_ISSUE_DATA 0x8D     // Shares In Issue Data
#define DATA_TYPE_INDEX_DATA 0x92               // Index Data
#define DATA_TYPE_INDEX_CONSTITUENTS_DATA 0x93  // Index Constituents Data

// Action: 4 byte code
#define ACTION_FILE_DOWNLOAD 0x00000000  // File Download
#define ACTION_DELETE 0x00000001         // Delete
#define ACTION_INSERT 0x00000002         // Insert
#define ACTION_UPDATE 0x00000003         // Update

// ---- Types -------------------------------------------------------------------

// User name as assigned by the exchange
typedef struct _UserName {
  UINT8 user_name_length_byte;     // byte 0
  UINT8 user_name_characters[15];  // bytes 1 to 15
} UserName;

// Time
typedef struct _Time {
  UINT8 hours;     // byte 0
  UINT8 minutes;   // byte 1
  UINT8 seconds;   // byte 2
  UINT8 unused_1;  // byte 3
} Time;

// Log in message.
typedef struct _LogInMessage {
  UINT8 encrypted_password[312];  // bytes 0 to 311
  UINT8 new_password[312];        // bytes 312 to 623
} LogInMessage;

// Re-Request of 59 messages.
typedef struct _ReRequestMessage {
  UINT32 from_sequence;            // bytes 0 to 3, signed, read here as unsigned
  UINT32 to_sequence;              // bytes 4 to 7, signed, read here as unsigned
  UINT32 market_shard_number_i_4;  // bytes 8 to 11, signed, read here as unsigned
} ReRequestMessage;

// Download Date
typedef struct _DownloadDate {
  UINT32 year;   // bytes 0 to 3, signed, read here as unsigned
  UINT32 month;  // bytes 4 to 7, signed, read here as unsigned
  UINT32 day;    // bytes 8 to 11, signed, read here as unsigned
} DownloadDate;

// Allows users to request data from the system.
typedef struct _RequestDataRetrievalMessage {
  UINT8 data_type;             // byte 0
  UINT8 unused_1;              // byte 1
  UINT8 last_piece_of_chunk;   // byte 2
  UINT8 re_request;            // byte 3
  UINT32 action;               // bytes 4 to 7, signed, read here as unsigned
  UINT32 specific_record;      // bytes 8 to 11, signed, read here as unsigned
  DownloadDate download_date;  // bytes 12 to 23
} RequestDataRetrievalMessage;

// Date
typedef struct _Date {
  UINT32 year;   // bytes 0 to 3, signed, read here as unsigned
  UINT32 month;  // bytes 4 to 7, signed, read here as unsigned
  UINT32 day;    // bytes 8 to 11, signed, read here as unsigned
} Date;

// Defines the instrument which represents this contract.
typedef struct _InstrumentNameP5 {
  UINT8 instrument_name_p_5_length_byte;    // byte 0
  UINT8 instrument_name_p_5_characters[4];  // bytes 1 to 4
} InstrumentNameP5;

// Secondary Date
typedef struct _SecondaryDate {
  UINT32 year;   // bytes 0 to 3, signed, read here as unsigned
  UINT32 month;  // bytes 4 to 7, signed, read here as unsigned
  UINT32 day;    // bytes 8 to 11, signed, read here as unsigned
} SecondaryDate;

// For strategy type products such as Product spreads, represents the instrument name of the second leg of the contract.
typedef struct _SecondaryInstrumentNameP5 {
  UINT8 secondary_instrument_name_p_5_length_byte;    // byte 0
  UINT8 secondary_instrument_name_p_5_characters[4];  // bytes 1 to 4
} SecondaryInstrumentNameP5;

// Contract
typedef struct _Contract {
  UINT32 identifier_prefix_i_4;                             // bytes 0 to 3, signed, read here as unsigned
  Date date;                                                // bytes 4 to 15
  InstrumentNameP5 instrument_name_p_5;                     // bytes 16 to 20
  UINT8 strike[8];                                          // bytes 21 to 28
  UINT8 call_put_c_1;                                       // byte 29
  SecondaryDate secondary_date;                             // bytes 30 to 41
  SecondaryInstrumentNameP5 secondary_instrument_name_p_5;  // bytes 42 to 46
  UINT8 is_delta_option;                                    // byte 47
} Contract;

// Contracts to unsubscribe
typedef struct _ContractsToUnsubscribe {
  Contract contract;  // bytes 0 to 47
} ContractsToUnsubscribe;

// Unsubscribe from Display Updates on up to 40 contracts.
typedef struct _UnsubscribeContractMessage {
  UINT16 quantity_i_2;                                               // bytes 0 to 1, signed, read here as unsigned
  ContractsToUnsubscribe contracts_to_unsubscribe[:byte-size 1920];  // bytes 2 to 1921
} UnsubscribeContractMessage;

// Contract Name
typedef struct _ContractName {
  UINT32 identifier_prefix_i_4;                             // bytes 0 to 3, signed, read here as unsigned
  Date date;                                                // bytes 4 to 15
  InstrumentNameP5 instrument_name_p_5;                     // bytes 16 to 20
  UINT8 strike[8];                                          // bytes 21 to 28
  UINT8 call_put_c_1;                                       // byte 29
  SecondaryDate secondary_date;                             // bytes 30 to 41
  SecondaryInstrumentNameP5 secondary_instrument_name_p_5;  // bytes 42 to 46
  UINT8 is_delta_option;                                    // byte 47
} ContractName;

// Request the on screen trade history for a contract for the current trading session.
typedef struct _RequestDailyTrendMessage {
  ContractName contract_name;  // bytes 0 to 47
} RequestDailyTrendMessage;

// Subscribe to Display Updates on the contracts listed.
typedef struct _OptionContractSubscriptionMessage {
  ContractName contract_name;  // bytes 0 to 47
} OptionContractSubscriptionMessage;

// Subscribe or unsubscribe from the indices service.
typedef struct _SubscribingToIndicesServiceMessage {
  UINT8 subscribe;  // byte 0
} SubscribingToIndicesServiceMessage;

// Contracts Requested For Display
typedef struct _ContractsRequestedForDisplay {
  Contract contract;  // bytes 0 to 47
} ContractsRequestedForDisplay;

// Subscribe to Display Updates on up to 40 contracts.
typedef struct _FutureContractSubscriptionMessage {
  UINT16 quantity_i_2;                                                            // bytes 0 to 1, signed, read here as unsigned
  ContractsRequestedForDisplay contracts_requested_for_display[:byte-size 1920];  // bytes 2 to 1921
} FutureContractSubscriptionMessage;

// Request a Display Update with information for all option contracts traded since the beginning of the trading session.
typedef struct _OptionStatisticsRequestMessage {
  ContractName contract_name;  // bytes 0 to 47
} OptionStatisticsRequestMessage;

// Branch
casetype _ClientMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x00: LogInMessage log_in_message;
    case 0x03: ReRequestMessage re_request_message;
    case 0x04: unit log_out_message;
    case 0x24: RequestDataRetrievalMessage request_data_retrieval_message;
    case 0x25: RequestDataRetrievalMessage request_data_retrieval_message_2;
    case 0x2A: UnsubscribeContractMessage unsubscribe_contract_message;
    case 0x3D: RequestDailyTrendMessage request_daily_trend_message;
    case 0x43: OptionContractSubscriptionMessage option_contract_subscription_message;
    case 0x54: unit heart_beats_message;
    case 0x62: SubscribingToIndicesServiceMessage subscribing_to_indices_service_message;
    case 0x63: FutureContractSubscriptionMessage future_contract_subscription_message;
    case 0x87: OptionStatisticsRequestMessage option_statistics_request_message;
    default: UINT8 unknown[available];
  }
} ClientMessagePayload;

// Mits message packet sent by the user
typedef struct _ClientMessage {
  UINT8 start_byte;                                                                                                                                                                  // byte 0
  UINT16 message_length { message_length >= 29 };                                                                                                                                    // bytes 1 to 2
  UINT8 length_check;                                                                                                                                                                // byte 3
  UINT32 sequence_number;                                                                                                                                                            // bytes 4 to 7, signed, read here as unsigned
  UserName user_name;                                                                                                                                                                // bytes 8 to 23
  UINT32 user_number;                                                                                                                                                                // bytes 24 to 27, signed, read here as unsigned
  Time time;                                                                                                                                                                         // bytes 28 to 31
  UINT8 client_message_type;                                                                                                                                                         // byte 32
  ClientMessagePayload(client_message_type, ((((UINT32) message_length) + 4) - 33)) client_message_payload[:byte-size-single-element-array ((((UINT32) message_length) + 4) - 33)];
} ClientMessage;

// ---- Packet: ClientPacket ----------------------------------------------------

// Mits Tcp block of one or more messages sent by the user
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientMessage client_message[:byte-size available];
} ClientPacket;

