  UINT64 volatility;                  // bytes 53 to 60, signed, read here as unsigned
  UINT64 underlying_reference_price;  // bytes 61 to 68, signed, read here as unsigned
} OrderExecutedWithPriceSizeMessage;

// ---- Trade Message: 69 bytes -------------------------------------------------

