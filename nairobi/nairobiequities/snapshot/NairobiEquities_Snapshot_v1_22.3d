} LoginRequestMessage;

// ---- Login Response Message: 1 byte ------------------------------------------

// Used by the server to accept or reject a login request to the Replay or Snapshot channel.
entrypoint typedef struct _LoginResponseMessage {
  UINT8 login_status;  // byte 0
} LoginResponseMessage;

// ---- Snapshot Response Message: 14 bytes -------------------------------------

// Used by the server to respond to a snapshot request on the Snapshot channel.
entrypoint typedef struct _SnapshotResponseMessage {
  UINT32 sequence_number;  // bytes 0 to 3
  UINT32 order_count;      // bytes 4 to 7
  UINT8 snapshot_status;   // byte 8
