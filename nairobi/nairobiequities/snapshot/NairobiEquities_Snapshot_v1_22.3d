// ---- Unit Header: 8 bytes ----------------------------------------------------

// Nairobi Mitch Unit Header, defining the length of a unit, its message count, market data group and first sequence number
entrypoint typedef struct _UnitHeader {
  UINT16 length;            // bytes 0 to 1
