} SystemEventMessage;

// ---- Order Deleted Message: 12 bytes -----------------------------------------

// Sent to indicate that the remainder of a displayed order is cancelled.
entrypoint typedef struct _OrderDeletedMessage {
  UINT32 nanosecond;  // bytes 0 to 3
