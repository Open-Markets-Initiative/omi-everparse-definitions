// Tick-by-tick market data includes tick-by-tick orders and tick-by-tick trades, sent in one data stream in the order they occur. Tick-by-tick order and tick-by-tick trade messages in the same channel share one continuous numbering of the message record number (ApplSeqNum). The client must use the continuity of the tick-by-tick sequence numbers to detect packet loss, and request retransmission over the TCP connection.
typedef struct _Tick_by_TickMarketDataMessage (UINT32 available) where (available >= 45) {
  UINT8 tick_by_tick_market_data_message_security_type;                                                                                                                                                                              // byte 0
  UINT16BE tick_by_tick_market_data_message_channel_n_o;                                                                                                                                                                             // bytes 1 to 2
  UINT64BE appl_seq_num;                                                                                                                                                                                                             // bytes 3 to 10
  UINT32BE m_d_stream_i_d_0;                                                                                                                                                                                                         // bytes 11 to 14, the first 4 of 5 characters a choice is made on
  UINT8 m_d_stream_i_d_1;                                                                                                                                                                                                            // byte 15
  UINT8 security_i_d[8];                                                                                                                                                                                                             // bytes 16 to 23
  UINT32BE transact_time;                                                                                                                                                                                                            // bytes 24 to 27
  UINT8 exec_type;                                                                                                                                                                                                                   // byte 28
  UINT64BE price;                                                                                                                                                                                                                    // bytes 29 to 36
  UINT64BE order_qty;                                                                                                                                                                                                                // bytes 37 to 44
  Tick_by_TickMarketDataMessageExtendFields(((((UINT64) m_d_stream_i_d_0) << 8) | ((UINT64) m_d_stream_i_d_1)), (available - 45)) tick_by_tick_market_data_message_extend_fields[:byte-size-single-element-array (available - 45)];
} Tick_by_TickMarketDataMessage;

// Branch
casetype _MessageBody (UINT32 selector, UINT32 available) {
  switch (selector) {
    case 0x53303031: LogonMessage logon_message;
    case 0x53303032: LogoutMessage logout_message;
    case 0x53303033: unit heartbeat_message;
    case 0x50303031: ChannelHeartbeat channel_heartbeat;
    case 0x50303032: RetransmissionMessage retransmission_message;
    case 0x4D313031: MarketStatusMessage market_status_message;
    case 0x4D313032: MarketDataSnapshotMessage(available) market_data_snapshot_message;
    case 0x4D323031: Tick_by_TickMarketDataMessage(available) tick_by_tick_market_data_message;
    default: UINT8 unknown[available];
  }
} MessageBody;

// The checksum is calculated from the start of the message header (header included) to the end of the message body. See Appendix 1 Calculating the checksum for sample code.
typedef struct _StandardTrailer {
  UINT32BE check_sum;  // bytes 0 to 3
} StandardTrailer;

// BINARY message
typedef struct _BinaryMessage {
  UINT32BE msg_type;                                                                             // bytes 0 to 3
  UINT64BE sending_time;                                                                         // bytes 4 to 11
  UINT64BE msg_seq_num;                                                                          // bytes 12 to 19
  UINT32BE body_length;                                                                          // bytes 20 to 23
  MessageBody(msg_type, body_length) message_body[:byte-size-single-element-array body_length];
  StandardTrailer standard_trailer;
} BinaryMessage;

// ---- Packet: Packet ----------------------------------------------------------

// BINARY messages
entrypoint typedef struct _Packet (UINT32 available) {
  BinaryMessage binary_message[:byte-size available];
} Packet;

