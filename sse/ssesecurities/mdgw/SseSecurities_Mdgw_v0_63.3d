    default: UINT8 unknown[available];
  }
} MarketDataSnapshotMessageExtendFields;

// The market data snapshot message publishes market data for securities. The exchange publishes full snapshot messages periodically and sends incremental snapshot messages when market data changes. Snapshot messages have no data dependency on one another; the client does not need to tell full and incremental messages apart and can replace its current data directly.
typedef struct _MarketDataSnapshotMessage (UINT32 available) where (available >= 71) {
  UINT8 market_data_snapshot_message_security_type;                                                                                                                                                                          // byte 0
  UINT8 trad_ses_mode;                                                                                                                                                                                                       // byte 1
  UINT32BE trade_date;                                                                                                                                                                                                       // bytes 2 to 5
  UINT32BE last_update_time;                                                                                                                                                                                                 // bytes 6 to 9
  UINT32BE m_d_stream_i_d_0;                                                                                                                                                                                                 // bytes 10 to 13, the first 4 of 5 characters a choice is made on
  UINT8 m_d_stream_i_d_1;                                                                                                                                                                                                    // byte 14
  UINT8 security_i_d[8];                                                                                                                                                                                                     // bytes 15 to 22
  UINT8 symbol[8];                                                                                                                                                                                                           // bytes 23 to 30
  UINT64BE pre_close_px;                                                                                                                                                                                                     // bytes 31 to 38
  UINT64BE total_volume_traded;                                                                                                                                                                                              // bytes 39 to 46
  UINT64BE num_trades;                                                                                                                                                                                                       // bytes 47 to 54
  UINT64BE market_data_snapshot_message_total_value_traded;                                                                                                                                                                  // bytes 55 to 62
  UINT8 trading_phase_code[8];                                                                                                                                                                                               // bytes 63 to 70
  MarketDataSnapshotMessageExtendFields(((((UINT64) m_d_stream_i_d_0) << 8) | ((UINT64) m_d_stream_i_d_1)), (available - 71)) market_data_snapshot_message_extend_fields[:byte-size-single-element-array (available - 71)];
} MarketDataSnapshotMessage;

