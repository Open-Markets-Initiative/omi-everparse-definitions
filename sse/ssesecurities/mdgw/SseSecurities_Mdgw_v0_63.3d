// MsgType: 4 byte code
#define MSG_TYPE_LOGON_MESSAGE 0x53303031                     // Logon Message
#define MSG_TYPE_LOGOUT_MESSAGE 0x53303032                    // Logout Message
#define MSG_TYPE_HEARTBEAT_MESSAGE 0x53303033                 // Heartbeat Message
#define MSG_TYPE_CHANNEL_HEARTBEAT 0x50303031                 // Channel Heartbeat
#define MSG_TYPE_RETRANSMISSION_MESSAGE 0x50303032            // Retransmission Message
#define MSG_TYPE_MARKET_STATUS_MESSAGE 0x4D313031             // Market Status Message
#define MSG_TYPE_MARKET_DATA_SNAPSHOT_MESSAGE 0x4D313032      // Market Data Snapshot Message
#define MSG_TYPE_TICK_BY_TICK_MARKET_DATA_MESSAGE 0x4D323031  // Tick-by-Tick Market Data Message

// SessionStatus: 4 byte code
#define SESSION_STATUS_NORMAL_LOGOUT 0x00000000  // Normal logout

// Channel Heartbeat SecurityType: one byte code
#define CHANNEL_HEARTBEAT_SECURITY_TYPE_BONDS_NON_MATCHED_TRADING 0x0D  // Bonds (non-matched trading)

// Channel Heartbeat ChannelNO: 2 byte code
#define CHANNEL_HEARTBEAT_CHANNEL_N_O_NON_MATCHED_TRADING_TICK_BY_TICK_MARKET_DATA 0x0064  // Non-matched trading tick-by-tick market data

// EndOfChannel: one byte code
#define END_OF_CHANNEL_MARKET_DATA_UPDATES_HAVE_ENDED 0x59      // Market data updates have ended
#define END_OF_CHANNEL_MARKET_DATA_UPDATES_HAVE_NOT_ENDED 0x4E  // Market data updates have not ended

// Retransmission Message ChannelNO: 2 byte code
#define RETRANSMISSION_MESSAGE_CHANNEL_N_O_NON_MATCHED_TRADING_TICK_BY_TICK_MARKET_DATA 0x0064  // Non-matched trading tick-by-tick market data

// ResendType: one byte code
#define RESEND_TYPE_TICK_BY_TICK_MARKET_DATA 0x01  // Tick-by-tick market data

// ResendStatus: one byte code
#define RESEND_STATUS_ALL_COMPLETE 0x01                                                    // All complete
#define RESEND_STATUS_PARTIALLY_COMPLETE_PART_OF_THE_REQUESTED_DATA_WAS_NOT_RETURNED 0x02  // Partially complete (part of the requested data was not returned)
#define RESEND_STATUS_NO_PERMISSION 0x03                                                   // No permission
#define RESEND_STATUS_DATA_NOT_AVAILABLE 0x04                                              // Data not available
#define RESEND_STATUS_A_RETRANSMISSION_REQUEST_IS_BEING_PROCESSED 0x05                     // A retransmission request is being processed
#define RESEND_STATUS_OTHER 0x63                                                           // Other

// Market Status Message SecurityType: one byte code
#define MARKET_STATUS_MESSAGE_SECURITY_TYPE_STOCKS_FUNDS_INDICES_AND_BOND_DISTRIBUTION 0x01  // Stocks, funds, indices and bond distribution
#define MARKET_STATUS_MESSAGE_SECURITY_TYPE_DERIVATIVES 0x02                                 // Derivatives
#define MARKET_STATUS_MESSAGE_SECURITY_TYPE_COMPREHENSIVE_BUSINESS 0x03                      // Comprehensive business
#define MARKET_STATUS_MESSAGE_SECURITY_TYPE_BONDS_MATCHED_TRADING 0x0C                       // Bonds (matched trading)
#define MARKET_STATUS_MESSAGE_SECURITY_TYPE_BONDS_NON_MATCHED_TRADING 0x0D                   // Bonds (non-matched trading)
#define MARKET_STATUS_MESSAGE_SECURITY_TYPE_EXTERNAL_SOURCE_MARKET_DATA 0x0E                 // External source market data

// TradSesMode: one byte code
#define TRAD_SES_MODE_SYSTEM_TEST 0x01                // System test
#define TRAD_SES_MODE_SIMULATED_TRADING 0x02          // Simulated trading
#define TRAD_SES_MODE_PRODUCTION_NORMAL_TRADING 0x03  // Production (normal trading)

// Market Data Snapshot Message SecurityType: one byte code
#define MARKET_DATA_SNAPSHOT_MESSAGE_SECURITY_TYPE_STOCKS_FUNDS_INDICES_AND_BOND_DISTRIBUTION 0x01  // Stocks, funds, indices and bond distribution
#define MARKET_DATA_SNAPSHOT_MESSAGE_SECURITY_TYPE_DERIVATIVES 0x02                                 // Derivatives
#define MARKET_DATA_SNAPSHOT_MESSAGE_SECURITY_TYPE_COMPREHENSIVE_BUSINESS 0x03                      // Comprehensive business
#define MARKET_DATA_SNAPSHOT_MESSAGE_SECURITY_TYPE_BONDS_MATCHED_TRADING 0x0C                       // Bonds (matched trading)
#define MARKET_DATA_SNAPSHOT_MESSAGE_SECURITY_TYPE_BONDS_NON_MATCHED_TRADING 0x0D                   // Bonds (non-matched trading)
#define MARKET_DATA_SNAPSHOT_MESSAGE_SECURITY_TYPE_EXTERNAL_SOURCE_MARKET_DATA 0x0E                 // External source market data

// Tick-by-Tick Market Data Message SecurityType: one byte code
#define TICK_BY_TICK_MARKET_DATA_MESSAGE_SECURITY_TYPE_BONDS_NON_MATCHED_TRADING 0x0D  // Bonds (non-matched trading)

// ExecType: one byte code
#define EXEC_TYPE_NEW_ORDER 0x30     // New order
#define EXEC_TYPE_DELETE_ORDER 0x34  // Delete order
#define EXEC_TYPE_TRADE 0x46         // Trade

// Side: one byte code
#define SIDE_BUY 0x31   // Buy
#define SIDE_SELL 0x32  // Sell

// FullAmountTrade: one byte code
#define FULL_AMOUNT_TRADE_YES 0x01  // Yes
#define FULL_AMOUNT_TRADE_NO 0x02   // No

// SettlType: one byte code
#define SETTL_TYPE_NET_SETTLEMENT 0x01  // Net settlement
#define SETTL_TYPE_R_T_G_S 0x02         // RTGS

// BidTransType: one byte code
#define BID_TRANS_TYPE_COMPETITIVE_BIDDING_RESERVATION 0x01                         // Competitive bidding reservation
#define BID_TRANS_TYPE_COMPETITIVE_BIDDING_DECLARATION 0x02                         // Competitive bidding declaration
#define BID_TRANS_TYPE_RESPONSE_PRICE_DECLARATION_FOR_A_SINGLE_WINNING_ENTITY 0x03  // Response price declaration for a single winning entity

// BidExecInstType: one byte code
#define BID_EXEC_INST_TYPE_SINGLE_WINNING_ENTITY 0x01                         // Single winning entity
#define BID_EXEC_INST_TYPE_MULTIPLE_WINNING_ENTITIES_AT_A_SINGLE_PRICE 0x02   // Multiple winning entities at a single price
#define BID_EXEC_INST_TYPE_MULTIPLE_WINNING_ENTITIES_AT_MULTIPLE_PRICES 0x03  // Multiple winning entities at multiple prices

// TradeMethod: one byte code
#define TRADE_METHOD_MATCHED_TRADE_RESERVED 0x00                                 // Matched trade (reserved)
#define TRADE_METHOD_FIRM_QUOTE_CLICK_TRADE 0x01                                 // Firm quote click trade
#define TRADE_METHOD_INDICATIVE_QUOTE_CLICK_TRADE 0x02                           // Indicative quote click trade
#define TRADE_METHOD_INQUIRY_TRADE 0x03                                          // Inquiry trade
#define TRADE_METHOD_NEGOTIATED_TRADE_INCLUDING_MERGED_DECLARATIONS 0x06         // Negotiated trade (including merged declarations)
#define TRADE_METHOD_COMPETITIVE_BIDDING_SINGLE_ENTITY_TRADE 0x07                // Competitive bidding single-entity trade
#define TRADE_METHOD_COMPETITIVE_BIDDING_MULTI_ENTITY_SINGLE_PRICE_TRADE 0x0A    // Competitive bidding multi-entity single-price trade
#define TRADE_METHOD_COMPETITIVE_BIDDING_MULTI_ENTITY_MULTIPLE_PRICE_TRADE 0x0B  // Competitive bidding multi-entity multiple-price trade

// ---- Types -------------------------------------------------------------------

// The client must send this message first when starting a market data session.
typedef struct _LogonMessage {
  UINT8 sender_comp_i_d[32];  // bytes 0 to 31
  UINT8 target_comp_i_d[32];  // bytes 32 to 63
  UINT16BE heart_bt_int;      // bytes 64 to 65
  UINT8 appl_ver_i_d[8];      // bytes 66 to 73
} LogonMessage;

// The logout message starts or confirms the end of a market data session. A disconnection without an exchange of logout messages is treated as an abnormal disconnection. After sending a logout message, neither side of the connection should send any further message.
typedef struct _LogoutMessage {
  UINT32BE session_status;  // bytes 0 to 3
  UINT8 text[256];          // bytes 4 to 259
} LogoutMessage;

// Tick-by-tick market data supports sending a heartbeat every 3 seconds during idle periods of data sending. If data sending stays busy, the channel heartbeat interval can exceed 3s.
typedef struct _ChannelHeartbeat {
  UINT8 channel_heartbeat_security_type;   // byte 0
  UINT16BE channel_heartbeat_channel_n_o;  // bytes 1 to 2
  UINT64BE appl_last_seq_num;              // bytes 3 to 10
  UINT8 end_of_channel;                    // byte 11
} ChannelHeartbeat;

// The retransmission message is used to request market data on a channel that supports retransmission. For application messages that can be retransmitted (all types of tick-by-tick market data messages), if application messages are missing, the user can send a retransmission message upstream, which represents a retransmission request. The upstream handles retransmission requests in a request reply manner: it returns the data to be retransmitted according to the start and end sequence numbers specified in the retransmission message, and after the retransmission is complete it returns a retransmission message reporting that the retransmission is complete; if the retransmission fails, it returns a retransmission message reporting that the retransmission failed. The upstream system supports retransmission of only one message gap at a time; when the upstream receives multiple retransmission requests, it returns a retransmission failure for the other request messages. For tick-by-tick market data, the channel code and the message record number can be used to determine whether messages have been lost. When the message record number received is <= the largest message record number already received on this channel, the message has already been received and should be ignored. When the message record number received is > the largest message record number already received +1 (for example, the largest message record number received is 100 and the new message record number is 102), messages have been lost, and the lost data should be recovered by sending a retransmission request.
typedef struct _RetransmissionMessage {
  UINT16BE retransmission_message_channel_n_o;  // bytes 0 to 1
  UINT8 resend_type;                            // byte 2
  UINT64BE appl_beg_seq_num;                    // bytes 3 to 10
  UINT64BE appl_end_seq_num;                    // bytes 11 to 18
  UINT8 resend_status;                          // byte 19
  UINT8 reject_text[32];                        // bytes 20 to 51
} RetransmissionMessage;

// The market status message is used by the exchange to publish information such as the market status and the number of products. It is published periodically and when the market status changes.
typedef struct _MarketStatusMessage {
  UINT8 market_status_message_security_type;  // byte 0
  UINT8 trad_ses_mode;                        // byte 1
  UINT8 trading_session_i_d[8];               // bytes 2 to 9
  UINT32BE tot_no_related_sym;                // bytes 10 to 13
} MarketStatusMessage;

typedef struct _IndexMarketDataSnapshotEntries {
  UINT8 index_market_data_snapshot_entries_m_d_entry_type[2];  // bytes 0 to 1
  UINT64BE index_market_data_snapshot_entries_m_d_entry_px;    // bytes 2 to 9
} IndexMarketDataSnapshotEntries;

typedef struct _IndexMarketDataSnapshotExtensionFields {
  UINT16BE no_m_d_entries;                                                                                         // bytes 0 to 1
  IndexMarketDataSnapshotEntries index_market_data_snapshot_entries[:byte-size (((UINT32) no_m_d_entries) * 10)];
