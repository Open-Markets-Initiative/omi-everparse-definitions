// ---- Values ------------------------------------------------------------------

// Replay Message Type: 2 byte code
#define REPLAY_MESSAGE_TYPE_REPLAY_REQUEST 0x0001  // Replay Request

// ---- Types -------------------------------------------------------------------

// Message replay request
typedef struct _ReplayRequest {
  UINT32 seq_num;      // bytes 0 to 3
  UINT32 end_seq_num;  // bytes 4 to 7
  UINT8 stream_id;     // byte 8
} ReplayRequest;

// Branch
casetype _ReplayRequestPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0001: ReplayRequest replay_request;
    default: UINT8 unknown[available];
  }
} ReplayRequestPayload;

typedef struct _ReplayRequestMessage {
  UINT16 replay_message_length { replay_message_length >= 4 };                                                                                                                       // bytes 0 to 1
  UINT16 replay_message_type;                                                                                                                                                        // bytes 2 to 3
  ReplayRequestPayload(replay_message_type, (((UINT32) replay_message_length) - 4)) replay_request_payload[:byte-size-single-element-array (((UINT32) replay_message_length) - 4)];
} ReplayRequestMessage;

// ---- Packet: ReplayRequestPacket ---------------------------------------------

// Gpw Wats Replay Request Packet
entrypoint typedef struct _ReplayRequestPacket (UINT32 available) {
  ReplayRequestMessage replay_request_message[:byte-size available];
} ReplayRequestPacket;

