// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Wse_Indices_v6_8.3d

// ---- Values ------------------------------------------------------------------

// Packet Type: 2 byte code
#define PACKET_TYPE_MARKET_DATA_MESSAGES 0x01F5  // Market Data Messages

// Delivery Flag: one byte code
#define DELIVERY_FLAG_REAL_TIME_MESSAGE_UNCOMPRESSED 0x00       // Real Time Message Uncompressed
#define DELIVERY_FLAG_RETRANSMISSION_MESSAGE_UNCOMPRESSED 0x02  // Retransmission Message Uncompressed
#define DELIVERY_FLAG_REAL_TIME_MESSAGE_ZLIB_COMPRESSED 0x10    // Real Time Message Zlib Compressed
#define DELIVERY_FLAG_REFRESH_MESSAGE_ZLIB_COMPRESSED 0x11      // Refresh Message Zlib Compressed
#define DELIVERY_FLAG_RETRANSMISSION_MESSAGE_COMPRESSED 0x12    // Retransmission Message Compressed

// Message Type: 2 byte code
#define MESSAGE_TYPE_REAL_TIME_INDEX_MESSAGE 0x0222  // Real Time Index Message
#define MESSAGE_TYPE_INDEX_SUMMARY_MESSAGE 0x0223    // Index Summary Message
#define MESSAGE_TYPE_INDEX_PORTFOLIO_MESSAGE 0x0224  // Index Portfolio Message

// System Id: 4 byte code
#define SYSTEM_ID_ALL_NON_UTP_SYSTEMS 0x00000001  // All Non Utp Systems
#define SYSTEM_ID_UTP_TRADING_UNIT_1 0x0000000B   // Utp Trading Unit 1
#define SYSTEM_ID_UTP_TRADING_UNIT_2 0x0000000C   // Utp Trading Unit 2

// Index Level Code: one byte code
#define INDEX_LEVEL_CODE_FIRST_VALUE_OF_THE_INDEX_AT_THE_SESSION 0x31               // First Value Of The Index At The Session
#define INDEX_LEVEL_CODE_CURRENT_INDEX 0x32                                         // Current Index
#define INDEX_LEVEL_CODE_THEORETICAL_VALUE_OF_THE_INDEX_BEFORE_ITS_OPENING 0x33     // Theoretical Value Of The Index Before Its Opening
#define INDEX_LEVEL_CODE_CLOSING_INDEX_FROM_PREVIOUS_SESSION_REFERENCE_INDEX 0x35   // Closing Index From Previous Session Reference Index
#define INDEX_LEVEL_CODE_THEORETICAL_OPENING_INDEX_BEFORE_OPENING_THE_SESSION 0x38  // Theoretical Opening Index Before Opening The Session
#define INDEX_LEVEL_CODE_INDEX_WITHOUT_OPENING 0x39                                 // Index Without Opening
#define INDEX_LEVEL_CODE_PRELIMINARY_OPENING_INDEX 0x41                             // Preliminary Opening Index
#define INDEX_LEVEL_CODE_SYNTHETIC_OPENING_INDEX_100 0x42                           // Synthetic Opening Index 100%
#define INDEX_LEVEL_CODE_FINAL_OPENING_INDEX 0x43                                   // Final Opening Index
#define INDEX_LEVEL_CODE_AVERAGE_WEIGHTED_INDEX 0x52                                // Average Weighted Index
#define INDEX_LEVEL_CODE_CANCELLATION_OF_THE_CURRENT_VALUES_OF_THE_INDEX 0x58       // Cancellation Of The Current Values Of The Index
#define INDEX_LEVEL_CODE_RECALCULATED_CURRENT_VALUES_OF_THE_INDEX 0x59              // Recalculated Current Values Of The Index

// Marker Percent Change Toi: one byte code
#define MARKER_PERCENT_CHANGE_TOI_INCREASE 0x2B   // Increase
#define MARKER_PERCENT_CHANGE_TOI_DECREASE 0x2D   // Decrease
#define MARKER_PERCENT_CHANGE_TOI_NO_CHANGE 0x20  // No Change

// Marker Point Change: one byte code
#define MARKER_POINT_CHANGE_INCREASE 0x2B   // Increase
#define MARKER_POINT_CHANGE_DECREASE 0x2D   // Decrease
#define MARKER_POINT_CHANGE_NO_CHANGE 0x20  // No Change

// Marker Difference Central Spread: one byte code
#define MARKER_DIFFERENCE_CENTRAL_SPREAD_INCREASE 0x2B   // Increase
#define MARKER_DIFFERENCE_CENTRAL_SPREAD_DECREASE 0x2D   // Decrease
#define MARKER_DIFFERENCE_CENTRAL_SPREAD_NO_CHANGE 0x20  // No Change

// Dissemination Frequency Marker: one byte code
#define DISSEMINATION_FREQUENCY_MARKER_WHEN_THE_MESSAGE_AT_A_PARTICULAR_LEVEL_IS_PUBLISHED_REGULARLY_AT_THE_SESSION 0x30      // When The Message At A Particular Level Is Published Regularly At The Session
#define DISSEMINATION_FREQUENCY_MARKER_WHEN_THE_MESSAGE_AT_A_PARTICULAR_LEVEL_IS_PUBLISHED_AT_THE_SESSION_ON_A_O_39kot5 0x31  // When The Message At A Particular Level Is Published At The Session On A One Time Basis

// Marker High: one byte code
#define MARKER_HIGH_INCREASE 0x2B   // Increase
#define MARKER_HIGH_DECREASE 0x2D   // Decrease
#define MARKER_HIGH_NO_CHANGE 0x20  // No Change

// Marker Low: one byte code
#define MARKER_LOW_INCREASE 0x2B   // Increase
#define MARKER_LOW_DECREASE 0x2D   // Decrease
#define MARKER_LOW_NO_CHANGE 0x20  // No Change

// Marker Closing Prev Session: one byte code
#define MARKER_CLOSING_PREV_SESSION_INCREASE 0x2B   // Increase
#define MARKER_CLOSING_PREV_SESSION_DECREASE 0x2D   // Decrease
#define MARKER_CLOSING_PREV_SESSION_NO_CHANGE 0x20  // No Change

// Marker Closing Prev Year: one byte code
#define MARKER_CLOSING_PREV_YEAR_INCREASE 0x2B   // Increase
#define MARKER_CLOSING_PREV_YEAR_DECREASE 0x2D   // Decrease
#define MARKER_CLOSING_PREV_YEAR_NO_CHANGE 0x20  // No Change

// Mode Index Dissemination: one byte code
#define MODE_INDEX_DISSEMINATION_INDEX_IS_QUOTED_IN_DETERMINED_TIME_INTERVALS 0x43  // Index Is Quoted In Determined Time Intervals
#define MODE_INDEX_DISSEMINATION_INDEX_IS_QUOTED_ON_DETERMINED_HOURS 0x46           // Index Is Quoted On Determined Hours

// Product Classification: one byte code
#define PRODUCT_CLASSIFICATION_WSE_INDEX_FROM_THE_MAIN_MARKET 0x57       // Wse Index From The Main Market
#define PRODUCT_CLASSIFICATION_EXTERNAL_INDEX 0x5A                       // External Index
#define PRODUCT_CLASSIFICATION_ANOTHER_WSE_INFORMATION_PRODUCT 0x56      // Another Wse Information Product
#define PRODUCT_CLASSIFICATION_WSE_STRATEGY_DIVIDEND_POINT_INDEX 0x4D    // Wse Strategy Dividend Point Index
#define PRODUCT_CLASSIFICATION_WSE_STRATEGY_INDEX_OF_SHORT_TYPE 0x53     // Wse Strategy Index Of Short Type
#define PRODUCT_CLASSIFICATION_WSE_STRATEGY_INDEX_OF_LEVERAGE_TYPE 0x4C  // Wse Strategy Index Of Leverage Type

// Opening Calc Formula: one byte code
#define OPENING_CALC_FORMULA_SYNTHETIC 0x53      // Synthetic
#define OPENING_CALC_FORMULA_CHRONOLOGICAL 0x4F  // Chronological

// Toi Dissemination: one byte code
#define TOI_DISSEMINATION_MESSAGE_546_WITH_LEVEL_8_IS_SENT 0x59      // Message 546 With Level 8 Is Sent
#define TOI_DISSEMINATION_MESSAGE_546_WITH_LEVEL_8_IS_NOT_SENT 0x4E  // Message 546 With Level 8 Is Not Sent

// Spread Dissemination: one byte code
#define SPREAD_DISSEMINATION_SPREAD_INDICATORS_ARE_PUBLISHED 0x59      // Spread Indicators Are Published
#define SPREAD_DISSEMINATION_SPREAD_INDICATORS_ARE_NOT_PUBLISHED 0x4E  // Spread Indicators Are Not Published

// Trading Value Publication: one byte code
#define TRADING_VALUE_PUBLICATION_VALUE_IS_PROVIDED 0x59      // Value Is Provided
#define TRADING_VALUE_PUBLICATION_VALUE_IS_NOT_PROVIDED 0x4E  // Value Is Not Provided

// Message Continuation: one byte code
#define MESSAGE_CONTINUATION_THE_MESSAGE_IS_NOT_THE_LAST_MESSAGE_INFORMATION_OF_THE_COMPOSITION_OF_THE_2lj2ta 0x30  // The Message Is Not The Last Message Information Of The Composition Of The Index Portfolio
#define MESSAGE_CONTINUATION_THE_MESSAGE_IS_THE_LAST_MESSAGE_INFORMATION_OF_THE_COMPOSITION_OF_THE_IND_35du14 0x31  // The Message Is The Last Message Information Of The Composition Of The Index Portfolio

// ---- Types -------------------------------------------------------------------

// The real time index message handles the real-time characteristics of an index
typedef struct _RealTimeIndexMessage {
  UINT32BE symbol_index;                       // bytes 0 to 3
  UINT32BE source_time;                        // bytes 4 to 7
  UINT32BE source_seq_num;                     // bytes 8 to 11
  UINT32BE system_id;                          // bytes 12 to 15
  UINT32BE index_level;                        // bytes 16 to 19
  UINT32BE session_high;                       // bytes 20 to 23
  UINT32BE session_low;                        // bytes 24 to 27
  UINT32BE ind_index_opening_portfolio;        // bytes 28 to 31
  UINT32BE percent_change_toi;                 // bytes 32 to 35
  UINT32BE pct_change_index_val_prev_session;  // bytes 36 to 39
  UINT32BE pct_change_index_val_prev_year;     // bytes 40 to 43
  UINT32BE toi;                                // bytes 44 to 47
  UINT32BE point_change;                       // bytes 48 to 51
  UINT64BE value_trading;                      // bytes 52 to 59
  UINT32BE index_value_bid;                    // bytes 60 to 63
  UINT32BE index_value_ask;                    // bytes 64 to 67
  UINT32BE mid_spread_index;                   // bytes 68 to 71
  UINT32BE difference_central_spread;          // bytes 72 to 75
  UINT16BE num_of_active_instruments;          // bytes 76 to 77
  UINT16BE num_of_instr_of_decreasing_qt;      // bytes 78 to 79
  UINT16BE num_of_instr_of_increasing_qt;      // bytes 80 to 81
  UINT16BE num_of_instr_of_unchanged_qt;       // bytes 82 to 83
  UINT16BE source_time_micro_secs;             // bytes 84 to 85
  UINT8 level_scale_code;                      // byte 86
  UINT8 time_first_high[6];                    // bytes 87 to 92
  UINT8 time_first_low[6];                     // bytes 93 to 98
  UINT8 index_status_indicator[2];             // bytes 99 to 100
  UINT8 index_level_code;                      // byte 101
  UINT8 marker_percent_change_toi;             // byte 102
  UINT8 marker_pct_chg_index_val_prev_sess;    // byte 103
  UINT8 marker_pct_chg_index_val_prev_year;    // byte 104
  UINT8 marker_point_change;                   // byte 105
  UINT8 marker_difference_central_spread;      // byte 106
  UINT8 dissemination_frequency_marker;        // byte 107
} RealTimeIndexMessage;

// The index summary message provides a summary of the data calculated in a stock index for a given day
typedef struct _IndexSummaryMessage {
  UINT32BE symbol_index;                         // bytes 0 to 3
  UINT32BE source_time;                          // bytes 4 to 7
  UINT32BE source_seq_num;                       // bytes 8 to 11
  UINT32BE system_id;                            // bytes 12 to 15
  UINT32BE closing_index_value;                  // bytes 16 to 19
  UINT32BE ind_opening_portfolio;                // bytes 20 to 23
  UINT32BE opening_index_value;                  // bytes 24 to 27
  UINT32BE session_high;                         // bytes 28 to 31
  UINT32BE session_low;                          // bytes 32 to 35
  UINT32BE pct_chg_high_index_val_prev_session;  // bytes 36 to 39
  UINT32BE pct_chg_low_index_val_prev_session;   // bytes 40 to 43
  UINT32BE pct_change_index_val_prev_session;    // bytes 44 to 47
  UINT32BE pct_change_index_val_prev_year;       // bytes 48 to 51
  UINT32BE capitalisation_portfolio;             // bytes 52 to 55
  UINT32BE index_adjustment_coefficient;         // bytes 56 to 59
  UINT16BE source_time_micro_secs;               // bytes 60 to 61
  UINT8 level_scale_code;                        // byte 62
  UINT8 capitalisation_scale_code;               // byte 63
  UINT8 index_adjustment_scale_code;             // byte 64
  UINT8 time_closing[6];                         // bytes 65 to 70
  UINT8 time_opening[6];                         // bytes 71 to 76
  UINT8 time_full_opening[6];                    // bytes 77 to 82
  UINT8 time_high[6];                            // bytes 83 to 88
  UINT8 time_low[6];                             // bytes 89 to 94
  UINT8 marker_high;                             // byte 95
  UINT8 marker_low;                              // byte 96
  UINT8 marker_closing_prev_session;             // byte 97
  UINT8 marker_closing_prev_year;                // byte 98
  UINT8 reserved_1;                              // byte 99
} IndexSummaryMessage;

// Characteristics of index portfolio / information product; block is repeated 20 times
typedef struct _IndexPortfolioComponent {
  UINT8 instrument_isin[12];         // bytes 0 to 11
  UINT8 instrument_abbrev_name[10];  // bytes 12 to 21
  UINT8 instrument_packet[10];       // bytes 22 to 31
} IndexPortfolioComponent;

// Index portfolio
typedef struct _IndexPortfolioMessage {
  UINT32BE symbol_index;                  // bytes 0 to 3
  UINT32BE source_time;                   // bytes 4 to 7
  UINT32BE source_seq_num;                // bytes 8 to 11
  UINT32BE system_id;                     // bytes 12 to 15
  UINT32BE index_adjustment_coefficient;  // bytes 16 to 19
  UINT32BE level_cash_portfolio;          // bytes 20 to 23
  UINT32BE value_last_closing_index;      // bytes 24 to 27
  UINT16BE number_of_components;          // bytes 28 to 29
  UINT16BE source_time_micro_secs;        // bytes 30 to 31
  UINT8 index_adjustment_scale_code;      // byte 32
  UINT8 cash_portfolio_scale_code;        // byte 33
  UINT8 level_scale_code;                 // byte 34
  UINT8 index_portfolio_component[640];   // bytes 35 to 674
  UINT8 date_validity[8];                 // bytes 675 to 682
  UINT8 index_currency[3];                // bytes 683 to 685
  UINT8 index_status_indicator[2];        // bytes 686 to 687
  UINT8 index_pres_seq[2];                // bytes 688 to 689
  UINT8 mode_index_dissemination;         // byte 690
  UINT8 product_classification;           // byte 691
  UINT8 opening_calc_formula;             // byte 692
  UINT8 reserved_1;                       // byte 693
  UINT8 toi_dissemination;                // byte 694
  UINT8 spread_dissemination;             // byte 695
  UINT8 trading_value_publication;        // byte 696
  UINT8 message_continuation;             // byte 697
  UINT8 reserved_2[2];                    // bytes 698 to 699
} IndexPortfolioMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0222: RealTimeIndexMessage real_time_index_message;
    case 0x0223: IndexSummaryMessage index_summary_message;
    case 0x0224: IndexPortfolioMessage index_portfolio_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_size { message_size >= 2 };                                                                                                                     // bytes 0 to 1
  UINT16BE message_type;                                                                                                                                           // bytes 2 to 3
  Payload(message_type, ((((UINT32) message_size) + 2) - 4)) payload[:byte-size-single-element-array ((((UINT32) message_size) + 2) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// The packet's message area: the messages it counts, or one ZliB block holding them
typedef struct _MessageBuffer (UINT8 number_msg_entries, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_msg_entries); };
} MessageBuffer;

// ---- Packet: Packet ----------------------------------------------------------

// Gpw Xdp Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16BE packet_length;                                                                                                       // bytes 0 to 1
  UINT16BE packet_type;                                                                                                         // bytes 2 to 3
  UINT32BE packet_sequence_number;                                                                                              // bytes 4 to 7
  UINT32BE send_time;                                                                                                           // bytes 8 to 11
  UINT16BE service_id;                                                                                                          // bytes 12 to 13
  UINT8 delivery_flag;                                                                                                          // byte 14
  UINT8 number_msg_entries;                                                                                                     // byte 15
  MessageBuffer(number_msg_entries, (available - 16), tally) message_buffer[:byte-size-single-element-array (available - 16)];
} Packet;

