// Gie da Papier w Warto ciowych w Warszawie Warsaw Stock Exchange Indices
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out Wse_Indices_v6_8.3d
//
// What this definition does not state, and the model does:
// - a field filling what is left of what holds it
// - a run filling what frames it
// - a run of a stated number of entries
//
// License: MIT No Attribution

// ---- Packet Header: 16 bytes -------------------------------------------------

// All messages are preceded by a common packet header format, which section 1.1 states for every Market Information message
entrypoint typedef struct _PacketHeader {
  UINT16BE packet_length;           // bytes 0 to 1
  UINT16BE packet_type;             // bytes 2 to 3
  UINT32BE packet_sequence_number;  // bytes 4 to 7
  UINT32BE send_time;               // bytes 8 to 11
  UINT16BE service_id;              // bytes 12 to 13
  UINT8 delivery_flag;              // byte 14
  UINT8 number_msg_entries;         // byte 15
} PacketHeader;

// ---- Message Header: 4 bytes -------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT16BE message_size;  // bytes 0 to 1
  UINT16BE message_type;  // bytes 2 to 3
} MessageHeader;

// ---- Real Time Index Message: 108 bytes --------------------------------------

// The real time index message handles the real-time characteristics of an index
entrypoint typedef struct _RealTimeIndexMessage {
  UINT32BE symbol_index;                       // bytes 0 to 3
  UINT32BE source_time;                        // bytes 4 to 7
  UINT32BE source_seq_num;                     // bytes 8 to 11
  UINT32BE system_id;                          // bytes 12 to 15
  UINT32BE index_level;                        // bytes 16 to 19
  UINT32BE session_high;                       // bytes 20 to 23
  UINT32BE session_low;                        // bytes 24 to 27
  UINT32BE ind_index_opening_portfolio;        // bytes 28 to 31
  UINT32BE percent_change_toi;                 // bytes 32 to 35
  UINT32BE pct_change_index_val_prev_session;  // bytes 36 to 39
  UINT32BE pct_change_index_val_prev_year;     // bytes 40 to 43
  UINT32BE toi;                                // bytes 44 to 47
  UINT32BE point_change;                       // bytes 48 to 51
  UINT64BE value_trading;                      // bytes 52 to 59
  UINT32BE index_value_bid;                    // bytes 60 to 63
  UINT32BE index_value_ask;                    // bytes 64 to 67
  UINT32BE mid_spread_index;                   // bytes 68 to 71
  UINT32BE difference_central_spread;          // bytes 72 to 75
  UINT16BE num_of_active_instruments;          // bytes 76 to 77
  UINT16BE num_of_instr_of_decreasing_qt;      // bytes 78 to 79
  UINT16BE num_of_instr_of_increasing_qt;      // bytes 80 to 81
  UINT16BE num_of_instr_of_unchanged_qt;       // bytes 82 to 83
  UINT16BE source_time_micro_secs;             // bytes 84 to 85
  UINT8 level_scale_code;                      // byte 86
  UINT8 time_first_high[6];                    // bytes 87 to 92
  UINT8 time_first_low[6];                     // bytes 93 to 98
  UINT8 index_status_indicator[2];             // bytes 99 to 100
  UINT8 index_level_code;                      // byte 101
  UINT8 marker_percent_change_toi;             // byte 102
  UINT8 marker_pct_chg_index_val_prev_sess;    // byte 103
  UINT8 marker_pct_chg_index_val_prev_year;    // byte 104
  UINT8 marker_point_change;                   // byte 105
  UINT8 marker_difference_central_spread;      // byte 106
  UINT8 dissemination_frequency_marker;        // byte 107
} RealTimeIndexMessage;

// ---- Index Summary Message: 100 bytes ----------------------------------------

// The index summary message provides a summary of the data calculated in a stock index for a given day
entrypoint typedef struct _IndexSummaryMessage {
  UINT32BE symbol_index;                         // bytes 0 to 3
  UINT32BE source_time;                          // bytes 4 to 7
  UINT32BE source_seq_num;                       // bytes 8 to 11
  UINT32BE system_id;                            // bytes 12 to 15
  UINT32BE closing_index_value;                  // bytes 16 to 19
  UINT32BE ind_opening_portfolio;                // bytes 20 to 23
  UINT32BE opening_index_value;                  // bytes 24 to 27
  UINT32BE session_high;                         // bytes 28 to 31
  UINT32BE session_low;                          // bytes 32 to 35
  UINT32BE pct_chg_high_index_val_prev_session;  // bytes 36 to 39
  UINT32BE pct_chg_low_index_val_prev_session;   // bytes 40 to 43
  UINT32BE pct_change_index_val_prev_session;    // bytes 44 to 47
  UINT32BE pct_change_index_val_prev_year;       // bytes 48 to 51
  UINT32BE capitalisation_portfolio;             // bytes 52 to 55
  UINT32BE index_adjustment_coefficient;         // bytes 56 to 59
  UINT16BE source_time_micro_secs;               // bytes 60 to 61
  UINT8 level_scale_code;                        // byte 62
  UINT8 capitalisation_scale_code;               // byte 63
  UINT8 index_adjustment_scale_code;             // byte 64
  UINT8 time_closing[6];                         // bytes 65 to 70
  UINT8 time_opening[6];                         // bytes 71 to 76
  UINT8 time_full_opening[6];                    // bytes 77 to 82
  UINT8 time_high[6];                            // bytes 83 to 88
  UINT8 time_low[6];                             // bytes 89 to 94
  UINT8 marker_high;                             // byte 95
  UINT8 marker_low;                              // byte 96
  UINT8 marker_closing_prev_session;             // byte 97
  UINT8 marker_closing_prev_year;                // byte 98
  UINT8 reserved_1;                              // byte 99
} IndexSummaryMessage;

