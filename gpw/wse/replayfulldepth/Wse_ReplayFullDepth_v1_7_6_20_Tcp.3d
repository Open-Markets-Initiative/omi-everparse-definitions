  UINT8 side;              // byte 12
} OrderCancel;

// ---- Order Execute: 41 bytes -------------------------------------------------

// Execution report
entrypoint typedef struct _OrderExecute {
  UINT64 quantity;            // bytes 0 to 7
  UINT32 instrument_id;       // bytes 8 to 11
  UINT64 public_order_id;     // bytes 12 to 19
  UINT32 trade_id;            // bytes 20 to 23
  UINT64 execution_price;     // bytes 24 to 31, signed, read here as unsigned
  UINT64 execution_quantity;  // bytes 32 to 39
  UINT8 side;                 // byte 40
} OrderExecute;

// ---- Order Book Event: 5 bytes -----------------------------------------------

// Order book event for given instrument
entrypoint typedef struct _OrderBookEvent {
  UINT32 instrument_id;         // bytes 0 to 3
  UINT8 order_book_event_type;  // byte 4
} OrderBookEvent;

