// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Wse_OrderBook_v6_8.3d

// ---- Values ------------------------------------------------------------------

// Packet Type: 2 byte code
#define PACKET_TYPE_MARKET_DATA_MESSAGES 0x01F5  // Market Data Messages

// Delivery Flag: one byte code
#define DELIVERY_FLAG_REAL_TIME_MESSAGE_UNCOMPRESSED 0x00       // Real Time Message Uncompressed
#define DELIVERY_FLAG_RETRANSMISSION_MESSAGE_UNCOMPRESSED 0x02  // Retransmission Message Uncompressed
#define DELIVERY_FLAG_REAL_TIME_MESSAGE_ZLIB_COMPRESSED 0x10    // Real Time Message Zlib Compressed
#define DELIVERY_FLAG_REFRESH_MESSAGE_ZLIB_COMPRESSED 0x11      // Refresh Message Zlib Compressed
#define DELIVERY_FLAG_RETRANSMISSION_MESSAGE_COMPRESSED 0x12    // Retransmission Message Compressed

// Message Type: 2 byte code
#define MESSAGE_TYPE_ORDER_UPDATE_MARKET_SHEET_MESSAGE 0x00E6            // Order Update Market Sheet Message
#define MESSAGE_TYPE_ORDER_BOOK_RETRANSMISSION_DELIMITER_MESSAGE 0x00E7  // Order Book Retransmission Delimiter Message

// System Id: 4 byte code
#define SYSTEM_ID_ALL_NON_UTP_SYSTEMS 0x00000001  // All Non Utp Systems
#define SYSTEM_ID_UTP_TRADING_UNIT_1 0x0000000B   // Utp Trading Unit 1
#define SYSTEM_ID_UTP_TRADING_UNIT_2 0x0000000C   // Utp Trading Unit 2

// Side: one byte code
#define SIDE_BUY 0x31                                                                               // Buy
#define SIDE_SELL 0x32                                                                              // Sell
#define SIDE_SELL_SHORT_EQUIVALENT_TO_VALUE_2_SELL_OPTIONAL_FOR_EXCHANGE_MEMBERS_AND_N_aa7jtw 0x35  // Sell Short Equivalent To Value 2 Sell Optional For Exchange Members And Not Monitored By The Wse

// Order Type: one byte code
#define ORDER_TYPE_MARKET_ORDER 0x31           // Market Order
#define ORDER_TYPE_LIMIT_ORDER 0x32            // Limit Order
#define ORDER_TYPE_MARKET_TO_LIMIT_ORDER 0x4B  // Market To Limit Order
#define ORDER_TYPE_PEG_ORDER 0x50              // Peg Order

// Action Type: one byte code
#define ACTION_TYPE_NEW_ORDER 0x41                                                                         // New Order
#define ACTION_TYPE_MODIFICATION_OF_EXISTING_ORDER_CASE_OF_PARTIAL_FILL 0x4D                               // Modification Of Existing Order Case Of Partial Fill
#define ACTION_TYPE_DELETION_OF_ORDER_IDENTIFIED_BY_ORDER_ID 0x44                                          // Deletion Of Order Identified By Order Id
#define ACTION_TYPE_DELETION_ALL_ORDERS_FOR_ONE_INSTRUMENT_AT_THE_START_OF_THE_DAY_BEFORE_THE_wkonqj 0x46  // Deletion All Orders For One Instrument At The Start Of The Day Before The Order Book Retransmission
#define ACTION_TYPE_RETRANSMISSION_OF_ALL_ORDERS_FOR_THE_GIVEN_INSTRUMENT 0x59                             // Retransmission Of All Orders For The Given Instrument

// Retransmission Indicator: one byte code
#define RETRANSMISSION_INDICATOR_BEGINNING_OF_THE_RETRANSMISSION 0x42  // Beginning Of The Retransmission
#define RETRANSMISSION_INDICATOR_END_OF_THE_RETRANSMISSION 0x45        // End Of The Retransmission

// ---- Types -------------------------------------------------------------------

// The Order update message generated by the trading engine UTP indicates the creation or modification of a line in the market sheet (a.k.a
typedef struct _OrderUpdateMarketSheetMessage {
  UINT32BE symbol_index;               // bytes 0 to 3
  UINT32BE source_time;                // bytes 4 to 7
  UINT32BE source_seq_num;             // bytes 8 to 11
  UINT32BE price;                      // bytes 12 to 15
  UINT32BE aggregated_volume;          // bytes 16 to 19
  UINT32BE volume;                     // bytes 20 to 23
  UINT32BE link_id;                    // bytes 24 to 27
  UINT32BE order_id;                   // bytes 28 to 31
  UINT32BE system_id;                  // bytes 32 to 35
  UINT16BE source_time_micro_secs;     // bytes 36 to 37
  UINT16BE number_orders;              // bytes 38 to 39
  UINT8 side;                          // byte 40
  UINT8 order_type;                    // byte 41
  UINT8 action_type;                   // byte 42
  UINT8 price_scale_code;              // byte 43
  UINT32BE order_date;                 // bytes 44 to 47
  UINT32BE order_priority_date;        // bytes 48 to 51
  UINT32BE order_priority_time;        // bytes 52 to 55
  UINT16BE order_priority_micro_secs;  // bytes 56 to 57
  UINT8 order_origin;                  // byte 58
  UINT8 reserved_1;                    // byte 59
} OrderUpdateMarketSheetMessage;

// The Orderbook retransmission delimiter message is set to clean then update the market sheet with the orders from previous days still remaining in the order book
typedef struct _OrderBookRetransmissionDelimiterMessage {
  UINT32BE source_time;            // bytes 0 to 3
  UINT32BE source_seq_num;         // bytes 4 to 7
  UINT8 application_id[2];         // bytes 8 to 9
  UINT8 instance_num;              // byte 10
  UINT8 retransmission_indicator;  // byte 11
} OrderBookRetransmissionDelimiterMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x00E6: OrderUpdateMarketSheetMessage order_update_market_sheet_message;
    case 0x00E7: OrderBookRetransmissionDelimiterMessage order_book_retransmission_delimiter_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_size { message_size >= 2 };                                                                                                                     // bytes 0 to 1
  UINT16BE message_type;                                                                                                                                           // bytes 2 to 3
  Payload(message_type, ((((UINT32) message_size) + 2) - 4)) payload[:byte-size-single-element-array ((((UINT32) message_size) + 2) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// The packet's message area: the messages it counts, or one ZliB block holding them
typedef struct _MessageBuffer (UINT8 number_msg_entries, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_msg_entries); };
} MessageBuffer;

// ---- Packet: Packet ----------------------------------------------------------

// Gpw Xdp Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16BE packet_length;                                                                                                       // bytes 0 to 1
  UINT16BE packet_type;                                                                                                         // bytes 2 to 3
  UINT32BE packet_sequence_number;                                                                                              // bytes 4 to 7
  UINT32BE send_time;                                                                                                           // bytes 8 to 11
  UINT16BE service_id;                                                                                                          // bytes 12 to 13
  UINT8 delivery_flag;                                                                                                          // byte 14
  UINT8 number_msg_entries;                                                                                                     // byte 15
  MessageBuffer(number_msg_entries, (available - 16), tally) message_buffer[:byte-size-single-element-array (available - 16)];
} Packet;

