  UINT32BE volatility;                          // bytes 136 to 139
  UINT32BE strike_price;                        // bytes 140 to 143
  UINT32BE short_selling_trades_number;         // bytes 144 to 147
  UINT32BE volume_short_selling_trades;         // bytes 148 to 151
  UINT32BE value_short_selling_trades;          // bytes 152 to 155
  UINT32BE last_trade_date;                     // bytes 156 to 159
  UINT32BE last_trade_price;                    // bytes 160 to 163
  UINT32BE block_trades_number;                 // bytes 164 to 167
  UINT32BE volume_block_trades;                 // bytes 168 to 171
  UINT32BE value_block_trades;                  // bytes 172 to 175
  UINT32BE vwap_blocktrade;                     // bytes 176 to 179
  UINT32BE maximum_block_price;                 // bytes 180 to 183
  UINT32BE minimum_block_price;                 // bytes 184 to 187
  UINT32BE system_id;                           // bytes 188 to 191
  UINT16BE source_time_micro_secs;              // bytes 192 to 193
  UINT8 multiplier_scale_code;                  // byte 194
