#define MSG_TYPE_INDICATOR_FUNCTIONAL 0x46      // Functional
#define MSG_TYPE_INDICATOR_TECHNICAL 0x54       // Technical
#define MSG_TYPE_INDICATOR_NOT_APPLICABLE 0x20  // Not Applicable

