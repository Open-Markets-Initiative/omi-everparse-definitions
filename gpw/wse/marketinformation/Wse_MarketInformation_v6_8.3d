#define TYPE_OF_DERIVATIVES_NO 0x39                                                             // No

// Market Indicator: one byte code
#define MARKET_INDICATOR_NOT_USED 0x00  // Not Used

// Algo: one byte code
#define ALGO_FIFO 0x46         // Fifo
#define ALGO_FIFO_ORIGIN 0x4F  // Fifo Origin

// Ss Market Maker: one byte code
#define SS_MARKET_MAKER_SHORT_SALE_IS_AUTHORIZED 0x59                                                          // Short Sale Is Authorized
#define SS_MARKET_MAKER_SHORT_SALE_IS_FORBIDDEN_WHICH_THE_561_SESSION_SUMMARY_MESSAGE_WORDS_AS_SUSPENDED 0x4E  // Short Sale Is Forbidden Which The 561 Session Summary Message Words As Suspended
#define SS_MARKET_MAKER_NOT_SIGNIFICANT_FOR_WARRANTS_AND_DERIVATIVES_INSTRUMENTS_AS_WELL_AS_INSTR_mgqsj6 0x20  // Not Significant For Warrants And Derivatives Instruments As Well As Instruments Traded On Ipo And To Segments

// Ss Non Market Maker: one byte code
#define SS_NON_MARKET_MAKER_SHORT_SALE_IS_AUTHORIZED 0x59                                                          // Short Sale Is Authorized
#define SS_NON_MARKET_MAKER_SHORT_SALE_IS_FORBIDDEN_WHICH_THE_561_SESSION_SUMMARY_MESSAGE_WORDS_AS_SUSPENDED 0x4E  // Short Sale Is Forbidden Which The 561 Session Summary Message Words As Suspended
#define SS_NON_MARKET_MAKER_NOT_SIGNIFICANT_FOR_WARRANTS_AND_DERIVATIVES_INSTRUMENTS_AS_WELL_AS_INSTR_mgqsj6 0x20  // Not Significant For Warrants And Derivatives Instruments As Well As Instruments Traded On Ipo And To Segments

