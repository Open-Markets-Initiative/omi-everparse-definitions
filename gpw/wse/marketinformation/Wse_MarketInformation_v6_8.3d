  UINT8 maximum_price_scale_code;               // byte 197
  UINT8 minimum_price_scale_code;               // byte 198
  UINT8 closing_price_scale_code;               // byte 199
  UINT8 implied_volatility_scale_code;          // byte 200
  UINT8 average_weighted_price_scale_code;      // byte 201
  UINT8 reference_price_scale_code;             // byte 202
  UINT8 pct_change_price_scale_code;            // byte 203
  UINT8 dividend_rate_scale_code;               // byte 204
  UINT8 settlement_price_scale_code;            // byte 205
  UINT8 settlement_value_scale_code;            // byte 206
  UINT8 reserved_1;                             // byte 207
  UINT8 trading_value_scale_code;               // byte 208
  UINT8 currency_price_scale_code;              // byte 209
  UINT8 delta_scale_code;                       // byte 210
  UINT8 gamma_scale_code;                       // byte 211
  UINT8 rho_scale_code;                         // byte 212
  UINT8 theta_scale_code;                       // byte 213
  UINT8 vega_scale_code;                        // byte 214
  UINT8 trading_value_currency_scale_code;      // byte 215
  UINT8 interest_rate_scale_code;               // byte 216
  UINT8 volatility_scale_code;                  // byte 217
  UINT8 strike_price_scale_code;                // byte 218
  UINT8 value_short_selling_trades_scale_code;  // byte 219
