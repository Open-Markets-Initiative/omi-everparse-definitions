#define MARKET_NEW_CONNECT_MARKET_PRICE_DRIVEN_MARKET 0x5A  // New Connect Market Price Driven Market
#define MARKET_NEW_CONNECT_MARKETORDER_DRIVEN_MARKET 0x43   // New Connect Marketorder Driven Market
#define MARKET_CATALYST_REGULATED_MARKET 0x4F               // Catalyst Regulated Market
#define MARKET_CATALYST_ASO 0x4E                            // Catalyst Aso

// Marker Pct Change Price: one byte code
#define MARKER_PCT_CHANGE_PRICE_INCREASE 0x2B   // Increase
#define MARKER_PCT_CHANGE_PRICE_DECREASE 0x2D   // Decrease
#define MARKER_PCT_CHANGE_PRICE_NO_CHANGE 0x20  // No Change

// Symbol Delta: one byte code
#define SYMBOL_DELTA_POSITIVE_VALUE 0x2B  // Positive Value
#define SYMBOL_DELTA_NEGATIVE_VALUE 0x2D  // Negative Value
#define SYMBOL_DELTA_ZERO_VALUE 0x20      // Zero Value

// Symbol Gamma: one byte code
#define SYMBOL_GAMMA_POSITIVE_VALUE 0x2B  // Positive Value
#define SYMBOL_GAMMA_NEGATIVE_VALUE 0x2D  // Negative Value
#define SYMBOL_GAMMA_ZERO_VALUE 0x20      // Zero Value

// Symbol Rho: one byte code
#define SYMBOL_RHO_POSITIVE_VALUE 0x2B  // Positive Value
#define SYMBOL_RHO_NEGATIVE_VALUE 0x2D  // Negative Value
#define SYMBOL_RHO_ZERO_VALUE 0x20      // Zero Value

// Symbol Theta: one byte code
#define SYMBOL_THETA_POSITIVE_VALUE 0x2B  // Positive Value
#define SYMBOL_THETA_NEGATIVE_VALUE 0x2D  // Negative Value
#define SYMBOL_THETA_ZERO_VALUE 0x20      // Zero Value

// Symbol Vega: one byte code
#define SYMBOL_VEGA_POSITIVE_VALUE 0x2B  // Positive Value
#define SYMBOL_VEGA_NEGATIVE_VALUE 0x2D  // Negative Value
#define SYMBOL_VEGA_ZERO_VALUE 0x20      // Zero Value

// Order Entry Rejection: one byte code
#define ORDER_ENTRY_REJECTION_ORDER_ENTRY_ALLOWED 0x4E    // Order Entry Allowed
#define ORDER_ENTRY_REJECTION_ORDER_ENTRY_FORBIDDEN 0x59  // Order Entry Forbidden

// Instrument State: one byte code
#define INSTRUMENT_STATE_HALTED 0x48                                                                // Halted
#define INSTRUMENT_STATE_AUCTION 0x41                                                               // Auction
#define INSTRUMENT_STATE_INHERITED_FOLLOWING_THE_STATE_OF_THE_CLASS_THE_INSTRUMENT_BELONGS_TO 0x20  // Inherited Following The State Of The Class The Instrument Belongs To

// Halt Reason: one byte code
#define HALT_REASON_HALTED_NO_LIQUIDITY_PROVIDER 0x52                        // Halted No Liquidity Provider
#define HALT_REASON_TRADE_PRICE_OUTSIDE_DYNAMIC_COLLARS 0x43                 // Trade Price Outside Dynamic Collars
#define HALT_REASON_MANUAL_HALTING_BY_MARKET_OPERATIONS 0x4D                 // Manual Halting By Market Operations
#define HALT_REASON_REGULATORY_HALTING_DEACTIVATING_BARRIER_REACHED 0x57     // Regulatory Halting Deactivating Barrier Reached
#define HALT_REASON_REGULATORY_HALTING_UNDERLYING_HALTED 0x58                // Regulatory Halting Underlying Halted
#define HALT_REASON_REGULATORY_HALTING_BY_MO 0x47                            // Regulatory Halting By Mo
#define HALT_REASON_TRADE_PRICE_OUTSIDE_STATIC_COLLARS 0x53                  // Trade Price Outside Static Collars
#define HALT_REASON_NUMBER_OF_ORDERS_ALERT 0x41                              // Number Of Orders Alert
#define HALT_REASON_INSTRUMENT_NOT_HALTED_OR_INFORMATION_NOT_AVAILABLE 0x20  // Instrument Not Halted Or Information Not Available

// Action Affecting State: one byte code
#define ACTION_AFFECTING_STATE_TRADING_ON_THE_INSTRUMENT_AT_THE_OPENING_SENT_BEFORE_O 0x43        // Trading On The Instrument At The Opening Sent Before O
#define ACTION_AFFECTING_STATE_CANCELLED_PROGRAMMED_OPENING 0x44                                  // Cancelled Programmed Opening
#define ACTION_AFFECTING_STATE_INSTRUMENT_HALTED_INDEPENDENTLY_FROM_ITS_CLASS 0x4D                // Instrument Halted Independently From Its Class
#define ACTION_AFFECTING_STATE_INSTRUMENT_IS_BEING_INITIALIZED_BEGINNING_OF_THE_TRADING_DAY 0x4E  // Instrument Is Being Initialized Beginning Of The Trading Day
#define ACTION_AFFECTING_STATE_INSTRUMENT_OPENED 0x4F                                             // Instrument Opened
#define ACTION_AFFECTING_STATE_DEFERRED_PROGRAMMED_OPENING 0x50                                   // Deferred Programmed Opening
#define ACTION_AFFECTING_STATE_AUTOMATIC_HALTING_AT_THE_CLASS_AUCTION 0x52                        // Automatic Halting At The Class Auction
#define ACTION_AFFECTING_STATE_BEGINNING_OF_A_ONE_SIDE_ONLY_PERIOD 0x59                           // Beginning Of A One Side Only Period
#define ACTION_AFFECTING_STATE_END_OF_A_ONE_SIDE_ONLY_PERIOD 0x5A                                 // End Of A One Side Only Period

