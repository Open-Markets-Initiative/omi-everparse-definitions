// ---- Instrument State Change Message: 48 bytes -------------------------------

// An 'Instrument State Change' message is generated by the trading engines to announce a change in the state of an instrument
entrypoint typedef struct _InstrumentStateChangeMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE system_id;               // bytes 12 to 15
  UINT16BE source_time_micro_secs;  // bytes 16 to 17
  UINT8 reserved_2[2];              // bytes 18 to 19
  UINT8 start_date_halting[8];      // bytes 20 to 27
  UINT8 start_time_halting[6];      // bytes 28 to 33
  UINT8 prog_opening_time[6];       // bytes 34 to 39
  UINT8 order_entry_rejection;      // byte 40
  UINT8 instrument_state;           // byte 41
  UINT8 instrument_trading_status;  // byte 42
  UINT8 halt_reason;                // byte 43
  UINT8 action_affecting_state;     // byte 44
  UINT8 instrument_state_tcs;       // byte 45
  UINT8 period_side;                // byte 46
  UINT8 reserved_1;                 // byte 47
} InstrumentStateChangeMessage;

// ---- Indicative Matching Price Message: 32 bytes -----------------------------

// The Indicative matching price message indicates an instrument's theoretical opening price (also known as an indicative opening price): An IMP-message is sent if the indicative matching price or volume varies
entrypoint typedef struct _IndicativeMatchingPriceMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE im_price;                // bytes 12 to 15
  UINT32BE variation;               // bytes 16 to 19
  UINT32BE system_id;               // bytes 20 to 23
  UINT16BE source_time_micro_secs;  // bytes 24 to 25
  UINT8 price_scale_code;           // byte 26
  UINT8 variation_scale_code;       // byte 27
  UINT32BE im_volume;               // bytes 28 to 31
} IndicativeMatchingPriceMessage;

// ---- Short Sale Change Message: 124 bytes ------------------------------------

// The Short Sale Change message indicates whether an instrument short sale is suspended or re-authorized
entrypoint typedef struct _ShortSaleChangeMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE system_id;               // bytes 12 to 15
  UINT16BE source_time_micro_secs;  // bytes 16 to 17
  UINT8 text[100];                  // bytes 18 to 117
  UINT8 authority;                  // byte 118
  UINT8 ss_market_maker;            // byte 119
  UINT8 ss_non_market_maker;        // byte 120
  UINT8 reserved_3[3];              // bytes 121 to 123
} ShortSaleChangeMessage;

// ---- Treasury Bond Futures Data: 220 bytes -----------------------------------

// Body Message for InternalMsgType = 02, which informs about the structure of the basket of treasury bonds for a given bond future for the next trading day
entrypoint typedef struct _TreasuryBondFuturesData {
  UINT8 isin_code[12];                       // bytes 0 to 11
  UINT8 date_of_first_quotation[8];          // bytes 12 to 19
  UINT8 short_name[16];                      // bytes 20 to 35
  UINT8 start_date[8];                       // bytes 36 to 43
  UINT8 underlying_isin_code[12];            // bytes 44 to 55
  UINT8 treasury_bond_1_isin_code[12];       // bytes 56 to 67
  UINT8 conversion_coefficient_factor_1[9];  // bytes 68 to 76
  UINT8 treasury_bond_2_isin_code[12];       // bytes 77 to 88
  UINT8 conversion_coefficient_factor_2[9];  // bytes 89 to 97
  UINT8 treasury_bond_3_isin_code[12];       // bytes 98 to 109
  UINT8 conversion_coefficient_factor_3[9];  // bytes 110 to 118
  UINT8 treasury_bond_4_isin_code[12];       // bytes 119 to 130
  UINT8 conversion_coefficient_factor_4[9];  // bytes 131 to 139
  UINT8 treasury_bond_5_isin_code[12];       // bytes 140 to 151
  UINT8 conversion_coefficient_factor_5[9];  // bytes 152 to 160
  UINT8 reserved_59[59];                     // bytes 161 to 219
} TreasuryBondFuturesData;

// ---- Kid: 220 bytes ----------------------------------------------------------

// Body Message for InternalMsgType field = 03, which informs about the selected values for PRIIPs key information for the given trading day and includes the link to the issuer's website
entrypoint typedef struct _Kid {
  UINT8 isin_code[12];              // bytes 0 to 11
  UINT8 kid_type_of_instrument[4];  // bytes 12 to 15
  UINT8 kid_version[10];            // bytes 16 to 25
  UINT8 kid_issue_date[8];          // bytes 26 to 33
  UINT8 value_at_risk;              // byte 34
  UINT8 holding_period[3];          // bytes 35 to 37
  UINT8 priip_kid_url[182];         // bytes 38 to 219
} Kid;

// ---- Market Conditions: 220 bytes --------------------------------------------

// Body Message for InternalMsgType field = 04, 05, which informs about the beginning or the end of a Stressed or an Exceptional Market Conditions State for a given instrument
entrypoint typedef struct _MarketConditions {
  UINT8 isin_code[12];                // bytes 0 to 11
  UINT8 market_conditions_state;      // byte 12
  UINT8 market_conditions_number[4];  // bytes 13 to 16
  UINT8 reserved_203[203];            // bytes 17 to 219
} MarketConditions;

// ---- Open Position Message: 36 bytes -----------------------------------------

// The Open Position message indicates the current number of open positions for a particular instrument
entrypoint typedef struct _OpenPositionMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT8 trading_date[8];            // bytes 12 to 19
  UINT32BE open_position;           // bytes 20 to 23
  UINT32BE transaction_number;      // bytes 24 to 27
  UINT32BE system_id;               // bytes 28 to 31
  UINT16BE source_time_micro_secs;  // bytes 32 to 33
  UINT8 open_position_indicator;    // byte 34
  UINT8 reserved_1;                 // byte 35
} OpenPositionMessage;

