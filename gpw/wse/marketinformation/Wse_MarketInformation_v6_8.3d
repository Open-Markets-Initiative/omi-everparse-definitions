#define LANGUAGE_VERSION_POLISH_VERSION_OF_THE_MESSAGE 0x50   // Polish Version Of The Message
#define LANGUAGE_VERSION_ENGLISH_VERSION_OF_THE_MESSAGE 0x45  // English Version Of The Message
#define LANGUAGE_VERSION_NOT_APPLICABLE 0x20                  // Not Applicable

// Open Position Indicator: one byte code
#define OPEN_POSITION_INDICATOR_OPEN_POSITION_DURING_THE_QUOTATION_PHASE 0x30                                          // Open Position During The Quotation Phase
#define OPEN_POSITION_INDICATOR_OPEN_POSITION_AFTER_THE_END_OF_THE_TRADING_SESSION 0x33                                // Open Position After The End Of The Trading Session
#define OPEN_POSITION_INDICATOR_OPEN_POSITION_BEFORE_THE_START_OF_THE_TRADING_SESSION_VERIFIED_DATA_FROM__v952yb 0x35  // Open Position Before The Start Of The Trading Session Verified Data From The Previous Day

// ---- Types -------------------------------------------------------------------

// The Class State Change message indicates a change in the state of a class
typedef struct _ClassStateChangeMessage {
  UINT32BE source_seq_num;          // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE system_id;               // bytes 8 to 11
  UINT16BE source_time_micro_secs;  // bytes 12 to 13
  UINT8 instrument_group_code[3];   // bytes 14 to 16
  UINT8 instrument_group_state;     // byte 17
  UINT8 session_type;               // byte 18
  UINT8 reserved_1;                 // byte 19
  UINT8 class_state[4];             // bytes 20 to 23
} ClassStateChangeMessage;

// This message supplies a part or a complete electronic message (E-mail), in order to inform members and rebroadcasting members about quotation conditions on a given listed instrument or a set of listed instruments or otherwise about a technical problem
typedef struct _MailMessage {
  UINT32BE source_seq_num;          // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE system_id;               // bytes 8 to 11
  UINT16BE source_time_micro_secs;  // bytes 12 to 13
  UINT8 scope;                      // byte 14
  UINT8 title[80];                  // bytes 15 to 94
  UINT8 mail_text[1000];            // bytes 95 to 1094
  UINT8 reserved_3[3];              // bytes 1095 to 1097
} MailMessage;

// A Collars message informs Clients of modifications in authorized price fluctuations for an instrument
typedef struct _CollarsMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE high_collar;             // bytes 12 to 15
  UINT32BE low_collar;              // bytes 16 to 19
  UINT32BE system_id;               // bytes 20 to 23
  UINT16BE source_time_micro_secs;  // bytes 24 to 25
  UINT8 high_scale_code;            // byte 26
  UINT8 low_scale_code;             // byte 27
  UINT8 collar_type;                // byte 28
  UINT8 reserved_3[3];              // bytes 29 to 31
} CollarsMessage;

// A class phase of the session timetable, the start time of the phase and the phase itself, repeated 15 times
typedef struct _ClassPhase {
  UINT8 class_state_time[4];  // bytes 0 to 3
  UINT8 class_state[4];       // bytes 4 to 7
} ClassPhase;

// The session timetable message indicates the timetable listing all the states changes of a Class for the current trading day
typedef struct _SessionTimetableMessage {
  UINT32BE source_seq_num;          // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE system_id;               // bytes 8 to 11
  UINT16BE source_time_micro_secs;  // bytes 12 to 13
  UINT8 instrument_group_code[3];   // bytes 14 to 16
  UINT8 reserved_1;                 // byte 17
  UINT16BE class_phase_number;      // bytes 18 to 19
  UINT8 class_phase[120];           // bytes 20 to 139
} SessionTimetableMessage;

// The Start referential message is sent to signal the start of transmission of the Instrument Reference Data Flow
typedef struct _StartReferentialMessage {
  UINT8 indicator;      // byte 0
  UINT8 reserved_3[3];  // bytes 1 to 3
} StartReferentialMessage;

// The End referential message is sent to signal the end of transmission of the Instrument Reference Data Flow
typedef struct _EndReferentialMessage {
  UINT8 indicator;      // byte 0
  UINT8 reserved_3[3];  // bytes 1 to 3
} EndReferentialMessage;

// The possible main depository organizations of an instrument. Section 1.2.10.3 gives the entry width, max 5 characters padded with zeros, and the field width, 25 bytes, so the run is five entries; the document does not state the count in words. Used by the clearing house to determine the relevant system for settling trades
typedef struct _DepositaryList {
  UINT8 depositary[5];  // bytes 0 to 4
} DepositaryList;

// The referential message indicates the main characteristics of a listed instrument: Characteristics of the instrument itself Trading characteristics of the instrument Previous trading day price
typedef struct _ReferentialMessage {
  UINT32BE symbol_index;                     // bytes 0 to 3
  UINT32BE source_seq_num;                   // bytes 4 to 7
  UINT32BE source_time;                      // bytes 8 to 11
  UINT32BE last_adj_price;                   // bytes 12 to 15
  UINT32BE system_id;                        // bytes 16 to 19
  UINT32BE prev_volume_traded;               // bytes 20 to 23
  UINT8 reserved_4[4];                       // bytes 24 to 27
  UINT16BE source_time_micro_secs;           // bytes 28 to 29
  UINT16BE stock_exchange_code;              // bytes 30 to 31
  UINT16BE type_of_instrument;               // bytes 32 to 33
  UINT8 event_date[8];                       // bytes 34 to 41
  UINT8 instrument_name[18];                 // bytes 42 to 59
  UINT8 period_indicator;                    // byte 60
  UINT8 type_of_market_admission;            // byte 61
  UINT8 issuing_country_code[3];             // bytes 62 to 64
  UINT8 trading_currency[3];                 // bytes 65 to 67
  UINT8 instrument_group_code[3];            // bytes 68 to 70
  UINT8 instrument_category;                 // byte 71
  UINT8 instrument_code[12];                 // bytes 72 to 83
  UINT8 date_of_last_trade[8];               // bytes 84 to 91
  UINT8 underlying_repo_isin_code[12];       // bytes 92 to 103
  UINT8 expiry_date[8];                      // bytes 104 to 111
  UINT8 first_settlement_date[8];            // bytes 112 to 119
  UINT8 type_of_derivatives;                 // byte 120
  UINT8 bic_depositary[11];                  // bytes 121 to 131
  UINT8 icb[4];                              // bytes 132 to 135
  UINT8 mic[4];                              // bytes 136 to 139
  UINT8 underlying_isin_code[12];            // bytes 140 to 151
  UINT8 depositary_list[25];                 // bytes 152 to 176
  UINT8 main_depositary[5];                  // bytes 177 to 181
  UINT8 type_of_corporate_event[2];          // bytes 182 to 183
  UINT8 time_lag_euronext_utc[5];            // bytes 184 to 188
  UINT8 time_lag_mi_fid_reg_utc[5];          // bytes 189 to 193
  UINT8 cfi[6];                              // bytes 194 to 199
  UINT8 second_reserved_4[4];                // bytes 200 to 203
  UINT8 index_set_of_var_price_tick[2];      // bytes 204 to 205
  UINT8 market_feed_code[2];                 // bytes 206 to 207
  UINT8 mic_list[24];                        // bytes 208 to 231
  UINT8 industry_code[4];                    // bytes 232 to 235
  UINT8 industry_text[100];                  // bytes 236 to 335
  UINT8 financial_market_code[3];            // bytes 336 to 338
  UINT8 us_indicators[7];                    // bytes 339 to 345
  UINT8 reserved_2[2];                       // bytes 346 to 347
  UINT64BE prev_day_capital_traded;          // bytes 348 to 355
  UINT64BE lot_size;                         // bytes 356 to 363
  UINT64BE number_instrument_circ;           // bytes 364 to 371
  UINT64BE shares_out;                       // bytes 372 to 379
  UINT64BE auth_shares;                      // bytes 380 to 387
  UINT8 price_notation[4];                   // bytes 388 to 391
  UINT8 repo_indicator;                      // byte 392
  UINT8 notional_amount[20];                 // bytes 393 to 412
  UINT8 notional_currency[3];                // bytes 413 to 415
  UINT8 last_adj_price_scale_code;           // byte 416
  UINT8 market_indicator;                    // byte 417
  UINT8 prev_day_capital_traded_scale_code;  // byte 418
  UINT8 tax_code;                            // byte 419
  UINT8 reserved_1;                          // byte 420
  UINT8 lot_size_scale_code;                 // byte 421
  UINT8 second_reserved_1;                   // byte 422
  UINT8 mnemo[5];                            // bytes 423 to 427
  UINT8 trading_code[12];                    // bytes 428 to 439
  UINT8 third_reserved_4[4];                 // bytes 440 to 443
  UINT32BE strike_price;                     // bytes 444 to 447
  UINT8 strike_currency[3];                  // bytes 448 to 450
  UINT8 strike_scale_code;                   // byte 451
  UINT32BE currency_coef;                    // bytes 452 to 455
  UINT8 currency_coef_scale_code;            // byte 456
  UINT8 trading_currency_indicator;          // byte 457
  UINT8 strike_currency_indicator;           // byte 458
  UINT8 market_segment[2];                   // bytes 459 to 460
  UINT8 algo;                                // byte 461
  UINT8 local_name[30];                      // bytes 462 to 491
  UINT32BE block_size;                       // bytes 492 to 495
  UINT8 ss_market_maker;                     // byte 496
  UINT8 ss_non_market_maker;                 // byte 497
  UINT8 settlement_delay[2];                 // bytes 498 to 499
  UINT8 option_type;                         // byte 500
  UINT8 delivery_type;                       // byte 501
  UINT8 exercise_type;                       // byte 502
  UINT8 multiplier_scale_code;               // byte 503
  UINT8 warrant_threshold_min_scale_code;    // byte 504
  UINT8 warrant_threshold_max_scale_code;    // byte 505
  UINT8 second_reserved_2[2];                // bytes 506 to 507
  UINT32BE warrant_threshold_min;            // bytes 508 to 511
  UINT32BE warrant_threshold_max;            // bytes 512 to 515
  UINT32BE min_quantity;                     // bytes 516 to 519
  UINT32BE max_quantity;                     // bytes 520 to 523
  UINT32BE multiplier;                       // bytes 524 to 527
  UINT8 fourth_reserved_4[4];                // bytes 528 to 531
  UINT64BE max_value;                        // bytes 532 to 539
} ReferentialMessage;

// This message contains statistical data
typedef struct _SessionSummaryMessage {
  UINT32BE symbol_index;                        // bytes 0 to 3
  UINT32BE source_time;                         // bytes 4 to 7
  UINT32BE source_seq_num;                      // bytes 8 to 11
  UINT32BE date;                                // bytes 12 to 15
  UINT32BE multiplier;                          // bytes 16 to 19
  UINT32BE accumulated_interest;                // bytes 20 to 23
  UINT32BE opening_price;                       // bytes 24 to 27
  UINT32BE maximum_price;                       // bytes 28 to 31
  UINT32BE minimum_price;                       // bytes 32 to 35
  UINT32BE closing_price;                       // bytes 36 to 39
  UINT32BE implied_volatility;                  // bytes 40 to 43
  UINT32BE average_weighted_price;              // bytes 44 to 47
  UINT32BE reference_price;                     // bytes 48 to 51
  UINT32BE pct_change_price;                    // bytes 52 to 55
  UINT32BE dividend_rate;                       // bytes 56 to 59
  UINT32BE settlement_price;                    // bytes 60 to 63
  UINT32BE settlement_value;                    // bytes 64 to 67
  UINT8 reserved_4[4];                          // bytes 68 to 71
  UINT32BE open_positions;                      // bytes 72 to 75
  UINT32BE trading_volume;                      // bytes 76 to 79
  UINT32BE transactions_number;                 // bytes 80 to 83
  UINT64BE trading_value;                       // bytes 84 to 91
  UINT32BE currency_price;                      // bytes 92 to 95
  UINT32BE delta;                               // bytes 96 to 99
  UINT32BE gamma;                               // bytes 100 to 103
  UINT32BE rho;                                 // bytes 104 to 107
  UINT32BE theta;                               // bytes 108 to 111
  UINT32BE vega;                                // bytes 112 to 115
  UINT32BE end_trading;                         // bytes 116 to 119
  UINT32BE number_of_instruments;               // bytes 120 to 123
  UINT64BE trading_value_currency;              // bytes 124 to 131
  UINT32BE interest_rate;                       // bytes 132 to 135
  UINT32BE volatility;                          // bytes 136 to 139
  UINT32BE strike_price;                        // bytes 140 to 143
  UINT32BE short_selling_trades_number;         // bytes 144 to 147
  UINT32BE volume_short_selling_trades;         // bytes 148 to 151
  UINT32BE value_short_selling_trades;          // bytes 152 to 155
  UINT32BE last_trade_date;                     // bytes 156 to 159
  UINT32BE last_trade_price;                    // bytes 160 to 163
  UINT32BE block_trades_number;                 // bytes 164 to 167
  UINT32BE volume_block_trades;                 // bytes 168 to 171
  UINT32BE value_block_trades;                  // bytes 172 to 175
  UINT32BE vwap_blocktrade;                     // bytes 176 to 179
  UINT32BE maximum_block_price;                 // bytes 180 to 183
  UINT32BE minimum_block_price;                 // bytes 184 to 187
  UINT32BE system_id;                           // bytes 188 to 191
  UINT16BE source_time_micro_secs;              // bytes 192 to 193
  UINT8 multiplier_scale_code;                  // byte 194
  UINT8 accumulated_interest_scale_code;        // byte 195
  UINT8 opening_price_scale_code;               // byte 196
  UINT8 maximum_price_scale_code;               // byte 197
  UINT8 minimum_price_scale_code;               // byte 198
  UINT8 closing_price_scale_code;               // byte 199
  UINT8 implied_volatility_scale_code;          // byte 200
  UINT8 average_weighted_price_scale_code;      // byte 201
  UINT8 reference_price_scale_code;             // byte 202
  UINT8 pct_change_price_scale_code;            // byte 203
  UINT8 dividend_rate_scale_code;               // byte 204
  UINT8 settlement_price_scale_code;            // byte 205
  UINT8 settlement_value_scale_code;            // byte 206
  UINT8 reserved_1;                             // byte 207
  UINT8 trading_value_scale_code;               // byte 208
  UINT8 currency_price_scale_code;              // byte 209
  UINT8 delta_scale_code;                       // byte 210
  UINT8 gamma_scale_code;                       // byte 211
  UINT8 rho_scale_code;                         // byte 212
  UINT8 theta_scale_code;                       // byte 213
  UINT8 vega_scale_code;                        // byte 214
  UINT8 trading_value_currency_scale_code;      // byte 215
  UINT8 interest_rate_scale_code;               // byte 216
  UINT8 volatility_scale_code;                  // byte 217
  UINT8 strike_price_scale_code;                // byte 218
  UINT8 value_short_selling_trades_scale_code;  // byte 219
  UINT8 last_trade_price_scale_code;            // byte 220
  UINT8 value_block_trades_scale_code;          // byte 221
  UINT8 vwap_blocktrade_scale_code;             // byte 222
  UINT8 maximum_block_price_scale_code;         // byte 223
  UINT8 minimum_block_price_scale_code;         // byte 224
  UINT8 status_indicator;                       // byte 225
  UINT8 sector[3];                              // bytes 226 to 228
  UINT8 market;                                 // byte 229
  UINT8 second_reserved_1;                      // byte 230
  UINT8 short_sale;                             // byte 231
  UINT8 marker_pct_change_price;                // byte 232
  UINT8 symbol_delta;                           // byte 233
  UINT8 symbol_gamma;                           // byte 234
  UINT8 symbol_rho;                             // byte 235
  UINT8 symbol_theta;                           // byte 236
  UINT8 symbol_vega;                            // byte 237
  UINT8 third_reserved_1;                       // byte 238
  UINT8 fourth_reserved_1;                      // byte 239
  UINT8 fifth_reserved_1;                       // byte 240
  UINT8 sixth_reserved_1;                       // byte 241
  UINT8 seventh_reserved_1;                     // byte 242
  UINT8 eighth_reserved_1;                      // byte 243
  UINT8 segment[2];                             // bytes 244 to 245
  UINT8 lower_liquidity;                        // byte 246
  UINT8 dividend[2];                            // bytes 247 to 248
  UINT8 subscription_right[2];                  // bytes 249 to 250
  UINT8 split[2];                               // bytes 251 to 252
  UINT8 interim_dividend_right[2];              // bytes 253 to 254
  UINT8 quotation_system[2];                    // bytes 255 to 256
  UINT8 liquidity_support_pge[2];               // bytes 257 to 258
  UINT8 ninth_reserved_1;                       // byte 259
} SessionSummaryMessage;

// An 'Instrument State Change' message is generated by the trading engines to announce a change in the state of an instrument
typedef struct _InstrumentStateChangeMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE system_id;               // bytes 12 to 15
  UINT16BE source_time_micro_secs;  // bytes 16 to 17
  UINT8 reserved_2[2];              // bytes 18 to 19
  UINT8 start_date_halting[8];      // bytes 20 to 27
  UINT8 start_time_halting[6];      // bytes 28 to 33
  UINT8 prog_opening_time[6];       // bytes 34 to 39
  UINT8 order_entry_rejection;      // byte 40
  UINT8 instrument_state;           // byte 41
  UINT8 instrument_trading_status;  // byte 42
  UINT8 halt_reason;                // byte 43
  UINT8 action_affecting_state;     // byte 44
  UINT8 instrument_state_tcs;       // byte 45
  UINT8 period_side;                // byte 46
  UINT8 reserved_1;                 // byte 47
} InstrumentStateChangeMessage;

// The Indicative matching price message indicates an instrument's theoretical opening price (also known as an indicative opening price): An IMP-message is sent if the indicative matching price or volume varies
typedef struct _IndicativeMatchingPriceMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE im_price;                // bytes 12 to 15
  UINT32BE variation;               // bytes 16 to 19
  UINT32BE system_id;               // bytes 20 to 23
  UINT16BE source_time_micro_secs;  // bytes 24 to 25
  UINT8 price_scale_code;           // byte 26
  UINT8 variation_scale_code;       // byte 27
  UINT32BE im_volume;               // bytes 28 to 31
} IndicativeMatchingPriceMessage;

// The Short Sale Change message indicates whether an instrument short sale is suspended or re-authorized
typedef struct _ShortSaleChangeMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE system_id;               // bytes 12 to 15
  UINT16BE source_time_micro_secs;  // bytes 16 to 17
  UINT8 text[100];                  // bytes 18 to 117
  UINT8 authority;                  // byte 118
  UINT8 ss_market_maker;            // byte 119
  UINT8 ss_non_market_maker;        // byte 120
  UINT8 reserved_3[3];              // bytes 121 to 123
} ShortSaleChangeMessage;

// Body Message for InternalMsgType = 02, which informs about the structure of the basket of treasury bonds for a given bond future for the next trading day
typedef struct _TreasuryBondFuturesData {
  UINT8 isin_code[12];                       // bytes 0 to 11
  UINT8 date_of_first_quotation[8];          // bytes 12 to 19
  UINT8 short_name[16];                      // bytes 20 to 35
  UINT8 start_date[8];                       // bytes 36 to 43
  UINT8 underlying_isin_code[12];            // bytes 44 to 55
  UINT8 treasury_bond_1_isin_code[12];       // bytes 56 to 67
  UINT8 conversion_coefficient_factor_1[9];  // bytes 68 to 76
  UINT8 treasury_bond_2_isin_code[12];       // bytes 77 to 88
  UINT8 conversion_coefficient_factor_2[9];  // bytes 89 to 97
  UINT8 treasury_bond_3_isin_code[12];       // bytes 98 to 109
  UINT8 conversion_coefficient_factor_3[9];  // bytes 110 to 118
  UINT8 treasury_bond_4_isin_code[12];       // bytes 119 to 130
  UINT8 conversion_coefficient_factor_4[9];  // bytes 131 to 139
  UINT8 treasury_bond_5_isin_code[12];       // bytes 140 to 151
  UINT8 conversion_coefficient_factor_5[9];  // bytes 152 to 160
  UINT8 reserved_59[59];                     // bytes 161 to 219
} TreasuryBondFuturesData;

// Body Message for InternalMsgType field = 03, which informs about the selected values for PRIIPs key information for the given trading day and includes the link to the issuer's website
typedef struct _Kid {
  UINT8 isin_code[12];              // bytes 0 to 11
  UINT8 kid_type_of_instrument[4];  // bytes 12 to 15
  UINT8 kid_version[10];            // bytes 16 to 25
  UINT8 kid_issue_date[8];          // bytes 26 to 33
  UINT8 value_at_risk;              // byte 34
  UINT8 holding_period[3];          // bytes 35 to 37
  UINT8 priip_kid_url[182];         // bytes 38 to 219
} Kid;

// Body Message for InternalMsgType field = 04, 05, which informs about the beginning or the end of a Stressed or an Exceptional Market Conditions State for a given instrument
typedef struct _MarketConditions {
  UINT8 isin_code[12];                // bytes 0 to 11
  UINT8 market_conditions_state;      // byte 12
  UINT8 market_conditions_number[4];  // bytes 13 to 16
  UINT8 reserved_203[203];            // bytes 17 to 219
} MarketConditions;

// Branch
casetype _BodyMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x3032: TreasuryBondFuturesData treasury_bond_futures_data;
    case 0x3033: Kid kid;
    case 0x3034: MarketConditions market_conditions;
    case 0x3035: MarketConditions market_conditions_2;
    default: UINT8 unknown[available];
  }
} BodyMessage;

// This message is a free format message with a container of 250 bytes
typedef struct _GenericWseMessage (UINT32 available) where (available >= 44) {
  UINT32BE source_seq_num;                                                                                          // bytes 0 to 3
  UINT32BE source_time;                                                                                             // bytes 4 to 7
  UINT32BE system_id;                                                                                               // bytes 8 to 11
  UINT16BE source_time_micro_secs;                                                                                  // bytes 12 to 13
  UINT8 source_data;                                                                                                // byte 14
  UINT16BE internal_msg_type;                                                                                       // bytes 15 to 16
  UINT8 event_date[8];                                                                                              // bytes 17 to 24
  UINT8 instrument_id[12];                                                                                          // bytes 25 to 36
  UINT8 instrument_group_code[3];                                                                                   // bytes 37 to 39
  UINT8 msg_type_indicator;                                                                                         // byte 40
  UINT8 language_version;                                                                                           // byte 41
  UINT8 type_off_recipient;                                                                                         // byte 42
  UINT8 msg_serial_num;                                                                                             // byte 43
  BodyMessage(internal_msg_type, (available - 44)) body_message[:byte-size-single-element-array (available - 44)];
} GenericWseMessage;

// The Open Position message indicates the current number of open positions for a particular instrument
typedef struct _OpenPositionMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT8 trading_date[8];            // bytes 12 to 19
  UINT32BE open_position;           // bytes 20 to 23
  UINT32BE transaction_number;      // bytes 24 to 27
  UINT32BE system_id;               // bytes 28 to 31
  UINT16BE source_time_micro_secs;  // bytes 32 to 33
  UINT8 open_position_indicator;    // byte 34
  UINT8 reserved_1;                 // byte 35
} OpenPositionMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0204: ClassStateChangeMessage class_state_change_message;
    case 0x020B: MailMessage mail_message;
    case 0x0219: CollarsMessage collars_message;
    case 0x021B: SessionTimetableMessage session_timetable_message;
    case 0x0226: StartReferentialMessage start_referential_message;
    case 0x0227: EndReferentialMessage end_referential_message;
    case 0x022C: ReferentialMessage referential_message;
    case 0x0231: SessionSummaryMessage session_summary_message;
    case 0x01F9: InstrumentStateChangeMessage instrument_state_change_message;
    case 0x0212: IndicativeMatchingPriceMessage indicative_matching_price_message;
    case 0x0230: ShortSaleChangeMessage short_sale_change_message;
    case 0x0250: GenericWseMessage(available) generic_wse_message;
    case 0x0253: OpenPositionMessage open_position_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_size { message_size >= 2 };                                                                                                                     // bytes 0 to 1
  UINT16BE message_type;                                                                                                                                           // bytes 2 to 3
  Payload(message_type, ((((UINT32) message_size) + 2) - 4)) payload[:byte-size-single-element-array ((((UINT32) message_size) + 2) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// The packet's message area: the messages it counts, or one ZliB block holding them
typedef struct _MessageBuffer (UINT8 number_msg_entries, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_msg_entries); };
} MessageBuffer;

// ---- Packet: Packet ----------------------------------------------------------

// Gpw Xdp Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16BE packet_length;                                                                                                       // bytes 0 to 1
  UINT16BE packet_type;                                                                                                         // bytes 2 to 3
  UINT32BE packet_sequence_number;                                                                                              // bytes 4 to 7
  UINT32BE send_time;                                                                                                           // bytes 8 to 11
  UINT16BE service_id;                                                                                                          // bytes 12 to 13
  UINT8 delivery_flag;                                                                                                          // byte 14
  UINT8 number_msg_entries;                                                                                                     // byte 15
  MessageBuffer(number_msg_entries, (available - 16), tally) message_buffer[:byte-size-single-element-array (available - 16)];
} Packet;

