// Gie da Papier w Warto ciowych w Warszawie Warsaw Stock Exchange Market Information
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out Wse_MarketInformation_v6_8.3d
//
// What this definition does not state, and the model does:
// - a field filling what is left of what holds it
// - a run filling what frames it
// - a run of a stated number of entries
// - the dispatch that chooses a message by its type
//
// License: MIT No Attribution

// ---- Packet Header: 16 bytes -------------------------------------------------

// All messages are preceded by a common packet header format, which section 1.1 states for every Market Information message
entrypoint typedef struct _PacketHeader {
  UINT16BE packet_length;           // bytes 0 to 1
  UINT16BE packet_type;             // bytes 2 to 3
  UINT32BE packet_sequence_number;  // bytes 4 to 7
  UINT32BE send_time;               // bytes 8 to 11
  UINT16BE service_id;              // bytes 12 to 13
  UINT8 delivery_flag;              // byte 14
  UINT8 number_msg_entries;         // byte 15
} PacketHeader;

// ---- Message Header: 4 bytes -------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT16BE message_size;  // bytes 0 to 1
  UINT16BE message_type;  // bytes 2 to 3
} MessageHeader;

// ---- Class State Change Message: 24 bytes ------------------------------------

// The Class State Change message indicates a change in the state of a class
entrypoint typedef struct _ClassStateChangeMessage {
  UINT32BE source_seq_num;          // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE system_id;               // bytes 8 to 11
  UINT16BE source_time_micro_secs;  // bytes 12 to 13
  UINT8 instrument_group_code[3];   // bytes 14 to 16
  UINT8 instrument_group_state;     // byte 17
  UINT8 session_type;               // byte 18
  UINT8 reserved_1;                 // byte 19
  UINT8 class_state[4];             // bytes 20 to 23
} ClassStateChangeMessage;

// ---- Mail Message: 1098 bytes ------------------------------------------------

// This message supplies a part or a complete electronic message (E-mail), in order to inform members and rebroadcasting members about quotation conditions on a given listed instrument or a set of listed instruments or otherwise about a technical problem
entrypoint typedef struct _MailMessage {
  UINT32BE source_seq_num;          // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE system_id;               // bytes 8 to 11
  UINT16BE source_time_micro_secs;  // bytes 12 to 13
  UINT8 scope;                      // byte 14
  UINT8 title[80];                  // bytes 15 to 94
  UINT8 mail_text[1000];            // bytes 95 to 1094
  UINT8 reserved_3[3];              // bytes 1095 to 1097
} MailMessage;

// ---- Collars Message: 32 bytes -----------------------------------------------

// A Collars message informs Clients of modifications in authorized price fluctuations for an instrument
entrypoint typedef struct _CollarsMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE high_collar;             // bytes 12 to 15
  UINT32BE low_collar;              // bytes 16 to 19
  UINT32BE system_id;               // bytes 20 to 23
  UINT16BE source_time_micro_secs;  // bytes 24 to 25
  UINT8 high_scale_code;            // byte 26
  UINT8 low_scale_code;             // byte 27
  UINT8 collar_type;                // byte 28
  UINT8 reserved_3[3];              // bytes 29 to 31
} CollarsMessage;

// ---- Start Referential Message: 4 bytes --------------------------------------

// The Start referential message is sent to signal the start of transmission of the Instrument Reference Data Flow
entrypoint typedef struct _StartReferentialMessage {
  UINT8 indicator;      // byte 0
  UINT8 reserved_3[3];  // bytes 1 to 3
} StartReferentialMessage;

// ---- End Referential Message: 4 bytes ----------------------------------------

// The End referential message is sent to signal the end of transmission of the Instrument Reference Data Flow
entrypoint typedef struct _EndReferentialMessage {
  UINT8 indicator;      // byte 0
  UINT8 reserved_3[3];  // bytes 1 to 3
} EndReferentialMessage;

