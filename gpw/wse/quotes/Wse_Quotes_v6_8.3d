// Gie da Papier w Warto ciowych w Warszawie Warsaw Stock Exchange Quotes
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out Wse_Quotes_v6_8.3d
//
// What this definition does not state, and the model does:
// - a field filling what is left of what holds it
// - a run filling what frames it
//
// License: MIT No Attribution

// ---- Packet Header: 16 bytes -------------------------------------------------

// All messages are preceded by a common packet header format, which section 1.1 states for every Market Information message
entrypoint typedef struct _PacketHeader {
  UINT16BE packet_length;           // bytes 0 to 1
  UINT16BE packet_type;             // bytes 2 to 3
  UINT32BE packet_sequence_number;  // bytes 4 to 7
  UINT32BE send_time;               // bytes 8 to 11
  UINT16BE service_id;              // bytes 12 to 13
  UINT8 delivery_flag;              // byte 14
  UINT8 number_msg_entries;         // byte 15
} PacketHeader;

// ---- Message Header: 4 bytes -------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT16BE message_size;  // bytes 0 to 1
  UINT16BE message_type;  // bytes 2 to 3
} MessageHeader;

// ---- Quotes And Bbo 5 Message: 48 bytes --------------------------------------

// A Quotes BBO5 message indicates the modification of one or more of the N best limits (N being the number of limits disseminated for the given exchange 1 ) for an instrument and, during the Pre-Opening phase, the modification of the market summary for the instrument
entrypoint typedef struct _QuotesAndBbo5Message {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE quote_link_id;           // bytes 12 to 15
  UINT32BE ask_price;               // bytes 16 to 19
  UINT32BE ask_size;                // bytes 20 to 23
  UINT32BE bid_price;               // bytes 24 to 27
  UINT32BE bid_size;                // bytes 28 to 31
  UINT32BE system_id;               // bytes 32 to 35
  UINT16BE number_ask_orders;       // bytes 36 to 37
  UINT16BE number_bid_orders;       // bytes 38 to 39
  UINT16BE source_time_micro_secs;  // bytes 40 to 41
  UINT8 type_of_ask_price;          // byte 42
  UINT8 type_of_bid_price;          // byte 43
  UINT8 quote_condition;            // byte 44
  UINT8 quote_number;               // byte 45
  UINT8 price_scale_code;           // byte 46
  UINT8 reserved_1;                 // byte 47
} QuotesAndBbo5Message;

// ---- Indication Of Interest Message: 160 bytes -------------------------------

// The Indication of Interest message disseminates an indication of interest for a given instrument to all participants
entrypoint typedef struct _IndicationOfInterestMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE ioiutpid;                // bytes 12 to 15
  UINT32BE ioi_qty;                 // bytes 16 to 19
  UINT32BE price;                   // bytes 20 to 23
  UINT32BE validity_time;           // bytes 24 to 27
  UINT32BE system_id;               // bytes 28 to 31
  UINT16BE source_time_micro_secs;  // bytes 32 to 33
  UINT8 price_scale_code;           // byte 34
  UINT8 ioi_trans_type;             // byte 35
  UINT8 firm_id[11];                // bytes 36 to 46
  UINT8 side;                       // byte 47
  UINT8 settlement_date[8];         // bytes 48 to 55
  UINT8 text[100];                  // bytes 56 to 155
  UINT8 trade_type;                 // byte 156
  UINT8 reserved_3[3];              // bytes 157 to 159
} IndicationOfInterestMessage;

