#define TCR_STATUS_ACCEPTED 0x02   // Accepted
#define TCR_STATUS_REJECTED 0x03   // Rejected
#define TCR_STATUS_CANCELLED 0x04  // Cancelled

// Tcr Rejection Reason: 2 byte code
#define TCR_REJECTION_REASON_NA 0x0001                                                                      // Na
#define TCR_REJECTION_REASON_EXCHANGE_CLOSED 0x0002                                                         // Exchange Closed
#define TCR_REJECTION_REASON_INVALID_PRICE_INCREMENT 0x0012                                                 // Invalid Price Increment
#define TCR_REJECTION_REASON_OTHER 0x0063                                                                   // Other
#define TCR_REJECTION_REASON_INSTRUMENT_PHASE_NO_TRADING 0x006A                                             // Instrument Phase No Trading
#define TCR_REJECTION_REASON_UNKNOWN_INSTRUMENT 0x03E9                                                      // Unknown Instrument
#define TCR_REJECTION_REASON_INVALID_EXECUTION_TRADER 0x03ED                                                // Invalid Execution Trader
#define TCR_REJECTION_REASON_INVALID_DECISION_MAKER 0x03EE                                                  // Invalid Decision Maker
#define TCR_REJECTION_REASON_INVALID_CLIENT_ID 0x03EF                                                       // Invalid Client Id
#define TCR_REJECTION_REASON_INVALID_PARTY_ROLE_QUALIFIER_FOR_CLIENT_ID 0x03F0                              // Invalid Party Role Qualifier For Client Id
#define TCR_REJECTION_REASON_INVALID_PARTY_ROLE_QUALIFIER_FOR_EXECUTING_TRADER 0x03F1                       // Invalid Party Role Qualifier For Executing Trader
#define TCR_REJECTION_REASON_INVALID_PARTY_ROLE_QUALIFIER_FOR_INVESTMENT_DECISION_MAKER 0x03F2              // Invalid Party Role Qualifier For Investment Decision Maker
#define TCR_REJECTION_REASON_ORDER_QUANTITY_MUST_BE_GREATER_THAN_MINIMUM_QUANTITY 0x0401                    // Order Quantity Must Be Greater Than Minimum Quantity
#define TCR_REJECTION_REASON_ORDER_QUANTITY_MUST_BE_LOWER_THAN_MAXIMUM_QUANTITY 0x0402                      // Order Quantity Must Be Lower Than Maximum Quantity
#define TCR_REJECTION_REASON_ORDER_PRICE_MUST_BE_GREATER_THAN_MINIMUM_PRICE 0x0403                          // Order Price Must Be Greater Than Minimum Price
#define TCR_REJECTION_REASON_ORDER_PRICE_MUST_BE_LOWER_THAN_MAXIMUM_PRICE 0x0404                            // Order Price Must Be Lower Than Maximum Price
#define TCR_REJECTION_REASON_ORDER_PRICE_MUST_BE_NONZERO 0x0405                                             // Order Price Must Be Nonzero
#define TCR_REJECTION_REASON_ORDER_VALUE_MUST_BE_GREATER_THAN_MINIMUM_VALUE 0x0406                          // Order Value Must Be Greater Than Minimum Value
#define TCR_REJECTION_REASON_ORDER_VALUE_MUST_BE_LOWER_THAN_MAXIMUM_VALUE 0x0407                            // Order Value Must Be Lower Than Maximum Value
#define TCR_REJECTION_REASON_PRICE_BELOW_LOW_COLLAR 0x040D                                                  // Price Below Low Collar
#define TCR_REJECTION_REASON_PRICE_ABOVE_HIGH_COLLAR 0x040E                                                 // Price Above High Collar
#define TCR_REJECTION_REASON_FIRM_IS_NOT_A_MARKET_MAKER 0x041A                                              // Firm Is Not A Market Maker
#define TCR_REJECTION_REASON_OPERATION_ON_REDISTRIBUTED_INSTRUMENTS_FORBIDDEN 0x0420                        // Operation On Redistributed Instruments Forbidden
#define TCR_REJECTION_REASON_FIRM_NOT_AUTHORIZED_TO_BUY_AND_SELL_THE_INSTRUMENT 0x0421                      // Firm Not Authorized To Buy And Sell The Instrument
#define TCR_REJECTION_REASON_FIRM_NOT_AUTHORIZED_TO_BUY_THE_INSTRUMENT 0x0422                               // Firm Not Authorized To Buy The Instrument
#define TCR_REJECTION_REASON_FIRM_NOT_AUTHORIZED_TO_SELL_THE_INSTRUMENT 0x0423                              // Firm Not Authorized To Sell The Instrument
#define TCR_REJECTION_REASON_OPERATIONS_ON_ORDERS_AND_QUOTES_FORBIDDEN_DURING_INSTRUMENT_SUSPENSION 0x0425  // Operations On Orders And Quotes Forbidden During Instrument Suspension
#define TCR_REJECTION_REASON_INVALID_PARTY_ID_FOR_CLIENT_ID 0x042E                                          // Invalid Party Id For Client Id
#define TCR_REJECTION_REASON_INVALID_PARTY_ID_FOR_EXECUTING_TRADER 0x042F                                   // Invalid Party Id For Executing Trader
#define TCR_REJECTION_REASON_INVALID_PARTY_ID_FOR_INVESTMENT_DECISION_MAKER 0x0430                          // Invalid Party Id For Investment Decision Maker
#define TCR_REJECTION_REASON_INVALID_PARTY_ROLE_QUALIFIER_FOR_PARTY_ID 0x0433                               // Invalid Party Role Qualifier For Party Id
#define TCR_REJECTION_REASON_MISSING_CLEARING_MEMBER_CODE 0x0434                                            // Missing Clearing Member Code
#define TCR_REJECTION_REASON_FORBIDDEN_CLEARING_MEMBER_CODE 0x0435                                          // Forbidden Clearing Member Code
#define TCR_REJECTION_REASON_MARKET_MODEL_NOT_SUPPORTED_ON_SPONSORED_CONNECTION 0x0439                      // Market Model Not Supported On Sponsored Connection
#define TCR_REJECTION_REASON_OPERATION_FORBIDDEN_DURING_EARLY_LATE_MONITORING 0x043C                        // Operation Forbidden During Early Late Monitoring
#define TCR_REJECTION_REASON_INVALID_CLEARING_MEMBER_CODE_LENGTH 0x043D                                     // Invalid Clearing Member Code Length
#define TCR_REJECTION_REASON_NOT_AUTHORIZED_TO_QUOTE_INSTRUMENT 0x04B9                                      // Not Authorized To Quote Instrument
#define TCR_REJECTION_REASON_UNKNOWN_TRADE_REPORT 0x07D1                                                    // Unknown Trade Report
#define TCR_REJECTION_REASON_DUPLICATE_TRADE_REPORT_ID 0x07D2                                               // Duplicate Trade Report Id
#define TCR_REJECTION_REASON_TRADE_REPORT_TYPE_NOT_COMPATIBLE_WITH_TRADE_REPORT_TRANS_TYPE 0x07D5           // Trade Report Type Not Compatible With Trade Report Trans Type
#define TCR_REJECTION_REASON_INVALID_EXEC_TYPE 0x07D8                                                       // Invalid Exec Type
#define TCR_REJECTION_REASON_TRADE_REPORT_REF_ID_NOT_ALLOWED 0x07D9                                         // Trade Report Ref Id Not Allowed
#define TCR_REJECTION_REASON_SETTLEMENT_DATE_CANNOT_BE_EARLIER_THAN_MINIMUM_SETTLEMENT_DATE 0x07DF          // Settlement Date Cannot Be Earlier Than Minimum Settlement Date
#define TCR_REJECTION_REASON_SETTLEMENT_DATE_CANNOT_BE_LATER_THAN_MAXIMUM_SETTLEMENT_DATE 0x07E0            // Settlement Date Cannot Be Later Than Maximum Settlement Date
#define TCR_REJECTION_REASON_SETTLEMENT_DATE_MUST_BE_A_SETTLEMENT_DAY 0x07E1                                // Settlement Date Must Be A Settlement Day
#define TCR_REJECTION_REASON_UNKNOWN_CONTRA_FIRM 0x07E6                                                     // Unknown Contra Firm
#define TCR_REJECTION_REASON_SENT_ATTRIBUTE_DOES_NOT_MATCH_ORIGINAL_VALUE 0x07E8                            // Sent Attribute Does Not Match Original Value
#define TCR_REJECTION_REASON_REQUEST_NOT_ALLOWED_FOR_BLOCK_INSTRUMENT 0x07EA                                // Request Not Allowed For Block Instrument
#define TCR_REJECTION_REASON_REQUEST_NOT_ALLOWED_FOR_CLOB_INSTRUMENT 0x07EB                                 // Request Not Allowed For Clob Instrument
#define TCR_REJECTION_REASON_REQUEST_NOT_ALLOWED_FOR_CROSS_INSTRUMENT 0x07EC                                // Request Not Allowed For Cross Instrument
#define TCR_REJECTION_REASON_CROSS_NOT_ALLOWED_OUTSIDE_OF_CLOB_INSTRUMENT_SPREAD 0x07EE                     // Cross Not Allowed Outside Of Clob Instrument Spread
#define TCR_REJECTION_REASON_CROSS_PRICE_NOT_EQUAL_TO_THE_REFERENCE_PRICE 0x07EF                            // Cross Price Not Equal To The Reference Price
#define TCR_REJECTION_REASON_CROSS_NOT_ALLOWED_DURING_CLOB_INSTRUMENT_AUCTION_OR_SUSPENSION 0x07F0          // Cross Not Allowed During Clob Instrument Auction Or Suspension
#define TCR_REJECTION_REASON_FORBIDDEN_SECONDARY_TRADEREPORT_ID 0x07F1                                      // Forbidden Secondary Tradereport Id
#define TCR_REJECTION_REASON_UNKNOWN_SECONDARY_TRADEREPORT_ID 0x07F2                                        // Unknown Secondary Tradereport Id
#define TCR_REJECTION_REASON_NO_TRADE_FOR_CLOB_REFERENCE_INSTRUMENT 0x07F3                                  // No Trade For Clob Reference Instrument

// ---- Types -------------------------------------------------------------------

// The login message authenticates a user establishing a connection to the trading port service. The login message must be the first message sent by the client application to request the initiation of a trading port session
typedef struct _Login {
  UINT16 version;                // bytes 0 to 1
  UINT8 token[8];                // bytes 2 to 9
  UINT16 connection_id;          // bytes 10 to 11
  UINT32 next_expected_seq_num;  // bytes 12 to 15
  UINT32 last_sent_seq_num;      // bytes 16 to 19
} Login;

// The login response message. The result field describes the login status, indicating whether the login was successful or not (i.e. successful login)
typedef struct _LoginResponse {
  UINT8 login_result;            // byte 0
  UINT32 next_expected_seq_num;  // bytes 1 to 4
  UINT32 last_replay_seq_num;    // bytes 5 to 8
  UINT16 session_id;             // bytes 9 to 10
} LoginResponse;

// The ConnectionClose message confirms the termination of a session through the trading port service
typedef struct _ConnectionClose {
  UINT8 connection_close_reason;  // byte 0
} ConnectionClose;

// The reject message is sent by the trading port service when receiving an erroneous message that cannot be further processed
typedef struct _Reject {
  UINT32 ref_seq_num;   // bytes 0 to 3
  UINT8 reject_reason;  // byte 4
} Reject;

// The internal message for a test purpose
typedef struct _Test {
  UINT64 target_timestamp;  // bytes 0 to 7
} Test;

// Test event
typedef struct _TestEvent {
  UINT8 scenario_name[200];  // bytes 0 to 199
  UINT8 event_type;          // byte 200
} TestEvent;

// The Trading Session Status provides information on the status of a trading session
typedef struct _TradingSessionStatus {
  UINT8 market_id[4];           // bytes 0 to 3
  UINT32 date;                  // bytes 4 to 7
  UINT8 trading_session_event;  // byte 8
} TradingSessionStatus;

// MifidField
typedef struct _Client {
  UINT32 short_code;  // bytes 0 to 3
  UINT8 qualifier;    // byte 4
} Client;

// MifidFields
typedef struct _MifidFields {
  Client client;                     // bytes 0 to 4
  Client executing_trader;           // bytes 5 to 9
  Client investment_decision_maker;  // bytes 10 to 14
} MifidFields;

// Message used to add new orders to the system
typedef struct _OrderAdd {
  UINT8 stp_id;                               // byte 0
  UINT32 instrument_id;                       // bytes 1 to 4
  UINT8 order_type;                           // byte 5
  UINT8 time_in_force;                        // byte 6
  UINT8 side;                                 // byte 7
  UINT64 price;                               // bytes 8 to 15, signed, read here as unsigned
  UINT64 trigger_price;                       // bytes 16 to 23, signed, read here as unsigned
  UINT64 quantity;                            // bytes 24 to 31
  UINT64 display_qty;                         // bytes 32 to 39
  UINT8 capacity;                             // byte 40
  UINT8 account[16];                          // bytes 41 to 56
  UINT8 account_type;                         // byte 57
  UINT8 liquidity_provision_activity : 1;     // byte 58
  UINT8 direct_or_sponsored_access : 1;       // byte 58
  UINT8 market_maker_or_specialist : 1;       // byte 58
  UINT8 reserved_3_to_7 : 5;                  // byte 58
  MifidFields mifid_fields;                   // bytes 59 to 73
  UINT64 expire;                              // bytes 74 to 81
  UINT8 memo[18];                             // bytes 82 to 99
  UINT8 client_order_id[20];                  // bytes 100 to 119
  UINT8 clearing_member_code[20];             // bytes 120 to 139
  UINT8 clearing_member_clearing_identifier;  // byte 140
  UINT8 cancel_on_connection_loss : 1;        // byte 141
  UINT8 reserved_1_to_7 : 7;                  // byte 141
  UINT8 fee_structure_id;                     // byte 142
  UINT8 interested_party[8];                  // bytes 143 to 150
} OrderAdd;

// The message is a response to an OrderAdd message and includes the order execution status
typedef struct _OrderAddResponse {
  UINT64 seq_num : 28;                 // bytes 0 to 7
  UINT64 bulk_seq_num : 8;             // bytes 0 to 7
  UINT64 session_id_order_id : 14;     // bytes 0 to 7
  UINT64 connection_id_order_id : 14;  // bytes 0 to 7
  UINT64 public_order_id;              // bytes 8 to 15
  UINT64 display_qty;                  // bytes 16 to 23
  UINT64 filled;                       // bytes 24 to 31
  UINT8 order_status;                  // byte 32
  UINT16 order_rejection_reason;       // bytes 33 to 34
  UINT8 exec_type_reason;              // byte 35
  UINT8 client_order_id[20];           // bytes 36 to 55
} OrderAddResponse;

// Message used to cancel the previously submitted order
typedef struct _OrderCancel {
  UINT64 seq_num : 28;                 // bytes 0 to 7
  UINT64 bulk_seq_num : 8;             // bytes 0 to 7
  UINT64 session_id_order_id : 14;     // bytes 0 to 7
  UINT64 connection_id_order_id : 14;  // bytes 0 to 7
  MifidFields mifid_fields;            // bytes 8 to 22
  UINT8 client_order_id[20];           // bytes 23 to 42
} OrderCancel;

// The message is a response to an order cancel request and contains information about its execution, in particular whether the order to cancel was found or not
typedef struct _OrderCancelResponse {
  UINT64 seq_num : 28;                 // bytes 0 to 7
  UINT64 bulk_seq_num : 8;             // bytes 0 to 7
  UINT64 session_id_order_id : 14;     // bytes 0 to 7
  UINT64 connection_id_order_id : 14;  // bytes 0 to 7
  UINT8 order_status;                  // byte 8
  UINT16 order_rejection_reason;       // bytes 9 to 10
  UINT8 exec_type_reason;              // byte 11
  UINT8 client_order_id[20];           // bytes 12 to 31
} OrderCancelResponse;

// Message used to modify the submitted order
typedef struct _OrderModify {
  UINT64 seq_num : 28;                 // bytes 0 to 7
  UINT64 bulk_seq_num : 8;             // bytes 0 to 7
  UINT64 session_id_order_id : 14;     // bytes 0 to 7
  UINT64 connection_id_order_id : 14;  // bytes 0 to 7
  UINT64 price;                        // bytes 8 to 15, signed, read here as unsigned
  UINT64 trigger_price;                // bytes 16 to 23, signed, read here as unsigned
  UINT64 quantity;                     // bytes 24 to 31
  UINT64 display_qty;                  // bytes 32 to 39
  UINT64 expire;                       // bytes 40 to 47
  MifidFields mifid_fields;            // bytes 48 to 62
  UINT8 client_order_id[20];           // bytes 63 to 82
} OrderModify;

// The response message for an OrderModify
typedef struct _OrderModifyResponse {
  UINT64 seq_num : 28;                 // bytes 0 to 7
  UINT64 bulk_seq_num : 8;             // bytes 0 to 7
  UINT64 session_id_order_id : 14;     // bytes 0 to 7
  UINT64 connection_id_order_id : 14;  // bytes 0 to 7
  UINT64 filled;                       // bytes 8 to 15
  UINT8 order_status;                  // byte 16
  UINT8 priority_flag;                 // byte 17
  UINT16 order_rejection_reason;       // bytes 18 to 19
  UINT8 client_order_id[20];           // bytes 20 to 39
} OrderModifyResponse;

// Message used to cancel multiple existing orders
typedef struct _OrderMassCancel {
  UINT8 mass_cancel_request_type;  // byte 0
  UINT8 target_party_role;         // byte 1
  UINT32 target_party_id;          // bytes 2 to 5
  UINT32 market_segment_id;        // bytes 6 to 9
  UINT32 instrument_id;            // bytes 10 to 13
  Client executing_trader;         // bytes 14 to 18
  UINT8 client_order_id[20];       // bytes 19 to 38
} OrderMassCancel;

// Response to message used to cancel multiple existing orders
typedef struct _OrderMassCancelResponse {
  UINT64 total_affected_orders;         // bytes 0 to 7
  UINT8 mass_cancel_request_type;       // byte 8
  UINT64 seq_num : 28;                  // bytes 9 to 16
  UINT64 bulk_seq_num : 8;              // bytes 9 to 16
  UINT64 session_id_order_id : 14;      // bytes 9 to 16
  UINT64 connection_id_order_id : 14;   // bytes 9 to 16
  UINT8 target_party_role;              // byte 17
  UINT32 target_party_id;               // bytes 18 to 21
  UINT32 market_segment_id;             // bytes 22 to 25
  UINT16 mass_cancel_rejection_reason;  // bytes 26 to 27
  UINT8 client_order_id[20];            // bytes 28 to 47
} OrderMassCancelResponse;

// The message used to report trades between counterparties (i.e. generated when two or more orders are matched)
typedef struct _OrderExecute {
  UINT32 instrument_id;                // bytes 0 to 3
  UINT64 seq_num : 28;                 // bytes 4 to 11
  UINT64 bulk_seq_num : 8;             // bytes 4 to 11
  UINT64 session_id_order_id : 14;     // bytes 4 to 11
  UINT64 connection_id_order_id : 14;  // bytes 4 to 11
  UINT32 trade_id;                     // bytes 12 to 15
  UINT64 price;                        // bytes 16 to 23, signed, read here as unsigned
  UINT64 quantity;                     // bytes 24 to 31
  UINT64 leaves_qty;                   // bytes 32 to 39
  UINT8 liquidity_indicator;           // byte 40
  UINT16 currency;                     // bytes 41 to 42
  UINT8 side;                          // byte 43
  UINT8 client_order_id[20];           // bytes 44 to 63
} OrderExecute;

// QuoteOrder
typedef struct _Bid {
  UINT64 price;     // bytes 0 to 7, signed, read here as unsigned
  UINT64 quantity;  // bytes 8 to 15
} Bid;

// Quote
typedef struct _Quote {
  UINT32 instrument_id;  // bytes 0 to 3
  Bid bid;               // bytes 4 to 19
  Bid ask;               // bytes 20 to 35
} Quote;

// The Array of quotes
typedef struct _ItemsQuotesArray {
  Quote quote_;  // bytes 0 to 35
} ItemsQuotesArray;

// Quotes
typedef struct _Quotes {
  UINT8 count;                                           // byte 0
  ItemsQuotesArray items_quotes_array[:byte-size 1080];  // bytes 1 to 1080
} Quotes;

// Mass Quote
typedef struct _MassQuote {
  UINT8 stp_id;                               // byte 0
  UINT8 capacity;                             // byte 1
  UINT8 account[16];                          // bytes 2 to 17
  UINT8 account_type;                         // byte 18
  UINT8 liquidity_provision_activity : 1;     // byte 19
  UINT8 direct_or_sponsored_access : 1;       // byte 19
  UINT8 market_maker_or_specialist : 1;       // byte 19
  UINT8 reserved_3_to_7 : 5;                  // byte 19
  MifidFields mifid_fields;                   // bytes 20 to 34
  UINT8 memo[18];                             // bytes 35 to 52
  UINT8 clearing_member_code[20];             // bytes 53 to 72
  UINT8 clearing_member_clearing_identifier;  // byte 73
  Quotes quotes;                              // bytes 74 to 1154
  UINT8 fee_structure_id;                     // byte 1155
  UINT8 interested_party[8];                  // bytes 1156 to 1163
  UINT8 quote_id[20];                         // bytes 1164 to 1183
} MassQuote;

// QuoteOrderResponse
typedef struct _QuoteOrderResponse {
  UINT32 instrument_id;                  // bytes 0 to 3
  UINT64 seq_num : 28;                   // bytes 4 to 11
  UINT64 bulk_seq_num : 8;               // bytes 4 to 11
  UINT64 session_id_order_id : 14;       // bytes 4 to 11
  UINT64 connection_id_order_id : 14;    // bytes 4 to 11
  UINT64 seq_num_2 : 28;                 // bytes 12 to 19
  UINT64 bulk_seq_num_2 : 8;             // bytes 12 to 19
  UINT64 session_id_order_id_2 : 14;     // bytes 12 to 19
  UINT64 connection_id_order_id_2 : 14;  // bytes 12 to 19
  UINT8 order_status;                    // byte 20
  UINT16 order_rejection_reason;         // bytes 21 to 22
} QuoteOrderResponse;

// An array of QuoteOrderResponse
typedef struct _ItemsQuoteOrderResponseArray {
  QuoteOrderResponse quote_order_response;  // bytes 0 to 22
} ItemsQuoteOrderResponseArray;

// QuoteOrderResponses
typedef struct _Responses {
  UINT8 count;                                                                    // byte 0
  ItemsQuoteOrderResponseArray items_quote_order_response_array[:byte-size 690];  // bytes 1 to 690
} Responses;

// The response to a MassQuote message
typedef struct _MassQuoteResponse {
  UINT64 seq_num : 28;                 // bytes 0 to 7
  UINT64 bulk_seq_num : 8;             // bytes 0 to 7
  UINT64 session_id_order_id : 14;     // bytes 0 to 7
  UINT64 connection_id_order_id : 14;  // bytes 0 to 7
  Responses responses;                 // bytes 8 to 698
  UINT8 mass_quote_status;             // byte 699
  UINT16 mass_quote_rejection_reason;  // bytes 700 to 701
  UINT8 fee_structure_id;              // byte 702
} MassQuoteResponse;

// Market Maker command request
typedef struct _MarketMakerCommand {
  UINT32 instrument_id;  // bytes 0 to 3
  UINT8 action;          // byte 4
} MarketMakerCommand;

// The response to the Market Maker command
typedef struct _MarketMakerCommandResponse {
  UINT32 ref_id;          // bytes 0 to 3
  UINT8 command_result;   // byte 4
  UINT16 rejection_code;  // bytes 5 to 6
} MarketMakerCommandResponse;

// The information for the MM that one of the quotes has been crossed
typedef struct _RequestForExecution {
  UINT32 instrument_id;                // bytes 0 to 3
  UINT8 request_for_execution_reason;  // byte 4
} RequestForExecution;

// Message send during the IPO to the sell side or during the Tender Offer to the buy side
typedef struct _BidOfferUpdate {
  UINT32 instrument_id;     // bytes 0 to 3
  UINT8 update_type;        // byte 4
  UINT64 total_bid_size;    // bytes 5 to 12
  UINT64 total_offer_size;  // bytes 13 to 20
  UINT32 bid_orders;        // bytes 21 to 24
  UINT32 offer_orders;      // bytes 25 to 28
} BidOfferUpdate;

// TcrParty
typedef struct _TcrParty {
  UINT8 liquidity_provision_activity : 1;     // byte 0
  UINT8 direct_or_sponsored_access : 1;       // byte 0
  UINT8 market_maker_or_specialist : 1;       // byte 0
  UINT8 reserved_3_to_7 : 5;                  // byte 0
  MifidFields mifid_fields;                   // bytes 1 to 15
  UINT8 clearing_member_code[20];             // bytes 16 to 35
  UINT8 clearing_member_clearing_identifier;  // byte 36
  UINT8 account[16];                          // bytes 37 to 52
  UINT8 account_type;                         // byte 53
  UINT8 order_capacity;                       // byte 54
  UINT8 fee_structure_id;                     // byte 55
  UINT8 interested_party[8];                  // bytes 56 to 63
  UINT8 memo[18];                             // bytes 64 to 81
} TcrParty;

// Trade Capture Report - single side
typedef struct _TradeCaptureReportSingle {
  UINT32 instrument_id;                // bytes 0 to 3
  UINT8 trade_report_id[21];           // bytes 4 to 24
  UINT64 seq_num : 28;                 // bytes 25 to 32
  UINT64 bulk_seq_num : 8;             // bytes 25 to 32
  UINT64 session_id_order_id : 14;     // bytes 25 to 32
  UINT64 connection_id_order_id : 14;  // bytes 25 to 32
  UINT32 trade_id;                     // bytes 33 to 36
  UINT8 trade_report_trans_type;       // byte 37
  UINT8 trade_report_type;             // byte 38
  UINT8 trade_type;                    // byte 39
  UINT8 algorithmic_trade_indicator;   // byte 40
  UINT8 exec_type;                     // byte 41
  UINT8 trade_report_ref_id[21];       // bytes 42 to 62
  UINT64 last_qty;                     // bytes 63 to 70
  UINT64 last_px;                      // bytes 71 to 78, signed, read here as unsigned
  UINT32 settlement_date;              // bytes 79 to 82
  UINT8 side;                          // byte 83
  UINT8 counterparty_code[16];         // bytes 84 to 99
  TcrParty tcr_party;                  // bytes 100 to 181
} TradeCaptureReportSingle;

// Trade Capture Report - dual sided
typedef struct _TradeCaptureReportDual {
  UINT32 instrument_id;                // bytes 0 to 3
  UINT8 trade_report_id[21];           // bytes 4 to 24
  UINT64 seq_num : 28;                 // bytes 25 to 32
  UINT64 bulk_seq_num : 8;             // bytes 25 to 32
  UINT64 session_id_order_id : 14;     // bytes 25 to 32
  UINT64 connection_id_order_id : 14;  // bytes 25 to 32
  UINT32 trade_id;                     // bytes 33 to 36
  UINT8 trade_report_trans_type;       // byte 37
  UINT8 trade_report_type;             // byte 38
  UINT8 trade_type;                    // byte 39
  UINT8 algorithmic_trade_indicator;   // byte 40
  UINT8 exec_type;                     // byte 41
  UINT8 trade_report_ref_id[21];       // bytes 42 to 62
  UINT64 last_qty;                     // bytes 63 to 70
  UINT64 last_px;                      // bytes 71 to 78, signed, read here as unsigned
  UINT32 settlement_date;              // bytes 79 to 82
  TcrParty tcr_party_buy;              // bytes 83 to 164
  TcrParty tcr_party_sell;             // bytes 165 to 246
} TradeCaptureReportDual;

// The message is a response to an Trade Capture Report message, containing the state of TCR execution
typedef struct _TradeCaptureReportResponse {
  UINT32 instrument_id;                // bytes 0 to 3
  UINT32 trade_id;                     // bytes 4 to 7
  UINT8 trade_report_id[21];           // bytes 8 to 28
  UINT64 seq_num : 28;                 // bytes 29 to 36
  UINT64 bulk_seq_num : 8;             // bytes 29 to 36
  UINT64 session_id_order_id : 14;     // bytes 29 to 36
  UINT64 connection_id_order_id : 14;  // bytes 29 to 36
  UINT8 tcr_status;                    // byte 37
  UINT16 tcr_rejection_reason;         // bytes 38 to 39
} TradeCaptureReportResponse;

// Message used to inform about cancellation of previously accepted Trade
typedef struct _TradeBust {
  UINT32 trade_id;  // bytes 0 to 3
} TradeBust;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0002: Login login;
    case 0x0003: LoginResponse login_response;
    case 0x000B: unit logout;
    case 0x000E: unit logout_response;
    case 0x000C: ConnectionClose connection_close;
    case 0x000D: unit heartbeat;
    case 0x000F: Reject reject;
    case 0x0022: unit gap_fill;
    case 0x0001: Test test;
    case 0x00FF: TestEvent test_event;
    case 0x0023: TradingSessionStatus trading_session_status;
    case 0x0004: OrderAdd order_add;
    case 0x0005: OrderAddResponse order_add_response;
    case 0x0006: OrderCancel order_cancel;
    case 0x0007: OrderCancelResponse order_cancel_response;
    case 0x0008: OrderModify order_modify;
    case 0x0009: OrderModifyResponse order_modify_response;
    case 0x001D: OrderMassCancel order_mass_cancel;
    case 0x001E: OrderMassCancelResponse order_mass_cancel_response;
    case 0x000A: OrderExecute order_execute;
    case 0x0018: MassQuote mass_quote;
    case 0x0019: MassQuoteResponse mass_quote_response;
    case 0x0020: MarketMakerCommand market_maker_command;
    case 0x0021: MarketMakerCommandResponse market_maker_command_response;
    case 0x001C: RequestForExecution request_for_execution;
    case 0x001F: BidOfferUpdate bid_offer_update;
    case 0x0012: TradeCaptureReportSingle trade_capture_report_single;
    case 0x0013: TradeCaptureReportDual trade_capture_report_dual;
    case 0x0014: TradeCaptureReportResponse trade_capture_report_response;
    case 0x0017: TradeBust trade_bust;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message {
  UINT16 message_length { message_length >= 24 };                                                                                     // bytes 0 to 1
  UINT16 message_type;                                                                                                                // bytes 2 to 3
  UINT32 sequence_number;                                                                                                             // bytes 4 to 7
  UINT64 timestamp;                                                                                                                   // bytes 8 to 15
  UINT64 source_timestamp;                                                                                                            // bytes 16 to 23
  Payload(message_type, (((UINT32) message_length) - 24)) payload[:byte-size-single-element-array (((UINT32) message_length) - 24)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Gpw Wats Native Order Gateway Packet
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

