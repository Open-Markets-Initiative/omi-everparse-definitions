// Product Type: one byte code
#define PRODUCT_TYPE_EQUITY 0x01              // Equity
#define PRODUCT_TYPE_FIXED_INCOME 0x02        // Fixed Income
#define PRODUCT_TYPE_DERIVATIVE_FUTURES 0x03  // Derivative Futures
#define PRODUCT_TYPE_DERIVATIVE_OPTIONS 0x04  // Derivative Options
#define PRODUCT_TYPE_INDEX 0x05               // Index
#define PRODUCT_TYPE_CURRENCY 0x06            // Currency
#define PRODUCT_TYPE_STRUCTURED_PRODUCT 0x07  // Structured Product
#define PRODUCT_TYPE_TRACKER 0x09             // Tracker

// Product Subtype: one byte code
#define PRODUCT_SUBTYPE_SHARE 0x01                             // Share
#define PRODUCT_SUBTYPE_ALLOTMENT_RIGHT 0x02                   // Allotment Right
#define PRODUCT_SUBTYPE_SUBSCRIPTION_RIGHT 0x03                // Subscription Right
#define PRODUCT_SUBTYPE_TENDER_OFFER 0x04                      // Tender Offer
#define PRODUCT_SUBTYPE_ISSUE_RIGHT 0x05                       // Issue Right
#define PRODUCT_SUBTYPE_SUBSCRIPTION_WARRANT 0x06              // Subscription Warrant
#define PRODUCT_SUBTYPE_BANK_SECURITIES 0x07                   // Bank Securities
#define PRODUCT_SUBTYPE_BOND 0x08                              // Bond
#define PRODUCT_SUBTYPE_TREASURY_BOND 0x09                     // Treasury Bond
#define PRODUCT_SUBTYPE_AGENCY_BOND 0x0A                       // Agency Bond
#define PRODUCT_SUBTYPE_MUNICIPAL_BOND 0x0B                    // Municipal Bond
#define PRODUCT_SUBTYPE_CORPORATE_BANK_BOND 0x0C               // Corporate Bank Bond
#define PRODUCT_SUBTYPE_CORPORATE_FIRM_BOND 0x0D               // Corporate Firm Bond
#define PRODUCT_SUBTYPE_CONVERTIBLE_BOND 0x0E                  // Convertible Bond
#define PRODUCT_SUBTYPE_MORTGAGE_BOND 0x0F                     // Mortgage Bond
#define PRODUCT_SUBTYPE_MORTGAGE_BACKED_BOND 0x10              // Mortgage Backed Bond
#define PRODUCT_SUBTYPE_PUBLIC_MORTGAGE_BOND 0x11              // Public Mortgage Bond
#define PRODUCT_SUBTYPE_BILL 0x12                              // Bill
#define PRODUCT_SUBTYPE_TREASURY_BILL 0x13                     // Treasury Bill
#define PRODUCT_SUBTYPE_COMMERCIAL_BILL 0x14                   // Commercial Bill
#define PRODUCT_SUBTYPE_EXCHANGE_TRADED_FUND 0x15              // Exchange Traded Fund
#define PRODUCT_SUBTYPE_EXCHANGE_TRADED_NOTE 0x16              // Exchange Traded Note
#define PRODUCT_SUBTYPE_EXCHANGE_TRADED_COMMODITY 0x17         // Exchange Traded Commodity
#define PRODUCT_SUBTYPE_INVESTMENT_CERTIFICATE 0x18            // Investment Certificate
#define PRODUCT_SUBTYPE_INDEX_FUTURES 0x19                     // Index Futures
#define PRODUCT_SUBTYPE_STOCK_FUTURES 0x1A                     // Stock Futures
#define PRODUCT_SUBTYPE_CURRENCY_FUTURES 0x1B                  // Currency Futures
#define PRODUCT_SUBTYPE_BOND_FUTURES 0x1C                      // Bond Futures
#define PRODUCT_SUBTYPE_INTEREST_RATE_FUTURES 0x1D             // Interest Rate Futures
#define PRODUCT_SUBTYPE_INDEX_OPTIONS 0x1E                     // Index Options
#define PRODUCT_SUBTYPE_STOCK_OPTIONS 0x1F                     // Stock Options
#define PRODUCT_SUBTYPE_OPTION_WARRANTS 0x20                   // Option Warrants
#define PRODUCT_SUBTYPE_FACTOR_CERTIFICATES 0x21               // Factor Certificates
#define PRODUCT_SUBTYPE_TURBO_CERTIFICATES 0x22                // Turbo Certificates
#define PRODUCT_SUBTYPE_CAPITAL_PROTECTION_CERTIFICATES 0x23   // Capital Protection Certificates
#define PRODUCT_SUBTYPE_BONUS_CERTIFICATES 0x24                // Bonus Certificates
#define PRODUCT_SUBTYPE_REVERSE_CONVERTIBLE_CERTIFICATES 0x25  // Reverse Convertible Certificates
#define PRODUCT_SUBTYPE_EXPRESS_CERTIFICATES 0x26              // Express Certificates
#define PRODUCT_SUBTYPE_DISCOUNT_CERTIFICATES 0x27             // Discount Certificates
#define PRODUCT_SUBTYPE_INDEX_TRACKER_CERTIFICATES 0x28        // Index Tracker Certificates
#define PRODUCT_SUBTYPE_OTHER_INVESTMENT_CERTIFICATES 0x29     // Other Investment Certificates
#define PRODUCT_SUBTYPE_STRUCTURED_NOTES 0x2A                  // Structured Notes
#define PRODUCT_SUBTYPE_REFERENCE_RATE 0x2B                    // Reference Rate
#define PRODUCT_SUBTYPE_INTEREST_RATE 0x2C                     // Interest Rate
#define PRODUCT_SUBTYPE_EXCHANGE_RATE 0x2D                     // Exchange Rate
#define PRODUCT_SUBTYPE_PRICE_INDEX 0x2E                       // Price Index
#define PRODUCT_SUBTYPE_TOTAL_RETURN_INDEX 0x2F                // Total Return Index
#define PRODUCT_SUBTYPE_SECTOR_PRICE_INDEX 0x30                // Sector Price Index
#define PRODUCT_SUBTYPE_SECTOR_TOTAL_RETURN_INDEX 0x31         // Sector Total Return Index
#define PRODUCT_SUBTYPE_DIVIDEND_INDEX 0x32                    // Dividend Index
#define PRODUCT_SUBTYPE_STRATEGY_PRICE_INDEX 0x33              // Strategy Price Index
