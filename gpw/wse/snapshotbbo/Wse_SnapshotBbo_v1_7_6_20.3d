// Us Indicator: one byte code
#define US_INDICATOR_NOT_APPLICABLE 0x01               // Not Applicable
#define US_INDICATOR_REGULATION_S 0x02                 // Regulation S
#define US_INDICATOR_REGULATION_S_PLUS_RULE_144A 0x03  // Regulation S Plus Rule 144a

// Settlement Type: one byte code
#define SETTLEMENT_TYPE_NOT_APPLICABLE 0x01     // Not Applicable
#define SETTLEMENT_TYPE_CASH_SETTLEMENT 0x02    // Cash Settlement
#define SETTLEMENT_TYPE_PHYSICAL_DELIVERY 0x03  // Physical Delivery

// Option Type: one byte code
#define OPTION_TYPE_NOT_APPLICABLE 0x01  // Not Applicable
#define OPTION_TYPE_CALL 0x02            // Call
#define OPTION_TYPE_PUT 0x03             // Put

// Exercise Type: one byte code
#define EXERCISE_TYPE_AMER 0x01  // Amer
#define EXERCISE_TYPE_EURO 0x02  // Euro
#define EXERCISE_TYPE_NA 0x03    // Na

// Status: one byte code
#define STATUS_ACTIVE 0x01                        // Active
#define STATUS_INACTIVE 0x02                      // Inactive
#define STATUS_MARKET_OPERATIONS_SUSPENSION 0x03  // Market Operations Suspension
#define STATUS_OUTSIDE_COLLARS_STATIC 0x04        // Outside Collars Static
#define STATUS_OUTSIDE_COLLARS_DYNAMIC 0x05       // Outside Collars Dynamic
#define STATUS_REGULATORY_SUSPENSION 0x06         // Regulatory Suspension
#define STATUS_HYBRID_NO_QUOTES 0x08              // Hybrid No Quotes
#define STATUS_HYBRID_KNOCKOUT 0x09               // Hybrid Knockout
#define STATUS_HYBRID_KNOCKOUT_BY_ISSUER 0x0A     // Hybrid Knockout By Issuer

