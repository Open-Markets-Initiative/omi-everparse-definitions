#define INDEX_PUBLICATION_SCHEDULE_CONTINUOUS 0x01  // Continuous
#define INDEX_PUBLICATION_SCHEDULE_FIXING 0x02      // Fixing
#define INDEX_PUBLICATION_SCHEDULE_CLOSING 0x03     // Closing

