// Mmt Market Mechanism: one byte code
#define MMT_MARKET_MECHANISM_CENTRAL_LIMIT_ORDER_BOOK 0x01  // Central Limit Order Book
#define MMT_MARKET_MECHANISM_QUOTE_DRIVEN_MARKET 0x02       // Quote Driven Market
