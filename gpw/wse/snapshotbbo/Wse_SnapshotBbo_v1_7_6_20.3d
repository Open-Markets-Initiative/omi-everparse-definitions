#define AUCTION_TYPE_AUCTION_EXTENDED_VOLATILITY_DYNAMIC 0x08  // Auction Extended Volatility Dynamic
#define AUCTION_TYPE_UNSUSPENSION_AUCTION 0x09                 // Unsuspension Auction

