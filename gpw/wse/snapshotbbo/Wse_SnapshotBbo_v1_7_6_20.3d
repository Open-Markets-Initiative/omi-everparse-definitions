#define MMT_MARKET_MECHANISM_PERIODIC_AUCTION 0x05          // Periodic Auction
#define MMT_MARKET_MECHANISM_REQUEST_FOR_QUOTES 0x06        // Request For Quotes
#define MMT_MARKET_MECHANISM_OTHER 0x07                     // Other

// Mmt Trading Mode: one byte code
#define MMT_TRADING_MODE_UNDEFINED_AUCTION 0x01                        // Undefined Auction
#define MMT_TRADING_MODE_SCHEDULED_OPENING_AUCTION 0x02                // Scheduled Opening Auction
#define MMT_TRADING_MODE_SCHEDULED_CLOSING_AUCTION 0x03                // Scheduled Closing Auction
#define MMT_TRADING_MODE_SCHEDULED_INTRADAY_AUCTION 0x04               // Scheduled Intraday Auction
#define MMT_TRADING_MODE_UNSCHEDULED_AUCTION 0x05                      // Unscheduled Auction
#define MMT_TRADING_MODE_CONTINUOUS_TRADING 0x06                       // Continuous Trading
#define MMT_TRADING_MODE_AT_MARKET_CLOSE_TRADING 0x07                  // At Market Close Trading
#define MMT_TRADING_MODE_OUT_OF_MAIN_SESSION_TRADING 0x08              // Out Of Main Session Trading
#define MMT_TRADING_MODE_TRADE_REPORTING_ON_EXCHANGE 0x09              // Trade Reporting On Exchange
#define MMT_TRADING_MODE_TRADE_REPORTING_OFF_EXCHANGE 0x0A             // Trade Reporting Off Exchange
#define MMT_TRADING_MODE_TRADE_REPORTING_SYSTEMATIC_INTERNALISER 0x0B  // Trade Reporting Systematic Internaliser

// Mmt Transaction Category: one byte code
#define MMT_TRANSACTION_CATEGORY_DARK_TRADE 0x01                    // Dark Trade
#define MMT_TRANSACTION_CATEGORY_TRADE_PRICE_IMPROVEMENT 0x02       // Trade Price Improvement
#define MMT_TRANSACTION_CATEGORY_PACKAGE_TRADE 0x03                 // Package Trade
#define MMT_TRANSACTION_CATEGORY_EXCHANGE_FOR_PHYSICALS_TRADE 0x04  // Exchange For Physicals Trade
#define MMT_TRANSACTION_CATEGORY_NONE 0x05                          // None

// Mmt Negotiation Indicator: one byte code
#define MMT_NEGOTIATION_INDICATOR_NEGOTIATED_TRADE 0x01                                    // Negotiated Trade
#define MMT_NEGOTIATION_INDICATOR_NEGOTIATED_TRADE_LIQUID_FINANCIAL_INSTRUMENTS 0x02       // Negotiated Trade Liquid Financial Instruments
#define MMT_NEGOTIATION_INDICATOR_NEGOTIATED_TRADE_ILLIQUID_FINANCIAL_INSTRUMENTS 0x03     // Negotiated Trade Illiquid Financial Instruments
#define MMT_NEGOTIATION_INDICATOR_NEGOTIATED_TRADE_OTHER 0x04                              // Negotiated Trade Other
#define MMT_NEGOTIATION_INDICATOR_NO_NEGOTIATED_TRADE 0x05                                 // No Negotiated Trade
#define MMT_NEGOTIATION_INDICATOR_PRE_TRADE_TRANSPARENCY_WAIVER_ILLIQUID_INSTRUMENT 0x06   // Pre Trade Transparency Waiver Illiquid Instrument
#define MMT_NEGOTIATION_INDICATOR_PRE_TRADE_TRANSPARENCY_WAIVER_STANDARD_MARKET_SIZE 0x07  // Pre Trade Transparency Waiver Standard Market Size
#define MMT_NEGOTIATION_INDICATOR_PRE_TRADE_TRANSPARENCY_WAIVERS_ILQD_AND_SIZE 0x08        // Pre Trade Transparency Waivers Ilqd And Size

// Mmt Agency Cross Trade Indicator: one byte code
#define MMT_AGENCY_CROSS_TRADE_INDICATOR_AGENCY_CROSS_TRADE 0x01     // Agency Cross Trade
#define MMT_AGENCY_CROSS_TRADE_INDICATOR_NO_AGENCY_CROSS_TRADE 0x02  // No Agency Cross Trade

// Mmt Modification Indicator: one byte code
#define MMT_MODIFICATION_INDICATOR_TRADE_CANCELLATION 0x01  // Trade Cancellation
#define MMT_MODIFICATION_INDICATOR_TRADE_AMENDMENT 0x02     // Trade Amendment
#define MMT_MODIFICATION_INDICATOR_NEW_TRADE 0x03           // New Trade

// Mmt Benchmark Reference Price Indicator: one byte code
#define MMT_BENCHMARK_REFERENCE_PRICE_INDICATOR_BENCHMARK_TRADE 0x01                       // Benchmark Trade
#define MMT_BENCHMARK_REFERENCE_PRICE_INDICATOR_REFERENCE_PRICE_TRADE 0x02                 // Reference Price Trade
#define MMT_BENCHMARK_REFERENCE_PRICE_INDICATOR_NO_BENCHMARKOR_REFERENCE_PRICE_TRADE 0x03  // No Benchmarkor Reference Price Trade

// Mmt Special Dividend Indicator: one byte code
#define MMT_SPECIAL_DIVIDEND_INDICATOR_SPECIAL_DIVIDEND_TRADE 0x01     // Special Dividend Trade
#define MMT_SPECIAL_DIVIDEND_INDICATOR_NO_SPECIAL_DIVIDEND_TRADE 0x02  // No Special Dividend Trade

// Mmt Off Book Automated Indicator: one byte code
#define MMT_OFF_BOOK_AUTOMATED_INDICATOR_UNSPECIFIED_OR_NOT_APPLY 0x01  // Unspecified Or Not Apply
#define MMT_OFF_BOOK_AUTOMATED_INDICATOR_OFF_BOOK_NON_AUTOMATED 0x02    // Off Book Non Automated
#define MMT_OFF_BOOK_AUTOMATED_INDICATOR_OFF_BOOK_AUTOMATED 0x03        // Off Book Automated

// Mmt Ordinary Trade Indicator: one byte code
#define MMT_ORDINARY_TRADE_INDICATOR_PLAIN_VANILLA_TRADE 0x01                        // Plain Vanilla Trade
#define MMT_ORDINARY_TRADE_INDICATOR_NON_PRICE_FORMING_TRADE 0x02                    // Non Price Forming Trade
#define MMT_ORDINARY_TRADE_INDICATOR_TRADE_NOT_CONTRIBUTING_TO_PRICE_DISCOVERY 0x03  // Trade Not Contributing To Price Discovery
#define MMT_ORDINARY_TRADE_INDICATOR_PRICE_PENDING 0x04                              // Price Pending

// Mmt Algorithmic Indicator: one byte code
#define MMT_ALGORITHMIC_INDICATOR_ALGORITHMIC_TRADE 0x01     // Algorithmic Trade
#define MMT_ALGORITHMIC_INDICATOR_NO_ALGORITHMIC_TRADE 0x02  // No Algorithmic Trade

// Mmt Post Trade Deferral Reason: one byte code
#define MMT_POST_TRADE_DEFERRAL_REASON_IMMEDIATE_PUBLICATION 0x01                          // Immediate Publication
#define MMT_POST_TRADE_DEFERRAL_REASON_NON_IMMEDIATE_PUBLICATION 0x02                      // Non Immediate Publication
#define MMT_POST_TRADE_DEFERRAL_REASON_NON_IMMEDIATE_PUBLICATION_LARGE_IN_SCALE 0x03       // Non Immediate Publication Large In Scale
#define MMT_POST_TRADE_DEFERRAL_REASON_NON_IMMEDIATE_PUBLICATION_ILLIQUID_INSTRUMENT 0x04  // Non Immediate Publication Illiquid Instrument
#define MMT_POST_TRADE_DEFERRAL_REASON_NON_IMMEDIATE_PUBLICATION_SIZE_SPECIFIC 0x05        // Non Immediate Publication Size Specific
#define MMT_POST_TRADE_DEFERRAL_REASON_NON_IMMEDIATE_PUBLICATION_ILQD_AND_SIZE 0x06        // Non Immediate Publication Ilqd And Size
#define MMT_POST_TRADE_DEFERRAL_REASON_NON_IMMEDIATE_PUBLICATION_ILQD_AND_LRGS 0x07        // Non Immediate Publication Ilqd And Lrgs

// Mmt Post Trade Deferral Type: one byte code
#define MMT_POST_TRADE_DEFERRAL_TYPE_LIMITED_DETAILS_TRADE 0x01             // Limited Details Trade
#define MMT_POST_TRADE_DEFERRAL_TYPE_DAILY_AGGREGATED_TRADE 0x02            // Daily Aggregated Trade
#define MMT_POST_TRADE_DEFERRAL_TYPE_VOLUME_OMISSION_TRADE 0x03             // Volume Omission Trade
#define MMT_POST_TRADE_DEFERRAL_TYPE_FOUR_WEEKS_AGGREGATION_TRADE 0x04      // Four Weeks Aggregation Trade
#define MMT_POST_TRADE_DEFERRAL_TYPE_INDEFINITE_AGGREGATION_TRADE 0x05      // Indefinite Aggregation Trade
#define MMT_POST_TRADE_DEFERRAL_TYPE_VOLUME_OMISSION_TRADE_AGGREGATED 0x06  // Volume Omission Trade Aggregated
#define MMT_POST_TRADE_DEFERRAL_TYPE_NOT_APPLICABLE 0x07                    // Not Applicable

// Pos Type: one byte code
#define POS_TYPE_SOD 0x01  // Sod
#define POS_TYPE_ITD 0x02  // Itd
#define POS_TYPE_FIN 0x03  // Fin

// Collar Type: one byte code
#define COLLAR_TYPE_STATIC 0x01   // Static
#define COLLAR_TYPE_DYNAMIC 0x02  // Dynamic

// Closing Price Type: one byte code
#define CLOSING_PRICE_TYPE_INITIAL_PRICE 0x01           // Initial Price
#define CLOSING_PRICE_TYPE_LTP 0x02                     // Ltp
#define CLOSING_PRICE_TYPE_LAST_ACP 0x03                // Last Acp
#define CLOSING_PRICE_TYPE_FAIR_VALUE 0x04              // Fair Value
#define CLOSING_PRICE_TYPE_DAILY_SETTLEMENT_PRICE 0x05  // Daily Settlement Price
#define CLOSING_PRICE_TYPE_FINAL_SETTLEMENT_PRICE 0x06  // Final Settlement Price

// Adjusted Closing Price Reason: one byte code
#define ADJUSTED_CLOSING_PRICE_REASON_NOT_APPLICABLE 0x01    // Not Applicable
#define ADJUSTED_CLOSING_PRICE_REASON_DIVIDEND 0x02          // Dividend
#define ADJUSTED_CLOSING_PRICE_REASON_ISSUE_RIGHT 0x03       // Issue Right
#define ADJUSTED_CLOSING_PRICE_REASON_SPLIT 0x04             // Split
#define ADJUSTED_CLOSING_PRICE_REASON_REVERSE_SPLIT 0x05     // Reverse Split
#define ADJUSTED_CLOSING_PRICE_REASON_BONUS 0x06             // Bonus
#define ADJUSTED_CLOSING_PRICE_REASON_SPIN_OFF 0x07          // Spin Off
#define ADJUSTED_CLOSING_PRICE_REASON_TICK_SIZE_CHANGE 0x08  // Tick Size Change
#define ADJUSTED_CLOSING_PRICE_REASON_ORDER_PURGE 0x09       // Order Purge
#define ADJUSTED_CLOSING_PRICE_REASON_OTHER_REASON 0x0A      // Other Reason

// Marker Price Change: one byte code
#define MARKER_PRICE_CHANGE_INCREASE 0x01        // Increase
#define MARKER_PRICE_CHANGE_DECREASE 0x02        // Decrease
#define MARKER_PRICE_CHANGE_NO_CHANGE 0x03       // No Change
#define MARKER_PRICE_CHANGE_NOT_APPLICABLE 0x04  // Not Applicable

// Quotation System: one byte code
#define QUOTATION_SYSTEM_NA 0x01                          // Na
#define QUOTATION_SYSTEM_SINGLE_PRICE_SINGLE_FIXING 0x02  // Single Price Single Fixing
#define QUOTATION_SYSTEM_CONTINUOUS_TRADING 0x03          // Continuous Trading
#define QUOTATION_SYSTEM_SINGLE_PRICE_TWO_FIXINGS 0x04    // Single Price Two Fixings

// Price Update Type: one byte code
#define PRICE_UPDATE_TYPE_REFERENCE_PRICE 0x01               // Reference Price
#define PRICE_UPDATE_TYPE_REFERENCE_INDEX_PRICE 0x02         // Reference Index Price
#define PRICE_UPDATE_TYPE_REFERENCE_FIXING_INDEX_PRICE 0x03  // Reference Fixing Index Price
#define PRICE_UPDATE_TYPE_MID_PRICE 0x04                     // Mid Price
#define PRICE_UPDATE_TYPE_FIXING_PRICE 0x05                  // Fixing Price
#define PRICE_UPDATE_TYPE_FIXING_YTM 0x06                    // Fixing Ytm

// Index Level Code: one byte code
#define INDEX_LEVEL_CODE_PREVIOUS_CLOSING_VALUE 0x01            // Previous Closing Value
#define INDEX_LEVEL_CODE_THEORETICAL_VALUE_BEFORE_OPENING 0x02  // Theoretical Value Before Opening
#define INDEX_LEVEL_CODE_VALUE_BEFORE_OPENING 0x03              // Value Before Opening
#define INDEX_LEVEL_CODE_OPENING_VALUE 0x04                     // Opening Value
#define INDEX_LEVEL_CODE_CURRENT_VALUE 0x05                     // Current Value
#define INDEX_LEVEL_CODE_PRE_CLOSING_VALUE 0x06                 // Pre Closing Value
#define INDEX_LEVEL_CODE_CLOSING_VALUE 0x07                     // Closing Value
#define INDEX_LEVEL_CODE_VALUE_WITHOUT_OPENING 0x08             // Value Without Opening

// Trading Session Event: one byte code
#define TRADING_SESSION_EVENT_NA 0x01                                 // Na
#define TRADING_SESSION_EVENT_START_OF_TECHNICAL_SESSION 0x02         // Start Of Technical Session
#define TRADING_SESSION_EVENT_END_OF_TECHNICAL_SESSION 0x03           // End Of Technical Session
#define TRADING_SESSION_EVENT_INITIAL_REFERENCE_DATA_START 0x04       // Initial Reference Data Start
#define TRADING_SESSION_EVENT_INITIAL_REFERENCE_DATA_END 0x05         // Initial Reference Data End
#define TRADING_SESSION_EVENT_PREVIOUS_DAY_RESTATE_START 0x06         // Previous Day Restate Start
#define TRADING_SESSION_EVENT_PREVIOUS_DAY_RESTATE_END 0x07           // Previous Day Restate End
#define TRADING_SESSION_EVENT_NEXT_SESSION_REFERENCE_DATA_START 0x08  // Next Session Reference Data Start
#define TRADING_SESSION_EVENT_NEXT_SESSION_REFERENCE_DATA_END 0x09    // Next Session Reference Data End
#define TRADING_SESSION_EVENT_START_OF_TRADING_SESSION_MIC 0x0C       // Start Of Trading Session Mic
#define TRADING_SESSION_EVENT_END_OF_TRADING_SESSION_MIC 0x0D         // End Of Trading Session Mic

// Event Type: one byte code
#define EVENT_TYPE_FLUSH 0x01           // Flush
#define EVENT_TYPE_SCENARIO_START 0x02  // Scenario Start
#define EVENT_TYPE_SCENARIO_END 0x03    // Scenario End

// Result: one byte code
#define RESULT_OK 0x01                 // Ok
#define RESULT_INVALID_TOKEN 0x02      // Invalid Token
#define RESULT_ALREADY_LOGGED_IN 0x03  // Already Logged In
#define RESULT_LOGIN_NOT_ALLOWED 0x04  // Login Not Allowed
#define RESULT_OTHER 0x05              // Other

// ---- Types -------------------------------------------------------------------

// Trading week plan
typedef struct _WeekPlan {
  UINT32 calendar_id;  // bytes 0 to 3
  UINT8 weekdays[7];   // bytes 4 to 10
} WeekPlan;

// Upcoming calendar day exception
typedef struct _CalendarException {
  UINT32 calendar_id;              // bytes 0 to 3
  UINT32 calendar_exception_date;  // bytes 4 to 7
  UINT8 calendar_exception_type;   // byte 8
} CalendarException;

// Tick size definition
typedef struct _TickTableEntry {
  UINT64 tick_size;      // bytes 0 to 7, signed, read here as unsigned
  UINT64 lower_bound;    // bytes 8 to 15, signed, read here as unsigned
  UINT32 tick_table_id;  // bytes 16 to 19
} TickTableEntry;

// Collar table definition
typedef struct _CollarTableEntry {
  UINT32 collar_table_id;     // bytes 0 to 3
  UINT8 collar_mode;          // byte 4
  UINT8 collar_expression;    // byte 5
  UINT64 collar_lower_bound;  // bytes 6 to 13, signed, read here as unsigned
  UINT64 collar_value;        // bytes 14 to 21, signed, read here as unsigned
  UINT64 collar_lower_bid;    // bytes 22 to 29, signed, read here as unsigned
  UINT64 collar_upper_bid;    // bytes 30 to 37, signed, read here as unsigned
  UINT64 collar_upper_ask;    // bytes 38 to 45, signed, read here as unsigned
  UINT64 collar_lower_ask;    // bytes 46 to 53, signed, read here as unsigned
} CollarTableEntry;

// Trading phase definition
typedef struct _TradingPhaseScheduleEntry {
  UINT32 trading_schedule_id;                       // bytes 0 to 3
  UINT32 trading_phase_id;                          // bytes 4 to 7
  UINT8 trading_phase_settlement_cycle;             // byte 8
  UINT8 trading_phase_max_block_settlement_cycle;   // byte 9
  UINT32 static_collar_volatility_auction_id;       // bytes 10 to 13
  UINT32 dynamic_collar_volatility_auction_id;      // bytes 14 to 17
  UINT64 trading_phase_start_time;                  // bytes 18 to 25
  UINT8 trading_phase_type;                         // byte 26
  UINT8 uncrossing;                                 // byte 27
  UINT32 ext_static_collar_volatility_auction_id;   // bytes 28 to 31
  UINT32 ext_dynamic_collar_volatility_auction_id;  // bytes 32 to 35
  UINT32 clat_id;                                   // bytes 36 to 39
} TradingPhaseScheduleEntry;

// Messages defining the Trading Venue s market structure
typedef struct _MarketStructure {
  UINT32 id;                // bytes 0 to 3
  UINT32 parent_id;         // bytes 4 to 7
  UINT8 mic[4];             // bytes 8 to 11
  UINT8 name[50];           // bytes 12 to 61
  UINT8 market_model_type;  // byte 62
} MarketStructure;

// Message defining a collar group
typedef struct _CollarGroup {
  UINT32 id;                             // bytes 0 to 3
  UINT32 order_static_collar_table_id;   // bytes 4 to 7
  UINT32 order_dynamic_collar_table_id;  // bytes 8 to 11
  UINT32 trade_static_collar_table_id;   // bytes 12 to 15
  UINT32 trade_dynamic_collar_table_id;  // bytes 16 to 19
} CollarGroup;

// The message contains a list of underlyings not traded in WATS. It concerns underlyings for derivatives and structured products
typedef struct _ExternalUnderlying {
  UINT32 external_underlying_id;      // bytes 0 to 3
  UINT8 product_identification[30];   // bytes 4 to 33
  UINT8 product_identification_type;  // byte 34
  UINT8 product_code[20];             // bytes 35 to 54
  UINT8 product_name[50];             // bytes 55 to 104
  UINT8 mic[4];                       // bytes 105 to 108
  UINT16 nominal_currency;            // bytes 109 to 110
  UINT16 trading_currency;            // bytes 111 to 112
} ExternalUnderlying;

// Definition of a financial instrument
typedef struct _Instrument {
  UINT32 instrument_id;                 // bytes 0 to 3
  UINT8 product_type;                   // byte 4
  UINT8 product_subtype;                // byte 5
  UINT32 first_trading_date;            // bytes 6 to 9
  UINT32 last_trading_date;             // bytes 10 to 13
  UINT32 product_id;                    // bytes 14 to 17
  UINT16 currency;                      // bytes 18 to 19
  UINT64 iceberg_min_value;             // bytes 20 to 27, signed, read here as unsigned
  UINT32 lot_size;                      // bytes 28 to 31
  UINT8 price_expression_type;          // byte 32
  UINT32 calendar_id;                   // bytes 33 to 36
  UINT32 market_structure_id;           // bytes 37 to 40
  UINT32 tick_table_id;                 // bytes 41 to 44
  UINT32 reference_instrument_id;       // bytes 45 to 48
  UINT32 collar_group_id;               // bytes 49 to 52
  UINT32 trading_schedule_id;           // bytes 53 to 56
  UINT8 description[64];                // bytes 57 to 120
  UINT8 mic[4];                         // bytes 121 to 124
  UINT64 nominal_value;                 // bytes 125 to 132, signed, read here as unsigned
  UINT8 nominal_value_type;             // byte 133
  UINT64 multiplier;                    // bytes 134 to 141, signed, read here as unsigned
  UINT64 strike_price;                  // bytes 142 to 149, signed, read here as unsigned
  UINT16 strike_price_currency;         // bytes 150 to 151
  UINT8 product_identification[30];     // bytes 152 to 181
  UINT8 product_identification_type;    // byte 182
  UINT32 settlement_calendar_id;        // bytes 183 to 186
  UINT8 bond_coupon_type;               // byte 187
  UINT64 pre_trade_check_min_price;     // bytes 188 to 195, signed, read here as unsigned
  UINT64 pre_trade_check_max_price;     // bytes 196 to 203, signed, read here as unsigned
  UINT64 pre_trade_check_min_quantity;  // bytes 204 to 211
  UINT64 pre_trade_check_max_quantity;  // bytes 212 to 219
  UINT64 pre_trade_check_max_value;     // bytes 220 to 227, signed, read here as unsigned
  UINT64 pre_trade_check_min_value;     // bytes 228 to 235, signed, read here as unsigned
  UINT8 liquidity;                      // byte 236
  UINT8 market_model_type;              // byte 237
  UINT8 issuer[150];                    // bytes 238 to 387
  UINT16 issuer_reg_country;            // bytes 388 to 389
  UINT32 underlying_instrument_id;      // bytes 390 to 393
  UINT8 product_code[20];               // bytes 394 to 413
  UINT8 cfi[6];                         // bytes 414 to 419
  UINT8 fisn[35];                       // bytes 420 to 454
  UINT64 issue_size;                    // bytes 455 to 462
  UINT16 nominal_currency;              // bytes 463 to 464
  UINT8 us_indicator;                   // byte 465
  UINT32 expiry_date;                   // bytes 466 to 469
  UINT8 version_number;                 // byte 470
  UINT8 settlement_type;                // byte 471
  UINT8 option_type;                    // byte 472
  UINT8 exercise_type;                  // byte 473
  UINT8 product_name[50];               // bytes 474 to 523
  UINT64 reference_price;               // bytes 524 to 531, signed, read here as unsigned
  UINT8 status;                         // byte 532
  UINT32 initial_phase_id;              // bytes 533 to 536
  UINT64 threshold_max;                 // bytes 537 to 544, signed, read here as unsigned
  UINT64 threshold_min;                 // bytes 545 to 552, signed, read here as unsigned
  UINT8 is_leverage;                    // byte 553
  UINT64 accrued_interest_value;        // bytes 554 to 561, signed, read here as unsigned
  UINT8 kid[128];                       // bytes 562 to 689
  UINT32 kid_issue_date;                // bytes 690 to 693
  UINT8 value_at_risk;                  // byte 694
  UINT32 external_underlying_id;        // bytes 695 to 698
} Instrument;

// Message describing an accrued interest table entry
typedef struct _AccruedInterestTableEntry {
  UINT32 product_id;                          // bytes 0 to 3
  UINT32 accrued_interest_table_entry_date;   // bytes 4 to 7
  UINT64 accrued_interest_table_entry_value;  // bytes 8 to 15, signed, read here as unsigned
} AccruedInterestTableEntry;

// Message describing an indexation table entry
typedef struct _IndexationTableEntry {
  UINT32 product_id;                    // bytes 0 to 3
  UINT32 indexation_table_entry_date;   // bytes 4 to 7
  UINT64 indexation_table_entry_value;  // bytes 8 to 15, signed, read here as unsigned
} IndexationTableEntry;

// PublicProductIdentification
typedef struct _ProductIdentificationPublicProductIdentification {
  UINT8 product_identification[30];   // bytes 0 to 29
  UINT8 product_identification_type;  // byte 30
} ProductIdentificationPublicProductIdentification;

// IndexUnderlying
typedef struct _IndexUnderlying {
  ProductIdentificationPublicProductIdentification product_identification_public_product_identification;  // bytes 0 to 30
  UINT8 index_underlying_type;                                                                            // byte 31
} IndexUnderlying;

// IndexUnderlying Array
typedef struct _Items {
  IndexUnderlying index_underlying;  // bytes 0 to 31
} Items;

// IndexUnderlyings
typedef struct _IndexUnderlyings {
  UINT8 count;                 // byte 0
  Items items[:byte-size 96];  // bytes 1 to 96
} IndexUnderlyings;

// The metadata message for the given index
typedef struct _IndexParams {
  UINT32 instrument_id;                               // bytes 0 to 3
  UINT64 index_base_value;                            // bytes 4 to 11, signed, read here as unsigned
  UINT64 index_base_capitalisation;                   // bytes 12 to 19, signed, read here as unsigned
  UINT32 index_base_date;                             // bytes 20 to 23
  UINT64 correction_coefficient;                      // bytes 24 to 31, signed, read here as unsigned
  UINT16 num_of_components;                           // bytes 32 to 33
  UINT8 index_publication_schedule;                   // byte 34
  UINT8 index_type;                                   // byte 35
  UINT8 has_days_since_last_publication : 1;          // byte 36
  UINT8 has_number_of_dividends : 1;                  // byte 36
  UINT8 reserved_27_index_params_presence_flags : 6;  // byte 36
  UINT8 days_since_last_publication;                  // byte 37
  UINT16 number_of_dividends;                         // bytes 38 to 39
  IndexUnderlyings index_underlyings;                 // bytes 40 to 136
  UINT16 publication_order;                           // bytes 137 to 138
  UINT16 currency;                                    // bytes 139 to 140
  UINT32 date_validity;                               // bytes 141 to 144
} IndexParams;

// The message contains information about a product providing the index portfolio
typedef struct _IndexPortfolioEntry {
  UINT32 id;                                                                       // bytes 0 to 3
  UINT32 index_id;                                                                 // bytes 4 to 7
  UINT8 has_instrument_id : 1;                                                     // byte 8
  UINT8 reserved_17_index_portfolio_entry_presence_flags : 7;                      // byte 8
  UINT32 instrument_id;                                                            // bytes 9 to 12
  ProductIdentificationPublicProductIdentification public_product_identification;  // bytes 13 to 43
  UINT8 mic[4];                                                                    // bytes 44 to 47
  UINT16 currency;                                                                 // bytes 48 to 49
  UINT64 instrument_packet;                                                        // bytes 50 to 57
  UINT8 suspended;                                                                 // byte 58
} IndexPortfolioEntry;

// Auction summary, including auction price and quantity
typedef struct _AuctionSummary {
  UINT32 instrument_id;  // bytes 0 to 3
  UINT64 price;          // bytes 4 to 11, signed, read here as unsigned
  UINT64 quantity;       // bytes 12 to 19
  UINT8 auction_type;    // byte 20
} AuctionSummary;

// Updates IMP/IMV and BBO during an auction
typedef struct _AuctionUpdate {
  UINT32 instrument_id;               // bytes 0 to 3
  UINT64 indicative_matching_price;   // bytes 4 to 11, signed, read here as unsigned
  UINT64 indicative_matching_volume;  // bytes 12 to 19
  UINT64 total_sell_quantity_at_imp;  // bytes 20 to 27
  UINT64 total_buy_quantity_at_imp;   // bytes 28 to 35
  UINT64 best_sell_level;             // bytes 36 to 43, signed, read here as unsigned
  UINT64 best_sell_level_quantity;    // bytes 44 to 51
  UINT64 best_buy_level;              // bytes 52 to 59, signed, read here as unsigned
  UINT64 best_buy_level_quantity;     // bytes 60 to 67
} AuctionUpdate;

// PriceLevel
typedef struct _PriceLevel {
  UINT8 is_encrypted;        // byte 0
  UINT64 encryption_offset;  // bytes 1 to 8
  UINT32 encryption_key_id;  // bytes 9 to 12
  UINT64 price;              // bytes 13 to 20, signed, read here as unsigned
  UINT64 quantity;           // bytes 21 to 28
  UINT16 order_count;        // bytes 29 to 30
} PriceLevel;

// PriceLevel table
typedef struct _Buy {
  PriceLevel price_level;  // bytes 0 to 30
} Buy;

// BBO price levels and volumes
typedef struct _PriceLevelSnapshot {
  UINT32 instrument_id;       // bytes 0 to 3
  UINT8 max_depth;            // byte 4
  UINT8 mm_buy_quote_level;   // byte 5
  UINT8 mm_sell_quote_level;  // byte 6
  Buy buy[:byte-size 155];    // bytes 7 to 161
  Buy sell[:byte-size 155];   // bytes 162 to 316
} PriceLevelSnapshot;

// BBO Level 1
typedef struct _TopPriceLevelUpdate {
  UINT32 instrument_id;  // bytes 0 to 3
  UINT64 price;          // bytes 4 to 11, signed, read here as unsigned
  UINT64 quantity;       // bytes 12 to 19
  UINT8 side;            // byte 20
  UINT16 order_count;    // bytes 21 to 22
} TopPriceLevelUpdate;

// Enriched trade report
typedef struct _Trade {
  UINT32 instrument_id;                                                            // bytes 0 to 3
  UINT64 trade_settlement_value;                                                   // bytes 4 to 11, signed, read here as unsigned
  UINT32 settlement_date;                                                          // bytes 12 to 15
  UINT64 trading_timestamp;                                                        // bytes 16 to 23
  ProductIdentificationPublicProductIdentification public_product_identification;  // bytes 24 to 54
  UINT64 price;                                                                    // bytes 55 to 62, signed, read here as unsigned
  UINT16 price_currency;                                                           // bytes 63 to 64
  UINT8 price_notation;                                                            // byte 65
  UINT64 quantity;                                                                 // bytes 66 to 73
  UINT64 trade_nominal_value;                                                      // bytes 74 to 81, signed, read here as unsigned
  UINT16 nominal_currency;                                                         // bytes 82 to 83
  UINT8 mic[4];                                                                    // bytes 84 to 87
  UINT64 publication_timestamp;                                                    // bytes 88 to 95
  UINT32 trade_id;                                                                 // bytes 96 to 99
  UINT8 trade_to_be_cleared;                                                       // byte 100
  UINT64 pct_change;                                                               // bytes 101 to 108, signed, read here as unsigned
  UINT64 vwap;                                                                     // bytes 109 to 116, signed, read here as unsigned
  UINT64 no_trades;                                                                // bytes 117 to 124
  UINT64 total_volume;                                                             // bytes 125 to 132
  UINT64 total_value;                                                              // bytes 133 to 140, signed, read here as unsigned
  UINT64 opening_price;                                                            // bytes 141 to 148, signed, read here as unsigned
  UINT64 max_price;                                                                // bytes 149 to 156, signed, read here as unsigned
  UINT64 min_price;                                                                // bytes 157 to 164, signed, read here as unsigned
  UINT8 mmt_market_mechanism;                                                      // byte 165
  UINT8 mmt_trading_mode;                                                          // byte 166
  UINT8 mmt_transaction_category;                                                  // byte 167
  UINT8 mmt_negotiation_indicator;                                                 // byte 168
  UINT8 mmt_agency_cross_trade_indicator;                                          // byte 169
  UINT8 mmt_modification_indicator;                                                // byte 170
  UINT8 mmt_benchmark_reference_price_indicator;                                   // byte 171
  UINT8 mmt_special_dividend_indicator;                                            // byte 172
  UINT8 mmt_off_book_automated_indicator;                                          // byte 173
  UINT8 mmt_ordinary_trade_indicator;                                              // byte 174
  UINT8 mmt_algorithmic_indicator;                                                 // byte 175
  UINT8 mmt_post_trade_deferral_reason;                                            // byte 176
  UINT8 mmt_post_trade_deferral_type;                                              // byte 177
} Trade;

// Report of open positions
typedef struct _PositionReport {
  ProductIdentificationPublicProductIdentification public_product_identification;  // bytes 0 to 30
  UINT8 pos_type;                                                                  // byte 31
  UINT32 open_positions;                                                           // bytes 32 to 35
  UINT32 trade_id;                                                                 // bytes 36 to 39
} PositionReport;

// Start of a new trading phase
typedef struct _InstrumentStatusChange {
  UINT32 instrument_id;      // bytes 0 to 3
  UINT32 trading_phase_id;   // bytes 4 to 7
  UINT8 trading_phase_type;  // byte 8
  UINT8 status;              // byte 9
  UINT8 stressed_market;     // byte 10
} InstrumentStatusChange;

// New order price collars
typedef struct _OrderCollars {
  UINT32 instrument_id;  // bytes 0 to 3
  UINT8 collar_type;     // byte 4
  UINT64 price;          // bytes 5 to 12, signed, read here as unsigned
  UINT64 lower_bid;      // bytes 13 to 20, signed, read here as unsigned
  UINT64 upper_bid;      // bytes 21 to 28, signed, read here as unsigned
  UINT64 lower_ask;      // bytes 29 to 36, signed, read here as unsigned
  UINT64 upper_ask;      // bytes 37 to 44, signed, read here as unsigned
} OrderCollars;

// New trade price collars
typedef struct _TradeCollars {
  UINT32 instrument_id;  // bytes 0 to 3
  UINT8 collar_type;     // byte 4
  UINT64 price;          // bytes 5 to 12, signed, read here as unsigned
  UINT64 lower;          // bytes 13 to 20, signed, read here as unsigned
  UINT64 upper;          // bytes 21 to 28, signed, read here as unsigned
} TradeCollars;

// Provides brief instrument summary
typedef struct _InstrumentSummary {
  UINT32 instrument_id;                 // bytes 0 to 3
  UINT64 last_traded_price;             // bytes 4 to 11, signed, read here as unsigned
  UINT64 closing_price;                 // bytes 12 to 19, signed, read here as unsigned
  UINT8 closing_price_type;             // byte 20
  UINT64 adjusted_closing_price;        // bytes 21 to 28, signed, read here as unsigned
  UINT8 adjusted_closing_price_reason;  // byte 29
  UINT64 pct_change;                    // bytes 30 to 37, signed, read here as unsigned
  UINT64 vwap;                          // bytes 38 to 45, signed, read here as unsigned
  UINT64 no_trades;                     // bytes 46 to 53
  UINT64 total_volume;                  // bytes 54 to 61
  UINT64 total_value;                   // bytes 62 to 69, signed, read here as unsigned
  UINT64 opening_price;                 // bytes 70 to 77, signed, read here as unsigned
  UINT64 max_price;                     // bytes 78 to 85, signed, read here as unsigned
  UINT64 min_price;                     // bytes 86 to 93, signed, read here as unsigned
  UINT8 is_correction;                  // byte 94
} InstrumentSummary;

// SingleInstrumentSummary
typedef struct _ClobInstrument {
  UINT32 instrument_id;                 // bytes 0 to 3
  UINT8 market_model_type;              // byte 4
  UINT64 last_traded_price;             // bytes 5 to 12, signed, read here as unsigned
  UINT64 closing_price;                 // bytes 13 to 20, signed, read here as unsigned
  UINT8 closing_price_type;             // byte 21
  UINT64 adjusted_closing_price;        // bytes 22 to 29, signed, read here as unsigned
  UINT8 adjusted_closing_price_reason;  // byte 30
  UINT64 pct_change;                    // bytes 31 to 38, signed, read here as unsigned
  UINT64 vwap;                          // bytes 39 to 46, signed, read here as unsigned
  UINT64 no_trades;                     // bytes 47 to 54
  UINT64 total_volume;                  // bytes 55 to 62
  UINT64 total_value;                   // bytes 63 to 70, signed, read here as unsigned
  UINT64 opening_price;                 // bytes 71 to 78, signed, read here as unsigned
  UINT64 max_price;                     // bytes 79 to 86, signed, read here as unsigned
  UINT64 min_price;                     // bytes 87 to 94, signed, read here as unsigned
  UINT64 settlement_price;              // bytes 95 to 102, signed, read here as unsigned
  UINT64 settlement_value;              // bytes 103 to 110, signed, read here as unsigned
  UINT32 end_trading_date;              // bytes 111 to 114
  UINT32 last_trade_date;               // bytes 115 to 118
} ClobInstrument;

// Session day product summary
typedef struct _ProductSummary {
  ClobInstrument clob_instrument;     // bytes 0 to 118
  ClobInstrument cross_instrument;    // bytes 119 to 237
  ClobInstrument block_instrument;    // bytes 238 to 356
  ClobInstrument hybrid_instrument;   // bytes 357 to 475
  UINT8 product_identification_type;  // byte 476
  UINT8 product_identification[30];   // bytes 477 to 506
  UINT32 product_id;                  // bytes 507 to 510
  UINT8 mic[4];                       // bytes 511 to 514
  UINT64 accumulated_interest;        // bytes 515 to 522, signed, read here as unsigned
  UINT64 interest_rate;               // bytes 523 to 530, signed, read here as unsigned
  UINT16 currency;                    // bytes 531 to 532
  UINT32 session_date;                // bytes 533 to 536
  UINT64 trading_value_currency;      // bytes 537 to 544, signed, read here as unsigned
  UINT8 status;                       // byte 545
  UINT16 sector;                      // bytes 546 to 547
  UINT8 market;                       // byte 548
  UINT8 marker_price_change;          // byte 549
  UINT8 lower_liquidity;              // byte 550
  UINT64 product_summary_multiplier;  // bytes 551 to 558, signed, read here as unsigned
  UINT64 dividend_rate;               // bytes 559 to 566, signed, read here as unsigned
  UINT64 delta;                       // bytes 567 to 574, signed, read here as unsigned
  UINT64 gamma;                       // bytes 575 to 582, signed, read here as unsigned
  UINT64 rho;                         // bytes 583 to 590, signed, read here as unsigned
  UINT64 theta;                       // bytes 591 to 598, signed, read here as unsigned
  UINT64 vega;                        // bytes 599 to 606, signed, read here as unsigned
  UINT64 volatility;                  // bytes 607 to 614, signed, read here as unsigned
  UINT64 options_strike_price;        // bytes 615 to 622, signed, read here as unsigned
  UINT8 dividend;                     // byte 623
  UINT8 subscription_right;           // byte 624
  UINT8 interim_dividend_right;       // byte 625
  UINT8 split;                        // byte 626
  UINT8 quotation_system;             // byte 627
  UINT8 liquidity_support_pge;        // byte 628
} ProductSummary;

// Message indicating a price or YTM update
typedef struct _PriceUpdate {
  UINT32 instrument_id;                     // bytes 0 to 3
  UINT8 price_update_type;                  // byte 4
  UINT16 value_price_ytm_presence : 1;      // bytes 5 to 6
  UINT16 value_bid_price_ytm_presence : 1;  // bytes 5 to 6
  UINT16 value_ask_price_ytm_presence : 1;  // bytes 5 to 6
  UINT16 ytm_no_calc : 1;                   // bytes 5 to 6
  UINT16 ytm_bid_no_calc : 1;               // bytes 5 to 6
  UINT16 ytm_ask_no_calc : 1;               // bytes 5 to 6
  UINT16 reserved_615 : 10;                 // bytes 5 to 6
  UINT64 value;                             // bytes 7 to 14, signed, read here as unsigned
  UINT64 value_bid;                         // bytes 15 to 22, signed, read here as unsigned
  UINT64 value_ask;                         // bytes 23 to 30, signed, read here as unsigned
} PriceUpdate;

// News message
typedef struct _News {
  UINT32 market_structure_id;  // bytes 0 to 3
  UINT32 news_id;              // bytes 4 to 7
  UINT8 title[80];             // bytes 8 to 87
  UINT8 entry_number;          // byte 88
  UINT8 total_;                // byte 89
  UINT8 text[800];             // bytes 90 to 889
} News;

// Message providing real-time index values for instruments
typedef struct _RealTimeIndex {
  UINT32 instrument_id;                      // bytes 0 to 3
  UINT8 index_level_code;                    // byte 4
  UINT16 num_of_active_instruments;          // bytes 5 to 6
  UINT64 ind_index_opening_portfolio;        // bytes 7 to 14, signed, read here as unsigned
  UINT64 index_value;                        // bytes 15 to 22, signed, read here as unsigned
  UINT64 pct_change_index_val_prev_session;  // bytes 23 to 30, signed, read here as unsigned
  UINT64 session_low;                        // bytes 31 to 38, signed, read here as unsigned
  UINT64 session_high;                       // bytes 39 to 46, signed, read here as unsigned
  UINT8 has_trading_value : 1;               // byte 47
  UINT8 has_index_value_bid : 1;             // byte 47
  UINT8 has_index_value_ask : 1;             // byte 47
  UINT8 has_mid_spread_index : 1;            // byte 47
  UINT8 has_difference_central_spread : 1;   // byte 47
  UINT8 reserved_57 : 3;                     // byte 47
  UINT64 trading_value;                      // bytes 48 to 55, signed, read here as unsigned
  UINT64 index_value_bid;                    // bytes 56 to 63, signed, read here as unsigned
  UINT64 index_value_ask;                    // bytes 64 to 71, signed, read here as unsigned
  UINT64 mid_spread_index;                   // bytes 72 to 79, signed, read here as unsigned
  UINT64 difference_central_spread;          // bytes 80 to 87, signed, read here as unsigned
} RealTimeIndex;

// The index summary message provides a summary of the data calculated in a stock index for a given day
typedef struct _IndexSummary {
  UINT32 instrument_id;                                // bytes 0 to 3
  UINT64 opening_index_value;                          // bytes 4 to 11, signed, read here as unsigned
  UINT64 session_low;                                  // bytes 12 to 19, signed, read here as unsigned
  UINT64 session_high;                                 // bytes 20 to 27, signed, read here as unsigned
  UINT64 closing_index_value;                          // bytes 28 to 35, signed, read here as unsigned
  UINT8 has_session_avg : 1;                           // byte 36
  UINT8 reserved_17_index_summary_presence_flags : 7;  // byte 36
  UINT64 session_avg;                                  // bytes 37 to 44, signed, read here as unsigned
  UINT64 pct_change_index_val_prev_session;            // bytes 45 to 52, signed, read here as unsigned
  UINT64 pct_change_index_val_prev_year;               // bytes 53 to 60, signed, read here as unsigned
  UINT64 closing_capitalisation_portfolio;             // bytes 61 to 68, signed, read here as unsigned
  UINT64 ind_index_opening_portfolio;                  // bytes 69 to 76, signed, read here as unsigned
} IndexSummary;

// The Trading Session Status provides information on the status of a market and on a trading day events
typedef struct _TradingSessionStatus {
  UINT8 market_id[4];           // bytes 0 to 3
  UINT32 market_structure_id;   // bytes 4 to 7
  UINT8 trading_session_event;  // byte 8
  UINT32 date;                  // bytes 9 to 12
} TradingSessionStatus;

// Test event
typedef struct _TestEvent {
  UINT8 scenario_name[200];  // bytes 0 to 199
  UINT8 event_type;          // byte 200
} TestEvent;

// Encryption key and ID
typedef struct _EncryptionKey {
  UINT32 id;             // bytes 0 to 3
  UINT8 secret_key[32];  // bytes 4 to 35
} EncryptionKey;

// Login message to the Snapshot service
typedef struct _Login {
  UINT16 connection_id;                  // bytes 0 to 1
  UINT8 token[8];                        // bytes 2 to 9
  UINT8 trades : 1;                      // byte 10
  UINT8 ref_data : 1;                    // byte 10
  UINT8 reserved_27_message_filter : 6;  // byte 10
} Login;

// Response to a Login message
typedef struct _LoginResponse {
  UINT8 result;  // byte 0
} LoginResponse;

// Marks the end of a snapshot
typedef struct _EndOfSnapshot {
  UINT32 last_seq_num;  // bytes 0 to 3
} EndOfSnapshot;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0021: WeekPlan week_plan;
    case 0x0023: CalendarException calendar_exception;
    case 0x0020: TickTableEntry tick_table_entry;
    case 0x006C: CollarTableEntry collar_table_entry;
    case 0x001B: TradingPhaseScheduleEntry trading_phase_schedule_entry;
    case 0x0113: MarketStructure market_structure;
    case 0x012B: CollarGroup collar_group;
    case 0x0326: ExternalUnderlying external_underlying;
    case 0x0117: Instrument instrument;
    case 0x0024: AccruedInterestTableEntry accrued_interest_table_entry;
    case 0x0025: IndexationTableEntry indexation_table_entry;
    case 0x01F7: IndexParams index_params;
    case 0x01F6: IndexPortfolioEntry index_portfolio_entry;
    case 0x010E: AuctionSummary auction_summary;
    case 0x010C: AuctionUpdate auction_update;
    case 0x0101: PriceLevelSnapshot price_level_snapshot;
    case 0x0100: TopPriceLevelUpdate top_price_level_update;
    case 0x0026: Trade trade;
    case 0x0321: PositionReport position_report;
    case 0x001A: InstrumentStatusChange instrument_status_change;
    case 0x0110: OrderCollars order_collars;
    case 0x0111: TradeCollars trade_collars;
    case 0x029F: InstrumentSummary instrument_summary;
    case 0x02A0: ProductSummary product_summary;
    case 0x010F: PriceUpdate price_update;
    case 0x0205: News news;
    case 0x01F4: RealTimeIndex real_time_index;
    case 0x01F5: IndexSummary index_summary;
    case 0x0017: TradingSessionStatus trading_session_status;
    case 0x0001: unit heartbeat;
    case 0x2000: TestEvent test_event;
    case 0x0018: EncryptionKey encryption_key;
    case 0x029B: Login login;
    case 0x029C: LoginResponse login_response;
    case 0x029D: unit logout;
    case 0x029E: EndOfSnapshot end_of_snapshot;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message {
  UINT16 message_length { message_length >= 42 };                                                                                     // bytes 0 to 1
  UINT16 message_type;                                                                                                                // bytes 2 to 3
  UINT16 message_version;                                                                                                             // bytes 4 to 5
  UINT32 sequence_number;                                                                                                             // bytes 6 to 9
  UINT64 timestamp;                                                                                                                   // bytes 10 to 17
  UINT64 source_timestamp;                                                                                                            // bytes 18 to 25
  UINT8 is_encrypted;                                                                                                                 // byte 26
  UINT64 encryption_offset;                                                                                                           // bytes 27 to 34
  UINT32 encryption_key_id;                                                                                                           // bytes 35 to 38
  UINT16 session_id;                                                                                                                  // bytes 39 to 40
  UINT8 stream_id;                                                                                                                    // byte 41
  Payload(message_type, (((UINT32) message_length) - 42)) payload[:byte-size-single-element-array (((UINT32) message_length) - 42)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Gpw Wats Snapshot and Replay Packet
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

