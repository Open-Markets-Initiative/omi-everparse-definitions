// Gie da Papier w Warto ciowych w Warszawie BondSpot Order Book
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out BondSpot_OrderBook_v6_8.3d
//
// What this definition does not state, and the model does:
// - a field filling what is left of what holds it
// - a run filling what frames it
//
// License: MIT No Attribution

// ---- Packet Header: 16 bytes -------------------------------------------------

// All messages are preceded by a common packet header format, which section 1.1 states for every Market Information message
entrypoint typedef struct _PacketHeader {
  UINT16BE packet_length;           // bytes 0 to 1
  UINT16BE packet_type;             // bytes 2 to 3
  UINT32BE packet_sequence_number;  // bytes 4 to 7
  UINT32BE send_time;               // bytes 8 to 11
  UINT16BE service_id;              // bytes 12 to 13
  UINT8 delivery_flag;              // byte 14
  UINT8 number_msg_entries;         // byte 15
} PacketHeader;

// ---- Message Header: 4 bytes -------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT16BE message_size;  // bytes 0 to 1
  UINT16BE message_type;  // bytes 2 to 3
} MessageHeader;

// ---- Order Update Market Sheet Message: 60 bytes -----------------------------

// The Order update message generated by the trading engine UTP indicates the creation or modification of a line in the market sheet (a.k.a
entrypoint typedef struct _OrderUpdateMarketSheetMessage {
  UINT32BE symbol_index;               // bytes 0 to 3
  UINT32BE source_time;                // bytes 4 to 7
  UINT32BE source_seq_num;             // bytes 8 to 11
  UINT32BE price;                      // bytes 12 to 15
  UINT32BE aggregated_volume;          // bytes 16 to 19
  UINT32BE volume;                     // bytes 20 to 23
  UINT32BE link_id;                    // bytes 24 to 27
  UINT32BE order_id;                   // bytes 28 to 31
  UINT32BE system_id;                  // bytes 32 to 35
  UINT16BE source_time_micro_secs;     // bytes 36 to 37
  UINT16BE number_orders;              // bytes 38 to 39
  UINT8 side;                          // byte 40
  UINT8 order_type;                    // byte 41
  UINT8 action_type;                   // byte 42
  UINT8 price_scale_code;              // byte 43
  UINT32BE order_date;                 // bytes 44 to 47
  UINT32BE order_priority_date;        // bytes 48 to 51
  UINT32BE order_priority_time;        // bytes 52 to 55
  UINT16BE order_priority_micro_secs;  // bytes 56 to 57
  UINT8 order_origin;                  // byte 58
  UINT8 reserved_1;                    // byte 59
} OrderUpdateMarketSheetMessage;

