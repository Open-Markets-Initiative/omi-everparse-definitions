  UINT8 eighth_reserved_1;                      // byte 243
  UINT8 segment[2];                             // bytes 244 to 245
  UINT8 lower_liquidity;                        // byte 246
  UINT8 dividend[2];                            // bytes 247 to 248
  UINT8 subscription_right[2];                  // bytes 249 to 250
  UINT8 split[2];                               // bytes 251 to 252
  UINT8 interim_dividend_right[2];              // bytes 253 to 254
  UINT8 quotation_system[2];                    // bytes 255 to 256
  UINT8 liquidity_support_pge[2];               // bytes 257 to 258
  UINT8 ninth_reserved_1;                       // byte 259
} SessionSummaryMessage;

