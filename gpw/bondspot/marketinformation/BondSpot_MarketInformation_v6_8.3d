// Gie da Papier w Warto ciowych w Warszawie BondSpot Market Information
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out BondSpot_MarketInformation_v6_8.3d
//
// What this definition does not state, and the model does:
// - a field filling what is left of what holds it
// - a run filling what frames it
// - a run of a stated number of entries
//
// License: MIT No Attribution

// ---- Packet Header: 16 bytes -------------------------------------------------

// All messages are preceded by a common packet header format, which section 1.1 states for every Market Information message
entrypoint typedef struct _PacketHeader {
  UINT16BE packet_length;           // bytes 0 to 1
  UINT16BE packet_type;             // bytes 2 to 3
  UINT32BE packet_sequence_number;  // bytes 4 to 7
  UINT32BE send_time;               // bytes 8 to 11
  UINT16BE service_id;              // bytes 12 to 13
  UINT8 delivery_flag;              // byte 14
  UINT8 number_msg_entries;         // byte 15
} PacketHeader;

// ---- Message Header: 4 bytes -------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT16BE message_size;  // bytes 0 to 1
  UINT16BE message_type;  // bytes 2 to 3
} MessageHeader;

// ---- Class State Change Message: 24 bytes ------------------------------------

// The Class State Change message indicates a change in the state of a class
entrypoint typedef struct _ClassStateChangeMessage {
  UINT32BE source_seq_num;          // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE system_id;               // bytes 8 to 11
  UINT16BE source_time_micro_secs;  // bytes 12 to 13
  UINT8 instrument_group_code[3];   // bytes 14 to 16
  UINT8 instrument_group_state;     // byte 17
  UINT8 session_type;               // byte 18
  UINT8 reserved_1;                 // byte 19
  UINT8 class_state[4];             // bytes 20 to 23
} ClassStateChangeMessage;

// ---- Mail Message: 1098 bytes ------------------------------------------------

// This message supplies a part or a complete electronic message (E-mail), in order to inform members and rebroadcasting members about quotation conditions on a given listed instrument or a set of listed instruments or otherwise about a technical problem
entrypoint typedef struct _MailMessage {
  UINT32BE source_seq_num;          // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE system_id;               // bytes 8 to 11
  UINT16BE source_time_micro_secs;  // bytes 12 to 13
  UINT8 scope;                      // byte 14
  UINT8 title[80];                  // bytes 15 to 94
  UINT8 text[1000];                 // bytes 95 to 1094
  UINT8 reserved_3[3];              // bytes 1095 to 1097
} MailMessage;

// ---- Collars Message: 32 bytes -----------------------------------------------

// A Collars message informs Clients of modifications in authorized price fluctuations for an instrument
entrypoint typedef struct _CollarsMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE high_collar;             // bytes 12 to 15
  UINT32BE low_collar;              // bytes 16 to 19
  UINT32BE system_id;               // bytes 20 to 23
  UINT16BE source_time_micro_secs;  // bytes 24 to 25
  UINT8 high_scale_code;            // byte 26
  UINT8 low_scale_code;             // byte 27
  UINT8 collar_type;                // byte 28
  UINT8 reserved_3[3];              // bytes 29 to 31
} CollarsMessage;

// ---- Start Referential Message: 4 bytes --------------------------------------

// The Start referential message is sent to signal the start of transmission of the Instrument Reference Data Flow
entrypoint typedef struct _StartReferentialMessage {
  UINT8 indicator;      // byte 0
  UINT8 reserved_3[3];  // bytes 1 to 3
} StartReferentialMessage;

// ---- End Referential Message: 4 bytes ----------------------------------------

// The End referential message is sent to signal the end of transmission of the Instrument Reference Data Flow
entrypoint typedef struct _EndReferentialMessage {
  UINT8 indicator;      // byte 0
  UINT8 reserved_3[3];  // bytes 1 to 3
} EndReferentialMessage;

// ---- Session Summary Message: 260 bytes --------------------------------------

// This message contains statistical data
entrypoint typedef struct _SessionSummaryMessage {
  UINT32BE symbol_index;                        // bytes 0 to 3
  UINT32BE source_time;                         // bytes 4 to 7
  UINT32BE source_seq_num;                      // bytes 8 to 11
  UINT32BE date;                                // bytes 12 to 15
  UINT32BE multiplier;                          // bytes 16 to 19
  UINT32BE accumulated_interest;                // bytes 20 to 23
  UINT32BE opening_price;                       // bytes 24 to 27
  UINT32BE maximum_price;                       // bytes 28 to 31
  UINT32BE minimum_price;                       // bytes 32 to 35
  UINT32BE closing_price;                       // bytes 36 to 39
  UINT32BE implied_volatility;                  // bytes 40 to 43
  UINT32BE average_weighted_price;              // bytes 44 to 47
  UINT32BE reference_price;                     // bytes 48 to 51
  UINT32BE pct_change_price;                    // bytes 52 to 55
  UINT32BE dividend_rate;                       // bytes 56 to 59
  UINT32BE settlement_price;                    // bytes 60 to 63
  UINT32BE settlement_value;                    // bytes 64 to 67
  UINT8 reserved_4[4];                          // bytes 68 to 71
  UINT32BE open_positions;                      // bytes 72 to 75
  UINT32BE trading_volume;                      // bytes 76 to 79
  UINT32BE transactions_number;                 // bytes 80 to 83
  UINT64BE trading_value;                       // bytes 84 to 91
  UINT32BE currency_price;                      // bytes 92 to 95
  UINT32BE delta;                               // bytes 96 to 99
  UINT32BE gamma;                               // bytes 100 to 103
  UINT32BE rho;                                 // bytes 104 to 107
  UINT32BE theta;                               // bytes 108 to 111
  UINT32BE vega;                                // bytes 112 to 115
  UINT32BE end_trading;                         // bytes 116 to 119
  UINT32BE number_of_instruments;               // bytes 120 to 123
  UINT64BE trading_value_currency;              // bytes 124 to 131
  UINT32BE interest_rate;                       // bytes 132 to 135
  UINT32BE volatility;                          // bytes 136 to 139
  UINT32BE strike_price;                        // bytes 140 to 143
  UINT32BE short_selling_trades_number;         // bytes 144 to 147
  UINT32BE volume_short_selling_trades;         // bytes 148 to 151
  UINT32BE value_short_selling_trades;          // bytes 152 to 155
  UINT32BE last_trade_date;                     // bytes 156 to 159
  UINT32BE last_trade_price;                    // bytes 160 to 163
  UINT32BE block_trades_number;                 // bytes 164 to 167
  UINT32BE volume_block_trades;                 // bytes 168 to 171
  UINT32BE value_block_trades;                  // bytes 172 to 175
  UINT32BE vwap_blocktrade;                     // bytes 176 to 179
  UINT32BE maximum_block_price;                 // bytes 180 to 183
  UINT32BE minimum_block_price;                 // bytes 184 to 187
  UINT32BE system_id;                           // bytes 188 to 191
  UINT16BE source_time_micro_secs;              // bytes 192 to 193
  UINT8 multiplier_scale_code;                  // byte 194
  UINT8 accumulated_interest_scale_code;        // byte 195
  UINT8 opening_price_scale_code;               // byte 196
  UINT8 maximum_price_scale_code;               // byte 197
  UINT8 minimum_price_scale_code;               // byte 198
  UINT8 closing_price_scale_code;               // byte 199
  UINT8 implied_volatility_scale_code;          // byte 200
  UINT8 average_weighted_price_scale_code;      // byte 201
  UINT8 reference_price_scale_code;             // byte 202
  UINT8 pct_change_price_scale_code;            // byte 203
  UINT8 dividend_rate_scale_code;               // byte 204
  UINT8 settlement_price_scale_code;            // byte 205
  UINT8 settlement_value_scale_code;            // byte 206
  UINT8 reserved_1;                             // byte 207
  UINT8 trading_value_scale_code;               // byte 208
  UINT8 currency_price_scale_code;              // byte 209
  UINT8 delta_scale_code;                       // byte 210
  UINT8 gamma_scale_code;                       // byte 211
  UINT8 rho_scale_code;                         // byte 212
  UINT8 theta_scale_code;                       // byte 213
  UINT8 vega_scale_code;                        // byte 214
  UINT8 trading_value_currency_scale_code;      // byte 215
  UINT8 interest_rate_scale_code;               // byte 216
  UINT8 volatility_scale_code;                  // byte 217
  UINT8 strike_price_scale_code;                // byte 218
  UINT8 value_short_selling_trades_scale_code;  // byte 219
  UINT8 last_trade_price_scale_code;            // byte 220
  UINT8 value_block_trades_scale_code;          // byte 221
  UINT8 vwap_blocktrade_scale_code;             // byte 222
  UINT8 maximum_block_price_scale_code;         // byte 223
  UINT8 minimum_block_price_scale_code;         // byte 224
  UINT8 status_indicator;                       // byte 225
  UINT8 sector[3];                              // bytes 226 to 228
  UINT8 market;                                 // byte 229
  UINT8 second_reserved_1;                      // byte 230
  UINT8 short_sale;                             // byte 231
  UINT8 marker_pct_change_price;                // byte 232
  UINT8 symbol_delta;                           // byte 233
  UINT8 symbol_gamma;                           // byte 234
  UINT8 symbol_rho;                             // byte 235
  UINT8 symbol_theta;                           // byte 236
  UINT8 symbol_vega;                            // byte 237
  UINT8 third_reserved_1;                       // byte 238
