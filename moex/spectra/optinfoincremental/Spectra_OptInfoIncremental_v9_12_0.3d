// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, UdpPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Spectra_OptInfoIncremental_v9_12_0.3d

// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_HEARTBEAT_MESSAGE 0x0001                          // Heartbeat Message
#define TEMPLATE_ID_SEQUENCE_RESET_MESSAGE 0x0002                     // Sequence Reset Message
#define TEMPLATE_ID_BEST_PRICES_MESSAGE 0x000E                        // Best Prices Message
#define TEMPLATE_ID_EMPTY_BOOK_MESSAGE 0x0004                         // Empty Book Message
#define TEMPLATE_ID_ORDER_UPDATE_MESSAGE 0x000F                       // Order Update Message
#define TEMPLATE_ID_ORDER_EXECUTION_MESSAGE 0x0010                    // Order Execution Message
#define TEMPLATE_ID_ORDER_BOOK_SNAPSHOT_MESSAGE 0x0011                // Order Book Snapshot Message
#define TEMPLATE_ID_SECURITY_DEFINITION_MESSAGE 0x001D                // Security Definition Message
#define TEMPLATE_ID_SECURITY_STATUS_MESSAGE 0x001C                    // Security Status Message
#define TEMPLATE_ID_SECURITY_DEFINITION_UPDATE_REPORT_MESSAGE 0x000A  // Security Definition Update Report Message
#define TEMPLATE_ID_TRADING_SESSION_STATUS_MESSAGE 0x001A             // Trading Session Status Message
#define TEMPLATE_ID_DISCRETE_AUCTION_MESSAGE 0x0018                   // Discrete Auction Message
#define TEMPLATE_ID_SECURITY_MASS_STATUS_MESSAGE 0x0013               // Security Mass Status Message
#define TEMPLATE_ID_SECURITY_GROUP_STATUS_MESSAGE 0x0016              // Security Group Status Message
#define TEMPLATE_ID_LOGON_MESSAGE 0x03E8                              // Logon Message
#define TEMPLATE_ID_LOGOUT_MESSAGE 0x03E9                             // Logout Message
#define TEMPLATE_ID_MARKET_DATA_REQUEST_MESSAGE 0x03EA                // Market Data Request Message
#define TEMPLATE_ID_MARKET_DATA_DUMMY_MESSAGE 0x03EB                  // Market Data Dummy Message

// Security Trading Status: one byte code
#define SECURITY_TRADING_STATUS_TRADING_HALT 0x02                     // Trading Halt
#define SECURITY_TRADING_STATUS_READY_TO_TRADE 0x11                   // Ready To Trade
#define SECURITY_TRADING_STATUS_NOT_AVAILABLE_FOR_TRADING 0x12        // Not Available For Trading
#define SECURITY_TRADING_STATUS_NOT_TRADED_ON_THIS_MARKET 0x13        // Not Traded On This Market
#define SECURITY_TRADING_STATUS_UNKNOWN_OR_INVALID 0x14               // Unknown Or Invalid
#define SECURITY_TRADING_STATUS_PRE_OPEN 0x15                         // Pre Open
#define SECURITY_TRADING_STATUS_DISCRETE_AUCTION_OPEN 0x77            // Discrete Auction Open
#define SECURITY_TRADING_STATUS_DISCRETE_AUCTION_CLOSE 0x79           // Discrete Auction Close
#define SECURITY_TRADING_STATUS_INSTRUMENT_HALT 0x7A                  // Instrument Halt
#define SECURITY_TRADING_STATUS_CLOSE_POSITION 0x7B                   // Close Position
#define SECURITY_TRADING_STATUS_DISCRETE_AUCTION_CLOSE_POSITION 0x7C  // Discrete Auction Close Position

// Trading Session Id: one byte code
#define TRADING_SESSION_ID_DAY 0x01      // Day
#define TRADING_SESSION_ID_MORNING 0x03  // Morning
#define TRADING_SESSION_ID_EVENING 0x05  // Evening
#define TRADING_SESSION_ID_WEEKEND 0x64  // Weekend

// Trad Ses Status: one byte code
#define TRAD_SES_STATUS_HALTED 0x01    // Halted
#define TRAD_SES_STATUS_OPEN 0x02      // Open
#define TRAD_SES_STATUS_CLOSED 0x03    // Closed
#define TRAD_SES_STATUS_PRE_OPEN 0x04  // Pre Open

// Market Segment Id: one byte code
#define MARKET_SEGMENT_ID_DERIVATIVES 0x44  // Derivatives

// Trad Ses Event: one byte code
#define TRAD_SES_EVENT_TRADING_RESUMES 0x00            // Trading Resumes
#define TRAD_SES_EVENT_CHANGE_OF_TRADING_SESSION 0x01  // Change Of Trading Session
#define TRAD_SES_EVENT_CHANGE_OF_TRADING_STATUS 0x03   // Change Of Trading Status

// Halt Type: one byte code
#define HALT_TYPE_EMPTY_HALTS 0x00                                        // Empty Halts
#define HALT_TYPE_SESSION 0x01                                            // Session
#define HALT_TYPE_SECTION 0x02                                            // Section
#define HALT_TYPE_SECTION_AND_TRADE_MODE 0x03                             // Section And Trade Mode
#define HALT_TYPE_FUT_BASE_CONTRACT 0x04                                  // Fut Base Contract
#define HALT_TYPE_INSTRUMENTS_FROM_TRADE_MODE 0x05                        // Instruments From Trade Mode
#define HALT_TYPE_INSTRUMENTS_FROM_TRADE_MODE_AND_FUT_BASE_CONTRACT 0x06  // Instruments From Trade Mode And Fut Base Contract
#define HALT_TYPE_GROUP_INSTRUMENTS 0x07                                  // Group Instruments
#define HALT_TYPE_GROUP_INSTRUMENTS_AND_FUT_BASE_CONTRACT 0x08            // Group Instruments And Fut Base Contract

// Section Id Optional: 4 byte code
#define SECTION_ID_OPTIONAL_ALL_SECTIONS 0x00000000       // All Sections
#define SECTION_ID_OPTIONAL_STOCK_SECTION 0x00000001      // Stock Section
#define SECTION_ID_OPTIONAL_COMMODITY_SECTION 0x00000002  // Commodity Section
#define SECTION_ID_OPTIONAL_MONEY_SECTION 0x00000003      // Money Section

// ---- Types -------------------------------------------------------------------

// MarketDataDummyMessage
typedef struct _MarketDataPacketHeader {
  UINT32 msg_seq_num;             // bytes 0 to 3
  UINT16 msg_size;                // bytes 4 to 5
  UINT16 last_fragment : 1;       // bytes 6 to 7
  UINT16 start_of_snapshot : 1;   // bytes 6 to 7
  UINT16 end_of_snapshot : 1;     // bytes 6 to 7
  UINT16 incremental_packet : 1;  // bytes 6 to 7
  UINT16 poss_dup_flag : 1;       // bytes 6 to 7
  UINT16 reserved_bits : 11;      // bytes 6 to 7
  UINT64 sending_time;            // bytes 8 to 15
} MarketDataPacketHeader;

// MarketDataDummyMessage
typedef struct _IncrementalPacketHeader {
  UINT64 transact_time;                         // bytes 0 to 7
  UINT32 exchange_trading_session_id_optional;  // bytes 8 to 11
} IncrementalPacketHeader;

// SequenceResetMessage
typedef struct _SequenceResetMessage {
  UINT32 new_seq_no;  // bytes 0 to 3
} SequenceResetMessage;

// SecurityStatusMessage
typedef struct _SecurityStatusMessage {
  UINT32 security_id;              // bytes 0 to 3, signed, read here as unsigned
  UINT8 symbol[25];                // bytes 4 to 28
  UINT8 security_trading_status;   // byte 29
  UINT64 high_limit_px;            // bytes 30 to 37, signed, read here as unsigned
  UINT64 low_limit_px;             // bytes 38 to 45, signed, read here as unsigned
  UINT64 initial_margin_on_buy;    // bytes 46 to 53, signed, read here as unsigned
  UINT64 initial_margin_on_sell;   // bytes 54 to 61, signed, read here as unsigned
  UINT64 initial_margin_syntetic;  // bytes 62 to 69, signed, read here as unsigned
  UINT64 high_limit_px_weekend;    // bytes 70 to 77, signed, read here as unsigned
  UINT64 low_limit_px_weekend;     // bytes 78 to 85, signed, read here as unsigned
} SecurityStatusMessage;

// SecurityDefinitionUpdateReportMessage
typedef struct _SecurityDefinitionUpdateReportMessage {
  UINT32 security_id;        // bytes 0 to 3, signed, read here as unsigned
  UINT64 volatility;         // bytes 4 to 11, signed, read here as unsigned
  UINT64 theor_price;        // bytes 12 to 19, signed, read here as unsigned
  UINT64 theor_price_limit;  // bytes 20 to 27, signed, read here as unsigned
} SecurityDefinitionUpdateReportMessage;

// TradingSessionStatusMessage
typedef struct _TradingSessionStatusMessage {
  UINT64 trad_ses_open_time;                                // bytes 0 to 7
  UINT64 trad_ses_close_time;                               // bytes 8 to 15
  UINT8 trading_session_id;                                 // byte 16
  UINT32 exchange_trading_session_id_int_32_null_optional;  // bytes 17 to 20, signed, read here as unsigned
  UINT8 trad_ses_status;                                    // byte 21
  UINT8 market_segment_id;                                  // byte 22
  UINT8 trad_ses_event;                                     // byte 23
  UINT64 trade_period_id;                                   // bytes 24 to 31, signed, read here as unsigned
  UINT64 settl_sess_begin;                                  // bytes 32 to 39
  UINT64 clr_sess_begin;                                    // bytes 40 to 47
} TradingSessionStatusMessage;

// NoRelatedSym
typedef struct _SecurityMassStatusMessageNoRelatedSymGroup {
  UINT32 security_id;             // bytes 0 to 3, signed, read here as unsigned
  UINT8 security_trading_status;  // byte 4
} SecurityMassStatusMessageNoRelatedSymGroup;

// NoRelatedSym Block
typedef struct _SecurityMassStatusMessageNoRelatedSymGroups {
  UINT16 block_length;                                                                                                                             // bytes 0 to 1
  UINT16 num_in_group_uint_16;                                                                                                                     // bytes 2 to 3
  SecurityMassStatusMessageNoRelatedSymGroup security_mass_status_message_no_related_sym_group[:byte-size (((UINT32) num_in_group_uint_16) * 5)];
} SecurityMassStatusMessageNoRelatedSymGroups;

// SecurityMassStatusMessage
typedef struct _SecurityMassStatusMessage {
  SecurityMassStatusMessageNoRelatedSymGroups security_mass_status_message_no_related_sym_groups;
} SecurityMassStatusMessage;

// SecurityGroupStatusMessage
typedef struct _SecurityGroupStatusMessage {
  UINT64 security_group_id;          // bytes 0 to 7, signed, read here as unsigned
  UINT8 halt_type;                   // byte 8
  UINT32 trade_mode_mask;            // bytes 9 to 12, signed, read here as unsigned
  UINT64 group_mask_optional;        // bytes 13 to 20, signed, read here as unsigned
  UINT32 section_id_optional;        // bytes 21 to 24, signed, read here as unsigned
  UINT32 base_contract_id_optional;  // bytes 25 to 28, signed, read here as unsigned
  UINT8 security_trading_status;     // byte 29
  UINT64 status_change_time;         // bytes 30 to 37
} SecurityGroupStatusMessage;

// Branch
casetype _Payload (UINT16 selector) {
  switch (selector) {
    case 0x0001: unit heartbeat_message;
    case 0x0002: SequenceResetMessage sequence_reset_message;
    case 0x001C: SecurityStatusMessage security_status_message;
    case 0x000A: SecurityDefinitionUpdateReportMessage security_definition_update_report_message;
    case 0x001A: TradingSessionStatusMessage trading_session_status_message;
    case 0x0013: SecurityMassStatusMessage security_mass_status_message;
    case 0x0016: SecurityGroupStatusMessage security_group_status_message;
  }
} Payload;

// Moex Simba Market Data Message
typedef struct _Message {
  UINT16 block_length;           // bytes 0 to 1
  UINT16 template_id;            // bytes 2 to 3
  UINT16 schema_id;              // bytes 4 to 5
  UINT16 version;                // bytes 6 to 7
  Payload(template_id) payload;
} Message;

// ---- Packet: UdpPacket -------------------------------------------------------

// Moex Simba Incremental Packet
entrypoint typedef struct _UdpPacket (UINT32 available) where (available >= 28) {
  MarketDataPacketHeader market_data_packet_header;   // bytes 0 to 15
  IncrementalPacketHeader incremental_packet_header;  // bytes 16 to 27
  Message message[:byte-size (available - 28)];
} UdpPacket;

