// Establishment Reject Code: one byte code
#define ESTABLISHMENT_REJECT_CODE_UNNEGOTIATED 0x00         // Unnegotiated
#define ESTABLISHMENT_REJECT_CODE_ALREADY_ESTABLISHED 0x01  // Already Established
#define ESTABLISHMENT_REJECT_CODE_SESSION_BLOCKED 0x02      // Session Blocked
#define ESTABLISHMENT_REJECT_CODE_KEEPALIVE_INTERVAL 0x03   // Keepalive Interval
#define ESTABLISHMENT_REJECT_CODE_CREDENTIALS 0x04          // Credentials
#define ESTABLISHMENT_REJECT_CODE_UNSPECIFIED 0x05          // Unspecified
#define ESTABLISHMENT_REJECT_CODE_TOO_FAST_RECONNECT 0x06   // Too Fast Reconnect

// Termination Code: one byte code
#define TERMINATION_CODE_FINISHED 0x00                  // Finished
#define TERMINATION_CODE_UNSPECIFIED_ERROR 0x01         // Unspecified Error
#define TERMINATION_CODE_RE_REQUEST_OUT_OF_BOUNDS 0x02  // Re Request Out Of Bounds
#define TERMINATION_CODE_RE_REQUEST_IN_PROGRESS 0x03    // Re Request In Progress
#define TERMINATION_CODE_TOO_FAST_CLIENT 0x04           // Too Fast Client
#define TERMINATION_CODE_TOO_SLOW_CLIENT 0x05           // Too Slow Client
#define TERMINATION_CODE_MISSED_HEARTBEAT 0x06          // Missed Heartbeat
#define TERMINATION_CODE_INVALID_MESSAGE 0x07           // Invalid Message
#define TERMINATION_CODE_TCP_FAILURE 0x08               // Tcp Failure
#define TERMINATION_CODE_INVALID_SEQUENCE_NUMBER 0x09   // Invalid Sequence Number
#define TERMINATION_CODE_SERVER_SHUTDOWN 0x0A           // Server Shutdown
#define TERMINATION_CODE_SEQUENCE_RESET 0x0B            // Sequence Reset

// Session Reject Reason: one byte code
#define SESSION_REJECT_REASON_VALUE_IS_INCORRECT 0x05       // Value Is Incorrect
#define SESSION_REJECT_REASON_OTHER 0x63                    // Other
#define SESSION_REJECT_REASON_SYSTEM_IS_UNAVAILABLE 0x64    // System Is Unavailable
#define SESSION_REJECT_REASON_CL_ORD_ID_IS_NOT_UNIQUE 0x65  // Cl Ord Id Is Not Unique

// Side: one byte code
#define SIDE_BUY 0x01         // Buy
#define SIDE_SELL 0x02        // Sell
#define SIDE_ALL_ORDERS 0x59  // All Orders

// Compliance Id: one byte code
#define COMPLIANCE_ID_NOT_AVAILABLE 0x20  // Not Available
#define COMPLIANCE_ID_MANUAL 0x4D         // Manual
#define COMPLIANCE_ID_STOP_LOSS 0x53      // Stop Loss
#define COMPLIANCE_ID_ALGORITHM 0x52      // Algorithm
#define COMPLIANCE_ID_AUTOFOLLOW 0x41     // Autofollow
#define COMPLIANCE_ID_MARGIN_CALL 0x44    // Margin Call

// Trad Ses Event: one byte code
#define TRAD_SES_EVENT_SESSION_DATA_READY 0x65              // Session Data Ready
#define TRAD_SES_EVENT_CLEARING_STARTED 0x69                // Clearing Started
#define TRAD_SES_EVENT_EXTENSION_OF_LIMITS_FINISHED 0x6A    // Extension Of Limits Finished
#define TRAD_SES_EVENT_BROKER_RECALC_FINISHED 0x6C          // Broker Recalc Finished
#define TRAD_SES_EVENT_AUCTION_FINISHED 0x7A                // Auction Finished
#define TRAD_SES_EVENT_AUCTION_COLLECT_ORDER_STARTED 0x7B   // Auction Collect Order Started
#define TRAD_SES_EVENT_AUCTION_COLLECT_ORDER_FINISHED 0x7C  // Auction Collect Order Finished

