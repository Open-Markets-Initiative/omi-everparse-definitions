} ExecutionSingleReportMessage;

// ExecutionMultilegReportMessage
typedef struct _ExecutionMultilegReportMessage {
  UINT64 cl_ord_id;                    // bytes 0 to 7
  UINT64 timestamp;                    // bytes 8 to 15
  UINT64 order_id;                     // bytes 16 to 23, signed, read here as unsigned
  UINT64 trd_match_id;                 // bytes 24 to 31, signed, read here as unsigned
  UINT64 day : 1;                      // bytes 32 to 39
  UINT64 ioc : 1;                      // bytes 32 to 39
  UINT64 otc : 1;                      // bytes 32 to 39
  UINT64 pos_transfer : 1;             // bytes 32 to 39
  UINT64 collateral : 1;               // bytes 32 to 39
  UINT64 unused_bits_6_to_9 : 4;       // bytes 32 to 39
  UINT64 dont_check_limits : 1;        // bytes 32 to 39
  UINT64 unused_bits_11_to_13 : 3;     // bytes 32 to 39
  UINT64 due_to_cross_cancel : 1;      // bytes 32 to 39
  UINT64 unused_bits_15_to_19 : 5;     // bytes 32 to 39
  UINT64 fok : 1;                      // bytes 32 to 39
  UINT64 replace : 1;                  // bytes 32 to 39
  UINT64 cancel : 1;                   // bytes 32 to 39
  UINT64 mass_cancel : 1;              // bytes 32 to 39
  UINT64 unused_bits_24_to_25 : 2;     // bytes 32 to 39
  UINT64 clearing : 1;                 // bytes 32 to 39
  UINT64 negotiated : 1;               // bytes 32 to 39
  UINT64 multileg : 1;                 // bytes 32 to 39
  UINT64 unused_bit_29 : 1;            // bytes 32 to 39
  UINT64 cross_trade : 1;              // bytes 32 to 39
  UINT64 unused_bit_31 : 1;            // bytes 32 to 39
  UINT64 negotiated_match_by_ref : 1;  // bytes 32 to 39
  UINT64 cod : 1;                      // bytes 32 to 39
  UINT64 unused_bits_34_to_37 : 4;     // bytes 32 to 39
  UINT64 uks : 1;                      // bytes 32 to 39
  UINT64 ncc_request : 1;              // bytes 32 to 39
  UINT64 ncc : 1;                      // bytes 32 to 39
  UINT64 liq_netting_rf : 1;           // bytes 32 to 39
  UINT64 active_side : 1;              // bytes 32 to 39
  UINT64 passive_side : 1;             // bytes 32 to 39
  UINT64 unused_bits_44_to_45 : 2;     // bytes 32 to 39
  UINT64 synthetic : 1;                // bytes 32 to 39
  UINT64 unused_bit_47 : 1;            // bytes 32 to 39
  UINT64 iceberg : 1;                  // bytes 32 to 39
  UINT64 unused_bits_49_to_53 : 5;     // bytes 32 to 39
  UINT64 disclosed_iceberg : 1;        // bytes 32 to 39
  UINT64 unused_bits_55_to_60 : 6;     // bytes 32 to 39
  UINT64 boc : 1;                      // bytes 32 to 39
  UINT64 unused_bit_62 : 1;            // bytes 32 to 39
  UINT64 during_discrete_auction : 1;  // bytes 32 to 39
  UINT64 reserved_64 : 1;              // bytes 32 to 39
  UINT64 zero : 1;                     // bytes 40 to 47
  UINT64 reserved_2_to_64 : 63;        // bytes 40 to 47
  UINT64 last_px;                      // bytes 48 to 55, signed, read here as unsigned
  UINT64 leg_price;                    // bytes 56 to 63, signed, read here as unsigned
  UINT32 last_qty;                     // bytes 64 to 67
  UINT32 order_qty;                    // bytes 68 to 71
  UINT32 trading_session_id;           // bytes 72 to 75, signed, read here as unsigned
  UINT32 cl_ord_link_id;               // bytes 76 to 79, signed, read here as unsigned
  UINT32 security_id;                  // bytes 80 to 83, signed, read here as unsigned
  UINT8 side;                          // byte 84
} ExecutionMultilegReportMessage;

// EmptyBookMessage
typedef struct _EmptyBookMessage {
  UINT64 timestamp;           // bytes 0 to 7
  UINT32 trading_session_id;  // bytes 8 to 11, signed, read here as unsigned
} EmptyBookMessage;

// SystemEventMessage
typedef struct _SystemEventMessage {
  UINT64 timestamp;           // bytes 0 to 7
  UINT64 event_id;            // bytes 8 to 15, signed, read here as unsigned
  UINT32 trading_session_id;  // bytes 16 to 19, signed, read here as unsigned
  UINT8 trad_ses_event;       // byte 20
} SystemEventMessage;

// Twime message body sent by the gateway
casetype _ServerPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x1389: EstablishmentAckMessage establishment_ack_message;
    case 0x138A: EstablishmentRejectMessage establishment_reject_message;
    case 0x138B: TerminateMessage terminate_message;
    case 0x138D: RetransmissionMessage retransmission_message;
    case 0x138E: SequenceMessage sequence_message;
    case 0x138F: FloodRejectMessage flood_reject_message;
    case 0x1390: SessionRejectMessage session_reject_message;
    case 0x1391: BusinessMessageRejectMessage business_message_reject_message;
    case 0x1B67: NewOrderSingleResponseMessage new_order_single_response_message;
    case 0x1B68: NewOrderIcebergResponseMessage new_order_iceberg_response_message;
    case 0x1B69: OrderCancelResponseMessage order_cancel_response_message;
    case 0x1B6A: OrderReplaceResponseMessage order_replace_response_message;
    case 0x1B5F: OrderMassCancelResponseMessage order_mass_cancel_response_message;
    case 0x1B6B: ExecutionSingleReportMessage execution_single_report_message;
    case 0x1B6C: ExecutionMultilegReportMessage execution_multileg_report_message;
    case 0x1B62: EmptyBookMessage empty_book_message;
    case 0x1B66: SystemEventMessage system_event_message;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// One Sbe message sent by the gateway: the unit the Tcp stream repeats
typedef struct _ServerMessage {
  UINT16 block_length;                                                                                                                                  // bytes 0 to 1
  UINT16 template_id;                                                                                                                                   // bytes 2 to 3
  UINT16 schema_id;                                                                                                                                     // bytes 4 to 5
  UINT16 version;                                                                                                                                       // bytes 6 to 7
  ServerPayload(template_id, ((((UINT32) block_length) + 8) - 8)) server_payload[:byte-size-single-element-array ((((UINT32) block_length) + 8) - 8)];
} ServerMessage;

// ---- Packet: ServerPacket ----------------------------------------------------

// Moex Twime Messages Sent By The Gateway
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerMessage server_message[:byte-size available];
} ServerPacket;

