// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_ESTABLISH_MESSAGE 0x1388                              // Establish Message
#define TEMPLATE_ID_ESTABLISHMENT_ACK_MESSAGE 0x1389                      // Establishment Ack Message
#define TEMPLATE_ID_ESTABLISHMENT_REJECT_MESSAGE 0x138A                   // Establishment Reject Message
#define TEMPLATE_ID_TERMINATE_MESSAGE 0x138B                              // Terminate Message
#define TEMPLATE_ID_RETRANSMIT_REQUEST_MESSAGE 0x138C                     // Retransmit Request Message
#define TEMPLATE_ID_RETRANSMISSION_MESSAGE 0x138D                         // Retransmission Message
#define TEMPLATE_ID_SEQUENCE_MESSAGE 0x138E                               // Sequence Message
#define TEMPLATE_ID_FLOOD_REJECT_MESSAGE 0x138F                           // Flood Reject Message
#define TEMPLATE_ID_SESSION_REJECT_MESSAGE 0x1390                         // Session Reject Message
#define TEMPLATE_ID_BUSINESS_MESSAGE_REJECT_MESSAGE 0x1391                // Business Message Reject Message
#define TEMPLATE_ID_NEW_ORDER_SINGLE_MESSAGE 0x1770                       // New Order Single Message
#define TEMPLATE_ID_NEW_ORDER_ICEBERG_MESSAGE 0x1778                      // New Order Iceberg Message
#define TEMPLATE_ID_NEW_ORDER_ICEBERG_X_MESSAGE 0x177B                    // New Order Iceberg X Message
#define TEMPLATE_ID_ORDER_CANCEL_REQUEST_MESSAGE 0x1776                   // Order Cancel Request Message
#define TEMPLATE_ID_ORDER_ICEBERG_CANCEL_REQUEST_MESSAGE 0x1779           // Order Iceberg Cancel Request Message
#define TEMPLATE_ID_ORDER_REPLACE_REQUEST_MESSAGE 0x1777                  // Order Replace Request Message
#define TEMPLATE_ID_ORDER_ICEBERG_REPLACE_REQUEST_MESSAGE 0x177A          // Order Iceberg Replace Request Message
#define TEMPLATE_ID_ORDER_MASS_CANCEL_REQUEST_MESSAGE 0x1774              // Order Mass Cancel Request Message
#define TEMPLATE_ID_ORDER_MASS_CANCEL_BY_BF_LIMIT_REQUEST_MESSAGE 0x1775  // Order Mass Cancel By Bf Limit Request Message
#define TEMPLATE_ID_NEW_ORDER_SINGLE_RESPONSE_MESSAGE 0x1B67              // New Order Single Response Message
#define TEMPLATE_ID_NEW_ORDER_ICEBERG_RESPONSE_MESSAGE 0x1B68             // New Order Iceberg Response Message
#define TEMPLATE_ID_ORDER_CANCEL_RESPONSE_MESSAGE 0x1B69                  // Order Cancel Response Message
#define TEMPLATE_ID_ORDER_REPLACE_RESPONSE_MESSAGE 0x1B6A                 // Order Replace Response Message
#define TEMPLATE_ID_ORDER_MASS_CANCEL_RESPONSE_MESSAGE 0x1B5F             // Order Mass Cancel Response Message
#define TEMPLATE_ID_EXECUTION_SINGLE_REPORT_MESSAGE 0x1B6B                // Execution Single Report Message
#define TEMPLATE_ID_EXECUTION_MULTILEG_REPORT_MESSAGE 0x1B6C              // Execution Multileg Report Message
#define TEMPLATE_ID_EMPTY_BOOK_MESSAGE 0x1B62                             // Empty Book Message
#define TEMPLATE_ID_SYSTEM_EVENT_MESSAGE 0x1B66                           // System Event Message

// Termination Code: one byte code
#define TERMINATION_CODE_FINISHED 0x00                  // Finished
#define TERMINATION_CODE_UNSPECIFIED_ERROR 0x01         // Unspecified Error
#define TERMINATION_CODE_RE_REQUEST_OUT_OF_BOUNDS 0x02  // Re Request Out Of Bounds
#define TERMINATION_CODE_RE_REQUEST_IN_PROGRESS 0x03    // Re Request In Progress
#define TERMINATION_CODE_TOO_FAST_CLIENT 0x04           // Too Fast Client
#define TERMINATION_CODE_TOO_SLOW_CLIENT 0x05           // Too Slow Client
#define TERMINATION_CODE_MISSED_HEARTBEAT 0x06          // Missed Heartbeat
#define TERMINATION_CODE_INVALID_MESSAGE 0x07           // Invalid Message
#define TERMINATION_CODE_TCP_FAILURE 0x08               // Tcp Failure
#define TERMINATION_CODE_INVALID_SEQUENCE_NUMBER 0x09   // Invalid Sequence Number
#define TERMINATION_CODE_SERVER_SHUTDOWN 0x0A           // Server Shutdown
#define TERMINATION_CODE_SEQUENCE_RESET 0x0B            // Sequence Reset

// Compliance Id: one byte code
#define COMPLIANCE_ID_NOT_AVAILABLE 0x20  // Not Available
#define COMPLIANCE_ID_MANUAL 0x4D         // Manual
#define COMPLIANCE_ID_STOP_LOSS 0x53      // Stop Loss
#define COMPLIANCE_ID_ALGORITHM 0x52      // Algorithm
#define COMPLIANCE_ID_AUTOFOLLOW 0x41     // Autofollow
#define COMPLIANCE_ID_MARGIN_CALL 0x44    // Margin Call

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY 0x00  // Day
#define TIME_IN_FORCE_IOC 0x03  // Ioc
#define TIME_IN_FORCE_FOK 0x04  // Fok
#define TIME_IN_FORCE_GTD 0x06  // Gtd
#define TIME_IN_FORCE_BOC 0x7A  // Boc

// Side: one byte code
#define SIDE_BUY 0x01         // Buy
#define SIDE_SELL 0x02        // Sell
#define SIDE_ALL_ORDERS 0x59  // All Orders

// Mode: one byte code
#define MODE_DONT_CHANGE_ORDER_QTY 0x00             // Dont Change Order Qty
#define MODE_CHANGE_ORDER_QTY 0x01                  // Change Order Qty
#define MODE_CHECK_ORDER_QTY_AND_CANCEL_ORDER 0x02  // Check Order Qty And Cancel Order
#define MODE_FIX_STYLE_REPLACE 0x03                 // Fix Style Replace

// ---- Types -------------------------------------------------------------------

// EstablishMessage
typedef struct _EstablishMessage {
  UINT64 timestamp;           // bytes 0 to 7
  UINT32 keepalive_interval;  // bytes 8 to 11
  UINT8 credentials[20];      // bytes 12 to 31
} EstablishMessage;

// TerminateMessage
typedef struct _TerminateMessage {
  UINT8 termination_code;  // byte 0
} TerminateMessage;

// RetransmitRequestMessage
typedef struct _RetransmitRequestMessage {
  UINT64 timestamp;    // bytes 0 to 7
  UINT64 from_seq_no;  // bytes 8 to 15
  UINT32 count;        // bytes 16 to 19
} RetransmitRequestMessage;

// SequenceMessage
typedef struct _SequenceMessage {
  UINT64 next_seq_no;  // bytes 0 to 7
} SequenceMessage;

// NewOrderSingleMessage
typedef struct _NewOrderSingleMessage {
  UINT64 cl_ord_id;                          // bytes 0 to 7
