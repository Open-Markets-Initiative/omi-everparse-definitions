// Twime message body sent by the firm
casetype _ClientPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x1388: EstablishMessage establish_message;
    case 0x138B: TerminateMessage terminate_message;
    case 0x138C: RetransmitRequestMessage retransmit_request_message;
    case 0x138E: SequenceMessage sequence_message;
    case 0x1770: NewOrderSingleMessage new_order_single_message;
    case 0x1778: NewOrderIcebergMessage new_order_iceberg_message;
    case 0x177B: NewOrderIcebergXMessage new_order_iceberg_x_message;
    case 0x1776: OrderCancelRequestMessage order_cancel_request_message;
    case 0x1779: OrderIcebergCancelRequestMessage order_iceberg_cancel_request_message;
    case 0x1777: OrderReplaceRequestMessage order_replace_request_message;
    case 0x177A: OrderIcebergReplaceRequestMessage order_iceberg_replace_request_message;
    case 0x1774: OrderMassCancelRequestMessage order_mass_cancel_request_message;
    case 0x1775: OrderMassCancelByBfLimitRequestMessage order_mass_cancel_by_bf_limit_request_message;
    default: UINT8 unknown[available];
  }
} ClientPayload;

// One Sbe message sent by the firm: the unit the Tcp stream repeats
typedef struct _ClientMessage {
  UINT16 block_length;                                                                                                                                  // bytes 0 to 1
  UINT16 template_id;                                                                                                                                   // bytes 2 to 3
  UINT16 schema_id;                                                                                                                                     // bytes 4 to 5
  UINT16 version;                                                                                                                                       // bytes 6 to 7
  ClientPayload(template_id, ((((UINT32) block_length) + 8) - 8)) client_payload[:byte-size-single-element-array ((((UINT32) block_length) + 8) - 8)];
} ClientMessage;

// ---- Packet: ClientPacket ----------------------------------------------------

// Moex Twime Messages Sent By The Firm
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientMessage client_message[:byte-size available];
} ClientPacket;

