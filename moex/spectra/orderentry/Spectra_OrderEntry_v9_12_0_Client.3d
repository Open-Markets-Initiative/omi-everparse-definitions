  UINT64 price;                              // bytes 16 to 23, signed, read here as unsigned
  UINT32 security_id;                        // bytes 24 to 27, signed, read here as unsigned
  UINT32 cl_ord_link_id;                     // bytes 28 to 31, signed, read here as unsigned
  UINT32 order_qty;                          // bytes 32 to 35
  UINT8 compliance_id;                       // byte 36
  UINT8 time_in_force;                       // byte 37
  UINT8 side;                                // byte 38
  UINT8 dont_check_limits_client_flags : 1;  // byte 39
  UINT8 ncc_request_client_flags : 1;        // byte 39
  UINT8 reserved_3_to_8 : 6;                 // byte 39
  UINT8 account[7];                          // bytes 40 to 46
} NewOrderSingleMessage;

