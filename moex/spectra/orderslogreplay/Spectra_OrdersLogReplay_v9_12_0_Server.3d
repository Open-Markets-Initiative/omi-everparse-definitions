  UINT16 version;       // bytes 6 to 7
} SbeHeader;

// ---- Logout Message: 256 bytes -----------------------------------------------

// LogoutMessage
entrypoint typedef struct _LogoutMessage {
  UINT8 text[256];  // bytes 0 to 255
} LogoutMessage;

// ---- Incremental Packet Header: 12 bytes -------------------------------------

// MarketDataDummyMessage
entrypoint typedef struct _IncrementalPacketHeader {
  UINT64 transact_time;                         // bytes 0 to 7
