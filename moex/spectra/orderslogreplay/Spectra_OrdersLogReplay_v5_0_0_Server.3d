// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_HEARTBEAT_MESSAGE 0x0001                          // Heartbeat Message
#define TEMPLATE_ID_SEQUENCE_RESET_MESSAGE 0x0002                     // Sequence Reset Message
#define TEMPLATE_ID_BEST_PRICES_MESSAGE 0x000E                        // Best Prices Message
#define TEMPLATE_ID_EMPTY_BOOK_MESSAGE 0x0004                         // Empty Book Message
#define TEMPLATE_ID_ORDER_UPDATE_MESSAGE 0x000F                       // Order Update Message
#define TEMPLATE_ID_ORDER_EXECUTION_MESSAGE 0x0010                    // Order Execution Message
#define TEMPLATE_ID_ORDER_BOOK_SNAPSHOT_MESSAGE 0x0011                // Order Book Snapshot Message
#define TEMPLATE_ID_SECURITY_DEFINITION_MESSAGE 0x0014                // Security Definition Message
#define TEMPLATE_ID_SECURITY_STATUS_MESSAGE 0x0009                    // Security Status Message
#define TEMPLATE_ID_SECURITY_DEFINITION_UPDATE_REPORT_MESSAGE 0x000A  // Security Definition Update Report Message
#define TEMPLATE_ID_TRADING_SESSION_STATUS_MESSAGE 0x000B             // Trading Session Status Message
#define TEMPLATE_ID_DISCRETE_AUCTION_MESSAGE 0x000D                   // Discrete Auction Message
#define TEMPLATE_ID_SECURITY_MASS_STATUS_MESSAGE 0x0013               // Security Mass Status Message
#define TEMPLATE_ID_LOGON_MESSAGE 0x03E8                              // Logon Message
#define TEMPLATE_ID_LOGOUT_MESSAGE 0x03E9                             // Logout Message
#define TEMPLATE_ID_MARKET_DATA_REQUEST_MESSAGE 0x03EA                // Market Data Request Message
#define TEMPLATE_ID_MARKET_DATA_DUMMY_MESSAGE 0x03EB                  // Market Data Dummy Message

// Md Update Action: one byte code
#define MD_UPDATE_ACTION_NEW 0x00     // New
#define MD_UPDATE_ACTION_CHANGE 0x01  // Change
#define MD_UPDATE_ACTION_DELETE 0x02  // Delete

// Md Entry Type: one byte code
#define MD_ENTRY_TYPE_BID 0x30         // Bid
#define MD_ENTRY_TYPE_OFFER 0x31       // Offer
#define MD_ENTRY_TYPE_EMPTY_BOOK 0x4A  // Empty Book

// ---- Types -------------------------------------------------------------------

// LogoutMessage
typedef struct _LogoutMessage {
  UINT8 text[256];  // bytes 0 to 255
} LogoutMessage;

// Branch
casetype _ServerSessionPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0001: unit heartbeat_message;
    case 0x03E8: unit logon_message;
    case 0x03E9: LogoutMessage logout_message;
    default: UINT8 unknown[available];
  }
} ServerSessionPayload;

// Moex Simba Replay Response Message, one Sbe message in a snapshot packet
typedef struct _ServerSession (UINT32 available) where (available >= 8) {
  UINT16 block_length;                                                                                                         // bytes 0 to 1
  UINT16 template_id;                                                                                                          // bytes 2 to 3
  UINT16 schema_id;                                                                                                            // bytes 4 to 5
  UINT16 version;                                                                                                              // bytes 6 to 7
  ServerSessionPayload(template_id, (available - 8)) server_session_payload[:byte-size-single-element-array (available - 8)];
} ServerSession;

// MarketDataDummyMessage
typedef struct _IncrementalPacketHeader {
  UINT64 transact_time;                         // bytes 0 to 7
  UINT32 exchange_trading_session_id_optional;  // bytes 8 to 11
} IncrementalPacketHeader;

// NoMDEntries
typedef struct _BestPricesMessageNoMdEntriesGroup {
  UINT64 mkt_bid_px;      // bytes 0 to 7, signed, read here as unsigned
  UINT64 mkt_offer_px;    // bytes 8 to 15, signed, read here as unsigned
  UINT64 mkt_bid_size;    // bytes 16 to 23, signed, read here as unsigned
  UINT64 mkt_offer_size;  // bytes 24 to 31, signed, read here as unsigned
  UINT32 security_id;     // bytes 32 to 35, signed, read here as unsigned
} BestPricesMessageNoMdEntriesGroup;

// NoMDEntries Block
typedef struct _BestPricesMessageNoMdEntriesGroups {
  UINT16 block_length;                                                                                                          // bytes 0 to 1
  UINT8 num_in_group_uint_8;                                                                                                    // byte 2
  BestPricesMessageNoMdEntriesGroup best_prices_message_no_md_entries_group[:byte-size (((UINT32) num_in_group_uint_8) * 36)];
} BestPricesMessageNoMdEntriesGroups;

// BestPricesMessage
typedef struct _BestPricesMessage {
  BestPricesMessageNoMdEntriesGroups best_prices_message_no_md_entries_groups;
} BestPricesMessage;

// EmptyBookMessage
typedef struct _EmptyBookMessage {
  UINT32 last_msg_seq_num_processed_optional;  // bytes 0 to 3
} EmptyBookMessage;

// OrderUpdateMessage
typedef struct _OrderUpdateMessage {
  UINT64 md_entry_id;                  // bytes 0 to 7, signed, read here as unsigned
  UINT64 md_entry_px;                  // bytes 8 to 15, signed, read here as unsigned
  UINT64 md_entry_size;                // bytes 16 to 23, signed, read here as unsigned
  UINT64 day : 1;                      // bytes 24 to 31
  UINT64 ioc : 1;                      // bytes 24 to 31
  UINT64 non_quote : 1;                // bytes 24 to 31
  UINT64 unused_bits_3_to_11 : 9;      // bytes 24 to 31
  UINT64 end_of_transaction : 1;       // bytes 24 to 31
  UINT64 due_to_cross_cancel : 1;      // bytes 24 to 31
  UINT64 second_leg : 1;               // bytes 24 to 31
  UINT64 unused_bits_15_to_18 : 4;     // bytes 24 to 31
  UINT64 fok : 1;                      // bytes 24 to 31
  UINT64 replace : 1;                  // bytes 24 to 31
  UINT64 cancel : 1;                   // bytes 24 to 31
  UINT64 mass_cancel : 1;              // bytes 24 to 31
  UINT64 unused_bits_23_to_25 : 3;     // bytes 24 to 31
  UINT64 negotiated : 1;               // bytes 24 to 31
  UINT64 multi_leg : 1;                // bytes 24 to 31
  UINT64 unused_bit_28 : 1;            // bytes 24 to 31
  UINT64 cross_trade : 1;              // bytes 24 to 31
  UINT64 unused_bit_30 : 1;            // bytes 24 to 31
  UINT64 negotiated_match_by_ref : 1;  // bytes 24 to 31
  UINT64 cod : 1;                      // bytes 24 to 31
  UINT64 unused_bits_33_to_40 : 8;     // bytes 24 to 31
  UINT64 active_side : 1;              // bytes 24 to 31
  UINT64 passive_side : 1;             // bytes 24 to 31
  UINT64 unused_bits_43_to_44 : 2;     // bytes 24 to 31
  UINT64 synthetic : 1;                // bytes 24 to 31
  UINT64 rfs : 1;                      // bytes 24 to 31
  UINT64 unused_bits_47_to_56 : 10;    // bytes 24 to 31
  UINT64 synthetic_passive : 1;        // bytes 24 to 31
  UINT64 unused_bits_58_to_59 : 2;     // bytes 24 to 31
  UINT64 boc : 1;                      // bytes 24 to 31
  UINT64 unused_bit_61 : 1;            // bytes 24 to 31
  UINT64 during_discrete_auction : 1;  // bytes 24 to 31
  UINT64 unused_bit_63 : 1;            // bytes 24 to 31
  UINT64 zero : 1;                     // bytes 32 to 39
  UINT64 reserved_63 : 63;             // bytes 32 to 39
  UINT32 security_id;                  // bytes 40 to 43, signed, read here as unsigned
  UINT32 rpt_seq;                      // bytes 44 to 47
  UINT8 md_update_action;              // byte 48
  UINT8 md_entry_type;                 // byte 49
} OrderUpdateMessage;

// OrderExecutionMessage
typedef struct _OrderExecutionMessage {
  UINT64 md_entry_id;                  // bytes 0 to 7, signed, read here as unsigned
  UINT64 md_entry_px_optional;         // bytes 8 to 15, signed, read here as unsigned
  UINT64 md_entry_size_optional;       // bytes 16 to 23, signed, read here as unsigned
  UINT64 last_px;                      // bytes 24 to 31, signed, read here as unsigned
  UINT64 last_qty;                     // bytes 32 to 39, signed, read here as unsigned
  UINT64 trade_id;                     // bytes 40 to 47, signed, read here as unsigned
  UINT64 day : 1;                      // bytes 48 to 55
  UINT64 ioc : 1;                      // bytes 48 to 55
  UINT64 non_quote : 1;                // bytes 48 to 55
  UINT64 unused_bits_3_to_11 : 9;      // bytes 48 to 55
  UINT64 end_of_transaction : 1;       // bytes 48 to 55
  UINT64 due_to_cross_cancel : 1;      // bytes 48 to 55
  UINT64 second_leg : 1;               // bytes 48 to 55
  UINT64 unused_bits_15_to_18 : 4;     // bytes 48 to 55
  UINT64 fok : 1;                      // bytes 48 to 55
  UINT64 replace : 1;                  // bytes 48 to 55
  UINT64 cancel : 1;                   // bytes 48 to 55
  UINT64 mass_cancel : 1;              // bytes 48 to 55
  UINT64 unused_bits_23_to_25 : 3;     // bytes 48 to 55
  UINT64 negotiated : 1;               // bytes 48 to 55
  UINT64 multi_leg : 1;                // bytes 48 to 55
  UINT64 unused_bit_28 : 1;            // bytes 48 to 55
  UINT64 cross_trade : 1;              // bytes 48 to 55
  UINT64 unused_bit_30 : 1;            // bytes 48 to 55
  UINT64 negotiated_match_by_ref : 1;  // bytes 48 to 55
  UINT64 cod : 1;                      // bytes 48 to 55
  UINT64 unused_bits_33_to_40 : 8;     // bytes 48 to 55
  UINT64 active_side : 1;              // bytes 48 to 55
  UINT64 passive_side : 1;             // bytes 48 to 55
  UINT64 unused_bits_43_to_44 : 2;     // bytes 48 to 55
  UINT64 synthetic : 1;                // bytes 48 to 55
  UINT64 rfs : 1;                      // bytes 48 to 55
  UINT64 unused_bits_47_to_56 : 10;    // bytes 48 to 55
  UINT64 synthetic_passive : 1;        // bytes 48 to 55
  UINT64 unused_bits_58_to_59 : 2;     // bytes 48 to 55
  UINT64 boc : 1;                      // bytes 48 to 55
  UINT64 unused_bit_61 : 1;            // bytes 48 to 55
  UINT64 during_discrete_auction : 1;  // bytes 48 to 55
  UINT64 unused_bit_63 : 1;            // bytes 48 to 55
  UINT64 zero : 1;                     // bytes 56 to 63
  UINT64 reserved_63 : 63;             // bytes 56 to 63
  UINT32 security_id;                  // bytes 64 to 67, signed, read here as unsigned
  UINT32 rpt_seq;                      // bytes 68 to 71
  UINT8 md_update_action;              // byte 72
  UINT8 md_entry_type;                 // byte 73
} OrderExecutionMessage;

// Branch
casetype _ServerReplayPayload (UINT16 selector) {
  switch (selector) {
    case 0x0001: unit heartbeat_message;
    case 0x000E: BestPricesMessage best_prices_message;
    case 0x0004: EmptyBookMessage empty_book_message;
    case 0x000F: OrderUpdateMessage order_update_message;
    case 0x0010: OrderExecutionMessage order_execution_message;
  }
} ServerReplayPayload;

// Moex Simba Market Data Message, one of the one or more an incremental packet carries
typedef struct _ServerReplayMessage {
  UINT16 block_length;                                     // bytes 0 to 1
  UINT16 template_id;                                      // bytes 2 to 3
  UINT16 schema_id;                                        // bytes 4 to 5
  UINT16 version;                                          // bytes 6 to 7
  ServerReplayPayload(template_id) server_replay_payload;
} ServerReplayMessage;

// Market data replayed as it was published on the Incremental Feed: the incremental packet header and the Sbe messages behind it
typedef struct _ServerReplay (UINT32 available) where (available >= 12) {
  IncrementalPacketHeader incremental_packet_header;                       // bytes 0 to 11
  ServerReplayMessage server_replay_message[:byte-size (available - 12)];
} ServerReplay;

// Branch
casetype _ServerBody (UINT8 selector, UINT32 length, UINT32 available) {
  switch (selector) {
    case 0: ServerSession(available) server_session;
    case 1: ServerReplay(length) server_replay[:byte-size-single-element-array length];
    default: UINT8 unknown[available];
  }
} ServerBody;

// One packet sent by the gateway, snapshot framed or incremental framed: the unit the Tcp stream repeats
typedef struct _ServerFrame {
  UINT32 msg_seq_num;                                                                                                                                              // bytes 0 to 3
  UINT16 msg_size { msg_size >= 16 };                                                                                                                              // bytes 4 to 5
  UINT16 last_fragment : 1;                                                                                                                                        // bytes 6 to 7
  UINT16 start_of_snapshot : 1;                                                                                                                                    // bytes 6 to 7
  UINT16 end_of_snapshot : 1;                                                                                                                                      // bytes 6 to 7
  UINT16 incremental_packet : 1;                                                                                                                                   // bytes 6 to 7
  UINT16 poss_dup_flag : 1;                                                                                                                                        // bytes 6 to 7
  UINT16 reserved_bits : 11;                                                                                                                                       // bytes 6 to 7
  UINT64 sending_time;                                                                                                                                             // bytes 8 to 15
  ServerBody(incremental_packet, (((UINT32) msg_size) - 16), (((UINT32) msg_size) - 16)) server_body[:byte-size-single-element-array (((UINT32) msg_size) - 16)];
} ServerFrame;

// ---- Packet: ServerPacket ----------------------------------------------------

// Moex Simba Replay Packets Sent By The Gateway
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerFrame server_frame[:byte-size available];
} ServerPacket;

