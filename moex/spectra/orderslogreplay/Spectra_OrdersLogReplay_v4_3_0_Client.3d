  UINT16 schema_id;     // bytes 4 to 5
  UINT16 version;       // bytes 6 to 7
} SbeHeader;

// ---- Logout Message: 256 bytes -----------------------------------------------

// LogoutMessage
entrypoint typedef struct _LogoutMessage {
  UINT8 text[256];  // bytes 0 to 255
} LogoutMessage;

// ---- Market Data Request Message: 8 bytes ------------------------------------

