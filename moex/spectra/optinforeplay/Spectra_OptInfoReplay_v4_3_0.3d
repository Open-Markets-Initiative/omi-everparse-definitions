casetype _OptionalSecurityDescData (Bool present, UINT32 length) {
  switch (present) {
    case true: UINT8 security_desc_data[length];
    case false: unit absent;
  }
} OptionalSecurityDescData;

// SecurityDesc data struct
typedef struct _SecurityDesc {
  UINT16 security_desc_length;                                                                                    // bytes 0 to 1
  OptionalSecurityDescData((security_desc_length > 0x0000), ((UINT32) security_desc_length)) security_desc_data;
} SecurityDesc;

casetype _OptionalQuotationListData (Bool present, UINT32 length) {
  switch (present) {
    case true: UINT8 quotation_list_data[length];
    case false: unit absent;
  }
} OptionalQuotationListData;

// QuotationList data struct
typedef struct _QuotationList {
  UINT16 quotation_list_length;                                                                                       // bytes 0 to 1
  OptionalQuotationListData((quotation_list_length > 0x0000), ((UINT32) quotation_list_length)) quotation_list_data;
} QuotationList;

// SecurityDefinitionMessage
typedef struct _SecurityDefinitionMessage {
  UINT32 tot_num_reports;                                                                            // bytes 0 to 3
  UINT8 symbol[25];                                                                                  // bytes 4 to 28
  UINT32 security_id;                                                                                // bytes 29 to 32, signed, read here as unsigned
  UINT8 security_alt_id[25];                                                                         // bytes 33 to 57
  UINT8 security_alt_id_source;                                                                      // byte 58
  UINT8 security_type[4];                                                                            // bytes 59 to 62
  UINT8 cfi_code[6];                                                                                 // bytes 63 to 68
  UINT64 strike_price;                                                                               // bytes 69 to 76, signed, read here as unsigned
  UINT32 contract_multiplier;                                                                        // bytes 77 to 80, signed, read here as unsigned
  UINT8 security_trading_status;                                                                     // byte 81
  UINT8 currency[3];                                                                                 // bytes 82 to 84
  UINT8 market_segment_id;                                                                           // byte 85
  UINT8 trading_session_id;                                                                          // byte 86
  UINT32 exchange_trading_session_id_int_32_null_optional;                                           // bytes 87 to 90, signed, read here as unsigned
  UINT64 volatility;                                                                                 // bytes 91 to 98, signed, read here as unsigned
  UINT64 high_limit_px;                                                                              // bytes 99 to 106, signed, read here as unsigned
  UINT64 low_limit_px;                                                                               // bytes 107 to 114, signed, read here as unsigned
  UINT64 min_price_increment;                                                                        // bytes 115 to 122, signed, read here as unsigned
  UINT64 min_price_increment_amount;                                                                 // bytes 123 to 130, signed, read here as unsigned
  UINT64 initial_margin_on_buy;                                                                      // bytes 131 to 138, signed, read here as unsigned
  UINT64 initial_margin_on_sell;                                                                     // bytes 139 to 146, signed, read here as unsigned
  UINT64 initial_margin_syntetic;                                                                    // bytes 147 to 154, signed, read here as unsigned
  UINT64 theor_price;                                                                                // bytes 155 to 162, signed, read here as unsigned
  UINT64 theor_price_limit;                                                                          // bytes 163 to 170, signed, read here as unsigned
  UINT64 underlying_qty;                                                                             // bytes 171 to 178, signed, read here as unsigned
  UINT8 underlying_currency[3];                                                                      // bytes 179 to 181
  UINT32 maturity_date;                                                                              // bytes 182 to 185
  UINT32 maturity_time;                                                                              // bytes 186 to 189
  UINT64 evening_or_morning_session : 1;                                                             // bytes 190 to 197
  UINT64 unused_bits_1_to_3 : 3;                                                                     // bytes 190 to 197
  UINT64 anonymous_trading : 1;                                                                      // bytes 190 to 197
  UINT64 private_trading : 1;                                                                        // bytes 190 to 197
  UINT64 day_session : 1;                                                                            // bytes 190 to 197
  UINT64 unused_bit_7 : 1;                                                                           // bytes 190 to 197
  UINT64 multi_leg : 1;                                                                              // bytes 190 to 197
  UINT64 unused_bits_9_to_17 : 9;                                                                    // bytes 190 to 197
  UINT64 collateral : 1;                                                                             // bytes 190 to 197
  UINT64 intraday_exercise : 1;                                                                      // bytes 190 to 197
  UINT64 reserved_44 : 44;                                                                           // bytes 190 to 197
  UINT64 min_price_increment_amount_curr;                                                            // bytes 198 to 205, signed, read here as unsigned
  UINT64 settl_price_open;                                                                           // bytes 206 to 213, signed, read here as unsigned
  UINT8 valuation_method[4];                                                                         // bytes 214 to 217
  UINT8 risk_free_rate[8];                                                                           // bytes 218 to 225
  UINT8 fixed_spot_discount[8];                                                                      // bytes 226 to 233
  UINT8 projected_spot_discount[8];                                                                  // bytes 234 to 241
  UINT8 settl_currency[3];                                                                           // bytes 242 to 244
  UINT8 negative_prices;                                                                             // byte 245
  UINT32 derivative_contract_multiplier;                                                             // bytes 246 to 249, signed, read here as unsigned
  UINT8 interest_rate_risk_up[8];                                                                    // bytes 250 to 257
  UINT8 interest_rate_risk_down[8];                                                                  // bytes 258 to 265
  UINT8 risk_free_rate_2[8];                                                                         // bytes 266 to 273
  UINT8 interest_rate_2_risk_up[8];                                                                  // bytes 274 to 281
  UINT8 interest_rate_2_risk_down[8];                                                                // bytes 282 to 289
  SecurityDefinitionMessageNoMdFeedTypesGroups security_definition_message_no_md_feed_types_groups;
  SecurityDefinitionMessageNoUnderlyingsGroups security_definition_message_no_underlyings_groups;
