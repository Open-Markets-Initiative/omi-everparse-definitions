// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_HEARTBEAT_MESSAGE 0x0001                          // Heartbeat Message
#define TEMPLATE_ID_SEQUENCE_RESET_MESSAGE 0x0002                     // Sequence Reset Message
#define TEMPLATE_ID_BEST_PRICES_MESSAGE 0x000E                        // Best Prices Message
#define TEMPLATE_ID_EMPTY_BOOK_MESSAGE 0x0004                         // Empty Book Message
#define TEMPLATE_ID_ORDER_UPDATE_MESSAGE 0x000F                       // Order Update Message
#define TEMPLATE_ID_ORDER_EXECUTION_MESSAGE 0x0010                    // Order Execution Message
#define TEMPLATE_ID_ORDER_BOOK_SNAPSHOT_MESSAGE 0x0011                // Order Book Snapshot Message
#define TEMPLATE_ID_SECURITY_DEFINITION_MESSAGE 0x0012                // Security Definition Message
#define TEMPLATE_ID_SECURITY_STATUS_MESSAGE 0x0009                    // Security Status Message
#define TEMPLATE_ID_SECURITY_DEFINITION_UPDATE_REPORT_MESSAGE 0x000A  // Security Definition Update Report Message
#define TEMPLATE_ID_TRADING_SESSION_STATUS_MESSAGE 0x000B             // Trading Session Status Message
#define TEMPLATE_ID_DISCRETE_AUCTION_MESSAGE 0x000D                   // Discrete Auction Message
#define TEMPLATE_ID_SECURITY_MASS_STATUS_MESSAGE 0x0013               // Security Mass Status Message
#define TEMPLATE_ID_LOGON_MESSAGE 0x03E8                              // Logon Message
#define TEMPLATE_ID_LOGOUT_MESSAGE 0x03E9                             // Logout Message
#define TEMPLATE_ID_MARKET_DATA_REQUEST_MESSAGE 0x03EA                // Market Data Request Message
#define TEMPLATE_ID_MARKET_DATA_DUMMY_MESSAGE 0x03EB                  // Market Data Dummy Message

// Security Alt Id Source: one byte code
#define SECURITY_ALT_ID_SOURCE_ISIN 0x34             // Isin
#define SECURITY_ALT_ID_SOURCE_EXCHANGE_SYMBOL 0x38  // Exchange Symbol

// Security Trading Status: one byte code
#define SECURITY_TRADING_STATUS_TRADING_HALT 0x02               // Trading Halt
#define SECURITY_TRADING_STATUS_READY_TO_TRADE 0x11             // Ready To Trade
#define SECURITY_TRADING_STATUS_NOT_AVAILABLE_FOR_TRADING 0x12  // Not Available For Trading
#define SECURITY_TRADING_STATUS_NOT_TRADED_ON_THIS_MARKET 0x13  // Not Traded On This Market
#define SECURITY_TRADING_STATUS_UNKNOWN_OR_INVALID 0x14         // Unknown Or Invalid
#define SECURITY_TRADING_STATUS_PRE_OPEN 0x15                   // Pre Open
#define SECURITY_TRADING_STATUS_DISCRETE_AUCTION_OPEN 0x77      // Discrete Auction Open
#define SECURITY_TRADING_STATUS_DISCRETE_AUCTION_CLOSE 0x79     // Discrete Auction Close
#define SECURITY_TRADING_STATUS_INSTRUMENT_HALT 0x7A            // Instrument Halt

// Market Segment Id: one byte code
#define MARKET_SEGMENT_ID_DERIVATIVES 0x44  // Derivatives

// Trading Session Id: one byte code
#define TRADING_SESSION_ID_DAY 0x01      // Day
#define TRADING_SESSION_ID_MORNING 0x03  // Morning
#define TRADING_SESSION_ID_EVENING 0x05  // Evening

// Negative Prices: one byte code
#define NEGATIVE_PRICES_NOT_ELIGIBLE 0x00  // Not Eligible
#define NEGATIVE_PRICES_ELIGIBLE 0x01      // Eligible

// Trad Ses Status: one byte code
#define TRAD_SES_STATUS_HALTED 0x01    // Halted
#define TRAD_SES_STATUS_OPEN 0x02      // Open
#define TRAD_SES_STATUS_CLOSED 0x03    // Closed
#define TRAD_SES_STATUS_PRE_OPEN 0x04  // Pre Open

// Trad Ses Event: one byte code
#define TRAD_SES_EVENT_TRADING_RESUMES 0x00            // Trading Resumes
#define TRAD_SES_EVENT_CHANGE_OF_TRADING_SESSION 0x01  // Change Of Trading Session
#define TRAD_SES_EVENT_CHANGE_OF_TRADING_STATUS 0x03   // Change Of Trading Status

