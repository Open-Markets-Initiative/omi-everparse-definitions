  DiscreteAuctionMessageNoUnderlyingsGroupCounted(((UINT32) num_in_group)) discrete_auction_message_no_underlyings_group;
} DiscreteAuctionMessageNoUnderlyingsGroups;

// DiscreteAuctionMessage
typedef struct _DiscreteAuctionMessage {
  UINT64 trad_ses_open_time;                                                                 // bytes 0 to 7
  UINT64 trad_ses_close_time_from;                                                           // bytes 8 to 15
  UINT64 trad_ses_close_time_till;                                                           // bytes 16 to 23
  UINT64 auction_id;                                                                         // bytes 24 to 31, signed, read here as unsigned
  UINT32 exchange_trading_session_id_int_32;                                                 // bytes 32 to 35, signed, read here as unsigned
  UINT32 event_id_open;                                                                      // bytes 36 to 39, signed, read here as unsigned
  UINT32 event_id_close;                                                                     // bytes 40 to 43, signed, read here as unsigned
  DiscreteAuctionMessageNoUnderlyingsGroups discrete_auction_message_no_underlyings_groups;
} DiscreteAuctionMessage;

// Branch
casetype _Payload (UINT16 selector) {
  switch (selector) {
    case 0x0001: unit heartbeat_message;
    case 0x0002: SequenceResetMessage sequence_reset_message;
    case 0x0009: SecurityStatusMessage security_status_message;
    case 0x000B: TradingSessionStatusMessage trading_session_status_message;
    case 0x000D: DiscreteAuctionMessage discrete_auction_message;
  }
} Payload;

// Moex Simba Market Data Message
typedef struct _Message {
  UINT16 block_length;           // bytes 0 to 1
  UINT16 template_id;            // bytes 2 to 3
  UINT16 schema_id;              // bytes 4 to 5
  UINT16 version;                // bytes 6 to 7
  Payload(template_id) payload;
} Message;

// ---- Packet: UdpPacket -------------------------------------------------------

// Moex Simba Incremental Packet
entrypoint typedef struct _UdpPacket (UINT32 available) where (available >= 28) {
  MarketDataPacketHeader market_data_packet_header;   // bytes 0 to 15
  IncrementalPacketHeader incremental_packet_header;  // bytes 16 to 27
  Message message[:byte-size (available - 28)];
} UdpPacket;

