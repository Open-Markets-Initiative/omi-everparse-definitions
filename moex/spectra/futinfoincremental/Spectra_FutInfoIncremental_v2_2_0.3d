// NoUnderlyings
typedef struct _DiscreteAuctionMessageNoUnderlyingsGroupCounted (UINT32 count) {
  DiscreteAuctionMessageNoUnderlyingsGroupPart128(((count & 128) != 0)) part128;
  DiscreteAuctionMessageNoUnderlyingsGroupPart64(((count & 64) != 0)) part64;
  DiscreteAuctionMessageNoUnderlyingsGroupPart32(((count & 32) != 0)) part32;
  DiscreteAuctionMessageNoUnderlyingsGroupPart16(((count & 16) != 0)) part16;
  DiscreteAuctionMessageNoUnderlyingsGroupPart8(((count & 8) != 0)) part8;
  DiscreteAuctionMessageNoUnderlyingsGroupPart4(((count & 4) != 0)) part4;
  DiscreteAuctionMessageNoUnderlyingsGroupPart2(((count & 2) != 0)) part2;
  DiscreteAuctionMessageNoUnderlyingsGroupPart1(((count & 1) != 0)) part1;
} DiscreteAuctionMessageNoUnderlyingsGroupCounted;

