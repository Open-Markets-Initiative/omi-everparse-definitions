// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, UdpPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Spectra_FutInfoIncremental_v1_0_4.3d

// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_HEARTBEAT_MESSAGE 0x0001                          // Heartbeat Message
#define TEMPLATE_ID_SEQUENCE_RESET_MESSAGE 0x0002                     // Sequence Reset Message
#define TEMPLATE_ID_BEST_PRICES_MESSAGE 0x0003                        // Best Prices Message
#define TEMPLATE_ID_EMPTY_BOOK_MESSAGE 0x0004                         // Empty Book Message
#define TEMPLATE_ID_ORDER_UPDATE_MESSAGE 0x0005                       // Order Update Message
#define TEMPLATE_ID_ORDER_EXECUTION_MESSAGE 0x0006                    // Order Execution Message
#define TEMPLATE_ID_ORDER_BOOK_SNAPSHOT_MESSAGE 0x0007                // Order Book Snapshot Message
#define TEMPLATE_ID_SECURITY_DEFINITION_MESSAGE 0x0008                // Security Definition Message
#define TEMPLATE_ID_SECURITY_STATUS_MESSAGE 0x0009                    // Security Status Message
#define TEMPLATE_ID_SECURITY_DEFINITION_UPDATE_REPORT_MESSAGE 0x000A  // Security Definition Update Report Message
#define TEMPLATE_ID_TRADING_SESSION_STATUS_MESSAGE 0x000B             // Trading Session Status Message
#define TEMPLATE_ID_LOGON_MESSAGE 0x03E8                              // Logon Message
#define TEMPLATE_ID_LOGOUT_MESSAGE 0x03E9                             // Logout Message
#define TEMPLATE_ID_MARKET_DATA_REQUEST_MESSAGE 0x03EA                // Market Data Request Message
#define TEMPLATE_ID_MARKET_DATA_DUMMY_MESSAGE 0x03EB                  // Market Data Dummy Message

// Security Trading Status: one byte code
#define SECURITY_TRADING_STATUS_TRADING_HALT 0x02               // Trading Halt
#define SECURITY_TRADING_STATUS_READY_TO_TRADE 0x11             // Ready To Trade
#define SECURITY_TRADING_STATUS_NOT_AVAILABLE_FOR_TRADING 0x12  // Not Available For Trading
#define SECURITY_TRADING_STATUS_NOT_TRADED_ON_THIS_MARKET 0x13  // Not Traded On This Market
#define SECURITY_TRADING_STATUS_PRE_OPEN 0x15                   // Pre Open

// Trading Session Id: one byte code
#define TRADING_SESSION_ID_DAY 0x01      // Day
#define TRADING_SESSION_ID_MORNING 0x03  // Morning
#define TRADING_SESSION_ID_EVENING 0x05  // Evening

// Trad Ses Status: one byte code
#define TRAD_SES_STATUS_HALTED 0x01    // Halted
#define TRAD_SES_STATUS_OPEN 0x02      // Open
#define TRAD_SES_STATUS_CLOSED 0x03    // Closed
#define TRAD_SES_STATUS_PRE_OPEN 0x04  // Pre Open

// Market Segment Id: one byte code
#define MARKET_SEGMENT_ID_DERIVATIVES 0x44  // Derivatives

// Trad Ses Event: one byte code
#define TRAD_SES_EVENT_TRADING_RESUMES 0x00            // Trading Resumes
#define TRAD_SES_EVENT_CHANGE_OF_TRADING_SESSION 0x01  // Change Of Trading Session
#define TRAD_SES_EVENT_CHANGE_OF_TRADING_STATUS 0x03   // Change Of Trading Status

// ---- Types -------------------------------------------------------------------

// MarketDataDummyMessage
typedef struct _MarketDataPacketHeader {
  UINT32 msg_seq_num;             // bytes 0 to 3
  UINT16 msg_size;                // bytes 4 to 5
  UINT16 last_fragment : 1;       // bytes 6 to 7
  UINT16 start_of_snapshot : 1;   // bytes 6 to 7
  UINT16 end_of_snapshot : 1;     // bytes 6 to 7
  UINT16 incremental_packet : 1;  // bytes 6 to 7
  UINT16 poss_dup_flag : 1;       // bytes 6 to 7
  UINT16 reserved_6_to_16 : 11;   // bytes 6 to 7
  UINT64 sending_time;            // bytes 8 to 15
} MarketDataPacketHeader;

// MarketDataDummyMessage
typedef struct _IncrementalPacketHeader {
  UINT64 transact_time;                         // bytes 0 to 7
  UINT32 exchange_trading_session_id_optional;  // bytes 8 to 11
} IncrementalPacketHeader;

// SequenceResetMessage
typedef struct _SequenceResetMessage {
  UINT32 new_seq_no;  // bytes 0 to 3
} SequenceResetMessage;

// SecurityStatusMessage
typedef struct _SecurityStatusMessage {
  UINT32 security_id;              // bytes 0 to 3, signed, read here as unsigned
  UINT8 symbol[25];                // bytes 4 to 28
  UINT8 security_trading_status;   // byte 29
  UINT64 high_limit_px;            // bytes 30 to 37, signed, read here as unsigned
  UINT64 low_limit_px;             // bytes 38 to 45, signed, read here as unsigned
  UINT64 initial_margin_on_buy;    // bytes 46 to 53, signed, read here as unsigned
  UINT64 initial_margin_on_sell;   // bytes 54 to 61, signed, read here as unsigned
  UINT64 initial_margin_syntetic;  // bytes 62 to 69, signed, read here as unsigned
} SecurityStatusMessage;

// TradingSessionStatusMessage
typedef struct _TradingSessionStatusMessage {
  UINT64 trad_ses_open_time;                                // bytes 0 to 7
  UINT64 trad_ses_close_time;                               // bytes 8 to 15
  UINT64 trad_ses_interm_clearing_start_time;               // bytes 16 to 23
  UINT64 trad_ses_interm_clearing_end_time;                 // bytes 24 to 31
  UINT8 trading_session_id;                                 // byte 32
  UINT32 exchange_trading_session_id_int_32_null_optional;  // bytes 33 to 36, signed, read here as unsigned
  UINT8 trad_ses_status;                                    // byte 37
  UINT8 market_segment_id;                                  // byte 38
  UINT8 trad_ses_event;                                     // byte 39
} TradingSessionStatusMessage;

// Branch
casetype _Payload (UINT16 selector) {
  switch (selector) {
    case 0x0001: unit heartbeat_message;
    case 0x0002: SequenceResetMessage sequence_reset_message;
    case 0x0009: SecurityStatusMessage security_status_message;
    case 0x000B: TradingSessionStatusMessage trading_session_status_message;
  }
} Payload;

// Moex Simba Market Data Message
typedef struct _Message {
  UINT16 block_length;           // bytes 0 to 1
  UINT16 template_id;            // bytes 2 to 3
  UINT16 schema_id;              // bytes 4 to 5
  UINT16 version;                // bytes 6 to 7
  Payload(template_id) payload;
} Message;

// ---- Packet: UdpPacket -------------------------------------------------------

// Moex Simba Incremental Packet
entrypoint typedef struct _UdpPacket (UINT32 available) where (available >= 28) {
  MarketDataPacketHeader market_data_packet_header;   // bytes 0 to 15
  IncrementalPacketHeader incremental_packet_header;  // bytes 16 to 27
  Message message[:byte-size (available - 28)];
} UdpPacket;

