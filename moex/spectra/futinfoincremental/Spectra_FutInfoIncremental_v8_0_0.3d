  UINT8 trad_ses_event;                                     // byte 23
  UINT64 trade_period_id;                                   // bytes 24 to 31, signed, read here as unsigned
  UINT64 settl_sess_begin;                                  // bytes 32 to 39
  UINT64 clr_sess_begin;                                    // bytes 40 to 47
} TradingSessionStatusMessage;

