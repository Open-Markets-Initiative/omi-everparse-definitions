// Branch
casetype _Payload (UINT16 selector) {
  switch (selector) {
    case 0x0001: unit heartbeat_message;
    case 0x0002: SequenceResetMessage sequence_reset_message;
    case 0x0009: SecurityStatusMessage security_status_message;
    case 0x001A: TradingSessionStatusMessage trading_session_status_message;
    case 0x0018: DiscreteAuctionMessage discrete_auction_message;
    case 0x0013: SecurityMassStatusMessage security_mass_status_message;
    case 0x0016: SecurityGroupStatusMessage security_group_status_message;
  }
} Payload;

// Moex Simba Market Data Message
typedef struct _Message {
  UINT16 block_length;           // bytes 0 to 1
  UINT16 template_id;            // bytes 2 to 3
  UINT16 schema_id;              // bytes 4 to 5
  UINT16 version;                // bytes 6 to 7
  Payload(template_id) payload;
} Message;

// ---- Packet: UdpPacket -------------------------------------------------------

// Moex Simba Incremental Packet
entrypoint typedef struct _UdpPacket (UINT32 available) where (available >= 28) {
  MarketDataPacketHeader market_data_packet_header;   // bytes 0 to 15
  IncrementalPacketHeader incremental_packet_header;  // bytes 16 to 27
  Message message[:byte-size (available - 28)];
} UdpPacket;

