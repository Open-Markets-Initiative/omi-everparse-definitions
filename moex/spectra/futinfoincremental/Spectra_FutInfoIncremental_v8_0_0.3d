  UINT64 low_limit_px;             // bytes 38 to 45, signed, read here as unsigned
  UINT64 initial_margin_on_buy;    // bytes 46 to 53, signed, read here as unsigned
  UINT64 initial_margin_on_sell;   // bytes 54 to 61, signed, read here as unsigned
  UINT64 initial_margin_syntetic;  // bytes 62 to 69, signed, read here as unsigned
} SecurityStatusMessage;

// TradingSessionStatusMessage
typedef struct _TradingSessionStatusMessage {
