// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_HEARTBEAT_MESSAGE 0x0001                          // Heartbeat Message
#define TEMPLATE_ID_SEQUENCE_RESET_MESSAGE 0x0002                     // Sequence Reset Message
#define TEMPLATE_ID_BEST_PRICES_MESSAGE 0x000E                        // Best Prices Message
#define TEMPLATE_ID_EMPTY_BOOK_MESSAGE 0x0004                         // Empty Book Message
#define TEMPLATE_ID_ORDER_UPDATE_MESSAGE 0x000F                       // Order Update Message
#define TEMPLATE_ID_ORDER_EXECUTION_MESSAGE 0x0010                    // Order Execution Message
#define TEMPLATE_ID_ORDER_BOOK_SNAPSHOT_MESSAGE 0x0011                // Order Book Snapshot Message
#define TEMPLATE_ID_SECURITY_DEFINITION_MESSAGE 0x000C                // Security Definition Message
#define TEMPLATE_ID_SECURITY_STATUS_MESSAGE 0x0009                    // Security Status Message
#define TEMPLATE_ID_SECURITY_DEFINITION_UPDATE_REPORT_MESSAGE 0x000A  // Security Definition Update Report Message
#define TEMPLATE_ID_TRADING_SESSION_STATUS_MESSAGE 0x000B             // Trading Session Status Message
#define TEMPLATE_ID_DISCRETE_AUCTION_MESSAGE 0x000D                   // Discrete Auction Message
#define TEMPLATE_ID_LOGON_MESSAGE 0x03E8                              // Logon Message
#define TEMPLATE_ID_LOGOUT_MESSAGE 0x03E9                             // Logout Message
#define TEMPLATE_ID_MARKET_DATA_REQUEST_MESSAGE 0x03EA                // Market Data Request Message
#define TEMPLATE_ID_MARKET_DATA_DUMMY_MESSAGE 0x03EB                  // Market Data Dummy Message

// Md Entry Type: one byte code
#define MD_ENTRY_TYPE_BID 0x30         // Bid
#define MD_ENTRY_TYPE_OFFER 0x31       // Offer
#define MD_ENTRY_TYPE_EMPTY_BOOK 0x4A  // Empty Book

// ---- Types -------------------------------------------------------------------

// MarketDataDummyMessage
typedef struct _MarketDataPacketHeader {
  UINT32 msg_seq_num;             // bytes 0 to 3
  UINT16 msg_size;                // bytes 4 to 5
  UINT16 last_fragment : 1;       // bytes 6 to 7
  UINT16 start_of_snapshot : 1;   // bytes 6 to 7
  UINT16 end_of_snapshot : 1;     // bytes 6 to 7
  UINT16 incremental_packet : 1;  // bytes 6 to 7
  UINT16 poss_dup_flag : 1;       // bytes 6 to 7
  UINT16 reserved_bits : 11;      // bytes 6 to 7
  UINT64 sending_time;            // bytes 8 to 15
} MarketDataPacketHeader;

// SequenceResetMessage
typedef struct _SequenceResetMessage {
  UINT32 new_seq_no;  // bytes 0 to 3
} SequenceResetMessage;

// NoMDEntries
typedef struct _OrderBookSnapshotMessageNoMdEntriesGroup {
  UINT64 md_entry_id_optional;         // bytes 0 to 7, signed, read here as unsigned
  UINT64 transact_time;                // bytes 8 to 15
  UINT64 md_entry_px_optional;         // bytes 16 to 23, signed, read here as unsigned
  UINT64 md_entry_size_optional;       // bytes 24 to 31, signed, read here as unsigned
  UINT64 trade_id_optional;            // bytes 32 to 39, signed, read here as unsigned
  UINT64 day : 1;                      // bytes 40 to 47
  UINT64 ioc : 1;                      // bytes 40 to 47
  UINT64 non_quote : 1;                // bytes 40 to 47
  UINT64 unused_bits_3_to_11 : 9;      // bytes 40 to 47
  UINT64 end_of_transaction : 1;       // bytes 40 to 47
  UINT64 due_to_cross_cancel : 1;      // bytes 40 to 47
  UINT64 second_leg : 1;               // bytes 40 to 47
  UINT64 unused_bits_15_to_18 : 4;     // bytes 40 to 47
  UINT64 fok : 1;                      // bytes 40 to 47
  UINT64 replace : 1;                  // bytes 40 to 47
  UINT64 cancel : 1;                   // bytes 40 to 47
  UINT64 mass_cancel : 1;              // bytes 40 to 47
  UINT64 unused_bits_23_to_25 : 3;     // bytes 40 to 47
  UINT64 negotiated : 1;               // bytes 40 to 47
  UINT64 multi_leg : 1;                // bytes 40 to 47
  UINT64 unused_bit_28 : 1;            // bytes 40 to 47
  UINT64 cross_trade : 1;              // bytes 40 to 47
  UINT64 unused_bits_30_to_31 : 2;     // bytes 40 to 47
  UINT64 cod : 1;                      // bytes 40 to 47
  UINT64 unused_bits_33_to_40 : 8;     // bytes 40 to 47
  UINT64 active_side : 1;              // bytes 40 to 47
  UINT64 passive_side : 1;             // bytes 40 to 47
  UINT64 unused_bits_43_to_44 : 2;     // bytes 40 to 47
  UINT64 synthetic : 1;                // bytes 40 to 47
  UINT64 rfs : 1;                      // bytes 40 to 47
  UINT64 unused_bits_47_to_56 : 10;    // bytes 40 to 47
  UINT64 synthetic_passive : 1;        // bytes 40 to 47
  UINT64 unused_bits_58_to_59 : 2;     // bytes 40 to 47
  UINT64 boc : 1;                      // bytes 40 to 47
  UINT64 unused_bit_61 : 1;            // bytes 40 to 47
  UINT64 during_discrete_auction : 1;  // bytes 40 to 47
  UINT64 unused_bit_63 : 1;            // bytes 40 to 47
  UINT64 zero : 1;                     // bytes 48 to 55
  UINT64 reserved_63 : 63;             // bytes 48 to 55
  UINT8 md_entry_type;                 // byte 56
} OrderBookSnapshotMessageNoMdEntriesGroup;

// NoMDEntries Block
typedef struct _OrderBookSnapshotMessageNoMdEntriesGroups {
  UINT16 block_length;                                                                                                                  // bytes 0 to 1
  UINT8 num_in_group;                                                                                                                   // byte 2
  OrderBookSnapshotMessageNoMdEntriesGroup order_book_snapshot_message_no_md_entries_group[:byte-size (((UINT32) num_in_group) * 57)];
} OrderBookSnapshotMessageNoMdEntriesGroups;

// OrderBookSnapshotMessage
typedef struct _OrderBookSnapshotMessage {
  UINT32 security_id;                                                                          // bytes 0 to 3, signed, read here as unsigned
  UINT32 last_msg_seq_num_processed;                                                           // bytes 4 to 7
  UINT32 rpt_seq;                                                                              // bytes 8 to 11
  UINT32 exchange_trading_session_id;                                                          // bytes 12 to 15
  OrderBookSnapshotMessageNoMdEntriesGroups order_book_snapshot_message_no_md_entries_groups;
} OrderBookSnapshotMessage;

// Branch
casetype _Payload (UINT16 selector) {
  switch (selector) {
    case 0x0001: unit heartbeat_message;
    case 0x0002: SequenceResetMessage sequence_reset_message;
    case 0x0011: OrderBookSnapshotMessage order_book_snapshot_message;
  }
} Payload;

// Moex Simba Market Data Message
typedef struct _Message {
  UINT16 block_length;           // bytes 0 to 1
  UINT16 template_id;            // bytes 2 to 3
  UINT16 schema_id;              // bytes 4 to 5
  UINT16 version;                // bytes 6 to 7
  Payload(template_id) payload;
} Message;

// ---- Packet: UdpPacket -------------------------------------------------------

// Moex Simba Snapshot Packet
entrypoint typedef struct _UdpPacket (UINT32 available) where (available >= 16) {
  MarketDataPacketHeader market_data_packet_header;  // bytes 0 to 15
  Message message[:byte-size (available - 16)];
} UdpPacket;

