// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AsxSecurities_Mdf_v1_0.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SECONDS_MESSAGE 0x54                               // Seconds Message
#define MESSAGE_TYPE_ORDER_BOOK_DIRECTORY_MESSAGE 0x52                  // Order Book Directory Message
#define MESSAGE_TYPE_EXCHANGE_DIRECTORY_MESSAGE 0x65                    // Exchange Directory Message
#define MESSAGE_TYPE_MARKET_DIRECTORY_MESSAGE 0x6D                      // Market Directory Message
#define MESSAGE_TYPE_COMBINATION_ORDER_BOOK_LEG_DIRECTORY_MESSAGE 0x4D  // Combination Order Book Leg Directory Message
#define MESSAGE_TYPE_TICK_SIZE_TABLE_ENTRY_MESSAGE 0x4C                 // Tick Size Table Entry Message
#define MESSAGE_TYPE_CORPORATE_ACTION_ENTRY_MESSAGE 0x43                // Corporate Action Entry Message
#define MESSAGE_TYPE_ORDER_BOOK_DIRECTORY_EXTENSION_MESSAGE 0x66        // Order Book Directory Extension Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                          // System Event Message
#define MESSAGE_TYPE_ORDER_BOOK_STATE_MESSAGE 0x4F                      // Order Book State Message
#define MESSAGE_TYPE_BUSINESS_DATE_MESSAGE 0x42                         // Business Date Message
#define MESSAGE_TYPE_END_OF_RECOVERY_MESSAGE 0x67                       // End Of Recovery Message
#define MESSAGE_TYPE_INSTRUMENT_STATUS_MESSAGE 0x74                     // Instrument Status Message
#define MESSAGE_TYPE_EQUILIBRIUM_PRICE_MESSAGE 0x5A                     // Equilibrium Price Message
#define MESSAGE_TYPE_MARKET_BY_PRICE_MESSAGE 0x62                       // Market By Price Message
#define MESSAGE_TYPE_TRADE_STATISTICS_MESSAGE 0x49                      // Trade Statistics Message
#define MESSAGE_TYPE_REFERENCE_PRICE_MESSAGE 0x51                       // Reference Price Message
#define MESSAGE_TYPE_INDEX_MESSAGE 0x4A                                 // Index Message
#define MESSAGE_TYPE_OPEN_INTEREST_MESSAGE 0x68                         // Open Interest Message
#define MESSAGE_TYPE_TRADE_TICKER_MESSAGE 0x69                          // Trade Ticker Message
#define MESSAGE_TYPE_PRICE_LIMITS_MESSAGE 0x6B                          // Price Limits Message
#define MESSAGE_TYPE_MARKET_ANNOUNCEMENT_MESSAGE 0x4E                   // Market Announcement Message
#define MESSAGE_TYPE_END_OF_SNAPSHOT_MESSAGE 0x47                       // End Of Snapshot Message

// Financial Product: one byte code
#define FINANCIAL_PRODUCT_NOT_APPLICABLE 0x00               // Not Applicable
#define FINANCIAL_PRODUCT_OPTION 0x01                       // Option
#define FINANCIAL_PRODUCT_FORWARD 0x02                      // Forward
#define FINANCIAL_PRODUCT_FUTURE 0x03                       // Future
#define FINANCIAL_PRODUCT_FRA 0x04                          // Fra
#define FINANCIAL_PRODUCT_CASH 0x05                         // Cash
#define FINANCIAL_PRODUCT_PAYMENT 0x06                      // Payment
#define FINANCIAL_PRODUCT_EXCHANGE_RATE 0x07                // Exchange Rate
#define FINANCIAL_PRODUCT_INTEREST_RATE_SWAP 0x08           // Interest Rate Swap
#define FINANCIAL_PRODUCT_REPO 0x09                         // Repo
#define FINANCIAL_PRODUCT_SYNTHETIC_BOX_LEG_REFERENCE 0x0A  // Synthetic Box Leg Reference
#define FINANCIAL_PRODUCT_STANDARD_COMBINATION 0x0B         // Standard Combination
#define FINANCIAL_PRODUCT_GUARANTEE 0x0C                    // Guarantee
#define FINANCIAL_PRODUCT_OTC_GENERAL 0x0D                  // Otc General
#define FINANCIAL_PRODUCT_EQUITY_WARRANT 0x0E               // Equity Warrant
#define FINANCIAL_PRODUCT_SECURITY_LENDING 0x0F             // Security Lending

// Option Type: one byte code
#define OPTION_TYPE_UNDEFINED 0x00  // Undefined
#define OPTION_TYPE_CALL 0x01       // Call
#define OPTION_TYPE_PUT 0x02        // Put

// Primary: one byte code
#define PRIMARY_YES 0x01  // Yes
#define PRIMARY_NO 0x02   // No

// Test Order Book: one byte code
#define TEST_ORDER_BOOK_YES 0x01  // Yes
#define TEST_ORDER_BOOK_NO 0x02   // No

// Tradable: one byte code
#define TRADABLE_YES 0x01  // Yes
#define TRADABLE_NO 0x00   // No

// Externally Price Sourced: one byte code
#define EXTERNALLY_PRICE_SOURCED_YES 0x01  // Yes
#define EXTERNALLY_PRICE_SOURCED_NO 0x02   // No

// Deliverable: one byte code
#define DELIVERABLE_YES 0x01  // Yes
#define DELIVERABLE_NO 0x02   // No

// Price Unit: one byte code
#define PRICE_UNIT_YIELD 0x01                  // Yield
#define PRICE_UNIT_PRICE 0x02                  // Price
#define PRICE_UNIT_POINTS 0x03                 // Points
#define PRICE_UNIT_YIELD_DIFFERENCE 0x04       // Yield Difference
#define PRICE_UNIT_IMM_INDEX 0x05              // Imm Index
#define PRICE_UNIT_BASIS_POINTS 0x06           // Basis Points
#define PRICE_UNIT_INVERTED_YIELD 0x07         // Inverted Yield
#define PRICE_UNIT_PERCENTAGE_OF_NOMINAL 0x08  // Percentage Of Nominal
#define PRICE_UNIT_DIRTY_PRICE 0x09            // Dirty Price

// Foreign Ownership Restriction: one byte code
#define FOREIGN_OWNERSHIP_RESTRICTION_YES 0x01  // Yes
#define FOREIGN_OWNERSHIP_RESTRICTION_NO 0x02   // No

// Option Style: one byte code
#define OPTION_STYLE_NOT_APPLICABLE 0x00  // Not Applicable
#define OPTION_STYLE_AMERICAN 0x01        // American
#define OPTION_STYLE_EUROPEAN 0x02        // European
#define OPTION_STYLE_ASIAN 0x03           // Asian

// Status: one byte code
#define STATUS_ACTIVE 0x41     // Active
#define STATUS_DELISTED 0x44   // Delisted
#define STATUS_SUSPENDED 0x53  // Suspended

// Market Type: one byte code
#define MARKET_TYPE_STOCK 0x01         // Stock
#define MARKET_TYPE_FIXED_INCOME 0x02  // Fixed Income
#define MARKET_TYPE_CURRENCY 0x03      // Currency
#define MARKET_TYPE_POWER_ENERGY 0x04  // Power Energy
#define MARKET_TYPE_COMMODITY 0x05     // Commodity
#define MARKET_TYPE_PAYMENT 0x06       // Payment
#define MARKET_TYPE_INDEX 0x07         // Index
#define MARKET_TYPE_GENERAL 0x08       // General

// Index Market: one byte code
#define INDEX_MARKET_YES 0x01  // Yes
#define INDEX_MARKET_NO 0x02   // No

// Leg Side: one byte code
#define LEG_SIDE_BUY_LEG 0x42   // Buy Leg
#define LEG_SIDE_SELL_LEG 0x43  // Sell Leg

// Corporate Action Type: one byte code
#define CORPORATE_ACTION_TYPE_BASIS_OF_QUOTATION 0x42  // Basis Of Quotation
#define CORPORATE_ACTION_TYPE_STATUS_NOTE 0x53         // Status Note

// Corporate Action Status: one byte code
#define CORPORATE_ACTION_STATUS_C_A_ACTIVE 0x01    // CA Active
#define CORPORATE_ACTION_STATUS_C_A_INACTIVE 0x02  // CA Inactive

// Accrued Interest Updown: one byte code
#define ACCRUED_INTEREST_UPDOWN_BLANK 0x00  // Blank
#define ACCRUED_INTEREST_UPDOWN_UP 0x01     // Up
#define ACCRUED_INTEREST_UPDOWN_DOWN 0x02   // Down

// Calculation Convention: one byte code
#define CALCULATION_CONVENTION_BLANK 0x00            // Blank
#define CALCULATION_CONVENTION_COMPOUND 0x01         // Compound
#define CALCULATION_CONVENTION_COMPOUND_SIMPLE 0x02  // Compound Simple
#define CALCULATION_CONVENTION_SIMPLE_MM 0x03        // Simple Mm
#define CALCULATION_CONVENTION_DISCOUNT 0x04         // Discount
#define CALCULATION_CONVENTION_US_TREASURY 0x05      // Us Treasury
#define CALCULATION_CONVENTION_PROCEED 0x06          // Proceed

// Clean Price Updown: one byte code
#define CLEAN_PRICE_UPDOWN_BLANK 0x00  // Blank
#define CLEAN_PRICE_UPDOWN_UP 0x01     // Up
#define CLEAN_PRICE_UPDOWN_DOWN 0x02   // Down

// Day Calculation Rule: one byte code
#define DAY_CALCULATION_RULE_BLANK 0x00     // Blank
#define DAY_CALCULATION_RULE_ACTACT 0x01    // Actact
#define DAY_CALCULATION_RULE_ACTAFB 0x02    // Actafb
#define DAY_CALCULATION_RULE_EU_30360 0x03  // Eu 30360
#define DAY_CALCULATION_RULE_US_30360 0x04  // Us 30360
#define DAY_CALCULATION_RULE_ACT_365 0x05   // Act 365
#define DAY_CALCULATION_RULE_ACT_360 0x06   // Act 360

// Day Count Convention: one byte code
#define DAY_COUNT_CONVENTION_BLANK 0x00     // Blank
#define DAY_COUNT_CONVENTION_ACTACT 0x01    // Actact
#define DAY_COUNT_CONVENTION_ACTAFB 0x02    // Actafb
#define DAY_COUNT_CONVENTION_EU_30360 0x03  // Eu 30360
#define DAY_COUNT_CONVENTION_US_30360 0x04  // Us 30360
#define DAY_COUNT_CONVENTION_ACT_365 0x05   // Act 365
#define DAY_COUNT_CONVENTION_ACT_360 0x06   // Act 360

// Fixed Income Type: one byte code
#define FIXED_INCOME_TYPE_NOT_APPLICABLE 0x00       // Not Applicable
#define FIXED_INCOME_TYPE_BILL 0x01                 // Bill
#define FIXED_INCOME_TYPE_BOND 0x02                 // Bond
#define FIXED_INCOME_TYPE_INDEX_LINKED_BONDS 0x03   // Index Linked Bonds
#define FIXED_INCOME_TYPE_BOND_FLOATING 0x04        // Bond Floating
#define FIXED_INCOME_TYPE_LOTTERY_BOND 0x05         // Lottery Bond
#define FIXED_INCOME_TYPE_CONVERTIBLE_BOND 0x06     // Convertible Bond
#define FIXED_INCOME_TYPE_STRUCTURED_BOND 0x07      // Structured Bond
#define FIXED_INCOME_TYPE_FIXING 0x08               // Fixing
#define FIXED_INCOME_TYPE_CREDIT_CERTIFICATES 0x09  // Credit Certificates

// End Of Month Count Convention: 4 byte code
#define END_OF_MONTH_COUNT_CONVENTION_BLANK 0x00000000     // Blank
#define END_OF_MONTH_COUNT_CONVENTION_SAME 0x00000001      // Same
#define END_OF_MONTH_COUNT_CONVENTION_LAST_360 0x00000002  // Last 360
#define END_OF_MONTH_COUNT_CONVENTION_LAST 0x00000003      // Last

// Set End Consideration: one byte code
#define SET_END_CONSIDERATION_YES 0x01  // Yes
#define SET_END_CONSIDERATION_NO 0x02   // No

// Set Start Consideration: one byte code
#define SET_START_CONSIDERATION_YES 0x01  // Yes
#define SET_START_CONSIDERATION_NO 0x02   // No

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F  // Start Of Messages
#define EVENT_CODE_END_OF_MESSAGES 0x43    // End Of Messages
#define EVENT_CODE_DONE_FOR_DAY 0x45       // Done For Day

// Instrument State Level: one byte code
#define INSTRUMENT_STATE_LEVEL_MARKET 0x01             // Market
#define INSTRUMENT_STATE_LEVEL_INSTRUMENT_TYPE 0x02    // Instrument Type
#define INSTRUMENT_STATE_LEVEL_INSTRUMENT_SERIES 0x04  // Instrument Series
#define INSTRUMENT_STATE_LEVEL_UNDERLYING 0x05         // Underlying

// Level Update Action: one byte code
#define LEVEL_UPDATE_ACTION_NEW 0x4E          // New
#define LEVEL_UPDATE_ACTION_CHANGE 0x43       // Change
#define LEVEL_UPDATE_ACTION_DELETE_FROM 0x44  // Delete From

// Side: one byte code
#define SIDE_BID 0x42  // Bid
#define SIDE_ASK 0x41  // Ask

// Trend Indicator: one byte code
#define TREND_INDICATOR_NO_CHANGE 0x4E           // No Change
#define TREND_INDICATOR_UP 0x55                  // Up
#define TREND_INDICATOR_DOWN 0x44                // Down
#define TREND_INDICATOR_NO_TREND_AVAILABLE 0x20  // No Trend Available

// Price Type: one byte code
#define PRICE_TYPE_EXTERNALLY_INJECTED 0x00       // Externally Injected
#define PRICE_TYPE_PREVIOUS_LAST_PAID_PRICE 0x03  // Previous Last Paid Price
#define PRICE_TYPE_SETTLEMENT_PRICE 0x04          // Settlement Price
#define PRICE_TYPE_EVER_LAST_PRICE 0x05           // Ever Last Price

// Deal Source: one byte code
#define DEAL_SOURCE_NOT_SET 0x00                                                // Not Set
#define DEAL_SOURCE_MATCHED_BY_SYSTEM_AUTOMATICALLY 0x01                        // Matched By System Automatically
#define DEAL_SOURCE_MATCHED_OUTSIDE_EXCHANGE_DIFFERENT_BROKERS 0x03             // Matched Outside Exchange Different Brokers
#define DEAL_SOURCE_MATCHED_OUTSIDE_EXCHANGE_ONE_BROKER 0x05                    // Matched Outside Exchange One Broker
#define DEAL_SOURCE_STANDARD_COMBINATION_MATCHED 0x07                           // Standard Combination Matched
#define DEAL_SOURCE_TRADE_MATCHED_IN_AN_AUCTION 0x14                            // Trade Matched In An Auction
#define DEAL_SOURCE_TMC_ORDER_MATCHED 0x24                                      // Tmc Order Matched
#define DEAL_SOURCE_BOOKED_UNINTENTIONAL_CROSSING_PREVENTION 0x2C               // Booked Unintentional Crossing Prevention
#define DEAL_SOURCE_BOOKED_UNINTENTIONAL_CROSSING_PREVENTION_AUCTION 0x2D       // Booked Unintentional Crossing Prevention Auction
#define DEAL_SOURCE_CENTRE_POINT_PREFERENCE_MATCHING 0x2E                       // Centre Point Preference Matching
#define DEAL_SOURCE_EXECUTIONS_IN_CENTRE_POINT 0x2F                             // Executions In Centre Point
#define DEAL_SOURCE_BOOKED_CENTRE_POINT_UNINTENTIONAL_CROSSING_PREVENTION 0x30  // Booked Centre Point Unintentional Crossing Prevention
#define DEAL_SOURCE_CENTRE_POINT_ANY_PRICE_BLOCK_TRADE 0x32                     // Centre Point Any Price Block Trade
#define DEAL_SOURCE_PREFERENCE_CENTRE_POINT_ANY_PRICE_BLOCK_TRADE 0x33          // Preference Centre Point Any Price Block Trade
#define DEAL_SOURCE_POST_CLOSE_AUTO 0x5A                                        // Post Close Auto
#define DEAL_SOURCE_POST_CLOSE_BOOKED_TRANSACTION 0x5B                          // Post Close Booked Transaction

// Action: one byte code
#define ACTION_NEW 0x01       // New
#define ACTION_UPDATED 0x02   // Updated
#define ACTION_CANCELED 0x03  // Canceled

// Aggressor: one byte code
#define AGGRESSOR_BID 0x42  // Bid
#define AGGRESSOR_ASK 0x41  // Ask

// Printable: one byte code
#define PRINTABLE_FALSE 0x00  // False
#define PRINTABLE_TRUE 0x01   // True

// Exchange Order Type: 4 byte code
#define EXCHANGE_ORDER_TYPE_UNDEFINED 0x00000000            // Undefined
#define EXCHANGE_ORDER_TYPE_PRICE_STABILISATION 0x00000008  // Price Stabilisation
#define EXCHANGE_ORDER_TYPE_CENTRE_POINT 0x00000040         // Centre Point

// Trade Condition: one byte code
#define TRADE_CONDITION_NO_CONDITION 0x00                       // No Condition
#define TRADE_CONDITION_INTERNAL_TRADE_CROSSING 0x02            // Internal Trade Crossing
#define TRADE_CONDITION_BUY_WRITE 0x08                          // Buy Write
#define TRADE_CONDITION_BUY_WRITE_INTERNAL_TRADE_CROSSING 0x0A  // Buy Write Internal Trade Crossing

// Type: one byte code
#define TYPE_PRICE_LIMITS 0x01            // Price Limits
#define TYPE_CIRCUIT_BREAKER_LIMITS 0x02  // Circuit Breaker Limits

// Category: one byte code
#define CATEGORY_STATIC_LIMITS 0x01   // Static Limits
#define CATEGORY_DYNAMIC_LIMITS 0x02  // Dynamic Limits

// Message Information Type: one byte code
#define MESSAGE_INFORMATION_TYPE_COMPANY_ANNOUNCEMENT 0x01  // Company Announcement
#define MESSAGE_INFORMATION_TYPE_MARKET_MESSAGE 0x02        // Market Message
#define MESSAGE_INFORMATION_TYPE_STATIC_LINE 0x03           // Static Line
#define MESSAGE_INFORMATION_TYPE_NOTICE_RECEIVED 0x04       // Notice Received

// Message Priority: one byte code
#define MESSAGE_PRIORITY_LOW_PRIORITY 0x01       // Low Priority
#define MESSAGE_PRIORITY_MEDIUM_PRIORITY 0x02    // Medium Priority
#define MESSAGE_PRIORITY_HIGH_PRIORITY 0x03      // High Priority
#define MESSAGE_PRIORITY_CRITICAL_PRIORITY 0x04  // Critical Priority

// ---- Types -------------------------------------------------------------------

// Sent every second for which at least one MDF message is being generated.
typedef struct _SecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} SecondsMessage;

// Disseminated at the start of each trading day for all active securities, including halted securities.
typedef struct _OrderBookDirectoryMessage {
  UINT32BE timestamp_nanoseconds;                   // bytes 0 to 3
  UINT32BE order_book_id;                           // bytes 4 to 7
  UINT8 partition_id;                               // byte 8
  UINT8 symbol[32];                                 // bytes 9 to 40
  UINT8 long_name[32];                              // bytes 41 to 72
  UINT8 isin[12];                                   // bytes 73 to 84
  UINT8 asset_name[32];                             // bytes 85 to 116
  UINT8 financial_product;                          // byte 117
  UINT8 trading_currency[3];                        // bytes 118 to 120
  UINT16BE number_of_decimals_in_price;             // bytes 121 to 122
  UINT16BE number_of_decimals_in_nominal_value;     // bytes 123 to 124
  UINT32BE round_lot_size;                          // bytes 125 to 128
  UINT64BE nominal_value;                           // bytes 129 to 136
  UINT8 number_of_legs;                             // byte 137
  UINT32BE commodity_code;                          // bytes 138 to 141
  UINT64BE strike_price;                            // bytes 142 to 149, signed, read here as unsigned
  UINT32BE expiration_date;                         // bytes 150 to 153
  UINT16BE number_of_decimals_in_strike_price;      // bytes 154 to 155
  UINT8 option_type;                                // byte 156
  UINT32BE market_id;                               // bytes 157 to 160
  UINT32BE exchange_id;                             // bytes 161 to 164
  UINT16BE number_of_decimals_in;                   // bytes 165 to 166
  UINT8 sector_code[4];                             // bytes 167 to 170
  UINT64BE number_of_tradable_equities;             // bytes 171 to 178
  UINT64BE number_of_outstanding_equities;          // bytes 179 to 186
  UINT32BE last_traded_date;                        // bytes 187 to 190
  UINT64BE contract_multiplier;                     // bytes 191 to 198
  UINT64BE multiplier;                              // bytes 199 to 206
  UINT16BE decimals_in_multiplier;                  // bytes 207 to 208
  UINT64BE min_order_quantity;                      // bytes 209 to 216
  UINT64BE max_order_quantity;                      // bytes 217 to 224
  UINT32BE number_of_settlement_days;               // bytes 225 to 228
  UINT8 primary;                                    // byte 229
  UINT8 test_order_book;                            // byte 230
  UINT8 alias_name[32];                             // bytes 231 to 262
  UINT32BE settlement_date;                         // bytes 263 to 266
  UINT8 tradable;                                   // byte 267
  UINT8 externally_price_sourced;                   // byte 268
  UINT8 deliverable;                                // byte 269
  UINT8 price_unit;                                 // byte 270
  UINT8 issuer[32];                                 // bytes 271 to 302
  UINT8 foreign_ownership_restriction;              // byte 303
  UINT8 last_trading_time[6];                       // bytes 304 to 309
  UINT8 option_style;                               // byte 310
  UINT64BE minimum_value_for_initial_trade_report;  // bytes 311 to 318
  UINT8 cfi_code[6];                                // bytes 319 to 324
  UINT8 upper_level_series[32];                     // bytes 325 to 356
  UINT32BE upper_series_level_order_book_id;        // bytes 357 to 360
  UINT8 instrument_type[4];                         // bytes 361 to 364
  UINT8 status;                                     // byte 365
} OrderBookDirectoryMessage;

// Disseminated at the start of each trading day for all active Exchanges in the system.
typedef struct _ExchangeDirectoryMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE exchange_id;            // bytes 4 to 7
  UINT8 exchange_name[32];         // bytes 8 to 39
} ExchangeDirectoryMessage;

// Disseminated at the start of each trading day for all active Markets in the system.
typedef struct _MarketDirectoryMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE market_id;              // bytes 4 to 7
  UINT8 market_name[32];           // bytes 8 to 39
  UINT8 market_type;               // byte 40
  UINT8 index_market;              // byte 41
} MarketDirectoryMessage;

// Provides a mapping between a combination order book and one of the combination leg order books.
typedef struct _CombinationOrderBookLegDirectoryMessage {
  UINT32BE timestamp_nanoseconds;      // bytes 0 to 3
  UINT32BE combination_order_book_id;  // bytes 4 to 7
  UINT32BE leg_order_book_id;          // bytes 8 to 11
  UINT8 leg_side;                      // byte 12
  UINT32BE leg_ratio;                  // bytes 13 to 16
} CombinationOrderBookLegDirectoryMessage;

// Contains information on a tick size for a price range.
typedef struct _TickSizeTableEntryMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE order_book_id;          // bytes 4 to 7
  UINT64BE tick_size;              // bytes 8 to 15
  UINT64BE price_from;             // bytes 16 to 23, signed, read here as unsigned
  UINT64BE price_to;               // bytes 24 to 31, signed, read here as unsigned
} TickSizeTableEntryMessage;

// Displays the entries of assigned Corporate Action Codes to Order Books.
typedef struct _CorporateActionEntryMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE corporate_action_id;    // bytes 4 to 7
  UINT32BE order_book_id;          // bytes 8 to 11
  UINT8 corporate_action_code[4];  // bytes 12 to 15
  UINT8 corporate_action_type;     // byte 16
  UINT32BE start_date;             // bytes 17 to 20
  UINT32BE end_date;               // bytes 21 to 24
  UINT32BE record_date;            // bytes 25 to 28
  UINT8 corporate_action_status;   // byte 29
  UINT8 action;                    // byte 30
} CorporateActionEntryMessage;

// Provides additional information that are valid only for Fixed Income instruments; sent for all instruments.
typedef struct _OrderBookDirectoryExtensionMessage {
  UINT32BE timestamp_nanoseconds;          // bytes 0 to 3
  UINT32BE order_book_id;                  // bytes 4 to 7
  UINT32BE accrued_interest_rounding;      // bytes 8 to 11
  UINT8 accrued_interest_updown;           // byte 12
  UINT8 calculation_convention;            // byte 13
  UINT32BE clean_price_rounding;           // bytes 14 to 17
  UINT8 clean_price_updown;                // byte 18
  UINT32BE coupon_frequency;               // bytes 19 to 22
  UINT64BE coupon_interest;                // bytes 23 to 30
  UINT32BE coupon_from_date;               // bytes 31 to 34
  UINT32BE issue_date;                     // bytes 35 to 38
  UINT32BE maturity_date;                  // bytes 39 to 42
  UINT8 day_calculation_rule;              // byte 43
  UINT8 day_count_convention;              // byte 44
  UINT32BE ex_coupon_period;               // bytes 45 to 48
  UINT64BE dividend;                       // bytes 49 to 56
  UINT8 fixed_income_type;                 // byte 57
  UINT32BE rate_determination_days;        // bytes 58 to 61
  UINT32BE yield_convention;               // bytes 62 to 65
  UINT32BE end_of_month_count_convention;  // bytes 66 to 69
  UINT32BE first_settlement_date;          // bytes 70 to 73
  UINT32BE coupon_div_date;                // bytes 74 to 77
  UINT32BE date_books_close;               // bytes 78 to 81
  UINT32BE effective_expiration_date;      // bytes 82 to 85
  UINT32BE proceed_date;                   // bytes 86 to 89
  UINT8 set_end_consideration;             // byte 90
  UINT8 set_start_consideration;           // byte 91
} OrderBookDirectoryExtensionMessage;

// Used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT8 event_code;                // byte 4
} SystemEventMessage;

// Relays information on state changes.
typedef struct _OrderBookStateMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE order_book_id;          // bytes 4 to 7
  UINT8 state_name[20];            // bytes 8 to 27
  UINT8 display_name[20];          // bytes 28 to 47
} OrderBookStateMessage;

// Relays information on the current business date.
typedef struct _BusinessDateMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE business_date;          // bytes 4 to 7
} BusinessDateMessage;

// Received when the State of an Instrument is changed at any of the applicable levels.
typedef struct _InstrumentStatusMessage {
  UINT32BE timestamp_nanoseconds;                // bytes 0 to 3
  UINT8 trading_state_name[20];                  // bytes 4 to 23
  UINT8 instrument_state_level;                  // byte 24
  UINT8 name_of_the_instrument_state_level[32];  // bytes 25 to 56
  UINT32BE start_date;                           // bytes 57 to 60
  UINT32BE start_time;                           // bytes 61 to 64
} InstrumentStatusMessage;

// Used when auctions occur; provides the changes in equilibrium price.
typedef struct _EquilibriumPriceMessage {
  UINT32BE timestamp_nanoseconds;                        // bytes 0 to 3
  UINT32BE order_book_id;                                // bytes 4 to 7
  UINT64BE available_bid_quantity_at_equilibrium_price;  // bytes 8 to 15
  UINT64BE available_ask_quantity_at_equilibrium_price;  // bytes 16 to 23
  UINT64BE equilibrium_price;                            // bytes 24 to 31, signed, read here as unsigned
  UINT64BE best_bid_price;                               // bytes 32 to 39, signed, read here as unsigned
  UINT64BE best_ask_price;                               // bytes 40 to 47, signed, read here as unsigned
  UINT64BE best_bid_quantity;                            // bytes 48 to 55
  UINT64BE best_ask_quantity;                            // bytes 56 to 63
  UINT64BE equilibrium_quantity;                         // bytes 64 to 71
} EquilibriumPriceMessage;

// Array of Level items
typedef struct _ArrayOfLevelItems {
  UINT8 level_update_action;  // byte 0
  UINT8 side;                 // byte 1
  UINT8 level;                // byte 2
  UINT64BE price;             // bytes 3 to 10, signed, read here as unsigned
  UINT64BE quantity;          // bytes 11 to 18
  UINT8 number_of_deletes;    // byte 19
  UINT64BE number_of_orders;  // bytes 20 to 27
} ArrayOfLevelItems;

// Publishes order book Prices per Price level.
typedef struct _MarketByPriceMessage {
  UINT32BE timestamp_nanoseconds;                                                              // bytes 0 to 3
  UINT32BE order_book_id;                                                                      // bytes 4 to 7
  UINT8 maximum_level;                                                                         // byte 8
  UINT8 number_of_level_items;                                                                 // byte 9
  ArrayOfLevelItems array_of_level_items[:byte-size (((UINT32) number_of_level_items) * 28)];
} MarketByPriceMessage;

// Publishes Trade Statistics per Orderbook ID for the current Trading Day.
typedef struct _TradeStatisticsMessage {
  UINT32BE timestamp_nanoseconds;              // bytes 0 to 3
  UINT32BE order_book_id;                      // bytes 4 to 7
  UINT64BE open_price;                         // bytes 8 to 15, signed, read here as unsigned
  UINT64BE high_price;                         // bytes 16 to 23, signed, read here as unsigned
  UINT64BE low_price;                          // bytes 24 to 31, signed, read here as unsigned
  UINT64BE last_price;                         // bytes 32 to 39, signed, read here as unsigned
  UINT64BE last_auction_price;                 // bytes 40 to 47, signed, read here as unsigned
  UINT64BE last_quantity;                      // bytes 48 to 55
  UINT64BE turnover_quantity;                  // bytes 56 to 63
  UINT64BE reported_trades_turnover_quantity;  // bytes 64 to 71
  UINT64BE turnover_value;                     // bytes 72 to 79
  UINT64BE number_of_trades;                   // bytes 80 to 87
  UINT8 trend_indicator;                       // byte 88
} TradeStatisticsMessage;

// Publishes Reference Prices per Price Types.
typedef struct _ReferencePriceMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE order_book_id;          // bytes 4 to 7
  UINT8 price_type;                // byte 8
  UINT64BE price;                  // bytes 9 to 16, signed, read here as unsigned
  UINT64BE timestamp;              // bytes 17 to 24
  UINT32BE price_date;             // bytes 25 to 28
} ReferencePriceMessage;

// Used for sending index price information.
typedef struct _IndexMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE order_book_id;          // bytes 4 to 7
  UINT64BE last_price;             // bytes 8 to 15, signed, read here as unsigned
  UINT64BE timestamp;              // bytes 16 to 23
  UINT32BE change_previous;        // bytes 24 to 27
  UINT32BE change_yesterday;       // bytes 28 to 31
  UINT8 trend_indicator;           // byte 32
  UINT32BE point_of_movement;      // bytes 33 to 36
} IndexMessage;

// Publishes Open Interest.
typedef struct _OpenInterestMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE order_book_id;          // bytes 4 to 7
  UINT64BE open_interest;          // bytes 8 to 15
  UINT64BE transact_time;          // bytes 16 to 23
} OpenInterestMessage;

// Publishes Trade Ticker.
typedef struct _TradeTickerMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE order_book_id;          // bytes 4 to 7
  UINT64BE deal_id;                // bytes 8 to 15
  UINT8 deal_source;               // byte 16
  UINT64BE price;                  // bytes 17 to 24, signed, read here as unsigned
  UINT64BE quantity;               // bytes 25 to 32
  UINT64BE deal_time;              // bytes 33 to 40
  UINT8 action;                    // byte 41
  UINT8 aggressor;                 // byte 42
  UINT16BE trade_report_type;      // bytes 43 to 44
  UINT8 printable;                 // byte 45
  UINT32BE as_of_date;             // bytes 46 to 49
  UINT8 boq_list[6];               // bytes 50 to 55
  UINT8 participant_id_buy[5];     // bytes 56 to 60
  UINT64BE order_id_buy;           // bytes 61 to 68
  UINT8 participant_id_sell[5];    // bytes 69 to 73
  UINT64BE order_id_sell;          // bytes 74 to 81
  UINT32BE trade_slip_number;      // bytes 82 to 85
  UINT32BE exchange_order_type;    // bytes 86 to 89
  UINT8 trade_condition;           // byte 90
} TradeTickerMessage;

// Provides an update to the price limits or circuit breaker limits for an order book.
typedef struct _PriceLimitsMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE order_book_id;          // bytes 4 to 7
  UINT64BE upper_limit;            // bytes 8 to 15, signed, read here as unsigned
  UINT64BE lower_limit;            // bytes 16 to 23, signed, read here as unsigned
  UINT8 type_;                     // byte 24
  UINT8 category;                  // byte 25
  UINT64BE reference_price;        // bytes 26 to 33, signed, read here as unsigned
} PriceLimitsMessage;

// Array of Message items
typedef struct _ArrayOfMessageItems {
  UINT8 message_item[80];  // bytes 0 to 79
} ArrayOfMessageItems;

// Publishes Market Announcements for Order Books, Markets, Underlyings or Exchanges.
typedef struct _MarketAnnouncementMessage {
  UINT32BE timestamp_nanoseconds;                                           // bytes 0 to 3
  UINT32BE order_book_id;                                                   // bytes 4 to 7
  UINT32BE exchange_id;                                                     // bytes 8 to 11
  UINT32BE market_id;                                                       // bytes 12 to 15
  UINT8 message_information_type;                                           // byte 16
  UINT8 message_source[80];                                                 // bytes 17 to 96
  UINT8 message_priority;                                                   // byte 97
  UINT8 header[80];                                                         // bytes 98 to 177
  UINT8 items_url;                                                          // byte 178
  UINT8 document_url[255];                                                  // bytes 179 to 433
  UINT8 number_of_message_items;                                            // byte 434
  UINT8 number_of_messages_items;                                           // byte 435
  UINT8 array_of_message_items[(((UINT32) number_of_message_items) * 80)];
  UINT32BE commodity_code;
} MarketAnnouncementMessage;

// Returns the current MDF sequence number to be used when connecting to the MDF feed (Glimpse).
typedef struct _EndOfSnapshotMessage {
  UINT8 snapshot_sequence_number[20];  // bytes 0 to 19
} EndOfSnapshotMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: SecondsMessage seconds_message;
    case 0x52: OrderBookDirectoryMessage order_book_directory_message;
    case 0x65: ExchangeDirectoryMessage exchange_directory_message;
    case 0x6D: MarketDirectoryMessage market_directory_message;
    case 0x4D: CombinationOrderBookLegDirectoryMessage combination_order_book_leg_directory_message;
    case 0x4C: TickSizeTableEntryMessage tick_size_table_entry_message;
    case 0x43: CorporateActionEntryMessage corporate_action_entry_message;
    case 0x66: OrderBookDirectoryExtensionMessage order_book_directory_extension_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x4F: OrderBookStateMessage order_book_state_message;
    case 0x42: BusinessDateMessage business_date_message;
    case 0x67: unit end_of_recovery_message;
    case 0x74: InstrumentStatusMessage instrument_status_message;
    case 0x5A: EquilibriumPriceMessage equilibrium_price_message;
    case 0x62: MarketByPriceMessage market_by_price_message;
    case 0x49: TradeStatisticsMessage trade_statistics_message;
    case 0x51: ReferencePriceMessage reference_price_message;
    case 0x4A: IndexMessage index_message;
    case 0x68: OpenInterestMessage open_interest_message;
    case 0x69: TradeTickerMessage trade_ticker_message;
    case 0x6B: PriceLimitsMessage price_limits_message;
    case 0x4E: MarketAnnouncementMessage market_announcement_message;
    case 0x47: EndOfSnapshotMessage end_of_snapshot_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

