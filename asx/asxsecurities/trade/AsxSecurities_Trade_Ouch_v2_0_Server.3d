// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AsxSecurities_Trade_Ouch_v2_0_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_ORDER_ACCEPTED_MESSAGE 0x41   // Order Accepted Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_REJECTED_MESSAGE 0x4A   // Order Rejected Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_REPLACED_MESSAGE 0x55   // Order Replaced Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_CANCELLED_MESSAGE 0x43  // Order Cancelled Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45   // Order Executed Message

// Side: one byte code
#define SIDE_BUY_ORDER 0x42                   // Buy Order
#define SIDE_SELL_ORDER 0x53                  // Sell Order
#define SIDE_SHORT_SELL_ORDER 0x54            // Short Sell Order
#define SIDE_BUY_ORDER_IN_A_COMBINATION 0x43  // Buy Order In A Combination

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY 0x00            // Day
#define TIME_IN_FORCE_FILL_AND_KILL 0x03  // Fill And Kill
#define TIME_IN_FORCE_FILL_OR_KILL 0x04   // Fill Or Kill

// Order State: one byte code
#define ORDER_STATE_ON_BOOK 0x01              // On Book
#define ORDER_STATE_NOT_ON_BOOK 0x02          // Not On Book
#define ORDER_STATE_OUCH_OWNERSHIP_LOST 0x63  // Ouch Ownership Lost

// Capacity Of Participant: one byte code
#define CAPACITY_OF_PARTICIPANT_AGENCY 0x41                      // Agency
#define CAPACITY_OF_PARTICIPANT_PRINCIPAL 0x50                   // Principal
#define CAPACITY_OF_PARTICIPANT_MIXED_AGENCY_AND_PRINCIPAL 0x4D  // Mixed Agency And Principal

// Directed Wholesale: one byte code
#define DIRECTED_WHOLESALE_TRUE 0x59           // True
#define DIRECTED_WHOLESALE_FALSE_DEFAULT 0x4E  // False Default

// Ouch Order Type: one byte code
#define OUCH_ORDER_TYPE_LIMIT_ORDER 0x59                                    // Limit Order
#define OUCH_ORDER_TYPE_CENTRE_POINT_ORDER_MID_POINT_ONLY 0x4E              // Centre Point Order Mid Point Only
#define OUCH_ORDER_TYPE_CENTRE_POINT_ORDER_DARK_LIMIT_ORDER 0x44            // Centre Point Order Dark Limit Order
#define OUCH_ORDER_TYPE_SWEEP_ORDER 0x53                                    // Sweep Order
#define OUCH_ORDER_TYPE_DUAL_POSTED_SWEEP_ORDER 0x50                        // Dual Posted Sweep Order
#define OUCH_ORDER_TYPE_CENTRE_POINT_BLOCK_ORDER_WITH_SINGLE_FILL_MAQ 0x42  // Centre Point Block Order With Single Fill Maq
#define OUCH_ORDER_TYPE_CENTRE_POINT_ORDER_WITH_SINGLE_FILL_MAQ 0x46        // Centre Point Order With Single Fill Maq
#define OUCH_ORDER_TYPE_LIMIT_SWEEP_ORDER_WITH_SINGLE_FILL_MAQ 0x54         // Limit Sweep Order With Single Fill Maq
#define OUCH_ORDER_TYPE_ANY_PRICE_BLOCK_ORDER 0x43                          // Any Price Block Order
#define OUCH_ORDER_TYPE_ANY_PRICE_BLOCK_ORDER_WITH_SINGLE_FILL_MAQ 0x45     // Any Price Block Order With Single Fill Maq

// Reason: one byte code
#define REASON_CANCELLED_BY_USER 0x01                                       // Cancelled By User
#define REASON_ORDER_INACTIVATED_DUE_TO_CONNECTION_LOSS 0x04                // Order Inactivated Due To Connection Loss
#define REASON_FILL_AND_KILL_ORDER_THAT_WAS_DELETED_IN_AN_AUCTION 0x09      // Fill And Kill Order That Was Deleted In An Auction
#define REASON_ORDER_DELETED_BY_ASX_ON_BEHALF_OF_THE_CUSTOMER 0x0A          // Order Deleted By Asx On Behalf Of The Customer
#define REASON_DELETED_BY_SYSTEM_DUE_TO_INSTRUMENT_SESSION_CHANGE 0x14      // Deleted By System Due To Instrument Session Change
#define REASON_INACTIVATED_BY_SYSTEM_DUE_TO_INSTRUMENT_SESSION_CHANGE 0x15  // Inactivated By System Due To Instrument Session Change
#define REASON_INACTIVATED_DAY_ORDER 0x18                                   // Inactivated Day Order

// Deal Source: 2 byte code
#define DEAL_SOURCE_CONTINUOUS_AUTO_MATCH 0x0001                            // Continuous Auto Match
#define DEAL_SOURCE_AUCTION_AUTO_MATCH 0x0014                               // Auction Auto Match
#define DEAL_SOURCE_TAILOR_MADE_COMBINATION_MATCH 0x0024                    // Tailor Made Combination Match
#define DEAL_SOURCE_COMBINATION_ORDER_MATCHED_AGAINST_OUTRIGHT_LEGS 0x002B  // Combination Order Matched Against Outright Legs
#define DEAL_SOURCE_BOOKED_U_C_P_TRANSACTION 0x002C                         // Booked UCP Transaction
#define DEAL_SOURCE_BOOKED_U_C_P_AUCTION_TRANSACTION 0x002D                 // Booked UCP Auction Transaction
#define DEAL_SOURCE_CENTRE_POINT_PREFERENCE_MATCHED_TRADE 0x002E            // Centre Point Preference Matched Trade
#define DEAL_SOURCE_CENTRE_POINT_TRADE 0x002F                               // Centre Point Trade
#define DEAL_SOURCE_CENTRE_POINT_BOOKED_U_C_P 0x0030                        // Centre Point Booked UCP
#define DEAL_SOURCE_RESERVED_49 0x0031                                      // Reserved 49
#define DEAL_SOURCE_BLOCK_TRADE 0x0032                                      // Block Trade
#define DEAL_SOURCE_PREFERENCE_BLOCK_TRADE 0x0033                           // Preference Block Trade
#define DEAL_SOURCE_RESERVED_52 0x0034                                      // Reserved 52

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// The Order Accepted message acknowledges the receipt and acceptance of a valid Enter Order message. The data fields from the Enter Order message are echoed back in the Order Accepted message, but some of the accepted values may differ from the entered values for some fields, depending on the state of the order. If the order for example traded immediately at entry, the Order Accepted message will show the state of the order after the trade.
typedef struct _OrderAcceptedMessage {
  UINT64BE timestamp_nanoseconds;        // bytes 0 to 7
  UINT8 order_token[14];                 // bytes 8 to 21
  UINT32BE order_book_id;                // bytes 22 to 25
  UINT8 side;                            // byte 26
  UINT64BE order_id;                     // bytes 27 to 34
  UINT64BE quantity;                     // bytes 35 to 42
  UINT32BE price;                        // bytes 43 to 46, signed, read here as unsigned
  UINT8 time_in_force;                   // byte 47
  UINT8 open_close;                      // byte 48
  UINT8 client_account[10];              // bytes 49 to 58
  UINT8 order_state;                     // byte 59
  UINT8 customer_info[15];               // bytes 60 to 74
  UINT8 exchange_info[32];               // bytes 75 to 106
  UINT8 clearing_participant;            // byte 107
  UINT32BE crossing_key;                 // bytes 108 to 111
  UINT8 capacity_of_participant;         // byte 112
  UINT8 directed_wholesale;              // byte 113
  UINT8 execution_venue[4];              // bytes 114 to 117
  UINT8 intermediary_id[10];             // bytes 118 to 127
  UINT8 order_origin[20];                // bytes 128 to 147
  UINT8 filler[8];                       // bytes 148 to 155
  UINT8 ouch_order_type;                 // byte 156
  UINT64BE short_sell_quantity;          // bytes 157 to 164
  UINT64BE minimum_acceptable_quantity;  // bytes 165 to 172
} OrderAcceptedMessage;

// This message is returned when an Enter Order, Replace Order, Cancel Order or Cancel By Order ID message is rejected
typedef struct _OrderRejectedMessage {
  UINT64BE timestamp_nanoseconds;  // bytes 0 to 7
  UINT8 order_token[14];           // bytes 8 to 21
  UINT32BE reject_code;            // bytes 22 to 25
} OrderRejectedMessage;

// The Order Replaced message acknowledges the receipt and acceptance of a valid Replace Order message.
typedef struct _OrderReplacedMessage {
  UINT64BE timestamp_nanoseconds;        // bytes 0 to 7
  UINT8 replacement_order_token[14];     // bytes 8 to 21
  UINT8 previous_order_token[14];        // bytes 22 to 35
  UINT32BE order_book_id;                // bytes 36 to 39
  UINT8 side;                            // byte 40
  UINT64BE order_id;                     // bytes 41 to 48
  UINT64BE quantity;                     // bytes 49 to 56
  UINT32BE price;                        // bytes 57 to 60, signed, read here as unsigned
  UINT8 time_in_force;                   // byte 61
  UINT8 open_close;                      // byte 62
  UINT8 client_account[10];              // bytes 63 to 72
  UINT8 order_state;                     // byte 73
  UINT8 customer_info[15];               // bytes 74 to 88
  UINT8 exchange_info[32];               // bytes 89 to 120
  UINT8 clearing_participant;            // byte 121
  UINT32BE crossing_key;                 // bytes 122 to 125
  UINT8 capacity_of_participant;         // byte 126
  UINT8 directed_wholesale;              // byte 127
  UINT8 execution_venue[4];              // bytes 128 to 131
  UINT8 intermediary_id[10];             // bytes 132 to 141
  UINT8 order_origin[20];                // bytes 142 to 161
  UINT8 filler[8];                       // bytes 162 to 169
  UINT8 ouch_order_type;                 // byte 170
  UINT64BE short_sell_quantity;          // bytes 171 to 178
  UINT64BE minimum_acceptable_quantity;  // bytes 179 to 186
} OrderReplacedMessage;

// The Order Cancelled message informs the ASX Trade OUCH user that an order has been cancelled. This could be to acknowledge a Cancel Order or Cancel By Order Id message, or it could be as a result of system cancellation of an order.
typedef struct _OrderCancelledMessage {
  UINT64BE timestamp_nanoseconds;  // bytes 0 to 7
  UINT8 order_token[14];           // bytes 8 to 21
  UINT32BE order_book_id;          // bytes 22 to 25
  UINT8 side;                      // byte 26
  UINT64BE order_id;               // bytes 27 to 34
  UINT8 reason;                    // byte 35
} OrderCancelledMessage;

// The Order Executed message is returned when an order partially or fully trades.
typedef struct _OrderExecutedMessage {
  UINT64BE timestamp_nanoseconds;            // bytes 0 to 7
  UINT8 order_token[14];                     // bytes 8 to 21
  UINT32BE order_book_id;                    // bytes 22 to 25
  UINT64BE traded_quantity;                  // bytes 26 to 33
  UINT32BE trade_price;                      // bytes 34 to 37, signed, read here as unsigned
  UINT8 match_id[12];                        // bytes 38 to 49
  UINT16BE deal_source;                      // bytes 50 to 51
  UINT8BE reserved : 5;                      // byte 52
  UINT8BE crossing_dealing_capacity : 2;     // byte 52
  UINT8BE passive_aggressive_indicator : 1;  // byte 52
} OrderExecutedMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: OrderAcceptedMessage order_accepted_message;
    case 0x4A: OrderRejectedMessage order_rejected_message;
    case 0x55: OrderReplacedMessage order_replaced_message;
    case 0x43: OrderCancelledMessage order_cancelled_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat;
    case 0x5A: unit end_of_session;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

