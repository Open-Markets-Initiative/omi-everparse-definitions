// ---- Server Packet Header: 3 bytes -------------------------------------------

// Packet header of a packet sent by the server
entrypoint typedef struct _ServerPacketHeader {
  UINT16BE packet_length;    // bytes 0 to 1
  UINT8 server_packet_type;  // byte 2
} ServerPacketHeader;

// ---- Login Accepted Packet: 30 bytes -----------------------------------------

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
entrypoint typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// ---- Login Rejected Packet: 1 byte -------------------------------------------

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
entrypoint typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// ---- Order Accepted Message: 173 bytes ---------------------------------------

// The Order Accepted message acknowledges the receipt and acceptance of a valid Enter Order message. The data fields from the Enter Order message are echoed back in the Order Accepted message, but some of the accepted values may differ from the entered values for some fields, depending on the state of the order. If the order for example traded immediately at entry, the Order Accepted message will show the state of the order after the trade.
entrypoint typedef struct _OrderAcceptedMessage {
  UINT64BE timestamp_nanoseconds;        // bytes 0 to 7
  UINT8 order_token[14];                 // bytes 8 to 21
  UINT32BE order_book_id;                // bytes 22 to 25
  UINT8 side;                            // byte 26
  UINT64BE order_id;                     // bytes 27 to 34
  UINT64BE quantity;                     // bytes 35 to 42
  UINT32BE price;                        // bytes 43 to 46, signed, read here as unsigned
  UINT8 time_in_force;                   // byte 47
  UINT8 open_close;                      // byte 48
  UINT8 client_account[10];              // bytes 49 to 58
  UINT8 order_state;                     // byte 59
  UINT8 customer_info[15];               // bytes 60 to 74
  UINT8 exchange_info[32];               // bytes 75 to 106
  UINT8 clearing_participant;            // byte 107
  UINT32BE crossing_key;                 // bytes 108 to 111
  UINT8 capacity_of_participant;         // byte 112
  UINT8 directed_wholesale;              // byte 113
  UINT8 execution_venue[4];              // bytes 114 to 117
  UINT8 intermediary_id[10];             // bytes 118 to 127
  UINT8 order_origin[20];                // bytes 128 to 147
  UINT8 filler[8];                       // bytes 148 to 155
  UINT8 ouch_order_type;                 // byte 156
  UINT64BE short_sell_quantity;          // bytes 157 to 164
  UINT64BE minimum_acceptable_quantity;  // bytes 165 to 172
} OrderAcceptedMessage;

// ---- Order Rejected Message: 26 bytes ----------------------------------------

// This message is returned when an Enter Order, Replace Order, Cancel Order or Cancel By Order ID message is rejected
entrypoint typedef struct _OrderRejectedMessage {
  UINT64BE timestamp_nanoseconds;  // bytes 0 to 7
  UINT8 order_token[14];           // bytes 8 to 21
  UINT32BE reject_code;            // bytes 22 to 25
} OrderRejectedMessage;

// ---- Order Replaced Message: 187 bytes ---------------------------------------

// The Order Replaced message acknowledges the receipt and acceptance of a valid Replace Order message.
entrypoint typedef struct _OrderReplacedMessage {
  UINT64BE timestamp_nanoseconds;        // bytes 0 to 7
  UINT8 replacement_order_token[14];     // bytes 8 to 21
  UINT8 previous_order_token[14];        // bytes 22 to 35
  UINT32BE order_book_id;                // bytes 36 to 39
  UINT8 side;                            // byte 40
  UINT64BE order_id;                     // bytes 41 to 48
  UINT64BE quantity;                     // bytes 49 to 56
  UINT32BE price;                        // bytes 57 to 60, signed, read here as unsigned
  UINT8 time_in_force;                   // byte 61
  UINT8 open_close;                      // byte 62
  UINT8 client_account[10];              // bytes 63 to 72
  UINT8 order_state;                     // byte 73
  UINT8 customer_info[15];               // bytes 74 to 88
  UINT8 exchange_info[32];               // bytes 89 to 120
  UINT8 clearing_participant;            // byte 121
  UINT32BE crossing_key;                 // bytes 122 to 125
  UINT8 capacity_of_participant;         // byte 126
  UINT8 directed_wholesale;              // byte 127
  UINT8 execution_venue[4];              // bytes 128 to 131
  UINT8 intermediary_id[10];             // bytes 132 to 141
  UINT8 order_origin[20];                // bytes 142 to 161
  UINT8 filler[8];                       // bytes 162 to 169
  UINT8 ouch_order_type;                 // byte 170
  UINT64BE short_sell_quantity;          // bytes 171 to 178
  UINT64BE minimum_acceptable_quantity;  // bytes 179 to 186
} OrderReplacedMessage;

// ---- Order Cancelled Message: 36 bytes ---------------------------------------

// The Order Cancelled message informs the ASX Trade OUCH user that an order has been cancelled. This could be to acknowledge a Cancel Order or Cancel By Order Id message, or it could be as a result of system cancellation of an order.
entrypoint typedef struct _OrderCancelledMessage {
  UINT64BE timestamp_nanoseconds;  // bytes 0 to 7
  UINT8 order_token[14];           // bytes 8 to 21
  UINT32BE order_book_id;          // bytes 22 to 25
  UINT8 side;                      // byte 26
  UINT64BE order_id;               // bytes 27 to 34
  UINT8 reason;                    // byte 35
} OrderCancelledMessage;

