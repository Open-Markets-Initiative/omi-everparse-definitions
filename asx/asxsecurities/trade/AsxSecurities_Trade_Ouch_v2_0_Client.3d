  UINT64BE quantity;                     // bytes 28 to 35
  UINT32BE price;                        // bytes 36 to 39, signed, read here as unsigned
  UINT8 open_close;                      // byte 40
  UINT8 client_account[10];              // bytes 41 to 50
  UINT8 customer_info[15];               // bytes 51 to 65
  UINT8 exchange_info[32];               // bytes 66 to 97
