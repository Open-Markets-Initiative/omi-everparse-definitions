  UINT8 side;                            // byte 18
  UINT64BE quantity;                     // bytes 19 to 26
  UINT32BE price;                        // bytes 27 to 30, signed, read here as unsigned
  UINT8 time_in_force;                   // byte 31
  UINT8 open_close;                      // byte 32
  UINT8 client_account[10];              // bytes 33 to 42
  UINT8 customer_info[15];               // bytes 43 to 57
  UINT8 exchange_info[32];               // bytes 58 to 89
  UINT8 clearing_participant;            // byte 90
  UINT32BE crossing_key;                 // bytes 91 to 94
  UINT8 capacity_of_participant;         // byte 95
  UINT8 directed_wholesale;              // byte 96
  UINT8 execution_venue[4];              // bytes 97 to 100
  UINT8 intermediary_id[10];             // bytes 101 to 110
  UINT8 order_origin[20];                // bytes 111 to 130
  UINT8 filler[8];                       // bytes 131 to 138
  UINT8 ouch_order_type;                 // byte 139
  UINT64BE short_sell_quantity;          // bytes 140 to 147
  UINT64BE minimum_acceptable_quantity;  // bytes 148 to 155
} EnterOrderMessage;

// ---- Replace Order Message: 158 bytes ----------------------------------------

// The Replace Order message is used to amend an existing order that was entered with ASX Trade OUCH. The response to a successful Replace Order message is an Order Replaced message. If the amendment is rejected, the Order Rejected message will be returned.
entrypoint typedef struct _ReplaceOrderMessage {
  UINT8 existing_order_token[14];        // bytes 0 to 13
