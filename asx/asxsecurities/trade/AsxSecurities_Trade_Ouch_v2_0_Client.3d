// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AsxSecurities_Trade_Ouch_v2_0_Client.3d

// ---- Values ------------------------------------------------------------------

// Client Packet Type: one byte code
#define CLIENT_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define CLIENT_PACKET_TYPE_LOGIN_REQUEST_PACKET 0x4C     // Login Request Packet
#define CLIENT_PACKET_TYPE_UNSEQUENCED_DATA_PACKET 0x55  // Unsequenced Data Packet
#define CLIENT_PACKET_TYPE_CLIENT_HEARTBEAT_PACKET 0x52  // Client Heartbeat Packet
#define CLIENT_PACKET_TYPE_LOGOUT_REQUEST_PACKET 0x4F    // Logout Request Packet

// Unsequenced Message Type: one byte code
#define UNSEQUENCED_MESSAGE_TYPE_ENTER_ORDER_MESSAGE 0x4F         // Enter Order Message
#define UNSEQUENCED_MESSAGE_TYPE_REPLACE_ORDER_MESSAGE 0x55       // Replace Order Message
#define UNSEQUENCED_MESSAGE_TYPE_CANCEL_ORDER_MESSAGE 0x58        // Cancel Order Message
#define UNSEQUENCED_MESSAGE_TYPE_CANCEL_BY_ORDER_ID_MESSAGE 0x59  // Cancel By Order Id Message

// Side: one byte code
#define SIDE_BUY_ORDER 0x42                   // Buy Order
#define SIDE_SELL_ORDER 0x53                  // Sell Order
#define SIDE_SHORT_SELL_ORDER 0x54            // Short Sell Order
#define SIDE_BUY_ORDER_IN_A_COMBINATION 0x43  // Buy Order In A Combination

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY 0x00            // Day
#define TIME_IN_FORCE_FILL_AND_KILL 0x03  // Fill And Kill
#define TIME_IN_FORCE_FILL_OR_KILL 0x04   // Fill Or Kill

// Capacity Of Participant: one byte code
#define CAPACITY_OF_PARTICIPANT_AGENCY 0x41                      // Agency
#define CAPACITY_OF_PARTICIPANT_PRINCIPAL 0x50                   // Principal
#define CAPACITY_OF_PARTICIPANT_MIXED_AGENCY_AND_PRINCIPAL 0x4D  // Mixed Agency And Principal

// Directed Wholesale: one byte code
#define DIRECTED_WHOLESALE_TRUE 0x59           // True
#define DIRECTED_WHOLESALE_FALSE_DEFAULT 0x4E  // False Default

// Ouch Order Type: one byte code
#define OUCH_ORDER_TYPE_LIMIT_ORDER 0x59                                    // Limit Order
#define OUCH_ORDER_TYPE_CENTRE_POINT_ORDER_MID_POINT_ONLY 0x4E              // Centre Point Order Mid Point Only
#define OUCH_ORDER_TYPE_CENTRE_POINT_ORDER_DARK_LIMIT_ORDER 0x44            // Centre Point Order Dark Limit Order
#define OUCH_ORDER_TYPE_SWEEP_ORDER 0x53                                    // Sweep Order
#define OUCH_ORDER_TYPE_DUAL_POSTED_SWEEP_ORDER 0x50                        // Dual Posted Sweep Order
#define OUCH_ORDER_TYPE_CENTRE_POINT_BLOCK_ORDER_WITH_SINGLE_FILL_MAQ 0x42  // Centre Point Block Order With Single Fill Maq
#define OUCH_ORDER_TYPE_CENTRE_POINT_ORDER_WITH_SINGLE_FILL_MAQ 0x46        // Centre Point Order With Single Fill Maq
#define OUCH_ORDER_TYPE_LIMIT_SWEEP_ORDER_WITH_SINGLE_FILL_MAQ 0x54         // Limit Sweep Order With Single Fill Maq
#define OUCH_ORDER_TYPE_ANY_PRICE_BLOCK_ORDER 0x43                          // Any Price Block Order
#define OUCH_ORDER_TYPE_ANY_PRICE_BLOCK_ORDER_WITH_SINGLE_FILL_MAQ 0x45     // Any Price Block Order With Single Fill Maq

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP client must send a Login Request Packet immediately upon establishing a new TCP/IP socket connection to the server
typedef struct _LoginRequestPacket {
  UINT8 username[6];                    // bytes 0 to 5
  UINT8 password[10];                   // bytes 6 to 15
  UINT8 requested_session[10];          // bytes 16 to 25
  UINT8 requested_sequence_number[20];  // bytes 26 to 45
} LoginRequestPacket;

// The Enter Order message is used to enter a new order into the market. The response to a successful Enter Order message is an Order Accepted message. If the order is rejected, the Order Rejected message will be returned.
typedef struct _EnterOrderMessage {
  UINT8 order_token[14];                 // bytes 0 to 13
  UINT32BE order_book_id;                // bytes 14 to 17
  UINT8 side;                            // byte 18
  UINT64BE quantity;                     // bytes 19 to 26
  UINT32BE price;                        // bytes 27 to 30, signed, read here as unsigned
  UINT8 time_in_force;                   // byte 31
  UINT8 open_close;                      // byte 32
  UINT8 client_account[10];              // bytes 33 to 42
  UINT8 customer_info[15];               // bytes 43 to 57
  UINT8 exchange_info[32];               // bytes 58 to 89
  UINT8 clearing_participant;            // byte 90
  UINT32BE crossing_key;                 // bytes 91 to 94
  UINT8 capacity_of_participant;         // byte 95
  UINT8 directed_wholesale;              // byte 96
  UINT8 execution_venue[4];              // bytes 97 to 100
  UINT8 intermediary_id[10];             // bytes 101 to 110
  UINT8 order_origin[20];                // bytes 111 to 130
  UINT8 filler[8];                       // bytes 131 to 138
  UINT8 ouch_order_type;                 // byte 139
  UINT64BE short_sell_quantity;          // bytes 140 to 147
  UINT64BE minimum_acceptable_quantity;  // bytes 148 to 155
} EnterOrderMessage;

// The Replace Order message is used to amend an existing order that was entered with ASX Trade OUCH. The response to a successful Replace Order message is an Order Replaced message. If the amendment is rejected, the Order Rejected message will be returned.
typedef struct _ReplaceOrderMessage {
  UINT8 existing_order_token[14];        // bytes 0 to 13
  UINT8 replacement_order_token[14];     // bytes 14 to 27
  UINT64BE quantity;                     // bytes 28 to 35
  UINT32BE price;                        // bytes 36 to 39, signed, read here as unsigned
  UINT8 open_close;                      // byte 40
  UINT8 client_account[10];              // bytes 41 to 50
  UINT8 customer_info[15];               // bytes 51 to 65
  UINT8 exchange_info[32];               // bytes 66 to 97
  UINT8 capacity_of_participant;         // byte 98
  UINT8 directed_wholesale;              // byte 99
  UINT8 execution_venue[4];              // bytes 100 to 103
  UINT8 intermediary_id[10];             // bytes 104 to 113
  UINT8 order_origin[20];                // bytes 114 to 133
  UINT8 filler[8];                       // bytes 134 to 141
  UINT64BE short_sell_quantity;          // bytes 142 to 149
  UINT64BE minimum_acceptable_quantity;  // bytes 150 to 157
} ReplaceOrderMessage;

// The Cancel Order message is used to cancel an existing order that was entered with ASX Trade OUCH, using the order token to identify the order being cancelled. The response to a successful Cancel Order message is an Order Cancelled message. If the cancellation is rejected, the Order Rejected message will be returned.
typedef struct _CancelOrderMessage {
  UINT8 order_token[14];  // bytes 0 to 13
} CancelOrderMessage;

// The Cancel By Order ID message is used to cancel an existing own customer order that was entered with ASX Trade OUCH or another protocol (for example the OMNet API), using the order ID to identify the order being cancelled. The response to a successful Cancel By Order ID message is an Order Cancelled message. If the cancellation is rejected, the Order Rejected message will be returned.
typedef struct _CancelByOrderIdMessage {
  UINT32BE order_book_id;  // bytes 0 to 3
  UINT8 side;              // byte 4
  UINT64BE order_id;       // bytes 5 to 12
} CancelByOrderIdMessage;

// The unsequenced (client to server) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _UnsequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x4F: EnterOrderMessage enter_order_message;
    case 0x55: ReplaceOrderMessage replace_order_message;
    case 0x58: CancelOrderMessage cancel_order_message;
    case 0x59: CancelByOrderIdMessage cancel_by_order_id_message;
    default: UINT8 unknown[available];
  }
} UnsequencedMessage;

// The Unsequenced Data Packets act as an envelope to carry the actual data messages that are transferred from the client to the server
typedef struct _UnsequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 unsequenced_message_type;                                                                                                                                    // byte 0
  UnsequencedMessage(unsequenced_message_type, (((UINT32) packet_length) - 2)) unsequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} UnsequencedDataPacket;

// Branch
casetype _ClientPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x4C: LoginRequestPacket login_request_packet;
    case 0x55: UnsequencedDataPacket(packet_length) unsequenced_data_packet[:byte-size-single-element-array length];
    case 0x52: unit client_heartbeat;
    case 0x4F: unit logout_request;
    default: UINT8 unknown[available];
  }
} ClientPayload;

// Soup Bin Tcp Packet sent by the client
typedef struct _ClientSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 client_packet_type;                                                                                                                                                                                     // byte 2
  ClientPayload(client_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) client_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ClientSoupBinTcpPacket;

// ---- Packet: ClientPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the client
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientSoupBinTcpPacket client_soup_bin_tcp_packet[:byte-size available];
} ClientPacket;

