// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AsxSecurities_Trade_v3_1.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SECONDS_MESSAGE 0x54                           // Seconds Message
#define MESSAGE_TYPE_ORDER_BOOK_DIRECTORY_MESSAGE 0x52              // Order Book Directory Message
#define MESSAGE_TYPE_COMBINATION_ORDER_BOOK_DIRECTORY_MESSAGE 0x4D  // Combination Order Book Directory Message
#define MESSAGE_TYPE_TICK_SIZE_TABLE_ENTRY_MESSAGE 0x4C             // Tick Size Table Entry Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                      // System Event Message
#define MESSAGE_TYPE_ORDER_BOOK_STATE_MESSAGE 0x4F                  // Order Book State Message
#define MESSAGE_TYPE_ADD_ORDER_NO_PARTICIPANT_ID_MESSAGE 0x41       // Add Order No Participant Id Message
#define MESSAGE_TYPE_ADD_ORDER_PARTICIPANT_ID_MESSAGE 0x46          // Add Order Participant Id Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45                    // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_WITH_PRICE_MESSAGE 0x43         // Order Executed With Price Message
#define MESSAGE_TYPE_ORDER_REPLACE_MESSAGE 0x55                     // Order Replace Message
#define MESSAGE_TYPE_ORDER_DELETE_MESSAGE 0x44                      // Order Delete Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x50                             // Trade Message
#define MESSAGE_TYPE_EQUILIBRIUM_PRICE_UPDATE_MESSAGE 0x5A          // Equilibrium Price Update Message

// Financial Product: one byte code
#define FINANCIAL_PRODUCT_OPTION 0x01                // Option
#define FINANCIAL_PRODUCT_FUTURE 0x03                // Future
#define FINANCIAL_PRODUCT_CASH 0x05                  // Cash
#define FINANCIAL_PRODUCT_STANDARD_COMBINATION 0x0B  // Standard Combination

// Leg Side: one byte code
#define LEG_SIDE_BUY_LEG 0x42   // Buy Leg
#define LEG_SIDE_SELL_LEG 0x43  // Sell Leg

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F  // Start Of Messages
#define EVENT_CODE_END_OF_MESSAGES 0x43    // End Of Messages

// Side: one byte code
#define SIDE_SELL 0x53  // Sell
#define SIDE_BUY 0x42   // Buy

// Lot Type: one byte code
#define LOT_TYPE_UNDEFINED 0x00        // Undefined
#define LOT_TYPE_ODD_LOT 0x01          // Odd Lot
#define LOT_TYPE_ROUND_LOT 0x02        // Round Lot
#define LOT_TYPE_BLOCK_LOT 0x03        // Block Lot
#define LOT_TYPE_ALL_OR_NONE_LOT 0x04  // All Or None Lot

// Occurred At Cross: one byte code
#define OCCURRED_AT_CROSS_YES 0x59  // Yes
#define OCCURRED_AT_CROSS_NO 0x4E   // No

// Printable: one byte code
#define PRINTABLE_YES 0x59  // Yes
#define PRINTABLE_NO 0x4E   // No

// ---- Types -------------------------------------------------------------------

// This message is sent every second for which at least one ASX ITCH message is being generated. The message contains the number of seconds since the start of 1970-01-01 00:00:00 UTC, also called Unix Time.
typedef struct _SecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} SecondsMessage;

// At the start of each trading day, Order Book Directory messages are disseminated for all active instruments.
typedef struct _OrderBookDirectoryMessage {
  UINT32BE nanoseconds;                          // bytes 0 to 3
  UINT32BE order_book_id;                        // bytes 4 to 7
  UINT8 symbol[32];                              // bytes 8 to 39
  UINT8 long_name[32];                           // bytes 40 to 71
  UINT8 isin[12];                                // bytes 72 to 83
  UINT8 financial_product;                       // byte 84
  UINT8 trading_currency[3];                     // bytes 85 to 87
  UINT16BE number_of_decimals_in_price;          // bytes 88 to 89
  UINT16BE number_of_decimals_in_nominal_value;  // bytes 90 to 91
  UINT32BE odd_lot_size;                         // bytes 92 to 95
  UINT32BE round_lot_size;                       // bytes 96 to 99
  UINT32BE block_lot_size;                       // bytes 100 to 103
  UINT64BE nominal_value;                        // bytes 104 to 111
} OrderBookDirectoryMessage;

// Leg 1
typedef struct _Leg1 {
  UINT8 leg_symbol[32];  // bytes 0 to 31
  UINT8 leg_side;        // byte 32
  UINT32BE leg_ratio;    // bytes 33 to 36
} Leg1;

// Leg 2
typedef struct _Leg2 {
  UINT8 leg_symbol[32];  // bytes 0 to 31
  UINT8 leg_side;        // byte 32
  UINT32BE leg_ratio;    // bytes 33 to 36
} Leg2;

// Leg 3
typedef struct _Leg3 {
  UINT8 leg_symbol[32];  // bytes 0 to 31
  UINT8 leg_side;        // byte 32
  UINT32BE leg_ratio;    // bytes 33 to 36
} Leg3;

// Leg 4
typedef struct _Leg4 {
  UINT8 leg_symbol[32];  // bytes 0 to 31
  UINT8 leg_side;        // byte 32
  UINT32BE leg_ratio;    // bytes 33 to 36
} Leg4;

// The Combination Order Book Directory is a specialised directory message used for combinations. It represents both standard combinations defined by ASX, and tailor-made combinations created by customers.
typedef struct _CombinationOrderBookDirectoryMessage {
  UINT32BE nanoseconds;                          // bytes 0 to 3
  UINT32BE order_book_id;                        // bytes 4 to 7
  UINT8 symbol[32];                              // bytes 8 to 39
  UINT8 long_name[32];                           // bytes 40 to 71
  UINT8 isin[12];                                // bytes 72 to 83
  UINT8 financial_product;                       // byte 84
  UINT8 trading_currency[3];                     // bytes 85 to 87
  UINT16BE number_of_decimals_in_price;          // bytes 88 to 89
  UINT16BE number_of_decimals_in_nominal_value;  // bytes 90 to 91
  UINT32BE odd_lot_size;                         // bytes 92 to 95
  UINT32BE round_lot_size;                       // bytes 96 to 99
  UINT32BE block_lot_size;                       // bytes 100 to 103
  UINT64BE nominal_value;                        // bytes 104 to 111
  Leg1 leg_1;                                    // bytes 112 to 148
  Leg2 leg_2;                                    // bytes 149 to 185
  Leg3 leg_3;                                    // bytes 186 to 222
  Leg4 leg_4;                                    // bytes 223 to 259
} CombinationOrderBookDirectoryMessage;

// This message contains information on a tick size for a price range. Together, all Tick Size messages with the same Order Book ID form a complete Tick Size Table. Each order book has a set of Tick Size Table Entries to define its tick size table.
typedef struct _TickSizeTableEntryMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
  UINT64BE tick_size;      // bytes 8 to 15
  UINT32BE price_from;     // bytes 16 to 19, signed, read here as unsigned
  UINT32BE price_to;       // bytes 20 to 23, signed, read here as unsigned
} TickSizeTableEntryMessage;

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT8 event_code;      // byte 4
} SystemEventMessage;

// The Order Book State message relays information on session state changes.
typedef struct _OrderBookStateMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
  UINT8 state_name[20];    // bytes 8 to 27
} OrderBookStateMessage;

// This message will be generated for anonymous instruments in ASX Trade
typedef struct _AddOrderNoParticipantIdMessage {
  UINT32BE nanoseconds;                 // bytes 0 to 3
  UINT64BE order_id;                    // bytes 4 to 11
  UINT32BE order_book_id;               // bytes 12 to 15
  UINT8 side;                           // byte 16
  UINT32BE order_book_position;         // bytes 17 to 20
  UINT64BE quantity;                    // bytes 21 to 28
  UINT32BE price;                       // bytes 29 to 32, signed, read here as unsigned
  UINT16BE unused_reserved_2_bits : 2;  // bytes 33 to 34
  UINT16BE implied_order : 1;           // bytes 33 to 34
  UINT16BE reserved_7_bits : 7;         // bytes 33 to 34
  UINT16BE undisclosed : 1;             // bytes 33 to 34
  UINT16BE reserved_bit : 1;            // bytes 33 to 34
  UINT16BE price_stabilisation : 1;     // bytes 33 to 34
  UINT16BE market_bid : 1;              // bytes 33 to 34
  UINT16BE reserved_2_bits : 2;         // bytes 33 to 34
  UINT8 lot_type;                       // byte 35
} AddOrderNoParticipantIdMessage;

// This message will be generated for non-anonymous instruments in ASX Trade
typedef struct _AddOrderParticipantIdMessage {
  UINT32BE nanoseconds;                 // bytes 0 to 3
  UINT64BE order_id;                    // bytes 4 to 11
  UINT32BE order_book_id;               // bytes 12 to 15
  UINT8 side;                           // byte 16
  UINT32BE order_book_position;         // bytes 17 to 20
  UINT64BE quantity;                    // bytes 21 to 28
  UINT32BE price;                       // bytes 29 to 32, signed, read here as unsigned
  UINT16BE unused_reserved_2_bits : 2;  // bytes 33 to 34
  UINT16BE implied_order : 1;           // bytes 33 to 34
  UINT16BE reserved_7_bits : 7;         // bytes 33 to 34
  UINT16BE undisclosed : 1;             // bytes 33 to 34
  UINT16BE reserved_bit : 1;            // bytes 33 to 34
  UINT16BE price_stabilisation : 1;     // bytes 33 to 34
  UINT16BE market_bid : 1;              // bytes 33 to 34
  UINT16BE reserved_2_bits : 2;         // bytes 33 to 34
  UINT8 lot_type;                       // byte 35
  UINT8 participant_id[7];              // bytes 36 to 42
} AddOrderParticipantIdMessage;

// This message is sent whenever an order in the book is executed in whole or in part.
typedef struct _OrderExecutedMessage {
  UINT32BE nanoseconds;                  // bytes 0 to 3
  UINT64BE order_id;                     // bytes 4 to 11
  UINT32BE order_book_id;                // bytes 12 to 15
  UINT8 side;                            // byte 16
  UINT64BE executed_quantity;            // bytes 17 to 24
  UINT8 match_id[12];                    // bytes 25 to 36
  UINT8 participant_id_owner[7];         // bytes 37 to 43
  UINT8 participant_id_counterparty[7];  // bytes 44 to 50
} OrderExecutedMessage;

// This message is sent when an order in the book is executed in whole or in part with a price different than the initial display price.
typedef struct _OrderExecutedWithPriceMessage {
  UINT32BE nanoseconds;                  // bytes 0 to 3
  UINT64BE order_id;                     // bytes 4 to 11
  UINT32BE order_book_id;                // bytes 12 to 15
  UINT8 side;                            // byte 16
  UINT64BE executed_quantity;            // bytes 17 to 24
  UINT8 match_id[12];                    // bytes 25 to 36
  UINT8 participant_id_owner[7];         // bytes 37 to 43
  UINT8 participant_id_counterparty[7];  // bytes 44 to 50
  UINT32BE trade_price;                  // bytes 51 to 54, signed, read here as unsigned
  UINT8 occurred_at_cross;               // byte 55
  UINT8 printable;                       // byte 56
} OrderExecutedWithPriceMessage;

// This message is sent whenever an order in the book has been replaced. The remaining quantity from the original order is no longer accessible and must be removed.
typedef struct _OrderReplaceMessage {
  UINT32BE nanoseconds;                 // bytes 0 to 3
  UINT64BE order_id;                    // bytes 4 to 11
  UINT32BE order_book_id;               // bytes 12 to 15
  UINT8 side;                           // byte 16
  UINT32BE new_order_book_position;     // bytes 17 to 20
  UINT64BE quantity;                    // bytes 21 to 28
  UINT32BE price;                       // bytes 29 to 32, signed, read here as unsigned
  UINT16BE unused_reserved_2_bits : 2;  // bytes 33 to 34
  UINT16BE implied_order : 1;           // bytes 33 to 34
  UINT16BE reserved_7_bits : 7;         // bytes 33 to 34
  UINT16BE undisclosed : 1;             // bytes 33 to 34
  UINT16BE reserved_bit : 1;            // bytes 33 to 34
  UINT16BE price_stabilisation : 1;     // bytes 33 to 34
  UINT16BE market_bid : 1;              // bytes 33 to 34
  UINT16BE reserved_2_bits : 2;         // bytes 33 to 34
} OrderReplaceMessage;

// This message is sent whenever an order in the book is deleted. There will be no remaining quantity, so the order should be removed from the book.
typedef struct _OrderDeleteMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT64BE order_id;       // bytes 4 to 11
  UINT32BE order_book_id;  // bytes 12 to 15
  UINT8 side;              // byte 16
} OrderDeleteMessage;

// The Trade Message is designed to provide details for executions in dark order books and reporting the individual legs of traded combinations.
typedef struct _TradeMessage {
  UINT32BE nanoseconds;                  // bytes 0 to 3
  UINT8 match_id[12];                    // bytes 4 to 15
  UINT8 side;                            // byte 16
  UINT64BE quantity;                     // bytes 17 to 24
  UINT32BE order_book_id;                // bytes 25 to 28
  UINT32BE trade_price;                  // bytes 29 to 32, signed, read here as unsigned
  UINT8 participant_id_owner[7];         // bytes 33 to 39
  UINT8 participant_id_counterparty[7];  // bytes 40 to 46
  UINT8 printable;                       // byte 47
  UINT8 occurred_at_cross;               // byte 48
} TradeMessage;

// This message is used when auctions occur. The message provides the changes in equilibrium (auction) price. Note that subtracting the Ask Quantity from the Bid Quantity will yield the Surplus Volume.
typedef struct _EquilibriumPriceUpdateMessage {
  UINT32BE nanoseconds;        // bytes 0 to 3
  UINT32BE order_book_id;      // bytes 4 to 7
  UINT64BE bid_quantity;       // bytes 8 to 15
  UINT64BE ask_quantity;       // bytes 16 to 23
  UINT32BE equilibrium_price;  // bytes 24 to 27, signed, read here as unsigned
  UINT32BE best_bid_price;     // bytes 28 to 31, signed, read here as unsigned
  UINT32BE best_ask_price;     // bytes 32 to 35, signed, read here as unsigned
  UINT64BE best_bid_quantity;  // bytes 36 to 43
  UINT64BE best_ask_quantity;  // bytes 44 to 51
} EquilibriumPriceUpdateMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: SecondsMessage seconds_message;
    case 0x52: OrderBookDirectoryMessage order_book_directory_message;
    case 0x4D: CombinationOrderBookDirectoryMessage combination_order_book_directory_message;
    case 0x4C: TickSizeTableEntryMessage tick_size_table_entry_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x4F: OrderBookStateMessage order_book_state_message;
    case 0x41: AddOrderNoParticipantIdMessage add_order_no_participant_id_message;
    case 0x46: AddOrderParticipantIdMessage add_order_participant_id_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceMessage order_executed_with_price_message;
    case 0x55: OrderReplaceMessage order_replace_message;
    case 0x44: OrderDeleteMessage order_delete_message;
    case 0x50: TradeMessage trade_message;
    case 0x5A: EquilibriumPriceUpdateMessage equilibrium_price_update_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

