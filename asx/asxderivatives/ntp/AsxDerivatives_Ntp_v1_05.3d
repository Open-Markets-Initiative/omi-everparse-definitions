// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AsxDerivatives_Ntp_v1_05.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SECONDS_MESSAGE 0x54                              // Seconds Message
#define MESSAGE_TYPE_END_OF_BUSINESS_TRADE_DATE_MESSAGE 0x53           // End Of Business Trade Date Message
#define MESSAGE_TYPE_FUTURE_SYMBOL_DIRECTORY_MESSAGE 0x66              // Future Symbol Directory Message
#define MESSAGE_TYPE_OPTIONS_SYMBOL_DIRECTORY_MESSAGE 0x68             // Options Symbol Directory Message
#define MESSAGE_TYPE_COMBINATION_SYMBOL_DIRECTORY_MESSAGE 0x4D         // Combination Symbol Directory Message
#define MESSAGE_TYPE_BUNDLES_SYMBOL_DIRECTORY 0x6D                     // Bundles Symbol Directory
#define MESSAGE_TYPE_ORDER_BOOK_STATE_MESSAGE 0x4F                     // Order Book State Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x41                            // Add Order Message
#define MESSAGE_TYPE_ORDER_VOLUME_CANCELLED_MESSAGE 0x58               // Order Volume Cancelled Message
#define MESSAGE_TYPE_ORDER_DELETED_MESSAGE 0x44                        // Order Deleted Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45                       // Order Executed Message
#define MESSAGE_TYPE_AUCTION_ORDER_EXECUTED_MESSAGE 0x43               // Auction Order Executed Message
#define MESSAGE_TYPE_COMBINATION_ORDER_EXECUTED_MESSAGE 0x65           // Combination Order Executed Message
#define MESSAGE_TYPE_IMPLIED_ORDER_ADDED_MESSAGE 0x6A                  // Implied Order Added Message
#define MESSAGE_TYPE_IMPLIED_ORDER_REPLACED_MESSAGE 0x6C               // Implied Order Replaced Message
#define MESSAGE_TYPE_IMPLIED_ORDER_DELETED_MESSAGE 0x6B                // Implied Order Deleted Message
#define MESSAGE_TYPE_TRADE_EXECUTED_MESSAGE 0x50                       // Trade Executed Message
#define MESSAGE_TYPE_COMBINATION_TRADE_EXECUTED_MESSAGE 0x70           // Combination Trade Executed Message
#define MESSAGE_TYPE_TRADE_CANCELLATION_MESSAGE 0x42                   // Trade Cancellation Message
#define MESSAGE_TYPE_EQUILIBRIUM_PRICE_MESSAGE 0x5A                    // Equilibrium Price Message
#define MESSAGE_TYPE_OPEN_HIGH_LOW_LAST_TRADE_ADJUSTMENT_MESSAGE 0x74  // Open High Low Last Trade Adjustment Message
#define MESSAGE_TYPE_MARKET_SETTLEMENT_MESSAGE 0x59                    // Market Settlement Message
#define MESSAGE_TYPE_TEXT_MESSAGE 0x78                                 // Text Message
#define MESSAGE_TYPE_REQUEST_FOR_QUOTE_MESSAGE 0x71                    // Request For Quote Message
#define MESSAGE_TYPE_ANOMALOUS_ORDER_THRESHOLD_PUBLISH_MESSAGE 0x57    // Anomalous Order Threshold Publish Message
#define MESSAGE_TYPE_VOLUME_AND_OPEN_INTEREST_MESSAGE 0x56             // Volume And Open Interest Message

// Event Code: one byte code
#define EVENT_CODE_BUSINESS_TRADE_DATE_HAS_ENDED 0x43  // Business Trade Date Has Ended

// Expiry Month: one byte code
#define EXPIRY_MONTH_JAN 0x01  // Jan
#define EXPIRY_MONTH_FEB 0x02  // Feb
#define EXPIRY_MONTH_MAR 0x03  // Mar
#define EXPIRY_MONTH_APR 0x04  // Apr
#define EXPIRY_MONTH_MAY 0x05  // May
#define EXPIRY_MONTH_JUN 0x06  // Jun
#define EXPIRY_MONTH_JUL 0x07  // Jul
#define EXPIRY_MONTH_AUG 0x08  // Aug
#define EXPIRY_MONTH_SEP 0x09  // Sep
#define EXPIRY_MONTH_OCT 0x0A  // Oct
#define EXPIRY_MONTH_NOV 0x0B  // Nov
#define EXPIRY_MONTH_DEC 0x0C  // Dec

// Option Type: one byte code
#define OPTION_TYPE_PUT 0x50   // Put
#define OPTION_TYPE_CALL 0x43  // Call

// Price Method: one byte code
#define PRICE_METHOD_NET_PRICE 0x00         // Net Price
#define PRICE_METHOD_YIELD_DIFFERENCE 0x02  // Yield Difference
#define PRICE_METHOD_INDIVIDUAL 0x03        // Individual
#define PRICE_METHOD_AVERAGE_PRICE 0x04     // Average Price

// Side Leg: one byte code
#define SIDE_LEG_BUY 0x42          // Buy
#define SIDE_LEG_SELL 0x53         // Sell
#define SIDE_LEG_NOT_DEFINED 0x20  // Not Defined

// Session State: one byte code
#define SESSION_STATE_PRE_OPEN 0x50         // Pre Open
#define SESSION_STATE_OPENED 0x4F           // Opened
#define SESSION_STATE_REGULATORY_HALT 0x52  // Regulatory Halt
#define SESSION_STATE_HALTED 0x48           // Halted
#define SESSION_STATE_CLOSED 0x43           // Closed
#define SESSION_STATE_MAINTENANCE 0x4D      // Maintenance

// Side: one byte code
#define SIDE_SELL 0x53  // Sell
#define SIDE_BUY 0x42   // Buy

// Trade Type: one byte code
#define TRADE_TYPE_NORMAL_TRADE 0x54                      // Normal Trade
#define TRADE_TYPE_NORMAL_CROSS 0x74                      // Normal Cross
#define TRADE_TYPE_AUCTION_TRADE 0x4C                     // Auction Trade
#define TRADE_TYPE_AUCTION_CROSS 0x6C                     // Auction Cross
#define TRADE_TYPE_COMBINATION_TO_UNDERLYING_TRADE 0x53   // Combination To Underlying Trade
#define TRADE_TYPE_COMBINATION_TO_UNDERLYING_CROSS 0x73   // Combination To Underlying Cross
#define TRADE_TYPE_COMBINATION_TO_COMBINATION_TRADE 0x52  // Combination To Combination Trade
#define TRADE_TYPE_COMBINATION_TO_COMBINATION_CROSS 0x72  // Combination To Combination Cross
#define TRADE_TYPE_STRIP_TO_STRIP_TRADE 0x41              // Strip To Strip Trade
#define TRADE_TYPE_STRIP_TO_STRIP_CROSS 0x61              // Strip To Strip Cross
#define TRADE_TYPE_STRIP_TO_OUTRIGHT_TRADE 0x42           // Strip To Outright Trade
#define TRADE_TYPE_STRIP_TO_OUTRIGHT_CROSS 0x62           // Strip To Outright Cross

// Opposite Side: one byte code
#define OPPOSITE_SIDE_SELL 0x53  // Sell
#define OPPOSITE_SIDE_BUY 0x42   // Buy

// Buyer Side: one byte code
#define BUYER_SIDE_SELL 0x53  // Sell
#define BUYER_SIDE_BUY 0x42   // Buy

// Seller Side: one byte code
#define SELLER_SIDE_SELL 0x53  // Sell
#define SELLER_SIDE_BUY 0x42   // Buy

// Rfq Side: one byte code
#define RFQ_SIDE_TWO_SIDED_QUOTE 0x54  // Two Sided Quote
#define RFQ_SIDE_BID_QUOTE 0x42        // Bid Quote
#define RFQ_SIDE_ASK_QUOTE 0x53        // Ask Quote
#define RFQ_SIDE_CROSSING 0x58         // Crossing

// ---- Types -------------------------------------------------------------------

// A seconds Nanoseconds is issued every second and any message thereafter will be stamped with the number of nanoseconds past the last Time message received as a time reference point
typedef struct _SecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} SecondsMessage;

// This message will be sent as the last message for a Business Trade Date to signal no further messages will be disseminated for that date.
typedef struct _EndOfBusinessTradeDateMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT16BE trade_date;   // bytes 4 to 5
  UINT8 event_code;      // byte 6
} EndOfBusinessTradeDateMessage;

// The Future Symbol Directory message describes futures contract
typedef struct _FutureSymbolDirectoryMessage {
  UINT32BE nanoseconds;                   // bytes 0 to 3
  UINT16BE trade_date;                    // bytes 4 to 5
  UINT32BE tradeable_instrument_id;       // bytes 6 to 9
  UINT8 symbol_name[32];                  // bytes 10 to 41
  UINT8 long_name[60];                    // bytes 42 to 101
  UINT8 isin[12];                         // bytes 102 to 113
  UINT8 exchange[6];                      // bytes 114 to 119
  UINT8 instrument[6];                    // bytes 120 to 125
  UINT8 cfi_code[6];                      // bytes 126 to 131
  UINT16BE expiry_year;                   // bytes 132 to 133
  UINT8 expiry_month;                     // byte 134
  UINT8 price_display_decimals;           // byte 135
  UINT32BE price_fractional_denominator;  // bytes 136 to 139
  UINT32BE price_minimum_tick;            // bytes 140 to 143
  UINT32BE last_trading_date;             // bytes 144 to 147
  UINT64BE prior_day_settlement;          // bytes 148 to 155, signed, read here as unsigned
  UINT8 currency[3];                      // bytes 156 to 158
  UINT64BE lot_size_or_face_value;        // bytes 159 to 166
  UINT8 maturity_value;                   // byte 167
  UINT16BE coupon_rate;                   // bytes 168 to 169
  UINT8 payments_per_year;                // byte 170
  UINT32BE block_lot_size;                // bytes 171 to 174
  UINT32BE expiry_date;                   // bytes 175 to 178
} FutureSymbolDirectoryMessage;

// The Options Symbol Directory message describes options and warrants contracts.
typedef struct _OptionsSymbolDirectoryMessage {
  UINT32BE nanoseconds;                          // bytes 0 to 3
  UINT16BE trade_date;                           // bytes 4 to 5
  UINT32BE tradeable_instrument_id;              // bytes 6 to 9
  UINT8 symbol_name[32];                         // bytes 10 to 41
  UINT8 long_name[60];                           // bytes 42 to 101
  UINT8 isin[12];                                // bytes 102 to 113
  UINT8 exchange[6];                             // bytes 114 to 119
  UINT8 instrument[6];                           // bytes 120 to 125
  UINT8 cfi_code[6];                             // bytes 126 to 131
  UINT16BE expiry_year;                          // bytes 132 to 133
  UINT8 expiry_month;                            // byte 134
  UINT8 option_type;                             // byte 135
  UINT64BE strike;                               // bytes 136 to 143, signed, read here as unsigned
  UINT32BE underlying_tradeable_instrument_id;   // bytes 144 to 147
  UINT8 price_display_decimals;                  // byte 148
  UINT32BE price_fractional_denominator;         // bytes 149 to 152
  UINT32BE price_minimum_tick;                   // bytes 153 to 156
  UINT8 strike_price_decimal_position;           // byte 157
  UINT32BE strike_price_fractional_denominator;  // bytes 158 to 161
  UINT32BE strike_price_minimum_tick;            // bytes 162 to 165
  UINT32BE last_trading_date;                    // bytes 166 to 169
  UINT64BE prior_day_settlement;                 // bytes 170 to 177, signed, read here as unsigned
  UINT64BE volatility;                           // bytes 178 to 185
  UINT8 currency[3];                             // bytes 186 to 188
  UINT64BE lot_size_or_face_value;               // bytes 189 to 196
  UINT8 maturity_value;                          // byte 197
  UINT16BE coupon_rate;                          // bytes 198 to 199
  UINT8 payments_per_year;                       // byte 200
  UINT32BE block_lot_size;                       // bytes 201 to 204
  UINT32BE expiry_date;                          // bytes 205 to 208
  UINT8 basis_of_quotation[10];                  // bytes 209 to 218
} OptionsSymbolDirectoryMessage;

// Combination Leg
typedef struct _CombinationLeg {
  UINT32BE tradeable_instrument_id_leg;  // bytes 0 to 3
  UINT8 side_leg;                        // byte 4
  UINT32BE ratio_leg;                    // bytes 5 to 8
  UINT64BE price_leg;                    // bytes 9 to 16, signed, read here as unsigned
} CombinationLeg;

// The Combination Symbol Directory is a specialised reference data message used for defining combinations with up to 6 legs. It represents both standard combinations defined by ASX and user defined combinations created by participants
typedef struct _CombinationSymbolDirectoryMessage {
  UINT32BE nanoseconds;                            // bytes 0 to 3
  UINT16BE trade_date;                             // bytes 4 to 5
  UINT32BE tradeable_instrument_id;                // bytes 6 to 9
  UINT8 symbol_name[32];                           // bytes 10 to 41
  UINT8 long_name[60];                             // bytes 42 to 101
  UINT8 cfi_code[6];                               // bytes 102 to 107
  UINT8 price_method;                              // byte 108
  UINT8 price_display_decimals;                    // byte 109
  UINT32BE price_fractional_denominator;           // bytes 110 to 113
  UINT32BE price_minimum_tick;                     // bytes 114 to 117
  UINT8 legs;                                      // byte 118
  CombinationLeg combination_leg[:byte-size 102];  // bytes 119 to 220
} CombinationSymbolDirectoryMessage;

// Bundle Leg
typedef struct _BundleLeg {
  UINT32BE tradeable_instrument_id_leg;  // bytes 0 to 3
  UINT8 side_leg;                        // byte 4
  UINT32BE ratio_leg;                    // bytes 5 to 8
  UINT64BE price_leg;                    // bytes 9 to 16, signed, read here as unsigned
} BundleLeg;

// The Bundles Symbol Directory is a specialised reference data message used for defining combinations with legs greater than 6, specifically Bundle products with legs of 8, 12, 16 or 20 legs
typedef struct _BundlesSymbolDirectory {
  UINT32BE nanoseconds;                   // bytes 0 to 3
  UINT16BE trade_date;                    // bytes 4 to 5
  UINT32BE tradeable_instrument_id;       // bytes 6 to 9
  UINT8 symbol_name[32];                  // bytes 10 to 41
  UINT8 long_name[60];                    // bytes 42 to 101
  UINT8 cfi_code[6];                      // bytes 102 to 107
  UINT8 price_method;                     // byte 108
  UINT8 price_display_decimals;           // byte 109
  UINT32BE price_fractional_denominator;  // bytes 110 to 113
  UINT32BE price_minimum_tick;            // bytes 114 to 117
  UINT8 legs;                             // byte 118
  BundleLeg bundle_leg[:byte-size 340];   // bytes 119 to 458
} BundlesSymbolDirectory;

// This message indicates the current session state of a contract to the market
typedef struct _OrderBookStateMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT8 session_state;               // byte 10
} OrderBookStateMessage;

// An Order Added message indicates a new order or a restated order that has been accepted by the matching engine and added to the order book
typedef struct _AddOrderMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT8 side;                        // byte 10
  UINT64BE order_id;                 // bytes 11 to 18
  UINT64BE order_book_priority;      // bytes 19 to 26
  UINT32BE quantity;                 // bytes 27 to 30
  UINT64BE price;                    // bytes 31 to 38, signed, read here as unsigned
} AddOrderMessage;

// An Order Volume Cancelled message is sent when an order is modified as a result of partial cancellation of volume
typedef struct _OrderVolumeCancelledMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT8 side;                        // byte 10
  UINT64BE order_id;                 // bytes 11 to 18
  UINT32BE quantity;                 // bytes 19 to 22
} OrderVolumeCancelledMessage;

// This message is sent whenever an order in the book is cancelled by the owner, expired, cancelled by the exchange, purged or volume cancelled
typedef struct _OrderDeletedMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT8 side;                        // byte 10
  UINT64BE order_id;                 // bytes 11 to 18
} OrderDeletedMessage;

// This message is sent whenever a resting order of the book is executed in whole or in part and the counterparty to the trade is an aggressive order
typedef struct _OrderExecutedMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT8 side;                        // byte 10
  UINT64BE order_id;                 // bytes 11 to 18
  UINT32BE quantity_remaining;       // bytes 19 to 22
  UINT8 trade_type;                  // byte 23
  UINT64BE trade_id;                 // bytes 24 to 31
  UINT32BE executed_quantity;        // bytes 32 to 35
  UINT64BE trade_price;              // bytes 36 to 43, signed, read here as unsigned
  UINT64BE combination_trade_id;     // bytes 44 to 51
  UINT8 counter_party_id[3];         // bytes 52 to 54
} OrderExecutedMessage;

// This message is sent when orders are executed in the auction at the open of the market
typedef struct _AuctionOrderExecutedMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT8 side;                        // byte 10
  UINT64BE order_id;                 // bytes 11 to 18
  UINT32BE quantity_remaining;       // bytes 19 to 22
  UINT8 trade_type;                  // byte 23
  UINT64BE trade_id;                 // bytes 24 to 31
  UINT32BE executed_quantity;        // bytes 32 to 35
  UINT64BE trade_price;              // bytes 36 to 43, signed, read here as unsigned
  UINT64BE opposite_order_id;        // bytes 44 to 51
} AuctionOrderExecutedMessage;

// This message is sent whenever a resting order is matched with an open leg of a resting combination order in whole or in part
typedef struct _CombinationOrderExecutedMessage {
  UINT32BE nanoseconds;                       // bytes 0 to 3
  UINT16BE trade_date;                        // bytes 4 to 5
  UINT32BE tradeable_instrument_id;           // bytes 6 to 9
  UINT8 side;                                 // byte 10
  UINT64BE order_id;                          // bytes 11 to 18
  UINT32BE quantity_remaining;                // bytes 19 to 22
  UINT8 trade_type;                           // byte 23
  UINT64BE trade_id;                          // bytes 24 to 31
  UINT32BE executed_quantity;                 // bytes 32 to 35
  UINT64BE trade_price;                       // bytes 36 to 43, signed, read here as unsigned
  UINT32BE opposite_tradeable_instrument_id;  // bytes 44 to 47
  UINT8 opposite_side;                        // byte 48
  UINT64BE opposite_order_id;                 // bytes 49 to 56
  UINT64BE combination_trade_id;              // bytes 57 to 64
} CombinationOrderExecutedMessage;

// This message is a similar format to the Order Added message, except the nature of this order is it has an implied price, implied volume and a priority that is derived from two or more real orders deriving the implied price
typedef struct _ImpliedOrderAddedMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT8 side;                        // byte 10
  UINT64BE order_id;                 // bytes 11 to 18
  UINT64BE order_book_priority;      // bytes 19 to 26
  UINT32BE quantity;                 // bytes 27 to 30
  UINT64BE price;                    // bytes 31 to 38, signed, read here as unsigned
} ImpliedOrderAddedMessage;

// This message notifies the subscriber that an existing implied order is to be replaced when the implied price, volume or priority has changed due to a price or volume movement of real orders for a side of a single Tradeable Instrument Id
typedef struct _ImpliedOrderReplacedMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT8 side;                        // byte 10
  UINT64BE order_id;                 // bytes 11 to 18
  UINT64BE order_book_priority;      // bytes 19 to 26
  UINT32BE quantity;                 // bytes 27 to 30
  UINT64BE price;                    // bytes 31 to 38, signed, read here as unsigned
} ImpliedOrderReplacedMessage;

// This message is sent whenever the implied pricing or volume has changed due to price or volume movement of real orders for a side of a single contract number. When received, any implied volume is no longer accessible so the implied order of the indicated side must be removed from the book
typedef struct _ImpliedOrderDeletedMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT8 side;                        // byte 10
  UINT64BE order_id;                 // bytes 11 to 18
} ImpliedOrderDeletedMessage;

// The Trade Message is designed to provide details for executions in combination order books. Trade Executed messages are reported in the same sequence as order execution messages are reported
typedef struct _TradeExecutedMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT8 trade_type;                  // byte 10
  UINT64BE trade_id;                 // bytes 11 to 18
  UINT32BE executed_quantity;        // bytes 19 to 22
  UINT64BE trade_price;              // bytes 23 to 30, signed, read here as unsigned
  UINT64BE combination_trade_id;     // bytes 31 to 38
  UINT8 participant_id_buyer[3];     // bytes 39 to 41
  UINT8 participant_id_seller[3];    // bytes 42 to 44
} TradeExecutedMessage;

// The Combination Trade Executed Message is designed to provide details for executions where one or both orders are resting from a different order book id from the order book id of the trade
typedef struct _CombinationTradeExecutedMessage {
  UINT32BE nanoseconds;                     // bytes 0 to 3
  UINT16BE trade_date;                      // bytes 4 to 5
  UINT32BE tradeable_instrument_id;         // bytes 6 to 9
  UINT8 trade_type;                         // byte 10
  UINT64BE trade_id;                        // bytes 11 to 18
  UINT32BE executed_quantity;               // bytes 19 to 22
  UINT64BE trade_price;                     // bytes 23 to 30, signed, read here as unsigned
  UINT32BE buyer_tradeable_instrument_id;   // bytes 31 to 34
  UINT8 buyer_side;                         // byte 35
  UINT64BE buyer_order_id;                  // bytes 36 to 43
  UINT64BE buyer_combination_trade_id;      // bytes 44 to 51
  UINT8 buyer_participant_id[3];            // bytes 52 to 54
  UINT32BE seller_tradeable_instrument_id;  // bytes 55 to 58
  UINT8 seller_side;                        // byte 59
  UINT64BE seller_order_id;                 // bytes 60 to 67
  UINT64BE seller_combination_trade_id;     // bytes 68 to 75
  UINT8 seller_participant_id[3];           // bytes 76 to 78
} CombinationTradeExecutedMessage;

// This message is sent whenever a trade is cancelled by ASX
typedef struct _TradeCancellationMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT64BE trade_id;                 // bytes 10 to 17
} TradeCancellationMessage;

// This message is disseminated in response to changes in the equilibrium price for an order book during a pre-open period
typedef struct _EquilibriumPriceMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT64BE equilibrium_price;        // bytes 10 to 17, signed, read here as unsigned
  UINT64BE matched_quantity;         // bytes 18 to 25
  UINT64BE bid_quantity;             // bytes 26 to 33
  UINT64BE ask_quantity;             // bytes 34 to 41
} EquilibriumPriceMessage;

// Market trade price adjustments are sent resulting from modifications of Open, High, Low, Last and volume statistics due to market operations, prior to the instrument moving to the next session within the trade date, or at the close of instrument
typedef struct _OpenHighLowLastTradeAdjustmentMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT64BE opening_trade;            // bytes 10 to 17, signed, read here as unsigned
  UINT64BE highest_trade;            // bytes 18 to 25, signed, read here as unsigned
  UINT64BE lowest_trade;             // bytes 26 to 33, signed, read here as unsigned
  UINT64BE last_trade;               // bytes 34 to 41, signed, read here as unsigned
  UINT32BE last_volume;              // bytes 42 to 45
  UINT64BE total_traded_volume;      // bytes 46 to 53
} OpenHighLowLastTradeAdjustmentMessage;

// This message disseminates the final settlement price of a future or option contracts order book for the trade date it pertains to
typedef struct _MarketSettlementMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT64BE opening_trade;            // bytes 10 to 17, signed, read here as unsigned
  UINT64BE highest_trade;            // bytes 18 to 25, signed, read here as unsigned
  UINT64BE lowest_trade;             // bytes 26 to 33, signed, read here as unsigned
  UINT64BE last_trade;               // bytes 34 to 41, signed, read here as unsigned
  UINT32BE last_volume;              // bytes 42 to 45
  UINT64BE total_traded_volume;      // bytes 46 to 53
} MarketSettlementMessage;

// This message disseminates free text information describing ad-hoc market events
typedef struct _TextMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT16BE trade_date;   // bytes 4 to 5
  UINT8 source_id[6];    // bytes 6 to 11
  UINT8 text[100];       // bytes 12 to 111
} TextMessage;

// This message is disseminated for anonymous Request for Quotes (RFQs) from the market
typedef struct _RequestForQuoteMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT8 rfq_side;                    // byte 10
  UINT32BE quantity;                 // bytes 11 to 14
} RequestForQuoteMessage;

// This message disseminates price band information to the market advising the setting, zeroing or adjusting of the Extreme Trade Range price, the Anomalous Order Threshold price and the associated ranges for a contract that requires Market Integrity Rules enforcement
typedef struct _AnomalousOrderThresholdPublishMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT64BE aot_price;                // bytes 10 to 17, signed, read here as unsigned
  UINT64BE aot_upper_price;          // bytes 18 to 25, signed, read here as unsigned
  UINT64BE aot_lower_price;          // bytes 26 to 33, signed, read here as unsigned
  UINT64BE etr_price;                // bytes 34 to 41, signed, read here as unsigned
  UINT64BE etr_upper_price;          // bytes 42 to 49, signed, read here as unsigned
  UINT64BE etr_lower_price;          // bytes 50 to 57, signed, read here as unsigned
} AnomalousOrderThresholdPublishMessage;

// This message disseminates Volume and Open Interest (VOI) information for each trade date
typedef struct _VolumeAndOpenInterestMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT16BE trade_date;               // bytes 4 to 5
  UINT32BE tradeable_instrument_id;  // bytes 6 to 9
  UINT64BE cumulative_volume;        // bytes 10 to 17
  UINT64BE open_interest;            // bytes 18 to 25
  UINT16BE voi_trade_date;           // bytes 26 to 27
} VolumeAndOpenInterestMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: SecondsMessage seconds_message;
    case 0x53: EndOfBusinessTradeDateMessage end_of_business_trade_date_message;
    case 0x66: FutureSymbolDirectoryMessage future_symbol_directory_message;
    case 0x68: OptionsSymbolDirectoryMessage options_symbol_directory_message;
    case 0x4D: CombinationSymbolDirectoryMessage combination_symbol_directory_message;
    case 0x6D: BundlesSymbolDirectory bundles_symbol_directory;
    case 0x4F: OrderBookStateMessage order_book_state_message;
    case 0x41: AddOrderMessage add_order_message;
    case 0x58: OrderVolumeCancelledMessage order_volume_cancelled_message;
    case 0x44: OrderDeletedMessage order_deleted_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: AuctionOrderExecutedMessage auction_order_executed_message;
    case 0x65: CombinationOrderExecutedMessage combination_order_executed_message;
    case 0x6A: ImpliedOrderAddedMessage implied_order_added_message;
    case 0x6C: ImpliedOrderReplacedMessage implied_order_replaced_message;
    case 0x6B: ImpliedOrderDeletedMessage implied_order_deleted_message;
    case 0x50: TradeExecutedMessage trade_executed_message;
    case 0x70: CombinationTradeExecutedMessage combination_trade_executed_message;
    case 0x42: TradeCancellationMessage trade_cancellation_message;
    case 0x5A: EquilibriumPriceMessage equilibrium_price_message;
    case 0x74: OpenHighLowLastTradeAdjustmentMessage open_high_low_last_trade_adjustment_message;
    case 0x59: MarketSettlementMessage market_settlement_message;
    case 0x78: TextMessage text_message;
    case 0x71: RequestForQuoteMessage request_for_quote_message;
    case 0x57: AnomalousOrderThresholdPublishMessage anomalous_order_threshold_publish_message;
    case 0x56: VolumeAndOpenInterestMessage volume_and_open_interest_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

