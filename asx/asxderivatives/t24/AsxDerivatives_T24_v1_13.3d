// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AsxDerivatives_T24_v1_13.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_TIME_MESSAGE 0x54                                 // Time Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                         // System Event Message
#define MESSAGE_TYPE_FUTURE_SYMBOL_DIRECTORY_MESSAGE 0x66              // Future Symbol Directory Message
#define MESSAGE_TYPE_SPREAD_SYMBOL_DIRECTORY_MESSAGE 0x67              // Spread Symbol Directory Message
#define MESSAGE_TYPE_OPTION_SYMBOL_DIRECTORY_MESSAGE 0x68              // Option Symbol Directory Message
#define MESSAGE_TYPE_ORDER_BOOK_STATE_MESSAGE 0x4F                     // Order Book State Message
#define MESSAGE_TYPE_ORDER_ADDED_MESSAGE 0x41                          // Order Added Message
#define MESSAGE_TYPE_ORDER_REPLACED_MESSAGE 0x55                       // Order Replaced Message
#define MESSAGE_TYPE_ORDER_VOLUME_CANCELLED_MESSAGE 0x58               // Order Volume Cancelled Message
#define MESSAGE_TYPE_ORDER_DELETED_MESSAGE 0x44                        // Order Deleted Message
#define MESSAGE_TYPE_IMPLIED_ORDER_ADDED_MESSAGE 0x6A                  // Implied Order Added Message
#define MESSAGE_TYPE_IMPLIED_ORDER_REPLACED_MESSAGE 0x6C               // Implied Order Replaced Message
#define MESSAGE_TYPE_IMPLIED_ORDER_DELETED_MESSAGE 0x6B                // Implied Order Deleted Message
#define MESSAGE_TYPE_CUSTOM_MARKET_ORDER_ADDED_MESSAGE 0x6D            // Custom Market Order Added Message
#define MESSAGE_TYPE_CUSTOM_MARKET_ORDER_REPLACED_MESSAGE 0x6E         // Custom Market Order Replaced Message
#define MESSAGE_TYPE_CUSTOM_MARKET_ORDER_DELETED_MESSAGE 0x72          // Custom Market Order Deleted Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45                       // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_WITH_PRICE_MESSAGE 0x43            // Order Executed With Price Message
#define MESSAGE_TYPE_SPREAD_EXECUTED_MESSAGE 0x65                      // Spread Executed Message
#define MESSAGE_TYPE_TRADE_SPREAD_EXECUTION_CHAIN_MESSAGE 0x50         // Trade Spread Execution Chain Message
#define MESSAGE_TYPE_CUSTOM_MARKET_EXECUTED_MESSAGE 0x75               // Custom Market Executed Message
#define MESSAGE_TYPE_CUSTOM_MARKET_TRADE_MESSAGE 0x70                  // Custom Market Trade Message
#define MESSAGE_TYPE_TRADE_CANCELLATION_MESSAGE 0x42                   // Trade Cancellation Message
#define MESSAGE_TYPE_EQUILIBRIUM_PRICE_AUCTION_INFO_MESSAGE 0x5A       // Equilibrium Price Auction Info Message
#define MESSAGE_TYPE_OPEN_HIGH_LOW_LAST_TRADE_ADJUSTMENT_MESSAGE 0x74  // Open High Low Last Trade Adjustment Message
#define MESSAGE_TYPE_MARKET_SETTLEMENT_MESSAGE 0x59                    // Market Settlement Message
#define MESSAGE_TYPE_AD_HOC_TEXT_MESSAGE 0x78                          // Ad Hoc Text Message
#define MESSAGE_TYPE_REQUEST_FOR_QUOTE_MESSAGE 0x71                    // Request For Quote Message
#define MESSAGE_TYPE_ANOMALOUS_ORDER_THRESHOLD_PUBLISH_MESSAGE 0x57    // Anomalous Order Threshold Publish Message
#define MESSAGE_TYPE_VOLUME_AND_OPEN_INTEREST_MESSAGE 0x56             // Volume And Open Interest Message

// Event Code: one byte code
#define EVENT_CODE_OPEN 0x4F     // Open
#define EVENT_CODE_START 0x53    // Start
#define EVENT_CODE_END 0x43      // End
#define EVENT_CODE_PAUSED 0x50   // Paused
#define EVENT_CODE_RESUMED 0x52  // Resumed

// Contract Type: one byte code
#define CONTRACT_TYPE_CFUT 0x46   // Cfut
#define CONTRACT_TYPE_COPTA 0x4F  // Copta
#define CONTRACT_TYPE_EOPTA 0x45  // Eopta
#define CONTRACT_TYPE_OOPT 0x4E   // Oopt
#define CONTRACT_TYPE_CSPRD 0x53  // Csprd
#define CONTRACT_TYPE_SPRD 0x41   // Sprd
#define CONTRACT_TYPE_SFUT 0x44   // Sfut

// Financial Type: one byte code
#define FINANCIAL_TYPE_COMMODITY 0x43        // Commodity
#define FINANCIAL_TYPE_CFD 0x44              // Cfd
#define FINANCIAL_TYPE_EQUITY 0x45           // Equity
#define FINANCIAL_TYPE_GOVERNMENT_BOND 0x58  // Government Bond
#define FINANCIAL_TYPE_BANK_BILL 0x42        // Bank Bill

// Option Type: one byte code
#define OPTION_TYPE_PUT 0x50   // Put
#define OPTION_TYPE_CALL 0x43  // Call

// Activated: one byte code
#define ACTIVATED_YES 0x59  // Yes
#define ACTIVATED_NO 0x4E   // No

// Trading Status: one byte code
#define TRADING_STATUS_PENDING 0x70              // Pending
#define TRADING_STATUS_HALTED 0x48               // Halted
#define TRADING_STATUS_PRE_OPEN 0x50             // Pre Open
#define TRADING_STATUS_CLOSED 0x43               // Closed
#define TRADING_STATUS_LEVELLING 0x6C            // Levelling
#define TRADING_STATUS_LOCKED 0x4C               // Locked
#define TRADING_STATUS_OPENED 0x4F               // Opened
#define TRADING_STATUS_UNAVAILABLE 0x55          // Unavailable
#define TRADING_STATUS_PRE_PRICE_DISCOVERY 0x64  // Pre Price Discovery
#define TRADING_STATUS_INACTIVE 0x49             // Inactive
#define TRADING_STATUS_PRICE_DISCOVERY 0x44      // Price Discovery
#define TRADING_STATUS_ACTIVATED 0x41            // Activated
#define TRADING_STATUS_REGULATORY_HALT 0x52      // Regulatory Halt

// Side: one byte code
#define SIDE_SELL 0x53  // Sell
#define SIDE_BUY 0x42   // Buy

// Trade Type: one byte code
#define TRADE_TYPE_NORMAL 0x54                         // Normal
#define TRADE_TYPE_CROSSING_NORMAL 0x74                // Crossing Normal
#define TRADE_TYPE_SWEEPING 0x57                       // Sweeping
#define TRADE_TYPE_CROSSING_SWEEPING 0x77              // Crossing Sweeping
#define TRADE_TYPE_LEVELLING 0x4C                      // Levelling
#define TRADE_TYPE_CROSSING_LEVELLING 0x6C             // Crossing Levelling
#define TRADE_TYPE_SPREAD_TO_UNDERLYING 0x53           // Spread To Underlying
#define TRADE_TYPE_CROSSING_SPREAD_TO_UNDERLYING 0x73  // Crossing Spread To Underlying
#define TRADE_TYPE_INTRA_SPREAD 0x52                   // Intra Spread
#define TRADE_TYPE_CROSSING_INTRA_SPREAD 0x72          // Crossing Intra Spread
#define TRADE_TYPE_INTER_SPREAD 0x51                   // Inter Spread
#define TRADE_TYPE_CROSSING_INTER_SPREAD 0x71          // Crossing Inter Spread
#define TRADE_TYPE_CUSTOM 0x55                         // Custom
#define TRADE_TYPE_CROSSING_CUSTOM 0x75                // Crossing Custom

// Printable: one byte code
#define PRINTABLE_YES 0x59  // Yes
#define PRINTABLE_NO 0x4E   // No

// ---- Types -------------------------------------------------------------------

typedef struct _Session {
  UINT8 protocol_version[3];  // bytes 0 to 2
  UINT8 session_year[2];      // bytes 3 to 4
  UINT8 session_week[2];      // bytes 5 to 6
  UINT8 trading_service[3];   // bytes 7 to 9
} Session;

// The server will, on each packet multicast, transmit this message for every second for which at least one application message is generated
typedef struct _TimeMessage {
  UINT32BE second;  // bytes 0 to 3
} TimeMessage;

// The system event message is used to signal a market or trading period event.
typedef struct _SystemEventMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT16BE trade_date;   // bytes 4 to 5
  UINT8 event_code;      // byte 6
} SystemEventMessage;

// As each product moves to the new Trade Date, ASX Trade24 will disseminate the future symbol messages defining the available futures, CFDs and Share Future contracts for each instrument. The action of disseminating this message will automatically imply the contract is in a Pending session state.
typedef struct _FutureSymbolDirectoryMessage {
  UINT32BE nanoseconds;                   // bytes 0 to 3
  UINT16BE trade_date;                    // bytes 4 to 5
  UINT32BE contract_number;               // bytes 6 to 9
  UINT8 exchange[6];                      // bytes 10 to 15
  UINT8 instrument[6];                    // bytes 16 to 21
  UINT8 contract_type;                    // byte 22
  UINT16BE expiry_year;                   // bytes 23 to 24
  UINT8 expiry_month;                     // byte 25
  UINT8 price_decimal_position;           // byte 26
  UINT32BE price_fractional_denominator;  // bytes 27 to 30
  UINT16BE price_minimum_tick;            // bytes 31 to 32
  UINT32BE last_trading_date;             // bytes 33 to 36
  UINT32BE prior_day_settlement;          // bytes 37 to 40, signed, read here as unsigned
  UINT8 financial_type;                   // byte 41
  UINT8 currency[3];                      // bytes 42 to 44
  UINT32BE lot_size_or_face_value;        // bytes 45 to 48
  UINT8 maturity_value;                   // byte 49
  UINT16BE coupon_rate;                   // bytes 50 to 51
  UINT8 payments_per_year;                // byte 52
} FutureSymbolDirectoryMessage;

// As each product moves to the new Trade Date, ASX Trade24 will disseminate the spread symbol messages defining the available calendar spread and inter-spread contracts. For contracts that are inter-spreads, the underlying legs are in the same Trade Date.
typedef struct _SpreadSymbolDirectoryMessage {
  UINT32BE nanoseconds;                   // bytes 0 to 3
  UINT16BE trade_date;                    // bytes 4 to 5
  UINT32BE contract_number;               // bytes 6 to 9
  UINT8 exchange[6];                      // bytes 10 to 15
  UINT8 contract_type;                    // byte 16
  UINT32BE first_leg_contract_number;     // bytes 17 to 20
  UINT32BE second_leg_contract_number;    // bytes 21 to 24
  UINT8 primary_ratio;                    // byte 25
  UINT8 secondary_ratio;                  // byte 26
  UINT8 price_decimal_position;           // byte 27
  UINT32BE price_fractional_denominator;  // bytes 28 to 31
  UINT16BE price_minimum_tick;            // bytes 32 to 33
} SpreadSymbolDirectoryMessage;

// As each product moves to the new Trade Date, ASX Trade24 will disseminate the option symbol messages defining all the available options contracts. For Single Session Options only, the exchange can activate or de-activate option symbols during the course of trading by issuing Order Book State messages for affected option contracts. If an option symbol is not active (Activated field is N ) or is de-activated (Trading Status is I ), reference to that option contract should be removed from the list of actively traded contracts. If an option symbol is active (Activated field is Y ) or is activated (Trading Status is A ), reference to that option contract should be added to the list of actively traded contracts.
typedef struct _OptionSymbolDirectoryMessage {
  UINT32BE nanoseconds;                          // bytes 0 to 3
  UINT16BE trade_date;                           // bytes 4 to 5
  UINT32BE contract_number;                      // bytes 6 to 9
  UINT8 exchange[6];                             // bytes 10 to 15
  UINT8 instrument[6];                           // bytes 16 to 21
  UINT8 contract_type;                           // byte 22
  UINT16BE expiry_year;                          // bytes 23 to 24
  UINT8 expiry_month;                            // byte 25
  UINT8 option_type;                             // byte 26
  UINT32BE strike;                               // bytes 27 to 30
  UINT32BE underlying_contract_number;           // bytes 31 to 34
  UINT8 price_decimal_position;                  // byte 35
  UINT32BE price_fractional_denominator;         // bytes 36 to 39
  UINT16BE price_minimum_tick;                   // bytes 40 to 41
  UINT8 strike_price_decimal_position;           // byte 42
  UINT32BE strike_price_fractional_denominator;  // bytes 43 to 46
  UINT16BE strike_price_minimum_tick;            // bytes 47 to 48
  UINT32BE last_trading_date;                    // bytes 49 to 52
  UINT32BE prior_day_settlement;                 // bytes 53 to 56, signed, read here as unsigned
  UINT32BE volatility;                           // bytes 57 to 60
  UINT8 financial_type;                          // byte 61
  UINT8 currency[3];                             // bytes 62 to 64
  UINT32BE lot_size_or_face_value;               // bytes 65 to 68
  UINT8 maturity_value;                          // byte 69
  UINT16BE coupon_rate;                          // bytes 70 to 71
  UINT8 payments_per_year;                       // byte 72
  UINT8 activated;                               // byte 73
} OptionSymbolDirectoryMessage;

// ASX Trade24 uses this message to indicate the current session state of a contract to the market.
typedef struct _OrderBookStateMessage {
  UINT32BE nanoseconds;      // bytes 0 to 3
  UINT16BE trade_date;       // bytes 4 to 5
  UINT32BE contract_number;  // bytes 6 to 9
  UINT8 trading_status;      // byte 10
} OrderBookStateMessage;

// An Order Added message indicates a new order has been accepted by the ASX Trade24 system and was added to the order book. All orders in ASX Trade24 are anonymous and one Add type is supported for real orders that are not custom market orders. The message is referenced by an Order Number assigned by ASX Trade24 and is unique for the life of the order.
typedef struct _OrderAddedMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3
  UINT16BE trade_date;           // bytes 4 to 5
  UINT32BE contract_number;      // bytes 6 to 9
  UINT8 side;                    // byte 10
  UINT64BE order_number;         // bytes 11 to 18
  UINT32BE order_book_priority;  // bytes 19 to 22
  UINT32BE quantity;             // bytes 23 to 26
  UINT32BE price;                // bytes 27 to 30, signed, read here as unsigned
} OrderAddedMessage;

// This message is sent whenever an order in the book has been modified for price or volume where the priority changes. Even though the side and contract number cannot be changed, these fields are included in the message to provide fast look-up.
typedef struct _OrderReplacedMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3
  UINT16BE trade_date;           // bytes 4 to 5
  UINT32BE contract_number;      // bytes 6 to 9
  UINT8 side;                    // byte 10
  UINT64BE order_number;         // bytes 11 to 18
  UINT32BE order_book_priority;  // bytes 19 to 22
  UINT32BE quantity;             // bytes 23 to 26
  UINT32BE price;                // bytes 27 to 30, signed, read here as unsigned
} OrderReplacedMessage;

// This message is sent whenever an order in the book is modified as a result of a partial cancellation of volume. The difference between this message and the Order Replaced is an Order Replaced will always show a change of order book priority in regards to the order s position in the queue. An Order Volume Cancelled message is not sent when an order has partially traded.
typedef struct _OrderVolumeCancelledMessage {
  UINT32BE nanoseconds;      // bytes 0 to 3
  UINT16BE trade_date;       // bytes 4 to 5
  UINT32BE contract_number;  // bytes 6 to 9
  UINT8 side;                // byte 10
  UINT64BE order_number;     // bytes 11 to 18
  UINT32BE quantity;         // bytes 19 to 22
} OrderVolumeCancelledMessage;

// This message is sent whenever an order in the book is cancelled by the owner, expired, cancelled by the exchange, purged or volume cancelled. All remaining volume is no longer accessible so the order must be removed from the book.
typedef struct _OrderDeletedMessage {
  UINT32BE nanoseconds;      // bytes 0 to 3
  UINT16BE trade_date;       // bytes 4 to 5
  UINT32BE contract_number;  // bytes 6 to 9
  UINT8 side;                // byte 10
  UINT64BE order_number;     // bytes 11 to 18
} OrderDeletedMessage;

// This message is the same format as the Order Added message, except the nature of this order is it has an implied price, implied volume and a priority that is derived from two or more spreadable real orders.
typedef struct _ImpliedOrderAddedMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3
  UINT16BE trade_date;           // bytes 4 to 5
  UINT32BE contract_number;      // bytes 6 to 9
  UINT8 side;                    // byte 10
  UINT64BE order_number;         // bytes 11 to 18
  UINT32BE order_book_priority;  // bytes 19 to 22
  UINT32BE quantity;             // bytes 23 to 26
  UINT32BE price;                // bytes 27 to 30, signed, read here as unsigned
} ImpliedOrderAddedMessage;

// This message is the same format as the Order Replaced message, except this replacement refers to an implied order and is sent whenever the implied pricing or volume has changed due to a price or volume movement of real orders for a side of a single contract number.
typedef struct _ImpliedOrderReplacedMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3
  UINT16BE trade_date;           // bytes 4 to 5
  UINT32BE contract_number;      // bytes 6 to 9
  UINT8 side;                    // byte 10
  UINT64BE order_number;         // bytes 11 to 18
  UINT32BE order_book_priority;  // bytes 19 to 22
  UINT32BE quantity;             // bytes 23 to 26
  UINT32BE price;                // bytes 27 to 30, signed, read here as unsigned
} ImpliedOrderReplacedMessage;

// This message is the same format as the Order Deleted message, except this deletion refers to an implied order. When received, any implied volume is no longer accessible so the implied order of the indicated side must be removed from the book.
typedef struct _ImpliedOrderDeletedMessage {
  UINT32BE nanoseconds;      // bytes 0 to 3
  UINT16BE trade_date;       // bytes 4 to 5
  UINT32BE contract_number;  // bytes 6 to 9
  UINT8 side;                // byte 10
  UINT64BE order_number;     // bytes 11 to 18
} ImpliedOrderDeletedMessage;

// Contract Legs
typedef struct _ContractLegs {
  UINT32BE contract_number;  // bytes 0 to 3
  UINT8 side;                // byte 4
  UINT16BE ratio;            // bytes 5 to 6
  UINT32BE price;            // bytes 7 to 10, signed, read here as unsigned
} ContractLegs;

// Any resting Custom Market Order that trades will be reported using the Custom Market Executed or Custom Market Trade message.
typedef struct _CustomMarketOrderAddedMessage {
  UINT32BE nanoseconds;                       // bytes 0 to 3
  UINT16BE trade_date;                        // bytes 4 to 5
  UINT64BE order_number;                      // bytes 6 to 13
  UINT32BE order_book_priority;               // bytes 14 to 17
  UINT32BE quantity;                          // bytes 18 to 21
  UINT8 legs;                                 // byte 22
  ContractLegs contract_legs[:byte-size 66];  // bytes 23 to 88
} CustomMarketOrderAddedMessage;

// This message is sent whenever an order in the custom market book has been modified for volume. Custom market order modification messages always include the Order Number of the Custom Market Order Added to which the update applies. To determine the current display volume for an order, subscribers must replace the original volume stated in the Custom Market Order Added message with the quantity stated in the Custom Market Order Replaced message of the same order number.
typedef struct _CustomMarketOrderReplacedMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3
  UINT16BE trade_date;           // bytes 4 to 5
  UINT64BE order_number;         // bytes 6 to 13
  UINT32BE order_book_priority;  // bytes 14 to 17
  UINT32BE quantity;             // bytes 18 to 21
} CustomMarketOrderReplacedMessage;

// This message is sent whenever an order in the custom market book is cancelled by the owner, expired, cancelled by the exchange or purged. All remaining volume is no longer accessible so the order must be removed from the book. A Custom Market Order Deleted message is not sent when an order has traded out.
typedef struct _CustomMarketOrderDeletedMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT16BE trade_date;    // bytes 4 to 5
  UINT64BE order_number;  // bytes 6 to 13
} CustomMarketOrderDeletedMessage;

// This message is sent whenever a resting order of the book is executed in whole or in part where the price and contract number of the order and trade are the same. It is possible to receive several Order Executed messages for the same order reference number if that order is executed in several parts.
typedef struct _OrderExecutedMessage {
  UINT32BE nanoseconds;         // bytes 0 to 3
  UINT16BE trade_date;          // bytes 4 to 5
  UINT32BE contract_number;     // bytes 6 to 9
  UINT8 side;                   // byte 10
  UINT64BE order_number;        // bytes 11 to 18
  UINT32BE quantity_remaining;  // bytes 19 to 22
  UINT8 trade_type;             // byte 23
  UINT32BE match_number;        // bytes 24 to 27
  UINT32BE executed_quantity;   // bytes 28 to 31
  UINT32BE trade_price;         // bytes 32 to 35, signed, read here as unsigned
} OrderExecutedMessage;

// This message is sent whenever two resting orders of the same contract are executed. This can occur in two circumstances: During levelling in whole or in part at a price that could be different from one or both resting order prices.
typedef struct _OrderExecutedWithPriceMessage {
  UINT32BE nanoseconds;                // bytes 0 to 3
  UINT16BE trade_date;                 // bytes 4 to 5
  UINT32BE contract_number;            // bytes 6 to 9
  UINT64BE buying_order_number;        // bytes 10 to 17
  UINT32BE buyer_quantity_remaining;   // bytes 18 to 21
  UINT64BE selling_order_number;       // bytes 22 to 29
  UINT32BE seller_quantity_remaining;  // bytes 30 to 33
  UINT8 trade_type;                    // byte 34
  UINT32BE match_number;               // bytes 35 to 38
  UINT32BE executed_quantity;          // bytes 39 to 42
  UINT32BE trade_price;                // bytes 43 to 46, signed, read here as unsigned
} OrderExecutedWithPriceMessage;

// This message is sent whenever the open leg of a resting spread order is traded in whole or in part where the price and the contract number will be different than the traded contract number. It is possible to receive several Spread Executed messages for the same order number if that order is executed in several parts.
typedef struct _SpreadExecutedMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT16BE trade_date;              // bytes 4 to 5
  UINT32BE contract_number;         // bytes 6 to 9
  UINT8 side;                       // byte 10
  UINT64BE order_number;            // bytes 11 to 18
  UINT32BE quantity_remaining;      // bytes 19 to 22
  UINT8 trade_type;                 // byte 23
  UINT32BE match_number;            // bytes 24 to 27
  UINT32BE executed_quantity;       // bytes 28 to 31
  UINT32BE trade_price;             // bytes 32 to 35, signed, read here as unsigned
  UINT32BE traded_contract_number;  // bytes 36 to 39
  UINT32BE spread_trade_price;      // bytes 40 to 43, signed, read here as unsigned
  UINT8 trade_side_of_leg;          // byte 44
  UINT8 printable;                  // byte 45
} SpreadExecutedMessage;

// This message is sent whenever two resting orders of different contracts are executed in whole or in part at a price different from the initial display price(s) such as sweeping or spreading orders. Since the execution price is different than the display price of the original Add Order, a trade price field is included within the execution message.
typedef struct _TradeSpreadExecutionChainMessage {
  UINT32BE nanoseconds;                // bytes 0 to 3
  UINT16BE trade_date;                 // bytes 4 to 5
  UINT32BE buyer;                      // bytes 6 to 9
  UINT8 side_of_buyer;                 // byte 10
  UINT64BE buyer_order_number;         // bytes 11 to 18
  UINT32BE buyer_quantity_remaining;   // bytes 19 to 22
  UINT32BE seller_contract_number;     // bytes 23 to 26
  UINT8 side_of_seller;                // byte 27
  UINT64BE selling_order_number;       // bytes 28 to 35
  UINT32BE seller_quantity_remaining;  // bytes 36 to 39
  UINT8 trade_type;                    // byte 40
  UINT32BE match_number;               // bytes 41 to 44
  UINT32BE executed_quantity;          // bytes 45 to 48
  UINT32BE trade_price;                // bytes 49 to 52, signed, read here as unsigned
  UINT32BE traded_contract_number;     // bytes 53 to 56
  UINT32BE spread_trade_price;         // bytes 57 to 60, signed, read here as unsigned
  UINT8 printable;                     // byte 61
} TradeSpreadExecutionChainMessage;

// This message is sent whenever the open leg of a resting custom market order is traded in whole or in part.
typedef struct _CustomMarketExecutedMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT16BE trade_date;              // bytes 4 to 5
  UINT64BE order_number;            // bytes 6 to 13
  UINT32BE quantity_remaining;      // bytes 14 to 17
  UINT8 trade_type;                 // byte 18
  UINT32BE match_number;            // bytes 19 to 22
  UINT32BE executed_quantity;       // bytes 23 to 26
  UINT32BE trade_price;             // bytes 27 to 30, signed, read here as unsigned
  UINT32BE traded_contract_number;  // bytes 31 to 34
  UINT8 trade_side_of_leg;          // byte 35
  UINT8 printable;                  // byte 36
} CustomMarketExecutedMessage;

// This message is sent whenever a resting custom market order is matched with a resting non-custom market order executed in whole or in part at a price that could be different from the initial display price(s) such as spreading orders. Since the execution price could be different than the display price of the original Order Added, a trade price field is included within the execution message.
typedef struct _CustomMarketTradeMessage {
  UINT32BE nanoseconds;                       // bytes 0 to 3
  UINT16BE trade_date;                        // bytes 4 to 5
  UINT32BE contract_number;                   // bytes 6 to 9
  UINT8 side;                                 // byte 10
  UINT64BE order_number;                      // bytes 11 to 18
  UINT32BE quantity_remaining;                // bytes 19 to 22
  UINT64BE custom_market_order_number;        // bytes 23 to 30
  UINT32BE custom_market_quantity_remaining;  // bytes 31 to 34
  UINT8 trade_type;                           // byte 35
  UINT32BE match_number;                      // bytes 36 to 39
  UINT32BE executed_quantity;                 // bytes 40 to 43
  UINT32BE trade_price;                       // bytes 44 to 47, signed, read here as unsigned
  UINT32BE traded_contract_number;            // bytes 48 to 51
  UINT8 trade_side_of_non_custom_order;       // byte 52
  UINT8 printable;                            // byte 53
} CustomMarketTradeMessage;

// This message is sent whenever a trade is cancelled by exchange operations. This message does not affect any resting orders and is more for Information purposes. Adjustments to the Open, High, Low, Last will be performed as separate action using the Open, High, Low, Last Trade Adjustment message.
typedef struct _TradeCancellationMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT16BE trade_date;    // bytes 4 to 5
  UINT32BE match_number;  // bytes 6 to 9
} TradeCancellationMessage;

// ASX Trade24 disseminates equilibrium prices during a price discovery period. As orders are added, modified, cancelled or deleted a message will be reported informing the market the potential opening price.
typedef struct _EquilibriumPriceAuctionInfoMessage {
  UINT32BE nanoseconds;        // bytes 0 to 3
  UINT16BE trade_date;         // bytes 4 to 5
  UINT32BE contract_number;    // bytes 6 to 9
  UINT32BE equilibrium_price;  // bytes 10 to 13, signed, read here as unsigned
  UINT32BE best_bid_price;     // bytes 14 to 17, signed, read here as unsigned
  UINT32BE best_ask_price;     // bytes 18 to 21, signed, read here as unsigned
  UINT32BE best_bid_quantity;  // bytes 22 to 25
  UINT32BE best_ask_quantity;  // bytes 26 to 29
} EquilibriumPriceAuctionInfoMessage;

// ASX Trade24 disseminates market trade price adjustments where the exchange operator modifies the open, high, low, last, last volume, total traded volume or total number of trades (usually due to a trade cancellation) or the product resets the open, high, low, last, last volume when it moves to the next session within the trade date. Each price is re-distributed with the Market Updates bitwise flags indicating which fields have been adjusted. This message is also issued during a snapshot download to enable the requestor to generate an up-to-date market image without having to regenerate from previous trades and market trade adjustment messages.
typedef struct _OpenHighLowLastTradeAdjustmentMessage {
  UINT32BE nanoseconds;                              // bytes 0 to 3
  UINT16BE trade_date;                               // bytes 4 to 5
  UINT32BE contract_number;                          // bytes 6 to 9
  UINT32BE opening_trade;                            // bytes 10 to 13, signed, read here as unsigned
  UINT32BE highest_trade;                            // bytes 14 to 17, signed, read here as unsigned
  UINT32BE lowest_trade;                             // bytes 18 to 21, signed, read here as unsigned
  UINT32BE last_trade;                               // bytes 22 to 25, signed, read here as unsigned
  UINT32BE last_volume;                              // bytes 26 to 29
  UINT32BE total_traded_volume;                      // bytes 30 to 33
  UINT32BE total_trades;                             // bytes 34 to 37
  UINT8BE all_fields : 2;                            // byte 38
  UINT8BE last_traded_volume : 1;                    // byte 38
  UINT8BE last_traded_price : 1;                     // byte 38
  UINT8BE total_traded_volume_and_total_trades : 1;  // byte 38
  UINT8BE lowest_traded_price : 1;                   // byte 38
  UINT8BE highest_traded_price : 1;                  // byte 38
  UINT8BE opening_trade_price : 1;                   // byte 38
} OpenHighLowLastTradeAdjustmentMessage;

// ASX Trade24 disseminates settlement prices for all future and option contracts in two instalments, an interim and then a final. When the contract moves to the next trade date, the Future Symbol Directory or Option Symbol Directory message will reflect the final settlement price reported from the previous trade date in the prior day settlement field.
typedef struct _MarketSettlementMessage {
  UINT32BE nanoseconds;       // bytes 0 to 3
  UINT16BE trade_date;        // bytes 4 to 5
  UINT32BE contract_number;   // bytes 6 to 9
  UINT32BE settlement_price;  // bytes 10 to 13, signed, read here as unsigned
  UINT32BE volatility;        // bytes 14 to 17
  UINT8 settlement_type;      // byte 18
} MarketSettlementMessage;

// ASX Trade24 disseminates text messages to inform the market of ad hoc events.
typedef struct _AdHocTextMessage {
  UINT32BE nanoseconds;     // bytes 0 to 3
  UINT16BE trade_date;      // bytes 4 to 5
  UINT8 source_id[6];       // bytes 6 to 11
  UINT8 text_message[100];  // bytes 12 to 111
} AdHocTextMessage;

// ASX Trade24 disseminates anonymous non-custom RFQs from the market.
typedef struct _RequestForQuoteMessage {
  UINT32BE nanoseconds;      // bytes 0 to 3
  UINT16BE trade_date;       // bytes 4 to 5
  UINT32BE contract_number;  // bytes 6 to 9
  UINT32BE price;            // bytes 10 to 13, signed, read here as unsigned
  UINT32BE quantity;         // bytes 14 to 17
} RequestForQuoteMessage;

// ASX Trade24 reports this message to inform the market of setting, zeroing or adjusting the Extreme Trade Range price (ETR), the Anomalous Order Threshold price (AOT) and the associated ranges for a contract that requires Market Integrity Rules enforcement.
typedef struct _AnomalousOrderThresholdPublishMessage {
  UINT32BE nanoseconds;      // bytes 0 to 3
  UINT16BE trade_date;       // bytes 4 to 5
  UINT32BE contract_number;  // bytes 6 to 9
  UINT32BE aot_price;        // bytes 10 to 13, signed, read here as unsigned
  UINT32BE aot_upper_price;  // bytes 14 to 17, signed, read here as unsigned
  UINT32BE aot_lower_price;  // bytes 18 to 21, signed, read here as unsigned
  UINT32BE etr_price;        // bytes 22 to 25, signed, read here as unsigned
  UINT32BE etr_upper_price;  // bytes 26 to 29, signed, read here as unsigned
  UINT32BE etr_lower_price;  // bytes 30 to 33, signed, read here as unsigned
} AnomalousOrderThresholdPublishMessage;

// ASX Trade24 disseminates volume and open interest information for each trade date. The VOI Trade Date indicates the trade date to which the information applies.
typedef struct _VolumeAndOpenInterestMessage {
  UINT32BE nanoseconds;        // bytes 0 to 3
  UINT16BE trade_date;         // bytes 4 to 5
  UINT32BE contract_number;    // bytes 6 to 9
  UINT32BE cumulative_volume;  // bytes 10 to 13
  UINT32BE open_interest;      // bytes 14 to 17
  UINT16BE voi_trade_date;     // bytes 18 to 19
} VolumeAndOpenInterestMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: TimeMessage time_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x66: FutureSymbolDirectoryMessage future_symbol_directory_message;
    case 0x67: SpreadSymbolDirectoryMessage spread_symbol_directory_message;
    case 0x68: OptionSymbolDirectoryMessage option_symbol_directory_message;
    case 0x4F: OrderBookStateMessage order_book_state_message;
    case 0x41: OrderAddedMessage order_added_message;
    case 0x55: OrderReplacedMessage order_replaced_message;
    case 0x58: OrderVolumeCancelledMessage order_volume_cancelled_message;
    case 0x44: OrderDeletedMessage order_deleted_message;
    case 0x6A: ImpliedOrderAddedMessage implied_order_added_message;
    case 0x6C: ImpliedOrderReplacedMessage implied_order_replaced_message;
    case 0x6B: ImpliedOrderDeletedMessage implied_order_deleted_message;
    case 0x6D: CustomMarketOrderAddedMessage custom_market_order_added_message;
    case 0x6E: CustomMarketOrderReplacedMessage custom_market_order_replaced_message;
    case 0x72: CustomMarketOrderDeletedMessage custom_market_order_deleted_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceMessage order_executed_with_price_message;
    case 0x65: SpreadExecutedMessage spread_executed_message;
    case 0x50: TradeSpreadExecutionChainMessage trade_spread_execution_chain_message;
    case 0x75: CustomMarketExecutedMessage custom_market_executed_message;
    case 0x70: CustomMarketTradeMessage custom_market_trade_message;
    case 0x42: TradeCancellationMessage trade_cancellation_message;
    case 0x5A: EquilibriumPriceAuctionInfoMessage equilibrium_price_auction_info_message;
    case 0x74: OpenHighLowLastTradeAdjustmentMessage open_high_low_last_trade_adjustment_message;
    case 0x59: MarketSettlementMessage market_settlement_message;
    case 0x78: AdHocTextMessage ad_hoc_text_message;
    case 0x71: RequestForQuoteMessage request_for_quote_message;
    case 0x57: AnomalousOrderThresholdPublishMessage anomalous_order_threshold_publish_message;
    case 0x56: VolumeAndOpenInterestMessage volume_and_open_interest_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  Session session;                                                                                                             // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

