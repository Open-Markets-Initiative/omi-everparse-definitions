// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, UdpPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NseEquities_Standard_v19_5.3d
//
// What this definition reads more loosely than the model states:
// - a union, several readings of the same bytes, is read as the bytes it occupies

// ---- Values ------------------------------------------------------------------

// Message Type Large Classification: one byte code
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_ISSUE_REALTIME_MESSAGE 0x31  // Issue Realtime Message
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_STATISTICS_MESSAGE 0x32      // Statistics Message
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_INDEX_MESSAGE 0x33           // Index Message
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_ISSUE_BASIC_MESSAGE 0x34     // Issue Basic Message
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_CONTROL_MESSAGE 0x39         // Control Message

// Exchange Code: one byte code
#define EXCHANGE_CODE_TOKYO_STOCK_EXCHANGE 0x31         // Tokyo Stock Exchange
#define EXCHANGE_CODE_NAGOYA_STOCK_EXCHANGE 0x33        // Nagoya Stock Exchange
#define EXCHANGE_CODE_FUKUOKA_STOCK_EXCHANGE 0x36       // Fukuoka Stock Exchange
#define EXCHANGE_CODE_SAPPORO_SECURITIES_EXCHANGE 0x38  // Sapporo Securities Exchange
#define EXCHANGE_CODE_OTHER 0x30                        // Other
#define EXCHANGE_CODE_CONTROL_MESSAGE 0x20              // Control Message

// Issue Classification Large Classification: 2 byte code
#define ISSUE_CLASSIFICATION_LARGE_CLASSIFICATION_STOCKRELATED 0x3031  // Stockrelated
#define ISSUE_CLASSIFICATION_LARGE_CLASSIFICATION_CBRELATED 0x3032     // Cbrelated

// Tag ID: 2 byte code
#define TAG_I_D_UPDATE_NO_MESSAGE 0x4E4F                        // Update No Message
#define TAG_I_D_STATUS_INFORMATION_MESSAGE 0x5354               // Status Information Message
#define TAG_I_D_OPEN_HIGH_LOW_AND_CURRENT_PRICE_MESSAGE 0x3450  // Open High Low And Current Price Message
#define TAG_I_D_QUOTE_1_MESSAGE 0x5131                          // Quote 1 Message
#define TAG_I_D_QUOTE_2_MESSAGE 0x5132                          // Quote 2 Message
#define TAG_I_D_QUOTE_3_MESSAGE 0x5133                          // Quote 3 Message
#define TAG_I_D_QUOTE_4_MESSAGE 0x5134                          // Quote 4 Message
#define TAG_I_D_QUOTE_5_MESSAGE 0x5135                          // Quote 5 Message
#define TAG_I_D_QUOTE_6_MESSAGE 0x5136                          // Quote 6 Message
#define TAG_I_D_QUOTE_7_MESSAGE 0x5137                          // Quote 7 Message
#define TAG_I_D_QUOTE_8_MESSAGE 0x5138                          // Quote 8 Message
#define TAG_I_D_QUOTE_9_MESSAGE 0x5139                          // Quote 9 Message
#define TAG_I_D_QUOTE_10_MESSAGE 0x5141                         // Quote 10 Message
#define TAG_I_D_MARKET_ORDER_MESSAGE 0x514D                     // Market Order Message
#define TAG_I_D_OVER_UNDER_MESSAGE 0x514F                       // Over Under Message
#define TAG_I_D_TRADING_VOLUME_MESSAGE 0x564C                   // Trading Volume Message
#define TAG_I_D_TURNOVER_MESSAGE 0x5641                         // Turnover Message
#define TAG_I_D_VWAP_MESSAGE 0x5657                             // Vwap Message
#define TAG_I_D_PARITY_MESSAGE 0x5041                           // Parity Message
#define TAG_I_D_YIELD_MESSAGE 0x5949                            // Yield Message
#define TAG_I_D_CONTROL_MESSAGE 0x4C43                          // Control Message

// Change Flag: one byte code
#define CHANGE_FLAG_CHANGED 0x31      // Changed
#define CHANGE_FLAG_NOT_CHANGED 0x20  // Not Changed

// Short Selling Regulation Flag: one byte code
#define SHORT_SELLING_REGULATION_FLAG_SHORT_SELLING_REGULATION_DOES_NOT_APPLY 0x30  // Short Selling Regulation Does Not Apply
#define SHORT_SELLING_REGULATION_FLAG_SHORT_SELLING_REGULATION_IS_APPLIED 0x31      // Short Selling Regulation Is Applied

// Unit Flag: one byte code
#define UNIT_FLAG_TO_THE_FOURTH_DECIMAL_PLACE 0x30  // To The Fourth Decimal Place
#define UNIT_FLAG_TO_THE_THIRD_DECIMAL_PLACE 0x31   // To The Third Decimal Place
#define UNIT_FLAG_TO_THE_SECOND_DECIMAL_PLACE 0x32  // To The Second Decimal Place
#define UNIT_FLAG_TO_THE_FIRST_DECIMAL_PLACE 0x33   // To The First Decimal Place
#define UNIT_FLAG_NO_DECIMAL_PLACES 0x34            // No Decimal Places
#define UNIT_FLAG_NO_NUMERICAL_VALUE 0x20           // No Numerical Value

// Sign: one byte code
#define SIGN_POSITIVE 0x2B  // Positive
#define SIGN_NO_SIGN 0x20   // No Sign

// Limit Up Flag: one byte code
#define LIMIT_UP_FLAG_LIMIT_UP 0x31              // Limit Up
#define LIMIT_UP_FLAG_OTHER_THAN_THE_ABOVE 0x20  // Other Than The Above

// Limit Down Flag: one byte code
#define LIMIT_DOWN_FLAG_LIMIT_DOWN 0x31            // Limit Down
#define LIMIT_DOWN_FLAG_OTHER_THAN_THE_ABOVE 0x20  // Other Than The Above

// Current Change Flag: one byte code
#define CURRENT_CHANGE_FLAG_CHANGED_GOING_UP 0x31          // Changed Going Up
#define CURRENT_CHANGE_FLAG_CHANGED_GOING_DOWN 0x32        // Changed Going Down
#define CURRENT_CHANGE_FLAG_CHANGED_SAME 0x33              // Changed Same
#define CURRENT_CHANGE_FLAG_CHANGED_OTHER_THAN_ABOVE 0x34  // Changed Other Than Above
#define CURRENT_CHANGE_FLAG_OTHER_THAN_THE_ABOVE 0x20      // Other Than The Above

// Stq Reference Point Flag: one byte code
#define STQ_REFERENCE_POINT_FLAG_REFERENCE_EXECUTION_SET_BY_THIS_TRADE 0x31  // Reference Execution Set By This Trade
#define STQ_REFERENCE_POINT_FLAG_OTHER_THAN_THE_ABOVE 0x20                   // Other Than The Above

// Closing Price Input Flag: one byte code
#define CLOSING_PRICE_INPUT_FLAG_TRADE_NOT_ESTABLISHED_AT_CLOSING 0x31  // Trade Not Established At Closing
#define CLOSING_PRICE_INPUT_FLAG_TRADE_ESTABLISHED_WITH_CLOSING 0x32    // Trade Established With Closing
#define CLOSING_PRICE_INPUT_FLAG_OTHER_THAN_THE_ABOVE 0x20              // Other Than The Above

// Quote Flag: one byte code
#define QUOTE_FLAG_QUOTE_BEFORE_OPENING 0x30                             // Quote Before Opening
#define QUOTE_FLAG_GENERAL_QUOTE 0x31                                    // General Quote
#define QUOTE_FLAG_GENERAL_QUOTE_UNDER_TRANSACTION 0x32                  // General Quote Under Transaction
#define QUOTE_FLAG_SPECIAL_QUOTE 0x33                                    // Special Quote
#define QUOTE_FLAG_SEQUENTIAL_TRADE_QUOTE 0x34                           // Sequential Trade Quote
#define QUOTE_FLAG_TEMPORARY_QUOTE_AT_THE_BEGINNING_OF_PRE_CLOSING 0x35  // Temporary Quote At The Beginning Of Pre Closing
#define QUOTE_FLAG_QUOTE_AFTER_SPECIAL_EXECUTION 0x36                    // Quote After Special Execution
#define QUOTE_FLAG_SPECIAL_QUOTE_BEFORE_TRADING_HALT 0x37                // Special Quote Before Trading Halt
#define QUOTE_FLAG_SEQUENTIAL_TRADE_QUOTE_BEFORE_TRADING_HALT 0x38       // Sequential Trade Quote Before Trading Halt
#define QUOTE_FLAG_NO_QUOTES_OR_ALL_QUOTES_ARE_CANCELLED 0x20            // No Quotes Or All Quotes Are Cancelled

// Trading Volume Turnover Unit Flag: one byte code
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_ONE 0x30                 // One
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_TEN 0x31                 // Ten
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_HUNDRED 0x32             // Hundred
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_THOUSAND 0x33            // Thousand
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_TEN_THOUSAND 0x34        // Ten Thousand
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_HUNDRED_THOUSAND 0x35    // Hundred Thousand
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_MILLION 0x36             // Million
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_TEN_MILLION 0x37         // Ten Million
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_HUNDRED_MILLION 0x38     // Hundred Million
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_BILLION 0x39             // Billion
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_NO_NUMERICAL_VALUE 0x20  // No Numerical Value

// Lot Size Unit Flag: one byte code
#define LOT_SIZE_UNIT_FLAG_TO_THE_FOURTH_DECIMAL_PLACE 0x30  // To The Fourth Decimal Place
#define LOT_SIZE_UNIT_FLAG_TO_THE_THIRD_DECIMAL_PLACE 0x31   // To The Third Decimal Place
#define LOT_SIZE_UNIT_FLAG_TO_THE_SECOND_DECIMAL_PLACE 0x32  // To The Second Decimal Place
#define LOT_SIZE_UNIT_FLAG_TO_THE_FIRST_DECIMAL_PLACE 0x33   // To The First Decimal Place
#define LOT_SIZE_UNIT_FLAG_NO_DECIMAL_PLACES 0x34            // No Decimal Places
#define LOT_SIZE_UNIT_FLAG_NO_NUMERICAL_VALUE 0x20           // No Numerical Value

// Test Mode Flag: one byte code
#define TEST_MODE_FLAG_PRODUCTION_OPERATION 0x31  // Production Operation
#define TEST_MODE_FLAG_TEST_OPERATION 0x32        // Test Operation

// Start End Flag: one byte code
#define START_END_FLAG_START 0x31                 // Start
#define START_END_FLAG_END 0x32                   // End
#define START_END_FLAG_HEALTH_CHECK_CONTROL 0x20  // Health Check Control

// Separation Of Tag: one byte code
#define SEPARATION_OF_TAG_SEPARATION_BETWEEN_TAG 0x13  // Separation Between Tag
#define SEPARATION_OF_TAG_END_OF_MESSAGE 0x11          // End Of Message

// ---- Types -------------------------------------------------------------------

// Numbered from 1 on each Multicast Group, with the multicast group number in the first to third byte
typedef struct _MessageSerialNo {
  UINT8 multicast_group_number[3];  // bytes 0 to 2
  UINT8 sequence_number[8];         // bytes 3 to 10
} MessageSerialNo;

// Large Classification indicates Message Type, and Medium Classification indicates details and other information
typedef struct _MessageType {
  UINT8 message_type_large_classification;      // byte 0
  UINT8 message_type_medium_classification[2];  // bytes 1 to 2
} MessageType;

// Jpx Flex 39 byte service header, common to all message types
typedef struct _ServiceHeader {
  UINT8 message_length[6];                              // bytes 0 to 5
  MessageSerialNo message_serial_no;                    // bytes 6 to 16
  MessageType message_type;                             // bytes 17 to 19
  UINT8 exchange_code;                                  // byte 20
  UINT8 session_distinction[2];                         // bytes 21 to 22
  UINT16BE issue_classification_large_classification;   // bytes 23 to 24
  UINT8 issue_classification_medium_classification[2];  // bytes 25 to 26
  UINT8 issue_code[12];                                 // bytes 27 to 38
} ServiceHeader;

// In this tag, Update Number for each issue is set. This tag appears as part of realtime data.
typedef struct _UpdateNoMessage {
  UINT8 update_no[8];  // bytes 0 to 7
} UpdateNoMessage;

// Status Information
typedef struct _StatusInformation {
  UINT8 issue_status[2];                // bytes 0 to 1
  UINT8 status_flag[2];                 // bytes 2 to 3
  UINT8 short_selling_regulation_flag;  // byte 4
} StatusInformation;

// In this tag, status information (Issue Status, Status Flag and Short Selling Regulation Flag) is set. This tag appears as part of realtime data.
typedef struct _StatusInformationMessage {
  UINT8 reserved_2[2];                   // bytes 0 to 1
  UINT8 change_flag;                     // byte 2
  StatusInformation status_information;  // bytes 3 to 7
  UINT8 precise_time[12];                // bytes 8 to 19
  UINT8 reserved_4[4];                   // bytes 20 to 23
} StatusInformationMessage;

// Price
typedef struct _Price {
  UINT8 unit_flag;        // byte 0
  UINT8 price_value[14];  // bytes 1 to 14
  UINT8 sign;             // byte 15
} Price;

// Open
typedef struct _Open {
  Price price;        // bytes 0 to 15
  UINT8 time[6];      // bytes 16 to 21
  UINT8 change_flag;  // byte 22
} Open;

// High
typedef struct _High {
  UINT8 limit_up_flag;  // byte 0
  Price price;          // bytes 1 to 16
  UINT8 time[6];        // bytes 17 to 22
  UINT8 change_flag;    // byte 23
} High;

// Low
typedef struct _Low {
  UINT8 limit_down_flag;  // byte 0
  Price price;            // bytes 1 to 16
  UINT8 time[6];          // bytes 17 to 22
  UINT8 change_flag;      // byte 23
} Low;

// Current
typedef struct _Current {
  Price price;                     // bytes 0 to 15
  UINT8 precise_time[12];          // bytes 16 to 27
  UINT8 current_change_flag;       // byte 28
  UINT8 stq_reference_point_flag;  // byte 29
  UINT8 reserved_1;                // byte 30
  UINT8 closing_price_input_flag;  // byte 31
} Current;

// In this tag, Open, High, Low and Current Price and other information are set. This tag appears as part of realtime data.
typedef struct _OpenHighLowAndCurrentPriceMessage {
  UINT8 reserved_2[2];  // bytes 0 to 1
  Open open_;           // bytes 2 to 24
  High high;            // bytes 25 to 48
  Low low;              // bytes 49 to 72
  Current current;      // bytes 73 to 104
} OpenHighLowAndCurrentPriceMessage;

// Quote Quantity
typedef struct _QuoteQuantity {
  UINT8 trading_volume_turnover_unit_flag;  // byte 0
  UINT8 quantity[14];                       // bytes 1 to 14
  UINT8 sign;                               // byte 15
} QuoteQuantity;

// Ask Quote
typedef struct _AskQuote {
  UINT8 change_flag;             // byte 0
  Price price;                   // bytes 1 to 16
  UINT8 precise_time[12];        // bytes 17 to 28
  UINT8 quote_flag;              // byte 29
  QuoteQuantity quote_quantity;  // bytes 30 to 45
} AskQuote;

// Bid Quote
typedef struct _BidQuote {
  UINT8 change_flag;             // byte 0
  Price price;                   // bytes 1 to 16
  UINT8 precise_time[12];        // bytes 17 to 28
  UINT8 quote_flag;              // byte 29
  QuoteQuantity quote_quantity;  // bytes 30 to 45
} BidQuote;

// In this tag, Quote 1 (Ask and Bid Quotes with the Highest Priority) information is set. This tag appears as part of realtime data.
typedef struct _Quote1Message {
  UINT8 reserved_2[2];  // bytes 0 to 1
  AskQuote ask_quote;   // bytes 2 to 47
  BidQuote bid_quote;   // bytes 48 to 93
} Quote1Message;

// In this tag, Quote 2 (ask and bid quotes with the 2nd Highest Priority) information is set. This tag appears as part of realtime data.
typedef struct _Quote2Message {
  UINT8 reserved_2[2];  // bytes 0 to 1
  AskQuote ask_quote;   // bytes 2 to 47
  BidQuote bid_quote;   // bytes 48 to 93
} Quote2Message;

// In this tag, Quote 3 (ask and bid quotes with the 3rd Highest Priority) information is set. This tag appears as part of realtime data.
typedef struct _Quote3Message {
  UINT8 reserved_2[2];  // bytes 0 to 1
  AskQuote ask_quote;   // bytes 2 to 47
  BidQuote bid_quote;   // bytes 48 to 93
} Quote3Message;

// In this tag, Quote 4 (ask and bid quotes with the 4th Highest Priority) information is set. This tag appears as part of realtime data.
typedef struct _Quote4Message {
  UINT8 reserved_2[2];  // bytes 0 to 1
  AskQuote ask_quote;   // bytes 2 to 47
  BidQuote bid_quote;   // bytes 48 to 93
} Quote4Message;

// In this tag, Quote 5 (ask and bid quotes with the 5th Highest Priority) information is set. This tag appears as part of realtime data.
typedef struct _Quote5Message {
  UINT8 reserved_2[2];  // bytes 0 to 1
  AskQuote ask_quote;   // bytes 2 to 47
  BidQuote bid_quote;   // bytes 48 to 93
} Quote5Message;

// In this tag, Quote 6 (ask and bid quotes with the 6th Highest Priority) information is set. This tag appears as part of realtime data.
typedef struct _Quote6Message {
  UINT8 reserved_2[2];  // bytes 0 to 1
  AskQuote ask_quote;   // bytes 2 to 47
  BidQuote bid_quote;   // bytes 48 to 93
} Quote6Message;

// In this tag, Quote 7 (ask and bid quotes with the 7th Highest Priority) information is set. This tag appears as part of realtime data.
typedef struct _Quote7Message {
  UINT8 reserved_2[2];  // bytes 0 to 1
  AskQuote ask_quote;   // bytes 2 to 47
  BidQuote bid_quote;   // bytes 48 to 93
} Quote7Message;

// In this tag, Quote 8 (ask and bid quotes with the 8th Highest Priority) information is set. This tag appears as part of realtime data.
typedef struct _Quote8Message {
  UINT8 reserved_2[2];  // bytes 0 to 1
  AskQuote ask_quote;   // bytes 2 to 47
  BidQuote bid_quote;   // bytes 48 to 93
} Quote8Message;

// In this tag, Quote 9 (ask and bid quotes with the 9th Highest Priority) information is set. This tag appears as part of realtime data.
typedef struct _Quote9Message {
  UINT8 reserved_2[2];  // bytes 0 to 1
  AskQuote ask_quote;   // bytes 2 to 47
  BidQuote bid_quote;   // bytes 48 to 93
} Quote9Message;

// In this tag, Quote 10 (ask and bid quotes with the 10th Highest Priority) information is set. This tag appears as part of realtime data.
typedef struct _Quote10Message {
  UINT8 reserved_2[2];  // bytes 0 to 1
  AskQuote ask_quote;   // bytes 2 to 47
  BidQuote bid_quote;   // bytes 48 to 93
} Quote10Message;

// Sell Order
typedef struct _SellOrder {
  UINT8 change_flag;             // byte 0
  UINT8 precise_time[12];        // bytes 1 to 12
  QuoteQuantity quote_quantity;  // bytes 13 to 28
} SellOrder;

// Buy Order
typedef struct _BuyOrder {
  UINT8 change_flag;             // byte 0
  UINT8 precise_time[12];        // bytes 1 to 12
  QuoteQuantity quote_quantity;  // bytes 13 to 28
} BuyOrder;

// In this tag, both Ask and Bid Market Order Information is set. This tag appears as part of realtime data.
typedef struct _MarketOrderMessage {
  UINT8 reserved_2[2];   // bytes 0 to 1
  SellOrder sell_order;  // bytes 2 to 30
  BuyOrder buy_order;    // bytes 31 to 59
} MarketOrderMessage;

// OVER Quote
typedef struct _OverQuote {
  UINT8 change_flag;             // byte 0
  UINT8 precise_time[12];        // bytes 1 to 12
  QuoteQuantity quote_quantity;  // bytes 13 to 28
} OverQuote;

// UNDER Quote
typedef struct _UnderQuote {
  UINT8 change_flag;             // byte 0
  UINT8 precise_time[12];        // bytes 1 to 12
  QuoteQuantity quote_quantity;  // bytes 13 to 28
} UnderQuote;

// In this tag, OVER/UNDER quote (Total of quote 11 (Ask) and above or quote 11 (Bid) and below) information is set. This tag is appeared as one of realtime data.
typedef struct _OverUnderMessage {
  UINT8 reserved_2[2];     // bytes 0 to 1
  OverQuote over_quote;    // bytes 2 to 30
  UnderQuote under_quote;  // bytes 31 to 59
} OverUnderMessage;

// Trading Volume
typedef struct _TradingVolume {
  UINT8 reserved_1;                         // byte 0
  UINT8 trading_volume_turnover_unit_flag;  // byte 1
  UINT8 trading_volume_value[14];           // bytes 2 to 15
  UINT8 time[6];                            // bytes 16 to 21
  UINT8 second_reserved_1;                  // byte 22
} TradingVolume;

// In this tag, by-issue trading volume information is set. This tag appears as part of realtime data.
typedef struct _TradingVolumeMessage {
  UINT8 reserved_2[2];           // bytes 0 to 1
  TradingVolume trading_volume;  // bytes 2 to 24
} TradingVolumeMessage;

// Turnover in yen value
typedef struct _TurnoverInYenValue {
  UINT8 reserved_1;                         // byte 0
  UINT8 trading_volume_turnover_unit_flag;  // byte 1
  UINT8 turnover_value[14];                 // bytes 2 to 15
  UINT8 time[6];                            // bytes 16 to 21
  UINT8 second_reserved_1;                  // byte 22
} TurnoverInYenValue;

// In this tag, by-issue Turnover Information is set. This tag appears as part of realtime data.
typedef struct _TurnoverMessage {
  UINT8 reserved_2[2];                       // bytes 0 to 1
  TurnoverInYenValue turnover_in_yen_value;  // bytes 2 to 24
} TurnoverMessage;

// All-Day VWAP
typedef struct _AllDayVwap {
  UINT8 reserved_1;              // byte 0
  UINT8 lot_size_unit_flag;      // byte 1
  UINT8 all_day_vwap_value[14];  // bytes 2 to 15
  UINT8 sign;                    // byte 16
  UINT8 time[6];                 // bytes 17 to 22
  UINT8 second_reserved_1;       // byte 23
} AllDayVwap;

// Current-Session VWAP
typedef struct _CurrentSessionVwap {
  UINT8 reserved_1;                      // byte 0
  UINT8 lot_size_unit_flag;              // byte 1
  UINT8 current_session_vwap_value[14];  // bytes 2 to 15
  UINT8 sign;                            // byte 16
  UINT8 time[6];                         // bytes 17 to 22
  UINT8 second_reserved_1;               // byte 23
} CurrentSessionVwap;

// In this tag, by-issue Volume Weighted Stock Price average (VWAP) Information is set. This tag appears as part of realtime data.
typedef struct _VwapMessage {
  UINT8 reserved_2[2];                      // bytes 0 to 1
  AllDayVwap all_day_vwap;                  // bytes 2 to 25
  CurrentSessionVwap current_session_vwap;  // bytes 26 to 49
} VwapMessage;

// Parity/Estimated Price
typedef struct _ParityEstimatedPrice {
  UINT8 unit_flag;                         // byte 0
  UINT8 parity_estimated_price_value[14];  // bytes 1 to 14
  UINT8 sign;                              // byte 15
  UINT8 time[6];                           // bytes 16 to 21
  UINT8 reserved_1;                        // byte 22
} ParityEstimatedPrice;

// In this tag, estimated Price Information for parity of CB is set. This tag appears as part of realtime data.
typedef struct _ParityMessage {
  UINT8 reserved_2[2];                          // bytes 0 to 1
  ParityEstimatedPrice parity_estimated_price;  // bytes 2 to 24
} ParityMessage;

// Direct Yield
typedef struct _DirectYield {
  UINT8 direct_yield_value[8];  // bytes 0 to 7
  UINT8 sign;                   // byte 8
} DirectYield;

// Final Yield
typedef struct _FinalYield {
  UINT8 final_yield_value[8];  // bytes 0 to 7
  UINT8 sign;                  // byte 8
} FinalYield;

// In this tag, Direct and Final Yield Information for CB is set. This tag appears as part of realtime data.
typedef struct _YieldMessage {
  UINT8 reserved_2[2];       // bytes 0 to 1
  DirectYield direct_yield;  // bytes 2 to 10
  FinalYield final_yield;    // bytes 11 to 19
  UINT8 time[6];             // bytes 20 to 25
  UINT8 reserved_1;          // byte 26
} YieldMessage;

// In this tag, the Test Mode Flag and the Start/End Flag that are used in a Control Message are set. This tag appears as part of a Control Message.
typedef struct _ControlMessage {
  UINT8 reserved_2[2];   // bytes 0 to 1
  UINT8 test_mode_flag;  // byte 2
  UINT8 start_end_flag;  // byte 3
  UINT8 time[6];         // bytes 4 to 9
} ControlMessage;

// Branch
casetype _Payload (UINT16 selector) {
  switch (selector) {
    case 0x4E4F: UpdateNoMessage update_no_message;
    case 0x5354: StatusInformationMessage status_information_message;
    case 0x3450: OpenHighLowAndCurrentPriceMessage open_high_low_and_current_price_message;
    case 0x5131: Quote1Message quote_1_message;
    case 0x5132: Quote2Message quote_2_message;
    case 0x5133: Quote3Message quote_3_message;
    case 0x5134: Quote4Message quote_4_message;
    case 0x5135: Quote5Message quote_5_message;
    case 0x5136: Quote6Message quote_6_message;
    case 0x5137: Quote7Message quote_7_message;
    case 0x5138: Quote8Message quote_8_message;
    case 0x5139: Quote9Message quote_9_message;
    case 0x5141: Quote10Message quote_10_message;
    case 0x514D: MarketOrderMessage market_order_message;
    case 0x514F: OverUnderMessage over_under_message;
    case 0x564C: TradingVolumeMessage trading_volume_message;
    case 0x5641: TurnoverMessage turnover_message;
    case 0x5657: VwapMessage vwap_message;
    case 0x5041: ParityMessage parity_message;
    case 0x5949: YieldMessage yield_message;
    case 0x4C43: ControlMessage control_message;
  }
} Payload;

// One tag: its two character Tag ID, its data, and the control code that closes it (DC3 between tags, DC1 at the end of the message)
typedef struct _TagInformation {
  UINT16BE tag_i_d;          // bytes 0 to 1
  Payload(tag_i_d) payload;
  UINT8 separation_of_tag;
} TagInformation;

// ---- Packet: UdpPacket -------------------------------------------------------

// One Flex user message per datagram: DC1, Service Header, DC2, then the tags
entrypoint typedef struct _UdpPacket (UINT32 available) where (available >= 41) {
  UINT8 start_of_message;                                       // byte 0
  ServiceHeader service_header;                                 // bytes 1 to 39
  UINT8 separation_between_service_header_and_data_section;     // byte 40
  TagInformation tag_information[:byte-size (available - 41)];
} UdpPacket;

