// ---- Values ------------------------------------------------------------------

// Message Type Large Classification: one byte code
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_ISSUE_REALTIME_MESSAGE 0x31  // Issue Realtime Message
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_STATISTICS_MESSAGE 0x32      // Statistics Message
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_INDEX_MESSAGE 0x33           // Index Message
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_ISSUE_BASIC_MESSAGE 0x34     // Issue Basic Message
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_CONTROL_MESSAGE 0x39         // Control Message

// Exchange Code: one byte code
#define EXCHANGE_CODE_TOKYO_STOCK_EXCHANGE 0x31         // Tokyo Stock Exchange
#define EXCHANGE_CODE_NAGOYA_STOCK_EXCHANGE 0x33        // Nagoya Stock Exchange
#define EXCHANGE_CODE_FUKUOKA_STOCK_EXCHANGE 0x36       // Fukuoka Stock Exchange
#define EXCHANGE_CODE_SAPPORO_SECURITIES_EXCHANGE 0x38  // Sapporo Securities Exchange
#define EXCHANGE_CODE_OTHER 0x30                        // Other
#define EXCHANGE_CODE_CONTROL_MESSAGE 0x20              // Control Message

// Issue Classification Large Classification: 2 byte code
#define ISSUE_CLASSIFICATION_LARGE_CLASSIFICATION_STOCKRELATED 0x3031  // Stockrelated
#define ISSUE_CLASSIFICATION_LARGE_CLASSIFICATION_CBRELATED 0x3032     // Cbrelated

// Tag ID: 2 byte code
#define TAG_I_D_ISSUE_INFORMATION_MESSAGE 0x4949                   // Issue Information Message
#define TAG_I_D_BASE_PRICE_INFORMATION_MESSAGE 0x4250              // Base Price Information Message
#define TAG_I_D_MULTICAST_GROUP_NUMBER_INFORMATION_MESSAGE 0x4D47  // Multicast Group Number Information Message
#define TAG_I_D_CONTROL_MESSAGE 0x4C43                             // Control Message

// Isin Flag: one byte code
#define ISIN_FLAG_IDENTIFIABLE_BY_THE_INTERNATIONAL_STANDARD_CODE 0x31  // Identifiable By The International Standard Code
#define ISIN_FLAG_OTHER_THAN_THE_ABOVE 0x20                             // Other Than The Above

// New Listing Flag: one byte code
#define NEW_LISTING_FLAG_NEWLY_LISTED_ISSUE 0x31    // Newly Listed Issue
#define NEW_LISTING_FLAG_OTHER_THAN_THE_ABOVE 0x20  // Other Than The Above

// When Issued Transaction Flag: one byte code
#define WHEN_ISSUED_TRANSACTION_FLAG_WHEN_ISSUED_TRANSACTION_ISSUE 0x31  // When Issued Transaction Issue
#define WHEN_ISSUED_TRANSACTION_FLAG_OTHER_THAN_THE_ABOVE 0x20           // Other Than The Above

// Short Selling Price Restriction Applied Flag At The Regular Distribution: one byte code
#define SHORT_SELLING_PRICE_RESTRICTION_APPLIED_FLAG_AT_THE_REGULAR_DISTRIBUTION_THE_ISSUE_THAT_SHORT_SELLING_REGULATION_IS_APPLIED 0x31  // The Issue That Short Selling Regulation Is Applied
#define SHORT_SELLING_PRICE_RESTRICTION_APPLIED_FLAG_AT_THE_REGULAR_DISTRIBUTION_OTHER_THAN_THE_ABOVE 0x20                                // Other Than The Above

// Loan Margin Flag: one byte code
#define LOAN_MARGIN_FLAG_LOAN_ISSUE 0x31                // Loan Issue
#define LOAN_MARGIN_FLAG_MARGIN_TRANSACTION_ISSUE 0x32  // Margin Transaction Issue
#define LOAN_MARGIN_FLAG_OTHER_THAN_THE_ABOVE 0x30      // Other Than The Above

// Securities To Be Delisted Under Supervision Classification: one byte code
#define SECURITIES_TO_BE_DELISTED_UNDER_SUPERVISION_CLASSIFICATION_UNDER_SUPERVISION_PRESENTLY_UNDER_EXAMINATION 0x31                                     // Under Supervision Presently Under Examination
#define SECURITIES_TO_BE_DELISTED_UNDER_SUPERVISION_CLASSIFICATION_UNDER_SUPERVISION_PRESENTLY_UNDER_CONFIRMATION 0x32                                    // Under Supervision Presently Under Confirmation
#define SECURITIES_TO_BE_DELISTED_UNDER_SUPERVISION_CLASSIFICATION_UNDER_SUPERVISION_PRESENTLY_UNDER_EXAMINATION_AND_CONFIRMATION 0x33                    // Under Supervision Presently Under Examination And Confirmation
#define SECURITIES_TO_BE_DELISTED_UNDER_SUPERVISION_CLASSIFICATION_UNDER_SUPERVISION_PRESENTLY_UNDER_EXAMINATION_AND_ON_SPECIAL_ALERT 0x34                // Under Supervision Presently Under Examination And On Special Alert
#define SECURITIES_TO_BE_DELISTED_UNDER_SUPERVISION_CLASSIFICATION_UNDER_SUPERVISION_PRESENTLY_UNDER_CONFIRMATION_AND_ON_SPECIAL_ALERT 0x35               // Under Supervision Presently Under Confirmation And On Special Alert
#define SECURITIES_TO_BE_DELISTED_UNDER_SUPERVISION_CLASSIFICATION_UNDER_SUPERVISION_PRESENTLY_UNDER_EXAMINATION_AND_CONFIRMATION_AND_ON_SPE_148fio 0x36  // Under Supervision Presently Under Examination And Confirmation And On Special Alert
#define SECURITIES_TO_BE_DELISTED_UNDER_SUPERVISION_CLASSIFICATION_TO_BE_DELISTED 0x37                                                                    // To Be Delisted
#define SECURITIES_TO_BE_DELISTED_UNDER_SUPERVISION_CLASSIFICATION_TO_BE_DELISTED_AND_ON_SPECIAL_ALERT 0x38                                               // To Be Delisted And On Special Alert
#define SECURITIES_TO_BE_DELISTED_UNDER_SUPERVISION_CLASSIFICATION_ON_SPECIAL_ALERT 0x39                                                                  // On Special Alert
#define SECURITIES_TO_BE_DELISTED_UNDER_SUPERVISION_CLASSIFICATION_NONE_SPECIFIED 0x30                                                                    // None Specified

