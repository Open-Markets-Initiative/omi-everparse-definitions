#define ARBITRARY_1_CONSTITUENT_ISSUE_OF_TOPIX_CORE_30 0x31  // Constituent Issue Of Topix Core 30
#define ARBITRARY_1_OTHER_THAN_THE_ABOVE 0x20                // Other Than The Above

// Arbitrary 2: one byte code
#define ARBITRARY_2_CONSTITUENT_ISSUE_OF_TOPIX_LARGE_70 0x31  // Constituent Issue Of Topix Large 70
#define ARBITRARY_2_OTHER_THAN_THE_ABOVE 0x20                 // Other Than The Above

// Arbitrary 3: one byte code
#define ARBITRARY_3_CONSTITUENT_ISSUE_OF_TOPIX_100 0x31  // Constituent Issue Of Topix 100
#define ARBITRARY_3_OTHER_THAN_THE_ABOVE 0x20            // Other Than The Above

// Arbitrary 4: one byte code
#define ARBITRARY_4_CONSTITUENT_ISSUE_OF_MID_400 0x31  // Constituent Issue Of Mid 400
#define ARBITRARY_4_OTHER_THAN_THE_ABOVE 0x20          // Other Than The Above

// Arbitrary 5: one byte code
#define ARBITRARY_5_CONSTITUENT_ISSUE_OF_TOPIX_500 0x31  // Constituent Issue Of Topix 500
#define ARBITRARY_5_OTHER_THAN_THE_ABOVE 0x20            // Other Than The Above

// Arbitrary 6: one byte code
#define ARBITRARY_6_CONSTITUENT_ISSUE_OF_TOPIX_SMALL 0x31  // Constituent Issue Of Topix Small
#define ARBITRARY_6_OTHER_THAN_THE_ABOVE 0x20              // Other Than The Above

// Arbitrary 7: one byte code
#define ARBITRARY_7_CONSTITUENT_ISSUE_OF_TOPIX_1000 0x31  // Constituent Issue Of Topix 1000
#define ARBITRARY_7_OTHER_THAN_THE_ABOVE 0x20             // Other Than The Above

// Arbitrary 11: one byte code
#define ARBITRARY_11_CONSTITUENT_ISSUE_OF_TSE_GROWTH_MARKET_250_INDEX 0x31  // Constituent Issue Of Tse Growth Market 250 Index
#define ARBITRARY_11_OTHER_THAN_THE_ABOVE 0x20                              // Other Than The Above

// Arbitrary 16: one byte code
#define ARBITRARY_16_CONSTITUENT_ISSUE_OF_REIT_GENERAL 0x31  // Constituent Issue Of Reit General
#define ARBITRARY_16_OTHER_THAN_THE_ABOVE 0x20               // Other Than The Above

// Market Limit Orders: one byte code
#define MARKET_LIMIT_ORDERS_ONLY_MARKET_ORDER_IS_PROHIBITED 0x31              // Only Market Order Is Prohibited
#define MARKET_LIMIT_ORDERS_BOTH_MARKET_AND_LIMIT_ORDERS_ARE_PROHIBITED 0x32  // Both Market And Limit Orders Are Prohibited
#define MARKET_LIMIT_ORDERS_OTHER_THAN_THE_ABOVE 0x20                         // Other Than The Above

// Side: one byte code
#define SIDE_BOTH_SELL_AND_BUY_ORDERS_ARE_PROHIBITED 0x31  // Both Sell And Buy Orders Are Prohibited
#define SIDE_ONLY_SELL_ORDER_IS_PROHIBITED 0x32            // Only Sell Order Is Prohibited
#define SIDE_ONLY_BUY_ORDER_IS_PROHIBITED 0x33             // Only Buy Order Is Prohibited
#define SIDE_OTHER_THAN_THE_ABOVE 0x20                     // Other Than The Above

// Proprietary Brokerage: one byte code
#define PROPRIETARY_BROKERAGE_ONLY_PROPRIETARY_ORDER_IS_PROHIBITED 0x31                  // Only Proprietary Order Is Prohibited
#define PROPRIETARY_BROKERAGE_BOTH_PROPRIETARY_AND_BROKERAGE_ORDERS_ARE_PROHIBITED 0x32  // Both Proprietary And Brokerage Orders Are Prohibited
#define PROPRIETARY_BROKERAGE_OTHER_THAN_THE_ABOVE 0x20                                  // Other Than The Above

// All Orders Prohibition: one byte code
#define ALL_ORDERS_PROHIBITION_PROHIBITED_FOR_ALL_ORDERS 0x31  // Prohibited For All Orders
#define ALL_ORDERS_PROHIBITION_OTHER_THAN_THE_ABOVE 0x20       // Other Than The Above

// Unit Flag: one byte code
#define UNIT_FLAG_TO_THE_FOURTH_DECIMAL_PLACE 0x30  // To The Fourth Decimal Place
#define UNIT_FLAG_TO_THE_THIRD_DECIMAL_PLACE 0x31   // To The Third Decimal Place
#define UNIT_FLAG_TO_THE_SECOND_DECIMAL_PLACE 0x32  // To The Second Decimal Place
#define UNIT_FLAG_TO_THE_FIRST_DECIMAL_PLACE 0x33   // To The First Decimal Place
#define UNIT_FLAG_NO_DECIMAL_PLACES 0x34            // No Decimal Places
#define UNIT_FLAG_NO_NUMERICAL_VALUE 0x20           // No Numerical Value

// Sign: one byte code
#define SIGN_POSITIVE 0x2B  // Positive
#define SIGN_NO_SIGN 0x20   // No Sign

// Base Price Price Of The Middle Of The Book: one byte code
#define BASE_PRICE_PRICE_OF_THE_MIDDLE_OF_THE_BOOK_BASE_PRICE 0x31                       // Base Price
#define BASE_PRICE_PRICE_OF_THE_MIDDLE_OF_THE_BOOK_PRICE_OF_THE_MIDDLE_OF_THE_BOOK 0x32  // Price Of The Middle Of The Book

// Test Mode Flag: one byte code
#define TEST_MODE_FLAG_REAL_OPERATION 0x31  // Real Operation
#define TEST_MODE_FLAG_TEST_OPERATION 0x32  // Test Operation

// Start End Flag: one byte code
#define START_END_FLAG_START 0x31           // Start
#define START_END_FLAG_END 0x32             // End
#define START_END_FLAG_NOT_APPLICABLE 0x20  // Not Applicable

// Separation Of Tag: one byte code
#define SEPARATION_OF_TAG_SEPARATION_BETWEEN_TAG 0x13  // Separation Between Tag
#define SEPARATION_OF_TAG_END_OF_MESSAGE 0x11          // End Of Message

// ---- Types -------------------------------------------------------------------

// Numbered from 1 on each Multicast Group, with the multicast group number in the first to third byte
typedef struct _MessageSerialNo {
  UINT8 multicast_group_number[3];  // bytes 0 to 2
  UINT8 sequence_number[8];         // bytes 3 to 10
} MessageSerialNo;

// Large Classification indicates Message Type, and Medium Classification indicates details and other information
typedef struct _MessageType {
  UINT8 message_type_large_classification;      // byte 0
  UINT8 message_type_medium_classification[2];  // bytes 1 to 2
} MessageType;

// Jpx Flex 39 byte service header, common to all message types
typedef struct _ServiceHeader {
  UINT8 message_length[6];                              // bytes 0 to 5
  MessageSerialNo message_serial_no;                    // bytes 6 to 16
  MessageType message_type;                             // bytes 17 to 19
  UINT8 exchange_code;                                  // byte 20
  UINT8 session_distinction[2];                         // bytes 21 to 22
  UINT16BE issue_classification_large_classification;   // bytes 23 to 24
  UINT8 issue_classification_medium_classification[2];  // bytes 25 to 26
  UINT8 issue_code[12];                                 // bytes 27 to 38
} ServiceHeader;

// Index constituent issue
typedef struct _IndexConstituentIssue {
  UINT8 arbitrary_1;            // byte 0
  UINT8 arbitrary_2;            // byte 1
  UINT8 arbitrary_3;            // byte 2
  UINT8 arbitrary_4;            // byte 3
  UINT8 arbitrary_5;            // byte 4
  UINT8 arbitrary_6;            // byte 5
  UINT8 arbitrary_7;            // byte 6
  UINT8 arbitrary_8_to_10[3];   // bytes 7 to 9
  UINT8 arbitrary_11;           // byte 10
  UINT8 arbitrary_12_to_15[4];  // bytes 11 to 14
  UINT8 arbitrary_16;           // byte 15
  UINT8 arbitrary_17_to_19[3];  // bytes 16 to 18
  UINT8 arbitrary_20;           // byte 19
} IndexConstituentIssue;

// New Orders Prohibition
typedef struct _NewOrdersProhibition {
  UINT8 market_limit_orders;    // byte 0
  UINT8 side;                   // byte 1
  UINT8 proprietary_brokerage;  // byte 2
  UINT8 reserved_1;             // byte 3
} NewOrdersProhibition;

// Margin Transactions Prohibition
typedef struct _MarginTransactionsProhibition {
  UINT8 side;                   // byte 0
  UINT8 proprietary_brokerage;  // byte 1
  UINT8 reserved_1;             // byte 2
} MarginTransactionsProhibition;

// Short Selling Prohibition
typedef struct _ShortSellingProhibition {
  UINT8 proprietary_brokerage;  // byte 0
  UINT8 reserved_1;             // byte 1
} ShortSellingProhibition;

// Order Prohibition Status (at the regular distribution)
typedef struct _OrderProhibitionStatusAtTheRegularDistribution {
  NewOrdersProhibition new_orders_prohibition;                    // bytes 0 to 3
  MarginTransactionsProhibition margin_transactions_prohibition;  // bytes 4 to 6
  ShortSellingProhibition short_selling_prohibition;              // bytes 7 to 8
  UINT8 all_orders_prohibition;                                   // byte 9
} OrderProhibitionStatusAtTheRegularDistribution;

// In this tag, the new security code, etc., of each issue will be set. This tag appears as part of an issue basic message.
typedef struct _IssueInformationMessage {
  UINT8 reserved_2[2];                                                                                  // bytes 0 to 1
  UINT8 serial_no[6];                                                                                   // bytes 2 to 7
  UINT8 applicable_business_day[8];                                                                     // bytes 8 to 15
  UINT8 reserved_1;                                                                                     // byte 16
  UINT8 issue_name[20];                                                                                 // bytes 17 to 36
  UINT8 security_type_etc_identification_code[2];                                                       // bytes 37 to 38
  UINT8 isin_flag;                                                                                      // byte 39
  UINT8 new_security_code[12];                                                                          // bytes 40 to 51
  UINT8 industry_code[4];                                                                               // bytes 52 to 55
  UINT8 new_listing_flag;                                                                               // byte 56
  UINT8 when_issued_transaction_flag;                                                                   // byte 57
  UINT8 short_selling_price_restriction_applied_flag_at_the_regular_distribution;                       // byte 58
  UINT8 loan_margin_flag;                                                                               // byte 59
  UINT8 ex_dividend_ex_right_flag[2];                                                                   // bytes 60 to 61
  UINT8 securities_to_be_delisted_under_supervision_classification;                                     // byte 62
  UINT8 reserved_5[5];                                                                                  // bytes 63 to 67
  UINT8 unit_of_trading[14];                                                                            // bytes 68 to 81
  IndexConstituentIssue index_constituent_issue;                                                        // bytes 82 to 101
  OrderProhibitionStatusAtTheRegularDistribution order_prohibition_status_at_the_regular_distribution;  // bytes 102 to 111
  UINT8 reserved_11[11];                                                                                // bytes 112 to 122
} IssueInformationMessage;

// Base Price
typedef struct _BasePrice {
  UINT8 unit_flag;  // byte 0
  UINT8 price[14];  // bytes 1 to 14
  UINT8 sign;       // byte 15
} BasePrice;

// Limit Price (Maximum)
typedef struct _LimitPriceMaximum {
  UINT8 unit_flag;  // byte 0
  UINT8 price[14];  // bytes 1 to 14
  UINT8 sign;       // byte 15
} LimitPriceMaximum;

// Limit Price (Minimum)
typedef struct _LimitPriceMinimum {
  UINT8 unit_flag;  // byte 0
  UINT8 price[14];  // bytes 1 to 14
  UINT8 sign;       // byte 15
} LimitPriceMinimum;

// In this Tag, the below items for the next business day or the day are set. This tag appears as part of an issue basic message.
typedef struct _BasePriceInformationMessage {
  UINT8 reserved_2[2];                               // bytes 0 to 1
  UINT8 based_business_day[8];                       // bytes 2 to 9
  BasePrice base_price;                              // bytes 10 to 25
  LimitPriceMaximum limit_price_maximum;             // bytes 26 to 41
  LimitPriceMinimum limit_price_minimum;             // bytes 42 to 57
  UINT8 base_price_price_of_the_middle_of_the_book;  // byte 58
  UINT8 number_of_tick_size_table[2];                // bytes 59 to 60
  UINT8 reserved_1;                                  // byte 61
  UINT8 reserved_4[4];                               // bytes 62 to 65
} BasePriceInformationMessage;

// In this tag, Multicast Group Number with which the issue is output is set. This tag appears as part of an Issue Realtime Message.
typedef struct _MulticastGroupNumberInformationMessage {
  UINT8 reserved_2[2];                    // bytes 0 to 1
  UINT8 applicable_business_day[8];       // bytes 2 to 9
  UINT8 issue_multicast_group_number[3];  // bytes 10 to 12
  UINT8 reserved_1;                       // byte 13
} MulticastGroupNumberInformationMessage;

// In this tag, the Test Mode Flag and the Start/End Flag that are used in a Control Message will be set. This tag appears as part of a Control Message (Communication Control, Health Check Control, Stock Base Price Information Control, CB Base Price Information Control, Issue Information Control and Multicast Group Number Information Control).
typedef struct _ControlMessage {
  UINT8 reserved_2[2];   // bytes 0 to 1
  UINT8 test_mode_flag;  // byte 2
  UINT8 start_end_flag;  // byte 3
  UINT8 time[6];         // bytes 4 to 9
} ControlMessage;

// Branch
casetype _Payload (UINT16 selector) {
  switch (selector) {
    case 0x4949: IssueInformationMessage issue_information_message;
    case 0x4250: BasePriceInformationMessage base_price_information_message;
    case 0x4D47: MulticastGroupNumberInformationMessage multicast_group_number_information_message;
    case 0x4C43: ControlMessage control_message;
  }
} Payload;

// One tag: its two character Tag ID, its data, and the control code that closes it (DC3 between tags, DC1 at the end of the message)
typedef struct _TagInformation {
  UINT16BE tag_i_d;          // bytes 0 to 1
  Payload(tag_i_d) payload;
  UINT8 separation_of_tag;
} TagInformation;

// ---- Packet: UdpPacket -------------------------------------------------------

// One Flex user message per datagram: DC1, Service Header, DC2, then the tags
entrypoint typedef struct _UdpPacket (UINT32 available) where (available >= 41) {
  UINT8 start_of_message;                                       // byte 0
  ServiceHeader service_header;                                 // bytes 1 to 39
  UINT8 separation_between_service_header_and_data_section;     // byte 40
  TagInformation tag_information[:byte-size (available - 41)];
} UdpPacket;

