// ---- Message Serial No: 11 bytes ---------------------------------------------

// Numbered from 1 on each Multicast Group, with the multicast group number in the first to third byte
entrypoint typedef struct _MessageSerialNo {
  UINT8 multicast_group_number[3];  // bytes 0 to 2
  UINT8 sequence_number[8];         // bytes 3 to 10
} MessageSerialNo;

// ---- Issue Classification: 4 bytes -------------------------------------------

// Set in issue realtime message and issue basic message. In the case of Control, Index and Statistics Message, space is set.
entrypoint typedef struct _IssueClassification {
  UINT8 issue_classification_large_classification[2];   // bytes 0 to 1
  UINT8 issue_classification_medium_classification[2];  // bytes 2 to 3
} IssueClassification;

// ---- Stock Issue Code: 12 bytes ----------------------------------------------

// Issue Code layout a. Stocks, used when Issue Classification Large Classification is 01 Stock-Related. FLEX Issue Code is set with right-align.
entrypoint typedef struct _StockIssueCode {
  UINT8 stock_space[7];             // bytes 0 to 6
  UINT8 stock_proper_name_code[4];  // bytes 7 to 10
  UINT8 stock_reserved_code;        // byte 11
} StockIssueCode;

// ---- CB Issue Code: 12 bytes -------------------------------------------------

// Issue Code layout used when Issue Classification Large Classification is 02 CB-Related. The figure carries no label of its own in 5.3.3 (7). FLEX Issue Code is set with right-align.
entrypoint typedef struct _CBIssueCode {
  UINT8 c_b_space[3];             // bytes 0 to 2
  UINT8 c_b_reserved_code;        // byte 3
  UINT8 time_symbol[4];           // bytes 4 to 7
  UINT8 c_b_proper_name_code[4];  // bytes 8 to 11
} CBIssueCode;

// ---- Trading Halt: 8 bytes ---------------------------------------------------

// Trading Halt
entrypoint typedef struct _TradingHalt {
  UINT8 state_flag[2];  // bytes 0 to 1
  UINT8 time[6];        // bytes 2 to 7
} TradingHalt;

// ---- Price: 30 bytes ---------------------------------------------------------

// Price
entrypoint typedef struct _Price {
  UINT8 price_code[2];       // bytes 0 to 1
  UINT8 lot_size_unit_flag;  // byte 2
  UINT8 price_value[14];     // bytes 3 to 16
