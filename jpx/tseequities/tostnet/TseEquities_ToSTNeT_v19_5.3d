// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, UdpPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out TseEquities_ToSTNeT_v19_5.3d
//
// What this definition reads more loosely than the model states:
// - a union, several readings of the same bytes, is read as the bytes it occupies

// ---- Values ------------------------------------------------------------------

// Message Type Large Classification: one byte code
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_ISSUE_REALTIME_MESSAGE 0x31  // Issue Realtime Message
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_STATISTICS_MESSAGE 0x32      // Statistics Message
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_INDEX_MESSAGE 0x33           // Index Message
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_ISSUE_BASIC_MESSAGE 0x34     // Issue Basic Message
#define MESSAGE_TYPE_LARGE_CLASSIFICATION_CONTROL_MESSAGE 0x39         // Control Message

// Exchange Code: one byte code
#define EXCHANGE_CODE_TOKYO_STOCK_EXCHANGE 0x31         // Tokyo Stock Exchange
#define EXCHANGE_CODE_NAGOYA_STOCK_EXCHANGE 0x33        // Nagoya Stock Exchange
#define EXCHANGE_CODE_FUKUOKA_STOCK_EXCHANGE 0x36       // Fukuoka Stock Exchange
#define EXCHANGE_CODE_SAPPORO_SECURITIES_EXCHANGE 0x38  // Sapporo Securities Exchange
#define EXCHANGE_CODE_OTHER 0x30                        // Other
#define EXCHANGE_CODE_CONTROL_MESSAGE 0x20              // Control Message

// Issue Classification Large Classification: 2 byte code
#define ISSUE_CLASSIFICATION_LARGE_CLASSIFICATION_STOCKRELATED 0x3031  // Stockrelated
#define ISSUE_CLASSIFICATION_LARGE_CLASSIFICATION_CBRELATED 0x3032     // Cbrelated

// Tag ID: 2 byte code
#define TAG_I_D_TO_S_T_NE_T_BY_ISSUE_INFORMATION_MESSAGE 0x5449  // ToSTNeT By-Issue Information Message
#define TAG_I_D_TO_S_T_NE_T_MARKET_INFORMATION_MESSAGE 0x544D    // ToSTNeT Market Information Message
#define TAG_I_D_CONTROL_MESSAGE 0x4C43                           // Control Message

// Market Identification Flag: one byte code
#define MARKET_IDENTIFICATION_FLAG_SINGLE_ISSUE_TRANSACTION 0x31   // Single Issue Transaction
#define MARKET_IDENTIFICATION_FLAG_BASKET_TRANSACTION 0x32         // Basket Transaction
#define MARKET_IDENTIFICATION_FLAG_CLOSING_PRICE_TRANSACTION 0x33  // Closing Price Transaction

// Transaction Identification Flag: one byte code
#define TRANSACTION_IDENTIFICATION_FLAG_DAY_TRANSACTION 0x31                            // Day Transaction
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_2_VWAP_TRANSACTION 0x32  // Ordinary Transaction T 2 Vwap Transaction
#define TRANSACTION_IDENTIFICATION_FLAG_DAY_TRANSACTION_VWAP_TRANSACTION 0x33           // Day Transaction Vwap Transaction
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_2 0x20                   // Ordinary Transaction T 2
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_1 0x41                   // Ordinary Transaction T 1
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_1_VWAP_TRANSACTION 0x42  // Ordinary Transaction T 1 Vwap Transaction
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_3 0x43                   // Ordinary Transaction T 3
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_3_VWAP_TRANSACTION 0x44  // Ordinary Transaction T 3 Vwap Transaction
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_4 0x45                   // Ordinary Transaction T 4
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_4_VWAP_TRANSACTION 0x46  // Ordinary Transaction T 4 Vwap Transaction
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_5 0x47                   // Ordinary Transaction T 5
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_5_VWAP_TRANSACTION 0x48  // Ordinary Transaction T 5 Vwap Transaction
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_6 0x49                   // Ordinary Transaction T 6
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_6_VWAP_TRANSACTION 0x4A  // Ordinary Transaction T 6 Vwap Transaction
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_7 0x4B                   // Ordinary Transaction T 7
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_7_VWAP_TRANSACTION 0x4C  // Ordinary Transaction T 7 Vwap Transaction
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_8 0x4D                   // Ordinary Transaction T 8
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_8_VWAP_TRANSACTION 0x4E  // Ordinary Transaction T 8 Vwap Transaction
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_9 0x4F                   // Ordinary Transaction T 9
#define TRANSACTION_IDENTIFICATION_FLAG_ORDINARY_TRANSACTION_T_9_VWAP_TRANSACTION 0x50  // Ordinary Transaction T 9 Vwap Transaction

// Lot Size Unit Flag: one byte code
#define LOT_SIZE_UNIT_FLAG_TO_THE_FOURTH_DECIMAL_PLACE 0x30  // To The Fourth Decimal Place
#define LOT_SIZE_UNIT_FLAG_TO_THE_THIRD_DECIMAL_PLACE 0x31   // To The Third Decimal Place
#define LOT_SIZE_UNIT_FLAG_TO_THE_SECOND_DECIMAL_PLACE 0x32  // To The Second Decimal Place
#define LOT_SIZE_UNIT_FLAG_TO_THE_FIRST_DECIMAL_PLACE 0x33   // To The First Decimal Place
#define LOT_SIZE_UNIT_FLAG_NO_DECIMAL_PLACES 0x34            // No Decimal Places
#define LOT_SIZE_UNIT_FLAG_NO_NUMERICAL_VALUE 0x20           // No Numerical Value

// Sign: one byte code
#define SIGN_POSITIVE 0x2B  // Positive
#define SIGN_NO_SIGN 0x20   // No Sign

// Trading Volume Turnover Unit Flag: one byte code
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_ONE 0x30                 // One
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_TEN 0x31                 // Ten
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_HUNDRED 0x32             // Hundred
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_THOUSAND 0x33            // Thousand
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_TEN_THOUSAND 0x34        // Ten Thousand
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_HUNDRED_THOUSAND 0x35    // Hundred Thousand
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_MILLION 0x36             // Million
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_TEN_MILLION 0x37         // Ten Million
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_HUNDRED_MILLION 0x38     // Hundred Million
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_BILLION 0x39             // Billion
#define TRADING_VOLUME_TURNOVER_UNIT_FLAG_NO_NUMERICAL_VALUE 0x20  // No Numerical Value

// Test Mode Flag: one byte code
#define TEST_MODE_FLAG_REAL_OPERATION 0x31  // Real Operation
#define TEST_MODE_FLAG_TEST_OPERATION 0x32  // Test Operation

// Start End Flag: one byte code
#define START_END_FLAG_START 0x31           // Start
#define START_END_FLAG_END 0x32             // End
#define START_END_FLAG_NOT_APPLICABLE 0x20  // Not Applicable

// Separation Of Tag: one byte code
#define SEPARATION_OF_TAG_SEPARATION_BETWEEN_TAG 0x13  // Separation Between Tag
#define SEPARATION_OF_TAG_END_OF_MESSAGE 0x11          // End Of Message

// ---- Types -------------------------------------------------------------------

// Numbered from 1 on each Multicast Group, with the multicast group number in the first to third byte
typedef struct _MessageSerialNo {
  UINT8 multicast_group_number[3];  // bytes 0 to 2
  UINT8 sequence_number[8];         // bytes 3 to 10
} MessageSerialNo;

// Large Classification indicates Message Type, and Medium Classification indicates details and other information
typedef struct _MessageType {
  UINT8 message_type_large_classification;      // byte 0
  UINT8 message_type_medium_classification[2];  // bytes 1 to 2
} MessageType;

// Jpx Flex 39 byte service header, common to all message types
typedef struct _ServiceHeader {
  UINT8 message_length[6];                              // bytes 0 to 5
  MessageSerialNo message_serial_no;                    // bytes 6 to 16
  MessageType message_type;                             // bytes 17 to 19
  UINT8 exchange_code;                                  // byte 20
  UINT8 session_distinction[2];                         // bytes 21 to 22
  UINT16BE issue_classification_large_classification;   // bytes 23 to 24
  UINT8 issue_classification_medium_classification[2];  // bytes 25 to 26
  UINT8 issue_code[12];                                 // bytes 27 to 38
} ServiceHeader;

// Trading Halt
typedef struct _TradingHalt {
  UINT8 state_flag[2];  // bytes 0 to 1
  UINT8 time[6];        // bytes 2 to 7
} TradingHalt;

// Price
typedef struct _Price {
  UINT8 price_code[2];       // bytes 0 to 1
  UINT8 lot_size_unit_flag;  // byte 2
  UINT8 price_value[14];     // bytes 3 to 16
  UINT8 sign;                // byte 17
  UINT8 precise_time[12];    // bytes 18 to 29
} Price;

// Trading Volume
typedef struct _TradingVolume {
  UINT8 trading_volume_turnover_unit_flag;  // byte 0
  UINT8 trading_volume_value[14];           // bytes 1 to 14
} TradingVolume;

// Turnover
typedef struct _Turnover {
  UINT8 trading_volume_turnover_unit_flag;  // byte 0
  UINT8 turnover_value[14];                 // bytes 1 to 14
} Turnover;

// In this tag, information concerning trade and trading halt for an issue (single-issue transaction, basket transaction, or closing price transaction) on the ToSTNeT is set. This data appears as part of realtime data.
typedef struct _ToSTNeTBy_IssueInformationMessage {
  UINT8 reserved_2[2];                    // bytes 0 to 1
  UINT8 market_identification_flag;       // byte 2
  TradingHalt trading_halt;               // bytes 3 to 10
  UINT8 transaction_identification_flag;  // byte 11
  Price price;                            // bytes 12 to 41
  TradingVolume trading_volume;           // bytes 42 to 56
  Turnover turnover;                      // bytes 57 to 71
} ToSTNeTBy_IssueInformationMessage;

// State
typedef struct _State {
  UINT8 market_state_flag[2];  // bytes 0 to 1
  UINT8 time[6];               // bytes 2 to 7
} State;

// In this tag, state information on the ToSTNeT will be set. This data appears as part of realtime data.
typedef struct _ToSTNeTMarketInformationMessage {
  UINT8 reserved_2[2];               // bytes 0 to 1
  UINT8 market_identification_flag;  // byte 2
  State state;                       // bytes 3 to 10
} ToSTNeTMarketInformationMessage;

// In this tag, the test mode flag and the start/end flag that are used in a control message will be set. This tag will be edited into a control message (communication control and health check control) for output.
typedef struct _ControlMessage {
  UINT8 reserved_2[2];   // bytes 0 to 1
  UINT8 test_mode_flag;  // byte 2
  UINT8 start_end_flag;  // byte 3
  UINT8 time[6];         // bytes 4 to 9
} ControlMessage;

// Branch
casetype _Payload (UINT16 selector) {
  switch (selector) {
    case 0x5449: ToSTNeTBy_IssueInformationMessage to_s_t_ne_t_by_issue_information_message;
    case 0x544D: ToSTNeTMarketInformationMessage to_s_t_ne_t_market_information_message;
    case 0x4C43: ControlMessage control_message;
  }
} Payload;

// One tag: its two character Tag ID, its data, and the control code that closes it (DC3 between tags, DC1 at the end of the message)
typedef struct _TagInformation {
  UINT16BE tag_i_d;          // bytes 0 to 1
  Payload(tag_i_d) payload;
  UINT8 separation_of_tag;
} TagInformation;

// ---- Packet: UdpPacket -------------------------------------------------------

// One Flex user message per datagram: DC1, Service Header, DC2, then the tags
entrypoint typedef struct _UdpPacket (UINT32 available) where (available >= 41) {
  UINT8 start_of_message;                                       // byte 0
  ServiceHeader service_header;                                 // bytes 1 to 39
  UINT8 separation_between_service_header_and_data_section;     // byte 40
  TagInformation tag_information[:byte-size (available - 41)];
} UdpPacket;

