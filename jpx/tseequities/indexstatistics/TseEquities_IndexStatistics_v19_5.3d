// Estimated total turnover
typedef struct _EstimatedTotalTurnover {
  UINT8 trading_volume_turnover_unit_flag;   // byte 0
  UINT8 estimated_total_turnover_value[14];  // bytes 1 to 14
  UINT8 reserved_1;                          // byte 15
} EstimatedTotalTurnover;

// In this tag, estimated total turnover information for each market (issue classification) will be set. This data appears as part of a statistics message.
typedef struct _EstimatedTotalTurnoverMessage {
  UINT8 reserved_2[2];                              // bytes 0 to 1
  UINT8 output_time[6];                             // bytes 2 to 7
  UINT8 issue_classification_code[4];               // bytes 8 to 11
  UINT8 other_classification_flag[2];               // bytes 12 to 13
  EstimatedTotalTurnover estimated_total_turnover;  // bytes 14 to 29
} EstimatedTotalTurnoverMessage;

// VWAP by market
typedef struct _VwapByMarket {
  UINT8 unit_flag;                  // byte 0
  UINT8 vwap_by_market_value[14];   // bytes 1 to 14
  UINT8 sign;                       // byte 15
  UINT8 reserved_1;                 // byte 16
  UINT8 second_unit_flag;           // byte 17
  UINT8 day_on_day_comparison[14];  // bytes 18 to 31
  UINT8 second_sign;                // byte 32
} VwapByMarket;

// In this tag, volume weighted average price (VWAP) information for each market (issue classification) will be set. This data appears as part of a statistics message.
typedef struct _VwapByMarketMessage {
  UINT8 reserved_2[2];                 // bytes 0 to 1
  UINT8 output_time[6];                // bytes 2 to 7
  UINT8 issue_classification_code[4];  // bytes 8 to 11
  VwapByMarket vwap_by_market;         // bytes 12 to 44
} VwapByMarketMessage;

// Top rank by trading volume
typedef struct _TopRankByTradingVolume {
  UINT8 rank[2];                            // bytes 0 to 1
  UINT8 ranked_issue_code[12];              // bytes 2 to 13
  UINT8 reserved_1;                         // byte 14
  UINT8 trading_volume_turnover_unit_flag;  // byte 15
  UINT8 trading_volume_value[14];           // bytes 16 to 29
} TopRankByTradingVolume;

// In this tag, information concerning top 30 issues by trading volume for each market (issue classification) will be set. This data appears as part of a statistics message.
typedef struct _RankingByTradingVolumeMessage {
  UINT8 reserved_2[2];                                                // bytes 0 to 1
  UINT8 output_time[6];                                               // bytes 2 to 7
  UINT8 issue_classification_code[4];                                 // bytes 8 to 11
  TopRankByTradingVolume top_rank_by_trading_volume[:byte-size 900];  // bytes 12 to 911
} RankingByTradingVolumeMessage;

// Top rank by turnover
typedef struct _TopRankByTurnover {
  UINT8 rank[2];                            // bytes 0 to 1
  UINT8 ranked_issue_code[12];              // bytes 2 to 13
  UINT8 reserved_1;                         // byte 14
  UINT8 trading_volume_turnover_unit_flag;  // byte 15
  UINT8 turnover_value[14];                 // bytes 16 to 29
} TopRankByTurnover;

// In this tag, information concerning top 30 issues by turnover for each market (issue classification) will be set. This data appears as part of a statistics message.
typedef struct _RankingByTurnoverMessage {
  UINT8 reserved_2[2];                                     // bytes 0 to 1
  UINT8 output_time[6];                                    // bytes 2 to 7
  UINT8 issue_classification_code[4];                      // bytes 8 to 11
  TopRankByTurnover top_rank_by_turnover[:byte-size 900];  // bytes 12 to 911
} RankingByTurnoverMessage;

// Top rank by net change
typedef struct _TopRankByNetChange {
  UINT8 rank[2];                  // bytes 0 to 1
  UINT8 ranked_issue_code[12];    // bytes 2 to 13
  UINT8 state_sign;               // byte 14
  UINT8 unit_flag;                // byte 15
  UINT8 current_price_value[14];  // bytes 16 to 29
  UINT8 sign;                     // byte 30
  UINT8 comparison_type;          // byte 31
  UINT8 second_unit_flag;         // byte 32
  UINT8 net_change[14];           // bytes 33 to 46
  UINT8 second_sign;              // byte 47
} TopRankByNetChange;

// In this tag, information concerning top 30 issues by net change for each market (issue classification) will be set. This data appears as part of a statistics message.
typedef struct _RankingByNetChangeMessage {
  UINT8 reserved_2[2];                                         // bytes 0 to 1
  UINT8 output_time[6];                                        // bytes 2 to 7
  UINT8 issue_classification_code[4];                          // bytes 8 to 11
  UINT8 net_change_distinction;                                // byte 12
  TopRankByNetChange top_rank_by_net_change[:byte-size 1440];  // bytes 13 to 1452
} RankingByNetChangeMessage;

// Top rank by net change rate
typedef struct _TopRankByNetChangeRate {
  UINT8 rank[2];                  // bytes 0 to 1
  UINT8 ranked_issue_code[12];    // bytes 2 to 13
  UINT8 state_sign;               // byte 14
  UINT8 unit_flag;                // byte 15
  UINT8 current_price_value[14];  // bytes 16 to 29
  UINT8 sign;                     // byte 30
  UINT8 comparison_type;          // byte 31
  UINT8 net_change_rate[8];       // bytes 32 to 39
  UINT8 second_sign;              // byte 40
} TopRankByNetChangeRate;

// In this tag, information concerning top 30 issues in net change rate for each market (issue classification) will be set. This data appears as part of a statistics message.
typedef struct _RankingByNetChangeRateMessage {
  UINT8 reserved_2[2];                                                  // bytes 0 to 1
  UINT8 output_time[6];                                                 // bytes 2 to 7
  UINT8 issue_classification_code[4];                                   // bytes 8 to 11
  UINT8 net_change_distinction;                                         // byte 12
  TopRankByNetChangeRate top_rank_by_net_change_rate[:byte-size 1230];  // bytes 13 to 1242
} RankingByNetChangeRateMessage;

// Trading volume
typedef struct _TradingVolume {
  UINT8 trading_volume_turnover_unit_flag;         // byte 0
  UINT8 single_issue_transaction[14];              // bytes 1 to 14
  UINT8 second_trading_volume_turnover_unit_flag;  // byte 15
  UINT8 closing_price_transaction[14];             // bytes 16 to 29
  UINT8 third_trading_volume_turnover_unit_flag;   // byte 30
  UINT8 basket_transaction[14];                    // bytes 31 to 44
  UINT8 fourth_trading_volume_turnover_unit_flag;  // byte 45
  UINT8 aggregate_trading_volume[14];              // bytes 46 to 59
} TradingVolume;

// Turnover
typedef struct _Turnover {
  UINT8 trading_volume_turnover_unit_flag;         // byte 0
  UINT8 single_issue_transaction[14];              // bytes 1 to 14
  UINT8 second_trading_volume_turnover_unit_flag;  // byte 15
  UINT8 closing_price_transaction[14];             // bytes 16 to 29
  UINT8 third_trading_volume_turnover_unit_flag;   // byte 30
  UINT8 basket_transaction[14];                    // bytes 31 to 44
  UINT8 fourth_trading_volume_turnover_unit_flag;  // byte 45
  UINT8 aggregate_turnover[14];                    // bytes 46 to 59
} Turnover;

// Number of transactions
typedef struct _NumberOfTransactions {
  UINT8 single_issue_transaction_count[8];  // bytes 0 to 7
  UINT8 basket_transaction_count[8];        // bytes 8 to 15
} NumberOfTransactions;

// In this tag, the quantities traded on the ToSTNeT and other information will be set. This data appears as part of a statistics message.
typedef struct _ToSTNeTStatisticsMessage {
  UINT8 reserved_2[2];                          // bytes 0 to 1
  UINT8 output_time[6];                         // bytes 2 to 7
  UINT8 other_classification_flag[2];           // bytes 8 to 9
  TradingVolume trading_volume;                 // bytes 10 to 69
  Turnover turnover;                            // bytes 70 to 129
  NumberOfTransactions number_of_transactions;  // bytes 130 to 145
} ToSTNeTStatisticsMessage;

// Open
typedef struct _Open {
  UINT8 unit_flag;           // byte 0
  UINT8 index_value[14];     // bytes 1 to 14
  UINT8 sign;                // byte 15
  UINT8 time_c_6_hhmmss[6];  // bytes 16 to 21
  UINT8 flag;                // byte 22
} Open;

// Highest
typedef struct _Highest {
  UINT8 unit_flag;           // byte 0
  UINT8 index_value[14];     // bytes 1 to 14
  UINT8 sign;                // byte 15
  UINT8 time_c_6_hhmmss[6];  // bytes 16 to 21
  UINT8 flag;                // byte 22
} Highest;

// Lowest
typedef struct _Lowest {
  UINT8 unit_flag;           // byte 0
  UINT8 index_value[14];     // bytes 1 to 14
  UINT8 sign;                // byte 15
  UINT8 time_c_6_hhmmss[6];  // bytes 16 to 21
  UINT8 flag;                // byte 22
} Lowest;

// Current price
typedef struct _CurrentPrice {
  UINT8 unit_flag;           // byte 0
  UINT8 index_value[14];     // bytes 1 to 14
  UINT8 sign;                // byte 15
  UINT8 time_c_6_hhmmss[6];  // bytes 16 to 21
  UINT8 flag;                // byte 22
} CurrentPrice;

// Index Day-on-day comparison
typedef struct _IndexDayOnDayComparison {
  UINT8 net_change_rate[8];  // bytes 0 to 7
  UINT8 sign;                // byte 8
  UINT8 unit_flag;           // byte 9
  UINT8 net_change[14];      // bytes 10 to 23
  UINT8 second_sign;         // byte 24
} IndexDayOnDayComparison;

// In this tag, index information will be set. This data is appeared as one of index data.
typedef struct _IndexOpenHighLowAndClosingPricesMessage {
  UINT8 reserved_2[2];                                  // bytes 0 to 1
  UINT8 index_type[4];                                  // bytes 2 to 5
  Open open_;                                           // bytes 6 to 28
  Highest highest;                                      // bytes 29 to 51
  Lowest lowest;                                        // bytes 52 to 74
  CurrentPrice current_price;                           // bytes 75 to 97
  IndexDayOnDayComparison index_day_on_day_comparison;  // bytes 98 to 122
} IndexOpenHighLowAndClosingPricesMessage;

// Index
typedef struct _Index {
  UINT8 unit_flag;           // byte 0
  UINT8 index_value[14];     // bytes 1 to 14
  UINT8 sign;                // byte 15
  UINT8 time_c_6_hhmmss[6];  // bytes 16 to 21
} Index;

// In this tag, special quotation (S.Q.) information will be set. This data appears as part of index data.
typedef struct _SpecialQuotationMessage {
  UINT8 reserved_2[2];  // bytes 0 to 1
  UINT8 sq_type[4];     // bytes 2 to 5
  Index index;          // bytes 6 to 27
  UINT8 reserved_1;     // byte 28
} SpecialQuotationMessage;

// In this tag, the test mode flag and the start/end flag that are used in a control message will be set. This tag will be edited into a control message (communication control and health check control) for output.
typedef struct _ControlMessage {
  UINT8 reserved_2[2];     // bytes 0 to 1
  UINT8 test_mode_flag;    // byte 2
  UINT8 startend_flag;     // byte 3
  UINT8 time_c_6_hhmm[6];  // bytes 4 to 9
} ControlMessage;

// Branch
casetype _Payload (UINT16 selector) {
  switch (selector) {
    case 0x4D56: MarketValueMessage market_value_message;
    case 0x5953: SimpleYieldMessage simple_yield_message;
    case 0x5957: WeightedYieldMessage weighted_yield_message;
    case 0x4150: SimpleStockPriceAverageMessage simple_stock_price_average_message;
    case 0x4157: WeightedStockPriceAverageMessage weighted_stock_price_average_message;
    case 0x4154: SimpleStockPriceAverageByIndustryMessage simple_stock_price_average_by_industry_message;
    case 0x4959: JapaneseYenCbIndicatorMessage japanese_yen_cb_indicator_message;
    case 0x4E43: NumberOfGainersDeclinersMessage number_of_gainers_decliners_message;
    case 0x5456: EstimatedTotalTradingVolumeMessage estimated_total_trading_volume_message;
    case 0x5441: EstimatedTotalTurnoverMessage estimated_total_turnover_message;
    case 0x5653: VwapByMarketMessage vwap_by_market_message;
    case 0x524F: RankingByTradingVolumeMessage ranking_by_trading_volume_message;
    case 0x5241: RankingByTurnoverMessage ranking_by_turnover_message;
    case 0x5243: RankingByNetChangeMessage ranking_by_net_change_message;
    case 0x5250: RankingByNetChangeRateMessage ranking_by_net_change_rate_message;
    case 0x5453: ToSTNeTStatisticsMessage to_s_t_ne_t_statistics_message;
    case 0x3449: IndexOpenHighLowAndClosingPricesMessage index_open_high_low_and_closing_prices_message;
    case 0x5351: SpecialQuotationMessage special_quotation_message;
    case 0x4C43: ControlMessage control_message;
  }
} Payload;

// One tag: its two character Tag ID, its data, and the control code that closes it (DC3 between tags, DC1 at the end of the message)
typedef struct _TagInformation {
  UINT16BE tag_i_d;          // bytes 0 to 1
  Payload(tag_i_d) payload;
  UINT8 separation_of_tag;
} TagInformation;

// ---- Packet: UdpPacket -------------------------------------------------------

// One Flex user message per datagram: DC1, Service Header, DC2, then the tags
entrypoint typedef struct _UdpPacket (UINT32 available) where (available >= 41) {
  UINT8 start_of_message;                                       // byte 0
  ServiceHeader service_header;                                 // bytes 1 to 39
  UINT8 separation_between_service_header_and_data_section;     // byte 40
  TagInformation tag_information[:byte-size (available - 41)];
} UdpPacket;

