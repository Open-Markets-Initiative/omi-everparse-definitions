// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out OseDerivatives_GeniumInet_v2_2_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_SECONDS_MESSAGE 0x54                                  // Seconds Message
#define SEQUENCED_MESSAGE_TYPE_SERIES_INFORMATION_BASIC_MESSAGE 0x52                 // Series Information Basic Message
#define SEQUENCED_MESSAGE_TYPE_SERIES_INFORMATION_BASIC_COMBINATION_MESSAGE 0x4D     // Series Information Basic Combination Message
#define SEQUENCED_MESSAGE_TYPE_TICK_SIZE_DATA_MESSAGE 0x4C                           // Tick Size Data Message
#define SEQUENCED_MESSAGE_TYPE_SYSTEM_EVENT_DATA_MESSAGE 0x53                        // System Event Data Message
#define SEQUENCED_MESSAGE_TYPE_TRADING_STATUS_DATA_MESSAGE 0x4F                      // Trading Status Data Message
#define SEQUENCED_MESSAGE_TYPE_NEW_ORDER_MESSAGE 0x41                                // New Order Message
#define SEQUENCED_MESSAGE_TYPE_EXECUTION_NOTICE_MESSAGE 0x45                         // Execution Notice Message
#define SEQUENCED_MESSAGE_TYPE_EXECUTION_NOTICE_WITH_TRADE_INFORMATION_MESSAGE 0x43  // Execution Notice With Trade Information Message
#define SEQUENCED_MESSAGE_TYPE_DELETED_ORDER_MESSAGE 0x44                            // Deleted Order Message
#define SEQUENCED_MESSAGE_TYPE_EP_MESSAGE 0x5A                                       // Ep Message
#define SEQUENCED_MESSAGE_TYPE_SNAPSHOT_COMPLETION_MESSAGE 0x47                      // Snapshot Completion Message

// Financial Product: one byte code
#define FINANCIAL_PRODUCT_OPTION 0x01              // Option
#define FINANCIAL_PRODUCT_FUTURES 0x03             // Futures
#define FINANCIAL_PRODUCT_COMBINATION_SERIES 0x0B  // Combination Series

// Put Or Call: one byte code
#define PUT_OR_CALL_FUTURES_OR_COMBINATION_SERIES 0x00  // Futures Or Combination Series
#define PUT_OR_CALL_CALL 0x01                           // Call
#define PUT_OR_CALL_PUT 0x02                            // Put

// Leg Side: one byte code
#define LEG_SIDE_BUY_IF_ON_BUY_SIDE_SELL_IF_ON_SELL_SIDE 0x42  // Buy If On Buy Side Sell If On Sell Side
#define LEG_SIDE_SELL_IF_ON_BUY_SIDE_BUY_IF_ON_SELL_SIDE 0x43  // Sell If On Buy Side Buy If On Sell Side

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGE_TRANSMISSION 0x4F  // Start Of Message Transmission
#define EVENT_CODE_END_OF_MESSAGE_TRANSMISSION 0x43    // End Of Message Transmission

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Occurred At Cross: one byte code
#define OCCURRED_AT_CROSS_EXECUTION_THROUGH_AUCTION 0x59  // Execution Through Auction
#define OCCURRED_AT_CROSS_EXECUTION_THROUGH_ZARABA 0x4E   // Execution Through Zaraba

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// Provides data on the seconds when each message is disseminated.
typedef struct _SecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} SecondsMessage;

// Provides detailed data about the series that can be traded on a given business day.
typedef struct _SeriesInformationBasicMessage {
  UINT32BE nanoseconds;                          // bytes 0 to 3
  UINT32BE order_book_id;                        // bytes 4 to 7
  UINT8 symbol[32];                              // bytes 8 to 39
  UINT8 long_name[32];                           // bytes 40 to 71
  UINT8 reserved_12[12];                         // bytes 72 to 83
  UINT8 financial_product;                       // byte 84
  UINT8 trading_currency[3];                     // bytes 85 to 87
  UINT16BE number_of_decimals_in_price;          // bytes 88 to 89
  UINT16BE number_of_decimals_in_nominal_value;  // bytes 90 to 91
  UINT32BE odd_lot_size;                         // bytes 92 to 95
  UINT32BE round_lot_size;                       // bytes 96 to 99
  UINT32BE block_lot_size;                       // bytes 100 to 103
  UINT64BE nominal_value;                        // bytes 104 to 111
  UINT8 number_of_legs;                          // byte 112
  UINT32BE underlying_order_book_id;             // bytes 113 to 116
  UINT32BE strike_price;                         // bytes 117 to 120, signed, read here as unsigned
  UINT32BE expiration_date;                      // bytes 121 to 124
  UINT16BE number_of_decimals_in_strike_price;   // bytes 125 to 126
  UINT8 put_or_call;                             // byte 127
} SeriesInformationBasicMessage;

// Provides detailed data about the legs of combination trading instruments that can be traded on a given trading day.
typedef struct _SeriesInformationBasicCombinationMessage {
  UINT32BE nanoseconds;                // bytes 0 to 3
  UINT32BE combination_order_book_id;  // bytes 4 to 7
  UINT32BE leg_order_book_id;          // bytes 8 to 11
  UINT8 leg_side;                      // byte 12
  UINT32BE leg_ratio;                  // bytes 13 to 16
} SeriesInformationBasicCombinationMessage;

// Provides the tick size of a trading instrument.
typedef struct _TickSizeDataMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
  UINT64BE tick_size;      // bytes 8 to 15
  UINT32BE price_from;     // bytes 16 to 19, signed, read here as unsigned
  UINT32BE price_to;       // bytes 20 to 23, signed, read here as unsigned
} TickSizeDataMessage;

// Provides system event update data.
typedef struct _SystemEventDataMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT8 event_code;      // byte 4
} SystemEventDataMessage;

// Provides the trading status data of a trading instrument.
typedef struct _TradingStatusDataMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
  UINT8 state_name[20];    // bytes 8 to 27
} TradingStatusDataMessage;

// Provides quote data related to a new order.
typedef struct _NewOrderMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3
  UINT64BE order_id;             // bytes 4 to 11
  UINT32BE order_book_id;        // bytes 12 to 15
  UINT8 side;                    // byte 16
  UINT32BE order_book_position;  // bytes 17 to 20
  UINT64BE quantity;             // bytes 21 to 28
  UINT32BE price;                // bytes 29 to 32, signed, read here as unsigned
  UINT16BE order_attributes;     // bytes 33 to 34
  UINT8 lot_type;                // byte 35
} NewOrderMessage;

// Provides an execution notice. The Order ID of the order which is already in the order book is set.
typedef struct _ExecutionNoticeMessage {
  UINT32BE nanoseconds;        // bytes 0 to 3
  UINT64BE order_id;           // bytes 4 to 11
  UINT32BE order_book_id;      // bytes 12 to 15
  UINT8 side;                  // byte 16
  UINT64BE executed_quantity;  // bytes 17 to 24
  UINT64BE match_id;           // bytes 25 to 32
  UINT32BE combo_group_id;     // bytes 33 to 36
  UINT8 reserved_7_a[7];       // bytes 37 to 43
  UINT8 reserved_7_b[7];       // bytes 44 to 50
} ExecutionNoticeMessage;

// Provides an execution notice with trade information.
typedef struct _ExecutionNoticeWithTradeInformationMessage {
  UINT32BE nanoseconds;        // bytes 0 to 3
  UINT64BE order_id;           // bytes 4 to 11
  UINT32BE order_book_id;      // bytes 12 to 15
  UINT8 side;                  // byte 16
  UINT64BE executed_quantity;  // bytes 17 to 24
  UINT64BE match_id;           // bytes 25 to 32
  UINT32BE combo_group_id;     // bytes 33 to 36
  UINT8 reserved_7_a[7];       // bytes 37 to 43
  UINT8 reserved_7_b[7];       // bytes 44 to 50
  UINT32BE trade_price;        // bytes 51 to 54, signed, read here as unsigned
  UINT8 occurred_at_cross;     // byte 55
  UINT8 printable;             // byte 56
} ExecutionNoticeWithTradeInformationMessage;

// Provided when an order is deleted and does not exist in the order book.
typedef struct _DeletedOrderMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT64BE order_id;       // bytes 4 to 11
  UINT32BE order_book_id;  // bytes 12 to 15
  UINT8 side;              // byte 16
} DeletedOrderMessage;

// Provides the equilibrium price for the order reception hours.
typedef struct _EpMessage {
  UINT32BE nanoseconds;                                  // bytes 0 to 3
  UINT32BE order_book_id;                                // bytes 4 to 7
  UINT64BE available_bid_quantity_at_equilibrium_price;  // bytes 8 to 15
  UINT64BE available_ask_quantity_at_equilibrium_price;  // bytes 16 to 23
  UINT32BE equilibrium_price;                            // bytes 24 to 27, signed, read here as unsigned
  UINT8 reserved_4_a[4];                                 // bytes 28 to 31
  UINT8 reserved_4_b[4];                                 // bytes 32 to 35
  UINT8 reserved_8_a[8];                                 // bytes 36 to 43
  UINT8 reserved_8_b[8];                                 // bytes 44 to 51
} EpMessage;

// Sent after completing the transmission of snapshot data.
typedef struct _SnapshotCompletionMessage {
  UINT8 sequence[20];  // bytes 0 to 19
} SnapshotCompletionMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: SecondsMessage seconds_message;
    case 0x52: SeriesInformationBasicMessage series_information_basic_message;
    case 0x4D: SeriesInformationBasicCombinationMessage series_information_basic_combination_message;
    case 0x4C: TickSizeDataMessage tick_size_data_message;
    case 0x53: SystemEventDataMessage system_event_data_message;
    case 0x4F: TradingStatusDataMessage trading_status_data_message;
    case 0x41: NewOrderMessage new_order_message;
    case 0x45: ExecutionNoticeMessage execution_notice_message;
    case 0x43: ExecutionNoticeWithTradeInformationMessage execution_notice_with_trade_information_message;
    case 0x44: DeletedOrderMessage deleted_order_message;
    case 0x5A: EpMessage ep_message;
    case 0x47: SnapshotCompletionMessage snapshot_completion_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat;
    case 0x5A: unit end_of_session;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

