// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out LtseEquities_MemoirLastSale_v2_0.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_HEARTBEAT_MESSAGE 0x00         // Heartbeat Message
#define MESSAGE_TYPE_SESSION_SHUTDOWN_MESSAGE 0x01  // Session Shutdown Message
#define MESSAGE_TYPE_SEQUENCED_MESSAGE 0x02         // Sequenced Message

// Template Id: one byte code
#define TEMPLATE_ID_INSTRUMENT_DIRECTORY_MESSAGE 0x01     // Instrument Directory Message
#define TEMPLATE_ID_REG_SHO_RESTRICTION_MESSAGE 0x02      // Reg Sho Restriction Message
#define TEMPLATE_ID_SECURITY_TRADING_STATUS_MESSAGE 0x03  // Security Trading Status Message
#define TEMPLATE_ID_TRADING_SESSION_STATUS_MESSAGE 0x05   // Trading Session Status Message
#define TEMPLATE_ID_TRADE_REPORT_MESSAGE 0x0A             // Trade Report Message
#define TEMPLATE_ID_TRADE_CANCEL_MESSAGE 0x0B             // Trade Cancel Message
#define TEMPLATE_ID_TRADE_CORRECT_MESSAGE 0x0C            // Trade Correct Message
#define TEMPLATE_ID_AUCTION_TRADE_MESSAGE 0x0D            // Auction Trade Message
#define TEMPLATE_ID_BROKEN_AUCTION_TRADE_MESSAGE 0x0E     // Broken Auction Trade Message
#define TEMPLATE_ID_CORRECTED_AUCTION_TRADE_MESSAGE 0x0F  // Corrected Auction Trade Message

// Is Test Symbol: one byte code
#define IS_TEST_SYMBOL_FALSE 0x00  // False
#define IS_TEST_SYMBOL_TRUE 0x01   // True

// Short Sale Restriction: one byte code
#define SHORT_SALE_RESTRICTION_FALSE 0x00  // False
#define SHORT_SALE_RESTRICTION_TRUE 0x01   // True

// Security Trading Status: one byte code
#define SECURITY_TRADING_STATUS_HALTED 0x48   // Halted
#define SECURITY_TRADING_STATUS_PAUSED 0x50   // Paused
#define SECURITY_TRADING_STATUS_QUOTING 0x51  // Quoting
#define SECURITY_TRADING_STATUS_TRADING 0x54  // Trading

// Security Trading Status Reason: one byte code
#define SECURITY_TRADING_STATUS_REASON_NONE 0x58            // None
#define SECURITY_TRADING_STATUS_REASON_REGULATORY 0x52      // Regulatory
#define SECURITY_TRADING_STATUS_REASON_ADMINISTRATIVE 0x41  // Administrative

// Halt Reason: one byte code
#define HALT_REASON_UNKNOWN 0x00                                  // Unknown
#define HALT_REASON_ADMIN 0x01                                    // Admin
#define HALT_REASON_ADDITIONAL_INFO_REQUESTED 0x02                // Additional Info Requested
#define HALT_REASON_REGULATORY_CONCERN 0x03                       // Regulatory Concern
#define HALT_REASON_NEWS_RELEASED 0x04                            // News Released
#define HALT_REASON_MERGER_EFFECTIVE 0x05                         // Merger Effective
#define HALT_REASON_ETF_COMPONENT_PRICES_NOT_AVAILABLE 0x06       // Etf Component Prices Not Available
#define HALT_REASON_ORDER_IMBALANCE 0x07                          // Order Imbalance
#define HALT_REASON_LULD_TRADING_PAUSE 0x08                       // Luld Trading Pause
#define HALT_REASON_CORPORATE_ACTION 0x09                         // Corporate Action
#define HALT_REASON_NEW_SECURITY_OFFERING 0x0A                    // New Security Offering
#define HALT_REASON_NEWS_PENDING 0x0B                             // News Pending
#define HALT_REASON_INTRADAY_INDICATIVE_VALUE_NOT_AVAILABLE 0x0C  // Intraday Indicative Value Not Available
#define HALT_REASON_OPERATIONAL 0x0D                              // Operational
#define HALT_REASON_SUB_PENNY_TRADING 0x0E                        // Sub Penny Trading
#define HALT_REASON_MARKET_WIDE_CIRCUIT_BREAKER_LEVEL_1 0x0F      // Market Wide Circuit Breaker Level 1
#define HALT_REASON_MARKET_WIDE_CIRCUIT_BREAKER_LEVEL_2 0x10      // Market Wide Circuit Breaker Level 2
#define HALT_REASON_MARKET_WIDE_CIRCUIT_BREAKER_LEVEL_3 0x11      // Market Wide Circuit Breaker Level 3

// Trading Session: one byte code
#define TRADING_SESSION_OPENING 0x31       // Opening
#define TRADING_SESSION_TRADING 0x32       // Trading
#define TRADING_SESSION_POST_TRADING 0x33  // Post Trading
#define TRADING_SESSION_CLOSED 0x34        // Closed

// Sale Condition 1: one byte code
#define SALE_CONDITION_1_REGULAR_TRADE 0x40  // Regular Trade

// Sale Condition 2: one byte code
#define SALE_CONDITION_2_INTERMARKET_SWEEP 0x46              // Intermarket Sweep
#define SALE_CONDITION_2_MARKET_CENTER_OPENING_TRADE 0x4F    // Market Center Opening Trade
#define SALE_CONDITION_2_MARKET_CENTER_REOPENING_TRADE 0x35  // Market Center Reopening Trade
#define SALE_CONDITION_2_MARKET_CENTER_CLOSING_TRADE 0x36    // Market Center Closing Trade
#define SALE_CONDITION_2_NOT_APPLICABLE 0x20                 // Not Applicable

// Sale Condition 3: one byte code
#define SALE_CONDITION_3_FORM_T 0x54          // Form T
#define SALE_CONDITION_3_NOT_APPLICABLE 0x20  // Not Applicable

// Sale Condition 4: one byte code
#define SALE_CONDITION_4_PRICE_VARIATION 0x48  // Price Variation
#define SALE_CONDITION_4_ODD_LOT 0x49          // Odd Lot
#define SALE_CONDITION_4_AUCTION_TRADE 0x58    // Auction Trade
#define SALE_CONDITION_4_NOT_APPLICABLE 0x20   // Not Applicable

// Original Sale Condition 1: one byte code
#define ORIGINAL_SALE_CONDITION_1_REGULAR_TRADE 0x40  // Regular Trade

// Original Sale Condition 2: one byte code
#define ORIGINAL_SALE_CONDITION_2_INTERMARKET_SWEEP 0x46              // Intermarket Sweep
#define ORIGINAL_SALE_CONDITION_2_MARKET_CENTER_OPENING_TRADE 0x4F    // Market Center Opening Trade
#define ORIGINAL_SALE_CONDITION_2_MARKET_CENTER_REOPENING_TRADE 0x35  // Market Center Reopening Trade
#define ORIGINAL_SALE_CONDITION_2_MARKET_CENTER_CLOSING_TRADE 0x36    // Market Center Closing Trade
#define ORIGINAL_SALE_CONDITION_2_NOT_APPLICABLE 0x20                 // Not Applicable

// Original Sale Condition 3: one byte code
#define ORIGINAL_SALE_CONDITION_3_FORM_T 0x54          // Form T
#define ORIGINAL_SALE_CONDITION_3_NOT_APPLICABLE 0x20  // Not Applicable

// Original Sale Condition 4: one byte code
#define ORIGINAL_SALE_CONDITION_4_PRICE_VARIATION 0x48  // Price Variation
#define ORIGINAL_SALE_CONDITION_4_ODD_LOT 0x49          // Odd Lot
#define ORIGINAL_SALE_CONDITION_4_AUCTION_TRADE 0x58    // Auction Trade
#define ORIGINAL_SALE_CONDITION_4_NOT_APPLICABLE 0x20   // Not Applicable

// Corrected Sale Condition 1: one byte code
#define CORRECTED_SALE_CONDITION_1_REGULAR_TRADE 0x40  // Regular Trade

// Corrected Sale Condition 2: one byte code
#define CORRECTED_SALE_CONDITION_2_INTERMARKET_SWEEP 0x46              // Intermarket Sweep
#define CORRECTED_SALE_CONDITION_2_MARKET_CENTER_OPENING_TRADE 0x4F    // Market Center Opening Trade
#define CORRECTED_SALE_CONDITION_2_MARKET_CENTER_REOPENING_TRADE 0x35  // Market Center Reopening Trade
#define CORRECTED_SALE_CONDITION_2_MARKET_CENTER_CLOSING_TRADE 0x36    // Market Center Closing Trade
#define CORRECTED_SALE_CONDITION_2_NOT_APPLICABLE 0x20                 // Not Applicable

// Corrected Sale Condition 3: one byte code
#define CORRECTED_SALE_CONDITION_3_FORM_T 0x54          // Form T
#define CORRECTED_SALE_CONDITION_3_NOT_APPLICABLE 0x20  // Not Applicable

// Corrected Sale Condition 4: one byte code
#define CORRECTED_SALE_CONDITION_4_PRICE_VARIATION 0x48  // Price Variation
#define CORRECTED_SALE_CONDITION_4_ODD_LOT 0x49          // Odd Lot
#define CORRECTED_SALE_CONDITION_4_AUCTION_TRADE 0x58    // Auction Trade
#define CORRECTED_SALE_CONDITION_4_NOT_APPLICABLE 0x20   // Not Applicable

// Auction Type: one byte code
#define AUCTION_TYPE_UNKNOWN 0x20  // Unknown
#define AUCTION_TYPE_OPENING 0x4F  // Opening
#define AUCTION_TYPE_CLOSING 0x43  // Closing
#define AUCTION_TYPE_HALT 0x48     // Halt
#define AUCTION_TYPE_IPO 0x49      // Ipo
#define AUCTION_TYPE_PAUSE 0x50    // Pause

// ---- Types -------------------------------------------------------------------

// InstrumentDirectoryMessage
typedef struct _InstrumentDirectoryMessage {
  UINT64BE timestamp;    // bytes 0 to 7
  UINT16BE security_id;  // bytes 8 to 9
  UINT8 symbol[6];       // bytes 10 to 15
  UINT8 symbol_sfx[6];   // bytes 16 to 21
  UINT32BE round_lot;    // bytes 22 to 25
  UINT8 is_test_symbol;  // byte 26
} InstrumentDirectoryMessage;

// RegSHORestrictionMessage
typedef struct _RegShoRestrictionMessage {
  UINT64BE timestamp;            // bytes 0 to 7
  UINT16BE security_id;          // bytes 8 to 9
  UINT8 short_sale_restriction;  // byte 10
} RegShoRestrictionMessage;

// SecurityTradingStatusMessage
typedef struct _SecurityTradingStatusMessage {
  UINT64BE timestamp;                    // bytes 0 to 7
  UINT16BE security_id;                  // bytes 8 to 9
  UINT8 security_trading_status;         // byte 10
  UINT8 security_trading_status_reason;  // byte 11
  UINT8 halt_reason;                     // byte 12
} SecurityTradingStatusMessage;

// TradingSessionStatusMessage
typedef struct _TradingSessionStatusMessage {
  UINT64BE timestamp;     // bytes 0 to 7
  UINT8 trading_session;  // byte 8
} TradingSessionStatusMessage;

// TradeReportMessage
typedef struct _TradeReportMessage {
  UINT64BE timestamp;      // bytes 0 to 7
  UINT16BE security_id;    // bytes 8 to 9
  UINT64BE trade_id;       // bytes 10 to 17
  UINT32BE trade_qty;      // bytes 18 to 21
  UINT64BE trade_price;    // bytes 22 to 29, signed, read here as unsigned
  UINT8 sale_condition_1;  // byte 30
  UINT8 sale_condition_2;  // byte 31
  UINT8 sale_condition_3;  // byte 32
  UINT8 sale_condition_4;  // byte 33
} TradeReportMessage;

// TradeCancelMessage
typedef struct _TradeCancelMessage {
  UINT64BE timestamp;      // bytes 0 to 7
  UINT16BE security_id;    // bytes 8 to 9
  UINT64BE trade_id;       // bytes 10 to 17
  UINT32BE trade_qty;      // bytes 18 to 21
  UINT64BE last_price;     // bytes 22 to 29, signed, read here as unsigned
  UINT8 sale_condition_1;  // byte 30
  UINT8 sale_condition_2;  // byte 31
  UINT8 sale_condition_3;  // byte 32
  UINT8 sale_condition_4;  // byte 33
} TradeCancelMessage;

// TradeCorrectMessage
typedef struct _TradeCorrectMessage {
  UINT64BE timestamp;                // bytes 0 to 7
  UINT16BE security_id;              // bytes 8 to 9
  UINT64BE trade_id;                 // bytes 10 to 17
  UINT32BE original_trade_qty;       // bytes 18 to 21
  UINT64BE original_trade_price;     // bytes 22 to 29, signed, read here as unsigned
  UINT8 original_sale_condition_1;   // byte 30
  UINT8 original_sale_condition_2;   // byte 31
  UINT8 original_sale_condition_3;   // byte 32
  UINT8 original_sale_condition_4;   // byte 33
  UINT32BE corrected_trade_qty;      // bytes 34 to 37
  UINT64BE corrected_trade_price;    // bytes 38 to 45, signed, read here as unsigned
  UINT8 corrected_sale_condition_1;  // byte 46
  UINT8 corrected_sale_condition_2;  // byte 47
  UINT8 corrected_sale_condition_3;  // byte 48
  UINT8 corrected_sale_condition_4;  // byte 49
} TradeCorrectMessage;

// AuctionTradeMessage
typedef struct _AuctionTradeMessage {
  UINT64BE timestamp;         // bytes 0 to 7
  UINT16BE security_id;       // bytes 8 to 9
  UINT64BE auction_id;        // bytes 10 to 17
  UINT8 auction_type;         // byte 18
  UINT64BE auction_quantity;  // bytes 19 to 26
  UINT64BE auction_price;     // bytes 27 to 34, signed, read here as unsigned
  UINT64BE trade_id;          // bytes 35 to 42
  UINT8 sale_condition_1;     // byte 43
  UINT8 sale_condition_2;     // byte 44
  UINT8 sale_condition_3;     // byte 45
  UINT8 sale_condition_4;     // byte 46
} AuctionTradeMessage;

// BrokenAuctionTradeMessage
typedef struct _BrokenAuctionTradeMessage {
  UINT64BE timestamp;                  // bytes 0 to 7
  UINT16BE security_id;                // bytes 8 to 9
  UINT64BE auction_id;                 // bytes 10 to 17
  UINT64BE trade_id;                   // bytes 18 to 25
  UINT64BE original_auction_quantity;  // bytes 26 to 33
  UINT64BE original_auction_price;     // bytes 34 to 41, signed, read here as unsigned
} BrokenAuctionTradeMessage;

// CorrectedAuctionTradeMessage
typedef struct _CorrectedAuctionTradeMessage {
  UINT64BE timestamp;                   // bytes 0 to 7
  UINT16BE security_id;                 // bytes 8 to 9
  UINT64BE auction_id;                  // bytes 10 to 17
  UINT64BE trade_id;                    // bytes 18 to 25
  UINT64BE original_auction_quantity;   // bytes 26 to 33
  UINT64BE original_auction_price;      // bytes 34 to 41, signed, read here as unsigned
  UINT8 original_sale_condition_1;      // byte 42
  UINT8 original_sale_condition_2;      // byte 43
  UINT8 original_sale_condition_3;      // byte 44
  UINT8 original_sale_condition_4;      // byte 45
  UINT64BE corrected_auction_quantity;  // bytes 46 to 53
  UINT64BE corrected_auction_price;     // bytes 54 to 61, signed, read here as unsigned
  UINT8 corrected_sale_condition_1;     // byte 62
  UINT8 corrected_sale_condition_2;     // byte 63
  UINT8 corrected_sale_condition_3;     // byte 64
  UINT8 corrected_sale_condition_4;     // byte 65
} CorrectedAuctionTradeMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: InstrumentDirectoryMessage instrument_directory_message;
    case 0x02: RegShoRestrictionMessage reg_sho_restriction_message;
    case 0x03: SecurityTradingStatusMessage security_trading_status_message;
    case 0x05: TradingSessionStatusMessage trading_session_status_message;
    case 0x0A: TradeReportMessage trade_report_message;
    case 0x0B: TradeCancelMessage trade_cancel_message;
    case 0x0C: TradeCorrectMessage trade_correct_message;
    case 0x0D: AuctionTradeMessage auction_trade_message;
    case 0x0E: BrokenAuctionTradeMessage broken_auction_trade_message;
    case 0x0F: CorrectedAuctionTradeMessage corrected_auction_trade_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Sbe Message
typedef struct _SbeMessage {
  UINT16BE block_length;                                                                                           // bytes 0 to 1
  UINT8 template_id;                                                                                               // byte 2
  UINT8 schema_id;                                                                                                 // byte 3
  UINT16BE version;                                                                                                // bytes 4 to 5
  Payload(template_id, ((UINT32) block_length)) payload[:byte-size-single-element-array ((UINT32) block_length)];
} SbeMessage;

// Memx Udp Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length;                                                                                                                                         // bytes 0 to 1
  SbeMessage sbe_message;
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Memx Udp Sequenced Message
typedef struct _SequencedMessage (UINT32 available, mutable UINT32 * tally) where (available >= 2) {
  UINT16BE message_count;                                                                                                   // bytes 0 to 1
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 2)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} SequencedMessage;

// Branch
casetype _SequencedMessages (UINT8 selector, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    case 0x01: unit session_shutdown;
    case 0x02: SequencedMessage(available, tally) sequenced_message;
    default: UINT8 unknown[available];
  }
} SequencedMessages;

// ---- Packet: Packet ----------------------------------------------------------

// Memx Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 18) {
  UINT8 message_type;                                                                                                             // byte 0
  UINT8 header_length;                                                                                                            // byte 1
  UINT64BE session_id;                                                                                                            // bytes 2 to 9
  UINT64BE sequence_number;                                                                                                       // bytes 10 to 17
  SequencedMessages(message_type, (available - 18), tally) sequenced_messages[:byte-size-single-element-array (available - 18)];
} Packet;

