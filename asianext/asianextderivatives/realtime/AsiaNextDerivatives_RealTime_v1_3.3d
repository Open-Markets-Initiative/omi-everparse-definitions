// AsiaNext Real Time Market Data Feed
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out AsiaNextDerivatives_RealTime_v1_3.3d
//
// What this definition does not state, and the model does:
// - a run counted by a field
// - a field read in bits
//
// License: MIT No Attribution

// ---- Packet Header: 1 byte ---------------------------------------------------

// Aquis udp packet header
entrypoint typedef struct _PacketHeader {
  UINT8 message_count;  // byte 0
} PacketHeader;

// ---- Message Header: 6 bytes -------------------------------------------------

// Aquis market data message header
entrypoint typedef struct _MessageHeader {
  UINT8 msg_type;    // byte 0
  UINT8 msg_length;  // byte 1
  UINT32 seq_no;     // bytes 2 to 5
} MessageHeader;

// ---- Sequence Number Reset Message: 4 bytes ----------------------------------

// The Sequence Number Reset is published when AsiaNext initiates a seqNo reset.
entrypoint typedef struct _SequenceNumberResetMessage {
  UINT32 next_seq_no;  // bytes 0 to 3
} SequenceNumberResetMessage;

// ---- Order Add Message: 37 bytes ---------------------------------------------

// The Order Add message is published when order quantity is posted to the order book for a particular security.
entrypoint typedef struct _OrderAddMessage {
  UINT32 security_id;  // bytes 0 to 3
  UINT8 side;          // byte 4
  UINT64 quantity;     // bytes 5 to 12
  UINT64 price;        // bytes 13 to 20
  UINT64 order_ref;    // bytes 21 to 28
  UINT64 timestamp;    // bytes 29 to 36
} OrderAddMessage;

// ---- Order Cancel Message: 20 bytes ------------------------------------------

// The Order Cancel message is published when a visible order is removed from the book.
entrypoint typedef struct _OrderCancelMessage {
  UINT32 security_id;  // bytes 0 to 3
  UINT64 order_ref;    // bytes 4 to 11
  UINT64 timestamp;    // bytes 12 to 19
} OrderCancelMessage;

// ---- Order Modify Message: 36 bytes ------------------------------------------

// The Order Modify message is published when a visible order is modified by the client (change of price and/or quantity).
entrypoint typedef struct _OrderModifyMessage {
  UINT32 security_id;  // bytes 0 to 3
  UINT64 quantity;     // bytes 4 to 11
  UINT64 price;        // bytes 12 to 19
  UINT64 order_ref;    // bytes 20 to 27
  UINT64 timestamp;    // bytes 28 to 35
} OrderModifyMessage;

// ---- Tick Table Data Message: 27 bytes ---------------------------------------

// A series of Tick Table Data messages are published to specify the dynamic tick tables and static ticks that apply to the securities traded on AsiaNext.
entrypoint typedef struct _TickTableDataMessage {
  UINT8 tick_table_id;  // byte 0
  UINT8 name[10];       // bytes 1 to 10
  UINT64 threshold;     // bytes 11 to 18
  UINT64 tick_size;     // bytes 19 to 26
} TickTableDataMessage;

// ---- Lot Size Composite: 9 bytes ---------------------------------------------

// Lot size scaled at runtime by lotSizeDecimal
entrypoint typedef struct _LotSizeComposite {
  UINT64 lot_size;         // bytes 0 to 7
  UINT8 lot_size_decimal;  // byte 8
} LotSizeComposite;

// ---- Contract Size Composite: 9 bytes ----------------------------------------

// Contract size scaled at runtime by contractSizeDecimals
entrypoint typedef struct _ContractSizeComposite {
  UINT64 contract_size;          // bytes 0 to 7
  UINT8 contract_size_decimals;  // byte 8
} ContractSizeComposite;

