// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AsiaNextDerivatives_RealTime_v1_3.3d

// ---- Values ------------------------------------------------------------------

// Msg Type: one byte code
#define MSG_TYPE_HEARTBEAT_MESSAGE 0x01                    // Heartbeat Message
#define MSG_TYPE_SEQUENCE_NUMBER_RESET_MESSAGE 0x1D        // Sequence Number Reset Message
#define MSG_TYPE_ORDER_ADD_MESSAGE 0x02                    // Order Add Message
#define MSG_TYPE_ORDER_CANCEL_MESSAGE 0x03                 // Order Cancel Message
#define MSG_TYPE_ORDER_MODIFY_MESSAGE 0x04                 // Order Modify Message
#define MSG_TYPE_TRADE_MESSAGE 0x05                        // Trade Message
#define MSG_TYPE_TRADE_BUST_MESSAGE 0x06                   // Trade Bust Message
#define MSG_TYPE_TICK_TABLE_DATA_MESSAGE 0x07              // Tick Table Data Message
#define MSG_TYPE_SECURITY_DEFINITION_MESSAGE 0x08          // Security Definition Message
#define MSG_TYPE_SECURITY_DEFINITION_FUTURES_MESSAGE 0x1E  // Security Definition Futures Message
#define MSG_TYPE_SECURITY_DEFINITION_OPTIONS_MESSAGE 0x20  // Security Definition Options Message
#define MSG_TYPE_SECURITY_STATUS_MESSAGE 0x09              // Security Status Message

// Side: one byte code
#define SIDE_BUY_ORDER 0x01   // Buy Order
#define SIDE_SELL_ORDER 0x02  // Sell Order

// Trade Type: one byte code
#define TRADE_TYPE_VISIBLE 0x01  // Visible

// Settlement Type: one byte code
#define SETTLEMENT_TYPE_CASH 0x01      // Cash
#define SETTLEMENT_TYPE_PHYSICAL 0x02  // Physical

// Option Type: one byte code
#define OPTION_TYPE_CALL 0x01  // Call
#define OPTION_TYPE_PUT 0x02   // Put

// Exercise Style: one byte code
#define EXERCISE_STYLE_AMERICAN 0x01  // American
#define EXERCISE_STYLE_EUROPEAN 0x02  // European
#define EXERCISE_STYLE_ASIAN 0x03     // Asian
#define EXERCISE_STYLE_BERMUDAN 0x04  // Bermudan

// Trading Status: one byte code
#define TRADING_STATUS_ACTIVE 0x01     // Active
#define TRADING_STATUS_HALTED 0x02     // Halted
#define TRADING_STATUS_SUSPENDED 0x03  // Suspended

// Trading Phase: one byte code
#define TRADING_PHASE_CONTINUOUS_TRADING 0x01  // Continuous Trading

// ---- Types -------------------------------------------------------------------

// The Sequence Number Reset is published when AsiaNext initiates a seqNo reset.
typedef struct _SequenceNumberResetMessage {
  UINT32 next_seq_no;  // bytes 0 to 3
} SequenceNumberResetMessage;

// The Order Add message is published when order quantity is posted to the order book for a particular security.
typedef struct _OrderAddMessage {
  UINT32 security_id;  // bytes 0 to 3
  UINT8 side;          // byte 4
  UINT64 quantity;     // bytes 5 to 12
  UINT64 price;        // bytes 13 to 20
  UINT64 order_ref;    // bytes 21 to 28
  UINT64 timestamp;    // bytes 29 to 36
} OrderAddMessage;

// The Order Cancel message is published when a visible order is removed from the book.
typedef struct _OrderCancelMessage {
  UINT32 security_id;  // bytes 0 to 3
  UINT64 order_ref;    // bytes 4 to 11
  UINT64 timestamp;    // bytes 12 to 19
} OrderCancelMessage;

// The Order Modify message is published when a visible order is modified by the client (change of price and/or quantity).
typedef struct _OrderModifyMessage {
  UINT32 security_id;  // bytes 0 to 3
  UINT64 quantity;     // bytes 4 to 11
  UINT64 price;        // bytes 12 to 19
  UINT64 order_ref;    // bytes 20 to 27
  UINT64 timestamp;    // bytes 28 to 35
} OrderModifyMessage;

// Whenever an order trades, partially or fully, a Trade message is published.
typedef struct _TradeMessage {
  UINT32 security_id;                                                 // bytes 0 to 3
  UINT8 trade_type;                                                   // byte 4
  UINT64 quantity;                                                    // bytes 5 to 12
  UINT64 price;                                                       // bytes 13 to 20
  UINT64 order_ref;                                                   // bytes 21 to 28
  UINT64 trade_ref;                                                   // bytes 29 to 36
  UINT64 timestamp;                                                   // bytes 37 to 44
  UINT32 market_mechanism : 3;                                        // bytes 45 to 48
  UINT32 trading_mode : 4;                                            // bytes 45 to 48
  UINT32 transaction_category : 3;                                    // bytes 45 to 48
  UINT32 negotiation_indicator_or_pre_trade_transparency_waiver : 3;  // bytes 45 to 48
  UINT32 crossing_trade : 1;                                          // bytes 45 to 48
  UINT32 modification_indicator : 2;                                  // bytes 45 to 48
  UINT32 benchmark_reference_price_indicator : 2;                     // bytes 45 to 48
  UINT32 dividend : 1;                                                // bytes 45 to 48
  UINT32 off_book_automation : 2;                                     // bytes 45 to 48
  UINT32 price_formation_discovery_process : 3;                       // bytes 45 to 48
  UINT32 algorithmic_indicator : 1;                                   // bytes 45 to 48
  UINT32 publication_mode_post_trade_deferral : 3;                    // bytes 45 to 48
  UINT32 deferral_type : 1;                                           // bytes 45 to 48
  UINT32 duplicative_indicator : 1;                                   // bytes 45 to 48
  UINT32 unused_2 : 2;                                                // bytes 45 to 48
} TradeMessage;

// If a trade has been declared erroneous by AsiaNext then a Trade Bust message is published.
typedef struct _TradeBustMessage {
  UINT32 security_id;                                                 // bytes 0 to 3
  UINT64 quantity;                                                    // bytes 4 to 11
  UINT64 price;                                                       // bytes 12 to 19
  UINT64 trade_ref;                                                   // bytes 20 to 27
  UINT64 timestamp;                                                   // bytes 28 to 35
  UINT32 market_mechanism : 3;                                        // bytes 36 to 39
  UINT32 trading_mode : 4;                                            // bytes 36 to 39
  UINT32 transaction_category : 3;                                    // bytes 36 to 39
  UINT32 negotiation_indicator_or_pre_trade_transparency_waiver : 3;  // bytes 36 to 39
  UINT32 crossing_trade : 1;                                          // bytes 36 to 39
  UINT32 modification_indicator : 2;                                  // bytes 36 to 39
  UINT32 benchmark_reference_price_indicator : 2;                     // bytes 36 to 39
  UINT32 dividend : 1;                                                // bytes 36 to 39
  UINT32 off_book_automation : 2;                                     // bytes 36 to 39
  UINT32 price_formation_discovery_process : 3;                       // bytes 36 to 39
  UINT32 algorithmic_indicator : 1;                                   // bytes 36 to 39
  UINT32 publication_mode_post_trade_deferral : 3;                    // bytes 36 to 39
  UINT32 deferral_type : 1;                                           // bytes 36 to 39
  UINT32 duplicative_indicator : 1;                                   // bytes 36 to 39
  UINT32 unused_2 : 2;                                                // bytes 36 to 39
} TradeBustMessage;

// A series of Tick Table Data messages are published to specify the dynamic tick tables and static ticks that apply to the securities traded on AsiaNext.
typedef struct _TickTableDataMessage {
  UINT8 tick_table_id;  // byte 0
  UINT8 name[10];       // bytes 1 to 10
  UINT64 threshold;     // bytes 11 to 18
  UINT64 tick_size;     // bytes 19 to 26
} TickTableDataMessage;

// Lot size scaled at runtime by lotSizeDecimal
typedef struct _LotSizeComposite {
  UINT64 lot_size;         // bytes 0 to 7
  UINT8 lot_size_decimal;  // byte 8
} LotSizeComposite;

// Security Definition messages are published to identify the securities traded on AsiaNext.
typedef struct _SecurityDefinitionMessage {
  UINT32 security_id;                   // bytes 0 to 3
  UINT8 umtf[6];                        // bytes 4 to 9
  UINT8 isin[12];                       // bytes 10 to 21
  UINT8 currency[3];                    // bytes 22 to 24
  UINT8 mic[4];                         // bytes 25 to 28
  UINT8 tick_table_id;                  // byte 29
  UINT16 mac_enabled : 1;               // bytes 30 to 31
  UINT16 test_stock : 1;                // bytes 30 to 31
  UINT16 illiquid : 1;                  // bytes 30 to 31
  UINT16 live : 1;                      // bytes 30 to 31
  UINT16 aod_enabled : 1;               // bytes 30 to 31
  UINT16 unused_11 : 11;                // bytes 30 to 31
  UINT8 exchange_symbol[20];            // bytes 32 to 51
  LotSizeComposite lot_size_composite;  // bytes 52 to 60
} SecurityDefinitionMessage;

// Contract size scaled at runtime by contractSizeDecimals
typedef struct _ContractSizeComposite {
  UINT64 contract_size;          // bytes 0 to 7
  UINT8 contract_size_decimals;  // byte 8
} ContractSizeComposite;

// Security Definition messages are published to identify the Futures securities traded on AsiaNext.
typedef struct _SecurityDefinitionFuturesMessage {
  UINT32 security_id;                             // bytes 0 to 3
  UINT8 umtf[6];                                  // bytes 4 to 9
  UINT8 isin[12];                                 // bytes 10 to 21
  UINT8 currency[3];                              // bytes 22 to 24
  UINT8 mic[4];                                   // bytes 25 to 28
  UINT8 tick_table_id;                            // byte 29
  UINT16 mac_enabled : 1;                         // bytes 30 to 31
  UINT16 test_stock : 1;                          // bytes 30 to 31
  UINT16 illiquid : 1;                            // bytes 30 to 31
  UINT16 live : 1;                                // bytes 30 to 31
  UINT16 unused_1 : 1;                            // bytes 30 to 31
  UINT16 underlying_flag : 1;                     // bytes 30 to 31
  UINT16 rfq_only : 1;                            // bytes 30 to 31
  UINT16 unused_9 : 9;                            // bytes 30 to 31
  UINT8 exchange_symbol[20];                      // bytes 32 to 51
  LotSizeComposite lot_size_composite;            // bytes 52 to 60
  UINT64 maturity_date;                           // bytes 61 to 68
  UINT8 settlement_type;                          // byte 69
  ContractSizeComposite contract_size_composite;  // bytes 70 to 78
  UINT8 underlying[20];                           // bytes 79 to 98
} SecurityDefinitionFuturesMessage;

// Security Definition messages are published to identify the Option securities traded on AsiaNext.
typedef struct _SecurityDefinitionOptionsMessage {
  UINT32 security_id;                             // bytes 0 to 3
  UINT8 umtf[6];                                  // bytes 4 to 9
  UINT8 isin[12];                                 // bytes 10 to 21
  UINT8 currency[3];                              // bytes 22 to 24
  UINT8 mic[4];                                   // bytes 25 to 28
  UINT8 tick_table_id;                            // byte 29
  UINT16 unused_1 : 1;                            // bytes 30 to 31
  UINT16 test_stock : 1;                          // bytes 30 to 31
  UINT16 illiquid : 1;                            // bytes 30 to 31
  UINT16 live : 1;                                // bytes 30 to 31
  UINT16 second_unused_1 : 1;                     // bytes 30 to 31
  UINT16 underlying_flag : 1;                     // bytes 30 to 31
  UINT16 rfq_only : 1;                            // bytes 30 to 31
  UINT16 unused_9 : 9;                            // bytes 30 to 31
  UINT8 exchange_symbol[20];                      // bytes 32 to 51
  LotSizeComposite lot_size_composite;            // bytes 52 to 60
  UINT64 maturity_date;                           // bytes 61 to 68
  UINT8 settlement_type;                          // byte 69
  ContractSizeComposite contract_size_composite;  // bytes 70 to 78
  UINT8 underlying[20];                           // bytes 79 to 98
  UINT8 option_type;                              // byte 99
  UINT8 exercise_style;                           // byte 100
  UINT64 strike_price;                            // bytes 101 to 108
} SecurityDefinitionOptionsMessage;

// The Security Status message is published when the trading status of a security changes or when there is a change to the status of the market on AsiaNext to which the security belongs.
typedef struct _SecurityStatusMessage {
  UINT32 security_id;    // bytes 0 to 3
  UINT8 trading_status;  // byte 4
  UINT8 trading : 1;     // byte 5
  UINT8 mac_open : 1;    // byte 5
  UINT8 mac_run : 1;     // byte 5
  UINT8 unused_5 : 5;    // byte 5
  UINT64 timestamp;      // bytes 6 to 13
  UINT8 trading_phase;   // byte 14
} SecurityStatusMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: unit heartbeat_message;
    case 0x1D: SequenceNumberResetMessage sequence_number_reset_message;
    case 0x02: OrderAddMessage order_add_message;
    case 0x03: OrderCancelMessage order_cancel_message;
    case 0x04: OrderModifyMessage order_modify_message;
    case 0x05: TradeMessage trade_message;
    case 0x06: TradeBustMessage trade_bust_message;
    case 0x07: TickTableDataMessage tick_table_data_message;
    case 0x08: SecurityDefinitionMessage security_definition_message;
    case 0x1E: SecurityDefinitionFuturesMessage security_definition_futures_message;
    case 0x20: SecurityDefinitionOptionsMessage security_definition_options_message;
    case 0x09: SecurityStatusMessage security_status_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Aquis Amd Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT8 msg_type;                                                                                                                                                  // byte 0
  UINT8 msg_length { msg_length >= 6 };                                                                                                                            // byte 1
  UINT32 seq_no;                                                                                                                                                   // bytes 2 to 5
  Payload(msg_type, (((UINT32) msg_length) - 6)) payload[:byte-size-single-element-array (((UINT32) msg_length) - 6)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Aquis Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 1) {
  UINT8 message_count;                                                                                                      // byte 0
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 1)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} Packet;

