// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AsiaNextDerivatives_TradingProtocol_v1_2.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - a field read in bits
// - the dispatch that chooses a message by its type
// - the packet as a whole, which is a union whose readings take different widths, at packet.message.payload.orderaddresponsemessage.orderaddresponsestatus

// ---- Values ------------------------------------------------------------------

// Msg Type: one byte code
#define MSG_TYPE_LOGIN_MESSAGE 0x01                       // Login Message
#define MSG_TYPE_LOGIN_RESPONSE_MESSAGE 0x02              // Login Response Message
#define MSG_TYPE_HEARTBEAT_MESSAGE 0x00                   // Heartbeat Message
#define MSG_TYPE_LOGOUT_REQUEST_MESSAGE 0x03              // Logout Request Message
#define MSG_TYPE_LOGOUT_MESSAGE 0x04                      // Logout Message
#define MSG_TYPE_ORDER_ADD_MESSAGE 0x05                   // Order Add Message
#define MSG_TYPE_ORDER_ADD_EXTENDED_MESSAGE 0x15          // Order Add Extended Message
#define MSG_TYPE_ORDER_CANCEL_MESSAGE 0x07                // Order Cancel Message
#define MSG_TYPE_ORDER_MODIFY_MESSAGE 0x09                // Order Modify Message
#define MSG_TYPE_ORDER_MODIFY_EXTENDED_MESSAGE 0x16       // Order Modify Extended Message
#define MSG_TYPE_ORDER_ADD_RESPONSE_MESSAGE 0x06          // Order Add Response Message
#define MSG_TYPE_ORDER_CANCEL_RESPONSE_MESSAGE 0x08       // Order Cancel Response Message
#define MSG_TYPE_ORDER_MODIFY_RESPONSE_MESSAGE 0x0A       // Order Modify Response Message
#define MSG_TYPE_QUOTE_REQUEST_MESSAGE 0x1E               // Quote Request Message
#define MSG_TYPE_QUOTE_REQUEST_NOTIFICATION_MESSAGE 0x1F  // Quote Request Notification Message
#define MSG_TYPE_QUOTE_ADD_MESSAGE 0x0D                   // Quote Add Message
#define MSG_TYPE_QUOTE_MODIFY_MESSAGE 0x0E                // Quote Modify Message
#define MSG_TYPE_QUOTE_CANCEL_MESSAGE 0x0F                // Quote Cancel Message
#define MSG_TYPE_TRADE_MESSAGE 0x0B                       // Trade Message
#define MSG_TYPE_TRADE_BUST_MESSAGE 0x0C                  // Trade Bust Message

// Result Code: one byte code
#define RESULT_CODE_SUCCESSFUL_LOGIN 0x00        // Successful Login
#define RESULT_CODE_ALREADY_LOGGED_IN 0x01       // Already Logged In
#define RESULT_CODE_SEQUENCE_NUMBER_ERROR 0x02   // Sequence Number Error
#define RESULT_CODE_UNSUPPORTED_PROTOCOL 0x03    // Unsupported Protocol
#define RESULT_CODE_FAILED_AUTHENTICATION 0x04   // Failed Authentication
#define RESULT_CODE_UNKNOWN_SOURCE_NETWORK 0x05  // Unknown Source Network

// Logout Reason Code: one byte code
#define LOGOUT_REASON_CODE_USER_REQUESTED 0x00         // User Requested
#define LOGOUT_REASON_CODE_ADMIN 0x01                  // Admin
#define LOGOUT_REASON_CODE_DISCONNECT 0x02             // Disconnect
#define LOGOUT_REASON_CODE_END_OF_DAY 0x03             // End Of Day
#define LOGOUT_REASON_CODE_INACTIVITY_TIMEOUT 0x04     // Inactivity Timeout
#define LOGOUT_REASON_CODE_PROTOCOL_ERROR 0x05         // Protocol Error
#define LOGOUT_REASON_CODE_SEQUENCE_NUMBER_ERROR 0x06  // Sequence Number Error
#define LOGOUT_REASON_CODE_MAINTENANCE 0x08            // Maintenance

// Side: one byte code
#define SIDE_NO_SIDE_SPECIFIED 0x00  // No Side Specified
#define SIDE_BUY_ORDER 0x01          // Buy Order
#define SIDE_SELL_ORDER 0x02         // Sell Order

// Quote Request Status: one byte code
#define QUOTE_REQUEST_STATUS_ACKNOWLEDGEMENT 0x01  // Acknowledgement
#define QUOTE_REQUEST_STATUS_EXPIRED 0x02          // Expired
#define QUOTE_REQUEST_STATUS_REJECTED 0x03         // Rejected

// Status Details: one byte code
#define STATUS_DETAILS_ACKNOWLEDGEMENT 0x00       // Acknowledgement
#define STATUS_DETAILS_SECURITY_SUSPENDED 0x01    // Security Suspended
#define STATUS_DETAILS_SECURITY_HALTED 0x02       // Security Halted
#define STATUS_DETAILS_UNSUPPORTED_SECURITY 0x03  // Unsupported Security
#define STATUS_DETAILS_INVALID_MARKET_MAKER 0x04  // Invalid Market Maker
#define STATUS_DETAILS_INVALID_SIDE 0x05          // Invalid Side
#define STATUS_DETAILS_INVALID_QUANTITY 0x06      // Invalid Quantity
#define STATUS_DETAILS_NOT_SUPPORTED 0x08         // Not Supported
#define STATUS_DETAILS_INVALID_ORDER_TYPE 0x09    // Invalid Order Type
#define STATUS_DETAILS_INTERNAL_ERROR 0x0A        // Internal Error
#define STATUS_DETAILS_NOT_AUTHORISED 0x0B        // Not Authorised
#define STATUS_DETAILS_MARKET_CLOSED 0x0C         // Market Closed
#define STATUS_DETAILS_SESSION_CLOSED 0x0D        // Session Closed

// ---- Message Header: 11 bytes ------------------------------------------------

// AsiaNext Atp message header
entrypoint typedef struct _MessageHeader {
  UINT16 msg_length;  // bytes 0 to 1
  UINT8 msg_type;     // byte 2, values MSG_TYPE_
  UINT64 msg_seq_no;  // bytes 3 to 10
} MessageHeader;

// ---- Login Message: 44 bytes -------------------------------------------------

// The Login message is sent by the trading Member as the initial message used to establish a trading session. It is also used to re-establish a session after a break.
entrypoint typedef struct _LoginMessage {
  UINT16 protocol_version;    // bytes 0 to 1
  UINT8 sender_id[16];        // bytes 2 to 17
  UINT8 password[16];         // bytes 18 to 33
  UINT16 inactivity_timeout;  // bytes 34 to 35
  UINT64 atp_seq_no;          // bytes 36 to 43
} LoginMessage;

// ---- Login Response Message: 9 bytes -----------------------------------------

// The Login Response message is sent by AsiaNext to acknowledge a Login request, and either accept or reject it.
entrypoint typedef struct _LoginResponseMessage {
  UINT8 result_code;     // byte 0, values RESULT_CODE_
  UINT64 client_seq_no;  // bytes 1 to 8
} LoginResponseMessage;

// ---- Logout Message: 33 bytes ------------------------------------------------

// The Logout message is usually sent as a response to the Logout Request. However it may also be sent by AsiaNext in case of a low sequence number or other protocol violation, or for other reasons.
entrypoint typedef struct _LogoutMessage {
  UINT8 logout_reason_code;  // byte 0, values LOGOUT_REASON_CODE_
  UINT8 reason_text[32];     // bytes 1 to 32
} LogoutMessage;

// ---- Quote Request Message: 37 bytes -----------------------------------------

// The Quote Request Message is sent to commence RFQ session.
entrypoint typedef struct _QuoteRequestMessage {
  UINT32 security_id_long;       // bytes 0 to 3
  UINT32 quantity;               // bytes 4 to 7
  UINT8 side;                    // byte 8, values SIDE_
  UINT64 user_tag;               // bytes 9 to 16
  UINT8 market_maker_code_1[4];  // bytes 17 to 20
  UINT8 market_maker_code_2[4];  // bytes 21 to 24
  UINT8 market_maker_code_3[4];  // bytes 25 to 28
  UINT8 market_maker_code_4[4];  // bytes 29 to 32
  UINT8 market_maker_code_5[4];  // bytes 33 to 36
} QuoteRequestMessage;

// ---- Quote Request Notification Message: 35 bytes ----------------------------

// The Quote Request Notification is sent back to requestor to acknowledge the Quote Request. It is also sent to Market Maker to share the Quote Request.
entrypoint typedef struct _QuoteRequestNotificationMessage {
  UINT64 rfq_session_id;       // bytes 0 to 7
  UINT32 security_id_long;     // bytes 8 to 11
  UINT32 quantity;             // bytes 12 to 15
  UINT8 side;                  // byte 16, values SIDE_
  UINT8 quote_request_status;  // byte 17, values QUOTE_REQUEST_STATUS_
  UINT8 status_details;        // byte 18, values STATUS_DETAILS_
  UINT64 msg_ref;              // bytes 19 to 26
  UINT64 user_tag;             // bytes 27 to 34
} QuoteRequestNotificationMessage;

// ---- Quote Add Message: 31 bytes ---------------------------------------------

// The Quote Add Message is used to disseminate quotes sent by Market Makers to the RFQ session requestor.
entrypoint typedef struct _QuoteAddMessage {
  UINT64 aqx_order_id;       // bytes 0 to 7
  UINT16 security_id_short;  // bytes 8 to 9
  UINT8 side;                // byte 10, values SIDE_
  UINT32 quantity;           // bytes 11 to 14
  UINT64 price;              // bytes 15 to 22
  UINT64 rfq_session_id;     // bytes 23 to 30
} QuoteAddMessage;

// ---- Quote Modify Message: 22 bytes ------------------------------------------

// Quote Modify Message is used to disseminate any quote modification submitted by the market makers to the RFQ session requestor.
entrypoint typedef struct _QuoteModifyMessage {
  UINT64 aqx_order_id;       // bytes 0 to 7
  UINT16 security_id_short;  // bytes 8 to 9
  UINT32 quantity;           // bytes 10 to 13
  UINT64 price;              // bytes 14 to 21
} QuoteModifyMessage;

// ---- Quote Cancel Message: 10 bytes ------------------------------------------

// Quote Cancel Message is used to disseminate any quote cancelation messages submitted by the market makers to the RFQ session requestor.
entrypoint typedef struct _QuoteCancelMessage {
  UINT64 aqx_order_id;       // bytes 0 to 7
  UINT16 security_id_short;  // bytes 8 to 9
} QuoteCancelMessage;

// ---- Trade Bust Message: 37 bytes --------------------------------------------

// If a trade is invalidated, a Trade Bust message is sent to notify the trading Member.
entrypoint typedef struct _TradeBustMessage {
  UINT64 order_ref;  // bytes 0 to 7
  UINT32 quantity;   // bytes 8 to 11
  UINT64 price;      // bytes 12 to 19
  UINT8 side;        // byte 20, values SIDE_
  UINT64 trade_ref;  // bytes 21 to 28
  UINT64 timestamp;  // bytes 29 to 36
} TradeBustMessage;

