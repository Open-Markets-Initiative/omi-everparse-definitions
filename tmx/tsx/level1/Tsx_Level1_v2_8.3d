// ---- Message Header: 22 bytes ------------------------------------------------

// Twenty two byte ascii header carried on every Qrtmd message
entrypoint typedef struct _MessageHeader {
  UINT8 message_length[4];          // bytes 0 to 3
  UINT8 sequence_number[9];         // bytes 4 to 12
  UINT8 service_identifier[3];      // bytes 13 to 15
  UINT8 retransmission_identifier;  // byte 16
  UINT8 continuation_identifier;    // byte 17
  UINT8 message_type[2];            // bytes 18 to 19
  UINT8 exchange_identifier[2];     // bytes 20 to 21
} MessageHeader;

// ---- Trade Message: 105 bytes ------------------------------------------------

// A trade in an equity on the Tsx or Tsx Venture market.
entrypoint typedef struct _TradeMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 volume[9];                      // bytes 12 to 20
  UINT8 trade_price[11];                // bytes 21 to 31
  UINT8 buyer_id[3];                    // bytes 32 to 34
  UINT8 seller_id[3];                   // bytes 35 to 37
  UINT8 trade_time_stamp[6];            // bytes 38 to 43
  UINT8 last_sale[11];                  // bytes 44 to 54
  UINT8 trade_id[9];                    // bytes 55 to 63
  UINT8 cross_type;                     // byte 64
  UINT8 moc;                            // byte 65
  UINT8 bypass;                         // byte 66
  UINT8 opening_trade;                  // byte 67
  UINT8 settlement_terms;               // byte 68
  UINT8 trading_system_time_stamp[23];  // bytes 69 to 91
  UINT8 listing_market;                 // byte 92
  UINT8 product_type;                   // byte 93
  UINT8 trade_date[8];                  // bytes 94 to 101
  UINT8 is_mid_only;                    // byte 102
  UINT8 is_dark;                        // byte 103
  UINT8 is_conditional;                 // byte 104
} TradeMessage;

// ---- Symbol Status Message: 164 bytes ----------------------------------------

// Reference information for a symbol trading on the current day.
entrypoint typedef struct _SymbolStatusMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 trading_system_time_stamp[23];  // bytes 12 to 34
  UINT8 exchange_id[3];                 // bytes 35 to 37
  UINT8 cusip[12];                      // bytes 38 to 49
  UINT8 board_lot[9];                   // bytes 50 to 58
  UINT8 currency;                       // byte 59
  UINT8 face_value[9];                  // bytes 60 to 68
  UINT8 last_sale[11];                  // bytes 69 to 79
  UINT8 moc_eligible;                   // byte 80
  UINT8 product_type;                   // byte 81
  UINT8 symbol_name[40];                // bytes 82 to 121
  UINT8 stock_group[2];                 // bytes 122 to 123
  UINT8 stock_state[2];                 // bytes 124 to 125
  UINT8 listing_market;                 // byte 126
  UINT8 buy_maximum_quantity[9];        // bytes 127 to 135
  UINT8 buy_minimum_quantity[9];        // bytes 136 to 144
  UINT8 sell_maximum_quantity[9];       // bytes 145 to 153
  UINT8 sell_minimum_quantity[9];       // bytes 154 to 162
  UINT8 test_symbol;                    // byte 163
} SymbolStatusMessage;

// ---- Moc Imbalance Notification Message: 102 bytes ---------------------------

// Volume imbalance for a Market On Close eligible symbol, sent every ten seconds from the beginning of the MOC Imbalance session.
entrypoint typedef struct _MocImbalanceNotificationMessage {
  UINT8 symbol[12];                         // bytes 0 to 11
  UINT8 imbalance_side;                     // byte 12
  UINT8 imbalance_volume[9];                // bytes 13 to 21
  UINT8 imbalance_reference_price[11];      // bytes 22 to 32
  UINT8 paired_volume[9];                   // bytes 33 to 41
  UINT8 market_order_imbalance_volume[9];   // bytes 42 to 50
  UINT8 market_order_imbalance_side;        // byte 51
  UINT8 near_indicative_closing_price[11];  // bytes 52 to 62
  UINT8 far_indicative_closing_price[11];   // bytes 63 to 73
  UINT8 price_variation[5];                 // bytes 74 to 78
  UINT8 trading_system_time_stamp[23];      // bytes 79 to 101
} MocImbalanceNotificationMessage;

// ---- Moc Price Movement Delay Message: 59 bytes ------------------------------

// Transmitted when Price Movement Extension is invoked.
entrypoint typedef struct _MocPriceMovementDelayMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 trading_system_time_stamp[23];  // bytes 12 to 34
  UINT8 stock_state[2];                 // bytes 35 to 36
  UINT8 ccp[11];                        // bytes 37 to 47
  UINT8 vwap[11];                       // bytes 48 to 58
} MocPriceMovementDelayMessage;

// ---- Stock State Message: 85 bytes -------------------------------------------

// A change in the trading state of a stock.
entrypoint typedef struct _StockStateMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 trading_system_time_stamp[23];  // bytes 12 to 34
  UINT8 comment[40];                    // bytes 35 to 74
  UINT8 stock_state[2];                 // bytes 75 to 76
  UINT8 opening_time[6];                // bytes 77 to 82
  UINT8 listing_market;                 // byte 83
  UINT8 product_type;                   // byte 84
} StockStateMessage;

// ---- Quote Message: 71 bytes -------------------------------------------------

// Full update quote sent whenever either the bid or the ask has changed.
entrypoint typedef struct _QuoteMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 bid_price[9];                   // bytes 12 to 20
  UINT8 bid_size[9];                    // bytes 21 to 29
  UINT8 ask_price[9];                   // bytes 30 to 38
  UINT8 ask_size[9];                    // bytes 39 to 47
  UINT8 trading_system_time_stamp[23];  // bytes 48 to 70
} QuoteMessage;

// ---- General Message: 104 bytes ----------------------------------------------

// Bulletin in textual format.
entrypoint typedef struct _GeneralMessage {
  UINT8 trading_system_time_stamp[23];  // bytes 0 to 22
  UINT8 bulletin_indicator;             // byte 23
  UINT8 message_text[80];               // bytes 24 to 103
} GeneralMessage;

// ---- Trade Cancellation Message: 97 bytes ------------------------------------

// Cancellation of a trade, reducing total volume, value and transactions by the amount of the cancellation.
entrypoint typedef struct _TradeCancellationMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 volume[9];                      // bytes 12 to 20
  UINT8 trade_price[11];                // bytes 21 to 31
  UINT8 buyer_id[3];                    // bytes 32 to 34
  UINT8 seller_id[3];                   // bytes 35 to 37
  UINT8 trade_time_stamp[6];            // bytes 38 to 43
  UINT8 original_trade_id[9];           // bytes 44 to 52
  UINT8 last_sale[11];                  // bytes 53 to 63
  UINT8 trading_system_time_stamp[23];  // bytes 64 to 86
  UINT8 listing_market;                 // byte 87
  UINT8 product_type;                   // byte 88
  UINT8 trade_date[8];                  // bytes 89 to 96
} TradeCancellationMessage;

// ---- Indicative Price Message: 44 bytes --------------------------------------

// Indicative Closing Price, calculated and published at sixteen hundred London time on every trading day.
entrypoint typedef struct _IndicativePriceMessage {
  UINT8 symbol[12];            // bytes 0 to 11
  UINT8 cusip[12];             // bytes 12 to 23
  UINT8 indicative_price[11];  // bytes 24 to 34
  UINT8 price_marker;          // byte 35
  UINT8 business_date[8];      // bytes 36 to 43
} IndicativePriceMessage;

// ---- Calculated Opening Price Message: 59 bytes ------------------------------

// Calculated Opening Price, published continuously from seven in the morning until the Tsx market opens.
entrypoint typedef struct _CalculatedOpeningPriceMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 cusip[12];                      // bytes 12 to 23
  UINT8 cop[11];                        // bytes 24 to 34
  UINT8 price_marker;                   // byte 35
  UINT8 trading_system_time_stamp[23];  // bytes 36 to 58
} CalculatedOpeningPriceMessage;

// ---- Tsx Tsxv Closing Price Message: 61 bytes --------------------------------

// Closing price of the trading day with the last bid and ask behind it.
entrypoint typedef struct _TsxTsxvClosingPriceMessage {
  UINT8 symbol[12];                  // bytes 0 to 11
  UINT8 cusip[12];                   // bytes 12 to 23
  UINT8 tsx_tsxv_closing_price[11];  // bytes 24 to 34
  UINT8 tsx_tsxv_last_bid[9];        // bytes 35 to 43
  UINT8 tsx_tsxv_last_ask[9];        // bytes 44 to 52
  UINT8 business_date[8];            // bytes 53 to 60
} TsxTsxvClosingPriceMessage;

// ---- Market State Message: 26 bytes ------------------------------------------

// The indication of the current market state for a stock group.
entrypoint typedef struct _MarketStateMessage {
  UINT8 trading_system_time_stamp[23];  // bytes 0 to 22
  UINT8 stock_group[2];                 // bytes 23 to 24
  UINT8 market_state;                   // byte 25
} MarketStateMessage;

// ---- Trading Tier Status Message: 40 bytes -----------------------------------

// Statistical information on the number of symbols and stock groups for the current trading day, sent at the beginning of each trading day.
entrypoint typedef struct _TradingTierStatusMessage {
  UINT8 exchange_id[3];                   // bytes 0 to 2
  UINT8 total_number_of_symbols[5];       // bytes 3 to 7
  UINT8 total_number_of_stock_groups[3];  // bytes 8 to 10
  UINT8 trading_system_time_stamp[23];    // bytes 11 to 33
  UINT8 trading_tier_id[6];               // bytes 34 to 39
} TradingTierStatusMessage;

// ---- Trade Correction Message: 114 bytes -------------------------------------

// Correction of a trade already disseminated.
entrypoint typedef struct _TradeCorrectionMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 volume[9];                      // bytes 12 to 20
  UINT8 trade_price[11];                // bytes 21 to 31
  UINT8 buyer_id[3];                    // bytes 32 to 34
  UINT8 seller_id[3];                   // bytes 35 to 37
  UINT8 trade_time_stamp[6];            // bytes 38 to 43
  UINT8 last_sale[11];                  // bytes 44 to 54
  UINT8 trade_id[9];                    // bytes 55 to 63
  UINT8 cross_type;                     // byte 64
  UINT8 moc;                            // byte 65
  UINT8 bypass;                         // byte 66
  UINT8 opening_trade;                  // byte 67
  UINT8 settlement_terms;               // byte 68
  UINT8 original_trade_id[9];           // bytes 69 to 77
  UINT8 trading_system_time_stamp[23];  // bytes 78 to 100
  UINT8 listing_market;                 // byte 101
  UINT8 product_type;                   // byte 102
  UINT8 trade_date[8];                  // bytes 103 to 110
  UINT8 is_mid_only;                    // byte 111
  UINT8 is_dark;                        // byte 112
  UINT8 is_conditional;                 // byte 113
} TradeCorrectionMessage;

