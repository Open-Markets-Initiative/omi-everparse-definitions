// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Tsx_Level1_v2_8.3d

// ---- Values ------------------------------------------------------------------

// Retransmission Identifier: one byte code
#define RETRANSMISSION_IDENTIFIER_NORMAL_TRANSMISSION 0x30  // Normal Transmission

// Continuation Identifier: one byte code
#define CONTINUATION_IDENTIFIER_STAND_ALONE_MESSAGE 0x30  // Stand Alone Message

// Message Type: 2 byte code
#define MESSAGE_TYPE_TRADE_MESSAGE 0x4120                       // Trade Message
#define MESSAGE_TYPE_SYMBOL_STATUS_MESSAGE 0x4220               // Symbol Status Message
#define MESSAGE_TYPE_MOC_IMBALANCE_NOTIFICATION_MESSAGE 0x4320  // Moc Imbalance Notification Message
#define MESSAGE_TYPE_MOC_PRICE_MOVEMENT_DELAY_MESSAGE 0x4341    // Moc Price Movement Delay Message
#define MESSAGE_TYPE_STOCK_STATE_MESSAGE 0x4420                 // Stock State Message
#define MESSAGE_TYPE_QUOTE_MESSAGE 0x4520                       // Quote Message
#define MESSAGE_TYPE_GENERAL_MESSAGE 0x4720                     // General Message
#define MESSAGE_TYPE_TRADE_CANCELLATION_MESSAGE 0x4820          // Trade Cancellation Message
#define MESSAGE_TYPE_INDICATIVE_PRICE_MESSAGE 0x4920            // Indicative Price Message
#define MESSAGE_TYPE_CALCULATED_OPENING_PRICE_MESSAGE 0x4F20    // Calculated Opening Price Message
#define MESSAGE_TYPE_TSX_TSXV_CLOSING_PRICE_MESSAGE 0x5220      // Tsx Tsxv Closing Price Message
#define MESSAGE_TYPE_MARKET_STATE_MESSAGE 0x5320                // Market State Message
#define MESSAGE_TYPE_TRADING_TIER_STATUS_MESSAGE 0x5420         // Trading Tier Status Message
#define MESSAGE_TYPE_TRADE_CORRECTION_MESSAGE 0x5820            // Trade Correction Message

// Cross Type: one byte code
#define CROSS_TYPE_INTERNAL 0x49                       // Internal
#define CROSS_TYPE_BASIS 0x42                          // Basis
#define CROSS_TYPE_CONTINGENT 0x43                     // Contingent
#define CROSS_TYPE_DERIVATIVE_RELATED 0x44             // Derivative Related
#define CROSS_TYPE_REGULAR 0x52                        // Regular
#define CROSS_TYPE_SPECIAL_TRADING_SESSION 0x53        // Special Trading Session
#define CROSS_TYPE_VOLUME_WEIGHTED_AVERAGE_PRICE 0x56  // Volume Weighted Average Price
#define CROSS_TYPE_DEFAULT 0x20                        // Default

// Moc: one byte code
#define MOC_YES 0x59  // Yes
#define MOC_NO 0x4E   // No

// Bypass: one byte code
#define BYPASS_YES 0x59  // Yes
#define BYPASS_NO 0x4E   // No

// Opening Trade: one byte code
#define OPENING_TRADE_YES 0x59  // Yes
#define OPENING_TRADE_NO 0x4E   // No

// Settlement Terms: one byte code
#define SETTLEMENT_TERMS_DEFAULT 0x20                                      // Default
#define SETTLEMENT_TERMS_CASH 0x43                                         // Cash
#define SETTLEMENT_TERMS_NON_NET 0x4E                                      // Non Net
#define SETTLEMENT_TERMS_DERIVATIVES_RELATED_CONTINGENT_EQUITY_TRADE 0x4D  // Derivatives Related Contingent Equity Trade
#define SETTLEMENT_TERMS_CASH_TODAY 0x54                                   // Cash Today
#define SETTLEMENT_TERMS_SETTLEMENT_DATE 0x44                              // Settlement Date

// Listing Market: one byte code
#define LISTING_MARKET_TSX 0x54        // Tsx
#define LISTING_MARKET_TSXV 0x56       // Tsxv
#define LISTING_MARKET_NAVEX 0x4E      // Navex
#define LISTING_MARKET_NASDAQ 0x51     // Nasdaq
#define LISTING_MARKET_NYSE 0x53       // Nyse
#define LISTING_MARKET_NYSE_MKT 0x4D   // Nyse Mkt
#define LISTING_MARKET_NO_MARKET 0x58  // No Market

// Product Type: one byte code
#define PRODUCT_TYPE_DEBENTURE 0x42    // Debenture
#define PRODUCT_TYPE_EQUITY 0x45       // Equity
#define PRODUCT_TYPE_MUTUAL_FUND 0x4D  // Mutual Fund
#define PRODUCT_TYPE_ETF 0x46          // Etf
#define PRODUCT_TYPE_US_EQUITY 0x55    // Us Equity
#define PRODUCT_TYPE_BOND 0x4F         // Bond

// Is Mid Only: one byte code
#define IS_MID_ONLY_YES 0x59  // Yes
#define IS_MID_ONLY_NO 0x4E   // No

// Is Dark: one byte code
#define IS_DARK_YES 0x59  // Yes
#define IS_DARK_NO 0x4E   // No

// Is Conditional: one byte code
#define IS_CONDITIONAL_YES 0x59  // Yes
#define IS_CONDITIONAL_NO 0x4E   // No

// Moc Eligible: one byte code
#define MOC_ELIGIBLE_YES 0x59  // Yes
#define MOC_ELIGIBLE_NO 0x4E   // No

// Test Symbol: one byte code
#define TEST_SYMBOL_YES 0x59  // Yes
#define TEST_SYMBOL_NO 0x4E   // No

// Imbalance Side: one byte code
#define IMBALANCE_SIDE_BUY 0x42             // Buy
#define IMBALANCE_SIDE_SELL 0x53            // Sell
#define IMBALANCE_SIDE_NOT_APPLICABLE 0x20  // Not Applicable

// Market Order Imbalance Side: one byte code
#define MARKET_ORDER_IMBALANCE_SIDE_BUY 0x42             // Buy
#define MARKET_ORDER_IMBALANCE_SIDE_SELL 0x53            // Sell
#define MARKET_ORDER_IMBALANCE_SIDE_NOT_APPLICABLE 0x20  // Not Applicable

// Bulletin Indicator: one byte code
#define BULLETIN_INDICATOR_YES 0x59  // Yes
#define BULLETIN_INDICATOR_NO 0x4E   // No

// Price Marker: one byte code
#define PRICE_MARKER_INDICATIVE_CLOSING_PRICE 0x43  // Indicative Closing Price
#define PRICE_MARKER_CALCULATED_OPENING_PRICE 0x4F  // Calculated Opening Price

// Market State: one byte code
#define MARKET_STATE_PRE_OPEN 0x50                  // Pre Open
#define MARKET_STATE_OPENING 0x4F                   // Opening
#define MARKET_STATE_OPEN 0x53                      // Open
#define MARKET_STATE_CLOSED 0x43                    // Closed
#define MARKET_STATE_EXTENDED_HOURS_OPEN 0x52       // Extended Hours Open
#define MARKET_STATE_EXTENDED_HOURS_CLOSE 0x46      // Extended Hours Close
#define MARKET_STATE_EXTENDED_HOURS_CXLS 0x4E       // Extended Hours Cxls
#define MARKET_STATE_MOC_IMBALANCE 0x4D             // Moc Imbalance
#define MARKET_STATE_MOC_FREEZE 0x54                // Moc Freeze
#define MARKET_STATE_CCP_DETERMINATION 0x41         // Ccp Determination
#define MARKET_STATE_PRICE_MOVEMENT_EXTENSION 0x45  // Price Movement Extension
#define MARKET_STATE_CLOSING 0x4C                   // Closing
#define MARKET_STATE_NAVEX_CLOSED 0x4A              // Navex Closed
#define MARKET_STATE_NAVEX_ORDER_ENTRY 0x47         // Navex Order Entry
#define MARKET_STATE_NAVEX_ORDER_ENTRY_CLOSE 0x48   // Navex Order Entry Close
#define MARKET_STATE_NAVEX_AM_EXECUTION 0x4B        // Navex Am Execution
#define MARKET_STATE_NAVEX_PM_EXECUTION 0x58        // Navex Pm Execution
#define MARKET_STATE_NAVEX_CLOSE 0x59               // Navex Close

// ---- Types -------------------------------------------------------------------

// A trade in an equity on the Tsx or Tsx Venture market.
typedef struct _TradeMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 volume[9];                      // bytes 12 to 20
  UINT8 trade_price[11];                // bytes 21 to 31
  UINT8 buyer_id[3];                    // bytes 32 to 34
  UINT8 seller_id[3];                   // bytes 35 to 37
  UINT8 trade_time_stamp[6];            // bytes 38 to 43
  UINT8 last_sale[11];                  // bytes 44 to 54
  UINT8 trade_id[9];                    // bytes 55 to 63
  UINT8 cross_type;                     // byte 64
  UINT8 moc;                            // byte 65
  UINT8 bypass;                         // byte 66
  UINT8 opening_trade;                  // byte 67
  UINT8 settlement_terms;               // byte 68
  UINT8 trading_system_time_stamp[23];  // bytes 69 to 91
  UINT8 listing_market;                 // byte 92
  UINT8 product_type;                   // byte 93
  UINT8 trade_date[8];                  // bytes 94 to 101
  UINT8 is_mid_only;                    // byte 102
  UINT8 is_dark;                        // byte 103
  UINT8 is_conditional;                 // byte 104
} TradeMessage;

// Reference information for a symbol trading on the current day.
typedef struct _SymbolStatusMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 trading_system_time_stamp[23];  // bytes 12 to 34
  UINT8 exchange_id[3];                 // bytes 35 to 37
  UINT8 cusip[12];                      // bytes 38 to 49
  UINT8 board_lot[9];                   // bytes 50 to 58
  UINT8 currency;                       // byte 59
  UINT8 face_value[9];                  // bytes 60 to 68
  UINT8 last_sale[11];                  // bytes 69 to 79
  UINT8 moc_eligible;                   // byte 80
  UINT8 product_type;                   // byte 81
  UINT8 symbol_name[40];                // bytes 82 to 121
  UINT8 stock_group[2];                 // bytes 122 to 123
  UINT8 stock_state[2];                 // bytes 124 to 125
  UINT8 listing_market;                 // byte 126
  UINT8 buy_maximum_quantity[9];        // bytes 127 to 135
  UINT8 buy_minimum_quantity[9];        // bytes 136 to 144
  UINT8 sell_maximum_quantity[9];       // bytes 145 to 153
  UINT8 sell_minimum_quantity[9];       // bytes 154 to 162
  UINT8 test_symbol;                    // byte 163
} SymbolStatusMessage;

// Volume imbalance for a Market On Close eligible symbol, sent every ten seconds from the beginning of the MOC Imbalance session.
typedef struct _MocImbalanceNotificationMessage {
  UINT8 symbol[12];                         // bytes 0 to 11
  UINT8 imbalance_side;                     // byte 12
  UINT8 imbalance_volume[9];                // bytes 13 to 21
  UINT8 imbalance_reference_price[11];      // bytes 22 to 32
  UINT8 paired_volume[9];                   // bytes 33 to 41
  UINT8 market_order_imbalance_volume[9];   // bytes 42 to 50
  UINT8 market_order_imbalance_side;        // byte 51
  UINT8 near_indicative_closing_price[11];  // bytes 52 to 62
  UINT8 far_indicative_closing_price[11];   // bytes 63 to 73
  UINT8 price_variation[5];                 // bytes 74 to 78
  UINT8 trading_system_time_stamp[23];      // bytes 79 to 101
} MocImbalanceNotificationMessage;

// Transmitted when Price Movement Extension is invoked.
typedef struct _MocPriceMovementDelayMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 trading_system_time_stamp[23];  // bytes 12 to 34
  UINT8 stock_state[2];                 // bytes 35 to 36
  UINT8 ccp[11];                        // bytes 37 to 47
  UINT8 vwap[11];                       // bytes 48 to 58
} MocPriceMovementDelayMessage;

// A change in the trading state of a stock.
typedef struct _StockStateMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 trading_system_time_stamp[23];  // bytes 12 to 34
  UINT8 comment[40];                    // bytes 35 to 74
  UINT8 stock_state[2];                 // bytes 75 to 76
  UINT8 opening_time[6];                // bytes 77 to 82
  UINT8 listing_market;                 // byte 83
  UINT8 product_type;                   // byte 84
} StockStateMessage;

// Full update quote sent whenever either the bid or the ask has changed.
typedef struct _QuoteMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 bid_price[9];                   // bytes 12 to 20
  UINT8 bid_size[9];                    // bytes 21 to 29
  UINT8 ask_price[9];                   // bytes 30 to 38
  UINT8 ask_size[9];                    // bytes 39 to 47
  UINT8 trading_system_time_stamp[23];  // bytes 48 to 70
} QuoteMessage;

// Bulletin in textual format.
typedef struct _GeneralMessage {
  UINT8 trading_system_time_stamp[23];  // bytes 0 to 22
  UINT8 bulletin_indicator;             // byte 23
  UINT8 message_text[80];               // bytes 24 to 103
} GeneralMessage;

// Cancellation of a trade, reducing total volume, value and transactions by the amount of the cancellation.
typedef struct _TradeCancellationMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 volume[9];                      // bytes 12 to 20
  UINT8 trade_price[11];                // bytes 21 to 31
  UINT8 buyer_id[3];                    // bytes 32 to 34
  UINT8 seller_id[3];                   // bytes 35 to 37
  UINT8 trade_time_stamp[6];            // bytes 38 to 43
  UINT8 original_trade_id[9];           // bytes 44 to 52
  UINT8 last_sale[11];                  // bytes 53 to 63
  UINT8 trading_system_time_stamp[23];  // bytes 64 to 86
  UINT8 listing_market;                 // byte 87
  UINT8 product_type;                   // byte 88
  UINT8 trade_date[8];                  // bytes 89 to 96
} TradeCancellationMessage;

// Indicative Closing Price, calculated and published at sixteen hundred London time on every trading day.
typedef struct _IndicativePriceMessage {
  UINT8 symbol[12];            // bytes 0 to 11
  UINT8 cusip[12];             // bytes 12 to 23
  UINT8 indicative_price[11];  // bytes 24 to 34
  UINT8 price_marker;          // byte 35
  UINT8 business_date[8];      // bytes 36 to 43
} IndicativePriceMessage;

// Calculated Opening Price, published continuously from seven in the morning until the Tsx market opens.
typedef struct _CalculatedOpeningPriceMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 cusip[12];                      // bytes 12 to 23
  UINT8 cop[11];                        // bytes 24 to 34
  UINT8 price_marker;                   // byte 35
  UINT8 trading_system_time_stamp[23];  // bytes 36 to 58
} CalculatedOpeningPriceMessage;

// Closing price of the trading day with the last bid and ask behind it.
typedef struct _TsxTsxvClosingPriceMessage {
  UINT8 symbol[12];                  // bytes 0 to 11
  UINT8 cusip[12];                   // bytes 12 to 23
  UINT8 tsx_tsxv_closing_price[11];  // bytes 24 to 34
  UINT8 tsx_tsxv_last_bid[9];        // bytes 35 to 43
  UINT8 tsx_tsxv_last_ask[9];        // bytes 44 to 52
  UINT8 business_date[8];            // bytes 53 to 60
} TsxTsxvClosingPriceMessage;

// The indication of the current market state for a stock group.
typedef struct _MarketStateMessage {
  UINT8 trading_system_time_stamp[23];  // bytes 0 to 22
  UINT8 stock_group[2];                 // bytes 23 to 24
  UINT8 market_state;                   // byte 25
} MarketStateMessage;

// Statistical information on the number of symbols and stock groups for the current trading day, sent at the beginning of each trading day.
typedef struct _TradingTierStatusMessage {
  UINT8 exchange_id[3];                   // bytes 0 to 2
  UINT8 total_number_of_symbols[5];       // bytes 3 to 7
  UINT8 total_number_of_stock_groups[3];  // bytes 8 to 10
  UINT8 trading_system_time_stamp[23];    // bytes 11 to 33
  UINT8 trading_tier_id[6];               // bytes 34 to 39
} TradingTierStatusMessage;

// Correction of a trade already disseminated.
typedef struct _TradeCorrectionMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 volume[9];                      // bytes 12 to 20
  UINT8 trade_price[11];                // bytes 21 to 31
  UINT8 buyer_id[3];                    // bytes 32 to 34
  UINT8 seller_id[3];                   // bytes 35 to 37
  UINT8 trade_time_stamp[6];            // bytes 38 to 43
  UINT8 last_sale[11];                  // bytes 44 to 54
  UINT8 trade_id[9];                    // bytes 55 to 63
  UINT8 cross_type;                     // byte 64
  UINT8 moc;                            // byte 65
  UINT8 bypass;                         // byte 66
  UINT8 opening_trade;                  // byte 67
  UINT8 settlement_terms;               // byte 68
  UINT8 original_trade_id[9];           // bytes 69 to 77
  UINT8 trading_system_time_stamp[23];  // bytes 78 to 100
  UINT8 listing_market;                 // byte 101
  UINT8 product_type;                   // byte 102
  UINT8 trade_date[8];                  // bytes 103 to 110
  UINT8 is_mid_only;                    // byte 111
  UINT8 is_dark;                        // byte 112
  UINT8 is_conditional;                 // byte 113
} TradeCorrectionMessage;

// Branch
casetype _MessageBody (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x4120: TradeMessage trade_message;
    case 0x4220: SymbolStatusMessage symbol_status_message;
    case 0x4320: MocImbalanceNotificationMessage moc_imbalance_notification_message;
    case 0x4341: MocPriceMovementDelayMessage moc_price_movement_delay_message;
    case 0x4420: StockStateMessage stock_state_message;
    case 0x4520: QuoteMessage quote_message;
    case 0x4720: GeneralMessage general_message;
    case 0x4820: TradeCancellationMessage trade_cancellation_message;
    case 0x4920: IndicativePriceMessage indicative_price_message;
    case 0x4F20: CalculatedOpeningPriceMessage calculated_opening_price_message;
    case 0x5220: TsxTsxvClosingPriceMessage tsx_tsxv_closing_price_message;
    case 0x5320: MarketStateMessage market_state_message;
    case 0x5420: TradingTierStatusMessage trading_tier_status_message;
    case 0x5820: TradeCorrectionMessage trade_correction_message;
    default: UINT8 unknown[available];
  }
} MessageBody;

// ---- Packet: Packet ----------------------------------------------------------

// Qrtmd Udp Packet
entrypoint typedef struct _Packet (UINT32 available) where (available >= 24) {
  UINT8 qrtmd_stx;                                                                                             // byte 0
  UINT8 message_length[4];                                                                                     // bytes 1 to 4
  UINT8 sequence_number[9];                                                                                    // bytes 5 to 13
  UINT8 service_identifier[3];                                                                                 // bytes 14 to 16
  UINT8 retransmission_identifier;                                                                             // byte 17
  UINT8 continuation_identifier;                                                                               // byte 18
  UINT16BE message_type;                                                                                       // bytes 19 to 20
  UINT8 exchange_identifier[2];                                                                                // bytes 21 to 22
  MessageBody(message_type, (available - 24)) message_body[:byte-size-single-element-array (available - 24)];
  UINT8 qrtmd_etx;
} Packet;

