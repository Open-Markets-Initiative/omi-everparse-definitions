// TMX Group Index Feed
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out Tsx_IndexFeed_v1_19.3d
//
// What this definition does not state, and the model does:
// - the dispatch that chooses a message by its type
//
// License: MIT No Attribution

// ---- Message Header: 22 bytes ------------------------------------------------

// Twenty two byte ascii header carried on every Qrtmd message
entrypoint typedef struct _MessageHeader {
  UINT8 message_length[4];          // bytes 0 to 3
  UINT8 sequence_number[9];         // bytes 4 to 12
  UINT8 service_identifier[3];      // bytes 13 to 15
  UINT8 retransmission_identifier;  // byte 16
  UINT8 continuation_identifier;    // byte 17
  UINT8 message_type[2];            // bytes 18 to 19
  UINT8 exchange_identifier[2];     // bytes 20 to 21
} MessageHeader;

// ---- S And P Tsx Official Index Level Message: 122 bytes ---------------------

// Level of an index as of the time of the calculation.
entrypoint typedef struct _SAndPTsxOfficialIndexLevelMessage {
  UINT8 time[6];                   // bytes 0 to 5
  UINT8 index_id[4];               // bytes 6 to 9
  UINT8 last_level[8];             // bytes 10 to 17
  UINT8 net_change[7];             // bytes 18 to 24
  UINT8 volume[11];                // bytes 25 to 35
  UINT8 value[12];                 // bytes 36 to 47
  UINT8 open_level[8];             // bytes 48 to 55
  UINT8 settlement_value[8];       // bytes 56 to 63
  UINT8 special_opening_quote[8];  // bytes 64 to 71
  UINT8 percent_trading[7];        // bytes 72 to 78
  UINT8 high_level[8];             // bytes 79 to 86
  UINT8 low_level[8];              // bytes 87 to 94
  UINT8 pe[7];                     // bytes 95 to 101
  UINT8 yield[5];                  // bytes 102 to 106
  UINT8 markers;                   // byte 107
  UINT8 bid_price[7];              // bytes 108 to 114
  UINT8 ask_price[7];              // bytes 115 to 121
} SAndPTsxOfficialIndexLevelMessage;

