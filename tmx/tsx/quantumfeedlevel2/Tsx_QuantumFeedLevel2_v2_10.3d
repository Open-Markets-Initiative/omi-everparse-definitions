// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Tsx_QuantumFeedLevel2_v2_10.3d
//
// What this definition does not state, and the model does:
// - a length prefix framing what follows
// - a run counted by a field
// - a run of a stated number of entries
// - the packet as a whole, which is an arm not leading with what the choice is made on, at packet.packetbody.businessbodies

// ---- Values ------------------------------------------------------------------

// Ack Required Poss Dup: one byte code
#define ACK_REQUIRED_POSS_DUP_UNUSED 0x30        // Unused
#define ACK_REQUIRED_POSS_DUP_ACK_REQUIRED 0x41  // Ack Required
#define ACK_REQUIRED_POSS_DUP_POSS_DUP 0x44      // Poss Dup

// Msg Type: one byte code
#define MSG_TYPE_HEARTBEAT 0x30                                // Heartbeat
#define MSG_TYPE_SYMBOL_STATUS_MESSAGE 0x4A                    // Symbol Status Message
#define MSG_TYPE_ORDER_BOOK_MESSAGE 0x47                       // Order Book Message
#define MSG_TYPE_ORDER_BOOK_TERMS_MESSAGE 0x6A                 // Order Book Terms Message
#define MSG_TYPE_ASSIGN_COP_ORDERS_MESSAGE 0x41                // Assign Cop Orders Message
#define MSG_TYPE_ASSIGN_COP_NO_ORDERS_MESSAGE 0x42             // Assign Cop No Orders Message
#define MSG_TYPE_ASSIGN_LIMIT_MESSAGE 0x43                     // Assign Limit Message
#define MSG_TYPE_MARKET_STATE_UPDATE_MESSAGE 0x45              // Market State Update Message
#define MSG_TYPE_MOC_IMBALANCE_MESSAGE 0x46                    // Moc Imbalance Message
#define MSG_TYPE_ORDER_BOOKED_MESSAGE 0x50                     // Order Booked Message
#define MSG_TYPE_ORDER_BOOKED_TERMS_MESSAGE 0x6D               // Order Booked Terms Message
#define MSG_TYPE_ORDER_CANCELLED_MESSAGE 0x51                  // Order Cancelled Message
#define MSG_TYPE_ORDER_CANCELLED_TERMS_MESSAGE 0x6E            // Order Cancelled Terms Message
#define MSG_TYPE_ORDER_PRICE_TIME_ASSIGNED_MESSAGE 0x52        // Order Price Time Assigned Message
#define MSG_TYPE_ORDER_PRICE_TIME_ASSIGNED_TERMS_MESSAGE 0x6F  // Order Price Time Assigned Terms Message
#define MSG_TYPE_STOCK_STATUS_MESSAGE 0x49                     // Stock Status Message
#define MSG_TYPE_TRADE_REPORT_MESSAGE 0x53                     // Trade Report Message
#define MSG_TYPE_TRADE_REPORT_TERMS_MESSAGE 0x70               // Trade Report Terms Message
#define MSG_TYPE_TRADE_CANCELLED_MESSAGE 0x54                  // Trade Cancelled Message
#define MSG_TYPE_TRADE_CANCELLED_TERMS_MESSAGE 0x71            // Trade Cancelled Terms Message
#define MSG_TYPE_TRADE_CORRECTION_MESSAGE 0x55                 // Trade Correction Message
#define MSG_TYPE_TRADE_CORRECTION_TERMS_MESSAGE 0x72           // Trade Correction Terms Message

// Source Id: one byte code
#define SOURCE_ID_NON_SOURCE_RELATED 0x30  // Non Source Related
#define SOURCE_ID_T_S_X 0x51               // TSX
#define SOURCE_ID_T_S_X_VENTURE 0x56       // TSX Venture
#define SOURCE_ID_ALPHA 0x41               // Alpha

// Currency: one byte code
#define CURRENCY_USD 0x55  // Usd
#define CURRENCY_CAD 0x43  // Cad

// Order Side: one byte code
#define ORDER_SIDE_BUY 0x42   // Buy
#define ORDER_SIDE_SELL 0x53  // Sell

// Non Resident: one byte code
#define NON_RESIDENT_YES 0x59  // Yes
#define NON_RESIDENT_NO 0x4E   // No

// Settlement Terms: one byte code
#define SETTLEMENT_TERMS_CASH 0x43                   // Cash
#define SETTLEMENT_TERMS_NN 0x4E                     // Nn
#define SETTLEMENT_TERMS_MS 0x4D                     // Ms
#define SETTLEMENT_TERMS_CT 0x54                     // Ct
#define SETTLEMENT_TERMS_VALID_SETTLEMENT_DATE 0x44  // Valid Settlement Date

// Market State: one byte code
#define MARKET_STATE_PRE_OPEN 0x50                  // Pre Open
#define MARKET_STATE_OPENING 0x4F                   // Opening
#define MARKET_STATE_OPEN 0x53                      // Open
#define MARKET_STATE_MOC_IMBALANCE 0x4D             // Moc Imbalance
#define MARKET_STATE_CCP_DETERMINATION 0x41         // Ccp Determination
#define MARKET_STATE_PRICE_MOVEMENT_EXTENSION 0x45  // Price Movement Extension
#define MARKET_STATE_CLOSING 0x4C                   // Closing
#define MARKET_STATE_EXTENDED_HOURS_CXLS 0x4E       // Extended Hours Cxls
#define MARKET_STATE_EXTENDED_HOURS_OPEN 0x52       // Extended Hours Open
#define MARKET_STATE_EXTENDED_HOURS_CLOSE 0x46      // Extended Hours Close
#define MARKET_STATE_CLOSED 0x43                    // Closed

// Imbalance Side: one byte code
#define IMBALANCE_SIDE_BUY 0x42                  // Buy
#define IMBALANCE_SIDE_SELL 0x53                 // Sell
#define IMBALANCE_SIDE_NO_IMBALANCE_EXISTS 0x20  // No Imbalance Exists

// Bypass: one byte code
#define BYPASS_THE_ORDER_IS_A_BYPASS 0x59      // The Order Is A Bypass
#define BYPASS_THE_ORDER_IS_NOT_A_BYPASS 0x4E  // The Order Is Not A Bypass

// Cross Type: one byte code
#define CROSS_TYPE_INTERNAL 0x49                       // Internal
#define CROSS_TYPE_BASIS 0x42                          // Basis
#define CROSS_TYPE_CONTINGENT 0x43                     // Contingent
#define CROSS_TYPE_SPECIAL_TRADING_SESSION 0x53        // Special Trading Session
#define CROSS_TYPE_VOLUME_WEIGHTED_AVERAGE_PRICE 0x56  // Volume Weighted Average Price

// Initiated By: one byte code
#define INITIATED_BY_BUY 0x42   // Buy
#define INITIATED_BY_SELL 0x53  // Sell
#define INITIATED_BY_BOTH 0x43  // Both

// ---- Frame Header: 11 bytes --------------------------------------------------

// Xmt Udp Packet Frame Header
entrypoint typedef struct _FrameHeader {
  UINT8 start_of_frame;         // byte 0
  UINT8 protocol_name;          // byte 1
  UINT8 protocol_version;       // byte 2
  UINT16 message_length;        // bytes 3 to 4
  UINT32 session_id;            // bytes 5 to 8
  UINT8 ack_required_poss_dup;  // byte 9, values ACK_REQUIRED_POSS_DUP_
  UINT8 num_body;               // byte 10
} FrameHeader;

// ---- Body Header: 3 bytes ----------------------------------------------------

// Xmt Body Header
entrypoint typedef struct _BodyHeader {
  UINT16 msg_length;  // bytes 0 to 1
  UINT8 msg_type;     // byte 2, values MSG_TYPE_
} BodyHeader;

// ---- Business Header: 9 bytes ------------------------------------------------

// Xmt Business Header
entrypoint typedef struct _BusinessHeader {
  UINT8 msg_version;  // byte 0
  UINT8 source_id;    // byte 1, values SOURCE_ID_
  UINT16 stream_id;   // bytes 2 to 3
  UINT8 sequence_0;   // byte 4
  UINT32 sequence_1;  // bytes 5 to 8
} BusinessHeader;

// ---- Symbol Status Message: 41 bytes -----------------------------------------

entrypoint typedef struct _SymbolStatusMessage {
  UINT8 symbol[9];    // bytes 0 to 8
  UINT8 stock_group;  // byte 9
  UINT8 cusip[12];    // bytes 10 to 21
  UINT16 board_lot;   // bytes 22 to 23
  UINT8 currency;     // byte 24, values CURRENCY_
  UINT64 face_value;  // bytes 25 to 32
  UINT64 last_sale;   // bytes 33 to 40
} SymbolStatusMessage;

// ---- Order Book Message: 40 bytes --------------------------------------------

entrypoint typedef struct _OrderBookMessage {
  UINT8 symbol[9];             // bytes 0 to 8
  UINT16 broker_number;        // bytes 9 to 10
  UINT8 order_side;            // byte 11, values ORDER_SIDE_
  UINT64 order_id;             // bytes 12 to 19
  UINT64 price;                // bytes 20 to 27
  UINT32 volume;               // bytes 28 to 31
  UINT64 priority_time_stamp;  // bytes 32 to 39
} OrderBookMessage;

// ---- Order Book Terms Message: 46 bytes --------------------------------------

entrypoint typedef struct _OrderBookTermsMessage {
  UINT8 symbol[9];             // bytes 0 to 8
  UINT16 broker_number;        // bytes 9 to 10
  UINT8 order_side;            // byte 11, values ORDER_SIDE_
  UINT64 order_id;             // bytes 12 to 19
  UINT64 price;                // bytes 20 to 27
  UINT32 volume;               // bytes 28 to 31
  UINT8 non_resident;          // byte 32, values NON_RESIDENT_
  UINT8 settlement_terms;      // byte 33, values SETTLEMENT_TERMS_
  UINT32 settlement_date;      // bytes 34 to 37
  UINT64 priority_time_stamp;  // bytes 38 to 45
} OrderBookTermsMessage;

// ---- Assign Cop No Orders Message: 25 bytes ----------------------------------

entrypoint typedef struct _AssignCopNoOrdersMessage {
  UINT8 symbol[9];                   // bytes 0 to 8
  UINT64 calculated_opening_price;   // bytes 9 to 16
  UINT64 trading_system_time_stamp;  // bytes 17 to 24
} AssignCopNoOrdersMessage;

// ---- Market State Update Message: 10 bytes -----------------------------------

entrypoint typedef struct _MarketStateUpdateMessage {
  UINT8 market_state;                // byte 0, values MARKET_STATE_
  UINT8 stock_group;                 // byte 1
  UINT64 trading_system_time_stamp;  // bytes 2 to 9
} MarketStateUpdateMessage;

// ---- Moc Imbalance Message: 30 bytes -----------------------------------------

entrypoint typedef struct _MocImbalanceMessage {
  UINT8 symbol[9];                   // bytes 0 to 8
  UINT8 imbalance_side;              // byte 9, values IMBALANCE_SIDE_
  UINT32 imbalance_volume;           // bytes 10 to 13
  UINT64 trading_system_time_stamp;  // bytes 14 to 21
  UINT64 imbalance_reference_price;  // bytes 22 to 29
} MocImbalanceMessage;

