  UINT64 trading_system_time_stamp;  // bytes 16 to 23
} TradeCancelledTermsMessage;

// ---- Trade Correction Message: 52 bytes --------------------------------------

entrypoint typedef struct _TradeCorrectionMessage {
  UINT8 symbol[12];                  // bytes 0 to 11
  UINT32 trade_number;               // bytes 12 to 15
  UINT64 price;                      // bytes 16 to 23
  UINT32 volume;                     // bytes 24 to 27
  UINT16 buy_broker_number;          // bytes 28 to 29
  UINT16 sell_broker_number;         // bytes 30 to 31
  UINT8 initiated_by;                // byte 32, values INITIATED_BY_
  UINT32 orig_trade_number;          // bytes 33 to 36
  UINT8 bypass;                      // byte 37, values BYPASS_
  UINT32 trade_time_stamp;           // bytes 38 to 41
  UINT8 cross_type;                  // byte 42, values CROSS_TYPE_
  UINT8 is_dark;                     // byte 43
  UINT64 trading_system_time_stamp;  // bytes 44 to 51
} TradeCorrectionMessage;

// ---- Trade Correction Terms Message: 55 bytes --------------------------------

entrypoint typedef struct _TradeCorrectionTermsMessage {
  UINT8 symbol[12];                  // bytes 0 to 11
  UINT32 trade_number;               // bytes 12 to 15
  UINT64 price;                      // bytes 16 to 23
  UINT32 volume;                     // bytes 24 to 27
  UINT16 buy_broker_number;          // bytes 28 to 29
  UINT16 sell_broker_number;         // bytes 30 to 31
  UINT8 initiated_by;                // byte 32, values INITIATED_BY_
  UINT32 orig_trade_number;          // bytes 33 to 36
  UINT32 trade_time_stamp;           // bytes 37 to 40
  UINT8 settlement_terms;            // byte 41, values SETTLEMENT_TERMS_
