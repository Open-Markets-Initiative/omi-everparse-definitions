// ---- Message Header: 22 bytes ------------------------------------------------

// Twenty two byte ascii header carried on every Qrtmd message
entrypoint typedef struct _MessageHeader {
  UINT8 message_length[4];          // bytes 0 to 3
  UINT8 sequence_number[9];         // bytes 4 to 12
  UINT8 service_identifier[3];      // bytes 13 to 15
  UINT8 retransmission_identifier;  // byte 16
  UINT8 continuation_identifier;    // byte 17
  UINT8 message_type[2];            // bytes 18 to 19
  UINT8 exchange_identifier[2];     // bytes 20 to 21
} MessageHeader;

// ---- Trade Message: 92 bytes -------------------------------------------------

// A trade in an equity on the Alpha market.
entrypoint typedef struct _TradeMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 volume[9];                      // bytes 12 to 20
  UINT8 trade_price[11];                // bytes 21 to 31
  UINT8 buyer_id[3];                    // bytes 32 to 34
  UINT8 seller_id[3];                   // bytes 35 to 37
  UINT8 trade_time_stamp[6];            // bytes 38 to 43
  UINT8 last_sale[11];                  // bytes 44 to 54
  UINT8 trade_id[9];                    // bytes 55 to 63
  UINT8 cross_type;                     // byte 64
  UINT8 bypass;                         // byte 65
  UINT8 opening_trade;                  // byte 66
  UINT8 settlement_terms;               // byte 67
  UINT8 is_dark;                        // byte 68
  UINT8 trading_system_time_stamp[23];  // bytes 69 to 91
} TradeMessage;

// ---- Symbol Status Message: 136 bytes ----------------------------------------

// Reference information for a symbol trading on the current day.
entrypoint typedef struct _SymbolStatusMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 trading_system_time_stamp[23];  // bytes 12 to 34
  UINT8 exchange_id[3];                 // bytes 35 to 37
  UINT8 cusip[12];                      // bytes 38 to 49
  UINT8 board_lot[9];                   // bytes 50 to 58
  UINT8 currency;                       // byte 59
  UINT8 face_value[9];                  // bytes 60 to 68
  UINT8 last_sale[11];                  // bytes 69 to 79
  UINT8 product_type;                   // byte 80
  UINT8 symbol_name[40];                // bytes 81 to 120
  UINT8 stock_group[2];                 // bytes 121 to 122
  UINT8 stock_state[2];                 // bytes 123 to 124
  UINT8 listing_market;                 // byte 125
  UINT8 min_po_qty[9];                  // bytes 126 to 134
  UINT8 test_symbol;                    // byte 135
} SymbolStatusMessage;

// ---- Stock State Message: 83 bytes -------------------------------------------

// A change in the trading state of a stock.
entrypoint typedef struct _StockStateMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 trading_system_time_stamp[23];  // bytes 12 to 34
  UINT8 comment[40];                    // bytes 35 to 74
  UINT8 stock_state[2];                 // bytes 75 to 76
  UINT8 opening_time[6];                // bytes 77 to 82
} StockStateMessage;

// ---- Quote Message: 71 bytes -------------------------------------------------

// Full update quote sent whenever either the bid or the ask has changed.
entrypoint typedef struct _QuoteMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 bid_price[9];                   // bytes 12 to 20
  UINT8 bid_size[9];                    // bytes 21 to 29
  UINT8 ask_price[9];                   // bytes 30 to 38
  UINT8 ask_size[9];                    // bytes 39 to 47
  UINT8 trading_system_time_stamp[23];  // bytes 48 to 70
} QuoteMessage;

// ---- General Message: 104 bytes ----------------------------------------------

// Bulletin in textual format.
entrypoint typedef struct _GeneralMessage {
  UINT8 trading_system_time_stamp[23];  // bytes 0 to 22
  UINT8 bulletin_indicator;             // byte 23
  UINT8 message_text[80];               // bytes 24 to 103
} GeneralMessage;

// ---- Trade Cancellation Message: 87 bytes ------------------------------------

// Cancellation of a trade, reducing total volume, value and transactions by the amount of the cancellation.
entrypoint typedef struct _TradeCancellationMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 volume[9];                      // bytes 12 to 20
  UINT8 trade_price[11];                // bytes 21 to 31
  UINT8 buyer_id[3];                    // bytes 32 to 34
  UINT8 seller_id[3];                   // bytes 35 to 37
  UINT8 trade_time_stamp[6];            // bytes 38 to 43
  UINT8 original_trade_id[9];           // bytes 44 to 52
  UINT8 last_sale[11];                  // bytes 53 to 63
  UINT8 trading_system_time_stamp[23];  // bytes 64 to 86
} TradeCancellationMessage;

// ---- Market State Message: 26 bytes ------------------------------------------

// The indication of the current market state for a stock group.
entrypoint typedef struct _MarketStateMessage {
  UINT8 trading_system_time_stamp[23];  // bytes 0 to 22
  UINT8 stock_group[2];                 // bytes 23 to 24
  UINT8 market_state;                   // byte 25
} MarketStateMessage;

// ---- Trading Tier Status Message: 40 bytes -----------------------------------

// Statistical information on the number of symbols and stock groups for the current trading day, sent at the beginning of each trading day.
entrypoint typedef struct _TradingTierStatusMessage {
  UINT8 exchange_id[3];                   // bytes 0 to 2
  UINT8 total_number_of_symbols[5];       // bytes 3 to 7
  UINT8 total_number_of_stock_groups[3];  // bytes 8 to 10
  UINT8 trading_system_time_stamp[23];    // bytes 11 to 33
  UINT8 trading_tier_id[6];               // bytes 34 to 39
} TradingTierStatusMessage;

// ---- Trade Correction Message: 101 bytes -------------------------------------

// Correction of a trade already disseminated.
entrypoint typedef struct _TradeCorrectionMessage {
  UINT8 symbol[12];                     // bytes 0 to 11
  UINT8 volume[9];                      // bytes 12 to 20
  UINT8 trade_price[11];                // bytes 21 to 31
  UINT8 buyer_id[3];                    // bytes 32 to 34
  UINT8 seller_id[3];                   // bytes 35 to 37
  UINT8 trade_time_stamp[6];            // bytes 38 to 43
  UINT8 last_sale[11];                  // bytes 44 to 54
  UINT8 trade_id[9];                    // bytes 55 to 63
  UINT8 cross_type;                     // byte 64
  UINT8 bypass;                         // byte 65
  UINT8 opening_trade;                  // byte 66
  UINT8 settlement_terms;               // byte 67
  UINT8 original_trade_id[9];           // bytes 68 to 76
  UINT8 is_dark;                        // byte 77
  UINT8 trading_system_time_stamp[23];  // bytes 78 to 100
} TradeCorrectionMessage;

