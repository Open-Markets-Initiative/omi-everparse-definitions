// ---- Message Header: 11 bytes ------------------------------------------------

// Standard Hsvf message header
entrypoint typedef struct _MessageHeader {
  UINT8 sequence_number[9];  // bytes 0 to 8
  UINT8 message_type[2];     // bytes 9 to 10
} MessageHeader;

// ---- Error Message: 84 bytes -------------------------------------------------

// Error Message
entrypoint typedef struct _ErrorMessage {
  UINT8 error_code[4];  // bytes 0 to 3
  UINT8 error_msg[80];  // bytes 4 to 83
} ErrorMessage;

// ---- Long Message Header: 12 bytes -------------------------------------------

// The guide states these fields once, as Table 3: Long Message Header, for every message the eight Table 2 frames do not. Sequence Number and Message Type are read by the packet, so they are not repeated here.
entrypoint typedef struct _LongMessageHeader {
  UINT8 message_timestamp[12];  // bytes 0 to 11
} LongMessageHeader;

