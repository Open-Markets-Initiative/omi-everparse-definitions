// ---- Group Status Message: 8 bytes -------------------------------------------

// This message will be sent when a group of trading instruments enters a new status.
entrypoint typedef struct _GroupStatusMessage {
  UINT8 exchange_id;           // byte 0, values EXCHANGE_ID_
  UINT8 root_symbol_group[6];  // bytes 1 to 6
  UINT8 group_status;          // byte 7, values GROUP_STATUS_
} GroupStatusMessage;

// ---- Group Status Strategies Message: 4 bytes --------------------------------

// This message will be sent when a strategy group of trading instruments enters a new status. All strategies have a predetermined group that can be found in the JS: Strategy Instrument Keys message.
entrypoint typedef struct _GroupStatusStrategiesMessage {
  UINT8 exchange_id;          // byte 0, values EXCHANGE_ID_
  UINT8 group_instrument[2];  // bytes 1 to 2
  UINT8 group_status;         // byte 3, values GROUP_STATUS_
} GroupStatusStrategiesMessage;

