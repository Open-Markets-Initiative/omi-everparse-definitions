// ---- Regular Text Bulletin: 80 bytes -----------------------------------------

// Regular Text Bulletin
entrypoint typedef struct _RegularTextBulletin {
  UINT8 regular_bulletin_contents[79];  // bytes 0 to 78
  UINT8 continue_marker;                // byte 79, values CONTINUE_MARKER_
} RegularTextBulletin;

// ---- Special Text Bulletin: 80 bytes -----------------------------------------

// This bulletin type will be used for bulletins relating to a specific trading instrument.
entrypoint typedef struct _SpecialTextBulletin {
  UINT8 symbol[30];                     // bytes 0 to 29
  UINT8 special_bulletin_contents[49];  // bytes 30 to 78
  UINT8 continue_marker;                // byte 79, values CONTINUE_MARKER_
} SpecialTextBulletin;

// ---- End Of Sales Message: 7 bytes -------------------------------------------

// The S: End of Sales message is sent when there is no more trading activity to be transmitted. This occurs after the closing of the market.
entrypoint typedef struct _EndOfSalesMessage {
  UINT8 reserved;  // byte 0
  UINT8 time[6];   // bytes 1 to 6
} EndOfSalesMessage;

