  UINT8 last_user_sequence_id_received[8];  // bytes 4 to 11
} DisconnectionAcknowledgement;

// ---- End Of Transmission: 18 bytes -------------------------------------------

entrypoint typedef struct _EndOfTransmission {
  UINT8 ended_session_id[4];                                                                  // bytes 0 to 3
  UINT8 last_user_sequence_id_received_if_no_business_message_has_been_received_o_soi8v5[8];  // bytes 4 to 11
  UINT8 trading_engine_timestamp_local_hhmmss[6];                                             // bytes 12 to 17
} EndOfTransmission;

// ---- Outgoing Messages Header: 22 bytes --------------------------------------

// The guide states these fields once, as the Outgoing Messages Header, for every business message the Exchange sends. Message Type is read by the packet before the branch, so it is not repeated here.
entrypoint typedef struct _OutgoingMessagesHeader {
  UINT8 trading_engine_timestamp_local_hhmmss[6];  // bytes 0 to 5
  UINT8 user_sequence_id[8];                       // bytes 6 to 13
  UINT8 exchange_message_id[6];                    // bytes 14 to 19
  UINT8 gap_sequence_id[2];                        // bytes 20 to 21
} OutgoingMessagesHeader;

// ---- Clearing Data: 20 bytes -------------------------------------------------

// The guide states these fields once, as Clearing Data, for every message that carries them.
entrypoint typedef struct _ClearingData {
  UINT8 clearing_instruction[12];  // bytes 0 to 11
  UINT8 account_type;              // byte 12, values ACCOUNT_TYPE_
  UINT8 open_close;                // byte 13, values OPEN_CLOSE_
  UINT8 hedge_spec;                // byte 14, values HEDGE_SPEC_
  UINT8 filler_5[5];               // bytes 15 to 19
} ClearingData;

// ---- Owner Data: 50 bytes ----------------------------------------------------

// The guide states this field once, as Owner Data, for every message that carries it.
entrypoint typedef struct _OwnerData {
  UINT8 memo[50];  // bytes 0 to 49
} OwnerData;

// ---- Order Reply: 134 bytes --------------------------------------------------

entrypoint typedef struct _OrderReply {
  OutgoingMessagesHeader outgoing_messages_header;  // bytes 0 to 21
  UINT8 group[2];                                   // bytes 22 to 23
  UINT8 instrument[4];                              // bytes 24 to 27
  UINT8 trader_id[8];                               // bytes 28 to 35
  UINT8 order_id[8];                                // bytes 36 to 43
  UINT8 status;                                     // byte 44, values STATUS_
  UINT8 verb_side;                                  // byte 45, values VERB_SIDE_
  UINT8 quantity_remaining[8];                      // bytes 46 to 53
  UINT8 assigned_price[10];                         // bytes 54 to 63
  ClearingData clearing_data;                       // bytes 64 to 83
  OwnerData owner_data;                             // bytes 84 to 133
} OrderReply;

// ---- Error Notice: 126 bytes -------------------------------------------------

entrypoint typedef struct _ErrorNotice {
