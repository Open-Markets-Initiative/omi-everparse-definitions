// ---- Values ------------------------------------------------------------------

// Account Type: one byte code
#define ACCOUNT_TYPE_CUSTOMER 0x31                // Customer
#define ACCOUNT_TYPE_HOUSE 0x32                   // House
#define ACCOUNT_TYPE_PRO 0x34                     // Pro
#define ACCOUNT_TYPE_NON_CLIENT 0x35              // Non Client
#define ACCOUNT_TYPE_NON_CLIENT_SHAREHOLDER 0x44  // Non Client Shareholder
#define ACCOUNT_TYPE_CUSTOMER_SHAREHOLDER 0x48    // Customer Shareholder
#define ACCOUNT_TYPE_CUSTOMER_INSIDER 0x49        // Customer Insider
#define ACCOUNT_TYPE_PRO_SHAREHOLDER 0x4C         // Pro Shareholder
#define ACCOUNT_TYPE_HOUSE_INSIDER 0x4E           // House Insider
#define ACCOUNT_TYPE_HOUSE_SHAREHOLDER 0x4F       // House Shareholder
#define ACCOUNT_TYPE_NON_CLIENT_INSIDER 0x52      // Non Client Insider
#define ACCOUNT_TYPE_PRO_INSIDER 0x53             // Pro Insider

// Open Close: one byte code
#define OPEN_CLOSE_ALL_LEGS_ARE_OPEN_OR_SINGLE_SECURITY 0x4F            // All Legs Are Open Or Single Security
#define OPEN_CLOSE_ALL_LEGS_ARE_CLOSED_OR_SINGLE_SECURITY 0x43          // All Legs Are Closed Or Single Security
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE 0x31                          // Leg 1 Open, Leg 2 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN 0x32                          // Leg 1 Close, Leg 2 Open
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_OPEN_LEG_3_CLOSE 0x33               // Leg 1 Open, Leg 2 Open, Leg 3 Close
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE_LEG_3_OPEN 0x34               // Leg 1 Open, Leg 2 Close, Leg 3 Open
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE_LEG_3_CLOSE 0x35              // Leg 1 Open, Leg 2 Close, Leg 3 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN_LEG_3_OPEN 0x36               // Leg 1 Close, Leg 2 Open, Leg 3 Open
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN_LEG_3_CLOSE 0x37              // Leg 1 Close, Leg 2 Open, Leg 3 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_CLOSE_LEG_3_OPEN 0x38              // Leg 1 Close, Leg 2 Close, Leg 3 Open
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_OPEN_LEG_3_OPEN_LEG_4_CLOSE 0x41    // Leg 1 Open, Leg 2 Open, Leg 3 Open, Leg 4 Close
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_OPEN_LEG_3_CLOSE_LEG_4_OPEN 0x42    // Leg 1 Open, Leg 2 Open, Leg 3 Close, Leg 4 Open
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_OPEN_LEG_3_CLOSE_LEG_4_CLOSE 0x44   // Leg 1 Open, Leg 2 Open, Leg 3 Close, Leg 4 Close
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE_LEG_3_OPEN_LEG_4_OPEN 0x45    // Leg 1 Open, Leg 2 Close, Leg 3 Open, Leg 4 Open
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE_LEG_3_OPEN_LEG_4_CLOSE 0x46   // Leg 1 Open, Leg 2 Close, Leg 3 Open, Leg 4 Close
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE_LEG_3_CLOSE_LEG_4_OPEN 0x47   // Leg 1 Open, Leg 2 Close, Leg 3 Close, Leg 4 Open
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE_LEG_3_CLOSE_LEG_4_CLOSE 0x48  // Leg 1 Open, Leg 2 Close, Leg 3 Close, Leg 4 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN_LEG_3_OPEN_LEG_4_OPEN 0x49    // Leg 1 Close, Leg 2 Open, Leg 3 Open, Leg 4 Open
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN_LEG_3_OPEN_LEG_4_CLOSE 0x4A   // Leg 1 Close, Leg 2 Open, Leg 3 Open, Leg 4 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN_LEG_3_CLOSE_LEG_4_OPEN 0x4B   // Leg 1 Close, Leg 2 Open, Leg 3 Close, Leg 4 Open
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN_LEG_3_CLOSE_LEG_4_CLOSE 0x4C  // Leg 1 Close, Leg 2 Open, Leg 3 Close, Leg 4 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_CLOSE_LEG_3_OPEN_LEG_4_OPEN 0x4D   // Leg 1 Close, Leg 2 Close, Leg 3 Open, Leg 4 Open
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_CLOSE_LEG_3_OPEN_LEG_4_CLOSE 0x4E  // Leg 1 Close, Leg 2 Close, Leg 3 Open, Leg 4 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_CLOSE_LEG_3_CLOSE_LEG_4_OPEN 0x50  // Leg 1 Close, Leg 2 Close, Leg 3 Close, Leg 4 Open

// Hedge Spec: one byte code
#define HEDGE_SPEC_HEDGER 0x48      // Hedger
#define HEDGE_SPEC_SPECULATOR 0x53  // Speculator

// Status: one byte code
#define STATUS_PUT_IN_THE_ORDER_BOOK_HAVING_POSSIBLY_BEEN_PARTIALLY_EXECUTED 0x20                     // Put In The Order Book Having Possibly Been Partially Executed
#define STATUS_CANCELLED_BY_THE_TRADER 0x41                                                           // Cancelled By The Trader
#define STATUS_ELIMINATED_BY_THE_CIRCUIT_BREAKER 0x43                                                 // Eliminated By The Circuit Breaker
#define STATUS_ORDER_ELIMINATED_BY_THE_SYSTEM 0x45                                                    // Order Eliminated By The System
#define STATUS_ELIMINATED_DUE_TO_WASH_TRADE_PREVENTION 0x46                                           // Eliminated Due To Wash Trade Prevention
#define STATUS_CANCELLED_BY_THE_FIRM_SUPERVISOR_USER_GLOBAL_CANCEL 0x47                               // Cancelled By The Firm Supervisor User Global Cancel
#define STATUS_ELIMINATED_ON_PARTICIPANT_DISCONNECTION 0x49                                           // Eliminated On Participant Disconnection
#define STATUS_ELIMINATED_BY_MOD 0x4D                                                                 // Eliminated By Mod
#define STATUS_ELIMINATED_DUE_TO_WASH_TRADE_PREVENTION_IN_NON_TRADING_STATE 0x4E                      // Eliminated Due To Wash Trade Prevention In Non Trading State
#define STATUS_ELIMINATED_DUE_TO_WASH_TRADE_PREVENTION_AGAINST_QUOTE 0x51                             // Eliminated Due To Wash Trade Prevention Against Quote
#define STATUS_PUT_IN_THE_ORDER_BOOK_AS_STOP_ORDER 0x53                                               // Put In The Order Book As Stop Order
#define STATUS_ELIMINATED_DUE_TO_TRADE_LIMIT_EXCEEDED 0x54                                            // Eliminated Due To Trade Limit Exceeded
#define STATUS_ELIMINATED_DUE_TO_UNPRICED_LEG 0x55                                                    // Eliminated Due To Unpriced Leg
#define STATUS_CANCEL_PENDING 0x57                                                                    // Cancel Pending
#define STATUS_ORDER_EXECUTED_IN_FULL_OR_PARTIALLY_AND_THE_REMAINING_PART_COULD_NOT_BE_P_als4h5 0x58  // Order Executed In Full Or Partially And The Remaining Part Could Not Be Put In The Order Book Fak

// Verb Side: one byte code
#define VERB_SIDE_BUY 0x42   // Buy
#define VERB_SIDE_SELL 0x53  // Sell

// Type Of Cancellation Only Q Quotes Only Can Be Returned: one byte code
#define TYPE_OF_CANCELLATION_ONLY_Q_QUOTES_ONLY_CAN_BE_RETURNED_ALL 0x41                 // All
#define TYPE_OF_CANCELLATION_ONLY_Q_QUOTES_ONLY_CAN_BE_RETURNED_QUOTES_ONLY 0x51         // Quotes Only
#define TYPE_OF_CANCELLATION_ONLY_Q_QUOTES_ONLY_CAN_BE_RETURNED_ORDERS_ONLY 0x4F         // Orders Only
#define TYPE_OF_CANCELLATION_ONLY_Q_QUOTES_ONLY_CAN_BE_RETURNED_STOP_ORDERS_ONLY 0x53    // Stop Orders Only
#define TYPE_OF_CANCELLATION_ONLY_Q_QUOTES_ONLY_CAN_BE_RETURNED_MARKET_ORDERS_ONLY 0x4D  // Market Orders Only

// Group State: one byte code
#define GROUP_STATE_CONSULTATION_START 0x43          // Consultation Start
#define GROUP_STATE_NO_CANCEL_PERIOD 0x45            // No Cancel Period
#define GROUP_STATE_PRE_OPENING 0x50                 // Pre Opening
#define GROUP_STATE_OPENING 0x4F                     // Opening
#define GROUP_STATE_CONTINUOUS_TRADING_SESSION 0x53  // Continuous Trading Session
#define GROUP_STATE_CONSULTATION_END 0x46            // Consultation End
#define GROUP_STATE_MOD_INTERVENTION 0x4E            // Mod Intervention
#define GROUP_STATE_MINI_BATCH 0x4D                  // Mini Batch
#define GROUP_STATE_POST_SESSION 0x42                // Post Session
#define GROUP_STATE_PROHIBITED 0x49                  // Prohibited
#define GROUP_STATE_INTERRUPTED 0x5A                 // Interrupted

// Instrument State: one byte code
#define INSTRUMENT_STATE_NORMAL 0x4E                                                                            // Normal
#define INSTRUMENT_STATE_FORBIDDEN 0x46                                                                         // Forbidden
#define INSTRUMENT_STATE_ORDERS_AND_QUOTES_ARE_PROCESSED_IN_PRE_OPENING_IF_THE_GROUP_IS_IN_TRADING_STATUS 0x52  // Orders And Quotes Are Processed In Pre Opening If The Group Is In Trading Status

// Special Trade Indicator: one byte code
#define SPECIAL_TRADE_INDICATOR_NORMAL_TRADE 0x20                   // Normal Trade
#define SPECIAL_TRADE_INDICATOR_AS_OF_TRADE 0x41                    // As Of Trade
#define SPECIAL_TRADE_INDICATOR_BLOCK_TRADE 0x42                    // Block Trade
#define SPECIAL_TRADE_INDICATOR_CONTINGENT_TRADE 0x43               // Contingent Trade
#define SPECIAL_TRADE_INDICATOR_CROSS 0x44                          // Cross
#define SPECIAL_TRADE_INDICATOR_EXCHANGE_FOR_PHYSICAL 0x45          // Exchange For Physical
#define SPECIAL_TRADE_INDICATOR_HIDDEN_TRADE 0x48                   // Hidden Trade
#define SPECIAL_TRADE_INDICATOR_IMPLIED 0x49                        // Implied
#define SPECIAL_TRADE_INDICATOR_DELTA_TRADE 0x4A                    // Delta Trade
#define SPECIAL_TRADE_INDICATOR_COMMITTED_BLOCK 0x4B                // Committed Block
#define SPECIAL_TRADE_INDICATOR_LATE_TRADE 0x4C                     // Late Trade
#define SPECIAL_TRADE_INDICATOR_FOR_FUTURE_USE_M 0x4D               // For Future Use M
#define SPECIAL_TRADE_INDICATOR_FOR_FUTURE_USE_N 0x4E               // For Future Use N
#define SPECIAL_TRADE_INDICATOR_FOR_FUTURE_USE_O 0x4F               // For Future Use O
#define SPECIAL_TRADE_INDICATOR_FOR_FUTURE_USE_P 0x50               // For Future Use P
#define SPECIAL_TRADE_INDICATOR_FOR_FUTURE_USE_Q 0x51               // For Future Use Q
#define SPECIAL_TRADE_INDICATOR_COMMITTED 0x54                      // Committed
#define SPECIAL_TRADE_INDICATOR_BASIS_ON_CLOSE 0x55                 // Basis On Close
#define SPECIAL_TRADE_INDICATOR_TRADE_CORRECTION 0x56               // Trade Correction
#define SPECIAL_TRADE_INDICATOR_PRICE_VOLUME_ADJUSTMENT_TRADE 0x5A  // Price Volume Adjustment Trade

// Price Type: one byte code
#define PRICE_TYPE_COMMITTED 0x43                         // Committed
#define PRICE_TYPE_LIMIT_PRICE_SET_IN_MESSAGE 0x4C        // Limit Price Set In Message
#define PRICE_TYPE_AT_OPENING_PRICE 0x4F                  // At Opening Price
#define PRICE_TYPE_AT_BEST_OPPOSITE_PRICE_TOP_ORDER 0x4D  // At Best Opposite Price Top Order

// Trade Type: one byte code
#define TRADE_TYPE_TRADED_DURING_CONTINUOUS_TRADING_FOLLOWING_FIFO_ALGORITHM 0x46  // Traded During Continuous Trading Following Fifo Algorithm
#define TRADE_TYPE_TRADE_ENTERED_BY_MOD 0x4D                                       // Trade Entered By Mod
#define TRADE_TYPE_TRADED_DURING_OPENING 0x4F                                      // Traded During Opening

// Verb: one byte code
#define VERB_BUY 0x42   // Buy
#define VERB_SELL 0x53  // Sell

// Order Type: one byte code
#define ORDER_TYPE_ORDER 0x4F  // Order
#define ORDER_TYPE_QUOTE 0x51  // Quote

// Cancel Reason: one byte code
#define CANCEL_REASON_CANCELLED_BY_TRADER 0x41                            // Cancelled By Trader
#define CANCEL_REASON_CANCELLED_BY_CIRCUIT_BREAKER 0x43                   // Cancelled By Circuit Breaker
#define CANCEL_REASON_CANCELLED_BY_SUPERVISOR 0x47                        // Cancelled By Supervisor
#define CANCEL_REASON_ELIMINATED_BY_DISCONNECTION 0x49                    // Eliminated By Disconnection
#define CANCEL_REASON_CANCELLED_BY_MOD 0x4D                               // Cancelled By Mod
#define CANCEL_REASON_BQM_MAXIMUM_DELTA_VOLUME_HAS_BEEN_REACHED 0x4E      // Bqm Maximum Delta Volume Has Been Reached
#define CANCEL_REASON_BQM_MAXIMUM_NUMBER_OF_TRADES_HAS_BEEN_REACHED 0x50  // Bqm Maximum Number Of Trades Has Been Reached
#define CANCEL_REASON_BQM_MAXIMUM_VALUE_HAS_BEEN_REACHED 0x52             // Bqm Maximum Value Has Been Reached
#define CANCEL_REASON_CANCELLED_BY_SYSTEM 0x53                            // Cancelled By System
#define CANCEL_REASON_BQM_MAXIMUM_VOLUME_HAS_BEEN_REACHED 0x54            // Bqm Maximum Volume Has Been Reached
#define CANCEL_REASON_BQM_MAXIMUM_DELTA_VALUE_HAS_BEEN_REACHED 0x56       // Bqm Maximum Delta Value Has Been Reached
#define CANCEL_REASON_CANCEL_PENDING 0x57                                 // Cancel Pending

// Market Side: one byte code
#define MARKET_SIDE_BUY 0x42   // Buy
#define MARKET_SIDE_SELL 0x53  // Sell
#define MARKET_SIDE_BOTH 0x32  // Both

// ---- Connection Acknowledgement: 12 bytes ------------------------------------

entrypoint typedef struct _ConnectionAcknowledgement {
  UINT8 current_session_id[4];              // bytes 0 to 3
  UINT8 last_user_sequence_id_received[8];  // bytes 4 to 11
} ConnectionAcknowledgement;

// ---- Disconnection Instruction Acknowledgement: 12 bytes ---------------------

entrypoint typedef struct _DisconnectionInstructionAcknowledgement {
  UINT8 current_session_id[4];              // bytes 0 to 3
  UINT8 last_user_sequence_id_received[8];  // bytes 4 to 11
} DisconnectionInstructionAcknowledgement;

