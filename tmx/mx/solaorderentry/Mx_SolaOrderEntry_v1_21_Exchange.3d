  UINT8 error_code[4];                                          // bytes 10 to 13
  UINT8 error_position[4];                                      // bytes 14 to 17
  UINT8 error_message[100];                                     // bytes 18 to 117
  UINT8 start_of_message_in_error[100];                         // bytes 118 to 217
} TechnicalErrorNotice;

// ---- Disconnection Acknowledgement: 12 bytes ---------------------------------

entrypoint typedef struct _DisconnectionAcknowledgement {
