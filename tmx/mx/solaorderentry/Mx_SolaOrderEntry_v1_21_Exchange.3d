  UINT8 verb_side;                                  // byte 45, values VERB_SIDE_
  UINT8 quantity[8];                                // bytes 46 to 53
  UINT8 assigned_price[10];                         // bytes 54 to 63
  ClearingData clearing_data;                       // bytes 64 to 83
  OwnerData owner_data;                             // bytes 84 to 133
  UINT8 original_order_id[8];                       // bytes 134 to 141
  UINT8 filler_6[6];                                // bytes 142 to 147
} OrderCancellationAcknowledgement;

