// ---- Leg Execution Notice: 235 bytes -----------------------------------------

entrypoint typedef struct _LegExecutionNotice {
  OutgoingMessagesHeader outgoing_messages_header;              // bytes 0 to 21
  UINT8 group[2];                                               // bytes 22 to 23
  UINT8 instrument[4];                                          // bytes 24 to 27
  UINT8 trader_id[8];                                           // bytes 28 to 35
  UINT8 reference_id_order_id_or_quote_id[8];                   // bytes 36 to 43
  UINT8 verb_side;                                              // byte 44, values VERB_SIDE_
  UINT8 quantity_traded[8];                                     // bytes 45 to 52
  UINT8 trade_price[10];                                        // bytes 53 to 62
  UINT8 trading_engine_timestamp_of_the_trade_local_hhmmss[6];  // bytes 63 to 68
  ClearingData clearing_data;                                   // bytes 69 to 88
  OwnerData owner_data;                                         // bytes 89 to 138
  UINT8 special_trade_indicator;                                // byte 139, values SPECIAL_TRADE_INDICATOR_
  UINT8 price_type;                                             // byte 140, values PRICE_TYPE_
  UINT8 trade_type;                                             // byte 141, values TRADE_TYPE_
  UINT8 filler_6[6];                                            // bytes 142 to 147
  UINT8 trade_number[8];                                        // bytes 148 to 155
  UINT8 trade_memo[50];                                         // bytes 156 to 205
  UINT8 original_reference_id[8];                               // bytes 206 to 213
  UINT8 id_code_for_the_counterpart_participant[4];             // bytes 214 to 217
  UINT8 strategy_group[2];                                      // bytes 218 to 219
  UINT8 strategy_instrument_id[4];                              // bytes 220 to 223
  UINT8 strategy_verb_side;                                     // byte 224
  UINT8 strategy_trade_number[8];                               // bytes 225 to 232
  UINT8 leg_number[2];                                          // bytes 233 to 234
} LegExecutionNotice;

// ---- Counterpart Owner Data: 50 bytes ----------------------------------------

// Owner Data of the counterpart, which NO: Overstepped Order or Quote Notice carries.
entrypoint typedef struct _CounterpartOwnerData {
  UINT8 memo[50];  // bytes 0 to 49
} CounterpartOwnerData;

// ---- Overstepped Order Or Quote Notice: 112 bytes ----------------------------

entrypoint typedef struct _OversteppedOrderOrQuoteNotice {
  OutgoingMessagesHeader outgoing_messages_header;  // bytes 0 to 21
  UINT8 group[2];                                   // bytes 22 to 23
  UINT8 instrument[4];                              // bytes 24 to 27
  UINT8 verb;                                       // byte 28, values VERB_
  UINT8 order_type;                                 // byte 29, values ORDER_TYPE_
  UINT8 trader_id[8];                               // bytes 30 to 37
  UINT8 order_id[8];                                // bytes 38 to 45
  UINT8 counterpart_trader_id[8];                   // bytes 46 to 53
  UINT8 counterpart_order_id[8];                    // bytes 54 to 61
  CounterpartOwnerData counterpart_owner_data;      // bytes 62 to 111
} OversteppedOrderOrQuoteNotice;

// ---- Cancellation Of All Quotes Notice: 37 bytes -----------------------------

entrypoint typedef struct _CancellationOfAllQuotesNotice {
  OutgoingMessagesHeader outgoing_messages_header;  // bytes 0 to 21
  UINT8 group[2];                                   // bytes 22 to 23
  UINT8 instrument[4];                              // bytes 24 to 27
  UINT8 trader_id[8];                               // bytes 28 to 35
  UINT8 cancel_reason;                              // byte 36, values CANCEL_REASON_
} CancellationOfAllQuotesNotice;

// ---- Execution Notice: 218 bytes ---------------------------------------------

entrypoint typedef struct _ExecutionNotice {
  OutgoingMessagesHeader outgoing_messages_header;              // bytes 0 to 21
  UINT8 group[2];                                               // bytes 22 to 23
  UINT8 instrument[4];                                          // bytes 24 to 27
  UINT8 trader_id[8];                                           // bytes 28 to 35
  UINT8 reference_id_order_id_or_quote_id[8];                   // bytes 36 to 43
  UINT8 verb_side;                                              // byte 44, values VERB_SIDE_
  UINT8 quantity_traded[8];                                     // bytes 45 to 52
  UINT8 trade_price[10];                                        // bytes 53 to 62
  UINT8 trading_engine_timestamp_of_the_trade_local_hhmmss[6];  // bytes 63 to 68
  ClearingData clearing_data;                                   // bytes 69 to 88
  OwnerData owner_data;                                         // bytes 89 to 138
  UINT8 special_trade_indicator;                                // byte 139, values SPECIAL_TRADE_INDICATOR_
  UINT8 price_type;                                             // byte 140, values PRICE_TYPE_
  UINT8 trade_type;                                             // byte 141, values TRADE_TYPE_
  UINT8 filler_6[6];                                            // bytes 142 to 147
  UINT8 trade_number[8];                                        // bytes 148 to 155
  UINT8 trade_memo[50];                                         // bytes 156 to 205
  UINT8 original_reference_id[8];                               // bytes 206 to 213
  UINT8 id_code_for_the_counterpart_participant[4];             // bytes 214 to 217
} ExecutionNotice;

// ---- Execution Cancellation Notice: 218 bytes --------------------------------

// This message is sent by the Exchange to report the execution of a trade cancellation by the MOD. This message has the same number of bytes and format as the NT: SAIL Execution Notice messages.
entrypoint typedef struct _ExecutionCancellationNotice {
  OutgoingMessagesHeader outgoing_messages_header;              // bytes 0 to 21
  UINT8 group[2];                                               // bytes 22 to 23
  UINT8 instrument[4];                                          // bytes 24 to 27
  UINT8 trader_id[8];                                           // bytes 28 to 35
  UINT8 reference_id_order_id_or_quote_id[8];                   // bytes 36 to 43
  UINT8 verb_side;                                              // byte 44, values VERB_SIDE_
  UINT8 quantity_traded[8];                                     // bytes 45 to 52
  UINT8 trade_price[10];                                        // bytes 53 to 62
  UINT8 trading_engine_timestamp_of_the_trade_local_hhmmss[6];  // bytes 63 to 68
  ClearingData clearing_data;                                   // bytes 69 to 88
  OwnerData owner_data;                                         // bytes 89 to 138
  UINT8 special_trade_indicator;                                // byte 139, values SPECIAL_TRADE_INDICATOR_
  UINT8 price_type;                                             // byte 140, values PRICE_TYPE_
  UINT8 trade_type;                                             // byte 141, values TRADE_TYPE_
  UINT8 filler_6[6];                                            // bytes 142 to 147
  UINT8 trade_number[8];                                        // bytes 148 to 155
  UINT8 trade_memo[50];                                         // bytes 156 to 205
  UINT8 original_reference_id[8];                               // bytes 206 to 213
  UINT8 id_code_for_the_counterpart_participant[4];             // bytes 214 to 217
} ExecutionCancellationNotice;

// ---- Leg Execution Cancellation Notice: 235 bytes ----------------------------

// This message is sent by the Exchange to report the execution of a cancellation by the MOD for a leg of the strategy trade. This message has the same number of bytes and format as the NL: Leg Execution Notice message.
entrypoint typedef struct _LegExecutionCancellationNotice {
  OutgoingMessagesHeader outgoing_messages_header;              // bytes 0 to 21
  UINT8 group[2];                                               // bytes 22 to 23
  UINT8 instrument[4];                                          // bytes 24 to 27
  UINT8 trader_id[8];                                           // bytes 28 to 35
  UINT8 reference_id_order_id_or_quote_id[8];                   // bytes 36 to 43
  UINT8 verb_side;                                              // byte 44, values VERB_SIDE_
  UINT8 quantity_traded[8];                                     // bytes 45 to 52
  UINT8 trade_price[10];                                        // bytes 53 to 62
  UINT8 trading_engine_timestamp_of_the_trade_local_hhmmss[6];  // bytes 63 to 68
  ClearingData clearing_data;                                   // bytes 69 to 88
  OwnerData owner_data;                                         // bytes 89 to 138
  UINT8 special_trade_indicator;                                // byte 139, values SPECIAL_TRADE_INDICATOR_
  UINT8 price_type;                                             // byte 140, values PRICE_TYPE_
  UINT8 trade_type;                                             // byte 141, values TRADE_TYPE_
  UINT8 filler_6[6];                                            // bytes 142 to 147
  UINT8 trade_number[8];                                        // bytes 148 to 155
  UINT8 trade_memo[50];                                         // bytes 156 to 205
  UINT8 original_reference_id[8];                               // bytes 206 to 213
  UINT8 id_code_for_the_counterpart_participant[4];             // bytes 214 to 217
  UINT8 strategy_group[2];                                      // bytes 218 to 219
  UINT8 strategy_instrument_id[4];                              // bytes 220 to 223
  UINT8 strategy_verb_side;                                     // byte 224
  UINT8 strategy_trade_number[8];                               // bytes 225 to 232
  UINT8 leg_number[2];                                          // bytes 233 to 234
} LegExecutionCancellationNotice;

// ---- Order Cancellation Notice By Mod Or System: 148 bytes -------------------

// This triggered message is sent by the Exchange to report the cancellation of an order by the MOD or by the System. This message has the same number of bytes and format as the KE: Order Acknowledgement, KM: Order Modification Acknowledgement and KZ: Order Cancellation Acknowledgement messages.
entrypoint typedef struct _OrderCancellationNoticeByModOrSystem {
  OutgoingMessagesHeader outgoing_messages_header;  // bytes 0 to 21
  UINT8 group[2];                                   // bytes 22 to 23
  UINT8 instrument[4];                              // bytes 24 to 27
  UINT8 trader_id[8];                               // bytes 28 to 35
  UINT8 order_id[8];                                // bytes 36 to 43
  UINT8 status;                                     // byte 44, values STATUS_
  UINT8 verb_side;                                  // byte 45, values VERB_SIDE_
  UINT8 quantity[8];                                // bytes 46 to 53
  UINT8 assigned_price[10];                         // bytes 54 to 63
  ClearingData clearing_data;                       // bytes 64 to 83
  OwnerData owner_data;                             // bytes 84 to 133
  UINT8 original_order_id[8];                       // bytes 134 to 141
  UINT8 filler_6[6];                                // bytes 142 to 147
} OrderCancellationNoticeByModOrSystem;

// ---- Request For Quote With Side Acknowledgement: 37 bytes -------------------

entrypoint typedef struct _RequestForQuoteWithSideAcknowledgement {
  OutgoingMessagesHeader outgoing_messages_header;  // bytes 0 to 21
  UINT8 group[2];                                   // bytes 22 to 23
  UINT8 instrument[4];                              // bytes 24 to 27
  UINT8 quantity[8];                                // bytes 28 to 35
  UINT8 market_side;                                // byte 36, values MARKET_SIDE_
} RequestForQuoteWithSideAcknowledgement;

