  UINT8 additional_quantity[8];                     // bytes 61 to 68
  UINT8 duration_type;                              // byte 69, values DURATION_TYPE_
  UINT8 gtd_date[8];                                // bytes 70 to 77
  UINT8 filler_4[4];                                // bytes 78 to 81
  UINT8 filler_1;                                   // byte 82
  UINT8 modified_order_id[8];                       // bytes 83 to 90
  ClearingData clearing_data;                       // bytes 91 to 110
  OwnerData owner_data;                             // bytes 111 to 160
  UINT8 anti_wash_id[8];                            // bytes 161 to 168
  UINT8 anti_wash_instruction;                      // byte 169, values ANTI_WASH_INSTRUCTION_
  UINT8 filler_20[20];                              // bytes 170 to 189
} OrderModification;

