// ---- Values ------------------------------------------------------------------

// Account Type: one byte code
#define ACCOUNT_TYPE_CUSTOMER 0x31                // Customer
#define ACCOUNT_TYPE_HOUSE 0x32                   // House
#define ACCOUNT_TYPE_PRO 0x34                     // Pro
#define ACCOUNT_TYPE_NON_CLIENT 0x35              // Non Client
#define ACCOUNT_TYPE_NON_CLIENT_SHAREHOLDER 0x44  // Non Client Shareholder
#define ACCOUNT_TYPE_CUSTOMER_SHAREHOLDER 0x48    // Customer Shareholder
#define ACCOUNT_TYPE_CUSTOMER_INSIDER 0x49        // Customer Insider
#define ACCOUNT_TYPE_PRO_SHAREHOLDER 0x4C         // Pro Shareholder
#define ACCOUNT_TYPE_HOUSE_INSIDER 0x4E           // House Insider
#define ACCOUNT_TYPE_HOUSE_SHAREHOLDER 0x4F       // House Shareholder
#define ACCOUNT_TYPE_NON_CLIENT_INSIDER 0x52      // Non Client Insider
#define ACCOUNT_TYPE_PRO_INSIDER 0x53             // Pro Insider

// Open Close: one byte code
#define OPEN_CLOSE_ALL_LEGS_ARE_OPEN_OR_SINGLE_SECURITY 0x4F            // All Legs Are Open Or Single Security
#define OPEN_CLOSE_ALL_LEGS_ARE_CLOSED_OR_SINGLE_SECURITY 0x43          // All Legs Are Closed Or Single Security
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE 0x31                          // Leg 1 Open, Leg 2 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN 0x32                          // Leg 1 Close, Leg 2 Open
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_OPEN_LEG_3_CLOSE 0x33               // Leg 1 Open, Leg 2 Open, Leg 3 Close
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE_LEG_3_OPEN 0x34               // Leg 1 Open, Leg 2 Close, Leg 3 Open
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE_LEG_3_CLOSE 0x35              // Leg 1 Open, Leg 2 Close, Leg 3 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN_LEG_3_OPEN 0x36               // Leg 1 Close, Leg 2 Open, Leg 3 Open
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN_LEG_3_CLOSE 0x37              // Leg 1 Close, Leg 2 Open, Leg 3 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_CLOSE_LEG_3_OPEN 0x38              // Leg 1 Close, Leg 2 Close, Leg 3 Open
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_OPEN_LEG_3_OPEN_LEG_4_CLOSE 0x41    // Leg 1 Open, Leg 2 Open, Leg 3 Open, Leg 4 Close
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_OPEN_LEG_3_CLOSE_LEG_4_OPEN 0x42    // Leg 1 Open, Leg 2 Open, Leg 3 Close, Leg 4 Open
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_OPEN_LEG_3_CLOSE_LEG_4_CLOSE 0x44   // Leg 1 Open, Leg 2 Open, Leg 3 Close, Leg 4 Close
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE_LEG_3_OPEN_LEG_4_OPEN 0x45    // Leg 1 Open, Leg 2 Close, Leg 3 Open, Leg 4 Open
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE_LEG_3_OPEN_LEG_4_CLOSE 0x46   // Leg 1 Open, Leg 2 Close, Leg 3 Open, Leg 4 Close
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE_LEG_3_CLOSE_LEG_4_OPEN 0x47   // Leg 1 Open, Leg 2 Close, Leg 3 Close, Leg 4 Open
#define OPEN_CLOSE_LEG_1_OPEN_LEG_2_CLOSE_LEG_3_CLOSE_LEG_4_CLOSE 0x48  // Leg 1 Open, Leg 2 Close, Leg 3 Close, Leg 4 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN_LEG_3_OPEN_LEG_4_OPEN 0x49    // Leg 1 Close, Leg 2 Open, Leg 3 Open, Leg 4 Open
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN_LEG_3_OPEN_LEG_4_CLOSE 0x4A   // Leg 1 Close, Leg 2 Open, Leg 3 Open, Leg 4 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN_LEG_3_CLOSE_LEG_4_OPEN 0x4B   // Leg 1 Close, Leg 2 Open, Leg 3 Close, Leg 4 Open
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_OPEN_LEG_3_CLOSE_LEG_4_CLOSE 0x4C  // Leg 1 Close, Leg 2 Open, Leg 3 Close, Leg 4 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_CLOSE_LEG_3_OPEN_LEG_4_OPEN 0x4D   // Leg 1 Close, Leg 2 Close, Leg 3 Open, Leg 4 Open
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_CLOSE_LEG_3_OPEN_LEG_4_CLOSE 0x4E  // Leg 1 Close, Leg 2 Close, Leg 3 Open, Leg 4 Close
#define OPEN_CLOSE_LEG_1_CLOSE_LEG_2_CLOSE_LEG_3_CLOSE_LEG_4_OPEN 0x50  // Leg 1 Close, Leg 2 Close, Leg 3 Close, Leg 4 Open

// Hedge Spec: one byte code
#define HEDGE_SPEC_HEDGER 0x48      // Hedger
#define HEDGE_SPEC_SPECULATOR 0x53  // Speculator

// Type Of Cancellation Q Quotes Only: one byte code
#define TYPE_OF_CANCELLATION_Q_QUOTES_ONLY_ALL 0x41                 // All
#define TYPE_OF_CANCELLATION_Q_QUOTES_ONLY_QUOTES_ONLY 0x51         // Quotes Only
#define TYPE_OF_CANCELLATION_Q_QUOTES_ONLY_ORDERS_ONLY 0x4F         // Orders Only
#define TYPE_OF_CANCELLATION_Q_QUOTES_ONLY_STOP_ORDERS_ONLY 0x53    // Stop Orders Only
#define TYPE_OF_CANCELLATION_Q_QUOTES_ONLY_MARKET_ORDERS_ONLY 0x4D  // Market Orders Only

// Type Of Cancellation: one byte code
#define TYPE_OF_CANCELLATION_ALL 0x41                 // All
#define TYPE_OF_CANCELLATION_QUOTES_ONLY 0x51         // Quotes Only
#define TYPE_OF_CANCELLATION_ORDERS_ONLY 0x4F         // Orders Only
#define TYPE_OF_CANCELLATION_STOP_ORDERS_ONLY 0x53    // Stop Orders Only
#define TYPE_OF_CANCELLATION_MARKET_ORDERS_ONLY 0x4D  // Market Orders Only

// Global Net Exposure Action: one byte code
#define GLOBAL_NET_EXPOSURE_ACTION_NOT_SET 0x3F        // Not Set
#define GLOBAL_NET_EXPOSURE_ACTION_ENFORCE_LIMIT 0x45  // Enforce Limit
#define GLOBAL_NET_EXPOSURE_ACTION_NONE 0x4E           // None
#define GLOBAL_NET_EXPOSURE_ACTION_WARNING 0x57        // Warning

// Default Net Exposure Action: one byte code
#define DEFAULT_NET_EXPOSURE_ACTION_NOT_SET 0x3F        // Not Set
#define DEFAULT_NET_EXPOSURE_ACTION_ENFORCE_LIMIT 0x45  // Enforce Limit
#define DEFAULT_NET_EXPOSURE_ACTION_NONE 0x4E           // None
#define DEFAULT_NET_EXPOSURE_ACTION_WARNING 0x57        // Warning

// Default Long Exposure Action: one byte code
#define DEFAULT_LONG_EXPOSURE_ACTION_NOT_SET 0x3F        // Not Set
#define DEFAULT_LONG_EXPOSURE_ACTION_ENFORCE_LIMIT 0x45  // Enforce Limit
#define DEFAULT_LONG_EXPOSURE_ACTION_NONE 0x4E           // None
#define DEFAULT_LONG_EXPOSURE_ACTION_WARNING 0x57        // Warning

// Default Short Exposure Action: one byte code
#define DEFAULT_SHORT_EXPOSURE_ACTION_NOT_SET 0x3F        // Not Set
#define DEFAULT_SHORT_EXPOSURE_ACTION_ENFORCE_LIMIT 0x45  // Enforce Limit
#define DEFAULT_SHORT_EXPOSURE_ACTION_NONE 0x4E           // None
#define DEFAULT_SHORT_EXPOSURE_ACTION_WARNING 0x57        // Warning

// Default Net Position Action: one byte code
#define DEFAULT_NET_POSITION_ACTION_NOT_SET 0x3F        // Not Set
#define DEFAULT_NET_POSITION_ACTION_ENFORCE_LIMIT 0x45  // Enforce Limit
#define DEFAULT_NET_POSITION_ACTION_NONE 0x4E           // None
#define DEFAULT_NET_POSITION_ACTION_WARNING 0x57        // Warning

// Default Long Position Action: one byte code
#define DEFAULT_LONG_POSITION_ACTION_NOT_SET 0x3F        // Not Set
#define DEFAULT_LONG_POSITION_ACTION_ENFORCE_LIMIT 0x45  // Enforce Limit
#define DEFAULT_LONG_POSITION_ACTION_NONE 0x4E           // None
#define DEFAULT_LONG_POSITION_ACTION_WARNING 0x57        // Warning

// Default Short Position Action: one byte code
#define DEFAULT_SHORT_POSITION_ACTION_NOT_SET 0x3F        // Not Set
#define DEFAULT_SHORT_POSITION_ACTION_ENFORCE_LIMIT 0x45  // Enforce Limit
#define DEFAULT_SHORT_POSITION_ACTION_NONE 0x4E           // None
#define DEFAULT_SHORT_POSITION_ACTION_WARNING 0x57        // Warning

// Price Type: one byte code
#define PRICE_TYPE_COMMITTED 0x43                         // Committed
#define PRICE_TYPE_LIMIT_PRICE_SET_IN_MESSAGE 0x4C        // Limit Price Set In Message
#define PRICE_TYPE_AT_OPENING_PRICE 0x4F                  // At Opening Price
#define PRICE_TYPE_AT_BEST_OPPOSITE_PRICE_TOP_ORDER 0x4D  // At Best Opposite Price Top Order

// Verb Side: one byte code
#define VERB_SIDE_BUY 0x42   // Buy
#define VERB_SIDE_SELL 0x53  // Sell

// Special Price Term: one byte code
#define SPECIAL_PRICE_TERM_NONE 0x20        // None
#define SPECIAL_PRICE_TERM_STOP_ORDER 0x53  // Stop Order

// Quantity Term: one byte code
#define QUANTITY_TERM_NONE 0x20       // None
#define QUANTITY_TERM_DISCLOSED 0x44  // Disclosed
#define QUANTITY_TERM_MINIMUM 0x4D    // Minimum

// Duration Type: one byte code
#define DURATION_TYPE_GOOD_TILL_DATE 0x44    // Good Till Date
#define DURATION_TYPE_FILL_AND_KILL 0x45     // Fill And Kill
#define DURATION_TYPE_GOOD_TILL_CANCEL 0x46  // Good Till Cancel
#define DURATION_TYPE_DAY 0x4A               // Day
#define DURATION_TYPE_PRE_OPENING 0x50       // Pre Opening
#define DURATION_TYPE_WHILE_CONNECTED 0x57   // While Connected

// Anti Wash Instruction: one byte code
#define ANTI_WASH_INSTRUCTION_CANCEL_BOTH_INBOUND_ORDER_AND_OPPOSITE_RESTING_ORDER 0x42  // Cancel Both Inbound Order And Opposite Resting Order
#define ANTI_WASH_INSTRUCTION_CANCEL_INBOUND_ORDER 0x49                                  // Cancel Inbound Order
#define ANTI_WASH_INSTRUCTION_CANCEL_OPPOSITE_RESTING_ORDER 0x4F                         // Cancel Opposite Resting Order

// Quantity Sign: one byte code
#define QUANTITY_SIGN_ADDS_THE_INCOMING_QUANTITY_TO_THE_BOOKED_QUANTITY 0x2B         // Adds The Incoming Quantity To The Booked Quantity
#define QUANTITY_SIGN_SUBTRACTS_THE_INCOMING_QUANTITY_FROM_THE_BOOKED_QUANTITY 0x2D  // Subtracts The Incoming Quantity From The Booked Quantity
#define QUANTITY_SIGN_REPLACES_THE_BOOKED_QUANTITY_WITH_THE_INCOMING_QUANTITY 0x3D   // Replaces The Booked Quantity With The Incoming Quantity

// Market Side: one byte code
#define MARKET_SIDE_BUY 0x42   // Buy
#define MARKET_SIDE_SELL 0x53  // Sell
#define MARKET_SIDE_BOTH 0x32  // Both

// Protection Type Advanced Protection Advanced Protection Disabled: one byte code
#define PROTECTION_TYPE_ADVANCED_PROTECTION_ADVANCED_PROTECTION_DISABLED_ADVANCED_PROTECTION 0x41           // Advanced Protection
#define PROTECTION_TYPE_ADVANCED_PROTECTION_ADVANCED_PROTECTION_DISABLED_ADVANCED_PROTECTION_DISABLED 0x4E  // Advanced Protection Disabled

// ---- Heartbeat Response: 20 bytes --------------------------------------------

entrypoint typedef struct _HeartbeatResponse {
  UINT8 user_sequence_id_first_user_sequence_id_for_nextcurrent_heartbeat_period[8];  // bytes 0 to 7
  UINT8 last_exchange_message_id_sent_to_participant[6];                              // bytes 8 to 13
  UINT8 user_message_timestamp_local_hhmmss[6];                                       // bytes 14 to 19
} HeartbeatResponse;

// ---- User Disconnection: 12 bytes --------------------------------------------

entrypoint typedef struct _UserDisconnection {
  UINT8 user_id[8];     // bytes 0 to 7
  UINT8 session_id[4];  // bytes 8 to 11
} UserDisconnection;

// ---- Incoming Messages Header: 22 bytes --------------------------------------

// The guide states these fields once, as the Incoming Messages Header, for every business message a Participant sends. Message Type is read by the packet before the branch, so it is not repeated here.
entrypoint typedef struct _IncomingMessagesHeader {
  UINT8 user_timestamp_local_hhmmss[6];  // bytes 0 to 5
  UINT8 trader_id[8];                    // bytes 6 to 13
  UINT8 user_sequence_id[8];             // bytes 14 to 21
} IncomingMessagesHeader;

// ---- Order Request: 22 bytes -------------------------------------------------

entrypoint typedef struct _OrderRequest {
  IncomingMessagesHeader incoming_messages_header;  // bytes 0 to 21
} OrderRequest;

// ---- Clearing Data: 20 bytes -------------------------------------------------

// The guide states these fields once, as Clearing Data, for every message that carries them.
entrypoint typedef struct _ClearingData {
  UINT8 clearing_instruction[12];  // bytes 0 to 11
  UINT8 account_type;              // byte 12, values ACCOUNT_TYPE_
  UINT8 open_close;                // byte 13, values OPEN_CLOSE_
  UINT8 hedge_spec;                // byte 14, values HEDGE_SPEC_
  UINT8 filler_5[5];               // bytes 15 to 19
} ClearingData;

// ---- Owner Data: 50 bytes ----------------------------------------------------

// The guide states this field once, as Owner Data, for every message that carries it.
entrypoint typedef struct _OwnerData {
  UINT8 memo[50];  // bytes 0 to 49
} OwnerData;

// ---- Bulk Quote Data: 174 bytes ----------------------------------------------

entrypoint typedef struct _BulkQuoteData {
  IncomingMessagesHeader incoming_messages_header;  // bytes 0 to 21
  UINT8 group[2];                                   // bytes 22 to 23
  ClearingData clearing_data;                       // bytes 24 to 43
  OwnerData owner_data;                             // bytes 44 to 93
  UINT8 maximum_number_trades[2];                   // bytes 94 to 95
  UINT8 minimum_volume[8];                          // bytes 96 to 103
  UINT8 filler_2[2];                                // bytes 104 to 105
  UINT8 calculation_time_interval[8];               // bytes 106 to 113
  UINT8 maximum_total_volume[8];                    // bytes 114 to 121
  UINT8 maximum_total_value[8];                     // bytes 122 to 129
  UINT8 delta_maximum_volume[8];                    // bytes 130 to 137
  UINT8 delta_maximum_value[8];                     // bytes 138 to 145
  UINT8 anti_wash_id[8];                            // bytes 146 to 153
  UINT8 filler_20[20];                              // bytes 154 to 173
} BulkQuoteData;

// ---- Global Cancellation: 25 bytes -------------------------------------------

entrypoint typedef struct _GlobalCancellation {
  IncomingMessagesHeader incoming_messages_header;  // bytes 0 to 21
  UINT8 group[2];                                   // bytes 22 to 23
  UINT8 type_of_cancellation_q_quotes_only;         // byte 24, values TYPE_OF_CANCELLATION_Q_QUOTES_ONLY_
} GlobalCancellation;

// ---- User Global Cancellation: 37 bytes --------------------------------------

entrypoint typedef struct _UserGlobalCancellation {
  IncomingMessagesHeader incoming_messages_header;  // bytes 0 to 21
  UINT8 group_filter[2];                            // bytes 22 to 23
  UINT8 instrument_filter[4];                       // bytes 24 to 27
  UINT8 type_of_cancellation;                       // byte 28, values TYPE_OF_CANCELLATION_
  UINT8 account_type_filter[8];                     // bytes 29 to 36
} UserGlobalCancellation;

// ---- Set Global Risk Limits: 101 bytes ---------------------------------------

entrypoint typedef struct _SetGlobalRiskLimits {
  IncomingMessagesHeader incoming_messages_header;  // bytes 0 to 21
  UINT8 global_net_exposure_action;                 // byte 22, values GLOBAL_NET_EXPOSURE_ACTION_
  UINT8 default_net_exposure_action;                // byte 23, values DEFAULT_NET_EXPOSURE_ACTION_
  UINT8 default_long_exposure_action;               // byte 24, values DEFAULT_LONG_EXPOSURE_ACTION_
  UINT8 default_short_exposure_action;              // byte 25, values DEFAULT_SHORT_EXPOSURE_ACTION_
  UINT8 default_net_position_action;                // byte 26, values DEFAULT_NET_POSITION_ACTION_
  UINT8 default_long_position_action;               // byte 27, values DEFAULT_LONG_POSITION_ACTION_
  UINT8 default_short_position_action;              // byte 28, values DEFAULT_SHORT_POSITION_ACTION_
  UINT8 global_net_exposure_limit[10];              // bytes 29 to 38
  UINT8 default_maximum_order_quantity[8];          // bytes 39 to 46
  UINT8 default_net_exposure_limit[10];             // bytes 47 to 56
  UINT8 default_long_exposure_limit[10];            // bytes 57 to 66
  UINT8 default_short_exposure_limit[10];           // bytes 67 to 76
  UINT8 default_net_position_limit[8];              // bytes 77 to 84
  UINT8 default_long_position_limit[8];             // bytes 85 to 92
  UINT8 default_short_position_limit[8];            // bytes 93 to 100
} SetGlobalRiskLimits;

// ---- Order Entry: 181 bytes --------------------------------------------------

entrypoint typedef struct _OrderEntry {
  IncomingMessagesHeader incoming_messages_header;  // bytes 0 to 21
  UINT8 group[2];                                   // bytes 22 to 23
  UINT8 instrument[4];                              // bytes 24 to 27
  UINT8 price_type;                                 // byte 28, values PRICE_TYPE_
  UINT8 verb_side;                                  // byte 29, values VERB_SIDE_
  UINT8 quantity[8];                                // bytes 30 to 37
  UINT8 price[10];                                  // bytes 38 to 47
