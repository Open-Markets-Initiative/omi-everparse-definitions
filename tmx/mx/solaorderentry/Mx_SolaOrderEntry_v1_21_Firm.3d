  UINT8 quantity_term;                              // byte 59, values QUANTITY_TERM_
  UINT8 additional_quantity[8];                     // bytes 60 to 67
  UINT8 duration_type;                              // byte 68, values DURATION_TYPE_
  UINT8 gtd_date[8];                                // bytes 69 to 76
  UINT8 executing_participant[4];                   // bytes 77 to 80
  UINT8 filler_1;                                   // byte 81
  ClearingData clearing_data;                       // bytes 82 to 101
  OwnerData owner_data;                             // bytes 102 to 151
  UINT8 anti_wash_id[8];                            // bytes 152 to 159
  UINT8 anti_wash_instruction;                      // byte 160, values ANTI_WASH_INSTRUCTION_
  UINT8 filler_20[20];                              // bytes 161 to 180
} OrderEntry;

