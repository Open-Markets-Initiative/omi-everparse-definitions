// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out BlueEquities_MemoirDepthFeed_v1_3.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_HEARTBEAT_MESSAGE 0x00         // Heartbeat Message
#define MESSAGE_TYPE_SESSION_SHUTDOWN_MESSAGE 0x01  // Session Shutdown Message
#define MESSAGE_TYPE_SEQUENCED_MESSAGE 0x02         // Sequenced Message

// Template Id: one byte code
#define TEMPLATE_ID_INSTRUMENT_DIRECTORY_MESSAGE 0x01     // Instrument Directory Message
#define TEMPLATE_ID_REG_SHO_RESTRICTION_MESSAGE 0x02      // Reg Sho Restriction Message
#define TEMPLATE_ID_SECURITY_TRADING_STATUS_MESSAGE 0x03  // Security Trading Status Message
#define TEMPLATE_ID_TRADING_SESSION_STATUS_MESSAGE 0x05   // Trading Session Status Message
#define TEMPLATE_ID_ORDER_ADDED_MESSAGE 0x0A              // Order Added Message
#define TEMPLATE_ID_ORDER_DELETED_MESSAGE 0x0B            // Order Deleted Message
#define TEMPLATE_ID_ORDER_REDUCED_MESSAGE 0x0C            // Order Reduced Message
#define TEMPLATE_ID_ORDER_EXECUTED_MESSAGE 0x0D           // Order Executed Message
#define TEMPLATE_ID_TRADE_MESSAGE 0x0E                    // Trade Message
#define TEMPLATE_ID_BROKEN_TRADE_MESSAGE 0x0F             // Broken Trade Message
#define TEMPLATE_ID_CORRECTED_TRADE_MESSAGE 0x10          // Corrected Trade Message
#define TEMPLATE_ID_CLEAR_BOOK_MESSAGE 0x12               // Clear Book Message
#define TEMPLATE_ID_SNAPSHOT_COMPLETE_MESSAGE 0x64        // Snapshot Complete Message

// Is Test Symbol: one byte code
#define IS_TEST_SYMBOL_FALSE 0x00  // False
#define IS_TEST_SYMBOL_TRUE 0x01   // True

// Short Sale Restriction: one byte code
#define SHORT_SALE_RESTRICTION_FALSE 0x00  // False
#define SHORT_SALE_RESTRICTION_TRUE 0x01   // True

// Security Trading Status: one byte code
#define SECURITY_TRADING_STATUS_HALTED 0x48   // Halted
#define SECURITY_TRADING_STATUS_PAUSED 0x50   // Paused
#define SECURITY_TRADING_STATUS_QUOTING 0x51  // Quoting
#define SECURITY_TRADING_STATUS_TRADING 0x54  // Trading

// Security Trading Status Reason: one byte code
#define SECURITY_TRADING_STATUS_REASON_NONE 0x58            // None
#define SECURITY_TRADING_STATUS_REASON_REGULATORY 0x52      // Regulatory
#define SECURITY_TRADING_STATUS_REASON_ADMINISTRATIVE 0x41  // Administrative

// Trading Session: one byte code
#define TRADING_SESSION_OPENING 0x31       // Opening
#define TRADING_SESSION_TRADING 0x32       // Trading
#define TRADING_SESSION_POST_TRADING 0x33  // Post Trading
#define TRADING_SESSION_CLOSED 0x34        // Closed

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// ---- Types -------------------------------------------------------------------

// Maps a tradable security to the Security ID used in place of its ticker on every later message of the session; sent for all tradable securities at the start of the trading day
typedef struct _InstrumentDirectoryMessage {
  UINT64BE timestamp;    // bytes 0 to 7
  UINT16BE security_id;  // bytes 8 to 9
  UINT8 symbol[6];       // bytes 10 to 15
  UINT8 symbol_sfx[6];   // bytes 16 to 21
  UINT32BE round_lot;    // bytes 22 to 25
  UINT8 reserved;        // byte 26
  UINT8 is_test_symbol;  // byte 27
  UINT64BE mpv;          // bytes 28 to 35, signed, read here as unsigned
} InstrumentDirectoryMessage;

// Indicates that a security is subject to the Rule 201 Regulation SHO short sale price restriction; may follow the Instrument Directory message when the restriction is already in effect
typedef struct _RegShoRestrictionMessage {
  UINT64BE timestamp;            // bytes 0 to 7
  UINT16BE security_id;          // bytes 8 to 9
  UINT8 short_sale_restriction;  // byte 10
} RegShoRestrictionMessage;

// Current trading status of a security, halted or paused by the listing market over the Sip or by the exchange itself; assume Halted until one is received
typedef struct _SecurityTradingStatusMessage {
  UINT64BE timestamp;                    // bytes 0 to 7
  UINT16BE security_id;                  // bytes 8 to 9
  UINT8 security_trading_status;         // byte 10
  UINT8 security_trading_status_reason;  // byte 11
} SecurityTradingStatusMessage;

// The exchange has entered a new trading session
typedef struct _TradingSessionStatusMessage {
  UINT64BE timestamp;     // bytes 0 to 7
  UINT8 trading_session;  // byte 8
} TradingSessionStatusMessage;

// A visible order has been added to the book; its Order Id is the key tracking the order through the rest of its lifecycle
typedef struct _OrderAddedMessage {
  UINT64BE timestamp;    // bytes 0 to 7
  UINT16BE security_id;  // bytes 8 to 9
  UINT64BE order_id;     // bytes 10 to 17
  UINT8 side;            // byte 18
  UINT32BE quantity;     // bytes 19 to 22
  UINT64BE price;        // bytes 23 to 30, signed, read here as unsigned
} OrderAddedMessage;

// A visible order was removed from the book, cancelled by the customer or by an administrative operation; the Order Id is no longer tracked
typedef struct _OrderDeletedMessage {
  UINT64BE timestamp;    // bytes 0 to 7
  UINT16BE security_id;  // bytes 8 to 9
  UINT64BE order_id;     // bytes 10 to 17
} OrderDeletedMessage;

// A visible order was reduced in quantity while keeping its matching priority; subtract the quantity from the order and remove it from the book when the remainder reaches zero
typedef struct _OrderReducedMessage {
  UINT64BE timestamp;    // bytes 0 to 7
  UINT16BE security_id;  // bytes 8 to 9
  UINT64BE order_id;     // bytes 10 to 17
  UINT32BE quantity;     // bytes 18 to 21
} OrderReducedMessage;

// A visible order on the book was executed; remove it when the remaining quantity reaches zero, otherwise it keeps its time priority
typedef struct _OrderExecutedMessage {
  UINT64BE timestamp;    // bytes 0 to 7
  UINT16BE security_id;  // bytes 8 to 9
  UINT64BE order_id;     // bytes 10 to 17
  UINT64BE trade_id;     // bytes 18 to 25
  UINT32BE quantity;     // bytes 26 to 29
  UINT64BE price;        // bytes 30 to 37, signed, read here as unsigned
} OrderExecutedMessage;

// A non displayed order on the book was executed; the displayed book is unchanged but cumulative volume and average price are affected
typedef struct _TradeMessage {
  UINT64BE timestamp;    // bytes 0 to 7
  UINT16BE security_id;  // bytes 8 to 9
  UINT64BE trade_id;     // bytes 10 to 17
  UINT32BE quantity;     // bytes 18 to 21
  UINT64BE price;        // bytes 22 to 29, signed, read here as unsigned
} TradeMessage;

// An operational or regulatory action has busted an execution; remove it from daily volume and average price, it cannot be reinstated
typedef struct _BrokenTradeMessage {
  UINT64BE timestamp;          // bytes 0 to 7
  UINT16BE security_id;        // bytes 8 to 9
  UINT64BE trade_id;           // bytes 10 to 17
  UINT32BE original_quantity;  // bytes 18 to 21
  UINT64BE original_price;     // bytes 22 to 29, signed, read here as unsigned
} BrokenTradeMessage;

// An operational or regulatory action has corrected an execution without busting it; replace the original volume and price with the corrected values
typedef struct _CorrectedTradeMessage {
  UINT64BE timestamp;           // bytes 0 to 7
  UINT16BE security_id;         // bytes 8 to 9
  UINT64BE trade_id;            // bytes 10 to 17
  UINT32BE original_quantity;   // bytes 18 to 21
  UINT64BE original_price;      // bytes 22 to 29, signed, read here as unsigned
  UINT32BE corrected_quantity;  // bytes 30 to 33
  UINT64BE corrected_price;     // bytes 34 to 41, signed, read here as unsigned
} CorrectedTradeMessage;

// An operational or regulatory action has reset the book state; remove every existing order for the security
typedef struct _ClearBookMessage {
  UINT64BE timestamp;    // bytes 0 to 7
  UINT16BE security_id;  // bytes 8 to 9
} ClearBookMessage;

// End of the snapshot, every message has been sent; disconnect from the snapshot feed and reconcile against the incremental feed
typedef struct _SnapshotCompleteMessage {
  UINT64BE timestamp;              // bytes 0 to 7
  UINT64BE as_of_sequence_number;  // bytes 8 to 15
} SnapshotCompleteMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: InstrumentDirectoryMessage instrument_directory_message;
    case 0x02: RegShoRestrictionMessage reg_sho_restriction_message;
    case 0x03: SecurityTradingStatusMessage security_trading_status_message;
    case 0x05: TradingSessionStatusMessage trading_session_status_message;
    case 0x0A: OrderAddedMessage order_added_message;
    case 0x0B: OrderDeletedMessage order_deleted_message;
    case 0x0C: OrderReducedMessage order_reduced_message;
    case 0x0D: OrderExecutedMessage order_executed_message;
    case 0x0E: TradeMessage trade_message;
    case 0x0F: BrokenTradeMessage broken_trade_message;
    case 0x10: CorrectedTradeMessage corrected_trade_message;
    case 0x12: ClearBookMessage clear_book_message;
    case 0x64: SnapshotCompleteMessage snapshot_complete_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Sbe Message
typedef struct _SbeMessage {
  UINT16BE block_length;                                                                                           // bytes 0 to 1
  UINT8 template_id;                                                                                               // byte 2
  UINT8 schema_id;                                                                                                 // byte 3
  UINT16BE version;                                                                                                // bytes 4 to 5
  Payload(template_id, ((UINT32) block_length)) payload[:byte-size-single-element-array ((UINT32) block_length)];
} SbeMessage;

// One element of the message list, its length followed by that many bytes of payload
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length;                                                                                                                                         // bytes 0 to 1
  SbeMessage sbe_message;
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// A datagram carrying one or more business messages; the first has the sequence in the common header and each one after it adds one, so the next datagram starts at this sequence plus this message count
typedef struct _SequencedMessage (UINT32 available, mutable UINT32 * tally) where (available >= 2) {
  UINT16BE message_count;                                                                                                   // bytes 0 to 1
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 2)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} SequencedMessage;

// Branch
casetype _SequencedMessages (UINT8 selector, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    case 0x01: unit session_shutdown;
    case 0x02: SequencedMessage(available, tally) sequenced_message;
    default: UINT8 unknown[available];
  }
} SequencedMessages;

// ---- Packet: Packet ----------------------------------------------------------

// A Memx Udp datagram, a common header followed by the payload its message type calls for; the protocol is broadcast only, nothing is sent back to the source and missed data is recovered out of band over Memx Tcp
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 18) {
  UINT8 message_type;                                                                                                             // byte 0
  UINT8 header_length;                                                                                                            // byte 1
  UINT64BE session_id;                                                                                                            // bytes 2 to 9
  UINT64BE sequence_number;                                                                                                       // bytes 10 to 17
  SequencedMessages(message_type, (available - 18), tally) sequenced_messages[:byte-size-single-element-array (available - 18)];
} Packet;

