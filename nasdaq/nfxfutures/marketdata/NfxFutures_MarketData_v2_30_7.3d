// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NfxFutures_MarketData_v2_30_7.3d

// ---- Values ------------------------------------------------------------------

// Financial Product: one byte code
#define FINANCIAL_PRODUCT_NOT_APPLICABLE 0x00               // Not Applicable
#define FINANCIAL_PRODUCT_OPTION 0x01                       // Option
#define FINANCIAL_PRODUCT_FORWARD 0x02                      // Forward
#define FINANCIAL_PRODUCT_FUTURE 0x03                       // Future
#define FINANCIAL_PRODUCT_FRA 0x04                          // Fra
#define FINANCIAL_PRODUCT_CASH 0x05                         // Cash
#define FINANCIAL_PRODUCT_PAYMENT 0x06                      // Payment
#define FINANCIAL_PRODUCT_EXCHANGE_RATE 0x07                // Exchange Rate
#define FINANCIAL_PRODUCT_INTEREST_RATE_SWAP 0x08           // Interest Rate Swap
#define FINANCIAL_PRODUCT_REPO 0x09                         // Repo
#define FINANCIAL_PRODUCT_SYNTHETIC_BOX_LEG_REFERENCE 0x0A  // Synthetic Box Leg Reference
#define FINANCIAL_PRODUCT_STANDARD_COMBINATION 0x0B         // Standard Combination
#define FINANCIAL_PRODUCT_GUARANTEE 0x0C                    // Guarantee
#define FINANCIAL_PRODUCT_OTC_GENERAL 0x0D                  // Otc General
#define FINANCIAL_PRODUCT_EQUITY_WARRANT 0x0E               // Equity Warrant
#define FINANCIAL_PRODUCT_SECURITY_LENDING 0x0F             // Security Lending

// Put Or Call: one byte code
#define PUT_OR_CALL_CALL 0x01  // Call
#define PUT_OR_CALL_PUT 0x02   // Put

// Strategy Subtype: one byte code
#define STRATEGY_SUBTYPE_NOT_APPLICABLE 0x00  // Not Applicable
#define STRATEGY_SUBTYPE_COVERED_OPTION 0x01  // Covered Option

// Leg Side: one byte code
#define LEG_SIDE_AS_DEFINED 0x42  // As Defined
#define LEG_SIDE_OPPOSITE 0x43    // Opposite

// Trade Type: 2 byte code
#define TRADE_TYPE_BLOCK_TRADE 0x0001            // Block Trade
#define TRADE_TYPE_EXCHANGE_FOR_PHYSICAL 0x0002  // Exchange For Physical
#define TRADE_TYPE_EXCHANGE_FOR_RISK 0x000B      // Exchange For Risk
#define TRADE_TYPE_EXCHANGE_FOR_OPTIONS 0x000E   // Exchange For Options

// ---- Types -------------------------------------------------------------------

typedef struct _SecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} SecondsMessage;

typedef struct _OrderBookDirectory {
  UINT32BE timestamp_nanoseconds;                // bytes 0 to 3
  UINT32BE order_book_id;                        // bytes 4 to 7
  UINT8 symbol[32];                              // bytes 8 to 39
  UINT8 long_name[32];                           // bytes 40 to 71
  UINT8 isin[12];                                // bytes 72 to 83
  UINT8 financial_product;                       // byte 84
  UINT8 trading_currency[3];                     // bytes 85 to 87
  UINT16BE number_of_decimals_in_price;          // bytes 88 to 89
  UINT16BE number_of_decimals_in_nominal_value;  // bytes 90 to 91
  UINT32BE odd_lot_size;                         // bytes 92 to 95
  UINT32BE round_lot_size;                       // bytes 96 to 99
  UINT32BE block_lot_size;                       // bytes 100 to 103
  UINT64BE nominal_value;                        // bytes 104 to 111
  UINT8 number_of_legs;                          // byte 112
  UINT32BE underlying_order_book_id;             // bytes 113 to 116
  UINT32BE strike_price;                         // bytes 117 to 120, signed, read here as unsigned
  UINT32BE expiration_date;                      // bytes 121 to 124
  UINT16BE number_of_decimals_in_strike_price;   // bytes 125 to 126
  UINT8 put_or_call;                             // byte 127
  UINT16BE market_id;                            // bytes 128 to 129
  UINT8 strategy_subtype;                        // byte 130
  UINT32BE minimum_quantity_and_multiple;        // bytes 131 to 134
} OrderBookDirectory;

// Combination Order book Directory Message
typedef struct _CombinationOrderBookLeg {
  UINT32BE timestamp_nanoseconds;      // bytes 0 to 3
  UINT32BE combination_order_book_id;  // bytes 4 to 7
  UINT32BE leg_order_book_id;          // bytes 8 to 11
  UINT8 leg_side;                      // byte 12
  UINT32BE leg_ratio;                  // bytes 13 to 16
  UINT32BE leg_price_future;           // bytes 17 to 20
  UINT32BE leg_delta;                  // bytes 21 to 24
  UINT32BE leg_quantity_future;        // bytes 25 to 28
} CombinationOrderBookLeg;

// L - Tick Size Message.
typedef struct _TickSizeTableEntry {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE order_book_id;          // bytes 4 to 7
  UINT64BE tick_size;              // bytes 8 to 15, signed, read here as unsigned
  UINT32BE price_from;             // bytes 16 to 19, signed, read here as unsigned
  UINT32BE price_to;               // bytes 20 to 23, signed, read here as unsigned
} TickSizeTableEntry;

typedef struct _SystemEventMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT8 event_code;                // byte 4
} SystemEventMessage;

typedef struct _OrderBookStateMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE order_book_id;          // bytes 4 to 7
  UINT8 state_name[20];            // bytes 8 to 27
} OrderBookStateMessage;

typedef struct _ReportedTrade {
  UINT32BE timestamp_nanoseconds;        // bytes 0 to 3
  UINT32BE order_book_id;                // bytes 4 to 7
  UINT64BE traded_quantity;              // bytes 8 to 15
  UINT64BE match_id;                     // bytes 16 to 23
  UINT32BE combo_group_id;               // bytes 24 to 27
  UINT64BE time_of_trade_execution;      // bytes 28 to 35
  UINT64BE time_of_trade_agreement;      // bytes 36 to 43
  UINT64BE time_of_trade_dissemination;  // bytes 44 to 51
  UINT32BE trade_price;                  // bytes 52 to 55, signed, read here as unsigned
  UINT16BE trade_type;                   // bytes 56 to 57
  UINT8 reserved[7];                     // bytes 58 to 64
  UINT8 second_reserved[7];              // bytes 65 to 71
} ReportedTrade;

typedef struct _BrokenTradeMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT64BE match_id;               // bytes 4 to 11
} BrokenTradeMessage;

typedef struct _OpenInterestMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT32BE order_book_id;          // bytes 4 to 7
  UINT64BE open_interest;          // bytes 8 to 15
} OpenInterestMessage;

typedef struct _PriceMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT8 price_type;                // byte 4
  UINT32BE order_book_id;          // bytes 5 to 8
  UINT32BE price;                  // bytes 9 to 12, signed, read here as unsigned
} PriceMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: SecondsMessage seconds_message;
    case 0x52: OrderBookDirectory order_book_directory;
    case 0x4D: CombinationOrderBookLeg combination_order_book_leg;
    case 0x4C: TickSizeTableEntry tick_size_table_entry;
    case 0x53: SystemEventMessage system_event_message;
    case 0x4F: OrderBookStateMessage order_book_state_message;
    case 0x72: ReportedTrade reported_trade;
    case 0x42: BrokenTradeMessage broken_trade_message;
    case 0x6F: OpenInterestMessage open_interest_message;
    case 0x70: PriceMessage price_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

