#define REJECT_CODE_INVALID_PERSIST 0x001F            // Invalid Persist
#define REJECT_CODE_INVALID_SHORT_SALE_IND 0x0020     // Invalid Short Sale Ind
#define REJECT_CODE_INVALID_PRODUCT 0x0021            // Invalid Product
#define REJECT_CODE_INVALID_SCOPE 0x0022              // Invalid Scope
#define REJECT_CODE_INVALID_CLEARING_INFO 0x0023      // Invalid Clearing Info
#define REJECT_CODE_INVALID_POSITION_EFFECT 0x0024    // Invalid Position Effect
#define REJECT_CODE_INVALID_CROSS_ID 0x0025           // Invalid Cross Id
#define REJECT_CODE_INVALID_MATCH_ID 0x0026           // Invalid Match Id
#define REJECT_CODE_INVALID_CLIENT_ORDER_ID 0x0027    // Invalid Client Order Id
#define REJECT_CODE_INVALID_KILLSWITCH_ACTION 0x0028  // Invalid Killswitch Action
#define REJECT_CODE_INVALID_LEG_COUNT 0x0029          // Invalid Leg Count
#define REJECT_CODE_INVALID_LEG_TYPE 0x002A           // Invalid Leg Type
#define REJECT_CODE_INVALID_LEG_RATIO 0x002B          // Invalid Leg Ratio
#define REJECT_CODE_INVALID_MPID 0x002C               // Invalid Mpid
#define REJECT_CODE_INVALID_TIME 0x002D               // Invalid Time
#define REJECT_CODE_INVALID_MSG_TYPE 0x002E           // Invalid Msg Type
#define REJECT_CODE_INVALID_DISCLOSURE_MASK 0x002F    // Invalid Disclosure Mask
#define REJECT_CODE_NOT_FREE_TRADING 0x0065           // Not Free Trading
#define REJECT_CODE_PREF_NOT_ALLOWED 0x0066           // Pref Not Allowed
#define REJECT_CODE_STOCK_COMBO_NOT_ALLOWED 0x0067    // Stock Combo Not Allowed
#define REJECT_CODE_INSTRUMENT_HALTED 0x0068          // Instrument Halted
#define REJECT_CODE_KILL_SWITCH_IN_EFFECT 0x0069      // Kill Switch In Effect
#define REJECT_CODE_SYSTEM_CLOSED 0x006A              // System Closed
#define REJECT_CODE_TEST_MODE 0x006B                  // Test Mode
#define REJECT_CODE_ORDER_NOT_FOUND 0x006C            // Order Not Found
#define REJECT_CODE_TOO_LATE_TO_ACT 0x006D            // Too Late To Act
#define REJECT_CODE_INSTRUMENT_CLOSED 0x006E          // Instrument Closed
#define REJECT_CODE_INSTRUMENT_STATE 0x006F           // Instrument State
#define REJECT_CODE_ACTION_NOT_ALLOWED 0x0070         // Action Not Allowed
#define REJECT_CODE_LULD_IN_EFFECT 0x0071             // Luld In Effect
#define REJECT_CODE_TOO_MANY_COMBOS 0x0072            // Too Many Combos
#define REJECT_CODE_REQUEST_CANCELLED 0x0073          // Request Cancelled

// Pending Reason: one byte code
#define PENDING_REASON_REQUEST_IN_PROGRESS 0x41  // Request In Progress

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// System Event message informs of a market or a session-level event.
typedef struct _SystemEventMessage {
  UINT64BE timestamp;  // bytes 0 to 7
  UINT8 event_code;    // byte 8
} SystemEventMessage;

// At the start of each trading day and during intra-day market state changes, the system disseminates directory messages for all symbols trading on the system.
typedef struct _SimpleInstrumentDirectoryMessage {
  UINT64BE timestamp;        // bytes 0 to 7
  UINT16BE product_id;       // bytes 8 to 9
  UINT8 product_name[13];    // bytes 10 to 22
  UINT32BE instrument_id;    // bytes 23 to 26
  UINT8 expir_year;          // byte 27
  UINT8 expir_mon;           // byte 28
  UINT8 expir_day;           // byte 29
  UINT64BE strike_price;     // bytes 30 to 37, signed, read here as unsigned
  UINT8 option_type;         // byte 38
  UINT8 closing_type;        // byte 39
  UINT8 tradable;            // byte 40
  UINT8 closing_only;        // byte 41
  UINT16BE contract_size;    // bytes 42 to 43
  UINT8 mpv;                 // byte 44
  UINT8 system_partition;    // byte 45
  UINT8 security_symbol[5];  // bytes 46 to 50
} SimpleInstrumentDirectoryMessage;

// Leg Definitions (2-10)
typedef struct _ComplexDirectoryLegs {
  UINT8 leg_type;              // byte 0
  UINT32BE leg_instrument_id;  // bytes 1 to 4
  UINT8 leg_side;              // byte 5
  UINT16BE leg_ratio;          // bytes 6 to 7
  UINT8 leg_id;                // byte 8
} ComplexDirectoryLegs;

// This message is sent whenever new complex strategy is created on the system.
typedef struct _ComplexInstrumentDirectoryMessage {
  UINT64BE timestamp;                                                                 // bytes 0 to 7
  UINT16BE product_id;                                                                // bytes 8 to 9
  UINT8 product_name[13];                                                             // bytes 10 to 22
  UINT32BE instrument_id;                                                             // bytes 23 to 26
  UINT8 num_legs;                                                                     // byte 27
  ComplexDirectoryLegs complex_directory_legs[:byte-size (((UINT32) num_legs) * 9)];
} ComplexInstrumentDirectoryMessage;

// This message notifies of changes to the trading status of an instrument.
typedef struct _InstrumentTradingActionMessage {
  UINT64BE timestamp;      // bytes 0 to 7
  UINT16BE product_id;     // bytes 8 to 9
  UINT32BE instrument_id;  // bytes 10 to 13
  UINT8 trading_state;     // byte 14
} InstrumentTradingActionMessage;

// Auction Notification message announces that a new Auction has started in the market for Nasdaq GEMX (GEMX) and Nasdaq MRX (MRX).
typedef struct _AuctionNotificationMessage {
  UINT64BE timestamp;            // bytes 0 to 7
  UINT8 instrument_type;         // byte 8
  UINT32BE instrument_id;        // bytes 9 to 12
  UINT32BE auction_id;           // bytes 13 to 16
  UINT8 order_type;              // byte 17
  UINT8 side;                    // byte 18
  UINT64BE price;                // bytes 19 to 26, signed, read here as unsigned
  UINT32BE quantity;             // bytes 27 to 30
  UINT8 exec_flag;               // byte 31
  UINT8 order_capacity;          // byte 32
  UINT8 firm_id[4];              // bytes 33 to 36
  UINT32BE occ_account;          // bytes 37 to 40
  UINT32BE cmta;                 // bytes 41 to 44
  UINT8 auction_event;           // byte 45
  UINT8 auction_type;            // byte 46
  UINT64BE best_response_price;  // bytes 47 to 54, signed, read here as unsigned
  UINT32BE best_response_size;   // bytes 55 to 58
} AuctionNotificationMessage;

// This message is used to acknowledge a valid order submitted via New Order (Long Form).
typedef struct _OrderAcceptedLongFormMessage {
  UINT64BE timestamp;             // bytes 0 to 7
  UINT8 firm_id[4];               // bytes 8 to 11
  UINT32BE instrument_id;         // bytes 12 to 15
  UINT64BE order_id;              // bytes 16 to 23
  UINT8 cl_ord_id[16];            // bytes 24 to 39
  UINT32BE cmta;                  // bytes 40 to 43
  UINT8 clearing_account[4];      // bytes 44 to 47
  UINT32BE occ_account;           // bytes 48 to 51
  UINT8 cust_acct[10];            // bytes 52 to 61
  UINT8 preferred_party[3];       // bytes 62 to 64
  UINT8 alo_inst;                 // byte 65
  UINT8 iso;                      // byte 66
  UINT8 side;                     // byte 67
  UINT8 order_type;               // byte 68
  UINT64BE price;                 // bytes 69 to 76, signed, read here as unsigned
  UINT32BE quantity;              // bytes 77 to 80
  UINT32BE min_qty;               // bytes 81 to 84
  UINT8 tif;                      // byte 85
  UINT8 capacity;                 // byte 86
  UINT8 auction_type;             // byte 87
  UINT32BE auction_id;            // bytes 88 to 91
  UINT8 flash_inst;               // byte 92
  UINT8 disclosure_mask;          // byte 93
  UINT16BE display_qty;           // bytes 94 to 95
  UINT8 display_when;             // byte 96
  UINT8 display_method;           // byte 97
  UINT16BE display_low_qty;       // bytes 98 to 99
  UINT16BE display_high_qty;      // bytes 100 to 101
  UINT16BE position_effect_mask;  // bytes 102 to 103
  UINT8 stock_leg_short_sale;     // byte 104
  UINT8 stock_leg_mpid[4];        // bytes 105 to 108
  UINT8 persist_inst;             // byte 109
} OrderAcceptedLongFormMessage;

// This message is used to acknowledge a valid order submitted via New Order (Short Form).
typedef struct _OrderAcceptedShortFormMessage {
  UINT64BE timestamp;             // bytes 0 to 7
  UINT8 firm_id[4];               // bytes 8 to 11
  UINT32BE instrument_id;         // bytes 12 to 15
  UINT64BE order_id;              // bytes 16 to 23
  UINT8 cl_ord_id[16];            // bytes 24 to 39
  UINT8 alo_inst;                 // byte 40
  UINT8 iso;                      // byte 41
  UINT8 side;                     // byte 42
  UINT8 order_type;               // byte 43
  UINT64BE price;                 // bytes 44 to 51, signed, read here as unsigned
  UINT16BE quantity_short;        // bytes 52 to 53
  UINT8 tif;                      // byte 54
  UINT8 capacity;                 // byte 55
  UINT8 auction_type;             // byte 56
  UINT32BE auction_id;            // bytes 57 to 60
  UINT8 price_protection;         // byte 61
  UINT16BE position_effect_mask;  // bytes 62 to 63
} OrderAcceptedShortFormMessage;

// This message acknowledges the receipt and acceptance of a valid Replace Order Message. Like Order Accepted Message, Order Replaced Message always comes before any Order Executed Messages or Order Canceled Messages for the replacement.
typedef struct _OrderReplacedMessage {
  UINT64BE timestamp;             // bytes 0 to 7
  UINT8 firm_id[4];               // bytes 8 to 11
  UINT32BE instrument_id;         // bytes 12 to 15
  UINT64BE orig_order_id;         // bytes 16 to 23
  UINT64BE order_id;              // bytes 24 to 31
  UINT8 orig_cl_ord_id[16];       // bytes 32 to 47
  UINT8 alo_inst;                 // byte 48
  UINT8 iso;                      // byte 49
  UINT8 side;                     // byte 50
  UINT8 order_type;               // byte 51
  UINT64BE price;                 // bytes 52 to 59, signed, read here as unsigned
  UINT32BE quantity;              // bytes 60 to 63
  UINT8 tif;                      // byte 64
  UINT8 cust_acct[10];            // bytes 65 to 74
  UINT8 capacity;                 // byte 75
  UINT8 auction_type;             // byte 76
  UINT32BE auction_id;            // bytes 77 to 80
  UINT16BE position_effect_mask;  // bytes 81 to 82
  UINT8 price_protection;         // byte 83
} OrderReplacedMessage;

// An Order Canceled Message informs you that an order has been fully canceled. This could be acknowledging a Cancel Order Message, or it could be the result of the order being canceled automatically by the system.
typedef struct _OrderCanceledMessage {
  UINT64BE timestamp;      // bytes 0 to 7
  UINT8 firm_id[4];        // bytes 8 to 11
  UINT32BE instrument_id;  // bytes 12 to 15
  UINT64BE order_id;       // bytes 16 to 23
  UINT8 cancel_reason;     // byte 24
} OrderCanceledMessage;

// Order Executed Message informs you that all or part of an order has been executed. This message is used for simple as well as complex instruments.
typedef struct _OrderExecutedMessage {
  UINT64BE timestamp;          // bytes 0 to 7
  UINT8 firm_id[4];            // bytes 8 to 11
  UINT16BE product_id;         // bytes 12 to 13
  UINT8 ord_exec_type;         // byte 14
  UINT32BE instrument_id;      // bytes 15 to 18
  UINT32BE leg_instrument_id;  // bytes 19 to 22
  UINT8 leg_id;                // byte 23
  UINT8 auction_type;          // byte 24
  UINT64BE order_id;           // bytes 25 to 32
  UINT32BE cross_id;           // bytes 33 to 36
  UINT32BE match_id;           // bytes 37 to 40
  UINT8 side;                  // byte 41
  UINT8 stock_leg_short_sale;  // byte 42
  UINT64BE price;              // bytes 43 to 50, signed, read here as unsigned
  UINT32BE quantity;           // bytes 51 to 54
  UINT8 liquidity_ind;         // byte 55
} OrderExecutedMessage;

// A Trade Details message contains additional details, specifically clearing information. This message is sent out with a nominal delay after Order Executed message.
typedef struct _TradeDetailsMessage {
  UINT64BE timestamp;          // bytes 0 to 7
  UINT8 firm_id[4];            // bytes 8 to 11
  UINT16BE product_id;         // bytes 12 to 13
  UINT8 ord_exec_type;         // byte 14
  UINT32BE instrument_id;      // bytes 15 to 18
  UINT32BE leg_instrument_id;  // bytes 19 to 22
  UINT8 leg_id;                // byte 23
  UINT8 trans_type;            // byte 24
  UINT8 event_source;          // byte 25
  UINT8 auction_type;          // byte 26
  UINT64BE order_id;           // bytes 27 to 34
  UINT8 cl_ord_id[16];         // bytes 35 to 50
  UINT32BE cross_id;           // bytes 51 to 54
  UINT32BE match_id;           // bytes 55 to 58
  UINT32BE ref_match_id;       // bytes 59 to 62
  UINT8 side;                  // byte 63
  UINT8 stock_leg_short_sale;  // byte 64
  UINT64BE price;              // bytes 65 to 72, signed, read here as unsigned
  UINT32BE quantity;           // bytes 73 to 76
  UINT8 liquidity_ind;         // byte 77
  UINT32BE cmta;               // bytes 78 to 81
  UINT8 clearing_account[4];   // bytes 82 to 85
  UINT32BE occ_account;        // bytes 86 to 89
  UINT8 cust_acct[10];         // bytes 90 to 99
  UINT8 stock_venue;           // byte 100
  UINT8 stock_leg_mpid[4];     // bytes 101 to 104
  UINT8 capacity;              // byte 105
  UINT8 open_close;            // byte 106
} TradeDetailsMessage;

// This message acknowledges the receipt and acceptance of a valid New Cross Order.
typedef struct _CrossOrderAcceptedMessage {
  UINT64BE timestamp;                     // bytes 0 to 7
  UINT8 firm_id[4];                       // bytes 8 to 11
  UINT32BE instrument_id;                 // bytes 12 to 15
  UINT8 cross_type;                       // byte 16
  UINT8 auction_type;                     // byte 17
  UINT32BE auction_id;                    // bytes 18 to 21
  UINT8 auction_alloc_pct;                // byte 22
  UINT8 side;                             // byte 23
  UINT8 iso;                              // byte 24
  UINT8 price_protection;                 // byte 25
  UINT64BE effective_time;                // bytes 26 to 33
  UINT8 disclosure_mask;                  // byte 34
  UINT64BE primary_order_id;              // bytes 35 to 42
  UINT8 primary_cl_ord_id[16];            // bytes 43 to 58
  UINT32BE primary_cmta;                  // bytes 59 to 62
  UINT8 primary_clearing_account[4];      // bytes 63 to 66
  UINT32BE primary_occ_account;           // bytes 67 to 70
  UINT8 primary_cust_acct[10];            // bytes 71 to 80
  UINT64BE primary_price;                 // bytes 81 to 88, signed, read here as unsigned
  UINT32BE primary_quantity;              // bytes 89 to 92
  UINT8 primary_capacity;                 // byte 93
  UINT16BE primary_position_effect_mask;  // bytes 94 to 95
  UINT8 primary_stock_leg_short_sale;     // byte 96
  UINT8 primary_stock_leg_mpid[4];        // bytes 97 to 100
  UINT64BE contra_order_id;               // bytes 101 to 108
  UINT8 contra_cl_ord_id[16];             // bytes 109 to 124
  UINT32BE contra_cmta;                   // bytes 125 to 128
  UINT8 contra_clearing_account[4];       // bytes 129 to 132
  UINT32BE contra_occ_account;            // bytes 133 to 136
  UINT8 contra_cust_acct[10];             // bytes 137 to 146
  UINT8 contra_order_type;                // byte 147
  UINT64BE contra_price;                  // bytes 148 to 155, signed, read here as unsigned
  UINT32BE contra_quantity;               // bytes 156 to 159
  UINT8 contra_capacity;                  // byte 160
  UINT16BE contra_position_effect_mask;   // bytes 161 to 162
  UINT8 contra_stock_leg_short_sale;      // byte 163
  UINT8 contra_stock_leg_mpid[4];         // bytes 164 to 167
} CrossOrderAcceptedMessage;

// The Member Kill Switch Notification informs of:
typedef struct _MemberKillSwitchNotificationMessage {
  UINT64BE timestamp;       // bytes 0 to 7
  UINT8 firm_id[4];         // bytes 8 to 11
  UINT8 cl_request_id[16];  // bytes 12 to 27
  UINT8 target_firm_id[4];  // bytes 28 to 31
  UINT8 kill_action;        // byte 32
} MemberKillSwitchNotificationMessage;

// Mass Cancel Response is sent out upon completion of processing of a valid Mass Cancel Request.
typedef struct _MassCancelResponseMessage {
  UINT64BE timestamp;       // bytes 0 to 7
  UINT8 firm_id[4];         // bytes 8 to 11
  UINT8 cl_request_id[16];  // bytes 12 to 27
  UINT32BE num_canceled;    // bytes 28 to 31
  UINT32BE num_pending;     // bytes 32 to 35
} MassCancelResponseMessage;

// Add Complex Instrument Response is sent out when new or existing complex strategy requested via Add Complex Instrument Request is successfully created.
typedef struct _AddComplexInstrumentResponseMessage {
  UINT64BE timestamp;       // bytes 0 to 7
  UINT8 firm_id[4];         // bytes 8 to 11
  UINT8 cl_request_id[16];  // bytes 12 to 27
  UINT32BE instrument_id;   // bytes 28 to 31
} AddComplexInstrumentResponseMessage;

// Modify Trade Response is sent when a valid Modify Trade Request is accepted.
typedef struct _ModifyTradeResponseMessage {
  UINT64BE timestamp;       // bytes 0 to 7
  UINT8 firm_id[4];         // bytes 8 to 11
  UINT8 cl_request_id[16];  // bytes 12 to 27
  UINT8 cl_ord_id[16];      // bytes 28 to 43
  UINT32BE cross_id;        // bytes 44 to 47
  UINT32BE match_id;        // bytes 48 to 51
} ModifyTradeResponseMessage;

// Subscription Response is sent after a valid Subscription Request has been processed.
typedef struct _SubscriptionResponseMessage {
  UINT64BE timestamp;       // bytes 0 to 7
  UINT8 firm_id[4];         // bytes 8 to 11
  UINT8 cl_request_id[16];  // bytes 12 to 27
} SubscriptionResponseMessage;

// Reject is sent in response to a Request that is deemed invalid. Reject message contains error code explaining the reason for rejection
typedef struct _RejectMessage {
  UINT64BE timestamp;     // bytes 0 to 7
  UINT8 reject_msg_type;  // byte 8
  UINT8 cl_ord_id[16];    // bytes 9 to 24
  UINT16BE reject_code;   // bytes 25 to 26
} RejectMessage;

// A Pending Response is sent when a request cannot be immediately, fully processed or validated, and indicates that the final status of the request is not yet known.
typedef struct _PendingResponseMessage {
  UINT64BE timestamp;      // bytes 0 to 7
  UINT8 firm_id[4];        // bytes 8 to 11
  UINT32BE instrument_id;  // bytes 12 to 15
  UINT8 pending_msg_type;  // byte 16
  UINT8 cl_ord_id[16];     // bytes 17 to 32
  UINT8 pending_reason;    // byte 33
} PendingResponseMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x7A: SystemEventMessage system_event_message;
    case 0x6F: SimpleInstrumentDirectoryMessage simple_instrument_directory_message;
    case 0x73: ComplexInstrumentDirectoryMessage complex_instrument_directory_message;
    case 0x69: InstrumentTradingActionMessage instrument_trading_action_message;
    case 0x6E: AuctionNotificationMessage auction_notification_message;
    case 0x61: OrderAcceptedLongFormMessage order_accepted_long_form_message;
    case 0x62: OrderAcceptedShortFormMessage order_accepted_short_form_message;
    case 0x72: OrderReplacedMessage order_replaced_message;
    case 0x63: OrderCanceledMessage order_canceled_message;
    case 0x65: OrderExecutedMessage order_executed_message;
    case 0x74: TradeDetailsMessage trade_details_message;
    case 0x78: CrossOrderAcceptedMessage cross_order_accepted_message;
    case 0x6B: MemberKillSwitchNotificationMessage member_kill_switch_notification_message;
    case 0x75: MassCancelResponseMessage mass_cancel_response_message;
    case 0x64: AddComplexInstrumentResponseMessage add_complex_instrument_response_message;
    case 0x6D: ModifyTradeResponseMessage modify_trade_response_message;
    case 0x66: SubscriptionResponseMessage subscription_response_message;
    case 0x6A: RejectMessage reject_message;
    case 0x70: PendingResponseMessage pending_response_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat_packet;
    case 0x5A: unit end_of_session_packet;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

