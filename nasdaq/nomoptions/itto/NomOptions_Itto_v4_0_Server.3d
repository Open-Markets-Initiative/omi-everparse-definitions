// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NomOptions_Itto_v4_0_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                     // System Event Message
#define SEQUENCED_MESSAGE_TYPE_OPTIONS_DIRECTORY_MESSAGE 0x52                // Options Directory Message
#define SEQUENCED_MESSAGE_TYPE_TRADING_ACTION_MESSAGE 0x48                   // Trading Action Message
#define SEQUENCED_MESSAGE_TYPE_SECURITY_OPEN_MESSAGE 0x4F                    // Security Open Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_MESSAGE_SHORT_MESSAGE_FORM 0x61     // Add Order Message Short Message Form
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_MESSAGE_LONG_FORM_MESSAGE 0x41      // Add Order Message Long Form Message
#define SEQUENCED_MESSAGE_TYPE_ADD_QUOTE_MESSAGE_SHORT_FORM_MESSAGE 0x6A     // Add Quote Message Short Form Message
#define SEQUENCED_MESSAGE_TYPE_ADD_QUOTE_MESSAGE_LONG_FORM_MESSAGE 0x4A      // Add Quote Message Long Form Message
#define SEQUENCED_MESSAGE_TYPE_SINGLE_SIDE_EXECUTED_MESSAGE 0x45             // Single Side Executed Message
#define SEQUENCED_MESSAGE_TYPE_SINGLE_SIDE_EXECUTED_WITH_PRICE_MESSAGE 0x43  // Single Side Executed With Price Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_CANCEL_MESSAGE 0x58                     // Order Cancel Message
#define SEQUENCED_MESSAGE_TYPE_SINGLE_SIDE_REPLACE_MESSAGE_SHORT_FORM 0x75   // Single Side Replace Message Short Form
#define SEQUENCED_MESSAGE_TYPE_SINGLE_SIDE_REPLACE_MESSAGE_LONG_FORM 0x55    // Single Side Replace Message Long Form
#define SEQUENCED_MESSAGE_TYPE_SINGLE_SIDE_DELETE_MESSAGE 0x44               // Single Side Delete Message
#define SEQUENCED_MESSAGE_TYPE_SINGLE_SIDE_CHANGE_MESSAGE 0x47               // Single Side Change Message
#define SEQUENCED_MESSAGE_TYPE_QUOTE_REPLACE_MESSAGE_SHORT_FORM 0x6B         // Quote Replace Message Short Form
#define SEQUENCED_MESSAGE_TYPE_QUOTE_REPLACE_MESSAGE_LONG_FORM 0x4B          // Quote Replace Message Long Form
#define SEQUENCED_MESSAGE_TYPE_QUOTE_DELETE_MESSAGE 0x59                     // Quote Delete Message
#define SEQUENCED_MESSAGE_TYPE_OPTIONS_TRADE_MESSAGES_NON_AUCTION 0x50       // Options Trade Messages Non Auction
#define SEQUENCED_MESSAGE_TYPE_OPTIONS_CROSS_TRADE_MESSAGE 0x51              // Options Cross Trade Message
#define SEQUENCED_MESSAGE_TYPE_BROKEN_TRADE_ORDER_EXECUTED_MESSAGE 0x42      // Broken Trade Order Executed Message
#define SEQUENCED_MESSAGE_TYPE_NOII_MESSAGE 0x49                             // Noii Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F               // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53           // Start Of System Hours
#define EVENT_CODE_START_OF_OPENING_PROCESS 0x51        // Start Of Opening Process
#define EVENT_CODE_END_OF_NORMAL_HOURS_PROCESSING 0x4E  // End Of Normal Hours Processing
#define EVENT_CODE_END_OF_LATE_HOURS_PROCESSING 0x4C    // End Of Late Hours Processing
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45             // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                 // End Of Messages

// Option Type: one byte code
#define OPTION_TYPE_CALL 0x43  // Call
#define OPTION_TYPE_PUT 0x50   // Put

// Options Closing Type: one byte code
#define OPTIONS_CLOSING_TYPE_NORMAL 0x4E  // Normal
#define OPTIONS_CLOSING_TYPE_LATE 0x4C    // Late

// Tradable: one byte code
#define TRADABLE_NOT_TRADABLE 0x4E  // Not Tradable
#define TRADABLE_IS_TRADABLE 0x59   // Is Tradable

// Mpv: one byte code
#define MPV_EVERYWHERE 0x45  // Everywhere
#define MPV_SCALED 0x53      // Scaled
#define MPV_PILOT 0x50       // Pilot

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_HALT 0x48                         // Halt
#define CURRENT_TRADING_STATE_TRADING 0x54                      // Trading
#define CURRENT_TRADING_STATE_BUY_SIDE_TRADING_SUSPENDED 0x42   // Buy Side Trading Suspended
#define CURRENT_TRADING_STATE_SELL_SIDE_TRADING_SUSPENDED 0x53  // Sell Side Trading Suspended

// Open State: one byte code
#define OPEN_STATE_OPEN 0x59    // Open
#define OPEN_STATE_CLOSED 0x4E  // Closed

// Market Side: one byte code
#define MARKET_SIDE_BUY 0x42   // Buy
#define MARKET_SIDE_SELL 0x53  // Sell

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// Change Reason: one byte code
#define CHANGE_REASON_USER 0x55     // User
#define CHANGE_REASON_REPRICE 0x52  // Reprice
#define CHANGE_REASON_SUSPEND 0x53  // Suspend

// Buy Sell Indicator: one byte code
#define BUY_SELL_INDICATOR_BUY 0x42   // Buy
#define BUY_SELL_INDICATOR_SELL 0x53  // Sell

// Cross Type: one byte code
#define CROSS_TYPE_NASDAQ_OPENING_REOPENING 0x4F  // Nasdaq Opening Reopening
#define CROSS_TYPE_PRICE_IMPROVEMENT 0x50         // Price Improvement

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING 0x4F            // Opening
#define AUCTION_TYPE_REOPENING 0x52          // Reopening
#define AUCTION_TYPE_PRICE_IMPROVEMENT 0x50  // Price Improvement
#define AUCTION_TYPE_EXPOSURE 0x49           // Exposure

// Imbalance Direction: one byte code
#define IMBALANCE_DIRECTION_BUY 0x42   // Buy
#define IMBALANCE_DIRECTION_SELL 0x53  // Sell

// Customer Firm Indicator: one byte code
#define CUSTOMER_FIRM_INDICATOR_CUSTOMER 0x43                      // Customer
#define CUSTOMER_FIRM_INDICATOR_FIRM_JOINT 0x46                    // Firm Joint
#define CUSTOMER_FIRM_INDICATOR_ON_FLOOR 0x4D                      // On Floor
#define CUSTOMER_FIRM_INDICATOR_PROFESSIONAL 0x50                  // Professional
#define CUSTOMER_FIRM_INDICATOR_BROKER_DEALER_NON_REGISTERED 0x42  // Broker Dealer Non Registered

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT8 event_code;          // byte 8
} SystemEventMessage;

// At the start of each trading day, NASDAQ disseminates options symbol directory messages for all active options symbols in the NASDAQ option system.
typedef struct _OptionsDirectoryMessage {
  UINT16BE tracking_number;        // bytes 0 to 1
  UINT8 timestamp[6];              // bytes 2 to 7
  UINT32BE option_id;              // bytes 8 to 11
  UINT8 security_symbol[6];        // bytes 12 to 17
  UINT8 expiration_year;           // byte 18
  UINT8 expiration_month;          // byte 19
  UINT8 expiration_date;           // byte 20
  UINT32BE explicit_strike_price;  // bytes 21 to 24, signed, read here as unsigned
  UINT8 option_type;               // byte 25
  UINT8 source;                    // byte 26
  UINT8 underlying_symbol[13];     // bytes 27 to 39
  UINT8 options_closing_type;      // byte 40
  UINT8 tradable;                  // byte 41
  UINT8 mpv;                       // byte 42
} OptionsDirectoryMessage;

// After the start of system hours, NASDAQ will use the Trading Action message to relay changes in trading status for an individual option. Messages will be sent when an option is halted, is released for quotation, released for trading, or temporarily suspended for trading on the buy or sell side.
typedef struct _TradingActionMessage {
  UINT16BE tracking_number;     // bytes 0 to 1
  UINT8 timestamp[6];           // bytes 2 to 7
  UINT32BE option_id;           // bytes 8 to 11
  UINT8 current_trading_state;  // byte 12
} TradingActionMessage;

// NASDAQ plans to disseminate the Option Open Message for each option as soon as the opening is completed. Upon receipt of the open state message, firms should be advised that the option denoted in the message is now available for auto execution within the NASDAQ Options Market System. Upon receipt of the closed state message, firms should be advised that the option is no longer eligible for auto-execution within the NASDAQ Options Market System.
typedef struct _SecurityOpenMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT32BE option_id;        // bytes 8 to 11
  UINT8 open_state;          // byte 12
} SecurityOpenMessage;

// For bandwidth efficiency reasons, this message can be published in either short or long format.
typedef struct _AddOrderMessageShortMessageForm {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT8 timestamp[6];               // bytes 2 to 7
  UINT64BE order_reference_number;  // bytes 8 to 15
  UINT8 market_side;                // byte 16
  UINT32BE option_id;               // bytes 17 to 20
  UINT16BE price_short;             // bytes 21 to 22
  UINT16BE volume_short;            // bytes 23 to 24
} AddOrderMessageShortMessageForm;

// For bandwidth efficiency reasons, this message can be published in either short or long format.
typedef struct _AddOrderMessageLongFormMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT8 timestamp[6];               // bytes 2 to 7
  UINT64BE order_reference_number;  // bytes 8 to 15
  UINT8 market_side;                // byte 16
  UINT32BE option_id;               // bytes 17 to 20
  UINT32BE price_long;              // bytes 21 to 24, signed, read here as unsigned
  UINT32BE volume_long;             // bytes 25 to 28
} AddOrderMessageLongFormMessage;

// For bandwidth efficiency reasons, this message can be published in either short or long format.
typedef struct _AddQuoteMessageShortFormMessage {
  UINT16BE tracking_number;       // bytes 0 to 1
  UINT8 timestamp[6];             // bytes 2 to 7
  UINT64BE bid_reference_number;  // bytes 8 to 15
  UINT64BE ask_reference_number;  // bytes 16 to 23
  UINT32BE option_id;             // bytes 24 to 27
  UINT16BE bid_price_short;       // bytes 28 to 29
  UINT16BE bid_size_short;        // bytes 30 to 31
  UINT16BE ask_price_short;       // bytes 32 to 33
  UINT16BE ask_size_short;        // bytes 34 to 35
} AddQuoteMessageShortFormMessage;

// For bandwidth efficiency reasons, this message can be published in either short or long format.
typedef struct _AddQuoteMessageLongFormMessage {
  UINT16BE tracking_number;       // bytes 0 to 1
  UINT8 timestamp[6];             // bytes 2 to 7
  UINT64BE bid_reference_number;  // bytes 8 to 15
  UINT64BE ask_reference_number;  // bytes 16 to 23
  UINT32BE option_id;             // bytes 24 to 27
  UINT32BE bid;                   // bytes 28 to 31
  UINT32BE bid_size_long;         // bytes 32 to 35
  UINT32BE ask;                   // bytes 36 to 39
  UINT32BE ask_size_long;         // bytes 40 to 43
} AddQuoteMessageLongFormMessage;

// This message is sent whenever a Side order is executed in whole or in part. It is possible to receive several Single Side Executed Messages for the same Side order if that Side order is executed in several parts. The multiple Single Side Executed Messages on the same order are cumulative. By combining the executions received separately via two types of Single Side Executed Messages and Trade Messages, it is possible to build a complete view of all non-auction executions that happen on NASDAQ. Auction execution information is available in one bulk print via the Auction Trade Message.
typedef struct _SingleSideExecutedMessage {
  UINT16BE tracking_number;     // bytes 0 to 1
  UINT8 timestamp[6];           // bytes 2 to 7
  UINT64BE reference_number;    // bytes 8 to 15
  UINT32BE executed_contracts;  // bytes 16 to 19
  UINT32BE cross_number;        // bytes 20 to 23
  UINT32BE match_number;        // bytes 24 to 27
} SingleSideExecutedMessage;

// These executions may be marked as non-printable. If the execution is marked as non-printed, it means that the contracts will be included into a later bulk print (e.g., in the case of auction executions). If a firm is looking to use the ITTO data in time-and-sales displays or volume calculations, NASDAQ recommends that firms ignore messages marked as non-printable to prevent double counting.
typedef struct _SingleSideExecutedWithPriceMessage {
  UINT16BE tracking_number;   // bytes 0 to 1
  UINT8 timestamp[6];         // bytes 2 to 7
  UINT64BE reference_number;  // bytes 8 to 15
  UINT32BE cross_number;      // bytes 16 to 19
  UINT32BE match_number;      // bytes 20 to 23
  UINT8 printable;            // byte 24
  UINT32BE price_long;        // bytes 25 to 28, signed, read here as unsigned
  UINT32BE volume_long;       // bytes 29 to 32
} SingleSideExecutedWithPriceMessage;

// This message is sent whenever an order on the book is modified as a result of a partial cancellation.
typedef struct _OrderCancelMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT8 timestamp[6];               // bytes 2 to 7
  UINT64BE order_reference_number;  // bytes 8 to 15
  UINT32BE cancelled_contracts;     // bytes 16 to 19
} OrderCancelMessage;

// This message is sent whenever an order or one side of a quote on the book is replaced. The replacement has a new sequence number and replaces the prior sequence number.
typedef struct _SingleSideReplaceMessageShortForm {
  UINT16BE tracking_number;            // bytes 0 to 1
  UINT8 timestamp[6];                  // bytes 2 to 7
  UINT64BE original_reference_number;  // bytes 8 to 15
  UINT64BE new_reference_number;       // bytes 16 to 23
  UINT16BE price_short;                // bytes 24 to 25
  UINT16BE volume_short;               // bytes 26 to 27
} SingleSideReplaceMessageShortForm;

// This message is sent whenever an order or one side of a quote on the book is replaced. The replacement has a new sequence number and replaces the prior sequence number.
typedef struct _SingleSideReplaceMessageLongForm {
  UINT16BE tracking_number;            // bytes 0 to 1
  UINT8 timestamp[6];                  // bytes 2 to 7
  UINT64BE original_reference_number;  // bytes 8 to 15
  UINT64BE new_reference_number;       // bytes 16 to 23
  UINT32BE price_long;                 // bytes 24 to 27, signed, read here as unsigned
  UINT32BE volume_long;                // bytes 28 to 31
} SingleSideReplaceMessageLongForm;

// The message is sent when an order or a side of a quote is being cancelled. All remaining contracts are no longer accessible so the side should be removed from the book.
typedef struct _SingleSideDeleteMessage {
  UINT16BE tracking_number;   // bytes 0 to 1
  UINT8 timestamp[6];         // bytes 2 to 7
  UINT64BE reference_number;  // bytes 8 to 15
} SingleSideDeleteMessage;

// This message is sent whenever an order or a side of a quote is being updated for price and (or) contracts. The reference number associated with the order quote is unchanged.
typedef struct _SingleSideChangeMessage {
  UINT16BE tracking_number;   // bytes 0 to 1
  UINT8 timestamp[6];         // bytes 2 to 7
  UINT64BE reference_number;  // bytes 8 to 15
  UINT8 change_reason;        // byte 16
  UINT32BE price_long;        // bytes 17 to 20, signed, read here as unsigned
  UINT32BE volume_long;       // bytes 21 to 24
} SingleSideChangeMessage;

// This message is sent whenever a quote on the book is replaced. The replaced quote has new sequence numbers on both sides. These new sequence numbers replace the prior sequence numbers on the quote.
typedef struct _QuoteReplaceMessageShortForm {
  UINT16BE tracking_number;                // bytes 0 to 1
  UINT8 timestamp[6];                      // bytes 2 to 7
  UINT64BE original_bid_reference_number;  // bytes 8 to 15
  UINT64BE bid_reference_number;           // bytes 16 to 23
  UINT64BE original_ask_reference_number;  // bytes 24 to 31
  UINT64BE ask_reference_number;           // bytes 32 to 39
  UINT16BE bid_price_short;                // bytes 40 to 41
  UINT16BE bid_size_short;                 // bytes 42 to 43
  UINT16BE ask_price_short;                // bytes 44 to 45
  UINT16BE ask_size_short;                 // bytes 46 to 47
} QuoteReplaceMessageShortForm;

// This message is sent whenever a quote on the book is replaced. The replaced quote has new sequence numbers on both sides. These new sequence numbers replace the prior sequence numbers on the quote.
typedef struct _QuoteReplaceMessageLongForm {
  UINT16BE tracking_number;                // bytes 0 to 1
  UINT8 timestamp[6];                      // bytes 2 to 7
  UINT64BE original_bid_reference_number;  // bytes 8 to 15
  UINT64BE bid_reference_number;           // bytes 16 to 23
  UINT64BE original_ask_reference_number;  // bytes 24 to 31
  UINT64BE ask_reference_number;           // bytes 32 to 39
  UINT32BE bid_price_long;                 // bytes 40 to 43, signed, read here as unsigned
  UINT32BE bid_size_long;                  // bytes 44 to 47
  UINT32BE ask_price_long;                 // bytes 48 to 51, signed, read here as unsigned
  UINT32BE ask_size_long;                  // bytes 52 to 55
} QuoteReplaceMessageLongForm;

// The message is sent when a single quote is being cancelled. All remaining contracts are no longer accessible so the quote should be removed from the book.
typedef struct _QuoteDeleteMessage {
  UINT16BE tracking_number;       // bytes 0 to 1
  UINT8 timestamp[6];             // bytes 2 to 7
  UINT64BE bid_reference_number;  // bytes 8 to 15
  UINT64BE ask_reference_number;  // bytes 16 to 23
} QuoteDeleteMessage;

// This Options Trade Message is designed to provide execution details for normal match events involving non-displayable order types. (Note: There is a separate message for NASDAQ Option auction events.)
typedef struct _OptionsTradeMessagesNonAuction {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT8 buy_sell_indicator;  // byte 8
  UINT32BE option_id;        // bytes 9 to 12
  UINT32BE cross_number;     // bytes 13 to 16
  UINT32BE match_number;     // bytes 17 to 20
  UINT32BE price_long;       // bytes 21 to 24, signed, read here as unsigned
  UINT32BE volume_long;      // bytes 25 to 28
} OptionsTradeMessagesNonAuction;

// This message will also be used to report all executions within a price improvement (PRISM) auction.
typedef struct _OptionsCrossTradeMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT32BE option_id;        // bytes 8 to 11
  UINT32BE cross_number;     // bytes 12 to 15
  UINT32BE match_number;     // bytes 16 to 19
  UINT8 cross_type;          // byte 20
  UINT32BE price_long;       // bytes 21 to 24, signed, read here as unsigned
  UINT32BE volume_long;      // bytes 25 to 28
} OptionsCrossTradeMessage;

// The Broken Trade Message is sent whenever an execution on NASDAQ is broken. An execution may be broken if it is found to be clearly erroneous pursuant to NASDAQ s Clearly Erroneous Policy. A trade break is final; once a trade is broken, it cannot be reinstated.
typedef struct _BrokenTradeOrderExecutedMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT32BE cross_number;     // bytes 8 to 11
  UINT32BE match_number;     // bytes 12 to 15
} BrokenTradeOrderExecutedMessage;

// For the NASDAQ Opening Auction, NASDAQ will begin the dissemination of NOII messages for a put or a call option five minutes prior to the start of opening process event and two minutes prior to the halt resumption (reopening) process event.
typedef struct _NoiiMessage {
  UINT16BE tracking_number;       // bytes 0 to 1
  UINT8 timestamp[6];             // bytes 2 to 7
  UINT32BE auction_id;            // bytes 8 to 11
  UINT8 auction_type;             // byte 12
  UINT32BE paired_contracts;      // bytes 13 to 16
  UINT8 imbalance_direction;      // byte 17
  UINT32BE option_id;             // bytes 18 to 21
  UINT32BE imbalance_price;       // bytes 22 to 25, signed, read here as unsigned
  UINT32BE imbalance_volume;      // bytes 26 to 29
  UINT8 customer_firm_indicator;  // byte 30
  UINT8 reserved_3[3];            // bytes 31 to 33
} NoiiMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x52: OptionsDirectoryMessage options_directory_message;
    case 0x48: TradingActionMessage trading_action_message;
    case 0x4F: SecurityOpenMessage security_open_message;
    case 0x61: AddOrderMessageShortMessageForm add_order_message_short_message_form;
    case 0x41: AddOrderMessageLongFormMessage add_order_message_long_form_message;
    case 0x6A: AddQuoteMessageShortFormMessage add_quote_message_short_form_message;
    case 0x4A: AddQuoteMessageLongFormMessage add_quote_message_long_form_message;
    case 0x45: SingleSideExecutedMessage single_side_executed_message;
    case 0x43: SingleSideExecutedWithPriceMessage single_side_executed_with_price_message;
    case 0x58: OrderCancelMessage order_cancel_message;
    case 0x75: SingleSideReplaceMessageShortForm single_side_replace_message_short_form;
    case 0x55: SingleSideReplaceMessageLongForm single_side_replace_message_long_form;
    case 0x44: SingleSideDeleteMessage single_side_delete_message;
    case 0x47: SingleSideChangeMessage single_side_change_message;
    case 0x6B: QuoteReplaceMessageShortForm quote_replace_message_short_form;
    case 0x4B: QuoteReplaceMessageLongForm quote_replace_message_long_form;
    case 0x59: QuoteDeleteMessage quote_delete_message;
    case 0x50: OptionsTradeMessagesNonAuction options_trade_messages_non_auction;
    case 0x51: OptionsCrossTradeMessage options_cross_trade_message;
    case 0x42: BrokenTradeOrderExecutedMessage broken_trade_order_executed_message;
    case 0x49: NoiiMessage noii_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat_packet;
    case 0x5A: unit end_of_session_packet;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

