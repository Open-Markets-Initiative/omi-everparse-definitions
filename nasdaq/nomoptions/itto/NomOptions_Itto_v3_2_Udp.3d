// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NomOptions_Itto_v3_2_Udp.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SECONDS_MESSAGE 0x54                          // Seconds Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                     // System Event Message
#define MESSAGE_TYPE_BASE_REFERENCE_MESSAGE 0x4C                   // Base Reference Message
#define MESSAGE_TYPE_OPTIONS_DIRECTORY_MESSAGE 0x52                // Options Directory Message
#define MESSAGE_TYPE_OPTIONS_TRADING_ACTION_MESSAGE 0x48           // Options Trading Action Message
#define MESSAGE_TYPE_OPTION_OPEN_MESSAGE 0x4F                      // Option Open Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE_SHORT_FORM 0x61             // Add Order Message Short Form
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE_LONG_FORM 0x41              // Add Order Message Long Form
#define MESSAGE_TYPE_ADD_QUOTE_MESSAGE_SHORT_FORM 0x6A             // Add Quote Message Short Form
#define MESSAGE_TYPE_ADD_QUOTE_MESSAGE_LONG_FORM 0x4A              // Add Quote Message Long Form
#define MESSAGE_TYPE_SINGLE_SIDE_EXECUTED_MESSAGE 0x45             // Single Side Executed Message
#define MESSAGE_TYPE_SINGLE_SIDE_EXECUTED_WITH_PRICE_MESSAGE 0x43  // Single Side Executed With Price Message
#define MESSAGE_TYPE_ORDER_CANCEL_MESSAGE 0x58                     // Order Cancel Message
#define MESSAGE_TYPE_SINGLE_SIDE_REPLACE_MESSAGE_SHORT_FORM 0x75   // Single Side Replace Message Short Form
#define MESSAGE_TYPE_SINGLE_SIDE_REPLACE_MESSAGE_LONG_FORM 0x55    // Single Side Replace Message Long Form
#define MESSAGE_TYPE_SINGLE_SIDE_DELETE_MESSAGE 0x44               // Single Side Delete Message
#define MESSAGE_TYPE_SINGLE_SIDE_UPDATE_MESSAGE 0x47               // Single Side Update Message
#define MESSAGE_TYPE_QUOTE_REPLACE_MESSAGE_SHORT_FORM 0x6B         // Quote Replace Message Short Form
#define MESSAGE_TYPE_QUOTE_REPLACE_MESSAGE_LONG_FORM 0x4B          // Quote Replace Message Long Form
#define MESSAGE_TYPE_QUOTE_DELETE_MESSAGE 0x59                     // Quote Delete Message
#define MESSAGE_TYPE_BLOCK_SINGLE_SIDE_DELETE_MESSAGE 0x5A         // Block Single Side Delete Message
#define MESSAGE_TYPE_OPTIONS_TRADE_NON_AUCTION_MESSAGE 0x50        // Options Trade Non Auction Message
#define MESSAGE_TYPE_OPTIONS_CROSS_TRADE_MESSAGE 0x51              // Options Cross Trade Message
#define MESSAGE_TYPE_BROKEN_TRADE_OR_ORDER_EXECUTION_MESSAGE 0x42  // Broken Trade Or Order Execution Message
#define MESSAGE_TYPE_NET_ORDER_IMBALANCE_INDICATOR_MESSAGE 0x49    // Net Order Imbalance Indicator Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F               // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53           // Start Of System Hours
#define EVENT_CODE_START_OF_OPENING_PROCESS 0x51        // Start Of Opening Process
#define EVENT_CODE_END_OF_NORMAL_HOURS_PROCESSING 0x4E  // End Of Normal Hours Processing
#define EVENT_CODE_END_OF_LATE_HOURS_PROCESSING 0x4C    // End Of Late Hours Processing
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45             // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                 // End Of Messages

// Option Type: one byte code
#define OPTION_TYPE_CALL_OPTION 0x43  // Call Option
#define OPTION_TYPE_PUT_OPTION 0x50   // Put Option

// Options Closing Type: one byte code
#define OPTIONS_CLOSING_TYPE_NORMAL_HOURS 0x4E  // Normal Hours
#define OPTIONS_CLOSING_TYPE_LATE_HOURS 0x4C    // Late Hours

// Tradable: one byte code
#define TRADABLE_OPTION_IS_TRADABLE 0x59      // Option Is Tradable
#define TRADABLE_OPTION_IS_NOT_TRADABLE 0x4E  // Option Is Not Tradable

// Mpv: one byte code
#define MPV_PENNY_EVERYWHERE 0x45  // Penny Everywhere
#define MPV_SCALED 0x53            // Scaled
#define MPV_PENNY_PILOT 0x50       // Penny Pilot

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_HALT_IN_EFFECT 0x48               // Halt In Effect
#define CURRENT_TRADING_STATE_TRADING_ON_NASDAQ 0x54            // Trading On Nasdaq
#define CURRENT_TRADING_STATE_BUY_SIDE_TRADING_SUSPENDED 0x42   // Buy Side Trading Suspended
#define CURRENT_TRADING_STATE_SELL_SIDE_TRADING_SUSPENDED 0x53  // Sell Side Trading Suspended

// Open State: one byte code
#define OPEN_STATE_OPEN_FOR_AUTO_EXECUTION 0x59    // Open For Auto Execution
#define OPEN_STATE_CLOSED_FOR_AUTO_EXECUTION 0x4E  // Closed For Auto Execution

// Market Side: one byte code
#define MARKET_SIDE_BUY 0x42   // Buy
#define MARKET_SIDE_SELL 0x53  // Sell

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// Change Reason: one byte code
#define CHANGE_REASON_USER 0x55     // User
#define CHANGE_REASON_REPRICE 0x52  // Reprice
#define CHANGE_REASON_SUSPEND 0x53  // Suspend

// Buy Sell Indicator: one byte code
#define BUY_SELL_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define BUY_SELL_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Cross Type: one byte code
#define CROSS_TYPE_NASDAQ_OPENING_REOPENING_AUCTION 0x4F  // Nasdaq Opening Reopening Auction
#define CROSS_TYPE_PRICE_IMPROVEMENT_AUCTION 0x50         // Price Improvement Auction

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING 0x4F                    // Opening
#define AUCTION_TYPE_REOPENING 0x52                  // Reopening
#define AUCTION_TYPE_PRICE_IMPROVEMENT_AUCTION 0x50  // Price Improvement Auction
#define AUCTION_TYPE_ORDER_EXPOSURE 0x49             // Order Exposure

// Imbalance Direction: one byte code
#define IMBALANCE_DIRECTION_BUY_IMBALANCE 0x42   // Buy Imbalance
#define IMBALANCE_DIRECTION_SELL_IMBALANCE 0x53  // Sell Imbalance

// Customer Firm Indicator: one byte code
#define CUSTOMER_FIRM_INDICATOR_CUSTOMER 0x43                // Customer
#define CUSTOMER_FIRM_INDICATOR_FIRM_JOINT_BACK_OFFICE 0x46  // Firm Joint Back Office
#define CUSTOMER_FIRM_INDICATOR_ON_FLOOR_MARKET_MAKER 0x4D   // On Floor Market Maker
#define CUSTOMER_FIRM_INDICATOR_PROFESSIONAL_CUSTOMER 0x50   // Professional Customer
#define CUSTOMER_FIRM_INDICATOR_BROKER_DEALER 0x42           // Broker Dealer

// ---- Types -------------------------------------------------------------------

// Sent every second for which at least one ITTO message is being generated. For bandwidth efficiency the timestamp is separated into this standalone Seconds message and a Nanoseconds portion carried by every other message.
typedef struct _SecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} SecondsMessage;

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT8 event_code;      // byte 4
} SystemEventMessage;

// Indicates the base reference number to which all the order, quote and trade reference number deltas must be added to obtain the absolute order or quote Nasdaq reference number. Sent prior to any order, quote and trade messages.
typedef struct _BaseReferenceMessage {
  UINT32BE nanoseconds;            // bytes 0 to 3
  UINT64BE base_reference_number;  // bytes 4 to 11
} BaseReferenceMessage;

// At the start of each trading day, Nasdaq disseminates options symbol directory messages for all active options symbols in the Nasdaq option system. Intra-day updates are sent as they occur; for a given Option Id the canonical information is invariant.
typedef struct _OptionsDirectoryMessage {
  UINT32BE nanoseconds;            // bytes 0 to 3
  UINT32BE option_id;              // bytes 4 to 7
  UINT8 security_symbol[6];        // bytes 8 to 13
  UINT8 expiration_year;           // byte 14
  UINT8 expiration_month;          // byte 15
  UINT8 expiration_date;           // byte 16
  UINT32BE explicit_strike_price;  // bytes 17 to 20
  UINT8 option_type;               // byte 21
  UINT8 source;                    // byte 22
  UINT8 underlying_symbol[13];     // bytes 23 to 35
  UINT8 options_closing_type;      // byte 36
  UINT8 tradable;                  // byte 37
  UINT8 mpv;                       // byte 38
} OptionsDirectoryMessage;

// Nasdaq uses this administrative message to indicate the current trading status of an index or equity option within the Nasdaq Options Market. Prior to the start of system hours Nasdaq sends a Trading Action spin carrying T (Trading Resumption) for every contract eligible for trading; an option absent from the spin should be treated as halted.
typedef struct _OptionsTradingActionMessage {
  UINT32BE nanoseconds;         // bytes 0 to 3
  UINT32BE option_id;           // bytes 4 to 7
  UINT8 current_trading_state;  // byte 8
} OptionsTradingActionMessage;

// Disseminated for each option as soon as the opening is completed. On the open state the option is available for auto execution within the Nasdaq Options Market System; on the closed state it is no longer eligible. Recipients should continue to process the Trading Action spin, which this message does not override.
typedef struct _OptionOpenMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT32BE option_id;    // bytes 4 to 7
  UINT8 open_state;      // byte 8
} OptionOpenMessage;

// Indicates that a new order has been accepted by the Nasdaq Option system and was added to the displayable book, carrying a day unique Order Reference Number. The short form of the message, published for bandwidth efficiency.
typedef struct _AddOrderMessageShortForm {
  UINT32BE nanoseconds;                   // bytes 0 to 3
  UINT32BE order_reference_number_delta;  // bytes 4 to 7
  UINT8 market_side;                      // byte 8
  UINT32BE option_id;                     // bytes 9 to 12
  UINT16BE price;                         // bytes 13 to 14
  UINT16BE volume;                        // bytes 15 to 16
} AddOrderMessageShortForm;

// Indicates that a new order has been accepted by the Nasdaq Option system and was added to the displayable book, carrying a day unique Order Reference Number. The long form of the message, with four byte price and volume.
typedef struct _AddOrderMessageLongForm {
  UINT32BE nanoseconds;                   // bytes 0 to 3
  UINT32BE order_reference_number_delta;  // bytes 4 to 7
  UINT8 market_side;                      // byte 8
  UINT32BE option_id;                     // bytes 9 to 12
  UINT32BE price_long;                    // bytes 13 to 16
  UINT32BE volume_long;                   // bytes 17 to 20
} AddOrderMessageLongForm;

// Indicates that a new quote has been accepted by the Nasdaq Option system and was added to the displayable book, carrying unique Bid and Ask Reference Numbers. The short form of the message, published for bandwidth efficiency.
typedef struct _AddQuoteMessageShortForm {
  UINT32BE nanoseconds;                 // bytes 0 to 3
  UINT32BE bid_reference_number_delta;  // bytes 4 to 7
  UINT32BE ask_reference_number_delta;  // bytes 8 to 11
  UINT32BE option_id;                   // bytes 12 to 15
  UINT16BE bid_price;                   // bytes 16 to 17
  UINT16BE bid_size;                    // bytes 18 to 19
  UINT16BE ask_price;                   // bytes 20 to 21
  UINT16BE ask_size;                    // bytes 22 to 23
} AddQuoteMessageShortForm;

// Indicates that a new quote has been accepted by the Nasdaq Option system and was added to the displayable book, carrying unique Bid and Ask Reference Numbers. The long form of the message, with four byte prices and sizes.
typedef struct _AddQuoteMessageLongForm {
  UINT32BE nanoseconds;                 // bytes 0 to 3
  UINT32BE bid_reference_number_delta;  // bytes 4 to 7
  UINT32BE ask_reference_number_delta;  // bytes 8 to 11
  UINT32BE option_id;                   // bytes 12 to 15
  UINT32BE bid;                         // bytes 16 to 19
  UINT32BE bid_size_long;               // bytes 20 to 23
  UINT32BE ask;                         // bytes 24 to 27
  UINT32BE ask_size_long;               // bytes 28 to 31
} AddQuoteMessageLongForm;

// Sent whenever a Side order, an order or one side of a quote, is executed in whole or in part. Several of these messages may be received for the same Side order when it is executed in several parts, and they are cumulative.
typedef struct _SingleSideExecutedMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT32BE reference_number_delta;  // bytes 4 to 7
  UINT32BE executed_contracts;      // bytes 8 to 11
  UINT32BE cross_number;            // bytes 12 to 15
  UINT32BE match_number;            // bytes 16 to 19
} SingleSideExecutedMessage;

// Sent whenever an incoming Side order is executed against the book in whole or in part at a price different from the initial display price, so the execution price is carried in the message.
typedef struct _SingleSideExecutedWithPriceMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT32BE reference_number_delta;  // bytes 4 to 7
  UINT32BE cross_number;            // bytes 8 to 11
  UINT32BE match_number;            // bytes 12 to 15
  UINT8 printable;                  // byte 16
  UINT32BE price_long;              // bytes 17 to 20
  UINT32BE volume_long;             // bytes 21 to 24
} SingleSideExecutedWithPriceMessage;

// Sent whenever an order on the book is modified as a result of a partial cancellation.
typedef struct _OrderCancelMessage {
  UINT32BE nanoseconds;                   // bytes 0 to 3
  UINT32BE order_reference_number_delta;  // bytes 4 to 7
  UINT32BE cancelled_contracts;           // bytes 8 to 11
} OrderCancelMessage;

// Sent whenever an order or one side of a quote on the book is replaced. The replacement has a new sequence number and replaces the prior sequence number. The short form of the message, published for bandwidth efficiency.
typedef struct _SingleSideReplaceMessageShortForm {
  UINT32BE nanoseconds;                      // bytes 0 to 3
  UINT32BE original_reference_number_delta;  // bytes 4 to 7
  UINT32BE new_reference_number_delta;       // bytes 8 to 11
  UINT16BE price;                            // bytes 12 to 13
  UINT16BE volume;                           // bytes 14 to 15
} SingleSideReplaceMessageShortForm;

// Sent whenever an order or one side of a quote on the book is replaced. The replacement has a new sequence number and replaces the prior sequence number. The long form of the message, with four byte price and volume.
typedef struct _SingleSideReplaceMessageLongForm {
  UINT32BE nanoseconds;                      // bytes 0 to 3
  UINT32BE original_reference_number_delta;  // bytes 4 to 7
  UINT32BE new_reference_number_delta;       // bytes 8 to 11
  UINT32BE price_long;                       // bytes 12 to 15
  UINT32BE volume_long;                      // bytes 16 to 19
} SingleSideReplaceMessageLongForm;

// Sent when an order or a side of a quote is being cancelled. All remaining contracts are no longer accessible so the side should be removed from the book.
typedef struct _SingleSideDeleteMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT32BE reference_number_delta;  // bytes 4 to 7
} SingleSideDeleteMessage;

// Sent whenever an order or a side of a quote is being updated for price and or contracts. The reference number associated with the order or quote is unchanged and it retains its priority on the book.
typedef struct _SingleSideUpdateMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT32BE reference_number_delta;  // bytes 4 to 7
  UINT8 change_reason;              // byte 8
  UINT32BE price_long;              // bytes 9 to 12
  UINT32BE volume_long;             // bytes 13 to 16
} SingleSideUpdateMessage;

// Sent whenever a quote on the book is replaced. The replaced quote has new sequence numbers on both sides, replacing the prior sequence numbers. The short form of the message, published for bandwidth efficiency.
typedef struct _QuoteReplaceMessageShortForm {
  UINT32BE nanoseconds;                          // bytes 0 to 3
  UINT32BE original_bid_reference_number_delta;  // bytes 4 to 7
  UINT32BE bid_reference_number_delta;           // bytes 8 to 11
  UINT32BE original_ask_reference_number_delta;  // bytes 12 to 15
  UINT32BE ask_reference_delta_number;           // bytes 16 to 19
  UINT16BE bid_price;                            // bytes 20 to 21
  UINT16BE bid_size;                             // bytes 22 to 23
  UINT16BE ask_price;                            // bytes 24 to 25
  UINT16BE ask_size;                             // bytes 26 to 27
} QuoteReplaceMessageShortForm;

// Sent whenever a quote on the book is replaced. The replaced quote has new sequence numbers on both sides, replacing the prior sequence numbers. The long form of the message, with four byte prices and sizes.
typedef struct _QuoteReplaceMessageLongForm {
  UINT32BE nanoseconds;                          // bytes 0 to 3
  UINT32BE original_bid_reference_number_delta;  // bytes 4 to 7
  UINT32BE bid_reference_number_delta;           // bytes 8 to 11
  UINT32BE original_ask_reference_number_delta;  // bytes 12 to 15
  UINT32BE ask_reference_delta_number;           // bytes 16 to 19
  UINT32BE bid_price_long;                       // bytes 20 to 23
  UINT32BE bid_size_long;                        // bytes 24 to 27
  UINT32BE ask_price_long;                       // bytes 28 to 31
  UINT32BE ask_size_long;                        // bytes 32 to 35
} QuoteReplaceMessageLongForm;

// Sent when a single quote is being cancelled. All remaining contracts are no longer accessible so the quote should be removed from the book.
typedef struct _QuoteDeleteMessage {
  UINT32BE nanoseconds;                 // bytes 0 to 3
  UINT32BE bid_reference_number_delta;  // bytes 4 to 7
  UINT32BE ask_reference_number_delta;  // bytes 8 to 11
} QuoteDeleteMessage;

// The block of single side deletes, one four byte reference number delta per entry at offset 4n + 7, repeated Total Number of Reference Number Deltas times.
typedef struct _ReferenceNumberDeltas {
  UINT32BE reference_number_delta;  // bytes 0 to 3
} ReferenceNumberDeltas;

// Contains a block of Single Side Deletes. Each reference number inside the block represents an order or a side of a quote that is being cancelled; all remaining contracts are no longer accessible so the side should be removed from the book.
typedef struct _BlockSingleSideDeleteMessage {
  UINT32BE nanoseconds;                                                                                                // bytes 0 to 3
  UINT16BE total_number_of_reference_number_deltas;                                                                    // bytes 4 to 5
  ReferenceNumberDeltas reference_number_deltas[:byte-size (((UINT32) total_number_of_reference_number_deltas) * 4)];
} BlockSingleSideDeleteMessage;

// Provides execution details for normal match events involving non displayable order types, for which no Add Order or Add Quote message is generated. Auction events are reported separately by the Options Cross Trade message.
typedef struct _OptionsTradeNonAuctionMessage {
  UINT32BE nanoseconds;      // bytes 0 to 3
  UINT8 buy_sell_indicator;  // byte 4
  UINT32BE option_id;        // bytes 5 to 8
  UINT32BE cross_number;     // bytes 9 to 12
  UINT32BE match_number;     // bytes 13 to 16
  UINT32BE price_long;       // bytes 17 to 20
  UINT32BE volume_long;      // bytes 21 to 24
} OptionsTradeNonAuctionMessage;

// Sent for every option when an auction in that option is completed, indicating the bulk volume associated with the auction event. Also used to report all executions within a price improvement (PRISM) auction. To avoid double counting of auction volume, firms should not include transactions marked as auction trades.
typedef struct _OptionsCrossTradeMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT32BE option_id;     // bytes 4 to 7
  UINT32BE cross_number;  // bytes 8 to 11
  UINT32BE match_number;  // bytes 12 to 15
  UINT8 cross_type;       // byte 16
  UINT32BE price_long;    // bytes 17 to 20
  UINT32BE volume_long;   // bytes 21 to 24
} OptionsCrossTradeMessage;

// Sent whenever an execution on Nasdaq is broken, which may happen if it is found to be clearly erroneous pursuant to the Nasdaq Clearly Erroneous Policy. A trade break is final; once a trade is broken it cannot be reinstated.
typedef struct _BrokenTradeOrOrderExecutionMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT32BE cross_number;  // bytes 4 to 7
  UINT32BE match_number;  // bytes 8 to 11
} BrokenTradeOrOrderExecutionMessage;

// Nasdaq disseminates Net Order Imbalance Indicator data at five second intervals in the minutes leading up to the Nasdaq Opening Auction events, and for price improvement (PRISM) auctions.
typedef struct _NetOrderImbalanceIndicatorMessage {
  UINT32BE nanoseconds;           // bytes 0 to 3
  UINT32BE auction_id;            // bytes 4 to 7
  UINT8 auction_type;             // byte 8
  UINT32BE paired_contracts;      // bytes 9 to 12
  UINT8 imbalance_direction;      // byte 13
  UINT32BE option_id;             // bytes 14 to 17
  UINT32BE imbalance_price;       // bytes 18 to 21
  UINT32BE imbalance_volume;      // bytes 22 to 25
  UINT8 customer_firm_indicator;  // byte 26
  UINT8 reserved_3[3];            // bytes 27 to 29
} NetOrderImbalanceIndicatorMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: SecondsMessage seconds_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x4C: BaseReferenceMessage base_reference_message;
    case 0x52: OptionsDirectoryMessage options_directory_message;
    case 0x48: OptionsTradingActionMessage options_trading_action_message;
    case 0x4F: OptionOpenMessage option_open_message;
    case 0x61: AddOrderMessageShortForm add_order_message_short_form;
    case 0x41: AddOrderMessageLongForm add_order_message_long_form;
    case 0x6A: AddQuoteMessageShortForm add_quote_message_short_form;
    case 0x4A: AddQuoteMessageLongForm add_quote_message_long_form;
    case 0x45: SingleSideExecutedMessage single_side_executed_message;
    case 0x43: SingleSideExecutedWithPriceMessage single_side_executed_with_price_message;
    case 0x58: OrderCancelMessage order_cancel_message;
    case 0x75: SingleSideReplaceMessageShortForm single_side_replace_message_short_form;
    case 0x55: SingleSideReplaceMessageLongForm single_side_replace_message_long_form;
    case 0x44: SingleSideDeleteMessage single_side_delete_message;
    case 0x47: SingleSideUpdateMessage single_side_update_message;
    case 0x6B: QuoteReplaceMessageShortForm quote_replace_message_short_form;
    case 0x4B: QuoteReplaceMessageLongForm quote_replace_message_long_form;
    case 0x59: QuoteDeleteMessage quote_delete_message;
    case 0x5A: BlockSingleSideDeleteMessage block_single_side_delete_message;
    case 0x50: OptionsTradeNonAuctionMessage options_trade_non_auction_message;
    case 0x51: OptionsCrossTradeMessage options_cross_trade_message;
    case 0x42: BrokenTradeOrOrderExecutionMessage broken_trade_or_order_execution_message;
    case 0x49: NetOrderImbalanceIndicatorMessage net_order_imbalance_indicator_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

