// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NomOptions_Quoting_v9_0_Client.3d

// ---- Values ------------------------------------------------------------------

// Client Packet Type: one byte code
#define CLIENT_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define CLIENT_PACKET_TYPE_LOGIN_REQUEST_PACKET 0x4C     // Login Request Packet
#define CLIENT_PACKET_TYPE_UNSEQUENCED_DATA_PACKET 0x55  // Unsequenced Data Packet
#define CLIENT_PACKET_TYPE_CLIENT_HEARTBEAT_PACKET 0x52  // Client Heartbeat Packet
#define CLIENT_PACKET_TYPE_LOGOUT_REQUEST_PACKET 0x4F    // Logout Request Packet

// Unsequenced Message Type: 2 byte code
#define UNSEQUENCED_MESSAGE_TYPE_NOTIFICATION_SUBSCRIPTION_REQUEST_MESSAGE 0x4142             // Notification Subscription Request Message
#define UNSEQUENCED_MESSAGE_TYPE_ADD_COMPLEX_INSTRUMENT_REQUEST_MESSAGE 0x4143                // Add Complex Instrument Request Message
#define UNSEQUENCED_MESSAGE_TYPE_MM_PARAMETER_DEFINITION_REQUEST_MESSAGE 0x4145               // Mm Parameter Definition Request Message
#define UNSEQUENCED_MESSAGE_TYPE_ACTIVE_QP_SELF_REPLENISHMENT_SET_LIMIT_MESSAGE 0x4147        // Active Qp Self Replenishment Set Limit Message
#define UNSEQUENCED_MESSAGE_TYPE_RAPID_FIRE_CONFIG_REQUEST_MESSAGE 0x4146                     // Rapid Fire Config Request Message
#define UNSEQUENCED_MESSAGE_TYPE_SIMPLE_QUOTE_BLOCK_SHORT_FORM_MESSAGE 0x5141                 // Simple Quote Block Short Form Message
#define UNSEQUENCED_MESSAGE_TYPE_SIMPLE_QUOTE_BLOCK_SHORT_FORM_DETAILED_MESSAGE 0x5161        // Simple Quote Block Short Form Detailed Message
#define UNSEQUENCED_MESSAGE_TYPE_SIMPLE_QUOTE_BLOCK_LONG_FORM_MESSAGE 0x514D                  // Simple Quote Block Long Form Message
#define UNSEQUENCED_MESSAGE_TYPE_SIMPLE_QUOTE_BLOCK_LONG_FORM_DETAILED_MESSAGE 0x516D         // Simple Quote Block Long Form Detailed Message
#define UNSEQUENCED_MESSAGE_TYPE_COMPLEX_QUOTE_BLOCK_MESSAGE 0x5144                           // Complex Quote Block Message
#define UNSEQUENCED_MESSAGE_TYPE_COMPLEX_QUOTE_BLOCK_DETAILED_MESSAGE 0x5164                  // Complex Quote Block Detailed Message
#define UNSEQUENCED_MESSAGE_TYPE_UNDERLYING_PURGE_REQUEST_MESSAGE 0x5075                      // Underlying Purge Request Message
#define UNSEQUENCED_MESSAGE_TYPE_MARKET_REENTRY_REQUEST_MESSAGE 0x5255                        // Market Reentry Request Message
#define UNSEQUENCED_MESSAGE_TYPE_ACTIVE_QP_SELF_REPLENISHMENT_REQUEST_REENTRY_MESSAGE 0x5247  // Active Qp Self Replenishment Request Reentry Message
#define UNSEQUENCED_MESSAGE_TYPE_SIMPLE_MSAR_REQUEST_MESSAGE 0x5342                           // Simple Msar Request Message
#define UNSEQUENCED_MESSAGE_TYPE_COMPLEX_MSAR_REQUEST_MESSAGE 0x5358                          // Complex Msar Request Message

// Leg Side: one byte code
#define LEG_SIDE_BUY 0x42   // Buy
#define LEG_SIDE_SELL 0x53  // Sell

// Instrument Type: one byte code
#define INSTRUMENT_TYPE_SIMPLE_INSTRUMENTS 0x53   // Simple Instruments
#define INSTRUMENT_TYPE_COMPLEX_INSTRUMENTS 0x43  // Complex Instruments
#define INSTRUMENT_TYPE_SIMPLE_INSTRUMENT 0x4F    // Simple Instrument

// Reentry Indicator: one byte code
#define REENTRY_INDICATOR_NORMAL 0x4E   // Normal
#define REENTRY_INDICATOR_REENTRY 0x52  // Reentry

// Stock Leg Short Sale: one byte code
#define STOCK_LEG_SHORT_SALE_NOT_APPLICABLE 0x4E     // Not Applicable
#define STOCK_LEG_SHORT_SALE_SELL_SHORT 0x48         // Sell Short
#define STOCK_LEG_SHORT_SALE_SELL_SHORT_EXEMPT 0x45  // Sell Short Exempt

// Msar Type: one byte code
#define MSAR_TYPE_AUCTION_RESPONSE 0x41  // Auction Response
#define MSAR_TYPE_MARKET_SWEEP 0x4D      // Market Sweep

// Side: one byte code
#define SIDE_BUY 0x42                // Buy
#define SIDE_SELL 0x53               // Sell
#define SIDE_NOT_DISCLOSED 0x2A      // Not Disclosed
#define SIDE_BUY_SHORT 0x54          // Buy Short
#define SIDE_BUY_SHORT_EXEMPT 0x58   // Buy Short Exempt
#define SIDE_SELL_SHORT 0x59         // Sell Short
#define SIDE_SELL_SHORT_EXEMPT 0x5A  // Sell Short Exempt

// Debit Credit: one byte code
#define DEBIT_CREDIT_DEBIT 0x44   // Debit
#define DEBIT_CREDIT_CREDIT 0x43  // Credit
#define DEBIT_CREDIT_ZERO 0x20    // Zero

// Price Protection: one byte code
#define PRICE_PROTECTION_LOCAL 0x4C     // Local
#define PRICE_PROTECTION_NATIONAL 0x4E  // National

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP client must send a Login Request Packet immediately upon establishing a new TCP/IP socket connection to the server
typedef struct _LoginRequestPacket {
  UINT8 username[6];                    // bytes 0 to 5
  UINT8 password[10];                   // bytes 6 to 15
  UINT8 requested_session[10];          // bytes 16 to 25
  UINT8 requested_sequence_number[20];  // bytes 26 to 45
  UINT8 heartbeat_timeout[5];           // bytes 46 to 50
} LoginRequestPacket;

// Modifies the set of optional notification types delivered on the current session.
typedef struct _NotificationSubscriptionRequestMessage {
  UINT8 badge[4];          // bytes 0 to 3
  UINT64BE message_id;     // bytes 4 to 11
  UINT8 subscription[24];  // bytes 12 to 35
} NotificationSubscriptionRequestMessage;

// Leg Definitions, Repeated Number Of Legs times
typedef struct _ComplexLegs {
  UINT32BE leg_instrument_id;  // bytes 0 to 3
  UINT8 leg_side;              // byte 4
  UINT32BE leg_ratio;          // bytes 5 to 8
} ComplexLegs;

// Defines a new complex instrument. A valid request results in an Add Complex Instrument Reply with Status Code space and a Complex Instrument Directory message.
typedef struct _AddComplexInstrumentRequestMessage {
  UINT8 badge[4];                                                        // bytes 0 to 3
  UINT64BE message_id;                                                   // bytes 4 to 11
  UINT8 underlying_symbol[13];                                           // bytes 12 to 24
  UINT8 number_of_legs;                                                  // byte 25
  ComplexLegs complex_legs[:byte-size (((UINT32) number_of_legs) * 9)];
} AddComplexInstrumentRequestMessage;

// Sets the Rapid Fire/Curtailment parameters (CumQty, Percentage, Delta, Vega and Interval) per underlying and instrument type. Rejected if the badge is configured for ActiveQP.
typedef struct _MmParameterDefinitionRequestMessage {
  UINT8 badge[4];         // bytes 0 to 3
  UINT64BE message_id;    // bytes 4 to 11
  UINT8 instrument_type;  // byte 12
  UINT8 underlying[13];   // bytes 13 to 25
  UINT16BE interval;      // bytes 26 to 27
  UINT16BE percentage;    // bytes 28 to 29
  UINT32BE cum_qty;       // bytes 30 to 33
  UINT32BE delta;         // bytes 34 to 37
  UINT32BE vega;          // bytes 38 to 41
  UINT8 reserved_32[32];  // bytes 42 to 73
} MmParameterDefinitionRequestMessage;

// ActiveQP/Self-Replenishment Set Limit Message: sets the contract limit for self-replenishment purge.
typedef struct _ActiveQpSelfReplenishmentSetLimitMessage {
  UINT8 badge[4];               // bytes 0 to 3
  UINT64BE message_id;          // bytes 4 to 11
  UINT8 underlying_symbol[13];  // bytes 12 to 24
  UINT32BE set_value;           // bytes 25 to 28
} ActiveQpSelfReplenishmentSetLimitMessage;

// Rapid Fire/Curtailment Config Request. Supported on Phlx, NOM and NTX; replaced by the MM Parameter Definition messages.
typedef struct _RapidFireConfigRequestMessage {
  UINT8 badge[4];               // bytes 0 to 3
  UINT8 underlying_symbol[13];  // bytes 4 to 16
  UINT16BE percentage;          // bytes 17 to 18
  UINT16BE interval;            // bytes 19 to 20
  UINT32BE cum_qty;             // bytes 21 to 24
} RapidFireConfigRequestMessage;

// Quotes of a Simple Quote Block (short form)
typedef struct _SimpleQuotes {
  UINT32BE instrument_id;   // bytes 0 to 3
  UINT32BE bid_price;       // bytes 4 to 7, signed, read here as unsigned
  UINT32BE bid_size;        // bytes 8 to 11
  UINT32BE ask_price;       // bytes 12 to 15, signed, read here as unsigned
  UINT32BE ask_size;        // bytes 16 to 19
  UINT8 reentry_indicator;  // byte 20
} SimpleQuotes;

// Simple Quote Block (short form) including SentTimestamp, results in a regular Quote Block Reply (QS). Up to 200 quotes for simple instruments; the MessageID identifies the whole block.
typedef struct _SimpleQuoteBlockShortFormMessage {
  UINT8 badge[4];                                                        // bytes 0 to 3
  UINT64BE message_id;                                                   // bytes 4 to 11
  UINT64BE sent_timestamp;                                               // bytes 12 to 19
  UINT16BE quote_count;                                                  // bytes 20 to 21
  SimpleQuotes simple_quotes[:byte-size (((UINT32) quote_count) * 21)];
} SimpleQuoteBlockShortFormMessage;

// Simple Quote Block (short form) including SentTimestamp, results in a Detailed Quote Block Reply (Qs).
typedef struct _SimpleQuoteBlockShortFormDetailedMessage {
  UINT8 badge[4];                                                        // bytes 0 to 3
  UINT64BE message_id;                                                   // bytes 4 to 11
  UINT64BE sent_timestamp;                                               // bytes 12 to 19
  UINT16BE quote_count;                                                  // bytes 20 to 21
  SimpleQuotes simple_quotes[:byte-size (((UINT32) quote_count) * 21)];
} SimpleQuoteBlockShortFormDetailedMessage;

// Quotes of a Simple Quote Block (long form)
typedef struct _SimpleQuotesLongForm {
  UINT64BE quote_id;        // bytes 0 to 7
  UINT32BE instrument_id;   // bytes 8 to 11
  UINT32BE bid_price;       // bytes 12 to 15, signed, read here as unsigned
  UINT32BE bid_size;        // bytes 16 to 19
  UINT32BE ask_price;       // bytes 20 to 23, signed, read here as unsigned
  UINT32BE ask_size;        // bytes 24 to 27
  UINT8 reentry_indicator;  // byte 28
} SimpleQuotesLongForm;

// Simple Quote Block (long form) including SentTimestamp, results in a regular Quote Block Reply (QS). Adds a per quote QuoteID.
typedef struct _SimpleQuoteBlockLongFormMessage {
  UINT8 badge[4];                                                                          // bytes 0 to 3
  UINT64BE message_id;                                                                     // bytes 4 to 11
  UINT64BE sent_timestamp;                                                                 // bytes 12 to 19
  UINT16BE quote_count;                                                                    // bytes 20 to 21
  SimpleQuotesLongForm simple_quotes_long_form[:byte-size (((UINT32) quote_count) * 29)];
} SimpleQuoteBlockLongFormMessage;

// Simple Quote Block (long form) including SentTimestamp, results in a Detailed Quote Block Reply (Qs).
typedef struct _SimpleQuoteBlockLongFormDetailedMessage {
  UINT8 badge[4];                                                                          // bytes 0 to 3
  UINT64BE message_id;                                                                     // bytes 4 to 11
  UINT64BE sent_timestamp;                                                                 // bytes 12 to 19
  UINT16BE quote_count;                                                                    // bytes 20 to 21
  SimpleQuotesLongForm simple_quotes_long_form[:byte-size (((UINT32) quote_count) * 29)];
} SimpleQuoteBlockLongFormDetailedMessage;

// Quotes of a Complex Quote Block
typedef struct _ComplexQuotes {
  UINT64BE quote_id;           // bytes 0 to 7
  UINT32BE instrument_id;      // bytes 8 to 11
  UINT32BE bid_price;          // bytes 12 to 15, signed, read here as unsigned
  UINT32BE bid_size;           // bytes 16 to 19
  UINT32BE ask_price;          // bytes 20 to 23, signed, read here as unsigned
  UINT32BE ask_size;           // bytes 24 to 27
  UINT8 reentry_indicator;     // byte 28
  UINT8 stock_leg_short_sale;  // byte 29
  UINT8 reserved_4[4];         // bytes 30 to 33
} ComplexQuotes;

// Complex Quote Block including SentTimestamp, results in a regular Quote Block Reply (QS). Bid/Ask prices for complex instruments can be zero or negative.
typedef struct _ComplexQuoteBlockMessage {
  UINT8 badge[4];                                                          // bytes 0 to 3
  UINT64BE message_id;                                                     // bytes 4 to 11
  UINT64BE sent_timestamp;                                                 // bytes 12 to 19
  UINT16BE quote_count;                                                    // bytes 20 to 21
  ComplexQuotes complex_quotes[:byte-size (((UINT32) quote_count) * 34)];
} ComplexQuoteBlockMessage;

// Complex Quote Block including SentTimestamp, results in a Detailed Quote Block Reply (Qs).
typedef struct _ComplexQuoteBlockDetailedMessage {
  UINT8 badge[4];                                                          // bytes 0 to 3
  UINT64BE message_id;                                                     // bytes 4 to 11
  UINT64BE sent_timestamp;                                                 // bytes 12 to 19
  UINT16BE quote_count;                                                    // bytes 20 to 21
  ComplexQuotes complex_quotes[:byte-size (((UINT32) quote_count) * 34)];
} ComplexQuoteBlockDetailedMessage;

// Underlying Purge Message including SentTimestamp: pulls all quotes for all options contracts of the specified underlying and inhibits new quotes until reentry.
typedef struct _UnderlyingPurgeRequestMessage {
  UINT8 badge[4];               // bytes 0 to 3
  UINT64BE message_id;          // bytes 4 to 11
  UINT64BE sent_timestamp;      // bytes 12 to 19
  UINT8 underlying_symbol[13];  // bytes 20 to 32
  UINT8 instrument_type;        // byte 33
} UnderlyingPurgeRequestMessage;

// Market Reentry Message: resets risk protection previously triggered by a Rapid Fire/Curtailment event or a user Purge request.
typedef struct _MarketReentryRequestMessage {
  UINT8 badge[4];               // bytes 0 to 3
  UINT64BE message_id;          // bytes 4 to 11
  UINT8 underlying_symbol[13];  // bytes 12 to 24
  UINT8 instrument_type;        // byte 25
} MarketReentryRequestMessage;

// ActiveQP/Self-Replenishment Request/Reentry Message: partial replenishment (removes a number of contracts from the Active QP counter) or full replenishment/reentry (value 0).
typedef struct _ActiveQpSelfReplenishmentRequestReentryMessage {
  UINT8 badge[4];                // bytes 0 to 3
  UINT64BE message_id;           // bytes 4 to 11
  UINT8 underlying_symbol[13];   // bytes 12 to 24
  UINT32BE replenishment_value;  // bytes 25 to 28
} ActiveQpSelfReplenishmentRequestReentryMessage;

// SQF Market Sweep and Auction Response (MSAR) request for a simple instrument. A size of zero cancels a prior auction response for the same instrument/price/side.
typedef struct _SimpleMsarRequestMessage {
  UINT8 badge[4];          // bytes 0 to 3
  UINT64BE message_id;     // bytes 4 to 11
  UINT32BE instrument_id;  // bytes 12 to 15
  UINT8 msar_type;         // byte 16
  UINT32BE auction_id;     // bytes 17 to 20
  UINT32BE price;          // bytes 21 to 24, signed, read here as unsigned
  UINT8 side;              // byte 25
  UINT32BE contracts;      // bytes 26 to 29
} SimpleMsarRequestMessage;

// MSAR request for a complex instrument. Price cannot be negative; the Debit/Credit indicator gives the sign.
typedef struct _ComplexMsarRequestMessage {
  UINT8 badge[4];          // bytes 0 to 3
  UINT64BE message_id;     // bytes 4 to 11
  UINT32BE instrument_id;  // bytes 12 to 15
  UINT8 msar_type;         // byte 16
  UINT32BE auction_id;     // bytes 17 to 20
  UINT32BE price;          // bytes 21 to 24, signed, read here as unsigned
  UINT8 side;              // byte 25
  UINT8 debit_credit;      // byte 26
  UINT32BE contracts;      // bytes 27 to 30
  UINT8 price_protection;  // byte 31
  UINT8 reserved_4[4];     // bytes 32 to 35
} ComplexMsarRequestMessage;

// The unsequenced (client to server) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _UnsequencedMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x4142: NotificationSubscriptionRequestMessage notification_subscription_request_message;
    case 0x4143: AddComplexInstrumentRequestMessage add_complex_instrument_request_message;
    case 0x4145: MmParameterDefinitionRequestMessage mm_parameter_definition_request_message;
    case 0x4147: ActiveQpSelfReplenishmentSetLimitMessage active_qp_self_replenishment_set_limit_message;
    case 0x4146: RapidFireConfigRequestMessage rapid_fire_config_request_message;
    case 0x5141: SimpleQuoteBlockShortFormMessage simple_quote_block_short_form_message;
    case 0x5161: SimpleQuoteBlockShortFormDetailedMessage simple_quote_block_short_form_detailed_message;
    case 0x514D: SimpleQuoteBlockLongFormMessage simple_quote_block_long_form_message;
    case 0x516D: SimpleQuoteBlockLongFormDetailedMessage simple_quote_block_long_form_detailed_message;
    case 0x5144: ComplexQuoteBlockMessage complex_quote_block_message;
    case 0x5164: ComplexQuoteBlockDetailedMessage complex_quote_block_detailed_message;
    case 0x5075: UnderlyingPurgeRequestMessage underlying_purge_request_message;
    case 0x5255: MarketReentryRequestMessage market_reentry_request_message;
    case 0x5247: ActiveQpSelfReplenishmentRequestReentryMessage active_qp_self_replenishment_request_reentry_message;
    case 0x5342: SimpleMsarRequestMessage simple_msar_request_message;
    case 0x5358: ComplexMsarRequestMessage complex_msar_request_message;
    default: UINT8 unknown[available];
  }
} UnsequencedMessage;

// The Unsequenced Data Packets act as an envelope to carry the actual data messages that are transferred from the client to the server
typedef struct _UnsequencedDataPacket (UINT16 packet_length) where (packet_length >= 3) {
  UINT16BE unsequenced_message_type;                                                                                                                                 // bytes 0 to 1
  UnsequencedMessage(unsequenced_message_type, (((UINT32) packet_length) - 3)) unsequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 3)];
} UnsequencedDataPacket;

// Branch
casetype _ClientPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x4C: LoginRequestPacket login_request_packet;
    case 0x55: UnsequencedDataPacket(packet_length) unsequenced_data_packet[:byte-size-single-element-array length];
    case 0x52: unit client_heartbeat_packet;
    case 0x4F: unit logout_request_packet;
    default: UINT8 unknown[available];
  }
} ClientPayload;

// Soup Bin Tcp Packet sent by the client
typedef struct _ClientSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 client_packet_type;                                                                                                                                                                                     // byte 2
  ClientPayload(client_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) client_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ClientSoupBinTcpPacket;

// ---- Packet: ClientPacket ----------------------------------------------------

// Sqf Packet sent by the client
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientSoupBinTcpPacket client_soup_bin_tcp_packet[:byte-size available];
} ClientPacket;

