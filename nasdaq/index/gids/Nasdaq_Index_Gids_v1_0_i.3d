// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Nasdaq_Index_Gids_v1_0_i.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_TIMESTAMP_SECONDS_MESSAGE 0x54                  // Timestamp Seconds Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                       // System Event Message
#define MESSAGE_TYPE_INDEX_DIRECTORY_MESSAGE 0x52                    // Index Directory Message
#define MESSAGE_TYPE_ISSUE_SYMBOL_PARTICIPATION_MESSAGE 0x50         // Issue Symbol Participation Message
#define MESSAGE_TYPE_INTRADAY_INDEX_VALUE_MESSAGE 0x49               // Intraday Index Value Message
#define MESSAGE_TYPE_SETTLEMENT_VALUE_MESSAGE 0x41                   // Settlement Value Message
#define MESSAGE_TYPE_EQUITIES_SUMMARY_MESSAGE 0x46                   // Equities Summary Message
#define MESSAGE_TYPE_FIXED_INCOME_SUMMARY_MESSAGE 0x42               // Fixed Income Summary Message
#define MESSAGE_TYPE_COMMODITY_SUMMARY_MESSAGE 0x43                  // Commodity Summary Message
#define MESSAGE_TYPE_ETP_DIRECTORY_AND_DAILY_VALUATION_MESSAGE 0x44  // Etp Directory And Daily Valuation Message
#define MESSAGE_TYPE_ETP_INTRA_DAY_VALUATION_MESSAGE 0x45            // Etp Intra Day Valuation Message
#define MESSAGE_TYPE_ETP_SUMMARY_MESSAGE 0x56                        // Etp Summary Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F  // Start Of Messages
#define EVENT_CODE_START_OF_DAY 0x53       // Start Of Day
#define EVENT_CODE_END_OF_DAY 0x45         // End Of Day
#define EVENT_CODE_END_OF_MESSAGES 0x43    // End Of Messages
#define EVENT_CODE_SESSION_OPEN 0x51       // Session Open
#define EVENT_CODE_SESSION_CLOSE 0x4D      // Session Close

// Dissemination Flag: one byte code
#define DISSEMINATION_FLAG_DISSEMINATED 0x59      // Disseminated
#define DISSEMINATION_FLAG_NOT_DISSEMINATED 0x4E  // Not Disseminated

// Financial Product Type: one byte code
#define FINANCIAL_PRODUCT_TYPE_NOT_SPECIFIED 0x20                 // Not Specified
#define FINANCIAL_PRODUCT_TYPE_INDEX 0x49                         // Index
#define FINANCIAL_PRODUCT_TYPE_EXCHANGE_TRADED_FUND 0x45          // Exchange Traded Fund
#define FINANCIAL_PRODUCT_TYPE_EXCHANGE_TRADED_NOTE 0x4E          // Exchange Traded Note
#define FINANCIAL_PRODUCT_TYPE_EXCHANGE_TRADED_MANAGED_FUND 0x46  // Exchange Traded Managed Fund
#define FINANCIAL_PRODUCT_TYPE_SETTLEMENT 0x53                    // Settlement
#define FINANCIAL_PRODUCT_TYPE_SPOT 0x50                          // Spot
#define FINANCIAL_PRODUCT_TYPE_SUBORDINATED_PRODUCT 0x4C          // Subordinated Product
#define FINANCIAL_PRODUCT_TYPE_WORLD_CURRENCY 0x57                // World Currency
#define FINANCIAL_PRODUCT_TYPE_ALPHA_INDEX 0x41                   // Alpha Index

// Market Cap Size: one byte code
#define MARKET_CAP_SIZE_NOT_SPECIFIED 0x20  // Not Specified
#define MARKET_CAP_SIZE_ALL 0x41            // All
#define MARKET_CAP_SIZE_LARGE 0x4C          // Large
#define MARKET_CAP_SIZE_MID 0x4D            // Mid
#define MARKET_CAP_SIZE_SMALL 0x53          // Small
#define MARKET_CAP_SIZE_LARGE_AND_MID 0x58  // Large And Mid
#define MARKET_CAP_SIZE_MID_AND_SMALL 0x59  // Mid And Small

// Index Settlement Type: one byte code
#define INDEX_SETTLEMENT_TYPE_NOT_SPECIFIED 0x20         // Not Specified
#define INDEX_SETTLEMENT_TYPE_SETTLES_AT_THE_OPEN 0x4F   // Settles At The Open
#define INDEX_SETTLEMENT_TYPE_SETTLES_AT_THE_CLOSE 0x43  // Settles At The Close
#define INDEX_SETTLEMENT_TYPE_SETTLES_AT_MID_DAY 0x4D    // Settles At Mid Day

// State: one byte code
#define STATE_ACTIVE 0x41   // Active
#define STATE_HELD 0x48     // Held
#define STATE_PENDING 0x50  // Pending
#define STATE_DELETED 0x44  // Deleted

// Index Usage: one byte code
#define INDEX_USAGE_LIVE 0x4C  // Live
#define INDEX_USAGE_DEMO 0x44  // Demo
#define INDEX_USAGE_TEST 0x54  // Test

// Tick Direction: one byte code
#define TICK_DIRECTION_POSITIVE 0x2B                  // Positive
#define TICK_DIRECTION_NEGATIVE 0x2D                  // Negative
#define TICK_DIRECTION_NO_NET_CHANGE_CALCULATED 0x20  // No Net Change Calculated

// Settlement Type: one byte code
#define SETTLEMENT_TYPE_NOT_SPECIFIED 0x20         // Not Specified
#define SETTLEMENT_TYPE_SETTLES_AT_THE_OPEN 0x4F   // Settles At The Open
#define SETTLEMENT_TYPE_SETTLES_AT_THE_CLOSE 0x43  // Settles At The Close
#define SETTLEMENT_TYPE_SETTLES_AT_MID_DAY 0x4D    // Settles At Mid Day

// ---- Types -------------------------------------------------------------------

// For every second during which there is at least one payload message, the seconds since the Unix epoch.
typedef struct _TimestampSecondsMessage {
  UINT32BE second;  // bytes 0 to 3, signed, read here as unsigned
} TimestampSecondsMessage;

// Signals a data feed handler event.
typedef struct _SystemEventMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 event_code;      // byte 4
  UINT8 schedule[3];     // bytes 5 to 7
} SystemEventMessage;

// Relays instrument level or reference data for Nasdaq and third party indexes.
typedef struct _IndexDirectoryMessage {
  UINT32BE nanoseconds;                             // bytes 0 to 3, signed, read here as unsigned
  UINT8 instrument_id[18];                          // bytes 4 to 21
  UINT8 dissemination_flag;                         // byte 22
  UINT8 financial_product_type;                     // byte 23
  UINT8 brand[2];                                   // bytes 24 to 25
  UINT8 series[3];                                  // bytes 26 to 28
  UINT8 strategy[3];                                // bytes 29 to 31
  UINT8 asset_type[2];                              // bytes 32 to 33
  UINT8 market_cap_size;                            // byte 34
  UINT8 currency[3];                                // bytes 35 to 37
  UINT8 geography[4];                               // bytes 38 to 41
  UINT8 index_settlement_type;                      // byte 42
  UINT8 index_calculation_method[3];                // bytes 43 to 45
  UINT8 state;                                      // byte 46
  UINT8 index_usage;                                // byte 47
  UINT8 schedule[3];                                // bytes 48 to 50
  UINT8 frequency[4];                               // bytes 51 to 54
  UINT32BE number_of_issue_participation_messages;  // bytes 55 to 58, signed, read here as unsigned
  UINT64BE base_value;                              // bytes 59 to 66, signed, read here as unsigned
  UINT32BE base_date;                               // bytes 67 to 70
  UINT16BE name_length;                             // bytes 71 to 72, signed, read here as unsigned
  UINT8 instrument_name[((UINT32) name_length)];
} IndexDirectoryMessage;

// Relays the component securities for select Nasdaq indexes.
typedef struct _IssueSymbolParticipationMessage {
  UINT32BE nanoseconds;                      // bytes 0 to 3, signed, read here as unsigned
  UINT8 instrument_id[18];                   // bytes 4 to 21
  UINT8 issue_symbol[18];                    // bytes 22 to 39
  UINT8 issue_mic[4];                        // bytes 40 to 43
  UINT16BE name_length;                      // bytes 44 to 45, signed, read here as unsigned
  UINT8 issue_name[((UINT32) name_length)];
} IssueSymbolParticipationMessage;

// The Intraday Index Value for a given instrument, disseminated at a defined frequency and schedule.
typedef struct _IntradayIndexValueMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3, signed, read here as unsigned
  UINT8 financial_product_type;  // byte 4
  UINT8 brand[2];                // bytes 5 to 6
  UINT8 series[3];               // bytes 7 to 9
  UINT8 instrument_id[18];       // bytes 10 to 27
  UINT64BE tick_value;           // bytes 28 to 35, signed, read here as unsigned
  UINT8 tick_direction;          // byte 36
  UINT8 currency[3];             // bytes 37 to 39
} IntradayIndexValueMessage;

// Sends the official settlement price and settlement session used to settle cash derivatives on financial products when they expire.
typedef struct _SettlementValueMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3, signed, read here as unsigned
  UINT8 financial_product_type;  // byte 4
  UINT8 brand[2];                // bytes 5 to 6
  UINT8 series[3];               // bytes 7 to 9
  UINT8 instrument_id[18];       // bytes 10 to 27
  UINT64BE settlement_value;     // bytes 28 to 35, signed, read here as unsigned
  UINT8 settlement_type;         // byte 36
  UINT8 currency[3];             // bytes 37 to 39
} SettlementValueMessage;

// Relays the summary of the current trading day's activity for an equity index.
typedef struct _EquitiesSummaryMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3, signed, read here as unsigned
  UINT8 financial_product_type;  // byte 4
  UINT8 brand[2];                // bytes 5 to 6
  UINT8 series[3];               // bytes 7 to 9
  UINT8 instrument_id[18];       // bytes 10 to 27
  UINT8 summary_type[3];         // bytes 28 to 30
  UINT64BE sod_value;            // bytes 31 to 38, signed, read here as unsigned
  UINT64BE high;                 // bytes 39 to 46, signed, read here as unsigned
  UINT64BE low;                  // bytes 47 to 54, signed, read here as unsigned
  UINT64BE eod_value;            // bytes 55 to 62, signed, read here as unsigned
  UINT64BE net_change;           // bytes 63 to 70, signed, read here as unsigned
  UINT32BE effective_date;       // bytes 71 to 74
  UINT8 currency[3];             // bytes 75 to 77
} EquitiesSummaryMessage;

// Relays the summary of the current trading day's activity for a fixed income index.
typedef struct _FixedIncomeSummaryMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3, signed, read here as unsigned
  UINT8 financial_product_type;  // byte 4
  UINT8 brand[2];                // bytes 5 to 6
  UINT8 series[3];               // bytes 7 to 9
  UINT8 instrument_id[18];       // bytes 10 to 27
  UINT8 summary_type[3];         // bytes 28 to 30
  UINT64BE sod_value;            // bytes 31 to 38, signed, read here as unsigned
  UINT64BE high;                 // bytes 39 to 46, signed, read here as unsigned
  UINT64BE low;                  // bytes 47 to 54, signed, read here as unsigned
  UINT64BE eod_value;            // bytes 55 to 62, signed, read here as unsigned
  UINT64BE net_change;           // bytes 63 to 70, signed, read here as unsigned
  UINT32BE effective_date;       // bytes 71 to 74
  UINT64BE yield;                // bytes 75 to 82, signed, read here as unsigned
  UINT64BE duration;             // bytes 83 to 90, signed, read here as unsigned
  UINT64BE coupon;               // bytes 91 to 98, signed, read here as unsigned
  UINT8 currency[3];             // bytes 99 to 101
} FixedIncomeSummaryMessage;

// Relays the summary of the current trading day's activity for a commodity index.
typedef struct _CommoditySummaryMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3, signed, read here as unsigned
  UINT8 financial_product_type;  // byte 4
  UINT8 brand[2];                // bytes 5 to 6
  UINT8 series[3];               // bytes 7 to 9
  UINT8 instrument_id[18];       // bytes 10 to 27
  UINT8 summary_type[3];         // bytes 28 to 30
  UINT64BE sod_value;            // bytes 31 to 38, signed, read here as unsigned
  UINT64BE high;                 // bytes 39 to 46, signed, read here as unsigned
  UINT64BE low;                  // bytes 47 to 54, signed, read here as unsigned
  UINT64BE eod_value;            // bytes 55 to 62, signed, read here as unsigned
  UINT64BE net_change;           // bytes 63 to 70, signed, read here as unsigned
  UINT32BE effective_date;       // bytes 71 to 74
  UINT8 currency[3];             // bytes 75 to 77
} CommoditySummaryMessage;

// Provides the symbols and values of the prior day's closing ETP valuations, disseminated as part of the pre-opening processes.
typedef struct _EtpDirectoryAndDailyValuationMessage {
  UINT32BE nanoseconds;                        // bytes 0 to 3, signed, read here as unsigned
  UINT8 financial_product_type;                // byte 4
  UINT8 industry_mic[4];                       // bytes 5 to 8
  UINT8 etp_trading_symbol[18];                // bytes 9 to 26
  UINT8 etp_ipv_symbol[18];                    // bytes 27 to 44
  UINT8 schedule[3];                           // bytes 45 to 47
  UINT8 frequency[4];                          // bytes 48 to 51
  UINT8 state;                                 // byte 52
  UINT8 nav_symbol[18];                        // bytes 53 to 70
  UINT64BE nav;                                // bytes 71 to 78, signed, read here as unsigned
  UINT8 estimated_cash_per_cu_symbol[18];      // bytes 79 to 96
  UINT64BE ecu;                                // bytes 97 to 104, signed, read here as unsigned
  UINT8 total_cash_per_cu_symbol[18];          // bytes 105 to 122
  UINT64BE total_cash_per_cu;                  // bytes 123 to 130, signed, read here as unsigned
  UINT8 estimated_cash_per_share_symbol[18];   // bytes 131 to 148
  UINT64BE ecs;                                // bytes 149 to 156, signed, read here as unsigned
  UINT8 tso_symbol[18];                        // bytes 157 to 174
  UINT64BE tso_outstanding;                    // bytes 175 to 182, signed, read here as unsigned
  UINT32BE effective_date;                     // bytes 183 to 186
  UINT64BE yield;                              // bytes 187 to 194, signed, read here as unsigned
  UINT64BE coupon;                             // bytes 195 to 202, signed, read here as unsigned
  UINT32BE maturity_date;                      // bytes 203 to 206
  UINT8 currency[3];                           // bytes 207 to 209
  UINT16BE etp_name_length;                    // bytes 210 to 211, signed, read here as unsigned
  UINT8 etp_name[((UINT32) etp_name_length)];
} EtpDirectoryAndDailyValuationMessage;

// Disseminates the Intraday Portfolio Value (IPV) of an ETF or the Intra-Day Indicative Value (IIV) of an ETMF.
typedef struct _EtpIntraDayValuationMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3, signed, read here as unsigned
  UINT8 financial_product_type;  // byte 4
  UINT8 ipv_symbol[18];          // bytes 5 to 22
  UINT64BE ipv_value;            // bytes 23 to 30, signed, read here as unsigned
  UINT8 currency[3];             // bytes 31 to 33
} EtpIntraDayValuationMessage;

// Relays the summary of the current trading day's IPV activity for an ETF or the IIV activity for an ETMF.
typedef struct _EtpSummaryMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3, signed, read here as unsigned
  UINT8 financial_product_type;  // byte 4
  UINT8 summary_type[3];         // bytes 5 to 7
  UINT8 ipv_or_iiv_symbol[18];   // bytes 8 to 25
  UINT64BE sod_value;            // bytes 26 to 33, signed, read here as unsigned
  UINT64BE high;                 // bytes 34 to 41, signed, read here as unsigned
  UINT64BE low;                  // bytes 42 to 49, signed, read here as unsigned
  UINT64BE eod_value;            // bytes 50 to 57, signed, read here as unsigned
  UINT64BE net_change;           // bytes 58 to 65, signed, read here as unsigned
  UINT32BE effective_date;       // bytes 66 to 69
  UINT8 currency[3];             // bytes 70 to 72
} EtpSummaryMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: TimestampSecondsMessage timestamp_seconds_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x52: IndexDirectoryMessage index_directory_message;
    case 0x50: IssueSymbolParticipationMessage issue_symbol_participation_message;
    case 0x49: IntradayIndexValueMessage intraday_index_value_message;
    case 0x41: SettlementValueMessage settlement_value_message;
    case 0x46: EquitiesSummaryMessage equities_summary_message;
    case 0x42: FixedIncomeSummaryMessage fixed_income_summary_message;
    case 0x43: CommoditySummaryMessage commodity_summary_message;
    case 0x44: EtpDirectoryAndDailyValuationMessage etp_directory_and_daily_valuation_message;
    case 0x45: EtpIntraDayValuationMessage etp_intra_day_valuation_message;
    case 0x56: EtpSummaryMessage etp_summary_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

