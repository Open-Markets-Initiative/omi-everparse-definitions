#define CLOSING_ONLY_NOT_CLOSING_POSITION_ONLY 0x4E  // Not Closing Position Only

// Action: one byte code
#define ACTION_ADD 0x41     // Add
#define ACTION_DELETE 0x44  // Delete

// Leg Option Kind: one byte code
#define LEG_OPTION_KIND_CALL 0x43       // Call
#define LEG_OPTION_KIND_PUT 0x50        // Put
#define LEG_OPTION_KIND_STOCK_LEG 0x20  // Stock Leg

// Leg Side: one byte code
#define LEG_SIDE_BUY 0x42   // Buy
