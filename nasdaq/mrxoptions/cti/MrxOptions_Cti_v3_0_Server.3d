#define OPTION_CLOSING_TYPE_EXTENDED_CLOSE 0x45  // Extended Close

// Tradable: one byte code
#define TRADABLE_TRADABLE 0x59      // Tradable
#define TRADABLE_NON_TRADABLE 0x4E  // Non Tradable

// Mpv: one byte code
#define MPV_PENNY_EVERYWHERE 0x45  // Penny Everywhere
