// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// The system event message is used to signal a ring wide event.
typedef struct _SystemEventMessage {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
  UINT8 version;         // byte 8
  UINT8 event_code;      // byte 9
} SystemEventMessage;

// At the start of each trading day, the exchange disseminates directory messages for all symbols trading on a given ring. Sent once per symbol, typically before the Start of System Hours System Event; intra-day updates are sent as they occur.
typedef struct _OptionsDirectoryMessage {
  UINT32BE seconds;               // bytes 0 to 3
  UINT32BE nanoseconds;           // bytes 4 to 7
  UINT8 version;                  // byte 8
  UINT32BE option_id;             // bytes 9 to 12
  UINT8 security_symbol[8];       // bytes 13 to 20
  UINT16BE expiration_year : 7;   // bytes 21 to 22
  UINT16BE expiration_month : 4;  // bytes 21 to 22
  UINT16BE expiration_day : 5;    // bytes 21 to 22
  UINT32BE strike_price;          // bytes 23 to 26
  UINT8 option_kind;              // byte 27
  UINT8 underlying_symbol[13];    // bytes 28 to 40
  UINT8 option_closing_type;      // byte 41
  UINT8 tradable;                 // byte 42
  UINT8 mpv;                      // byte 43
  UINT8 closing_only;             // byte 44
  UINT32BE contract_size;         // bytes 45 to 48
  UINT8 reserved_16[16];          // bytes 49 to 64
} OptionsDirectoryMessage;

// Leg information of the Complex Order Strategy message, 32 bytes per leg at offset 32n + 45
typedef struct _StrategyLegs {
  UINT32BE leg_option_id;             // bytes 0 to 3
  UINT8 leg_security_symbol[8];       // bytes 4 to 11
  UINT16BE leg_expiration_year : 7;   // bytes 12 to 13
  UINT16BE leg_expiration_month : 4;  // bytes 12 to 13
  UINT16BE leg_expiration_day : 5;    // bytes 12 to 13
  UINT32BE leg_strike_price;          // bytes 14 to 17
  UINT8 leg_option_kind;              // byte 18
  UINT8 leg_side;                     // byte 19
  UINT32BE leg_ratio;                 // bytes 20 to 23
  UINT8 reserved_8[8];                // bytes 24 to 31
} StrategyLegs;

// The strategy associated to a complex order (PHLX, ISE and MRX only). The Strategy ID assigned for a new complex strategy is unique for a particular complex instrument for a trading session, however Strategy IDs are independent of session Option IDs and uniqueness across complex and simple options is not guaranteed.
typedef struct _ComplexOrderStrategyMessage {
  UINT32BE seconds;                                                         // bytes 0 to 3
  UINT32BE nanoseconds;                                                     // bytes 4 to 7
  UINT8 version;                                                            // byte 8
  UINT32BE strategy_id;                                                     // bytes 9 to 12
  UINT8 underlying_symbol[13];                                              // bytes 13 to 25
  UINT8 action;                                                             // byte 26
  UINT8 reserved_16[16];                                                    // bytes 27 to 42
  UINT8 number_of_legs;                                                     // byte 43
  StrategyLegs strategy_legs[:byte-size (((UINT32) number_of_legs) * 32)];
} ComplexOrderStrategyMessage;

// Indicates the current trading status of an option within the exchange. A T (Trading resumed) message is sent for all options eligible for trading at the start of system hours; a security absent from the pre-opening spin should be treated as halted.
typedef struct _SecurityTradingActionMessage {
  UINT32BE seconds;               // bytes 0 to 3
  UINT32BE nanoseconds;           // bytes 4 to 7
  UINT8 version;                  // byte 8
  UINT32BE option_id;             // bytes 9 to 12
  UINT8 security_symbol[8];       // bytes 13 to 20
  UINT16BE expiration_year : 7;   // bytes 21 to 22
  UINT16BE expiration_month : 4;  // bytes 21 to 22
  UINT16BE expiration_day : 5;    // bytes 21 to 22
  UINT32BE strike_price;          // bytes 23 to 26
  UINT8 option_kind;              // byte 27
  UINT8 current_trading_state;    // byte 28
} SecurityTradingActionMessage;

// Indicates the current trading status of a strategy within the exchange (PHLX, ISE and MRX only). A T (Trading Resumed) message is sent for all strategies eligible for trading at the start of system hours.
typedef struct _ComplexTradingActionMessage {
  UINT32BE seconds;             // bytes 0 to 3
  UINT32BE nanoseconds;         // bytes 4 to 7
  UINT8 version;                // byte 8
  UINT32BE strategy_id;         // bytes 9 to 12
  UINT8 current_trading_state;  // byte 13
} ComplexTradingActionMessage;

// Clearing trades and trade corrections, with contra side clearing information (trade cancels too when a firm and connection block is configured for extended cancels, Transaction Type Z). 337 bytes. Contra side clearing fields carry a Contra prefix.
typedef struct _TradeMessage {
  UINT32BE seconds;                             // bytes 0 to 3
  UINT32BE nanoseconds;                         // bytes 4 to 7
  UINT8 version;                                // byte 8
  UINT8 send_type;                              // byte 9
  UINT32BE option_id;                           // bytes 10 to 13
  UINT8 underlying_symbol[13];                  // bytes 14 to 26
  UINT8 security_symbol[8];                     // bytes 27 to 34
  UINT16BE expiration_year : 7;                 // bytes 35 to 36
  UINT16BE expiration_month : 4;                // bytes 35 to 36
  UINT16BE expiration_day : 5;                  // bytes 35 to 36
  UINT32BE strike_price;                        // bytes 37 to 40
  UINT8 option_kind;                            // byte 41
  UINT16BE penny_pilot : 1;                     // bytes 42 to 43
  UINT16BE make_take_program : 1;               // bytes 42 to 43
  UINT16BE single_listed : 1;                   // bytes 42 to 43
  UINT16BE weekly_expiration : 1;               // bytes 42 to 43
  UINT16BE monthly_expiration : 1;              // bytes 42 to 43
  UINT16BE quarterly_expiration : 1;            // bytes 42 to 43
  UINT16BE reserved_trade_flags : 10;           // bytes 42 to 43
  UINT8 reserved_4[4];                          // bytes 44 to 47
  UINT8 transaction_type;                       // byte 48
  UINT8 liquidity;                              // byte 49
  UINT32BE trade_id;                            // bytes 50 to 53
  UINT16BE correction_number;                   // bytes 54 to 55
  UINT32BE cross_id;                            // bytes 56 to 59
  UINT32BE match_id;                            // bytes 60 to 63
  UINT32BE auction_id;                          // bytes 64 to 67
  UINT8 auction_type;                           // byte 68
  UINT32BE ref_trade_id;                        // bytes 69 to 72
  UINT16BE ref_correction_number;               // bytes 73 to 74
  UINT32BE ref_match_id;                        // bytes 75 to 78
  UINT8 execution_type;                         // byte 79
  UINT8 execution_market;                       // byte 80
  UINT8 trade_side;                             // byte 81
  UINT64BE trade_price;                         // bytes 82 to 89
  UINT32BE trade_contracts;                     // bytes 90 to 93
  UINT8 side_changed;                           // byte 94
  UINT32BE strategy_id;                         // bytes 95 to 98
  UINT16BE strategy_leg;                        // bytes 99 to 100
  UINT8 reserved_8[8];                          // bytes 101 to 108
  UINT32BE occ_clearing_number;                 // bytes 109 to 112
  UINT32BE give_up_occ_clearing_number;         // bytes 113 to 116
  UINT32BE exchange_clearing_number;            // bytes 117 to 120
  UINT32BE exchange_house;                      // bytes 121 to 124
  UINT8 exchange_suffix;                        // byte 125
  UINT8 capacity;                               // byte 126
  UINT8 multi_account[5];                       // bytes 127 to 131
  UINT8 broker[4];                              // bytes 132 to 135
  UINT32BE second_broker;                       // bytes 136 to 139
  UINT8 origin_market;                          // byte 140
  UINT8 account[32];                            // bytes 141 to 172
  UINT32BE nscc;                                // bytes 173 to 176
  UINT8 mpid[5];                                // bytes 177 to 181
  UINT16BE priority_market_maker : 1;           // bytes 182 to 183
  UINT16BE reserved_clearing_flags : 15;        // bytes 182 to 183
  UINT8 executing_broker[4];                    // bytes 184 to 187
  UINT8 reserved_6[6];                          // bytes 188 to 193
  UINT32BE contra_occ_clearing_number;          // bytes 194 to 197
  UINT32BE contra_give_up_occ_clearing_number;  // bytes 198 to 201
  UINT32BE contra_exchange_clearing_number;     // bytes 202 to 205
  UINT32BE contra_exchange_house;               // bytes 206 to 209
  UINT8 contra_capacity;                        // byte 210
  UINT32BE contra_broker;                       // bytes 211 to 214
  UINT32BE contra_second_broker;                // bytes 215 to 218
  UINT32BE contra_nscc;                         // bytes 219 to 222
  UINT8 contra_mpid[5];                         // bytes 223 to 227
  UINT8 second_reserved_8[8];                   // bytes 228 to 235
  UINT8 firm[4];                                // bytes 236 to 239
  UINT16BE order_date_year : 7;                 // bytes 240 to 241
  UINT16BE order_date_month : 4;                // bytes 240 to 241
  UINT16BE order_date_day : 5;                  // bytes 240 to 241
  UINT8 order_id[30];                           // bytes 242 to 271
  UINT64BE quote_id;                            // bytes 272 to 279
  UINT64BE sqf_sweep_id;                        // bytes 280 to 287
  UINT8 open_close_indicator;                   // byte 288
  UINT8 customer_strategy_leg[10];              // bytes 289 to 298
  UINT8 short_sell;                             // byte 299
  UINT8 principal_agent;                        // byte 300
  UINT8 supplementary_id[15];                   // bytes 301 to 315
  UINT16BE fbms_order : 1;                      // bytes 316 to 317
  UINT16BE directed_preferenced : 1;            // bytes 316 to 317
  UINT16BE post_only_alo : 1;                   // bytes 316 to 317
  UINT16BE mkt_order : 1;                       // bytes 316 to 317
  UINT16BE ise_directed_order : 1;              // bytes 316 to 317
  UINT16BE reserved_order_indicators : 11;      // bytes 316 to 317
  UINT8 origin_type;                            // byte 318
  UINT32BE order_size;                          // bytes 319 to 322
  UINT32BE order_price;                         // bytes 323 to 326
  UINT8 tif;                                    // byte 327
  UINT8 third_reserved_8[8];                    // bytes 328 to 335
} TradeMessage;

// By default CTI sends trade cancels using this message; alternatively a firm and connection block can be configured to send extended cancels with all the trade information using the Trade message with Transaction Type Z. 66 bytes.
typedef struct _CancelTradeMessage {
  UINT32BE seconds;               // bytes 0 to 3
  UINT32BE nanoseconds;           // bytes 4 to 7
  UINT8 version;                  // byte 8
  UINT8 send_type;                // byte 9
  UINT32BE option_id;             // bytes 10 to 13
  UINT8 underlying_symbol[13];    // bytes 14 to 26
  UINT8 security_symbol[8];       // bytes 27 to 34
  UINT16BE expiration_year : 7;   // bytes 35 to 36
  UINT16BE expiration_month : 4;  // bytes 35 to 36
  UINT16BE expiration_day : 5;    // bytes 35 to 36
  UINT32BE strike_price;          // bytes 37 to 40
  UINT8 option_kind;              // byte 41
  UINT32BE trade_id;              // bytes 42 to 45
  UINT16BE correction_number;     // bytes 46 to 47
  UINT32BE cross_id;              // bytes 48 to 51
  UINT8 trade_side;               // byte 52
  UINT32BE match_id;              // bytes 53 to 56
  UINT8 reserved_8[8];            // bytes 57 to 64
} CancelTradeMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x44: OptionsDirectoryMessage options_directory_message;
    case 0x52: ComplexOrderStrategyMessage complex_order_strategy_message;
    case 0x48: SecurityTradingActionMessage security_trading_action_message;
    case 0x49: ComplexTradingActionMessage complex_trading_action_message;
    case 0x54: TradeMessage trade_message;
    case 0x56: CancelTradeMessage cancel_trade_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat;
    case 0x5A: unit end_of_session;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

