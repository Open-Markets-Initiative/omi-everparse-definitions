  UINT8 option_type;         // byte 38
  UINT8 closing_type;        // byte 39
  UINT8 tradable;            // byte 40
  UINT8 closing_only;        // byte 41
  UINT16BE contract_size;    // bytes 42 to 43
  UINT8 mpv;                 // byte 44
  UINT8 security_symbol[8];  // bytes 45 to 52
  UINT8 reserved_16[16];     // bytes 53 to 68
} SimpleInstrumentDirectoryMessage;

// ---- Instrument Trading Action Message: 15 bytes -----------------------------

// This message notifies of changes to the trading status of an instrument.
entrypoint typedef struct _InstrumentTradingActionMessage {
  UINT64BE timestamp;      // bytes 0 to 7
  UINT16BE product_id;     // bytes 8 to 9
  UINT32BE instrument_id;  // bytes 10 to 13
