// Mass Cancel Response is sent out upon completion of processing of a valid Mass Cancel Request.
entrypoint typedef struct _MassCancelResponseMessage {
  UINT64BE timestamp;       // bytes 0 to 7
  UINT8 firm_id[4];         // bytes 8 to 11
  UINT8 cl_request_id[16];  // bytes 12 to 27
