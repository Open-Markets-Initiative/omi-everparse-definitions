  UINT64BE primary_order_id;              // bytes 35 to 42
  UINT8 primary_cl_ord_id[16];            // bytes 43 to 58
  UINT32BE primary_cmta;                  // bytes 59 to 62
  UINT8 primary_clearing_account[4];      // bytes 63 to 66
