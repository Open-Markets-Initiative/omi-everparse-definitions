  UINT8 side;                     // byte 66
  UINT8 order_type;               // byte 67
  UINT64BE price;                 // bytes 68 to 75, signed, read here as unsigned
  UINT32BE quantity;              // bytes 76 to 79
  UINT8 tif;                      // byte 80
