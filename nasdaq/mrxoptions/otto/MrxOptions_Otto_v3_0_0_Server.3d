  UINT8 primary_stock_leg_mpid[4];        // bytes 97 to 100
  UINT64BE contra_order_id;               // bytes 101 to 108
  UINT8 contra_cl_ord_id[16];             // bytes 109 to 124
  UINT32BE contra_cmta;                   // bytes 125 to 128
  UINT8 contra_clearing_account[4];       // bytes 129 to 132
  UINT32BE contra_occ_account;            // bytes 133 to 136
  UINT8 contra_cust_acct[10];             // bytes 137 to 146
  UINT8 contra_order_type;                // byte 147
  UINT64BE contra_price;                  // bytes 148 to 155, signed, read here as unsigned
  UINT32BE contra_quantity;               // bytes 156 to 159
  UINT8 contra_capacity;                  // byte 160
  UINT16BE contra_position_effect_mask;   // bytes 161 to 162
  UINT8 contra_stock_leg_short_sale;      // byte 163
