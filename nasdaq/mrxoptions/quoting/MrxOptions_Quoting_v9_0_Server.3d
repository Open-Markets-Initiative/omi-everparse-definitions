#define PURGE_REASON_SYSTEM_INITIATED 0x53          // System Initiated
#define PURGE_REASON_AUTO_KILLSWITCH 0x4B           // Auto Killswitch
#define PURGE_REASON_MANUAL_KILLSWITCH 0x4D         // Manual Killswitch
#define PURGE_REASON_PURGE_ON_DISCONNECT 0x50       // Purge On Disconnect
#define PURGE_REASON_USER_REQUESTED_COMPLEX 0x75    // User Requested Complex
#define PURGE_REASON_SYSTEM_INITIATED_COMPLEX 0x73  // System Initiated Complex
#define PURGE_REASON_ANTI_INTERNALIZE 0x51          // Anti Internalize

// Reentry Scope: one byte code
#define REENTRY_SCOPE_USER_REQUESTED_SIMPLE 0x4E   // User Requested Simple
#define REENTRY_SCOPE_USER_REQUESTED_COMPLEX 0x6E  // User Requested Complex
#define REENTRY_SCOPE_POST_KILLSWITCH 0x4B         // Post Killswitch

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// The MSAR Request was accepted by the matching engine. Sequenced.
typedef struct _MsarAcceptMessage {
  UINT8 badge[4];          // bytes 0 to 3
  UINT64BE message_id;     // bytes 4 to 11
  UINT32BE instrument_id;  // bytes 12 to 15
  UINT8 msar_type;         // byte 16
  UINT32BE auction_id;     // bytes 17 to 20
  UINT32BE price;          // bytes 21 to 24, signed, read here as unsigned
  UINT8 side;              // byte 25
  UINT32BE contracts;      // bytes 26 to 29
} MsarAcceptMessage;

// The MSAR Request is invalid and therefore rejected. Sequenced.
typedef struct _MsarRejectMessage {
  UINT8 badge[4];       // bytes 0 to 3
  UINT64BE message_id;  // bytes 4 to 11
  UINT8 status_code;    // byte 12
} MsarRejectMessage;

// The Complex MSAR Request was accepted by the matching engine. Sequenced.
typedef struct _ComplexMsarAcceptMessage {
  UINT8 badge[4];          // bytes 0 to 3
  UINT64BE message_id;     // bytes 4 to 11
  UINT32BE instrument_id;  // bytes 12 to 15
  UINT8 msar_type;         // byte 16
  UINT32BE auction_id;     // bytes 17 to 20
  UINT32BE price;          // bytes 21 to 24, signed, read here as unsigned
  UINT8 side;              // byte 25
  UINT32BE contracts;      // bytes 26 to 29
  UINT8 price_protection;  // byte 30
  UINT8 reserved_4[4];     // bytes 31 to 34
} ComplexMsarAcceptMessage;

// The Complex MSAR Request is invalid and therefore rejected. Sequenced.
typedef struct _ComplexMsarRejectMessage {
  UINT8 badge[4];       // bytes 0 to 3
  UINT64BE message_id;  // bytes 4 to 11
  UINT8 status_code;    // byte 12
} ComplexMsarRejectMessage;

// Sent once per badge/underlying pair, typically right after the instrument directory messages, and intra-day when permissions change. Sequenced.
typedef struct _UnderlyingPermissionNotificationMessage {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
  UINT8 badge[4];        // bytes 8 to 11
  UINT8 underlying[13];  // bytes 12 to 24
  UINT8 permitted;       // byte 25
} UnderlyingPermissionNotificationMessage;

// Optionally delivered participant per-underlying/instrument type configuration settings. Sequenced.
typedef struct _MmParameterDefinitionNotificationMessage {
  UINT32BE seconds;       // bytes 0 to 3
  UINT32BE nanoseconds;   // bytes 4 to 7
  UINT8 badge[4];         // bytes 8 to 11
  UINT8 instrument_type;  // byte 12
  UINT8 underlying[13];   // bytes 13 to 25
  UINT16BE interval;      // bytes 26 to 27
  UINT16BE percentage;    // bytes 28 to 29
  UINT32BE cum_qty;       // bytes 30 to 33
  UINT32BE delta;         // bytes 34 to 37
  UINT32BE vega;          // bytes 38 to 41
  UINT8 reserved_32[32];  // bytes 42 to 73
} MmParameterDefinitionNotificationMessage;

// Optionally delivered contract limit on the badges configured for ActiveQP. Sequenced.
typedef struct _ActiveQpSelfReplenishmentParameterDefinitionNotificationMessage {
  UINT32BE seconds;             // bytes 0 to 3
  UINT32BE nanoseconds;         // bytes 4 to 7
  UINT8 badge[4];               // bytes 8 to 11
  UINT8 underlying[13];         // bytes 12 to 24
  UINT32BE set_contract_limit;  // bytes 25 to 28
  UINT8 reserved_32[32];        // bytes 29 to 60
} ActiveQpSelfReplenishmentParameterDefinitionNotificationMessage;

// Signals a market or data feed handler event. Sequenced.
typedef struct _SystemEventMessage {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
  UINT8 event_code;      // byte 8
  UINT8 version;         // byte 9
  UINT8 sub_version;     // byte 10
} SystemEventMessage;

// Disseminated at the start of each trading day for all symbols trading on the system, and intra-day when attributes change. Sequenced.
typedef struct _SimpleInstrumentDirectoryMessage {
  UINT32BE seconds;             // bytes 0 to 3
  UINT32BE nanoseconds;         // bytes 4 to 7
  UINT32BE instrument_id;       // bytes 8 to 11
  UINT8 security_symbol[8];     // bytes 12 to 19
  UINT16BE expiration;          // bytes 20 to 21
  UINT32BE strike_price;        // bytes 22 to 25, signed, read here as unsigned
  UINT8 option_type;            // byte 26
  UINT8 underlying_symbol[13];  // bytes 27 to 39
  UINT8 closing_type;           // byte 40
  UINT8 tradable;               // byte 41
  UINT8 mpv;                    // byte 42
  UINT8 reserved_16[16];        // bytes 43 to 58
} SimpleInstrumentDirectoryMessage;

// Leg Definitions, Repeated Number Of Legs times
typedef struct _ComplexLegs {
  UINT32BE leg_instrument_id;  // bytes 0 to 3
  UINT8 leg_side;              // byte 4
  UINT32BE leg_ratio;          // bytes 5 to 8
} ComplexLegs;

// Sent when a new complex strategy is created for the first time. Sequenced.
typedef struct _ComplexInstrumentDirectoryMessage {
  UINT32BE seconds;                                                      // bytes 0 to 3
  UINT32BE nanoseconds;                                                  // bytes 4 to 7
  UINT32BE instrument_id;                                                // bytes 8 to 11
  UINT8 underlying_symbol[13];                                           // bytes 12 to 24
  UINT8 reserved_1;                                                      // byte 25
  UINT8 number_of_legs;                                                  // byte 26
  ComplexLegs complex_legs[:byte-size (((UINT32) number_of_legs) * 9)];
} ComplexInstrumentDirectoryMessage;

// Relays changes in trading status for a simple instrument. Sequenced.
typedef struct _SimpleInstrumentTradingActionMessage {
  UINT32BE seconds;        // bytes 0 to 3
  UINT32BE nanoseconds;    // bytes 4 to 7
  UINT32BE instrument_id;  // bytes 8 to 11
  UINT8 trading_state;     // byte 12
} SimpleInstrumentTradingActionMessage;

// Relays changes in trading status for a complex strategy. Sequenced.
typedef struct _ComplexInstrumentTradingActionMessage {
  UINT32BE seconds;        // bytes 0 to 3
  UINT32BE nanoseconds;    // bytes 4 to 7
  UINT32BE instrument_id;  // bytes 8 to 11
  UINT8 trading_state;     // byte 12
} ComplexInstrumentTradingActionMessage;

// Informs the firm that its quote for a given simple instrument has been executed. Only sent if subscribed. Sequenced.
typedef struct _SimpleQuoteExecutionNotificationMessage {
  UINT32BE seconds;           // bytes 0 to 3
  UINT32BE nanoseconds;       // bytes 4 to 7
  UINT8 badge[4];             // bytes 8 to 11
  UINT32BE instrument_id;     // bytes 12 to 15
  UINT64BE message_id;        // bytes 16 to 23
  UINT32BE auction_id;        // bytes 24 to 27
  UINT32BE price;             // bytes 28 to 31, signed, read here as unsigned
  UINT8 side;                 // byte 32
  UINT32BE contracts;         // bytes 33 to 36
  UINT8 liquidity_indicator;  // byte 37
  UINT32BE cross_id;          // bytes 38 to 41
  UINT32BE match_id;          // bytes 42 to 45
} SimpleQuoteExecutionNotificationMessage;

// Informs the participant that its quote for a given complex instrument has been executed. Sequenced.
typedef struct _ComplexQuoteExecutionNotificationMessage {
  UINT32BE seconds;           // bytes 0 to 3
  UINT32BE nanoseconds;       // bytes 4 to 7
  UINT8 badge[4];             // bytes 8 to 11
  UINT64BE message_id;        // bytes 12 to 19
  UINT32BE instrument_id;     // bytes 20 to 23
  UINT32BE auction_id;        // bytes 24 to 27
  UINT64BE price_6;           // bytes 28 to 35, signed, read here as unsigned
  UINT8 side;                 // byte 36
  UINT32BE contracts;         // bytes 37 to 40
  UINT8 liquidity_indicator;  // byte 41
  UINT32BE cross_id;          // bytes 42 to 45
  UINT32BE match_id;          // bytes 46 to 49
} ComplexQuoteExecutionNotificationMessage;

// Leg level execution of a quote in a complex instrument. Sequenced.
typedef struct _ComplexQuoteLegExecutionNotificationMessage {
  UINT32BE seconds;            // bytes 0 to 3
  UINT32BE nanoseconds;        // bytes 4 to 7
  UINT8 badge[4];              // bytes 8 to 11
  UINT64BE message_id;         // bytes 12 to 19
  UINT32BE instrument_id;      // bytes 20 to 23
  UINT32BE leg_instrument_id;  // bytes 24 to 27
  UINT8 leg_id;                // byte 28
  UINT32BE auction_id;         // bytes 29 to 32
  UINT64BE price_6;            // bytes 33 to 40, signed, read here as unsigned
  UINT8 side;                  // byte 41
  UINT32BE contracts;          // bytes 42 to 45
  UINT8 liquidity_indicator;   // byte 46
  UINT32BE cross_id;           // bytes 47 to 50
  UINT32BE match_id;           // bytes 51 to 54
} ComplexQuoteLegExecutionNotificationMessage;

// Execution Notification Message: the MSAR Request for a given simple instrument has been executed or cancelled. The Side field reflects the side being swept. Sequenced.
typedef struct _SimpleMsarNotificationMessage {
  UINT32BE seconds;           // bytes 0 to 3
  UINT32BE nanoseconds;       // bytes 4 to 7
  UINT8 badge[4];             // bytes 8 to 11
  UINT32BE instrument_id;     // bytes 12 to 15
  UINT8 notification_type;    // byte 16
  UINT64BE message_id;        // bytes 17 to 24
  UINT32BE auction_id;        // bytes 25 to 28
  UINT32BE price;             // bytes 29 to 32, signed, read here as unsigned
  UINT8 side;                 // byte 33
  UINT32BE contracts;         // bytes 34 to 37
  UINT8 liquidity_indicator;  // byte 38
  UINT32BE cross_id;          // bytes 39 to 42
  UINT32BE match_id;          // bytes 43 to 46
} SimpleMsarNotificationMessage;

// Leg-level information on the execution/out of an MSAR for a complex instrument. Precedes the corresponding Complex MSAR Notification. Sequenced.
typedef struct _ComplexMsarLegNotificationMessage {
  UINT32BE seconds;            // bytes 0 to 3
  UINT32BE nanoseconds;        // bytes 4 to 7
  UINT8 badge[4];              // bytes 8 to 11
  UINT32BE instrument_id;      // bytes 12 to 15
  UINT8 leg_id;                // byte 16
  UINT32BE leg_instrument_id;  // bytes 17 to 20
  UINT8 notification_type;     // byte 21
  UINT64BE message_id;         // bytes 22 to 29
  UINT32BE auction_id;         // bytes 30 to 33
  UINT32BE price;              // bytes 34 to 37, signed, read here as unsigned
  UINT8 side;                  // byte 38
  UINT8 leg_side;              // byte 39
  UINT32BE contracts;          // bytes 40 to 43
  UINT8 liquidity_indicator;   // byte 44
  UINT32BE cross_id;           // bytes 45 to 48
  UINT32BE match_id;           // bytes 49 to 52
  UINT64BE price_6;            // bytes 53 to 60, signed, read here as unsigned
} ComplexMsarLegNotificationMessage;

// Complex MSAR Execution Notification: the Complex MSAR Request has been executed or cancelled. Sequenced.
typedef struct _ComplexMsarNotificationMessage {
  UINT32BE seconds;           // bytes 0 to 3
  UINT32BE nanoseconds;       // bytes 4 to 7
  UINT8 badge[4];             // bytes 8 to 11
  UINT32BE instrument_id;     // bytes 12 to 15
  UINT8 notification_type;    // byte 16
  UINT64BE message_id;        // bytes 17 to 24
  UINT32BE auction_id;        // bytes 25 to 28
  UINT32BE price;             // bytes 29 to 32, signed, read here as unsigned
  UINT8 side;                 // byte 33
  UINT32BE contracts;         // bytes 34 to 37
  UINT8 liquidity_indicator;  // byte 38
  UINT32BE cross_id;          // bytes 39 to 42
  UINT32BE match_id;          // bytes 43 to 46
  UINT64BE price_6;           // bytes 47 to 54, signed, read here as unsigned
} ComplexMsarNotificationMessage;

// Quote Spread Multiplier Message: sent once per underlying permitted on the port and whenever the effective multiplier changes intraday. Sequenced.
typedef struct _OpeningRotationQuoteSpreadMultiplierNotificationMessage {
  UINT32BE seconds;             // bytes 0 to 3
  UINT32BE nanoseconds;         // bytes 4 to 7
  UINT8 underlying_symbol[13];  // bytes 8 to 20
  UINT8 multiplier;             // byte 21
} OpeningRotationQuoteSpreadMultiplierNotificationMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x5341: MsarAcceptMessage msar_accept_message;
    case 0x5352: MsarRejectMessage msar_reject_message;
    case 0x5359: ComplexMsarAcceptMessage complex_msar_accept_message;
    case 0x534E: ComplexMsarRejectMessage complex_msar_reject_message;
    case 0x4150: UnderlyingPermissionNotificationMessage underlying_permission_notification_message;
    case 0x414A: MmParameterDefinitionNotificationMessage mm_parameter_definition_notification_message;
    case 0x414B: ActiveQpSelfReplenishmentParameterDefinitionNotificationMessage active_qp_self_replenishment_parameter_definition_notification_message;
    case 0x4153: SystemEventMessage system_event_message;
    case 0x4144: SimpleInstrumentDirectoryMessage simple_instrument_directory_message;
    case 0x4152: ComplexInstrumentDirectoryMessage complex_instrument_directory_message;
    case 0x4148: SimpleInstrumentTradingActionMessage simple_instrument_trading_action_message;
    case 0x4149: ComplexInstrumentTradingActionMessage complex_instrument_trading_action_message;
    case 0x4E45: SimpleQuoteExecutionNotificationMessage simple_quote_execution_notification_message;
    case 0x4E56: ComplexQuoteExecutionNotificationMessage complex_quote_execution_notification_message;
    case 0x4E57: ComplexQuoteLegExecutionNotificationMessage complex_quote_leg_execution_notification_message;
    case 0x4E53: SimpleMsarNotificationMessage simple_msar_notification_message;
    case 0x4E4C: ComplexMsarLegNotificationMessage complex_msar_leg_notification_message;
    case 0x4E58: ComplexMsarNotificationMessage complex_msar_notification_message;
    case 0x414D: OpeningRotationQuoteSpreadMultiplierNotificationMessage opening_rotation_quote_spread_multiplier_notification_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 3) {
  UINT16BE sequenced_message_type;                                                                                                                             // bytes 0 to 1
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 3)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 3)];
} SequencedDataPacket;

// Reply to a Notification Subscription Request. Unsequenced.
typedef struct _NotificationSubscriptionReplyMessage {
  UINT8 badge[4];       // bytes 0 to 3
  UINT64BE message_id;  // bytes 4 to 11
  UINT8 status_code;    // byte 12
} NotificationSubscriptionReplyMessage;

// Response to the Add Complex Instrument Request (AC) indicating the validity of the request. Unsequenced.
typedef struct _AddComplexInstrumentReplyMessage {
  UINT8 badge[4];       // bytes 0 to 3
  UINT64BE message_id;  // bytes 4 to 11
  UINT8 status_code;    // byte 12
} AddComplexInstrumentReplyMessage;

// Response to the MM Parameter Definition Request (AE) indicating the validity of the request. Unsequenced.
typedef struct _MmParameterDefinitionReplyMessage {
  UINT8 badge[4];       // bytes 0 to 3
  UINT64BE message_id;  // bytes 4 to 11
  UINT8 status_code;    // byte 12
} MmParameterDefinitionReplyMessage;

// Acknowledgement message for Set Limit Message. Unsequenced.
typedef struct _ActiveQpSelfReplenishmentSetLimitReplyMessage {
  UINT8 badge[4];               // bytes 0 to 3
  UINT64BE message_id;          // bytes 4 to 11
  UINT8 underlying_symbol[13];  // bytes 12 to 24
  UINT32BE set_value;           // bytes 25 to 28
  UINT8 status_code;            // byte 29
} ActiveQpSelfReplenishmentSetLimitReplyMessage;

// 1-200 quote responses of a Quote Block Reply, one per quote of the submitted block
typedef struct _QuoteResponses {
  UINT8 quote_status_code;  // byte 0
  UINT64BE sequence;        // bytes 1 to 8
} QuoteResponses;

// Quote Block Reply Message including SentTimestamp. Response to QA, QM and QD. Unsequenced.
typedef struct _QuoteBlockReplyMessage {
  UINT8 badge[4];                                                                 // bytes 0 to 3
  UINT64BE message_id;                                                            // bytes 4 to 11
  UINT64BE sent_timestamp;                                                        // bytes 12 to 19
  UINT8 block_status_code;                                                        // byte 20
  UINT16BE quote_count;                                                           // bytes 21 to 22
  UINT16BE valid_quote_count;                                                     // bytes 23 to 24
  QuoteResponses quote_responses[:byte-size (((UINT32) valid_quote_count) * 9)];
} QuoteBlockReplyMessage;

// 1-200 quote responses of a Detailed Quote Block Reply, one per quote of the submitted block
typedef struct _DetailedQuoteResponses {
  UINT8 quote_status_code;  // byte 0
  UINT64BE sequence;        // bytes 1 to 8
  UINT64BE bid_sequence;    // bytes 9 to 16
  UINT64BE ask_sequence;    // bytes 17 to 24
} DetailedQuoteResponses;

// Detailed Quote Reply Message including SentTimestamp. Response to Qa, Qm and Qd; adds individual Bid/Ask sequence numbers. Unsequenced.
typedef struct _DetailedQuoteBlockReplyMessage {
  UINT8 badge[4];                                                                                   // bytes 0 to 3
  UINT64BE message_id;                                                                              // bytes 4 to 11
  UINT64BE sent_timestamp;                                                                          // bytes 12 to 19
  UINT8 block_status_code;                                                                          // byte 20
  UINT16BE quote_count;                                                                             // bytes 21 to 22
  UINT16BE valid_quote_count;                                                                       // bytes 23 to 24
  DetailedQuoteResponses detailed_quote_responses[:byte-size (((UINT32) valid_quote_count) * 25)];
} DetailedQuoteBlockReplyMessage;

// Underlying Purge Reply Message including SentTimestamp. Unsequenced.
typedef struct _UnderlyingPurgeReplyMessage {
  UINT8 badge[4];           // bytes 0 to 3
  UINT64BE message_id;      // bytes 4 to 11
  UINT64BE sent_timestamp;  // bytes 12 to 19
  UINT8 status_code;        // byte 20
  UINT64BE sequence;        // bytes 21 to 28
} UnderlyingPurgeReplyMessage;

// Market Reentry Reply Message. Unsequenced.
typedef struct _MarketReentryReplyMessage {
  UINT8 badge[4];       // bytes 0 to 3
  UINT64BE message_id;  // bytes 4 to 11
  UINT8 status_code;    // byte 12
  UINT8 reserved_8[8];  // bytes 13 to 20
} MarketReentryReplyMessage;

// Acknowledgement for the ActiveQP Request/Reentry Message. Unsequenced.
typedef struct _ActiveQpSelfReplenishmentRequestReentryReplyMessage {
  UINT8 badge[4];                          // bytes 0 to 3
  UINT64BE message_id;                     // bytes 4 to 11
  UINT8 underlying_symbol[13];             // bytes 12 to 24
  UINT8 status_code;                       // byte 25
  UINT32BE requested_replenishment_value;  // bytes 26 to 29
  UINT32BE active_counter_value;           // bytes 30 to 33
  UINT32BE set_contract_limit;             // bytes 34 to 37
} ActiveQpSelfReplenishmentRequestReentryReplyMessage;

// Auction Notification leg definitions, to be used in future to support Delta-Adjusted at Close functionality on Flex
typedef struct _FlexDacLegs {
  UINT8 reserved_8[8];  // bytes 0 to 7
} FlexDacLegs;

// Announces start, update or end of an Auction (Block, Exposure, Flash, Facilitation, Solicitation, PIM) for simple, complex and stock combo instruments. An end of auction notification has all fields after Auction ID zeroed and blanked out. Unsequenced.
typedef struct _AuctionNotificationMessage {
  UINT32BE seconds;                                               // bytes 0 to 3
  UINT32BE nanoseconds;                                           // bytes 4 to 7
  UINT8 instrument_type;                                          // byte 8
  UINT32BE instrument_id;                                         // bytes 9 to 12
  UINT32BE auction_id;                                            // bytes 13 to 16
  UINT8 order_type;                                               // byte 17
  UINT8 side;                                                     // byte 18
  UINT32BE price;                                                 // bytes 19 to 22, signed, read here as unsigned
  UINT32BE matched_volume;                                        // bytes 23 to 26
  UINT32BE volume;                                                // bytes 27 to 30
  UINT8 exec_flag;                                                // byte 31
  UINT8 order_capacity;                                           // byte 32
  UINT8 firm_id[4];                                               // bytes 33 to 36
  UINT32BE occ_account;                                           // bytes 37 to 40
  UINT32BE cmta;                                                  // bytes 41 to 44
  UINT8 auction_event;                                            // byte 45
  UINT8 auction_type;                                             // byte 46
  UINT32BE auction_duration;                                      // bytes 47 to 50
  UINT32BE best_response_price;                                   // bytes 51 to 54, signed, read here as unsigned
  UINT32BE best_response_size;                                    // bytes 55 to 58
  UINT8 reserved_9[9];                                            // bytes 59 to 67
  UINT8 number_of_flex_dac_legs;                                  // byte 68
  UINT8 flex_dac_legs[(((UINT32) number_of_flex_dac_legs) * 8)];
} AuctionNotificationMessage;

// Informs the firm that its quotes for a given simple or complex instrument have been purged. Unsequenced.
typedef struct _InstrumentPurgeNotificationMessage {
  UINT32BE seconds;        // bytes 0 to 3
  UINT32BE nanoseconds;    // bytes 4 to 7
  UINT8 badge[4];          // bytes 8 to 11
  UINT64BE message_id;     // bytes 12 to 19
  UINT32BE instrument_id;  // bytes 20 to 23
  UINT8 purge_reason;      // byte 24
  UINT64BE sequence;       // bytes 25 to 32
  UINT8 reserved_16[16];   // bytes 33 to 48
} InstrumentPurgeNotificationMessage;

// Informs the firm that all the quotes for instruments associated with the given underlying have been purged (user request, Rapid Fire/ActiveQP risk protection or Kill-Switch). Unsequenced.
typedef struct _UnderlyingPurgeNotificationMessage {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
  UINT8 badge[4];        // bytes 8 to 11
  UINT8 underlying[13];  // bytes 12 to 24
  UINT8 purge_reason;    // byte 25
  UINT64BE message_id;   // bytes 26 to 33
  UINT64BE sequence;     // bytes 34 to 41
} UnderlyingPurgeNotificationMessage;

// Informs that risk protection triggered by rapid fire/purge has been reset for the specified scope. Unsequenced.
typedef struct _MarketReentryNotificationMessage {
  UINT32BE seconds;             // bytes 0 to 3
  UINT32BE nanoseconds;         // bytes 4 to 7
  UINT8 badge[4];               // bytes 8 to 11
  UINT8 underlying_symbol[13];  // bytes 12 to 24
  UINT8 reentry_scope;          // byte 25
  UINT64BE message_id;          // bytes 26 to 33
  UINT8 reserved_8[8];          // bytes 34 to 41
} MarketReentryNotificationMessage;

// The unsequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _ServerUnsequencedMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x4162: NotificationSubscriptionReplyMessage notification_subscription_reply_message;
    case 0x4163: AddComplexInstrumentReplyMessage add_complex_instrument_reply_message;
    case 0x4165: MmParameterDefinitionReplyMessage mm_parameter_definition_reply_message;
    case 0x4167: ActiveQpSelfReplenishmentSetLimitReplyMessage active_qp_self_replenishment_set_limit_reply_message;
    case 0x5153: QuoteBlockReplyMessage quote_block_reply_message;
    case 0x5173: DetailedQuoteBlockReplyMessage detailed_quote_block_reply_message;
    case 0x5072: UnderlyingPurgeReplyMessage underlying_purge_reply_message;
    case 0x5252: MarketReentryReplyMessage market_reentry_reply_message;
    case 0x5267: ActiveQpSelfReplenishmentRequestReentryReplyMessage active_qp_self_replenishment_request_reentry_reply_message;
    case 0x4E41: AuctionNotificationMessage auction_notification_message;
    case 0x4E44: InstrumentPurgeNotificationMessage instrument_purge_notification_message;
    case 0x4E55: UnderlyingPurgeNotificationMessage underlying_purge_notification_message;
    case 0x4E52: MarketReentryNotificationMessage market_reentry_notification_message;
    default: UINT8 unknown[available];
  }
} ServerUnsequencedMessage;

// The Unsequenced Data Packets sent by the server carry unsequenced messages from the server to the client. They are delivered on a best-effort basis and do not advance the sequence number
typedef struct _ServerUnsequencedDataPacket (UINT16 packet_length) where (packet_length >= 3) {
  UINT16BE server_unsequenced_message_type;                                                                                                                                              // bytes 0 to 1
  ServerUnsequencedMessage(server_unsequenced_message_type, (((UINT32) packet_length) - 3)) server_unsequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 3)];
} ServerUnsequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT32 length_2, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x55: ServerUnsequencedDataPacket(packet_length) server_unsequenced_data_packet[:byte-size-single-element-array length_2];
    case 0x48: unit server_heartbeat_packet;
    case 0x5A: unit end_of_session_packet;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// Sqf Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

