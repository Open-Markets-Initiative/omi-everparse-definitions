// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NtxOptions_Cti_v1_3_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53             // System Event Message
#define SEQUENCED_MESSAGE_TYPE_OPTIONS_DIRECTORY_MESSAGE 0x44        // Options Directory Message
#define SEQUENCED_MESSAGE_TYPE_SECURITY_TRADING_ACTION_MESSAGE 0x48  // Security Trading Action Message
#define SEQUENCED_MESSAGE_TYPE_TRADE_MESSAGE 0x54                    // Trade Message
#define SEQUENCED_MESSAGE_TYPE_CANCEL_TRADE_MESSAGE 0x56             // Cancel Trade Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F               // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53           // Start Of System Hours
#define EVENT_CODE_START_OF_OPENING_PROCESS 0x51        // Start Of Opening Process
#define EVENT_CODE_END_OF_NORMAL_HOURS_PROCESSING 0x4E  // End Of Normal Hours Processing
#define EVENT_CODE_END_OF_LATE_HOURS_PROCESSING 0x4C    // End Of Late Hours Processing
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45             // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                 // End Of Messages

// Option Kind: one byte code
#define OPTION_KIND_CALL 0x43       // Call
#define OPTION_KIND_PUT 0x50        // Put
#define OPTION_KIND_STOCK_LEG 0x20  // Stock Leg

// Option Closing Type: one byte code
#define OPTION_CLOSING_TYPE_NORMAL_HOURS 0x4E  // Normal Hours
#define OPTION_CLOSING_TYPE_LATE_HOURS 0x4C    // Late Hours

// Tradable: one byte code
#define TRADABLE_TRADABLE 0x59      // Tradable
#define TRADABLE_NOT_TRADABLE 0x4E  // Not Tradable

// Mpv: one byte code
#define MPV_PENNY_EVERYWHERE 0x45  // Penny Everywhere
#define MPV_SCALED 0x53            // Scaled
#define MPV_PENNY_PILOT 0x50       // Penny Pilot

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_HALT_IN_EFFECT 0x48   // Halt In Effect
#define CURRENT_TRADING_STATE_TRADING_RESUMED 0x54  // Trading Resumed

// Send Type: one byte code
#define SEND_TYPE_SEND 0x53                // Send
#define SEND_TYPE_POSSIBLE_DUPLICATE 0x50  // Possible Duplicate

// Transaction Type: one byte code
#define TRANSACTION_TYPE_NEW_TRADE 0x58         // New Trade
#define TRANSACTION_TYPE_TRADE_CORRECTION 0x59  // Trade Correction
#define TRANSACTION_TYPE_TRADE_CANCEL 0x5A      // Trade Cancel

// Liquidity: one byte code
#define LIQUIDITY_ADD 0x41                                 // Add
#define LIQUIDITY_REMOVE 0x52                              // Remove
#define LIQUIDITY_ORDER_EXPOSURE_ALERTED 0x4A              // Order Exposure Alerted
#define LIQUIDITY_EXECUTED_AGAINST_A_FLASH_ORDER 0x4B      // Executed Against A Flash Order
#define LIQUIDITY_OPENING_TRADE_CUSTOMER_TO_CUSTOMER 0x46  // Opening Trade Customer To Customer
#define LIQUIDITY_OPENING_TRADE 0x4F                       // Opening Trade
#define LIQUIDITY_NONE 0x4E                                // None

// Auction Type: one byte code
#define AUCTION_TYPE_SIMPLE_ORDER_PIXL_PRISM 0x50  // Simple Order Pixl Prism
#define AUCTION_TYPE_OPENING 0x4F                  // Opening
#define AUCTION_TYPE_MARKET_EXHAUST 0x45           // Market Exhaust
#define AUCTION_TYPE_NO_AUCTION 0x20               // No Auction

// Execution Type: one byte code
#define EXECUTION_TYPE_AUTOMATIC 0x41  // Automatic
#define EXECUTION_TYPE_MANUAL 0x4D     // Manual

// Execution Market: one byte code
#define EXECUTION_MARKET_AMEX 0x41            // Amex
#define EXECUTION_MARKET_BOX 0x42             // Box
#define EXECUTION_MARKET_CBOE 0x43            // Cboe
#define EXECUTION_MARKET_ISE 0x49             // Ise
#define EXECUTION_MARKET_NYSE 0x4E            // Nyse
#define EXECUTION_MARKET_NASDAQ 0x51          // Nasdaq
#define EXECUTION_MARKET_C_2 0x57             // C 2
#define EXECUTION_MARKET_BATS 0x5A            // Bats
#define EXECUTION_MARKET_PHLX 0x58            // Phlx
#define EXECUTION_MARKET_BX_OPTIONS 0x54      // Bx Options
#define EXECUTION_MARKET_MIAX 0x4D            // Miax
#define EXECUTION_MARKET_ISE_GEMINI 0x48      // Ise Gemini
#define EXECUTION_MARKET_BATS_EDGX 0x45       // Bats Edgx
#define EXECUTION_MARKET_ISE_MERCURY 0x4A     // Ise Mercury
#define EXECUTION_MARKET_MIAX_PEARL 0x50      // Miax Pearl
#define EXECUTION_MARKET_NOT_AWAY_TRADE 0x20  // Not Away Trade

// Trade Side: one byte code
#define TRADE_SIDE_BUY 0x42   // Buy
#define TRADE_SIDE_SELL 0x53  // Sell

// Side Changed: one byte code
#define SIDE_CHANGED_YES 0x59  // Yes
#define SIDE_CHANGED_NO 0x4E   // No

// Capacity: one byte code
#define CAPACITY_CUSTOMER 0x43                     // Customer
#define CAPACITY_BROKER_DEALER 0x59                // Broker Dealer
#define CAPACITY_PROFESSIONAL_CUSTOMER 0x50        // Professional Customer
#define CAPACITY_FIRM 0x46                         // Firm
#define CAPACITY_MARKET_MAKER 0x4D                 // Market Maker
#define CAPACITY_NON_REGISTERED_MARKET_MAKER 0x4F  // Non Registered Market Maker
#define CAPACITY_JOINT_BACK_OFFICE 0x4A            // Joint Back Office

// Origin Market: one byte code
#define ORIGIN_MARKET_AMEX 0x41            // Amex
#define ORIGIN_MARKET_BOX 0x42             // Box
#define ORIGIN_MARKET_CBOE 0x43            // Cboe
#define ORIGIN_MARKET_ISE 0x49             // Ise
#define ORIGIN_MARKET_NYSE 0x4E            // Nyse
#define ORIGIN_MARKET_NASDAQ 0x51          // Nasdaq
#define ORIGIN_MARKET_C_2 0x57             // C 2
#define ORIGIN_MARKET_BATS 0x5A            // Bats
#define ORIGIN_MARKET_PHLX 0x58            // Phlx
#define ORIGIN_MARKET_BX_OPTIONS 0x54      // Bx Options
#define ORIGIN_MARKET_MIAX 0x4D            // Miax
#define ORIGIN_MARKET_ISE_GEMINI 0x48      // Ise Gemini
#define ORIGIN_MARKET_BATS_EDGX 0x45       // Bats Edgx
#define ORIGIN_MARKET_ISE_MERCURY 0x4A     // Ise Mercury
#define ORIGIN_MARKET_MIAX_PEARL 0x50      // Miax Pearl
#define ORIGIN_MARKET_NOT_APPLICABLE 0x20  // Not Applicable

// Contra Capacity: one byte code
#define CONTRA_CAPACITY_CUSTOMER 0x43                     // Customer
#define CONTRA_CAPACITY_BROKER_DEALER 0x59                // Broker Dealer
#define CONTRA_CAPACITY_PROFESSIONAL_CUSTOMER 0x50        // Professional Customer
#define CONTRA_CAPACITY_FIRM 0x46                         // Firm
#define CONTRA_CAPACITY_MARKET_MAKER 0x4D                 // Market Maker
#define CONTRA_CAPACITY_NON_REGISTERED_MARKET_MAKER 0x4F  // Non Registered Market Maker
#define CONTRA_CAPACITY_NOT_APPLICABLE 0x20               // Not Applicable
#define CONTRA_CAPACITY_JOINT_BACK_OFFICE 0x4A            // Joint Back Office

// Short Sell: one byte code
#define SHORT_SELL_SHORT_SALE 0x59         // Short Sale
#define SHORT_SELL_NOT_A_SHORT_SALE 0x4E   // Not A Short Sale
#define SHORT_SELL_SHORT_SALE_EXEMPT 0x45  // Short Sale Exempt
#define SHORT_SELL_NOT_APPLICABLE 0x20     // Not Applicable

// Principal Agent: one byte code
#define PRINCIPAL_AGENT_AGENCY 0x41              // Agency
#define PRINCIPAL_AGENT_PRINCIPAL 0x50           // Principal
#define PRINCIPAL_AGENT_RISKLESS_PRINCIPAL 0x52  // Riskless Principal
#define PRINCIPAL_AGENT_NOT_A_STOCK_LEG 0x20     // Not A Stock Leg

// Origin Type: one byte code
#define ORIGIN_TYPE_FIX_ORDER 0x4F                      // Fix Order
#define ORIGIN_TYPE_OTTO_QUO_ORDER 0x54                 // Otto Quo Order
#define ORIGIN_TYPE_OTTO_SWEEP 0x45                     // Otto Sweep
#define ORIGIN_TYPE_SQF_QUOTE 0x51                      // Sqf Quote
#define ORIGIN_TYPE_SQF_SWEEP 0x57                      // Sqf Sweep
#define ORIGIN_TYPE_PIXL_PRISM_PRIMARY_FIX_ORDER 0x47   // Pixl Prism Primary Fix Order
#define ORIGIN_TYPE_PIXL_PRISM_CONTRA_FIX_ORDER 0x48    // Pixl Prism Contra Fix Order
#define ORIGIN_TYPE_PIXL_PRISM_RESPONSE_FIX_ORDER 0x49  // Pixl Prism Response Fix Order
#define ORIGIN_TYPE_PIXL_PRISM_RESPONSE_SQF_SWEEP 0x4A  // Pixl Prism Response Sqf Sweep
#define ORIGIN_TYPE_OTHERS 0x20                         // Others

// Tif: one byte code
#define TIF_IOC 0x49             // Ioc
#define TIF_DAY 0x44             // Day
#define TIF_GTC 0x47             // Gtc
#define TIF_OPG 0x4F             // Opg
#define TIF_NOT_APPLICABLE 0x20  // Not Applicable

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// The system event message is used to signal a ring wide event. 11 bytes.
typedef struct _SystemEventMessage {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
  UINT8 event_code;      // byte 8
  UINT8 version;         // byte 9
} SystemEventMessage;

// At the start of each trading day, the exchange disseminates directory messages for all symbols trading on a given ring. Sent once per symbol, typically before the Start of System Hours System Event; intra-day updates are sent as they occur. 42 bytes.
typedef struct _OptionsDirectoryMessage {
  UINT32BE seconds;               // bytes 0 to 3
  UINT32BE nanoseconds;           // bytes 4 to 7
  UINT32BE option_id;             // bytes 8 to 11
  UINT8 security_symbol[5];       // bytes 12 to 16
  UINT16BE expiration_year : 7;   // bytes 17 to 18
  UINT16BE expiration_month : 4;  // bytes 17 to 18
  UINT16BE expiration_day : 5;    // bytes 17 to 18
  UINT32BE strike_price;          // bytes 19 to 22
  UINT8 option_kind;              // byte 23
  UINT8 source;                   // byte 24
  UINT8 underlying_symbol[13];    // bytes 25 to 37
  UINT8 option_closing_type;      // byte 38
  UINT8 tradable;                 // byte 39
  UINT8 mpv;                      // byte 40
} OptionsDirectoryMessage;

// Indicates the current trading status of an option within the exchange. A T (Trading resumed) message is sent for all options eligible for trading at the start of system hours; a security absent from the pre-opening spin should be treated as halted. 26 bytes.
typedef struct _SecurityTradingActionMessage {
  UINT32BE seconds;               // bytes 0 to 3
  UINT32BE nanoseconds;           // bytes 4 to 7
  UINT32BE option_id;             // bytes 8 to 11
  UINT8 security_symbol[5];       // bytes 12 to 16
  UINT16BE expiration_year : 7;   // bytes 17 to 18
  UINT16BE expiration_month : 4;  // bytes 17 to 18
  UINT16BE expiration_day : 5;    // bytes 17 to 18
  UINT32BE strike_price;          // bytes 19 to 22
  UINT8 option_kind;              // byte 23
  UINT8 current_trading_state;    // byte 24
} SecurityTradingActionMessage;

// Clearing trades and trade corrections, with contra side clearing information (trade cancels too when a firm and connection block is configured for extended cancels, Transaction Type Z). 310 bytes. Contra side clearing fields carry a Contra prefix.
typedef struct _TradeMessage {
  UINT32BE seconds;                             // bytes 0 to 3
  UINT32BE nanoseconds;                         // bytes 4 to 7
  UINT8 send_type;                              // byte 8
  UINT32BE option_id;                           // bytes 9 to 12
  UINT8 underlying_symbol[13];                  // bytes 13 to 25
  UINT8 security_symbol[5];                     // bytes 26 to 30
  UINT16BE expiration_year : 7;                 // bytes 31 to 32
  UINT16BE expiration_month : 4;                // bytes 31 to 32
  UINT16BE expiration_day : 5;                  // bytes 31 to 32
  UINT32BE strike_price;                        // bytes 33 to 36
  UINT8 option_kind;                            // byte 37
  UINT16BE penny_pilot : 1;                     // bytes 38 to 39
  UINT16BE make_take_program : 1;               // bytes 38 to 39
  UINT16BE single_listed : 1;                   // bytes 38 to 39
  UINT16BE weekly_expiration : 1;               // bytes 38 to 39
  UINT16BE monthly_expiration : 1;              // bytes 38 to 39
  UINT16BE quarterly_expiration : 1;            // bytes 38 to 39
  UINT16BE reserved_trade_flags : 10;           // bytes 38 to 39
  UINT8 transaction_type;                       // byte 40
  UINT8 liquidity;                              // byte 41
  UINT32BE trade_id;                            // bytes 42 to 45
  UINT16BE correction_number;                   // bytes 46 to 47
  UINT32BE cross_id;                            // bytes 48 to 51
  UINT32BE match_id;                            // bytes 52 to 55
  UINT32BE auction_id;                          // bytes 56 to 59
  UINT8 auction_type;                           // byte 60
  UINT32BE ref_trade_id;                        // bytes 61 to 64
  UINT16BE ref_correction_number;               // bytes 65 to 66
  UINT8 execution_type;                         // byte 67
  UINT8 execution_market;                       // byte 68
  UINT8 trade_side;                             // byte 69
  UINT32BE trade_price;                         // bytes 70 to 73
  UINT32BE trade_contracts;                     // bytes 74 to 77
  UINT8 side_changed;                           // byte 78
  UINT32BE strategy_id;                         // bytes 79 to 82
  UINT16BE strategy_leg;                        // bytes 83 to 84
  UINT8 reserved_8[8];                          // bytes 85 to 92
  UINT32BE occ_clearing_number;                 // bytes 93 to 96
  UINT32BE give_up_occ_clearing_number;         // bytes 97 to 100
  UINT32BE exchange_clearing_number;            // bytes 101 to 104
  UINT32BE exchange_house;                      // bytes 105 to 108
  UINT8 exchange_suffix;                        // byte 109
  UINT8 capacity;                               // byte 110
  UINT8 multi_account[5];                       // bytes 111 to 115
  UINT32BE broker;                              // bytes 116 to 119
  UINT32BE second_broker;                       // bytes 120 to 123
  UINT8 origin_market;                          // byte 124
  UINT8 account[32];                            // bytes 125 to 156
  UINT32BE nscc;                                // bytes 157 to 160
  UINT8 mpid[5];                                // bytes 161 to 165
  UINT16BE priority_market_maker : 1;           // bytes 166 to 167
  UINT16BE reserved_clearing_flags : 15;        // bytes 166 to 167
  UINT8 reserved_6[6];                          // bytes 168 to 173
  UINT32BE contra_occ_clearing_number;          // bytes 174 to 177
  UINT32BE contra_give_up_occ_clearing_number;  // bytes 178 to 181
  UINT32BE contra_exchange_clearing_number;     // bytes 182 to 185
  UINT32BE contra_exchange_house;               // bytes 186 to 189
  UINT8 contra_capacity;                        // byte 190
  UINT32BE contra_broker;                       // bytes 191 to 194
  UINT32BE contra_second_broker;                // bytes 195 to 198
  UINT32BE contra_nscc;                         // bytes 199 to 202
  UINT8 contra_mpid[5];                         // bytes 203 to 207
  UINT8 second_reserved_8[8];                   // bytes 208 to 215
  UINT8 firm[4];                                // bytes 216 to 219
  UINT16BE order_date_year : 7;                 // bytes 220 to 221
  UINT16BE order_date_month : 4;                // bytes 220 to 221
  UINT16BE order_date_day : 5;                  // bytes 220 to 221
  UINT8 order_id[30];                           // bytes 222 to 251
  UINT64BE quote_id;                            // bytes 252 to 259
  UINT64BE sweep_id;                            // bytes 260 to 267
  UINT8 open_close_indicator;                   // byte 268
  UINT8 customer_strategy_leg[5];               // bytes 269 to 273
  UINT8 short_sell;                             // byte 274
  UINT8 principal_agent;                        // byte 275
  UINT8 supplementary_id[13];                   // bytes 276 to 288
  UINT16BE fbms_order : 1;                      // bytes 289 to 290
  UINT16BE directed : 1;                        // bytes 289 to 290
  UINT16BE post_only : 1;                       // bytes 289 to 290
  UINT16BE mkt_order : 1;                       // bytes 289 to 290
  UINT16BE reserved_order_indicators : 12;      // bytes 289 to 290
  UINT8 origin_type;                            // byte 291
  UINT32BE order_size;                          // bytes 292 to 295
  UINT32BE order_price;                         // bytes 296 to 299
  UINT8 tif;                                    // byte 300
  UINT8 third_reserved_8[8];                    // bytes 301 to 308
} TradeMessage;

// By default CTI sends trade cancels using this message; alternatively a firm and connection block can be configured to send extended cancels with all the trade information using the Trade message with Transaction Type Z. 50 bytes.
typedef struct _CancelTradeMessage {
  UINT32BE seconds;               // bytes 0 to 3
  UINT32BE nanoseconds;           // bytes 4 to 7
  UINT8 send_type;                // byte 8
  UINT32BE option_id;             // bytes 9 to 12
  UINT8 underlying_symbol[13];    // bytes 13 to 25
  UINT8 security_symbol[5];       // bytes 26 to 30
  UINT16BE expiration_year : 7;   // bytes 31 to 32
  UINT16BE expiration_month : 4;  // bytes 31 to 32
  UINT16BE expiration_day : 5;    // bytes 31 to 32
  UINT32BE strike_price;          // bytes 33 to 36
  UINT8 option_kind;              // byte 37
  UINT32BE trade_id;              // bytes 38 to 41
  UINT16BE correction_number;     // bytes 42 to 43
  UINT32BE cross_id;              // bytes 44 to 47
  UINT8 trade_side;               // byte 48
} CancelTradeMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x44: OptionsDirectoryMessage options_directory_message;
    case 0x48: SecurityTradingActionMessage security_trading_action_message;
    case 0x54: TradeMessage trade_message;
    case 0x56: CancelTradeMessage cancel_trade_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat;
    case 0x5A: unit end_of_session;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

