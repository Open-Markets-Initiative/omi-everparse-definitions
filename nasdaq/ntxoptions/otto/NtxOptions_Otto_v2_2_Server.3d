} OrderReplacedMessage;

// ---- Order Cancelled Message: 25 bytes ---------------------------------------

// An Order Cancelled Message informs you that an order has been fully cancelled. This could be acknowledging a Cancel Order Message, or it could be the result of the order being cancelled automatically by the system.
entrypoint typedef struct _OrderCancelledMessage {
  UINT64BE timestamp;      // bytes 0 to 7
  UINT8 firm_id[4];        // bytes 8 to 11
  UINT32BE instrument_id;  // bytes 12 to 15
  UINT64BE order_id;       // bytes 16 to 23
  UINT8 cancel_reason;     // byte 24
} OrderCancelledMessage;

