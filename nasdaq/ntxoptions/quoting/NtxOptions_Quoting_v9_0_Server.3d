} ComplexMsarAcceptMessage;

// ---- Complex Msar Reject Message: 13 bytes -----------------------------------

// The Complex MSAR Request is invalid and therefore rejected. Sequenced.
entrypoint typedef struct _ComplexMsarRejectMessage {
