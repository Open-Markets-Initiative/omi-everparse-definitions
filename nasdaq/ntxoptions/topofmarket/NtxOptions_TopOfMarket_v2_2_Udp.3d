} MessageHeader;

// ---- System Event Message: 11 bytes ------------------------------------------

// The system event message type is used to signal a market or data feed handler event.
entrypoint typedef struct _SystemEventMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT64BE timestamp;        // bytes 2 to 9
  UINT8 event_code;          // byte 10
} SystemEventMessage;

// ---- Derivative Directory Message: 86 bytes ----------------------------------

// At the start of each trading day, Nasdaq disseminates options symbol directory messages for all active options symbols in the system.
entrypoint typedef struct _DerivativeDirectoryMessage {
  UINT16BE tracking_number;        // bytes 0 to 1
  UINT64BE timestamp;              // bytes 2 to 9
  UINT32BE instrument_id;          // bytes 10 to 13
