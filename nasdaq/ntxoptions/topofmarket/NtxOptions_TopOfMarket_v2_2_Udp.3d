  UINT32BE pro_cust_size_long;      // bytes 31 to 34
} BestBidOrAskUpdateLongFormMessage;

// ---- Trade Report Message: 27 bytes ------------------------------------------

// Trade Report Message indicates that a trade has occurred for an options contract.
entrypoint typedef struct _TradeReportMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT64BE timestamp;        // bytes 2 to 9
