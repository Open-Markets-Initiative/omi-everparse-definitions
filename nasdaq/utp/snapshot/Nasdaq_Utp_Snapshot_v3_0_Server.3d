// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Nasdaq_Utp_Snapshot_v3_0_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Market Center Originator: one byte code
#define MARKET_CENTER_ORIGINATOR_CBOE_BYX_EXCHANGE_INC 0x59                    // Cboe Byx Exchange Inc
#define MARKET_CENTER_ORIGINATOR_CBOE_BZX_EXCHANGE_INC 0x5A                    // Cboe Bzx Exchange Inc
#define MARKET_CENTER_ORIGINATOR_CBOE_EDGA_EXCHANGE_INC 0x4A                   // Cboe Edga Exchange Inc
#define MARKET_CENTER_ORIGINATOR_CBOE_EDGX_EXCHANGE_INC 0x4B                   // Cboe Edgx Exchange Inc
#define MARKET_CENTER_ORIGINATOR_CBOE_EXCHANGE_INC 0x57                        // Cboe Exchange Inc
#define MARKET_CENTER_ORIGINATOR_NASDAQ_TEXAS_LLC 0x42                         // Nasdaq Texas Llc
#define MARKET_CENTER_ORIGINATOR_NASDAQ_PHLX_LLC 0x58                          // Nasdaq Phlx Llc
#define MARKET_CENTER_ORIGINATOR_NASDAQ_INC 0x51                               // Nasdaq Inc
#define MARKET_CENTER_ORIGINATOR_NASDAQ_ISE_LLC 0x49                           // Nasdaq Ise Llc
#define MARKET_CENTER_ORIGINATOR_NEW_YORK_STOCK_EXCHANGE_LLC 0x4E              // New York Stock Exchange Llc
#define MARKET_CENTER_ORIGINATOR_NYSE_ARCA_INC 0x50                            // Nyse Arca Inc
#define MARKET_CENTER_ORIGINATOR_NYSE_AMERICAN_LLC 0x41                        // Nyse American Llc
#define MARKET_CENTER_ORIGINATOR_NYSE_NATIONAL_INC 0x43                        // Nyse National Inc
#define MARKET_CENTER_ORIGINATOR_NYSE_TEXAS 0x4D                               // Nyse Texas
#define MARKET_CENTER_ORIGINATOR_TEXAS_STOCK_EXCHANGE_LLC 0x46                 // Texas Stock Exchange Llc
#define MARKET_CENTER_ORIGINATOR_N24_X_NATIONAL_EXCHANGE_L_L_C 0x47            // N24X National Exchange LLC
#define MARKET_CENTER_ORIGINATOR_FINANCIAL_INDUSTRY_REGULATORY_AUTHORITY 0x44  // Financial Industry Regulatory Authority
#define MARKET_CENTER_ORIGINATOR_INVESTORS_EXCHANGE_LLC 0x56                   // Investors Exchange Llc
#define MARKET_CENTER_ORIGINATOR_LONG_TERM_STOCK_EXCHANGE 0x4C                 // Long Term Stock Exchange
#define MARKET_CENTER_ORIGINATOR_MIAX_PEARL_LLC 0x48                           // Miax Pearl Llc
#define MARKET_CENTER_ORIGINATOR_MEMX_LLC 0x55                                 // Memx Llc
#define MARKET_CENTER_ORIGINATOR_MARKET_INDEPENDENT_GENERATED_BY_SIP 0x45      // Market Independent Generated By Sip

// Sub Market Center Id: one byte code
#define SUB_MARKET_CENTER_ID_FINRA_NYSE_TRF 0x4E                                            // Finra Nyse Trf
#define SUB_MARKET_CENTER_ID_FINRA_NASDAQ_TRF_CARTERET 0x51                                 // Finra Nasdaq Trf Carteret
#define SUB_MARKET_CENTER_ID_FINRA_NASDAQ_TRF_CHICAGO 0x42                                  // Finra Nasdaq Trf Chicago
#define SUB_MARKET_CENTER_ID_TRADE_ORIGINATES_FROM_FINRA_ALTERNATIVE_DISPLAY_FACILITY 0x20  // Trade Originates From Finra Alternative Display Facility

// Issue Type: one byte code
#define ISSUE_TYPE_AMERICAN_DEPOSITORY_RECEIPT 0x41    // American Depository Receipt
#define ISSUE_TYPE_BOND 0x42                           // Bond
#define ISSUE_TYPE_COMMON_STOCK 0x43                   // Common Stock
#define ISSUE_TYPE_DEPOSITORY_RECEIPT 0x46             // Depository Receipt
#define ISSUE_TYPE_SEC_144_A 0x49                      // Sec 144 A
#define ISSUE_TYPE_LIMITED_PARTNERSHIP 0x4C            // Limited Partnership
#define ISSUE_TYPE_NOTE 0x4E                           // Note
#define ISSUE_TYPE_ORDINARY_SHARES 0x4F                // Ordinary Shares
#define ISSUE_TYPE_PREFERRED_STOCK 0x50                // Preferred Stock
#define ISSUE_TYPE_OTHER_SECURITIES 0x51               // Other Securities
#define ISSUE_TYPE_RIGHTS 0x52                         // Rights
#define ISSUE_TYPE_SHARES_OF_BENEFICIAL_INTEREST 0x53  // Shares Of Beneficial Interest
#define ISSUE_TYPE_CONVERTIBLE_DEBENTURE 0x54          // Convertible Debenture
#define ISSUE_TYPE_UNIT 0x55                           // Unit
#define ISSUE_TYPE_UNITS_OF_BENEFICIAL_INTEREST 0x56   // Units Of Beneficial Interest
#define ISSUE_TYPE_WARRANT 0x57                        // Warrant

// Market Tier: one byte code
#define MARKET_TIER_NASDAQ_GLOBAL_SELECT_MARKET 0x51  // Nasdaq Global Select Market
#define MARKET_TIER_NASDAQ_GLOBAL_MARKET 0x47         // Nasdaq Global Market
#define MARKET_TIER_NASDAQ_CAPITAL_MARKET 0x53        // Nasdaq Capital Market

// Authenticity: one byte code
#define AUTHENTICITY_LIVE_PRODUCTION 0x50  // Live Production
#define AUTHENTICITY_TEST 0x54             // Test
#define AUTHENTICITY_DEMO 0x44             // Demo
#define AUTHENTICITY_DELETED 0x58          // Deleted

// Short Sale Threshold Indicator: one byte code
#define SHORT_SALE_THRESHOLD_INDICATOR_ISSUE_IS_RESTRICTED_UNDER_SEC_RULE_203_B_3 0x59  // Issue Is Restricted Under Sec Rule 203 B 3
#define SHORT_SALE_THRESHOLD_INDICATOR_ISSUE_IS_NOT_RESTRICTED 0x4E                     // Issue Is Not Restricted
#define SHORT_SALE_THRESHOLD_INDICATOR_THRESHOLD_INDICATOR_NOT_AVAILABLE 0x20           // Threshold Indicator Not Available

// Financial Status Indicator: one byte code
#define FINANCIAL_STATUS_INDICATOR_CREATIONS_ANDOR_REDEMPTIONS_SUSPENDED_FOR_EXCHANGE_TRADED_PRODUCT 0x43      // Creations Andor Redemptions Suspended For Exchange Traded Product
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_ISSUER_FAILED_TO_MEET_NASDAQ_CONTINUED_LISTING_REQUIREMENTS 0x44  // Deficient Issuer Failed To Meet Nasdaq Continued Listing Requirements
#define FINANCIAL_STATUS_INDICATOR_DELINQUENT_ISSUER_MISSED_REGULATORY_FILING_DEADLINE 0x45                    // Delinquent Issuer Missed Regulatory Filing Deadline
#define FINANCIAL_STATUS_INDICATOR_BANKRUPT_ISSUER_HAS_FILED_FOR_BANKRUPTCY 0x51                               // Bankrupt Issuer Has Filed For Bankruptcy
#define FINANCIAL_STATUS_INDICATOR_NORMAL_DEFAULT_ISSUER_IS_NOT_DEFICIENT_DELINQUENT_OR_BANKRUPT 0x4E          // Normal Default Issuer Is Not Deficient Delinquent Or Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_AND_BANKRUPT 0x47                                                 // Deficient And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_AND_DELINQUENT 0x48                                               // Deficient And Delinquent
#define FINANCIAL_STATUS_INDICATOR_DELINQUENT_AND_BANKRUPT 0x4A                                                // Delinquent And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_DELINQUENT_AND_BANKRUPT 0x4B                                      // Deficient Delinquent And Bankrupt

// Mpi Tick: one byte code
#define MPI_TICK_PENNY_MPI 0x50                                          // Penny Mpi
#define MPI_TICK_HALF_PENNY_MPI_EFFECTIVE_NOV_2026_PER_SEC_MANDATE 0x48  // Half Penny Mpi Effective Nov 2026 Per Sec Mandate

// Trading State: one byte code
#define TRADING_STATE_HALTED 0x48   // Halted
#define TRADING_STATE_TRADING 0x54  // Trading

// Reg Sho Action: one byte code
#define REG_SHO_ACTION_NO_PRICE_TEST_IN_EFFECT 0x30                                       // No Price Test In Effect
#define REG_SHO_ACTION_REG_SHO_IN_EFFECT_DUE_TO_AN_INTRA_DAY_PRICE_DROP_IN_SECURITY 0x31  // Reg Sho In Effect Due To An Intra Day Price Drop In Security
#define REG_SHO_ACTION_REG_SHO_RESTRICTION_REMAINS_IN_EFFECT 0x32                         // Reg Sho Restriction Remains In Effect

// Trading Action Code: one byte code
#define TRADING_ACTION_CODE_TRADING_HALT 0x48                              // Trading Halt
#define TRADING_ACTION_CODE_QUOTATION_RESUMPTION_INCLUDING_AFTER_EMA 0x51  // Quotation Resumption Including After Ema
#define TRADING_ACTION_CODE_TRADING_RESUMPTION 0x54                        // Trading Resumption
#define TRADING_ACTION_CODE_VOLATILITY_TRADING_PAUSE 0x50                  // Volatility Trading Pause

// Luld Price Band Indicator: one byte code
#define LULD_PRICE_BAND_INDICATOR_OPENING_UPDATE 0x41                                  // Opening Update
#define LULD_PRICE_BAND_INDICATOR_INTRA_DAY_UPDATE 0x42                                // Intra Day Update
#define LULD_PRICE_BAND_INDICATOR_RESTATED_VALUE 0x43                                  // Restated Value
#define LULD_PRICE_BAND_INDICATOR_SUSPENDED_DURING_TRADING_HALT_OR_TRADING_PAUSE 0x44  // Suspended During Trading Halt Or Trading Pause
#define LULD_PRICE_BAND_INDICATOR_RE_OPENING_UPDATE 0x45                               // Re Opening Update
#define LULD_PRICE_BAND_INDICATOR_OUTSIDE_PRICE_BAND_RULE_HOURS 0x46                   // Outside Price Band Rule Hours
#define LULD_PRICE_BAND_INDICATOR_NONE_PROVIDED 0x20                                   // None Provided

// Quote Condition: one byte code
#define QUOTE_CONDITION_MANUAL_ASK_AUTOMATED_BID 0x41                          // Manual Ask Automated Bid
#define QUOTE_CONDITION_MANUAL_BID_AUTOMATED_ASK 0x42                          // Manual Bid Automated Ask
#define QUOTE_CONDITION_FAST_TRADING 0x46                                      // Fast Trading
#define QUOTE_CONDITION_MANUAL_BID_AND_ASK 0x48                                // Manual Bid And Ask
#define QUOTE_CONDITION_ORDER_IMBALANCE 0x49                                   // Order Imbalance
#define QUOTE_CONDITION_CLOSED_QUOTE 0x4C                                      // Closed Quote
#define QUOTE_CONDITION_NON_FIRM_QUOTE 0x4E                                    // Non Firm Quote
#define QUOTE_CONDITION_OPENING_QUOTE_AUTOMATED 0x4F                           // Opening Quote Automated
#define QUOTE_CONDITION_REGULAR_TWO_SIDED_OPEN_QUOTE_AUTOMATED 0x52            // Regular Two Sided Open Quote Automated
#define QUOTE_CONDITION_MANUAL_BID_AND_ASK_NON_FIRM 0x55                       // Manual Bid And Ask Non Firm
#define QUOTE_CONDITION_ORDER_INFLUX 0x58                                      // Order Influx
#define QUOTE_CONDITION_AUTOMATED_BID_NO_OFFER_OR_AUTOMATED_OFFER_NO_BID 0x59  // Automated Bid No Offer Or Automated Offer No Bid
#define QUOTE_CONDITION_NO_OPEN_NO_RESUME 0x5A                                 // No Open No Resume
#define QUOTE_CONDITION_INTRADAY_AUCTION 0x34                                  // Intraday Auction

// Sip Generated Update Flag: one byte code
#define SIP_GENERATED_UPDATE_FLAG_TRANSACTION_ORIGINATED_FROM_MARKET_PARTICIPANT 0x20  // Transaction Originated From Market Participant
#define SIP_GENERATED_UPDATE_FLAG_SIP_GENERATED_TRANSACTION_EG_PRICE_BAND_CHANGE 0x45  // Sip Generated Transaction Eg Price Band Change

// Luld Bbo Indicator: one byte code
#define LULD_BBO_INDICATOR_LIMIT_UP_LIMIT_DOWN_NOT_APPLICABLE 0x20                            // Limit Up Limit Down Not Applicable
#define LULD_BBO_INDICATOR_BID_PRICE_ABOVE_UPPER_LIMIT_PRICE_BAND_BID_IS_NON_EXECUTABLE 0x41  // Bid Price Above Upper Limit Price Band Bid Is Non Executable
#define LULD_BBO_INDICATOR_ASK_PRICE_BELOW_LOWER_LIMIT_PRICE_BAND_ASK_IS_NON_EXECUTABLE 0x42  // Ask Price Below Lower Limit Price Band Ask Is Non Executable
#define LULD_BBO_INDICATOR_BID_AND_ASK_OUTSIDE_PRICE_BAND_NOT_EXECUTABLE 0x43                 // Bid And Ask Outside Price Band Not Executable

// Retail Interest Indicator: one byte code
#define RETAIL_INTEREST_INDICATOR_RETAIL_INTEREST_NOT_APPLICABLE 0x20             // Retail Interest Not Applicable
#define RETAIL_INTEREST_INDICATOR_RETAIL_INTEREST_ON_BID_QUOTE 0x41               // Retail Interest On Bid Quote
#define RETAIL_INTEREST_INDICATOR_RETAIL_INTEREST_ON_ASK_QUOTE 0x42               // Retail Interest On Ask Quote
#define RETAIL_INTEREST_INDICATOR_RETAIL_INTEREST_ON_BOTH_BID_AND_ASK_QUOTE 0x43  // Retail Interest On Both Bid And Ask Quote

// Nbbo Appendage Indicator: one byte code
#define NBBO_APPENDAGE_INDICATOR_NO_NATIONAL_BBO_CHANGE 0x30                       // No National Bbo Change
#define NBBO_APPENDAGE_INDICATOR_NO_NATIONAL_BBO_CAN_BE_CALCULATED 0x31            // No National Bbo Can Be Calculated
#define NBBO_APPENDAGE_INDICATOR_SHORT_FORM_NATIONAL_BBO_APPENDAGE_ATTACHED 0x32   // Short Form National Bbo Appendage Attached
#define NBBO_APPENDAGE_INDICATOR_LONG_FORM_NATIONAL_BBO_APPENDAGE_ATTACHED 0x33    // Long Form National Bbo Appendage Attached
#define NBBO_APPENDAGE_INDICATOR_QUOTE_CONTAINS_ALL_NATIONAL_BBO_INFORMATION 0x34  // Quote Contains All National Bbo Information

// Luld National Bbo Indicator: one byte code
#define LULD_NATIONAL_BBO_INDICATOR_LIMIT_UP_LIMIT_DOWN_NOT_APPLICABLE 0x20                                                // Limit Up Limit Down Not Applicable
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_BID_AND_NATIONAL_BEST_ASK_ARE_EXECUTABLE 0x41                            // National Best Bid And National Best Ask Are Executable
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_BID_BELOW_LOWER_LIMIT_PRICE_BAND_NON_EXECUTABLE 0x42                     // National Best Bid Below Lower Limit Price Band Non Executable
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_ASK_ABOVE_UPPER_LIMIT_PRICE_BAND_NON_EXECUTABLE 0x43                     // National Best Ask Above Upper Limit Price Band Non Executable
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_BID_BELOW_LOWER_AND_NATIONAL_BEST_ASK_ABOVE_UPPER_LIMIT_PRI_mkd879 0x44  // National Best Bid Below Lower And National Best Ask Above Upper Limit Price Bands Non Executable
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_BID_EQUALS_UPPER_LIMIT_PRICE_BAND_NATIONAL_BEST_BID_IS_IN_L_ihlswq 0x45  // National Best Bid Equals Upper Limit Price Band National Best Bid Is In Limit State
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_OFFER_EQUALS_LOWER_LIMIT_PRICE_BAND_NATIONAL_BEST_ASK_IS_IN_e1d2fy 0x46  // National Best Offer Equals Lower Limit Price Band National Best Ask Is In Limit State
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_BID_EQUALS_UPPER_LIMIT_PRICE_BAND_IN_LIMIT_STATE_AND_NATION_30tjkz 0x47  // National Best Bid Equals Upper Limit Price Band In Limit State And National Best Ask Above Upper Limit Price Band Non Executable
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_ASK_EQUALS_LOWER_LIMIT_PRICE_BAND_IN_LIMIT_STATE_AND_NATION_xswsrz 0x48  // National Best Ask Equals Lower Limit Price Band In Limit State And National Best Bid Below Lower Limit Price Band Non Executable
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_BID_EQUALS_UPPER_LIMIT_PRICE_BAND_AND_NATIONAL_BEST_ASK_EQU_blt7a5 0x49  // National Best Bid Equals Upper Limit Price Band And National Best Ask Equals Lower Limit Price Band Crossed Not In Limit State

// Finra Adf Mpid Appendage Indicator: one byte code
#define FINRA_ADF_MPID_APPENDAGE_INDICATOR_NOT_APPLICABLE_QUOTATION_ORIGINATES_FROM_A_UTP_PARTICIPANT_OTHER_THAN_FINRA 0x20  // Not Applicable Quotation Originates From A Utp Participant Other Than Finra
#define FINRA_ADF_MPID_APPENDAGE_INDICATOR_NO_ADF_MPID_CHANGES_CURRENT_ADF_QUOTE_DOES_NOT_AFFECT_THE_FINRA_MPID 0x30         // No Adf Mpid Changes Current Adf Quote Does Not Affect The Finra Mpid
#define FINRA_ADF_MPID_APPENDAGE_INDICATOR_NO_ADF_MPID_EXISTS_NO_CALCULATION_OF_THE_FINRA_MPID 0x31                          // No Adf Mpid Exists No Calculation Of The Finra Mpid
#define FINRA_ADF_MPID_APPENDAGE_INDICATOR_ADF_MPI_DS_ATTACHED_FINRA_MPID_WAS_GENERATED 0x32                                 // Adf Mpi Ds Attached Finra Mpid Was Generated

// Bolo Appendage Indicator: one byte code
#define BOLO_APPENDAGE_INDICATOR_NO_BOLO_CHANGE 0x30                      // No Bolo Change
#define BOLO_APPENDAGE_INDICATOR_NO_BOLO_CAN_BE_CALCULATED 0x31           // No Bolo Can Be Calculated
#define BOLO_APPENDAGE_INDICATOR_SHORT_FORM_BOLO_APPENDAGE_ATTACHED 0x32  // Short Form Bolo Appendage Attached
#define BOLO_APPENDAGE_INDICATOR_LONG_FORM_BOLO_APPENDAGE_ATTACHED 0x33   // Long Form Bolo Appendage Attached
#define BOLO_APPENDAGE_INDICATOR_MPID_FORM_BOLO_APPENDAGE_ATTACHED 0x35   // Mpid Form Bolo Appendage Attached

// Odd Lot Attachment Type: one byte code
#define ODD_LOT_ATTACHMENT_TYPE_NO_ODD_LOT_PRICE_LEVELS_ATTACHED 0x30          // No Odd Lot Price Levels Attached
#define ODD_LOT_ATTACHMENT_TYPE_SHORT_FORM_ODD_LOT_PRICE_LEVELS_ATTACHED 0x32  // Short Form Odd Lot Price Levels Attached
#define ODD_LOT_ATTACHMENT_TYPE_LONG_FORM_ODD_LOT_PRICE_LEVELS_ATTACHED 0x33   // Long Form Odd Lot Price Levels Attached
#define ODD_LOT_ATTACHMENT_TYPE_MPID_FORM_ODD_LOT_PRICE_LEVELS_ATTACHED 0x35   // Mpid Form Odd Lot Price Levels Attached

// Side: one byte code
#define SIDE_UPDATE_FOR_THE_BID_SIDE 0x42  // Update For The Bid Side
#define SIDE_UPDATE_FOR_THE_ASK_SIDE 0x41  // Update For The Ask Side

// ---- Types -------------------------------------------------------------------

// Issue Symbol Directory Message providing reference data for NASDAQ-listed securities. To be retired in Q1 2027 in favor of the Enhanced Issue Symbol Directory Message (Type F).
typedef struct _IssueSymbolDirectoryMessage {
  UINT8 market_center_originator;        // byte 0
  UINT8 sub_market_center_id;            // byte 1
  UINT64BE sip_timestamp;                // bytes 2 to 9
  UINT64BE timestamp_1;                  // bytes 10 to 17
  UINT64BE participant_token;            // bytes 18 to 25
  UINT8 symbol[11];                      // bytes 26 to 36
  UINT8 old_symbol[11];                  // bytes 37 to 47
  UINT8 issue_name[30];                  // bytes 48 to 77
  UINT8 issue_type;                      // byte 78
  UINT8 issue_subtype[2];                // bytes 79 to 80
  UINT8 market_tier;                     // byte 81
  UINT8 authenticity;                    // byte 82
  UINT8 short_sale_threshold_indicator;  // byte 83
  UINT16BE round_lot_size;               // bytes 84 to 85
  UINT8 financial_status_indicator;      // byte 86
} IssueSymbolDirectoryMessage;

// Enhanced Issue Symbol Directory Message introduced in v3.0 alongside the existing Issue Symbol Directory Message (Type B) to support the SEC MPI Tick Rule (Nov 2026) and Extended Operational Hours (Dec 6, 2026). Adds ETP/IPO/MPI/Trading-State/Halt-Reason/Reg-SHO fields and two RESERVED prior-close prices.
typedef struct _EnhancedIssueSymbolDirectoryMessage {
  UINT8 market_center_originator;                          // byte 0
  UINT8 sub_market_center_id;                              // byte 1
  UINT64BE sip_timestamp;                                  // bytes 2 to 9
  UINT64BE timestamp_1;                                    // bytes 10 to 17
  UINT64BE participant_token;                              // bytes 18 to 25
  UINT8 symbol[11];                                        // bytes 26 to 36
  UINT8 old_symbol[11];                                    // bytes 37 to 47
  UINT8 issue_name[30];                                    // bytes 48 to 77
  UINT8 issue_type;                                        // byte 78
  UINT8 issue_subtype[2];                                  // bytes 79 to 80
  UINT8 market_tier;                                       // byte 81
  UINT8 authenticity;                                      // byte 82
  UINT8 short_sale_threshold_indicator;                    // byte 83
  UINT16BE round_lot_size;                                 // bytes 84 to 85
  UINT8 financial_status_indicator;                        // byte 86
  UINT8 etp_indicator;                                     // byte 87
  UINT8 new_issue_indicator;                               // byte 88
  UINT8 mpi_tick;                                          // byte 89
  UINT8 trading_state;                                     // byte 90
  UINT8 halt_reason[6];                                    // bytes 91 to 96
  UINT8 reg_sho_action;                                    // byte 97
  UINT64BE consolidated_prior_day_close_price;             // bytes 98 to 105
  UINT64BE listing_market_official_prior_day_close_price;  // bytes 106 to 113
} EnhancedIssueSymbolDirectoryMessage;

// Reg SHO Restriction Indicator Message indicating the Rule 201 status for NASDAQ-listed securities. Snap-Shot sends a full spin of all active securities reflecting the current Reg SHO Action.
typedef struct _RegShoShortSalePriceTestRestrictedIndicatorMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
  UINT8 symbol[11];                // bytes 26 to 36
  UINT8 reg_sho_action;            // byte 37
} RegShoShortSalePriceTestRestrictedIndicatorMessage;

// Cross SRO Trading Action message. In Snap-Shot, sent only for NASDAQ-listed issues currently halted, in a Quote Resumption, or in a LULD pause. Absence implies the issue is eligible for normal quoting and trading.
typedef struct _CrossSroTradingActionMessage {
  UINT8 market_center_originator;           // byte 0
  UINT8 sub_market_center_id;               // byte 1
  UINT64BE sip_timestamp;                   // bytes 2 to 9
  UINT64BE timestamp_1;                     // bytes 10 to 17
  UINT64BE participant_token;               // bytes 18 to 25
  UINT8 symbol[11];                         // bytes 26 to 36
  UINT8 trading_action_code;                // byte 37
  UINT32BE trading_action_sequence_number;  // bytes 38 to 41
  UINT64BE action_time;                     // bytes 42 to 49
  UINT8 reason_for_the_trading_action[6];   // bytes 50 to 55
} CrossSroTradingActionMessage;

// Market Center Trading Action message sent when a UTP participant invokes or releases a market center-specific trading halt for a NASDAQ-listed security. Other participants may continue to quote and trade.
typedef struct _MarketCenterTradingActionMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
  UINT8 symbol[11];                // bytes 26 to 36
  UINT8 trading_action_code;       // byte 37
  UINT64BE action_time;            // bytes 38 to 45
  UINT8 market_center_identifier;  // byte 46
} MarketCenterTradingActionMessage;

// MWCB Decline Message. Communicates the daily MWCB breach points (Levels 1/2/3) set based on the prior day's closing value of the S P 500 index. May be re-sent if levels are reset due to erroneous activity; participants should use the most recently disseminated values.
typedef struct _MarketWideCircuitBreakerDeclineLevelMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
  UINT64BE mwcb_level_1;           // bytes 26 to 33
  UINT64BE mwcb_level_2;           // bytes 34 to 41
  UINT64BE mwcb_level_3;           // bytes 42 to 49
} MarketWideCircuitBreakerDeclineLevelMessage;

// Limit Up Limit Down Price Band Message. Reflects the current LULD band for LULD-eligible securities. Designed to prevent trades outside specified Upper and Lower Limit Price Bands.
typedef struct _LimitUpLimitDownPriceBandMessage {
  UINT8 market_center_originator;           // byte 0
  UINT8 sub_market_center_id;               // byte 1
  UINT64BE sip_timestamp;                   // bytes 2 to 9
  UINT64BE timestamp_1;                     // bytes 10 to 17
  UINT64BE participant_token;               // bytes 18 to 25
  UINT8 symbol[11];                         // bytes 26 to 36
  UINT8 luld_price_band_indicator;          // byte 37
  UINT64BE luld_price_band_effective_time;  // bytes 38 to 45
  UINT64BE limit_down_price;                // bytes 46 to 53
  UINT64BE limit_up_price;                  // bytes 54 to 61
} LimitUpLimitDownPriceBandMessage;

// Auction Collar Message published by primary markets using an automated reopening after a LULD Trading Pause. Snap-Shot sends only the most recent Auction Collar message per security.
typedef struct _AuctionCollarMessage {
  UINT8 market_center_originator;           // byte 0
  UINT8 sub_market_center_id;               // byte 1
  UINT64BE sip_timestamp;                   // bytes 2 to 9
  UINT64BE timestamp_1;                     // bytes 10 to 17
  UINT64BE participant_token;               // bytes 18 to 25
  UINT8 symbol[11];                         // bytes 26 to 36
  UINT32BE trading_action_sequence_number;  // bytes 37 to 40
  UINT64BE collar_reference_price;          // bytes 41 to 48
  UINT64BE collar_up_price;                 // bytes 49 to 56
  UINT64BE collar_down_price;               // bytes 57 to 64
  UINT8 collar_extension_indicator;         // byte 65
} AuctionCollarMessage;

// Snapshot Sequence Number Message. Reflects the UTP Data Service sequence number at the time the UTP Snap-Shot spin was requested. To stay current, firms should process real-time UTP Data Service messages beginning with the next sequence number after this value.
typedef struct _SnapshotSequenceMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
  UINT64BE sequence_number;        // bytes 26 to 33
} SnapshotSequenceMessage;

// Branch
casetype _AdministrativeMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x42: IssueSymbolDirectoryMessage issue_symbol_directory_message;
    case 0x46: EnhancedIssueSymbolDirectoryMessage enhanced_issue_symbol_directory_message;
    case 0x56: RegShoShortSalePriceTestRestrictedIndicatorMessage reg_sho_short_sale_price_test_restricted_indicator_message;
    case 0x48: CrossSroTradingActionMessage cross_sro_trading_action_message;
    case 0x4B: MarketCenterTradingActionMessage market_center_trading_action_message;
    case 0x43: MarketWideCircuitBreakerDeclineLevelMessage market_wide_circuit_breaker_decline_level_message;
    case 0x50: LimitUpLimitDownPriceBandMessage limit_up_limit_down_price_band_message;
    case 0x45: AuctionCollarMessage auction_collar_message;
    case 0x53: SnapshotSequenceMessage snapshot_sequence_message;
    default: UINT8 unknown[available];
  }
} AdministrativeMessagePayload;

// Administrative Messages
typedef struct _AdministrativeMessage (UINT32 available) where (available >= 1) {
  UINT8 administrative_message_type;                                                                                                                           // byte 0
  AdministrativeMessagePayload(administrative_message_type, (available - 1)) administrative_message_payload[:byte-size-single-element-array (available - 1)];
} AdministrativeMessage;

// Start of Day Control Message. Each day, signals that all subsequent data transmitted will be real-time updates. Prior to 03:58 the data feed handler may be broadcasting heartbeats.
typedef struct _StartOfDayMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
} StartOfDayMessage;

// Market Session Open Control Message. Signifies the opening of market systems for the Normal Market Session. Each UTP participant may choose to provide its own Market Session Open control message.
typedef struct _MarketSessionOpenMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
} MarketSessionOpenMessage;

// Market Session Close Control Message. Signals the closing of market systems for the Normal Market Session.
typedef struct _MarketSessionCloseMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
} MarketSessionCloseMessage;

// End of Day Control Message. Signals the end of active message dissemination for the UTP SIP operational cycle.
typedef struct _EndOfDayMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
} EndOfDayMessage;

// End of Transmissions Control Message. Last production message of the day; signals no further transmissions through the UTP SIP line.
typedef struct _EndOfTransmissionsMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
} EndOfTransmissionsMessage;

// Branch
casetype _ControlMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x49: StartOfDayMessage start_of_day_message;
    case 0x4F: MarketSessionOpenMessage market_session_open_message;
    case 0x43: MarketSessionCloseMessage market_session_close_message;
    case 0x4A: EndOfDayMessage end_of_day_message;
    case 0x5A: EndOfTransmissionsMessage end_of_transmissions_message;
    default: UINT8 unknown[available];
  }
} ControlMessagePayload;

// Control Messages
typedef struct _ControlMessage (UINT32 available) where (available >= 1) {
  UINT8 control_message_type;                                                                                                             // byte 0
  ControlMessagePayload(control_message_type, (available - 1)) control_message_payload[:byte-size-single-element-array (available - 1)];
} ControlMessage;

// National BBO Appendage Long-form
typedef struct _NationalBboAppendageLongForm {
  UINT8 nbbo_quote_condition;             // byte 0
  UINT8 national_best_bid_market_center;  // byte 1
  UINT64BE national_best_bid_price;       // bytes 2 to 9
  UINT32BE national_best_bid_size;        // bytes 10 to 13
  UINT8 national_best_ask_market_center;  // byte 14
  UINT64BE national_best_ask_price;       // bytes 15 to 22
  UINT32BE national_best_ask_size;        // bytes 23 to 26
} NationalBboAppendageLongForm;

// National BBO Appendage Long-form
casetype _OptionalNationalBboAppendageLongForm (Bool present) {
  switch (present) {
    case true: NationalBboAppendageLongForm national_bbo_appendage_long_form;
    case false: unit absent;
  }
} OptionalNationalBboAppendageLongForm;

// FINRA ADF MPID Appendage
typedef struct _FinraAdfMpidAppendage {
  UINT8 bid_adf_mpid[4];  // bytes 0 to 3
  UINT8 ask_adf_mpid[4];  // bytes 4 to 7
} FinraAdfMpidAppendage;

// FINRA ADF MPID Appendage
casetype _OptionalFinraAdfMpidAppendage (Bool present) {
  switch (present) {
    case true: FinraAdfMpidAppendage finra_adf_mpid_appendage;
    case false: unit absent;
  }
} OptionalFinraAdfMpidAppendage;

// BOLO Appendage MPID Form
typedef struct _BoloAppendageMpidForm {
  UINT8 bolo_best_bid_market_center;                     // byte 0
  UINT64BE bolo_bid_price;                               // bytes 1 to 8
  UINT16BE bolo_bid_size;                                // bytes 9 to 10
  UINT8 bolo_best_ask_market_center;                     // byte 11
  UINT64BE bolo_ask_price;                               // bytes 12 to 19
  UINT16BE bolo_ask_size;                                // bytes 20 to 21
  UINT8 bolo_best_bid_market_participant_identifier[4];  // bytes 22 to 25
  UINT8 bolo_best_ask_market_participant_identifier[4];  // bytes 26 to 29
} BoloAppendageMpidForm;

// BOLO Appendage MPID Form
casetype _OptionalBoloAppendageMpidForm (Bool present) {
  switch (present) {
    case true: BoloAppendageMpidForm bolo_appendage_mpid_form;
    case false: unit absent;
  }
} OptionalBoloAppendageMpidForm;

// UTP ADF MPID Odd Lot Attachment. Provides one or more odd lot price levels as an attachment to the odd lot or combined quote message, including ADF MPID attribution. Repeats Odd Lot Attachment Count times. ADF Market Participant Identifier is populated with the FINRA ADF MPID update if necessary.
typedef struct _UtpAdfMpidOddLotAttachment {
  UINT8 market_center_id;                      // byte 0
  UINT8 side;                                  // byte 1
  UINT64BE odd_lot_price;                      // bytes 2 to 9
  UINT16BE shares_at_odd_lot_price;            // bytes 10 to 11
  UINT8 adf_market_participant_identifier[4];  // bytes 12 to 15
} UtpAdfMpidOddLotAttachment;

// UTP ADF MPID Odd Lot Attachment. Provides one or more odd lot price levels as an attachment to the odd lot or combined quote message, including ADF MPID attribution. Repeats Odd Lot Attachment Count times. ADF Market Participant Identifier is populated with the FINRA ADF MPID update if necessary.
casetype _OptionalUtpAdfMpidOddLotAttachment (Bool present, UINT32 length) {
  switch (present) {
    case true: UtpAdfMpidOddLotAttachment utp_adf_mpid_odd_lot_attachment[:byte-size length];
    case false: unit absent;
  }
} OptionalUtpAdfMpidOddLotAttachment;

// Long-format UTP Combined Quotation Message. The Combined Quote Spin provides the current state of all active participants in the identified security. During the spin, NBBO/BOLO Appendage Indicators are set to 1 until the final participant BBO is disseminated; on the final message they are populated as appropriate.
typedef struct _UtpCombinedQuoteMessageLongForm {
  UINT8 market_center_originator;                                                                                                                     // byte 0
  UINT8 sub_market_center_id;                                                                                                                         // byte 1
  UINT64BE sip_timestamp;                                                                                                                             // bytes 2 to 9
  UINT64BE timestamp_1;                                                                                                                               // bytes 10 to 17
  UINT64BE participant_token;                                                                                                                         // bytes 18 to 25
  UINT64BE finra_adf_timestamp;                                                                                                                       // bytes 26 to 33
  UINT8 symbol[11];                                                                                                                                   // bytes 34 to 44
  UINT64BE bid_price;                                                                                                                                 // bytes 45 to 52
  UINT32BE bid_size;                                                                                                                                  // bytes 53 to 56
  UINT64BE ask_price;                                                                                                                                 // bytes 57 to 64
  UINT32BE ask_size;                                                                                                                                  // bytes 65 to 68
  UINT8 quote_condition;                                                                                                                              // byte 69
  UINT8 sip_generated_update_flag;                                                                                                                    // byte 70
  UINT8 luld_bbo_indicator;                                                                                                                           // byte 71
  UINT8 retail_interest_indicator;                                                                                                                    // byte 72
  UINT8 nbbo_appendage_indicator;                                                                                                                     // byte 73
  UINT8 luld_national_bbo_indicator;                                                                                                                  // byte 74
  UINT8 finra_adf_mpid_appendage_indicator;                                                                                                           // byte 75
  UINT8 bolo_appendage_indicator;                                                                                                                     // byte 76
  UINT8 odd_lot_attachment_type;                                                                                                                      // byte 77
  UINT16BE odd_lot_attachment_count;                                                                                                                  // bytes 78 to 79
  OptionalNationalBboAppendageLongForm((nbbo_appendage_indicator == 0x33)) national_bbo_appendage_long_form;
  OptionalFinraAdfMpidAppendage((finra_adf_mpid_appendage_indicator == 0x32)) finra_adf_mpid_appendage;
  OptionalBoloAppendageMpidForm((bolo_appendage_indicator == 0x35)) bolo_appendage_mpid_form;
  OptionalUtpAdfMpidOddLotAttachment((odd_lot_attachment_type == 0x35), (((UINT32) odd_lot_attachment_count) * 16)) utp_adf_mpid_odd_lot_attachment;
} UtpCombinedQuoteMessageLongForm;

// Long Format Odd Lot Quotation Message. Sent when a single Combined Quote update exceeds the number of attachments within a single message; carries remaining odd lot updates.
typedef struct _OddLotQuoteMessageLongForm {
  UINT8 market_center_originator;                                                                                                                     // byte 0
  UINT8 sub_market_center_id;                                                                                                                         // byte 1
  UINT64BE sip_timestamp;                                                                                                                             // bytes 2 to 9
  UINT64BE timestamp_1;                                                                                                                               // bytes 10 to 17
  UINT64BE participant_token;                                                                                                                         // bytes 18 to 25
  UINT64BE adf_timestamp;                                                                                                                             // bytes 26 to 33
  UINT8 symbol[11];                                                                                                                                   // bytes 34 to 44
  UINT8 sip_generated_update_flag;                                                                                                                    // byte 45
  UINT8 bolo_appendage_indicator;                                                                                                                     // byte 46
  UINT8 odd_lot_attachment_type;                                                                                                                      // byte 47
  UINT16BE odd_lot_attachment_count;                                                                                                                  // bytes 48 to 49
  OptionalBoloAppendageMpidForm((bolo_appendage_indicator == 0x35)) bolo_appendage_mpid_form;
  OptionalUtpAdfMpidOddLotAttachment((odd_lot_attachment_type == 0x35), (((UINT32) odd_lot_attachment_count) * 16)) utp_adf_mpid_odd_lot_attachment;
} OddLotQuoteMessageLongForm;

// Branch
casetype _QuoteMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x44: UtpCombinedQuoteMessageLongForm utp_combined_quote_message_long_form;
    case 0x42: OddLotQuoteMessageLongForm odd_lot_quote_message_long_form;
    default: UINT8 unknown[available];
  }
} QuoteMessagePayload;

// Quote Messages
typedef struct _QuoteMessage (UINT32 available) where (available >= 1) {
  UINT8 quote_message_type;                                                                                                         // byte 0
  QuoteMessagePayload(quote_message_type, (available - 1)) quote_message_payload[:byte-size-single-element-array (available - 1)];
} QuoteMessage;

// Branch
casetype _CategoryPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: AdministrativeMessage(available) administrative_message;
    case 0x43: ControlMessage(available) control_message;
    case 0x51: QuoteMessage(available) quote_message;
    default: UINT8 unknown[available];
  }
} CategoryPayload;

// SoupBinTCP Sequenced Data Packet wrapping a UTP Snap-Shot application message
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 3) {
  UINT8 version;                                                                                                                                       // byte 0
  UINT8 message_category;                                                                                                                              // byte 1
  CategoryPayload(message_category, (((UINT32) packet_length) - 3)) category_payload[:byte-size-single-element-array (((UINT32) packet_length) - 3)];
} SequencedDataPacket;

// SoupBinTCP Debug Packet (free-form text)
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// SoupBinTCP Login Accepted Packet
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// SoupBinTCP Login Rejected Packet
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// Branch
casetype _ServerTcpPayload (UINT8 selector, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet;
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x48: unit server_heartbeat_packet;
    case 0x5A: unit end_of_session_packet;
    default: UINT8 unknown[available];
  }
} ServerTcpPayload;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP packet carrying UTP Snap-Shot messages sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) where (available >= 3) {
  UINT16BE packet_length;                                                                                                                    // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                  // byte 2
  ServerTcpPayload(server_packet_type, packet_length, (available - 3)) server_tcp_payload[:byte-size-single-element-array (available - 3)];
} ServerPacket;

