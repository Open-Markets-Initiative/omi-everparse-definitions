// ---- Trading Action Message: 56 bytes ----------------------------------------

// Trading Action Message (AO). Listing market notifies SIP of halts and other trading state events.
entrypoint typedef struct _TradingActionMessage {
  UINT8 orig[2];             // bytes 0 to 1
  UINT64BE timestamp_1;      // bytes 2 to 9
  UINT64BE feed_sequence;    // bytes 10 to 17
  UINT64BE part_token;       // bytes 18 to 25
  UINT8 symbol_long[11];     // bytes 26 to 36
  UINT8 action;              // byte 37, values ACTION_
  UINT32BE action_sequence;  // bytes 38 to 41
  UINT64BE action_time;      // bytes 42 to 49
  UINT8 reason[6];           // bytes 50 to 55
} TradingActionMessage;

// ---- Market Center Trading Action Message: 46 bytes --------------------------

// Market Center Trading Action Message (AJ). Participant-specific trading halt on the participant's own market only.
entrypoint typedef struct _MarketCenterTradingActionMessage {
  UINT8 orig[2];           // bytes 0 to 1
  UINT64BE timestamp_1;    // bytes 2 to 9
  UINT64BE feed_sequence;  // bytes 10 to 17
  UINT64BE part_token;     // bytes 18 to 25
  UINT8 symbol_long[11];   // bytes 26 to 36
  UINT8 action;            // byte 37, values ACTION_
  UINT64BE action_time;    // bytes 38 to 45
} MarketCenterTradingActionMessage;

// ---- Market Center Mass Trading Action Message: 57 bytes ---------------------

// Market Center Mass Trading Action Message (AU). Applies action across a range of securities. No acknowledgement is returned.
entrypoint typedef struct _MarketCenterMassTradingActionMessage {
  UINT8 orig[2];             // bytes 0 to 1
  UINT64BE timestamp_1;      // bytes 2 to 9
  UINT64BE feed_sequence;    // bytes 10 to 17
  UINT64BE part_token;       // bytes 18 to 25
  UINT8 first_security[11];  // bytes 26 to 36
  UINT8 last_security[11];   // bytes 37 to 47
  UINT8 action;              // byte 48, values ACTION_
  UINT64BE action_time;      // bytes 49 to 56
} MarketCenterMassTradingActionMessage;

