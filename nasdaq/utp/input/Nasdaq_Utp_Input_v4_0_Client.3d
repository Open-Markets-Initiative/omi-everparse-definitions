// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Nasdaq_Utp_Input_v4_0_Client.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - the dispatch that chooses a message by its type
// - a run counted by a field
// - a field of no fixed width
// - a length prefix framing what follows
// - the packet as a whole, which is a field of no fixed width, at clientpacket.clienttcppayload.unsequenceddatapacket.categorypayload.inboundadministrativemessagesmessage.inboundadministrativemessagesmessagepayload.generaladministrativemessage.text

// ---- Values ------------------------------------------------------------------

// Client Packet Type: one byte code
#define CLIENT_PACKET_TYPE_UNSEQUENCED_DATA_PACKET 0x55  // Unsequenced Data Packet
#define CLIENT_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define CLIENT_PACKET_TYPE_LOGIN_REQUEST_PACKET 0x4C     // Login Request Packet
#define CLIENT_PACKET_TYPE_CLIENT_HEARTBEAT_PACKET 0x52  // Client Heartbeat Packet
#define CLIENT_PACKET_TYPE_LOGOUT_REQUEST_PACKET 0x4F    // Logout Request Packet

// Cond: one byte code
#define COND_MANUAL_ASK_AUTOMATED_BID 0x41                          // Manual Ask Automated Bid
#define COND_MANUAL_BID_AUTOMATED_ASK 0x42                          // Manual Bid Automated Ask
#define COND_FAST_TRADING 0x46                                      // Fast Trading
#define COND_MANUAL_BID_AND_ASK 0x48                                // Manual Bid And Ask
#define COND_ORDER_IMBALANCE 0x49                                   // Order Imbalance
#define COND_CLOSED_QUOTE 0x4C                                      // Closed Quote
#define COND_NON_FIRM_QUOTE 0x4E                                    // Non Firm Quote
#define COND_OPENING_QUOTE_AUTOMATED 0x4F                           // Opening Quote Automated
#define COND_REGULAR_TWO_SIDED_OPEN_QUOTE_AUTOMATED 0x52            // Regular Two Sided Open Quote Automated
#define COND_MANUAL_BID_AND_ASK_NON_FIRM 0x55                       // Manual Bid And Ask Non Firm
#define COND_ORDER_INFLUX 0x58                                      // Order Influx
#define COND_AUTOMATED_BID_NO_OFFER_OR_AUTOMATED_OFFER_NO_BID 0x59  // Automated Bid No Offer Or Automated Offer No Bid
#define COND_NO_OPENNO_RESUME 0x5A                                  // No Openno Resume
#define COND_INTRADAY_AUCTION 0x34                                  // Intraday Auction

// Rii: one byte code
#define RII_RETAIL_INTEREST_NOT_APPLICABLE 0x20             // Retail Interest Not Applicable
#define RII_RETAIL_INTEREST_ON_BID_QUOTE 0x41               // Retail Interest On Bid Quote
#define RII_RETAIL_INTEREST_ON_ASK_QUOTE 0x42               // Retail Interest On Ask Quote
#define RII_RETAIL_INTEREST_ON_BOTH_BID_AND_ASK_QUOTE 0x43  // Retail Interest On Both Bid And Ask Quote

// Bbo Cond: one byte code
#define BBO_COND_MANUAL_ASK_AUTOMATED_BID 0x41                // Manual Ask Automated Bid
#define BBO_COND_MANUAL_BID_AUTOMATED_ASK 0x42                // Manual Bid Automated Ask
#define BBO_COND_FAST_TRADING 0x46                            // Fast Trading
#define BBO_COND_MANUAL_BID_AND_ASK 0x48                      // Manual Bid And Ask
#define BBO_COND_ORDER_IMBALANCE 0x49                         // Order Imbalance
#define BBO_COND_CLOSED_QUOTE 0x4C                            // Closed Quote
#define BBO_COND_NON_FIRM_QUOTE 0x4E                          // Non Firm Quote
#define BBO_COND_OPENING_QUOTE_AUTOMATED 0x4F                 // Opening Quote Automated
#define BBO_COND_REGULAR_TWO_SIDED_OPEN_QUOTE_AUTOMATED 0x52  // Regular Two Sided Open Quote Automated

// Bbo Indicator: one byte code
#define BBO_INDICATOR_NO_FINRA_BBO_CHANGE 0x41  // No Finra Bbo Change
#define BBO_INDICATOR_NO_FINRA_BBO_EXISTS 0x42  // No Finra Bbo Exists

// Tt Exempt: one byte code
#define TT_EXEMPT_RULE_611_TRADE_THROUGH_EXEMPT 0x58      // Rule 611 Trade Through Exempt
#define TT_EXEMPT_NOT_RULE_611_TRADE_THROUGH_EXEMPT 0x20  // Not Rule 611 Trade Through Exempt

// Side: one byte code
#define SIDE_BUY 0x42         // Buy
#define SIDE_SELL 0x53        // Sell
#define SIDE_CROSS 0x58       // Cross
#define SIDE_SHORT_SALE 0x52  // Short Sale

// Cancel Type: one byte code
#define CANCEL_TYPE_CANCEL 0x43  // Cancel
#define CANCEL_TYPE_ERROR 0x45   // Error

// Reversal: one byte code
#define REVERSAL_TRANSACTION_REPRESENTS_A_REVERSAL 0x59          // Transaction Represents A Reversal
#define REVERSAL_TRANSACTION_DOES_NOT_REPRESENT_A_REVERSAL 0x4E  // Transaction Does Not Represent A Reversal

// Action: one byte code
#define ACTION_TRADING_HALT 0x48                                                   // Trading Halt
#define ACTION_QUOTATION_RESUMPTION_INCLUDING_REVOKE_EMERGENCY_MARKET_ACTION 0x51  // Quotation Resumption Including Revoke Emergency Market Action
#define ACTION_TRADING_RESUMPTION 0x54                                             // Trading Resumption
#define ACTION_VOLATILITY_TRADING_PAUSE 0x50                                       // Volatility Trading Pause
#define ACTION_WIPEOUT_QUOTE 0x57                                                  // Wipeout Quote
#define ACTION_EMERGENCY_MARKET_ACTION_WIPEOUT_AND_REJECT_NEW_QUOTES 0x45          // Emergency Market Action Wipeout And Reject New Quotes
#define ACTION_CLEAR_ODD_LOT_QUOTES 0x4F                                           // Clear Odd Lot Quotes

// Reject Code: 2 byte code
#define REJECT_CODE_INVALID_MESSAGE_TYPE 0x0001                 // Invalid Message Type
#define REJECT_CODE_INVALID_ORIGINATING_PARTICIPANT 0x0002      // Invalid Originating Participant
#define REJECT_CODE_MISSING_MESSAGE_GAP_DETECTED 0x0007         // Missing Message Gap Detected
#define REJECT_CODE_SYSTEM_NOT_OPEN 0x000B                      // System Not Open
#define REJECT_CODE_UNKNOWN_SECURITY_ID 0x001A                  // Unknown Security Id
#define REJECT_CODE_INVALID_TRADE_CANCELLATION_TYPE 0x001B      // Invalid Trade Cancellation Type
#define REJECT_CODE_INVALID_PRICE 0x001C                        // Invalid Price
#define REJECT_CODE_INVALID_VOLUME 0x001D                       // Invalid Volume
#define REJECT_CODE_INVALID_CONDITION 0x001F                    // Invalid Condition
#define REJECT_CODE_INVALID_NUMBER_OF_DAYS_FIELD 0x0020         // Invalid Number Of Days Field
#define REJECT_CODE_INVALID_EXECUTION_SIDE 0x0021               // Invalid Execution Side
#define REJECT_CODE_SECURITY_HALTED 0x0024                      // Security Halted
#define REJECT_CODE_INVALID_MESSAGE_FORMAT 0x0025               // Invalid Message Format
#define REJECT_CODE_INVALID_SIZE 0x0030                         // Invalid Size
#define REJECT_CODE_INVALID_DATE_AND_TIME 0x003C                // Invalid Date And Time
#define REJECT_CODE_MARKET_OPEN_MESSAGE_NOT_RECEIVED 0x003E     // Market Open Message Not Received
#define REJECT_CODE_INVALID_MPID 0x0042                         // Invalid Mpid
#define REJECT_CODE_INVALID_FINRA_BBO_MPID 0x0044               // Invalid Finra Bbo Mpid
#define REJECT_CODE_INVALID_FINRA_BBO_PRICE 0x0045              // Invalid Finra Bbo Price
#define REJECT_CODE_INVALID_FINRA_BBO_SIZE 0x0046               // Invalid Finra Bbo Size
#define REJECT_CODE_INVALID_FINRA_BBO_COND 0x0047               // Invalid Finra Bbo Cond
#define REJECT_CODE_TRADE_DOESNT_MATCH 0x0049                   // Trade Doesnt Match
#define REJECT_CODE_PARTICIPANT_HALTED 0x004B                   // Participant Halted
#define REJECT_CODE_INVALID_REVERSAL_INDICATOR 0x004C           // Invalid Reversal Indicator
#define REJECT_CODE_INVALID_REASON 0x004D                       // Invalid Reason
#define REJECT_CODE_MARKET_WIDE_HALT 0x004F                     // Market Wide Halt
#define REJECT_CODE_INVALID_RETAIL_INTEREST_INDICATOR 0x0050    // Invalid Retail Interest Indicator
#define REJECT_CODE_INVALID_REPORTING_TIME 0x0052               // Invalid Reporting Time
#define REJECT_CODE_UNSUPPORTED_MESSAGE_VERSION 0x0053          // Unsupported Message Version
#define REJECT_CODE_ORIGINATING_PARTICIPANT_NOT_ALLOWED 0x0054  // Originating Participant Not Allowed
#define REJECT_CODE_INVALID_BBO_INDICATOR 0x0056                // Invalid Bbo Indicator
#define REJECT_CODE_INVALID_TRADE_THROUGH_EXEMPT_FLAG 0x0057    // Invalid Trade Through Exempt Flag
#define REJECT_CODE_INVALID_ACTION 0x0058                       // Invalid Action
#define REJECT_CODE_ACTION_NOT_ALLOWED 0x0059                   // Action Not Allowed
#define REJECT_CODE_UNEXPECTED_TRADE_ID 0x005C                  // Unexpected Trade Id
#define REJECT_CODE_UNEXPECTED_TRADING_ACTION_SEQUENCE 0x005D   // Unexpected Trading Action Sequence
#define REJECT_CODE_INVALID_ODD_LEVEL 0x0065                    // Invalid Odd Level

// Syntax Violation: one byte code
#define SYNTAX_VIOLATION_SYNTAX_VIOLATION_PORT_WILL_DISCONNECT 0x59  // Syntax Violation Port Will Disconnect
#define SYNTAX_VIOLATION_NO_SYNTAX_VIOLATION 0x4E                    // No Syntax Violation

// Sip State: one byte code
#define SIP_STATE_BEFORE_START_OF_DAY_SOD 0x4E                       // Before Start Of Day Sod
#define SIP_STATE_AFTER_START_OF_DAY_SOD_BEFORE_END_OF_DAY_EOD 0x53  // After Start Of Day Sod Before End Of Day Eod
#define SIP_STATE_AFTER_END_OF_DAY_EOD 0x45                          // After End Of Day Eod

// Symbol State: one byte code
#define SYMBOL_STATE_TRADING_HALT 0x48              // Trading Halt
#define SYMBOL_STATE_QUOTATION_ONLY 0x51            // Quotation Only
#define SYMBOL_STATE_TRADING 0x54                   // Trading
#define SYMBOL_STATE_VOLATILITY_TRADING_PAUSE 0x50  // Volatility Trading Pause

// ---- Client Tcp Packet Header: 3 bytes ---------------------------------------

// Packet header of a packet sent by the client
entrypoint typedef struct _ClientTcpPacketHeader {
  UINT16BE packet_length;    // bytes 0 to 1
  UINT8 client_packet_type;  // byte 2, values CLIENT_PACKET_TYPE_
} ClientTcpPacketHeader;

// ---- Message Header: 2 bytes -------------------------------------------------

// UTP Participant Input message header fixed Version + Message Category prefix common to inbound and return messages
entrypoint typedef struct _MessageHeader {
  UINT8 version;           // byte 0
  UINT8 message_category;  // byte 1
} MessageHeader;

// ---- Protected Exchange Quote Message Short Form Message: 41 bytes -----------

// Short-format Exchange Quotation Message (QQ). Transmits Bid and Ask price and size from an Exchange to the SIP.
entrypoint typedef struct _ProtectedExchangeQuoteMessageShortFormMessage {
  UINT8 orig[2];            // bytes 0 to 1
  UINT64BE timestamp_1;     // bytes 2 to 9
  UINT64BE feed_sequence;   // bytes 10 to 17
  UINT64BE part_token;      // bytes 18 to 25
  UINT8 symbol_short[5];    // bytes 26 to 30
  UINT16BE bid_short;       // bytes 31 to 32
  UINT16BE bid_size_short;  // bytes 33 to 34
  UINT16BE ask_short;       // bytes 35 to 36
  UINT16BE ask_size_short;  // bytes 37 to 38
  UINT8 cond;               // byte 39, values COND_
  UINT8 rii;                // byte 40, values RII_
} ProtectedExchangeQuoteMessageShortFormMessage;

// ---- Protected Exchange Quote Message Long Form Message: 63 bytes ------------

// Long-format Exchange Quotation Message (QL).
entrypoint typedef struct _ProtectedExchangeQuoteMessageLongFormMessage {
  UINT8 orig[2];           // bytes 0 to 1
  UINT64BE timestamp_1;    // bytes 2 to 9
  UINT64BE feed_sequence;  // bytes 10 to 17
  UINT64BE part_token;     // bytes 18 to 25
  UINT8 symbol_long[11];   // bytes 26 to 36
  UINT64BE bid_long;       // bytes 37 to 44
  UINT32BE bid_size_long;  // bytes 45 to 48
  UINT64BE ask_long;       // bytes 49 to 56
  UINT32BE ask_size_long;  // bytes 57 to 60
  UINT8 cond;              // byte 61, values COND_
  UINT8 rii;               // byte 62, values RII_
} ProtectedExchangeQuoteMessageLongFormMessage;

// ---- Finra Protected Quote Message With Bbo Info Message: 107 bytes ----------

// FINRA BBO Quote Message w BBO Info (QG).
entrypoint typedef struct _FinraProtectedQuoteMessageWithBboInfoMessage {
  UINT8 orig[2];           // bytes 0 to 1
  UINT64BE timestamp_1;    // bytes 2 to 9
  UINT64BE feed_sequence;  // bytes 10 to 17
  UINT64BE part_token;     // bytes 18 to 25
  UINT64BE timestamp_2;    // bytes 26 to 33
  UINT8 symbol_long[11];   // bytes 34 to 44
  UINT64BE bid_long;       // bytes 45 to 52
  UINT32BE bid_size_long;  // bytes 53 to 56
  UINT64BE ask_long;       // bytes 57 to 64
  UINT32BE ask_size_long;  // bytes 65 to 68
  UINT8 cond;              // byte 69, values COND_
  UINT8 mpid[4];           // bytes 70 to 73
  UINT64BE bbo_bid;        // bytes 74 to 81
  UINT32BE bbo_bid_size;   // bytes 82 to 85
  UINT8 bbo_bid_mpid[4];   // bytes 86 to 89
  UINT64BE bbo_ask;        // bytes 90 to 97
  UINT32BE bbo_ask_size;   // bytes 98 to 101
  UINT8 bbo_ask_mpid[4];   // bytes 102 to 105
  UINT8 bbo_cond;          // byte 106, values BBO_COND_
} FinraProtectedQuoteMessageWithBboInfoMessage;

// ---- Finra Protected Quote Message Without Bbo Info Message: 75 bytes --------

// FINRA BBO Quote Message without BBO Info (QF).
entrypoint typedef struct _FinraProtectedQuoteMessageWithoutBboInfoMessage {
  UINT8 orig[2];           // bytes 0 to 1
  UINT64BE timestamp_1;    // bytes 2 to 9
  UINT64BE feed_sequence;  // bytes 10 to 17
  UINT64BE part_token;     // bytes 18 to 25
  UINT64BE timestamp_2;    // bytes 26 to 33
  UINT8 symbol_long[11];   // bytes 34 to 44
  UINT64BE bid_long;       // bytes 45 to 52
  UINT32BE bid_size_long;  // bytes 53 to 56
  UINT64BE ask_long;       // bytes 57 to 64
  UINT32BE ask_size_long;  // bytes 65 to 68
  UINT8 cond;              // byte 69, values COND_
  UINT8 mpid[4];           // bytes 70 to 73
  UINT8 bbo_indicator;     // byte 74, values BBO_INDICATOR_
} FinraProtectedQuoteMessageWithoutBboInfoMessage;

// ---- Regular Trade Report Message: 69 bytes ----------------------------------

// Regular Trade Report Message (TE). Carries whole-share last sale reports from an Exchange to the SIP.
entrypoint typedef struct _RegularTradeReportMessage {
  UINT8 orig[2];           // bytes 0 to 1
  UINT64BE timestamp_1;    // bytes 2 to 9
  UINT64BE feed_sequence;  // bytes 10 to 17
  UINT64BE part_token;     // bytes 18 to 25
  UINT64BE timestamp_2;    // bytes 26 to 33
  UINT8 symbol_long[11];   // bytes 34 to 44
  UINT32BE trade_id;       // bytes 45 to 48
  UINT8 tt_exempt;         // byte 49, values TT_EXEMPT_
  UINT8 trcond[4];         // bytes 50 to 53
  UINT16BE ssday;          // bytes 54 to 55
  UINT8 side;              // byte 56, values SIDE_
  UINT64BE price;          // bytes 57 to 64
  UINT32BE volume;         // bytes 65 to 68
} RegularTradeReportMessage;

// ---- Trade Cancel Error Message: 70 bytes ------------------------------------

// Trade Cancel/Error Message (TI). Cancels or errors a previously delivered trade.
entrypoint typedef struct _TradeCancelErrorMessage {
  UINT8 orig[2];           // bytes 0 to 1
  UINT64BE timestamp_1;    // bytes 2 to 9
  UINT64BE feed_sequence;  // bytes 10 to 17
  UINT64BE part_token;     // bytes 18 to 25
  UINT64BE timestamp_2;    // bytes 26 to 33
  UINT8 symbol_long[11];   // bytes 34 to 44
  UINT8 cancel_type;       // byte 45, values CANCEL_TYPE_
  UINT32BE orig_trade_id;  // bytes 46 to 49
  UINT8 orig_tt_exempt;    // byte 50
  UINT8 orig_trcond[4];    // bytes 51 to 54
  UINT16BE orig_ssday;     // bytes 55 to 56
  UINT8 orig_side;         // byte 57
  UINT64BE orig_price;     // bytes 58 to 65
  UINT32BE orig_volume;    // bytes 66 to 69
} TradeCancelErrorMessage;

// ---- Trade Correction Message: 92 bytes --------------------------------------

// Trade Correction Message (TJ). Corrects a previously delivered trade with new values.
entrypoint typedef struct _TradeCorrectionMessage {
  UINT8 orig[2];           // bytes 0 to 1
  UINT64BE timestamp_1;    // bytes 2 to 9
  UINT64BE feed_sequence;  // bytes 10 to 17
  UINT64BE part_token;     // bytes 18 to 25
  UINT64BE timestamp_2;    // bytes 26 to 33
  UINT8 symbol_long[11];   // bytes 34 to 44
  UINT32BE trade_id;       // bytes 45 to 48
  UINT32BE orig_trade_id;  // bytes 49 to 52
  UINT8 orig_tt_exempt;    // byte 53
  UINT8 orig_trcond[4];    // bytes 54 to 57
  UINT16BE orig_ssday;     // bytes 58 to 59
  UINT8 side;              // byte 60, values SIDE_
  UINT64BE orig_price;     // bytes 61 to 68
  UINT32BE orig_volume;    // bytes 69 to 72
  UINT8 new_tt_exempt;     // byte 73
  UINT8 new_trcond[4];     // bytes 74 to 77
  UINT16BE new_ssday;      // bytes 78 to 79
  UINT64BE new_price;      // bytes 80 to 87
  UINT32BE new_volume;     // bytes 88 to 91
} TradeCorrectionMessage;

// ---- As Of Trade Report Message: 70 bytes ------------------------------------

// As/Of Trade Report Message (TH). Reports a trade from a prior session date.
entrypoint typedef struct _AsOfTradeReportMessage {
  UINT8 orig[2];           // bytes 0 to 1
  UINT64BE timestamp_1;    // bytes 2 to 9
  UINT64BE feed_sequence;  // bytes 10 to 17
  UINT64BE part_token;     // bytes 18 to 25
  UINT8 symbol_long[11];   // bytes 26 to 36
