// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PhlxOptions_Orders_v1_9.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                  // System Event Message
#define MESSAGE_TYPE_OPTIONS_DIRECTORY_MESSAGE 0x44             // Options Directory Message
#define MESSAGE_TYPE_COMPLEX_ORDER_STRATEGY_MESSAGE 0x52        // Complex Order Strategy Message
#define MESSAGE_TYPE_SECURITY_TRADING_ACTION_MESSAGE 0x48       // Security Trading Action Message
#define MESSAGE_TYPE_COMPLEX_TRADING_ACTION_MESSAGE 0x49        // Complex Trading Action Message
#define MESSAGE_TYPE_SECURITY_OPEN_CLOSED_MESSAGE 0x50          // Security Open Closed Message
#define MESSAGE_TYPE_STRATEGY_OPEN_CLOSED_MESSAGE 0x51          // Strategy Open Closed Message
#define MESSAGE_TYPE_SIMPLE_ORDER_MESSAGE 0x4F                  // Simple Order Message
#define MESSAGE_TYPE_COMPLEX_ORDER_MESSAGE 0x58                 // Complex Order Message
#define MESSAGE_TYPE_AUCTION_NOTIFICATION_MESSAGE 0x41          // Auction Notification Message
#define MESSAGE_TYPE_COMPLEX_AUCTION_NOTIFICATION_MESSAGE 0x43  // Complex Auction Notification Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F                      // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53                  // Start Of System Hours
#define EVENT_CODE_START_OF_OPENING_PROCESS 0x51               // Start Of Opening Process
#define EVENT_CODE_START_OF_NORMAL_HOURS_CLOSING_PROCESS 0x4E  // Start Of Normal Hours Closing Process
#define EVENT_CODE_START_OF_LATE_HOURS_CLOSING_PROCESS 0x4C    // Start Of Late Hours Closing Process
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45                    // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                        // End Of Messages
#define EVENT_CODE_END_OF_WCO_EARLY_CLOSING 0x57               // End Of Wco Early Closing

// Option Type: one byte code
#define OPTION_TYPE_CALL 0x43   // Call
#define OPTION_TYPE_PUT 0x50    // Put
#define OPTION_TYPE_STOCK 0x20  // Stock

// Option Closing Type: one byte code
#define OPTION_CLOSING_TYPE_NORMAL 0x4E             // Normal
#define OPTION_CLOSING_TYPE_LATE 0x4C               // Late
#define OPTION_CLOSING_TYPE_WCO_EARLY_CLOSING 0x57  // Wco Early Closing

// Phlx Tradable: one byte code
#define PHLX_TRADABLE_TRADABLE 0x59      // Tradable
#define PHLX_TRADABLE_NOT_TRADABLE 0x4E  // Not Tradable

// Action: one byte code
#define ACTION_ADD 0x41     // Add
#define ACTION_DELETE 0x44  // Delete

// Side: one byte code
#define SIDE_BUY 0x42     // Buy
#define SIDE_SELL 0x53    // Sell
#define SIDE_HIDDEN 0x2A  // Hidden

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_HALT_IN_EFFECT 0x48        // Halt In Effect
#define CURRENT_TRADING_STATE_PHLX_TRADING_RESUMED 0x54  // Phlx Trading Resumed

// Open State: one byte code
#define OPEN_STATE_OPEN_FOR_AUTO_EXECUTION 0x59    // Open For Auto Execution
#define OPEN_STATE_CLOSED_FOR_AUTO_EXECUTION 0x4E  // Closed For Auto Execution

// Order Status: one byte code
#define ORDER_STATUS_OPEN 0x4F            // Open
#define ORDER_STATUS_FILLED 0x46          // Filled
#define ORDER_STATUS_CANCELLED 0x43       // Cancelled
#define ORDER_STATUS_RENOTIFICATION 0x52  // Renotification

// Order Type: one byte code
#define ORDER_TYPE_MARKET 0x4D     // Market
#define ORDER_TYPE_LIMIT 0x4C      // Limit
#define ORDER_TYPE_ANONYMOUS 0x2A  // Anonymous

// Market Qualifier: one byte code
#define MARKET_QUALIFIER_OPENING_ORDER 0x4F  // Opening Order
#define MARKET_QUALIFIER_IMPLIED_ORDER 0x49  // Implied Order
#define MARKET_QUALIFIER_NA 0x20             // Na

// All Or None: one byte code
#define ALL_OR_NONE_ALL_OR_NONE_ORDER 0x59      // All Or None Order
#define ALL_OR_NONE_NOT_ALL_OR_NONE_ORDER 0x4E  // Not All Or None Order

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY_ORDER 0x44  // Day Order
#define TIME_IN_FORCE_GTC 0x47        // Gtc
#define TIME_IN_FORCE_IOC 0x49        // Ioc

// Customer Firm Indicator: one byte code
#define CUSTOMER_FIRM_INDICATOR_CUSTOMER_ORDER 0x43         // Customer Order
#define CUSTOMER_FIRM_INDICATOR_FIRM_ORDER 0x46             // Firm Order
#define CUSTOMER_FIRM_INDICATOR_ON_FLOOR_MARKET_MAKER 0x4D  // On Floor Market Maker
#define CUSTOMER_FIRM_INDICATOR_BROKER_DEALER_ORDER 0x42    // Broker Dealer Order
#define CUSTOMER_FIRM_INDICATOR_PROFESSIONAL_ORDER 0x50     // Professional Order
#define CUSTOMER_FIRM_INDICATOR_NA_FOR_IMPLIED_ORDER 0x20   // Na For Implied Order

// Open Close Indicator: one byte code
#define OPEN_CLOSE_INDICATOR_OPENS_POSITION 0x4F   // Opens Position
#define OPEN_CLOSE_INDICATOR_CLOSES_POSITION 0x43  // Closes Position
#define OPEN_CLOSE_INDICATOR_NA 0x20               // Na

// Debit Or Credit: one byte code
#define DEBIT_OR_CREDIT_NET_DEBIT 0x44             // Net Debit
#define DEBIT_OR_CREDIT_NET_CREDIT 0x43            // Net Credit
#define DEBIT_OR_CREDIT_EVEN_OR_MARKET_ORDER 0x20  // Even Or Market Order
#define DEBIT_OR_CREDIT_ANONYMOUS 0x2A             // Anonymous

// Leg Open Close Indicator: one byte code
#define LEG_OPEN_CLOSE_INDICATOR_OPENS_POSITION 0x4F   // Opens Position
#define LEG_OPEN_CLOSE_INDICATOR_CLOSES_POSITION 0x43  // Closes Position
#define LEG_OPEN_CLOSE_INDICATOR_STOCK_LEG 0x20        // Stock Leg

// Auction Type: one byte code
#define AUCTION_TYPE_COLA 0x43            // Cola
#define AUCTION_TYPE_OPENING 0x4F         // Opening
#define AUCTION_TYPE_REOPENING 0x52       // Reopening
#define AUCTION_TYPE_PIXL 0x50            // Pixl
#define AUCTION_TYPE_SOLICITATION 0x53    // Solicitation
#define AUCTION_TYPE_ORDER_EXPOSURE 0x49  // Order Exposure

// Auction Side: one byte code
#define AUCTION_SIDE_BUY 0x42                   // Buy
#define AUCTION_SIDE_SELL 0x53                  // Sell
#define AUCTION_SIDE_SOLICITATION_AUCTION 0x2A  // Solicitation Auction

// ---- Types -------------------------------------------------------------------

// Time the message was sent: seconds after midnight and the nanosecond portion, U.S. Eastern Time
typedef struct _Timestamp {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} Timestamp;

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  Timestamp timestamp;  // bytes 0 to 7
  UINT8 event_code;     // byte 8
  UINT8 version;        // byte 9
} SystemEventMessage;

// At the start of each trading day, PHLX disseminates directory messages for all symbols trading on the PHLX option system.
typedef struct _OptionsDirectoryMessage {
  Timestamp timestamp;             // bytes 0 to 7
  UINT32BE option_id;              // bytes 8 to 11
  UINT8 security_symbol[5];        // bytes 12 to 16
  UINT16BE year : 7;               // bytes 17 to 18
  UINT16BE month : 4;              // bytes 17 to 18
  UINT16BE day : 5;                // bytes 17 to 18
  UINT32BE explicit_strike_price;  // bytes 19 to 22
  UINT8 option_type;               // byte 23
  UINT8 source;                    // byte 24
  UINT8 underlying_symbol[13];     // bytes 25 to 37
  UINT8 option_closing_type;       // byte 38
  UINT8 phlx_tradable;             // byte 39
} OptionsDirectoryMessage;

// Complex Order Strategy Leg Information
typedef struct _ComplexOrderStrategyLeg {
  UINT32BE option_id;              // bytes 0 to 3
  UINT8 security_symbol[5];        // bytes 4 to 8
  UINT16BE year : 7;               // bytes 9 to 10
  UINT16BE month : 4;              // bytes 9 to 10
  UINT16BE day : 5;                // bytes 9 to 10
  UINT32BE explicit_strike_price;  // bytes 11 to 14
  UINT8 option_type;               // byte 15
  UINT8 side;                      // byte 16
  UINT32BE leg_ratio;              // bytes 17 to 20
} ComplexOrderStrategyLeg;

// Whenever a complex order is added in the system for an underlying, the order is normalized and results in either the creation of a new complex strategy or is added to an existing strategy. A Complex Order Strategy Message containing the strategy definition will be sent.
typedef struct _ComplexOrderStrategyMessage {
  Timestamp timestamp;                                                                              // bytes 0 to 7
  UINT32BE strategy_id;                                                                             // bytes 8 to 11
  UINT8 source;                                                                                     // byte 12
  UINT8 underlying_symbol[13];                                                                      // bytes 13 to 25
  UINT8 action;                                                                                     // byte 26
  UINT8 number_of_legs;                                                                             // byte 27
  ComplexOrderStrategyLeg complex_order_strategy_leg[:byte-size (((UINT32) number_of_legs) * 21)];
} ComplexOrderStrategyMessage;

// PHLX uses this administrative message to indicate the current trading status of an index or equity option within the PHLX Options Market.
typedef struct _SecurityTradingActionMessage {
  Timestamp timestamp;             // bytes 0 to 7
  UINT32BE option_id;              // bytes 8 to 11
  UINT8 security_symbol[5];        // bytes 12 to 16
  UINT16BE year : 7;               // bytes 17 to 18
  UINT16BE month : 4;              // bytes 17 to 18
  UINT16BE day : 5;                // bytes 17 to 18
  UINT32BE explicit_strike_price;  // bytes 19 to 22
  UINT8 option_type;               // byte 23
  UINT8 current_trading_state;     // byte 24
} SecurityTradingActionMessage;

// PHLX uses this administrative message to indicate the current trading status of a strategy within the PHLX Options Market.
typedef struct _ComplexTradingActionMessage {
  Timestamp timestamp;          // bytes 0 to 7
  UINT32BE strategy_id;         // bytes 8 to 11
  UINT8 current_trading_state;  // byte 12
} ComplexTradingActionMessage;

// PHLX uses this administrative message to indicate when an option has completed the opening process and is now available for auto execution or when the option has closed and is no longer available for auto execution.
typedef struct _SecurityOpenClosedMessage {
  Timestamp timestamp;             // bytes 0 to 7
  UINT32BE option_id;              // bytes 8 to 11
  UINT8 security_symbol[5];        // bytes 12 to 16
  UINT16BE year : 7;               // bytes 17 to 18
  UINT16BE month : 4;              // bytes 17 to 18
  UINT16BE day : 5;                // bytes 17 to 18
  UINT32BE explicit_strike_price;  // bytes 19 to 22
  UINT8 option_type;               // byte 23
  UINT8 open_state;                // byte 24
} SecurityOpenClosedMessage;

// PHLX uses this administrative message to indicate when a strategy has completed the opening process or when the strategy has closed and is no longer available for auto execution.
typedef struct _StrategyOpenClosedMessage {
  Timestamp timestamp;   // bytes 0 to 7
  UINT32BE strategy_id;  // bytes 8 to 11
  UINT8 open_state;      // byte 12
} StrategyOpenClosedMessage;

// When a Single Order is received or any change is made to an order, an Order message containing the current order status will be sent.
typedef struct _SimpleOrderMessage {
  Timestamp timestamp;               // bytes 0 to 7
  UINT32BE option_id;                // bytes 8 to 11
  UINT8 security_symbol[5];          // bytes 12 to 16
  UINT16BE year : 7;                 // bytes 17 to 18
  UINT16BE month : 4;                // bytes 17 to 18
  UINT16BE day : 5;                  // bytes 17 to 18
  UINT32BE explicit_strike_price;    // bytes 19 to 22
  UINT8 option_type;                 // byte 23
  UINT32BE order_id;                 // bytes 24 to 27
  UINT8 side;                        // byte 28
  UINT32BE original_order_volume;    // bytes 29 to 32
  UINT32BE executable_order_volume;  // bytes 33 to 36
  UINT8 order_status;                // byte 37
  UINT8 order_type;                  // byte 38
  UINT8 market_qualifier;            // byte 39
  UINT32BE limit_price;              // bytes 40 to 43
  UINT8 all_or_none;                 // byte 44
  UINT8 time_in_force;               // byte 45
  UINT8 customer_firm_indicator;     // byte 46
  UINT8 open_close_indicator;        // byte 47
} SimpleOrderMessage;

// Complex Order Leg Information
typedef struct _ComplexOrderLeg {
  UINT8 leg_open_close_indicator;  // byte 0
  UINT32BE option_id;              // bytes 1 to 4
  UINT8 security_symbol[5];        // bytes 5 to 9
  UINT16BE year : 7;               // bytes 10 to 11
  UINT16BE month : 4;              // bytes 10 to 11
  UINT16BE day : 5;                // bytes 10 to 11
  UINT32BE explicit_strike_price;  // bytes 12 to 15
  UINT8 option_type;               // byte 16
  UINT8 side;                      // byte 17
  UINT32BE leg_ratio;              // bytes 18 to 21
} ComplexOrderLeg;

// When a Complex Order is received or any change is made to a complex order for an underlying, a Complex Order Message containing the order information will be sent.
typedef struct _ComplexOrderMessage {
  Timestamp timestamp;                                                             // bytes 0 to 7
  UINT32BE strategy_id;                                                            // bytes 8 to 11
  UINT32BE order_id;                                                               // bytes 12 to 15
  UINT8 side;                                                                      // byte 16
  UINT32BE original_order_volume;                                                  // bytes 17 to 20
  UINT32BE executable_order_volume;                                                // bytes 21 to 24
  UINT8 order_status;                                                              // byte 25
  UINT8 order_type;                                                                // byte 26
  UINT32BE limit_price;                                                            // bytes 27 to 30
  UINT8 debit_or_credit;                                                           // byte 31
  UINT8 all_or_none;                                                               // byte 32
  UINT8 time_in_force;                                                             // byte 33
  UINT8 customer_firm_indicator;                                                   // byte 34
  UINT8 underlying_symbol[13];                                                     // bytes 35 to 47
  UINT8 number_of_legs;                                                            // byte 48
  ComplexOrderLeg complex_order_leg[:byte-size (((UINT32) number_of_legs) * 22)];
} ComplexOrderMessage;

// When a symbol goes into an auction, an Auction Notification Message is sent. Also if any auction parameters change during the auction, size for example, a new Auction Notification message will be sent for that symbol.
typedef struct _AuctionNotificationMessage {
  Timestamp timestamp;             // bytes 0 to 7
  UINT32BE option_id;              // bytes 8 to 11
  UINT8 security_symbol[5];        // bytes 12 to 16
  UINT16BE year : 7;               // bytes 17 to 18
  UINT16BE month : 4;              // bytes 17 to 18
  UINT16BE day : 5;                // bytes 17 to 18
  UINT32BE explicit_strike_price;  // bytes 19 to 22
  UINT8 option_type;               // byte 23
  UINT32BE auction_id;             // bytes 24 to 27
  UINT8 auction_type;              // byte 28
  UINT32BE price;                  // bytes 29 to 32
  UINT8 auction_side;              // byte 33
  UINT32BE matched_volume;         // bytes 34 to 37
  UINT32BE imbalance_volume;       // bytes 38 to 41
  UINT32BE reserved_4;             // bytes 42 to 45
} AuctionNotificationMessage;

// When a Complex Order Live Auction (COLA) or PIXL/Solicitation auction starts for a strategy of an underlying, a COLA/PIXL/Solicitation notification message containing the auction information will be sent.
typedef struct _ComplexAuctionNotificationMessage {
  Timestamp timestamp;    // bytes 0 to 7
  UINT32BE strategy_id;   // bytes 8 to 11
  UINT32BE auction_id;    // bytes 12 to 15
  UINT8 auction_type;     // byte 16
  UINT32BE price;         // bytes 17 to 20
  UINT8 auction_side;     // byte 21
  UINT8 debit_or_credit;  // byte 22
  UINT32BE volume;        // bytes 23 to 26
} ComplexAuctionNotificationMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x44: OptionsDirectoryMessage options_directory_message;
    case 0x52: ComplexOrderStrategyMessage complex_order_strategy_message;
    case 0x48: SecurityTradingActionMessage security_trading_action_message;
    case 0x49: ComplexTradingActionMessage complex_trading_action_message;
    case 0x50: SecurityOpenClosedMessage security_open_closed_message;
    case 0x51: StrategyOpenClosedMessage strategy_open_closed_message;
    case 0x4F: SimpleOrderMessage simple_order_message;
    case 0x58: ComplexOrderMessage complex_order_message;
    case 0x41: AuctionNotificationMessage auction_notification_message;
    case 0x43: ComplexAuctionNotificationMessage complex_auction_notification_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp message data
typedef struct _MessageData (UINT16 message_length) where (message_length >= 1) {
  UINT8 message_type;                                                                                                               // byte 0
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
} MessageData;

// Branch
casetype _MessageBody (UINT16 selector, UINT16 message_length) {
  switch (selector) {
    case 0x0000: unit end_of_session;
    default: MessageData(message_length) message_data;
  }
} MessageBody;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_length;                                                                                                                                           // bytes 0 to 1
  MessageBody(message_length, message_length) message_body[:byte-size-single-element-array ((((UINT32) message_length) + 2) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT32 sequence_number;                                                                                                      // bytes 10 to 13
  UINT16 message_count;                                                                                                        // bytes 14 to 15
  Messages(message_count, message_count, (available - 16), tally) messages[:byte-size-single-element-array (available - 16)];
} Packet;

