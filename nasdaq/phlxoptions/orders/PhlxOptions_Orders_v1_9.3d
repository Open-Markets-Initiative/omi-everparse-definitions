// ---- Packet Header: 16 bytes -------------------------------------------------

entrypoint typedef struct _PacketHeader {
  UINT8 session[10];       // bytes 0 to 9
  UINT32 sequence_number;  // bytes 10 to 13
  UINT16 message_count;    // bytes 14 to 15
} PacketHeader;

// ---- Message Header: 1 byte --------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT8 message_type;  // byte 0
} MessageHeader;

// ---- Timestamp: 8 bytes ------------------------------------------------------

// Time the message was sent: seconds after midnight and the nanosecond portion, U.S. Eastern Time
entrypoint typedef struct _Timestamp {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} Timestamp;

// ---- System Event Message: 10 bytes ------------------------------------------

// The system event message type is used to signal a market or data feed handler event.
entrypoint typedef struct _SystemEventMessage {
  Timestamp timestamp;  // bytes 0 to 7
  UINT8 event_code;     // byte 8
  UINT8 version;        // byte 9
} SystemEventMessage;

// ---- Complex Trading Action Message: 13 bytes --------------------------------

// PHLX uses this administrative message to indicate the current trading status of a strategy within the PHLX Options Market.
entrypoint typedef struct _ComplexTradingActionMessage {
  Timestamp timestamp;          // bytes 0 to 7
  UINT32BE strategy_id;         // bytes 8 to 11
  UINT8 current_trading_state;  // byte 12
} ComplexTradingActionMessage;

// ---- Strategy Open Closed Message: 13 bytes ----------------------------------

// PHLX uses this administrative message to indicate when a strategy has completed the opening process or when the strategy has closed and is no longer available for auto execution.
entrypoint typedef struct _StrategyOpenClosedMessage {
  Timestamp timestamp;   // bytes 0 to 7
  UINT32BE strategy_id;  // bytes 8 to 11
  UINT8 open_state;      // byte 12
} StrategyOpenClosedMessage;

// ---- Complex Auction Notification Message: 27 bytes --------------------------

// When a Complex Order Live Auction (COLA) or PIXL/Solicitation auction starts for a strategy of an underlying, a COLA/PIXL/Solicitation notification message containing the auction information will be sent.
entrypoint typedef struct _ComplexAuctionNotificationMessage {
  Timestamp timestamp;    // bytes 0 to 7
  UINT32BE strategy_id;   // bytes 8 to 11
  UINT32BE auction_id;    // bytes 12 to 15
  UINT8 auction_type;     // byte 16
  UINT32BE price;         // bytes 17 to 20
  UINT8 auction_side;     // byte 21
  UINT8 debit_or_credit;  // byte 22
  UINT32BE volume;        // bytes 23 to 26
} ComplexAuctionNotificationMessage;

