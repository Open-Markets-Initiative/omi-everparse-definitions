// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PhlxOptions_TradeFeed_v2_1_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53            // System Event Message
#define SEQUENCED_MESSAGE_TYPE_DERIVATIVE_DIRECTORY_MESSAGE 0x6D    // Derivative Directory Message
#define SEQUENCED_MESSAGE_TYPE_TRADING_ACTION_MESSAGE 0x48          // Trading Action Message
#define SEQUENCED_MESSAGE_TYPE_TRADE_MESSAGE 0x52                   // Trade Message
#define SEQUENCED_MESSAGE_TYPE_BROKEN_TRADE_REPORT_MESSAGE 0x58     // Broken Trade Report Message
#define SEQUENCED_MESSAGE_TYPE_END_OF_REPLAY_SEQUENCE_MESSAGE 0x4D  // End Of Replay Sequence Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F                      // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53                  // Start Of System Hours
#define EVENT_CODE_START_OF_OPENING_PROCESS 0x51               // Start Of Opening Process
#define EVENT_CODE_START_OF_NORMAL_HOURS_CLOSING_PROCESS 0x4E  // Start Of Normal Hours Closing Process
#define EVENT_CODE_START_OF_LATE_HOURS_CLOSING_PROCESS 0x4C    // Start Of Late Hours Closing Process
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45                    // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                        // End Of Messages
#define EVENT_CODE_END_OF_WCO_EARLY_CLOSING 0x57               // End Of Wco Early Closing

// Option Type: one byte code
#define OPTION_TYPE_CALL 0x43            // Call
#define OPTION_TYPE_PUT 0x50             // Put
#define OPTION_TYPE_NOT_APPLICABLE 0x4E  // Not Applicable

// Closing Type: one byte code
#define CLOSING_TYPE_NORMAL_HOURS 0x4E       // Normal Hours
#define CLOSING_TYPE_LATE_HOURS 0x4C         // Late Hours
#define CLOSING_TYPE_WCO_EARLY_CLOSING 0x57  // Wco Early Closing

// Tradable: one byte code
#define TRADABLE_TRADABLE 0x59      // Tradable
#define TRADABLE_NOT_TRADABLE 0x4E  // Not Tradable

// Mpv: one byte code
#define MPV_PENNY_EVERYWHERE 0x45  // Penny Everywhere
#define MPV_SCALED 0x53            // Scaled
#define MPV_PENNY_PILOT 0x50       // Penny Pilot

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_BUY_SIDE_SUSPENDED 0x42   // Buy Side Suspended
#define CURRENT_TRADING_STATE_SELL_SIDE_SUSPENDED 0x53  // Sell Side Suspended
#define CURRENT_TRADING_STATE_HALT_IN_EFFECT 0x48       // Halt In Effect
#define CURRENT_TRADING_STATE_CONTINUOUS_TRADING 0x54   // Continuous Trading
#define CURRENT_TRADING_STATE_PRE_OPEN 0x49             // Pre Open
#define CURRENT_TRADING_STATE_OPENING_AUCTION 0x4F      // Opening Auction
#define CURRENT_TRADING_STATE_RE_OPENING 0x52           // Re Opening
#define CURRENT_TRADING_STATE_CLOSED 0x58               // Closed

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT64BE timestamp;        // bytes 2 to 9
  UINT8 event_code;          // byte 10
} SystemEventMessage;

// Derivative Directory Message for active options symbols.
typedef struct _DerivativeDirectoryMessage {
  UINT16BE tracking_number;        // bytes 0 to 1
  UINT64BE timestamp;              // bytes 2 to 9
  UINT32BE instrument_id;          // bytes 10 to 13
  UINT8 security_symbol[8];        // bytes 14 to 21
  UINT8 expiration_year;           // byte 22
  UINT8 expiration_month;          // byte 23
  UINT8 expiration_day;            // byte 24
  UINT32BE explicit_strike_price;  // bytes 25 to 28, signed, read here as unsigned
  UINT8 option_type;               // byte 29
  UINT8 underlying_symbol[13];     // bytes 30 to 42
  UINT8 closing_type;              // byte 43
  UINT8 tradable;                  // byte 44
  UINT8 mpv;                       // byte 45
  UINT8 reserved_16[16];           // bytes 46 to 61
} DerivativeDirectoryMessage;

// The options system uses this administrative message to indicate the current trading status of an index or equity option within the options market.
typedef struct _TradingActionMessage {
  UINT16BE tracking_number;     // bytes 0 to 1
  UINT64BE timestamp;           // bytes 2 to 9
  UINT32BE instrument_id;       // bytes 10 to 13
  UINT8 current_trading_state;  // byte 14
} TradingActionMessage;

// The Trade Report message will be used to relay execution system transactions that are reported during the current business day.
typedef struct _TradeMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT64BE timestamp;        // bytes 2 to 9
  UINT32BE instrument_id;    // bytes 10 to 13
  UINT32BE cross_id;         // bytes 14 to 17
  UINT8 trade_condition;     // byte 18
  UINT32BE price;            // bytes 19 to 22, signed, read here as unsigned
  UINT32BE volume;           // bytes 23 to 26
  UINT8 reserved_16[16];     // bytes 27 to 42
} TradeMessage;

// The Broken Trade Report message is used in the event that an options trade transaction is broken on the same business day that it is reported.
typedef struct _BrokenTradeReportMessage {
  UINT16BE tracking_number;    // bytes 0 to 1
  UINT64BE timestamp;          // bytes 2 to 9
  UINT32BE instrument_id;      // bytes 10 to 13
  UINT32BE original_cross_id;  // bytes 14 to 17
  UINT32BE original_price;     // bytes 18 to 21, signed, read here as unsigned
  UINT32BE original_volume;    // bytes 22 to 25
} BrokenTradeReportMessage;

// The End of replay Sequence message reflects the sequence number at the time replay of existing messages is complete.
typedef struct _EndOfReplaySequenceMessage {
  UINT8 end_of_replay_sequence_number[20];  // bytes 0 to 19
} EndOfReplaySequenceMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x6D: DerivativeDirectoryMessage derivative_directory_message;
    case 0x48: TradingActionMessage trading_action_message;
    case 0x52: TradeMessage trade_message;
    case 0x58: BrokenTradeReportMessage broken_trade_report_message;
    case 0x4D: EndOfReplaySequenceMessage end_of_replay_sequence_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat_packet;
    case 0x5A: unit end_of_session_packet;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

