// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PhlxOptions_TopOfMarket_v3_4_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_TIMESTAMP_MESSAGE 0x54                      // Timestamp Message
#define SEQUENCED_MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                   // System Event Message
#define SEQUENCED_MESSAGE_TYPE_OPTIONS_DIRECTORY_MESSAGE 0x44              // Options Directory Message
#define SEQUENCED_MESSAGE_TYPE_TRADING_ACTION_MESSAGE 0x48                 // Trading Action Message
#define SEQUENCED_MESSAGE_TYPE_SECURITY_OPEN_CLOSED_MESSAGE 0x4F           // Security Open Closed Message
#define SEQUENCED_MESSAGE_TYPE_SHORT_BEST_BID_AND_ASK_UPDATE_MESSAGE 0x71  // Short Best Bid And Ask Update Message
#define SEQUENCED_MESSAGE_TYPE_LONG_BEST_BID_AND_ASK_UPDATE_MESSAGE 0x51   // Long Best Bid And Ask Update Message
#define SEQUENCED_MESSAGE_TYPE_SHORT_BEST_ASK_UPDATE_MESSAGE 0x61          // Short Best Ask Update Message
#define SEQUENCED_MESSAGE_TYPE_SHORT_BEST_BID_UPDATE_MESSAGE 0x62          // Short Best Bid Update Message
#define SEQUENCED_MESSAGE_TYPE_LONG_BEST_ASK_UPDATE_MESSAGE 0x41           // Long Best Ask Update Message
#define SEQUENCED_MESSAGE_TYPE_LONG_BEST_BID_UPDATE_MESSAGE 0x42           // Long Best Bid Update Message
#define SEQUENCED_MESSAGE_TYPE_TRADE_REPORT_MESSAGE 0x52                   // Trade Report Message
#define SEQUENCED_MESSAGE_TYPE_BROKEN_TRADE_REPORT_MESSAGE 0x58            // Broken Trade Report Message
#define SEQUENCED_MESSAGE_TYPE_END_OF_REPLAY_SEQUENCE_MESSAGE 0x4D         // End Of Replay Sequence Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F                      // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53                  // Start Of System Hours
#define EVENT_CODE_START_OF_OPENING_PROCESS 0x51               // Start Of Opening Process
#define EVENT_CODE_START_OF_NORMAL_HOURS_CLOSING_PROCESS 0x4E  // Start Of Normal Hours Closing Process
#define EVENT_CODE_START_OF_LATE_HOURS_CLOSING_PROCESS 0x4C    // Start Of Late Hours Closing Process
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45                    // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                        // End Of Messages
#define EVENT_CODE_END_OF_WCO_EARLY_CLOSING 0x57               // End Of Wco Early Closing

// Option Type: one byte code
#define OPTION_TYPE_CALL 0x43  // Call
#define OPTION_TYPE_PUT 0x50   // Put

// Option Closing Type: one byte code
#define OPTION_CLOSING_TYPE_NORMAL 0x4E             // Normal
#define OPTION_CLOSING_TYPE_LATE 0x4C               // Late
#define OPTION_CLOSING_TYPE_WCO_EARLY_CLOSING 0x57  // Wco Early Closing

// Tradable: one byte code
#define TRADABLE_TRADABLE 0x59      // Tradable
#define TRADABLE_NOT_TRADABLE 0x4E  // Not Tradable

// Mpv: one byte code
#define MPV_PENNY_EVERYWHERE 0x45  // Penny Everywhere
#define MPV_SCALED 0x53            // Scaled
#define MPV_PENNY_PILOT 0x50       // Penny Pilot

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_HALT_IN_EFFECT 0x48   // Halt In Effect
#define CURRENT_TRADING_STATE_TRADING_RESUMED 0x54  // Trading Resumed

// Open State: one byte code
#define OPEN_STATE_OPEN_FOR_AUTO_EXECUTION 0x59    // Open For Auto Execution
#define OPEN_STATE_CLOSED_FOR_AUTO_EXECUTION 0x4E  // Closed For Auto Execution

// Quote Condition: one byte code
#define QUOTE_CONDITION_REGULAR_QUOTEAUTOX_ELIGIBLE 0x20  // Regular Quoteautox Eligible
#define QUOTE_CONDITION_NON_FIRM_QUOTE 0x46               // Non Firm Quote
#define QUOTE_CONDITION_ROTATIONAL_QUOTE 0x52             // Rotational Quote
#define QUOTE_CONDITION_BID_SIDE_FIRM 0x58                // Bid Side Firm
#define QUOTE_CONDITION_ASK_SIDE_FIRM 0x59                // Ask Side Firm

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// The system event message type is used to signal a market or data feed handler event.
typedef struct _TimestampMessage {
  UINT32BE second;  // bytes 0 to 3
} TimestampMessage;

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT8 event_code;      // byte 4
  UINT8 version;         // byte 5
  UINT8 sub_version;     // byte 6
} SystemEventMessage;

// At the start of each trading day, the options system disseminates directory messages for all symbols eligible for the auction process in the options system.
typedef struct _OptionsDirectoryMessage {
  UINT32BE nanoseconds;         // bytes 0 to 3
  UINT32BE option_id;           // bytes 4 to 7
  UINT8 security_symbol[6];     // bytes 8 to 13
  UINT8 expiration_year;        // byte 14
  UINT8 expiration_month;       // byte 15
  UINT8 expiration_day;         // byte 16
  UINT32BE strike_price;        // bytes 17 to 20, signed, read here as unsigned
  UINT8 option_type;            // byte 21
  UINT8 source;                 // byte 22
  UINT8 underlying_symbol[13];  // bytes 23 to 35
  UINT8 option_closing_type;    // byte 36
  UINT8 tradable;               // byte 37
  UINT8 mpv;                    // byte 38
} OptionsDirectoryMessage;

// The options system uses this administrative message to indicate the current trading status of an index or equity option within the options market.
typedef struct _TradingActionMessage {
  UINT32BE nanoseconds;         // bytes 0 to 3
  UINT32BE option_id;           // bytes 4 to 7
  UINT8 current_trading_state;  // byte 8
} TradingActionMessage;

// The options system uses this administrative message to indicate when an option has completed the opening process and is now available for auto execution or when the option has closed and is no longer available for auto execution.
typedef struct _SecurityOpenClosedMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT32BE option_id;    // bytes 4 to 7
  UINT8 open_state;      // byte 8
} SecurityOpenClosedMessage;

// Whenever the best bid and ask position changes on both sides, the options system will send its best bid and ask update via the data feed for the affected security.
typedef struct _ShortBestBidAndAskUpdateMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT32BE option_id;     // bytes 4 to 7
  UINT8 quote_condition;  // byte 8
  UINT16BE bid_price_2;   // bytes 9 to 10
  UINT16BE bid_size_2;    // bytes 11 to 12
  UINT16BE ask_price_2;   // bytes 13 to 14
  UINT16BE ask_size_2;    // bytes 15 to 16
} ShortBestBidAndAskUpdateMessage;

// This message is the same as the Best Bid AND Ask Update Message Short Form described above except that Prices and Sizes are 4 byte Integers, the prices having 4 implied decimal places.
typedef struct _LongBestBidAndAskUpdateMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT32BE option_id;     // bytes 4 to 7
  UINT8 quote_condition;  // byte 8
  UINT32BE bid_price_4;   // bytes 9 to 12, signed, read here as unsigned
  UINT32BE bid_size_4;    // bytes 13 to 16
  UINT32BE ask_price_4;   // bytes 17 to 20, signed, read here as unsigned
  UINT32BE ask_size_4;    // bytes 21 to 24
} LongBestBidAndAskUpdateMessage;

// The options system will continuously calculate its best bid and offer position for active options contracts on the options market during the trading day. Whenever the best bid or ask position changes on one side but not the other side, the options system will send its best bid or ask update via this feed for the affected security.
typedef struct _ShortBestAskUpdateMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT32BE option_id;     // bytes 4 to 7
  UINT8 quote_condition;  // byte 8
  UINT16BE price_2;       // bytes 9 to 10
  UINT16BE size_2;        // bytes 11 to 12
} ShortBestAskUpdateMessage;

// This message is the same as the Best Bid OR Ask Update Message Short Form described above except that Prices and Sizes are 4 byte Integers, the price having 4 implied decimal places.
typedef struct _LongBestAskUpdateMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT32BE option_id;     // bytes 4 to 7
  UINT8 quote_condition;  // byte 8
  UINT32BE price_4;       // bytes 9 to 12, signed, read here as unsigned
  UINT32BE size_4;        // bytes 13 to 16
} LongBestAskUpdateMessage;

// The Trade Report message will be used to relay execution system transactions that are reported during the current business day. The options system only reports one-side of a trade execution on the feed and other data feed products.
typedef struct _TradeReportMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT32BE option_id;     // bytes 4 to 7
  UINT32BE cross_id;      // bytes 8 to 11
  UINT8 trade_condition;  // byte 12
  UINT32BE price_4;       // bytes 13 to 16, signed, read here as unsigned
  UINT32BE volume;        // bytes 17 to 20
} TradeReportMessage;

// The following message is used in the event that an options trade transaction is broken on the same business day that it is reported.
typedef struct _BrokenTradeReportMessage {
  UINT32BE nanoseconds;        // bytes 0 to 3
  UINT32BE option_id;          // bytes 4 to 7
  UINT32BE original_cross_id;  // bytes 8 to 11
  UINT32BE original_price;     // bytes 12 to 15, signed, read here as unsigned
  UINT32BE original_volume;    // bytes 16 to 19
} BrokenTradeReportMessage;

// The End of replay Sequence message reflects the sequence number at the time replay of existing messages is complete. The firms can then use this sequence number to resume on the real time Mold channel. Only for SoupBINTCP.
typedef struct _EndOfReplaySequenceMessage {
  UINT8 end_of_replay_sequence_number[20];  // bytes 0 to 19
} EndOfReplaySequenceMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: TimestampMessage timestamp_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x44: OptionsDirectoryMessage options_directory_message;
    case 0x48: TradingActionMessage trading_action_message;
    case 0x4F: SecurityOpenClosedMessage security_open_closed_message;
    case 0x71: ShortBestBidAndAskUpdateMessage short_best_bid_and_ask_update_message;
    case 0x51: LongBestBidAndAskUpdateMessage long_best_bid_and_ask_update_message;
    case 0x61: ShortBestAskUpdateMessage short_best_ask_update_message;
    case 0x62: ShortBestAskUpdateMessage short_best_bid_update_message;
    case 0x41: LongBestAskUpdateMessage long_best_ask_update_message;
    case 0x42: LongBestAskUpdateMessage long_best_bid_update_message;
    case 0x52: TradeReportMessage trade_report_message;
    case 0x58: BrokenTradeReportMessage broken_trade_report_message;
    case 0x4D: EndOfReplaySequenceMessage end_of_replay_sequence_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat_packet;
    case 0x5A: unit end_of_session_packet;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

