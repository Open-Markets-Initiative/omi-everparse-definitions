// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PhlxOptions_TopOfMarket_Itch_v2_1_Udp.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                        // System Event Message
#define MESSAGE_TYPE_DERIVATIVE_DIRECTORY_MESSAGE 0x6D                // Derivative Directory Message
#define MESSAGE_TYPE_TRADING_ACTION_MESSAGE 0x48                      // Trading Action Message
#define MESSAGE_TYPE_BEST_BID_AND_ASK_UPDATE_SHORT_FORM_MESSAGE 0x71  // Best Bid And Ask Update Short Form Message
#define MESSAGE_TYPE_BEST_BID_AND_ASK_UPDATE_LONG_FORM_MESSAGE 0x51   // Best Bid And Ask Update Long Form Message
#define MESSAGE_TYPE_BEST_BID_UPDATE_SHORT_FORM_MESSAGE 0x62          // Best Bid Update Short Form Message
#define MESSAGE_TYPE_BEST_ASK_UPDATE_SHORT_FORM_MESSAGE 0x61          // Best Ask Update Short Form Message
#define MESSAGE_TYPE_BEST_BID_UPDATE_LONG_FORM_MESSAGE 0x42           // Best Bid Update Long Form Message
#define MESSAGE_TYPE_BEST_ASK_UPDATE_LONG_FORM_MESSAGE 0x41           // Best Ask Update Long Form Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F                      // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53                  // Start Of System Hours
#define EVENT_CODE_START_OF_OPENING_PROCESS 0x51               // Start Of Opening Process
#define EVENT_CODE_START_OF_NORMAL_HOURS_CLOSING_PROCESS 0x4E  // Start Of Normal Hours Closing Process
#define EVENT_CODE_START_OF_LATE_HOURS_CLOSING_PROCESS 0x4C    // Start Of Late Hours Closing Process
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45                    // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                        // End Of Messages
#define EVENT_CODE_END_OF_WCO_EARLY_CLOSING 0x57               // End Of Wco Early Closing

// Option Type: one byte code
#define OPTION_TYPE_CALL 0x43            // Call
#define OPTION_TYPE_PUT 0x50             // Put
#define OPTION_TYPE_NOT_APPLICABLE 0x4E  // Not Applicable

// Closing Type: one byte code
#define CLOSING_TYPE_NORMAL_HOURS 0x4E       // Normal Hours
#define CLOSING_TYPE_LATE_HOURS 0x4C         // Late Hours
#define CLOSING_TYPE_WCO_EARLY_CLOSING 0x57  // Wco Early Closing

// Tradable: one byte code
#define TRADABLE_TRADABLE 0x59      // Tradable
#define TRADABLE_NOT_TRADABLE 0x4E  // Not Tradable

// Mpv: one byte code
#define MPV_PENNY_EVERYWHERE 0x45  // Penny Everywhere
#define MPV_SCALED 0x53            // Scaled
#define MPV_PENNY_PILOT 0x50       // Penny Pilot

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_BUY_SIDE_SUSPENDED 0x42   // Buy Side Suspended
#define CURRENT_TRADING_STATE_SELL_SIDE_SUSPENDED 0x53  // Sell Side Suspended
#define CURRENT_TRADING_STATE_HALT_IN_EFFECT 0x48       // Halt In Effect
#define CURRENT_TRADING_STATE_CONTINUOUS_TRADING 0x54   // Continuous Trading
#define CURRENT_TRADING_STATE_PRE_OPEN 0x49             // Pre Open
#define CURRENT_TRADING_STATE_OPENING_AUCTION 0x4F      // Opening Auction
#define CURRENT_TRADING_STATE_RE_OPENING 0x52           // Re Opening
#define CURRENT_TRADING_STATE_CLOSED 0x58               // Closed

// Quote Condition: one byte code
#define QUOTE_CONDITION_REGULAR_QUOTE_AUTOX_ELIGIBLE 0x20     // Regular Quote Autox Eligible
#define QUOTE_CONDITION_ASK_SIDE_NOT_FIRM_BID_SIDE_FIRM 0x58  // Ask Side Not Firm Bid Side Firm
#define QUOTE_CONDITION_BID_SIDE_NOT_FIRM_ASK_SIDE_FIRM 0x59  // Bid Side Not Firm Ask Side Firm

// ---- Types -------------------------------------------------------------------

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT64BE timestamp;        // bytes 2 to 9
  UINT8 event_code;          // byte 10
} SystemEventMessage;

// At the start of each trading day, Nasdaq disseminates options symbol directory messages for all active options symbols in the system.
typedef struct _DerivativeDirectoryMessage {
  UINT16BE tracking_number;        // bytes 0 to 1
  UINT64BE timestamp;              // bytes 2 to 9
  UINT32BE instrument_id;          // bytes 10 to 13
  UINT8 security_symbol[8];        // bytes 14 to 21
  UINT8 expiration_year;           // byte 22
  UINT8 expiration_month;          // byte 23
  UINT8 expiration_day;            // byte 24
  UINT32BE explicit_strike_price;  // bytes 25 to 28, signed, read here as unsigned
  UINT8 option_type;               // byte 29
  UINT8 underlying_symbol[13];     // bytes 30 to 42
  UINT8 closing_type;              // byte 43
  UINT8 tradable;                  // byte 44
  UINT8 mpv;                       // byte 45
  UINT8 reserved_16[16];           // bytes 46 to 61
} DerivativeDirectoryMessage;

// The options system uses this administrative message to indicate the current trading status of an index or equity option within the options market.
typedef struct _TradingActionMessage {
  UINT16BE tracking_number;     // bytes 0 to 1
  UINT64BE timestamp;           // bytes 2 to 9
  UINT32BE instrument_id;       // bytes 10 to 13
  UINT8 current_trading_state;  // byte 14
} TradingActionMessage;

// The options system will continuously calculate its best bid and offer position for active options contracts on the options market during the trading day.
typedef struct _BestBidAndAskUpdateShortFormMessage {
  UINT16BE tracking_number;              // bytes 0 to 1
  UINT64BE timestamp;                    // bytes 2 to 9
  UINT32BE instrument_id;                // bytes 10 to 13
  UINT8 quote_condition;                 // byte 14
  UINT16BE bid_market_order_size_short;  // bytes 15 to 16
  UINT16BE bid_price_short;              // bytes 17 to 18
  UINT16BE bid_size_short;               // bytes 19 to 20
  UINT16BE bid_cust_size_short;          // bytes 21 to 22
  UINT16BE bid_pro_cust_size_short;      // bytes 23 to 24
  UINT16BE ask_market_order_size_short;  // bytes 25 to 26
  UINT16BE ask_price_short;              // bytes 27 to 28
  UINT16BE ask_size_short;               // bytes 29 to 30
  UINT16BE ask_cust_size_short;          // bytes 31 to 32
  UINT16BE ask_pro_cust_size_short;      // bytes 33 to 34
} BestBidAndAskUpdateShortFormMessage;

// This message is the same as the Best Bid AND Ask Update Message - Short Form described above except that Prices and Sizes are 4 byte Integers, the price having 4 implied decimal places.
typedef struct _BestBidAndAskUpdateLongFormMessage {
  UINT16BE tracking_number;             // bytes 0 to 1
  UINT64BE timestamp;                   // bytes 2 to 9
  UINT32BE instrument_id;               // bytes 10 to 13
  UINT8 quote_condition;                // byte 14
  UINT32BE bid_market_order_size_long;  // bytes 15 to 18
  UINT32BE bid_price_long;              // bytes 19 to 22, signed, read here as unsigned
  UINT32BE bid_size_long;               // bytes 23 to 26
  UINT32BE bid_cust_size_long;          // bytes 27 to 30
  UINT32BE bid_pro_cust_size_long;      // bytes 31 to 34
  UINT32BE ask_market_order_size_long;  // bytes 35 to 38
  UINT32BE ask_price_long;              // bytes 39 to 42, signed, read here as unsigned
  UINT32BE ask_size_long;               // bytes 43 to 46
  UINT32BE ask_cust_size_long;          // bytes 47 to 50
  UINT32BE ask_pro_cust_size_long;      // bytes 51 to 54
} BestBidAndAskUpdateLongFormMessage;

// The options system will continuously calculate its best bid and offer position for active options contracts on the options market during the trading day. Whenever the best bid or ask position changes on one side but not the other side, the options system will send its best bid or ask update via this data feed for the affected security.
typedef struct _BestBidUpdateShortFormMessage {
  UINT16BE tracking_number;          // bytes 0 to 1
  UINT64BE timestamp;                // bytes 2 to 9
  UINT32BE instrument_id;            // bytes 10 to 13
  UINT8 quote_condition;             // byte 14
  UINT16BE market_order_size_short;  // bytes 15 to 16
  UINT16BE price_short;              // bytes 17 to 18
  UINT16BE size_short;               // bytes 19 to 20
  UINT16BE cust_size_short;          // bytes 21 to 22
  UINT16BE pro_cust_size_short;      // bytes 23 to 24
} BestBidUpdateShortFormMessage;

// This message is the same as the Best Bid OR Ask Update Message - Short Form described above except that Prices and Sizes are 4 byte Integers, the price having 4 implied decimal places.
typedef struct _BestBidUpdateLongFormMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT32BE instrument_id;           // bytes 10 to 13
  UINT8 quote_condition;            // byte 14
  UINT32BE market_order_size_long;  // bytes 15 to 18
  UINT32BE price_long;              // bytes 19 to 22, signed, read here as unsigned
  UINT32BE size_long;               // bytes 23 to 26
  UINT32BE cust_size_long;          // bytes 27 to 30
  UINT32BE pro_cust_size_long;      // bytes 31 to 34
} BestBidUpdateLongFormMessage;

// Branch
casetype _UdpPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x6D: DerivativeDirectoryMessage derivative_directory_message;
    case 0x48: TradingActionMessage trading_action_message;
    case 0x71: BestBidAndAskUpdateShortFormMessage best_bid_and_ask_update_short_form_message;
    case 0x51: BestBidAndAskUpdateLongFormMessage best_bid_and_ask_update_long_form_message;
    case 0x62: BestBidUpdateShortFormMessage best_bid_update_short_form_message;
    case 0x61: BestBidUpdateShortFormMessage best_ask_update_short_form_message;
    case 0x42: BestBidUpdateLongFormMessage best_bid_update_long_form_message;
    case 0x41: BestBidUpdateLongFormMessage best_ask_update_long_form_message;
    default: UINT8 unknown[available];
  }
} UdpPayload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  UdpPayload(message_type, (((UINT32) message_length) - 1)) udp_payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

