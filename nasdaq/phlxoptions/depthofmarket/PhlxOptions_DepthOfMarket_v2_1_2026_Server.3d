// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PhlxOptions_DepthOfMarket_v2_1_2026_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                     // System Event Message
#define SEQUENCED_MESSAGE_TYPE_DERIVATIVE_DIRECTORY_MESSAGE 0x6D             // Derivative Directory Message
#define SEQUENCED_MESSAGE_TYPE_TRADING_ACTION_MESSAGE 0x48                   // Trading Action Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_SHORT_FORM_MESSAGE 0x72             // Add Order Short Form Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_LONG_FORM_MESSAGE 0x6F              // Add Order Long Form Message
#define SEQUENCED_MESSAGE_TYPE_ADD_QUOTE_SHORT_FORM_MESSAGE 0x6A             // Add Quote Short Form Message
#define SEQUENCED_MESSAGE_TYPE_ADD_QUOTE_LONG_FORM_MESSAGE 0x4A              // Add Quote Long Form Message
#define SEQUENCED_MESSAGE_TYPE_SINGLE_SIDE_EXECUTED_MESSAGE 0x65             // Single Side Executed Message
#define SEQUENCED_MESSAGE_TYPE_SINGLE_SIDE_EXECUTED_WITH_PRICE_MESSAGE 0x63  // Single Side Executed With Price Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_CANCEL_MESSAGE 0x58                     // Order Cancel Message
#define SEQUENCED_MESSAGE_TYPE_SINGLE_SIDE_REPLACE_SHORT_FORM_MESSAGE 0x75   // Single Side Replace Short Form Message
#define SEQUENCED_MESSAGE_TYPE_SINGLE_SIDE_REPLACE_LONG_FORM_MESSAGE 0x55    // Single Side Replace Long Form Message
#define SEQUENCED_MESSAGE_TYPE_SINGLE_SIDE_DELETE_MESSAGE 0x44               // Single Side Delete Message
#define SEQUENCED_MESSAGE_TYPE_SINGLE_SIDE_UPDATE_MESSAGE 0x47               // Single Side Update Message
#define SEQUENCED_MESSAGE_TYPE_QUOTE_REPLACE_SHORT_FORM_MESSAGE 0x6B         // Quote Replace Short Form Message
#define SEQUENCED_MESSAGE_TYPE_QUOTE_REPLACE_LONG_FORM_MESSAGE 0x4B          // Quote Replace Long Form Message
#define SEQUENCED_MESSAGE_TYPE_QUOTE_DELETE_MESSAGE 0x59                     // Quote Delete Message
#define SEQUENCED_MESSAGE_TYPE_TRADE_MESSAGE 0x71                            // Trade Message
#define SEQUENCED_MESSAGE_TYPE_NET_ORDER_IMBALANCE_MESSAGE 0x4F              // Net Order Imbalance Message
#define SEQUENCED_MESSAGE_TYPE_END_OF_REPLAY_SEQUENCE_MESSAGE 0x4D           // End Of Replay Sequence Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F                      // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53                  // Start Of System Hours
#define EVENT_CODE_START_OF_OPENING_PROCESS 0x51               // Start Of Opening Process
#define EVENT_CODE_START_OF_NORMAL_HOURS_CLOSING_PROCESS 0x4E  // Start Of Normal Hours Closing Process
#define EVENT_CODE_START_OF_LATE_HOURS_CLOSING_PROCESS 0x4C    // Start Of Late Hours Closing Process
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45                    // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                        // End Of Messages
#define EVENT_CODE_END_OF_WCO_EARLY_CLOSING 0x57               // End Of Wco Early Closing

// Option Type: one byte code
#define OPTION_TYPE_CALL 0x43            // Call
#define OPTION_TYPE_PUT 0x50             // Put
#define OPTION_TYPE_NOT_APPLICABLE 0x4E  // Not Applicable

// Closing Type: one byte code
#define CLOSING_TYPE_NORMAL_HOURS 0x4E       // Normal Hours
#define CLOSING_TYPE_LATE_HOURS 0x4C         // Late Hours
#define CLOSING_TYPE_WCO_EARLY_CLOSING 0x57  // Wco Early Closing

// Tradable: one byte code
#define TRADABLE_TRADABLE 0x59      // Tradable
#define TRADABLE_NOT_TRADABLE 0x4E  // Not Tradable

// Mpv: one byte code
#define MPV_PENNY_EVERYWHERE 0x45  // Penny Everywhere
#define MPV_SCALED 0x53            // Scaled
#define MPV_PENNY_PILOT 0x50       // Penny Pilot

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_BUY_SIDE_SUSPENDED 0x42   // Buy Side Suspended
#define CURRENT_TRADING_STATE_SELL_SIDE_SUSPENDED 0x53  // Sell Side Suspended
#define CURRENT_TRADING_STATE_HALT_IN_EFFECT 0x48       // Halt In Effect
#define CURRENT_TRADING_STATE_CONTINUOUS_TRADING 0x54   // Continuous Trading
#define CURRENT_TRADING_STATE_PRE_OPEN 0x49             // Pre Open
#define CURRENT_TRADING_STATE_OPENING_AUCTION 0x4F      // Opening Auction
#define CURRENT_TRADING_STATE_RE_OPENING 0x52           // Re Opening
#define CURRENT_TRADING_STATE_CLOSED 0x58               // Closed

// Side: one byte code
#define SIDE_BUY 0x42           // Buy
#define SIDE_SELL 0x53          // Sell
#define SIDE_BUY_IMPLIED 0x4D   // Buy Implied
#define SIDE_SELL_IMPLIED 0x4E  // Sell Implied

// Order Capacity: one byte code
#define ORDER_CAPACITY_CUSTOMER_ORDER 0x43                     // Customer Order
#define ORDER_CAPACITY_FIRM_ORDER 0x46                         // Firm Order
#define ORDER_CAPACITY_MARKET_MAKER_ORDER 0x4D                 // Market Maker Order
#define ORDER_CAPACITY_BROKER_DEALER_ORDER 0x42                // Broker Dealer Order
#define ORDER_CAPACITY_PROFESSIONAL_ORDER 0x50                 // Professional Order
#define ORDER_CAPACITY_OTHER_EXCHANGE_MARKET_MAKER_ORDER 0x4F  // Other Exchange Market Maker Order
#define ORDER_CAPACITY_JOINT_BACK_OFFICE 0x4A                  // Joint Back Office
#define ORDER_CAPACITY_NA 0x20                                 // Na

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// Change Reason: one byte code
#define CHANGE_REASON_USER 0x55     // User
#define CHANGE_REASON_REPRICE 0x52  // Reprice
#define CHANGE_REASON_SUSPEND 0x53  // Suspend

// Cross Type: one byte code
#define CROSS_TYPE_BLOCK_AUCTION 0x42              // Block Auction
#define CROSS_TYPE_OPENING_AUCTION 0x4F            // Opening Auction
#define CROSS_TYPE_RE_OPENING_AUCTION 0x52         // Re Opening Auction
#define CROSS_TYPE_PRICE_IMPROVEMENT_AUCTION 0x50  // Price Improvement Auction
#define CROSS_TYPE_FACILITATION 0x43               // Facilitation
#define CROSS_TYPE_SOLICITATION 0x53               // Solicitation
#define CROSS_TYPE_FLEX_AUCTION 0x58               // Flex Auction
#define CROSS_TYPE_NONE 0x4E                       // None
#define CROSS_TYPE_COMPLEX_EXPOSURE_AUCTION 0x45   // Complex Exposure Auction

// Trade Type: one byte code
#define TRADE_TYPE_ELECTRONIC_TRADE 0x45  // Electronic Trade

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING 0x4F    // Opening
#define AUCTION_TYPE_REOPENING 0x52  // Reopening

// Side Imbalance Direction: one byte code
#define SIDE_IMBALANCE_DIRECTION_BUY 0x42   // Buy
#define SIDE_IMBALANCE_DIRECTION_SELL 0x53  // Sell

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT64BE timestamp;        // bytes 2 to 9
  UINT8 event_code;          // byte 10
} SystemEventMessage;

// Derivative Directory Message for active options symbols.
typedef struct _DerivativeDirectoryMessage {
  UINT16BE tracking_number;        // bytes 0 to 1
  UINT64BE timestamp;              // bytes 2 to 9
  UINT32BE instrument_id;          // bytes 10 to 13
  UINT8 security_symbol[8];        // bytes 14 to 21
  UINT8 expiration_year;           // byte 22
  UINT8 expiration_month;          // byte 23
  UINT8 expiration_day;            // byte 24
  UINT32BE explicit_strike_price;  // bytes 25 to 28, signed, read here as unsigned
  UINT8 option_type;               // byte 29
  UINT8 underlying_symbol[13];     // bytes 30 to 42
  UINT8 closing_type;              // byte 43
  UINT8 tradable;                  // byte 44
  UINT8 mpv;                       // byte 45
  UINT8 reserved_16[16];           // bytes 46 to 61
} DerivativeDirectoryMessage;

// The options system uses this administrative message to indicate the current trading status of an index or equity option within the options market.
typedef struct _TradingActionMessage {
  UINT16BE tracking_number;     // bytes 0 to 1
  UINT64BE timestamp;           // bytes 2 to 9
  UINT32BE instrument_id;       // bytes 10 to 13
  UINT8 current_trading_state;  // byte 14
} TradingActionMessage;

// An Add Order Message indicates that a new order has been accepted and was added to the displayable book.
typedef struct _AddOrderShortFormMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT32BE instrument_id;           // bytes 10 to 13
  UINT64BE order_reference_number;  // bytes 14 to 21
  UINT8 side;                       // byte 22
  UINT8 order_capacity;             // byte 23
  UINT16BE price_short;             // bytes 24 to 25
  UINT16BE volume_short;            // bytes 26 to 27
  UINT8 reserved_4[4];              // bytes 28 to 31
} AddOrderShortFormMessage;

// An Add Order Message indicates that a new order has been accepted and was added to the displayable book.
typedef struct _AddOrderLongFormMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT32BE instrument_id;           // bytes 10 to 13
  UINT64BE order_reference_number;  // bytes 14 to 21
  UINT8 side;                       // byte 22
  UINT8 order_capacity;             // byte 23
  UINT32BE price_long;              // bytes 24 to 27, signed, read here as unsigned
  UINT32BE volume_long;             // bytes 28 to 31
  UINT8 reserved_4[4];              // bytes 32 to 35
} AddOrderLongFormMessage;

// An Add Quote Message indicates that a new quote has been accepted and was added to the displayable book.
typedef struct _AddQuoteShortFormMessage {
  UINT16BE tracking_number;       // bytes 0 to 1
  UINT64BE timestamp;             // bytes 2 to 9
  UINT32BE instrument_id;         // bytes 10 to 13
  UINT64BE bid_reference_number;  // bytes 14 to 21
  UINT64BE ask_reference_number;  // bytes 22 to 29
  UINT16BE bid_price_short;       // bytes 30 to 31
  UINT16BE bid_size_short;        // bytes 32 to 33
  UINT16BE ask_price_short;       // bytes 34 to 35
  UINT16BE ask_size_short;        // bytes 36 to 37
} AddQuoteShortFormMessage;

// An Add Quote Message indicates that a new quote has been accepted and was added to the displayable book.
typedef struct _AddQuoteLongFormMessage {
  UINT16BE tracking_number;       // bytes 0 to 1
  UINT64BE timestamp;             // bytes 2 to 9
  UINT32BE instrument_id;         // bytes 10 to 13
  UINT64BE bid_reference_number;  // bytes 14 to 21
  UINT64BE ask_reference_number;  // bytes 22 to 29
  UINT32BE bid_price_long;        // bytes 30 to 33, signed, read here as unsigned
  UINT32BE bid_size_long;         // bytes 34 to 37
  UINT32BE ask_price_long;        // bytes 38 to 41, signed, read here as unsigned
  UINT32BE ask_size_long;         // bytes 42 to 45
} AddQuoteLongFormMessage;

// This message is sent whenever a Side order is executed in whole or in part.
typedef struct _SingleSideExecutedMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT32BE instrument_id;           // bytes 10 to 13
  UINT32BE strategy_id;             // bytes 14 to 17
  UINT64BE order_reference_number;  // bytes 18 to 25
  UINT32BE executed_volume;         // bytes 26 to 29
  UINT8 trade_condition;            // byte 30
  UINT32BE auction_id;              // bytes 31 to 34
  UINT32BE cross_number;            // bytes 35 to 38
  UINT32BE match_number;            // bytes 39 to 42
} SingleSideExecutedMessage;

// This message is sent whenever an incoming Side order is executed against the book in whole or in part at a price different from the initial display price.
typedef struct _SingleSideExecutedWithPriceMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT32BE instrument_id;           // bytes 10 to 13
  UINT32BE strategy_id;             // bytes 14 to 17
  UINT64BE order_reference_number;  // bytes 18 to 25
  UINT32BE cross_number;            // bytes 26 to 29
  UINT32BE match_number;            // bytes 30 to 33
  UINT8 printable;                  // byte 34
  UINT32BE price_long;              // bytes 35 to 38, signed, read here as unsigned
  UINT32BE volume_long;             // bytes 39 to 42
  UINT8 trade_condition;            // byte 43
  UINT32BE auction_id;              // bytes 44 to 47
} SingleSideExecutedWithPriceMessage;

// This message is sent whenever an order on the book is modified as a result of a partial cancellation.
typedef struct _OrderCancelMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT32BE instrument_id;           // bytes 10 to 13
  UINT64BE order_reference_number;  // bytes 14 to 21
  UINT32BE cancelled_volume;        // bytes 22 to 25
} OrderCancelMessage;

// This message is sent whenever an order or one side of a quote on the book is replaced.
typedef struct _SingleSideReplaceShortFormMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT32BE instrument_id;           // bytes 10 to 13
  UINT64BE order_reference_number;  // bytes 14 to 21
  UINT64BE new_reference_number;    // bytes 22 to 29
  UINT16BE price_short;             // bytes 30 to 31
  UINT16BE volume_short;            // bytes 32 to 33
} SingleSideReplaceShortFormMessage;

// This message is sent whenever an order or one side of a quote on the book is replaced.
typedef struct _SingleSideReplaceLongFormMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT32BE instrument_id;           // bytes 10 to 13
  UINT64BE order_reference_number;  // bytes 14 to 21
  UINT64BE new_reference_number;    // bytes 22 to 29
  UINT32BE price_long;              // bytes 30 to 33, signed, read here as unsigned
  UINT32BE volume_long;             // bytes 34 to 37
} SingleSideReplaceLongFormMessage;

// The message is sent when an order or a side of a quote is being cancelled. All remaining contracts are no longer accessible so the side should be removed from the book.
typedef struct _SingleSideDeleteMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT32BE instrument_id;           // bytes 10 to 13
  UINT64BE order_reference_number;  // bytes 14 to 21
} SingleSideDeleteMessage;

// This message is sent whenever an order or a side of a quote is being updated for price and (or) contracts.
typedef struct _SingleSideUpdateMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT32BE instrument_id;           // bytes 10 to 13
  UINT64BE order_reference_number;  // bytes 14 to 21
  UINT8 change_reason;              // byte 22
  UINT32BE price_long;              // bytes 23 to 26, signed, read here as unsigned
  UINT32BE volume_long;             // bytes 27 to 30
} SingleSideUpdateMessage;

// This message is sent whenever a quote on the book is replaced.
typedef struct _QuoteReplaceShortFormMessage {
  UINT16BE tracking_number;                // bytes 0 to 1
  UINT64BE timestamp;                      // bytes 2 to 9
  UINT32BE instrument_id;                  // bytes 10 to 13
  UINT64BE original_bid_reference_number;  // bytes 14 to 21
  UINT64BE bid_reference_number;           // bytes 22 to 29
  UINT64BE original_ask_reference_number;  // bytes 30 to 37
  UINT64BE ask_reference_number;           // bytes 38 to 45
  UINT16BE bid_price_short;                // bytes 46 to 47
  UINT16BE bid_size_short;                 // bytes 48 to 49
  UINT16BE ask_price_short;                // bytes 50 to 51
  UINT16BE ask_size_short;                 // bytes 52 to 53
} QuoteReplaceShortFormMessage;

// This message is sent whenever a quote on the book is replaced.
typedef struct _QuoteReplaceLongFormMessage {
  UINT16BE tracking_number;                // bytes 0 to 1
  UINT64BE timestamp;                      // bytes 2 to 9
  UINT32BE instrument_id;                  // bytes 10 to 13
  UINT64BE original_bid_reference_number;  // bytes 14 to 21
  UINT64BE bid_reference_number;           // bytes 22 to 29
  UINT64BE original_ask_reference_number;  // bytes 30 to 37
  UINT64BE ask_reference_number;           // bytes 38 to 45
  UINT32BE bid_price_long;                 // bytes 46 to 49, signed, read here as unsigned
  UINT32BE bid_size_long;                  // bytes 50 to 53
  UINT32BE ask_price_long;                 // bytes 54 to 57, signed, read here as unsigned
  UINT32BE ask_size_long;                  // bytes 58 to 61
} QuoteReplaceLongFormMessage;

// The message is sent when a single quote is being cancelled.
typedef struct _QuoteDeleteMessage {
  UINT16BE tracking_number;       // bytes 0 to 1
  UINT64BE timestamp;             // bytes 2 to 9
  UINT32BE instrument_id;         // bytes 10 to 13
  UINT64BE bid_reference_number;  // bytes 14 to 21
  UINT64BE ask_reference_number;  // bytes 22 to 29
} QuoteDeleteMessage;

// This Options Trade Message is designed to provide execution details for normal match events involving non-displayable order types.
typedef struct _TradeMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT64BE timestamp;        // bytes 2 to 9
  UINT32BE instrument_id;    // bytes 10 to 13
  UINT32BE cross_number;     // bytes 14 to 17
  UINT32BE match_number;     // bytes 18 to 21
  UINT32BE strategy_id;      // bytes 22 to 25
  UINT8 cross_type;          // byte 26
  UINT32BE price_long;       // bytes 27 to 30, signed, read here as unsigned
  UINT32BE volume_long;      // bytes 31 to 34
  UINT8 trade_condition;     // byte 35
  UINT32BE auction_id;       // bytes 36 to 39
  UINT8 printable;           // byte 40
  UINT8 trade_type;          // byte 41
  UINT8 reserved_16[16];     // bytes 42 to 57
} TradeMessage;

// This message is used to announce opening and re-opening auctions only.
typedef struct _NetOrderImbalanceMessage {
  UINT16BE tracking_number;        // bytes 0 to 1
  UINT64BE timestamp;              // bytes 2 to 9
  UINT32BE instrument_id;          // bytes 10 to 13
  UINT32BE auction_id;             // bytes 14 to 17
  UINT8 auction_type;              // byte 18
  UINT32BE paired_quantity;        // bytes 19 to 22
  UINT8 side_imbalance_direction;  // byte 23
  UINT32BE price_imbalance_price;  // bytes 24 to 27, signed, read here as unsigned
  UINT32BE imbalance_volume;       // bytes 28 to 31
  UINT8 order_capacity;            // byte 32
} NetOrderImbalanceMessage;

// The End of replay Sequence message reflects the sequence number at the time replay of existing messages is complete.
typedef struct _EndOfReplaySequenceMessage {
  UINT8 end_of_replay_sequence_number[20];  // bytes 0 to 19
} EndOfReplaySequenceMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x6D: DerivativeDirectoryMessage derivative_directory_message;
    case 0x48: TradingActionMessage trading_action_message;
    case 0x72: AddOrderShortFormMessage add_order_short_form_message;
    case 0x6F: AddOrderLongFormMessage add_order_long_form_message;
    case 0x6A: AddQuoteShortFormMessage add_quote_short_form_message;
    case 0x4A: AddQuoteLongFormMessage add_quote_long_form_message;
    case 0x65: SingleSideExecutedMessage single_side_executed_message;
    case 0x63: SingleSideExecutedWithPriceMessage single_side_executed_with_price_message;
    case 0x58: OrderCancelMessage order_cancel_message;
    case 0x75: SingleSideReplaceShortFormMessage single_side_replace_short_form_message;
    case 0x55: SingleSideReplaceLongFormMessage single_side_replace_long_form_message;
    case 0x44: SingleSideDeleteMessage single_side_delete_message;
    case 0x47: SingleSideUpdateMessage single_side_update_message;
    case 0x6B: QuoteReplaceShortFormMessage quote_replace_short_form_message;
    case 0x4B: QuoteReplaceLongFormMessage quote_replace_long_form_message;
    case 0x59: QuoteDeleteMessage quote_delete_message;
    case 0x71: TradeMessage trade_message;
    case 0x4F: NetOrderImbalanceMessage net_order_imbalance_message;
    case 0x4D: EndOfReplaySequenceMessage end_of_replay_sequence_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat_packet;
    case 0x5A: unit end_of_session_packet;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

