// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PhlxOptions_DepthOfMarket_v1_5.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SECONDS_MESSAGE 0x54                          // Seconds Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                     // System Event Message
#define MESSAGE_TYPE_BASE_REFERENCE_MESSAGE 0x4C                   // Base Reference Message
#define MESSAGE_TYPE_OPTION_DIRECTORY_MESSAGE 0x52                 // Option Directory Message
#define MESSAGE_TYPE_TRADING_ACTION_MESSAGE 0x48                   // Trading Action Message
#define MESSAGE_TYPE_SECURITY_OPEN_MESSAGE 0x4F                    // Security Open Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE_SHORT_FORM 0x61             // Add Order Message Short Form
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE_LONG_FORM 0x41              // Add Order Message Long Form
#define MESSAGE_TYPE_ADD_QUOTE_MESSAGE_SHORT_FORM 0x6A             // Add Quote Message Short Form
#define MESSAGE_TYPE_ADD_QUOTE_MESSAGE_LONG_FORM 0x4A              // Add Quote Message Long Form
#define MESSAGE_TYPE_SINGLE_SIDE_EXECUTED_MESSAGE 0x45             // Single Side Executed Message
#define MESSAGE_TYPE_SINGLE_SIDE_EXECUTED_WITH_PRICE_MESSAGE 0x43  // Single Side Executed With Price Message
#define MESSAGE_TYPE_SINGLE_SIDE_CANCEL_MESSAGE 0x58               // Single Side Cancel Message
#define MESSAGE_TYPE_SINGLE_SIDE_REPLACE_MESSAGE_SHORT_FORM 0x75   // Single Side Replace Message Short Form
#define MESSAGE_TYPE_SINGLE_SIDE_REPLACE_MESSAGE_LONG_FORM 0x55    // Single Side Replace Message Long Form
#define MESSAGE_TYPE_ORDER_REPLACE_MESSAGE_SHORT_FORM 0x76         // Order Replace Message Short Form
#define MESSAGE_TYPE_SINGLE_SIDE_REPLACE_LONG_FORM_MESSAGE 0x56    // Single Side Replace Long Form Message
#define MESSAGE_TYPE_SINGLE_SIDE_DELETE_MESSAGE 0x44               // Single Side Delete Message
#define MESSAGE_TYPE_SINGLE_SIDE_UPDATE_MESSAGE 0x47               // Single Side Update Message
#define MESSAGE_TYPE_QUOTE_REPLACE_SHORT_FORM_MESSAGE 0x6B         // Quote Replace Short Form Message
#define MESSAGE_TYPE_QUOTE_REPLACE_LONG_FORM_MESSAGE 0x4B          // Quote Replace Long Form Message
#define MESSAGE_TYPE_QUOTE_DELETE_MESSAGE 0x59                     // Quote Delete Message
#define MESSAGE_TYPE_BLOCK_DELETE_MESSAGE 0x5A                     // Block Delete Message
#define MESSAGE_TYPE_NON_AUCTION_OPTIONS_TRADE_MESSAGE 0x50        // Non Auction Options Trade Message
#define MESSAGE_TYPE_OPTIONS_CROSS_TRADE_MESSAGE 0x51              // Options Cross Trade Message
#define MESSAGE_TYPE_BROKEN_TRADE_ORDER_EXECUTION_MESSAGE 0x42     // Broken Trade Order Execution Message
#define MESSAGE_TYPE_AUCTION_NOTIFICATION_MESSAGE 0x49             // Auction Notification Message

// Option Type: one byte code
#define OPTION_TYPE_CALL 0x43  // Call
#define OPTION_TYPE_PUT 0x50   // Put

// Options Closing Type: one byte code
#define OPTIONS_CLOSING_TYPE_NORMAL 0x4E             // Normal
#define OPTIONS_CLOSING_TYPE_LATE 0x4C               // Late
#define OPTIONS_CLOSING_TYPE_WCO_EARLY_CLOSING 0x57  // Wco Early Closing

// Tradable: one byte code
#define TRADABLE_TRADABLE 0x59      // Tradable
#define TRADABLE_NOT_TRADABLE 0x4E  // Not Tradable

// Mpv: one byte code
#define MPV_EVERYWHERE 0x45  // Everywhere
#define MPV_SCALED 0x53      // Scaled
#define MPV_PILOT 0x50       // Pilot

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_HALT 0x48                                   // Halt
#define CURRENT_TRADING_STATE_TRADING 0x54                                // Trading
#define CURRENT_TRADING_STATE_BUY_SIDE_TRADING_SUSPENDED_EXHAUSTED 0x42   // Buy Side Trading Suspended Exhausted
#define CURRENT_TRADING_STATE_SELL_SIDE_TRADING_SUSPENDED_EXHAUSTED 0x53  // Sell Side Trading Suspended Exhausted

// Open State: one byte code
#define OPEN_STATE_OPEN 0x59    // Open
#define OPEN_STATE_CLOSED 0x4E  // Closed

// Market Side: one byte code
#define MARKET_SIDE_BUY 0x42           // Buy
#define MARKET_SIDE_SELL 0x53          // Sell
#define MARKET_SIDE_BUY_AON 0x58       // Buy Aon
#define MARKET_SIDE_SELL_AON 0x59      // Sell Aon
#define MARKET_SIDE_BUY_IMPLIED 0x4D   // Buy Implied
#define MARKET_SIDE_SELL_IMPLIED 0x4E  // Sell Implied

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// Change Reason: one byte code
#define CHANGE_REASON_USER 0x55       // User
#define CHANGE_REASON_REPRICE 0x52    // Reprice
#define CHANGE_REASON_SUSPEND 0x53    // Suspend
#define CHANGE_REASON_EXHAUSTED 0x45  // Exhausted

// Trade Indicator: one byte code
#define TRADE_INDICATOR_NON_DISPLAYABLE 0x4F  // Non Displayable
#define TRADE_INDICATOR_COMPLEX 0x43          // Complex
#define TRADE_INDICATOR_PIXL 0x50             // Pixl

// Cross Type: one byte code
#define CROSS_TYPE_OPENING_REOPENING 0x4F  // Opening Reopening

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING 0x4F    // Opening
#define AUCTION_TYPE_REOPENING 0x52  // Reopening
#define AUCTION_TYPE_EXPOSURE 0x49   // Exposure

// Imbalance Direction: one byte code
#define IMBALANCE_DIRECTION_BUY 0x42   // Buy
#define IMBALANCE_DIRECTION_SELL 0x53  // Sell

// Customer Indicator: one byte code
#define CUSTOMER_INDICATOR_CUSTOMER 0x43      // Customer
#define CUSTOMER_INDICATOR_FIRM 0x46          // Firm
#define CUSTOMER_INDICATOR_ON_FLOOR 0x4D      // On Floor
#define CUSTOMER_INDICATOR_PROFESSIONAL 0x50  // Professional
#define CUSTOMER_INDICATOR_NON_PHLX 0x42      // Non Phlx

// ---- Types -------------------------------------------------------------------

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} SecondsMessage;

// The system event message type is used to signal a market or data feed handler event. The format is as follows:
typedef struct _SystemEventMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT8 event_code;      // byte 4
} SystemEventMessage;

// This message indicates the base reference number to which all the order/quote/trade reference number deltas must be added to obtain the absolute order/quote PHLX reference number.
typedef struct _BaseReferenceMessage {
  UINT32BE nanoseconds;            // bytes 0 to 3
  UINT64BE base_reference_number;  // bytes 4 to 11
} BaseReferenceMessage;

// At the start of each trading day, the options system disseminates option symbol directory messages for all active option symbols in the PHLX options system.
typedef struct _OptionDirectoryMessage {
  UINT32BE nanoseconds;            // bytes 0 to 3
  UINT32BE option_id;              // bytes 4 to 7
  UINT8 security_symbol[6];        // bytes 8 to 13
  UINT8 expiration_year;           // byte 14
  UINT8 expiration_month;          // byte 15
  UINT8 expiration_date;           // byte 16
  UINT32BE explicit_strike_price;  // bytes 17 to 20
  UINT8 option_type;               // byte 21
  UINT8 source;                    // byte 22
  UINT8 underlying_symbol[13];     // bytes 23 to 35
  UINT8 options_closing_type;      // byte 36
  UINT8 tradable;                  // byte 37
  UINT8 mpv;                       // byte 38
} OptionDirectoryMessage;

// The options system uses this administrative message to indicate the current trading status of an index or equity option within the PHLX Options Market.
typedef struct _TradingActionMessage {
  UINT32BE nanoseconds;         // bytes 0 to 3
  UINT32BE option_id;           // bytes 4 to 7
  UINT8 current_trading_state;  // byte 8
} TradingActionMessage;

// The options system plans to disseminate the Option Open Message for each option as soon as the opening is completed. Upon receipt of the open state message, firms should be advised that the option denoted in the message is now available for auto execution within the PHLX Options Market System. Upon receipt of the closed state message, firms should be advised that the option is no longer eligible for auto-execution within the Options Market System.
typedef struct _SecurityOpenMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT32BE option_id;    // bytes 4 to 7
  UINT8 open_state;      // byte 8
} SecurityOpenMessage;

// An Add Order Message indicates that a new order has been accepted by the options system and was added to the displayable book. The message includes a day-unique Order Reference Number used by options system to track the order.
typedef struct _AddOrderMessageShortForm {
  UINT32BE nanoseconds;                   // bytes 0 to 3
  UINT32BE order_reference_number_delta;  // bytes 4 to 7
  UINT8 market_side;                      // byte 8
  UINT32BE option_id;                     // bytes 9 to 12
  UINT16BE short_price;                   // bytes 13 to 14
  UINT16BE short_volume;                  // bytes 15 to 16
  UINT32BE order_id;                      // bytes 17 to 20
} AddOrderMessageShortForm;

// An Add Order Message indicates that a new order has been accepted by the options system and was added to the displayable book. The message includes a day-unique Order Reference Number used by options system to track the order.
typedef struct _AddOrderMessageLongForm {
  UINT32BE nanoseconds;                   // bytes 0 to 3
  UINT32BE order_reference_number_delta;  // bytes 4 to 7
  UINT8 market_side;                      // byte 8
  UINT32BE option_id;                     // bytes 9 to 12
  UINT32BE price;                         // bytes 13 to 16
  UINT32BE volume;                        // bytes 17 to 20
  UINT32BE order_id;                      // bytes 21 to 24
} AddOrderMessageLongForm;

// An Add Quote Message indicates that a new quote has been accepted by the PHLX options system and was added to the displayable book. The message includes a unique Bid/Ask Reference Numbers used by the options system to track the quote.
typedef struct _AddQuoteMessageShortForm {
  UINT32BE nanoseconds;                 // bytes 0 to 3
  UINT32BE bid_reference_number_delta;  // bytes 4 to 7
  UINT32BE ask_reference_number_delta;  // bytes 8 to 11
  UINT32BE option_id;                   // bytes 12 to 15
  UINT16BE bid_price;                   // bytes 16 to 17
  UINT16BE short_bid_size;              // bytes 18 to 19
  UINT16BE ask_price;                   // bytes 20 to 21
  UINT16BE short_ask_size;              // bytes 22 to 23
} AddQuoteMessageShortForm;

// An Add Quote Message indicates that a new quote has been accepted by the PHLX options system and was added to the displayable book. The message includes a unique Bid/Ask Reference Numbers used by the options system to track the quote.
typedef struct _AddQuoteMessageLongForm {
  UINT32BE nanoseconds;                 // bytes 0 to 3
  UINT32BE bid_reference_number_delta;  // bytes 4 to 7
  UINT32BE ask_reference_number_delta;  // bytes 8 to 11
  UINT32BE option_id;                   // bytes 12 to 15
  UINT32BE bid;                         // bytes 16 to 19
  UINT32BE bid_size;                    // bytes 20 to 23
  UINT32BE ask;                         // bytes 24 to 27
  UINT32BE ask_size;                    // bytes 28 to 31
} AddQuoteMessageLongForm;

// This message is sent whenever a Side order is executed in whole or in part. It is possible to receive several Single Side Executed Messages for the same Side order if that Side order is executed in several parts. The multiple Single Side Executed Messages on the same order are cumulative. By combining the executions received separately via two types of Single Side Executed Messages and Trade Messages, it is possible to build a complete view of all non-auction executions that happen on PHLX . Auction execution information is available in one bulk print via the Auction Trade Message.
typedef struct _SingleSideExecutedMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT32BE reference_number_delta;  // bytes 4 to 7
  UINT32BE executed_contracts;      // bytes 8 to 11
  UINT32BE cross_number;            // bytes 12 to 15
  UINT32BE match_number;            // bytes 16 to 19
} SingleSideExecutedMessage;

// This message is sent whenever an incoming Side order is executed against the book in whole or in part at a price different from the initial display price. Since the execution price is different than the display price of the original Add/Replace, the options system includes a price field within this execution message. It is possible to receive multiple Single Side Executed and Single Side Executed with Price messages for the same Side order if that Side order is executed in several parts. The multiple Single Side Executed messages on the same Side order are cumulative.
typedef struct _SingleSideExecutedWithPriceMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT32BE reference_number_delta;  // bytes 4 to 7
  UINT32BE cross_number;            // bytes 8 to 11
  UINT32BE match_number;            // bytes 12 to 15
  UINT8 printable;                  // byte 16
  UINT32BE price;                   // bytes 17 to 20
  UINT32BE volume;                  // bytes 21 to 24
} SingleSideExecutedWithPriceMessage;

// This message is sent whenever an order or a side of a quote on the book is modified as a result of a partial cancellation.
typedef struct _SingleSideCancelMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT32BE reference_number_delta;  // bytes 4 to 7
  UINT32BE cancelled_contracts;     // bytes 8 to 11
} SingleSideCancelMessage;

// This message is sent whenever one side of a quote on the book is replaced. The replacement has a new reference number and replaces the prior reference number.
typedef struct _SingleSideReplaceMessageShortForm {
  UINT32BE nanoseconds;                      // bytes 0 to 3
  UINT32BE original_reference_number_delta;  // bytes 4 to 7
  UINT32BE new_reference_number_delta;       // bytes 8 to 11
  UINT16BE short_price;                      // bytes 12 to 13
  UINT16BE short_volume;                     // bytes 14 to 15
} SingleSideReplaceMessageShortForm;

// This message is sent whenever one side of a quote on the book is replaced. The replacement has a new reference number and replaces the prior reference number.
typedef struct _SingleSideReplaceMessageLongForm {
  UINT32BE nanoseconds;                      // bytes 0 to 3
  UINT32BE original_reference_number_delta;  // bytes 4 to 7
  UINT32BE new_reference_number_delta;       // bytes 8 to 11
  UINT32BE price;                            // bytes 12 to 15
  UINT32BE volume;                           // bytes 16 to 19
} SingleSideReplaceMessageLongForm;

// This message is sent whenever an order on the book is replaced. The replacement has a new reference number and replaces the prior reference number.
typedef struct _OrderReplaceMessageShortForm {
  UINT32BE nanoseconds;                      // bytes 0 to 3
  UINT32BE original_reference_number_delta;  // bytes 4 to 7
  UINT32BE new_reference_number_delta;       // bytes 8 to 11
  UINT16BE short_price;                      // bytes 12 to 13
  UINT16BE short_volume;                     // bytes 14 to 15
  UINT32BE order_id;                         // bytes 16 to 19
} OrderReplaceMessageShortForm;

// This message is sent whenever an order on the book is replaced. The replacement has a new reference number and replaces the prior reference number.
typedef struct _SingleSideReplaceLongFormMessage {
  UINT32BE nanoseconds;                      // bytes 0 to 3
  UINT32BE original_reference_number_delta;  // bytes 4 to 7
  UINT32BE new_reference_number_delta;       // bytes 8 to 11
  UINT32BE price;                            // bytes 12 to 15
  UINT32BE volume;                           // bytes 16 to 19
  UINT32BE order_id;                         // bytes 20 to 23
} SingleSideReplaceLongFormMessage;

// The message is sent when an order or a side of a quote is being cancelled. All remaining contracts are no longer accessible so the side should be removed from the book.
typedef struct _SingleSideDeleteMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT32BE reference_number_delta;  // bytes 4 to 7
} SingleSideDeleteMessage;

// This message is sent whenever an order or a side of a quote is being updated for price and (or) contracts. The reference number associated with the order quote is unchanged.
typedef struct _SingleSideUpdateMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT32BE reference_number_delta;  // bytes 4 to 7
  UINT8 change_reason;              // byte 8
  UINT32BE price;                   // bytes 9 to 12
  UINT32BE volume;                  // bytes 13 to 16
} SingleSideUpdateMessage;

// This message is sent whenever a quote on the book is replaced. The replaced quote has new reference numbers on both sides.
typedef struct _QuoteReplaceShortFormMessage {
  UINT32BE nanoseconds;                          // bytes 0 to 3
  UINT32BE original_bid_reference_number_delta;  // bytes 4 to 7
  UINT32BE bid_reference_number_delta;           // bytes 8 to 11
  UINT32BE original_ask_reference_number_delta;  // bytes 12 to 15
  UINT32BE ask_reference_number_delta;           // bytes 16 to 19
  UINT16BE bid_price;                            // bytes 20 to 21
  UINT16BE short_bid_size;                       // bytes 22 to 23
  UINT16BE ask_price;                            // bytes 24 to 25
  UINT16BE short_ask_size;                       // bytes 26 to 27
} QuoteReplaceShortFormMessage;

// This message is sent whenever a quote on the book is replaced. The replaced quote has new reference numbers on both sides.
typedef struct _QuoteReplaceLongFormMessage {
  UINT32BE nanoseconds;                          // bytes 0 to 3
  UINT32BE original_bid_reference_number_delta;  // bytes 4 to 7
  UINT32BE bid_reference_number_delta;           // bytes 8 to 11
  UINT32BE original_ask_reference_number_delta;  // bytes 12 to 15
  UINT32BE ask_reference_number_delta;           // bytes 16 to 19
  UINT32BE bid;                                  // bytes 20 to 23
  UINT32BE bid_size;                             // bytes 24 to 27
  UINT32BE ask;                                  // bytes 28 to 31
  UINT32BE ask_size;                             // bytes 32 to 35
} QuoteReplaceLongFormMessage;

// The message is sent when a single quote is being cancelled. All remaining contracts are no longer accessible so the quote should be removed from the book.
typedef struct _QuoteDeleteMessage {
  UINT32BE nanoseconds;                 // bytes 0 to 3
  UINT32BE bid_reference_number_delta;  // bytes 4 to 7
  UINT32BE ask_reference_number_delta;  // bytes 8 to 11
} QuoteDeleteMessage;

// This message contains a block of Single Side Deletes. Each reference number inside the block represents an order or a side of a quote that is being cancelled. All remaining contracts are no longer accessible so the side should be removed from the book.
typedef struct _BlockDeleteMessage {
  UINT32BE nanoseconds;                                                                                      // bytes 0 to 3
  UINT16BE number_of_reference_number_deltas;                                                                // bytes 4 to 5
  UINT32BE cancelled_reference_number_delta[:byte-size (((UINT32) number_of_reference_number_deltas) * 4)];
} BlockDeleteMessage;

// This Options Trade Message is designed to provide execution details for match events involving non-displayable order types and Complex orders. (Note: There is a separate message for Option auction events.)
typedef struct _NonAuctionOptionsTradeMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT8 trade_indicator;  // byte 4
  UINT32BE option_id;     // bytes 5 to 8
  UINT32BE cross_number;  // bytes 9 to 12
  UINT32BE match_number;  // bytes 13 to 16
  UINT32BE price;         // bytes 17 to 20
  UINT32BE volume;        // bytes 21 to 24
} NonAuctionOptionsTradeMessage;

// Options Auction Trade message is sent for every option when an auction in that option is completed. The message indicates the bulk volume associated with the auction event.
typedef struct _OptionsCrossTradeMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT32BE option_id;     // bytes 4 to 7
  UINT32BE cross_number;  // bytes 8 to 11
  UINT32BE match_number;  // bytes 12 to 15
  UINT8 cross_type;       // byte 16
  UINT32BE price;         // bytes 17 to 20
  UINT32BE volume;        // bytes 21 to 24
} OptionsCrossTradeMessage;

// The Broken Trade Message is sent whenever an execution on PHLX is broken. An execution may be broken if it is found to be clearly erroneous pursuant to PHLX Clearly Erroneous Policy. A trade break is final; once a trade is broken, it cannot be reinstated.
typedef struct _BrokenTradeOrderExecutionMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT32BE cross_number;  // bytes 4 to 7
  UINT32BE match_number;  // bytes 8 to 11
} BrokenTradeOrderExecutionMessage;

// This message is also sent as notification that there is an exposed buy (sell) order available for execution at the National Best Offer (Bid).
typedef struct _AuctionNotificationMessage {
  UINT32BE nanoseconds;       // bytes 0 to 3
  UINT32BE auction_id;        // bytes 4 to 7
  UINT8 auction_type;         // byte 8
  UINT32BE paired_contracts;  // bytes 9 to 12
  UINT8 imbalance_direction;  // byte 13
  UINT32BE option_id;         // bytes 14 to 17
  UINT32BE imbalance_price;   // bytes 18 to 21
  UINT32BE imbalance_volume;  // bytes 22 to 25
  UINT8 customer_indicator;   // byte 26
  UINT8 reserved_3[3];        // bytes 27 to 29
} AuctionNotificationMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: SecondsMessage seconds_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x4C: BaseReferenceMessage base_reference_message;
    case 0x52: OptionDirectoryMessage option_directory_message;
    case 0x48: TradingActionMessage trading_action_message;
    case 0x4F: SecurityOpenMessage security_open_message;
    case 0x61: AddOrderMessageShortForm add_order_message_short_form;
    case 0x41: AddOrderMessageLongForm add_order_message_long_form;
    case 0x6A: AddQuoteMessageShortForm add_quote_message_short_form;
    case 0x4A: AddQuoteMessageLongForm add_quote_message_long_form;
    case 0x45: SingleSideExecutedMessage single_side_executed_message;
    case 0x43: SingleSideExecutedWithPriceMessage single_side_executed_with_price_message;
    case 0x58: SingleSideCancelMessage single_side_cancel_message;
    case 0x75: SingleSideReplaceMessageShortForm single_side_replace_message_short_form;
    case 0x55: SingleSideReplaceMessageLongForm single_side_replace_message_long_form;
    case 0x76: OrderReplaceMessageShortForm order_replace_message_short_form;
    case 0x56: SingleSideReplaceLongFormMessage single_side_replace_long_form_message;
    case 0x44: SingleSideDeleteMessage single_side_delete_message;
    case 0x47: SingleSideUpdateMessage single_side_update_message;
    case 0x6B: QuoteReplaceShortFormMessage quote_replace_short_form_message;
    case 0x4B: QuoteReplaceLongFormMessage quote_replace_long_form_message;
    case 0x59: QuoteDeleteMessage quote_delete_message;
    case 0x5A: BlockDeleteMessage block_delete_message;
    case 0x50: NonAuctionOptionsTradeMessage non_auction_options_trade_message;
    case 0x51: OptionsCrossTradeMessage options_cross_trade_message;
    case 0x42: BrokenTradeOrderExecutionMessage broken_trade_order_execution_message;
    case 0x49: AuctionNotificationMessage auction_notification_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

