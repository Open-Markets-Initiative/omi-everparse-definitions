#define MARKET_CATEGORY_NASDAQ_GLOBAL_SELECT_MARKET_SM 0x51  // Nasdaq Global Select Market Sm
#define MARKET_CATEGORY_NASDAQ_GLOBAL_MARKET_SM 0x47         // Nasdaq Global Market Sm
#define MARKET_CATEGORY_NASDAQ_CAPITAL_MARKET 0x53           // Nasdaq Capital Market
