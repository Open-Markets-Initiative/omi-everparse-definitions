  UINT32BE price;               // bytes 25 to 28
  UINT8 mpid[4];                // bytes 29 to 32
} PriceLevelUpdateMessage;

// ---- Net Order Imbalance Indicator Message: 47 bytes -------------------------

// Net Order Imbalance Indicator disseminated for Opening, Closing, Halt/IPO/Pause, and Extended Trading Close crosses
entrypoint typedef struct _NetOrderImbalanceIndicatorMessage {
  UINT16BE tracking_number;          // bytes 0 to 1
