} OperationalHaltMessage;

// ---- Price Level Update Message: 33 bytes ------------------------------------

// Disseminated whenever the aggregated position at a price level changes
entrypoint typedef struct _PriceLevelUpdateMessage {
  UINT16BE tracking_number;     // bytes 0 to 1
