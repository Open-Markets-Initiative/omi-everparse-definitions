} SystemEventMessage;

// ---- Stock Directory Message: 19 bytes ---------------------------------------

// Market data redistributors should process this message to populate the Financial Status Indicator (required display field) and the Market Category (recommended display field) for NASDAQ-listed issues.
entrypoint typedef struct _StockDirectoryMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT8 stock[8];                    // bytes 4 to 11
  UINT8 market_category;             // byte 12
  UINT8 financial_status_indicator;  // byte 13
  UINT32BE round_lot_size;           // bytes 14 to 17
