// ---- Server Packet Header: 1 byte --------------------------------------------

// SoupTcp Packet Header sent by the server
entrypoint typedef struct _ServerPacketHeader {
  UINT8 server_packet_type;  // byte 0
} ServerPacketHeader;

// ---- Login Accepted Packet: 20 bytes -----------------------------------------

// The SoupTcp server sends a Login Accepted Packet in response to receiving a valid Login Request from the client.
entrypoint typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[10];  // bytes 10 to 19
} LoginAcceptedPacket;

// ---- Login Rejected Packet: 1 byte -------------------------------------------

// The SoupTcp server sends this packet in response to an invalid Login Request Packet from the client.
entrypoint typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// ---- Sequenced Message Header: 8 bytes ---------------------------------------

// Time and type carried ahead of every sequenced Itch message
entrypoint typedef struct _SequencedMessageHeader {
  UINT8 timestamp[7];  // bytes 0 to 6
  UINT8 message_type;  // byte 7
} SequencedMessageHeader;

// ---- System Event Message: 1 byte --------------------------------------------

// System Event Messages signal events that affect the entire NASDAQ system.
entrypoint typedef struct _SystemEventMessage {
  UINT8 event_code;  // byte 0
} SystemEventMessage;

// ---- Add Order Message: 46 bytes ---------------------------------------------

// An Add Order Message indicates that a new order has been accepted by the NASDAQ system and added onto the book. It includes a session-unique Order Reference Number assigned by NASDAQ to the order, all other fields were specified by the party who entered the order. You will not receive an Add Order Message when a non-displayed order is added to the book.
entrypoint typedef struct _AddOrderMessage {
  UINT8 order_reference_number[9];  // bytes 0 to 8
  UINT8 side;                       // byte 9
  UINT8 shares[9];                  // bytes 10 to 18
  UINT8 stock[6];                   // bytes 19 to 24
  UINT8 price[20];                  // bytes 25 to 44
  UINT8 display;                    // byte 45
} AddOrderMessage;

// ---- Order Executed Message: 31 bytes ----------------------------------------

// This message is sent whenever an order on the book is executed in whole or in part. The execution price is always the limit price of the order already on the book.
entrypoint typedef struct _OrderExecutedMessage {
  UINT8 order_reference_number[9];  // bytes 0 to 8
  UINT8 executed_shares[9];         // bytes 9 to 17
  UINT8 match_number[9];            // bytes 18 to 26
  UINT8 contra_broker_code[4];      // bytes 27 to 30
} OrderExecutedMessage;

// ---- Order Cancel Message: 18 bytes ------------------------------------------

// This message is sent whenever an order on the book is modified as a result of being canceled in whole or in part.
entrypoint typedef struct _OrderCancelMessage {
  UINT8 order_reference_number[9];  // bytes 0 to 8
  UINT8 canceled_shares[9];         // bytes 9 to 17
} OrderCancelMessage;

// ---- Trade Message: 58 bytes -------------------------------------------------

// The Trade Message provides information about execution events that involve orders not visible on the NASDAQ book. A Trade Message is transmitted each time a hidden order is executed in whole or in part.
entrypoint typedef struct _TradeMessage {
  UINT8 order_reference_number[9];  // bytes 0 to 8
  UINT8 side;                       // byte 9
  UINT8 shares[9];                  // bytes 10 to 18
  UINT8 stock[6];                   // bytes 19 to 24
  UINT8 price[20];                  // bytes 25 to 44
  UINT8 match_number[9];            // bytes 45 to 53
  UINT8 contra_broker_code[4];      // bytes 54 to 57
} TradeMessage;

// ---- Broken Trade Message: 9 bytes -------------------------------------------

// The Broken Trade message is sent whenever an execution on NASDAQ is broken.
entrypoint typedef struct _BrokenTradeMessage {
  UINT8 match_number[9];  // bytes 0 to 8
} BrokenTradeMessage;

