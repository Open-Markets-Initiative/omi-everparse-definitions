// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NsmEquities_TotalView_v4_0_f_Udp.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_TIMESTAMP_MESSAGE 0x54                      // Timestamp Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                   // System Event Message
#define MESSAGE_TYPE_STOCK_DIRECTORY_MESSAGE 0x52                // Stock Directory Message
#define MESSAGE_TYPE_STOCK_TRADING_ACTION_MESSAGE 0x48           // Stock Trading Action Message
#define MESSAGE_TYPE_MARKET_PARTICIPANT_POSITION_MESSAGE 0x4C    // Market Participant Position Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x41                      // Add Order Message
#define MESSAGE_TYPE_ADD_ORDER_WITH_MPID_MESSAGE 0x46            // Add Order With Mpid Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45                 // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_WITH_PRICE_MESSAGE 0x43      // Order Executed With Price Message
#define MESSAGE_TYPE_ORDER_CANCEL_MESSAGE 0x58                   // Order Cancel Message
#define MESSAGE_TYPE_ORDER_DELETE_MESSAGE 0x44                   // Order Delete Message
#define MESSAGE_TYPE_ORDER_REPLACE_MESSAGE 0x55                  // Order Replace Message
#define MESSAGE_TYPE_ORDER_DISPLAY_MESSAGE 0x56                  // Order Display Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x50                          // Trade Message
#define MESSAGE_TYPE_CROSS_TRADE_MESSAGE 0x51                    // Cross Trade Message
#define MESSAGE_TYPE_BROKEN_TRADE_MESSAGE 0x42                   // Broken Trade Message
#define MESSAGE_TYPE_NET_ORDER_IMBALANCE_INDICATOR_MESSAGE 0x49  // Net Order Imbalance Indicator Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F                             // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53                         // Start Of System Hours
#define EVENT_CODE_START_OF_MARKET_HOURS 0x51                         // Start Of Market Hours
#define EVENT_CODE_END_OF_MARKET_HOURS 0x4D                           // End Of Market Hours
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45                           // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                               // End Of Messages
#define EVENT_CODE_EMERGENCY_MARKET_CONDITION_HALT 0x41               // Emergency Market Condition Halt
#define EVENT_CODE_EMERGENCY_MARKET_CONDITION_QUOTE_ONLY_PERIOD 0x52  // Emergency Market Condition Quote Only Period
#define EVENT_CODE_EMERGENCY_MARKET_CONDITION_RESUMPTION 0x42         // Emergency Market Condition Resumption

// Market Category: one byte code
#define MARKET_CATEGORY_CQS 0x54                          // Cqs
#define MARKET_CATEGORY_NASDAQ_GLOBAL_SELECT_MARKET 0x51  // Nasdaq Global Select Market
#define MARKET_CATEGORY_NASDAQ_GLOBAL_MARKET 0x47         // Nasdaq Global Market
#define MARKET_CATEGORY_NASDAQ_CAPITAL_MARKET 0x53        // Nasdaq Capital Market

// Financial Status Indicator: one byte code
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT 0x44                          // Deficient
#define FINANCIAL_STATUS_INDICATOR_DELINQUENT 0x45                         // Delinquent
#define FINANCIAL_STATUS_INDICATOR_BANKRUPT 0x51                           // Bankrupt
#define FINANCIAL_STATUS_INDICATOR_SUSPENDED 0x53                          // Suspended
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_AND_BANKRUPT 0x47             // Deficient And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_AND_DELINQUENT 0x48           // Deficient And Delinquent
#define FINANCIAL_STATUS_INDICATOR_DELINQUENT_AND_BANKRUPT 0x4A            // Delinquent And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_DELINQUENT_AND_BANKRUPT 0x4B  // Deficient Delinquent And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_IN_COMPLIANCE 0x20                      // In Compliance

// Round Lots Only: one byte code
#define ROUND_LOTS_ONLY_ROUND_LOTS_ONLY 0x59         // Round Lots Only
#define ROUND_LOTS_ONLY_ODD_MIXED_LOTS_ALLOWED 0x4E  // Odd Mixed Lots Allowed

// Trading State: one byte code
#define TRADING_STATE_HALTED 0x48                 // Halted
#define TRADING_STATE_QUOTATION_ONLY_PERIOD 0x51  // Quotation Only Period
#define TRADING_STATE_TRADING 0x54                // Trading

// Primary Market Maker: one byte code
#define PRIMARY_MARKET_MAKER_PRIMARY 0x59      // Primary
#define PRIMARY_MARKET_MAKER_NON_PRIMARY 0x4E  // Non Primary

// Market Maker Mode: one byte code
#define MARKET_MAKER_MODE_NORMAL 0x4E         // Normal
#define MARKET_MAKER_MODE_PASSIVE 0x50        // Passive
#define MARKET_MAKER_MODE_SYNDICATE 0x53      // Syndicate
#define MARKET_MAKER_MODE_PRE_SYNDICATE 0x52  // Pre Syndicate
#define MARKET_MAKER_MODE_PENALTY 0x4C        // Penalty

// Market Participant State: one byte code
#define MARKET_PARTICIPANT_STATE_ACTIVE 0x41             // Active
#define MARKET_PARTICIPANT_STATE_EXCUSED_WITHDRAWN 0x45  // Excused Withdrawn
#define MARKET_PARTICIPANT_STATE_WITHDRAWN 0x57          // Withdrawn
#define MARKET_PARTICIPANT_STATE_SUSPENDED 0x53          // Suspended
#define MARKET_PARTICIPANT_STATE_DELETED 0x44            // Deleted

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Display: one byte code
#define DISPLAY_DISPLAYABLE 0x59  // Displayable
#define DISPLAY_FLASH 0x53        // Flash

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// Cross Type: one byte code
#define CROSS_TYPE_OPENING 0x4F         // Opening
#define CROSS_TYPE_CLOSING 0x43         // Closing
#define CROSS_TYPE_IPO_AND_HALTED 0x48  // Ipo And Halted
#define CROSS_TYPE_CROSS_NETWORK 0x49   // Cross Network

// Imbalance Direction: one byte code
#define IMBALANCE_DIRECTION_BUY 0x42                  // Buy
#define IMBALANCE_DIRECTION_SELL 0x53                 // Sell
#define IMBALANCE_DIRECTION_NO_IMBALANCE 0x4E         // No Imbalance
#define IMBALANCE_DIRECTION_INSUFFICIENT_ORDERS 0x4F  // Insufficient Orders

// Price Variation Indicator: one byte code
#define PRICE_VARIATION_INDICATOR_LESS_THAN_ONE_PERCENT 0x4C                          // Less Than One Percent
#define PRICE_VARIATION_INDICATOR_ONE_TO_ONE_POINT_NINE_NINE_PERCENT 0x31             // One To One Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_TWO_TO_TWO_POINT_NINE_NINE_PERCENT 0x32             // Two To Two Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_THREE_TO_THREE_POINT_NINE_NINE_PERCENT 0x33         // Three To Three Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_FOUR_TO_FOUR_POINT_NINE_NINE_PERCENT 0x34           // Four To Four Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_FIVE_TO_FIVE_POINT_NINE_NINE_PERCENT 0x35           // Five To Five Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_SIX_TO_SIX_POINT_NINE_NINE_PERCENT 0x36             // Six To Six Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_SEVEN_TO_SEVEN_POINT_NINE_NINE_PERCENT 0x37         // Seven To Seven Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_EIGHT_TO_EIGHT_POINT_NINE_NINE_PERCENT 0x38         // Eight To Eight Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_NINE_TO_NINE_POINT_NINE_NINE_PERCENT 0x39           // Nine To Nine Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_TEN_TO_NINETEEN_POINT_NINE_NINE_PERCENT 0x41        // Ten To Nineteen Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_TWENTY_TO_TWENTY_NINE_POINT_NINE_NINE_PERCENT 0x42  // Twenty To Twenty Nine Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_THIRTY_PERCENT_OR_GREATER 0x43                      // Thirty Percent Or Greater
#define PRICE_VARIATION_INDICATOR_CANNOT_BE_CALCULATED 0x20                           // Cannot Be Calculated

// ---- Types -------------------------------------------------------------------

// Reflects the number of seconds past midnight that the Timestamp message was generated.
typedef struct _TimestampMessage {
  UINT32BE second;  // bytes 0 to 3
} TimestampMessage;

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT8 event_code;      // byte 4
} SystemEventMessage;

// Market data redistributors should process this message to populate the Financial Status Indicator (required display field) and the Market Category (recommended display field) for NASDAQ-listed issues.
typedef struct _StockDirectoryMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT8 stock[6];                    // bytes 4 to 9
  UINT8 market_category;             // byte 10
  UINT8 financial_status_indicator;  // byte 11
  UINT32BE round_lot_size;           // bytes 12 to 15
  UINT8 round_lots_only;             // byte 16
} StockDirectoryMessage;

// NASDAQ uses this administrative message to indicate the current trading status of a security to the trading community.
typedef struct _StockTradingActionMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT8 stock[6];        // bytes 4 to 9
  UINT8 trading_state;   // byte 10
  UINT8 reserved;        // byte 11
  UINT8 reason[4];       // bytes 12 to 15
} StockTradingActionMessage;

// At the start of each trading day, NASDAQ disseminates a spin of market participant position messages. Throughout the day, NASDAQ will send out this message only if NASDAQ Operations changes the status of a market participant firm in an issue.
typedef struct _MarketParticipantPositionMessage {
  UINT32BE nanoseconds;            // bytes 0 to 3
  UINT8 mpid[4];                   // bytes 4 to 7
  UINT8 stock[6];                  // bytes 8 to 13
  UINT8 primary_market_maker;      // byte 14
  UINT8 market_maker_mode;         // byte 15
  UINT8 market_participant_state;  // byte 16
} MarketParticipantPositionMessage;

// This message will be generated for unattributed orders accepted by the NASDAQ system.
typedef struct _AddOrderMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT64BE order_reference_number;  // bytes 4 to 11
  UINT8 side;                       // byte 12
  UINT32BE shares;                  // bytes 13 to 16
  UINT8 stock[6];                   // bytes 17 to 22
  UINT32BE price;                   // bytes 23 to 26
  UINT8 display;                    // byte 27
} AddOrderMessage;

// This message will be generated for attributed orders and quotations accepted by the NASDAQ system.
typedef struct _AddOrderWithMpidMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT64BE order_reference_number;  // bytes 4 to 11
  UINT8 side;                       // byte 12
  UINT32BE shares;                  // bytes 13 to 16
  UINT8 stock[6];                   // bytes 17 to 22
  UINT32BE price;                   // bytes 23 to 26
  UINT8 attribution[4];             // bytes 27 to 30
} AddOrderWithMpidMessage;

// This message is sent whenever an order on the book is executed in whole or in part.
typedef struct _OrderExecutedMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT64BE order_reference_number;  // bytes 4 to 11
  UINT32BE executed_shares;         // bytes 12 to 15
  UINT64BE match_number;            // bytes 16 to 23
} OrderExecutedMessage;

// This message is sent whenever an order on the book is executed in whole or in part at a price different from the initial display price.
typedef struct _OrderExecutedWithPriceMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT64BE order_reference_number;  // bytes 4 to 11
  UINT32BE executed_shares;         // bytes 12 to 15
  UINT64BE match_number;            // bytes 16 to 23
  UINT8 printable;                  // byte 24
  UINT32BE execution_price;         // bytes 25 to 28
} OrderExecutedWithPriceMessage;

// This message is sent whenever an order on the book is modified as a result of a partial cancellation.
typedef struct _OrderCancelMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT64BE order_reference_number;  // bytes 4 to 11
  UINT32BE canceled_shares;         // bytes 12 to 15
} OrderCancelMessage;

// This message is sent whenever an order on the book is being cancelled. All remaining shares are no longer accessible so the order must be removed from the book.
typedef struct _OrderDeleteMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT64BE order_reference_number;  // bytes 4 to 11
} OrderDeleteMessage;

// This message is sent whenever an order on the book has been cancel-replaced. All remaining shares from the original order are no longer accessible, and must be removed. The new order details are provided for the replacement, along with a new order reference number which will be used henceforth.
typedef struct _OrderReplaceMessage {
  UINT32BE nanoseconds;                      // bytes 0 to 3
  UINT64BE original_order_reference_number;  // bytes 4 to 11
  UINT64BE new_order_reference_number;       // bytes 12 to 19
  UINT32BE shares;                           // bytes 20 to 23
  UINT32BE price;                            // bytes 24 to 27
  UINT8 display;                             // byte 28
} OrderReplaceMessage;

// This message is disseminated to alert the TotalView-ITCH users that a Flash order has been added to the continuous order book for display on all NASDAQ data feeds.
typedef struct _OrderDisplayMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT64BE order_reference_number;  // bytes 4 to 11
} OrderDisplayMessage;

// The Trade Message is designed to provide execution details for normal match events involving non-displayable order types.
typedef struct _TradeMessage {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT64BE order_reference_number;  // bytes 4 to 11
  UINT8 side;                       // byte 12
  UINT32BE shares;                  // bytes 13 to 16
  UINT8 stock[6];                   // bytes 17 to 22
  UINT32BE price;                   // bytes 23 to 26
  UINT64BE match_number;            // bytes 27 to 34
} TradeMessage;

// Cross Trade message indicates that NASDAQ has completed its cross process for a specific security.
typedef struct _CrossTradeMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT64BE cross_shares;  // bytes 4 to 11
  UINT8 stock[6];         // bytes 12 to 17
  UINT32BE cross_price;   // bytes 18 to 21
  UINT64BE match_number;  // bytes 22 to 29
  UINT8 cross_type;       // byte 30
} CrossTradeMessage;

// The Broken Trade Message is sent whenever an execution on NASDAQ is broken.
typedef struct _BrokenTradeMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT64BE match_number;  // bytes 4 to 11
} BrokenTradeMessage;

// NASDAQ disseminates NOII data at 5-second intervals in the minutes leading up to the NASDAQ Opening Cross and NASDAQ Closing Cross.
typedef struct _NetOrderImbalanceIndicatorMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT64BE paired_shares;            // bytes 4 to 11
  UINT64BE imbalance_shares;         // bytes 12 to 19
  UINT8 imbalance_direction;         // byte 20
  UINT8 stock[6];                    // bytes 21 to 26
  UINT32BE far_price;                // bytes 27 to 30
  UINT32BE near_price;               // bytes 31 to 34
  UINT32BE current_reference_price;  // bytes 35 to 38
  UINT8 cross_type;                  // byte 39
  UINT8 price_variation_indicator;   // byte 40
} NetOrderImbalanceIndicatorMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: TimestampMessage timestamp_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x52: StockDirectoryMessage stock_directory_message;
    case 0x48: StockTradingActionMessage stock_trading_action_message;
    case 0x4C: MarketParticipantPositionMessage market_participant_position_message;
    case 0x41: AddOrderMessage add_order_message;
    case 0x46: AddOrderWithMpidMessage add_order_with_mpid_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceMessage order_executed_with_price_message;
    case 0x58: OrderCancelMessage order_cancel_message;
    case 0x44: OrderDeleteMessage order_delete_message;
    case 0x55: OrderReplaceMessage order_replace_message;
    case 0x56: OrderDisplayMessage order_display_message;
    case 0x50: TradeMessage trade_message;
    case 0x51: CrossTradeMessage cross_trade_message;
    case 0x42: BrokenTradeMessage broken_trade_message;
    case 0x49: NetOrderImbalanceIndicatorMessage net_order_imbalance_indicator_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

