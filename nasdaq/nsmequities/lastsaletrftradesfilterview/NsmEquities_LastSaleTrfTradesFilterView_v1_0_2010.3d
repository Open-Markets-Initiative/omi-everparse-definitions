// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NsmEquities_LastSaleTrfTradesFilterView_v1_0_2010.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53        // System Event Message
#define MESSAGE_TYPE_TRADE_REPORT_MESSAGE 0x54        // Trade Report Message
#define MESSAGE_TYPE_TRADE_CANCEL_ERROR_MESSAGE 0x58  // Trade Cancel Error Message
#define MESSAGE_TYPE_TRADE_CORRECTION_MESSAGE 0x43    // Trade Correction Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_TRANSMISSIONS 0x4F  // Start Of Transmissions
#define EVENT_CODE_END_OF_TRANSMISSIONS 0x43    // End Of Transmissions

// Market Center Identifier: one byte code
#define MARKET_CENTER_IDENTIFIER_NASDAQ 0x51  // Nasdaq
#define MARKET_CENTER_IDENTIFIER_TRF 0x4C     // Trf

// Security Class: one byte code
#define SECURITY_CLASS_NASDAQ 0x51     // Nasdaq
#define SECURITY_CLASS_NYSE 0x4E       // Nyse
#define SECURITY_CLASS_NYSE_AMEX 0x41  // Nyse Amex
#define SECURITY_CLASS_NYSE_ARCA 0x50  // Nyse Arca

// Settlement Type: one byte code
#define SETTLEMENT_TYPE_REGULAR_SETTLEMENT 0x40   // Regular Settlement
#define SETTLEMENT_TYPE_CASH_SETTLEMENT 0x43      // Cash Settlement
#define SETTLEMENT_TYPE_NEXT_DAY_SETTLEMENT 0x4E  // Next Day Settlement
#define SETTLEMENT_TYPE_SELLER_SETTLEMENT 0x52    // Seller Settlement

// Trade Through Exemption: one byte code
#define TRADE_THROUGH_EXEMPTION_INTERMARKET_SWEEP 0x46  // Intermarket Sweep
#define TRADE_THROUGH_EXEMPTION_OPENING_PRINT 0x4F      // Opening Print
#define TRADE_THROUGH_EXEMPTION_DERIVATIVE_PRICED 0x34  // Derivative Priced
#define TRADE_THROUGH_EXEMPTION_RE_OPENING_PRINT 0x35   // Re Opening Print
#define TRADE_THROUGH_EXEMPTION_CLOSING_PRINT 0x36      // Closing Print
#define TRADE_THROUGH_EXEMPTION_NOT_APPLICABLE 0x20     // Not Applicable

// Extended Hours Or Sold Code: one byte code
#define EXTENDED_HOURS_OR_SOLD_CODE_EXTENDED_HOURS_TRADE 0x54                                   // Extended Hours Trade
#define EXTENDED_HOURS_OR_SOLD_CODE_EXTENDED_HOURS_TRADE_REPORTED_LATE_OR_OUT_OF_SEQUENCE 0x55  // Extended Hours Trade Reported Late Or Out Of Sequence
#define EXTENDED_HOURS_OR_SOLD_CODE_SOLD_LAST_REPORTED_LATE_BUT_IN_SEQUENCE 0x4C                // Sold Last Reported Late But In Sequence
#define EXTENDED_HOURS_OR_SOLD_CODE_SOLD_OUT_OF_SEQUENCE 0x5A                                   // Sold Out Of Sequence
#define EXTENDED_HOURS_OR_SOLD_CODE_NOT_APPLICABLE 0x20                                         // Not Applicable

// Special Sale Condition: one byte code
#define SPECIAL_SALE_CONDITION_ACQUISITION 0x41                  // Acquisition
#define SPECIAL_SALE_CONDITION_BUNCHED 0x42                      // Bunched
#define SPECIAL_SALE_CONDITION_DISTRIBUTION 0x44                 // Distribution
#define SPECIAL_SALE_CONDITION_PRICE_VARIATION_TRANSACTION 0x48  // Price Variation Transaction
#define SPECIAL_SALE_CONDITION_OFFICIAL_CLOSE_PRICE 0x4D         // Official Close Price
#define SPECIAL_SALE_CONDITION_PRIOR_REFERENCE_PRICE 0x50        // Prior Reference Price
#define SPECIAL_SALE_CONDITION_OFFICIAL_OPENING_PRICE 0x51       // Official Opening Price
#define SPECIAL_SALE_CONDITION_SPLIT_TRADE 0x53                  // Split Trade
#define SPECIAL_SALE_CONDITION_WEIGHTED_AVERAGE_PRICE 0x57       // Weighted Average Price
#define SPECIAL_SALE_CONDITION_CROSS_TRADE 0x58                  // Cross Trade
#define SPECIAL_SALE_CONDITION_ODD_LOT_EXECUTION 0x6F            // Odd Lot Execution
#define SPECIAL_SALE_CONDITION_NOT_APPLICABLE 0x20               // Not Applicable

// Original Settlement Type: one byte code
#define ORIGINAL_SETTLEMENT_TYPE_REGULAR_SETTLEMENT 0x40   // Regular Settlement
#define ORIGINAL_SETTLEMENT_TYPE_CASH_SETTLEMENT 0x43      // Cash Settlement
#define ORIGINAL_SETTLEMENT_TYPE_NEXT_DAY_SETTLEMENT 0x4E  // Next Day Settlement
#define ORIGINAL_SETTLEMENT_TYPE_SELLER_SETTLEMENT 0x52    // Seller Settlement

// Original Trade Through Exemption: one byte code
#define ORIGINAL_TRADE_THROUGH_EXEMPTION_INTERMARKET_SWEEP 0x46  // Intermarket Sweep
#define ORIGINAL_TRADE_THROUGH_EXEMPTION_OPENING_PRINT 0x4F      // Opening Print
#define ORIGINAL_TRADE_THROUGH_EXEMPTION_DERIVATIVE_PRICED 0x34  // Derivative Priced
#define ORIGINAL_TRADE_THROUGH_EXEMPTION_RE_OPENING_PRINT 0x35   // Re Opening Print
#define ORIGINAL_TRADE_THROUGH_EXEMPTION_CLOSING_PRINT 0x36      // Closing Print
#define ORIGINAL_TRADE_THROUGH_EXEMPTION_NOT_APPLICABLE 0x20     // Not Applicable

// Original Extended Hours Or Sold Code: one byte code
#define ORIGINAL_EXTENDED_HOURS_OR_SOLD_CODE_EXTENDED_HOURS_TRADE 0x54                                   // Extended Hours Trade
#define ORIGINAL_EXTENDED_HOURS_OR_SOLD_CODE_EXTENDED_HOURS_TRADE_REPORTED_LATE_OR_OUT_OF_SEQUENCE 0x55  // Extended Hours Trade Reported Late Or Out Of Sequence
#define ORIGINAL_EXTENDED_HOURS_OR_SOLD_CODE_SOLD_LAST_REPORTED_LATE_BUT_IN_SEQUENCE 0x4C                // Sold Last Reported Late But In Sequence
#define ORIGINAL_EXTENDED_HOURS_OR_SOLD_CODE_SOLD_OUT_OF_SEQUENCE 0x5A                                   // Sold Out Of Sequence
#define ORIGINAL_EXTENDED_HOURS_OR_SOLD_CODE_NOT_APPLICABLE 0x20                                         // Not Applicable

// Original Special Sale Condition: one byte code
#define ORIGINAL_SPECIAL_SALE_CONDITION_ACQUISITION 0x41                  // Acquisition
#define ORIGINAL_SPECIAL_SALE_CONDITION_BUNCHED 0x42                      // Bunched
#define ORIGINAL_SPECIAL_SALE_CONDITION_DISTRIBUTION 0x44                 // Distribution
#define ORIGINAL_SPECIAL_SALE_CONDITION_PRICE_VARIATION_TRANSACTION 0x48  // Price Variation Transaction
#define ORIGINAL_SPECIAL_SALE_CONDITION_OFFICIAL_CLOSE_PRICE 0x4D         // Official Close Price
#define ORIGINAL_SPECIAL_SALE_CONDITION_PRIOR_REFERENCE_PRICE 0x50        // Prior Reference Price
#define ORIGINAL_SPECIAL_SALE_CONDITION_OFFICIAL_OPENING_PRICE 0x51       // Official Opening Price
#define ORIGINAL_SPECIAL_SALE_CONDITION_SPLIT_TRADE 0x53                  // Split Trade
#define ORIGINAL_SPECIAL_SALE_CONDITION_WEIGHTED_AVERAGE_PRICE 0x57       // Weighted Average Price
#define ORIGINAL_SPECIAL_SALE_CONDITION_CROSS_TRADE 0x58                  // Cross Trade
#define ORIGINAL_SPECIAL_SALE_CONDITION_ODD_LOT_EXECUTION 0x6F            // Odd Lot Execution
#define ORIGINAL_SPECIAL_SALE_CONDITION_NOT_APPLICABLE 0x20               // Not Applicable

// Corrected Settlement Type: one byte code
#define CORRECTED_SETTLEMENT_TYPE_REGULAR_SETTLEMENT 0x40   // Regular Settlement
#define CORRECTED_SETTLEMENT_TYPE_CASH_SETTLEMENT 0x43      // Cash Settlement
#define CORRECTED_SETTLEMENT_TYPE_NEXT_DAY_SETTLEMENT 0x4E  // Next Day Settlement
#define CORRECTED_SETTLEMENT_TYPE_SELLER_SETTLEMENT 0x52    // Seller Settlement

// Corrected Trade Through Exemption: one byte code
#define CORRECTED_TRADE_THROUGH_EXEMPTION_INTERMARKET_SWEEP 0x46  // Intermarket Sweep
#define CORRECTED_TRADE_THROUGH_EXEMPTION_OPENING_PRINT 0x4F      // Opening Print
#define CORRECTED_TRADE_THROUGH_EXEMPTION_DERIVATIVE_PRICED 0x34  // Derivative Priced
#define CORRECTED_TRADE_THROUGH_EXEMPTION_RE_OPENING_PRINT 0x35   // Re Opening Print
#define CORRECTED_TRADE_THROUGH_EXEMPTION_CLOSING_PRINT 0x36      // Closing Print
#define CORRECTED_TRADE_THROUGH_EXEMPTION_NOT_APPLICABLE 0x20     // Not Applicable

// Corrected Extended Hours Or Sold Code: one byte code
#define CORRECTED_EXTENDED_HOURS_OR_SOLD_CODE_EXTENDED_HOURS_TRADE 0x54                                   // Extended Hours Trade
#define CORRECTED_EXTENDED_HOURS_OR_SOLD_CODE_EXTENDED_HOURS_TRADE_REPORTED_LATE_OR_OUT_OF_SEQUENCE 0x55  // Extended Hours Trade Reported Late Or Out Of Sequence
#define CORRECTED_EXTENDED_HOURS_OR_SOLD_CODE_SOLD_LAST_REPORTED_LATE_BUT_IN_SEQUENCE 0x4C                // Sold Last Reported Late But In Sequence
#define CORRECTED_EXTENDED_HOURS_OR_SOLD_CODE_SOLD_OUT_OF_SEQUENCE 0x5A                                   // Sold Out Of Sequence
#define CORRECTED_EXTENDED_HOURS_OR_SOLD_CODE_NOT_APPLICABLE 0x20                                         // Not Applicable

// Corrected Special Sale Condition: one byte code
#define CORRECTED_SPECIAL_SALE_CONDITION_ACQUISITION 0x41                  // Acquisition
#define CORRECTED_SPECIAL_SALE_CONDITION_BUNCHED 0x42                      // Bunched
#define CORRECTED_SPECIAL_SALE_CONDITION_DISTRIBUTION 0x44                 // Distribution
#define CORRECTED_SPECIAL_SALE_CONDITION_PRICE_VARIATION_TRANSACTION 0x48  // Price Variation Transaction
#define CORRECTED_SPECIAL_SALE_CONDITION_OFFICIAL_CLOSE_PRICE 0x4D         // Official Close Price
#define CORRECTED_SPECIAL_SALE_CONDITION_PRIOR_REFERENCE_PRICE 0x50        // Prior Reference Price
#define CORRECTED_SPECIAL_SALE_CONDITION_OFFICIAL_OPENING_PRICE 0x51       // Official Opening Price
#define CORRECTED_SPECIAL_SALE_CONDITION_SPLIT_TRADE 0x53                  // Split Trade
#define CORRECTED_SPECIAL_SALE_CONDITION_WEIGHTED_AVERAGE_PRICE 0x57       // Weighted Average Price
#define CORRECTED_SPECIAL_SALE_CONDITION_CROSS_TRADE 0x58                  // Cross Trade
#define CORRECTED_SPECIAL_SALE_CONDITION_ODD_LOT_EXECUTION 0x6F            // Odd Lot Execution
#define CORRECTED_SPECIAL_SALE_CONDITION_NOT_APPLICABLE 0x20               // Not Applicable

// ---- Types -------------------------------------------------------------------

// System Event Messages is used to signal key market or data feed control events.
typedef struct _SystemEventMessage {
  UINT8 event_code;  // byte 0
} SystemEventMessage;

// Sale Condition Modifier
typedef struct _SaleConditionModifier {
  UINT8 settlement_type;              // byte 0
  UINT8 trade_through_exemption;      // byte 1
  UINT8 extended_hours_or_sold_code;  // byte 2
  UINT8 special_sale_condition;       // byte 3
} SaleConditionModifier;

// The following message is used to relay NASDAQ execution system and TRF trade transactions that are reported for the current business day. Please note that NASDAQ only reports one-side of a trade execution on the NASDAQ Last Sale (NLS) feed and other data feed products.
typedef struct _TradeReportMessage {
  UINT8 market_center_identifier;                 // byte 0
  UINT8 issue_symbol[6];                          // bytes 1 to 6
  UINT8 security_class;                           // byte 7
  UINT8 trade_control_number[10];                 // bytes 8 to 17
  UINT8 trade_price[10];                          // bytes 18 to 27
  UINT8 trade_size[9];                            // bytes 28 to 36
  SaleConditionModifier sale_condition_modifier;  // bytes 37 to 40
} TradeReportMessage;

// Original Sale Condition Modifier
typedef struct _OriginalSaleConditionModifier {
  UINT8 original_settlement_type;              // byte 0
  UINT8 original_trade_through_exemption;      // byte 1
  UINT8 original_extended_hours_or_sold_code;  // byte 2
  UINT8 original_special_sale_condition;       // byte 3
} OriginalSaleConditionModifier;

// The following message is used in the event that a NASDAQ or TRF trade transaction is cancelled on the same business day that it is reported.
typedef struct _TradeCancelErrorMessage {
  UINT8 market_center_identifier;                                  // byte 0
  UINT8 issue_symbol[6];                                           // bytes 1 to 6
  UINT8 security_class;                                            // byte 7
  UINT8 original_trade_control_number[10];                         // bytes 8 to 17
  UINT8 original_trade_price[10];                                  // bytes 18 to 27
  UINT8 original_trade_size[9];                                    // bytes 28 to 36
  OriginalSaleConditionModifier original_sale_condition_modifier;  // bytes 37 to 40
} TradeCancelErrorMessage;

// Corrected Sale Condition Modifier
typedef struct _CorrectedSaleConditionModifier {
  UINT8 corrected_settlement_type;              // byte 0
  UINT8 corrected_trade_through_exemption;      // byte 1
  UINT8 corrected_extended_hours_or_sold_code;  // byte 2
  UINT8 corrected_special_sale_condition;       // byte 3
} CorrectedSaleConditionModifier;

// The following message is used in the event that a TRF trade transaction is corrected on the same business day that it is reported.
typedef struct _TradeCorrectionMessage {
  UINT8 market_center_identifier;                                    // byte 0
  UINT8 issue_symbol[6];                                             // bytes 1 to 6
  UINT8 security_class;                                              // byte 7
  UINT8 original_trade_control_number[10];                           // bytes 8 to 17
  UINT8 original_trade_price[10];                                    // bytes 18 to 27
  UINT8 original_trade_size[9];                                      // bytes 28 to 36
  OriginalSaleConditionModifier original_sale_condition_modifier;    // bytes 37 to 40
  UINT8 corrected_trade_control_number[10];                          // bytes 41 to 50
  UINT8 corrected_trade_price[10];                                   // bytes 51 to 60
  UINT8 corrected_trade_size[9];                                     // bytes 61 to 69
  CorrectedSaleConditionModifier corrected_sale_condition_modifier;  // bytes 70 to 73
} TradeCorrectionMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x54: TradeReportMessage trade_report_message;
    case 0x58: TradeCancelErrorMessage trade_cancel_error_message;
    case 0x43: TradeCorrectionMessage trade_correction_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp message data
typedef struct _MessageData (UINT16 message_length) where (message_length >= 9) {
  UINT8 timestamp[8];                                                                                                               // bytes 0 to 7
  UINT8 message_type;                                                                                                               // byte 8
  Payload(message_type, (((UINT32) message_length) - 9)) payload[:byte-size-single-element-array (((UINT32) message_length) - 9)];
} MessageData;

// Branch
casetype _MessageBody (UINT16 selector, UINT16 message_length) {
  switch (selector) {
    case 0x0000: unit end_of_session;
    default: MessageData(message_length) message_data;
  }
} MessageBody;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_length;                                                                                                                                           // bytes 0 to 1
  MessageBody(message_length, message_length) message_body[:byte-size-single-element-array ((((UINT32) message_length) + 2) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT32 sequence_number;                                                                                                      // bytes 10 to 13
  UINT16 message_count;                                                                                                        // bytes 14 to 15
  Messages(message_count, message_count, (available - 16), tally) messages[:byte-size-single-element-array (available - 16)];
} Packet;

