// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerFrame, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NsmEquities_Drop_v2_2_Server.3d
//
// What this definition reads more loosely than the model states:
// - the stream is a run of frames each ending at a byte 10: the caller splits it there and validates each frame, that byte included

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet

// Message Type: one byte code
#define MESSAGE_TYPE_NEW_ORDER_ACCEPTED_MESSAGE 0x41            // New Order Accepted Message
#define MESSAGE_TYPE_EXISTING_ORDER_EXECUTED_MESSAGE 0x45       // Existing Order Executed Message
#define MESSAGE_TYPE_EXISTING_ORDER_CANCELED_MESSAGE 0x58       // Existing Order Canceled Message
#define MESSAGE_TYPE_PREVIOUS_EXECUTION_BROKEN_MESSAGE 0x42     // Previous Execution Broken Message
#define MESSAGE_TYPE_EXISTING_ORDER_REPLACED_MESSAGE 0x55       // Existing Order Replaced Message
#define MESSAGE_TYPE_EXISTING_ORDER_CANCELLED_AIQ_MESSAGE 0x59  // Existing Order Cancelled Aiq Message
#define MESSAGE_TYPE_TRADE_CORRECTION_MESSAGE 0x43              // Trade Correction Message

// Buy Sell: one byte code
#define BUY_SELL_BOUGHT 0x42             // Bought
#define BUY_SELL_SOLD 0x53               // Sold
#define BUY_SELL_SOLD_SHORT 0x54         // Sold Short
#define BUY_SELL_SOLD_SHORT_EXEMPT 0x45  // Sold Short Exempt

// Capacity: one byte code
#define CAPACITY_AGENCY 0x41     // Agency
#define CAPACITY_PRINCIPAL 0x50  // Principal
#define CAPACITY_RISKLESS 0x52   // Riskless

// Liquidity Code: one byte code
#define LIQUIDITY_CODE_ADDED 0x41                                                                             // Added
#define LIQUIDITY_CODE_REMOVED 0x52                                                                           // Removed
#define LIQUIDITY_CODE_ROUTED 0x58                                                                            // Routed
#define LIQUIDITY_CODE_DOT 0x44                                                                               // Dot
#define LIQUIDITY_CODE_OPENING_TRADE_ON_NYSE 0x46                                                             // Opening Trade On Nyse
#define LIQUIDITY_CODE_ON_CLOSE_ORDER_ON_NYSE 0x47                                                            // On Close Order On Nyse
#define LIQUIDITY_CODE_OPENING_CROSS 0x4F                                                                     // Opening Cross
#define LIQUIDITY_CODE_OPENING_CROSS_IMBALANCE_ONLY 0x4D                                                      // Opening Cross Imbalance Only
#define LIQUIDITY_CODE_CLOSING_CROSS 0x43                                                                     // Closing Cross
#define LIQUIDITY_CODE_CLOSING_CROSS_IMBALANCE_ONLY 0x4C                                                      // Closing Cross Imbalance Only
#define LIQUIDITY_CODE_HALT_IPO_CROSS 0x48                                                                    // Halt Ipo Cross
#define LIQUIDITY_CODE_HALT_CROSS 0x4B                                                                        // Halt Cross
#define LIQUIDITY_CODE_NON_DISPLAYED_ADDING_LIQUIDITY 0x4A                                                    // Non Displayed Adding Liquidity
#define LIQUIDITY_CODE_RE_ROUTED_BY_NYSE 0x59                                                                 // Re Routed By Nyse
#define LIQUIDITY_CODE_ODD_LOT_EXECUTION_ON_NYSE 0x53                                                         // Odd Lot Execution On Nyse
#define LIQUIDITY_CODE_ADDED_LIQUIDITY_ON_NYSE 0x55                                                           // Added Liquidity On Nyse
#define LIQUIDITY_CODE_ROUTED_TO_BX 0x42                                                                      // Routed To Bx
#define LIQUIDITY_CODE_NYSE_OTHER 0x45                                                                        // Nyse Other
#define LIQUIDITY_CODE_ROUTED_TO_PSX 0x50                                                                     // Routed To Psx
#define LIQUIDITY_CODE_OPENING_TRADE_ON_ARCA 0x54                                                             // Opening Trade On Arca
#define LIQUIDITY_CODE_ON_CLOSE_ORDER_ON_ARCA 0x5A                                                            // On Close Order On Arca
#define LIQUIDITY_CODE_ADDED_POST_ONLY_NOT_CURRENTLY_AVAILABLE 0x57                                           // Added Post Only Not Currently Available
#define LIQUIDITY_CODE_REMOVED_LIQUIDITY_AT_A_MIDPOINT 0x6D                                                   // Removed Liquidity At A Midpoint
#define LIQUIDITY_CODE_ADDED_LIQUIDITY_VIA_A_MIDPOINT_ORDER 0x6B                                              // Added Liquidity Via A Midpoint Order
#define LIQUIDITY_CODE_SUPPLEMENTAL_ORDER_EXECUTION 0x30                                                      // Supplemental Order Execution
#define LIQUIDITY_CODE_DISPLAYED_LIQUIDITY_ADDING_ORDER_IMPROVES_THE_NBBO 0x37                                // Displayed Liquidity Adding Order Improves The Nbbo
#define LIQUIDITY_CODE_DISPLAYED_LIQUIDITY_ADDING_ORDER_SETS_THE_QBBO_WHILE_JOINING_THE_NBBO 0x38             // Displayed Liquidity Adding Order Sets The Qbbo While Joining The Nbbo
#define LIQUIDITY_CODE_RETAIL_DESIGNATED_EXECUTION_THAT_REMOVED_LIQUIDITY_NOT_CURRENTLY_AVAILABLE 0x64        // Retail Designated Execution That Removed Liquidity Not Currently Available
#define LIQUIDITY_CODE_RETAIL_DESIGNATED_EXECUTION_THAT_ADDED_DISPLAYED_LIQUIDITY 0x65                        // Retail Designated Execution That Added Displayed Liquidity
#define LIQUIDITY_CODE_RETAIL_DESIGNATED_EXECUTION_THAT_ADDED_NON_DISPLAYED_LIQUIDITY_NOT_CURREN_gd3ut9 0x66  // Retail Designated Execution That Added Non Displayed Liquidity Not Currently Available
#define LIQUIDITY_CODE_RPI_ORDER_THAT_PROVIDES_LIQUIDITY 0x6A                                                 // Rpi Order That Provides Liquidity
#define LIQUIDITY_CODE_RETAIL_ORDER_THAT_REMOVES_RPI_LIQUIDITY 0x72                                           // Retail Order That Removes Rpi Liquidity
#define LIQUIDITY_CODE_RETAIL_ORDER_THAT_REMOVES_PRICE_IMPROVING_NON_DISPLAYED_LIQUIDITY_OTHER_T_b24ukg 0x74  // Retail Order That Removes Price Improving Non Displayed Liquidity Other Than Rpi Liquidity
#define LIQUIDITY_CODE_ADDED_DISPLAYED_LIQUIDITY_IN_A_GROUP_A_SYMBOL 0x34                                     // Added Displayed Liquidity In A Group A Symbol
#define LIQUIDITY_CODE_ADDED_NON_DISPLAYED_LIQUIDITY_IN_A_GROUP_A_SYMBOL 0x35                                 // Added Non Displayed Liquidity In A Group A Symbol
#define LIQUIDITY_CODE_LIQUIDITY_REMOVING_ORDER_IN_A_GROUP_A_SYMBOL 0x36                                      // Liquidity Removing Order In A Group A Symbol
#define LIQUIDITY_CODE_ADDED_NON_DISPLAYED_MIDPOINT_LIQUIDITY_IN_A_GROUP_A_SYMBOL 0x67                        // Added Non Displayed Midpoint Liquidity In A Group A Symbol
#define LIQUIDITY_CODE_ADDED_DISPLAYED_LIQUIDITY_IN_A_SCIP_SYMBOL 0x61                                        // Added Displayed Liquidity In A Scip Symbol
#define LIQUIDITY_CODE_DISPLAYED_LIQUIDITY_ADDING_ORDER_IMPROVES_THE_NBBO_IN_A_SCIP_SYMBOL 0x78               // Displayed Liquidity Adding Order Improves The Nbbo In A Scip Symbol
#define LIQUIDITY_CODE_DISPLAYED_LIQUIDITY_ADDING_ORDER_SET_THE_QBBO_WHILE_JOINING_THE_NBBO_IN_A_oq1t34 0x79  // Displayed Liquidity Adding Order Set The Qbbo While Joining The Nbbo In A Scip Symbol
#define LIQUIDITY_CODE_DISPLAYED_LIQUIDITY_ADDING_ORDER_IMPROVES_THE_NBBO_IN_PILOT_SYMBOL_DURING_m7v584 0x62  // Displayed Liquidity Adding Order Improves The Nbbo In Pilot Symbol During Specified Luld Pricing Pilot Timeframe
#define LIQUIDITY_CODE_ADDED_DISPLAYED_LIQUIDITY_IN_A_PILOT_SYMBOL_DURING_SPECIFIED_LULD_PRICING_r2xd0q 0x63  // Added Displayed Liquidity In A Pilot Symbol During Specified Luld Pricing Pilot Timeframe
#define LIQUIDITY_CODE_REMOVED_LIQUIDITY_IN_A_PILOT_SYMBOL_DURING_SPECIFIED_LULD_PRICING_PILOT_T_c4vgcs 0x68  // Removed Liquidity In A Pilot Symbol During Specified Luld Pricing Pilot Timeframe
#define LIQUIDITY_CODE_HALT_CROSS_ORDERS_ENTERED_IN_PILOT_SYMBOLS_DURING_THE_LULD_TRADING_PAUSE 0x4E          // Halt Cross Orders Entered In Pilot Symbols During The Luld Trading Pause

// Clearing Code: one byte code
#define CLEARING_CODE_QSR 0x51  // Qsr

// Reference Price Type: one byte code
#define REFERENCE_PRICE_TYPE_NOT_APPLICABLE 0x20             // Not Applicable
#define REFERENCE_PRICE_TYPE_INTRADAY_INDICATIVE_VALUE 0x49  // Intraday Indicative Value

// Cancel Reason: one byte code
#define CANCEL_REASON_USER_CANCEL 0x55            // User Cancel
#define CANCEL_REASON_IOC_CANCEL 0x49             // Ioc Cancel
#define CANCEL_REASON_TIMEOUT 0x54                // Timeout
#define CANCEL_REASON_SUPERVISORY_CANCEL 0x53     // Supervisory Cancel
#define CANCEL_REASON_REGULATORY_CANCEL 0x44      // Regulatory Cancel
#define CANCEL_REASON_SELF_MATCH_PREVENTION 0x51  // Self Match Prevention
#define CANCEL_REASON_SYSTEM_CANCEL 0x5A          // System Cancel
#define CANCEL_REASON_CROSS_CANCEL 0x43           // Cross Cancel
#define CANCEL_REASON_HALTED 0x48                 // Halted
#define CANCEL_REASON_OPEN_PROTECTION 0x58        // Open Protection

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems.
typedef struct _DebugPacket (UINT32 available) where (available >= 1) {
  UINT8 text[(available - 1)];
} DebugPacket;

// The SoupTcp server sends a Login Accepted Packet in response to receiving a valid Login Request from the client.
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupTcp server sends this packet in response to an invalid Login Request Packet from the client.
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// New order accepted.
typedef struct _NewOrderAcceptedMessage {
  UINT8 separator_1;           // byte 0
  UINT8 source[6];             // bytes 1 to 6
  UINT8 separator_2;           // byte 7
  UINT8 order_token[15];       // bytes 8 to 22
  UINT8 separator_3;           // byte 23
  UINT8 replaced_token[10];    // bytes 24 to 33
  UINT8 separator_4;           // byte 34
  UINT8 buy_sell;              // byte 35
  UINT8 separator_5;           // byte 36
  UINT8 shares[6];             // bytes 37 to 42
  UINT8 separator_6;           // byte 43
  UINT8 stock[8];              // bytes 44 to 51
  UINT8 separator_7;           // byte 52
  UINT8 price[11];             // bytes 53 to 63
  UINT8 separator_8;           // byte 64
  UINT8 firm[4];               // bytes 65 to 68
  UINT8 separator_9;           // byte 69
  UINT8 reference[12];         // bytes 70 to 81
  UINT8 separator_10;          // byte 82
  UINT8 time_in_force[12];     // bytes 83 to 94
  UINT8 separator_11;          // byte 95
  UINT8 capacity;              // byte 96
  UINT8 separator_12;          // byte 97
  UINT8 liquidity_code;        // byte 98
  UINT8 separator_13;          // byte 99
  UINT8 clearing_code;         // byte 100
  UINT8 separator_14;          // byte 101
  UINT8 reference_price[11];   // bytes 102 to 112
  UINT8 separator_15;          // byte 113
  UINT8 reference_price_type;  // byte 114
} NewOrderAcceptedMessage;

