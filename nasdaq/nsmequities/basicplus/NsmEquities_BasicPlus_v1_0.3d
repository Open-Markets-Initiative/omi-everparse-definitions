// ---- Packet Header: 20 bytes -------------------------------------------------

// Itch Mold Udp 64 Packet Header
entrypoint typedef struct _PacketHeader {
  UINT8 session[10];         // bytes 0 to 9
  UINT64BE sequence_number;  // bytes 10 to 17
  UINT16BE message_count;    // bytes 18 to 19
} PacketHeader;

// ---- Message Header: 3 bytes -------------------------------------------------

// Mold Udp 64 Message Header
entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;  // bytes 0 to 1
  UINT8 message_type;       // byte 2
} MessageHeader;

// ---- System Event Message: 9 bytes -------------------------------------------

// System Event Messages is used to signal key market or data feed control events.
entrypoint typedef struct _SystemEventMessage {
  UINT64BE timestamp;  // bytes 0 to 7
  UINT8 event_code;    // byte 8
} SystemEventMessage;

// ---- Consolidated Quotation Message: 42 bytes --------------------------------

// Consolidated BBO will broadcast a real-time update every time the Consolidated BBO across Nasdaq owned and operated exchanges is updated throughout the trading day.
entrypoint typedef struct _ConsolidatedQuotationMessage {
  UINT64BE timestamp;          // bytes 0 to 7
  UINT8 stock[8];              // bytes 8 to 15
  UINT64BE best_bid_price;     // bytes 16 to 23
  UINT32BE best_bid_size;      // bytes 24 to 27
  UINT64BE best_offer_price;   // bytes 28 to 35
  UINT32BE best_offer_size;    // bytes 36 to 39
  UINT8 best_bid_exchanges;    // byte 40
  UINT8 best_offer_exchanges;  // byte 41
} ConsolidatedQuotationMessage;

// ---- Retail Price Improvement Message: 18 bytes ------------------------------

// Indicates a retail interest indication of the Bid, Ask or both the Bid and Ask for Nasdaq-listed securities. Populated for the Nasdaq Texas market only.
entrypoint typedef struct _RetailPriceImprovementMessage {
  UINT64BE timestamp;             // bytes 0 to 7
  UINT8 stock[8];                 // bytes 8 to 15
  UINT8 buy_side_rpi_exchanges;   // byte 16
  UINT8 sell_side_rpi_exchanges;  // byte 17
} RetailPriceImprovementMessage;

// ---- Trading Action Message: 21 bytes ----------------------------------------

// Nasdaq uses this administrative message to indicate the current trading status of a security to the trading community. The message originates from the Nasdaq market center system.
entrypoint typedef struct _TradingActionMessage {
  UINT64BE timestamp;    // bytes 0 to 7
  UINT8 stock[8];        // bytes 8 to 15
  UINT8 trading_state;   // byte 16
  UINT8 reason_code[4];  // bytes 17 to 20
} TradingActionMessage;

// ---- Reg Sho Restriction Message: 17 bytes -----------------------------------

// Reg SHO Short Sale Price Test Restricted Indicator. Sends updates for the Nasdaq market only.
entrypoint typedef struct _RegShoRestrictionMessage {
  UINT64BE timestamp;    // bytes 0 to 7
  UINT8 stock[8];        // bytes 8 to 15
  UINT8 reg_sho_action;  // byte 16
} RegShoRestrictionMessage;

// ---- Stock Directory Message: 36 bytes ---------------------------------------

// At the start of each trading day, Nasdaq disseminates stock directory messages for all active Nasdaq and non Nasdaq listed security symbols. The Stock Directory can be sent again during the trading day if any value changes.
entrypoint typedef struct _StockDirectoryMessage {
  UINT64BE timestamp;                    // bytes 0 to 7
  UINT8 stock[8];                        // bytes 8 to 15
  UINT8 market_category;                 // byte 16
  UINT8 financial_status_indicator;      // byte 17
  UINT32BE round_lot_size;               // bytes 18 to 21
  UINT8 round_lots_only;                 // byte 22
  UINT8 issue_classification;            // byte 23
  UINT8 issue_sub_type[2];               // bytes 24 to 25
  UINT8 authenticity;                    // byte 26
  UINT8 short_sale_threshold_indicator;  // byte 27
  UINT8 ipo_flag;                        // byte 28
  UINT8 luld_reference_price_tier;       // byte 29
  UINT8 etp_flag;                        // byte 30
  UINT32BE etp_leverage_factor;          // bytes 31 to 34
  UINT8 inverse_indicator;               // byte 35
} StockDirectoryMessage;

// ---- Mwcb Decline Level Message: 32 bytes ------------------------------------

// Informs data recipients what the daily MWCB breach points are set to for the current trading day.
entrypoint typedef struct _MwcbDeclineLevelMessage {
  UINT64BE timestamp;  // bytes 0 to 7
  UINT64BE level_1;    // bytes 8 to 15
  UINT64BE level_2;    // bytes 16 to 23
  UINT64BE level_3;    // bytes 24 to 31
} MwcbDeclineLevelMessage;

// ---- Mwcb Status Message: 9 bytes --------------------------------------------

// Informs data recipients when a MWCB has breached one of the established levels.
entrypoint typedef struct _MwcbStatusMessage {
  UINT64BE timestamp;    // bytes 0 to 7
  UINT8 breached_level;  // byte 8
} MwcbStatusMessage;

// ---- Ipo Quoting Period Update: 29 bytes -------------------------------------

// Indicates the anticipated IPO quotation release time of a security. Populated for the Nasdaq market only.
entrypoint typedef struct _IpoQuotingPeriodUpdate {
  UINT64BE timestamp;                     // bytes 0 to 7
  UINT8 stock[8];                         // bytes 8 to 15
  UINT32BE ipo_quotation_release_time;    // bytes 16 to 19
  UINT8 ipo_quotation_release_qualifier;  // byte 20
  UINT64BE ipo_price;                     // bytes 21 to 28
} IpoQuotingPeriodUpdate;

// ---- Operational Halt Message: 18 bytes --------------------------------------

// The Exchange uses this message to indicate the current Operational Status of a security to the trading community, for the three market centers operated by Nasdaq.
entrypoint typedef struct _OperationalHaltMessage {
  UINT64BE timestamp;             // bytes 0 to 7
  UINT8 stock[8];                 // bytes 8 to 15
  UINT8 market_code;              // byte 16
  UINT8 operational_halt_action;  // byte 17
} OperationalHaltMessage;

