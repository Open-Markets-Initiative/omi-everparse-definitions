// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NsmEquities_LastSale_v4_0_2026.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                                        // System Event Message
#define MESSAGE_TYPE_TRADE_REPORT_MESSAGE 0x65                                        // Trade Report Message
#define MESSAGE_TYPE_TRADE_CANCEL_ERROR_MESSAGE 0x6F                                  // Trade Cancel Error Message
#define MESSAGE_TYPE_TRADE_CORRECTION_MESSAGE 0x62                                    // Trade Correction Message
#define MESSAGE_TYPE_STOCK_TRADING_ACTION_MESSAGE 0x48                                // Stock Trading Action Message
#define MESSAGE_TYPE_REG_SHO_SHORT_SALE_PRICE_TEST_RESTRICTED_INDICATOR_MESSAGE 0x59  // Reg Sho Short Sale Price Test Restricted Indicator Message
#define MESSAGE_TYPE_STOCK_DIRECTORY_MESSAGE 0x52                                     // Stock Directory Message
#define MESSAGE_TYPE_ADJUSTED_CLOSING_PRICE_MESSAGE 0x67                              // Adjusted Closing Price Message
#define MESSAGE_TYPE_MWCB_DECLINE_LEVEL_MESSAGE 0x56                                  // Mwcb Decline Level Message
#define MESSAGE_TYPE_MWCB_STATUS_MESSAGE 0x57                                         // Mwcb Status Message
#define MESSAGE_TYPE_IPO_QUOTING_PERIOD_UPDATE_MESSAGE 0x6B                           // Ipo Quoting Period Update Message
#define MESSAGE_TYPE_OPERATIONAL_HALT_MESSAGE 0x68                                    // Operational Halt Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_TRANSMISSIONS 0x4F  // Start Of Transmissions
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53   // Start Of System Hours
#define EVENT_CODE_START_OF_MARKET_HOURS 0x51   // Start Of Market Hours
#define EVENT_CODE_END_OF_MARKET_HOURS 0x4D     // End Of Market Hours
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45     // End Of System Hours
#define EVENT_CODE_END_OF_TRANSMISSIONS 0x43    // End Of Transmissions

// Originating Market Center Identifier: one byte code
#define ORIGINATING_MARKET_CENTER_IDENTIFIER_NASDAQ 0x51        // Nasdaq
#define ORIGINATING_MARKET_CENTER_IDENTIFIER_TRF_CARTERET 0x4C  // Trf Carteret
#define ORIGINATING_MARKET_CENTER_IDENTIFIER_TRF_CHICAGO 0x32   // Trf Chicago
#define ORIGINATING_MARKET_CENTER_IDENTIFIER_NASDAQ_TEXAS 0x42  // Nasdaq Texas
#define ORIGINATING_MARKET_CENTER_IDENTIFIER_PSX 0x58           // Psx

// Security Class: one byte code
#define SECURITY_CLASS_NASDAQ 0x51                // Nasdaq
#define SECURITY_CLASS_NYSE 0x4E                  // Nyse
#define SECURITY_CLASS_NYSE_AMERICAN 0x41         // Nyse American
#define SECURITY_CLASS_NYSE_ARCA 0x50             // Nyse Arca
#define SECURITY_CLASS_NYSE_TEXAS 0x4D            // Nyse Texas
#define SECURITY_CLASS_BATS 0x5A                  // Bats
#define SECURITY_CLASS_IEX 0x56                   // Iex
#define SECURITY_CLASS_TEXAS_STOCK_EXCHANGE 0x46  // Texas Stock Exchange

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_HALTED 0x48          // Halted
#define CURRENT_TRADING_STATE_PAUSED 0x50          // Paused
#define CURRENT_TRADING_STATE_QUOTATION_ONLY 0x51  // Quotation Only
#define CURRENT_TRADING_STATE_TRADING 0x54         // Trading

// Reg Sho Action: one byte code
#define REG_SHO_ACTION_NO_PRICE_TEST 0x30          // No Price Test
#define REG_SHO_ACTION_RESTRICTION_IN_EFFECT 0x31  // Restriction In Effect
#define REG_SHO_ACTION_RESTRICTION_REMAINS 0x32    // Restriction Remains

// Market Category: one byte code
#define MARKET_CATEGORY_NASDAQ_GLOBAL_SELECT_MARKET 0x51  // Nasdaq Global Select Market
#define MARKET_CATEGORY_NASDAQ_GLOBAL_MARKET 0x47         // Nasdaq Global Market
#define MARKET_CATEGORY_NASDAQ_CAPITAL_MARKET 0x53        // Nasdaq Capital Market
#define MARKET_CATEGORY_NYSE 0x4E                         // Nyse
#define MARKET_CATEGORY_NYSE_AMERICAN 0x41                // Nyse American
#define MARKET_CATEGORY_NYSE_ARCA 0x50                    // Nyse Arca
#define MARKET_CATEGORY_NYSE_TEXAS 0x4D                   // Nyse Texas
#define MARKET_CATEGORY_BATS_Z 0x5A                       // Bats Z
#define MARKET_CATEGORY_IEX 0x56                          // Iex
#define MARKET_CATEGORY_NOT_AVAILABLE 0x20                // Not Available

// Financial Status Indicator: one byte code
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT 0x44                          // Deficient
#define FINANCIAL_STATUS_INDICATOR_DELINQUENT 0x45                         // Delinquent
#define FINANCIAL_STATUS_INDICATOR_BANKRUPT 0x51                           // Bankrupt
#define FINANCIAL_STATUS_INDICATOR_SUSPENDED 0x53                          // Suspended
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_AND_BANKRUPT 0x47             // Deficient And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_AND_DELINQUENT 0x48           // Deficient And Delinquent
#define FINANCIAL_STATUS_INDICATOR_DELINQUENT_AND_BANKRUPT 0x4A            // Delinquent And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_DELINQUENT_AND_BANKRUPT 0x4B  // Deficient Delinquent And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_CREATIONS_REDEMPTIONS_SUSPENDED 0x43    // Creations Redemptions Suspended
#define FINANCIAL_STATUS_INDICATOR_NORMAL 0x4E                             // Normal
#define FINANCIAL_STATUS_INDICATOR_NOT_AVAILABLE 0x20                      // Not Available

// Round Lots Only: one byte code
#define ROUND_LOTS_ONLY_ROUND_LOTS_ONLY 0x59  // Round Lots Only
#define ROUND_LOTS_ONLY_NO_RESTRICTIONS 0x4E  // No Restrictions

// Issue Classification: one byte code
#define ISSUE_CLASSIFICATION_ADS 0x41          // Ads
#define ISSUE_CLASSIFICATION_BOND 0x42         // Bond
#define ISSUE_CLASSIFICATION_COMMON 0x43       // Common
#define ISSUE_CLASSIFICATION_DEPOSITORY 0x46   // Depository
#define ISSUE_CLASSIFICATION_SEC_144_A 0x49    // Sec 144 A
#define ISSUE_CLASSIFICATION_LIMITED 0x4C      // Limited
#define ISSUE_CLASSIFICATION_NOTES 0x4E        // Notes
#define ISSUE_CLASSIFICATION_ORDINARY 0x4F     // Ordinary
#define ISSUE_CLASSIFICATION_PREFERRED 0x50    // Preferred
#define ISSUE_CLASSIFICATION_OTHER 0x51        // Other
#define ISSUE_CLASSIFICATION_RIGHT 0x52        // Right
#define ISSUE_CLASSIFICATION_SHARES 0x53       // Shares
#define ISSUE_CLASSIFICATION_CONVERTIBLE 0x54  // Convertible
#define ISSUE_CLASSIFICATION_UNIT 0x55         // Unit
#define ISSUE_CLASSIFICATION_UNITS_BI 0x56     // Units Bi
#define ISSUE_CLASSIFICATION_WARRANT 0x57      // Warrant

// Authenticity: one byte code
#define AUTHENTICITY_LIVE_PRODUCTION 0x50  // Live Production
#define AUTHENTICITY_TEST 0x54             // Test

// Short Sale Threshold Indicator: one byte code
#define SHORT_SALE_THRESHOLD_INDICATOR_RESTRICTED 0x59      // Restricted
#define SHORT_SALE_THRESHOLD_INDICATOR_NOT_RESTRICTED 0x4E  // Not Restricted
#define SHORT_SALE_THRESHOLD_INDICATOR_NOT_AVAILABLE 0x20   // Not Available

// Ipo Flag: one byte code
#define IPO_FLAG_YES 0x59                 // Yes
#define IPO_FLAG_NO 0x4E                  // No
#define IPO_FLAG_NON_IPO_NEW_LISTED 0x5A  // Non Ipo New Listed
#define IPO_FLAG_NOT_AVAILABLE 0x20       // Not Available

// Luld Reference Price Tier: one byte code
#define LULD_REFERENCE_PRICE_TIER_TIER_1 0x31          // Tier 1
#define LULD_REFERENCE_PRICE_TIER_TIER_2 0x32          // Tier 2
#define LULD_REFERENCE_PRICE_TIER_NOT_APPLICABLE 0x20  // Not Applicable

// Etp Flag: one byte code
#define ETP_FLAG_ETP 0x59            // Etp
#define ETP_FLAG_NOT_ETP 0x4E        // Not Etp
#define ETP_FLAG_NOT_AVAILABLE 0x20  // Not Available

// Inverse Indicator: one byte code
#define INVERSE_INDICATOR_INVERSE_ETP 0x59      // Inverse Etp
#define INVERSE_INDICATOR_NOT_INVERSE_ETP 0x4E  // Not Inverse Etp

// Breached Level: one byte code
#define BREACHED_LEVEL_LEVEL_1 0x31  // Level 1
#define BREACHED_LEVEL_LEVEL_2 0x32  // Level 2
#define BREACHED_LEVEL_LEVEL_3 0x33  // Level 3

// Ipo Quotation Release Qualifier: one byte code
#define IPO_QUOTATION_RELEASE_QUALIFIER_ANTICIPATED 0x41         // Anticipated
#define IPO_QUOTATION_RELEASE_QUALIFIER_CANCELED_POSTPONED 0x43  // Canceled Postponed

// Market Code: one byte code
#define MARKET_CODE_NASDAQ 0x51        // Nasdaq
#define MARKET_CODE_NASDAQ_TEXAS 0x42  // Nasdaq Texas
#define MARKET_CODE_PSX 0x58           // Psx

// Operational Halt Action: one byte code
#define OPERATIONAL_HALT_ACTION_OPERATIONALLY_HALTED 0x48     // Operationally Halted
#define OPERATIONAL_HALT_ACTION_OPERATIONAL_HALT_LIFTED 0x54  // Operational Halt Lifted

// ---- Types -------------------------------------------------------------------

// System Event Messages is used to signal key market or data feed control events.
typedef struct _SystemEventMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT8 event_code;          // byte 8
} SystemEventMessage;

// The following message is used to relay trade transactions that are reported for the current business day. Please note that Nasdaq only reports one-side of a trade execution on the Last Sale feeds.
typedef struct _TradeReportMessage {
  UINT16BE tracking_number;                    // bytes 0 to 1
  UINT8 timestamp[6];                          // bytes 2 to 7
  UINT64BE client_timestamp;                   // bytes 8 to 15
  UINT8 originating_market_center_identifier;  // byte 16
  UINT8 issue_symbol[8];                       // bytes 17 to 24
  UINT8 security_class;                        // byte 25
  UINT8 trade_control_number[10];              // bytes 26 to 35
  UINT64BE trade_price;                        // bytes 36 to 43
  UINT64BE trade_size;                         // bytes 44 to 51
  UINT8 sale_condition_modifier[4];            // bytes 52 to 55
} TradeReportMessage;

// The following message is used in the event that a transaction is cancelled on the same business day that it is reported.
typedef struct _TradeCancelErrorMessage {
  UINT16BE tracking_number;                    // bytes 0 to 1
  UINT8 timestamp[6];                          // bytes 2 to 7
  UINT64BE client_timestamp;                   // bytes 8 to 15
  UINT8 originating_market_center_identifier;  // byte 16
  UINT8 issue_symbol[8];                       // bytes 17 to 24
  UINT8 security_class;                        // byte 25
  UINT8 original_trade_control_number[10];     // bytes 26 to 35
  UINT64BE original_trade_price;               // bytes 36 to 43
  UINT64BE original_trade_size;                // bytes 44 to 51
  UINT8 original_sale_condition_modifier[4];   // bytes 52 to 55
} TradeCancelErrorMessage;

// The following message is used in the event that a trade transaction is corrected on the same business day that it is reported.
typedef struct _TradeCorrectionMessage {
  UINT16BE tracking_number;                    // bytes 0 to 1
  UINT8 timestamp[6];                          // bytes 2 to 7
  UINT64BE client_timestamp;                   // bytes 8 to 15
  UINT8 originating_market_center_identifier;  // byte 16
  UINT8 issue_symbol[8];                       // bytes 17 to 24
  UINT8 security_class;                        // byte 25
  UINT8 original_trade_control_number[10];     // bytes 26 to 35
  UINT64BE original_trade_price;               // bytes 36 to 43
  UINT64BE original_trade_size;                // bytes 44 to 51
  UINT8 original_sale_condition_modifier[4];   // bytes 52 to 55
  UINT8 corrected_trade_control_number[10];    // bytes 56 to 65
  UINT64BE corrected_trade_price;              // bytes 66 to 73
  UINT64BE corrected_trade_size;               // bytes 74 to 81
  UINT8 corrected_sale_condition_modifier[4];  // bytes 82 to 85
} TradeCorrectionMessage;

// Nasdaq uses this administrative message to indicate the current trading status of a security to the trading community.
typedef struct _StockTradingActionMessage {
  UINT16BE tracking_number;     // bytes 0 to 1
  UINT8 timestamp[6];           // bytes 2 to 7
  UINT8 issue_symbol[8];        // bytes 8 to 15
  UINT8 security_class;         // byte 16
  UINT8 current_trading_state;  // byte 17
  UINT8 reason[4];              // bytes 18 to 21
} StockTradingActionMessage;

// Nasdaq processes orders based on the most Reg SHO Restriction status value.
typedef struct _RegShoShortSalePriceTestRestrictedIndicatorMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT8 issue_symbol[8];     // bytes 8 to 15
  UINT8 reg_sho_action;      // byte 16
} RegShoShortSalePriceTestRestrictedIndicatorMessage;

// At the start of each trading day, Nasdaq disseminates stock directory messages for all active Nasdaq and non Nasdaq listed security symbols.
typedef struct _StockDirectoryMessage {
  UINT16BE tracking_number;              // bytes 0 to 1
  UINT8 timestamp[6];                    // bytes 2 to 7
  UINT8 stock[8];                        // bytes 8 to 15
  UINT8 market_category;                 // byte 16
  UINT8 financial_status_indicator;      // byte 17
  UINT32BE round_lot_size;               // bytes 18 to 21
  UINT8 round_lots_only;                 // byte 22
  UINT8 issue_classification;            // byte 23
  UINT8 issue_sub_type[2];               // bytes 24 to 25
  UINT8 authenticity;                    // byte 26
  UINT8 short_sale_threshold_indicator;  // byte 27
  UINT8 ipo_flag;                        // byte 28
  UINT8 luld_reference_price_tier;       // byte 29
  UINT8 etp_flag;                        // byte 30
  UINT32BE etp_leverage_factor;          // bytes 31 to 34
  UINT8 inverse_indicator;               // byte 35
  UINT8 bloomberg_id[12];                // bytes 36 to 47
} StockDirectoryMessage;

// At the start of each trading day, Nasdaq disseminates the adjusted closing price for all active symbols in the Nasdaq system.
typedef struct _AdjustedClosingPriceMessage {
  UINT16BE tracking_number;         // bytes 0 to 1
  UINT8 timestamp[6];               // bytes 2 to 7
  UINT8 issue_symbol[8];            // bytes 8 to 15
  UINT8 security_class;             // byte 16
  UINT64BE adjusted_closing_price;  // bytes 17 to 24
} AdjustedClosingPriceMessage;

// Informs data recipients what the daily MWCB breach points are set to for the current trading day.
typedef struct _MwcbDeclineLevelMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT64BE level_1;          // bytes 8 to 15
  UINT64BE level_2;          // bytes 16 to 23
  UINT64BE level_3;          // bytes 24 to 31
} MwcbDeclineLevelMessage;

// Informs data recipients when a MWCB has breached one of the established levels.
typedef struct _MwcbStatusMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT8 breached_level;      // byte 8
} MwcbStatusMessage;

// Indicates the anticipated IPO quotation release time of a security.
typedef struct _IpoQuotingPeriodUpdateMessage {
  UINT16BE tracking_number;               // bytes 0 to 1
  UINT8 timestamp[6];                     // bytes 2 to 7
  UINT8 stock[8];                         // bytes 8 to 15
  UINT32BE ipo_quotation_release_time;    // bytes 16 to 19
  UINT8 ipo_quotation_release_qualifier;  // byte 20
  UINT64BE ipo_price;                     // bytes 21 to 28
} IpoQuotingPeriodUpdateMessage;

// An Operational Halt means that there has been an interruption of service on the identified security impacting only the designated Market Center.
typedef struct _OperationalHaltMessage {
  UINT16BE tracking_number;       // bytes 0 to 1
  UINT8 timestamp[6];             // bytes 2 to 7
  UINT8 stock[8];                 // bytes 8 to 15
  UINT8 market_code;              // byte 16
  UINT8 operational_halt_action;  // byte 17
} OperationalHaltMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x65: TradeReportMessage trade_report_message;
    case 0x6F: TradeCancelErrorMessage trade_cancel_error_message;
    case 0x62: TradeCorrectionMessage trade_correction_message;
    case 0x48: StockTradingActionMessage stock_trading_action_message;
    case 0x59: RegShoShortSalePriceTestRestrictedIndicatorMessage reg_sho_short_sale_price_test_restricted_indicator_message;
    case 0x52: StockDirectoryMessage stock_directory_message;
    case 0x67: AdjustedClosingPriceMessage adjusted_closing_price_message;
    case 0x56: MwcbDeclineLevelMessage mwcb_decline_level_message;
    case 0x57: MwcbStatusMessage mwcb_status_message;
    case 0x6B: IpoQuotingPeriodUpdateMessage ipo_quoting_period_update_message;
    case 0x68: OperationalHaltMessage operational_halt_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

