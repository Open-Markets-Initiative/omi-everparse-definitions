#define MARKET_CENTER_IDENTIFIER_NASDAQ 0x51  // Nasdaq
#define MARKET_CENTER_IDENTIFIER_TRF 0x4C     // Trf

// Security Class: one byte code
#define SECURITY_CLASS_NASDAQ 0x51     // Nasdaq
#define SECURITY_CLASS_NYSE 0x4E       // Nyse
#define SECURITY_CLASS_NYSE_MKT 0x41   // Nyse Mkt
#define SECURITY_CLASS_NYSE_ARCA 0x50  // Nyse Arca
#define SECURITY_CLASS_BATS 0x5A       // Bats

// Settlement Type: one byte code
#define SETTLEMENT_TYPE_REGULAR_SETTLEMENT 0x40   // Regular Settlement
#define SETTLEMENT_TYPE_CASH_SETTLEMENT 0x43      // Cash Settlement
#define SETTLEMENT_TYPE_NEXT_DAY_SETTLEMENT 0x4E  // Next Day Settlement
#define SETTLEMENT_TYPE_SELLER_SETTLEMENT 0x52    // Seller Settlement

// Trade Through Exemption: one byte code
#define TRADE_THROUGH_EXEMPTION_INTERMARKET_SWEEP 0x46  // Intermarket Sweep
#define TRADE_THROUGH_EXEMPTION_OPENING_PRINT 0x4F      // Opening Print
#define TRADE_THROUGH_EXEMPTION_DERIVATIVE_PRICED 0x34  // Derivative Priced
#define TRADE_THROUGH_EXEMPTION_RE_OPENING_PRINT 0x35   // Re Opening Print
#define TRADE_THROUGH_EXEMPTION_CLOSING_PRINT 0x36      // Closing Print
#define TRADE_THROUGH_EXEMPTION_NOT_APPLICABLE 0x20     // Not Applicable

// Extended Hours Or Sold Code: one byte code
#define EXTENDED_HOURS_OR_SOLD_CODE_EXTENDED_HOURS_TRADE 0x54                                   // Extended Hours Trade
#define EXTENDED_HOURS_OR_SOLD_CODE_EXTENDED_HOURS_TRADE_REPORTED_LATE_OR_OUT_OF_SEQUENCE 0x55  // Extended Hours Trade Reported Late Or Out Of Sequence
#define EXTENDED_HOURS_OR_SOLD_CODE_SOLD_LAST_REPORTED_LATE_BUT_IN_SEQUENCE 0x4C                // Sold Last Reported Late But In Sequence
#define EXTENDED_HOURS_OR_SOLD_CODE_SOLD_OUT_OF_SEQUENCE 0x5A                                   // Sold Out Of Sequence
#define EXTENDED_HOURS_OR_SOLD_CODE_NOT_APPLICABLE 0x20                                         // Not Applicable

// Special Sale Condition: one byte code
#define SPECIAL_SALE_CONDITION_ACQUISITION 0x41                  // Acquisition
#define SPECIAL_SALE_CONDITION_BUNCHED 0x42                      // Bunched
#define SPECIAL_SALE_CONDITION_DISTRIBUTION 0x44                 // Distribution
#define SPECIAL_SALE_CONDITION_PRICE_VARIATION_TRANSACTION 0x48  // Price Variation Transaction
#define SPECIAL_SALE_CONDITION_OFFICIAL_CLOSE_PRICE 0x4D         // Official Close Price
#define SPECIAL_SALE_CONDITION_PRIOR_REFERENCE_PRICE 0x50        // Prior Reference Price
#define SPECIAL_SALE_CONDITION_OFFICIAL_OPENING_PRICE 0x51       // Official Opening Price
#define SPECIAL_SALE_CONDITION_SPLIT_TRADE 0x53                  // Split Trade
#define SPECIAL_SALE_CONDITION_AVERAGE_PRICE_TRADE 0x57          // Average Price Trade
#define SPECIAL_SALE_CONDITION_CROSS_TRADE 0x58                  // Cross Trade
#define SPECIAL_SALE_CONDITION_ODD_LOT_EXECUTION 0x6F            // Odd Lot Execution
#define SPECIAL_SALE_CONDITION_NOT_APPLICABLE 0x20               // Not Applicable

// Original Settlement Type: one byte code
#define ORIGINAL_SETTLEMENT_TYPE_REGULAR_SETTLEMENT 0x40   // Regular Settlement
#define ORIGINAL_SETTLEMENT_TYPE_CASH_SETTLEMENT 0x43      // Cash Settlement
