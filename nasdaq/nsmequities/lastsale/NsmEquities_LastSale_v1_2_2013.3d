#define ORIGINAL_SPECIAL_SALE_CONDITION_ACQUISITION 0x41                  // Acquisition
#define ORIGINAL_SPECIAL_SALE_CONDITION_BUNCHED 0x42                      // Bunched
#define ORIGINAL_SPECIAL_SALE_CONDITION_DISTRIBUTION 0x44                 // Distribution
#define ORIGINAL_SPECIAL_SALE_CONDITION_PRICE_VARIATION_TRANSACTION 0x48  // Price Variation Transaction
#define ORIGINAL_SPECIAL_SALE_CONDITION_OFFICIAL_CLOSE_PRICE 0x4D         // Official Close Price
#define ORIGINAL_SPECIAL_SALE_CONDITION_PRIOR_REFERENCE_PRICE 0x50        // Prior Reference Price
#define ORIGINAL_SPECIAL_SALE_CONDITION_OFFICIAL_OPENING_PRICE 0x51       // Official Opening Price
#define ORIGINAL_SPECIAL_SALE_CONDITION_SPLIT_TRADE 0x53                  // Split Trade
#define ORIGINAL_SPECIAL_SALE_CONDITION_AVERAGE_PRICE_TRADE 0x57          // Average Price Trade
#define ORIGINAL_SPECIAL_SALE_CONDITION_CROSS_TRADE 0x58                  // Cross Trade
#define ORIGINAL_SPECIAL_SALE_CONDITION_ODD_LOT_EXECUTION 0x6F            // Odd Lot Execution
#define ORIGINAL_SPECIAL_SALE_CONDITION_NOT_APPLICABLE 0x20               // Not Applicable

// Corrected Settlement Type: one byte code
#define CORRECTED_SETTLEMENT_TYPE_REGULAR_SETTLEMENT 0x40   // Regular Settlement
#define CORRECTED_SETTLEMENT_TYPE_CASH_SETTLEMENT 0x43      // Cash Settlement
#define CORRECTED_SETTLEMENT_TYPE_NEXT_DAY_SETTLEMENT 0x4E  // Next Day Settlement
#define CORRECTED_SETTLEMENT_TYPE_SELLER_SETTLEMENT 0x52    // Seller Settlement

// Corrected Trade Through Exemption: one byte code
#define CORRECTED_TRADE_THROUGH_EXEMPTION_INTERMARKET_SWEEP 0x46  // Intermarket Sweep
#define CORRECTED_TRADE_THROUGH_EXEMPTION_OPENING_PRINT 0x4F      // Opening Print
#define CORRECTED_TRADE_THROUGH_EXEMPTION_DERIVATIVE_PRICED 0x34  // Derivative Priced
#define CORRECTED_TRADE_THROUGH_EXEMPTION_RE_OPENING_PRINT 0x35   // Re Opening Print
#define CORRECTED_TRADE_THROUGH_EXEMPTION_CLOSING_PRINT 0x36      // Closing Print
#define CORRECTED_TRADE_THROUGH_EXEMPTION_NOT_APPLICABLE 0x20     // Not Applicable

// Corrected Extended Hours Or Sold Code: one byte code
#define CORRECTED_EXTENDED_HOURS_OR_SOLD_CODE_EXTENDED_HOURS_TRADE 0x54                                   // Extended Hours Trade
#define CORRECTED_EXTENDED_HOURS_OR_SOLD_CODE_EXTENDED_HOURS_TRADE_REPORTED_LATE_OR_OUT_OF_SEQUENCE 0x55  // Extended Hours Trade Reported Late Or Out Of Sequence
#define CORRECTED_EXTENDED_HOURS_OR_SOLD_CODE_SOLD_LAST_REPORTED_LATE_BUT_IN_SEQUENCE 0x4C                // Sold Last Reported Late But In Sequence
#define CORRECTED_EXTENDED_HOURS_OR_SOLD_CODE_SOLD_OUT_OF_SEQUENCE 0x5A                                   // Sold Out Of Sequence
#define CORRECTED_EXTENDED_HOURS_OR_SOLD_CODE_NOT_APPLICABLE 0x20                                         // Not Applicable

// Corrected Special Sale Condition: one byte code
#define CORRECTED_SPECIAL_SALE_CONDITION_ACQUISITION 0x41                  // Acquisition
#define CORRECTED_SPECIAL_SALE_CONDITION_BUNCHED 0x42                      // Bunched
#define CORRECTED_SPECIAL_SALE_CONDITION_DISTRIBUTION 0x44                 // Distribution
#define CORRECTED_SPECIAL_SALE_CONDITION_PRICE_VARIATION_TRANSACTION 0x48  // Price Variation Transaction
#define CORRECTED_SPECIAL_SALE_CONDITION_OFFICIAL_CLOSE_PRICE 0x4D         // Official Close Price
#define CORRECTED_SPECIAL_SALE_CONDITION_PRIOR_REFERENCE_PRICE 0x50        // Prior Reference Price
#define CORRECTED_SPECIAL_SALE_CONDITION_OFFICIAL_OPENING_PRICE 0x51       // Official Opening Price
#define CORRECTED_SPECIAL_SALE_CONDITION_SPLIT_TRADE 0x53                  // Split Trade
