// Original Extended Hours Or Sold Code: one byte code
#define ORIGINAL_EXTENDED_HOURS_OR_SOLD_CODE_EXTENDED_HOURS_TRADE 0x54                                   // Extended Hours Trade
#define ORIGINAL_EXTENDED_HOURS_OR_SOLD_CODE_EXTENDED_HOURS_TRADE_REPORTED_LATE_OR_OUT_OF_SEQUENCE 0x55  // Extended Hours Trade Reported Late Or Out Of Sequence
#define ORIGINAL_EXTENDED_HOURS_OR_SOLD_CODE_SOLD_LAST_REPORTED_LATE_BUT_IN_SEQUENCE 0x4C                // Sold Last Reported Late But In Sequence
#define ORIGINAL_EXTENDED_HOURS_OR_SOLD_CODE_SOLD_OUT_OF_SEQUENCE 0x5A                                   // Sold Out Of Sequence
#define ORIGINAL_EXTENDED_HOURS_OR_SOLD_CODE_NOT_APPLICABLE 0x20                                         // Not Applicable

