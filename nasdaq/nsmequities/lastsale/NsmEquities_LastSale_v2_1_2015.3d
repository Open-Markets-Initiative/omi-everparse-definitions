  UINT32BE corrected_trade_size;                                     // bytes 46 to 49
  CorrectedSaleConditionModifier corrected_sale_condition_modifier;  // bytes 50 to 53
} TradeCorrectionMessage;

// ---- Etmf Trade Correction Message: 62 bytes ---------------------------------

// The following message is used in the event that a TRF trade transaction for an ETMF is corrected on the same business day that it is reported.
entrypoint typedef struct _EtmfTradeCorrectionMessage {
  UINT8 market_center_identifier;                                    // byte 0
  UINT8 issue_symbol[8];                                             // bytes 1 to 8
