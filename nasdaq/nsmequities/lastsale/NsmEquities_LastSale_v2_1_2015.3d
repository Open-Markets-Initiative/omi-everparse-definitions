// ---- Packet Header: 20 bytes -------------------------------------------------

// Itch Mold Udp 64 Packet Header
entrypoint typedef struct _PacketHeader {
  UINT8 session[10];         // bytes 0 to 9
  UINT64BE sequence_number;  // bytes 10 to 17
  UINT16BE message_count;    // bytes 18 to 19
} PacketHeader;

// ---- Message Header: 11 bytes ------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;   // bytes 0 to 1
  UINT16BE tracking_number;  // bytes 2 to 3
  UINT8 timestamp[6];        // bytes 4 to 9
  UINT8 message_type;        // byte 10
} MessageHeader;

// ---- System Event Message: 1 byte --------------------------------------------

// System Event Messages is used to signal key market or data feed control events.
entrypoint typedef struct _SystemEventMessage {
  UINT8 event_code;  // byte 0
} SystemEventMessage;

// ---- Sale Condition Modifier: 4 bytes ----------------------------------------

// Sale condition modifier consists of four levels
entrypoint typedef struct _SaleConditionModifier {
  UINT8 settlement_type;              // byte 0
  UINT8 trade_through_exemption;      // byte 1
  UINT8 extended_hours_or_sold_code;  // byte 2
  UINT8 special_sale_condition;       // byte 3
} SaleConditionModifier;

// ---- Trade Report Message: 32 bytes ------------------------------------------

// The following message is used to relay NASDAQ execution system and TRF trade transactions that are reported for the current business day. Please note that NASDAQ only reports one-side of a trade execution on the NASDAQ Last Sale (NLS) feed and other data feed products.
entrypoint typedef struct _TradeReportMessage {
  UINT8 market_center_identifier;                 // byte 0
  UINT8 issue_symbol[8];                          // bytes 1 to 8
  UINT8 security_class;                           // byte 9
  UINT8 trade_control_number[10];                 // bytes 10 to 19
  UINT32BE trade_price;                           // bytes 20 to 23
  UINT32BE trade_size;                            // bytes 24 to 27
  SaleConditionModifier sale_condition_modifier;  // bytes 28 to 31
} TradeReportMessage;

// ---- Etmf Trade Report Message: 36 bytes -------------------------------------

// The following message is used to relay NASDAQ execution system and TRF trade transactions for Exchange Traded Managed Funds (ETMF) that are reported for the current business day.
entrypoint typedef struct _EtmfTradeReportMessage {
  UINT8 market_center_identifier;                 // byte 0
  UINT8 etmf_symbol[8];                           // bytes 1 to 8
  UINT8 security_class;                           // byte 9
  UINT8 trade_control_number[10];                 // bytes 10 to 19
  UINT32BE proxy_price;                           // bytes 20 to 23
  UINT32BE trade_size;                            // bytes 24 to 27
  UINT32BE nav_premium_discount_amount;           // bytes 28 to 31
  SaleConditionModifier sale_condition_modifier;  // bytes 32 to 35
} EtmfTradeReportMessage;

// ---- Original Sale Condition Modifier: 4 bytes -------------------------------

// The sale condition modifiers as reported on the original trade transaction
entrypoint typedef struct _OriginalSaleConditionModifier {
  UINT8 original_settlement_type;              // byte 0
  UINT8 original_trade_through_exemption;      // byte 1
  UINT8 original_extended_hours_or_sold_code;  // byte 2
  UINT8 original_special_sale_condition;       // byte 3
} OriginalSaleConditionModifier;

// ---- Trade Cancel Error Message: 32 bytes ------------------------------------

// The following message is used in the event that a NASDAQ or TRF trade transaction is cancelled on the same business day that it is reported.
entrypoint typedef struct _TradeCancelErrorMessage {
  UINT8 market_center_identifier;                                  // byte 0
  UINT8 issue_symbol[8];                                           // bytes 1 to 8
  UINT8 security_class;                                            // byte 9
  UINT8 original_trade_control_number[10];                         // bytes 10 to 19
  UINT32BE original_trade_price;                                   // bytes 20 to 23
  UINT32BE original_trade_size;                                    // bytes 24 to 27
  OriginalSaleConditionModifier original_sale_condition_modifier;  // bytes 28 to 31
} TradeCancelErrorMessage;

// ---- Etmf Trade Cancel Error Message: 36 bytes -------------------------------

// The following message is used in the event that a NASDAQ or TRF trade transaction for an ETMF is cancelled on the same business day that it is reported.
entrypoint typedef struct _EtmfTradeCancelErrorMessage {
  UINT8 market_center_identifier;                                  // byte 0
  UINT8 issue_symbol[8];                                           // bytes 1 to 8
  UINT8 security_class;                                            // byte 9
  UINT8 original_trade_control_number[10];                         // bytes 10 to 19
  UINT32BE original_trade_price;                                   // bytes 20 to 23
  UINT32BE original_nav_premium_discount_amount;                   // bytes 24 to 27
  UINT32BE original_trade_size;                                    // bytes 28 to 31
  OriginalSaleConditionModifier original_sale_condition_modifier;  // bytes 32 to 35
} EtmfTradeCancelErrorMessage;

// ---- Corrected Sale Condition Modifier: 4 bytes ------------------------------

// The sale condition modifiers associated with the corrected trade transaction
entrypoint typedef struct _CorrectedSaleConditionModifier {
  UINT8 corrected_settlement_type;              // byte 0
  UINT8 corrected_trade_through_exemption;      // byte 1
  UINT8 corrected_extended_hours_or_sold_code;  // byte 2
  UINT8 corrected_special_sale_condition;       // byte 3
} CorrectedSaleConditionModifier;

// ---- Trade Correction Message: 54 bytes --------------------------------------

// The following message is used in the event that a TRF trade transaction is corrected on the same business day that it is reported.
entrypoint typedef struct _TradeCorrectionMessage {
  UINT8 market_center_identifier;                                    // byte 0
  UINT8 issue_symbol[8];                                             // bytes 1 to 8
  UINT8 security_class;                                              // byte 9
  UINT8 original_trade_control_number[10];                           // bytes 10 to 19
