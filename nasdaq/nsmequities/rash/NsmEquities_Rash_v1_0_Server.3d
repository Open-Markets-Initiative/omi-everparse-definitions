// ---- Server Packet Header: 1 byte --------------------------------------------

// SoupTcp Packet Header sent by the server
entrypoint typedef struct _ServerPacketHeader {
  UINT8 server_packet_type;  // byte 0
} ServerPacketHeader;

// ---- Debug Packet: 1 byte ----------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems.
entrypoint typedef struct _DebugPacket {
  UINT8 text;  // byte 0
} DebugPacket;

// ---- Login Accepted Packet: 30 bytes -----------------------------------------

// The SoupTcp server sends a Login Accepted Packet in response to receiving a valid Login Request from the client.
entrypoint typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// ---- Login Rejected Packet: 1 byte -------------------------------------------

// The SoupTcp server sends this packet in response to an invalid Login Request Packet from the client.
entrypoint typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// ---- Sequenced Message Header: 9 bytes ---------------------------------------

// Time Stamp and type carried ahead of every RASH outbound sequenced message
entrypoint typedef struct _SequencedMessageHeader {
  UINT8 timestamp[8];            // bytes 0 to 7
  UINT8 sequenced_message_type;  // byte 8
} SequencedMessageHeader;

// ---- System Event Message: 1 byte --------------------------------------------

// System Event Messages signal events that affect the entire system.
entrypoint typedef struct _SystemEventMessage {
  UINT8 event_code;  // byte 0
} SystemEventMessage;

// ---- Accepted Order Message: 146 bytes ---------------------------------------

// An Accepted Order Message acknowledges the receipt of a valid Enter Order Message. The data fields from the Enter Order Message are echoed back; the accepted values may differ from the entered values for some fields.
entrypoint typedef struct _AcceptedOrderMessage {
  UINT8 order_token_client_order_id[14];     // bytes 0 to 13
  UINT8 side;                                // byte 14
  UINT8 shares_order_qty[6];                 // bytes 15 to 20
  UINT8 stock_symbol[6];                     // bytes 21 to 26
  UINT8 price[10];                           // bytes 27 to 36
  UINT8 time_in_force[5];                    // bytes 37 to 41
  UINT8 firm_client_id[4];                   // bytes 42 to 45
  UINT8 display;                             // byte 46
  UINT8 order_reference_number[9];           // bytes 47 to 55
  UINT8 min_qty[6];                          // bytes 56 to 61
  UINT8 max_floor[6];                        // bytes 62 to 67
  UINT8 peg_type;                            // byte 68
  UINT8 peg_difference_sign;                 // byte 69
  UINT8 peg_difference[10];                  // bytes 70 to 79
  UINT8 discretion_price[10];                // bytes 80 to 89
  UINT8 discretion_peg_type;                 // byte 90
  UINT8 discretion_peg_difference_sign;      // byte 91
  UINT8 discretion_peg_difference[10];       // bytes 92 to 101
  UINT8 capacity_rule_80_a_indicator;        // byte 102
  UINT8 random_reserve[6];                   // bytes 103 to 108
  UINT8 route_dest_exec_broker[4];           // bytes 109 to 112
  UINT8 cust_terminal_id_sender_sub_id[32];  // bytes 113 to 144
  UINT8 customer_type;                       // byte 145
} AcceptedOrderMessage;

// ---- Accepted Order Message With Cross Functionality: 148 bytes --------------

// Similar to the regular Accepted Order Message, with the additional information provided upon order entry using the Enter Order Message with Cross Functionality.
entrypoint typedef struct _AcceptedOrderMessageWithCrossFunctionality {
  UINT8 order_token_client_order_id[14];     // bytes 0 to 13
  UINT8 side;                                // byte 14
  UINT8 shares_order_qty[6];                 // bytes 15 to 20
  UINT8 stock_symbol[6];                     // bytes 21 to 26
  UINT8 price[10];                           // bytes 27 to 36
  UINT8 time_in_force[5];                    // bytes 37 to 41
  UINT8 firm_client_id[4];                   // bytes 42 to 45
  UINT8 display;                             // byte 46
  UINT8 order_reference_number[9];           // bytes 47 to 55
  UINT8 min_qty[6];                          // bytes 56 to 61
  UINT8 max_floor[6];                        // bytes 62 to 67
  UINT8 peg_type;                            // byte 68
  UINT8 peg_difference_sign;                 // byte 69
  UINT8 peg_difference[10];                  // bytes 70 to 79
  UINT8 discretion_price[10];                // bytes 80 to 89
  UINT8 discretion_peg_type;                 // byte 90
  UINT8 discretion_peg_difference_sign;      // byte 91
  UINT8 discretion_peg_difference[10];       // bytes 92 to 101
  UINT8 capacity_rule_80_a_indicator;        // byte 102
  UINT8 random_reserve[6];                   // bytes 103 to 108
  UINT8 route_dest_exec_broker[4];           // bytes 109 to 112
  UINT8 cust_terminal_id_sender_sub_id[32];  // bytes 113 to 144
  UINT8 inter_market_sweep_eligibility;      // byte 145
  UINT8 cross_type;                          // byte 146
  UINT8 customer_type;                       // byte 147
} AcceptedOrderMessageWithCrossFunctionality;

// ---- Canceled Order Message: 21 bytes ----------------------------------------

// A Canceled Order Message informs you that an order has been reduced or canceled. Canceled shares reflect the number of shares that are out.
entrypoint typedef struct _CanceledOrderMessage {
  UINT8 order_token_client_order_id[14];  // bytes 0 to 13
  UINT8 shares[6];                        // bytes 14 to 19
  UINT8 cancel_reason;                    // byte 20
} CanceledOrderMessage;

// ---- Rejected Order Message: 15 bytes ----------------------------------------

// A Rejected Order Message may be sent in response to an Enter Order Message if the order cannot be accepted at this time. The Token of a rejected order cannot be re-used.
entrypoint typedef struct _RejectedOrderMessage {
  UINT8 order_token_client_order_id[14];  // bytes 0 to 13
  UINT8 reject_reason;                    // byte 14
} RejectedOrderMessage;

// ---- Executed Order Message: 40 bytes ----------------------------------------

// An Executed Order Message informs you that all or part of an order has been executed.
entrypoint typedef struct _ExecutedOrderMessage {
  UINT8 order_token_client_order_id[14];  // bytes 0 to 13
  UINT8 shares[6];                        // bytes 14 to 19
  UINT8 price[10];                        // bytes 20 to 29
  UINT8 liquidity;                        // byte 30
  UINT8 match_number[9];                  // bytes 31 to 39
} ExecutedOrderMessage;

// ---- Broken Trade Message: 24 bytes ------------------------------------------

// A Broken Trade Message informs you that an execution has been broken. The trade is no longer good and will not clear.
entrypoint typedef struct _BrokenTradeMessage {
  UINT8 order_token[14];      // bytes 0 to 13
  UINT8 match_number[9];      // bytes 14 to 22
  UINT8 broken_trade_reason;  // byte 23
} BrokenTradeMessage;

// ---- Executed With Reference Price Message: 51 bytes -------------------------

// Informs you that all or part of an order has been executed, with the reference price associated with the execution.
entrypoint typedef struct _ExecutedWithReferencePriceMessage {
  UINT8 order_token_client_order_id[14];  // bytes 0 to 13
  UINT8 shares[6];                        // bytes 14 to 19
  UINT8 price[10];                        // bytes 20 to 29
  UINT8 liquidity;                        // byte 30
  UINT8 match_number[9];                  // bytes 31 to 39
  UINT8 reference_price[10];              // bytes 40 to 49
  UINT8 reference_price_type;             // byte 50
} ExecutedWithReferencePriceMessage;

// ---- Trade Correction Message: 41 bytes --------------------------------------

// A Trade Correction Message informs you that there has been a change to an execution.
entrypoint typedef struct _TradeCorrectionMessage {
  UINT8 order_token_client_order_id[14];  // bytes 0 to 13
  UINT8 shares[6];                        // bytes 14 to 19
  UINT8 price[10];                        // bytes 20 to 29
  UINT8 liquidity;                        // byte 30
  UINT8 match_number[9];                  // bytes 31 to 39
  UINT8 trade_correction_reason;          // byte 40
} TradeCorrectionMessage;

