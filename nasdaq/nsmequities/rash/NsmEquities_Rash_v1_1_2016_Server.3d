  UINT8 price[10];                           // bytes 29 to 38
  UINT8 time_in_force[5];                    // bytes 39 to 43
  UINT8 firm_client_id[4];                   // bytes 44 to 47
  UINT8 display;                             // byte 48
  UINT8 order_reference_number[9];           // bytes 49 to 57
  UINT8 min_qty[6];                          // bytes 58 to 63
  UINT8 max_floor[6];                        // bytes 64 to 69
  UINT8 peg_type;                            // byte 70
  UINT8 peg_difference_sign;                 // byte 71
  UINT8 peg_difference[10];                  // bytes 72 to 81
  UINT8 discretion_price[10];                // bytes 82 to 91
  UINT8 discretion_peg_type;                 // byte 92
  UINT8 discretion_peg_difference_sign;      // byte 93
  UINT8 discretion_peg_difference[10];       // bytes 94 to 103
  UINT8 capacity_rule_80_a_indicator;        // byte 104
  UINT8 random_reserve[6];                   // bytes 105 to 110
  UINT8 route_dest_exec_broker[4];           // bytes 111 to 114
  UINT8 cust_terminal_id_sender_sub_id[32];  // bytes 115 to 146
} AcceptedOrderMessage;

// ---- Accepted Order Message With Cross Functionality: 149 bytes --------------

// Similar to the regular Accepted Order Message, with the additional information provided upon order entry using the Enter Order Message with Cross Functionality.
entrypoint typedef struct _AcceptedOrderMessageWithCrossFunctionality {
  UINT8 order_token_client_order_id[14];     // bytes 0 to 13
  UINT8 side;                                // byte 14
  UINT8 shares_order_qty[6];                 // bytes 15 to 20
  UINT8 stock_symbol[8];                     // bytes 21 to 28
  UINT8 price[10];                           // bytes 29 to 38
  UINT8 time_in_force[5];                    // bytes 39 to 43
  UINT8 firm_client_id[4];                   // bytes 44 to 47
  UINT8 display;                             // byte 48
  UINT8 order_reference_number[9];           // bytes 49 to 57
  UINT8 min_qty[6];                          // bytes 58 to 63
  UINT8 max_floor[6];                        // bytes 64 to 69
  UINT8 peg_type;                            // byte 70
  UINT8 peg_difference_sign;                 // byte 71
  UINT8 peg_difference[10];                  // bytes 72 to 81
  UINT8 discretion_price[10];                // bytes 82 to 91
  UINT8 discretion_peg_type;                 // byte 92
  UINT8 discretion_peg_difference_sign;      // byte 93
  UINT8 discretion_peg_difference[10];       // bytes 94 to 103
  UINT8 capacity_rule_80_a_indicator;        // byte 104
  UINT8 random_reserve[6];                   // bytes 105 to 110
  UINT8 route_dest_exec_broker[4];           // bytes 111 to 114
  UINT8 cust_terminal_id_sender_sub_id[32];  // bytes 115 to 146
  UINT8 inter_market_sweep_eligibility;      // byte 147
  UINT8 cross_type;                          // byte 148
} AcceptedOrderMessageWithCrossFunctionality;

// ---- Canceled Order Message: 21 bytes ----------------------------------------

// A Canceled Order Message informs you that an order has been reduced or canceled. Canceled shares reflect the number of shares that are out.
entrypoint typedef struct _CanceledOrderMessage {
  UINT8 order_token_client_order_id[14];  // bytes 0 to 13
  UINT8 shares[6];                        // bytes 14 to 19
  UINT8 cancel_reason;                    // byte 20
} CanceledOrderMessage;

// ---- Rejected Order Message: 15 bytes ----------------------------------------

// A Rejected Order Message may be sent in response to an Enter Order Message if the order cannot be accepted at this time. The Token of a rejected order cannot be re-used.
entrypoint typedef struct _RejectedOrderMessage {
  UINT8 order_token_client_order_id[14];  // bytes 0 to 13
  UINT8 reject_reason;                    // byte 14
} RejectedOrderMessage;

// ---- Executed Order Message: 40 bytes ----------------------------------------

// An Executed Order Message informs you that all or part of an order has been executed.
entrypoint typedef struct _ExecutedOrderMessage {
  UINT8 order_token_client_order_id[14];  // bytes 0 to 13
  UINT8 shares[6];                        // bytes 14 to 19
  UINT8 price[10];                        // bytes 20 to 29
  UINT8 liquidity;                        // byte 30
  UINT8 match_number[9];                  // bytes 31 to 39
} ExecutedOrderMessage;

// ---- Broken Trade Message: 24 bytes ------------------------------------------

// A Broken Trade Message informs you that an execution has been broken. The trade is no longer good and will not clear.
entrypoint typedef struct _BrokenTradeMessage {
  UINT8 order_token[14];      // bytes 0 to 13
  UINT8 match_number[9];      // bytes 14 to 22
  UINT8 broken_trade_reason;  // byte 23
} BrokenTradeMessage;

// ---- Executed With Reference Price Message: 51 bytes -------------------------

// Informs you that all or part of an order has been executed, with the reference price associated with the execution.
entrypoint typedef struct _ExecutedWithReferencePriceMessage {
  UINT8 order_token_client_order_id[14];  // bytes 0 to 13
  UINT8 shares[6];                        // bytes 14 to 19
  UINT8 price[10];                        // bytes 20 to 29
  UINT8 liquidity;                        // byte 30
  UINT8 match_number[9];                  // bytes 31 to 39
  UINT8 reference_price[10];              // bytes 40 to 49
  UINT8 reference_price_type;             // byte 50
} ExecutedWithReferencePriceMessage;

// ---- Trade Correction Message: 41 bytes --------------------------------------

// A Trade Correction Message informs you that there has been a change to an execution.
entrypoint typedef struct _TradeCorrectionMessage {
  UINT8 order_token_client_order_id[14];  // bytes 0 to 13
  UINT8 shares[6];                        // bytes 14 to 19
  UINT8 price[10];                        // bytes 20 to 29
  UINT8 liquidity;                        // byte 30
  UINT8 match_number[9];                  // bytes 31 to 39
  UINT8 trade_correction_reason;          // byte 40
} TradeCorrectionMessage;

