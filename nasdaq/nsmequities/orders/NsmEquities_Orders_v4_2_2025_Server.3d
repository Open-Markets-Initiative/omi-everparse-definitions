#define EVENT_CODE_START_OF_DAY_THIS_IS_ALWAYS_THE_FIRST_MESSAGE_EACH_DAY 0x53                            // Start Of Day This Is Always The First Message Each Day
#define EVENT_CODE_END_OF_DAY_THIS_INDICATES_THAT_NASDAQ_IS_NOW_CLOSED_AND_WILL_NOT_ACCEPT_A_n6puol 0x45  // End Of Day This Indicates That Nasdaq Is Now Closed And Will Not Accept Any New Orders Or Replaces In This Session

