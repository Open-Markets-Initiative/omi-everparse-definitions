#define REJECTED_ORDER_REASON_REQUESTED_FIRM_NOT_AUTHORIZED_FOR_REQUESTED_CLEARING_TYPE_ON_THIS_ACCOUNT 0x4C  // Requested Firm Not Authorized For Requested Clearing Type On This Account
#define REJECTED_ORDER_REASON_RISK_MAX_SHARES_EXCEEDED 0x6D                                                   // Risk Max Shares Exceeded
