// ---- Packet Header: 20 bytes -------------------------------------------------

// Itch Mold Udp 64 Packet Header
entrypoint typedef struct _PacketHeader {
  UINT8 session[10];         // bytes 0 to 9
  UINT64BE sequence_number;  // bytes 10 to 17
  UINT16BE message_count;    // bytes 18 to 19
} PacketHeader;

// ---- Message Header: 11 bytes ------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;   // bytes 0 to 1
  UINT16BE tracking_number;  // bytes 2 to 3
  UINT8 timestamp[6];        // bytes 4 to 9
  UINT8 message_type;        // byte 10
} MessageHeader;

// ---- System Event Message: 1 byte --------------------------------------------

// System Event Messages is used to signal key market or data feed control events.
entrypoint typedef struct _SystemEventMessage {
  UINT8 event_code;  // byte 0
} SystemEventMessage;

// ---- Sale Condition Modifier: 4 bytes ----------------------------------------

// Sale condition modifier, consisting of four levels
entrypoint typedef struct _SaleConditionModifier {
  UINT8 settlement_type;              // byte 0
  UINT8 trade_through_exemption;      // byte 1
  UINT8 extended_hours_or_sold_code;  // byte 2
  UINT8 special_sale_condition;       // byte 3
} SaleConditionModifier;

// ---- Trade Report Message: 40 bytes ------------------------------------------

// Relays Nasdaq execution system and Trf trade transactions reported for the current business day. Nasdaq reports only one side of a trade execution on the Nls Plus feed.
entrypoint typedef struct _TradeReportMessage {
  UINT8 originating_market_center_identifier;     // byte 0
  UINT8 issue_symbol[8];                          // bytes 1 to 8
  UINT8 security_class;                           // byte 9
  UINT8 trade_control_number[10];                 // bytes 10 to 19
  UINT32BE trade_price;                           // bytes 20 to 23
  UINT32BE trade_size;                            // bytes 24 to 27
  SaleConditionModifier sale_condition_modifier;  // bytes 28 to 31
  UINT64BE consolidated_volume;                   // bytes 32 to 39
} TradeReportMessage;

// ---- Long Form Trade Report Message: 44 bytes --------------------------------

// Trade Report carrying an eight byte trade price, used when the price breaches the maximum value the four byte form can carry.
entrypoint typedef struct _LongFormTradeReportMessage {
  UINT8 originating_market_center_identifier;     // byte 0
  UINT8 issue_symbol[8];                          // bytes 1 to 8
  UINT8 security_class;                           // byte 9
  UINT8 trade_control_number[10];                 // bytes 10 to 19
  UINT64BE trade_price_long;                      // bytes 20 to 27
  UINT32BE trade_size;                            // bytes 28 to 31
  SaleConditionModifier sale_condition_modifier;  // bytes 32 to 35
  UINT64BE consolidated_volume;                   // bytes 36 to 43
} LongFormTradeReportMessage;

// ---- Next Shares Trade Report Message: 44 bytes ------------------------------

// Relays trade transactions for NextShares exchange traded managed funds, reported as a proxy price with the Nav offset to apply to it.
entrypoint typedef struct _NextSharesTradeReportMessage {
  UINT8 originating_market_center_identifier;     // byte 0
  UINT8 next_shares_symbol[8];                    // bytes 1 to 8
  UINT8 security_class;                           // byte 9
  UINT8 trade_control_number[10];                 // bytes 10 to 19
