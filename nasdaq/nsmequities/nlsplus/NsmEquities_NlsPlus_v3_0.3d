  UINT32BE trade_size;                            // bytes 24 to 27
  UINT32BE nav_offset_amount;                     // bytes 28 to 31
  SaleConditionModifier sale_condition_modifier;  // bytes 32 to 35
  UINT64BE consolidated_volume;                   // bytes 36 to 43
} NextSharesTradeReportMessage;

// ---- Original Sale Condition Modifier: 4 bytes -------------------------------

// The sale condition modifier reported on the original trade transaction
entrypoint typedef struct _OriginalSaleConditionModifier {
  UINT8 original_settlement_type;              // byte 0
  UINT8 original_trade_through_exemption;      // byte 1
  UINT8 original_extended_hours_or_sold_code;  // byte 2
