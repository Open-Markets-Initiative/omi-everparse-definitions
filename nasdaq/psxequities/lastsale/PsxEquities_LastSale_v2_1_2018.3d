// ---- Trading Action Message: 14 bytes ----------------------------------------

// PSX uses this administrative message to indicate the current trading status of a security to the trading community.
entrypoint typedef struct _TradingActionMessage {
  UINT8 issue_symbol[8];           // bytes 0 to 7
  UINT8 security_class;            // byte 8
  UINT8 current_trading_state;     // byte 9
  UINT8 trading_action_reason[4];  // bytes 10 to 13
} TradingActionMessage;

// ---- Reg Sho Short Sale Price Test Restricted Indicator Message: 9 bytes -----

// For Nasdaq-listed issues, Nasdaq supports a full pre-opening spin of Reg SHO Short Sale Price Test Restricted Indicator messages indicating the Rule 201 status for all active issues. Nasdaq also sends the Reg SHO Short Sale Price Test Restricted Indicator message in the event of an intraday status change. For other exchange-listed issues, Nasdaq relays the Reg SHO Short Sale Price Test Restricted Indicator message when it receives an update from the primary listing exchange.
entrypoint typedef struct _RegShoShortSalePriceTestRestrictedIndicatorMessage {
  UINT8 stock[8];        // bytes 0 to 7
  UINT8 reg_sho_action;  // byte 8
} RegShoShortSalePriceTestRestrictedIndicatorMessage;

// ---- Stock Directory Message: 28 bytes ---------------------------------------

// At the start of each trading day, PSX disseminates stock directory messages for all active symbols in the PSX system
entrypoint typedef struct _StockDirectoryMessage {
  UINT8 stock[8];                        // bytes 0 to 7
  UINT8 market_category;                 // byte 8
  UINT8 financial_status_indicator;      // byte 9
  UINT32BE round_lot_size;               // bytes 10 to 13
  UINT8 round_lots_only;                 // byte 14
  UINT8 issue_classification;            // byte 15
  UINT8 issue_sub_type[2];               // bytes 16 to 17
  UINT8 authenticity;                    // byte 18
  UINT8 short_sale_threshold_indicator;  // byte 19
  UINT8 ipo_flag;                        // byte 20
  UINT8 luld_reference_price_tier;       // byte 21
  UINT8 etp_flag;                        // byte 22
  UINT32BE etp_leverage_factor;          // bytes 23 to 26
  UINT8 inverse_indicator;               // byte 27
} StockDirectoryMessage;

// ---- Mwcb Decline Level Message: 24 bytes ------------------------------------

// Informs data recipients what the daily MWCB breach points are set to for the current trading day.
entrypoint typedef struct _MwcbDeclineLevelMessage {
  UINT64BE level_1;  // bytes 0 to 7
  UINT64BE level_2;  // bytes 8 to 15
  UINT64BE level_3;  // bytes 16 to 23
} MwcbDeclineLevelMessage;

// ---- Mwcb Breach Message: 1 byte ---------------------------------------------

// Informs data recipients when a MWCB has breached one of the established levels
entrypoint typedef struct _MwcbBreachMessage {
  UINT8 breached_level;  // byte 0
} MwcbBreachMessage;

// ---- Operational Halt Message: 10 bytes --------------------------------------

// Nasdaq uses this administrative message to indicate the current trading status of the three market centers operated by Nasdaq.
entrypoint typedef struct _OperationalHaltMessage {
  UINT8 stock[8];                 // bytes 0 to 7
  UINT8 market_code;              // byte 8
  UINT8 operational_halt_action;  // byte 9
} OperationalHaltMessage;

