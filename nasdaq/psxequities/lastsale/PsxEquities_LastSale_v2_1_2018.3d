  UINT8 sale_condition_modifier_level_2;  // byte 29
  UINT8 sale_condition_modifier_level_3;  // byte 30
  UINT8 sale_condition_modifier_level_4;  // byte 31
} TradeReportMessage;

// ---- Next Shares Trade Report Message: 36 bytes ------------------------------

// The following message is used to relay PSX execution system and TRF trade transactions for Exchange Traded Managed Funds (NextShares) that are reported for the current business day.
entrypoint typedef struct _NextSharesTradeReportMessage {
  UINT8 market_center_identifier;         // byte 0
  UINT8 next_shares_symbol[8];            // bytes 1 to 8
