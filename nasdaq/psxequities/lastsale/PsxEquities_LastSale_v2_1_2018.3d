  UINT8 sale_condition_modifier_level_3;  // byte 34
  UINT8 sale_condition_modifier_level_4;  // byte 35
} NextSharesTradeReportMessage;

// ---- Trade Cancel Error Message: 32 bytes ------------------------------------

// The following message is used in the event that a PSX trade transaction is cancelled on the same business day that it is reported
entrypoint typedef struct _TradeCancelErrorMessage {
  UINT8 market_center_identifier;             // byte 0
  UINT8 issue_symbol[8];                      // bytes 1 to 8
  UINT8 security_class;                       // byte 9
  UINT8 original_trade_control_number[10];    // bytes 10 to 19
  UINT32BE original_trade_price;              // bytes 20 to 23
  UINT32BE original_trade_size;               // bytes 24 to 27
  UINT8 original_sale_condition_modifier[4];  // bytes 28 to 31
} TradeCancelErrorMessage;

// ---- Trade Cancel Error For Next Shares Message: 36 bytes --------------------

// The following message is used in the event that a Nasdaq or TRF trade transaction for an NextShares is cancelled on the same business day that it is reported.
entrypoint typedef struct _TradeCancelErrorForNextSharesMessage {
  UINT8 market_center_identifier;                 // byte 0
  UINT8 issue_symbol[8];                          // bytes 1 to 8
  UINT8 security_class;                           // byte 9
