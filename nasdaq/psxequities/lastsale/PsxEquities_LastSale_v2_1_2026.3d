// ---- Types -------------------------------------------------------------------

// System Event Messages is used to signal key market or data feed control events.
typedef struct _SystemEventMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT8 event_code;          // byte 8
} SystemEventMessage;

// The following message is used to relay PSX execution system transactions that are reported for the current business day. Please note that PSX only reports one-side of a trade execution on the PSX Last Sale (PLS) feed and other data feed products.
typedef struct _TradeReportMessage {
  UINT16BE tracking_number;               // bytes 0 to 1
  UINT8 timestamp[6];                     // bytes 2 to 7
  UINT8 market_center_identifier;         // byte 8
  UINT8 issue_symbol[8];                  // bytes 9 to 16
  UINT8 security_class;                   // byte 17
  UINT8 trade_control_number[10];         // bytes 18 to 27
  UINT32BE trade_price;                   // bytes 28 to 31
  UINT32BE trade_size;                    // bytes 32 to 35
  UINT8 sale_condition_modifier_level_1;  // byte 36
  UINT8 sale_condition_modifier_level_2;  // byte 37
  UINT8 sale_condition_modifier_level_3;  // byte 38
  UINT8 sale_condition_modifier_level_4;  // byte 39
} TradeReportMessage;

// The following message is used to relay PSX execution system and TRF trade transactions for Exchange Traded Managed Funds (NextShares) that are reported for the current business day.
typedef struct _NextSharesTradeReportMessage {
  UINT16BE tracking_number;               // bytes 0 to 1
  UINT8 timestamp[6];                     // bytes 2 to 7
  UINT8 market_center_identifier;         // byte 8
  UINT8 next_shares_symbol[8];            // bytes 9 to 16
  UINT8 security_class;                   // byte 17
  UINT8 trade_control_number[10];         // bytes 18 to 27
  UINT32BE proxy_price;                   // bytes 28 to 31
  UINT32BE trade_size;                    // bytes 32 to 35
  UINT32BE nav_premium_discount_amount;   // bytes 36 to 39, signed, read here as unsigned
  UINT8 sale_condition_modifier_level_1;  // byte 40
  UINT8 sale_condition_modifier_level_2;  // byte 41
  UINT8 sale_condition_modifier_level_3;  // byte 42
  UINT8 sale_condition_modifier_level_4;  // byte 43
} NextSharesTradeReportMessage;

// The following message is used in the event that a PSX trade transaction is cancelled on the same business day that it is reported
typedef struct _TradeCancelErrorMessage {
  UINT16BE tracking_number;                   // bytes 0 to 1
  UINT8 timestamp[6];                         // bytes 2 to 7
  UINT8 market_center_identifier;             // byte 8
  UINT8 issue_symbol[8];                      // bytes 9 to 16
  UINT8 security_class;                       // byte 17
  UINT8 original_trade_control_number[10];    // bytes 18 to 27
  UINT32BE original_trade_price;              // bytes 28 to 31
  UINT32BE original_trade_size;               // bytes 32 to 35
  UINT8 original_sale_condition_modifier[4];  // bytes 36 to 39
} TradeCancelErrorMessage;

// The following message is used in the event that a Nasdaq or TRF trade transaction for an NextShares is cancelled on the same business day that it is reported.
typedef struct _TradeCancelErrorForNextSharesMessage {
  UINT16BE tracking_number;                       // bytes 0 to 1
  UINT8 timestamp[6];                             // bytes 2 to 7
  UINT8 market_center_identifier;                 // byte 8
  UINT8 issue_symbol[8];                          // bytes 9 to 16
  UINT8 security_class;                           // byte 17
  UINT8 original_trade_control_number[10];        // bytes 18 to 27
  UINT32BE original_trade_price;                  // bytes 28 to 31
  UINT32BE original_nav_premium_discount_amount;  // bytes 32 to 35, signed, read here as unsigned
  UINT32BE original_trade_size;                   // bytes 36 to 39
  UINT8 original_sale_condition_modifier[4];      // bytes 40 to 43
} TradeCancelErrorForNextSharesMessage;

// The following message is used in the event that a TRF trade transaction is corrected on the same business day that it is reported.
typedef struct _TradeCorrectionMessage {
  UINT16BE tracking_number;                    // bytes 0 to 1
  UINT8 timestamp[6];                          // bytes 2 to 7
  UINT8 market_center_identifier;              // byte 8
  UINT8 issue_symbol[8];                       // bytes 9 to 16
  UINT8 security_class;                        // byte 17
  UINT8 original_trade_control_number[10];     // bytes 18 to 27
  UINT32BE original_trade_price;               // bytes 28 to 31
  UINT32BE original_trade_size;                // bytes 32 to 35
  UINT8 original_sale_condition_modifier[4];   // bytes 36 to 39
  UINT8 corrected_trade_control_number[10];    // bytes 40 to 49
  UINT32BE corrected_trade_price;              // bytes 50 to 53
  UINT32BE corrected_trade_size;               // bytes 54 to 57
  UINT8 corrected_sale_condition_modifier[4];  // bytes 58 to 61
} TradeCorrectionMessage;

// The following message is used in the event that a TRF trade transaction for a NextShares is corrected on the same business day that it is reported.
typedef struct _TradeCorrectionForNextSharesMessage {
  UINT16BE tracking_number;                        // bytes 0 to 1
  UINT8 timestamp[6];                              // bytes 2 to 7
  UINT8 market_center_identifier;                  // byte 8
  UINT8 issue_symbol[8];                           // bytes 9 to 16
  UINT8 security_class;                            // byte 17
  UINT8 original_trade_control_number[10];         // bytes 18 to 27
  UINT32BE original_trade_price;                   // bytes 28 to 31
  UINT32BE original_nav_premium_discount_amount;   // bytes 32 to 35, signed, read here as unsigned
  UINT32BE original_trade_size;                    // bytes 36 to 39
  UINT8 original_sale_condition_modifier[4];       // bytes 40 to 43
  UINT8 corrected_trade_control_number[10];        // bytes 44 to 53
  UINT32BE corrected_trade_price;                  // bytes 54 to 57
  UINT32BE corrected_nav_premium_discount_amount;  // bytes 58 to 61, signed, read here as unsigned
  UINT32BE corrected_trade_size;                   // bytes 62 to 65
  UINT8 corrected_sale_condition_modifier[4];      // bytes 66 to 69
} TradeCorrectionForNextSharesMessage;

// PSX uses this administrative message to indicate the current trading status of a security to the trading community.
typedef struct _TradingActionMessage {
  UINT16BE tracking_number;        // bytes 0 to 1
  UINT8 timestamp[6];              // bytes 2 to 7
  UINT8 issue_symbol[8];           // bytes 8 to 15
  UINT8 security_class;            // byte 16
  UINT8 current_trading_state;     // byte 17
  UINT8 trading_action_reason[4];  // bytes 18 to 21
} TradingActionMessage;

// For Nasdaq-listed issues, Nasdaq supports a full pre-opening spin of Reg SHO Short Sale Price Test Restricted Indicator messages indicating the Rule 201 status for all active issues. Nasdaq also sends the Reg SHO Short Sale Price Test Restricted Indicator message in the event of an intraday status change. For other exchange-listed issues, Nasdaq relays the Reg SHO Short Sale Price Test Restricted Indicator message when it receives an update from the primary listing exchange.
typedef struct _RegShoShortSalePriceTestRestrictedIndicatorMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT8 stock[8];            // bytes 8 to 15
  UINT8 reg_sho_action;      // byte 16
} RegShoShortSalePriceTestRestrictedIndicatorMessage;

// At the start of each trading day, PSX disseminates stock directory messages for all active symbols in the PSX system
typedef struct _StockDirectoryMessage {
  UINT16BE tracking_number;              // bytes 0 to 1
  UINT8 timestamp[6];                    // bytes 2 to 7
  UINT8 stock[8];                        // bytes 8 to 15
  UINT8 market_category;                 // byte 16
  UINT8 financial_status_indicator;      // byte 17
  UINT32BE round_lot_size;               // bytes 18 to 21
  UINT8 round_lots_only;                 // byte 22
  UINT8 issue_classification;            // byte 23
  UINT8 issue_sub_type[2];               // bytes 24 to 25
  UINT8 authenticity;                    // byte 26
  UINT8 short_sale_threshold_indicator;  // byte 27
  UINT8 ipo_flag;                        // byte 28
  UINT8 luld_reference_price_tier;       // byte 29
  UINT8 etp_flag;                        // byte 30
  UINT32BE etp_leverage_factor;          // bytes 31 to 34
  UINT8 inverse_indicator;               // byte 35
} StockDirectoryMessage;

// Informs data recipients what the daily MWCB breach points are set to for the current trading day.
typedef struct _MwcbDeclineLevelMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT64BE level_1;          // bytes 8 to 15
  UINT64BE level_2;          // bytes 16 to 23
  UINT64BE level_3;          // bytes 24 to 31
} MwcbDeclineLevelMessage;

// Informs data recipients when a MWCB has breached one of the established levels
typedef struct _MwcbBreachMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT8 breached_level;      // byte 8
} MwcbBreachMessage;

// Nasdaq uses this administrative message to indicate the current trading status of the three market centers operated by Nasdaq.
typedef struct _OperationalHaltMessage {
  UINT16BE tracking_number;       // bytes 0 to 1
  UINT8 timestamp[6];             // bytes 2 to 7
  UINT8 stock[8];                 // bytes 8 to 15
  UINT8 market_code;              // byte 16
  UINT8 operational_halt_action;  // byte 17
} OperationalHaltMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x54: TradeReportMessage trade_report_message;
    case 0x4D: NextSharesTradeReportMessage next_shares_trade_report_message;
    case 0x58: TradeCancelErrorMessage trade_cancel_error_message;
    case 0x4F: TradeCancelErrorForNextSharesMessage trade_cancel_error_for_next_shares_message;
    case 0x43: TradeCorrectionMessage trade_correction_message;
    case 0x5A: TradeCorrectionForNextSharesMessage trade_correction_for_next_shares_message;
    case 0x48: TradingActionMessage trading_action_message;
    case 0x59: RegShoShortSalePriceTestRestrictedIndicatorMessage reg_sho_short_sale_price_test_restricted_indicator_message;
    case 0x52: StockDirectoryMessage stock_directory_message;
    case 0x56: MwcbDeclineLevelMessage mwcb_decline_level_message;
    case 0x57: MwcbBreachMessage mwcb_breach_message;
    case 0x68: OperationalHaltMessage operational_halt_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

