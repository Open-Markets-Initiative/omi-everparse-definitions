// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PsxEquities_Bbo_v2_0_2013_1.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                                        // System Event Message
#define MESSAGE_TYPE_STOCK_DIRECTORY_MESSAGE 0x52                                     // Stock Directory Message
#define MESSAGE_TYPE_STOCK_TRADING_ACTION_MESSAGE 0x48                                // Stock Trading Action Message
#define MESSAGE_TYPE_REG_SHO_SHORT_SALE_PRICE_TEST_RESTRICTED_INDICATOR_MESSAGE 0x59  // Reg Sho Short Sale Price Test Restricted Indicator Message
#define MESSAGE_TYPE_MWCB_DECLINE_LEVEL_MESSAGE 0x56                                  // Mwcb Decline Level Message
#define MESSAGE_TYPE_MWCB_STATUS_MESSAGE 0x57                                         // Mwcb Status Message
#define MESSAGE_TYPE_QUOTATION_MESSAGE 0x51                                           // Quotation Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_TRANSMISSIONS 0x4F  // Start Of Transmissions
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53   // Start Of System Hours
#define EVENT_CODE_START_OF_MARKET_HOURS 0x51   // Start Of Market Hours
#define EVENT_CODE_END_OF_MARKET_HOURS 0x4D     // End Of Market Hours
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45     // End Of System Hours
#define EVENT_CODE_END_OF_TRANSMISSIONS 0x43    // End Of Transmissions

// Market Category: one byte code
#define MARKET_CATEGORY_NASDAQ_GLOBAL_SELECT_MARKET 0x51  // Nasdaq Global Select Market
#define MARKET_CATEGORY_NASDAQ_GLOBAL_MARKET 0x47         // Nasdaq Global Market
#define MARKET_CATEGORY_NASDAQ_CAPITAL_MARKET 0x53        // Nasdaq Capital Market
#define MARKET_CATEGORY_NYSE 0x4E                         // Nyse
#define MARKET_CATEGORY_NYSE_MKT 0x41                     // Nyse Mkt
#define MARKET_CATEGORY_NYSE_ARCA 0x50                    // Nyse Arca
#define MARKET_CATEGORY_BATS_Z_EXCHANGE 0x5A              // Bats Z Exchange
#define MARKET_CATEGORY_NOT_AVAILABLE 0x20                // Not Available

// Financial Status Indicator: one byte code
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT 0x44                            // Deficient
#define FINANCIAL_STATUS_INDICATOR_DELINQUENT 0x45                           // Delinquent
#define FINANCIAL_STATUS_INDICATOR_BANKRUPT 0x51                             // Bankrupt
#define FINANCIAL_STATUS_INDICATOR_SUSPENDED 0x53                            // Suspended
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_AND_BANKRUPT 0x47               // Deficient And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_AND_DELINQUENT 0x48             // Deficient And Delinquent
#define FINANCIAL_STATUS_INDICATOR_DELINQUENT_AND_BANKRUPT 0x4A              // Delinquent And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_DELINQUENT_AND_BANKRUPT 0x4B    // Deficient Delinquent And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_CREATIONS_AND_REDEMPTIONS_SUSPENDED 0x43  // Creations And Redemptions Suspended
#define FINANCIAL_STATUS_INDICATOR_NORMAL 0x4E                               // Normal
#define FINANCIAL_STATUS_INDICATOR_NOT_AVAILABLE 0x20                        // Not Available

// Round Lots Only: one byte code
#define ROUND_LOTS_ONLY_ROUND_LOTS_ONLY 0x59             // Round Lots Only
#define ROUND_LOTS_ONLY_ODD_AND_MIXED_LOTS_ALLOWED 0x4E  // Odd And Mixed Lots Allowed

// Issue Classification: one byte code
#define ISSUE_CLASSIFICATION_AMERICAN_DEPOSITARY_SHARE 0x41      // American Depositary Share
#define ISSUE_CLASSIFICATION_BOND 0x42                           // Bond
#define ISSUE_CLASSIFICATION_COMMON_STOCK 0x43                   // Common Stock
#define ISSUE_CLASSIFICATION_DEPOSITORY_RECEIPT 0x46             // Depository Receipt
#define ISSUE_CLASSIFICATION_SEC_144_A 0x49                      // Sec 144 A
#define ISSUE_CLASSIFICATION_LIMITED_PARTNERSHIP 0x4C            // Limited Partnership
#define ISSUE_CLASSIFICATION_NOTES 0x4E                          // Notes
#define ISSUE_CLASSIFICATION_ORDINARY_SHARE 0x4F                 // Ordinary Share
#define ISSUE_CLASSIFICATION_PREFERRED_STOCK 0x50                // Preferred Stock
#define ISSUE_CLASSIFICATION_OTHER_SECURITIES 0x51               // Other Securities
#define ISSUE_CLASSIFICATION_RIGHT 0x52                          // Right
#define ISSUE_CLASSIFICATION_SHARES_OF_BENEFICIAL_INTEREST 0x53  // Shares Of Beneficial Interest
#define ISSUE_CLASSIFICATION_CONVERTIBLE_DEBENTURE 0x54          // Convertible Debenture
#define ISSUE_CLASSIFICATION_UNIT 0x55                           // Unit
#define ISSUE_CLASSIFICATION_UNITS_BENIF_INT 0x56                // Units Benif Int
#define ISSUE_CLASSIFICATION_WARRANT 0x57                        // Warrant

// Authenticity: one byte code
#define AUTHENTICITY_LIVE_PRODUCTION 0x50  // Live Production
#define AUTHENTICITY_TEST 0x54             // Test

// Short Sale Threshold Indicator: one byte code
#define SHORT_SALE_THRESHOLD_INDICATOR_RESTRICTED 0x59      // Restricted
#define SHORT_SALE_THRESHOLD_INDICATOR_NOT_RESTRICTED 0x4E  // Not Restricted
#define SHORT_SALE_THRESHOLD_INDICATOR_NOT_AVAILABLE 0x20   // Not Available

// Ipo Flag: one byte code
#define IPO_FLAG_NEW_IPO_SECURITY 0x59      // New Ipo Security
#define IPO_FLAG_NOT_NEW_IPO_SECURITY 0x4E  // Not New Ipo Security
#define IPO_FLAG_NOT_AVAILABLE 0x20         // Not Available

// Luld Reference Price Tier: one byte code
#define LULD_REFERENCE_PRICE_TIER_TIER_1 0x31         // Tier 1
#define LULD_REFERENCE_PRICE_TIER_TIER_2 0x32         // Tier 2
#define LULD_REFERENCE_PRICE_TIER_NOT_AVAILABLE 0x20  // Not Available

// Etp Flag: one byte code
#define ETP_FLAG_ETP 0x59            // Etp
#define ETP_FLAG_NOT_ETP 0x4E        // Not Etp
#define ETP_FLAG_NOT_AVAILABLE 0x20  // Not Available

// Inverse Indicator: one byte code
#define INVERSE_INDICATOR_INVERSE_ETP 0x59      // Inverse Etp
#define INVERSE_INDICATOR_NOT_INVERSE_ETP 0x4E  // Not Inverse Etp

// Security Class: one byte code
#define SECURITY_CLASS_NASDAQ_LISTED_ISSUE 0x51  // Nasdaq Listed Issue
#define SECURITY_CLASS_NYSE 0x4E                 // Nyse
#define SECURITY_CLASS_NYSE_MKT 0x41             // Nyse Mkt
#define SECURITY_CLASS_NYSE_ARCA 0x50            // Nyse Arca
#define SECURITY_CLASS_BATS 0x5A                 // Bats

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_HALTED_OR_PAUSED_ON_NASDAQ_AND_ALL_UTP_PARTICIPANTS 0x48      // Halted Or Paused On Nasdaq And All Utp Participants
#define CURRENT_TRADING_STATE_QUOTATION_ONLY_PERIOD_FOR_CROSS_SRO_HALT_OR_PAUSE 0x51        // Quotation Only Period For Cross Sro Halt Or Pause
#define CURRENT_TRADING_STATE_QUOTATION_ONLY_PERIOD_FOR_NASDAQ_OMX_ONLY_HALT_OR_PAUSE 0x52  // Quotation Only Period For Nasdaq Omx Only Halt Or Pause
#define CURRENT_TRADING_STATE_TRADING_ON_NASDAQ 0x54                                        // Trading On Nasdaq

// Reg Sho Action: one byte code
#define REG_SHO_ACTION_NO_PRICE_TEST_IN_PLACE 0x30         // No Price Test In Place
#define REG_SHO_ACTION_RESTRICTION_IN_EFFECT 0x31          // Restriction In Effect
#define REG_SHO_ACTION_RESTRICTION_REMAINS_IN_EFFECT 0x32  // Restriction Remains In Effect

// Breached Level: one byte code
#define BREACHED_LEVEL_LEVEL_1 0x31  // Level 1
#define BREACHED_LEVEL_LEVEL_2 0x32  // Level 2
#define BREACHED_LEVEL_LEVEL_3 0x33  // Level 3

// ---- Types -------------------------------------------------------------------

// The System Event message is used to signal key market or data feed control events.
typedef struct _SystemEventMessage {
  UINT8 event_code;  // byte 0
} SystemEventMessage;

// At the start of each trading day, NASDAQ PSX disseminates stock directory messages for all active symbols in its market center system.
typedef struct _StockDirectoryMessage {
  UINT8 stock[8];                        // bytes 0 to 7
  UINT8 market_category;                 // byte 8
  UINT8 financial_status_indicator;      // byte 9
  UINT8 round_lot_size[6];               // bytes 10 to 15
  UINT8 round_lots_only;                 // byte 16
  UINT8 issue_classification;            // byte 17
  UINT8 issue_sub_type[2];               // bytes 18 to 19
  UINT8 authenticity;                    // byte 20
  UINT8 short_sale_threshold_indicator;  // byte 21
  UINT8 ipo_flag;                        // byte 22
  UINT8 luld_reference_price_tier;       // byte 23
  UINT8 etp_flag;                        // byte 24
  UINT8 etp_leverage_factor[5];          // bytes 25 to 29
  UINT8 inverse_indicator;               // byte 30
} StockDirectoryMessage;

// NASDAQ OMX uses this administrative message to indicate the current trading status of a security to the trading community.
typedef struct _StockTradingActionMessage {
  UINT8 stock[8];               // bytes 0 to 7
  UINT8 security_class;         // byte 8
  UINT8 current_trading_state;  // byte 9
  UINT8 reason[4];              // bytes 10 to 13
  UINT8 tracking_id[13];        // bytes 14 to 26
} StockTradingActionMessage;

// Denotes the Reg SHO Short Sale Price Test Restriction (Rule 201) status for an issue: a full pre-opening spin for NASDAQ-listed issues and intraday status changes.
typedef struct _RegShoShortSalePriceTestRestrictedIndicatorMessage {
  UINT8 stock[8];        // bytes 0 to 7
  UINT8 reg_sho_action;  // byte 8
} RegShoShortSalePriceTestRestrictedIndicatorMessage;

// Informs data recipients what the daily MWCB breach points are set to for the current trading day.
typedef struct _MwcbDeclineLevelMessage {
  UINT8 level_1[12];  // bytes 0 to 11
  UINT8 level_2[12];  // bytes 12 to 23
  UINT8 level_3[12];  // bytes 24 to 35
} MwcbDeclineLevelMessage;

// Informs data recipients when a MWCB has breached one of the established levels.
typedef struct _MwcbStatusMessage {
  UINT8 breached_level;  // byte 0
} MwcbStatusMessage;

// PSX BBO will broadcast a real-time update every time that the exchange's best bid and offer quote is updated during the trading day.
typedef struct _QuotationMessage {
  UINT8 stock[8];                  // bytes 0 to 7
  UINT8 security_class;            // byte 8
  UINT8 psx_best_bid_price[10];    // bytes 9 to 18
  UINT8 psx_best_bid_size[9];      // bytes 19 to 27
  UINT8 psx_best_offer_price[10];  // bytes 28 to 37
  UINT8 psx_best_offer_size[9];    // bytes 38 to 46
  UINT8 tracking_id[13];           // bytes 47 to 59
} QuotationMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x52: StockDirectoryMessage stock_directory_message;
    case 0x48: StockTradingActionMessage stock_trading_action_message;
    case 0x59: RegShoShortSalePriceTestRestrictedIndicatorMessage reg_sho_short_sale_price_test_restricted_indicator_message;
    case 0x56: MwcbDeclineLevelMessage mwcb_decline_level_message;
    case 0x57: MwcbStatusMessage mwcb_status_message;
    case 0x51: QuotationMessage quotation_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp message data
typedef struct _MessageData (UINT16 message_length) where (message_length >= 9) {
  UINT8 timestamp[8];                                                                                                               // bytes 0 to 7
  UINT8 message_type;                                                                                                               // byte 8
  Payload(message_type, (((UINT32) message_length) - 9)) payload[:byte-size-single-element-array (((UINT32) message_length) - 9)];
} MessageData;

// Branch
casetype _MessageBody (UINT16 selector, UINT16 message_length) {
  switch (selector) {
    case 0x0000: unit end_of_session;
    default: MessageData(message_length) message_data;
  }
} MessageBody;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_length;                                                                                                                                           // bytes 0 to 1
  MessageBody(message_length, message_length) message_body[:byte-size-single-element-array ((((UINT32) message_length) + 2) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT32 sequence_number;                                                                                                      // bytes 10 to 13
  UINT16 message_count;                                                                                                        // bytes 14 to 15
  Messages(message_count, message_count, (available - 16), tally) messages[:byte-size-single-element-array (available - 16)];
} Packet;

