} SystemEventMessage;

// ---- Stock Directory Message: 36 bytes ---------------------------------------

// Market data vendors should process this message to populate the Financial Status Indicator (required display field) and the Market Category (recommended display field) for Nasdaq-listed issues.
entrypoint typedef struct _StockDirectoryMessage {
  UINT16BE tracking_number;              // bytes 0 to 1
  UINT8 timestamp[6];                    // bytes 2 to 7
  UINT8 stock[8];                        // bytes 8 to 15
