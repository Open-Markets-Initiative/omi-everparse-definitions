  UINT8 separator_9;         // byte 62
  UINT8 firm[4];             // bytes 63 to 66
  UINT8 separator_10;        // byte 67
  UINT8 reference[12];       // bytes 68 to 79
  UINT8 separator_11;        // byte 80
  UINT8 time_in_force[12];   // bytes 81 to 92
  UINT8 separator_12;        // byte 93
