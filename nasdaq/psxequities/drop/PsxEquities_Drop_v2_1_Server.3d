// Existing order replaced.
typedef struct _ExistingOrderReplacedMessage {
  UINT8 separator_1;         // byte 0
  UINT8 source[6];           // bytes 1 to 6
  UINT8 separator_2;         // byte 7
  UINT8 user[4];             // bytes 8 to 11
  UINT8 separator_3;         // byte 12
  UINT8 token[10];           // bytes 13 to 22
  UINT8 separator_4;         // byte 23
  UINT8 replaced_token[10];  // bytes 24 to 33
  UINT8 separator_5;         // byte 34
  UINT8 buy_sell;            // byte 35
  UINT8 separator_6;         // byte 36
