  UINT8 source[6];           // bytes 1 to 6
  UINT8 separator_2;         // byte 7
  UINT8 user[4];             // bytes 8 to 11
  UINT8 separator_3;         // byte 12
  UINT8 token[10];           // bytes 13 to 22
  UINT8 separator_4;         // byte 23
  UINT8 replaced_token[10];  // bytes 24 to 33
  UINT8 separator_5;         // byte 34
  UINT8 buy_sell;            // byte 35
  UINT8 separator_6;         // byte 36
  UINT8 shares[6];           // bytes 37 to 42
  UINT8 separator_7;         // byte 43
  UINT8 stock[6];            // bytes 44 to 49
  UINT8 separator_8;         // byte 50
  UINT8 price[11];           // bytes 51 to 61
  UINT8 separator_9;         // byte 62
  UINT8 firm[4];             // bytes 63 to 66
  UINT8 separator_10;        // byte 67
  UINT8 reference[12];       // bytes 68 to 79
  UINT8 separator_11;        // byte 80
  UINT8 time_in_force[12];   // bytes 81 to 92
  UINT8 separator_12;        // byte 93
  UINT8 capacity;            // byte 94
  UINT8 separator_13;        // byte 95
  UINT8 liquidity_flag;      // byte 96
  UINT8 separator_14;        // byte 97
  UINT8 clearing_code;       // byte 98
