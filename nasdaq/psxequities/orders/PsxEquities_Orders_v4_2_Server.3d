// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PsxEquities_Orders_v4_2_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53           // System Event Message
#define SEQUENCED_MESSAGE_TYPE_ACCEPTED_MESSAGE 0x41               // Accepted Message
#define SEQUENCED_MESSAGE_TYPE_REPLACED_MESSAGE 0x55               // Replaced Message
#define SEQUENCED_MESSAGE_TYPE_CANCELED_MESSAGE 0x43               // Canceled Message
#define SEQUENCED_MESSAGE_TYPE_AIQ_CANCELED_MESSAGE 0x44           // Aiq Canceled Message
#define SEQUENCED_MESSAGE_TYPE_EXECUTED_MESSAGE 0x45               // Executed Message
#define SEQUENCED_MESSAGE_TYPE_BROKEN_TRADE_MESSAGE 0x42           // Broken Trade Message
#define SEQUENCED_MESSAGE_TYPE_REJECTED_MESSAGE 0x4A               // Rejected Message
#define SEQUENCED_MESSAGE_TYPE_CANCEL_PENDING_MESSAGE 0x50         // Cancel Pending Message
#define SEQUENCED_MESSAGE_TYPE_CANCEL_REJECT_MESSAGE 0x49          // Cancel Reject Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_PRIORITY_UPDATE_MESSAGE 0x54  // Order Priority Update Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_MODIFIED_MESSAGE 0x4D         // Order Modified Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_DAY 0x53  // Start Of Day
#define EVENT_CODE_END_OF_DAY 0x45    // End Of Day

// Buy Sell Indicator: one byte code
#define BUY_SELL_INDICATOR_BUY 0x42                // Buy
#define BUY_SELL_INDICATOR_SELL 0x53               // Sell
#define BUY_SELL_INDICATOR_SELL_SHORT 0x54         // Sell Short
#define BUY_SELL_INDICATOR_SELL_SHORT_EXEMPT 0x45  // Sell Short Exempt

// Display: one byte code
#define DISPLAY_ATTRIBUTABLE_PRICE 0x41        // Attributable Price
#define DISPLAY_ANONYMOUS_PRICE 0x59           // Anonymous Price
#define DISPLAY_NON_DISPLAY 0x4E               // Non Display
#define DISPLAY_POST_ONLY 0x50                 // Post Only
#define DISPLAY_CHANGED_TO_NON_DISPLAYED 0x5A  // Changed To Non Displayed
#define DISPLAY_IMBALANCE_ONLY 0x49            // Imbalance Only
#define DISPLAY_MID_POINT_PEG 0x4D             // Mid Point Peg
#define DISPLAY_MID_POINT_PEG_POST_ONLY 0x57   // Mid Point Peg Post Only

// Capacity: one byte code
#define CAPACITY_OTHER 0x4F      // Other
#define CAPACITY_AGENCY 0x41     // Agency
#define CAPACITY_PRINCIPAL 0x50  // Principal
#define CAPACITY_RISKLESS 0x52   // Riskless

// Intermarket Sweep Eligibility: one byte code
#define INTERMARKET_SWEEP_ELIGIBILITY_ELIGIBLE 0x59      // Eligible
#define INTERMARKET_SWEEP_ELIGIBILITY_NOT_ELIGIBLE 0x4E  // Not Eligible
#define INTERMARKET_SWEEP_ELIGIBILITY_TRADE_AT 0x79      // Trade At

// Cross Type: one byte code
#define CROSS_TYPE_NO_CROSS 0x4E  // No Cross
#define CROSS_TYPE_OPENING 0x4F   // Opening
#define CROSS_TYPE_CLOSING 0x43   // Closing

// Order State: one byte code
#define ORDER_STATE_LIVE 0x4C  // Live
#define ORDER_STATE_DEAD 0x44  // Dead

// Bbo Weight Indicator: one byte code
#define BBO_WEIGHT_INDICATOR_LESS_THAN_POINT_TWO_PERCENT 0x30  // Less Than Point Two Percent
#define BBO_WEIGHT_INDICATOR_LESS_THAN_ONE_PERCENT 0x31        // Less Than One Percent
#define BBO_WEIGHT_INDICATOR_LESS_THAN_TWO_PERCENT 0x32        // Less Than Two Percent
#define BBO_WEIGHT_INDICATOR_GREATER_THAN_TWO_PERCENT 0x33     // Greater Than Two Percent
#define BBO_WEIGHT_INDICATOR_SETS_THE_QBBO 0x53                // Sets The Qbbo
#define BBO_WEIGHT_INDICATOR_IMPROVES_THE_NBBO 0x4E            // Improves The Nbbo

// Canceled Reason: one byte code
#define CANCELED_REASON_USER_REQUESTED_CANCEL 0x55                                              // User Requested Cancel
#define CANCELED_REASON_IMMEDIATE_OR_CANCEL_ORDER 0x49                                          // Immediate Or Cancel Order
#define CANCELED_REASON_TIMEOUT 0x54                                                            // Timeout
#define CANCELED_REASON_SUPERVISORY 0x53                                                        // Supervisory
#define CANCELED_REASON_THIS_ORDER_CANNOT_BE_EXECUTED_BECAUSE_OF_A_REGULATORY_RESTRICTION 0x44  // This Order Cannot Be Executed Because Of A Regulatory Restriction
#define CANCELED_REASON_SELF_MATCH_PREVENTION 0x51                                              // Self Match Prevention
#define CANCELED_REASON_SYSTEM_CANCEL 0x5A                                                      // System Cancel
#define CANCELED_REASON_CLOSED 0x45                                                             // Closed

// Liquidity Flag: one byte code
#define LIQUIDITY_FLAG_ADDED 0x41                                 // Added
#define LIQUIDITY_FLAG_REMOVED 0x52                               // Removed
#define LIQUIDITY_FLAG_OPENING_CROSS 0x4F                         // Opening Cross
#define LIQUIDITY_FLAG_OPENING_CROSS_IMBALANCE_ONLY 0x4D          // Opening Cross Imbalance Only
#define LIQUIDITY_FLAG_CLOSING_CROSS 0x43                         // Closing Cross
#define LIQUIDITY_FLAG_CLOSING_CROSS_IMBALANCE_ONLY 0x4C          // Closing Cross Imbalance Only
#define LIQUIDITY_FLAG_HALT_I_P_O_CROSS 0x48                      // Halt IPO Cross
#define LIQUIDITY_FLAG_HALT_CROSS 0x4B                            // Halt Cross
#define LIQUIDITY_FLAG_NON_DISPLAYED_AND_ADDED_LIQUIDITY 0x4A     // Non Displayed And Added Liquidity
#define LIQUIDITY_FLAG_REMOVED_LIQUIDITY_AT_A_MIDPOINT 0x6D       // Removed Liquidity At A Midpoint
#define LIQUIDITY_FLAG_ADDED_LIQUIDITY_VIA_A_MIDPOINT_ORDER 0x6B  // Added Liquidity Via A Midpoint Order
#define LIQUIDITY_FLAG_DISPLAYED_ADDED_LIQUIDITY 0x56             // Displayed Added Liquidity

// Broken Trade Reason: one byte code
#define BROKEN_TRADE_REASON_ERRONEOUS 0x45    // Erroneous
#define BROKEN_TRADE_REASON_CONSENT 0x43      // Consent
#define BROKEN_TRADE_REASON_SUPERVISORY 0x53  // Supervisory
#define BROKEN_TRADE_REASON_EXTERNAL 0x58     // External

// Rejected Reason: one byte code
#define REJECTED_REASON_TEST_MODE 0x54                                                                  // Test Mode
#define REJECTED_REASON_HALTED 0x48                                                                     // Halted
#define REJECTED_REASON_SHARES_EXCEEDS_CONFIGURED_SAFETY_THRESHOLD 0x5A                                 // Shares Exceeds Configured Safety Threshold
#define REJECTED_REASON_INVALID_STOCK 0x53                                                              // Invalid Stock
#define REJECTED_REASON_INVALID_DISPLAY_TYPE 0x44                                                       // Invalid Display Type
#define REJECTED_REASON_NASDAQ_OMX_PSX_IS_CLOSED 0x43                                                   // Nasdaq Omx Psx Is Closed
#define REJECTED_REASON_REQUESTED_FIRM_NOT_AUTHORIZED_FOR_REQUESTED_CLEARING_TYPE_ON_THIS_ACCOUNT 0x4C  // Requested Firm Not Authorized For Requested Clearing Type On This Account
#define REJECTED_REASON_OUTSIDE_OF_PERMITTED_TIMES 0x4D                                                 // Outside Of Permitted Times
#define REJECTED_REASON_THIS_ORDER_IS_NOT_ALLOWED_IN_THIS_TYPE_OF_CROSS 0x52                            // This Order Is Not Allowed In This Type Of Cross
#define REJECTED_REASON_INVALID_PRICE 0x58                                                              // Invalid Price
#define REJECTED_REASON_INVALID_MINIMUM_QUANTITY 0x4E                                                   // Invalid Minimum Quantity
#define REJECTED_REASON_INVALID_MIDPOINT 0x57                                                           // Invalid Midpoint
#define REJECTED_REASON_REJECT_ALL_ENABLED 0x61                                                         // Reject All Enabled
#define REJECTED_REASON_EASY_TO_BORROW_REJECT 0x62                                                      // Easy To Borrow Reject
#define REJECTED_REASON_RESTRICTED_SYMBOL_LIST_REJECT 0x63                                              // Restricted Symbol List Reject
#define REJECTED_REASON_I_S_O_ORDER_RESTRICTION 0x64                                                    // ISO Order Restriction
#define REJECTED_REASON_ODD_LOT_ORDER_RESTRICTION 0x65                                                  // Odd Lot Order Restriction
#define REJECTED_REASON_MID_POINT_ORDER_RESTRICTION 0x66                                                // Mid Point Order Restriction
#define REJECTED_REASON_PRE_MARKET_ORDER_RESTRICTION 0x67                                               // Pre Market Order Restriction
#define REJECTED_REASON_POST_MARKET_ORDER_RESTRICTION 0x68                                              // Post Market Order Restriction
#define REJECTED_REASON_SHORT_SALE_ORDER_RESTRICTION 0x69                                               // Short Sale Order Restriction
#define REJECTED_REASON_ON_OPEN_ORDER_RESTRICTION 0x6A                                                  // On Open Order Restriction
#define REJECTED_REASON_ON_CLOSE_ORDER_RESTRICTION 0x6B                                                 // On Close Order Restriction
#define REJECTED_REASON_TWO_SIDED_QUOTE_REJECT 0x6C                                                     // Two Sided Quote Reject
#define REJECTED_REASON_EXCEEDED_SHARES_LIMIT 0x6D                                                      // Exceeded Shares Limit
#define REJECTED_REASON_EXCEEDED_DOLLAR_VALUE_LIMIT 0x6E                                                // Exceeded Dollar Value Limit

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

typedef struct _SystemEventMessage {
  UINT64BE timestamp;  // bytes 0 to 7
  UINT8 event_code;    // byte 8
} SystemEventMessage;

typedef struct _AcceptedMessage {
  UINT64BE timestamp;                   // bytes 0 to 7
  UINT8 order_token[14];                // bytes 8 to 21
  UINT8 buy_sell_indicator;             // byte 22
  UINT32BE shares;                      // bytes 23 to 26
  UINT8 stock[8];                       // bytes 27 to 34
  UINT32BE price;                       // bytes 35 to 38
  UINT32BE time_in_force;               // bytes 39 to 42
  UINT8 firm[4];                        // bytes 43 to 46
  UINT8 display;                        // byte 47
  UINT64BE order_reference_number;      // bytes 48 to 55
  UINT8 capacity;                       // byte 56
  UINT8 intermarket_sweep_eligibility;  // byte 57
  UINT32BE minimum_quantity;            // bytes 58 to 61
  UINT8 cross_type;                     // byte 62
  UINT8 order_state;                    // byte 63
  UINT8 bbo_weight_indicator;           // byte 64
} AcceptedMessage;

typedef struct _ReplacedMessage {
  UINT64BE timestamp;                                 // bytes 0 to 7
  UINT8 replacement_order_token_alphanumeric_14[14];  // bytes 8 to 21
  UINT8 buy_sell_indicator;                           // byte 22
  UINT32BE shares;                                    // bytes 23 to 26
  UINT8 stock[8];                                     // bytes 27 to 34
  UINT32BE price;                                     // bytes 35 to 38
  UINT32BE time_in_force;                             // bytes 39 to 42
  UINT8 firm[4];                                      // bytes 43 to 46
  UINT8 display;                                      // byte 47
  UINT64BE order_reference_number;                    // bytes 48 to 55
  UINT8 capacity;                                     // byte 56
  UINT8 intermarket_sweep_eligibility;                // byte 57
  UINT32BE minimum_quantity;                          // bytes 58 to 61
  UINT8 cross_type;                                   // byte 62
  UINT8 order_state;                                  // byte 63
  UINT8 previous_order_token[14];                     // bytes 64 to 77
  UINT8 bbo_weight_indicator;                         // byte 78
} ReplacedMessage;

typedef struct _CanceledMessage {
  UINT64BE timestamp;         // bytes 0 to 7
  UINT8 order_token[14];      // bytes 8 to 21
  UINT32BE decrement_shares;  // bytes 22 to 25
  UINT8 canceled_reason;      // byte 26
} CanceledMessage;

typedef struct _AiqCanceledMessage {
  UINT64BE timestamp;                        // bytes 0 to 7
  UINT8 order_token[14];                     // bytes 8 to 21
  UINT32BE decrement_shares;                 // bytes 22 to 25
  UINT8 aiq_canceled_reason;                 // byte 26
  UINT32BE quantity_prevented_from_trading;  // bytes 27 to 30
  UINT32BE execution_price;                  // bytes 31 to 34
  UINT8 liquidity_flag;                      // byte 35
  UINT8 aiq_strategy;                        // byte 36
} AiqCanceledMessage;

typedef struct _ExecutedMessage {
  UINT64BE timestamp;        // bytes 0 to 7
  UINT8 order_token[14];     // bytes 8 to 21
  UINT32BE executed_shares;  // bytes 22 to 25
  UINT32BE execution_price;  // bytes 26 to 29
  UINT8 liquidity_flag;      // byte 30
  UINT64BE match_number;     // bytes 31 to 38
} ExecutedMessage;

typedef struct _BrokenTradeMessage {
  UINT64BE timestamp;         // bytes 0 to 7
  UINT8 order_token[14];      // bytes 8 to 21
  UINT64BE match_number;      // bytes 22 to 29
  UINT8 broken_trade_reason;  // byte 30
} BrokenTradeMessage;

typedef struct _RejectedMessage {
  UINT64BE timestamp;     // bytes 0 to 7
  UINT8 order_token[14];  // bytes 8 to 21
  UINT8 rejected_reason;  // byte 22
} RejectedMessage;

typedef struct _CancelPendingMessage {
  UINT64BE timestamp;     // bytes 0 to 7
  UINT8 order_token[14];  // bytes 8 to 21
} CancelPendingMessage;

typedef struct _OrderPriorityUpdateMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT8 order_token[14];            // bytes 8 to 21
  UINT32BE price;                   // bytes 22 to 25
  UINT8 display;                    // byte 26
  UINT64BE order_reference_number;  // bytes 27 to 34
} OrderPriorityUpdateMessage;

typedef struct _OrderModifiedMessage {
  UINT64BE timestamp;        // bytes 0 to 7
  UINT8 order_token[14];     // bytes 8 to 21
  UINT8 buy_sell_indicator;  // byte 22
  UINT32BE shares;           // bytes 23 to 26
} OrderModifiedMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x41: AcceptedMessage accepted_message;
    case 0x55: ReplacedMessage replaced_message;
    case 0x43: CanceledMessage canceled_message;
    case 0x44: AiqCanceledMessage aiq_canceled_message;
    case 0x45: ExecutedMessage executed_message;
    case 0x42: BrokenTradeMessage broken_trade_message;
    case 0x4A: RejectedMessage rejected_message;
    case 0x50: CancelPendingMessage cancel_pending_message;
    case 0x49: CancelPendingMessage cancel_reject_message;
    case 0x54: OrderPriorityUpdateMessage order_priority_update_message;
    case 0x4D: OrderModifiedMessage order_modified_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat;
    case 0x5A: unit end_of_session;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

