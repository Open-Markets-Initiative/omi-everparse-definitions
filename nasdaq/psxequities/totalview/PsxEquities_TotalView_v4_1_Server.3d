// ---- Server Packet Header: 3 bytes -------------------------------------------

// Packet header of a packet sent by the server
entrypoint typedef struct _ServerPacketHeader {
  UINT16BE packet_length;    // bytes 0 to 1
  UINT8 server_packet_type;  // byte 2
} ServerPacketHeader;

// ---- Login Accepted Packet: 30 bytes -----------------------------------------

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
entrypoint typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// ---- Login Rejected Packet: 1 byte -------------------------------------------

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
entrypoint typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// ---- Timestamp Seconds Message: 4 bytes --------------------------------------

// Reflects the number of seconds past midnight that the Timestamp message was generated. A Timestamp - Second message will be disseminated for every second for which there is at least one payload message.
entrypoint typedef struct _TimestampSecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} TimestampSecondsMessage;

// ---- System Event Message: 5 bytes -------------------------------------------

// PSX GLIMPSE product is designed to support the same system event messages as the PSX TotalView-ITCH feed. On PSX GLIMPSE, PSX will send out system event messages for those events that occurred up to the time of the PSX GLIMPSE snapshot request.
entrypoint typedef struct _SystemEventMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT8 event_code;                // byte 4
} SystemEventMessage;

// ---- Add Order Message: 29 bytes ---------------------------------------------

// Add Order - No MPID Attribution Message. This message will be generated for unattributed orders accepted by the PSX system.
entrypoint typedef struct _AddOrderMessage {
  UINT32BE timestamp_nanoseconds;   // bytes 0 to 3
  UINT64BE order_reference_number;  // bytes 4 to 11
  UINT8 buy_sell_indicator;         // byte 12
  UINT32BE shares;                  // bytes 13 to 16
  UINT8 stock[8];                   // bytes 17 to 24
  UINT32BE price;                   // bytes 25 to 28
} AddOrderMessage;

// ---- Add Order Mpid Attribution Message: 33 bytes ----------------------------

// Add Order with MPID Attribution Message. This message will be generated for attributed orders and quotations accepted by the PSX system. Note: This message will not be supported for NASDAQ OMX PSX for initial market launch.
entrypoint typedef struct _AddOrderMpidAttributionMessage {
  UINT32BE timestamp_nanoseconds;   // bytes 0 to 3
  UINT64BE order_reference_number;  // bytes 4 to 11
  UINT8 buy_sell_indicator;         // byte 12
  UINT32BE shares;                  // bytes 13 to 16
  UINT8 stock[8];                   // bytes 17 to 24
  UINT32BE price;                   // bytes 25 to 28
  UINT8 attribution[4];             // bytes 29 to 32
} AddOrderMpidAttributionMessage;

// ---- Stock Directory Message: 19 bytes ---------------------------------------

// At the start of each trading day, NASDAQ OMX PSX disseminates stock directory messages for all active symbols in the system for the current trading day. Please note that the Symbol Directory spin may include halted issues.
entrypoint typedef struct _StockDirectoryMessage {
  UINT32BE timestamp_nanoseconds;    // bytes 0 to 3
  UINT8 stock[8];                    // bytes 4 to 11
  UINT8 market_category;             // byte 12
  UINT8 financial_status_indicator;  // byte 13
  UINT32BE round_lot_size;           // bytes 14 to 17
  UINT8 round_lots_only;             // byte 18
} StockDirectoryMessage;

// ---- Stock Trading Action Message: 18 bytes ----------------------------------

// In the GLIMPSE transmission, PSX will send out a Stock Trading Action message for only those NASDAQ, NYSE, NYSE Amex, NYSE Arca and BATS issues that were eligible for trading during the current trading session.
entrypoint typedef struct _StockTradingActionMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT8 stock[8];                  // bytes 4 to 11
  UINT8 trading_state;             // byte 12
  UINT8 reserved;                  // byte 13
  UINT8 reason[4];                 // bytes 14 to 17
} StockTradingActionMessage;

// ---- Reg Sho Restriction Message: 13 bytes -----------------------------------

// Reg SHO Short Sale Price Test Restricted Indicator
entrypoint typedef struct _RegShoRestrictionMessage {
  UINT32BE timestamp_nanoseconds;  // bytes 0 to 3
  UINT8 stock[8];                  // bytes 4 to 11
  UINT8 reg_sho_action;            // byte 12
} RegShoRestrictionMessage;

// ---- End Of Snapshot Message: 20 bytes ---------------------------------------

// The Snapshot message reflects the PSX TotalView-ITCH 4.1 sequence number at the time that the PSX GLIMPSE 4.1 spin was requested.
entrypoint typedef struct _EndOfSnapshotMessage {
  UINT8 itch_sequence_number[20];  // bytes 0 to 19
} EndOfSnapshotMessage;

