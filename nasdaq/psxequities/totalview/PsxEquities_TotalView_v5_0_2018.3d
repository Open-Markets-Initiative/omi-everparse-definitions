// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PsxEquities_TotalView_v5_0_2018.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                                        // System Event Message
#define MESSAGE_TYPE_STOCK_DIRECTORY_MESSAGE 0x52                                     // Stock Directory Message
#define MESSAGE_TYPE_STOCK_TRADING_ACTION_MESSAGE 0x48                                // Stock Trading Action Message
#define MESSAGE_TYPE_REG_SHO_SHORT_SALE_PRICE_TEST_RESTRICTED_INDICATOR_MESSAGE 0x59  // Reg Sho Short Sale Price Test Restricted Indicator Message
#define MESSAGE_TYPE_MARKET_PARTICIPANT_POSITION_MESSAGE 0x4C                         // Market Participant Position Message
#define MESSAGE_TYPE_MWCB_DECLINE_LEVEL_MESSAGE 0x56                                  // Mwcb Decline Level Message
#define MESSAGE_TYPE_MWCB_STATUS_LEVEL_MESSAGE 0x57                                   // Mwcb Status Level Message
#define MESSAGE_TYPE_LULD_AUCTION_COLLAR_MESSAGE 0x4A                                 // Luld Auction Collar Message
#define MESSAGE_TYPE_OPERATIONAL_HALT_MESSAGE 0x68                                    // Operational Halt Message
#define MESSAGE_TYPE_ADD_ORDER_NO_MPID_ATTRIBUTION_MESSAGE 0x41                       // Add Order No Mpid Attribution Message
#define MESSAGE_TYPE_ADD_ORDER_WITH_MPID_ATTRIBUTION_MESSAGE 0x46                     // Add Order With Mpid Attribution Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45                                      // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_WITH_PRICE_MESSAGE 0x43                           // Order Executed With Price Message
#define MESSAGE_TYPE_ORDER_CANCEL_MESSAGE 0x58                                        // Order Cancel Message
#define MESSAGE_TYPE_ORDER_DELETE_MESSAGE 0x44                                        // Order Delete Message
#define MESSAGE_TYPE_ORDER_REPLACE_MESSAGE 0x55                                       // Order Replace Message
#define MESSAGE_TYPE_TRADE_MESSAGE_NON_CROSS 0x50                                     // Trade Message Non Cross
#define MESSAGE_TYPE_CROSS_TRADE_MESSAGE 0x51                                         // Cross Trade Message
#define MESSAGE_TYPE_BROKEN_TRADE_MESSAGE 0x42                                        // Broken Trade Message
#define MESSAGE_TYPE_NET_ORDER_IMBALANCE_INDICATOR_MESSAGE 0x49                       // Net Order Imbalance Indicator Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F      // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53  // Start Of System Hours
#define EVENT_CODE_START_OF_MARKET_HOURS 0x51  // Start Of Market Hours
#define EVENT_CODE_END_OF_MARKET_HOURS 0x4D    // End Of Market Hours
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45    // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43        // End Of Messages

// Market Category: one byte code
#define MARKET_CATEGORY_NASDAQ_GLOBAL_SELECT_MARKET 0x51  // Nasdaq Global Select Market
#define MARKET_CATEGORY_NASDAQ_GLOBAL_MARKET 0x47         // Nasdaq Global Market
#define MARKET_CATEGORY_NASDAQ_CAPITAL_MARKET 0x53        // Nasdaq Capital Market
#define MARKET_CATEGORY_NYSE 0x4E                         // Nyse
#define MARKET_CATEGORY_NYSE_MKT 0x41                     // Nyse Mkt
#define MARKET_CATEGORY_NYSE_ARCA 0x50                    // Nyse Arca
#define MARKET_CATEGORY_BATS_Z 0x5A                       // Bats Z
#define MARKET_CATEGORY_INVESTORS_EXCHANGE 0x56           // Investors Exchange
#define MARKET_CATEGORY_NA 0x20                           // Na

// Financial Status Indicator: one byte code
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT 0x44                            // Deficient
#define FINANCIAL_STATUS_INDICATOR_DELINQUENT 0x45                           // Delinquent
#define FINANCIAL_STATUS_INDICATOR_BANKRUPT 0x51                             // Bankrupt
#define FINANCIAL_STATUS_INDICATOR_SUSPENDED 0x53                            // Suspended
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_AND_BANKRUPT 0x47               // Deficient And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_AND_DELINQUENT 0x48             // Deficient And Delinquent
#define FINANCIAL_STATUS_INDICATOR_DELINQUENT_AND_BANKRUPT 0x4A              // Delinquent And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_DELINQUENT_AND_BANKRUPT 0x4B    // Deficient Delinquent And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_CREATIONS_AND_REDEMPTIONS_SUSPENDED 0x43  // Creations And Redemptions Suspended
#define FINANCIAL_STATUS_INDICATOR_NORMAL 0x4E                               // Normal
#define FINANCIAL_STATUS_INDICATOR_NA 0x20                                   // Na

// Round Lots Only: one byte code
#define ROUND_LOTS_ONLY_YES 0x59  // Yes
#define ROUND_LOTS_ONLY_NO 0x4E   // No

// Authenticity: one byte code
#define AUTHENTICITY_LIVE_PRODUCTION 0x50  // Live Production
#define AUTHENTICITY_TEST 0x54             // Test

// Short Sale Threshold Indicator: one byte code
#define SHORT_SALE_THRESHOLD_INDICATOR_RESTRICTED 0x59      // Restricted
#define SHORT_SALE_THRESHOLD_INDICATOR_NOT_RESTRICTED 0x4E  // Not Restricted
#define SHORT_SALE_THRESHOLD_INDICATOR_NA 0x20              // Na

// Ipo Flag: one byte code
#define IPO_FLAG_YES 0x59  // Yes
#define IPO_FLAG_NO 0x4E   // No
#define IPO_FLAG_NA 0x20   // Na

// Luld Reference Price Tier: one byte code
#define LULD_REFERENCE_PRICE_TIER_TIER_1 0x31  // Tier 1
#define LULD_REFERENCE_PRICE_TIER_TIER_2 0x32  // Tier 2
#define LULD_REFERENCE_PRICE_TIER_NA 0x20      // Na

// Etp Flag: one byte code
#define ETP_FLAG_ETP 0x59      // Etp
#define ETP_FLAG_NOT_ETP 0x4E  // Not Etp
#define ETP_FLAG_NA 0x20       // Na

// Inverse Indicator: one byte code
#define INVERSE_INDICATOR_INVERSE_ETP 0x59      // Inverse Etp
#define INVERSE_INDICATOR_NOT_INVERSE_ETP 0x4E  // Not Inverse Etp

// Trading State: one byte code
#define TRADING_STATE_HALTED 0x48                 // Halted
#define TRADING_STATE_PAUSED 0x50                 // Paused
#define TRADING_STATE_QUOTATION_ONLY_PERIOD 0x51  // Quotation Only Period
#define TRADING_STATE_TRADING 0x54                // Trading

// Reg Sho Action: one byte code
#define REG_SHO_ACTION_NO_PRICE_TEST 0x30                              // No Price Test
#define REG_SHO_ACTION_REG_SHO_SHORT_SALE_PRICE_TEST_RESTRICTION 0x31  // Reg Sho Short Sale Price Test Restriction
#define REG_SHO_ACTION_TEST_RESTRICTION_REMAINS 0x32                   // Test Restriction Remains

// Primary Market Maker: one byte code
#define PRIMARY_MARKET_MAKER_PRIMARY 0x59      // Primary
#define PRIMARY_MARKET_MAKER_NON_PRIMARY 0x4E  // Non Primary

// Market Maker Mode: one byte code
#define MARKET_MAKER_MODE_NORMAL 0x4E         // Normal
#define MARKET_MAKER_MODE_PASSIVE 0x50        // Passive
#define MARKET_MAKER_MODE_SYNDICATE 0x53      // Syndicate
#define MARKET_MAKER_MODE_PRE_SYNDICATE 0x52  // Pre Syndicate
#define MARKET_MAKER_MODE_PENALTY 0x4C        // Penalty

// Market Participant State: one byte code
#define MARKET_PARTICIPANT_STATE_ACTIVE 0x41             // Active
#define MARKET_PARTICIPANT_STATE_EXCUSED_WITHDRAWN 0x45  // Excused Withdrawn
#define MARKET_PARTICIPANT_STATE_WITHDRAWN 0x57          // Withdrawn
#define MARKET_PARTICIPANT_STATE_SUSPENDED 0x53          // Suspended
#define MARKET_PARTICIPANT_STATE_DELETED 0x44            // Deleted

// Breached Level: one byte code
#define BREACHED_LEVEL_LEVEL_1 0x31  // Level 1
#define BREACHED_LEVEL_LEVEL_2 0x32  // Level 2
#define BREACHED_LEVEL_LEVEL_3 0x33  // Level 3

// Market Code: one byte code
#define MARKET_CODE_NASDAQ 0x51  // Nasdaq
#define MARKET_CODE_BX 0x42      // Bx
#define MARKET_CODE_PSX 0x58     // Psx

// Operational Halt Action: one byte code
#define OPERATIONAL_HALT_ACTION_HALTED 0x48   // Halted
#define OPERATIONAL_HALT_ACTION_RESUMED 0x54  // Resumed

// Buy Sell Indicator: one byte code
#define BUY_SELL_INDICATOR_BUY 0x42   // Buy
#define BUY_SELL_INDICATOR_SELL 0x53  // Sell

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// Cross Type: one byte code
#define CROSS_TYPE_OPENING_CROSS 0x4F                        // Opening Cross
#define CROSS_TYPE_CLOSING_CROSS 0x43                        // Closing Cross
#define CROSS_TYPE_CROSS_HALTED_OR_PAUSED 0x48               // Cross Halted Or Paused
#define CROSS_TYPE_INTRADAY_CROSS_AND_POST_CLOSE_CROSS 0x49  // Intraday Cross And Post Close Cross

// Imbalance Direction: one byte code
#define IMBALANCE_DIRECTION_BUY 0x42                  // Buy
#define IMBALANCE_DIRECTION_SELL 0x53                 // Sell
#define IMBALANCE_DIRECTION_NO_IMBALANCE 0x4E         // No Imbalance
#define IMBALANCE_DIRECTION_INSUFFICIENT_ORDERS 0x4F  // Insufficient Orders

// Price Variation Indicator: one byte code
#define PRICE_VARIATION_INDICATOR_LESS_THAN_1 0x4C                                    // Less Than 1%
#define PRICE_VARIATION_INDICATOR_ONE_TO_ONE_POINT_NINE_NINE_PERCENT 0x31             // One To One Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_TWO_TO_TWO_POINT_NINE_NINE_PERCENT 0x32             // Two To Two Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_THREE_TO_THREE_POINT_NINE_NINE_PERCENT 0x33         // Three To Three Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_FOUR_TO_FOUR_POINT_NINE_NINE_PERCENT 0x34           // Four To Four Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_FIVE_TO_FIVE_POINT_NINE_NINE_PERCENT 0x35           // Five To Five Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_SIX_TO_SIX_POINT_NINE_NINE_PERCENT 0x36             // Six To Six Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_SEVEN_TO_SEVEN_POINT_NINE_NINE_PERCENT 0x37         // Seven To Seven Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_EIGHT_TO_EIGHT_POINT_NINE_NINE_PERCENT 0x38         // Eight To Eight Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_NINE_TO_NINE_POINT_NINE_NINE_PERCENT 0x39           // Nine To Nine Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_TEN_TO_NINETEEN_POINT_NINE_NINE_PERCENT 0x41        // Ten To Nineteen Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_TWENTY_TO_TWENTY_NINE_POINT_NINE_NINE_PERCENT 0x42  // Twenty To Twenty Nine Point Nine Nine Percent
#define PRICE_VARIATION_INDICATOR_THIRTY_PERCENT_OR_GREATER 0x43                      // Thirty Percent Or Greater
#define PRICE_VARIATION_INDICATOR_NO_CALCULATION 0x20                                 // No Calculation

// ---- Types -------------------------------------------------------------------

// Reflects the number of seconds past midnight that the Timestamp message was generated.
typedef struct _SystemEventMessage {
  UINT16BE stock_locate;     // bytes 0 to 1
  UINT16BE tracking_number;  // bytes 2 to 3
  UINT8 timestamp[6];        // bytes 4 to 9
  UINT8 event_code;          // byte 10
} SystemEventMessage;

// Market data redistributors should process this message to populate the Financial Status Indicator (required display field) and the Market Category (recommended display field) for NASDAQ-listed issues.
typedef struct _StockDirectoryMessage {
  UINT16BE stock_locate;                 // bytes 0 to 1
  UINT16BE tracking_number;              // bytes 2 to 3
  UINT8 timestamp[6];                    // bytes 4 to 9
  UINT8 stock[8];                        // bytes 10 to 17
  UINT8 market_category;                 // byte 18
  UINT8 financial_status_indicator;      // byte 19
  UINT32BE round_lot_size;               // bytes 20 to 23
  UINT8 round_lots_only;                 // byte 24
  UINT8 issue_classification;            // byte 25
  UINT8 issue_sub_type[2];               // bytes 26 to 27
  UINT8 authenticity;                    // byte 28
  UINT8 short_sale_threshold_indicator;  // byte 29
  UINT8 ipo_flag;                        // byte 30
  UINT8 luld_reference_price_tier;       // byte 31
  UINT8 etp_flag;                        // byte 32
  UINT32BE etp_leverage_factor;          // bytes 33 to 36
  UINT8 inverse_indicator;               // byte 37
} StockDirectoryMessage;

// Nasdaq PSX uses this administrative message to indicate the current trading status of a security to the trading community.
typedef struct _StockTradingActionMessage {
  UINT16BE stock_locate;     // bytes 0 to 1
  UINT16BE tracking_number;  // bytes 2 to 3
  UINT8 timestamp[6];        // bytes 4 to 9
  UINT8 stock[8];            // bytes 10 to 17
  UINT8 trading_state;       // byte 18
  UINT8 reserved;            // byte 19
  UINT8 reason[4];           // bytes 20 to 23
} StockTradingActionMessage;

// NASDAQ PSX processes orders based on the most Reg SHO Restriction status value.
typedef struct _RegShoShortSalePriceTestRestrictedIndicatorMessage {
  UINT16BE locate_code;      // bytes 0 to 1
  UINT16BE tracking_number;  // bytes 2 to 3
  UINT8 timestamp[6];        // bytes 4 to 9
  UINT8 stock[8];            // bytes 10 to 17
  UINT8 reg_sho_action;      // byte 18
} RegShoShortSalePriceTestRestrictedIndicatorMessage;

// Throughout the day, Nasdaq PSX will send out this message only if Nasdaq Operations changes the status of a market participant firm in an issue.
typedef struct _MarketParticipantPositionMessage {
  UINT16BE stock_locate;           // bytes 0 to 1
  UINT16BE tracking_number;        // bytes 2 to 3
  UINT8 timestamp[6];              // bytes 4 to 9
  UINT8 mpid[4];                   // bytes 10 to 13
  UINT8 stock[8];                  // bytes 14 to 21
  UINT8 primary_market_maker;      // byte 22
  UINT8 market_maker_mode;         // byte 23
  UINT8 market_participant_state;  // byte 24
} MarketParticipantPositionMessage;

// Informs data recipients what the daily MWCB breach points are set to for the current trading day.
typedef struct _MwcbDeclineLevelMessage {
  UINT16BE stock_locate;     // bytes 0 to 1
  UINT16BE tracking_number;  // bytes 2 to 3
  UINT8 timestamp[6];        // bytes 4 to 9
  UINT64BE level_1;          // bytes 10 to 17
  UINT64BE level_2;          // bytes 18 to 25
  UINT64BE level_3;          // bytes 26 to 33
} MwcbDeclineLevelMessage;

// Informs data recipients when a MWCB has breached one of the established levels
typedef struct _MwcbStatusLevelMessage {
  UINT16BE stock_locate;     // bytes 0 to 1
  UINT16BE tracking_number;  // bytes 2 to 3
  UINT8 timestamp[6];        // bytes 4 to 9
  UINT8 breached_level;      // byte 10
} MwcbStatusLevelMessage;

// Indicates the auction collar thresholds within which a paused security can reopen following a LULD Trading Pause
typedef struct _LuldAuctionCollarMessage {
  UINT16BE stock_locate;                    // bytes 0 to 1
  UINT16BE tracking_number;                 // bytes 2 to 3
  UINT8 timestamp[6];                       // bytes 4 to 9
  UINT8 stock[8];                           // bytes 10 to 17
  UINT32BE auction_collar_reference_price;  // bytes 18 to 21
  UINT32BE upper_auction_collar_price;      // bytes 22 to 25
  UINT32BE lower_auction_collar_price;      // bytes 26 to 29
  UINT32BE auction_collar_extension;        // bytes 30 to 33
} LuldAuctionCollarMessage;

// Nasdaq uses this administrative message to indicate the current trading status of the three market centers operated by Nasdaq.
typedef struct _OperationalHaltMessage {
  UINT16BE stock_locate;          // bytes 0 to 1
  UINT16BE tracking_number;       // bytes 2 to 3
  UINT8 timestamp[6];             // bytes 4 to 9
  UINT8 stock[8];                 // bytes 10 to 17
  UINT8 market_code;              // byte 18
  UINT8 operational_halt_action;  // byte 19
} OperationalHaltMessage;

// This message will be generated for unattributed orders accepted by the NASDAQ PSX system.
typedef struct _AddOrderNoMpidAttributionMessage {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT16BE tracking_number;         // bytes 2 to 3
  UINT8 timestamp[6];               // bytes 4 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT8 buy_sell_indicator;         // byte 18
  UINT32BE shares;                  // bytes 19 to 22
  UINT8 stock[8];                   // bytes 23 to 30
  UINT32BE price;                   // bytes 31 to 34
} AddOrderNoMpidAttributionMessage;

// This message will be generated for attributed orders and quotations accepted by the NASDAQ PSX system.
typedef struct _AddOrderWithMpidAttributionMessage {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT16BE tracking_number;         // bytes 2 to 3
  UINT8 timestamp[6];               // bytes 4 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT8 buy_sell_indicator;         // byte 18
  UINT32BE shares;                  // bytes 19 to 22
  UINT8 stock[8];                   // bytes 23 to 30
  UINT32BE price;                   // bytes 31 to 34
  UINT8 attribution[4];             // bytes 35 to 38
} AddOrderWithMpidAttributionMessage;

// This message is sent whenever an order on the book is executed in whole or in part. It is possible to receive several Order Executed Messages for the same order reference number if that order is executed in several parts. The multiple Order Executed Messages on the same order are cumulative.
typedef struct _OrderExecutedMessage {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT16BE tracking_number;         // bytes 2 to 3
  UINT8 timestamp[6];               // bytes 4 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT32BE executed_shares;         // bytes 18 to 21
  UINT64BE match_number;            // bytes 22 to 29
} OrderExecutedMessage;

// This message is sent whenever an order on the book is executed in whole or in part at a price different from the initial display price. Since the execution price is different than the display price of the original Add Order, Nasdaq PSX includes a price field within this execution message.
typedef struct _OrderExecutedWithPriceMessage {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT16BE tracking_number;         // bytes 2 to 3
  UINT8 timestamp[6];               // bytes 4 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT32BE executed_shares;         // bytes 18 to 21
  UINT64BE match_number;            // bytes 22 to 29
  UINT8 printable;                  // byte 30
  UINT32BE execution_price;         // bytes 31 to 34
} OrderExecutedWithPriceMessage;

// This message is sent whenever an order on the book is modified as a result of a partial cancellation.
typedef struct _OrderCancelMessage {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT16BE tracking_number;         // bytes 2 to 3
  UINT8 timestamp[6];               // bytes 4 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT32BE canceled_shares;         // bytes 18 to 21
} OrderCancelMessage;

// This message is sent whenever an order on the book is being cancelled. All remaining shares are no longer accessible so the order must be removed from the book.
typedef struct _OrderDeleteMessage {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT16BE tracking_number;         // bytes 2 to 3
  UINT8 timestamp[6];               // bytes 4 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
} OrderDeleteMessage;

// This message is sent whenever an order on the book has been cancel-replaced. All remaining shares from the original order are no longer accessible, and must be removed. The new order details are provided for the replacement, along with a new order reference number which will be used henceforth. Since the side, stock symbol and attribution (if any) cannot be changed by an Order Replace event, these fields are not included in the message. Firms should retain the side, stock symbol and MPID from the original Add Order message.
typedef struct _OrderReplaceMessage {
  UINT16BE stock_locate;                     // bytes 0 to 1
  UINT16BE tracking_number;                  // bytes 2 to 3
  UINT8 timestamp[6];                        // bytes 4 to 9
  UINT64BE original_order_reference_number;  // bytes 10 to 17
  UINT64BE new_order_reference_number;       // bytes 18 to 25
  UINT32BE shares;                           // bytes 26 to 29
  UINT32BE price;                            // bytes 30 to 33
} OrderReplaceMessage;

// The Trade Message is designed to provide execution details for normal match events involving non-displayable order types. (Note: There is a separate message for Nasdaq PSX cross events.)
typedef struct _TradeMessageNonCross {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT16BE tracking_number;         // bytes 2 to 3
  UINT8 timestamp[6];               // bytes 4 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT8 buy_sell_indicator;         // byte 18
  UINT32BE shares;                  // bytes 19 to 22
  UINT8 stock[8];                   // bytes 23 to 30
  UINT32BE price;                   // bytes 31 to 34
  UINT64BE match_number;            // bytes 35 to 42
} TradeMessageNonCross;

// Cross Trade message indicates that Nasdaq PSX has completed its cross process for a specific security. Nasdaq PSX sends out a Cross Trade message for all active issues in the system following the Opening, Closing and EMC cross events. Firms may use the Cross Trade message to determine when the cross for each security has been completed. (Note: For the halted / paused securities, firms should use the Trading Action message to determine when an issue has been released for trading.)
typedef struct _CrossTradeMessage {
  UINT16BE stock_locate;     // bytes 0 to 1
  UINT16BE tracking_number;  // bytes 2 to 3
  UINT8 timestamp[6];        // bytes 4 to 9
  UINT64BE cross_shares;     // bytes 10 to 17
  UINT8 stock[8];            // bytes 18 to 25
  UINT32BE cross_price;      // bytes 26 to 29
  UINT64BE match_number;     // bytes 30 to 37
  UINT8 cross_type;          // byte 38
} CrossTradeMessage;

// The Broken Trade Message is sent whenever an execution on Nasdaq PSX is broken. An execution may be broken if it is found to be clearly erroneous pursuant to Nasdaq s Clearly Erroneous Policy. A trade break is final; once a trade is broken, it cannot be reinstated.
typedef struct _BrokenTradeMessage {
  UINT16BE stock_locate;     // bytes 0 to 1
  UINT16BE tracking_number;  // bytes 2 to 3
  UINT8 timestamp[6];        // bytes 4 to 9
  UINT64BE match_number;     // bytes 10 to 17
} BrokenTradeMessage;

// NASDAQ PSX disseminates NOII data at 5-second intervals in the minutes leading up to the NASDAQ Opening Cross and NASDAQ Closing Cross
typedef struct _NetOrderImbalanceIndicatorMessage {
  UINT16BE stock_locate;             // bytes 0 to 1
  UINT16BE tracking_number;          // bytes 2 to 3
  UINT8 timestamp[6];                // bytes 4 to 9
  UINT64BE paired_shares;            // bytes 10 to 17
  UINT64BE imbalance_shares;         // bytes 18 to 25
  UINT8 imbalance_direction;         // byte 26
  UINT8 stock[8];                    // bytes 27 to 34
  UINT32BE far_price;                // bytes 35 to 38
  UINT32BE near_price;               // bytes 39 to 42
  UINT32BE current_reference_price;  // bytes 43 to 46
  UINT8 cross_type;                  // byte 47
  UINT8 price_variation_indicator;   // byte 48
} NetOrderImbalanceIndicatorMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x52: StockDirectoryMessage stock_directory_message;
    case 0x48: StockTradingActionMessage stock_trading_action_message;
    case 0x59: RegShoShortSalePriceTestRestrictedIndicatorMessage reg_sho_short_sale_price_test_restricted_indicator_message;
    case 0x4C: MarketParticipantPositionMessage market_participant_position_message;
    case 0x56: MwcbDeclineLevelMessage mwcb_decline_level_message;
    case 0x57: MwcbStatusLevelMessage mwcb_status_level_message;
    case 0x4A: LuldAuctionCollarMessage luld_auction_collar_message;
    case 0x68: OperationalHaltMessage operational_halt_message;
    case 0x41: AddOrderNoMpidAttributionMessage add_order_no_mpid_attribution_message;
    case 0x46: AddOrderWithMpidAttributionMessage add_order_with_mpid_attribution_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceMessage order_executed_with_price_message;
    case 0x58: OrderCancelMessage order_cancel_message;
    case 0x44: OrderDeleteMessage order_delete_message;
    case 0x55: OrderReplaceMessage order_replace_message;
    case 0x50: TradeMessageNonCross trade_message_non_cross;
    case 0x51: CrossTradeMessage cross_trade_message;
    case 0x42: BrokenTradeMessage broken_trade_message;
    case 0x49: NetOrderImbalanceIndicatorMessage net_order_imbalance_indicator_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

