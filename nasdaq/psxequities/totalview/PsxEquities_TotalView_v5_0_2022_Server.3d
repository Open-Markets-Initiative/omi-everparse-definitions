} ServerPacketHeader;

// ---- Login Accepted Packet: 30 bytes -----------------------------------------

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
entrypoint typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// ---- Login Rejected Packet: 1 byte -------------------------------------------

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
entrypoint typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// ---- System Event Message: 11 bytes ------------------------------------------

// PSX GLIMPSE product is designed to support the same system event messages as the PSX TotalView-ITCH feed. On PSX GLIMPSE, PSX will send out system event messages for those events that occurred up to the time of the PSX GLIMPSE snapshot request.
entrypoint typedef struct _SystemEventMessage {
  UINT16BE stock_locate;     // bytes 0 to 1
  UINT16BE tracking_number;  // bytes 2 to 3
  UINT8 timestamp[6];        // bytes 4 to 9
  UINT8 event_code;          // byte 10
} SystemEventMessage;

// ---- Add Order Message: 35 bytes ---------------------------------------------

// Add Order - No MPID Attribution Message. This message will be generated for unattributed orders accepted by the Nasdaq PSX system. (Note: If a firm wants to display a MPID for unattributed orders, Nasdaq PSX recommends that it use the MPID of NSDQ .)
entrypoint typedef struct _AddOrderMessage {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT16BE tracking_number;         // bytes 2 to 3
  UINT8 timestamp[6];               // bytes 4 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT8 buy_sell_indicator;         // byte 18
  UINT32BE shares;                  // bytes 19 to 22
  UINT8 stock[8];                   // bytes 23 to 30
  UINT32BE price;                   // bytes 31 to 34, signed, read here as unsigned
} AddOrderMessage;

// ---- Add Order Mpid Attribution Message: 39 bytes ----------------------------

// Add Order with MPID Attribution Message. This message will be generated for attributed orders and quotations accepted by the Nasdaq PSX system.
entrypoint typedef struct _AddOrderMpidAttributionMessage {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT16BE tracking_number;         // bytes 2 to 3
  UINT8 timestamp[6];               // bytes 4 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT8 buy_sell_indicator;         // byte 18
  UINT32BE shares;                  // bytes 19 to 22
  UINT8 stock[8];                   // bytes 23 to 30
  UINT32BE price;                   // bytes 31 to 34, signed, read here as unsigned
  UINT8 attribution[4];             // bytes 35 to 38
} AddOrderMpidAttributionMessage;

// ---- Stock Directory Message: 38 bytes ---------------------------------------

// At the start of each PSX GLIMPSE transmission, Nasdaq PSX will disseminate stock directory messages for all symbols in Nasdaq PSX execution system for the current trading day. Please note that the Symbol Directory spin may include halted issues. Firms must process the Trading Action message for current trading state information.
entrypoint typedef struct _StockDirectoryMessage {
  UINT16BE stock_locate;                 // bytes 0 to 1
  UINT16BE tracking_number;              // bytes 2 to 3
  UINT8 timestamp[6];                    // bytes 4 to 9
  UINT8 stock[8];                        // bytes 10 to 17
  UINT8 market_category;                 // byte 18
  UINT8 financial_status_indicator;      // byte 19
  UINT32BE round_lot_size;               // bytes 20 to 23
  UINT8 round_lots_only;                 // byte 24
  UINT8 issue_classification;            // byte 25
  UINT8 issue_sub_type[2];               // bytes 26 to 27
  UINT8 authenticity;                    // byte 28
  UINT8 short_sale_threshold_indicator;  // byte 29
  UINT8 ipo_flag;                        // byte 30
  UINT8 luld_reference_price_tier;       // byte 31
  UINT8 etp_flag;                        // byte 32
  UINT32BE etp_leverage_factor;          // bytes 33 to 36
  UINT8 inverse_indicator;               // byte 37
} StockDirectoryMessage;

// ---- Stock Trading Action Message: 24 bytes ----------------------------------

// In the PSX GLIMPSE transmission, Nasdaq PSX will send out a Stock Trading Action message for only those Nasdaq, NYSE, and other regional exchanges issues that were eligible for trading during the current trading session.
entrypoint typedef struct _StockTradingActionMessage {
  UINT16BE stock_locate;     // bytes 0 to 1
  UINT16BE tracking_number;  // bytes 2 to 3
  UINT8 timestamp[6];        // bytes 4 to 9
  UINT8 stock[8];            // bytes 10 to 17
  UINT8 trading_state;       // byte 18
  UINT8 reserved_1;          // byte 19
  UINT8 reason[4];           // bytes 20 to 23
} StockTradingActionMessage;

// ---- Reg Sho Restriction Message: 19 bytes -----------------------------------

// Reg SHO Short Sale Price Test Restricted Indicator
entrypoint typedef struct _RegShoRestrictionMessage {
  UINT16BE locate_code;      // bytes 0 to 1
  UINT16BE tracking_number;  // bytes 2 to 3
  UINT8 timestamp[6];        // bytes 4 to 9
  UINT8 stock[8];            // bytes 10 to 17
  UINT8 reg_sho_action;      // byte 18
} RegShoRestrictionMessage;

// ---- End Of Snapshot Message: 20 bytes ---------------------------------------

// The Snapshot message reflects the Nasdaq PSX TotalView-ITCH sequence number at the time that the Nasdaq PSX GLIMPSE spin was requested.
entrypoint typedef struct _EndOfSnapshotMessage {
  UINT8 itch_sequence_number[20];  // bytes 0 to 19
} EndOfSnapshotMessage;

// ---- Operational Halt Message: 20 bytes --------------------------------------

// The Exchange uses this message to indicate the current Operational Status of a security to the trading community. An Operational Halt means that there has been an interruption of service on the identified security impacting only the designated Market Center. PSX GLIMPSE will distribute the Operational Halt message on a last seen basis.
entrypoint typedef struct _OperationalHaltMessage {
  UINT16BE stock_locate;          // bytes 0 to 1
  UINT16BE tracking_number;       // bytes 2 to 3
  UINT8 timestamp[6];             // bytes 4 to 9
  UINT8 stock[8];                 // bytes 10 to 17
  UINT8 market_code;              // byte 18
  UINT8 operational_halt_action;  // byte 19
} OperationalHaltMessage;

