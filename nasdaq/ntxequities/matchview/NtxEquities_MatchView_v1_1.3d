// ---- Packet Header: 16 bytes -------------------------------------------------

entrypoint typedef struct _PacketHeader {
  UINT8 session[10];       // bytes 0 to 9
  UINT32 sequence_number;  // bytes 10 to 13
  UINT16 message_count;    // bytes 14 to 15
} PacketHeader;

// ---- Message Header: 9 bytes -------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT8 timestamp[8];  // bytes 0 to 7
  UINT8 message_type;  // byte 8
} MessageHeader;

// ---- Quote Update Message: 28 bytes ------------------------------------------

// The prevailing best bid and offer of the other exchanges as the Nasdaq Texas execution system sees it.
entrypoint typedef struct _QuoteUpdateMessage {
  UINT8 stock[8];       // bytes 0 to 7
  UINT8 bid_price[10];  // bytes 8 to 17
  UINT8 ask_price[10];  // bytes 18 to 27
} QuoteUpdateMessage;

