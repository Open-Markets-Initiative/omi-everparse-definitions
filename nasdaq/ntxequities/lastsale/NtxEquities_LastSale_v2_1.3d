} MessageHeader;

// ---- System Event Message: 9 bytes -------------------------------------------

// System Event Messages is used to signal key market or data feed control events.
entrypoint typedef struct _SystemEventMessage {
  UINT16BE tracking_number;  // bytes 0 to 1
  UINT8 timestamp[6];        // bytes 2 to 7
  UINT8 event_code;          // byte 8
} SystemEventMessage;

// ---- Trade Report Message: 40 bytes ------------------------------------------

// The following message is used to relay BX execution system transactions that are reported for the current business day. Please note that BX only reports one-side of a trade execution on the BX Last Sale (PLS) feed and other data feed products.
entrypoint typedef struct _TradeReportMessage {
  UINT16BE tracking_number;               // bytes 0 to 1
  UINT8 timestamp[6];                     // bytes 2 to 7
  UINT8 market_center_identifier;         // byte 8
  UINT8 issue_symbol[8];                  // bytes 9 to 16
  UINT8 security_class;                   // byte 17
  UINT8 trade_control_number[10];         // bytes 18 to 27
  UINT32BE trade_price;                   // bytes 28 to 31
  UINT32BE trade_size;                    // bytes 32 to 35
  UINT8 sale_condition_modifier_level_1;  // byte 36
  UINT8 sale_condition_modifier_level_2;  // byte 37
  UINT8 sale_condition_modifier_level_3;  // byte 38
  UINT8 sale_condition_modifier_level_4;  // byte 39
} TradeReportMessage;

// ---- Next Shares Trade Report Message: 44 bytes ------------------------------

// The following message is used to relay BX execution system and TRF trade transactions for Exchange Traded Managed Funds (NextShares) that are reported for the current business day.
entrypoint typedef struct _NextSharesTradeReportMessage {
  UINT16BE tracking_number;               // bytes 0 to 1
  UINT8 timestamp[6];                     // bytes 2 to 7
  UINT8 market_center_identifier;         // byte 8
