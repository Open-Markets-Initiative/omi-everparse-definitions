// ---- Trading Action Message: 22 bytes ----------------------------------------

// BX uses this administrative message to indicate the current trading status of a security to the trading community.
entrypoint typedef struct _TradingActionMessage {
  UINT16BE tracking_number;        // bytes 0 to 1
  UINT8 timestamp[6];              // bytes 2 to 7
  UINT8 issue_symbol[8];           // bytes 8 to 15
  UINT8 security_class;            // byte 16
