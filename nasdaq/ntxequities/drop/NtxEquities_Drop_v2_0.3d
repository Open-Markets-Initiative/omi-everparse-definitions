  UINT8 separator_2;       // byte 7
  UINT8 user[4];           // bytes 8 to 11
  UINT8 separator_3;       // byte 12
  UINT8 token[10];         // bytes 13 to 22
  UINT8 separator_4;       // byte 23
  UINT8 buy_sell;          // byte 24
  UINT8 separator_5;       // byte 25
  UINT8 shares[6];         // bytes 26 to 31
  UINT8 separator_6;       // byte 32
  UINT8 stock[6];          // bytes 33 to 38
  UINT8 separator_7;       // byte 39
  UINT8 price[11];         // bytes 40 to 50
  UINT8 separator_8;       // byte 51
  UINT8 firm[4];           // bytes 52 to 55
  UINT8 separator_9;       // byte 56
  UINT8 reference[9];      // bytes 57 to 65
  UINT8 separator_10;      // byte 66
  UINT8 time_in_force[9];  // bytes 67 to 75
  UINT8 separator_11;      // byte 76
  UINT8 liquidity_code;    // byte 77
  UINT8 separator_12;      // byte 78
  UINT8 clearing_code;     // byte 79
} NewOrderAcceptedMessage;

