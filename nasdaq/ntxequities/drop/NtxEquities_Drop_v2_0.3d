// ---- Message Header: 11 bytes ------------------------------------------------

// Time Stamp and Type opening every Drop message line
entrypoint typedef struct _MessageHeader {
  UINT8 time_stamp[9];  // bytes 0 to 8
  UINT8 comma;          // byte 9
  UINT8 message_type;   // byte 10
} MessageHeader;

// ---- New Order Accepted Message: 80 bytes ------------------------------------

// New order accepted.
entrypoint typedef struct _NewOrderAcceptedMessage {
  UINT8 separator_1;       // byte 0
