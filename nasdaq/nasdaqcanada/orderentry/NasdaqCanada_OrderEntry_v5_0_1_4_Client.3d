// Replace Order Request Appendage
typedef struct _ReplaceOrderRequestAppendage {
  UINT8 optional_field_length { optional_field_length >= 1 };                                                                                                                                                                               // byte 0
  UINT8 replace_order_request_optional_field;                                                                                                                                                                                               // byte 1
  ReplaceOrderRequestOptionalValue(replace_order_request_optional_field, ((((UINT32) optional_field_length) + 1) - 2)) replace_order_request_optional_value[:byte-size-single-element-array ((((UINT32) optional_field_length) + 1) - 2)];
} ReplaceOrderRequestAppendage;

// The Replace Order Message allows you to alter most of the attributes of an order in a single message. This is more efficient than canceling an existing order and immediately succeeding it with a new order.
typedef struct _ReplaceOrderRequestMessage {
  UINT32BE orig_user_ref_num;                                                                            // bytes 0 to 3
  UINT32BE user_ref_num;                                                                                 // bytes 4 to 7
  UINT32BE order_qty;                                                                                    // bytes 8 to 11
  UINT64BE price;                                                                                        // bytes 12 to 19
  UINT8 side;                                                                                            // byte 20
  UINT8 time_in_force;                                                                                   // byte 21
  UINT16BE appendage_length;                                                                             // bytes 22 to 23
  ReplaceOrderRequestAppendage replace_order_request_appendage[:byte-size ((UINT32) appendage_length)];
} ReplaceOrderRequestMessage;

// Branch
casetype _CancelOrderRequestOptionalValue (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x25: UINT8 user_ref_idx;
    default: UINT8 unknown[available];
  }
} CancelOrderRequestOptionalValue;

// Cancel Order Request Appendage
typedef struct _CancelOrderRequestAppendage {
  UINT8 optional_field_length { optional_field_length >= 1 };                                                                                                                                                                            // byte 0
  UINT8 cancel_order_request_optional_field;                                                                                                                                                                                             // byte 1
  CancelOrderRequestOptionalValue(cancel_order_request_optional_field, ((((UINT32) optional_field_length) + 1) - 2)) cancel_order_request_optional_value[:byte-size-single-element-array ((((UINT32) optional_field_length) + 1) - 2)];
} CancelOrderRequestAppendage;

// The Cancel Order Message is used to request that an order be canceled or reduced. You must specify the new intended order size, the maximum number of shares that can be executed in total after the cancel is applied.
typedef struct _CancelOrderRequestMessage {
  UINT32BE user_ref_num;                                                                               // bytes 0 to 3
  UINT32BE order_qty;                                                                                  // bytes 4 to 7
  UINT16BE appendage_length;                                                                           // bytes 8 to 9
  CancelOrderRequestAppendage cancel_order_request_appendage[:byte-size ((UINT32) appendage_length)];
} CancelOrderRequestMessage;

// Account Query Request Appendage
typedef struct _AccountQueryRequestAppendage {
  UINT8 optional_field_length { optional_field_length >= 1 };                                                                                                                                                                              // byte 0
  UINT8 account_query_request_optional_field;                                                                                                                                                                                              // byte 1
  CancelOrderRequestOptionalValue(account_query_request_optional_field, ((((UINT32) optional_field_length) + 1) - 2)) account_query_request_optional_value[:byte-size-single-element-array ((((UINT32) optional_field_length) + 1) - 2)];
} AccountQueryRequestAppendage;

// The Account Query Request message can be used when recovering state to request the next available UserRefNum that can be used for identifying new transactions.
typedef struct _AccountQueryRequestMessage {
  UINT16BE appendage_length;                                                                             // bytes 0 to 1
  AccountQueryRequestAppendage account_query_request_appendage[:byte-size ((UINT32) appendage_length)];
} AccountQueryRequestMessage;

// The unsequenced (client to server) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _UnsequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x4F: EnterOrderMessage enter_order_message;
    case 0x55: ReplaceOrderRequestMessage replace_order_request_message;
    case 0x58: CancelOrderRequestMessage cancel_order_request_message;
    case 0x51: AccountQueryRequestMessage account_query_request_message;
    default: UINT8 unknown[available];
  }
} UnsequencedMessage;

// The Unsequenced Data Packets act as an envelope to carry the actual data messages that are transferred from the client to the server
typedef struct _UnsequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 unsequenced_message_type;                                                                                                                                    // byte 0
  UnsequencedMessage(unsequenced_message_type, (((UINT32) packet_length) - 2)) unsequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} UnsequencedDataPacket;

// Branch
casetype _ClientPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x4C: LoginRequestPacket login_request_packet;
    case 0x55: UnsequencedDataPacket(packet_length) unsequenced_data_packet[:byte-size-single-element-array length];
    case 0x52: unit client_heartbeat;
    case 0x4F: unit logout_request;
    default: UINT8 unknown[available];
  }
} ClientPayload;

// Soup Bin Tcp Packet sent by the client
typedef struct _ClientSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 client_packet_type;                                                                                                                                                                                     // byte 2
  ClientPayload(client_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) client_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ClientSoupBinTcpPacket;

// ---- Packet: ClientPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the client
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientSoupBinTcpPacket client_soup_bin_tcp_packet[:byte-size available];
} ClientPacket;

