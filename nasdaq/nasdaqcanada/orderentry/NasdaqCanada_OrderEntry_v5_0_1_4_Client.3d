// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP client must send a Login Request Packet immediately upon establishing a new TCP/IP socket connection to the server
typedef struct _LoginRequestPacket {
  UINT8 username[6];                    // bytes 0 to 5
  UINT8 password[10];                   // bytes 6 to 15
  UINT8 requested_session[10];          // bytes 16 to 25
  UINT8 requested_sequence_number[20];  // bytes 26 to 45
} LoginRequestPacket;

// Branch
casetype _EnterOrderOptionalValue (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x25: UINT8 user_ref_idx;
    case 0x01: UINT8 account[15];
    case 0x02: UINT8 peg_type;
    case 0x03: UINT8 min_qty_type;
    case 0x04: UINT32BE min_qty;
    case 0x05: UINT32BE max_floor;
    case 0x06: UINT32BE expire_time;
    case 0x07: UINT64BE peg_offset;
    case 0x08: UINT16BE target_strategy;
    case 0x09: UINT8 order_origination;
    case 0x0A: UINT8 routing_arrangement_indicator;
    case 0x0B: UINT8 basket_trade;
    case 0x0C: UINT8 program_trade;
    case 0x0E: UINT8 jitney[3];
    case 0x0F: UINT8 gef_eligible;
    case 0x10: UINT8 anonymous;
    case 0x11: UINT8 umir_regulation_id[2];
    case 0x12: UINT8 bypass;
    case 0x13: UINT8 tsxncib;
    case 0x14: UINT8 no_trade_feat;
    case 0x15: UINT8 no_trade_key[6];
    case 0x16: UINT8 short_marking_exempt;
    case 0x17: UINT8 po_comment[32];
    case 0x18: UINT32BE display_range;
    case 0x19: UINT8 customer_account[20];
    case 0x1A: UINT8 algorithm_id[20];
    case 0x1B: UINT8 customer_lei[52];
    case 0x1C: UINT8 broker_lei[20];
    case 0x1D: UINT8 conditional_order;
    case 0x1E: UINT8 allow_conditional;
    case 0x1F: UINT64BE firm_up_id;
    case 0x20: UINT8 cxd_connect;
    case 0x21: UINT8 pure_stream_connect;
    case 0x22: UINT16BE min_rate;
    case 0x23: UINT16BE max_rate;
    case 0x27: UINT8 routing_strategy[15];
    case 0x2B: UINT8 handl_inst;
    default: UINT8 unknown[available];
  }
} EnterOrderOptionalValue;

// Enter Order Appendage
typedef struct _EnterOrderAppendage {
  UINT8 optional_field_length { optional_field_length >= 1 };                                                                                                                                                  // byte 0
  UINT8 enter_order_optional_field;                                                                                                                                                                            // byte 1
  EnterOrderOptionalValue(enter_order_optional_field, ((((UINT32) optional_field_length) + 1) - 2)) enter_order_optional_value[:byte-size-single-element-array ((((UINT32) optional_field_length) + 1) - 2)];
} EnterOrderAppendage;

// Enter Order Message
typedef struct _EnterOrderMessage {
  UINT32BE user_ref_num;                                                              // bytes 0 to 3
  UINT32BE order_qty;                                                                 // bytes 4 to 7
  UINT64BE price;                                                                     // bytes 8 to 15
  UINT8 side;                                                                         // byte 16
  UINT8 symbol[10];                                                                   // bytes 17 to 26
  UINT8 time_in_force;                                                                // byte 27
  UINT8 ex_destination;                                                               // byte 28
  UINT8 umir_account_type[2];                                                         // bytes 29 to 30
  UINT8 umir_user_id[8];                                                              // bytes 31 to 38
  UINT16BE appendage_length;                                                          // bytes 39 to 40
  EnterOrderAppendage enter_order_appendage[:byte-size ((UINT32) appendage_length)];
} EnterOrderMessage;

