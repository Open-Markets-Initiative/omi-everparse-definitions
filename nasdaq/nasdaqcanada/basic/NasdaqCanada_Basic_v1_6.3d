// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NasdaqCanada_Basic_v1_6.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_QUOTATION_MESSAGE 0x43                 // Quotation Message
#define MESSAGE_TYPE_TRADE_REPORT_MESSAGE 0x54              // Trade Report Message
#define MESSAGE_TYPE_TRADE_BREAK_MESSAGE 0x58               // Trade Break Message
#define MESSAGE_TYPE_TRADE_CORRECTION_MESSAGE 0x5A          // Trade Correction Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53              // System Event Message
#define MESSAGE_TYPE_STOCK_DIRECTORY_MESSAGE 0x52           // Stock Directory Message
#define MESSAGE_TYPE_STOCK_STATUS_MESSAGE 0x48              // Stock Status Message
#define MESSAGE_TYPE_END_OF_DAY_TRADE_SUMMARY_MESSAGE 0x44  // End Of Day Trade Summary Message
#define MESSAGE_TYPE_ADJUSTED_CLOSING_PRICE_MESSAGE 0x47    // Adjusted Closing Price Message

// Originating Market Center Identifier: one byte code
#define ORIGINATING_MARKET_CENTER_IDENTIFIER_THE_NASDAQ_CXC_TRADING_BOOK 0x43   // The Nasdaq Cxc Trading Book
#define ORIGINATING_MARKET_CENTER_IDENTIFIER_THE_NASDAQ_CX_2_TRADING_BOOK 0x58  // The Nasdaq Cx 2 Trading Book
#define ORIGINATING_MARKET_CENTER_IDENTIFIER_THE_NASDAQ_CXD_TRADING_BOOK 0x44   // The Nasdaq Cxd Trading Book
#define ORIGINATING_MARKET_CENTER_IDENTIFIER_ALL_MARKETS 0x41                   // All Markets

// Sale Condition Modifier Level 1: one byte code
#define SALE_CONDITION_MODIFIER_LEVEL_1_REGULAR_TRADE 0x20    // Regular Trade
#define SALE_CONDITION_MODIFIER_LEVEL_1_BYPASS 0x42           // Bypass
#define SALE_CONDITION_MODIFIER_LEVEL_1_M_ELO 0x4C            // M Elo
#define SALE_CONDITION_MODIFIER_LEVEL_1_CXD_PURE_STREAM 0x50  // Cxd Pure Stream

// Sales Condition Modifier Level 2: one byte code
#define SALES_CONDITION_MODIFIER_LEVEL_2_REGULAR 0x20             // Regular
#define SALES_CONDITION_MODIFIER_LEVEL_2_INTERNAL 0x49            // Internal
#define SALES_CONDITION_MODIFIER_LEVEL_2_BASIS 0x42               // Basis
#define SALES_CONDITION_MODIFIER_LEVEL_2_CONTINGENT 0x43          // Contingent
#define SALES_CONDITION_MODIFIER_LEVEL_2_VWAP 0x56                // Vwap
#define SALES_CONDITION_MODIFIER_LEVEL_2_INTENTIONAL 0x58         // Intentional
#define SALES_CONDITION_MODIFIER_LEVEL_2_DERIVATIVE_RELATED 0x44  // Derivative Related

// Sales Condition Modifier Level 3: one byte code
#define SALES_CONDITION_MODIFIER_LEVEL_3_REGULAR 0x20           // Regular
#define SALES_CONDITION_MODIFIER_LEVEL_3_CASH_TODAY 0x54        // Cash Today
#define SALES_CONDITION_MODIFIER_LEVEL_3_CASH_TOMORROW 0x43     // Cash Tomorrow
#define SALES_CONDITION_MODIFIER_LEVEL_3_DELAYED_DELIVERY 0x44  // Delayed Delivery

// Sales Condition Modifier Level 4: one byte code
#define SALES_CONDITION_MODIFIER_LEVEL_4_ODD_LOT 0x41              // Odd Lot
#define SALES_CONDITION_MODIFIER_LEVEL_4_BOARD_LOT_OR_LARGER 0x42  // Board Lot Or Larger

// Event Code: one byte code
#define EVENT_CODE_FIRST_MESSAGE_OF_THE_DAY 0x4F                          // First Message Of The Day
#define EVENT_CODE_START_OF_NASDAQ_CANADA_TRADING_SESSION 0x53            // Start Of Nasdaq Canada Trading Session
#define EVENT_CODE_START_OF_PRIMARY_MARKET_TRADING_ACTIVITY_SESSION 0x51  // Start Of Primary Market Trading Activity Session
#define EVENT_CODE_END_OF_PRIMARY_MARKET_TRADING_SESSION 0x4D             // End Of Primary Market Trading Session
#define EVENT_CODE_END_OF_NASDAQ_CANADA_TRADING_SESSION 0x45              // End Of Nasdaq Canada Trading Session
#define EVENT_CODE_END_OF_MESSAGES 0x43                                   // End Of Messages

// Listing Market: one byte code
#define LISTING_MARKET_THE_TMX_SENIOR_MARKET 0x54             // The Tmx Senior Market
#define LISTING_MARKET_THE_CANADIAN_SECURITIES_EXCHANGE 0x43  // The Canadian Securities Exchange
#define LISTING_MARKET_THE_TMX_VENTURE_MARKET 0x56            // The Tmx Venture Market
#define LISTING_MARKET_THE_NEO_EXCHANGE 0x4E                  // The Neo Exchange

// Currency: one byte code
#define CURRENCY_USD 0x55  // Usd
#define CURRENCY_CAD 0x43  // Cad

// Market: one byte code
#define MARKET_THE_NASDAQ_CXC_TRADING_BOOK 0x43   // The Nasdaq Cxc Trading Book
#define MARKET_THE_NASDAQ_CX_2_TRADING_BOOK 0x58  // The Nasdaq Cx 2 Trading Book
#define MARKET_THE_NASDAQ_CXD_TRADING_BOOK 0x44   // The Nasdaq Cxd Trading Book
#define MARKET_ALL_MARKETS 0x41                   // All Markets

// System Status: one byte code
#define SYSTEM_STATUS_HALTED 0x48   // Halted
#define SYSTEM_STATUS_TRADING 0x54  // Trading

// Security Class: one byte code
#define SECURITY_CLASS_THE_TMX_SENIOR_MARKET 0x54             // The Tmx Senior Market
#define SECURITY_CLASS_THE_CANADIAN_SECURITIES_EXCHANGE 0x43  // The Canadian Securities Exchange
#define SECURITY_CLASS_THE_TMX_VENTURE_MARKET 0x56            // The Tmx Venture Market
#define SECURITY_CLASS_THE_NEO_EXCHANGE 0x4E                  // The Neo Exchange

// ---- Types -------------------------------------------------------------------

// Combined Quotation Report of the Nasdaq Canada best bid and offer, with size attributed to the CXC and CX2 trading books.
typedef struct _QuotationMessage {
  UINT64BE time_stamp;                    // bytes 0 to 7
  UINT8 stock_symbol[10];                 // bytes 8 to 17
  UINT64BE nasdaq_canada_best_bid_price;  // bytes 18 to 25
  UINT32BE nasdaq_canada_best_bid_size;   // bytes 26 to 29
  UINT32BE nasdaq_cxc_best_bid_size;      // bytes 30 to 33
  UINT32BE nasdaq_cx_2_best_bid_size;     // bytes 34 to 37
  UINT64BE nasdaq_canada_best_ask_price;  // bytes 38 to 45
  UINT32BE nasdaq_canada_best_ask_size;   // bytes 46 to 49
  UINT32BE nasdaq_cxc_best_ask_size;      // bytes 50 to 53
  UINT32BE nasdaq_cx_2_best_ask_size;     // bytes 54 to 57
} QuotationMessage;

// Sale condition modifier consists of four levels
typedef struct _SaleConditionModifier {
  UINT8 sale_condition_modifier_level_1;   // byte 0
  UINT8 sales_condition_modifier_level_2;  // byte 1
  UINT8 sales_condition_modifier_level_3;  // byte 2
  UINT8 sales_condition_modifier_level_4;  // byte 3
} SaleConditionModifier;

// Relays all transactions available from or reported by the three Nasdaq Canada Trading Books for the current business day.
typedef struct _TradeReportMessage {
  UINT64BE time_stamp;                            // bytes 0 to 7
  UINT8 originating_market_center_identifier;     // byte 8
  UINT8 stock_symbol[10];                         // bytes 9 to 18
  UINT32BE trade_number;                          // bytes 19 to 22
  UINT64BE trade_price;                           // bytes 23 to 30
  UINT32BE trade_size;                            // bytes 31 to 34
  UINT8 broker[3];                                // bytes 35 to 37
  UINT8 contra_broker[3];                         // bytes 38 to 40
  SaleConditionModifier sale_condition_modifier;  // bytes 41 to 44
  UINT64BE consolidated_trade_volume;             // bytes 45 to 52
} TradeReportMessage;

// Sent if a Trade is cancelled during the same day as its execution.
typedef struct _TradeBreakMessage {
  UINT64BE time_stamp;                         // bytes 0 to 7
  UINT32BE trade_control_number;               // bytes 8 to 11
  UINT8 originating_market_center_identifier;  // byte 12
} TradeBreakMessage;

// Sent if a Trade is corrected during the same day as its execution.
typedef struct _TradeCorrectionMessage {
  UINT64BE time_stamp;                         // bytes 0 to 7
  UINT8 originating_market_center_identifier;  // byte 8
  UINT8 stock_symbol[10];                      // bytes 9 to 18
  UINT32BE original_trade_number;              // bytes 19 to 22
  UINT64BE original_trade_price;               // bytes 23 to 30
  UINT32BE original_trade_size;                // bytes 31 to 34
  UINT64BE corrected_trade_price;              // bytes 35 to 42
  UINT32BE corrected_trade_size;               // bytes 43 to 46
} TradeCorrectionMessage;

// Issued to indicate a market state event.
typedef struct _SystemEventMessage {
  UINT64BE time_stamp;                         // bytes 0 to 7
  UINT8 originating_market_center_identifier;  // byte 8
  UINT8 event_code;                            // byte 9
} SystemEventMessage;

// Disseminated at the start of each trading day for all active symbols in the Nasdaq Execution system.
typedef struct _StockDirectoryMessage {
  UINT64BE time_stamp;           // bytes 0 to 7
  UINT8 stock_symbol[10];        // bytes 8 to 17
  UINT8 stock_display_name[40];  // bytes 18 to 57
  UINT8 listing_market;          // byte 58
  UINT8 board_lot_size[4];       // bytes 59 to 62
  UINT8 currency;                // byte 63
} StockDirectoryMessage;

// Indicates the current trading status of a stock.
typedef struct _StockStatusMessage {
  UINT64BE time_stamp;     // bytes 0 to 7
  UINT8 stock_symbol[10];  // bytes 8 to 17
  UINT8 market;            // byte 18
  UINT8 system_status;     // byte 19
} StockStatusMessage;

// Published once at 4:15PM and again at 5:15PM, including all traded symbols from the day.
typedef struct _EndOfDayTradeSummaryMessage {
  UINT64BE time_stamp;                  // bytes 0 to 7
  UINT8 stock_symbol[10];               // bytes 8 to 17
  UINT64BE consolidated_high_price;     // bytes 18 to 25
  UINT64BE consolidated_low_price;      // bytes 26 to 33
  UINT64BE consolidated_open_price;     // bytes 34 to 41
  UINT64BE listing_center_open_price;   // bytes 42 to 49
  UINT64BE consolidated_close_price;    // bytes 50 to 57
  UINT64BE listing_center_close_price;  // bytes 58 to 65
  UINT64BE consolidated_volume;         // bytes 66 to 73
} EndOfDayTradeSummaryMessage;

// Previous Day Adjusted Close Price, sent at 7:00AM to reflect any adjustments made overnight.
typedef struct _AdjustedClosingPriceMessage {
  UINT64BE time_stamp;              // bytes 0 to 7
  UINT8 issue_symbol[10];           // bytes 8 to 17
  UINT8 security_class;             // byte 18
  UINT64BE adjusted_closing_price;  // bytes 19 to 26
} AdjustedClosingPriceMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x43: QuotationMessage quotation_message;
    case 0x54: TradeReportMessage trade_report_message;
    case 0x58: TradeBreakMessage trade_break_message;
    case 0x5A: TradeCorrectionMessage trade_correction_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x52: StockDirectoryMessage stock_directory_message;
    case 0x48: StockStatusMessage stock_status_message;
    case 0x44: EndOfDayTradeSummaryMessage end_of_day_trade_summary_message;
    case 0x47: AdjustedClosingPriceMessage adjusted_closing_price_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

