// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerFrame, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NasdaqCanada_Chixmd_v3_4_1_23_Server.3d
//
// What this definition reads more loosely than the model states:
// - the stream is a run of frames each ending at a byte 10: the caller splits it there and validates each frame, that byte included

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_INVALID_USERNAME_OR_PASSWORD 0x41  // Invalid Username Or Password
#define REJECT_REASON_CODE_INVALID_SESSION 0x53               // Invalid Session

// Message Type: one byte code
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x41                  // Add Order Message
#define MESSAGE_TYPE_LONG_FORM_ADD_ORDER_MESSAGE 0x61        // Long Form Add Order Message
#define MESSAGE_TYPE_ORDER_EXECUTION_MESSAGE 0x45            // Order Execution Message
#define MESSAGE_TYPE_LONG_FORM_ORDER_EXECUTION_MESSAGE 0x65  // Long Form Order Execution Message
#define MESSAGE_TYPE_ORDER_CANCEL_MESSAGE 0x58               // Order Cancel Message
#define MESSAGE_TYPE_LONG_FORM_ORDER_CANCEL_MESSAGE 0x78     // Long Form Order Cancel Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x50                      // Trade Message
#define MESSAGE_TYPE_LONG_FORM_TRADE_MESSAGE 0x70            // Long Form Trade Message
#define MESSAGE_TYPE_BROKEN_TRADE_MESSAGE 0x42               // Broken Trade Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53               // System Event Message
#define MESSAGE_TYPE_STOCK_STATUS_MESSAGE 0x48               // Stock Status Message

// Buy Sell Indicator: one byte code
#define BUY_SELL_INDICATOR_BUY 0x42   // Buy
#define BUY_SELL_INDICATOR_SELL 0x53  // Sell

// Trade Attribute: one byte code
#define TRADE_ATTRIBUTE_BYPASS 0x42                              // Bypass
#define TRADE_ATTRIBUTE_MARKET_ON_CLOSE_OR_CXD_CONDITIONAL 0x43  // Market On Close Or Cxd Conditional
#define TRADE_ATTRIBUTE_M_ELO 0x4C                               // M Elo
#define TRADE_ATTRIBUTE_CXD_PURE_STREAM 0x50                     // Cxd Pure Stream

// Cross Type: one byte code
#define CROSS_TYPE_INTERNAL 0x49            // Internal
#define CROSS_TYPE_BASIS 0x42               // Basis
#define CROSS_TYPE_CONTINGENT 0x43          // Contingent
#define CROSS_TYPE_VWAP 0x56                // Vwap
#define CROSS_TYPE_INTENTIONAL_CROSS 0x58   // Intentional Cross
#define CROSS_TYPE_DERIVATIVE_RELATED 0x44  // Derivative Related
#define CROSS_TYPE_NET_ASSET_VALUE 0x4E     // Net Asset Value

// Settlement Terms: one byte code
#define SETTLEMENT_TERMS_CASH_TODAY 0x54        // Cash Today
#define SETTLEMENT_TERMS_DELAYED_DELIVERY 0x44  // Delayed Delivery

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F                        // Start Of Messages
#define EVENT_CODE_START_OF_NASDAQ_CANADA_TRADING_SESSION 0x53   // Start Of Nasdaq Canada Trading Session
#define EVENT_CODE_START_OF_PRIMARY_MARKET_TRADING_SESSION 0x51  // Start Of Primary Market Trading Session
#define EVENT_CODE_END_OF_PRIMARY_MARKET_TRADING_SESSION 0x4D    // End Of Primary Market Trading Session
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45                      // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                          // End Of Messages
#define EVENT_CODE_MARKET_WIDE_CIRCUIT_BREAKER_HALT 0x57         // Market Wide Circuit Breaker Halt
#define EVENT_CODE_MARKET_WIDE_CIRCUIT_BREAKER_RESUMPTION 0x52   // Market Wide Circuit Breaker Resumption

// Trading State: one byte code
#define TRADING_STATE_HALTED 0x48   // Halted
#define TRADING_STATE_TRADING 0x54  // Trading

// Listing Market: one byte code
#define LISTING_MARKET_TSX 0x54          // Tsx
#define LISTING_MARKET_TSX_VENTURE 0x56  // Tsx Venture
#define LISTING_MARKET_CSE 0x43          // Cse
#define LISTING_MARKET_NEO 0x4E          // Neo

// Gef Eligible: one byte code
#define GEF_ELIGIBLE_GEF_ELIGIBLE 0x59      // Gef Eligible
#define GEF_ELIGIBLE_NOT_GEF_ELIGIBLE 0x4E  // Not Gef Eligible

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems.
typedef struct _DebugPacket (UINT32 available) where (available >= 1) {
  UINT8 text[(available - 1)];
} DebugPacket;

// The SoupTcp server sends a Login Accepted Packet in response to receiving a valid Login Request from the client.
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[10];  // bytes 10 to 19
  UINT8 comma;                         // byte 20
  UINT8 messages_total[10];            // bytes 21 to 30
} LoginAcceptedPacket;

// The SoupTcp server sends this packet in response to an invalid Login Request Packet from the client.
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// An Add Order Message indicates that CXC or CX2 has accepted a visible order into the book. It includes a day-unique Order Reference key assigned to the order. The issuing of an Add Order Message is not necessarily always for a new order (see Modification of Existing Orders). Not applicable to CXD.
typedef struct _AddOrderMessage {
  UINT8 order_reference[9];  // bytes 0 to 8
  UINT8 buy_sell_indicator;  // byte 9
  UINT8 shares[6];           // bytes 10 to 15
  UINT8 stock[10];           // bytes 16 to 25
  UINT8 price[10];           // bytes 26 to 35
  UINT8 broker[3];           // bytes 36 to 38
} AddOrderMessage;

// An Add Order Message indicates that CXC or CX2 has accepted a visible order into the book. It includes a day-unique Order Reference key assigned to the order. The issuing of an Add Order Message is not necessarily always for a new order (see Modification of Existing Orders). Not applicable to CXD. Long form messages are used when either the price or size is larger than the standard messages can permit.
typedef struct _LongFormAddOrderMessage {
  UINT8 order_reference[9];  // bytes 0 to 8
  UINT8 buy_sell_indicator;  // byte 9
  UINT8 long_shares[10];     // bytes 10 to 19
  UINT8 stock[10];           // bytes 20 to 29
  UINT8 long_price[19];      // bytes 30 to 48
  UINT8 broker[3];           // bytes 49 to 51
} LongFormAddOrderMessage;

// An Order Execution Message is sent whenever an order on the book is executed in whole or in part. Not applicable to CXD.
typedef struct _OrderExecutionMessage {
  UINT8 order_reference[9];         // bytes 0 to 8
  UINT8 executed_shares[6];         // bytes 9 to 14
  UINT8 trade_reference[9];         // bytes 15 to 23
  UINT8 contra_order_reference[9];  // bytes 24 to 32
  UINT8 trade_attribute;            // byte 33
  UINT8 broker[3];                  // bytes 34 to 36
  UINT8 contra_broker[3];           // bytes 37 to 39
} OrderExecutionMessage;

// An Order Execution Message is sent whenever an order on the book is executed in whole or in part. Not applicable to CXD. Long form messages are used when either the price or size is larger than the standard messages can permit.
typedef struct _LongFormOrderExecutionMessage {
  UINT8 order_reference[9];         // bytes 0 to 8
  UINT8 long_executed_shares[10];   // bytes 9 to 18
  UINT8 trade_reference[9];         // bytes 19 to 27
  UINT8 contra_order_reference[9];  // bytes 28 to 36
  UINT8 trade_attribute;            // byte 37
  UINT8 broker[3];                  // bytes 38 to 40
  UINT8 contra_broker[3];           // bytes 41 to 43
} LongFormOrderExecutionMessage;

// An Order Cancel Message is sent whenever an order on the book is fully canceled, its quantity revised down or when a pegged order is re-priced. Not applicable to CXD.
typedef struct _OrderCancelMessage {
  UINT8 order_reference[9];  // bytes 0 to 8
  UINT8 canceled_shares[6];  // bytes 9 to 14
} OrderCancelMessage;

// An Order Cancel Message is sent whenever an order on the book is fully canceled, its quantity revised down or when a pegged order is re-priced. Not applicable to CXD. Long form messages are used when either the price or size is larger than the standard messages can permit.
typedef struct _LongFormOrderCancelMessage {
  UINT8 order_reference[9];        // bytes 0 to 8
  UINT8 long_canceled_shares[10];  // bytes 9 to 18
} LongFormOrderCancelMessage;

// A Trade Message is sent when a trade occurs against order quantity not visible on the book (i.e. a fully or partially hidden order). They do not affect the book. The Order Reference is always 0 and the Buy/Sell indicator B.
typedef struct _TradeMessage {
  UINT8 order_reference[9];         // bytes 0 to 8
  UINT8 buy_sell_indicator;         // byte 9
  UINT8 shares[6];                  // bytes 10 to 15
  UINT8 stock[10];                  // bytes 16 to 25
  UINT8 price[10];                  // bytes 26 to 35
  UINT8 trade_reference[9];         // bytes 36 to 44
  UINT8 contra_order_reference[9];  // bytes 45 to 53
  UINT8 broker[3];                  // bytes 54 to 56
  UINT8 contra_broker[3];           // bytes 57 to 59
  UINT8 trade_attribute;            // byte 60
  UINT8 cross_type;                 // byte 61
  UINT8 settlement_terms;           // byte 62
} TradeMessage;

// A Trade Message is sent when a trade occurs against order quantity not visible on the book (i.e. a fully or partially hidden order). They do not affect the book. The Order Reference is always 0 and the Buy/Sell indicator B. Long form messages are used when either the price or size is larger than the standard messages can permit.
typedef struct _LongFormTradeMessage {
  UINT8 order_reference[9];         // bytes 0 to 8
  UINT8 buy_sell_indicator;         // byte 9
  UINT8 long_shares[10];            // bytes 10 to 19
  UINT8 stock[10];                  // bytes 20 to 29
  UINT8 long_price[19];             // bytes 30 to 48
  UINT8 trade_reference[9];         // bytes 49 to 57
  UINT8 contra_order_reference[9];  // bytes 58 to 66
  UINT8 broker[3];                  // bytes 67 to 69
  UINT8 contra_broker[3];           // bytes 70 to 72
  UINT8 trade_attribute;            // byte 73
  UINT8 cross_type;                 // byte 74
  UINT8 settlement_terms;           // byte 75
} LongFormTradeMessage;

// A Broken Trade message is sent whenever an execution is broken. A Broken Trade is final; once a trade is broken it cannot be reinstated.
typedef struct _BrokenTradeMessage {
  UINT8 trade_reference[9];  // bytes 0 to 8
} BrokenTradeMessage;

// The system event message type is used to indicate a market state event.
typedef struct _SystemEventMessage {
  UINT8 event_code;  // byte 0
} SystemEventMessage;

// This message indicates the current trading status of a stock. At the start of day, the feed will send out a stock status message for each of the symbols trading on CXC, CX2 and CXD. Subsequently, stock status messages will be sent when a stock is halted or is released for trading.
typedef struct _StockStatusMessage {
  UINT8 stock[10];          // bytes 0 to 9
  UINT8 trading_state;      // byte 10
  UINT8 reserved_1;         // byte 11
  UINT8 listing_market;     // byte 12
  UINT8 board_lot_size[4];  // bytes 13 to 16
  UINT8 currency[3];        // bytes 17 to 19
  UINT8 gef_eligible;       // byte 20
} StockStatusMessage;

// Branch
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: AddOrderMessage add_order_message;
    case 0x61: LongFormAddOrderMessage long_form_add_order_message;
    case 0x45: OrderExecutionMessage order_execution_message;
    case 0x65: LongFormOrderExecutionMessage long_form_order_execution_message;
    case 0x58: OrderCancelMessage order_cancel_message;
    case 0x78: LongFormOrderCancelMessage long_form_order_cancel_message;
    case 0x50: TradeMessage trade_message;
    case 0x70: LongFormTradeMessage long_form_trade_message;
    case 0x42: BrokenTradeMessage broken_trade_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x48: StockStatusMessage stock_status_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol.
typedef struct _SequencedDataPacket (UINT32 available) where (available >= 9) {
  UINT8 timestamp[8];                                                                                                  // bytes 0 to 7
  UINT8 message_type;                                                                                                  // byte 8
  SequencedMessage(message_type, (available - 9)) sequenced_message[:byte-size-single-element-array (available - 9)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(available) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(available) sequenced_data_packet;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// ---- Packet: ServerFrame -----------------------------------------------------

// SoupTcp Lf terminated packet sent by the server
entrypoint typedef struct _ServerFrame (UINT32 available) where (available >= 2) {
  UINT8 server_packet_type;                                                                                            // byte 0
  ServerPayload(server_packet_type, (available - 2)) server_payload[:byte-size-single-element-array (available - 2)];
  UINT8 soup_lf { soup_lf == 10 };
} ServerFrame;

