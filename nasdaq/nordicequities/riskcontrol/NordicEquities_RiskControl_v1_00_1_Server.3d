// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NordicEquities_RiskControl_v1_00_1_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_ACCOUNT_QUERY_RESPONSE_MESSAGE 0x51               // Account Query Response Message
#define SEQUENCED_MESSAGE_TYPE_ACCOUNT_SETTINGS_RESPONSE_MESSAGE 0x43            // Account Settings Response Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_BOOK_RESTRICTION_RESPONSE_MESSAGE 0x52      // Order Book Restriction Response Message
#define SEQUENCED_MESSAGE_TYPE_MARKET_SEGMENT_RESTRICTION_RESPONSE_MESSAGE 0x53  // Market Segment Restriction Response Message
#define SEQUENCED_MESSAGE_TYPE_LIMIT_SETTINGS_RESPONSE_MESSAGE 0x4C              // Limit Settings Response Message
#define SEQUENCED_MESSAGE_TYPE_ACCOUNT_CURRENCY_SETTING_RESPONSE_MESSAGE 0x46    // Account Currency Setting Response Message
#define SEQUENCED_MESSAGE_TYPE_REJECT_MESSAGE 0x4A                               // Reject Message
#define SEQUENCED_MESSAGE_TYPE_API_PORT_RATE_BREACH_MESSAGE 0x50                 // Api Port Rate Breach Message
#define SEQUENCED_MESSAGE_TYPE_ACCOUNT_RATE_BREACH_MESSAGE 0x42                  // Account Rate Breach Message
#define SEQUENCED_MESSAGE_TYPE_ACCUMULATED_VALUES_MESSAGE 0x56                   // Accumulated Values Message

// Trigger Restrict Symbol On Repeated Order Generation: one byte code
#define TRIGGER_RESTRICT_SYMBOL_ON_REPEATED_ORDER_GENERATION_ENABLED 0x59              // Enabled
#define TRIGGER_RESTRICT_SYMBOL_ON_REPEATED_ORDER_GENERATION_DISABLED 0x4E             // Disabled
#define TRIGGER_RESTRICT_SYMBOL_ON_REPEATED_ORDER_GENERATION_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// In Auction Market Order Prevention: one byte code
#define IN_AUCTION_MARKET_ORDER_PREVENTION_ENABLED 0x59              // Enabled
#define IN_AUCTION_MARKET_ORDER_PREVENTION_DISABLED 0x4E             // Disabled
#define IN_AUCTION_MARKET_ORDER_PREVENTION_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// In Auction Fat Finger Protection: one byte code
#define IN_AUCTION_FAT_FINGER_PROTECTION_ENABLED 0x59              // Enabled
#define IN_AUCTION_FAT_FINGER_PROTECTION_DISABLED 0x4E             // Disabled
#define IN_AUCTION_FAT_FINGER_PROTECTION_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// In Auction Market Order Protection: one byte code
#define IN_AUCTION_MARKET_ORDER_PROTECTION_ENABLED 0x59              // Enabled
#define IN_AUCTION_MARKET_ORDER_PROTECTION_DISABLED 0x4E             // Disabled
#define IN_AUCTION_MARKET_ORDER_PROTECTION_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// Block And Cancel: one byte code
#define BLOCK_AND_CANCEL_BLOCK 0x42                // Block
#define BLOCK_AND_CANCEL_UNBLOCK 0x55              // Unblock
#define BLOCK_AND_CANCEL_BLOCK_AND_CANCEL 0x43     // Block And Cancel
#define BLOCK_AND_CANCEL_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// State: one byte code
#define STATE_ACTIVE 0x41               // Active
#define STATE_INACTIVE 0x49             // Inactive
#define STATE_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// Reject All Flag: one byte code
#define REJECT_ALL_FLAG_ENABLED 0x59              // Enabled
#define REJECT_ALL_FLAG_DISABLED 0x4E             // Disabled
#define REJECT_ALL_FLAG_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// Blow Through Protection: one byte code
#define BLOW_THROUGH_PROTECTION_ENABLED 0x59              // Enabled
#define BLOW_THROUGH_PROTECTION_DISABLED 0x4E             // Disabled
#define BLOW_THROUGH_PROTECTION_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// Reason: one byte code
#define REASON_INVALID_CURRENCY 0x43     // Invalid Currency
#define REASON_INVALID_PRM_ACCOUNT 0x41  // Invalid Prm Account
#define REASON_NO_SETTING_PRESENT 0x4E   // No Setting Present
#define REASON_UNAUTHORIZED 0x55         // Unauthorized

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// Provides the PRM API port's next expected user reference number
typedef struct _AccountQueryResponseMessage {
  UINT32BE user_ref_num;  // bytes 0 to 3
} AccountQueryResponseMessage;

// Indicates that the settings for a given PRM Account have been updated
typedef struct _AccountSettingsResponseMessage {
  UINT32BE user_ref_num;                                       // bytes 0 to 3
  UINT8 prm_account[6];                                        // bytes 4 to 9
  UINT32BE repeated_order_generation;                          // bytes 10 to 13, signed, read here as unsigned
  UINT8 trigger_restrict_symbol_on_repeated_order_generation;  // byte 14
  UINT8 in_auction_market_order_prevention;                    // byte 15
  UINT8 in_auction_fat_finger_protection;                      // byte 16
  UINT8 in_auction_market_order_protection;                    // byte 17
  UINT8 block_and_cancel;                                      // byte 18
} AccountSettingsResponseMessage;

// Indicates that an Order Book has been restricted or non-restricted for a given PRM Account
typedef struct _OrderBookRestrictionResponseMessage {
  UINT32BE user_ref_num;  // bytes 0 to 3
  UINT64BE timestamp;     // bytes 4 to 11
  UINT8 prm_account[6];   // bytes 12 to 17
  UINT32BE order_book;    // bytes 18 to 21
  UINT8 state;            // byte 22
} OrderBookRestrictionResponseMessage;

// Indicates that a Market Segment has been restricted or non-restricted for a given PRM Account
typedef struct _MarketSegmentRestrictionResponseMessage {
  UINT32BE user_ref_num;    // bytes 0 to 3
  UINT64BE timestamp;       // bytes 4 to 11
  UINT8 prm_account[6];     // bytes 12 to 17
  UINT16BE market_segment;  // bytes 18 to 19
  UINT8 state;              // byte 20
} MarketSegmentRestrictionResponseMessage;

// Indicates that the Limit settings for a given PRM Account and Currency have been updated
typedef struct _LimitSettingsResponseMessage {
  UINT32BE user_ref_num;           // bytes 0 to 3
  UINT8 prm_account[6];            // bytes 4 to 9
  UINT8 currency[3];               // bytes 10 to 12
  UINT64BE max_quantity;           // bytes 13 to 20, signed, read here as unsigned
  UINT64BE max_value;              // bytes 21 to 28, signed, read here as unsigned
  UINT64BE unused;                 // bytes 29 to 36
  UINT64BE total_risk_value;       // bytes 37 to 44, signed, read here as unsigned
  UINT64BE trade_buy_value;        // bytes 45 to 52, signed, read here as unsigned
  UINT64BE trade_sell_value;       // bytes 53 to 60, signed, read here as unsigned
  UINT64BE trade_net_value;        // bytes 61 to 68, signed, read here as unsigned
  UINT64BE open_order_buy_value;   // bytes 69 to 76, signed, read here as unsigned
  UINT64BE open_order_sell_value;  // bytes 77 to 84, signed, read here as unsigned
  UINT64BE open_order_net_value;   // bytes 85 to 92, signed, read here as unsigned
  UINT64BE max_quantity_auction;   // bytes 93 to 100, signed, read here as unsigned
  UINT64BE max_value_auction;      // bytes 101 to 108, signed, read here as unsigned
} LimitSettingsResponseMessage;

// Indicates that the settings for a given PRM Account's currency have been updated
typedef struct _AccountCurrencySettingResponseMessage {
  UINT32BE user_ref_num;          // bytes 0 to 3
  UINT8 prm_account[6];           // bytes 4 to 9
  UINT8 currency[3];              // bytes 10 to 12
  UINT8 reject_all_flag;          // byte 13
  UINT8 blow_through_protection;  // byte 14
} AccountCurrencySettingResponseMessage;

// Indicates that an inbound message has been rejected
typedef struct _RejectMessage {
  UINT32BE user_ref_num;  // bytes 0 to 3
  UINT8 reason;           // byte 4
} RejectMessage;

// Indicates that the port's rate limit has been breached
typedef struct _ApiPortRateBreachMessage {
  UINT64BE timestamp;  // bytes 0 to 7
} ApiPortRateBreachMessage;

// Indicates that a PRM Account's rate limit has been breached
typedef struct _AccountRateBreachMessage {
  UINT64BE timestamp;    // bytes 0 to 7
  UINT8 state;           // byte 8
  UINT8 prm_account[6];  // bytes 9 to 14
} AccountRateBreachMessage;

// Indicates the current Accumulated Values for a PRM Account and Currency, sent after order or trade updates
typedef struct _AccumulatedValuesMessage {
  UINT8 prm_account[6];         // bytes 0 to 5
  UINT8 currency[3];            // bytes 6 to 8
  UINT64BE last_update_time;    // bytes 9 to 16
  UINT64BE risk_total_value;    // bytes 17 to 24
  UINT64BE trades_buy_value;    // bytes 25 to 32
  UINT64BE trades_sell_value;   // bytes 33 to 40
  UINT64BE trades_total_value;  // bytes 41 to 48
  UINT64BE orders_buy_value;    // bytes 49 to 56
  UINT64BE orders_sell_value;   // bytes 57 to 64
  UINT64BE orders_total_value;  // bytes 65 to 72
} AccumulatedValuesMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x51: AccountQueryResponseMessage account_query_response_message;
    case 0x43: AccountSettingsResponseMessage account_settings_response_message;
    case 0x52: OrderBookRestrictionResponseMessage order_book_restriction_response_message;
    case 0x53: MarketSegmentRestrictionResponseMessage market_segment_restriction_response_message;
    case 0x4C: LimitSettingsResponseMessage limit_settings_response_message;
    case 0x46: AccountCurrencySettingResponseMessage account_currency_setting_response_message;
    case 0x4A: RejectMessage reject_message;
    case 0x50: ApiPortRateBreachMessage api_port_rate_breach_message;
    case 0x42: AccountRateBreachMessage account_rate_breach_message;
    case 0x56: AccumulatedValuesMessage accumulated_values_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat;
    case 0x5A: unit end_of_session;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

