// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NordicEquities_RiskControl_v1_00_1_Client.3d

// ---- Values ------------------------------------------------------------------

// Client Packet Type: one byte code
#define CLIENT_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define CLIENT_PACKET_TYPE_LOGIN_REQUEST_PACKET 0x4C     // Login Request Packet
#define CLIENT_PACKET_TYPE_UNSEQUENCED_DATA_PACKET 0x55  // Unsequenced Data Packet
#define CLIENT_PACKET_TYPE_CLIENT_HEARTBEAT_PACKET 0x52  // Client Heartbeat Packet
#define CLIENT_PACKET_TYPE_LOGOUT_REQUEST_PACKET 0x4F    // Logout Request Packet

// Unsequenced Message Type: one byte code
#define UNSEQUENCED_MESSAGE_TYPE_ACCOUNT_QUERY_MESSAGE 0x51                      // Account Query Message
#define UNSEQUENCED_MESSAGE_TYPE_MODIFY_ACCOUNT_SETTINGS_MESSAGE 0x43            // Modify Account Settings Message
#define UNSEQUENCED_MESSAGE_TYPE_MODIFY_ORDER_BOOK_RESTRICTION_MESSAGE 0x52      // Modify Order Book Restriction Message
#define UNSEQUENCED_MESSAGE_TYPE_MODIFY_MARKET_SEGMENT_RESTRICTION_MESSAGE 0x53  // Modify Market Segment Restriction Message
#define UNSEQUENCED_MESSAGE_TYPE_MODIFY_LIMIT_SETTINGS_MESSAGE 0x4C              // Modify Limit Settings Message
#define UNSEQUENCED_MESSAGE_TYPE_MODIFY_ACCOUNT_CURRENCY_SETTING_MESSAGE 0x46    // Modify Account Currency Setting Message

// Trigger Restrict Symbol On Repeated Order Generation: one byte code
#define TRIGGER_RESTRICT_SYMBOL_ON_REPEATED_ORDER_GENERATION_ENABLED 0x59              // Enabled
#define TRIGGER_RESTRICT_SYMBOL_ON_REPEATED_ORDER_GENERATION_DISABLED 0x4E             // Disabled
#define TRIGGER_RESTRICT_SYMBOL_ON_REPEATED_ORDER_GENERATION_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// In Auction Market Order Prevention: one byte code
#define IN_AUCTION_MARKET_ORDER_PREVENTION_ENABLED 0x59              // Enabled
#define IN_AUCTION_MARKET_ORDER_PREVENTION_DISABLED 0x4E             // Disabled
#define IN_AUCTION_MARKET_ORDER_PREVENTION_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// In Auction Fat Finger Protection: one byte code
#define IN_AUCTION_FAT_FINGER_PROTECTION_ENABLED 0x59              // Enabled
#define IN_AUCTION_FAT_FINGER_PROTECTION_DISABLED 0x4E             // Disabled
#define IN_AUCTION_FAT_FINGER_PROTECTION_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// In Auction Market Order Protection: one byte code
#define IN_AUCTION_MARKET_ORDER_PROTECTION_ENABLED 0x59              // Enabled
#define IN_AUCTION_MARKET_ORDER_PROTECTION_DISABLED 0x4E             // Disabled
#define IN_AUCTION_MARKET_ORDER_PROTECTION_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// Block And Cancel: one byte code
#define BLOCK_AND_CANCEL_BLOCK 0x42                // Block
#define BLOCK_AND_CANCEL_UNBLOCK 0x55              // Unblock
#define BLOCK_AND_CANCEL_BLOCK_AND_CANCEL 0x43     // Block And Cancel
#define BLOCK_AND_CANCEL_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// State: one byte code
#define STATE_ACTIVE 0x41               // Active
#define STATE_INACTIVE 0x49             // Inactive
#define STATE_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// Reject All Flag: one byte code
#define REJECT_ALL_FLAG_ENABLED 0x59              // Enabled
#define REJECT_ALL_FLAG_DISABLED 0x4E             // Disabled
#define REJECT_ALL_FLAG_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// Blow Through Protection: one byte code
#define BLOW_THROUGH_PROTECTION_ENABLED 0x59              // Enabled
#define BLOW_THROUGH_PROTECTION_DISABLED 0x4E             // Disabled
#define BLOW_THROUGH_PROTECTION_PREVIOUS_VALUE_KEPT 0x3F  // Previous Value Kept

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP client must send a Login Request Packet immediately upon establishing a new TCP/IP socket connection to the server
typedef struct _LoginRequestPacket {
  UINT8 username[6];                    // bytes 0 to 5
  UINT8 password[10];                   // bytes 6 to 15
  UINT8 requested_session[10];          // bytes 16 to 25
  UINT8 requested_sequence_number[20];  // bytes 26 to 45
} LoginRequestPacket;

// Updates the settings for a given PRM Account
typedef struct _ModifyAccountSettingsMessage {
  UINT32BE user_ref_num;                                       // bytes 0 to 3
  UINT8 prm_account[6];                                        // bytes 4 to 9
  UINT32BE repeated_order_generation;                          // bytes 10 to 13, signed, read here as unsigned
  UINT8 trigger_restrict_symbol_on_repeated_order_generation;  // byte 14
  UINT8 in_auction_market_order_prevention;                    // byte 15
  UINT8 in_auction_fat_finger_protection;                      // byte 16
  UINT8 in_auction_market_order_protection;                    // byte 17
  UINT8 block_and_cancel;                                      // byte 18
} ModifyAccountSettingsMessage;

// Marks an Order Book as restricted or non-restricted for a given PRM Account
typedef struct _ModifyOrderBookRestrictionMessage {
  UINT32BE user_ref_num;  // bytes 0 to 3
  UINT8 prm_account[6];   // bytes 4 to 9
  UINT32BE order_book;    // bytes 10 to 13
  UINT8 state;            // byte 14
} ModifyOrderBookRestrictionMessage;

// Marks a Market Segment as restricted or non-restricted for a given PRM Account
typedef struct _ModifyMarketSegmentRestrictionMessage {
  UINT32BE user_ref_num;    // bytes 0 to 3
  UINT8 prm_account[6];     // bytes 4 to 9
  UINT16BE market_segment;  // bytes 10 to 11
  UINT8 state;              // byte 12
} ModifyMarketSegmentRestrictionMessage;

// Updates the Limit settings for a given PRM Account and Currency
typedef struct _ModifyLimitSettingsMessage {
  UINT32BE user_ref_num;           // bytes 0 to 3
  UINT8 prm_account[6];            // bytes 4 to 9
  UINT8 currency[3];               // bytes 10 to 12
  UINT64BE max_quantity;           // bytes 13 to 20, signed, read here as unsigned
  UINT64BE max_value;              // bytes 21 to 28, signed, read here as unsigned
  UINT64BE unused;                 // bytes 29 to 36
  UINT64BE total_risk_value;       // bytes 37 to 44, signed, read here as unsigned
  UINT64BE trade_buy_value;        // bytes 45 to 52, signed, read here as unsigned
  UINT64BE trade_sell_value;       // bytes 53 to 60, signed, read here as unsigned
  UINT64BE trade_net_value;        // bytes 61 to 68, signed, read here as unsigned
  UINT64BE open_order_buy_value;   // bytes 69 to 76, signed, read here as unsigned
  UINT64BE open_order_sell_value;  // bytes 77 to 84, signed, read here as unsigned
  UINT64BE open_order_net_value;   // bytes 85 to 92, signed, read here as unsigned
  UINT64BE max_quantity_auction;   // bytes 93 to 100, signed, read here as unsigned
  UINT64BE max_value_auction;      // bytes 101 to 108, signed, read here as unsigned
} ModifyLimitSettingsMessage;

// Updates the settings for a given PRM Account's currency
typedef struct _ModifyAccountCurrencySettingMessage {
  UINT32BE user_ref_num;          // bytes 0 to 3
  UINT8 prm_account[6];           // bytes 4 to 9
  UINT8 currency[3];              // bytes 10 to 12
  UINT8 reject_all_flag;          // byte 13
  UINT8 blow_through_protection;  // byte 14
} ModifyAccountCurrencySettingMessage;

// The unsequenced (client to server) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _UnsequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x51: unit account_query_message;
    case 0x43: ModifyAccountSettingsMessage modify_account_settings_message;
    case 0x52: ModifyOrderBookRestrictionMessage modify_order_book_restriction_message;
    case 0x53: ModifyMarketSegmentRestrictionMessage modify_market_segment_restriction_message;
    case 0x4C: ModifyLimitSettingsMessage modify_limit_settings_message;
    case 0x46: ModifyAccountCurrencySettingMessage modify_account_currency_setting_message;
    default: UINT8 unknown[available];
  }
} UnsequencedMessage;

// The Unsequenced Data Packets act as an envelope to carry the actual data messages that are transferred from the client to the server
typedef struct _UnsequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 unsequenced_message_type;                                                                                                                                    // byte 0
  UnsequencedMessage(unsequenced_message_type, (((UINT32) packet_length) - 2)) unsequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} UnsequencedDataPacket;

// Branch
casetype _ClientPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x4C: LoginRequestPacket login_request_packet;
    case 0x55: UnsequencedDataPacket(packet_length) unsequenced_data_packet[:byte-size-single-element-array length];
    case 0x52: unit client_heartbeat;
    case 0x4F: unit logout_request;
    default: UINT8 unknown[available];
  }
} ClientPayload;

// Soup Bin Tcp Packet sent by the client
typedef struct _ClientSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 client_packet_type;                                                                                                                                                                                     // byte 2
  ClientPayload(client_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) client_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ClientSoupBinTcpPacket;

// ---- Packet: ClientPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the client
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientSoupBinTcpPacket client_soup_bin_tcp_packet[:byte-size available];
} ClientPacket;

