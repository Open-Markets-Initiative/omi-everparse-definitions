// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NordicEquities_TotalView_v3_00_1_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                // System Event Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_BOOK_TRADING_ACTION_MESSAGE 0x48   // Order Book Trading Action Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_BOOK_DIRECTORY_MESSAGE 0x52        // Order Book Directory Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x41                   // Add Order Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_MPID_ATTRIBUTION_MESSAGE 0x46  // Add Order Mpid Attribution Message
#define SEQUENCED_MESSAGE_TYPE_END_OF_SNAPSHOT_MESSAGE 0x47             // End Of Snapshot Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F  // Start Of Messages
#define EVENT_CODE_END_OF_MESSAGES 0x43    // End Of Messages

// Symbol State: one byte code
#define SYMBOL_STATE_CLOSED 0x43                      // Closed
#define SYMBOL_STATE_PRE_OPEN 0x50                    // Pre Open
#define SYMBOL_STATE_OPENING_AUCTION 0x4F             // Opening Auction
#define SYMBOL_STATE_CONTINUOUS_TRADING 0x54          // Continuous Trading
#define SYMBOL_STATE_SCHEDULED_INTRADAY_AUCTION 0x49  // Scheduled Intraday Auction
#define SYMBOL_STATE_CLOSING_AUCTION 0x4C             // Closing Auction
#define SYMBOL_STATE_POST_TRADE 0x53                  // Post Trade
#define SYMBOL_STATE_HALTED 0x48                      // Halted
#define SYMBOL_STATE_AUCTION_PERIOD 0x51              // Auction Period
#define SYMBOL_STATE_TRADING_AT_CLOSING_PRICE 0x41    // Trading At Closing Price

// Extension: one byte code
#define EXTENSION_CROSS_EXTENSION 0x45  // Cross Extension

// Financial Product: one byte code
#define FINANCIAL_PRODUCT_STOCK 0x01                   // Stock
#define FINANCIAL_PRODUCT_EQUITY_WARRANT 0x02          // Equity Warrant
#define FINANCIAL_PRODUCT_EQUITY_RIGHT 0x03            // Equity Right
#define FINANCIAL_PRODUCT_BOND 0x04                    // Bond
#define FINANCIAL_PRODUCT_LOTTERY_BOND_SERIES 0x06     // Lottery Bond Series
#define FINANCIAL_PRODUCT_CONVERTIBLE 0x07             // Convertible
#define FINANCIAL_PRODUCT_WARRANT 0x08                 // Warrant
#define FINANCIAL_PRODUCT_UNIT_TRUST_CERTIFICATE 0x0B  // Unit Trust Certificate
#define FINANCIAL_PRODUCT_INDEX_FUND_UNIT 0x0C         // Index Fund Unit

// Price Notation: one byte code
#define PRICE_NOTATION_MONETARY_VALUE 0x4D  // Monetary Value

// Buy Sell Indicator: one byte code
#define BUY_SELL_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define BUY_SELL_INDICATOR_SELL_ORDER 0x53  // Sell Order

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// Signals a market or data feed handler event
typedef struct _SystemEventMessage {
  UINT64BE timestamp;        // bytes 0 to 7
  UINT16BE tracking_number;  // bytes 8 to 9
  UINT8 event_code;          // byte 10
} SystemEventMessage;

// Indicates the current trading status of a security
typedef struct _OrderBookTradingActionMessage {
  UINT64BE timestamp;        // bytes 0 to 7
  UINT16BE tracking_number;  // bytes 8 to 9
  UINT32BE order_book;       // bytes 10 to 13
  UINT8 symbol_state;        // byte 14
  UINT8 extension;           // byte 15
  UINT8 reason[4];           // bytes 16 to 19
} OrderBookTradingActionMessage;

// Disseminated for all active order books at the start of each trading day
typedef struct _OrderBookDirectoryMessage {
  UINT64BE timestamp;                                                // bytes 0 to 7
  UINT16BE tracking_number;                                          // bytes 8 to 9
  UINT32BE order_book;                                               // bytes 10 to 13
  UINT8 symbol[16];                                                  // bytes 14 to 29
  UINT8 isin[12];                                                    // bytes 30 to 41
  UINT8 financial_product;                                           // byte 42
  UINT8 trading_currency[3];                                         // bytes 43 to 45
  UINT8 mic[4];                                                      // bytes 46 to 49
  UINT16BE market_segment_id;                                        // bytes 50 to 51
  UINT8 nm_new_market_company : 1;                                   // byte 52
  UINT8 xr_excluding_participating_in_rights : 1;                    // byte 52
  UINT8 sp_excluding_participating_in_split : 1;                     // byte 52
  UINT8 po_company_subject_to_public_offer : 1;                      // byte 52
  UINT8 ud_under_drawing : 1;                                        // byte 52
  UINT8 sr_excluding_comb_split_and_issue_rights : 1;                // byte 52
  UINT8 ul_un_listed : 1;                                            // byte 52
  UINT8 wi_when_issued : 1;                                          // byte 52
  UINT8 br_company_bankruptcy : 1;                                   // byte 53
  UINT8 su_suspension : 1;                                           // byte 53
  UINT8 rl_removal_from_listing_in_process : 1;                      // byte 53
  UINT8 sl_other_surveillance_list_reason : 1;                       // byte 53
  UINT8 to_a_significant_reverse_takeover_pending : 1;               // byte 53
  UINT8 cs_cent_shares : 1;                                          // byte 53
  UINT8 rs_reversed_split : 1;                                       // byte 53
  UINT8 bs_excluding_comb_bonus_split : 1;                           // byte 53
  UINT8 ss_excluding_comb_split_redemption_share : 1;                // byte 54
  UINT8 fn_first_north_company : 1;                                  // byte 54
  UINT8 ob_observation_status : 1;                                   // byte 54
  UINT8 xd_excluding_dividend : 1;                                   // byte 54
  UINT8 fe_foreign_non_eueea_entity : 1;                             // byte 54
  UINT8 so_sold_out_buy_back : 1;                                    // byte 54
  UINT8 sk_soft_knock : 1;                                           // byte 54
  UINT8 kb_knock_out_buy_back : 1;                                   // byte 54
  UINT8 bb_buy_back : 1;                                             // byte 55
  UINT8 reserved_23 : 2;                                             // byte 55
  UINT8 ce_capped_by_esma : 1;                                       // byte 55
  UINT8 reserved_5 : 1;                                              // byte 55
  UINT8 pd_price_discrepancy_historical_average_share_classes : 1;   // byte 55
  UINT8 sm_stressed_market : 1;                                      // byte 55
  UINT8 ew_market_wide_exceptional_circumstance : 1;                 // byte 55
  UINT8 em_exceptional_circumstances_related_to_market_maker : 1;    // byte 56
  UINT8 un_underlying_not_quoted : 1;                                // byte 56
  UINT8 da_digital_asset : 1;                                        // byte 56
  UINT8 kn_knock_out_buy_back_into_next_trading_day : 1;             // byte 56
  UINT8 reserved_58 : 4;                                             // byte 56
  UINT8 reserved_18 : 8;                                             // byte 57
  UINT8 reserved_18_2 : 8;                                           // byte 58
  UINT8 reserved_18_3 : 8;                                           // byte 59
  UINT32BE round_lot_size;                                           // bytes 60 to 63
  UINT8 nordic_mid_mic[4];                                           // bytes 64 to 67
  UINT8 aod_mic[4];                                                  // bytes 68 to 71
  UINT8 notation_of_qty[4];                                          // bytes 72 to 75
  UINT64BE notional_amount;                                          // bytes 76 to 83
  UINT8 currency[3];                                                 // bytes 84 to 86
  UINT8 price_notation;                                              // byte 87
  UINT64BE multiplier_for_calculating_quantity_in_measurement_unit;  // bytes 88 to 95
} OrderBookDirectoryMessage;

// An order added to the book without Mpid attribution
typedef struct _AddOrderMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT16BE tracking_number;         // bytes 8 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT8 buy_sell_indicator;         // byte 18
  UINT32BE quantity;                // bytes 19 to 22
  UINT32BE order_book;              // bytes 23 to 26
  UINT32BE price;                   // bytes 27 to 30
} AddOrderMessage;

// An order added to the book with Mpid attribution
typedef struct _AddOrderMpidAttributionMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT16BE tracking_number;         // bytes 8 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT8 buy_sell_indicator;         // byte 18
  UINT32BE quantity;                // bytes 19 to 22
  UINT32BE order_book;              // bytes 23 to 26
  UINT32BE price;                   // bytes 27 to 30
  UINT8 attribution[4];             // bytes 31 to 34
} AddOrderMpidAttributionMessage;

// Denotes the TotalView Itch sequence number to begin real time processing from
typedef struct _EndOfSnapshotMessage {
  UINT8 sequence_number[20];  // bytes 0 to 19
} EndOfSnapshotMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x48: OrderBookTradingActionMessage order_book_trading_action_message;
    case 0x52: OrderBookDirectoryMessage order_book_directory_message;
    case 0x41: AddOrderMessage add_order_message;
    case 0x46: AddOrderMpidAttributionMessage add_order_mpid_attribution_message;
    case 0x47: EndOfSnapshotMessage end_of_snapshot_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat;
    case 0x5A: unit end_of_session;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

