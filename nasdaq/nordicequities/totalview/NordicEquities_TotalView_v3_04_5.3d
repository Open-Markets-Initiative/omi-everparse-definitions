// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NordicEquities_TotalView_v3_04_5.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                // System Event Message
#define MESSAGE_TYPE_ORDER_BOOK_TRADING_ACTION_MESSAGE 0x48   // Order Book Trading Action Message
#define MESSAGE_TYPE_ORDER_BOOK_DIRECTORY_MESSAGE 0x52        // Order Book Directory Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x41                   // Add Order Message
#define MESSAGE_TYPE_ADD_ORDER_MPID_ATTRIBUTION_MESSAGE 0x46  // Add Order Mpid Attribution Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45              // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_WITH_PRICE_MESSAGE 0x43   // Order Executed With Price Message
#define MESSAGE_TYPE_ORDER_CANCEL_MESSAGE 0x58                // Order Cancel Message
#define MESSAGE_TYPE_ORDER_DELETE_MESSAGE 0x44                // Order Delete Message
#define MESSAGE_TYPE_ORDER_BOOK_FLUSH_MESSAGE 0x59            // Order Book Flush Message
#define MESSAGE_TYPE_ORDER_REPLACE_MESSAGE 0x55               // Order Replace Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x50                       // Trade Message
#define MESSAGE_TYPE_CROSS_TRADE_MESSAGE 0x51                 // Cross Trade Message
#define MESSAGE_TYPE_BROKEN_TRADE_MESSAGE 0x42                // Broken Trade Message
#define MESSAGE_TYPE_NOII_MESSAGE 0x49                        // Noii Message
#define MESSAGE_TYPE_MOII_MESSAGE 0x4A                        // Moii Message
#define MESSAGE_TYPE_EXECUTION_SUMMARY_MESSAGE 0x4B           // Execution Summary Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F  // Start Of Messages
#define EVENT_CODE_END_OF_MESSAGES 0x43    // End Of Messages

// Symbol State: one byte code
#define SYMBOL_STATE_CLOSED 0x43                      // Closed
#define SYMBOL_STATE_PRE_OPEN 0x50                    // Pre Open
#define SYMBOL_STATE_OPENING_AUCTION 0x4F             // Opening Auction
#define SYMBOL_STATE_CONTINUOUS_TRADING 0x54          // Continuous Trading
#define SYMBOL_STATE_SCHEDULED_INTRADAY_AUCTION 0x49  // Scheduled Intraday Auction
#define SYMBOL_STATE_CLOSING_AUCTION 0x4C             // Closing Auction
#define SYMBOL_STATE_POST_TRADE 0x53                  // Post Trade
#define SYMBOL_STATE_HALTED 0x48                      // Halted
#define SYMBOL_STATE_AUCTION_PERIOD 0x51              // Auction Period
#define SYMBOL_STATE_TRADING_AT_CLOSING_PRICE 0x41    // Trading At Closing Price

// Extension: one byte code
#define EXTENSION_CROSS_EXTENSION 0x45  // Cross Extension

// Financial Product: one byte code
#define FINANCIAL_PRODUCT_STOCK 0x01                   // Stock
#define FINANCIAL_PRODUCT_EQUITY_WARRANT 0x02          // Equity Warrant
#define FINANCIAL_PRODUCT_EQUITY_RIGHT 0x03            // Equity Right
#define FINANCIAL_PRODUCT_BOND 0x04                    // Bond
#define FINANCIAL_PRODUCT_LOTTERY_BOND_SERIES 0x06     // Lottery Bond Series
#define FINANCIAL_PRODUCT_CONVERTIBLE 0x07             // Convertible
#define FINANCIAL_PRODUCT_WARRANT 0x08                 // Warrant
#define FINANCIAL_PRODUCT_UNIT_TRUST_CERTIFICATE 0x0B  // Unit Trust Certificate
#define FINANCIAL_PRODUCT_INDEX_FUND_UNIT 0x0C         // Index Fund Unit

// Price Notation: one byte code
#define PRICE_NOTATION_MONETARY_VALUE 0x4D  // Monetary Value

// Buy Sell Indicator: one byte code
#define BUY_SELL_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define BUY_SELL_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// Trade Type: one byte code
#define TRADE_TYPE_MAIN_BOOK 0x42   // Main Book
#define TRADE_TYPE_NORDIC_MID 0x53  // Nordic Mid

// Cross Type: one byte code
#define CROSS_TYPE_OPENING_CROSS 0x4F                // Opening Cross
#define CROSS_TYPE_SCHEDULED_INTRADAY_CROSS 0x49     // Scheduled Intraday Cross
#define CROSS_TYPE_CLOSING_CROSS 0x43                // Closing Cross
#define CROSS_TYPE_CROSS_FOR_HALTED_SECURITIES 0x48  // Cross For Halted Securities
#define CROSS_TYPE_AUCTION_ON_DEMAND 0x41            // Auction On Demand

// Imbalance Direction: one byte code
#define IMBALANCE_DIRECTION_BUY_IMBALANCE 0x42                     // Buy Imbalance
#define IMBALANCE_DIRECTION_SELL_IMBALANCE 0x53                    // Sell Imbalance
#define IMBALANCE_DIRECTION_NO_IMBALANCE 0x4E                      // No Imbalance
#define IMBALANCE_DIRECTION_INSUFFICIENT_ORDERS_TO_CALCULATE 0x4F  // Insufficient Orders To Calculate

// Cross Level: one byte code
#define CROSS_LEVEL_BUY 0x42    // Buy
#define CROSS_LEVEL_SELL 0x53   // Sell
#define CROSS_LEVEL_MID 0x4D    // Mid
#define CROSS_LEVEL_LIMIT 0x4C  // Limit

// Aggressing Side: one byte code
#define AGGRESSING_SIDE_BUY 0x42   // Buy
#define AGGRESSING_SIDE_SELL 0x53  // Sell
#define AGGRESSING_SIDE_NONE 0x20  // None

// ---- Types -------------------------------------------------------------------

// Signals a market or data feed handler event
typedef struct _SystemEventMessage {
  UINT64BE timestamp;        // bytes 0 to 7
  UINT16BE tracking_number;  // bytes 8 to 9
  UINT8 event_code;          // byte 10
} SystemEventMessage;

// Indicates the current trading status of a security
typedef struct _OrderBookTradingActionMessage {
  UINT64BE timestamp;        // bytes 0 to 7
  UINT16BE tracking_number;  // bytes 8 to 9
  UINT32BE order_book;       // bytes 10 to 13
  UINT8 symbol_state;        // byte 14
  UINT8 extension;           // byte 15
  UINT8 reason[4];           // bytes 16 to 19
} OrderBookTradingActionMessage;

// Disseminated for all active order books at the start of each trading day
typedef struct _OrderBookDirectoryMessage {
  UINT64BE timestamp;                                                // bytes 0 to 7
  UINT16BE tracking_number;                                          // bytes 8 to 9
  UINT32BE order_book;                                               // bytes 10 to 13
  UINT8 symbol[16];                                                  // bytes 14 to 29
  UINT8 isin[12];                                                    // bytes 30 to 41
  UINT8 financial_product;                                           // byte 42
  UINT8 trading_currency[3];                                         // bytes 43 to 45
  UINT8 mic[4];                                                      // bytes 46 to 49
  UINT16BE market_segment_id;                                        // bytes 50 to 51
  UINT8 nm_new_market_company : 1;                                   // byte 52
  UINT8 xr_excluding_participating_in_rights : 1;                    // byte 52
  UINT8 sp_excluding_participating_in_split : 1;                     // byte 52
  UINT8 po_company_subject_to_public_offer : 1;                      // byte 52
  UINT8 ud_under_drawing : 1;                                        // byte 52
  UINT8 sr_excluding_comb_split_and_issue_rights : 1;                // byte 52
  UINT8 ul_un_listed : 1;                                            // byte 52
  UINT8 wi_when_issued : 1;                                          // byte 52
  UINT8 br_company_bankruptcy : 1;                                   // byte 53
  UINT8 su_suspension : 1;                                           // byte 53
  UINT8 rl_removal_from_listing_in_process : 1;                      // byte 53
  UINT8 sl_other_surveillance_list_reason : 1;                       // byte 53
  UINT8 to_a_significant_reverse_takeover_pending : 1;               // byte 53
  UINT8 cs_cent_shares : 1;                                          // byte 53
  UINT8 rs_reversed_split : 1;                                       // byte 53
  UINT8 bs_excluding_comb_bonus_split : 1;                           // byte 53
  UINT8 ss_excluding_comb_split_redemption_share : 1;                // byte 54
  UINT8 fn_first_north_company : 1;                                  // byte 54
  UINT8 ob_observation_status : 1;                                   // byte 54
  UINT8 xd_excluding_dividend : 1;                                   // byte 54
  UINT8 fe_foreign_non_eueea_entity : 1;                             // byte 54
  UINT8 so_sold_out_buy_back : 1;                                    // byte 54
  UINT8 sk_soft_knock : 1;                                           // byte 54
  UINT8 kb_knock_out_buy_back : 1;                                   // byte 54
  UINT8 bb_buy_back : 1;                                             // byte 55
  UINT8 reserved_23 : 2;                                             // byte 55
  UINT8 ce_capped_by_esma : 1;                                       // byte 55
  UINT8 reserved_5 : 1;                                              // byte 55
  UINT8 pd_price_discrepancy_historical_average_share_classes : 1;   // byte 55
  UINT8 sm_stressed_market : 1;                                      // byte 55
  UINT8 ew_market_wide_exceptional_circumstance : 1;                 // byte 55
  UINT8 em_exceptional_circumstances_related_to_market_maker : 1;    // byte 56
  UINT8 un_underlying_not_quoted : 1;                                // byte 56
  UINT8 da_digital_asset : 1;                                        // byte 56
  UINT8 kn_knock_out_buy_back_into_next_trading_day : 1;             // byte 56
  UINT8 reserved_58 : 4;                                             // byte 56
  UINT8 reserved_18 : 8;                                             // byte 57
  UINT8 reserved_18_2 : 8;                                           // byte 58
  UINT8 reserved_18_3 : 8;                                           // byte 59
  UINT32BE round_lot_size;                                           // bytes 60 to 63
  UINT8 nordic_mid_mic[4];                                           // bytes 64 to 67
  UINT8 aod_mic[4];                                                  // bytes 68 to 71
  UINT8 notation_of_qty[4];                                          // bytes 72 to 75
  UINT64BE notional_amount;                                          // bytes 76 to 83
  UINT8 currency[3];                                                 // bytes 84 to 86
  UINT8 price_notation;                                              // byte 87
  UINT64BE multiplier_for_calculating_quantity_in_measurement_unit;  // bytes 88 to 95
} OrderBookDirectoryMessage;

// An order added to the book without Mpid attribution
typedef struct _AddOrderMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT16BE tracking_number;         // bytes 8 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT8 buy_sell_indicator;         // byte 18
  UINT32BE quantity;                // bytes 19 to 22
  UINT32BE order_book;              // bytes 23 to 26
  UINT32BE price;                   // bytes 27 to 30
} AddOrderMessage;

// An order added to the book with Mpid attribution
typedef struct _AddOrderMpidAttributionMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT16BE tracking_number;         // bytes 8 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT8 buy_sell_indicator;         // byte 18
  UINT32BE quantity;                // bytes 19 to 22
  UINT32BE order_book;              // bytes 23 to 26
  UINT32BE price;                   // bytes 27 to 30
  UINT8 attribution[4];             // bytes 31 to 34
} AddOrderMpidAttributionMessage;

// Sent whenever an order on the book is executed in whole or in part
typedef struct _OrderExecutedMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT16BE tracking_number;         // bytes 8 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT32BE executed_quantity;       // bytes 18 to 21
  UINT32BE match_number;            // bytes 22 to 25
  UINT8 mpid[4];                    // bytes 26 to 29
  UINT8 mpid_counterparty[4];       // bytes 30 to 33
} OrderExecutedMessage;

// An order executed at a price different to its display price
typedef struct _OrderExecutedWithPriceMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT16BE tracking_number;         // bytes 8 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT32BE executed_quantity;       // bytes 18 to 21
  UINT32BE match_number;            // bytes 22 to 25
  UINT8 printable;                  // byte 26
  UINT32BE trade_price;             // bytes 27 to 30
  UINT8 mpid_owner[4];              // bytes 31 to 34
  UINT8 mpid_counterparty[4];       // bytes 35 to 38
} OrderExecutedWithPriceMessage;

// An order on the book modified by a partial cancellation
typedef struct _OrderCancelMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT16BE tracking_number;         // bytes 8 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT32BE canceled_quantity;       // bytes 18 to 21
} OrderCancelMessage;

// An order on the book being cancelled in full
typedef struct _OrderDeleteMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT16BE tracking_number;         // bytes 8 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
} OrderDeleteMessage;

// An order book is flushed and all orders removed
typedef struct _OrderBookFlushMessage {
  UINT64BE timestamp;        // bytes 0 to 7
  UINT16BE tracking_number;  // bytes 8 to 9
  UINT32BE order_book;       // bytes 10 to 13
} OrderBookFlushMessage;

// An order on the book has been cancel replaced
typedef struct _OrderReplaceMessage {
  UINT64BE timestamp;                        // bytes 0 to 7
  UINT16BE tracking_number;                  // bytes 8 to 9
  UINT64BE original_order_reference_number;  // bytes 10 to 17
  UINT64BE new_order_reference_number;       // bytes 18 to 25
  UINT32BE quantity;                         // bytes 26 to 29
  UINT32BE price;                            // bytes 30 to 33
} OrderReplaceMessage;

// Execution details for a match involving non displayable order types
typedef struct _TradeMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT16BE tracking_number;         // bytes 8 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT8 trade_type;                 // byte 18
  UINT32BE quantity;                // bytes 19 to 22
  UINT32BE order_book;              // bytes 23 to 26
  UINT32BE match_number;            // bytes 27 to 30
  UINT32BE trade_price;             // bytes 31 to 34
  UINT8 participant_id_buyer[4];    // bytes 35 to 38
  UINT8 participant_id_seller[4];   // bytes 39 to 42
} TradeMessage;

// The cross process has completed for a specific security
typedef struct _CrossTradeMessage {
  UINT64BE timestamp;         // bytes 0 to 7
  UINT16BE tracking_number;   // bytes 8 to 9
  UINT32BE quantity;          // bytes 10 to 13
  UINT32BE order_book;        // bytes 14 to 17
  UINT32BE cross_price;       // bytes 18 to 21
  UINT32BE match_number;      // bytes 22 to 25
  UINT8 cross_type;           // byte 26
  UINT32BE number_of_trades;  // bytes 27 to 30
} CrossTradeMessage;

// An execution has been broken and cannot be reinstated
typedef struct _BrokenTradeMessage {
  UINT64BE timestamp;        // bytes 0 to 7
  UINT16BE tracking_number;  // bytes 8 to 9
  UINT32BE match_number;     // bytes 10 to 13
} BrokenTradeMessage;

// Net order imbalance indicator disseminated during a cross auction
typedef struct _NoiiMessage {
  UINT64BE timestamp;           // bytes 0 to 7
  UINT16BE tracking_number;     // bytes 8 to 9
  UINT64BE paired_quantity;     // bytes 10 to 17
  UINT64BE imbalance_quantity;  // bytes 18 to 25
  UINT8 imbalance_direction;    // byte 26
  UINT32BE order_book;          // bytes 27 to 30
  UINT32BE equilibrium_price;   // bytes 31 to 34
  UINT8 cross_type;             // byte 35
  UINT32BE best_bid_price;      // bytes 36 to 39
  UINT64BE best_bid_quantity;   // bytes 40 to 47
  UINT32BE best_ask_price;      // bytes 48 to 51
  UINT64BE best_ask_quantity;   // bytes 52 to 59
} NoiiMessage;

// Auction on demand order imbalance indicator
typedef struct _MoiiMessage {
  UINT64BE timestamp;          // bytes 0 to 7
  UINT16BE tracking_number;    // bytes 8 to 9
  UINT64BE paired_quantity;    // bytes 10 to 17
  UINT32BE order_book;         // bytes 18 to 21
  UINT32BE equilibrium_price;  // bytes 22 to 25
  UINT8 cross_type;            // byte 26
  UINT8 cross_level;           // byte 27
} MoiiMessage;

// Summary information disseminated before the individual trades
typedef struct _ExecutionSummaryMessage {
  UINT64BE timestamp;                 // bytes 0 to 7
  UINT16BE tracking_number;           // bytes 8 to 9
  UINT32BE order_book;                // bytes 10 to 13
  UINT8 aggressing_side;              // byte 14
  UINT32BE quantity;                  // bytes 15 to 18
  UINT32BE hidden_quantity;           // bytes 19 to 22
  UINT32BE stp_cancel_quantity;       // bytes 23 to 26
  UINT32BE far_price;                 // bytes 27 to 30
  UINT32BE add_quantity;              // bytes 31 to 34
  UINT16BE number_of_lit_executions;  // bytes 35 to 36
} ExecutionSummaryMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x48: OrderBookTradingActionMessage order_book_trading_action_message;
    case 0x52: OrderBookDirectoryMessage order_book_directory_message;
    case 0x41: AddOrderMessage add_order_message;
    case 0x46: AddOrderMpidAttributionMessage add_order_mpid_attribution_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceMessage order_executed_with_price_message;
    case 0x58: OrderCancelMessage order_cancel_message;
    case 0x44: OrderDeleteMessage order_delete_message;
    case 0x59: OrderBookFlushMessage order_book_flush_message;
    case 0x55: OrderReplaceMessage order_replace_message;
    case 0x50: TradeMessage trade_message;
    case 0x51: CrossTradeMessage cross_trade_message;
    case 0x42: BrokenTradeMessage broken_trade_message;
    case 0x49: NoiiMessage noii_message;
    case 0x4A: MoiiMessage moii_message;
    case 0x4B: ExecutionSummaryMessage execution_summary_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

