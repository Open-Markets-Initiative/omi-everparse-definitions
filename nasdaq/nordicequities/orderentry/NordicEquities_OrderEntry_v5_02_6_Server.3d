} MaxRate;

// Conditional Type
typedef struct _ConditionalType {
  UINT8 conditional_type_value;  // byte 0
} ConditionalType;

// Firm-Up ID
typedef struct _FirmUpId {
  UINT32BE firm_up_id_value;  // bytes 0 to 3
} FirmUpId;

// Branch
casetype _ValuePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: ClearingAccount clearing_account;
    case 0x02: ClearingAccountType clearing_account_type;
    case 0x03: ClearingFirm clearing_firm;
    case 0x04: ClientReference client_reference;
    case 0x05: CrossType cross_type;
    case 0x06: DeaIndicator dea_indicator;
    case 0x07: Display display;
    case 0x08: DisplayPrice display_price;
    case 0x09: DisplayQuantity display_quantity;
    case 0x0A: ExpireTime expire_time;
    case 0x0B: Firm firm;
    case 0x0C: LiquidityProvisionIndicator liquidity_provision_indicator;
    case 0x0D: MaxFloor max_floor;
    case 0x0E: MinimumQuantity minimum_quantity;
    case 0x0F: OrderReference order_reference;
    case 0x10: OriginalOrderEntryDate original_order_entry_date;
    case 0x11: OriginalOrderReferenceNumber original_order_reference_number;
    case 0x12: PegDifference peg_difference;
    case 0x13: PegType peg_type;
    case 0x14: RandomReserve random_reserve;
    case 0x15: SecondaryOrderReferenceNumber secondary_order_reference_number;
    case 0x16: StpAction stp_action;
    case 0x17: StpLevel stp_level;
    case 0x18: StpTraderGroup stp_trader_group;
    case 0x19: TimeInForce time_in_force;
    case 0x1A: TradingAtClosingPrice trading_at_closing_price;
    case 0x1B: OrderCondition order_condition;
    case 0x1C: CumulativeQuantity cumulative_quantity;
    case 0x1D: CustomerOrderCapacity customer_order_capacity;
    case 0x1E: TargetStrategy target_strategy;
    case 0x1F: MinRate min_rate;
    case 0x20: MaxRate max_rate;
    case 0x21: ConditionalType conditional_type;
    case 0x22: FirmUpId firm_up_id;
    default: UINT8 unknown[available];
  }
} ValuePayload;

// Additional appendage tag value
typedef struct _TagValue {
  UINT8 length { length >= 1 };                                                                                                   // byte 0
  UINT8 tag;                                                                                                                      // byte 1
  ValuePayload(tag, ((((UINT32) length) + 1) - 2)) value_payload[:byte-size-single-element-array ((((UINT32) length) + 1) - 2)];
} TagValue;

// Acknowledges receipt and acceptance of a valid Enter Order
typedef struct _OrderAcceptedMessage {
  UINT64BE timestamp;                                          // bytes 0 to 7
  UINT32BE user_ref_num;                                       // bytes 8 to 11
  UINT32BE price;                                              // bytes 12 to 15
  UINT64BE order_reference_number;                             // bytes 16 to 23
  UINT8 buy_sell_indicator;                                    // byte 24
  UINT32BE order_book;                                         // bytes 25 to 28
  UINT32BE quantity;                                           // bytes 29 to 32
  UINT8 user[6];                                               // bytes 33 to 38
  UINT32BE execution_within_firm;                              // bytes 39 to 42
  UINT32BE investment_decision_within_firm_short_code;         // bytes 43 to 46
  UINT32BE client_identifier;                                  // bytes 47 to 50
  UINT8BE reserved_78 : 2;                                     // byte 51
  UINT8BE execution_decision_within_firm : 2;                  // byte 51
  UINT8BE investment_decision_within_firm : 2;                 // byte 51
  UINT8BE client_identification : 2;                           // byte 51
  UINT8 capacity;                                              // byte 52
  UINT8 algo_indicator;                                        // byte 53
  UINT16BE appendage_length;                                   // bytes 54 to 55
  TagValue tag_value[:byte-size ((UINT32) appendage_length)];
} OrderAcceptedMessage;

// Confirms that an order has been replaced
typedef struct _OrderReplacedMessage {
  UINT64BE timestamp;                                          // bytes 0 to 7
  UINT32BE orig_user_ref_num;                                  // bytes 8 to 11
  UINT32BE new_user_ref_num;                                   // bytes 12 to 15
  UINT32BE price;                                              // bytes 16 to 19
  UINT64BE order_reference_number;                             // bytes 20 to 27
  UINT8 buy_sell_indicator;                                    // byte 28
  UINT32BE order_book;                                         // bytes 29 to 32
  UINT32BE quantity;                                           // bytes 33 to 36
  UINT8 user[6];                                               // bytes 37 to 42
  UINT16BE appendage_length;                                   // bytes 43 to 44
  TagValue tag_value[:byte-size ((UINT32) appendage_length)];
} OrderReplacedMessage;

// An order has been reduced or cancelled
typedef struct _CancelledOrderMessage {
  UINT64BE timestamp;           // bytes 0 to 7
  UINT32BE user_ref_num;        // bytes 8 to 11
  UINT32BE decrement_quantity;  // bytes 12 to 15
  UINT8 cancel_reason;          // byte 16
} CancelledOrderMessage;

// A cancel request cannot be applied immediately
typedef struct _CancelPendingMessage {
  UINT64BE timestamp;           // bytes 0 to 7
  UINT32BE user_ref_num;        // bytes 8 to 11
  UINT8 cancel_pending_reason;  // byte 12
} CancelPendingMessage;

// A replace request cannot be applied immediately
typedef struct _ReplacePendingMessage {
  UINT64BE timestamp;            // bytes 0 to 7
  UINT32BE orig_user_ref_num;    // bytes 8 to 11
  UINT32BE user_ref_num;         // bytes 12 to 15
  UINT8 replace_pending_reason;  // byte 16
} ReplacePendingMessage;

// An order has been executed in whole or in part
typedef struct _ExecutedOrderMessage {
  UINT64BE timestamp;                     // bytes 0 to 7
  UINT32BE user_ref_num;                  // bytes 8 to 11
  UINT32BE executed_quantity;             // bytes 12 to 15
  UINT32BE execution_price;               // bytes 16 to 19
  UINT8 liquidity_flag;                   // byte 20
  UINT32BE match_number;                  // bytes 21 to 24
  UINT8 contra_firm[4];                   // bytes 25 to 28
  UINT8 trading_mode;                     // byte 29
  UINT8 transaction_category;             // byte 30
  UINT8 transaction_type_algo_indicator;  // byte 31
  UINT8BE liquidity_self_trade : 1;       // byte 32
  UINT8BE liquidity_top_of_book : 1;      // byte 32
  UINT8BE liquidity_internalized : 1;     // byte 32
  UINT8BE liquidity_indicator : 2;        // byte 32
  UINT8BE reserved_13 : 3;                // byte 32
  UINT8 last_market;                      // byte 33
} ExecutedOrderMessage;

// An execution has been broken and cannot be reinstated
typedef struct _BrokenTradeMessage {
  UINT64BE timestamp;                     // bytes 0 to 7
  UINT32BE user_ref_num;                  // bytes 8 to 11
  UINT32BE match_number;                  // bytes 12 to 15
  UINT8 broken_trade_reason;              // byte 16
  UINT8 trading_mode;                     // byte 17
  UINT8 transaction_category;             // byte 18
  UINT8 transaction_type_algo_indicator;  // byte 19
} BrokenTradeMessage;

// An order has been rejected
typedef struct _RejectedOrderMessage {
  UINT64BE timestamp;              // bytes 0 to 7
  UINT32BE user_ref_num;           // bytes 8 to 11
  UINT16BE rejected_order_reason;  // bytes 12 to 13
} RejectedOrderMessage;

// A cancel request has been rejected
typedef struct _CancelRejectedMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT32BE user_ref_num;            // bytes 8 to 11
  UINT16BE cancel_rejected_reason;  // bytes 12 to 13
} CancelRejectedMessage;

// An order has been restated by the system
typedef struct _OrderRestatedMessage {
  UINT64BE timestamp;                                          // bytes 0 to 7
  UINT32BE user_ref_num;                                       // bytes 8 to 11
  UINT8 restate_reason;                                        // byte 12
  UINT16BE appendage_length;                                   // bytes 13 to 14
  TagValue tag_value[:byte-size ((UINT32) appendage_length)];
} OrderRestatedMessage;

// Requests a market maker order refresh
typedef struct _MmoRefreshRequestMessage {
  UINT64BE timestamp;        // bytes 0 to 7
  Firm firm;                 // bytes 8 to 11
  UINT32BE order_book;       // bytes 12 to 15
  UINT8 mmo_refresh_reason;  // byte 16
} MmoRefreshRequestMessage;

// Indicates the next available UserRefNum
typedef struct _AccountQueryResponseMessage {
  UINT64BE timestamp;          // bytes 0 to 7
  UINT32BE next_user_ref_num;  // bytes 8 to 11
} AccountQueryResponseMessage;

// A Gtc order could not be restated in the morning
typedef struct _GtcCancelledMessage {
  UINT64BE timestamp;                                            // bytes 0 to 7
  OriginalOrderEntryDate original_order_entry_date;              // bytes 8 to 11
  OriginalOrderReferenceNumber original_order_reference_number;  // bytes 12 to 19
  UINT16BE reason;                                               // bytes 20 to 21
} GtcCancelledMessage;

// Response to a market making instruction notification
typedef struct _ResponseToMmiNotificationMessage {
  UINT64BE timestamp;        // bytes 0 to 7
  UINT32BE user_ref_num;     // bytes 8 to 11
  UINT32BE order_book;       // bytes 12 to 15
  UINT8 instruction;         // byte 16
  UINT8 add_or_remove;       // byte 17
  Firm firm;                 // bytes 18 to 21
  UINT8 user[6];             // bytes 22 to 27
  UINT8 instruction_status;  // byte 28
} ResponseToMmiNotificationMessage;

// An order is pending while the system processes it
typedef struct _PendingOrderMessage {
  UINT64BE timestamp;          // bytes 0 to 7
  UINT32BE user_ref_num;       // bytes 8 to 11
  UINT8 pending_order_reason;  // byte 12
} PendingOrderMessage;

// Sent whenever an indication of interest changes its streaming
typedef struct _StreamStatusMessage {
  UINT64BE timestamp;     // bytes 0 to 7
  UINT32BE user_ref_num;  // bytes 8 to 11
  UINT16BE cum_rate;      // bytes 12 to 13
  UINT8 status;           // byte 14
} StreamStatusMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x41: OrderAcceptedMessage order_accepted_message;
    case 0x55: OrderReplacedMessage order_replaced_message;
    case 0x43: CancelledOrderMessage cancelled_order_message;
    case 0x50: CancelPendingMessage cancel_pending_message;
    case 0x4E: ReplacePendingMessage replace_pending_message;
    case 0x45: ExecutedOrderMessage executed_order_message;
    case 0x42: BrokenTradeMessage broken_trade_message;
    case 0x4A: RejectedOrderMessage rejected_order_message;
    case 0x49: CancelRejectedMessage cancel_rejected_message;
    case 0x54: OrderRestatedMessage order_restated_message;
    case 0x57: MmoRefreshRequestMessage mmo_refresh_request_message;
    case 0x51: AccountQueryResponseMessage account_query_response_message;
    case 0x47: GtcCancelledMessage gtc_cancelled_message;
    case 0x52: ResponseToMmiNotificationMessage response_to_mmi_notification_message;
    case 0x4D: PendingOrderMessage pending_order_message;
    case 0x44: StreamStatusMessage stream_status_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat;
    case 0x5A: unit end_of_session;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

