// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NordicEquities_OrderEntry_v5_02_6_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                  // System Event Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_ACCEPTED_MESSAGE 0x41                // Order Accepted Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_REPLACED_MESSAGE 0x55                // Order Replaced Message
#define SEQUENCED_MESSAGE_TYPE_CANCELLED_ORDER_MESSAGE 0x43               // Cancelled Order Message
#define SEQUENCED_MESSAGE_TYPE_CANCEL_PENDING_MESSAGE 0x50                // Cancel Pending Message
#define SEQUENCED_MESSAGE_TYPE_REPLACE_PENDING_MESSAGE 0x4E               // Replace Pending Message
#define SEQUENCED_MESSAGE_TYPE_EXECUTED_ORDER_MESSAGE 0x45                // Executed Order Message
#define SEQUENCED_MESSAGE_TYPE_BROKEN_TRADE_MESSAGE 0x42                  // Broken Trade Message
#define SEQUENCED_MESSAGE_TYPE_REJECTED_ORDER_MESSAGE 0x4A                // Rejected Order Message
#define SEQUENCED_MESSAGE_TYPE_CANCEL_REJECTED_MESSAGE 0x49               // Cancel Rejected Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_RESTATED_MESSAGE 0x54                // Order Restated Message
#define SEQUENCED_MESSAGE_TYPE_MMO_REFRESH_REQUEST_MESSAGE 0x57           // Mmo Refresh Request Message
#define SEQUENCED_MESSAGE_TYPE_ACCOUNT_QUERY_RESPONSE_MESSAGE 0x51        // Account Query Response Message
#define SEQUENCED_MESSAGE_TYPE_GTC_CANCELLED_MESSAGE 0x47                 // Gtc Cancelled Message
#define SEQUENCED_MESSAGE_TYPE_RESPONSE_TO_MMI_NOTIFICATION_MESSAGE 0x52  // Response To Mmi Notification Message
#define SEQUENCED_MESSAGE_TYPE_PENDING_ORDER_MESSAGE 0x4D                 // Pending Order Message
#define SEQUENCED_MESSAGE_TYPE_STREAM_STATUS_MESSAGE 0x44                 // Stream Status Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_DAY 0x53  // Start Of Day
#define EVENT_CODE_END_OF_DAY 0x45    // End Of Day

// Buy Sell Indicator: one byte code
#define BUY_SELL_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define BUY_SELL_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Capacity: one byte code
#define CAPACITY_CLIENT 0x31                        // Client
#define CAPACITY_OWN_ACCOUNT 0x32                   // Own Account
#define CAPACITY_MARKET_MAKER 0x33                  // Market Maker
#define CAPACITY_ISSUER_HOLDING 0x34                // Issuer Holding
#define CAPACITY_ISSUE_PRICE_STABILIZING 0x36       // Issue Price Stabilizing
#define CAPACITY_RISKLESS_PRINCIPAL 0x37            // Riskless Principal
#define CAPACITY_ISSUER_HOLDING_DEAL 0x38           // Issuer Holding Deal
#define CAPACITY_ISSUE_PRICE_STABILIZING_DEAL 0x39  // Issue Price Stabilizing Deal

// Algo Indicator: one byte code
#define ALGO_INDICATOR_NO_ALGO 0x2D  // No Algo
#define ALGO_INDICATOR_ALGO 0x48     // Algo

// Clearing Account Type Value: one byte code
#define CLEARING_ACCOUNT_TYPE_VALUE_CUSTOMER_CLIENT 0x31  // Customer Client
#define CLEARING_ACCOUNT_TYPE_VALUE_FIRM_HOUSE 0x32       // Firm House

// Cross Type Value: one byte code
#define CROSS_TYPE_VALUE_CLOSING_CROSS 0x43             // Closing Cross
#define CROSS_TYPE_VALUE_OPENING_CROSS 0x4F             // Opening Cross
#define CROSS_TYPE_VALUE_SCHEDULED_INTRADAY_CROSS 0x49  // Scheduled Intraday Cross
#define CROSS_TYPE_VALUE_HALT_CROSS 0x48                // Halt Cross
#define CROSS_TYPE_VALUE_AUCTION_ON_DEMAND 0x41         // Auction On Demand

// Dea Indicator Value: one byte code
#define DEA_INDICATOR_VALUE_ORDER_RECEIVED_FROM_A_CUSTOMER 0x31                                    // Order Received From A Customer
#define DEA_INDICATOR_VALUE_ORDER_RECEIVED_FROM_WITHIN_THE_FIRM 0x32                               // Order Received From Within The Firm
#define DEA_INDICATOR_VALUE_ORDER_RECEIVED_FROM_ANOTHER_BROKER_DEALER 0x33                         // Order Received From Another Broker Dealer
#define DEA_INDICATOR_VALUE_ORDER_RECEIVED_FROM_A_CUSTOMER_OR_ORIGINATED_WITH_THE_FIRM 0x34        // Order Received From A Customer Or Originated With The Firm
#define DEA_INDICATOR_VALUE_ORDER_RECEIVED_FROM_A_DIRECT_ACCESS_OR_SPONSORED_ACCESS_CUSTOMER 0x35  // Order Received From A Direct Access Or Sponsored Access Customer

// Display Value: one byte code
#define DISPLAY_VALUE_DISPLAY 0x59            // Display
#define DISPLAY_VALUE_NON_DISPLAY 0x4E        // Non Display
#define DISPLAY_VALUE_AUCTION_ON_DEMAND 0x41  // Auction On Demand
#define DISPLAY_VALUE_NORDIC_MID 0x4D         // Nordic Mid
#define DISPLAY_VALUE_PURE_STREAM 0x53        // Pure Stream

// Liquidity Provision Indicator Value: one byte code
#define LIQUIDITY_PROVISION_INDICATOR_VALUE_NO_LIQUIDITY_PROVISION 0x4E  // No Liquidity Provision
#define LIQUIDITY_PROVISION_INDICATOR_VALUE_LIQUIDITY_PROVISION 0x59     // Liquidity Provision

// Peg Type Value: one byte code
#define PEG_TYPE_VALUE_MIDPOINT 0x4D  // Midpoint
#define PEG_TYPE_VALUE_MARKET 0x50    // Market
#define PEG_TYPE_VALUE_PRIMARY 0x52   // Primary

// Stp Action Value: one byte code
#define STP_ACTION_VALUE_CANCEL_PASSIVE_ORDER 0x31           // Cancel Passive Order
#define STP_ACTION_VALUE_CANCEL_AGGRESSIVE_ORDER 0x32        // Cancel Aggressive Order
#define STP_ACTION_VALUE_CANCEL_BOTH_ORDERS 0x33             // Cancel Both Orders
#define STP_ACTION_VALUE_CREATE_A_TRANSFER_TRANSACTION 0x34  // Create A Transfer Transaction

// Stp Level Value: one byte code
#define STP_LEVEL_VALUE_MPID_AND_TRADER 0x31         // Mpid And Trader
#define STP_LEVEL_VALUE_MPID 0x32                    // Mpid
#define STP_LEVEL_VALUE_SPECIFIED_TRADER_GROUP 0x33  // Specified Trader Group

// Time In Force Value: one byte code
#define TIME_IN_FORCE_VALUE_DAY 0x30                      // Day
#define TIME_IN_FORCE_VALUE_GTC_GOOD_TILL_CANCELLED 0x31  // Gtc Good Till Cancelled
#define TIME_IN_FORCE_VALUE_IOC_IMMEDIATE_OR_CANCEL 0x33  // Ioc Immediate Or Cancel
#define TIME_IN_FORCE_VALUE_GTT_GOOD_TILL_TIME 0x36       // Gtt Good Till Time
#define TIME_IN_FORCE_VALUE_GFA_GOOD_FOR_AUCTION 0x42     // Gfa Good For Auction

// Trading At Closing Price Value: one byte code
#define TRADING_AT_CLOSING_PRICE_VALUE_PARTICIPATE_IN_TRADING_AT_CLOSING_PRICE 0x59         // Participate In Trading At Closing Price
#define TRADING_AT_CLOSING_PRICE_VALUE_DO_NOT_PARTICIPATE_IN_TRADING_AT_CLOSING_PRICE 0x4E  // Do Not Participate In Trading At Closing Price

// Order Condition Value: one byte code
#define ORDER_CONDITION_VALUE_MARKET_MAKER_ORDER 0x57          // Market Maker Order
#define ORDER_CONDITION_VALUE_MARKET_MAKER_ORDER_REFRESH 0x55  // Market Maker Order Refresh
#define ORDER_CONDITION_VALUE_TOP_OF_BOOK 0x50                 // Top Of Book
#define ORDER_CONDITION_VALUE_DARK_LIT_SWEEP 0x51              // Dark Lit Sweep
#define ORDER_CONDITION_VALUE_TRADE_NOW 0x54                   // Trade Now

// Customer Order Capacity Value: one byte code
#define CUSTOMER_ORDER_CAPACITY_VALUE_RETAIL_CUSTOMER 0x35  // Retail Customer

// Target Strategy Value: one byte code
#define TARGET_STRATEGY_VALUE_RATE_5_TO_15_PERCENT 0x30    // Rate 5 To 15 Percent
#define TARGET_STRATEGY_VALUE_RATE_5_TO_30_PERCENT 0x31    // Rate 5 To 30 Percent
#define TARGET_STRATEGY_VALUE_RATE_10_TO_200_PERCENT 0x35  // Rate 10 To 200 Percent
#define TARGET_STRATEGY_VALUE_CUSTOM 0x43                  // Custom

// Conditional Type Value: one byte code
#define CONDITIONAL_TYPE_VALUE_CONDITIONAL_ORDER 0x43  // Conditional Order
#define CONDITIONAL_TYPE_VALUE_FIRM_UP_ORDER 0x46      // Firm Up Order

// Cancel Reason: one byte code
#define CANCEL_REASON_USER_REQUESTED_CANCEL 0x55      // User Requested Cancel
#define CANCEL_REASON_IMMEDIATE_OR_CANCEL_ORDER 0x49  // Immediate Or Cancel Order
#define CANCEL_REASON_TIMEOUT 0x54                    // Timeout
#define CANCEL_REASON_SUPERVISORY 0x53                // Supervisory
#define CANCEL_REASON_SELF_MATCH_PREVENTION 0x51      // Self Match Prevention
#define CANCEL_REASON_HIDDEN_PEG_NOT_LIS 0x4C         // Hidden Peg Not Lis
#define CANCEL_REASON_BAD_QUOTE 0x4E                  // Bad Quote
#define CANCEL_REASON_STATE_MANAGEMENT 0x52           // State Management

// Cancel Pending Reason: one byte code
#define CANCEL_PENDING_REASON_CANCEL_PENDING_COMPLETION_OF_AUCTION_ON_DEMAND 0x41  // Cancel Pending Completion Of Auction On Demand

// Trading Mode: one byte code
#define TRADING_MODE_OPENING_AUCTION 0x4F             // Opening Auction
#define TRADING_MODE_SCHEDULED_INTRADAY_AUCTION 0x49  // Scheduled Intraday Auction
#define TRADING_MODE_UNSCHEDULED_AUCTION 0x55         // Unscheduled Auction
#define TRADING_MODE_CONTINUOUS_TRADING 0x32          // Continuous Trading
#define TRADING_MODE_AT_MARKET_CLOSE_TRADING 0x33     // At Market Close Trading
#define TRADING_MODE_ON_DEMAND_AUCTION 0x50           // On Demand Auction

// Transaction Category: one byte code
#define TRANSACTION_CATEGORY_DARK_TRADE 0x44  // Dark Trade
#define TRANSACTION_CATEGORY_NONE_APPLY 0x2D  // None Apply

// Transaction Type Algo Indicator: one byte code
#define TRANSACTION_TYPE_ALGO_INDICATOR_ALGORITHMIC_TRADE 0x48     // Algorithmic Trade
#define TRANSACTION_TYPE_ALGO_INDICATOR_NO_ALGORITHMIC_TRADE 0x2D  // No Algorithmic Trade

// Broken Trade Reason: one byte code
#define BROKEN_TRADE_REASON_ERRONEOUS 0x45    // Erroneous
#define BROKEN_TRADE_REASON_CONSENT 0x43      // Consent
#define BROKEN_TRADE_REASON_SUPERVISORY 0x53  // Supervisory

// Restate Reason: one byte code
#define RESTATE_REASON_REFRESH_OF_DISPLAY 0x52         // Refresh Of Display
#define RESTATE_REASON_UPDATE_OF_DISPLAYED_PRICE 0x50  // Update Of Displayed Price

// Pending Order Reason: one byte code
#define PENDING_ORDER_REASON_SYSTEM_PROCESSING 0x53  // System Processing

// Status: one byte code
#define STATUS_STREAM_ON 0x4F   // Stream On
#define STATUS_STREAM_OFF 0x58  // Stream Off

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// Signals an event affecting the entire Nasdaq Nordic system
typedef struct _SystemEventMessage {
  UINT64BE timestamp;  // bytes 0 to 7
  UINT8 event_code;    // byte 8
} SystemEventMessage;

// Clearing Account
typedef struct _ClearingAccount {
  UINT8 clearing_account_value[12];  // bytes 0 to 11
} ClearingAccount;

// Clearing Account Type
typedef struct _ClearingAccountType {
  UINT8 clearing_account_type_value;  // byte 0
} ClearingAccountType;

// Clearing Firm
typedef struct _ClearingFirm {
  UINT8 clearing_firm_value[4];  // bytes 0 to 3
} ClearingFirm;

// Client Reference
typedef struct _ClientReference {
  UINT8 client_reference_value[15];  // bytes 0 to 14
} ClientReference;

// Cross Type
typedef struct _CrossType {
  UINT8 cross_type_value;  // byte 0
} CrossType;

// DEA Indicator
typedef struct _DeaIndicator {
  UINT8 dea_indicator_value;  // byte 0
} DeaIndicator;

// Display
typedef struct _Display {
  UINT8 display_value;  // byte 0
} Display;

// Display Price
typedef struct _DisplayPrice {
  UINT32BE display_price_value;  // bytes 0 to 3
} DisplayPrice;

// Display Quantity
typedef struct _DisplayQuantity {
  UINT32BE display_quantity_value;  // bytes 0 to 3
} DisplayQuantity;

// Expire Time
typedef struct _ExpireTime {
  UINT16BE expire_time_value;  // bytes 0 to 1
} ExpireTime;

// Firm
typedef struct _Firm {
  UINT8 firm_value[4];  // bytes 0 to 3
} Firm;

// Liquidity Provision Indicator
typedef struct _LiquidityProvisionIndicator {
  UINT8 liquidity_provision_indicator_value;  // byte 0
} LiquidityProvisionIndicator;

// Max Floor
typedef struct _MaxFloor {
  UINT32BE max_floor_value;  // bytes 0 to 3
} MaxFloor;

// Minimum Quantity
typedef struct _MinimumQuantity {
  UINT32BE minimum_quantity_value;  // bytes 0 to 3
} MinimumQuantity;

// Order Reference
typedef struct _OrderReference {
  UINT8 order_reference_value[10];  // bytes 0 to 9
} OrderReference;

// Original Order Entry Date
typedef struct _OriginalOrderEntryDate {
  UINT32BE original_order_entry_date_value;  // bytes 0 to 3
} OriginalOrderEntryDate;

// Original Order Reference Number
typedef struct _OriginalOrderReferenceNumber {
  UINT64BE original_order_reference_number_value;  // bytes 0 to 7
} OriginalOrderReferenceNumber;

// Peg Difference
typedef struct _PegDifference {
  UINT32BE peg_difference_value;  // bytes 0 to 3, signed, read here as unsigned
} PegDifference;

// Peg Type
typedef struct _PegType {
  UINT8 peg_type_value;  // byte 0
} PegType;

// Random Reserve
typedef struct _RandomReserve {
  UINT32BE random_reserve_value;  // bytes 0 to 3
} RandomReserve;

// Secondary Order Reference Number
typedef struct _SecondaryOrderReferenceNumber {
  UINT64BE secondary_order_reference_number_value;  // bytes 0 to 7
} SecondaryOrderReferenceNumber;

// STP Action
typedef struct _StpAction {
  UINT8 stp_action_value;  // byte 0
} StpAction;

// STP Level
typedef struct _StpLevel {
  UINT8 stp_level_value;  // byte 0
} StpLevel;

// STP Trader Group
typedef struct _StpTraderGroup {
  UINT8 stp_trader_group_value[2];  // bytes 0 to 1
} StpTraderGroup;

// Time in Force
typedef struct _TimeInForce {
  UINT8 time_in_force_value;  // byte 0
} TimeInForce;

// Trading at Closing price
typedef struct _TradingAtClosingPrice {
  UINT8 trading_at_closing_price_value;  // byte 0
} TradingAtClosingPrice;

// Order Condition
typedef struct _OrderCondition {
