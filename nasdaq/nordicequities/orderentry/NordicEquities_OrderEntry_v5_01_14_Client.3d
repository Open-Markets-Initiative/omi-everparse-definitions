// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NordicEquities_OrderEntry_v5_01_14_Client.3d

// ---- Values ------------------------------------------------------------------

// Client Packet Type: one byte code
#define CLIENT_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define CLIENT_PACKET_TYPE_LOGIN_REQUEST_PACKET 0x4C     // Login Request Packet
#define CLIENT_PACKET_TYPE_UNSEQUENCED_DATA_PACKET 0x55  // Unsequenced Data Packet
#define CLIENT_PACKET_TYPE_CLIENT_HEARTBEAT_PACKET 0x52  // Client Heartbeat Packet
#define CLIENT_PACKET_TYPE_LOGOUT_REQUEST_PACKET 0x4F    // Logout Request Packet

// Unsequenced Message Type: one byte code
#define UNSEQUENCED_MESSAGE_TYPE_ENTER_ORDER_MESSAGE 0x4F               // Enter Order Message
#define UNSEQUENCED_MESSAGE_TYPE_REPLACE_ORDER_MESSAGE 0x55             // Replace Order Message
#define UNSEQUENCED_MESSAGE_TYPE_CANCEL_ORDER_MESSAGE 0x58              // Cancel Order Message
#define UNSEQUENCED_MESSAGE_TYPE_ACCOUNT_QUERY_MESSAGE 0x51             // Account Query Message
#define UNSEQUENCED_MESSAGE_TYPE_MMI_NOTIFICATION_REQUEST_MESSAGE 0x4D  // Mmi Notification Request Message

// Buy Sell Indicator: one byte code
#define BUY_SELL_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define BUY_SELL_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Capacity: one byte code
#define CAPACITY_CLIENT 0x31                        // Client
#define CAPACITY_OWN_ACCOUNT 0x32                   // Own Account
#define CAPACITY_MARKET_MAKER 0x33                  // Market Maker
#define CAPACITY_ISSUER_HOLDING 0x34                // Issuer Holding
#define CAPACITY_ISSUE_PRICE_STABILIZING 0x36       // Issue Price Stabilizing
#define CAPACITY_RISKLESS_PRINCIPAL 0x37            // Riskless Principal
#define CAPACITY_ISSUER_HOLDING_DEAL 0x38           // Issuer Holding Deal
#define CAPACITY_ISSUE_PRICE_STABILIZING_DEAL 0x39  // Issue Price Stabilizing Deal

// Algo Indicator: one byte code
#define ALGO_INDICATOR_NO_ALGO 0x2D  // No Algo
#define ALGO_INDICATOR_ALGO 0x48     // Algo

// Clearing Account Type Value: one byte code
#define CLEARING_ACCOUNT_TYPE_VALUE_CUSTOMER_CLIENT 0x31  // Customer Client
#define CLEARING_ACCOUNT_TYPE_VALUE_FIRM_HOUSE 0x32       // Firm House

// Cross Type Value: one byte code
#define CROSS_TYPE_VALUE_CLOSING_CROSS 0x43             // Closing Cross
#define CROSS_TYPE_VALUE_OPENING_CROSS 0x4F             // Opening Cross
#define CROSS_TYPE_VALUE_SCHEDULED_INTRADAY_CROSS 0x49  // Scheduled Intraday Cross
#define CROSS_TYPE_VALUE_HALT_CROSS 0x48                // Halt Cross
#define CROSS_TYPE_VALUE_AUCTION_ON_DEMAND 0x41         // Auction On Demand

// Dea Indicator Value: one byte code
#define DEA_INDICATOR_VALUE_ORDER_RECEIVED_FROM_A_CUSTOMER 0x31                                    // Order Received From A Customer
#define DEA_INDICATOR_VALUE_ORDER_RECEIVED_FROM_WITHIN_THE_FIRM 0x32                               // Order Received From Within The Firm
#define DEA_INDICATOR_VALUE_ORDER_RECEIVED_FROM_ANOTHER_BROKER_DEALER 0x33                         // Order Received From Another Broker Dealer
#define DEA_INDICATOR_VALUE_ORDER_RECEIVED_FROM_A_CUSTOMER_OR_ORIGINATED_WITH_THE_FIRM 0x34        // Order Received From A Customer Or Originated With The Firm
#define DEA_INDICATOR_VALUE_ORDER_RECEIVED_FROM_A_DIRECT_ACCESS_OR_SPONSORED_ACCESS_CUSTOMER 0x35  // Order Received From A Direct Access Or Sponsored Access Customer

// Display Value: one byte code
#define DISPLAY_VALUE_DISPLAY 0x59            // Display
#define DISPLAY_VALUE_NON_DISPLAY 0x4E        // Non Display
#define DISPLAY_VALUE_AUCTION_ON_DEMAND 0x41  // Auction On Demand
#define DISPLAY_VALUE_NORDIC_MID 0x4D         // Nordic Mid

// Liquidity Provision Indicator Value: one byte code
#define LIQUIDITY_PROVISION_INDICATOR_VALUE_NO_LIQUIDITY_PROVISION 0x4E  // No Liquidity Provision
#define LIQUIDITY_PROVISION_INDICATOR_VALUE_LIQUIDITY_PROVISION 0x59     // Liquidity Provision

// Peg Type Value: one byte code
#define PEG_TYPE_VALUE_MIDPOINT 0x4D  // Midpoint
#define PEG_TYPE_VALUE_MARKET 0x50    // Market
#define PEG_TYPE_VALUE_PRIMARY 0x52   // Primary

// Stp Action Value: one byte code
#define STP_ACTION_VALUE_CANCEL_PASSIVE_ORDER 0x31           // Cancel Passive Order
#define STP_ACTION_VALUE_CANCEL_AGGRESSIVE_ORDER 0x32        // Cancel Aggressive Order
#define STP_ACTION_VALUE_CANCEL_BOTH_ORDERS 0x33             // Cancel Both Orders
#define STP_ACTION_VALUE_CREATE_A_TRANSFER_TRANSACTION 0x34  // Create A Transfer Transaction

// Stp Level Value: one byte code
#define STP_LEVEL_VALUE_MPID_AND_TRADER 0x31         // Mpid And Trader
#define STP_LEVEL_VALUE_MPID 0x32                    // Mpid
#define STP_LEVEL_VALUE_SPECIFIED_TRADER_GROUP 0x33  // Specified Trader Group

// Time In Force Value: one byte code
#define TIME_IN_FORCE_VALUE_DAY 0x30                      // Day
#define TIME_IN_FORCE_VALUE_GTC_GOOD_TILL_CANCELLED 0x31  // Gtc Good Till Cancelled
#define TIME_IN_FORCE_VALUE_IOC_IMMEDIATE_OR_CANCEL 0x33  // Ioc Immediate Or Cancel
#define TIME_IN_FORCE_VALUE_GTT_GOOD_TILL_TIME 0x36       // Gtt Good Till Time
#define TIME_IN_FORCE_VALUE_GFA_GOOD_FOR_AUCTION 0x42     // Gfa Good For Auction

// Trading At Closing Price Value: one byte code
#define TRADING_AT_CLOSING_PRICE_VALUE_PARTICIPATE_IN_TRADING_AT_CLOSING_PRICE 0x59         // Participate In Trading At Closing Price
#define TRADING_AT_CLOSING_PRICE_VALUE_DO_NOT_PARTICIPATE_IN_TRADING_AT_CLOSING_PRICE 0x4E  // Do Not Participate In Trading At Closing Price

// Order Condition Value: one byte code
#define ORDER_CONDITION_VALUE_MARKET_MAKER_ORDER 0x57          // Market Maker Order
#define ORDER_CONDITION_VALUE_MARKET_MAKER_ORDER_REFRESH 0x55  // Market Maker Order Refresh
#define ORDER_CONDITION_VALUE_TOP_OF_BOOK 0x50                 // Top Of Book
#define ORDER_CONDITION_VALUE_DARK_LIT_SWEEP 0x51              // Dark Lit Sweep
#define ORDER_CONDITION_VALUE_TRADE_NOW 0x54                   // Trade Now

// Customer Order Capacity Value: one byte code
#define CUSTOMER_ORDER_CAPACITY_VALUE_RETAIL_CUSTOMER 0x35  // Retail Customer

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP client must send a Login Request Packet immediately upon establishing a new TCP/IP socket connection to the server
typedef struct _LoginRequestPacket {
  UINT8 username[6];                    // bytes 0 to 5
  UINT8 password[10];                   // bytes 6 to 15
  UINT8 requested_session[10];          // bytes 16 to 25
  UINT8 requested_sequence_number[20];  // bytes 26 to 45
} LoginRequestPacket;

// Clearing Account
typedef struct _ClearingAccount {
  UINT8 clearing_account_value[12];  // bytes 0 to 11
} ClearingAccount;

// Clearing Account Type
typedef struct _ClearingAccountType {
  UINT8 clearing_account_type_value;  // byte 0
} ClearingAccountType;

// Clearing Firm
typedef struct _ClearingFirm {
  UINT8 clearing_firm_value[4];  // bytes 0 to 3
} ClearingFirm;

// Client Reference
typedef struct _ClientReference {
  UINT8 client_reference_value[15];  // bytes 0 to 14
} ClientReference;

// Cross Type
typedef struct _CrossType {
  UINT8 cross_type_value;  // byte 0
} CrossType;

// DEA Indicator
typedef struct _DeaIndicator {
  UINT8 dea_indicator_value;  // byte 0
} DeaIndicator;

// Display
typedef struct _Display {
  UINT8 display_value;  // byte 0
} Display;

// Display Price
typedef struct _DisplayPrice {
  UINT32BE display_price_value;  // bytes 0 to 3
} DisplayPrice;

// Display Quantity
typedef struct _DisplayQuantity {
  UINT32BE display_quantity_value;  // bytes 0 to 3
} DisplayQuantity;

// Expire Time
typedef struct _ExpireTime {
  UINT16BE expire_time_value;  // bytes 0 to 1
} ExpireTime;

// Firm
typedef struct _Firm {
  UINT8 firm_value[4];  // bytes 0 to 3
} Firm;

// Liquidity Provision Indicator
typedef struct _LiquidityProvisionIndicator {
  UINT8 liquidity_provision_indicator_value;  // byte 0
} LiquidityProvisionIndicator;

// Max Floor
typedef struct _MaxFloor {
  UINT32BE max_floor_value;  // bytes 0 to 3
} MaxFloor;

// Minimum Quantity
typedef struct _MinimumQuantity {
  UINT32BE minimum_quantity_value;  // bytes 0 to 3
} MinimumQuantity;

// Order Reference
typedef struct _OrderReference {
  UINT8 order_reference_value[10];  // bytes 0 to 9
} OrderReference;

// Original Order Entry Date
typedef struct _OriginalOrderEntryDate {
  UINT32BE original_order_entry_date_value;  // bytes 0 to 3
} OriginalOrderEntryDate;

// Original Order Reference Number
typedef struct _OriginalOrderReferenceNumber {
  UINT64BE original_order_reference_number_value;  // bytes 0 to 7
} OriginalOrderReferenceNumber;

// Peg Difference
typedef struct _PegDifference {
  UINT32BE peg_difference_value;  // bytes 0 to 3, signed, read here as unsigned
} PegDifference;

// Peg Type
typedef struct _PegType {
  UINT8 peg_type_value;  // byte 0
} PegType;

// Random Reserve
typedef struct _RandomReserve {
  UINT32BE random_reserve_value;  // bytes 0 to 3
} RandomReserve;

// Secondary Order Reference Number
typedef struct _SecondaryOrderReferenceNumber {
  UINT64BE secondary_order_reference_number_value;  // bytes 0 to 7
} SecondaryOrderReferenceNumber;

// STP Action
typedef struct _StpAction {
  UINT8 stp_action_value;  // byte 0
} StpAction;

// STP Level
typedef struct _StpLevel {
  UINT8 stp_level_value;  // byte 0
} StpLevel;

// STP Trader Group
typedef struct _StpTraderGroup {
  UINT8 stp_trader_group_value[2];  // bytes 0 to 1
} StpTraderGroup;

// Time in Force
typedef struct _TimeInForce {
  UINT8 time_in_force_value;  // byte 0
} TimeInForce;

// Trading at Closing price
typedef struct _TradingAtClosingPrice {
  UINT8 trading_at_closing_price_value;  // byte 0
} TradingAtClosingPrice;

// Order Condition
typedef struct _OrderCondition {
  UINT8 order_condition_value;  // byte 0
} OrderCondition;

// Cumulative Quantity
typedef struct _CumulativeQuantity {
  UINT32BE cumulative_quantity_value;  // bytes 0 to 3
} CumulativeQuantity;

// Customer Order Capacity
typedef struct _CustomerOrderCapacity {
  UINT8 customer_order_capacity_value;  // byte 0
} CustomerOrderCapacity;

// Branch
casetype _ValuePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: ClearingAccount clearing_account;
    case 0x02: ClearingAccountType clearing_account_type;
    case 0x03: ClearingFirm clearing_firm;
    case 0x04: ClientReference client_reference;
    case 0x05: CrossType cross_type;
    case 0x06: DeaIndicator dea_indicator;
    case 0x07: Display display;
    case 0x08: DisplayPrice display_price;
    case 0x09: DisplayQuantity display_quantity;
    case 0x0A: ExpireTime expire_time;
    case 0x0B: Firm firm;
    case 0x0C: LiquidityProvisionIndicator liquidity_provision_indicator;
    case 0x0D: MaxFloor max_floor;
    case 0x0E: MinimumQuantity minimum_quantity;
    case 0x0F: OrderReference order_reference;
    case 0x10: OriginalOrderEntryDate original_order_entry_date;
    case 0x11: OriginalOrderReferenceNumber original_order_reference_number;
    case 0x12: PegDifference peg_difference;
    case 0x13: PegType peg_type;
    case 0x14: RandomReserve random_reserve;
    case 0x15: SecondaryOrderReferenceNumber secondary_order_reference_number;
    case 0x16: StpAction stp_action;
    case 0x17: StpLevel stp_level;
    case 0x18: StpTraderGroup stp_trader_group;
    case 0x19: TimeInForce time_in_force;
    case 0x1A: TradingAtClosingPrice trading_at_closing_price;
    case 0x1B: OrderCondition order_condition;
    case 0x1C: CumulativeQuantity cumulative_quantity;
    case 0x1D: CustomerOrderCapacity customer_order_capacity;
    default: UINT8 unknown[available];
  }
} ValuePayload;

// Additional appendage tag value
typedef struct _TagValue {
  UINT8 length { length >= 1 };                                                                                                   // byte 0
  UINT8 tag;                                                                                                                      // byte 1
  ValuePayload(tag, ((((UINT32) length) + 1) - 2)) value_payload[:byte-size-single-element-array ((((UINT32) length) + 1) - 2)];
} TagValue;

// Enters a new order into Nasdaq Nordic
typedef struct _EnterOrderMessage {
  UINT32BE user_ref_num;                                       // bytes 0 to 3
  UINT8 buy_sell_indicator;                                    // byte 4
  UINT32BE quantity;                                           // bytes 5 to 8
  UINT32BE order_book;                                         // bytes 9 to 12
  UINT32BE price;                                              // bytes 13 to 16
  UINT8 user[6];                                               // bytes 17 to 22
  UINT32BE execution_within_firm;                              // bytes 23 to 26
  UINT32BE investment_decision_within_firm_short_code;         // bytes 27 to 30
  UINT32BE client_identifier;                                  // bytes 31 to 34
  UINT8BE reserved_78 : 2;                                     // byte 35
  UINT8BE execution_decision_within_firm : 2;                  // byte 35
  UINT8BE investment_decision_within_firm : 2;                 // byte 35
  UINT8BE client_identification : 2;                           // byte 35
  UINT8 capacity;                                              // byte 36
  UINT8 algo_indicator;                                        // byte 37
  UINT16BE appendage_length;                                   // bytes 38 to 39
  TagValue tag_value[:byte-size ((UINT32) appendage_length)];
} EnterOrderMessage;

// Alters attributes of a live order in a single message
typedef struct _ReplaceOrderMessage {
  UINT32BE orig_user_ref_num;                                  // bytes 0 to 3
  UINT32BE new_user_ref_num;                                   // bytes 4 to 7
  UINT32BE quantity;                                           // bytes 8 to 11
  UINT32BE price;                                              // bytes 12 to 15
  UINT8 user[6];                                               // bytes 16 to 21
  UINT16BE appendage_length;                                   // bytes 22 to 23
  TagValue tag_value[:byte-size ((UINT32) appendage_length)];
} ReplaceOrderMessage;

// Requests that an order be cancelled or reduced
typedef struct _CancelOrderMessage {
  UINT32BE user_ref_num;  // bytes 0 to 3
  UINT32BE quantity;      // bytes 4 to 7
  UINT8 user[6];          // bytes 8 to 13
} CancelOrderMessage;

// Requests a market making instruction notification
typedef struct _MmiNotificationRequestMessage {
  UINT32BE user_ref_num;  // bytes 0 to 3
  UINT32BE order_book;    // bytes 4 to 7
  UINT8 instruction;      // byte 8
  UINT8 add_or_remove;    // byte 9
  Firm firm;              // bytes 10 to 13
  UINT8 user[6];          // bytes 14 to 19
} MmiNotificationRequestMessage;

// The unsequenced (client to server) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _UnsequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x4F: EnterOrderMessage enter_order_message;
    case 0x55: ReplaceOrderMessage replace_order_message;
    case 0x58: CancelOrderMessage cancel_order_message;
    case 0x51: unit account_query_message;
    case 0x4D: MmiNotificationRequestMessage mmi_notification_request_message;
    default: UINT8 unknown[available];
  }
} UnsequencedMessage;

// The Unsequenced Data Packets act as an envelope to carry the actual data messages that are transferred from the client to the server
typedef struct _UnsequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 unsequenced_message_type;                                                                                                                                    // byte 0
  UnsequencedMessage(unsequenced_message_type, (((UINT32) packet_length) - 2)) unsequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} UnsequencedDataPacket;

// Branch
casetype _ClientPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x4C: LoginRequestPacket login_request_packet;
    case 0x55: UnsequencedDataPacket(packet_length) unsequenced_data_packet[:byte-size-single-element-array length];
    case 0x52: unit client_heartbeat;
    case 0x4F: unit logout_request;
    default: UINT8 unknown[available];
  }
} ClientPayload;

// Soup Bin Tcp Packet sent by the client
typedef struct _ClientSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 client_packet_type;                                                                                                                                                                                     // byte 2
  ClientPayload(client_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) client_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ClientSoupBinTcpPacket;

// ---- Packet: ClientPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the client
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientSoupBinTcpPacket client_soup_bin_tcp_packet[:byte-size available];
} ClientPacket;

