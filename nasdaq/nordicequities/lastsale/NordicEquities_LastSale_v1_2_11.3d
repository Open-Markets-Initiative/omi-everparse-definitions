// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NordicEquities_LastSale_v1_2_11.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_ADJUSTED_CLOSING_PRICE_MESSAGE 0x47  // Adjusted Closing Price Message
#define MESSAGE_TYPE_ON_EXCHANGE_TRADE_MESSAGE 0x54       // On Exchange Trade Message
#define MESSAGE_TYPE_OTC_TRADE_MESSAGE 0x5A               // Otc Trade Message

// Trade Type: one byte code
#define TRADE_TYPE_STANDARD_TRADE 0x31                       // Standard Trade
#define TRADE_TYPE_NON_STANDARD_SETTLEMENT 0x32              // Non Standard Settlement
#define TRADE_TYPE_EXCHANGE_GRANTED_TRADE 0x33               // Exchange Granted Trade
#define TRADE_TYPE_PORTFOLIO_TRADE 0x35                      // Portfolio Trade
#define TRADE_TYPE_VOLUME_WEIGHTED_AVERAGE_PRICE_TRADE 0x36  // Volume Weighted Average Price Trade
#define TRADE_TYPE_PRE_OPENING_TRADE 0x38                    // Pre Opening Trade
#define TRADE_TYPE_STANDARD_ROUTED_TRADE 0x44                // Standard Routed Trade
#define TRADE_TYPE_STANDARD_ROUTED_DARK_TRADE 0x45           // Standard Routed Dark Trade
#define TRADE_TYPE_STANDARD_DARK_TRADE 0x46                  // Standard Dark Trade
#define TRADE_TYPE_STANDARD_AUCTION_ON_DEMAND_TRADE 0x47     // Standard Auction On Demand Trade
#define TRADE_TYPE_STANDARD_TRADE_AT_CLOSING_TRADE 0x48      // Standard Trade At Closing Trade
#define TRADE_TYPE_CONTINGENT_TRADE 0x49                     // Contingent Trade
#define TRADE_TYPE_NON_PRICE_FORMING_TRADE 0x4E              // Non Price Forming Trade
#define TRADE_TYPE_AUCTION_VOLUME_DISCOVERY 0x56             // Auction Volume Discovery
#define TRADE_TYPE_OTC_STANDARD_TRADE 0x39                   // Otc Standard Trade
#define TRADE_TYPE_OTC_NON_STANDARD_TRADE 0x41               // Otc Non Standard Trade
#define TRADE_TYPE_SI_STANDARD_TRADE 0x42                    // Si Standard Trade
#define TRADE_TYPE_SI_NON_STANDARD_TRADE 0x43                // Si Non Standard Trade
#define TRADE_TYPE_OTC_LOAN_PAYMENT 0x4F                     // Otc Loan Payment
#define TRADE_TYPE_OTC_PRIMARY_TRANSACTION 0x50              // Otc Primary Transaction

// Transaction To Be Cleared: one byte code
#define TRANSACTION_TO_BE_CLEARED_YES 0x59  // Yes
#define TRANSACTION_TO_BE_CLEARED_NO 0x4E   // No

// ---- Types -------------------------------------------------------------------

// Adjusted closing price disseminated for all active symbols at the start of each trading day
typedef struct _AdjustedClosingPriceMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT16BE tracking_number;         // bytes 8 to 9
  UINT32BE order_book;              // bytes 10 to 13
  UINT64BE adjusted_closing_price;  // bytes 14 to 21
} AdjustedClosingPriceMessage;

// Relays on exchange trade transactions executed or deferred to the current business day
typedef struct _OnExchangeTradeMessage {
  UINT64BE timestamp;                     // bytes 0 to 7
  UINT16BE tracking_number;               // bytes 8 to 9
  UINT32BE order_book;                    // bytes 10 to 13
  UINT32BE execution_date;                // bytes 14 to 17
  UINT64BE execution_time;                // bytes 18 to 25
  UINT32BE agreement_date;                // bytes 26 to 29
  UINT64BE agreement_time;                // bytes 30 to 37
  UINT64BE price_on_exchange;             // bytes 38 to 45
  UINT64BE quantity;                      // bytes 46 to 53
  UINT8 venue_of_execution[4];            // bytes 54 to 57
  UINT8 transaction_identifier_code[10];  // bytes 58 to 67
  UINT8 mmt_trade_flags[14];              // bytes 68 to 81
  UINT8 trade_type;                       // byte 82
  UINT8 mpid_buyer[4];                    // bytes 83 to 86
  UINT8 mpid_seller[4];                   // bytes 87 to 90
  UINT8 transaction_to_be_cleared;        // byte 91
} OnExchangeTradeMessage;

// Relays over the counter and systematic internaliser trade transactions
typedef struct _OtcTradeMessage {
  UINT64BE timestamp;                                      // bytes 0 to 7
  UINT16BE tracking_number;                                // bytes 8 to 9
  UINT8 instrument_identification_code_type[4];            // bytes 10 to 13
  UINT8 instrument_identification_code[12];                // bytes 14 to 25
  UINT32BE agreement_date;                                 // bytes 26 to 29
  UINT64BE agreement_time;                                 // bytes 30 to 37
  UINT64BE price_otc;                                      // bytes 38 to 45
  UINT8 price_fraction;                                    // byte 46
  UINT8 price_notation[4];                                 // bytes 47 to 50
  UINT8 price_currency[3];                                 // bytes 51 to 53
  UINT64BE quantity;                                       // bytes 54 to 61
  UINT8 quantity_fraction;                                 // byte 62
  UINT8 notation_of_the_quantity_in_measurement_unit[25];  // bytes 63 to 87
  UINT64BE quantity_in_measurement_unit;                   // bytes 88 to 95
  UINT8 quantity_in_measurement_unit_fraction;             // byte 96
  UINT8 venue_of_execution[4];                             // bytes 97 to 100
  UINT64BE notional_amount;                                // bytes 101 to 108
  UINT8 notional_amount_fraction;                          // byte 109
  UINT8 notional_currency[3];                              // bytes 110 to 112
  UINT8 type_[4];                                          // bytes 113 to 116
  UINT8 transaction_identifier_code[10];                   // bytes 117 to 126
  UINT8 mmt_trade_flags[14];                               // bytes 127 to 140
  UINT8 transaction_to_be_cleared;                         // byte 141
  UINT8 trade_type;                                        // byte 142
  UINT8 third_country_trading_venue_of_execution[4];       // bytes 143 to 146
} OtcTradeMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x47: AdjustedClosingPriceMessage adjusted_closing_price_message;
    case 0x54: OnExchangeTradeMessage on_exchange_trade_message;
    case 0x5A: OtcTradeMessage otc_trade_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

