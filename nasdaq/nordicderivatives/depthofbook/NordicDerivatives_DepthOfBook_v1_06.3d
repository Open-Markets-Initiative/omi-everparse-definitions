// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NordicDerivatives_DepthOfBook_v1_06.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SECONDS_MESSAGE 0x54                    // Seconds Message
#define MESSAGE_TYPE_ORDER_BOOK_DIRECTORY 0x52               // Order Book Directory
#define MESSAGE_TYPE_COMBINATION_ORDER_BOOK_DIRECTORY 0x4D   // Combination Order Book Directory
#define MESSAGE_TYPE_TICK_SIZE_TABLE_ENTRY 0x4C              // Tick Size Table Entry
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53               // System Event Message
#define MESSAGE_TYPE_ORDER_BOOK_STATE_MESSAGE 0x4F           // Order Book State Message
#define MESSAGE_TYPE_ADD_ORDER_NO_MPID_ATTRIBUTION 0x41      // Add Order No Mpid Attribution
#define MESSAGE_TYPE_ADD_ORDER_MPID_ATTRIBUTION 0x46         // Add Order Mpid Attribution
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45             // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_WITH_PRICE_MESSAGE 0x43  // Order Executed With Price Message
#define MESSAGE_TYPE_ORDER_REPLACE_MESSAGE 0x55              // Order Replace Message
#define MESSAGE_TYPE_ORDER_DELETE_MESSAGE 0x44               // Order Delete Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x50                      // Trade Message
#define MESSAGE_TYPE_EQUILIBRIUM_PRICE_UPDATE 0x5A           // Equilibrium Price Update

// Financial Product: one byte code
#define FINANCIAL_PRODUCT_OPTION 0x01                          // Option
#define FINANCIAL_PRODUCT_FORWARD 0x02                         // Forward
#define FINANCIAL_PRODUCT_FUTURE 0x03                          // Future
#define FINANCIAL_PRODUCT_FRA 0x04                             // Fra
#define FINANCIAL_PRODUCT_CASH 0x05                            // Cash
#define FINANCIAL_PRODUCT_PAYMENT 0x06                         // Payment
#define FINANCIAL_PRODUCT_EXCHANGE_RATE 0x07                   // Exchange Rate
#define FINANCIAL_PRODUCT_INTEREST_RATE_SWAP 0x08              // Interest Rate Swap
#define FINANCIAL_PRODUCT_REPO 0x09                            // Repo
#define FINANCIAL_PRODUCT_SYNTHETIC_BOX_LEG_OR_REFERENCE 0x0A  // Synthetic Box Leg Or Reference
#define FINANCIAL_PRODUCT_STANDARD_COMBINATION 0x0B            // Standard Combination
#define FINANCIAL_PRODUCT_GUARANTEE 0x0C                       // Guarantee
#define FINANCIAL_PRODUCT_OTC_GENERAL 0x0D                     // Otc General
#define FINANCIAL_PRODUCT_EQUITY_WARRANT 0x0E                  // Equity Warrant
#define FINANCIAL_PRODUCT_SECURITY_LENDING 0x0F                // Security Lending

// Leg 1 Side: one byte code
#define LEG_1_SIDE_AS_DEFINED 0x42  // As Defined
#define LEG_1_SIDE_OPPOSITE 0x43    // Opposite

// Leg 2 Side: one byte code
#define LEG_2_SIDE_AS_DEFINED 0x42  // As Defined
#define LEG_2_SIDE_OPPOSITE 0x43    // Opposite

// Leg 3 Side: one byte code
#define LEG_3_SIDE_AS_DEFINED 0x42  // As Defined
#define LEG_3_SIDE_OPPOSITE 0x43    // Opposite

// Leg 4 Side: one byte code
#define LEG_4_SIDE_AS_DEFINED 0x42  // As Defined
#define LEG_4_SIDE_OPPOSITE 0x43    // Opposite

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F  // Start Of Messages
#define EVENT_CODE_END_OF_MESSAGES 0x43    // End Of Messages

// Side: one byte code
#define SIDE_BUY 0x42    // Buy
#define SIDE_SELL 0x53   // Sell
#define SIDE_BLANK 0x20  // Blank

// Lot Type: one byte code
#define LOT_TYPE_UNDEFINED 0x00        // Undefined
#define LOT_TYPE_ODD_LOT 0x01          // Odd Lot
#define LOT_TYPE_ROUND_LOT 0x02        // Round Lot
#define LOT_TYPE_BLOCK_LOT 0x03        // Block Lot
#define LOT_TYPE_ALL_OR_NONE_LOT 0x04  // All Or None Lot

// Occurred At Cross: one byte code
#define OCCURRED_AT_CROSS_YES 0x59  // Yes
#define OCCURRED_AT_CROSS_NO 0x4E   // No

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// ---- Types -------------------------------------------------------------------

// This message is sent every second for which at least one ITCH message is being generated. The message contains the number of seconds since the start of 1970-01-01 00:00:00 UTC, also called Unix Time
typedef struct _SecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} SecondsMessage;

// At the start of each trading day, Order book directory messages are disseminated for all active securities, including halted securities, in the Genium INET Trading system. Intra-day transmissions of this message may occur when new order books are added to the system; updates to existing order books may also be represented by intra-day Order book Directory messages
typedef struct _OrderBookDirectory {
  UINT32BE nanoseconds;                          // bytes 0 to 3
  UINT32BE order_book_id;                        // bytes 4 to 7
  UINT8 symbol[32];                              // bytes 8 to 39
  UINT8 long_name[32];                           // bytes 40 to 71
  UINT8 isin[12];                                // bytes 72 to 83
  UINT8 financial_product;                       // byte 84
  UINT8 trading_currency[3];                     // bytes 85 to 87
  UINT16BE number_of_decimals_in_price;          // bytes 88 to 89
  UINT16BE number_of_decimals_in_nominal_value;  // bytes 90 to 91
  UINT32BE odd_lot_size;                         // bytes 92 to 95
  UINT32BE round_lot_size;                       // bytes 96 to 99
  UINT32BE block_lot_size;                       // bytes 100 to 103
  UINT64BE nominal_value;                        // bytes 104 to 111
} OrderBookDirectory;

// Specialized directory message used when Combination order books are traded in the marketplace. It represents both standard combinations defined by the exchange and tailor-made combinations created by members. Intra-day transmissions may occur when new combination order books are added, typically for tailor-made combinations
typedef struct _CombinationOrderBookDirectory {
  UINT32BE nanoseconds;                          // bytes 0 to 3
  UINT32BE order_book_id;                        // bytes 4 to 7
  UINT8 symbol[32];                              // bytes 8 to 39
  UINT8 long_name[32];                           // bytes 40 to 71
  UINT8 isin[12];                                // bytes 72 to 83
  UINT8 financial_product;                       // byte 84
  UINT8 trading_currency[3];                     // bytes 85 to 87
  UINT16BE number_of_decimals_in_price;          // bytes 88 to 89
  UINT16BE number_of_decimals_in_nominal_value;  // bytes 90 to 91
  UINT32BE odd_lot_size;                         // bytes 92 to 95
  UINT32BE round_lot_size;                       // bytes 96 to 99
  UINT32BE block_lot_size;                       // bytes 100 to 103
  UINT64BE nominal_value;                        // bytes 104 to 111
  UINT8 leg_1_symbol[32];                        // bytes 112 to 143
  UINT8 leg_1_side;                              // byte 144
  UINT32BE leg_1_ratio;                          // bytes 145 to 148
  UINT8 leg_2_symbol[32];                        // bytes 149 to 180
  UINT8 leg_2_side;                              // byte 181
  UINT32BE leg_2_ratio;                          // bytes 182 to 185
  UINT8 leg_3_symbol[32];                        // bytes 186 to 217
  UINT8 leg_3_side;                              // byte 218
  UINT32BE leg_3_ratio;                          // bytes 219 to 222
  UINT8 leg_4_symbol[32];                        // bytes 223 to 254
  UINT8 leg_4_side;                              // byte 255
  UINT32BE leg_4_ratio;                          // bytes 256 to 259
} CombinationOrderBookDirectory;

// Contains information on a tick size for a price range. Together, all Tick Size messages with the same order book ID form a complete Tick Size Table. The number of decimals in prices are given by the Order Book Directory message for this order book
typedef struct _TickSizeTableEntry {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
  UINT64BE tick_size;      // bytes 8 to 15, signed, read here as unsigned
  UINT32BE price_from;     // bytes 16 to 19, signed, read here as unsigned
  UINT32BE price_to;       // bytes 20 to 23, signed, read here as unsigned
} TickSizeTableEntry;

// The system event message type is used to signal a market or data feed handler event
typedef struct _SystemEventMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT8 event_code;      // byte 4
} SystemEventMessage;

// The Order book state message relays information on state changes
typedef struct _OrderBookStateMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
  UINT8 state_name[20];    // bytes 8 to 27
} OrderBookStateMessage;

// Add Order Message. Indicates that a new order has been accepted by the Genium INET Trading system and was added to the displayable book. Generated for unattributed orders
typedef struct _AddOrderNoMpidAttribution {
  UINT32BE nanoseconds;                    // bytes 0 to 3
  UINT64BE order_id;                       // bytes 4 to 11
  UINT32BE order_book_id;                  // bytes 12 to 15
  UINT8 side;                              // byte 16
  UINT32BE order_book_position;            // bytes 17 to 20
  UINT64BE quantity;                       // bytes 21 to 28
  UINT32BE price;                          // bytes 29 to 32, signed, read here as unsigned
  UINT16BE reserved_bits_15_to_16 : 2;     // bytes 33 to 34
  UINT16BE bait_implied_order : 1;         // bytes 33 to 34
  UINT16BE convert_to_aggressive : 1;      // bytes 33 to 34
  UINT16BE firm_color_disabled : 1;        // bytes 33 to 34
  UINT16BE fill_and_kill_immediately : 1;  // bytes 33 to 34
  UINT16BE reserved_bits_7_to_10 : 4;      // bytes 33 to 34
  UINT16BE undisclosed : 1;                // bytes 33 to 34
  UINT16BE override_crossing : 1;          // bytes 33 to 34
  UINT16BE price_stabilization : 1;        // bytes 33 to 34
  UINT16BE market_bid : 1;                 // bytes 33 to 34
  UINT16BE short_sell : 1;                 // bytes 33 to 34
  UINT16BE force : 1;                      // bytes 33 to 34
  UINT8 lot_type;                          // byte 35
} AddOrderNoMpidAttribution;

// Add Order Message. Indicates that a new order has been accepted by the Genium INET Trading system and was added to the displayable book. Generated for attributed orders and quotations
typedef struct _AddOrderMpidAttribution {
  UINT32BE nanoseconds;                    // bytes 0 to 3
  UINT64BE order_id;                       // bytes 4 to 11
  UINT32BE order_book_id;                  // bytes 12 to 15
  UINT8 side;                              // byte 16
  UINT32BE order_book_position;            // bytes 17 to 20
  UINT64BE quantity;                       // bytes 21 to 28
  UINT32BE price;                          // bytes 29 to 32, signed, read here as unsigned
  UINT16BE reserved_bits_15_to_16 : 2;     // bytes 33 to 34
  UINT16BE bait_implied_order : 1;         // bytes 33 to 34
  UINT16BE convert_to_aggressive : 1;      // bytes 33 to 34
  UINT16BE firm_color_disabled : 1;        // bytes 33 to 34
  UINT16BE fill_and_kill_immediately : 1;  // bytes 33 to 34
  UINT16BE reserved_bits_7_to_10 : 4;      // bytes 33 to 34
  UINT16BE undisclosed : 1;                // bytes 33 to 34
  UINT16BE override_crossing : 1;          // bytes 33 to 34
  UINT16BE price_stabilization : 1;        // bytes 33 to 34
  UINT16BE market_bid : 1;                 // bytes 33 to 34
  UINT16BE short_sell : 1;                 // bytes 33 to 34
  UINT16BE force : 1;                      // bytes 33 to 34
  UINT8 lot_type;                          // byte 35
  UINT8 participant_id[7];                 // bytes 36 to 42
} AddOrderMpidAttribution;

// Sent whenever an order on the book is executed in whole or in part. Multiple Order Executed Messages on the same order are cumulative
typedef struct _OrderExecutedMessage {
  UINT32BE nanoseconds;                  // bytes 0 to 3
  UINT64BE order_id;                     // bytes 4 to 11
  UINT32BE order_book_id;                // bytes 12 to 15
  UINT8 side;                            // byte 16
  UINT64BE executed_quantity;            // bytes 17 to 24
  UINT8 match_id[12];                    // bytes 25 to 36
  UINT8 participant_id_owner[7];         // bytes 37 to 43
  UINT8 participant_id_counterparty[7];  // bytes 44 to 50
} OrderExecutedMessage;

// Sent in the relatively rare event that an order on the book is executed in whole or in part with a price different than the initial display price. Combination orders on the book that execute are always represented by this message, with the Printable flag set to N
typedef struct _OrderExecutedWithPriceMessage {
  UINT32BE nanoseconds;                  // bytes 0 to 3
  UINT64BE order_id;                     // bytes 4 to 11
  UINT32BE order_book_id;                // bytes 12 to 15
  UINT8 side;                            // byte 16
  UINT64BE executed_quantity;            // bytes 17 to 24
  UINT8 match_id[12];                    // bytes 25 to 36
  UINT8 participant_id_owner[7];         // bytes 37 to 43
  UINT8 participant_id_counterparty[7];  // bytes 44 to 50
  UINT32BE trade_price;                  // bytes 51 to 54, signed, read here as unsigned
  UINT8 occurred_at_cross;               // byte 55
  UINT8 printable;                       // byte 56
} OrderExecutedWithPriceMessage;

// Sent whenever an existing order on the book has been modified through an alter action. The Side, Order book ID and attribution (if any) remain the same as the original order
typedef struct _OrderReplaceMessage {
  UINT32BE nanoseconds;                    // bytes 0 to 3
  UINT64BE order_id;                       // bytes 4 to 11
  UINT32BE order_book_id;                  // bytes 12 to 15
  UINT8 side;                              // byte 16
  UINT32BE new_order_book_position;        // bytes 17 to 20
  UINT64BE quantity;                       // bytes 21 to 28
  UINT32BE price;                          // bytes 29 to 32, signed, read here as unsigned
  UINT16BE reserved_bits_15_to_16 : 2;     // bytes 33 to 34
  UINT16BE bait_implied_order : 1;         // bytes 33 to 34
  UINT16BE convert_to_aggressive : 1;      // bytes 33 to 34
  UINT16BE firm_color_disabled : 1;        // bytes 33 to 34
  UINT16BE fill_and_kill_immediately : 1;  // bytes 33 to 34
  UINT16BE reserved_bits_7_to_10 : 4;      // bytes 33 to 34
  UINT16BE undisclosed : 1;                // bytes 33 to 34
  UINT16BE override_crossing : 1;          // bytes 33 to 34
  UINT16BE price_stabilization : 1;        // bytes 33 to 34
  UINT16BE market_bid : 1;                 // bytes 33 to 34
  UINT16BE short_sell : 1;                 // bytes 33 to 34
  UINT16BE force : 1;                      // bytes 33 to 34
} OrderReplaceMessage;

// Sent whenever an order on the book is being deleted. Order Deletes are also sent when an order with an undisclosed quantity is fully filled, when orders are suspended due to connection loss, and for all existing orders prior to an auction where market by order dissemination is disabled
typedef struct _OrderDeleteMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT64BE order_id;       // bytes 4 to 11
  UINT32BE order_book_id;  // bytes 12 to 15
  UINT8 side;              // byte 16
} OrderDeleteMessage;

// Provides execution details for normal match events involving non-displayable order types, and is also used to publish individual cross trades
typedef struct _TradeMessage {
  UINT32BE nanoseconds;                  // bytes 0 to 3
  UINT8 match_id[12];                    // bytes 4 to 15
  UINT8 side;                            // byte 16
  UINT64BE quantity;                     // bytes 17 to 24
  UINT32BE order_book_id;                // bytes 25 to 28
  UINT32BE trade_price;                  // bytes 29 to 32, signed, read here as unsigned
  UINT8 participant_id_owner[7];         // bytes 33 to 39
  UINT8 participant_id_counterparty[7];  // bytes 40 to 46
  UINT8 printable;                       // byte 47
  UINT8 occurred_at_cross;               // byte 48
} TradeMessage;

// Used when auctions occur. The message provides the changes in equilibrium price. If any Price field has bit 31 set (the highest bit, MIN_INT) while all other bits are zero (decimal -2147483648), this means that no price is available
typedef struct _EquilibriumPriceUpdate {
  UINT32BE nanoseconds;                                  // bytes 0 to 3
  UINT32BE order_book_id;                                // bytes 4 to 7
  UINT64BE available_bid_quantity_at_equilibrium_price;  // bytes 8 to 15
  UINT64BE available_ask_quantity_at_equilibrium_price;  // bytes 16 to 23
  UINT32BE equilibrium_price;                            // bytes 24 to 27, signed, read here as unsigned
  UINT8 reserved_4_a[4];                                 // bytes 28 to 31
  UINT8 reserved_4_b[4];                                 // bytes 32 to 35
  UINT8 reserved_8_a[8];                                 // bytes 36 to 43
  UINT8 reserved_8_b[8];                                 // bytes 44 to 51
} EquilibriumPriceUpdate;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: SecondsMessage seconds_message;
    case 0x52: OrderBookDirectory order_book_directory;
    case 0x4D: CombinationOrderBookDirectory combination_order_book_directory;
    case 0x4C: TickSizeTableEntry tick_size_table_entry;
    case 0x53: SystemEventMessage system_event_message;
    case 0x4F: OrderBookStateMessage order_book_state_message;
    case 0x41: AddOrderNoMpidAttribution add_order_no_mpid_attribution;
    case 0x46: AddOrderMpidAttribution add_order_mpid_attribution;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceMessage order_executed_with_price_message;
    case 0x55: OrderReplaceMessage order_replace_message;
    case 0x44: OrderDeleteMessage order_delete_message;
    case 0x50: TradeMessage trade_message;
    case 0x5A: EquilibriumPriceUpdate equilibrium_price_update;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

