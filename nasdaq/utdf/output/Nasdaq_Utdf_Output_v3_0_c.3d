  UINT8 corrected_trade_through_exempt_flag;  // byte 104
  UINT16BE corrected_sellers_sale_days;       // bytes 105 to 106
  UINT64BE consolidated_high_price;           // bytes 107 to 114
  UINT64BE consolidated_low_price;            // bytes 115 to 122
  UINT64BE consolidated_last_price;           // bytes 123 to 130
  UINT64BE consolidated_volume;               // bytes 131 to 138
  UINT8 consolidated_price_change_indicator;  // byte 139
  UINT8 consolidated_last_price_originator;   // byte 140
  UINT64BE market_participant_high_price;     // bytes 141 to 148
  UINT64BE market_participant_low_price;      // bytes 149 to 156
  UINT64BE market_participant_last_price;     // bytes 157 to 164
  UINT64BE market_participant_volume;         // bytes 165 to 172
} FractionalTradeCorrectionMessage;

// Fractional As-Of Trade Message. Introduced with the Fractional Share Release on February 23, 2026.
typedef struct _FractionalAsOfTradeMessage {
  UINT8 market_center_originator;   // byte 0
  UINT8 sub_market_center_id;       // byte 1
  UINT64BE sip_timestamp;           // bytes 2 to 9
  UINT64BE timestamp_1;             // bytes 10 to 17
  UINT64BE participant_token;       // bytes 18 to 25
  UINT64BE timestamp_2;             // bytes 26 to 33
  UINT8 symbol_long[11];            // bytes 34 to 44
  UINT64BE trade_id;                // bytes 45 to 52
  UINT64BE trade_price_long;        // bytes 53 to 60
  UINT64BE trade_volume;            // bytes 61 to 68
  UINT8 sale_condition[4];          // bytes 69 to 72
  UINT8 trade_through_exempt_flag;  // byte 73
  UINT16BE sellers_sale_days;       // bytes 74 to 75
  UINT8 as_of_action;               // byte 76
  UINT64BE timestamp_of_trade;      // bytes 77 to 84
} FractionalAsOfTradeMessage;

// Branch
casetype _TradeMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: TradeReportMessageShortFormMessage trade_report_message_short_form_message;
    case 0x57: TradeReportMessageLongFormMessage trade_report_message_long_form_message;
    case 0x5A: TradeCancelErrorMessage trade_cancel_error_message;
    case 0x59: TradeCorrectionMessage trade_correction_message;
    case 0x48: PriorDayAsOfTradeMessage prior_day_as_of_trade_message;
    case 0x4D: FractionalTradeReportMessageShortFormMessage fractional_trade_report_message_short_form_message;
    case 0x4E: FractionalTradeReportMessageLongFormMessage fractional_trade_report_message_long_form_message;
    case 0x4F: FractionalTradeCancelErrorMessage fractional_trade_cancel_error_message;
    case 0x50: FractionalTradeCorrectionMessage fractional_trade_correction_message;
    case 0x51: FractionalAsOfTradeMessage fractional_as_of_trade_message;
    default: UINT8 unknown[available];
  }
} TradeMessagePayload;

// Trade Messages Utp Trade Feed Only
typedef struct _TradeMessage (UINT32 available) where (available >= 1) {
  UINT8 trade_message_type;                                                                                                         // byte 0
  TradeMessagePayload(trade_message_type, (available - 1)) trade_message_payload[:byte-size-single-element-array (available - 1)];
} TradeMessage;

// General Administrative Message containing free-form text
typedef struct _GeneralAdministrativeMessage {
  UINT8 market_center_originator;      // byte 0
  UINT8 sub_market_center_id;          // byte 1
  UINT64BE sip_timestamp;              // bytes 2 to 9
  UINT64BE timestamp_1;                // bytes 10 to 17
  UINT64BE participant_token;          // bytes 18 to 25
  UINT16BE text_length;                // bytes 26 to 27
  UINT8 text[((UINT32) text_length)];
} GeneralAdministrativeMessage;

// Informs subscribers of trading actions across all UTP participants
typedef struct _CrossSroTradingActionMessage {
  UINT8 market_center_originator;           // byte 0
  UINT8 sub_market_center_id;               // byte 1
  UINT64BE sip_timestamp;                   // bytes 2 to 9
  UINT64BE timestamp_1;                     // bytes 10 to 17
  UINT64BE participant_token;               // bytes 18 to 25
  UINT8 symbol_long[11];                    // bytes 26 to 36
  UINT8 trading_action_code;                // byte 37
  UINT32BE trading_action_sequence_number;  // bytes 38 to 41
  UINT64BE action_time;                     // bytes 42 to 49
  UINT8 reason_for_the_trading_action[6];   // bytes 50 to 55
} CrossSroTradingActionMessage;

// Informs UTP data feed subscribers when a UTP participant invokes or releases a market center-specific trading halt
typedef struct _MarketCenterTradingActionMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
  UINT8 symbol_long[11];           // bytes 26 to 36
  UINT8 trading_action_code;       // byte 37
  UINT64BE action_time;            // bytes 38 to 45
  UINT8 market_center_identifier;  // byte 46
} MarketCenterTradingActionMessage;

// Issue Symbol Directory Message providing reference data for NASDAQ-listed securities
typedef struct _IssueSymbolDirectoryMessage {
