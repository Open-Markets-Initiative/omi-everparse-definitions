// Market Center Closing Price and Volume Summary attachment following the Closing Trade Summary Report Message. Repeats Number of Market Center Attachments times.
typedef struct _MarketCenterClosingPriceAndVolumeSummary {
  UINT8 market_center_identifier;          // byte 0
  UINT64BE market_center_closing_price;    // bytes 1 to 8
  UINT64BE market_center_volume;           // bytes 9 to 16
  UINT8 market_center_close_indicator;     // byte 17
  UINT64BE market_participant_high_price;  // bytes 18 to 25
  UINT64BE market_participant_low_price;   // bytes 26 to 33
} MarketCenterClosingPriceAndVolumeSummary;

// Fractional Closing Trade Summary Report Message. Disseminated three times daily, last at End of Trading Reporting event, with attachments per market center
typedef struct _ClosingTradeSummaryReportMessage {
  UINT8 market_center_originator;                                                                                                                             // byte 0
  UINT8 sub_market_center_id;                                                                                                                                 // byte 1
  UINT64BE sip_timestamp;                                                                                                                                     // bytes 2 to 9
  UINT64BE timestamp_1;                                                                                                                                       // bytes 10 to 17
  UINT64BE participant_token;                                                                                                                                 // bytes 18 to 25
  UINT8 symbol_long[11];                                                                                                                                      // bytes 26 to 36
  UINT64BE daily_consolidated_high_price;                                                                                                                     // bytes 37 to 44
  UINT64BE daily_consolidated_low_price;                                                                                                                      // bytes 45 to 52
  UINT64BE daily_consolidated_closing_price;                                                                                                                  // bytes 53 to 60
  UINT8 consolidated_last_price_originator;                                                                                                                   // byte 61
  UINT64BE consolidated_volume;                                                                                                                               // bytes 62 to 69
  UINT8 trading_action_indicator;                                                                                                                             // byte 70
  UINT16BE number_of_market_center_attachments;                                                                                                               // bytes 71 to 72
  MarketCenterClosingPriceAndVolumeSummary market_center_closing_price_and_volume_summary[:byte-size (((UINT32) number_of_market_center_attachments) * 34)];
} ClosingTradeSummaryReportMessage;

// Branch
casetype _AdministrativeMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: GeneralAdministrativeMessage general_administrative_message;
    case 0x48: CrossSroTradingActionMessage cross_sro_trading_action_message;
    case 0x4B: MarketCenterTradingActionMessage market_center_trading_action_message;
    case 0x42: IssueSymbolDirectoryMessage issue_symbol_directory_message;
    case 0x56: RegShoShortSalePriceTestRestrictedIndicatorMessage reg_sho_short_sale_price_test_restricted_indicator_message;
    case 0x50: LimitUpLimitDownPriceBandMessage limit_up_limit_down_price_band_message;
    case 0x43: MarketWideCircuitBreakerDeclineLevelMessage market_wide_circuit_breaker_decline_level_message;
    case 0x44: MarketWideCircuitBreakerStatusMessage market_wide_circuit_breaker_status_message;
    case 0x45: AuctionCollarMessage auction_collar_message;
    case 0x55: ClosingTradeSummaryReportMessage closing_trade_summary_report_message;
    default: UINT8 unknown[available];
  }
} AdministrativeMessagePayload;

// Administrative Messages
typedef struct _AdministrativeMessage (UINT32 available) where (available >= 1) {
  UINT8 administrative_message_type;                                                                                                                           // byte 0
  AdministrativeMessagePayload(administrative_message_type, (available - 1)) administrative_message_payload[:byte-size-single-element-array (available - 1)];
} AdministrativeMessage;

// Market Center Volume attachment following the Total Consolidated and Market Center Volume Message. Repeats Number of Market Center Attachments times.
typedef struct _MarketCenterVolumeGroup {
  UINT8 market_center_identifier;  // byte 0
  UINT64BE market_center_volume;   // bytes 1 to 8
} MarketCenterVolumeGroup;

// Fractional Total Consolidated and Market Center Volume Message. Relays intra-day cumulative consolidated share volume and per-market center volume
typedef struct _TotalConsolidatedAndMarketCenterVolumeMessage {
  UINT8 market_center_originator;                                                                                       // byte 0
  UINT8 sub_market_center_id;                                                                                           // byte 1
  UINT64BE sip_timestamp;                                                                                               // bytes 2 to 9
  UINT64BE timestamp_1;                                                                                                 // bytes 10 to 17
  UINT64BE participant_token;                                                                                           // bytes 18 to 25
  UINT64BE total_consolidated_volume;                                                                                   // bytes 26 to 33
  UINT16BE number_of_market_center_attachments;                                                                         // bytes 34 to 35
  MarketCenterVolumeGroup market_center_volume_group[:byte-size (((UINT32) number_of_market_center_attachments) * 9)];
} TotalConsolidatedAndMarketCenterVolumeMessage;

// Branch
casetype _TotalConsolidatedVolumeMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x56: TotalConsolidatedAndMarketCenterVolumeMessage total_consolidated_and_market_center_volume_message;
    default: UINT8 unknown[available];
  }
} TotalConsolidatedVolumeMessagePayload;

// Total Consolidated And Market Center Volume Messages
typedef struct _TotalConsolidatedVolumeMessage (UINT32 available) where (available >= 1) {
  UINT8 total_consolidated_volume_message_type;                                                                                                                                               // byte 0
  TotalConsolidatedVolumeMessagePayload(total_consolidated_volume_message_type, (available - 1)) total_consolidated_volume_message_payload[:byte-size-single-element-array (available - 1)];
} TotalConsolidatedVolumeMessage;

// Signifies the beginning of each operational cycle for SIP Processing
typedef struct _StartOfDayMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
} StartOfDayMessage;

// Signals the end of active message dissemination for the UTP SIP operational cycle
typedef struct _EndOfDayMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
} EndOfDayMessage;

// Signifies the opening of market systems
typedef struct _MarketSessionOpenMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
} MarketSessionOpenMessage;

// Signals the closing of market systems
typedef struct _MarketSessionCloseMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
} MarketSessionCloseMessage;

// Signals that there will be no further transmissions for the day
typedef struct _EndOfTransmissionsMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
} EndOfTransmissionsMessage;

// Signals that SIP has completed its trade entry eligibility and no further trade data will be accepted for the market session
typedef struct _EndOfTradeReportingMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
} EndOfTradeReportingMessage;

// Signals the closing of the trade-reporting window for consolidated last sale calculation eligibility. Generated 10 seconds after the market close message from the primary market
typedef struct _EndOfConsolidatedLastSaleEligibilityMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
} EndOfConsolidatedLastSaleEligibilityMessage;

// Branch
casetype _ControlMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x49: StartOfDayMessage start_of_day_message;
    case 0x4A: EndOfDayMessage end_of_day_message;
    case 0x4F: MarketSessionOpenMessage market_session_open_message;
    case 0x43: MarketSessionCloseMessage market_session_close_message;
    case 0x5A: EndOfTransmissionsMessage end_of_transmissions_message;
    case 0x58: EndOfTradeReportingMessage end_of_trade_reporting_message;
    case 0x53: EndOfConsolidatedLastSaleEligibilityMessage end_of_consolidated_last_sale_eligibility_message;
    default: UINT8 unknown[available];
  }
} ControlMessagePayload;

// Control Messages
typedef struct _ControlMessage (UINT32 available) where (available >= 1) {
  UINT8 control_message_type;                                                                                                             // byte 0
  ControlMessagePayload(control_message_type, (available - 1)) control_message_payload[:byte-size-single-element-array (available - 1)];
} ControlMessage;

// Branch
casetype _CategoryPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: TradeMessage(available) trade_message;
    case 0x41: AdministrativeMessage(available) administrative_message;
    case 0x56: TotalConsolidatedVolumeMessage(available) total_consolidated_volume_message;
    case 0x43: ControlMessage(available) control_message;
    default: UINT8 unknown[available];
  }
} CategoryPayload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 2 };                                                                                                                 // bytes 0 to 1
  UINT8 version;                                                                                                                                                   // byte 2
  UINT8 message_category;                                                                                                                                          // byte 3
  CategoryPayload(message_category, (((UINT32) message_length) - 2)) category_payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Utp Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

