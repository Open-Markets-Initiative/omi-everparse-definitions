  UINT32BE trade_volume_long;                 // bytes 61 to 64
  UINT8 sale_condition[4];                    // bytes 65 to 68
  UINT8 trade_through_exempt_flag;            // byte 69
  UINT16BE sellers_sale_days;                 // bytes 70 to 71
