// ---- Packet Header: 20 bytes -------------------------------------------------

// Utp Mold Udp 64 Packet Header
entrypoint typedef struct _PacketHeader {
  UINT8 session[10];         // bytes 0 to 9
  UINT64BE sequence_number;  // bytes 10 to 17
  UINT16BE message_count;    // bytes 18 to 19
} PacketHeader;

// ---- Message Header: 4 bytes -------------------------------------------------

// Utp Mold Udp 64 Message Header
entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;  // bytes 0 to 1
  UINT8 version;            // byte 2
  UINT8 message_category;   // byte 3
} MessageHeader;

// ---- Finra Adf Market Participant Quotation Message: 74 bytes ----------------

// FINRA ADF Quotation Message. Sent for FINRA quotes that do not affect the NBBO or FINRA BBO. May also be produced when the FINRA BBO quote impacts either the current FINRA best bid or best ask.
entrypoint typedef struct _FinraAdfMarketParticipantQuotationMessage {
  UINT8 market_center_originator;     // byte 0
  UINT8 sub_market_center_id;         // byte 1
  UINT64BE sip_timestamp;             // bytes 2 to 9
  UINT64BE timestamp_1;               // bytes 10 to 17
  UINT64BE participant_token;         // bytes 18 to 25
  UINT64BE timestamp_2;               // bytes 26 to 33
  UINT8 symbol_long[11];              // bytes 34 to 44
  UINT64BE bid_price_long;            // bytes 45 to 52
  UINT32BE bid_size_long;             // bytes 53 to 56
  UINT64BE ask_price_long;            // bytes 57 to 64
  UINT32BE ask_size_long;             // bytes 65 to 68
  UINT8 quote_condition;              // byte 69
  UINT8 finra_market_participant[4];  // bytes 70 to 73
} FinraAdfMarketParticipantQuotationMessage;

// ---- Cross Sro Trading Action Message: 56 bytes ------------------------------

// Informs subscribers of trading actions (halts, pauses, quotation resumptions and trading resumptions) impacting the trading of a NASDAQ-listed issue across all UTP participants
entrypoint typedef struct _CrossSroTradingActionMessage {
  UINT8 market_center_originator;           // byte 0
  UINT8 sub_market_center_id;               // byte 1
  UINT64BE sip_timestamp;                   // bytes 2 to 9
  UINT64BE timestamp_1;                     // bytes 10 to 17
  UINT64BE participant_token;               // bytes 18 to 25
  UINT8 symbol_long[11];                    // bytes 26 to 36
  UINT8 trading_action_code;                // byte 37
  UINT32BE trading_action_sequence_number;  // bytes 38 to 41
  UINT64BE action_time;                     // bytes 42 to 49
  UINT8 reason_for_the_trading_action[6];   // bytes 50 to 55
} CrossSroTradingActionMessage;

// ---- Market Center Trading Action Message: 47 bytes --------------------------

// Informs UTP data feed subscribers when a UTP participant invokes or releases a market center-specific trading halt for a NASDAQ-listed security
entrypoint typedef struct _MarketCenterTradingActionMessage {
  UINT8 market_center_originator;  // byte 0
  UINT8 sub_market_center_id;      // byte 1
  UINT64BE sip_timestamp;          // bytes 2 to 9
  UINT64BE timestamp_1;            // bytes 10 to 17
  UINT64BE participant_token;      // bytes 18 to 25
  UINT8 symbol_long[11];           // bytes 26 to 36
  UINT8 trading_action_code;       // byte 37
  UINT64BE action_time;            // bytes 38 to 45
  UINT8 market_center_identifier;  // byte 46
} MarketCenterTradingActionMessage;

// ---- Issue Symbol Directory Message: 87 bytes --------------------------------

// Issue Symbol Directory Message providing reference data for NASDAQ-listed securities
entrypoint typedef struct _IssueSymbolDirectoryMessage {
