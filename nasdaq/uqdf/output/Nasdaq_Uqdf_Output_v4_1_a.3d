// ---- Types -------------------------------------------------------------------

// FINRA ADF Quotation Message. Sent for FINRA quotes that do not affect the NBBO or FINRA BBO. May also be produced when the FINRA BBO quote impacts either the current FINRA best bid or best ask.
typedef struct _FinraAdfMarketParticipantQuotationMessage {
  UINT8 market_center_originator;     // byte 0
  UINT8 sub_market_center_id;         // byte 1
  UINT64BE sip_timestamp;             // bytes 2 to 9
  UINT64BE timestamp_1;               // bytes 10 to 17
  UINT64BE participant_token;         // bytes 18 to 25
  UINT64BE timestamp_2;               // bytes 26 to 33
  UINT8 symbol_long[11];              // bytes 34 to 44
  UINT64BE bid_price;                 // bytes 45 to 52
  UINT32BE bid_size;                  // bytes 53 to 56
  UINT64BE ask_price;                 // bytes 57 to 64
  UINT32BE ask_size;                  // bytes 65 to 68
  UINT8 quote_condition;              // byte 69
  UINT8 finra_market_participant[4];  // bytes 70 to 73
} FinraAdfMarketParticipantQuotationMessage;

// National BBO Appendage Short-form
typedef struct _NationalBboAppendageShortForm {
  UINT8 nbbo_quote_condition;              // byte 0
  UINT8 national_best_bid_market_center;   // byte 1
  UINT16BE national_best_bid_price_short;  // bytes 2 to 3
  UINT16BE national_best_bid_size_short;   // bytes 4 to 5
  UINT8 national_best_ask_market_center;   // byte 6
  UINT16BE national_best_ask_price_short;  // bytes 7 to 8
  UINT16BE national_best_ask_size_short;   // bytes 9 to 10
} NationalBboAppendageShortForm;

// National BBO Appendage Short-form
casetype _OptionalNationalBboAppendageShortForm (Bool present) {
  switch (present) {
    case true: NationalBboAppendageShortForm national_bbo_appendage_short_form;
    case false: unit absent;
  }
} OptionalNationalBboAppendageShortForm;

// National BBO Appendage Long-form
typedef struct _NationalBboAppendageLongForm {
  UINT8 nbbo_quote_condition;             // byte 0
  UINT8 national_best_bid_market_center;  // byte 1
  UINT64BE national_best_bid_price_long;  // bytes 2 to 9
  UINT32BE national_best_bid_size_long;   // bytes 10 to 13
  UINT8 national_best_ask_market_center;  // byte 14
  UINT64BE national_best_ask_price_long;  // bytes 15 to 22
  UINT32BE national_best_ask_size_long;   // bytes 23 to 26
} NationalBboAppendageLongForm;

// National BBO Appendage Long-form
casetype _OptionalNationalBboAppendageLongForm (Bool present) {
  switch (present) {
    case true: NationalBboAppendageLongForm national_bbo_appendage_long_form;
    case false: unit absent;
  }
} OptionalNationalBboAppendageLongForm;

// BOLO Appendage Short Form
typedef struct _BoloAppendageShortForm {
  UINT8 bolo_best_bid_market_center;  // byte 0
  UINT16BE bolo_bid_price_short;      // bytes 1 to 2
  UINT16BE bolo_bid_size;             // bytes 3 to 4
  UINT8 bolo_best_ask_market_center;  // byte 5
  UINT16BE bolo_ask_price_short;      // bytes 6 to 7
  UINT16BE bolo_ask_size;             // bytes 8 to 9
} BoloAppendageShortForm;

// BOLO Appendage Short Form
casetype _OptionalBoloAppendageShortForm (Bool present) {
  switch (present) {
    case true: BoloAppendageShortForm bolo_appendage_short_form;
    case false: unit absent;
  }
} OptionalBoloAppendageShortForm;

// BOLO Appendage Long Form
typedef struct _BoloAppendageLongForm {
  UINT8 bolo_best_bid_market_center;  // byte 0
  UINT64BE bolo_bid_price_long;       // bytes 1 to 8
  UINT16BE bolo_bid_size;             // bytes 9 to 10
  UINT8 bolo_best_ask_market_center;  // byte 11
  UINT64BE bolo_ask_price_long;       // bytes 12 to 19
  UINT16BE bolo_ask_size;             // bytes 20 to 21
} BoloAppendageLongForm;

// BOLO Appendage Long Form
casetype _OptionalBoloAppendageLongForm (Bool present) {
  switch (present) {
    case true: BoloAppendageLongForm bolo_appendage_long_form;
    case false: unit absent;
  }
} OptionalBoloAppendageLongForm;

// BOLO Appendage MPID Form
typedef struct _BoloAppendageMpidForm {
  UINT8 bolo_best_bid_market_center;                     // byte 0
  UINT64BE bolo_bid_price_long;                          // bytes 1 to 8
  UINT16BE bolo_bid_size;                                // bytes 9 to 10
  UINT8 bolo_best_ask_market_center;                     // byte 11
  UINT64BE bolo_ask_price_long;                          // bytes 12 to 19
  UINT16BE bolo_ask_size;                                // bytes 20 to 21
  UINT8 bolo_best_bid_market_participant_identifier[4];  // bytes 22 to 25
  UINT8 bolo_best_ask_market_participant_identifier[4];  // bytes 26 to 29
} BoloAppendageMpidForm;

// BOLO Appendage MPID Form
casetype _OptionalBoloAppendageMpidForm (Bool present) {
  switch (present) {
    case true: BoloAppendageMpidForm bolo_appendage_mpid_form;
    case false: unit absent;
  }
} OptionalBoloAppendageMpidForm;

// Odd Lot Price Level Attachment Short Form (Odd Lot Attachment Type = 2). Repeats Odd Lot Attachment Count times.
typedef struct _OddLotPriceLevelAttachmentShortForm {
  UINT8 market_center_id;            // byte 0
  UINT8 side;                        // byte 1
  UINT16BE odd_lot_price_short;      // bytes 2 to 3
  UINT16BE shares_at_odd_lot_price;  // bytes 4 to 5
} OddLotPriceLevelAttachmentShortForm;

// Odd Lot Price Level Attachment Short Form (Odd Lot Attachment Type = 2). Repeats Odd Lot Attachment Count times.
casetype _OptionalOddLotPriceLevelAttachmentShortForm (Bool present, UINT32 length) {
  switch (present) {
    case true: OddLotPriceLevelAttachmentShortForm odd_lot_price_level_attachment_short_form[:byte-size length];
    case false: unit absent;
  }
} OptionalOddLotPriceLevelAttachmentShortForm;

// Odd Lot Price Level Attachment Long Form (Odd Lot Attachment Type = 3). Repeats Odd Lot Attachment Count times.
typedef struct _OddLotPriceLevelAttachmentLongForm {
  UINT8 market_center_id;            // byte 0
  UINT8 side;                        // byte 1
  UINT64BE odd_lot_price_long;       // bytes 2 to 9
  UINT16BE shares_at_odd_lot_price;  // bytes 10 to 11
} OddLotPriceLevelAttachmentLongForm;

// Odd Lot Price Level Attachment Long Form (Odd Lot Attachment Type = 3). Repeats Odd Lot Attachment Count times.
casetype _OptionalOddLotPriceLevelAttachmentLongForm (Bool present, UINT32 length) {
  switch (present) {
    case true: OddLotPriceLevelAttachmentLongForm odd_lot_price_level_attachment_long_form[:byte-size length];
    case false: unit absent;
  }
} OptionalOddLotPriceLevelAttachmentLongForm;

// Odd Lot Price Level Attachment ADF MPID Form (Odd Lot Attachment Type = 5). Adds ADF Market Participant Identifier to long form fields. Repeats Odd Lot Attachment Count times.
typedef struct _OddLotPriceLevelAttachmentAdfMpidForm {
  UINT8 market_center_id;                      // byte 0
  UINT8 side;                                  // byte 1
  UINT64BE odd_lot_price_long;                 // bytes 2 to 9
  UINT16BE shares_at_odd_lot_price;            // bytes 10 to 11
  UINT8 adf_market_participant_identifier[4];  // bytes 12 to 15
} OddLotPriceLevelAttachmentAdfMpidForm;

// Odd Lot Price Level Attachment ADF MPID Form (Odd Lot Attachment Type = 5). Adds ADF Market Participant Identifier to long form fields. Repeats Odd Lot Attachment Count times.
casetype _OptionalOddLotPriceLevelAttachmentAdfMpidForm (Bool present, UINT32 length) {
  switch (present) {
    case true: OddLotPriceLevelAttachmentAdfMpidForm odd_lot_price_level_attachment_adf_mpid_form[:byte-size length];
    case false: unit absent;
  }
} OptionalOddLotPriceLevelAttachmentAdfMpidForm;

// Short Format Combined Quotation Message. Combines protected quote and one or more odd lot quotes in a single message. Supported since the Odd Lot Release on April 27, 2026.
typedef struct _CombinedQuoteMessageShortFormMessage {
  UINT8 market_center_originator;                                                                                                                                             // byte 0
  UINT8 sub_market_center_id;                                                                                                                                                 // byte 1
  UINT64BE sip_timestamp;                                                                                                                                                     // bytes 2 to 9
  UINT64BE timestamp_1;                                                                                                                                                       // bytes 10 to 17
  UINT64BE participant_token;                                                                                                                                                 // bytes 18 to 25
  UINT8 symbol_short[5];                                                                                                                                                      // bytes 26 to 30
  UINT16BE protected_bid_price_short;                                                                                                                                         // bytes 31 to 32
  UINT16BE protected_bid_size_short;                                                                                                                                          // bytes 33 to 34
  UINT16BE protected_ask_price_short;                                                                                                                                         // bytes 35 to 36
  UINT16BE protected_ask_size_short;                                                                                                                                          // bytes 37 to 38
  UINT8 quote_condition;                                                                                                                                                      // byte 39
  UINT8 sip_generated_update_flag;                                                                                                                                            // byte 40
  UINT8 luld_bbo_indicator;                                                                                                                                                   // byte 41
  UINT8 retail_interest_indicator;                                                                                                                                            // byte 42
  UINT8 nbbo_appendage_indicator;                                                                                                                                             // byte 43
  UINT8 luld_national_bbo_indicator;                                                                                                                                          // byte 44
  UINT8 bolo_appendage_indicator;                                                                                                                                             // byte 45
  UINT8 odd_lot_attachment_type;                                                                                                                                              // byte 46
  UINT16BE odd_lot_attachment_count;                                                                                                                                          // bytes 47 to 48
  OptionalNationalBboAppendageShortForm((nbbo_appendage_indicator == 0x32)) national_bbo_appendage_short_form;
  OptionalNationalBboAppendageLongForm((nbbo_appendage_indicator == 0x33)) national_bbo_appendage_long_form;
  OptionalBoloAppendageShortForm((bolo_appendage_indicator == 0x32)) bolo_appendage_short_form;
  OptionalBoloAppendageLongForm((bolo_appendage_indicator == 0x33)) bolo_appendage_long_form;
  OptionalBoloAppendageMpidForm((bolo_appendage_indicator == 0x35)) bolo_appendage_mpid_form;
  OptionalOddLotPriceLevelAttachmentShortForm((odd_lot_attachment_type == 0x32), (((UINT32) odd_lot_attachment_count) * 6)) odd_lot_price_level_attachment_short_form;
  OptionalOddLotPriceLevelAttachmentLongForm((odd_lot_attachment_type == 0x33), (((UINT32) odd_lot_attachment_count) * 12)) odd_lot_price_level_attachment_long_form;
  OptionalOddLotPriceLevelAttachmentAdfMpidForm((odd_lot_attachment_type == 0x35), (((UINT32) odd_lot_attachment_count) * 16)) odd_lot_price_level_attachment_adf_mpid_form;
} CombinedQuoteMessageShortFormMessage;

// FINRA ADF MPID Appendage
typedef struct _FinraAdfMpidAppendage {
  UINT8 bid_adf_mpid[4];  // bytes 0 to 3
  UINT8 ask_adf_mpid[4];  // bytes 4 to 7
} FinraAdfMpidAppendage;

// FINRA ADF MPID Appendage
casetype _OptionalFinraAdfMpidAppendage (Bool present) {
  switch (present) {
    case true: FinraAdfMpidAppendage finra_adf_mpid_appendage;
    case false: unit absent;
  }
} OptionalFinraAdfMpidAppendage;

// Long-format Combined Quotation Message. Combines protected quote and one or more odd lot quotes in a single message. Supported since the Odd Lot Release on April 27, 2026.
typedef struct _CombinedQuoteMessageLongFormMessage {
  UINT8 market_center_originator;                                                                                                                                             // byte 0
  UINT8 sub_market_center_id;                                                                                                                                                 // byte 1
  UINT64BE sip_timestamp;                                                                                                                                                     // bytes 2 to 9
  UINT64BE timestamp_1;                                                                                                                                                       // bytes 10 to 17
  UINT64BE participant_token;                                                                                                                                                 // bytes 18 to 25
  UINT64BE adf_timestamp;                                                                                                                                                     // bytes 26 to 33
  UINT8 symbol_long[11];                                                                                                                                                      // bytes 34 to 44
  UINT64BE protected_bid_price_long;                                                                                                                                          // bytes 45 to 52
  UINT32BE protected_bid_size_long;                                                                                                                                           // bytes 53 to 56
  UINT64BE protected_ask_price_long;                                                                                                                                          // bytes 57 to 64
  UINT32BE protected_ask_size_long;                                                                                                                                           // bytes 65 to 68
  UINT8 quote_condition;                                                                                                                                                      // byte 69
  UINT8 sip_generated_update_flag;                                                                                                                                            // byte 70
  UINT8 luld_bbo_indicator;                                                                                                                                                   // byte 71
  UINT8 retail_interest_indicator;                                                                                                                                            // byte 72
  UINT8 nbbo_appendage_indicator;                                                                                                                                             // byte 73
  UINT8 luld_national_bbo_indicator;                                                                                                                                          // byte 74
  UINT8 finra_adf_mpid_appendage_indicator;                                                                                                                                   // byte 75
  UINT8 bolo_appendage_indicator;                                                                                                                                             // byte 76
  UINT8 odd_lot_attachment_type;                                                                                                                                              // byte 77
  UINT16BE odd_lot_attachment_count;                                                                                                                                          // bytes 78 to 79
  OptionalNationalBboAppendageShortForm((nbbo_appendage_indicator == 0x32)) national_bbo_appendage_short_form;
  OptionalNationalBboAppendageLongForm((nbbo_appendage_indicator == 0x33)) national_bbo_appendage_long_form;
  OptionalFinraAdfMpidAppendage((finra_adf_mpid_appendage_indicator == 0x32)) finra_adf_mpid_appendage;
  OptionalBoloAppendageShortForm((bolo_appendage_indicator == 0x32)) bolo_appendage_short_form;
  OptionalBoloAppendageLongForm((bolo_appendage_indicator == 0x33)) bolo_appendage_long_form;
  OptionalBoloAppendageMpidForm((bolo_appendage_indicator == 0x35)) bolo_appendage_mpid_form;
  OptionalOddLotPriceLevelAttachmentShortForm((odd_lot_attachment_type == 0x32), (((UINT32) odd_lot_attachment_count) * 6)) odd_lot_price_level_attachment_short_form;
  OptionalOddLotPriceLevelAttachmentLongForm((odd_lot_attachment_type == 0x33), (((UINT32) odd_lot_attachment_count) * 12)) odd_lot_price_level_attachment_long_form;
  OptionalOddLotPriceLevelAttachmentAdfMpidForm((odd_lot_attachment_type == 0x35), (((UINT32) odd_lot_attachment_count) * 16)) odd_lot_price_level_attachment_adf_mpid_form;
} CombinedQuoteMessageLongFormMessage;

// Short Format Odd Lot Quotation Message. Contains one or more odd lots without a protected quote change. Supported since the Odd Lot Release on April 27, 2026.
