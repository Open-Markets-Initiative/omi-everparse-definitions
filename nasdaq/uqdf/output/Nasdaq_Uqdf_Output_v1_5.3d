// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Nasdaq_Uqdf_Output_v1_5.3d

// ---- Values ------------------------------------------------------------------

// Market Center Originator Id: one byte code
#define MARKET_CENTER_ORIGINATOR_ID_BYX 0x59                 // Byx
#define MARKET_CENTER_ORIGINATOR_ID_BZX 0x5A                 // Bzx
#define MARKET_CENTER_ORIGINATOR_ID_EDGA 0x4A                // Edga
#define MARKET_CENTER_ORIGINATOR_ID_EDGX 0x4B                // Edgx
#define MARKET_CENTER_ORIGINATOR_ID_CBOE 0x57                // Cboe
#define MARKET_CENTER_ORIGINATOR_ID_BX 0x42                  // Bx
#define MARKET_CENTER_ORIGINATOR_ID_PHLX 0x58                // Phlx
#define MARKET_CENTER_ORIGINATOR_ID_NASDAQ 0x51              // Nasdaq
#define MARKET_CENTER_ORIGINATOR_ID_ISE 0x49                 // Ise
#define MARKET_CENTER_ORIGINATOR_ID_NYSE 0x4E                // Nyse
#define MARKET_CENTER_ORIGINATOR_ID_ARCA 0x50                // Arca
#define MARKET_CENTER_ORIGINATOR_ID_AMERICAN 0x41            // American
#define MARKET_CENTER_ORIGINATOR_ID_NATIONAL 0x43            // National
#define MARKET_CENTER_ORIGINATOR_ID_CHICAGO 0x4D             // Chicago
#define MARKET_CENTER_ORIGINATOR_ID_FINRA 0x44               // Finra
#define MARKET_CENTER_ORIGINATOR_ID_IEX 0x56                 // Iex
#define MARKET_CENTER_ORIGINATOR_ID_LTSE 0x4C                // Ltse
#define MARKET_CENTER_ORIGINATOR_ID_PEARL 0x48               // Pearl
#define MARKET_CENTER_ORIGINATOR_ID_MEMX 0x55                // Memx
#define MARKET_CENTER_ORIGINATOR_ID_MARKET_INDEPENDENT 0x45  // Market Independent

// Sub Market Center Id: one byte code
#define SUB_MARKET_CENTER_ID_NYSE_TRF 0x4E                            // Nyse Trf
#define SUB_MARKET_CENTER_ID_NASDAQ_TRF_CARTERET 0x51                 // Nasdaq Trf Carteret
#define SUB_MARKET_CENTER_ID_NASDAQ_TRF_CHICAGO 0x42                  // Nasdaq Trf Chicago
#define SUB_MARKET_CENTER_ID_FINRA_ALTERNATIVE_DISPLAY_FACILITY 0x20  // Finra Alternative Display Facility

// Quote Condition: one byte code
#define QUOTE_CONDITION_MANUAL_ASK_AUTOMATED_BID 0x41                          // Manual Ask Automated Bid
#define QUOTE_CONDITION_MANUAL_BID_AUTOMATED_ASK 0x42                          // Manual Bid Automated Ask
#define QUOTE_CONDITION_FAST_TRADING 0x46                                      // Fast Trading
#define QUOTE_CONDITION_MANUAL_BID_AND_ASK 0x48                                // Manual Bid And Ask
#define QUOTE_CONDITION_ORDER_IMBALANCE 0x49                                   // Order Imbalance
#define QUOTE_CONDITION_CLOSED_QUOTE 0x4C                                      // Closed Quote
#define QUOTE_CONDITION_NON_FIRM_QUOTE 0x4E                                    // Non Firm Quote
#define QUOTE_CONDITION_OPENING_QUOTE_AUTOMATED 0x4F                           // Opening Quote Automated
#define QUOTE_CONDITION_REGULAR_TWO_SIDED_OPEN_QUOTE_AUTOMATED 0x52            // Regular Two Sided Open Quote Automated
#define QUOTE_CONDITION_MANUAL_BID_AND_ASK_NON_FIRM 0x55                       // Manual Bid And Ask Non Firm
#define QUOTE_CONDITION_ORDER_INFLUX 0x58                                      // Order Influx
#define QUOTE_CONDITION_AUTOMATED_BID_NO_OFFER_OR_AUTOMATED_OFFER_NO_BID 0x59  // Automated Bid No Offer Or Automated Offer No Bid
#define QUOTE_CONDITION_NO_OPEN_NO_RESUME 0x5A                                 // No Open No Resume
#define QUOTE_CONDITION_INTRADAY_AUCTION 0x34                                  // Intraday Auction

// Sip Generated Update: one byte code
#define SIP_GENERATED_UPDATE_ORIGINATED_FROM_THE_MARKET_PARTICIPANT 0x20  // Originated From The Market Participant
#define SIP_GENERATED_UPDATE_SIP_GENERATED_TRANSACTION 0x45               // Sip Generated Transaction

// Luld Bbo Indicator: one byte code
#define LULD_BBO_INDICATOR_NOT_APPLICABLE 0x20                          // Not Applicable
#define LULD_BBO_INDICATOR_BID_PRICE_ABOVE_UPPER_LIMIT_PRICE_BAND 0x41  // Bid Price Above Upper Limit Price Band
#define LULD_BBO_INDICATOR_ASK_PRICE_BELOW_LOWER_LIMIT_PRICE_BAND 0x42  // Ask Price Below Lower Limit Price Band
#define LULD_BBO_INDICATOR_BID_AND_ASK_OUTSIDE_PRICE_BAND 0x43          // Bid And Ask Outside Price Band

// Retail Interest Indicator: one byte code
#define RETAIL_INTEREST_INDICATOR_NOT_APPLICABLE 0x20             // Not Applicable
#define RETAIL_INTEREST_INDICATOR_ON_BID_QUOTE 0x41               // On Bid Quote
#define RETAIL_INTEREST_INDICATOR_ON_ASK_QUOTE 0x42               // On Ask Quote
#define RETAIL_INTEREST_INDICATOR_ON_BOTH_BID_AND_ASK_QUOTE 0x43  // On Both Bid And Ask Quote

// Nbbo Appendage Indicator: one byte code
#define NBBO_APPENDAGE_INDICATOR_NO_NATIONAL_BBO_CHANGE 0x30                       // No National Bbo Change
#define NBBO_APPENDAGE_INDICATOR_NO_NATIONAL_BBO_CAN_BE_CALCULATED 0x31            // No National Bbo Can Be Calculated
#define NBBO_APPENDAGE_INDICATOR_SHORT_FORM_NATIONAL_BBO_APPENDAGE 0x32            // Short Form National Bbo Appendage
#define NBBO_APPENDAGE_INDICATOR_LONG_FORM_NATIONAL_BBO_APPENDAGE 0x33             // Long Form National Bbo Appendage
#define NBBO_APPENDAGE_INDICATOR_QUOTE_CONTAINS_ALL_NATIONAL_BBO_INFORMATION 0x34  // Quote Contains All National Bbo Information

// Luld National Bbo Indicator: one byte code
#define LULD_NATIONAL_BBO_INDICATOR_NOT_APPLICABLE 0x20                                                                    // Not Applicable
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_BID_AND_NATIONAL_BEST_ASK_ARE_EXECUTABLE 0x41                            // National Best Bid And National Best Ask Are Executable
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_BID_BELOW_LOWER_LIMIT_PRICE_BAND 0x42                                    // National Best Bid Below Lower Limit Price Band
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_ASK_ABOVE_UPPER_LIMIT_PRICE_BAND 0x43                                    // National Best Ask Above Upper Limit Price Band
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_BID_BELOW_LOWER_LIMIT_PRICE_BAND_AND_NATIONAL_BEST_ASK_ABOV_ek9s4j 0x44  // National Best Bid Below Lower Limit Price Band And National Best Ask Above Upper Limit Price Band
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_BID_EQUALS_UPPER_LIMIT_PRICE_BAND 0x45                                   // National Best Bid Equals Upper Limit Price Band
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_OFFER_EQUALS_LOWER_LIMIT_PRICE_BAND 0x46                                 // National Best Offer Equals Lower Limit Price Band
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_BID_EQUALS_UPPER_LIMIT_PRICE_BAND_AND_NATIONAL_BEST_ASK_ABO_muyktk 0x47  // National Best Bid Equals Upper Limit Price Band And National Best Ask Above Upper Limit Price Band
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_ASK_EQUALS_LOWER_LIMIT_PRICE_BAND_AND_NATIONAL_BEST_BID_BEL_8i98gq 0x48  // National Best Ask Equals Lower Limit Price Band And National Best Bid Below Lower Limit Price Band
#define LULD_NATIONAL_BBO_INDICATOR_NATIONAL_BEST_BID_EQUALS_UPPER_LIMIT_PRICE_BAND_AND_NATIONAL_BEST_ASK_EQU_8yajsb 0x49  // National Best Bid Equals Upper Limit Price Band And National Best Ask Equals Lower Limit Price Band

// Nbbo Quote Condition: one byte code
#define NBBO_QUOTE_CONDITION_MANUAL_ASK_AUTOMATED_BID 0x41                          // Manual Ask Automated Bid
#define NBBO_QUOTE_CONDITION_MANUAL_BID_AUTOMATED_ASK 0x42                          // Manual Bid Automated Ask
#define NBBO_QUOTE_CONDITION_FAST_TRADING 0x46                                      // Fast Trading
#define NBBO_QUOTE_CONDITION_MANUAL_BID_AND_ASK 0x48                                // Manual Bid And Ask
#define NBBO_QUOTE_CONDITION_ORDER_IMBALANCE 0x49                                   // Order Imbalance
#define NBBO_QUOTE_CONDITION_CLOSED_QUOTE 0x4C                                      // Closed Quote
#define NBBO_QUOTE_CONDITION_NON_FIRM_QUOTE 0x4E                                    // Non Firm Quote
#define NBBO_QUOTE_CONDITION_OPENING_QUOTE_AUTOMATED 0x4F                           // Opening Quote Automated
#define NBBO_QUOTE_CONDITION_REGULAR_TWO_SIDED_OPEN_QUOTE_AUTOMATED 0x52            // Regular Two Sided Open Quote Automated
#define NBBO_QUOTE_CONDITION_MANUAL_BID_AND_ASK_NON_FIRM 0x55                       // Manual Bid And Ask Non Firm
#define NBBO_QUOTE_CONDITION_ORDER_INFLUX 0x58                                      // Order Influx
#define NBBO_QUOTE_CONDITION_AUTOMATED_BID_NO_OFFER_OR_AUTOMATED_OFFER_NO_BID 0x59  // Automated Bid No Offer Or Automated Offer No Bid
#define NBBO_QUOTE_CONDITION_NO_OPEN_NO_RESUME 0x5A                                 // No Open No Resume
#define NBBO_QUOTE_CONDITION_INTRADAY_AUCTION 0x34                                  // Intraday Auction

// Finra Adf Mpid Appendage Indicator: one byte code
#define FINRA_ADF_MPID_APPENDAGE_INDICATOR_NOT_APPLICABLE 0x20       // Not Applicable
#define FINRA_ADF_MPID_APPENDAGE_INDICATOR_NO_ADF_MPID_CHANGES 0x30  // No Adf Mpid Changes
#define FINRA_ADF_MPID_APPENDAGE_INDICATOR_NO_ADF_MPID_EXISTS 0x31   // No Adf Mpid Exists
#define FINRA_ADF_MPID_APPENDAGE_INDICATOR_ADF_MPI_DS_ATTACHED 0x32  // Adf Mpi Ds Attached

// Trading Action Code: one byte code
#define TRADING_ACTION_CODE_TRADING_HALT 0x48                              // Trading Halt
#define TRADING_ACTION_CODE_QUOTATION_RESUMPTION_INCLUDING_AFTER_EMA 0x51  // Quotation Resumption Including After Ema
#define TRADING_ACTION_CODE_TRADING_RESUMPTION 0x54                        // Trading Resumption
#define TRADING_ACTION_CODE_VOLATILITY_TRADING_PAUSE 0x50                  // Volatility Trading Pause

// Issue Type: one byte code
#define ISSUE_TYPE_AMERICAN_DEPOSITORY_RECEIPT 0x41    // American Depository Receipt
#define ISSUE_TYPE_BOND 0x42                           // Bond
#define ISSUE_TYPE_COMMON_STOCK 0x43                   // Common Stock
#define ISSUE_TYPE_DEPOSITORY_RECEIPT 0x46             // Depository Receipt
#define ISSUE_TYPE_RULE_144A 0x49                      // Rule 144a
#define ISSUE_TYPE_LIMITED_PARTNERSHIP 0x4C            // Limited Partnership
#define ISSUE_TYPE_NOTE 0x4E                           // Note
#define ISSUE_TYPE_ORDINARY_SHARES 0x4F                // Ordinary Shares
#define ISSUE_TYPE_PREFERRED_STOCK 0x50                // Preferred Stock
#define ISSUE_TYPE_OTHER_SECURITIES 0x51               // Other Securities
#define ISSUE_TYPE_RIGHTS 0x52                         // Rights
#define ISSUE_TYPE_SHARES_OF_BENEFICIAL_INTEREST 0x53  // Shares Of Beneficial Interest
#define ISSUE_TYPE_CONVERTIBLE_DEBENTURE 0x54          // Convertible Debenture
#define ISSUE_TYPE_UNIT 0x55                           // Unit
#define ISSUE_TYPE_UNITS_OF_BENEFICIAL_INTEREST 0x56   // Units Of Beneficial Interest
#define ISSUE_TYPE_WARRANT 0x57                        // Warrant

// Market Tier: one byte code
#define MARKET_TIER_NASDAQ_GLOBAL_SELECT_MARKET 0x51  // Nasdaq Global Select Market
#define MARKET_TIER_NASDAQ_GLOBAL_MARKET 0x47         // Nasdaq Global Market
#define MARKET_TIER_NASDAQ_CAPITAL_MARKET 0x53        // Nasdaq Capital Market

// Authenticity: one byte code
#define AUTHENTICITY_PRODUCTION 0x50  // Production
#define AUTHENTICITY_TEST 0x54        // Test
#define AUTHENTICITY_DEMO 0x44        // Demo
#define AUTHENTICITY_DELETED 0x58     // Deleted

// Short Sale Threshold Indicator: one byte code
#define SHORT_SALE_THRESHOLD_INDICATOR_ISSUE_IS_RESTRICTED 0x59      // Issue Is Restricted
#define SHORT_SALE_THRESHOLD_INDICATOR_ISSUE_IS_NOT_RESTRICTED 0x4E  // Issue Is Not Restricted
#define SHORT_SALE_THRESHOLD_INDICATOR_NOT_AVAILABLE 0x20            // Not Available

// Financial Status Indicator: one byte code
#define FINANCIAL_STATUS_INDICATOR_CREATIONS_AND_OR_REDEMPTIONS_SUSPENDED 0x43  // Creations And Or Redemptions Suspended
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT 0x44                               // Deficient
#define FINANCIAL_STATUS_INDICATOR_DELINQUENT 0x45                              // Delinquent
#define FINANCIAL_STATUS_INDICATOR_BANKRUPT 0x51                                // Bankrupt
#define FINANCIAL_STATUS_INDICATOR_NORMAL 0x4E                                  // Normal
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_AND_BANKRUPT 0x47                  // Deficient And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_AND_DELINQUENT 0x48                // Deficient And Delinquent
#define FINANCIAL_STATUS_INDICATOR_DELINQUENT_AND_BANKRUPT 0x4A                 // Delinquent And Bankrupt
#define FINANCIAL_STATUS_INDICATOR_DEFICIENT_DELINQUENT_AND_BANKRUPT 0x4B       // Deficient Delinquent And Bankrupt

// Reg Sho Action: one byte code
#define REG_SHO_ACTION_NO_PRICE_TEST_IN_EFFECT 0x30                           // No Price Test In Effect
#define REG_SHO_ACTION_REG_SHO_IN_EFFECT_DUE_TO_AN_INTRA_DAY_PRICE_DROP 0x31  // Reg Sho In Effect Due To An Intra Day Price Drop
#define REG_SHO_ACTION_REG_SHO_RESTRICTION_REMAINS_IN_EFFECT 0x32             // Reg Sho Restriction Remains In Effect

// Luld Price Band Indicator: one byte code
#define LULD_PRICE_BAND_INDICATOR_OPENING_UPDATE 0x41                                  // Opening Update
#define LULD_PRICE_BAND_INDICATOR_INTRA_DAY_UPDATE 0x42                                // Intra Day Update
#define LULD_PRICE_BAND_INDICATOR_RESTATED_VALUE 0x43                                  // Restated Value
#define LULD_PRICE_BAND_INDICATOR_SUSPENDED_DURING_TRADING_HALT_OR_TRADING_PAUSE 0x44  // Suspended During Trading Halt Or Trading Pause
#define LULD_PRICE_BAND_INDICATOR_RE_OPENING_UPDATE 0x45                               // Re Opening Update
#define LULD_PRICE_BAND_INDICATOR_OUTSIDE_PRICE_BAND_RULE_HOURS 0x46                   // Outside Price Band Rule Hours
#define LULD_PRICE_BAND_INDICATOR_NONE_PROVIDED 0x20                                   // None Provided

// Mwcb Status Level Indicator: one byte code
#define MWCB_STATUS_LEVEL_INDICATOR_LEVEL_1_BREACHED 0x31  // Level 1 Breached
#define MWCB_STATUS_LEVEL_INDICATOR_LEVEL_2_BREACHED 0x32  // Level 2 Breached
#define MWCB_STATUS_LEVEL_INDICATOR_LEVEL_3_BREACHED 0x33  // Level 3 Breached

// Special Condition: one byte code
#define SPECIAL_CONDITION_ONE_SIDED_NATIONAL_BBO_AT_MARKET_CLOSE 0x4F                          // One Sided National Bbo At Market Close
#define SPECIAL_CONDITION_TRADING_HALT_IN_EFFECT_AT_MARKET_CLOSE 0x48                          // Trading Halt In Effect At Market Close
#define SPECIAL_CONDITION_NO_ELIGIBLE_MARKET_PARTICIPANT_QUOTES_IN_ISSUE_AT_MARKET_CLOSE 0x4D  // No Eligible Market Participant Quotes In Issue At Market Close
#define SPECIAL_CONDITION_NO_SPECIAL_CONDITION_EXISTS 0x20                                     // No Special Condition Exists

// ---- Types -------------------------------------------------------------------

// Message Info
typedef struct _MessageInfo {
  UINT8 market_center_originator_id;  // byte 0
  UINT8 sub_market_center_id;         // byte 1
  UINT64BE sip_timestamp;             // bytes 2 to 9
  UINT64BE participant_timestamp;     // bytes 10 to 17
  UINT64BE participant_token;         // bytes 18 to 25
} MessageInfo;

// Short Form National BBO Appendage
typedef struct _ShortFormNationalBboAppendage {
  UINT8 nbbo_quote_condition;              // byte 0
  UINT8 national_best_bid_market_center;   // byte 1
  UINT16BE national_best_bid_price_short;  // bytes 2 to 3
  UINT16BE national_best_bid_size_short;   // bytes 4 to 5
  UINT8 national_best_ask_market_center;   // byte 6
  UINT16BE national_best_ask_price_short;  // bytes 7 to 8
  UINT16BE national_best_ask_size_short;   // bytes 9 to 10
} ShortFormNationalBboAppendage;

// Short Form National BBO Appendage
casetype _OptionalShortFormNationalBboAppendage (Bool present) {
  switch (present) {
    case true: ShortFormNationalBboAppendage short_form_national_bbo_appendage;
    case false: unit absent;
  }
} OptionalShortFormNationalBboAppendage;

// Long Form National BBO Appendage
typedef struct _LongFormNationalBboAppendage {
  UINT8 nbbo_quote_condition;    // byte 0
  UINT8 best_bid_market_center;  // byte 1
  UINT64BE best_bid_price;       // bytes 2 to 9
  UINT32BE best_bid_size;        // bytes 10 to 13
  UINT8 best_ask_market_center;  // byte 14
  UINT64BE best_ask_price;       // bytes 15 to 22
  UINT32BE best_ask_size;        // bytes 23 to 26
} LongFormNationalBboAppendage;

// Long Form National BBO Appendage
casetype _OptionalLongFormNationalBboAppendage (Bool present) {
  switch (present) {
    case true: LongFormNationalBboAppendage long_form_national_bbo_appendage;
    case false: unit absent;
  }
} OptionalLongFormNationalBboAppendage;

// Used to disseminate quotation data for NASDAQ listed securities
typedef struct _QuoteShortFormMessage {
  MessageInfo message_info;                                                                                     // bytes 0 to 25
  UINT8 symbol_short[5];                                                                                        // bytes 26 to 30
  UINT16BE bid_price_short;                                                                                     // bytes 31 to 32
  UINT16BE bid_size_short;                                                                                      // bytes 33 to 34
  UINT16BE ask_price_short;                                                                                     // bytes 35 to 36
  UINT16BE ask_size_short;                                                                                      // bytes 37 to 38
  UINT8 quote_condition;                                                                                        // byte 39
  UINT8 sip_generated_update;                                                                                   // byte 40
  UINT8 luld_bbo_indicator;                                                                                     // byte 41
  UINT8 retail_interest_indicator;                                                                              // byte 42
  UINT8 nbbo_appendage_indicator;                                                                               // byte 43
  UINT8 luld_national_bbo_indicator;                                                                            // byte 44
  OptionalShortFormNationalBboAppendage((nbbo_appendage_indicator == 0x32)) short_form_national_bbo_appendage;
  OptionalLongFormNationalBboAppendage((nbbo_appendage_indicator == 0x33)) long_form_national_bbo_appendage;
} QuoteShortFormMessage;

// FINRA ADF MPID Appendage
typedef struct _FinraAdfMpidAppendage {
  UINT8 bid_adf_mpid[4];  // bytes 0 to 3
  UINT8 ask_adf_mpid[4];  // bytes 4 to 7
} FinraAdfMpidAppendage;

// FINRA ADF MPID Appendage
casetype _OptionalFinraAdfMpidAppendage (Bool present) {
  switch (present) {
    case true: FinraAdfMpidAppendage finra_adf_mpid_appendage;
    case false: unit absent;
  }
} OptionalFinraAdfMpidAppendage;

// Used to disseminate quotation data for NASDAQ listed securities
typedef struct _QuoteLongFormMessage {
  MessageInfo message_info;                                                                                     // bytes 0 to 25
  UINT64BE finra_timestamp;                                                                                     // bytes 26 to 33
  UINT8 symbol_long[11];                                                                                        // bytes 34 to 44
  UINT64BE bid_price;                                                                                           // bytes 45 to 52
  UINT32BE bid_size;                                                                                            // bytes 53 to 56
  UINT64BE ask_price;                                                                                           // bytes 57 to 64
  UINT32BE ask_size;                                                                                            // bytes 65 to 68
  UINT8 quote_condition;                                                                                        // byte 69
  UINT8 sip_generated_update;                                                                                   // byte 70
  UINT8 luld_bbo_indicator;                                                                                     // byte 71
  UINT8 retail_interest_indicator;                                                                              // byte 72
  UINT8 nbbo_appendage_indicator;                                                                               // byte 73
  UINT8 luld_national_bbo_indicator;                                                                            // byte 74
  UINT8 finra_adf_mpid_appendage_indicator;                                                                     // byte 75
  OptionalShortFormNationalBboAppendage((nbbo_appendage_indicator == 0x32)) short_form_national_bbo_appendage;
  OptionalLongFormNationalBboAppendage((nbbo_appendage_indicator == 0x33)) long_form_national_bbo_appendage;
  OptionalFinraAdfMpidAppendage((finra_adf_mpid_appendage_indicator == 0x32)) finra_adf_mpid_appendage;
} QuoteLongFormMessage;

// For FINRA quotes that do not affect the NBBO or FINRA BBO a FINRA ADF Market Participant Quotation Message will be sent.
typedef struct _FinraAdfMarketParticipantQuotationMessage {
  MessageInfo message_info;           // bytes 0 to 25
  UINT64BE finra_timestamp;           // bytes 26 to 33
  UINT8 symbol_long[11];              // bytes 34 to 44
  UINT64BE bid_price;                 // bytes 45 to 52
  UINT32BE bid_size;                  // bytes 53 to 56
  UINT64BE ask_price;                 // bytes 57 to 64
  UINT32BE ask_size;                  // bytes 65 to 68
  UINT8 quote_condition;              // byte 69
  UINT8 finra_market_participant[4];  // bytes 70 to 73
} FinraAdfMarketParticipantQuotationMessage;

// Branch
casetype _QuoteMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x45: QuoteShortFormMessage quote_short_form_message;
    case 0x46: QuoteLongFormMessage quote_long_form_message;
    case 0x4D: FinraAdfMarketParticipantQuotationMessage finra_adf_market_participant_quotation_message;
    default: UINT8 unknown[available];
  }
} QuoteMessagePayload;

// Quote Messages
typedef struct _QuoteMessage (UINT32 available) where (available >= 1) {
  UINT8 quote_message_type;                                                                                                         // byte 0
  QuoteMessagePayload(quote_message_type, (available - 1)) quote_message_payload[:byte-size-single-element-array (available - 1)];
} QuoteMessage;

// General Administrative
typedef struct _GeneralAdministrativeMessage {
  MessageInfo message_info;            // bytes 0 to 25
  UINT16BE text_length;                // bytes 26 to 27
  UINT8 text[((UINT32) text_length)];
} GeneralAdministrativeMessage;

// This fixed format message will be used to inform subscribers of trading actions such as halts, pauses, quotation resumptions and trading resumptions
typedef struct _CrossSroTradingActionMessage {
  MessageInfo message_info;                 // bytes 0 to 25
  UINT8 symbol_long[11];                    // bytes 26 to 36
  UINT8 trading_action_code;                // byte 37
  UINT32BE trading_action_sequence_number;  // bytes 38 to 41
  UINT64BE action_timestamp;                // bytes 42 to 49
  UINT8 trading_action_reason[6];           // bytes 50 to 55
} CrossSroTradingActionMessage;

// This fixed format message will inform UTP data feed subscribers of when a UTP participant invokes or releases a market center-specific trading halt for a NASDAQ-listed security.
typedef struct _MarketCenterTradingActionMessage {
  MessageInfo message_info;        // bytes 0 to 25
  UINT8 symbol_long[11];           // bytes 26 to 36
  UINT8 trading_action_code;       // byte 37
  UINT64BE action_timestamp;       // bytes 38 to 45
  UINT8 market_center_identifier;  // byte 46
} MarketCenterTradingActionMessage;

// General Administrative
typedef struct _IssueSymbolDirectoryMessage {
  MessageInfo message_info;              // bytes 0 to 25
  UINT8 symbol_long[11];                 // bytes 26 to 36
  UINT8 old_symbol[11];                  // bytes 37 to 47
  UINT8 issue_name[30];                  // bytes 48 to 77
  UINT8 issue_type;                      // byte 78
  UINT8 issue_subtype[2];                // bytes 79 to 80
  UINT8 market_tier;                     // byte 81
  UINT8 authenticity;                    // byte 82
  UINT8 short_sale_threshold_indicator;  // byte 83
  UINT16BE round_lot_size;               // bytes 84 to 85
  UINT8 financial_status_indicator;      // byte 86
} IssueSymbolDirectoryMessage;

// Used to disseminate quotation data for NASDAQ listed securities
typedef struct _RegulationShoShortSalePriceTestRestrictedIndicatorMessage {
  MessageInfo message_info;  // bytes 0 to 25
  UINT8 symbol_short[5];     // bytes 26 to 30
  UINT8 reg_sho_action;      // byte 31
} RegulationShoShortSalePriceTestRestrictedIndicatorMessage;

// Designed to prevent trades in individual NMS Stocks from occurring outside of specified Upper and Lower Limit Price Bands
typedef struct _LimitUpLimitDownPriceBandMessage {
  MessageInfo message_info;         // bytes 0 to 25
  UINT8 symbol_long[11];            // bytes 26 to 36
  UINT8 luld_price_band_indicator;  // byte 37
  UINT64BE luld_timestamp;          // bytes 38 to 45
  UINT64BE limit_down_price;        // bytes 46 to 53
  UINT64BE limit_up_price;          // bytes 54 to 61
} LimitUpLimitDownPriceBandMessage;

// A Market Wide Circuit Breaker (MWCB) Level message will inform participants and the UTP data recipients what the daily MWCB breach points are set to for the current trading day
typedef struct _MarketWideCircuitBreakerDeclineLevelMessage {
  MessageInfo message_info;  // bytes 0 to 25
  UINT64BE mwcb_level_1;     // bytes 26 to 33
  UINT64BE mwcb_level_2;     // bytes 34 to 41
  UINT64BE mwcb_level_3;     // bytes 42 to 49
} MarketWideCircuitBreakerDeclineLevelMessage;

// A Market Wide Circuit Breaker (MWCB) Status message will inform participants and the UTP data recipients when a MWCB has breached one of the established levels.
typedef struct _MarketWideCircuitBreakerStatusMessage {
  MessageInfo message_info;           // bytes 0 to 25
  UINT8 mwcb_status_level_indicator;  // byte 26
} MarketWideCircuitBreakerStatusMessage;

// Primary markets using an automated reopening will calculate new Auction Collars, in compliance with rules around prices for re-opening, when applicable and publish this new Auction Collar Message
typedef struct _AuctionCollarMessage {
  MessageInfo message_info;                 // bytes 0 to 25
  UINT8 symbol_long[11];                    // bytes 26 to 36
  UINT32BE trading_action_sequence_number;  // bytes 37 to 40
  UINT64BE collar_reference_price;          // bytes 41 to 48
  UINT64BE collar_up_price;                 // bytes 49 to 56
  UINT64BE collar_down_price;               // bytes 57 to 64
  UINT8 collar_extension_indicator;         // byte 65
} AuctionCollarMessage;

// At the request of the market data community, the UTP SIP generates a Session Close Recap message that reflects the National BBO quotation information at the close of the normal market session
typedef struct _MarketCenterCloseRecap {
  UINT8 market_center_identifier;    // byte 0
  UINT64BE market_center_bid_price;  // bytes 1 to 8
  UINT64BE market_center_bid_size;   // bytes 9 to 16
  UINT64BE market_center_ask_price;  // bytes 17 to 24
  UINT64BE market_center_ask_size;   // bytes 25 to 32
} MarketCenterCloseRecap;

// At the request of the market data community, the UTP SIP generates a Session Close Recap message that reflects the National BBO quotation information at the close of the normal market session
typedef struct _SessionCloseRecapMessage {
  MessageInfo message_info;                                                                                            // bytes 0 to 25
  UINT8 symbol_long[11];                                                                                               // bytes 26 to 36
  UINT8 national_best_bid_market_center;                                                                               // byte 37
  UINT64BE national_best_bid_price;                                                                                    // bytes 38 to 45
  UINT64BE national_best_bid_size;                                                                                     // bytes 46 to 53
  UINT8 national_best_ask_market_center;                                                                               // byte 54
  UINT64BE national_best_ask_price;                                                                                    // bytes 55 to 62
  UINT64BE national_best_ask_size;                                                                                     // bytes 63 to 70
  UINT8 special_condition;                                                                                             // byte 71
  UINT16BE number_of_market_center_attachments;                                                                        // bytes 72 to 73
  MarketCenterCloseRecap market_center_close_recap[:byte-size (((UINT32) number_of_market_center_attachments) * 33)];
} SessionCloseRecapMessage;

// Branch
casetype _AdministrativeMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: GeneralAdministrativeMessage general_administrative_message;
    case 0x48: CrossSroTradingActionMessage cross_sro_trading_action_message;
    case 0x4B: MarketCenterTradingActionMessage market_center_trading_action_message;
    case 0x42: IssueSymbolDirectoryMessage issue_symbol_directory_message;
    case 0x56: RegulationShoShortSalePriceTestRestrictedIndicatorMessage regulation_sho_short_sale_price_test_restricted_indicator_message;
    case 0x50: LimitUpLimitDownPriceBandMessage limit_up_limit_down_price_band_message;
    case 0x43: MarketWideCircuitBreakerDeclineLevelMessage market_wide_circuit_breaker_decline_level_message;
    case 0x44: MarketWideCircuitBreakerStatusMessage market_wide_circuit_breaker_status_message;
    case 0x45: AuctionCollarMessage auction_collar_message;
    case 0x52: SessionCloseRecapMessage session_close_recap_message;
    default: UINT8 unknown[available];
  }
} AdministrativeMessagePayload;

// Administrative Messages
typedef struct _AdministrativeMessage (UINT32 available) where (available >= 1) {
  UINT8 administrative_message_type;                                                                                                                           // byte 0
  AdministrativeMessagePayload(administrative_message_type, (available - 1)) administrative_message_payload[:byte-size-single-element-array (available - 1)];
} AdministrativeMessage;

// The Start of Day control message signifies the beginning of each operational cycle for SIP Processing
typedef struct _StartOfDayMessage {
  MessageInfo message_info;  // bytes 0 to 25
} StartOfDayMessage;

// The End of Day control message signals the end of active message dissemination for the UTP SIP operational cycle
typedef struct _EndOfDayMessage {
  MessageInfo message_info;  // bytes 0 to 25
} EndOfDayMessage;

// The Market Session Open Control Message signifies the opening of market systems for the session indicated in the Message Header
typedef struct _MarketSessionOpenMessage {
  MessageInfo message_info;  // bytes 0 to 25
} MarketSessionOpenMessage;

// The Session Close Control Message signals the closing of market systems for the session indicated in the Message Header
typedef struct _MarketSessionCloseMessage {
  MessageInfo message_info;  // bytes 0 to 25
} MarketSessionCloseMessage;

// The End of Transmissions Message signals that there will be no further transmissions of data sent through the UTP SIP line
typedef struct _EndOfTransmissionsMessage {
  MessageInfo message_info;  // bytes 0 to 25
} EndOfTransmissionsMessage;

// The Quote Wipe-Out message will be sent to indicate that a UTP Participant is experiencing a problem with their internal systems and, as a result, are not able to update their UTP BBO quotation information
typedef struct _QuoteWipeOutMessage {
  MessageInfo message_info;  // bytes 0 to 25
} QuoteWipeOutMessage;

// Branch
casetype _ControlMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x49: StartOfDayMessage start_of_day_message;
    case 0x4A: EndOfDayMessage end_of_day_message;
    case 0x4F: MarketSessionOpenMessage market_session_open_message;
    case 0x43: MarketSessionCloseMessage market_session_close_message;
    case 0x5A: EndOfTransmissionsMessage end_of_transmissions_message;
    case 0x50: QuoteWipeOutMessage quote_wipe_out_message;
    default: UINT8 unknown[available];
  }
} ControlMessagePayload;

// Control Messages
typedef struct _ControlMessage (UINT32 available) where (available >= 1) {
  UINT8 control_message_type;                                                                                                             // byte 0
  ControlMessagePayload(control_message_type, (available - 1)) control_message_payload[:byte-size-single-element-array (available - 1)];
} ControlMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x51: QuoteMessage(available) quote_message;
    case 0x41: AdministrativeMessage(available) administrative_message;
    case 0x43: ControlMessage(available) control_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 2 };                                                                                                                 // bytes 0 to 1
  UINT8 version;                                                                                                                                                   // byte 2
  UINT8 message_category;                                                                                                                                          // byte 3
  Payload(message_category, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                        // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                 // bytes 10 to 17
  UINT16BE message_count;                                                                                                   // bytes 18 to 19
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 20)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} Packet;

