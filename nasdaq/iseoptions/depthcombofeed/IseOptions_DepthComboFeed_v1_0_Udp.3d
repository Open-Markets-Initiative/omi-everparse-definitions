// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out IseOptions_DepthComboFeed_v1_0_Udp.3d
//
// What this definition reads more loosely than the model states:
// - a count of entries of no fixed width, whose entries hold a counted run of their own, is not checked: the entries fill what is left of their frame

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                // System Event Message
#define MESSAGE_TYPE_COMPLEX_STRATEGY_DIRECTORY_MESSAGE 0x52  // Complex Strategy Directory Message
#define MESSAGE_TYPE_STRATEGY_TRADING_ACTION_MESSAGE 0x48     // Strategy Trading Action Message
#define MESSAGE_TYPE_STRATEGY_OPEN_CLOSED_MESSAGE 0x4F        // Strategy Open Closed Message
#define MESSAGE_TYPE_STRATEGY_DEPTH_INCREMENTAL_MESSAGE 0x4B  // Strategy Depth Incremental Message
#define MESSAGE_TYPE_COMPLEX_STRATEGY_TICKER_MESSAGE 0x74     // Complex Strategy Ticker Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F                      // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53                  // Start Of System Hours
#define EVENT_CODE_START_OF_OPENING_PROCESS 0x51               // Start Of Opening Process
#define EVENT_CODE_START_OF_NORMAL_HOURS_CLOSING_PROCESS 0x4E  // Start Of Normal Hours Closing Process
#define EVENT_CODE_START_OF_LATE_HOURS_CLOSING_PROCESS 0x4C    // Start Of Late Hours Closing Process
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45                    // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                        // End Of Messages
#define EVENT_CODE_END_OF_WCO_EARLY_CLOSING 0x57               // End Of Wco Early Closing

// Strategy Type: one byte code
#define STRATEGY_TYPE_VERTICAL_SPREAD 0x56  // Vertical Spread
#define STRATEGY_TYPE_TIME_SPREAD 0x54      // Time Spread
#define STRATEGY_TYPE_DIAGONAL_SPREAD 0x44  // Diagonal Spread
#define STRATEGY_TYPE_STRADDLE 0x53         // Straddle
#define STRATEGY_TYPE_STRANGLE 0x47         // Strangle
#define STRATEGY_TYPE_COMBO 0x43            // Combo
#define STRATEGY_TYPE_RISK_REVERSAL 0x52    // Risk Reversal
#define STRATEGY_TYPE_RATIO_SPREAD 0x41     // Ratio Spread
#define STRATEGY_TYPE_CUSTOM 0x55           // Custom

// Option Type: one byte code
#define OPTION_TYPE_CALL 0x43  // Call
#define OPTION_TYPE_PUT 0x50   // Put
#define OPTION_TYPE_NA 0x20    // Na

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_HALT_IN_EFFECT 0x48  // Halt In Effect
#define CURRENT_TRADING_STATE_TRADING 0x54         // Trading

// Open State: one byte code
#define OPEN_STATE_OPEN 0x59    // Open
#define OPEN_STATE_CLOSED 0x4E  // Closed

// Quote Condition: one byte code
#define QUOTE_CONDITION_REGULAR_QUOTE 0x20  // Regular Quote
#define QUOTE_CONDITION_HALTED 0x58         // Halted

// Update Action: one byte code
#define UPDATE_ACTION_NEW 0x4E          // New
#define UPDATE_ACTION_CHANGE 0x43       // Change
#define UPDATE_ACTION_DELETE 0x44       // Delete
#define UPDATE_ACTION_DELETE_FROM 0x46  // Delete From

// Depth Side: one byte code
#define DEPTH_SIDE_BID 0x42  // Bid
#define DEPTH_SIDE_ASK 0x41  // Ask

// ---- Types -------------------------------------------------------------------

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT8 timestamp[6];     // bytes 0 to 5
  UINT8 event_code;       // byte 6
  UINT16BE current_year;  // bytes 7 to 8
  UINT8 current_month;    // byte 9
  UINT8 current_day;      // byte 10
  UINT8 version;          // byte 11
  UINT8 sub_version;      // byte 12
} SystemEventMessage;

// Leg information, legs repeated. n = 0, 1 and so on...
typedef struct _LegInformation {
  UINT32BE option_id;              // bytes 0 to 3
  UINT8 security_symbol[6];        // bytes 4 to 9
  UINT8 leg_id;                    // byte 10
  UINT8 expiration_year;           // byte 11
  UINT8 expiration_month;          // byte 12
  UINT8 expiration_day;            // byte 13
  UINT64BE explicit_strike_price;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 option_type;               // byte 22
  UINT8 side;                      // byte 23
  UINT32BE leg_ratio;              // bytes 24 to 27
} LegInformation;

// Whenever a complex order is added in the system for an underlying, the order is normalized and results in either the creation of a new complex strategy or is added to an existing strategy. A Complex Strategy Message containing the strategy definition will be sent.
typedef struct _ComplexStrategyDirectoryMessage {
  UINT8 timestamp[6];                                                           // bytes 0 to 5
  UINT32BE strategy_id;                                                         // bytes 6 to 9
  UINT8 strategy_type;                                                          // byte 10
  UINT8 source;                                                                 // byte 11
  UINT8 underlying_symbol[13];                                                  // bytes 12 to 24
  UINT8 number_of_legs;                                                         // byte 25
  LegInformation leg_information[:byte-size (((UINT32) number_of_legs) * 28)];
} ComplexStrategyDirectoryMessage;

// ISE uses this administrative message to indicate the current trading status of a strategy within the ISE Options Market. Messages will be sent when the strategy is halted or is released for trading.
typedef struct _StrategyTradingActionMessage {
  UINT8 timestamp[6];           // bytes 0 to 5
  UINT32BE strategy_id;         // bytes 6 to 9
  UINT8 current_trading_state;  // byte 10
} StrategyTradingActionMessage;

// The options system uses this administrative message to indicate when a strategy has completed the opening process and is now available for auto execution or when the option has closed and is no longer available for auto execution.
typedef struct _StrategyOpenClosedMessage {
  UINT8 timestamp[6];    // bytes 0 to 5
  UINT32BE strategy_id;  // bytes 6 to 9
  UINT8 open_state;      // byte 10
} StrategyOpenClosedMessage;

// Price level s price (fixed point format with 6 whole number places followed by 4 decimal digits). Present for New and Change Update Actions only.
casetype _OptionalPrice (Bool present) {
  switch (present) {
    case true: UINT32BE price;
    case false: unit absent;
  }
} OptionalPrice;

// Last traded quantity.
casetype _OptionalSize (Bool present) {
  switch (present) {
    case true: UINT32BE size;
    case false: unit absent;
  }
} OptionalSize;

// Aggregated Customer Professional quantity in the price level. Present for New and Change Update Actions only.
casetype _OptionalCustSize (Bool present) {
  switch (present) {
    case true: UINT32BE cust_size;
    case false: unit absent;
  }
} OptionalCustSize;

// Aggregated Customer quantity in the price level. Present for New and Change Update Actions only.
casetype _OptionalProCustSize (Bool present) {
  switch (present) {
    case true: UINT32BE pro_cust_size;
    case false: unit absent;
  }
} OptionalProCustSize;

// Limit size that can t be traded through. Present for New and Change Update Actions only.
casetype _OptionalNttSize (Bool present) {
  switch (present) {
    case true: UINT32BE ntt_size;
    case false: unit absent;
  }
} OptionalNttSize;

// One update of one side of one price level. The Price, Size, Cust Size, ProCust Size and NTTSize fields are present for New and Change Update Actions only; if Update Action is Delete or Delete From they are absent, so the entry is 23 or 3 bytes long.
typedef struct _DepthIncrementals (mutable UINT32 * tally) {
  UINT8 update_action;                                                                                                                                             // byte 0
  UINT8 depth_side;                                                                                                                                                // byte 1
  UINT8 level;                                                                                                                                                     // byte 2
  OptionalPrice(((update_action == 0x4E) || (update_action == 0x43))) price;
  OptionalSize(((update_action == 0x4E) || (update_action == 0x43))) size;
  OptionalCustSize(((update_action == 0x4E) || (update_action == 0x43))) cust_size;
  OptionalProCustSize(((update_action == 0x4E) || (update_action == 0x43))) pro_cust_size;
  OptionalNttSize(((update_action == 0x4E) || (update_action == 0x43))) ntt_size;
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} DepthIncrementals;

// This message is used to send information regarding any of the top five price levels of an option s order book. The message may contain multiple repeating items, each of which updates one side of one price level. All repeating items within the message relate to the same option.
typedef struct _StrategyDepthIncrementalMessage (UINT32 available, mutable UINT32 * tally) where (available >= 28) {
  UINT8 timestamp[6];                                                                                                                                 // bytes 0 to 5
  UINT32BE strategy_id;                                                                                                                               // bytes 6 to 9
  UINT8 quote_condition;                                                                                                                              // byte 10
  UINT32BE bid_market_size;                                                                                                                           // bytes 11 to 14
  UINT32BE ask_market_size;                                                                                                                           // bytes 15 to 18
  UINT32BE bid_ntt_market_size;                                                                                                                       // bytes 19 to 22
  UINT32BE ask_ntt_market_size;                                                                                                                       // bytes 23 to 26
  UINT8 number_of_depth_incrementals;                                                                                                                 // byte 27
  unit depth_incrementals_tally_start {:on-success *tally = 0; return true; };
  DepthIncrementals(tally) depth_incrementals[:byte-size (available - 28)];
  unit depth_incrementals_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_of_depth_incrementals); };
} StrategyDepthIncrementalMessage;

// The ticker message is used to send real time trade information.
typedef struct _ComplexStrategyTickerMessage {
  UINT8 timestamp[6];     // bytes 0 to 5
  UINT32BE strategy_id;   // bytes 6 to 9
  UINT64BE last_price;    // bytes 10 to 17, signed, read here as unsigned
  UINT32BE size;          // bytes 18 to 21
  UINT32BE volume;        // bytes 22 to 25
  UINT64BE high;          // bytes 26 to 33, signed, read here as unsigned
  UINT64BE low;           // bytes 34 to 41, signed, read here as unsigned
  UINT64BE first;         // bytes 42 to 49, signed, read here as unsigned
  UINT8 trade_condition;  // byte 50
} ComplexStrategyTickerMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x52: ComplexStrategyDirectoryMessage complex_strategy_directory_message;
    case 0x48: StrategyTradingActionMessage strategy_trading_action_message;
    case 0x4F: StrategyOpenClosedMessage strategy_open_closed_message;
    case 0x4B: StrategyDepthIncrementalMessage(available, tally) strategy_depth_incremental_message;
    case 0x74: ComplexStrategyTickerMessage complex_strategy_ticker_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                         // bytes 0 to 1
  UINT8 message_type;                                                                                                                      // byte 2
  Payload(message_type, (((UINT32) message_length) - 1), tally) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
} Message;

// Branch
casetype _Messages (UINT16 selector, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: Message(tally) message[:byte-size available];
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                            // bytes 0 to 9
  UINT64BE sequence_number;                                                                                     // bytes 10 to 17
  UINT16BE message_count;                                                                                       // bytes 18 to 19
  Messages(message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

