// National Association of Securities Dealers Automated Quotations (Nasdaq) Ise Order Feed Market Data
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out IseOptions_OrderFeed_v1_1.3d
//
// What this definition does not state, and the model does:
// - the dispatch that chooses a message by its type
// - a run counted by a field
//
// License: MIT No Attribution

// ---- Packet Header: 20 bytes -------------------------------------------------

// Itch Mold Udp 64 Packet Header
entrypoint typedef struct _PacketHeader {
  UINT8 session[10];         // bytes 0 to 9
  UINT64BE sequence_number;  // bytes 10 to 17
  UINT16BE message_count;    // bytes 18 to 19
} PacketHeader;

// ---- Message Header: 3 bytes -------------------------------------------------

// Mold Udp 64 Message Header
entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;  // bytes 0 to 1
  UINT8 message_type;       // byte 2
} MessageHeader;

// ---- System Event Message: 13 bytes ------------------------------------------

// The system event message type is used to signal a market or data feed handler event.
entrypoint typedef struct _SystemEventMessage {
  UINT8 timestamp[6];     // bytes 0 to 5
  UINT8 event_code;       // byte 6
  UINT16BE current_year;  // bytes 7 to 8
  UINT8 current_month;    // byte 9
  UINT8 current_day;      // byte 10
  UINT8 version;          // byte 11
  UINT8 sub_version;      // byte 12
} SystemEventMessage;

// ---- Option Directory Message: 49 bytes --------------------------------------

// At the start of each trading day, the options system disseminates directory messages for all symbols eligible for trading in the options system.
entrypoint typedef struct _OptionDirectoryMessage {
  UINT8 timestamp[6];           // bytes 0 to 5
  UINT32BE option_id;           // bytes 6 to 9
  UINT8 security_symbol[6];     // bytes 10 to 15
  UINT8 expiration_year;        // byte 16
  UINT8 expiration_month;       // byte 17
  UINT8 expiration_day;         // byte 18
  UINT64BE strike_price;        // bytes 19 to 26
  UINT8 option_type;            // byte 27
  UINT8 source;                 // byte 28
  UINT8 underlying_symbol[13];  // bytes 29 to 41
  UINT8 trading_type;           // byte 42
  UINT16BE contract_size;       // bytes 43 to 44
  UINT8 option_closing_type;    // byte 45
  UINT8 tradable;               // byte 46
  UINT8 mpv;                    // byte 47
  UINT8 closing_only;           // byte 48
} OptionDirectoryMessage;

// ---- Trading Action Message: 11 bytes ----------------------------------------

// The options system uses this administrative message to indicate the current trading status of an index or equity option within the options market.
entrypoint typedef struct _TradingActionMessage {
  UINT8 timestamp[6];           // bytes 0 to 5
  UINT32BE option_id;           // bytes 6 to 9
  UINT8 current_trading_state;  // byte 10
} TradingActionMessage;

// ---- Security Open Closed Message: 11 bytes ----------------------------------

// The options system uses this administrative message to indicate when an option has completed the opening process and is now available for auto execution or when the option has closed and is no longer available for auto execution.
entrypoint typedef struct _SecurityOpenClosedMessage {
  UINT8 timestamp[6];  // bytes 0 to 5
  UINT32BE option_id;  // bytes 6 to 9
  UINT8 open_state;    // byte 10
} SecurityOpenClosedMessage;

// ---- Opening Imbalance Message: 23 bytes -------------------------------------

// Nasdaq disseminates Opening Imbalance information at regular intervals in the time leading up to the Nasdaq Opening Auction events.
entrypoint typedef struct _OpeningImbalanceMessage {
  UINT8 timestamp[6];         // bytes 0 to 5
  UINT32BE option_id;         // bytes 6 to 9
  UINT32BE paired_contracts;  // bytes 10 to 13
  UINT8 imbalance_direction;  // byte 14
  UINT32BE imbalance_price;   // bytes 15 to 18
  UINT32BE imbalance_volume;  // bytes 19 to 22
} OpeningImbalanceMessage;

// ---- Order On Book Message: 40 bytes -----------------------------------------

// An Order on Book message is generated for all the following situations whenever an order free from any display restrictions is reported by the matching engine.
entrypoint typedef struct _OrderOnBookMessage {
  UINT8 timestamp[6];    // bytes 0 to 5
  UINT32BE option_id;    // bytes 6 to 9
  UINT8 order_type;      // byte 10
  UINT8 side;            // byte 11
  UINT32BE price;        // bytes 12 to 15
  UINT32BE size;         // bytes 16 to 19
  UINT8 exec_flag;       // byte 20
  UINT8 order_capacity;  // byte 21
  UINT8 owner_id[6];     // bytes 22 to 27
  UINT8 giveup[6];       // bytes 28 to 33
  UINT8 cmta[6];         // bytes 34 to 39
} OrderOnBookMessage;

