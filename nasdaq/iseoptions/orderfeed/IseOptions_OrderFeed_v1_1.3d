// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out IseOptions_OrderFeed_v1_1.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53          // System Event Message
#define MESSAGE_TYPE_OPTION_DIRECTORY_MESSAGE 0x44      // Option Directory Message
#define MESSAGE_TYPE_TRADING_ACTION_MESSAGE 0x48        // Trading Action Message
#define MESSAGE_TYPE_SECURITY_OPEN_CLOSED_MESSAGE 0x4F  // Security Open Closed Message
#define MESSAGE_TYPE_OPENING_IMBALANCE_MESSAGE 0x4E     // Opening Imbalance Message
#define MESSAGE_TYPE_ORDER_ON_BOOK_MESSAGE 0x42         // Order On Book Message
#define MESSAGE_TYPE_AUCTION_MESSAGE 0x41               // Auction Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F                      // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53                  // Start Of System Hours
#define EVENT_CODE_START_OF_OPENING_PROCESS 0x51               // Start Of Opening Process
#define EVENT_CODE_START_OF_NORMAL_HOURS_CLOSING_PROCESS 0x4E  // Start Of Normal Hours Closing Process
#define EVENT_CODE_START_OF_LATE_HOURS_CLOSING_PROCESS 0x4C    // Start Of Late Hours Closing Process
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45                    // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                        // End Of Messages
#define EVENT_CODE_END_OF_WCO_EARLY_CLOSING 0x57               // End Of Wco Early Closing

// Option Type: one byte code
#define OPTION_TYPE_CALL 0x43  // Call
#define OPTION_TYPE_PUT 0x50   // Put

// Trading Type: one byte code
#define TRADING_TYPE_EQUITY 0x45    // Equity
#define TRADING_TYPE_INDEX 0x49     // Index
#define TRADING_TYPE_ETF 0x46       // Etf
#define TRADING_TYPE_CURRENCY 0x43  // Currency

// Option Closing Type: one byte code
#define OPTION_CLOSING_TYPE_NORMAL 0x4E  // Normal
#define OPTION_CLOSING_TYPE_LATE 0x4C    // Late

// Tradable: one byte code
#define TRADABLE_TRADABLE 0x59      // Tradable
#define TRADABLE_NOT_TRADABLE 0x4E  // Not Tradable

// Mpv: one byte code
#define MPV_PENNY_EVERYWHERE 0x45  // Penny Everywhere
#define MPV_SCALED 0x53            // Scaled
#define MPV_PENNY_PILOT 0x50       // Penny Pilot

// Closing Only: one byte code
#define CLOSING_ONLY_CLOSING_POSITION_ONLY 0x59      // Closing Position Only
#define CLOSING_ONLY_NOT_CLOSING_POSITION_ONLY 0x4E  // Not Closing Position Only

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_HALT_IN_EFFECT 0x48                 // Halt In Effect
#define CURRENT_TRADING_STATE_TRADING_ON_THE_OPTIONS_SYSTEM 0x54  // Trading On The Options System

// Open State: one byte code
#define OPEN_STATE_OPEN_FOR_AUTO_EXECUTION 0x59    // Open For Auto Execution
#define OPEN_STATE_CLOSED_FOR_AUTO_EXECUTION 0x4E  // Closed For Auto Execution

// Imbalance Direction: one byte code
#define IMBALANCE_DIRECTION_BUY_IMBALANCE 0x42   // Buy Imbalance
#define IMBALANCE_DIRECTION_SELL_IMBALANCE 0x53  // Sell Imbalance

// Order Type: one byte code
#define ORDER_TYPE_MARKET 0x4D  // Market
#define ORDER_TYPE_LIMIT 0x4C   // Limit

// Side: one byte code
#define SIDE_BID 0x42        // Bid
#define SIDE_OFFER_ASK 0x41  // Offer Ask
#define SIDE_HIDDEN 0x20     // Hidden

// Exec Flag: one byte code
#define EXEC_FLAG_NONE 0x4E    // None
#define EXEC_FLAG_AON 0x41     // Aon
#define EXEC_FLAG_HIDDEN 0x20  // Hidden

// Order Capacity: one byte code
#define ORDER_CAPACITY_CUSTOMER 0x43                // Customer
#define ORDER_CAPACITY_CUSTOMER_PROFESSIONAL 0x44   // Customer Professional
#define ORDER_CAPACITY_FIRM 0x46                    // Firm
#define ORDER_CAPACITY_BROKER_DEALER_CUSTOMER 0x42  // Broker Dealer Customer
#define ORDER_CAPACITY_BROKER_DEALER_FIRM 0x4B      // Broker Dealer Firm
#define ORDER_CAPACITY_PROPRIETARY 0x45             // Proprietary
#define ORDER_CAPACITY_AWAY_MARKET_MAKER 0x4E       // Away Market Maker
#define ORDER_CAPACITY_MARKET_MAKER 0x4D            // Market Maker

// Auction Event: one byte code
#define AUCTION_EVENT_START 0x53           // Start
#define AUCTION_EVENT_AUCTION_UPDATE 0x55  // Auction Update
#define AUCTION_EVENT_END_OF_AUCTION 0x45  // End Of Auction

// ---- Types -------------------------------------------------------------------

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT8 timestamp[6];     // bytes 0 to 5
  UINT8 event_code;       // byte 6
  UINT16BE current_year;  // bytes 7 to 8
  UINT8 current_month;    // byte 9
  UINT8 current_day;      // byte 10
  UINT8 version;          // byte 11
  UINT8 sub_version;      // byte 12
} SystemEventMessage;

// At the start of each trading day, the options system disseminates directory messages for all symbols eligible for trading in the options system.
typedef struct _OptionDirectoryMessage {
  UINT8 timestamp[6];           // bytes 0 to 5
  UINT32BE option_id;           // bytes 6 to 9
  UINT8 security_symbol[6];     // bytes 10 to 15
  UINT8 expiration_year;        // byte 16
  UINT8 expiration_month;       // byte 17
  UINT8 expiration_day;         // byte 18
  UINT64BE strike_price;        // bytes 19 to 26
  UINT8 option_type;            // byte 27
  UINT8 source;                 // byte 28
  UINT8 underlying_symbol[13];  // bytes 29 to 41
  UINT8 trading_type;           // byte 42
  UINT16BE contract_size;       // bytes 43 to 44
  UINT8 option_closing_type;    // byte 45
  UINT8 tradable;               // byte 46
  UINT8 mpv;                    // byte 47
  UINT8 closing_only;           // byte 48
} OptionDirectoryMessage;

// The options system uses this administrative message to indicate the current trading status of an index or equity option within the options market.
typedef struct _TradingActionMessage {
  UINT8 timestamp[6];           // bytes 0 to 5
  UINT32BE option_id;           // bytes 6 to 9
  UINT8 current_trading_state;  // byte 10
} TradingActionMessage;

// The options system uses this administrative message to indicate when an option has completed the opening process and is now available for auto execution or when the option has closed and is no longer available for auto execution.
typedef struct _SecurityOpenClosedMessage {
  UINT8 timestamp[6];  // bytes 0 to 5
  UINT32BE option_id;  // bytes 6 to 9
  UINT8 open_state;    // byte 10
} SecurityOpenClosedMessage;

// Nasdaq disseminates Opening Imbalance information at regular intervals in the time leading up to the Nasdaq Opening Auction events.
typedef struct _OpeningImbalanceMessage {
  UINT8 timestamp[6];         // bytes 0 to 5
  UINT32BE option_id;         // bytes 6 to 9
  UINT32BE paired_contracts;  // bytes 10 to 13
  UINT8 imbalance_direction;  // byte 14
  UINT32BE imbalance_price;   // bytes 15 to 18
  UINT32BE imbalance_volume;  // bytes 19 to 22
} OpeningImbalanceMessage;

// An Order on Book message is generated for all the following situations whenever an order free from any display restrictions is reported by the matching engine.
typedef struct _OrderOnBookMessage {
  UINT8 timestamp[6];    // bytes 0 to 5
  UINT32BE option_id;    // bytes 6 to 9
  UINT8 order_type;      // byte 10
  UINT8 side;            // byte 11
  UINT32BE price;        // bytes 12 to 15
  UINT32BE size;         // bytes 16 to 19
  UINT8 exec_flag;       // byte 20
  UINT8 order_capacity;  // byte 21
  UINT8 owner_id[6];     // bytes 22 to 27
  UINT8 giveup[6];       // bytes 28 to 33
  UINT8 cmta[6];         // bytes 34 to 39
} OrderOnBookMessage;

// Auction Response Information
typedef struct _AuctionResponse {
  UINT32BE response_price;  // bytes 0 to 3
  UINT32BE response_size;   // bytes 4 to 7
} AuctionResponse;

// This message is used to announce auctions. The start of auction is announced, followed by possible updates on the auction, and announcing the end of the auction.
typedef struct _AuctionMessage {
  UINT8 timestamp[6];                                                                 // bytes 0 to 5
  UINT32BE option_id;                                                                 // bytes 6 to 9
  UINT32BE auction_id;                                                                // bytes 10 to 13
  UINT8 order_type;                                                                   // byte 14
  UINT8 side;                                                                         // byte 15
  UINT32BE price;                                                                     // bytes 16 to 19
  UINT32BE size;                                                                      // bytes 20 to 23
  UINT8 exec_flag;                                                                    // byte 24
  UINT8 order_capacity;                                                               // byte 25
  UINT8 owner_id[6];                                                                  // bytes 26 to 31
  UINT8 giveup[6];                                                                    // bytes 32 to 37
  UINT8 cmta[6];                                                                      // bytes 38 to 43
  UINT8 auction_event;                                                                // byte 44
  UINT8 number_of_responses;                                                          // byte 45
  AuctionResponse auction_response[:byte-size (((UINT32) number_of_responses) * 8)];
} AuctionMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x44: OptionDirectoryMessage option_directory_message;
    case 0x48: TradingActionMessage trading_action_message;
    case 0x4F: SecurityOpenClosedMessage security_open_closed_message;
    case 0x4E: OpeningImbalanceMessage opening_imbalance_message;
    case 0x42: OrderOnBookMessage order_on_book_message;
    case 0x41: AuctionMessage auction_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

