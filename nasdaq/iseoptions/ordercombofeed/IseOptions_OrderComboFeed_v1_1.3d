// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out IseOptions_OrderComboFeed_v1_1.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                    // System Event Message
#define MESSAGE_TYPE_COMPLEX_STRATEGY_DIRECTORY_MESSAGE 0x52      // Complex Strategy Directory Message
#define MESSAGE_TYPE_STRATEGY_TRADING_ACTION_MESSAGE 0x48         // Strategy Trading Action Message
#define MESSAGE_TYPE_STRATEGY_OPEN_CLOSED_MESSAGE 0x4F            // Strategy Open Closed Message
#define MESSAGE_TYPE_COMPLEX_STRATEGY_ORDER_ON_BOOK_MESSAGE 0x4C  // Complex Strategy Order On Book Message
#define MESSAGE_TYPE_COMPLEX_STRATEGY_AUCTION_MESSAGE 0x4A        // Complex Strategy Auction Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F                      // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53                  // Start Of System Hours
#define EVENT_CODE_START_OF_OPENING_PROCESS 0x51               // Start Of Opening Process
#define EVENT_CODE_START_OF_NORMAL_HOURS_CLOSING_PROCESS 0x4E  // Start Of Normal Hours Closing Process
#define EVENT_CODE_START_OF_LATE_HOURS_CLOSING_PROCESS 0x4C    // Start Of Late Hours Closing Process
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45                    // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43                        // End Of Messages
#define EVENT_CODE_END_OF_WCO_EARLY_CLOSING 0x57               // End Of Wco Early Closing

// Strategy Type: one byte code
#define STRATEGY_TYPE_VERTICAL_SPREAD 0x56  // Vertical Spread
#define STRATEGY_TYPE_TIME_SPREAD 0x54      // Time Spread
#define STRATEGY_TYPE_DIAGONAL_SPREAD 0x44  // Diagonal Spread
#define STRATEGY_TYPE_STRADDLE 0x53         // Straddle
#define STRATEGY_TYPE_STRANGLE 0x47         // Strangle
#define STRATEGY_TYPE_COMBO 0x43            // Combo
#define STRATEGY_TYPE_RISK_REVERSAL 0x52    // Risk Reversal
#define STRATEGY_TYPE_RATIO_SPREAD 0x41     // Ratio Spread
#define STRATEGY_TYPE_CUSTOM 0x55           // Custom

// Option Type: one byte code
#define OPTION_TYPE_CALL 0x43   // Call
#define OPTION_TYPE_PUT 0x50    // Put
#define OPTION_TYPE_STOCK 0x20  // Stock

// Leg Side: one byte code
#define LEG_SIDE_BUY 0x42   // Buy
#define LEG_SIDE_SELL 0x53  // Sell

// Current Trading State: one byte code
#define CURRENT_TRADING_STATE_HALT_IN_EFFECT 0x48   // Halt In Effect
#define CURRENT_TRADING_STATE_TRADING_RESUMED 0x54  // Trading Resumed

// Open State: one byte code
#define OPEN_STATE_OPEN_FOR_AUTO_EXECUTION 0x59    // Open For Auto Execution
#define OPEN_STATE_CLOSED_FOR_AUTO_EXECUTION 0x4E  // Closed For Auto Execution

// Order Type: one byte code
#define ORDER_TYPE_MARKET 0x4D  // Market
#define ORDER_TYPE_LIMIT 0x4C   // Limit

// Side: one byte code
#define SIDE_BID 0x42        // Bid
#define SIDE_OFFER_ASK 0x41  // Offer Ask
#define SIDE_HIDDEN 0x20     // Hidden

// Exec Flag: one byte code
#define EXEC_FLAG_NONE 0x4E  // None
#define EXEC_FLAG_AON 0x41   // Aon

// Order Capacity: one byte code
#define ORDER_CAPACITY_CUSTOMER 0x43                // Customer
#define ORDER_CAPACITY_CUSTOMER_PROFESSIONAL 0x44   // Customer Professional
#define ORDER_CAPACITY_FIRM 0x46                    // Firm
#define ORDER_CAPACITY_BROKER_DEALER_CUSTOMER 0x42  // Broker Dealer Customer
#define ORDER_CAPACITY_BROKER_DEALER_FIRM 0x4B      // Broker Dealer Firm
#define ORDER_CAPACITY_PROPRIETARY 0x45             // Proprietary
#define ORDER_CAPACITY_AWAY_MARKET_MAKER 0x4E       // Away Market Maker
#define ORDER_CAPACITY_MARKET_MAKER 0x4D            // Market Maker

// Scope: one byte code
#define SCOPE_LOCAL 0x4C     // Local
#define SCOPE_NATIONAL 0x4E  // National

// Auction Event: one byte code
#define AUCTION_EVENT_START 0x53           // Start
#define AUCTION_EVENT_AUCTION_UPDATE 0x55  // Auction Update
#define AUCTION_EVENT_END_OF_AUCTION 0x45  // End Of Auction

// Auction Type: one byte code
#define AUCTION_TYPE_EXPOSURE 0x45      // Exposure
#define AUCTION_TYPE_FACILITATION 0x43  // Facilitation
#define AUCTION_TYPE_SOLICITATION 0x53  // Solicitation
#define AUCTION_TYPE_PIM 0x50           // Pim

// ---- Types -------------------------------------------------------------------

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT8 timestamp[6];     // bytes 0 to 5
  UINT8 event_code;       // byte 6
  UINT16BE current_year;  // bytes 7 to 8
  UINT8 current_month;    // byte 9
  UINT8 current_day;      // byte 10
  UINT8 version;          // byte 11
  UINT8 sub_version;      // byte 12
} SystemEventMessage;

// Leg information
typedef struct _LegInformation {
  UINT32BE option_id;              // bytes 0 to 3
  UINT8 security_symbol[6];        // bytes 4 to 9
  UINT8 leg_id;                    // byte 10
  UINT8 expiration_year;           // byte 11
  UINT8 expiration_month;          // byte 12
  UINT8 expiration_day;            // byte 13
  UINT64BE explicit_strike_price;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 option_type;               // byte 22
  UINT8 leg_side;                  // byte 23
  UINT32BE leg_ratio;              // bytes 24 to 27
} LegInformation;

// Whenever a complex order is added in the system for an underlying, the order is normalized and results in either the creation of a new complex strategy or is added to an existing strategy. A Complex Strategy Message containing the strategy definition will be sent.
typedef struct _ComplexStrategyDirectoryMessage {
  UINT8 timestamp[6];                                                           // bytes 0 to 5
  UINT32BE strategy_id;                                                         // bytes 6 to 9
  UINT8 strategy_type;                                                          // byte 10
  UINT8 source;                                                                 // byte 11
  UINT8 underlying_symbol[13];                                                  // bytes 12 to 24
  UINT8 number_of_legs;                                                         // byte 25
  LegInformation leg_information[:byte-size (((UINT32) number_of_legs) * 28)];
} ComplexStrategyDirectoryMessage;

// ISE uses this administrative message to indicate the current trading status of a strategy within the ISE Options Market.
typedef struct _StrategyTradingActionMessage {
  UINT8 timestamp[6];           // bytes 0 to 5
  UINT32BE strategy_id;         // bytes 6 to 9
  UINT8 current_trading_state;  // byte 10
} StrategyTradingActionMessage;

// The options system uses this administrative message to indicate when an strategy has completed the opening process and is now available for auto execution or when the option has closed and is no longer available for auto execution.
typedef struct _StrategyOpenClosedMessage {
  UINT8 timestamp[6];    // bytes 0 to 5
  UINT32BE strategy_id;  // bytes 6 to 9
  UINT8 open_state;      // byte 10
} StrategyOpenClosedMessage;

// An Order on Book message is generated for all the following situations whenever an order free from any display restrictions is reported by the matching engine. In all such cases the order size to be displayed is as reported by the matching engine
typedef struct _ComplexStrategyOrderOnBookMessage {
  UINT8 timestamp[6];    // bytes 0 to 5
  UINT32BE strategy_id;  // bytes 6 to 9
  UINT8 order_type;      // byte 10
  UINT8 side;            // byte 11
  UINT32BE price;        // bytes 12 to 15, signed, read here as unsigned
  UINT32BE size;         // bytes 16 to 19
  UINT8 exec_flag;       // byte 20
  UINT8 order_capacity;  // byte 21
  UINT8 scope;           // byte 22
  UINT8 owner_id[6];     // bytes 23 to 28
  UINT8 giveup[6];       // bytes 29 to 34
  UINT8 cmta[6];         // bytes 35 to 40
} ComplexStrategyOrderOnBookMessage;

// Auction Response information
typedef struct _AuctionResponse {
  UINT32BE response_price;  // bytes 0 to 3, signed, read here as unsigned
  UINT32BE response_size;   // bytes 4 to 7
} AuctionResponse;

// This message is used to announce strategy auctions. The start of auction is announced, followed by possible updates on the auction, and announcing the end of the auction.
typedef struct _ComplexStrategyAuctionMessage {
  UINT8 timestamp[6];                                                                 // bytes 0 to 5
  UINT32BE strategy_id;                                                               // bytes 6 to 9
  UINT32BE auction_id;                                                                // bytes 10 to 13
  UINT8 order_type;                                                                   // byte 14
  UINT8 side;                                                                         // byte 15
  UINT32BE price;                                                                     // bytes 16 to 19, signed, read here as unsigned
  UINT32BE size;                                                                      // bytes 20 to 23
  UINT8 exec_flag;                                                                    // byte 24
  UINT8 order_capacity;                                                               // byte 25
  UINT8 scope;                                                                        // byte 26
  UINT8 owner_id[6];                                                                  // bytes 27 to 32
  UINT8 giveup[6];                                                                    // bytes 33 to 38
  UINT8 cmta[6];                                                                      // bytes 39 to 44
  UINT8 auction_event;                                                                // byte 45
  UINT8 auction_type;                                                                 // byte 46
  UINT8 number_of_responses;                                                          // byte 47
  AuctionResponse auction_response[:byte-size (((UINT32) number_of_responses) * 8)];
} ComplexStrategyAuctionMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x52: ComplexStrategyDirectoryMessage complex_strategy_directory_message;
    case 0x48: StrategyTradingActionMessage strategy_trading_action_message;
    case 0x4F: StrategyOpenClosedMessage strategy_open_closed_message;
    case 0x4C: ComplexStrategyOrderOnBookMessage complex_strategy_order_on_book_message;
    case 0x4A: ComplexStrategyAuctionMessage complex_strategy_auction_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

