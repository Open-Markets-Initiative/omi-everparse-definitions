#define WIDE_STATUS_CODE_DUPLICATE_UNIQUE_ID_OF_A_SECURITY_DEFINITION_REQUEST_FOR_THE_FLEX_CONTRACT 0x0130        // Duplicate Unique Id Of A Security Definition Request For The Flex Contract
#define WIDE_STATUS_CODE_EXCEEDING_THE_FLEX_CONTRACT_LIMIT 0x0131                                                 // Exceeding The Flex Contract Limit
#define WIDE_STATUS_CODE_NO_RECORD_OF_SUCCESSFUL_FLEX_CONTRACT_APPLICATION_WAS_FOUND 0x0132                       // No Record Of Successful Flex Contract Application Was Found
#define WIDE_STATUS_CODE_NON_FLEXIBLE_CONTRACT_APPLICATION_PERIOD 0x0136                                          // Non Flexible Contract Application Period
#define WIDE_STATUS_CODE_THE_PROPRIETARY_TRADING_ACCOUNT_HAS_NOT_BEEN_APPROVED_TO_APPLY_FOR_FLEX_C_2vsum5 0x0137  // The Proprietary Trading Account Has Not Been Approved To Apply For Flex Contracts
#define WIDE_STATUS_CODE_THE_FCM_ACCOUNT_HAS_NOT_BEEN_APPROVED_TO_APPLY_FOR_FLEX_CONTRACTS 0x0138                 // The Fcm Account Has Not Been Approved To Apply For Flex Contracts
#define WIDE_STATUS_CODE_INCORRECT_COVERAGE_RANGE_FOR_THE_FLEX_CONTRACT 0x0139                                    // Incorrect Coverage Range For The Flex Contract
#define WIDE_STATUS_CODE_INVALID_STRIKE_PRICE_FOR_THE_FLEX_CONTRACT 0x013A                                        // Invalid Strike Price For The Flex Contract
#define WIDE_STATUS_CODE_INVALID_SECURITY_REQUEST_TYPE_FOR_THE_FLEX_CONTRACT 0x013B                               // Invalid Security Request Type For The Flex Contract
#define WIDE_STATUS_CODE_INVALID_APPLICATION_TYPE_FOR_THE_FLEX_CONTRACT 0x013C                                    // Invalid Application Type For The Flex Contract
#define WIDE_STATUS_CODE_INVALID_TYPE_FOR_THE_FLEX_CONTRACT 0x013D                                                // Invalid Type For The Flex Contract
#define WIDE_STATUS_CODE_EXPIRY_TYPE_ERROR 0x013E                                                                 // Expiry Type Error
#define WIDE_STATUS_CODE_CALL_PUT_CODE_ERROR 0x013F                                                               // Call Put Code Error

// Part Id: one byte code
#define PART_ID_FLEX_OPTIONS_REGULAR_MARKET_HOURS 0x66  // Flex Options Regular Market Hours
#define PART_ID_FLEX_FUTURES_REGULAR_MARKET_HOURS 0xCA  // Flex Futures Regular Market Hours

// Ap Code: one byte code
#define AP_CODE_FCM_ORDER_TRANSACTION 0x04                     // Fcm Order Transaction
#define AP_CODE_FCM_CONDENSED_VERSION_ORDER_TRANSACTION 0x06   // Fcm Condensed Version Order Transaction
#define AP_CODE_TMPDC_SESSION 0x07                             // Tmpdc Session
#define AP_CODE_CLEARING_MEMBER_ORDER_TRANSACTION_REPORT 0x08  // Clearing Member Order Transaction Report

// Exec Type: one byte code
#define EXEC_TYPE_NEW 0x30                                          // New
#define EXEC_TYPE_CANCEL 0x34                                       // Cancel
#define EXEC_TYPE_DECREASE 0x35                                     // Decrease
#define EXEC_TYPE_NEW_AND_EXECUTION_REPORT 0x36                     // New And Execution Report
#define EXEC_TYPE_EXECUTION_REPORT 0x46                             // Execution Report
#define EXEC_TYPE_QUERY 0x49                                        // Query
#define EXEC_TYPE_MODIFY_PRICE_REPLYING_TO_THE_MODIFYING_LINE 0x4D  // Modify Price Replying To The Modifying Line
#define EXEC_TYPE_MODIFY_PRICE_REPLYING_TO_THE_ORIGINAL_LINE 0x6D   // Modify Price Replying To The Original Line

// Symbol Type: one byte code
#define SYMBOL_TYPE_NUMERIC_PRODUCT_ID 0x01              // Numeric Product Id
#define SYMBOL_TYPE_TEXT_PRODUCT_ID 0x02                 // Text Product Id
#define SYMBOL_TYPE_NUMERIC_PRODUCT_ID_LONG_FORMAT 0x03  // Numeric Product Id Long Format
#define SYMBOL_TYPE_TEXT_PRODUCT_ID_LONG_FORMAT 0x04     // Text Product Id Long Format

// Comb Op: one byte code
#define COMB_OP_SINGLE_ORDER 0x00              // Single Order
#define COMB_OP_PRICE_SPREAD 0x01              // Price Spread
#define COMB_OP_TIME_SPREAD 0x02               // Time Spread
#define COMB_OP_STRADDLE 0x03                  // Straddle
#define COMB_OP_STRANGLE 0x04                  // Strangle
#define COMB_OP_CONVERSION_AND_REVERSALS 0x05  // Conversion And Reversals

// Side: one byte code
#define SIDE_BUY 0x01   // Buy
#define SIDE_SELL 0x02  // Sell

// Ord Type: one byte code
#define ORD_TYPE_MARKET 0x01                  // Market
#define ORD_TYPE_LIMIT 0x02                   // Limit
#define ORD_TYPE_MARKET_WITH_PROTECTION 0x03  // Market With Protection

// Time In Force: one byte code
#define TIME_IN_FORCE_ROD 0x00                                             // Rod
#define TIME_IN_FORCE_IOC 0x03                                             // Ioc
#define TIME_IN_FORCE_FOK 0x04                                             // Fok
#define TIME_IN_FORCE_AUTOMATICALLY_CANCELLED_AFTER_A_PERIOD_OF_TIME 0x08  // Automatically Cancelled After A Period Of Time

// Position Effect: one byte code
#define POSITION_EFFECT_OPEN 0x4F                                 // Open
#define POSITION_EFFECT_CLOSE 0x43                                // Close
#define POSITION_EFFECT_DAYTRADE 0x44                             // Daytrade
#define POSITION_EFFECT_OPEN_AND_SPECIFIED_POSITION_OFFSETS 0x41  // Open And Specified Position Offsets
#define POSITION_EFFECT_OFFSET_BY_FCM 0x37                        // Offset By Fcm
#define POSITION_EFFECT_MARKET_MAKER_QUOTE 0x39                   // Market Maker Quote

// Target Id: one byte code
#define TARGET_ID_EXECUTION_REPORT_INCLUDING_HEAD_OFFICE_AND_BRANCH_OFFICES_IN_R_02_FORMAT 0x03  // Execution Report Including Head Office And Branch Offices In R 02 Format
#define TARGET_ID_FCM 0x04                                                                       // Fcm
#define TARGET_ID_DROP_COPY_IN_R_02_FORMAT 0x07                                                  // Drop Copy In R 02 Format
#define TARGET_ID_CLEARING_MEMBER_ORDER_AND_EXECUTION_IN_R_02_FORMAT 0x08                        // Clearing Member Order And Execution In R 02 Format
#define TARGET_ID_CLEARING_MEMBER_EXECUTION_IN_R_02_FORMAT 0x09                                  // Clearing Member Execution In R 02 Format
#define TARGET_ID_EXECUTION_REPORT_INCLUDING_HEAD_OFFICE_AND_BRANCH_OFFICES_IN_R_32_FORMAT 0x0D  // Execution Report Including Head Office And Branch Offices In R 32 Format
#define TARGET_ID_DROP_COPY_IN_R_32_FORMAT 0x11                                                  // Drop Copy In R 32 Format
#define TARGET_ID_CLEARING_MEMBER_ORDER_AND_EXECUTION_IN_R_32_FORMAT 0x12                        // Clearing Member Order And Execution In R 32 Format
#define TARGET_ID_CLEARING_MEMBER_EXECUTION_IN_R_32_FORMAT 0x13                                  // Clearing Member Execution In R 32 Format
#define TARGET_ID_EXECUTION_REPORT_INCLUDING_HEAD_OFFICE_AND_BRANCH_OFFICES_IN_R_06_FORMAT 0x17  // Execution Report Including Head Office And Branch Offices In R 06 Format

// Protocol Type: one byte code
#define PROTOCOL_TYPE_RESERVED 0x00  // Reserved
#define PROTOCOL_TYPE_TMP 0x01       // Tmp
#define PROTOCOL_TYPE_FIX 0x02       // Fix

// Leg Side: one byte code
#define LEG_SIDE_SINGLE_ORDER 0x00  // Single Order
#define LEG_SIDE_BUY 0x01           // Buy
#define LEG_SIDE_SELL 0x02          // Sell

// ---- Types -------------------------------------------------------------------

// Message time, the Tmp time format of section 2.1 carried by the common message header
typedef struct _HeaderTime {
  UINT32BE header_epoch_s;  // bytes 0 to 3, signed, read here as unsigned
  UINT16BE header_ms;       // bytes 4 to 5
} HeaderTime;

// Wake up call message, which either Taifex or the futures commission merchant may initiate in the logon phase of the Link Subsystem.
typedef struct _WakeUpCallMessage {
  UINT8 status_code;            // byte 0
  UINT32BE start_in_bound_num;  // bytes 1 to 4
} WakeUpCallMessage;

// Wake up call confirmed message, sent by the futures commission merchant to Taifex.
typedef struct _WakeUpCallConfirmedMessage {
  UINT8 version;  // byte 0
} WakeUpCallConfirmedMessage;

// Logon notice message, carrying the sequence No of the last message Taifex sent the futures commission merchant in the session.
typedef struct _LogonNoticeMessage {
  UINT8 status_code;           // byte 0
  UINT16BE append_no;          // bytes 1 to 2
  UINT32BE end_out_bound_num;  // bytes 3 to 6
  UINT8 system_type;           // byte 7
  UINT8 encrypt_method;        // byte 8
} LogonNoticeMessage;

// Tmp Expanded Message Header, which assigns different functionalities to a MessageType by defining additional subcategories for it
typedef struct _SubHdr {
  UINT8 msg_type_ext;    // byte 0
  UINT8 preserve;        // byte 1
  UINT32BE msg_time_ns;  // bytes 2 to 5
} SubHdr;

// Final Sequential Number Notification Message for Group, transmitting the group's last report sequence number to the futures commission merchant.
typedef struct _FinalSequentialNumberNotificationForGroupMessage {
  SubHdr sub_hdr;              // bytes 0 to 5
  UINT16BE wide_status_code;   // bytes 6 to 7
  UINT8 part_id;               // byte 8
  UINT32BE end_out_bound_num;  // bytes 9 to 12
  UINT8 reserved_8[8];         // bytes 13 to 20
} FinalSequentialNumberNotificationForGroupMessage;

// Request logon, sent by the futures commission merchant to Taifex with the start sequence of the messages it requests Taifex to resend.
typedef struct _RequestLogonMessage {
  UINT8 status_code;           // byte 0
  UINT16BE append_no;          // bytes 1 to 2
  UINT16BE fcm_id;             // bytes 3 to 4
  UINT16BE session_id;         // bytes 5 to 6
  UINT8 system_type;           // byte 7
  UINT8 ap_code;               // byte 8
  UINT8 key_value;             // byte 9
  UINT32BE request_start_seq;  // bytes 10 to 13
  UINT8 cancel_order_sec;      // byte 14
} RequestLogonMessage;

// Activate application system, sent by Taifex to the futures commission merchant.
typedef struct _ActivateApplicationSystemMessage {
  UINT8 status_code;           // byte 0
  UINT8 heart_bt_int;          // byte 1
  UINT16BE max_flow_ctrl_cnt;  // bytes 2 to 3
} ActivateApplicationSystemMessage;

// Activate application system confirmed, from which Taifex calculates the round trip time of the L50 message to determine the maximum peak flow per second.
typedef struct _ActivateApplicationSystemConfirmedMessage {
  UINT8 status_code;  // byte 0
} ActivateApplicationSystemConfirmedMessage;

// Logout confirmed message, sent by Taifex to the futures commission merchant.
typedef struct _LogoutConfirmedMessage {
  UINT8 status_code;  // byte 0
} LogoutConfirmedMessage;

// Confirm connection message, which either party sends when no new message has arrived from the other after the number of seconds set in the HeartBtInt field of L50.
typedef struct _ConfirmConnectionMessage {
  UINT8 status_code;  // byte 0
} ConfirmConnectionMessage;

// Connection confirmed message, with which a party answers the confirm connection message of the other.
typedef struct _ConnectionConfirmedMessage {
  UINT8 status_code;  // byte 0
} ConnectionConfirmedMessage;

// Numeric product ID, naming a product by the number Taifex assigns it in each session
typedef struct _SymbolNum {
  UINT16BE pseq_1;          // bytes 0 to 1
  UINT16BE pseq_2;          // bytes 2 to 3
  UINT8 both_leg_sides[2];  // bytes 4 to 5
  UINT8 comb_op;            // byte 6
  UINT8 reserved_13[13];    // bytes 7 to 19
} SymbolNum;

// Text product ID, naming a product by its Ascii character string symbol
typedef struct _SymbolText {
  UINT8 symbol[20];  // bytes 0 to 19
} SymbolText;

// Branch
casetype _SymSymbolX (UINT8 selector) {
  switch (selector) {
    case 0x01: SymbolNum symbol_num;
    case 0x02: SymbolText symbol_text;
  }
} SymSymbolX;

// Tmp time format, the seconds since the epoch and the thousandth of a second
typedef struct _OrgTransTimeMsgTime {
  UINT32BE msg_time_epoch_s;  // bytes 0 to 3, signed, read here as unsigned
  UINT16BE ms;                // bytes 4 to 5
} OrgTransTimeMsgTime;

// Order status report, with which Taifex answers an order input and reports each execution against it, naming its product in the short product format.
typedef struct _OrderStatusReportMessage {
  UINT8 status_code;                            // byte 0
  UINT8 exec_type;                              // byte 1
  UINT16BE cm_id;                               // bytes 2 to 3
  UINT16BE fcm_id;                              // bytes 4 to 5
  UINT8 order_no[5];                            // bytes 6 to 10
  UINT32BE ord_id;                              // bytes 11 to 14
  UINT8 user_define[8];                         // bytes 15 to 22
  UINT8 symbol_type;                            // byte 23
  SymSymbolX(symbol_type) sym_symbol_x;
  UINT32BE price;                               // signed, read here as unsigned
  UINT16BE qty;
  UINT32BE investor_acno;
  UINT8 investor_flag;
  UINT8 side;
  UINT8 ord_type;
  UINT8 time_in_force;
  UINT8 position_effect;
  UINT32BE last_px;                             // signed, read here as unsigned
  UINT16BE last_qty;
  UINT64BE px_subtotal;                         // signed, read here as unsigned
  UINT16BE cum_qty;
  UINT16BE leaves_qty;
  UINT16BE before_qty;
  UINT8 both_leg_sides[2];
  UINT32BE leg_px[:byte-size 8];
  UINT16BE both_leg_qtys[:byte-size 4];
  OrgTransTimeMsgTime org_trans_time_msg_time;
  OrgTransTimeMsgTime transact_time_msg_time;
  UINT8 target_id;
  UINT32BE uniq_id;
  UINT32BE rpt_seq;
  UINT8 protocol_type;
} OrderStatusReportMessage;

// Numeric product ID in the long product format, naming a product by the number Taifex assigns it in each session
typedef struct _LongSymbolNum {
  UINT16BE pseq_1;          // bytes 0 to 1
  UINT16BE pseq_2;          // bytes 2 to 3
  UINT8 both_leg_sides[2];  // bytes 4 to 5
  UINT8 comb_op;            // byte 6
  UINT8 reserved_33[33];    // bytes 7 to 39
} LongSymbolNum;

// Text product ID in the long product format, naming a product by its Ascii character string symbol
typedef struct _LongSymbolText {
  UINT8 long_symbol[40];  // bytes 0 to 39
} LongSymbolText;

// Branch
casetype _SymLongSymbolX (UINT8 selector) {
  switch (selector) {
    case 0x03: LongSymbolNum long_symbol_num;
    case 0x04: LongSymbolText long_symbol_text;
  }
} SymLongSymbolX;

// Order status report, with which Taifex answers an order input and reports each execution against it, naming its product in the long product format.
typedef struct _OrderStatusReportLongFormatMessage {
  UINT8 status_code;                              // byte 0
  UINT8 exec_type;                                // byte 1
  UINT16BE cm_id;                                 // bytes 2 to 3
  UINT16BE fcm_id;                                // bytes 4 to 5
  UINT8 order_no[5];                              // bytes 6 to 10
  UINT32BE ord_id;                                // bytes 11 to 14
  UINT8 user_define[8];                           // bytes 15 to 22
  UINT8 symbol_type;                              // byte 23
  SymLongSymbolX(symbol_type) sym_long_symbol_x;
  UINT32BE price;                                 // signed, read here as unsigned
  UINT16BE qty;
  UINT32BE investor_acno;
  UINT8 investor_flag;
  UINT8 side;
  UINT8 ord_type;
  UINT8 time_in_force;
  UINT8 position_effect;
  UINT32BE last_px;                               // signed, read here as unsigned
  UINT16BE last_qty;
  UINT64BE px_subtotal;                           // signed, read here as unsigned
  UINT16BE cum_qty;
  UINT16BE leaves_qty;
  UINT16BE before_qty;
  UINT8 both_leg_sides[2];
  UINT32BE leg_px[:byte-size 8];
  UINT16BE both_leg_qtys[:byte-size 4];
  OrgTransTimeMsgTime org_trans_time_msg_time;
  OrgTransTimeMsgTime transact_time_msg_time;
  UINT8 target_id;
  UINT32BE uniq_id;
  UINT32BE rpt_seq;
  UINT8 protocol_type;
} OrderStatusReportLongFormatMessage;

// Execution report including head office and branch offices, which carries the executions of every protocol and neither the order response nor a deletion or decrease.
typedef struct _ExecutionReportIncludingHeadOfficeAndBranchOfficesMessage {
  UINT8 status_code;                            // byte 0
  UINT8 exec_type;                              // byte 1
  UINT16BE cm_id;                               // bytes 2 to 3
  UINT16BE fcm_id;                              // bytes 4 to 5
  UINT8 order_no[5];                            // bytes 6 to 10
  UINT32BE ord_id;                              // bytes 11 to 14
  UINT8 user_define[8];                         // bytes 15 to 22
  UINT8 symbol_type;                            // byte 23
  SymSymbolX(symbol_type) sym_symbol_x;
  UINT32BE price;                               // signed, read here as unsigned
  UINT16BE qty;
  UINT32BE investor_acno;
  UINT8 investor_flag;
  UINT8 side;
  UINT8 ord_type;
  UINT8 time_in_force;
  UINT8 position_effect;
  UINT32BE last_px;                             // signed, read here as unsigned
  UINT16BE last_qty;
  UINT64BE px_subtotal;                         // signed, read here as unsigned
  UINT16BE cum_qty;
  UINT16BE leaves_qty;
  UINT16BE before_qty;
  UINT8 both_leg_sides[2];
  UINT32BE leg_px[:byte-size 8];
  UINT16BE both_leg_qtys[:byte-size 4];
  OrgTransTimeMsgTime org_trans_time_msg_time;
  OrgTransTimeMsgTime transact_time_msg_time;
  UINT8 target_id;
  UINT32BE uniq_id;
  UINT32BE rpt_seq;
  UINT8 protocol_type;
  UINT16BE rpt_session_id;
} ExecutionReportIncludingHeadOfficeAndBranchOfficesMessage;

// FLEX Numeric Single Product Serial number, naming a FLEX product by the serial number of the XP08 product and time flow group definition file
typedef struct _SymbolNumX {
  UINT32BE pseq;  // bytes 0 to 3
} SymbolNumX;

// FLEX Textual Single Product Symbol, naming a FLEX product by the product symbol of the XP08 product and time flow group definition file
typedef struct _SymbolTxtX {
  UINT8 prod_id[20];  // bytes 0 to 19
} SymbolTxtX;

// One leg of a multi leg FLEX order whose product is named by a numeric product serial number
typedef struct _LegEntryNum {
  SymbolNumX leg_sym_symbol_num_x;  // bytes 0 to 3
  UINT8 leg_side;                   // byte 4
  UINT16BE leg_qty;                 // bytes 5 to 6
} LegEntryNum;

// Multi leg FLEX product named by numeric product serial numbers, which section 2.17.1 lays out as a number of legs, the multi leg order code and one block per leg
typedef struct _MultiLegNum {
  UINT8 no_leg;                                                   // byte 0
  UINT8 comb_op;                                                  // byte 1
  LegEntryNum leg_entry_num[:byte-size (((UINT32) no_leg) * 7)];
} MultiLegNum;

// One leg of a multi leg FLEX order whose product is named by a textual product symbol
typedef struct _LegEntryTxt {
  SymbolTxtX leg_sym_symbol_txt_x;  // bytes 0 to 19
  UINT8 leg_side;                   // byte 20
  UINT16BE leg_qty;                 // bytes 21 to 22
} LegEntryTxt;

// Multi leg FLEX product named by textual product symbols, which section 2.17.1 lays out as a number of legs, the multi leg order code and one block per leg
typedef struct _MultiLegTxt {
  UINT8 no_leg;                                                    // byte 0
  UINT8 comb_op;                                                   // byte 1
  LegEntryTxt leg_entry_txt[:byte-size (((UINT32) no_leg) * 23)];
} MultiLegTxt;

// Branch
casetype _SymFlexProductX (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: SymbolNumX symbol_num_x;
    case 0x02: SymbolTxtX symbol_txt_x;
    case 0x03: MultiLegNum multi_leg_num;
    case 0x04: MultiLegTxt multi_leg_txt;
    default: UINT8 unknown[available];
  }
} SymFlexProductX;

// Tmp Expanded Time Format, the seconds since the epoch and the billionth of a second, which the FLEX reports carry in place of msg_time
typedef struct _OrgTransTimeMsgTimeX {
  UINT32BE msg_time_x_epoch_s;  // bytes 0 to 3
  UINT32BE nanosecond;          // bytes 4 to 7
} OrgTransTimeMsgTimeX;

// FLEX Order status report, with which Taifex answers a FLEX order input and reports each execution against it, and which is not reported if the L20 version is 0.
typedef struct _FlexOrderStatusReportMessage (UINT32 available) where (available >= 110) {
  UINT8 msg_type_ext;                                                                                                      // byte 0
  UINT8 preserve;                                                                                                          // byte 1
  UINT32BE msg_time_ns;                                                                                                    // bytes 2 to 5
  UINT8 part_id;                                                                                                           // byte 6
  UINT8 no_leg;                                                                                                            // byte 7
  UINT16BE wide_status_code;                                                                                               // bytes 8 to 9
  UINT8 exec_type;                                                                                                         // byte 10
  UINT16BE cm_id;                                                                                                          // bytes 11 to 12
  UINT16BE fcm_id;                                                                                                         // bytes 13 to 14
  UINT8 order_no[5];                                                                                                       // bytes 15 to 19
  UINT32BE ord_id;                                                                                                         // bytes 20 to 23
  UINT8 user_define[8];                                                                                                    // bytes 24 to 31
  SymFlexProductX(msg_type_ext, (available - 110)) sym_flex_product_x[:byte-size-single-element-array (available - 110)];
  UINT32BE price;                                                                                                          // signed, read here as unsigned
  UINT16BE qty;
  UINT32BE investor_acno;
  UINT8 investor_flag;
  UINT8 side;
  UINT8 ord_type;
  UINT8 time_in_force;
  UINT8 position_effect;
  UINT32BE last_px;                                                                                                        // signed, read here as unsigned
  UINT16BE last_qty;
  UINT64BE px_subtotal;                                                                                                    // signed, read here as unsigned
  UINT16BE cum_qty;
  UINT16BE leaves_qty;
  UINT16BE before_qty;
  OrgTransTimeMsgTimeX org_trans_time_msg_time_x;
  OrgTransTimeMsgTimeX transact_time_msg_time_x;
  UINT8 target_id;
  UINT32BE uniq_id;
  UINT32BE rpt_seq;
  UINT16BE rpt_session_id;
  UINT32BE rpt_session_seq;
  UINT8 reserved_12[12];
} FlexOrderStatusReportMessage;

// Clearing member initiate operation message, with which the clearing member requests the report start sequence of its downline FCM data.
typedef struct _ClearingMemberInitiateOperationMessage {
  UINT16BE member_id;   // bytes 0 to 1
  UINT8 target_id;      // byte 2
  UINT32BE req_cm_seq;  // bytes 3 to 6
} ClearingMemberInitiateOperationMessage;

// Clearing member initiate operation confirmed message, with which Taifex answers the clearing member with a report start notice.
typedef struct _ClearingMemberInitiateOperationConfirmedMessage {
  UINT8 status_code;    // byte 0
  UINT16BE member_id;   // bytes 1 to 2
  UINT8 target_id;      // byte 3
  UINT32BE req_cm_seq;  // bytes 4 to 7
} ClearingMemberInitiateOperationConfirmedMessage;

// Clearing member initiate FLEX operation message, with which the clearing member subscribes to the FLEX order and execution data of a partition.
typedef struct _FlexClearingMemberInitiateOperationMessage {
  SubHdr sub_hdr;       // bytes 0 to 5
  UINT8 part_id;        // byte 6
  UINT16BE member_id;   // bytes 7 to 8
  UINT8 target_id;      // byte 9
  UINT32BE req_cm_seq;  // bytes 10 to 13
} FlexClearingMemberInitiateOperationMessage;

// Clearing member initiate FLEX operation confirmed message, with which Taifex confirms the FLEX subscription.
typedef struct _FlexClearingMemberInitiateOperationConfirmedMessage {
  SubHdr sub_hdr;             // bytes 0 to 5
  UINT8 part_id;              // byte 6
  UINT16BE wide_status_code;  // bytes 7 to 8
  UINT16BE member_id;         // bytes 9 to 10
  UINT8 target_id;            // byte 11
  UINT32BE req_cm_seq;        // bytes 12 to 15
  UINT8 reserved_16[16];      // bytes 16 to 31
} FlexClearingMemberInitiateOperationConfirmedMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x0A: WakeUpCallMessage wake_up_call_message;
    case 0x14: WakeUpCallConfirmedMessage wake_up_call_confirmed_message;
    case 0x1E: LogonNoticeMessage logon_notice_message;
    case 0xE6: FinalSequentialNumberNotificationForGroupMessage final_sequential_number_notification_for_group_message;
    case 0x28: RequestLogonMessage request_logon_message;
    case 0x32: ActivateApplicationSystemMessage activate_application_system_message;
    case 0x3C: ActivateApplicationSystemConfirmedMessage activate_application_system_confirmed_message;
    case 0x46: unit logout_message;
    case 0x50: LogoutConfirmedMessage logout_confirmed_message;
    case 0x68: ConfirmConnectionMessage confirm_connection_message;
    case 0x69: ConnectionConfirmedMessage connection_confirmed_message;
    case 0x66: OrderStatusReportMessage order_status_report_message;
    case 0x84: OrderStatusReportLongFormatMessage order_status_report_long_format_message;
    case 0x6A: ExecutionReportIncludingHeadOfficeAndBranchOfficesMessage execution_report_including_head_office_and_branch_offices_message;
    case 0xCA: FlexOrderStatusReportMessage(available) flex_order_status_report_message;
    case 0x73: ClearingMemberInitiateOperationMessage clearing_member_initiate_operation_message;
    case 0x74: ClearingMemberInitiateOperationConfirmedMessage clearing_member_initiate_operation_confirmed_message;
    case 0xD7: FlexClearingMemberInitiateOperationMessage flex_clearing_member_initiate_operation_message;
    case 0xD8: FlexClearingMemberInitiateOperationConfirmedMessage flex_clearing_member_initiate_operation_confirmed_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Tmp Message Tail, carrying the check sum of a message
typedef struct _MessageTail {
  UINT8 check_sum;  // byte 0
} MessageTail;

// ---- Packet: TmpMessage ------------------------------------------------------

// Taifex Tmp Tcp Message, a common message header, a message body and a one byte check sum
entrypoint typedef struct _TmpMessage {
  UINT16BE msg_length { msg_length >= 15 };                                                                                   // bytes 0 to 1
  UINT32BE msg_seq_num;                                                                                                       // bytes 2 to 5
  HeaderTime header_time;                                                                                                     // bytes 6 to 11
  UINT8 message_type;                                                                                                         // byte 12
  UINT16BE fcm_id;                                                                                                            // bytes 13 to 14
  UINT16BE session_id;                                                                                                        // bytes 15 to 16
  Payload(message_type, (((UINT32) msg_length) - 15)) payload[:byte-size-single-element-array (((UINT32) msg_length) - 15)];
  MessageTail message_tail;
} TmpMessage;

