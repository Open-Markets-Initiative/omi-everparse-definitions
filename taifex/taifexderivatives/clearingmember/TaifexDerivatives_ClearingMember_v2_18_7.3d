#define WIDE_STATUS_CODE_ORDER_PARTIALLY_TRADED_MODIFY_TO_MARKET_FOK_ORDER_OR_MWP_FOK_ORDER_IS_NOT_fczs1w 0x0040  // Order Partially Traded Modify To Market Fok Order Or Mwp Fok Order Is Not Allowed
