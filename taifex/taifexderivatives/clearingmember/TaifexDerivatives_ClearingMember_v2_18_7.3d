#define WIDE_STATUS_CODE_SUBSCRIPTION_REQUEST_TYPE_ERROR 0x00D2                                                   // Subscription Request Type Error
#define WIDE_STATUS_CODE_MSG_TYPE_EXT_ERROR 0x00DC                                                                // Msg Type Ext Error
#define WIDE_STATUS_CODE_PART_ID_ERROR 0x00DD                                                                     // Part Id Error
