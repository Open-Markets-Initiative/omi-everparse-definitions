#define WIDE_STATUS_CODE_MSG_SEQ_NUM_ERROR 0x00CF                                                                 // Msg Seq Num Error
#define WIDE_STATUS_CODE_TARGET_ID_ERROR 0x00D0                                                                   // Target Id Error
