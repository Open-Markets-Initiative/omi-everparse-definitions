// Template Id: 2 byte code
#define TEMPLATE_ID_INSTRUMENT_MESSAGE 0x000A             // Instrument Message
#define TEMPLATE_ID_TRADING_STATUS_UPDATE_MESSAGE 0x000C  // Trading Status Update Message
#define TEMPLATE_ID_INSTRUMENT_INFO_MESSAGE 0x000D        // Instrument Info Message
#define TEMPLATE_ID_INSTRUMENT_REF_MESSAGE 0x000E         // Instrument Ref Message
#define TEMPLATE_ID_BID_PUT_MESSAGE 0x0014                // Bid Put Message
#define TEMPLATE_ID_ASK_PUT_MESSAGE 0x0015                // Ask Put Message
#define TEMPLATE_ID_BID_QTY_REDUCED_MESSAGE 0x0016        // Bid Qty Reduced Message
#define TEMPLATE_ID_ASK_QTY_REDUCED_MESSAGE 0x0017        // Ask Qty Reduced Message
#define TEMPLATE_ID_BID_DELETE_MESSAGE 0x0018             // Bid Delete Message
#define TEMPLATE_ID_ASK_DELETE_MESSAGE 0x0019             // Ask Delete Message
#define TEMPLATE_ID_TRADE_SUMMARY_MESSAGE 0x001E          // Trade Summary Message
#define TEMPLATE_ID_TRADE_MESSAGE 0x001F                  // Trade Message
#define TEMPLATE_ID_BLOCK_TRADE_MESSAGE 0x0021            // Block Trade Message
#define TEMPLATE_ID_SNAPSHOT_HEADER_MESSAGE 0x0064        // Snapshot Header Message
#define TEMPLATE_ID_SNAPSHOT_TRAILER_MESSAGE 0x0065       // Snapshot Trailer Message
#define TEMPLATE_ID_END_OF_CYCLE_MESSAGE 0x0077           // End Of Cycle Message
#define TEMPLATE_ID_RETRANSMIT_REQUEST_MESSAGE 0x00C8     // Retransmit Request Message
#define TEMPLATE_ID_RETRANSMIT_REJECT_MESSAGE 0x00CA      // Retransmit Reject Message

// Type: one byte code
#define TYPE_PERP_FUTURE 0x00   // Perp Future
#define TYPE_OPTION 0x01        // Option
#define TYPE_SPOT 0x02          // Spot
#define TYPE_FUTURE_COMBO 0x03  // Future Combo
#define TYPE_OPTION_COMBO 0x04  // Option Combo
#define TYPE_DATED_FUTURE 0x05  // Dated Future

// Status: one byte code
#define STATUS_OPEN 0x00        // Open
#define STATUS_INACTIVE 0x01    // Inactive
#define STATUS_SETTLEMENT 0x02  // Settlement
#define STATUS_DELIVERED 0x03   // Delivered
#define STATUS_LOCKED 0x04      // Locked
#define STATUS_HALTED 0x05      // Halted

// Trading Status: one byte code
#define TRADING_STATUS_OPEN 0x00        // Open
#define TRADING_STATUS_INACTIVE 0x01    // Inactive
#define TRADING_STATUS_SETTLEMENT 0x02  // Settlement
#define TRADING_STATUS_DELIVERED 0x03   // Delivered
#define TRADING_STATUS_LOCKED 0x04      // Locked
#define TRADING_STATUS_HALTED 0x05      // Halted

// Reason: one byte code
#define REASON_SEQ_TOO_LOW 0x01          // Seq Too Low
#define REASON_SEQ_TOO_HIGH 0x02         // Seq Too High
#define REASON_RATE_LIMIT_EXCEEDED 0x03  // Rate Limit Exceeded
#define REASON_OTHER_ERROR 0x04          // Other Error

