// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x000A: InstrumentMessage instrument_message;
    case 0x000C: TradingStatusUpdateMessage trading_status_update_message;
    case 0x000D: InstrumentInfoMessage instrument_info_message;
    case 0x000E: InstrumentRefMessage instrument_ref_message;
    case 0x0014: BidPutMessage bid_put_message;
    case 0x0015: AskPutMessage ask_put_message;
    case 0x0016: BidQtyReducedMessage bid_qty_reduced_message;
    case 0x0017: AskQtyReducedMessage ask_qty_reduced_message;
    case 0x0018: BidDeleteMessage bid_delete_message;
    case 0x0019: AskDeleteMessage ask_delete_message;
    case 0x001E: TradeSummaryMessage trade_summary_message;
    case 0x001F: TradeMessage trade_message;
    case 0x0021: BlockTradeMessage block_trade_message;
    case 0x0064: SnapshotHeaderMessage snapshot_header_message;
    case 0x0065: SnapshotTrailerMessage snapshot_trailer_message;
    case 0x0077: EndOfCycleMessage end_of_cycle_message;
    case 0x00C8: RetransmitRequestMessage retransmit_request_message;
    case 0x00CA: RetransmitRejectMessage retransmit_reject_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Alignment padding out to the message length
casetype _OptionalPadding (Bool present, UINT32 available) {
  switch (present) {
    case true: UINT8 padding[available];
    case false: unit absent;
  }
} OptionalPadding;

// Coinbase Deribit Market Data per-message wrapper Md Message Header plus payload
typedef struct _MdMessage (mutable UINT32 * tally) {
  UINT16 message_length { message_length >= 16 && (((UINT32) message_length) - 16) <= (((UINT32) message_length) - 16) };                                                       // bytes 0 to 1
  UINT16 template_id;                                                                                                                                                           // bytes 2 to 3
  UINT16 schema_version;                                                                                                                                                        // bytes 4 to 5
  UINT16 start_of_transaction : 1;                                                                                                                                              // bytes 6 to 7
  UINT16 end_of_transaction : 1;                                                                                                                                                // bytes 6 to 7
  UINT16 reserved_bits : 14;                                                                                                                                                    // bytes 6 to 7
  UINT64 transact_time;                                                                                                                                                         // bytes 8 to 15, signed, read here as unsigned
  Payload(template_id, (((UINT32) message_length) - 16)) payload[:byte-size-single-element-array (((UINT32) message_length) - 16)];
  OptionalPadding((((((UINT32) message_length) - 16) - (((UINT32) message_length) - 16)) > 0), ((((UINT32) message_length) - 16) - (((UINT32) message_length) - 16))) padding;
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} MdMessage;

// Coinbase Deribit Market Data per-message wrapper Md Message Header plus payload
typedef struct _MdMessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit md_message_tally_start {:on-success *tally = 0; return true; };
  MdMessage(tally) md_message[:byte-size available];
  unit md_message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MdMessageRun;

// Branch
casetype _MdMessages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit empty_packet;
    default: MdMessageRun(message_count, available, tally) md_message;
  }
} MdMessages;

// ---- Packet: Packet ----------------------------------------------------------

// Coinbase Deribit Market Data Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 24) {
  UINT64 sending_time;                                                                                                              // bytes 0 to 7, signed, read here as unsigned
  UINT64 seq_num;                                                                                                                   // bytes 8 to 15, signed, read here as unsigned
  UINT32 channel_id;                                                                                                                // bytes 16 to 19, signed, read here as unsigned
  UINT16 incremental_update : 1;                                                                                                    // bytes 20 to 21
  UINT16 snapshot : 1;                                                                                                              // bytes 20 to 21
  UINT16 retransmit : 1;                                                                                                            // bytes 20 to 21
  UINT16 packet_reserved_bits : 13;                                                                                                 // bytes 20 to 21
  UINT16 message_count;                                                                                                             // bytes 22 to 23
  MdMessages(message_count, message_count, (available - 24), tally) md_messages[:byte-size-single-element-array (available - 24)];
} Packet;

