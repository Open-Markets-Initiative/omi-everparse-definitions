  UINT64 large_tick_size_1;       // bytes 256 to 263, signed, read here as unsigned
  UINT64 large_tick_threshold_1;  // bytes 264 to 271, signed, read here as unsigned
  UINT64 creation_time;           // bytes 272 to 279, signed, read here as unsigned
  UINT64 expiry_time;             // bytes 280 to 287, signed, read here as unsigned
  LogicalExpiry logical_expiry;   // bytes 288 to 295
  UINT32 is_reversed : 1;         // bytes 296 to 299
  UINT32 is_put_option : 1;       // bytes 296 to 299
