  UINT64 estimated_delivery_price;  // bytes 24 to 31, signed, read here as unsigned
  UINT64 delivery_price;            // bytes 32 to 39, signed, read here as unsigned
  UINT64 settlement_price;          // bytes 40 to 47, signed, read here as unsigned
  UINT8 open_interest[8];           // bytes 48 to 55
} InstrumentRefMessage;

