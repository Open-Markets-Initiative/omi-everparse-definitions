// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Deribit_MarketDataApi_v1_0.3d
//
// What this definition does not state, and the model does:
// - a field read in bits
// - a run counted by a field
// - a block whose stated length holds more than its fields
// - the packet as a whole, which is an element present when bytes remain, where what remains is not known, at packet.mdmessages.mdmessage.payload.blocktrademessage.executiontimestamp

// ---- Values ------------------------------------------------------------------

// Trading Status: one byte code
#define TRADING_STATUS_OPEN 0x00        // Open
#define TRADING_STATUS_INACTIVE 0x01    // Inactive
#define TRADING_STATUS_SETTLEMENT 0x02  // Settlement
#define TRADING_STATUS_DELIVERED 0x03   // Delivered
#define TRADING_STATUS_LOCKED 0x04      // Locked
#define TRADING_STATUS_HALTED 0x05      // Halted

// Reason: one byte code
#define REASON_SEQ_TOO_LOW 0x01          // Seq Too Low
#define REASON_SEQ_TOO_HIGH 0x02         // Seq Too High
#define REASON_RATE_LIMIT_EXCEEDED 0x03  // Rate Limit Exceeded
#define REASON_OTHER_ERROR 0x04          // Other Error

// ---- Group Size Encoding: 4 bytes --------------------------------------------

// groupSizeEncoding
entrypoint typedef struct _GroupSizeEncoding {
  UINT16 block_length;  // bytes 0 to 1
  UINT16 num_in_group;  // bytes 2 to 3
} GroupSizeEncoding;

// ---- Index Definition Message: 136 bytes -------------------------------------

// IndexDefinitionMessage
entrypoint typedef struct _IndexDefinitionMessage {
  UINT64 index_id;  // bytes 0 to 7, signed, read here as unsigned
  UINT8 name[128];  // bytes 8 to 135
} IndexDefinitionMessage;

