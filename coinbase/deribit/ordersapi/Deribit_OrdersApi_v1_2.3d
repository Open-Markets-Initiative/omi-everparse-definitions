// ---- Values ------------------------------------------------------------------

// Reset Seq Num: one byte code
#define RESET_SEQ_NUM_FALSE 0x00  // False
#define RESET_SEQ_NUM_TRUE 0x01   // True

// Product Type: one byte code
#define PRODUCT_TYPE_ALL 0x00            // All
#define PRODUCT_TYPE_OPTIONS 0x01        // Options
#define PRODUCT_TYPE_FUTURES 0x02        // Futures
#define PRODUCT_TYPE_COMBO_FUTURES 0x03  // Combo Futures
#define PRODUCT_TYPE_COMBO_OPTIONS 0x04  // Combo Options
#define PRODUCT_TYPE_SPOT 0x05           // Spot

// Side: one byte code
#define SIDE_BUY 0x01   // Buy
#define SIDE_BOTH 0x00  // Both

// Trigger: one byte code
#define TRIGGER_QUANTITY 0x00  // Quantity
#define TRIGGER_DELTA 0x01     // Delta
#define TRIGGER_VEGA 0x02      // Vega

