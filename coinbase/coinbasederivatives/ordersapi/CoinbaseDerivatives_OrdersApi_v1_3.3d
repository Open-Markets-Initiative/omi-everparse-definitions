// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out CoinbaseDerivatives_OrdersApi_v1_3.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - a field read in bits
// - the dispatch that chooses a message by its type
// - a field present only on a condition
// - a block whose stated length holds more than its fields
// - the packet as a whole, which is an element present when bytes remain, where what remains is not known, at packet.sbemessage.padding

// ---- Values ------------------------------------------------------------------

// Reset Seq Num: one byte code
#define RESET_SEQ_NUM_FALSE 0x00  // False
#define RESET_SEQ_NUM_TRUE 0x01   // True

// Security Type: one byte code
#define SECURITY_TYPE_FUTURES 0x00  // Futures
#define SECURITY_TYPE_OPTIONS 0x01  // Options

// Instrument Status: one byte code
#define INSTRUMENT_STATUS_PRE_OPEN 0x01            // Pre Open
#define INSTRUMENT_STATUS_PRE_OPEN_NO_CANCEL 0x02  // Pre Open No Cancel
#define INSTRUMENT_STATUS_READY_TO_TRADE 0x03      // Ready To Trade
#define INSTRUMENT_STATUS_TRADING_HALT 0x04        // Trading Halt
#define INSTRUMENT_STATUS_CLOSE 0x05               // Close
#define INSTRUMENT_STATUS_POST_CLOSE 0x06          // Post Close

// Is Last Message: one byte code
#define IS_LAST_MESSAGE_FALSE 0x00  // False
#define IS_LAST_MESSAGE_TRUE 0x01   // True

// Side: one byte code
#define SIDE_BUY 0x01  // Buy

// Order Reject Reason: one byte code
#define ORDER_REJECT_REASON_ERROR 0x01               // Error
#define ORDER_REJECT_REASON_INVALID_INSTRUMENT 0x02  // Invalid Instrument
#define ORDER_REJECT_REASON_CL_ORD_ID_IN_USE 0x03    // Cl Ord Id In Use
#define ORDER_REJECT_REASON_VALIDATION_FAILURE 0x08  // Validation Failure
#define ORDER_REJECT_REASON_UNKNOWN_ORDER 0x09       // Unknown Order

// Cancel Reason: one byte code
#define CANCEL_REASON_EXPIRED 0x00                // Expired
#define CANCEL_REASON_CANCELED_BY_USER 0x01       // Canceled By User
#define CANCEL_REASON_SELF_MATCH_PREVENTION 0x02  // Self Match Prevention
#define CANCEL_REASON_CLIENT_DISCONNECT 0x03      // Client Disconnect
#define CANCEL_REASON_PRICE_LIMIT 0x04            // Price Limit
#define CANCEL_REASON_ADMIN_CANCEL 0x05           // Admin Cancel
#define CANCEL_REASON_MASS_CANCEL 0x06            // Mass Cancel
#define CANCEL_REASON_STREAM_REPLACED 0x07        // Stream Replaced
#define CANCEL_REASON_ACTIVE_LIMIT_EXCEEDED 0x08  // Active Limit Exceeded

// Cancel Order Reject Reason: one byte code
#define CANCEL_ORDER_REJECT_REASON_ERROR 0x01          // Error
#define CANCEL_ORDER_REJECT_REASON_UNKNOWN_ORDER 0x02  // Unknown Order
#define CANCEL_ORDER_REJECT_REASON_ORDER_FILLED 0x03   // Order Filled

// Current Session Only: one byte code
#define CURRENT_SESSION_ONLY_FALSE 0x00  // False
#define CURRENT_SESSION_ONLY_TRUE 0x01   // True

// Request Trading Lock: one byte code
#define REQUEST_TRADING_LOCK_FALSE 0x00  // False
#define REQUEST_TRADING_LOCK_TRUE 0x01   // True

// Only Current Session: one byte code
#define ONLY_CURRENT_SESSION_FALSE 0x00  // False
#define ONLY_CURRENT_SESSION_TRUE 0x01   // True

// Trading Lock Applied: one byte code
#define TRADING_LOCK_APPLIED_FALSE 0x00  // False
#define TRADING_LOCK_APPLIED_TRUE 0x01   // True

// Is Aggressor: one byte code
#define IS_AGGRESSOR_FALSE 0x00  // False
#define IS_AGGRESSOR_TRUE 0x01   // True

// Resend Reject Reason: one byte code
#define RESEND_REJECT_REASON_BEGIN_EXEC_ID_TOO_SMALL 0x01     // Begin Exec Id Too Small
#define RESEND_REJECT_REASON_END_EXEC_ID_TOO_LARGE 0x02       // End Exec Id Too Large
#define RESEND_REJECT_REASON_RESEND_ALREADY_IN_PROGRESS 0x03  // Resend Already In Progress
#define RESEND_REJECT_REASON_TOO_MANY_RESEND_REQUESTS 0x04    // Too Many Resend Requests
#define RESEND_REJECT_REASON_SERVER_ERROR 0x05                // Server Error

