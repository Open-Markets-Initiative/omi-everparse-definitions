// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out CoinbaseDerivatives_Session_v1_2.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - a field read in bits
// - a block whose stated length holds more than its fields
// - the packet as a whole, which is an element present when bytes remain, where what remains is not known, at packet.sbemessage.padding

// ---- Values ------------------------------------------------------------------

// Reset Seq Num: one byte code
#define RESET_SEQ_NUM_FALSE 0x00  // False
#define RESET_SEQ_NUM_TRUE 0x01   // True

// Reject Reason: 4 byte code
#define REJECT_REASON_INVALID_SCHEMA_ID 0x00000001     // Invalid Schema Id
#define REJECT_REASON_INVALID_TEMPLATE_ID 0x00000002   // Invalid Template Id
#define REJECT_REASON_INVALID_BLOCK_LENGTH 0x00000003  // Invalid Block Length
#define REJECT_REASON_INVALID_FIELD_VALUE 0x00000004   // Invalid Field Value

// ---- Logon Message: 49 bytes -------------------------------------------------

// LogonMessage
entrypoint typedef struct _LogonMessage {
  UINT8 username[16];   // bytes 0 to 15
  UINT8 password[32];   // bytes 16 to 47
  UINT8 reset_seq_num;  // byte 48, values RESET_SEQ_NUM_, signed, read here as unsigned
} LogonMessage;

// ---- Logon Conf Message: 4 bytes ---------------------------------------------

// LogonConfMessage
entrypoint typedef struct _LogonConfMessage {
  UINT32 heartbeat_interval_seconds;  // bytes 0 to 3, signed, read here as unsigned
} LogonConfMessage;

// ---- Logout Message: 64 bytes ------------------------------------------------

// LogoutMessage
entrypoint typedef struct _LogoutMessage {
  UINT8 logout_reason[64];  // bytes 0 to 63
} LogoutMessage;

// ---- Logged Out Message: 64 bytes --------------------------------------------

// LoggedOutMessage
entrypoint typedef struct _LoggedOutMessage {
  UINT8 logout_reason[64];  // bytes 0 to 63
} LoggedOutMessage;

// ---- Heartbeat Message: 8 bytes ----------------------------------------------

// HeartbeatMessage
entrypoint typedef struct _HeartbeatMessage {
  UINT64 correlation_id;  // bytes 0 to 7, signed, read here as unsigned
} HeartbeatMessage;

// ---- Test Request Message: 8 bytes -------------------------------------------

// TestRequestMessage
entrypoint typedef struct _TestRequestMessage {
  UINT64 correlation_id;  // bytes 0 to 7, signed, read here as unsigned
} TestRequestMessage;

// ---- Resend Request Message: 8 bytes -----------------------------------------

// ResendRequestMessage
entrypoint typedef struct _ResendRequestMessage {
  UINT32 from_sequence_number;  // bytes 0 to 3
  UINT32 to_sequence_number;    // bytes 4 to 7
} ResendRequestMessage;

// ---- Gap Fill Message: 8 bytes -----------------------------------------------

// GapFillMessage
entrypoint typedef struct _GapFillMessage {
  UINT32 new_sequence_number;  // bytes 0 to 3
  UINT32 gap_fill_padding;     // bytes 4 to 7
} GapFillMessage;

// ---- Reject Message: 72 bytes ------------------------------------------------

// RejectMessage
entrypoint typedef struct _RejectMessage {
  UINT32 ref_sequence_number;  // bytes 0 to 3
  UINT32 reject_reason;        // bytes 4 to 7, values REJECT_REASON_, signed, read here as unsigned
  UINT8 details[64];           // bytes 8 to 71
} RejectMessage;

