// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_OUTRIGHT_INSTRUMENT_DEFINITION_MESSAGE 0x000A         // Outright Instrument Definition Message
#define TEMPLATE_ID_SPREAD_INSTRUMENT_DEFINITION_MESSAGE 0x000B           // Spread Instrument Definition Message
#define TEMPLATE_ID_OPTION_INSTRUMENT_DEFINITION_MESSAGE 0x000C           // Option Instrument Definition Message
#define TEMPLATE_ID_TRADING_STATUS_UPDATE_MESSAGE 0x0011                  // Trading Status Update Message
#define TEMPLATE_ID_ORDER_PUT_MESSAGE 0x0014                              // Order Put Message
#define TEMPLATE_ID_ORDER_DELETE_MESSAGE 0x0015                           // Order Delete Message
#define TEMPLATE_ID_IMPLIED_ORDER_UPDATE_MESSAGE 0x0016                   // Implied Order Update Message
#define TEMPLATE_ID_TRADE_SUMMARY_MESSAGE 0x0021                          // Trade Summary Message
#define TEMPLATE_ID_TRADE_MESSAGE 0x001E                                  // Trade Message
#define TEMPLATE_ID_TRADE_AMEND_MESSAGE 0x001F                            // Trade Amend Message
#define TEMPLATE_ID_SPREAD_TRADE_AMEND_MESSAGE 0x0022                     // Spread Trade Amend Message
#define TEMPLATE_ID_TRADE_BUST_MESSAGE 0x0020                             // Trade Bust Message
#define TEMPLATE_ID_MARKET_STAT_MESSAGE 0x0028                            // Market Stat Message
#define TEMPLATE_ID_TRADE_SESSION_VOLUME_MESSAGE 0x0029                   // Trade Session Volume Message
#define TEMPLATE_ID_OPEN_INTEREST_MESSAGE 0x002A                          // Open Interest Message
#define TEMPLATE_ID_START_OF_OUTRIGHT_INSTRUMENT_SNAPSHOT_MESSAGE 0x006E  // Start Of Outright Instrument Snapshot Message
#define TEMPLATE_ID_START_OF_SPREAD_INSTRUMENT_SNAPSHOT_MESSAGE 0x006F    // Start Of Spread Instrument Snapshot Message
#define TEMPLATE_ID_START_OF_OPTION_INSTRUMENT_SNAPSHOT_MESSAGE 0x0070    // Start Of Option Instrument Snapshot Message
#define TEMPLATE_ID_ORDER_SNAPSHOT_MESSAGE 0x0078                         // Order Snapshot Message
#define TEMPLATE_ID_END_OF_SNAPSHOT_MESSAGE 0x007A                        // End Of Snapshot Message
#define TEMPLATE_ID_END_OF_CYCLE_MESSAGE 0x007C                           // End Of Cycle Message
#define TEMPLATE_ID_RETRANSMIT_REQUEST_MESSAGE 0x00C8                     // Retransmit Request Message
#define TEMPLATE_ID_RETRANSMIT_REJECT_MESSAGE 0x00CA                      // Retransmit Reject Message

// Instrument Side: one byte code
#define INSTRUMENT_SIDE_BUY 0x01           // Buy
#define INSTRUMENT_SIDE_OPENING_FILL 0x00  // Opening Fill

// Trading Status: one byte code
#define TRADING_STATUS_PRE_OPEN 0x00            // Pre Open
#define TRADING_STATUS_OPEN 0x01                // Open
#define TRADING_STATUS_HALT 0x02                // Halt
#define TRADING_STATUS_PAUSE 0x03               // Pause
#define TRADING_STATUS_CLOSE 0x04               // Close
#define TRADING_STATUS_PRE_OPEN_NO_CANCEL 0x05  // Pre Open No Cancel
#define TRADING_STATUS_EXPIRED 0x06             // Expired

// Stat Type: one byte code
#define STAT_TYPE_DAY_OPENING_PRICE 0x34           // Day Opening Price
#define STAT_TYPE_CLOSING_PRICE 0x35               // Closing Price
#define STAT_TYPE_SETTLEMENT_PRICE 0x36            // Settlement Price
#define STAT_TYPE_TRADING_SESSION_HIGH_PRICE 0x37  // Trading Session High Price
#define STAT_TYPE_TRADING_SESSION_LOW_PRICE 0x38   // Trading Session Low Price
#define STAT_TYPE_REFERENCE_PRICE 0x46             // Reference Price
#define STAT_TYPE_INDICATIVE_OPENING_PRICE 0x49    // Indicative Opening Price

// Product Group: one byte code
#define PRODUCT_GROUP_CURRENCY 0x00       // Currency
#define PRODUCT_GROUP_EQUITY 0x01         // Equity
#define PRODUCT_GROUP_ENERGY 0x02         // Energy
#define PRODUCT_GROUP_METALS 0x03         // Metals
#define PRODUCT_GROUP_INTEREST_RATE 0x04  // Interest Rate
#define PRODUCT_GROUP_AGRICULTURE 0x05    // Agriculture
#define PRODUCT_GROUP_CRYPTO 0x06         // Crypto

// Spread Buy Convention: one byte code
#define SPREAD_BUY_CONVENTION_USE_FAR_BID 0x01  // Use Far Bid

// Reason: one byte code
#define REASON_SEQ_TOO_LOW 0x01          // Seq Too Low
#define REASON_SEQ_TOO_HIGH 0x02         // Seq Too High
#define REASON_RATE_LIMIT_EXCEEDED 0x03  // Rate Limit Exceeded
#define REASON_OTHER_ERROR 0x04          // Other Error

// ---- Message Header: 10 bytes ------------------------------------------------

// Coinbase Sbe Market Data message header frame length plus standard SBE header
entrypoint typedef struct _MessageHeader {
  UINT16 frame_length;  // bytes 0 to 1
  UINT16 block_length;  // bytes 2 to 3
  UINT16 template_id;   // bytes 4 to 5, values TEMPLATE_ID_
  UINT16 schema_id;     // bytes 6 to 7
  UINT16 version;       // bytes 8 to 9
} MessageHeader;

// ---- Instr Header: 22 bytes --------------------------------------------------

// Instrument Header
entrypoint typedef struct _InstrHeader {
  UINT8 instrument_flags;       // byte 0
  UINT8 instrument_side;        // byte 1, values INSTRUMENT_SIDE_, signed, read here as unsigned
  UINT32 instrument_id;         // bytes 2 to 5, signed, read here as unsigned
  UINT32 instr_seq_num;         // bytes 6 to 9
  UINT16 trading_session_date;  // bytes 10 to 11
  UINT16 reserved;              // bytes 12 to 13, signed, read here as unsigned
  UINT64 transact_time;         // bytes 14 to 21, signed, read here as unsigned
} InstrHeader;

// ---- Logical Expiry: 8 bytes -------------------------------------------------

// OutrightInstrumentDefinitionMessage
entrypoint typedef struct _LogicalExpiry {
  UINT16 year;           // bytes 0 to 1, signed, read here as unsigned
  UINT16 month;          // bytes 2 to 3, signed, read here as unsigned
  UINT16 week_of_month;  // bytes 4 to 5, signed, read here as unsigned
  UINT16 day_of_month;   // bytes 6 to 7, signed, read here as unsigned
} LogicalExpiry;

// ---- Trading Status Update Message: 39 bytes ---------------------------------

// TradingStatusUpdateMessage
entrypoint typedef struct _TradingStatusUpdateMessage {
  InstrHeader instr_header;  // bytes 0 to 21
  UINT64 limit_down_price;   // bytes 22 to 29, signed, read here as unsigned
  UINT64 limit_up_price;     // bytes 30 to 37, signed, read here as unsigned
  UINT8 trading_status;      // byte 38, values TRADING_STATUS_, signed, read here as unsigned
} TradingStatusUpdateMessage;

