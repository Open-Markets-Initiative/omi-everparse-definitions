// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AquisStockExchange_RealTime_v1_2_3.3d

// ---- Values ------------------------------------------------------------------

// Msg Type: one byte code
#define MSG_TYPE_HEARTBEAT_MESSAGE 0x01            // Heartbeat Message
#define MSG_TYPE_ORDER_ADD_MESSAGE 0x02            // Order Add Message
#define MSG_TYPE_ORDER_CANCEL_MESSAGE 0x03         // Order Cancel Message
#define MSG_TYPE_ORDER_MODIFY_MESSAGE 0x04         // Order Modify Message
#define MSG_TYPE_QUOTE_ADD_REPLACE_MESSAGE 0x14    // Quote Add Replace Message
#define MSG_TYPE_QUOTE_CANCEL_MESSAGE 0x15         // Quote Cancel Message
#define MSG_TYPE_TRADE_MESSAGE 0x05                // Trade Message
#define MSG_TYPE_TRADE_REPORT_MESSAGE 0x19         // Trade Report Message
#define MSG_TYPE_TRADE_REPORT_MODIFY_MESSAGE 0x1A  // Trade Report Modify Message
#define MSG_TYPE_TRADE_REPORT_CANCEL_MESSAGE 0x1B  // Trade Report Cancel Message
#define MSG_TYPE_TRADE_BUST_MESSAGE 0x06           // Trade Bust Message
#define MSG_TYPE_SECURITY_STATISTICS_MESSAGE 0x16  // Security Statistics Message
#define MSG_TYPE_TRADER_DEFINITION_MESSAGE 0x17    // Trader Definition Message
#define MSG_TYPE_TICK_TABLE_DATA_MESSAGE 0x07      // Tick Table Data Message
#define MSG_TYPE_SECURITY_DEFINITION_MESSAGE 0x08  // Security Definition Message
#define MSG_TYPE_SECURITY_STATUS_MESSAGE 0x09      // Security Status Message
#define MSG_TYPE_AOD_UPDATE_MESSAGE 0x11           // Aod Update Message

// Side: one byte code
#define SIDE_BUY_ORDER 0x01   // Buy Order
#define SIDE_SELL_ORDER 0x02  // Sell Order

// Trade Type: one byte code
#define TRADE_TYPE_VISIBLE 0x01                     // Visible
#define TRADE_TYPE_HIDDEN_OR_RESERVE 0x02           // Hidden Or Reserve
#define TRADE_TYPE_AUCTION_ON_DEMAND_TRADE 0x06     // Auction On Demand Trade
#define TRADE_TYPE_TRADE_CAPTURE_REPORT_TRADE 0x08  // Trade Capture Report Trade

// Price Type: one byte code
#define PRICE_TYPE_OPENING_PRICE 0x02  // Opening Price
#define PRICE_TYPE_CLOSING_PRICE 0x05  // Closing Price

// Trading Status: one byte code
#define TRADING_STATUS_ACTIVE 0x01     // Active
#define TRADING_STATUS_HALTED 0x02     // Halted
#define TRADING_STATUS_SUSPENDED 0x03  // Suspended

// ---- Types -------------------------------------------------------------------

// The Order Add message is published when order quantity is posted to the order book for a particular security. This message is only applicable to continuous trading.
typedef struct _OrderAddMessage {
  UINT16 security_id;  // bytes 0 to 1
  UINT8 side;          // byte 2
  UINT32 quantity;     // bytes 3 to 6
  UINT64 price;        // bytes 7 to 14
  UINT32 order_ref;    // bytes 15 to 18
  UINT64 timestamp;    // bytes 19 to 26
} OrderAddMessage;

// The Order Cancel message is published when a visible order is removed from the book. This message is only applicable to continuous trading.
typedef struct _OrderCancelMessage {
  UINT16 security_id;  // bytes 0 to 1
  UINT32 order_ref;    // bytes 2 to 5
  UINT64 timestamp;    // bytes 6 to 13
} OrderCancelMessage;

// The Order Modify message is published when a visible order is modified by the client (change of price and/or quantity). The order reference number remains the same on order modification. This message is only applicable to continuous trading.
typedef struct _OrderModifyMessage {
  UINT16 security_id;         // bytes 0 to 1
  UINT32 remaining_quantity;  // bytes 2 to 5
  UINT64 price;               // bytes 6 to 13
  UINT32 order_ref;           // bytes 14 to 17
  UINT64 timestamp;           // bytes 18 to 25
} OrderModifyMessage;

// The Quote Add/Replace message is published when a quote is available for a particular security.
typedef struct _QuoteAddReplaceMessage {
  UINT16 trader_id;       // bytes 0 to 1
  UINT16 security_id;     // bytes 2 to 3
  UINT32 bid_quantity;    // bytes 4 to 7
  UINT64 bid_price;       // bytes 8 to 15
  UINT32 offer_quantity;  // bytes 16 to 19
  UINT64 offer_price;     // bytes 20 to 27
  UINT64 timestamp;       // bytes 28 to 35
} QuoteAddReplaceMessage;

// The Quote Cancel message is published when a quote is removed for a particular security. The quote may have been cancelled by the trading Member or by the Aquis support team or the market may have closed.
typedef struct _QuoteCancelMessage {
  UINT16 trader_id;    // bytes 0 to 1
  UINT16 security_id;  // bytes 2 to 3
  UINT64 timestamp;    // bytes 4 to 11
} QuoteCancelMessage;

// Whenever an order trades, partially or fully, a Trade message is published.
typedef struct _TradeMessage {
  UINT16 security_id;                                                 // bytes 0 to 1
  UINT8 trade_type;                                                   // byte 2
  UINT32 traded_quantity;                                             // bytes 3 to 6
  UINT64 execution_price;                                             // bytes 7 to 14
  UINT32 order_ref;                                                   // bytes 15 to 18
  UINT32 trade_ref;                                                   // bytes 19 to 22
  UINT64 timestamp;                                                   // bytes 23 to 30
  UINT32 market_mechanism : 3;                                        // bytes 31 to 34
  UINT32 trading_mode : 4;                                            // bytes 31 to 34
  UINT32 transaction_category : 3;                                    // bytes 31 to 34
  UINT32 negotiation_indicator_or_pre_trade_transparency_waiver : 3;  // bytes 31 to 34
  UINT32 crossing_trade : 1;                                          // bytes 31 to 34
  UINT32 modification_indicator : 2;                                  // bytes 31 to 34
  UINT32 benchmark_reference_price_indicator : 2;                     // bytes 31 to 34
  UINT32 dividend : 1;                                                // bytes 31 to 34
  UINT32 off_book_automation : 2;                                     // bytes 31 to 34
  UINT32 price_formation_discovery_process : 3;                       // bytes 31 to 34
  UINT32 algorithmic_indicator : 1;                                   // bytes 31 to 34
  UINT32 publication_mode_post_trade_deferral : 3;                    // bytes 31 to 34
  UINT32 deferral_type : 1;                                           // bytes 31 to 34
  UINT32 duplicative_indicator : 1;                                   // bytes 31 to 34
  UINT32 unused_2 : 2;                                                // bytes 31 to 34
} TradeMessage;

// Whenever a new trade report is submitted to AQSE, a Trade Report message is published.
typedef struct _TradeReportMessage {
  UINT16 security_id;                                                 // bytes 0 to 1
  UINT8 trade_type;                                                   // byte 2
  UINT32 traded_quantity;                                             // bytes 3 to 6
  UINT64 execution_price;                                             // bytes 7 to 14
  UINT32 trade_ref;                                                   // bytes 15 to 18
  UINT64 received_timestamp;                                          // bytes 19 to 26
  UINT32 market_mechanism : 3;                                        // bytes 27 to 30
  UINT32 trading_mode : 4;                                            // bytes 27 to 30
  UINT32 transaction_category : 3;                                    // bytes 27 to 30
  UINT32 negotiation_indicator_or_pre_trade_transparency_waiver : 3;  // bytes 27 to 30
  UINT32 crossing_trade : 1;                                          // bytes 27 to 30
  UINT32 modification_indicator : 2;                                  // bytes 27 to 30
  UINT32 benchmark_reference_price_indicator : 2;                     // bytes 27 to 30
  UINT32 dividend : 1;                                                // bytes 27 to 30
  UINT32 off_book_automation : 2;                                     // bytes 27 to 30
  UINT32 price_formation_discovery_process : 3;                       // bytes 27 to 30
  UINT32 algorithmic_indicator : 1;                                   // bytes 27 to 30
  UINT32 publication_mode_post_trade_deferral : 3;                    // bytes 27 to 30
  UINT32 deferral_type : 1;                                           // bytes 27 to 30
  UINT32 duplicative_indicator : 1;                                   // bytes 27 to 30
  UINT32 unused_2 : 2;                                                // bytes 27 to 30
  UINT64 transact_time;                                               // bytes 31 to 38
} TradeReportMessage;

// Whenever a previously published trade report is modified, a Trade Report Modify message is published. Members can modify trades for up to five business days from the day on which the trade was reported.
typedef struct _TradeReportModifyMessage {
  UINT16 security_id;                                                 // bytes 0 to 1
  UINT8 trade_type;                                                   // byte 2
  UINT32 traded_quantity;                                             // bytes 3 to 6
  UINT64 execution_price;                                             // bytes 7 to 14
  UINT32 trade_ref;                                                   // bytes 15 to 18
  UINT64 received_timestamp;                                          // bytes 19 to 26
  UINT32 market_mechanism : 3;                                        // bytes 27 to 30
  UINT32 trading_mode : 4;                                            // bytes 27 to 30
  UINT32 transaction_category : 3;                                    // bytes 27 to 30
  UINT32 negotiation_indicator_or_pre_trade_transparency_waiver : 3;  // bytes 27 to 30
  UINT32 crossing_trade : 1;                                          // bytes 27 to 30
  UINT32 modification_indicator : 2;                                  // bytes 27 to 30
  UINT32 benchmark_reference_price_indicator : 2;                     // bytes 27 to 30
  UINT32 dividend : 1;                                                // bytes 27 to 30
  UINT32 off_book_automation : 2;                                     // bytes 27 to 30
  UINT32 price_formation_discovery_process : 3;                       // bytes 27 to 30
  UINT32 algorithmic_indicator : 1;                                   // bytes 27 to 30
  UINT32 publication_mode_post_trade_deferral : 3;                    // bytes 27 to 30
  UINT32 deferral_type : 1;                                           // bytes 27 to 30
  UINT32 duplicative_indicator : 1;                                   // bytes 27 to 30
  UINT32 unused_2 : 2;                                                // bytes 27 to 30
  UINT64 transact_time;                                               // bytes 31 to 38
  UINT32 orig_trade_ref;                                              // bytes 39 to 42
  UINT64 orig_timestamp;                                              // bytes 43 to 50
} TradeReportModifyMessage;

// Whenever a previously published trade report is cancelled, a Trade Report Cancel message is published. Members can cancel trades for up to five business days from the day on which the trade was reported.
typedef struct _TradeReportCancelMessage {
  UINT16 orig_security_id;                                            // bytes 0 to 1
  UINT8 orig_trade_type;                                              // byte 2
  UINT32 orig_quantity;                                               // bytes 3 to 6
  UINT64 orig_price;                                                  // bytes 7 to 14
  UINT32 trade_ref;                                                   // bytes 15 to 18
  UINT64 received_timestamp;                                          // bytes 19 to 26
  UINT32 market_mechanism : 3;                                        // bytes 27 to 30
  UINT32 trading_mode : 4;                                            // bytes 27 to 30
  UINT32 transaction_category : 3;                                    // bytes 27 to 30
  UINT32 negotiation_indicator_or_pre_trade_transparency_waiver : 3;  // bytes 27 to 30
  UINT32 crossing_trade : 1;                                          // bytes 27 to 30
  UINT32 modification_indicator : 2;                                  // bytes 27 to 30
  UINT32 benchmark_reference_price_indicator : 2;                     // bytes 27 to 30
  UINT32 dividend : 1;                                                // bytes 27 to 30
  UINT32 off_book_automation : 2;                                     // bytes 27 to 30
  UINT32 price_formation_discovery_process : 3;                       // bytes 27 to 30
  UINT32 algorithmic_indicator : 1;                                   // bytes 27 to 30
  UINT32 publication_mode_post_trade_deferral : 3;                    // bytes 27 to 30
  UINT32 deferral_type : 1;                                           // bytes 27 to 30
  UINT32 duplicative_indicator : 1;                                   // bytes 27 to 30
  UINT32 unused_2 : 2;                                                // bytes 27 to 30
  UINT64 transact_time;                                               // bytes 31 to 38
  UINT32 orig_trade_ref;                                              // bytes 39 to 42
  UINT64 orig_timestamp;                                              // bytes 43 to 50
  UINT64 orig_transact_time;                                          // bytes 51 to 58
} TradeReportCancelMessage;

// If a trade has been declared erroneous by AQSE then a Trade Bust message is published. This message is only applicable to order generated trades.
typedef struct _TradeBustMessage {
  UINT16 security_id;                                                 // bytes 0 to 1
  UINT32 traded_quantity;                                             // bytes 2 to 5
  UINT64 execution_price;                                             // bytes 6 to 13
  UINT32 trade_ref;                                                   // bytes 14 to 17
  UINT64 timestamp;                                                   // bytes 18 to 25
  UINT32 market_mechanism : 3;                                        // bytes 26 to 29
  UINT32 trading_mode : 4;                                            // bytes 26 to 29
  UINT32 transaction_category : 3;                                    // bytes 26 to 29
  UINT32 negotiation_indicator_or_pre_trade_transparency_waiver : 3;  // bytes 26 to 29
  UINT32 crossing_trade : 1;                                          // bytes 26 to 29
  UINT32 modification_indicator : 2;                                  // bytes 26 to 29
  UINT32 benchmark_reference_price_indicator : 2;                     // bytes 26 to 29
  UINT32 dividend : 1;                                                // bytes 26 to 29
  UINT32 off_book_automation : 2;                                     // bytes 26 to 29
  UINT32 price_formation_discovery_process : 3;                       // bytes 26 to 29
  UINT32 algorithmic_indicator : 1;                                   // bytes 26 to 29
  UINT32 publication_mode_post_trade_deferral : 3;                    // bytes 26 to 29
  UINT32 deferral_type : 1;                                           // bytes 26 to 29
  UINT32 duplicative_indicator : 1;                                   // bytes 26 to 29
  UINT32 unused_2 : 2;                                                // bytes 26 to 29
} TradeBustMessage;

// The Security Statistics message is published to disseminate the opening and closing prices of a security.
typedef struct _SecurityStatisticsMessage {
  UINT16 security_id;       // bytes 0 to 1
  UINT64 statistics_price;  // bytes 2 to 9
  UINT8 price_type;         // byte 10
  UINT64 timestamp;         // bytes 11 to 18
} SecurityStatisticsMessage;

// A series of Trader Definition messages are published pre-market to identify the quote originators.
typedef struct _TraderDefinitionMessage {
  UINT16 trader_id;     // bytes 0 to 1
  UINT8 sender_id[16];  // bytes 2 to 17
} TraderDefinitionMessage;

// A series of Tick Table Data messages are published pre-market to specify the dynamic tick tables and static ticks that apply to the securities traded on AQSE.
typedef struct _TickTableDataMessage {
  UINT8 tick_table_id;  // byte 0
  UINT8 name[10];       // bytes 1 to 10
  UINT64 threshold;     // bytes 11 to 18
  UINT64 tick_size;     // bytes 19 to 26
} TickTableDataMessage;

// A series of Security Definition messages are published pre-market to identify the securities traded on AQSE (those relevant to the particular feed e.g. Euronext securities).
typedef struct _SecurityDefinitionMessage {
  UINT16 security_id;   // bytes 0 to 1
  UINT8 umtf[6];        // bytes 2 to 7
  UINT8 isin[12];       // bytes 8 to 19
  UINT8 currency[3];    // bytes 20 to 22
  UINT8 mic[4];         // bytes 23 to 26
  UINT8 tick_table_id;  // byte 27
} SecurityDefinitionMessage;

// The Security Status message is published when the trading status of a security changes or when there is a change to the status of the market on AQSE to which the security belongs.
typedef struct _SecurityStatusMessage {
  UINT16 security_id;        // bytes 0 to 1
  UINT8 trading_status;      // byte 2
  UINT8 trading : 1;         // byte 3
  UINT8 unused_2 : 2;        // byte 3
  UINT8 pre_open_close : 1;  // byte 3
  UINT8 unused_4 : 4;        // byte 3
  UINT64 timestamp;          // bytes 4 to 11
} SecurityStatusMessage;

// During the AoD this message is used to publish the indicative price and indicative matched volume. The first AoD update message signals the start of an auction.
typedef struct _AodUpdateMessage {
  UINT16 security_id;       // bytes 0 to 1
  UINT64 indicative_price;  // bytes 2 to 9
  UINT32 match_vol;         // bytes 10 to 13
  UINT64 timestamp;         // bytes 14 to 21
} AodUpdateMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: unit heartbeat_message;
    case 0x02: OrderAddMessage order_add_message;
    case 0x03: OrderCancelMessage order_cancel_message;
    case 0x04: OrderModifyMessage order_modify_message;
    case 0x14: QuoteAddReplaceMessage quote_add_replace_message;
    case 0x15: QuoteCancelMessage quote_cancel_message;
    case 0x05: TradeMessage trade_message;
    case 0x19: TradeReportMessage trade_report_message;
    case 0x1A: TradeReportModifyMessage trade_report_modify_message;
    case 0x1B: TradeReportCancelMessage trade_report_cancel_message;
    case 0x06: TradeBustMessage trade_bust_message;
    case 0x16: SecurityStatisticsMessage security_statistics_message;
    case 0x17: TraderDefinitionMessage trader_definition_message;
    case 0x07: TickTableDataMessage tick_table_data_message;
    case 0x08: SecurityDefinitionMessage security_definition_message;
    case 0x09: SecurityStatusMessage security_status_message;
    case 0x11: AodUpdateMessage aod_update_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Aquis Amd Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT8 msg_type;                                                                                                                                                  // byte 0
  UINT8 msg_length { msg_length >= 6 };                                                                                                                            // byte 1
  UINT32 seq_no;                                                                                                                                                   // bytes 2 to 5
  Payload(msg_type, (((UINT32) msg_length) - 6)) payload[:byte-size-single-element-array (((UINT32) msg_length) - 6)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Aquis Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 1) {
  UINT8 message_count;                                                                                                      // byte 0
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 1)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} Packet;

