// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AquisEquities_Replay_v2_5.3d

// ---- Values ------------------------------------------------------------------

// Msg Type: one byte code
#define MSG_TYPE_LOGIN_MESSAGE 0x0D            // Login Message
#define MSG_TYPE_REPLAY_REQUEST_MESSAGE 0x0E   // Replay Request Message
#define MSG_TYPE_REPLAY_RESPONSE_MESSAGE 0x0F  // Replay Response Message

// Response Code: one byte code
#define RESPONSE_CODE_LOGIN_SUCCESSFUL 0x00                    // Login Successful
#define RESPONSE_CODE_BAD_BEGIN_SEQ_NO_IN_RESEND_REQUEST 0x01  // Bad Begin Seq No In Resend Request
#define RESPONSE_CODE_BAD_END_SEQ_NO_IN_RESEND_REQUEST 0x02    // Bad End Seq No In Resend Request

// ---- Types -------------------------------------------------------------------

// If a recipient wishes to use the message replay service, they must first be authenticated by sending a Login message to the relevant replay server.
typedef struct _LoginMessage {
  UINT8 username[10];  // bytes 0 to 9
  UINT8 password[10];  // bytes 10 to 19
} LoginMessage;

// The recipient sends a Replay Request message to request a particular message or range of messages from the replay server.
typedef struct _ReplayRequestMessage {
  UINT32 begin_seq_no;  // bytes 0 to 3
  UINT32 end_seq_no;    // bytes 4 to 7
} ReplayRequestMessage;

// Aquis will send a Replay Response message to the recipient to acknowledge a successful Login or to report problems with a Resend Request.
typedef struct _ReplayResponseMessage {
  UINT8 response_code;  // byte 0
} ReplayResponseMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x0D: LoginMessage login_message;
    case 0x0E: ReplayRequestMessage replay_request_message;
    case 0x0F: ReplayResponseMessage replay_response_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Aquis Amd Message
typedef struct _Message {
  UINT8 msg_type;                                                                                                       // byte 0
  UINT8 msg_length { msg_length >= 6 };                                                                                 // byte 1
  UINT32 seq_no;                                                                                                        // bytes 2 to 5
  Payload(msg_type, (((UINT32) msg_length) - 6)) payload[:byte-size-single-element-array (((UINT32) msg_length) - 6)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Aquis Tcp Packet
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

