// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out BivaEquities_TotalView_Glimpse_v1_12_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_TIME_STAMP_SECONDS_MESSAGE 0x54         // Time Stamp Seconds Message
#define SEQUENCED_MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53               // System Event Message
#define SEQUENCED_MESSAGE_TYPE_PRICE_TICK_SIZE_MESSAGE 0x4C            // Price Tick Size Message
#define SEQUENCED_MESSAGE_TYPE_QUANTITY_TICK_SIZE_MESSAGE 0x4D         // Quantity Tick Size Message
#define SEQUENCED_MESSAGE_TYPE_ORDERBOOK_DIRECTORY_MESSAGE 0x52        // Orderbook Directory Message
#define SEQUENCED_MESSAGE_TYPE_PARTICIPANT_DIRECTORY_MESSAGE 0x46      // Participant Directory Message
#define SEQUENCED_MESSAGE_TYPE_ORDERBOOK_TRADING_ACTION_MESSAGE 0x48   // Orderbook Trading Action Message
#define SEQUENCED_MESSAGE_TYPE_ORDERBOOK_REFERENCE_PRICE_MESSAGE 0x58  // Orderbook Reference Price Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x41                  // Add Order Message
#define SEQUENCED_MESSAGE_TYPE_INDICATIVE_PRICE_QUANTITY_MESSAGE 0x49  // Indicative Price Quantity Message
#define SEQUENCED_MESSAGE_TYPE_GLIMPSE_SNAPSHOT_MESSAGE 0x47           // Glimpse Snapshot Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F            // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53        // Start Of System Hours
#define EVENT_CODE_START_OF_MARKET_HOURS 0x51        // Start Of Market Hours
#define EVENT_CODE_END_OF_MARKET_HOURS 0x4D          // End Of Market Hours
#define EVENT_CODE_SCHEDULED_AUCTION_STARTS 0x56     // Scheduled Auction Starts
#define EVENT_CODE_SCHEDULED_AUCTION_CLOSES 0x55     // Scheduled Auction Closes
#define EVENT_CODE_START_OF_POST_CLOSE_SESSION 0x50  // Start Of Post Close Session
#define EVENT_CODE_END_OF_POST_CLOSE_SESSION 0x54    // End Of Post Close Session
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45          // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43              // End Of Messages

// Listing Type: one byte code
#define LISTING_TYPE_REGULAR_SECURITIES 0x52  // Regular Securities
#define LISTING_TYPE_SUB_RM_SECURITIES 0x53   // Sub Rm Securities

// Trading State: one byte code
#define TRADING_STATE_TRADING 0x54    // Trading
#define TRADING_STATE_SUSPENDED 0x56  // Suspended

// Trading Action Reason: one byte code
#define TRADING_ACTION_REASON_NORMAL_TRADING 0x4E                               // Normal Trading
#define TRADING_ACTION_REASON_VOLATILITY_AUCTION 0x48                           // Volatility Auction
#define TRADING_ACTION_REASON_CONTINUOUS_AUCTION_START 0x41                     // Continuous Auction Start
#define TRADING_ACTION_REASON_CONTINUOUS_AUCTION_END 0x42                       // Continuous Auction End
#define TRADING_ACTION_REASON_NEWS_PENDING 0x51                                 // News Pending
#define TRADING_ACTION_REASON_STATIC_PRICE_BAND_BREACH 0x53                     // Static Price Band Breach
#define TRADING_ACTION_REASON_MARKET_SURVEILLANCE_SUSPENSION 0x4D               // Market Surveillance Suspension
#define TRADING_ACTION_REASON_SUSPENSION_BY_MARKET_OF_ORIGIN 0x4F               // Suspension By Market Of Origin
#define TRADING_ACTION_REASON_NON_COMPLIANCE 0x43                               // Non Compliance
#define TRADING_ACTION_REASON_START_OF_INDICATION_OF_INTEREST 0x49              // Start Of Indication Of Interest
#define TRADING_ACTION_REASON_EXPIRED_SECURITY_IS_UNAVAILABLE_FOR_TRADING 0x45  // Expired Security Is Unavailable For Trading
#define TRADING_ACTION_REASON_NOT_YET_AVAILABLE_FOR_TRADING 0x4C                // Not Yet Available For Trading

// Price Type: one byte code
#define PRICE_TYPE_CLOSE_PRICE 0x43      // Close Price
#define PRICE_TYPE_REFERENCE_PRICE 0x52  // Reference Price
#define PRICE_TYPE_INAV 0x49             // Inav
#define PRICE_TYPE_VWAP_OR_PPP 0x56      // Vwap Or Ppp

// Reference Price Reason: one byte code
#define REFERENCE_PRICE_REASON_NONE 0x20  // None

// Order Verb: one byte code
#define ORDER_VERB_BUY 0x42   // Buy
#define ORDER_VERB_SELL 0x53  // Sell

// Cross Type: one byte code
#define CROSS_TYPE_PRE_OPENING_SESSION 0x4F  // Pre Opening Session
#define CROSS_TYPE_INTRADAY_AUCTION 0x49     // Intraday Auction

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// Itch timestamp, number of seconds since midnight of the system start
typedef struct _TimeStampSecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} TimeStampSecondsMessage;

// System event message
typedef struct _SystemEventMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT8 group[8];        // bytes 4 to 11
  UINT8 event_code;      // byte 12
  UINT32BE orderbook;    // bytes 13 to 16
} SystemEventMessage;

// Orderbook price tick table
typedef struct _PriceTickSizeMessage {
  UINT32BE nanoseconds;         // bytes 0 to 3
  UINT32BE tick_size_table_id;  // bytes 4 to 7
  UINT32BE price_tick_size;     // bytes 8 to 11
  UINT32BE price_start;         // bytes 12 to 15
} PriceTickSizeMessage;

// Orderbook quantity tick table
typedef struct _QuantityTickSizeMessage {
  UINT32BE nanoseconds;         // bytes 0 to 3
  UINT32BE tick_size_table_id;  // bytes 4 to 7
  UINT64BE quantity_tick_size;  // bytes 8 to 15
  UINT64BE quantity_start;      // bytes 16 to 23
} QuantityTickSizeMessage;

// Orderbook directory
typedef struct _OrderbookDirectoryMessage {
  UINT32BE nanoseconds;                  // bytes 0 to 3
  UINT32BE orderbook;                    // bytes 4 to 7
  UINT8 isin[12];                        // bytes 8 to 19
  UINT8 sec_code[15];                    // bytes 20 to 34
  UINT8 currency[3];                     // bytes 35 to 37
  UINT8 group[8];                        // bytes 38 to 45
  UINT64BE minimum_quantity;             // bytes 46 to 53
  UINT32BE quantity_tick_size_table_id;  // bytes 54 to 57
  UINT32BE quantity_decimals;            // bytes 58 to 61
  UINT32BE price_tick_size_table_id;     // bytes 62 to 65
  UINT32BE price_decimals;               // bytes 66 to 69
  UINT32BE delisting_or_maturity_date;   // bytes 70 to 73
  UINT32BE delisting_time;               // bytes 74 to 77
  UINT8 turnover_ratio;                  // byte 78
  UINT8 quotation_basis[3];              // bytes 79 to 81
  UINT8 instrument[12];                  // bytes 82 to 93
  UINT8 listing_type;                    // byte 94
  UINT8 listing_exchange[4];             // bytes 95 to 98
} OrderbookDirectoryMessage;

// Participant directory
typedef struct _ParticipantDirectoryMessage {
  UINT32BE nanoseconds;        // bytes 0 to 3
  UINT32BE participant_id;     // bytes 4 to 7
  UINT8 participant_code[12];  // bytes 8 to 19
} ParticipantDirectoryMessage;

// Trading action message
typedef struct _OrderbookTradingActionMessage {
  UINT32BE nanoseconds;         // bytes 0 to 3
  UINT32BE orderbook;           // bytes 4 to 7
  UINT8 trading_state;          // byte 8
  UINT8 trading_action_reason;  // byte 9
} OrderbookTradingActionMessage;

// Orderbook reference price message
typedef struct _OrderbookReferencePriceMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3
  UINT32BE orderbook;            // bytes 4 to 7
  UINT32BE reference_price;      // bytes 8 to 11
  UINT8 price_type;              // byte 12
  UINT8 reference_price_reason;  // byte 13
} OrderbookReferencePriceMessage;

// Add order message
typedef struct _AddOrderMessage {
  UINT32BE nanoseconds;     // bytes 0 to 3
  UINT64BE order_number;    // bytes 4 to 11
  UINT8 order_verb;         // byte 12
  UINT64BE quantity;        // bytes 13 to 20
  UINT32BE orderbook;       // bytes 21 to 24
  UINT32BE price;           // bytes 25 to 28
  UINT32BE participant_id;  // bytes 29 to 32
} AddOrderMessage;

// Indicative price quantity message
typedef struct _IndicativePriceQuantityMessage {
  UINT32BE nanoseconds;                   // bytes 0 to 3
  UINT64BE theoretical_opening_quantity;  // bytes 4 to 11
  UINT32BE orderbook;                     // bytes 12 to 15
  UINT32BE best_bid;                      // bytes 16 to 19
  UINT32BE best_offer;                    // bytes 20 to 23
  UINT32BE theoretical_opening_price;     // bytes 24 to 27
  UINT8 cross_type;                       // byte 28
} IndicativePriceQuantityMessage;

// Glimpse snapshot message
typedef struct _GlimpseSnapshotMessage {
  UINT64BE sequence_number;  // bytes 0 to 7
} GlimpseSnapshotMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: TimeStampSecondsMessage time_stamp_seconds_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x4C: PriceTickSizeMessage price_tick_size_message;
    case 0x4D: QuantityTickSizeMessage quantity_tick_size_message;
    case 0x52: OrderbookDirectoryMessage orderbook_directory_message;
    case 0x46: ParticipantDirectoryMessage participant_directory_message;
    case 0x48: OrderbookTradingActionMessage orderbook_trading_action_message;
    case 0x58: OrderbookReferencePriceMessage orderbook_reference_price_message;
    case 0x41: AddOrderMessage add_order_message;
    case 0x49: IndicativePriceQuantityMessage indicative_price_quantity_message;
    case 0x47: GlimpseSnapshotMessage glimpse_snapshot_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat;
    case 0x5A: unit end_of_session;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

