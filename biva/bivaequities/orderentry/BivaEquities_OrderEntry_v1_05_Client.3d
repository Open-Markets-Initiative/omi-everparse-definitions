// Bolsa Institucional de Valores Order Entry
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out BivaEquities_OrderEntry_v1_05_Client.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - a length prefix framing what follows
//
// License: MIT No Attribution

// ---- Client Packet Header: 3 bytes -------------------------------------------

// Packet header of a packet sent by the client
entrypoint typedef struct _ClientPacketHeader {
  UINT16BE packet_length;    // bytes 0 to 1
  UINT8 client_packet_type;  // byte 2
} ClientPacketHeader;

// ---- Login Request Packet: 46 bytes ------------------------------------------

// The SoupBinTCP client must send a Login Request Packet immediately upon establishing a new TCP/IP socket connection to the server
entrypoint typedef struct _LoginRequestPacket {
  UINT8 username[6];                    // bytes 0 to 5
  UINT8 password[10];                   // bytes 6 to 15
  UINT8 requested_session[10];          // bytes 16 to 25
  UINT8 requested_sequence_number[20];  // bytes 26 to 45
} LoginRequestPacket;

// ---- Enter Order Message: 42 bytes -------------------------------------------

// Enter order message
entrypoint typedef struct _EnterOrderMessage {
  UINT32BE order_token;       // bytes 0 to 3
  UINT8 account_type;         // byte 4
  UINT32BE account_id;        // bytes 5 to 8
  UINT8 order_verb;           // byte 9
  UINT64BE quantity;          // bytes 10 to 17
  UINT32BE orderbook;         // bytes 18 to 21
  UINT32BE price;             // bytes 22 to 25
  UINT32BE time_in_force;     // bytes 26 to 29
  UINT32BE client_id;         // bytes 30 to 33
  UINT64BE minimum_quantity;  // bytes 34 to 41
} EnterOrderMessage;

// ---- Replace Order Message: 20 bytes -----------------------------------------

// Replace order message, the account id orderbook client id and order verb are inherited from the original order
entrypoint typedef struct _ReplaceOrderMessage {
  UINT32BE existing_order_token;     // bytes 0 to 3
  UINT32BE replacement_order_token;  // bytes 4 to 7
  UINT64BE quantity;                 // bytes 8 to 15
  UINT32BE price;                    // bytes 16 to 19
} ReplaceOrderMessage;

// ---- Cancel Order Message: 4 bytes -------------------------------------------

// Cancel order message
entrypoint typedef struct _CancelOrderMessage {
  UINT32BE order_token;  // bytes 0 to 3
} CancelOrderMessage;

