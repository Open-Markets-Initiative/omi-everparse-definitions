// Message Type: one byte code
#define MESSAGE_TYPE_LOGON_MESSAGE 0x41                         // Logon Message
#define MESSAGE_TYPE_LOGON_RESPONSE_MESSAGE 0x42                // Logon Response Message
#define MESSAGE_TYPE_LOGOUT_MESSAGE 0x35                        // Logout Message
#define MESSAGE_TYPE_HEARTBEAT_MESSAGE 0x30                     // Heartbeat Message
#define MESSAGE_TYPE_REJECT_MESSAGE 0x33                        // Reject Message
#define MESSAGE_TYPE_MISSED_MESSAGE_REQUEST_MESSAGE 0x4D        // Missed Message Request Message
#define MESSAGE_TYPE_MISSED_MESSAGE_REQUEST_ACK_MESSAGE 0x4E    // Missed Message Request Ack Message
#define MESSAGE_TYPE_TRANSMISSION_COMPLETE_MESSAGE 0x50         // Transmission Complete Message
#define MESSAGE_TYPE_SYSTEM_STATUS_MESSAGE 0x6E                 // System Status Message
#define MESSAGE_TYPE_NEW_ORDER_MESSAGE 0x44                     // New Order Message
#define MESSAGE_TYPE_ORDER_CANCEL_REQUEST_MESSAGE 0x46          // Order Cancel Request Message
#define MESSAGE_TYPE_ORDER_MASS_CANCEL_REQUEST_MESSAGE 0x71     // Order Mass Cancel Request Message
#define MESSAGE_TYPE_ORDER_CANCEL_REPLACE_REQUEST_MESSAGE 0x47  // Order Cancel Replace Request Message
#define MESSAGE_TYPE_SECURITY_DEFINITION_REQUEST_MESSAGE 0x4F   // Security Definition Request Message
#define MESSAGE_TYPE_EXECUTION_REPORT_MESSAGE 0x38              // Execution Report Message
#define MESSAGE_TYPE_ORDER_CANCEL_REJECT_MESSAGE 0x39           // Order Cancel Reject Message
#define MESSAGE_TYPE_ORDER_MASS_CANCEL_REPORT_MESSAGE 0x72      // Order Mass Cancel Report Message
#define MESSAGE_TYPE_SECURITY_DEFINITION_RESPONSE_MESSAGE 0x52  // Security Definition Response Message
#define MESSAGE_TYPE_NEWS_MESSAGE 0x5A                          // News Message
#define MESSAGE_TYPE_BUSINESS_REJECT_MESSAGE 0x6A               // Business Reject Message

// Missed Message Status: one byte code
#define MISSED_MESSAGE_STATUS_REQUEST_ACCEPTED_SUCCESSFUL 0x00  // Request Accepted Successful
#define MISSED_MESSAGE_STATUS_REQUEST_LIMIT_REACHED 0x01        // Request Limit Reached
#define MISSED_MESSAGE_STATUS_INVALID_PARTITION_ID 0x02         // Invalid Partition Id
#define MISSED_MESSAGE_STATUS_SERVICE_UNAVAILABLE 0x03          // Service Unavailable

// Transmission Status: one byte code
#define TRANSMISSION_STATUS_ALL_MESSAGES_TRANSMITTED 0x00  // All Messages Transmitted
#define TRANSMISSION_STATUS_MESSAGE_LIMIT_REACHED 0x01     // Message Limit Reached
#define TRANSMISSION_STATUS_SERVICE_UNAVAILABLE 0x03       // Service Unavailable

// System Status: one byte code
#define SYSTEM_STATUS_RECOVERY_SERVICE_RESUMED 0x01      // Recovery Service Resumed
#define SYSTEM_STATUS_RECOVERY_SERVICE_UNAVAILABLE 0x02  // Recovery Service Unavailable
#define SYSTEM_STATUS_PARTITION_SUSPENDED 0x03           // Partition Suspended

// Order Type: one byte code
#define ORDER_TYPE_MARKET_ORDER 0x01           // Market Order
#define ORDER_TYPE_LIMIT_ORDER 0x02            // Limit Order
#define ORDER_TYPE_STOP_ORDER 0x03             // Stop Order
#define ORDER_TYPE_STOP_LIMIT_ORDER 0x04       // Stop Limit Order
#define ORDER_TYPE_MARKET_TO_LIMIT_ORDER 0x05  // Market To Limit Order
#define ORDER_TYPE_MARKET_IF_TOUCHED 0x06      // Market If Touched

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY 0x00                            // Day
#define TIME_IN_FORCE_GOOD_TILL_CANCEL_GTC 0x01           // Good Till Cancel Gtc
#define TIME_IN_FORCE_IMMEDIATE_OR_CANCEL_IOC 0x03        // Immediate Or Cancel Ioc
#define TIME_IN_FORCE_FILL_OR_KILL_FOK 0x04               // Fill Or Kill Fok
#define TIME_IN_FORCE_AT_THE_OPEN_OPG 0x05                // At The Open Opg
#define TIME_IN_FORCE_GOOD_TILL_DATE_GTD 0x06             // Good Till Date Gtd
#define TIME_IN_FORCE_GOOD_TILL_TIME_GTT 0x08             // Good Till Time Gtt
#define TIME_IN_FORCE_GOOD_FOR_AUCTION_GFA 0x09           // Good For Auction Gfa
#define TIME_IN_FORCE_AT_THE_CLOSE_ATC 0x0A               // At The Close Atc
#define TIME_IN_FORCE_CLOSING_PRICE_CROSS_CPX 0x0C        // Closing Price Cross Cpx
#define TIME_IN_FORCE_GOOD_FOR_INTRADAY_AUCTION_GFX 0x33  // Good For Intraday Auction Gfx

// Side: one byte code
#define SIDE_BUY 0x01   // Buy
#define SIDE_SELL 0x02  // Sell

// Capacity: one byte code
#define CAPACITY_PRINCIPAL 0x02  // Principal
#define CAPACITY_AGENCY 0x03     // Agency

// Cancel On Disconnect: one byte code
#define CANCEL_ON_DISCONNECT_DO_NOT_CANCEL 0x00  // Do Not Cancel
#define CANCEL_ON_DISCONNECT_CANCEL 0x01         // Cancel

// Order Book: one byte code
#define ORDER_BOOK_REGULAR 0x01            // Regular
#define ORDER_BOOK_BULLETIN_BOARD 0x09     // Bulletin Board
#define ORDER_BOOK_NEGOTIATED_TRADES 0x0B  // Negotiated Trades
#define ORDER_BOOK_FX_AUCTION 0x33         // Fx Auction

// Anonymity: one byte code
#define ANONYMITY_ANONYMOUS 0x00  // Anonymous
#define ANONYMITY_NAMED 0x01      // Named

// Mass Cancel Request Type: one byte code
#define MASS_CANCEL_REQUEST_TYPE_ALL_FIRM_ORDERS_FOR_INSTRUMENT 0x03                  // All Firm Orders For Instrument
#define MASS_CANCEL_REQUEST_TYPE_ALL_FIRM_ORDERS_FOR_SEGMENT 0x04                     // All Firm Orders For Segment
#define MASS_CANCEL_REQUEST_TYPE_ALL_ORDERS_FOR_CLIENT_INTERFACE_USER_ID 0x07         // All Orders For Client Interface User Id
#define MASS_CANCEL_REQUEST_TYPE_ALL_ORDERS_FOR_FIRM 0x08                             // All Orders For Firm
#define MASS_CANCEL_REQUEST_TYPE_CLIENT_INTERFACE_USER_ID_ORDERS_FOR_INSTRUMENT 0x09  // Client Interface User Id Orders For Instrument
#define MASS_CANCEL_REQUEST_TYPE_CLIENT_INTEREST_FOR_UNDERLYING 0x0E                  // Client Interest For Underlying
#define MASS_CANCEL_REQUEST_TYPE_CLIENT_INTERFACE_USER_ID_ORDERS_FOR_SEGMENT 0x0F     // Client Interface User Id Orders For Segment
#define MASS_CANCEL_REQUEST_TYPE_FIRM_INTEREST_FOR_UNDERLYING 0x16                    // Firm Interest For Underlying

// Order Sub Type: one byte code
#define ORDER_SUB_TYPE_ORDER 0x00  // Order
#define ORDER_SUB_TYPE_QUOTE 0x03  // Quote

// Security Type: one byte code
#define SECURITY_TYPE_FUTURE 0x01        // Future
#define SECURITY_TYPE_CALL_OPTION 0x02   // Call Option
#define SECURITY_TYPE_PUT_OPTION 0x03    // Put Option
#define SECURITY_TYPE_FWD_FWD 0x63       // Fwd Fwd
#define SECURITY_TYPE_DELTA_OPTION 0x64  // Delta Option

// Reference Instrument Identifier: one byte code
#define REFERENCE_INSTRUMENT_IDENTIFIER_SYMBOL 0x00         // Symbol
#define REFERENCE_INSTRUMENT_IDENTIFIER_INSTRUMENT_ID 0x01  // Instrument Id

// Execution Type: one byte code
#define EXECUTION_TYPE_NEW 0x30               // New
#define EXECUTION_TYPE_CANCELLED 0x34         // Cancelled
#define EXECUTION_TYPE_AMENDED_MODIFIED 0x35  // Amended Modified
#define EXECUTION_TYPE_REJECTED 0x38          // Rejected
#define EXECUTION_TYPE_SUSPENDED 0x39         // Suspended
#define EXECUTION_TYPE_EXPIRED 0x43           // Expired
#define EXECUTION_TYPE_TRADE 0x46             // Trade
#define EXECUTION_TYPE_TRADE_CORRECT 0x47     // Trade Correct
#define EXECUTION_TYPE_TRADE_CANCEL 0x48      // Trade Cancel
#define EXECUTION_TYPE_RESTATED 0x44          // Restated
#define EXECUTION_TYPE_TRIGGERED 0x4C         // Triggered

// Order Status: one byte code
#define ORDER_STATUS_NEW 0x00               // New
#define ORDER_STATUS_PARTIALLY_FILLED 0x01  // Partially Filled
#define ORDER_STATUS_FILLED 0x02            // Filled
#define ORDER_STATUS_CANCELLED 0x04         // Cancelled
#define ORDER_STATUS_EXPIRED 0x06           // Expired
#define ORDER_STATUS_REJECTED 0x08          // Rejected
#define ORDER_STATUS_SUSPENDED 0x09         // Suspended

// Working Indicator: one byte code
#define WORKING_INDICATOR_UNSET 0x00                                      // Unset
#define WORKING_INDICATOR_ORDER_IS_BEING_WORKED 0x01                      // Order Is Being Worked
#define WORKING_INDICATOR_ORDER_IS_NOT_CURRENTLY_IN_A_WORKING_STATE 0x02  // Order Is Not Currently In A Working State

// Is Market Ops Request: one byte code
#define IS_MARKET_OPS_REQUEST_NO 0x00   // No
#define IS_MARKET_OPS_REQUEST_YES 0x01  // Yes

// Execution Instruction: one byte code
#define EXECUTION_INSTRUCTION_DO_NOT_EXCLUDE_HIDDEN_LIMIT_ORDERS 0x00  // Do Not Exclude Hidden Limit Orders
#define EXECUTION_INSTRUCTION_EXCLUDE_HIDDEN_LIMIT_ORDERS 0x01         // Exclude Hidden Limit Orders

// Multi Leg Reporting Type: one byte code
#define MULTI_LEG_REPORTING_TYPE_TRADE_OF_SINGLE_INSTRUMENT 0x01           // Trade Of Single Instrument
#define MULTI_LEG_REPORTING_TYPE_LEG_TRADE_OF_A_MULTI_LEG_INSTRUMENT 0x02  // Leg Trade Of A Multi Leg Instrument
#define MULTI_LEG_REPORTING_TYPE_TRADE_OF_MULTI_LEG_INSTRUMENT 0x03        // Trade Of Multi Leg Instrument

// Mass Cancel Status: one byte code
#define MASS_CANCEL_STATUS_REJECTED 0x00  // Rejected
#define MASS_CANCEL_STATUS_ACCEPTED 0x07  // Accepted

// Security Response Type: one byte code
#define SECURITY_RESPONSE_TYPE_REJECTED 0x00  // Rejected
#define SECURITY_RESPONSE_TYPE_ACCEPTED 0x01  // Accepted

// Urgency: one byte code
#define URGENCY_REGULAR 0x30        // Regular
#define URGENCY_HIGH_PRIORITY 0x31  // High Priority
#define URGENCY_LOW_PRIORITY 0x32   // Low Priority

// ---- Types -------------------------------------------------------------------

// Allows the client to login to the server.
typedef struct _LogonMessage {
  UINT8 comp_id[6];         // bytes 0 to 5
  UINT8 password[25];       // bytes 6 to 30
  UINT8 new_password[25];   // bytes 31 to 55
  UINT32 protocol_version;  // bytes 56 to 59, signed, read here as unsigned
} LogonMessage;

// Used by the server to accept or reject a login request.
typedef struct _LogonResponseMessage {
  UINT32 reject_code;      // bytes 0 to 3, signed, read here as unsigned
  UINT32 password_expiry;  // bytes 4 to 7, signed, read here as unsigned
} LogonResponseMessage;

// Used by the client or server to terminate a session.
typedef struct _LogoutMessage {
  UINT8 reason[20];  // bytes 0 to 19
} LogoutMessage;

// Used by the server to reject a message that does not comply with the specifications.
typedef struct _RejectMessage {
  UINT32 reject_code;         // bytes 0 to 3, signed, read here as unsigned
  UINT8 reject_reason[30];    // bytes 4 to 33
  UINT8 message_type;         // byte 34
  UINT8 client_order_id[20];  // bytes 35 to 54
} RejectMessage;

// Used by the client to recover missed messages through the Recovery Channel.
typedef struct _MissedMessageRequestMessage {
  UINT8 partition_id;      // byte 0
  UINT32 sequence_number;  // bytes 1 to 4, signed, read here as unsigned
} MissedMessageRequestMessage;

// Used by the server to accept or reject a request for missed messages.
typedef struct _MissedMessageRequestAckMessage {
  UINT8 missed_message_status;  // byte 0
} MissedMessageRequestAckMessage;

// Used by the server to indicate that the transmission of missed messages is complete.
typedef struct _TransmissionCompleteMessage {
  UINT8 transmission_status;  // byte 0
} TransmissionCompleteMessage;

// Disseminated in the recovery channel to indicate the status of a partition.
typedef struct _SystemStatusMessage {
  UINT8 partition_id;   // byte 0
  UINT8 system_status;  // byte 1
} SystemStatusMessage;

// Allows the client to submit a new order.
typedef struct _NewOrderMessage {
  UINT8 client_order_id[20];            // bytes 0 to 19
  UINT32 security_id;                   // bytes 20 to 23, signed, read here as unsigned
  UINT8 trader_mnemonic[17];            // bytes 24 to 40
  UINT8 account[10];                    // bytes 41 to 50
  UINT8 order_type;                     // byte 51
  UINT8 time_in_force;                  // byte 52
  UINT8 expire_time[17];                // bytes 53 to 69
  UINT8 side;                           // byte 70
  UINT32 order_quantity;                // bytes 71 to 74, signed, read here as unsigned
  UINT32 display_quantity;              // bytes 75 to 78, signed, read here as unsigned
  UINT32 minimum_quantity;              // bytes 79 to 82, signed, read here as unsigned
  UINT64 limit_price;                   // bytes 83 to 90, signed, read here as unsigned
  UINT64 stop_price;                    // bytes 91 to 98, signed, read here as unsigned
  UINT8 capacity;                       // byte 99
  UINT8 cancel_on_disconnect;           // byte 100
  UINT8 order_book;                     // byte 101
  UINT8 anonymity;                      // byte 102
  UINT64 trailing_offset;               // bytes 103 to 110, signed, read here as unsigned
  UINT8 secondary_trade_report_id[10];  // bytes 111 to 120
} NewOrderMessage;

// Allows the client to cancel an Open or Parked order.
typedef struct _OrderCancelRequestMessage {
  UINT8 client_order_id[20];       // bytes 0 to 19
  UINT8 orig_client_order_id[20];  // bytes 20 to 39
  UINT8 order_id_alpha_12[12];     // bytes 40 to 51
  UINT32 security_id;              // bytes 52 to 55, signed, read here as unsigned
  UINT8 trader_mnemonic[17];       // bytes 56 to 72
  UINT8 side;                      // byte 73
  UINT8 order_book;                // byte 74
  UINT8 rfq_id[10];                // bytes 75 to 84
} OrderCancelRequestMessage;

// Allows the client to mass cancel orders.
typedef struct _OrderMassCancelRequestMessage {
  UINT8 client_order_id[20];       // bytes 0 to 19
  UINT8 mass_cancel_request_type;  // byte 20
  UINT32 security_id;              // bytes 21 to 24, signed, read here as unsigned
  UINT8 segment[6];                // bytes 25 to 30
  UINT8 order_sub_type;            // byte 31
  UINT8 order_book;                // byte 32
} OrderMassCancelRequestMessage;

// Allows the client to modify an Open or Parked order.
typedef struct _OrderCancelReplaceRequestMessage {
  UINT8 client_order_id[20];            // bytes 0 to 19
  UINT8 original_client_order_id[20];   // bytes 20 to 39
  UINT8 order_id_string_12[12];         // bytes 40 to 51
  UINT32 security_id;                   // bytes 52 to 55, signed, read here as unsigned
  UINT8 trader_mnemonic[17];            // bytes 56 to 72
  UINT8 account[10];                    // bytes 73 to 82
  UINT8 order_type;                     // byte 83
  UINT8 time_in_force;                  // byte 84
  UINT8 expire_time[17];                // bytes 85 to 101
  UINT8 side;                           // byte 102
  UINT32 order_quantity;                // bytes 103 to 106, signed, read here as unsigned
  UINT32 display_quantity;              // bytes 107 to 110, signed, read here as unsigned
  UINT32 minimum_quantity;              // bytes 111 to 114, signed, read here as unsigned
  UINT64 limit_price;                   // bytes 115 to 122, signed, read here as unsigned
  UINT64 stop_price;                    // bytes 123 to 130, signed, read here as unsigned
  UINT8 order_book;                     // byte 131
  UINT8 secondary_trade_report_id[10];  // bytes 132 to 141
} OrderCancelReplaceRequestMessage;

// Allows the client to request an instrument creation intra-day.
typedef struct _SecurityDefinitionRequestMessage {
  UINT8 security_request_id[10];          // bytes 0 to 9
  UINT8 security_type;                    // byte 10
  UINT64 strike_price;                    // bytes 11 to 18, signed, read here as unsigned
  UINT8 maturity_date[8];                 // bytes 19 to 26
  UINT8 reference_instrument_identifier;  // byte 27
  UINT8 reference_instrument[25];         // bytes 28 to 52
  UINT64 reference_price;                 // bytes 53 to 60, signed, read here as unsigned
  UINT32 near_month_type;                 // bytes 61 to 64, signed, read here as unsigned
  UINT32 far_month_type;                  // bytes 65 to 68, signed, read here as unsigned
  UINT8 far_maturity_date[8];             // bytes 69 to 76
} SecurityDefinitionRequestMessage;

// Time the Execution Report was generated
typedef struct _TransactTime {
  UINT32 transact_time_seconds;      // bytes 0 to 3
  UINT32 transact_time_nanoseconds;  // bytes 4 to 7
} TransactTime;

// Indicates the status of an order.
typedef struct _ExecutionReportMessage {
  UINT8 partition_id;                   // byte 0
  UINT32 sequence_number;               // bytes 1 to 4, signed, read here as unsigned
  UINT8 execution_id[21];               // bytes 5 to 25
  UINT8 client_order_id[20];            // bytes 26 to 45
  UINT8 order_id_alpha_12[12];          // bytes 46 to 57
  UINT8 execution_type;                 // byte 58
  UINT8 order_status;                   // byte 59
  UINT32 reject_code;                   // bytes 60 to 63, signed, read here as unsigned
  UINT64 executed_price;                // bytes 64 to 71, signed, read here as unsigned
  UINT32 executed_quantity;             // bytes 72 to 75, signed, read here as unsigned
  UINT32 leaves_quantity;               // bytes 76 to 79, signed, read here as unsigned
  UINT8 working_indicator;              // byte 80
  UINT32 security_id;                   // bytes 81 to 84, signed, read here as unsigned
  UINT8 side;                           // byte 85
  UINT8 trader_mnemonic[17];            // bytes 86 to 102
  UINT8 account[10];                    // bytes 103 to 112
  UINT8 is_market_ops_request;          // byte 113
  TransactTime transact_time;           // bytes 114 to 121
  UINT8 order_book;                     // byte 122
  UINT8 execution_instruction;          // byte 123, signed, read here as unsigned
  UINT8 multi_leg_reporting_type;       // byte 124
  UINT64 last_opt_px;                   // bytes 125 to 132, signed, read here as unsigned
  UINT64 volatility;                    // bytes 133 to 140, signed, read here as unsigned
  UINT8 secondary_trade_report_id[10];  // bytes 141 to 150
  UINT8 aggressor_indicator : 1;        // byte 151
  UINT8 reserved_28 : 7;                // byte 151
} ExecutionReportMessage;

// Indicates that an order cancel or cancel replace request has been rejected.
typedef struct _OrderCancelRejectMessage {
  UINT8 partition_id;           // byte 0
  UINT32 sequence_number;       // bytes 1 to 4, signed, read here as unsigned
  UINT8 client_order_id[20];    // bytes 5 to 24
  UINT8 order_id_alpha_12[12];  // bytes 25 to 36
  TransactTime transact_time;   // bytes 37 to 44
  UINT32 reject_code;           // bytes 45 to 48, signed, read here as unsigned
  UINT8 order_book;             // byte 49
  UINT8 rfq_id[10];             // bytes 50 to 59
} OrderCancelRejectMessage;

// Indicates the outcome of an order mass cancel request.
typedef struct _OrderMassCancelReportMessage {
  UINT8 partition_id;          // byte 0
  UINT32 sequence_number;      // bytes 1 to 4, signed, read here as unsigned
  UINT8 client_order_id[20];   // bytes 5 to 24
  UINT8 mass_cancel_status;    // byte 25
  UINT32 reject_code;          // bytes 26 to 29, signed, read here as unsigned
  TransactTime transact_time;  // bytes 30 to 37
  UINT8 order_book;            // byte 38
} OrderMassCancelReportMessage;

// Indicates that a Security Definition Request has been accepted or rejected.
typedef struct _SecurityDefinitionResponseMessage {
  UINT8 security_request_id[10];  // bytes 0 to 9
  UINT8 security_response_type;   // byte 10
  UINT32 reject_code;             // bytes 11 to 14, signed, read here as unsigned
  UINT32 security_id;             // bytes 15 to 18, signed, read here as unsigned
  UINT8 security_type;            // byte 19
} SecurityDefinitionResponseMessage;

// Carries a market operations announcement.
typedef struct _NewsMessage {
  UINT8 partition_id;      // byte 0
  UINT32 sequence_number;  // bytes 1 to 4, signed, read here as unsigned
  UINT8 orig_time[24];     // bytes 5 to 28
  UINT8 urgency;           // byte 29
  UINT8 headline[100];     // bytes 30 to 129
  UINT8 text[750];         // bytes 130 to 879
  UINT8 instruments[100];  // bytes 880 to 979
  UINT8 underlyings[100];  // bytes 980 to 1079
  UINT8 firm_list[54];     // bytes 1080 to 1133
  UINT8 user_list[54];     // bytes 1134 to 1187
} NewsMessage;

// Indicates that an application message could not be processed.
typedef struct _BusinessRejectMessage {
  UINT8 partition_id;           // byte 0
  UINT32 sequence_number;       // bytes 1 to 4, signed, read here as unsigned
  UINT32 reject_code;           // bytes 5 to 8, signed, read here as unsigned
  UINT8 client_order_id[20];    // bytes 9 to 28
  UINT8 order_id_alpha_12[12];  // bytes 29 to 40
  TransactTime transact_time;   // bytes 41 to 48
} BusinessRejectMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: LogonMessage logon_message;
    case 0x42: LogonResponseMessage logon_response_message;
    case 0x35: LogoutMessage logout_message;
    case 0x30: unit heartbeat_message;
    case 0x33: RejectMessage reject_message;
    case 0x4D: MissedMessageRequestMessage missed_message_request_message;
    case 0x4E: MissedMessageRequestAckMessage missed_message_request_ack_message;
    case 0x50: TransmissionCompleteMessage transmission_complete_message;
    case 0x6E: SystemStatusMessage system_status_message;
    case 0x44: NewOrderMessage new_order_message;
    case 0x46: OrderCancelRequestMessage order_cancel_request_message;
    case 0x71: OrderMassCancelRequestMessage order_mass_cancel_request_message;
    case 0x47: OrderCancelReplaceRequestMessage order_cancel_replace_request_message;
    case 0x4F: SecurityDefinitionRequestMessage security_definition_request_message;
    case 0x38: ExecutionReportMessage execution_report_message;
    case 0x39: OrderCancelRejectMessage order_cancel_reject_message;
    case 0x72: OrderMassCancelReportMessage order_mass_cancel_report_message;
    case 0x52: SecurityDefinitionResponseMessage security_definition_response_message;
    case 0x5A: NewsMessage news_message;
    case 0x6A: BusinessRejectMessage business_reject_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Native Trading Gateway Message
typedef struct _Message {
  UINT8 start_of_message;                                                                                                                       // byte 0
  UINT16 message_length { message_length >= 1 };                                                                                                // bytes 1 to 2
  UINT8 message_type;                                                                                                                           // byte 3
  Payload(message_type, ((((UINT32) message_length) + 3) - 4)) payload[:byte-size-single-element-array ((((UINT32) message_length) + 3) - 4)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Jse Native Trading Gateway Tcp Message Block
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

