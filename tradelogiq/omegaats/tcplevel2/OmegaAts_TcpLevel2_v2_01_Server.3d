// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out OmegaAts_TcpLevel2_v2_01_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53               // System Event Message
#define MESSAGE_TYPE_STOCK_DIRECTORY_MESSAGE 0x52            // Stock Directory Message
#define MESSAGE_TYPE_EXTENDED_STOCK_DIRECTORY_MESSAGE 0x72   // Extended Stock Directory Message
#define MESSAGE_TYPE_STOCK_TRADING_ACTION_MESSAGE 0x48       // Stock Trading Action Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x41                  // Add Order Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45             // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_WITH_PRICE_MESSAGE 0x43  // Order Executed With Price Message
#define MESSAGE_TYPE_ORDER_DELETE_MESSAGE 0x44               // Order Delete Message
#define MESSAGE_TYPE_ORDER_REPLACE_MESSAGE 0x55              // Order Replace Message
#define MESSAGE_TYPE_ORDER_CANCEL_MESSAGE 0x58               // Order Cancel Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x50                      // Trade Message
#define MESSAGE_TYPE_CROSS_TRADE_MESSAGE 0x51                // Cross Trade Message
#define MESSAGE_TYPE_TRADE_BUST_MESSAGE 0x42                 // Trade Bust Message
#define MESSAGE_TYPE_TRADE_AMEND_MESSAGE 0x4D                // Trade Amend Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F      // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53  // Start Of System Hours
#define EVENT_CODE_START_OF_MARKET_HOURS 0x51  // Start Of Market Hours
#define EVENT_CODE_END_OF_MARKET_HOURS 0x4D    // End Of Market Hours
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45    // End Of System Hours
#define EVENT_CODE_END_OF_MESSAGES 0x43        // End Of Messages
#define EVENT_CODE_TRADING_HALTED 0x42         // Trading Halted
#define EVENT_CODE_TRADING_RESUMED 0x52        // Trading Resumed

// Market: one byte code
#define MARKET_TSX 0x74            // Tsx
#define MARKET_TSX_VENTURE 0x76    // Tsx Venture
#define MARKET_CSE 0x63            // Cse
#define MARKET_NASDAQ_CANADA 0x71  // Nasdaq Canada
#define MARKET_OMEGA_ATS 0x6F      // Omega Ats
#define MARKET_CBOE_CANADA 0x7A    // Cboe Canada

// Shortable: one byte code
#define SHORTABLE_SHORT_EXEMPT 0x45   // Short Exempt
#define SHORTABLE_SHORTABLE 0x53      // Shortable
#define SHORTABLE_NOT_SHORTABLE 0x4E  // Not Shortable

// Dividend Indicator: one byte code
#define DIVIDEND_INDICATOR_ANNUAL 0x41       // Annual
#define DIVIDEND_INDICATOR_SEMI_ANNUAL 0x53  // Semi Annual
#define DIVIDEND_INDICATOR_QUARTERLY 0x51    // Quarterly
#define DIVIDEND_INDICATOR_MONTHLY 0x4D      // Monthly

// Frequency: one byte code
#define FREQUENCY_ANNUAL 0x41       // Annual
#define FREQUENCY_SEMI_ANNUAL 0x53  // Semi Annual
#define FREQUENCY_QUARTERLY 0x51    // Quarterly
#define FREQUENCY_MONTHLY 0x4D      // Monthly

// Security Type: one byte code
#define SECURITY_TYPE_BONDS 0x62       // Bonds
#define SECURITY_TYPE_DEBENTURES 0x64  // Debentures
#define SECURITY_TYPE_RIGHTS 0x72      // Rights
#define SECURITY_TYPE_NOTES 0x6E       // Notes
#define SECURITY_TYPE_WARRANTS 0x77    // Warrants

// Trading State: one byte code
#define TRADING_STATE_HALTED 0x48   // Halted
#define TRADING_STATE_TRADING 0x54  // Trading

// Buy Sell Indicator: one byte code
#define BUY_SELL_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define BUY_SELL_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Midpoint Book Trade: 4 byte code
#define MIDPOINT_BOOK_TRADE_NO 0x00000000   // No
#define MIDPOINT_BOOK_TRADE_YES 0x00000001  // Yes

// Cross Type: one byte code
#define CROSS_TYPE_DERIVATIVES_CROSS 0x44      // Derivatives Cross
#define CROSS_TYPE_INTERNAL_CROSS 0x49         // Internal Cross
#define CROSS_TYPE_INTENTIONAL_CROSS 0x4D      // Intentional Cross
#define CROSS_TYPE_NET_ASSET_VALUE_CROSS 0x4E  // Net Asset Value Cross

// Bypass: one byte code
#define BYPASS_BYPASS 0x59      // Bypass
#define BYPASS_NON_BYPASS 0x4E  // Non Bypass

// Settlement Type: one byte code
#define SETTLEMENT_TYPE_REGULAR_SETTLEMENT 0x30  // Regular Settlement
#define SETTLEMENT_TYPE_CASH 0x31                // Cash
#define SETTLEMENT_TYPE_NEXT_DAY 0x32            // Next Day
#define SETTLEMENT_TYPE_DELAYED_DELIVERY 0x33    // Delayed Delivery

// ---- Types -------------------------------------------------------------------

// The server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The server sends this packet in response to an invalid Login Request Packet from the client and closes the socket connection
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// The system event message type is used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT8 event_code;     // byte 0
  UINT8 reserved_2[2];  // bytes 1 to 2
  UINT64BE timestamp;   // bytes 3 to 10
} SystemEventMessage;

// At the start of each trading day, Tradelogiq disseminates stock directory messages for all supported securities.
typedef struct _StockDirectoryMessage {
  UINT8 market;              // byte 0
  UINT8 stock[10];           // bytes 1 to 10
  UINT64BE timestamp;        // bytes 11 to 18
  UINT32BE board_lot_size;   // bytes 19 to 22
  UINT16BE instrument_id;    // bytes 23 to 24
  UINT8 shortable;           // byte 25
  UINT8 dividend_indicator;  // byte 26
  UINT8 reserved_9[9];       // bytes 27 to 35
  UINT8 currency[3];         // bytes 36 to 38
} StockDirectoryMessage;

// Extended Stock Directory messages carry the additional reference data of bonds, debentures, rights, notes and warrants.
typedef struct _ExtendedStockDirectoryMessage {
  UINT8 market;             // byte 0
  UINT8 stock[10];          // bytes 1 to 10
  UINT64BE timestamp;       // bytes 11 to 18
  UINT32BE board_lot_size;  // bytes 19 to 22
  UINT16BE instrument_id;   // bytes 23 to 24
  UINT8 shortable;          // byte 25
  UINT8 frequency;          // byte 26
  UINT8 reserved_9[9];      // bytes 27 to 35
  UINT8 currency[3];        // bytes 36 to 38
  UINT8 security_type;      // byte 39
  UINT8 expiry_date[8];     // bytes 40 to 47
  UINT8 description[20];    // bytes 48 to 67
  UINT8 reserved_3[3];      // bytes 68 to 70
} ExtendedStockDirectoryMessage;

// Tradelogiq uses this administrative message to indicate the current trading status of a security.
typedef struct _StockTradingActionMessage {
  UINT8 trading_state;     // byte 0
  UINT16BE instrument_id;  // bytes 1 to 2
  UINT64BE timestamp;      // bytes 3 to 10
  UINT8 reason[4];         // bytes 11 to 14
} StockTradingActionMessage;

// An Add Order Message indicates that a new order has been accepted by Omega ATS or Lynx ATS and was added to the visible order book.
typedef struct _AddOrderMessage {
  UINT8 buy_sell_indicator;         // byte 0
  UINT16BE instrument_id;           // bytes 1 to 2
  UINT64BE timestamp;               // bytes 3 to 10
  UINT32BE order_reference_number;  // bytes 11 to 14
  UINT32BE shares;                  // bytes 15 to 18
  UINT32BE price;                   // bytes 19 to 22
  UINT16BE exec_broker_id;          // bytes 23 to 24
  UINT8 reserved_2[2];              // bytes 25 to 26
} AddOrderMessage;

// This message is sent whenever an order on the book is executed in whole or in part.
typedef struct _OrderExecutedMessage {
  UINT8 marker;                     // byte 0
  UINT16BE instrument_id;           // bytes 1 to 2
  UINT64BE timestamp;               // bytes 3 to 10
  UINT32BE order_reference_number;  // bytes 11 to 14
  UINT32BE executed_shares;         // bytes 15 to 18
  UINT32BE match_number;            // bytes 19 to 22
  UINT16BE contra_broker_id;        // bytes 23 to 24
  UINT8 reserved_2[2];              // bytes 25 to 26
} OrderExecutedMessage;

// This message is sent whenever an order on the book is executed at a display price different from the original.
typedef struct _OrderExecutedWithPriceMessage {
  UINT8 marker;                     // byte 0
  UINT16BE instrument_id;           // bytes 1 to 2
  UINT64BE timestamp;               // bytes 3 to 10
  UINT32BE order_reference_number;  // bytes 11 to 14
  UINT32BE executed_shares;         // bytes 15 to 18
  UINT32BE execution_price;         // bytes 19 to 22
  UINT32BE match_number;            // bytes 23 to 26
  UINT16BE contra_broker_id;        // bytes 27 to 28
  UINT8 reserved_2[2];              // bytes 29 to 30
} OrderExecutedWithPriceMessage;

// This message is sent whenever an order on the book is being cancelled.
typedef struct _OrderDeleteMessage {
  UINT8 reserved_1;                 // byte 0
  UINT16BE instrument_id;           // bytes 1 to 2
  UINT64BE timestamp;               // bytes 3 to 10
  UINT32BE order_reference_number;  // bytes 11 to 14
} OrderDeleteMessage;

// This message is sent whenever an order on the book has been cancelled and replaced.
typedef struct _OrderReplaceMessage {
  UINT8 reserved_1;                          // byte 0
  UINT16BE instrument_id;                    // bytes 1 to 2
  UINT64BE timestamp;                        // bytes 3 to 10
  UINT32BE original_order_reference_number;  // bytes 11 to 14
  UINT32BE new_order_reference_number;       // bytes 15 to 18
  UINT32BE shares;                           // bytes 19 to 22
  UINT32BE price;                            // bytes 23 to 26
} OrderReplaceMessage;

// This message is sent whenever an order on the book is modified as a result of a partial cancellation.
typedef struct _OrderCancelMessage {
  UINT8 reserved_1;                 // byte 0
  UINT16BE instrument_id;           // bytes 1 to 2
  UINT64BE timestamp;               // bytes 3 to 10
  UINT32BE order_reference_number;  // bytes 11 to 14
  UINT32BE cancelled_shares;        // bytes 15 to 18
} OrderCancelMessage;

// The Trade Message is designed to provide execution details for normal match events involving non-displayed order types.
typedef struct _TradeMessage {
  UINT8 side;                    // byte 0
  UINT16BE instrument_id;        // bytes 1 to 2
  UINT64BE timestamp;            // bytes 3 to 10
  UINT32BE midpoint_book_trade;  // bytes 11 to 14
  UINT32BE shares;               // bytes 15 to 18
  UINT32BE price;                // bytes 19 to 22
  UINT32BE match_number;         // bytes 23 to 26
  UINT16BE buy_broker_id;        // bytes 27 to 28
  UINT16BE sell_broker_id;       // bytes 29 to 30
} TradeMessage;

// Cross trades are only accepted on Omega ATS.
typedef struct _CrossTradeMessage {
  UINT8 cross_type;         // byte 0
  UINT16BE instrument_id;   // bytes 1 to 2
  UINT64BE timestamp;       // bytes 3 to 10
  UINT32BE shares;          // bytes 11 to 14
  UINT32BE price;           // bytes 15 to 18
  UINT32BE match_number;    // bytes 19 to 22
  UINT16BE buy_broker_id;   // bytes 23 to 24
  UINT16BE sell_broker_id;  // bytes 25 to 26
  UINT8 bypass;             // byte 27
  UINT8 settlement_type;    // byte 28
  UINT8 reserved_2[2];      // bytes 29 to 30
} CrossTradeMessage;

// The Trade Bust message is sent whenever an execution on Omega ATS or Lynx ATS is cancelled.
typedef struct _TradeBustMessage {
  UINT8 reserved_1;        // byte 0
  UINT16BE instrument_id;  // bytes 1 to 2
  UINT64BE timestamp;      // bytes 3 to 10
  UINT32BE match_number;   // bytes 11 to 14
} TradeBustMessage;

// The Trade Amend/Correction message is sent whenever an execution on Omega ATS or Lynx ATS is amended.
typedef struct _TradeAmendMessage {
  UINT8 reserved_1;                // byte 0
  UINT16BE instrument_id;          // bytes 1 to 2
  UINT64BE timestamp;              // bytes 3 to 10
  UINT32BE original_trade_id;      // bytes 11 to 14
  UINT64BE original_trade_price;   // bytes 15 to 22
  UINT32BE original_trade_size;    // bytes 23 to 26
  UINT64BE corrected_trade_price;  // bytes 27 to 34
  UINT32BE corrected_trade_size;   // bytes 35 to 38
} TradeAmendMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x52: StockDirectoryMessage stock_directory_message;
    case 0x72: ExtendedStockDirectoryMessage extended_stock_directory_message;
    case 0x48: StockTradingActionMessage stock_trading_action_message;
    case 0x41: AddOrderMessage add_order_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceMessage order_executed_with_price_message;
    case 0x44: OrderDeleteMessage order_delete_message;
    case 0x55: OrderReplaceMessage order_replace_message;
    case 0x58: OrderCancelMessage order_cancel_message;
    case 0x50: TradeMessage trade_message;
    case 0x51: CrossTradeMessage cross_trade_message;
    case 0x42: TradeBustMessage trade_bust_message;
    case 0x4D: TradeAmendMessage trade_amend_message;
    default: UINT8 unknown[available];
  }
} Payload;

// The higher-level protocol message carried by a Sequenced Data Packet
typedef struct _SequencedMessage (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 message_type;                                                                                                             // byte 0
  Payload(message_type, (((UINT32) packet_length) - 2)) payload[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedMessage;

// The higher-level protocol message carried by a Sequenced Data Packet
casetype _OptionalSequencedMessage (Bool present, UINT16 packet_length) {
  switch (present) {
    case true: SequencedMessage(packet_length) sequenced_message;
    case false: unit absent;
  }
} OptionalSequencedMessage;

// The Sequenced Data Packets carry a higher-level protocol message; zero message bytes indicate no more messages available
typedef struct _SequencedDataPacket (UINT16 packet_length) {
  OptionalSequencedMessage((packet_length > 0x0001), packet_length) sequenced_message;
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x48: unit server_heartbeat;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Tcp Packet sent by the server
typedef struct _ServerSoupTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// Tradelogiq SoupTcp Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupTcpPacket server_soup_tcp_packet[:byte-size available];
} ServerPacket;

