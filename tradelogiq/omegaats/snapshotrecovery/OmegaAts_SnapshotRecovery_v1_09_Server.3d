// ---- Server Packet Header: 3 bytes -------------------------------------------

// Tradelogiq SoupTcp Server Packet Header
entrypoint typedef struct _ServerPacketHeader {
  UINT16BE packet_length;    // bytes 0 to 1
  UINT8 server_packet_type;  // byte 2
} ServerPacketHeader;

// ---- Login Accepted Packet: 30 bytes -----------------------------------------

// The server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
entrypoint typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// ---- Login Rejected Packet: 1 byte -------------------------------------------

// The server sends this packet in response to an invalid Login Request Packet from the client and closes the socket connection
entrypoint typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// ---- System Event Message: 11 bytes ------------------------------------------

// The spin consists of a Start-Of-Messages event, Add Order messages and an End-Of-Messages event, after which the Reallocation Server disconnects.
entrypoint typedef struct _SystemEventMessage {
  UINT8 event_code;     // byte 0
  UINT8 reserved_2[2];  // bytes 1 to 2
  UINT64BE timestamp;   // bytes 3 to 10
} SystemEventMessage;

// ---- Stock Directory Message: 39 bytes ---------------------------------------

// A Requested Sequence Number of 1 returns the symbol spin, the Instrument Directory messages distributed early in the Tradelogiq start of day.
entrypoint typedef struct _StockDirectoryMessage {
  UINT8 market;              // byte 0
  UINT8 stock[10];           // bytes 1 to 10
  UINT64BE timestamp;        // bytes 11 to 18
  UINT32BE board_lot_size;   // bytes 19 to 22
  UINT16BE instrument_id;    // bytes 23 to 24
  UINT8 shortable;           // byte 25
  UINT8 dividend_indicator;  // byte 26
  UINT8 reserved_9[9];       // bytes 27 to 35
  UINT8 currency[3];         // bytes 36 to 38
} StockDirectoryMessage;

// ---- Extended Stock Directory Message: 71 bytes ------------------------------

// The symbol spin carries the Extended Stock Directory of bonds, debentures, rights, notes and warrants alongside the Stock Directory.
entrypoint typedef struct _ExtendedStockDirectoryMessage {
  UINT8 market;             // byte 0
  UINT8 stock[10];          // bytes 1 to 10
  UINT64BE timestamp;       // bytes 11 to 18
  UINT32BE board_lot_size;  // bytes 19 to 22
  UINT16BE instrument_id;   // bytes 23 to 24
  UINT8 shortable;          // byte 25
  UINT8 frequency;          // byte 26
  UINT8 reserved_9[9];      // bytes 27 to 35
  UINT8 currency[3];        // bytes 36 to 38
  UINT8 security_type;      // byte 39
  UINT8 expiry_date[8];     // bytes 40 to 47
  UINT8 description[20];    // bytes 48 to 67
  UINT8 reserved_3[3];      // bytes 68 to 70
} ExtendedStockDirectoryMessage;

// ---- Stock Trading Action Message: 15 bytes ----------------------------------

// If sequence 1 is used for the Sequenced Number field the reallocation server will return the symbol spin with the stock trading status messages before returning all open orders seen on the book.
entrypoint typedef struct _StockTradingActionMessage {
  UINT8 trading_state;     // byte 0
  UINT16BE instrument_id;  // bytes 1 to 2
  UINT64BE timestamp;      // bytes 3 to 10
  UINT8 reason[4];         // bytes 11 to 14
} StockTradingActionMessage;

// ---- Add Order Message: 27 bytes ---------------------------------------------

// Only open orders are sent in the spin; the spin will not contain any message for an order which is no longer in the book.
entrypoint typedef struct _AddOrderMessage {
  UINT8 buy_sell_indicator;         // byte 0
  UINT16BE instrument_id;           // bytes 1 to 2
  UINT64BE timestamp;               // bytes 3 to 10
  UINT32BE order_reference_number;  // bytes 11 to 14
  UINT32BE shares;                  // bytes 15 to 18
  UINT32BE price;                   // bytes 19 to 22
  UINT16BE exec_broker_id;          // bytes 23 to 24
  UINT8 reserved_2[2];              // bytes 25 to 26
} AddOrderMessage;

