// ---- Packet Header: 20 bytes -------------------------------------------------

// Tradelogiq Qtp Downstream Packet Header
entrypoint typedef struct _PacketHeader {
  UINT8 session[10];         // bytes 0 to 9
  UINT64BE sequence_number;  // bytes 10 to 17
  UINT16BE message_count;    // bytes 18 to 19
} PacketHeader;

// ---- Message Header: 3 bytes -------------------------------------------------

// Tradelogiq Qtp Message Block Header
entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;  // bytes 0 to 1
  UINT8 message_type;       // byte 2
} MessageHeader;

// ---- Quote Message: 43 bytes -------------------------------------------------

// Tradelogiq's BBO will broadcast real-time updates every time Tradelogiq's top of book changes.
entrypoint typedef struct _QuoteMessage {
  UINT8 reserved_1;         // byte 0
  UINT8 stock_symbol[10];   // bytes 1 to 10
  UINT64BE timestamp;       // bytes 11 to 18
  UINT64BE best_bid_price;  // bytes 19 to 26
  UINT32BE best_bid_size;   // bytes 27 to 30
  UINT64BE best_ask_price;  // bytes 31 to 38
  UINT32BE best_ask_size;   // bytes 39 to 42
} QuoteMessage;

// ---- Trade Report Message: 43 bytes ------------------------------------------

// Relays all transactions available from or reported by Tradelogiq's two trading books for the current business day.
entrypoint typedef struct _TradeReportMessage {
  UINT8 conditions[5];     // bytes 0 to 4
  UINT8 stock_symbol[10];  // bytes 5 to 14
  UINT64BE timestamp;      // bytes 15 to 22
  UINT32BE trade_id;       // bytes 23 to 26
  UINT64BE trade_price;    // bytes 27 to 34
  UINT32BE trade_size;     // bytes 35 to 38
  UINT16BE buy_broker;     // bytes 39 to 40
  UINT16BE sell_broker;    // bytes 41 to 42
} TradeReportMessage;

// ---- Trade Bust Message: 23 bytes --------------------------------------------

// If trade is cancelled or busted during the day Trade Bust Message will be sent.
entrypoint typedef struct _TradeBustMessage {
  UINT8 reserved_1;        // byte 0
  UINT8 stock_symbol[10];  // bytes 1 to 10
  UINT64BE timestamp;      // bytes 11 to 18
  UINT32BE trade_id;       // bytes 19 to 22
} TradeBustMessage;

// ---- Trade Correction Message: 47 bytes --------------------------------------

// Trade amendments during the day will send this message.
entrypoint typedef struct _TradeCorrectionMessage {
  UINT8 reserved_1;                // byte 0
  UINT8 stock_symbol[10];          // bytes 1 to 10
  UINT64BE timestamp;              // bytes 11 to 18
  UINT32BE original_trade_id;      // bytes 19 to 22
  UINT64BE original_trade_price;   // bytes 23 to 30
  UINT32BE original_trade_size;    // bytes 31 to 34
  UINT64BE corrected_trade_price;  // bytes 35 to 42
  UINT32BE corrected_trade_size;   // bytes 43 to 46
} TradeCorrectionMessage;

// ---- System Event Message: 11 bytes ------------------------------------------

// The system event message is used to signal a market or a data feed handler event.
entrypoint typedef struct _SystemEventMessage {
  UINT8 event_code;     // byte 0
  UINT8 reserved_2[2];  // bytes 1 to 2
  UINT64BE timestamp;   // bytes 3 to 10
} SystemEventMessage;

// ---- Stock Directory Message: 39 bytes ---------------------------------------

// At start of each trading day, OSI disseminates stock directory messages for supported securities.
entrypoint typedef struct _StockDirectoryMessage {
  UINT8 market;              // byte 0
  UINT8 stock[10];           // bytes 1 to 10
  UINT64BE timestamp;        // bytes 11 to 18
  UINT32BE board_lot_size;   // bytes 19 to 22
  UINT16BE instrument_id;    // bytes 23 to 24
  UINT8 shortable;           // byte 25
  UINT8 dividend_indicator;  // byte 26
  UINT8 reserved_9[9];       // bytes 27 to 35
  UINT8 currency[3];         // bytes 36 to 38
} StockDirectoryMessage;

// ---- Extended Stock Directory Message: 71 bytes ------------------------------

// Extended Stock Directory are for Special stock symbols eg warrants debentures rights.
entrypoint typedef struct _ExtendedStockDirectoryMessage {
  UINT8 market;             // byte 0
  UINT8 stock[10];          // bytes 1 to 10
  UINT64BE timestamp;       // bytes 11 to 18
  UINT32BE board_lot_size;  // bytes 19 to 22
  UINT16BE instrument_id;   // bytes 23 to 24
  UINT8 shortable;          // byte 25
  UINT8 frequency;          // byte 26
  UINT8 reserved_9[9];      // bytes 27 to 35
  UINT8 currency[3];        // bytes 36 to 38
  UINT8 security_type;      // byte 39
  UINT8 expiry_date[8];     // bytes 40 to 47
  UINT8 description[20];    // bytes 48 to 67
  UINT8 reserved_3[3];      // bytes 68 to 70
} ExtendedStockDirectoryMessage;

// ---- Stock Status Message: 23 bytes ------------------------------------------

// This message indicates the current trading status of a stock.
entrypoint typedef struct _StockStatusMessage {
  UINT8 trading_state;  // byte 0
  UINT8 stock[10];      // bytes 1 to 10
  UINT64BE timestamp;   // bytes 11 to 18
  UINT8 reason[4];      // bytes 19 to 22
} StockStatusMessage;

