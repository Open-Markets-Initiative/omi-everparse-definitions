// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out LinkAts_QuoteBookGlobalOtc_v4_10_4.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_START_OF_SPIN_MESSAGE 0x0B  // Start Of Spin Message
#define MESSAGE_TYPE_END_OF_SPIN_MESSAGE 0x0C    // End Of Spin Message
#define MESSAGE_TYPE_MARKET_OPEN_MESSAGE 0x0D    // Market Open Message
#define MESSAGE_TYPE_MARKET_CLOSE_MESSAGE 0x0E   // Market Close Message
#define MESSAGE_TYPE_SECURITY_MESSAGE 0x09       // Security Message
#define MESSAGE_TYPE_QUOTE_MESSAGE 0x01          // Quote Message
#define MESSAGE_TYPE_QUOTE_UPDATE_MESSAGE 0x02   // Quote Update Message

// Spin Type: one byte code
#define SPIN_TYPE_REFERENCE 0x01    // Reference
#define SPIN_TYPE_MARKET_DATA 0x02  // Market Data
#define SPIN_TYPE_OPENING 0x03      // Opening

// Security Action: one byte code
#define SECURITY_ACTION_UPDATE 0x01  // Update
#define SECURITY_ACTION_ADD 0x02     // Add
#define SECURITY_ACTION_DELETE 0x03  // Delete
#define SECURITY_ACTION_SPIN 0x04    // Spin

// Asset Class: one byte code
#define ASSET_CLASS_EQUITY 0x01        // Equity
#define ASSET_CLASS_FIXED_INCOME 0x02  // Fixed Income

// Tier: one byte code
#define TIER_NO_TIER 0x00                      // No Tier
#define TIER_OTCQXUS_PREMIER 0x01              // Otcqxus Premier
#define TIER_OTCQXUS 0x02                      // Otcqxus
#define TIER_OTCQX_INTERNATIONAL_PREMIER 0x05  // Otcqx International Premier
#define TIER_OTCQX_INTERNATIONAL 0x06          // Otcqx International
#define TIER_OTCQB 0x0A                        // Otcqb
#define TIER_OTCBB_ONLY 0x0B                   // Otcbb Only
#define TIER_PINK_CURRENT 0x14                 // Pink Current
#define TIER_PINK_LIMITED 0x15                 // Pink Limited
#define TIER_PINK_NO_INFORMATION 0x16          // Pink No Information
#define TIER_GREY_MARKET 0x1E                  // Grey Market
#define TIER_EXPERT_MARKET 0x28                // Expert Market
#define TIER_OTC_BONDS 0x32                    // Otc Bonds

// Reporting Status: one byte code
#define REPORTING_STATUS_ALTERNATIVE_REPORTING 0x41    // Alternative Reporting
#define REPORTING_STATUS_BANK_THRIFT 0x42              // Bank Thrift
#define REPORTING_STATUS_SEC_REPORTING_REG_CF 0x43     // Sec Reporting Reg Cf
#define REPORTING_STATUS_SEC_REPORTING 0x46            // Sec Reporting
#define REPORTING_STATUS_INTERNATIONAL_REPORTING 0x47  // International Reporting
#define REPORTING_STATUS_INSURANCE_COMPANY 0x49        // Insurance Company
#define REPORTING_STATUS_NO_REPORTING 0x4E             // No Reporting
#define REPORTING_STATUS_OTHER_REPORTING 0x4F          // Other Reporting
#define REPORTING_STATUS_FINRA_REPORTING 0x52          // Finra Reporting
#define REPORTING_STATUS_SEC_INVESTMENT_COMPANY 0x56   // Sec Investment Company
#define REPORTING_STATUS_SEC_REPORTING_REG_A 0x57      // Sec Reporting Reg A

// Security Status: one byte code
#define SECURITY_STATUS_ACTIVE 0x41         // Active
#define SECURITY_STATUS_QUOTE_ONLY 0x51     // Quote Only
#define SECURITY_STATUS_SUSPENDED 0x53      // Suspended
#define SECURITY_STATUS_HALTED 0x48         // Halted
#define SECURITY_STATUS_INTERNAL_HALT 0x49  // Internal Halt
#define SECURITY_STATUS_REVOKED 0x52        // Revoked
#define SECURITY_STATUS_DELETED 0x44        // Deleted

// ---- Types -------------------------------------------------------------------

// This message appears on all quote channels and indicates the beginning of a spin message cycle.
typedef struct _StartOfSpinMessage {
  UINT32BE channel_seq_num;        // bytes 0 to 3
  UINT8 spin_type;                 // byte 4
  UINT64BE spin_start_time_milli;  // bytes 5 to 12
  UINT32BE spin_last_seq_num;      // bytes 13 to 16
} StartOfSpinMessage;

// This message appears on all quote channels and indicates the end of a spin message cycle.
typedef struct _EndOfSpinMessage {
  UINT32BE channel_seq_num;      // bytes 0 to 3
  UINT8 spin_type;               // byte 4
  UINT32BE spin_msg_ct;          // bytes 5 to 8
  UINT64BE spin_end_time_milli;  // bytes 9 to 16
  UINT32BE spin_last_seq_num;    // bytes 17 to 20
} EndOfSpinMessage;

// This message is sent out at 6 AM on all channels. The message can also be sent mid-day if a technical outage caused a temporary closure of the market.
typedef struct _MarketOpenMessage {
  UINT32BE channel_seq_num;  // bytes 0 to 3
  UINT64BE market_open;      // bytes 4 to 11
  UINT64BE market_close;     // bytes 12 to 19
} MarketOpenMessage;

// This message is sent out at 5 PM on all channels. The message can also be sent mid-day if a technical outage causes a temporary closure of the market.
typedef struct _MarketCloseMessage {
  UINT32BE channel_seq_num;          // bytes 0 to 3
  UINT64BE market_close_time_milli;  // bytes 4 to 11
  UINT32BE market_msg_ct;            // bytes 12 to 15
} MarketCloseMessage;

// The Security Message is included in all quote channels and provides basic security attribute information.
typedef struct _SecurityMessage {
  UINT32BE channel_seq_num;                       // bytes 0 to 3
  UINT8 symbol[10];                               // bytes 4 to 13
  UINT64BE last_update_milli;                     // bytes 14 to 21
  UINT8 security_action;                          // byte 22
  UINT8 asset_class;                              // byte 23
  UINT32BE security_id;                           // bytes 24 to 27
  UINT8 proprietary_quote_eligible : 1;           // byte 28
  UINT8 caveat_emptor_warning : 1;                // byte 28
  UINT8 qualified_institutional_buyers_only : 1;  // byte 28
  UINT8 unsolicited_only : 1;                     // byte 28
  UINT8 bb_quoted : 1;                            // byte 28
  UINT8 otc_link_ecn_eligible : 1;                // byte 28
  UINT8 otc_link_messaging_disabled : 1;          // byte 28
  UINT8 saturation_eligible : 1;                  // byte 28
  UINT8 tier;                                     // byte 29
  UINT8 reporting_status;                         // byte 30
  UINT8 security_status;                          // byte 31
} SecurityMessage;

// This message is sent on the Quote Book channel and the Quote Book with Global OTC data channel.
typedef struct _QuoteMessage {
  UINT32BE channel_seq_num;         // bytes 0 to 3
  UINT32BE quote_id;                // bytes 4 to 7
  UINT8 quote_action;               // byte 8
  UINT8 update_side : 1;            // byte 9
  UINT8 state : 1;                  // byte 9
  UINT8 ask_unsolicited : 1;        // byte 9
  UINT8 ask_priced : 1;             // byte 9
  UINT8 ask_bid_wanted : 1;         // byte 9
  UINT8 bid_unsolicited : 1;        // byte 9
  UINT8 bid_priced : 1;             // byte 9
  UINT8 bid_ask_wanted : 1;         // byte 9
  UINT32BE security_id;             // bytes 10 to 13
  UINT8 mpid[4];                    // bytes 14 to 17
  UINT64BE ask_price;               // bytes 18 to 25
  UINT32BE ask_size;                // bytes 26 to 29
  UINT8 ask_qap;                    // byte 30, signed, read here as unsigned
  UINT64BE ask_time_milli;          // bytes 31 to 38
  UINT64BE bid_price;               // bytes 39 to 46
  UINT32BE bid_size;                // bytes 47 to 50
  UINT8 bid_qap;                    // byte 51, signed, read here as unsigned
  UINT64BE bid_time_milli;          // bytes 52 to 59
  UINT16BE quote_reference_id;      // bytes 60 to 61
  UINT8 quote_saturated : 1;        // byte 62
  UINT8 bid_auto_ex : 1;            // byte 62
  UINT8 offer_auto_ex : 1;          // byte 62
  UINT8 nms_conditional_quote : 1;  // byte 62
  UINT8 reserved_4 : 4;             // byte 62
} QuoteMessage;

// Quote update information for the Quote Book channel and the Quote Book with Global OTC data channel.
typedef struct _QuoteUpdateMessage {
  UINT32BE channel_seq_num;         // bytes 0 to 3
  UINT32BE quote_id;                // bytes 4 to 7
  UINT8 update_side : 1;            // byte 8
  UINT8 state : 1;                  // byte 8
  UINT8 ask_unsolicited : 1;        // byte 8
  UINT8 ask_priced : 1;             // byte 8
  UINT8 ask_bid_wanted : 1;         // byte 8
  UINT8 bid_unsolicited : 1;        // byte 8
  UINT8 bid_priced : 1;             // byte 8
  UINT8 bid_ask_wanted : 1;         // byte 8
  UINT64BE price;                   // bytes 9 to 16
  UINT32BE size;                    // bytes 17 to 20
  UINT8 qap;                        // byte 21, signed, read here as unsigned
  UINT64BE quote_time_milli;        // bytes 22 to 29
  UINT16BE quote_reference_id;      // bytes 30 to 31
  UINT8 quote_saturated : 1;        // byte 32
  UINT8 bid_auto_ex : 1;            // byte 32
  UINT8 offer_auto_ex : 1;          // byte 32
  UINT8 nms_conditional_quote : 1;  // byte 32
  UINT8 reserved_4 : 4;             // byte 32
} QuoteUpdateMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x0B: StartOfSpinMessage start_of_spin_message;
    case 0x0C: EndOfSpinMessage end_of_spin_message;
    case 0x0D: MarketOpenMessage market_open_message;
    case 0x0E: MarketCloseMessage market_close_message;
    case 0x09: SecurityMessage security_message;
    case 0x01: QuoteMessage quote_message;
    case 0x02: QuoteUpdateMessage quote_update_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_size { message_size >= 3 };                                                                                                                     // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_size) - 3)) payload[:byte-size-single-element-array (((UINT32) message_size) - 3)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _MessageBlock (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 1: unit heartbeat_packet;
    default: MessageRun(message_count, available, tally) message;
  }
} MessageBlock;

// ---- Packet: Packet ----------------------------------------------------------

// Otc Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 12) {
  UINT16BE packet_size;                                                                                                             // bytes 0 to 1
  UINT32BE seq_num;                                                                                                                 // bytes 2 to 5
  UINT8 heartbeat : 1;                                                                                                              // byte 6
  UINT8 seq_num_reset : 1;                                                                                                          // byte 6
  UINT8 reserved_4 : 4;                                                                                                             // byte 6
  UINT8 replay : 1;                                                                                                                 // byte 6
  UINT8 test : 1;                                                                                                                   // byte 6
  UINT8 message_count;                                                                                                              // byte 7
  UINT32BE packet_milli;                                                                                                            // bytes 8 to 11
  MessageBlock(heartbeat, message_count, (available - 12), tally) message_block[:byte-size-single-element-array (available - 12)];
} Packet;

