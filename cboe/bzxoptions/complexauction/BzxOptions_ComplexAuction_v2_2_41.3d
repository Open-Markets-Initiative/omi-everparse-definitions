// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out BzxOptions_ComplexAuction_v2_2_41.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_TIME_MESSAGE 0x20                                    // Time Message
#define MESSAGE_TYPE_COMPLEX_INSTRUMENT_DEFINITION_EXPANDED_MESSAGE 0x9A  // Complex Instrument Definition Expanded Message
#define MESSAGE_TYPE_SYMBOL_MAPPING_MESSAGE 0x2E                          // Symbol Mapping Message
#define MESSAGE_TYPE_AUCTION_NOTIFICATION_MESSAGE 0xAD                    // Auction Notification Message
#define MESSAGE_TYPE_AUCTION_CANCEL_MESSAGE 0xAE                          // Auction Cancel Message
#define MESSAGE_TYPE_AUCTION_TRADE_MESSAGE 0xAF                           // Auction Trade Message
#define MESSAGE_TYPE_OPTIONS_AUCTION_UPDATE_MESSAGE 0xD1                  // Options Auction Update Message
#define MESSAGE_TYPE_AUCTION_SUMMARY_MESSAGE 0x96                         // Auction Summary Message
#define MESSAGE_TYPE_END_OF_SESSION_MESSAGE 0x2D                          // End Of Session Message

// Leg Security Type: one byte code
#define LEG_SECURITY_TYPE_LEG_IS_AN_OPTION_INSTRUMENT 0x4F  // Leg Is An Option Instrument
#define LEG_SECURITY_TYPE_LEG_IS_AN_EQUITY_INSTRUMENT 0x45  // Leg Is An Equity Instrument

// Symbol Condition: one byte code
#define SYMBOL_CONDITION_NORMAL 0x4E        // Normal
#define SYMBOL_CONDITION_CLOSING_ONLY 0x43  // Closing Only

// Auction Notification Auction Type: one byte code
#define AUCTION_NOTIFICATION_AUCTION_TYPE_COMPLEX_ORDER_AUCTION_COA_OR_STOP_COMPLEX_ORDER_AUCTION_SCOA_EFFECTIVE_TBD 0x43  // Complex Order Auction Coa Or Stop Complex Order Auction Scoa Effective Tbd
#define AUCTION_NOTIFICATION_AUCTION_TYPE_COMPLEX_SOLICITATION_AUCTION_MECHANISM 0x53                                      // Complex Solicitation Auction Mechanism
#define AUCTION_NOTIFICATION_AUCTION_TYPE_COMPLEX_AIM 0x42                                                                 // Complex Aim
#define AUCTION_NOTIFICATION_AUCTION_TYPE_COA_ALL_OR_NONE 0x4F                                                             // Coa All Or None

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Customer Indicator: one byte code
#define CUSTOMER_INDICATOR_NON_CUSTOMER 0x4E  // Non Customer
#define CUSTOMER_INDICATOR_CUSTOMER 0x43      // Customer

// Options Auction Update Auction Type: one byte code
#define OPTIONS_AUCTION_UPDATE_AUCTION_TYPE_GTH_OPENING 0x47      // Gth Opening
#define OPTIONS_AUCTION_UPDATE_AUCTION_TYPE_RTH_OPENING 0x4F      // Rth Opening
#define OPTIONS_AUCTION_UPDATE_AUCTION_TYPE_HALT_RE_OPENING 0x48  // Halt Re Opening

// Auction Summary Auction Type: one byte code
#define AUCTION_SUMMARY_AUCTION_TYPE_GTH_OPENING 0x47      // Gth Opening
#define AUCTION_SUMMARY_AUCTION_TYPE_RTH_OPENING 0x4F      // Rth Opening
#define AUCTION_SUMMARY_AUCTION_TYPE_HALT_RE_OPENING 0x48  // Halt Re Opening

// ---- Types -------------------------------------------------------------------

// A Time message is immediately generated and sent when there is a PITCH event for a given clock second. If there is no PITCH event for a given clock second, then no Time message is sent for that second. All subsequent time offset fields for the same unit will use the new Time value as the base until another Time message is received for the same unit.
typedef struct _TimeMessage {
  UINT32 time;  // bytes 0 to 3
} TimeMessage;

// Repeating leg definition group inside the Complex Instrument Definition Expanded message. Repeats Leg Count times.
typedef struct _ComplexLeg {
  UINT8 leg_symbol[8];      // bytes 0 to 7
  UINT32 leg_ratio;         // bytes 8 to 11, signed, read here as unsigned
  UINT8 leg_security_type;  // byte 12
} ComplexLeg;

// A Complex Instrument Definition Expanded message represents a complex instrument that is available to place orders. This message is unsequenced (sequence = 0) and is sent just prior to every Auction Notification message. Complex Instrument Definition Expanded messages will also be sent in a continuous loop through the day at variable rates as bandwidth allows. The Time offset field should be ignored on Complex Instrument Definition Expanded messages. The Complex Instrument Definition Expanded message will contain two or more repeating groups of leg definitions. There is a limit of 16 leg definitions.
typedef struct _ComplexInstrumentDefinitionExpandedMessage {
  UINT32 time_offset;                                              // bytes 0 to 3
  UINT8 complex_instrument_id_short[6];                            // bytes 4 to 9
  UINT8 complex_instrument_underlying[8];                          // bytes 10 to 17
  UINT8 complex_instrument_type[4];                                // bytes 18 to 21
  UINT8 leg_count;                                                 // byte 22
  ComplexLeg complex_leg[:byte-size (((UINT32) leg_count) * 13)];
} ComplexInstrumentDefinitionExpandedMessage;

// A Symbol Mapping message is used to map the 6 character simple instrument multicast feed symbol field to an OSI symbol and Underlying. These messages are not sequenced (sequence = 0) and are sent continuously through the day at variable rates as bandwidth allows.
typedef struct _SymbolMappingMessage {
  UINT8 feed_symbol[6];    // bytes 0 to 5
  UINT8 osi_symbol[21];    // bytes 6 to 26
  UINT8 symbol_condition;  // byte 27
  UINT8 underlying[8];     // bytes 28 to 35
} SymbolMappingMessage;

// Auction Notification messages are used to disseminate order details of a complex auction. Auctions will be available for a defined period of time known as the exposure period.
typedef struct _AuctionNotificationMessage {
  UINT32 time_offset;                       // bytes 0 to 3
  UINT8 complex_instrument_id_short[6];     // bytes 4 to 9
  UINT64 auction_id;                        // bytes 10 to 17
  UINT8 auction_notification_auction_type;  // byte 18
  UINT8 side;                               // byte 19
  UINT64 price;                             // bytes 20 to 27, signed, read here as unsigned
  UINT32 quantity;                          // bytes 28 to 31
  UINT8 customer_indicator;                 // byte 32
  UINT8 participant_id[4];                  // bytes 33 to 36
  UINT32 auction_end_offset;                // bytes 37 to 40
  UINT8 client_id[4];                       // bytes 41 to 44
} AuctionNotificationMessage;

// Auction Cancel messages are used to disseminate the cancellation of an earlier Auction Notification message as a result of a user cancellation of the original complex auction, a user modification request to change the complex auction price or increase the original complex auction quantity, a fading of the NBBO or to cancel any remaining complex auction quantity from the original Auction Notification following the complex auction termination. A user request to modify the complex auction price or to increase the original complex auction quantity will result in a cancellation of the complex auction followed by a new Auction Notification message. Auction Cancel messages will not be issued for complex auction quantity decrements.
typedef struct _AuctionCancelMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 auction_id;   // bytes 4 to 11
} AuctionCancelMessage;

// Auction Trade messages are used to disseminate executions resulting from a complex auction.
typedef struct _AuctionTradeMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 auction_id;    // bytes 4 to 11
  UINT64 execution_id;  // bytes 12 to 19
  UINT64 price;         // bytes 20 to 27, signed, read here as unsigned
  UINT32 quantity;      // bytes 28 to 31
} AuctionTradeMessage;

// Options Auction Update messages are used to disseminate price and size information during the Opening and Re-Opening (halt) process for complex instruments. The Options Auction Update messages are sent every five seconds during an opening period. Refer to the Cboe Options Complex Book Process specification for more information.
typedef struct _OptionsAuctionUpdateMessage {
  UINT32 time_offset;                         // bytes 0 to 3
  UINT8 complex_instrument_id_long[8];        // bytes 4 to 11
  UINT8 options_auction_update_auction_type;  // byte 12
  UINT64 reference_price;                     // bytes 13 to 20
  UINT32 buy_contracts;                       // bytes 21 to 24
  UINT32 sell_contracts;                      // bytes 25 to 28
  UINT64 indicative_price;                    // bytes 29 to 36, signed, read here as unsigned
  UINT64 auction_only_price;                  // bytes 37 to 44, signed, read here as unsigned
  UINT8 opening_condition;                    // byte 45
  UINT64 composite_market_bid_price;          // bytes 46 to 53, signed, read here as unsigned
  UINT64 composite_market_offer_price;        // bytes 54 to 61, signed, read here as unsigned
} OptionsAuctionUpdateMessage;

// Auction Summary messages are used to disseminate the results of the Opening and Re-Opening process of a complex instrument. An Opening or Re-Opening Auction Summary message for each complex instrument is sent at the conclusion of the Opening or Re-Opening process and represents the Cboe opening price. Refer to the Cboe Options Complex Book Process specification for more information.
typedef struct _AuctionSummaryMessage {
  UINT32 time_offset;                   // bytes 0 to 3
  UINT8 complex_instrument_id_long[8];  // bytes 4 to 11
  UINT8 auction_summary_auction_type;   // byte 12
  UINT64 price;                         // bytes 13 to 20, signed, read here as unsigned
  UINT32 quantity;                      // bytes 21 to 24
} AuctionSummaryMessage;

// The End of Session message is sent for each unit when the unit shuts down. No more auction messages will be delivered for this unit, but heartbeats from the unit may be received.
typedef struct _EndOfSessionMessage {
  UINT32 time_offset;  // bytes 0 to 3
} EndOfSessionMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x20: TimeMessage time_message;
    case 0x9A: ComplexInstrumentDefinitionExpandedMessage complex_instrument_definition_expanded_message;
    case 0x2E: SymbolMappingMessage symbol_mapping_message;
    case 0xAD: AuctionNotificationMessage auction_notification_message;
    case 0xAE: AuctionCancelMessage auction_cancel_message;
    case 0xAF: AuctionTradeMessage auction_trade_message;
    case 0xD1: OptionsAuctionUpdateMessage options_auction_update_message;
    case 0x96: AuctionSummaryMessage auction_summary_message;
    case 0x2D: EndOfSessionMessage end_of_session_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

