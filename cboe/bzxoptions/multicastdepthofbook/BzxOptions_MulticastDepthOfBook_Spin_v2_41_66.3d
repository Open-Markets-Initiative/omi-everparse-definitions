#define SIDE_SELL 0x53  // Sell

// ---- Types -------------------------------------------------------------------

// The Login message is the first message sent to the Spin Server by a user's process after the connection to the Spin Server is established. Failure to login before sending any other message type will result in the connection being dropped by the Spin Server. The format of the Login message for the Spin Server is identical to that of the GRP.
typedef struct _LoginMessage {
  UINT8 session_sub_id[4];  // bytes 0 to 3
  UINT8 username[4];        // bytes 4 to 7
  UINT8 filler[2];          // bytes 8 to 9
  UINT8 password[10];       // bytes 10 to 19
} LoginMessage;

// The Login Response message is sent by the Spin Server to a user's process in response to a Login message. The status field is used to reflect an accepted login or the reason the session was not accepted. If login fails, the connection will be dropped after the Login Response message is sent.
typedef struct _LoginResponseMessage {
  UINT8 login_response_status;  // byte 0
} LoginResponseMessage;

// The Spin Image Available message is sent once per second and indicates through what sequence number a spin is available.
typedef struct _SpinImageAvailableMessage {
  UINT32 sequence;  // bytes 0 to 3
} SpinImageAvailableMessage;

// The Spin Request message is used by a user's process to request transmission of a spin of the unit's order book. See Options Specific Symbol Processing for more complete details regarding Sequence specification as well as buffering requirements.
typedef struct _SpinRequestMessage {
  UINT32 sequence;  // bytes 0 to 3
} SpinRequestMessage;

// The Spin Response message is sent in response to a user's Spin Request message indicating whether a spin will be sent.
typedef struct _SpinResponseMessage {
  UINT32 sequence;             // bytes 0 to 3
  UINT32 order_count;          // bytes 4 to 7
  UINT8 spin_response_status;  // byte 8
} SpinResponseMessage;

// The Spin Finished message is sent to indicate that all messages for the spin requested have been sent. A Spin Finished message is only sent if a Spin Request message was not rejected. Upon receipt of a Spin Finished message, any buffered multicast messages should be applied to the member's copy of the book to make it current.
typedef struct _SpinFinishedMessage {
  UINT32 sequence;  // bytes 0 to 3
} SpinFinishedMessage;

// The Instrument Definition Request message is used by a user's process to request transmission of this unit's Symbol Mappings and Complex Instrument Definitions. Refer to Options Specific Symbol Processing for more complete details regarding Sequence specification as well as buffering requirements.
typedef struct _InstrumentDefinitionRequestMessage {
  UINT32 sequence;  // bytes 0 to 3
} InstrumentDefinitionRequestMessage;

// The Instrument Definition Response message is sent in response to a user's Instrument Definition Request message indicating whether a spin will be sent.
typedef struct _InstrumentDefinitionResponseMessage {
  UINT32 sequence;                              // bytes 0 to 3
  UINT32 instrument_count;                      // bytes 4 to 7
  UINT8 instrument_definition_response_status;  // byte 8
} InstrumentDefinitionResponseMessage;

// A Time message is immediately generated and sent when there is a PITCH event for a given clock second. If there is no PITCH event for a given clock second, then no Time message is sent for that second. All subsequent time offset fields for the same unit will use the new Time value as the base until another Time message is received for the same unit. The Time field is the number of seconds relative to midnight Eastern Time.
typedef struct _TimeMessage {
  UINT32 time;  // bytes 0 to 3
} TimeMessage;

// The Unit Clear message instructs feed recipients to clear all orders for the Cboe book in the unit specified in the Sequenced Unit Header. This message will be sent at startup each day. It would also be distributed in certain recovery events such as a data center fail-over.
typedef struct _UnitClearMessage {
  UINT32 time_offset;  // bytes 0 to 3
} UnitClearMessage;

// The Transaction Begin message indicates any subsequent messages, up to the accompanying Transaction End message, are all part of the same transaction block.
typedef struct _TransactionBeginMessage {
  UINT32 time_offset;  // bytes 0 to 3
} TransactionBeginMessage;

// The Transaction End message indicates that a transaction indicated by a previous Transaction Begin message has completed.
typedef struct _TransactionEndMessage {
  UINT32 time_offset;  // bytes 0 to 3
} TransactionEndMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book. It includes a day-specific Order Id assigned by Cboe to the order.
typedef struct _AddOrderLongMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT64 order_id;       // bytes 4 to 11
  UINT8 side_indicator;  // byte 12
  UINT32 quantity_long;  // bytes 13 to 16
  UINT8 symbol[6];       // bytes 17 to 22
  UINT64 price_long;     // bytes 23 to 30
  UINT8 reserved_3 : 3;  // byte 31
  UINT8 aon : 1;         // byte 31
  UINT8 reserved_4 : 4;  // byte 31
} AddOrderLongMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book. The Short variant is used when the price can be represented by a Binary Short Price and the quantity by an unsigned 16-bit integer.
typedef struct _AddOrderShortMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT16 quantity_short;  // bytes 13 to 14
  UINT8 symbol[6];        // bytes 15 to 20
  UINT16 price_short;     // bytes 21 to 22
  UINT8 reserved_3 : 3;   // byte 23
  UINT8 aon : 1;          // byte 23
  UINT8 reserved_4 : 4;   // byte 23
} AddOrderShortMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book. The Expanded variant accommodates larger symbol sizes possible through the ISRA plan and includes additional attribution fields.
typedef struct _AddOrderExpandedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT8 side_indicator;      // byte 12
  UINT32 quantity_long;      // bytes 13 to 16
  UINT8 expanded_symbol[8];  // bytes 17 to 24
  UINT64 price_long;         // bytes 25 to 32
  UINT8 reserved_3 : 3;      // byte 33
  UINT8 aon : 1;             // byte 33
  UINT8 reserved_4 : 4;      // byte 33
  UINT8 participant_id[4];   // bytes 34 to 37
  UINT8 customer_indicator;  // byte 38
  UINT8 client_id[4];        // bytes 39 to 42
  UINT8 reserved_5[5];       // bytes 43 to 47
} AddOrderExpandedMessage;

// Order Executed messages are sent when a visible order on the Cboe book is executed in whole or in part. The execution will always be at the displayed price of the resting order.
typedef struct _OrderExecutedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT32 executed_quantity;  // bytes 12 to 15
  UINT64 execution_id;       // bytes 16 to 23
  UINT8 trade_condition;     // byte 24
} OrderExecutedMessage;

// Order Executed at Price/Size messages are sent when a visible order on the Cboe book is executed in whole or in part at a different price than the limit price on the original Add Order message or the limit order price in the latest Modify Order message referencing the Order Id.
typedef struct _OrderExecutedAtPriceSizeMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT64 order_id;            // bytes 4 to 11
  UINT32 executed_quantity;   // bytes 12 to 15
  UINT32 remaining_quantity;  // bytes 16 to 19
  UINT64 execution_id;        // bytes 20 to 27
  UINT64 price_long;          // bytes 28 to 35
  UINT8 trade_condition;      // byte 36
} OrderExecutedAtPriceSizeMessage;

// Reduce Size messages are sent when a visible order on the Cboe book is partially reduced.
typedef struct _ReduceSizeLongMessage {
  UINT32 time_offset;             // bytes 0 to 3
  UINT64 order_id;                // bytes 4 to 11
  UINT32 canceled_quantity_long;  // bytes 12 to 15
} ReduceSizeLongMessage;

// Reduce Size messages are sent when a visible order on the Cboe book is partially reduced. The Short variant is used when the canceled quantity can be represented by an unsigned 16-bit integer.
typedef struct _ReduceSizeShortMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT16 canceled_quantity_short;  // bytes 12 to 13
} ReduceSizeShortMessage;

// The Modify Order message is sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message.
typedef struct _ModifyOrderLongMessage {
  UINT32 time_offset;           // bytes 0 to 3
  UINT64 order_id;              // bytes 4 to 11
  UINT32 quantity_long;         // bytes 12 to 15
  UINT64 price_long;            // bytes 16 to 23
  UINT8 display : 1;            // byte 24
  UINT8 maintain_priority : 1;  // byte 24
  UINT8 reserved_6 : 6;         // byte 24
} ModifyOrderLongMessage;

// The Modify Order message is sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message. The Short variant is used when the price can be represented by a Binary Short Price and the quantity by an unsigned 16-bit integer.
typedef struct _ModifyOrderShortMessage {
  UINT32 time_offset;           // bytes 0 to 3
  UINT64 order_id;              // bytes 4 to 11
  UINT16 quantity_short;        // bytes 12 to 13
  UINT16 price_short;           // bytes 14 to 15
  UINT8 display : 1;            // byte 16
  UINT8 maintain_priority : 1;  // byte 16
  UINT8 reserved_6 : 6;         // byte 16
} ModifyOrderShortMessage;

// The Delete Order message is sent whenever a booked order is cancelled or leaves the order book.
typedef struct _DeleteOrderMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
} DeleteOrderMessage;

// The Trade message provides information about executions of non-displayed orders on the Cboe book and routed executions to other trading centers.
typedef struct _TradeLongMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT32 quantity_long;   // bytes 13 to 16
  UINT8 symbol[6];        // bytes 17 to 22
  UINT64 price_long;      // bytes 23 to 30
  UINT64 execution_id;    // bytes 31 to 38
  UINT8 trade_condition;  // byte 39
} TradeLongMessage;

// The Trade message provides information about executions of non-displayed orders on the Cboe book and routed executions to other trading centers. The Short variant is used when the price can be represented by a Binary Short Price and the quantity by an unsigned 16-bit integer.
typedef struct _TradeShortMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT16 quantity_short;  // bytes 13 to 14
  UINT8 symbol[6];        // bytes 15 to 20
  UINT16 price_short;     // bytes 21 to 22
  UINT64 execution_id;    // bytes 23 to 30
  UINT8 trade_condition;  // byte 31
} TradeShortMessage;

// The Trade message provides information about executions of non-displayed orders on the Cboe book and routed executions to other trading centers. The Expanded variant accommodates larger symbol sizes possible through the ISRA plan.
typedef struct _TradeExpandedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT8 side_indicator;      // byte 12
  UINT32 quantity_long;      // bytes 13 to 16
  UINT8 expanded_symbol[8];  // bytes 17 to 24
  UINT64 price_long;         // bytes 25 to 32
  UINT64 execution_id;       // bytes 33 to 40
  UINT8 trade_condition;     // byte 41
} TradeExpandedMessage;

// The Trade Break message is sent whenever an execution on Cboe is broken. Trade breaks are rare, but can occur in the event of an erroneous execution.
typedef struct _TradeBreakMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 execution_id;  // bytes 4 to 11
} TradeBreakMessage;

// The End of Session message is sent for each unit when the unit shuts down for the trading day. This message is used as the signal that processing for the day is complete.
typedef struct _EndOfSessionMessage {
  UINT32 time_offset;  // bytes 0 to 3
} EndOfSessionMessage;

// A Symbol Mapping message is used to map the 6 character multicast feed symbol field to an OSI symbol and Underlying. These messages are not sequenced and are sent continuously through the day at variable rates as bandwidth allows.
typedef struct _SymbolMappingMessage {
  UINT8 feed_symbol[6];    // bytes 0 to 5
  UINT8 osi_symbol[21];    // bytes 6 to 26
  UINT8 symbol_condition;  // byte 27
  UINT8 underlying[8];     // bytes 28 to 35
} SymbolMappingMessage;

// The Trading Status message is used to indicate the current trading status of an options contract. A Trading Status message will be sent whenever a security's trading status changes. The Trading Status field will be used to represent the status of the RTH (9:30 a.m. ET - 4:15 p.m. ET) and Curb sessions. The GTH Trading Status field will be used to represent the status of series that trade during the GTH session. The GTH session runs from 8:15 p.m. to 9:25 a.m. ET for GTH-eligible Products (C1 only).
typedef struct _TradingStatusMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT8 symbol[6];           // bytes 4 to 9
  UINT8 reserved_2[2];       // bytes 10 to 11
  UINT8 trading_status;      // byte 12
  UINT8 reserved_1;          // byte 13
  UINT8 gth_trading_status;  // byte 14
  UINT8 second_reserved_1;   // byte 15
} TradingStatusMessage;

// The Width Update message is used to communicate opening quote width multiplier. This message will be sent in the event that the exchange decides to change the quote width multiplier on a per underlying basis.
typedef struct _WidthUpdateMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT8 underlying[8];  // bytes 4 to 11
  UINT8 width_type;     // byte 12
  UINT32 multiplier;    // bytes 13 to 16
} WidthUpdateMessage;

// Options Auction Update messages are used to disseminate price and size information and Composite Market bid and offer prices during Opening and Re-Opening (halt) auctions on the Cboe Options Exchange.
typedef struct _OptionsAuctionUpdateMessage {
  UINT32 time_offset;                   // bytes 0 to 3
  UINT8 expanded_symbol[8];             // bytes 4 to 11
  UINT8 auction_type;                   // byte 12
  UINT64 reference_price;               // bytes 13 to 20
  UINT32 buy_contracts;                 // bytes 21 to 24
  UINT32 sell_contracts;                // bytes 25 to 28
  UINT64 indicative_price;              // bytes 29 to 36
  UINT64 auction_only_price;            // bytes 37 to 44
  UINT8 opening_condition;              // byte 45
  UINT64 composite_market_bid_price;    // bytes 46 to 53
  UINT64 composite_market_offer_price;  // bytes 54 to 61
} OptionsAuctionUpdateMessage;

// Auction Summary messages are used to disseminate the results of an auction, including Opening and Re-Opening on the Cboe Options Exchange.
typedef struct _AuctionSummaryMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT8 stock_symbol[8];  // bytes 4 to 11
  UINT8 auction_type;     // byte 12
  UINT64 price_long;      // bytes 13 to 20
  UINT32 contracts;       // bytes 21 to 24
} AuctionSummaryMessage;

// C1 and EDGX Options Only. Auction Notification messages are used to disseminate order details of an auction. Auctions will be available for a defined period of time known as the exposure period.
typedef struct _AuctionNotificationMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 symbol[6];            // bytes 4 to 9
  UINT64 auction_id;          // bytes 10 to 17
  UINT8 auction_type;         // byte 18
  UINT8 side;                 // byte 19
  UINT64 price_long;          // bytes 20 to 27
  UINT32 contracts;           // bytes 28 to 31
  UINT8 customer_indicator;   // byte 32
  UINT8 participant_id[4];    // bytes 33 to 36
  UINT32 auction_end_offset;  // bytes 37 to 40
  UINT8 client_id[4];         // bytes 41 to 44
} AuctionNotificationMessage;

// C1 and EDGX Options Only. Auction Cancel messages are used to disseminate the cancelation of an earlier Auction Notification message.
typedef struct _AuctionCancelMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 auction_id;   // bytes 4 to 11
} AuctionCancelMessage;

// C1 and EDGX Options Only. Auction Trade messages are used to disseminate executions resulting from an options auction.
typedef struct _AuctionTradeMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 auction_id;    // bytes 4 to 11
  UINT64 execution_id;  // bytes 12 to 19
  UINT64 price_long;    // bytes 20 to 27
  UINT32 contracts;     // bytes 28 to 31
} AuctionTradeMessage;

// C1 Only. The SOQ Strike Range Update message disseminates the minimum and maximum strike prices of the strike price range used to calculate the Special Opening Quote (SOQ) on a Volatility Settlement date.
typedef struct _SoqStrikeRangeUpdateMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 soq_identifier[20];   // bytes 4 to 23
  UINT64 lower_strike_price;  // bytes 24 to 31
  UINT64 upper_strike_price;  // bytes 32 to 39
} SoqStrikeRangeUpdateMessage;

// C1 Only. The Constituent Symbol Mapping message is used to communicate which options series are Constituent Series in a Volatility Settlement Special Opening Quote (SOQ).
typedef struct _ConstituentSymbolMappingMessage {
  UINT8 feed_symbol[6];      // bytes 0 to 5
  UINT8 osi_symbol[21];      // bytes 6 to 26
  UINT8 symbol_condition;    // byte 27
  UINT8 underlying[8];       // bytes 28 to 35
  UINT8 soq_identifier[20];  // bytes 36 to 55
} ConstituentSymbolMappingMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: LoginMessage login_message;
    case 0x02: LoginResponseMessage login_response_message;
    case 0x80: SpinImageAvailableMessage spin_image_available_message;
    case 0x81: SpinRequestMessage spin_request_message;
    case 0x82: SpinResponseMessage spin_response_message;
    case 0x83: SpinFinishedMessage spin_finished_message;
    case 0x84: InstrumentDefinitionRequestMessage instrument_definition_request_message;
    case 0x85: InstrumentDefinitionResponseMessage instrument_definition_response_message;
    case 0x86: unit instrument_definition_finished_message;
    case 0x20: TimeMessage time_message;
    case 0x97: UnitClearMessage unit_clear_message;
    case 0xBC: TransactionBeginMessage transaction_begin_message;
    case 0xBD: TransactionEndMessage transaction_end_message;
    case 0x21: AddOrderLongMessage add_order_long_message;
    case 0x22: AddOrderShortMessage add_order_short_message;
    case 0x2F: AddOrderExpandedMessage add_order_expanded_message;
    case 0x23: OrderExecutedMessage order_executed_message;
    case 0x24: OrderExecutedAtPriceSizeMessage order_executed_at_price_size_message;
    case 0x25: ReduceSizeLongMessage reduce_size_long_message;
    case 0x26: ReduceSizeShortMessage reduce_size_short_message;
    case 0x27: ModifyOrderLongMessage modify_order_long_message;
    case 0x28: ModifyOrderShortMessage modify_order_short_message;
    case 0x29: DeleteOrderMessage delete_order_message;
    case 0x2A: TradeLongMessage trade_long_message;
    case 0x2B: TradeShortMessage trade_short_message;
    case 0x30: TradeExpandedMessage trade_expanded_message;
    case 0x2C: TradeBreakMessage trade_break_message;
    case 0x2D: EndOfSessionMessage end_of_session_message;
    case 0x2E: SymbolMappingMessage symbol_mapping_message;
    case 0x31: TradingStatusMessage trading_status_message;
    case 0xD2: WidthUpdateMessage width_update_message;
    case 0xD1: OptionsAuctionUpdateMessage options_auction_update_message;
    case 0x96: AuctionSummaryMessage auction_summary_message;
    case 0xAD: AuctionNotificationMessage auction_notification_message;
    case 0xAE: AuctionCancelMessage auction_cancel_message;
    case 0xAF: AuctionTradeMessage auction_trade_message;
    case 0x9D: SoqStrikeRangeUpdateMessage soq_strike_range_update_message;
    case 0x9E: ConstituentSymbolMappingMessage constituent_symbol_mapping_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Tcp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

