// Chicago Board Options Exchange Binary Order Entry
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out BzxOptions_BinaryOrderEntry_v1_0_10_Firm.3d
//
// What this definition does not state, and the model does:
// - a Reassemble rule
// - a run counted by a field
//
// License: MIT No Attribution

// ---- Firm Message Header: 12 bytes -------------------------------------------

// Message header of a packet sent by the firm
entrypoint typedef struct _FirmMessageHeader {
  UINT16 start_of_message;   // bytes 0 to 1
  UINT16 message_length;     // bytes 2 to 3
  UINT16 firm_message_type;  // bytes 4 to 5
  UINT8 matching_unit;       // byte 6
  UINT8 reserved_field;      // byte 7
  UINT32 sequence_number;    // bytes 8 to 11
} FirmMessageHeader;

// ---- Prevent Match: 3 bytes --------------------------------------------------

entrypoint typedef struct _PreventMatch {
  UINT8 mtp_modifier;      // byte 0
  UINT8 unique_id_level;   // byte 1
  UINT8 trading_group_id;  // byte 2
} PreventMatch;

// ---- New Order Message: 193 bytes --------------------------------------------

// Submission of a new simple (single leg) order to Cboe
entrypoint typedef struct _NewOrderMessage {
  UINT8 cl_ord_id[20];               // bytes 0 to 19
  UINT8 side;                        // byte 20
  UINT32 order_qty;                  // bytes 21 to 24
  UINT8 clearing_firm[4];            // bytes 25 to 28
  UINT8 clearing_account[4];         // bytes 29 to 32
  UINT64 price;                      // bytes 33 to 40, signed, read here as unsigned
  UINT8 exec_inst;                   // byte 41
  UINT8 ord_type;                    // byte 42
  UINT8 time_in_force;               // byte 43
  UINT32 min_qty;                    // bytes 44 to 47
  UINT32 max_floor;                  // bytes 48 to 51
  UINT8 symbol[8];                   // bytes 52 to 59
  UINT8 capacity;                    // byte 60
  UINT8 routing_inst[4];             // bytes 61 to 64
  UINT8 account[16];                 // bytes 65 to 80
  UINT8 display_indicator;           // byte 81
  PreventMatch prevent_match;        // bytes 82 to 84
  UINT64 expire_time;                // bytes 85 to 92
  UINT32 maturity_date;              // bytes 93 to 96
  UINT64 strike_price;               // bytes 97 to 104, signed, read here as unsigned
  UINT8 put_or_call;                 // byte 105
  UINT8 open_close;                  // byte 106
  UINT32 cmta_number;                // bytes 107 to 110
  UINT8 target_party_id[4];          // bytes 111 to 114
  UINT8 session_eligibility;         // byte 115
  UINT8 attributed_quote;            // byte 116
  UINT32 display_range;              // bytes 117 to 120
  UINT64 stop_px;                    // bytes 121 to 128, signed, read here as unsigned
  UINT8 rout_strategy[6];            // bytes 129 to 134
  UINT8 route_delivery_method[3];    // bytes 135 to 137
  UINT8 ex_destination;              // byte 138
  UINT64 auction_id;                 // bytes 139 to 146
  UINT8 routing_firm_id[4];          // bytes 147 to 150
  UINT16 custom_group_id;            // bytes 151 to 152
  UINT8 clearing_optional_data[16];  // bytes 153 to 168
  UINT8 client_id_attr[4];           // bytes 169 to 172
  UINT8 frequent_trader_id[6];       // bytes 173 to 178
  UINT8 compression;                 // byte 179
  UINT8 floor_destination[4];        // bytes 180 to 183
  UINT8 floor_routing_inst;          // byte 184
  UINT8 order_origin[3];             // bytes 185 to 187
  UINT8 order_router_subsidy;        // byte 188
  UINT8 price_type;                  // byte 189
  UINT8 held;                        // byte 190
  UINT16 scratch_pad;                // bytes 191 to 192
} NewOrderMessage;

// ---- New Order Short Message: 117 bytes --------------------------------------

// Submission of a new simple (single leg) order to Cboe
entrypoint typedef struct _NewOrderShortMessage {
  UINT8 cl_ord_id[20];          // bytes 0 to 19
  UINT8 side;                   // byte 20
  UINT32 order_qty;             // bytes 21 to 24
  UINT8 clearing_firm[4];       // bytes 25 to 28
  UINT8 clearing_account[4];    // bytes 29 to 32
  UINT64 price;                 // bytes 33 to 40, signed, read here as unsigned
  UINT8 exec_inst;              // byte 41
  UINT8 ord_type;               // byte 42
  UINT8 time_in_force;          // byte 43
  UINT32 min_qty;               // bytes 44 to 47
  UINT32 max_floor;             // bytes 48 to 51
  UINT8 symbol[8];              // bytes 52 to 59
  UINT8 capacity;               // byte 60
  UINT8 routing_inst[4];        // bytes 61 to 64
  UINT8 account[16];            // bytes 65 to 80
  UINT8 display_indicator;      // byte 81
  PreventMatch prevent_match;   // bytes 82 to 84
  UINT8 open_close;             // byte 85
  UINT32 cmta_number;           // bytes 86 to 89
  UINT8 session_eligibility;    // byte 90
  UINT8 attributed_quote;       // byte 91
  UINT8 rout_strategy[6];       // bytes 92 to 97
  UINT8 ex_destination;         // byte 98
  UINT64 auction_id;            // bytes 99 to 106
  UINT16 custom_group_id;       // bytes 107 to 108
  UINT8 frequent_trader_id[6];  // bytes 109 to 114
  UINT16 scratch_pad;           // bytes 115 to 116
} NewOrderShortMessage;

// ---- Cancel Order Message: 30 bytes ------------------------------------------

// Request to cancel a single order
entrypoint typedef struct _CancelOrderMessage {
  UINT8 orig_cl_ord_id[20];  // bytes 0 to 19
  UINT8 clearing_firm[4];    // bytes 20 to 23
  UINT8 routing_firm_id[4];  // bytes 24 to 27
  UINT16 scratch_pad;        // bytes 28 to 29
} CancelOrderMessage;

// ---- Mass Cancel Inst: 8 bytes -----------------------------------------------

entrypoint typedef struct _MassCancelInst {
  UINT8 clearing_firm_filter;    // byte 0
  UINT8 acknowledgement_style;   // byte 1
  UINT8 lockout_instruction;     // byte 2
  UINT8 instrument_type_filter;  // byte 3
  UINT8 gtc_order_filter;        // byte 4
  UINT8 instruction_details[3];  // bytes 5 to 7
} MassCancelInst;

// ---- Mass Cancel Order Message: 52 bytes -------------------------------------

// MassCancelOrderMessage
entrypoint typedef struct _MassCancelOrderMessage {
  UINT8 mass_cancel_id[20];         // bytes 0 to 19
  UINT8 clearing_firm[4];           // bytes 20 to 23
  UINT8 routing_firm_id[4];         // bytes 24 to 27
  UINT8 risk_root[6];               // bytes 28 to 33
  MassCancelInst mass_cancel_inst;  // bytes 34 to 41
  UINT64 send_time;                 // bytes 42 to 49
  UINT16 scratch_pad;               // bytes 50 to 51
} MassCancelOrderMessage;

// ---- Modify Order Message: 117 bytes -----------------------------------------

// Request to modify an order
entrypoint typedef struct _ModifyOrderMessage {
  UINT8 cl_ord_id[20];          // bytes 0 to 19
  UINT8 orig_cl_ord_id[20];     // bytes 20 to 39
  UINT8 clearing_firm[4];       // bytes 40 to 43
  UINT8 routing_firm_id[4];     // bytes 44 to 47
  UINT32 order_qty;             // bytes 48 to 51
  UINT64 price;                 // bytes 52 to 59, signed, read here as unsigned
  UINT8 ord_type;               // byte 60
  UINT32 max_floor;             // bytes 61 to 64
  UINT64 stop_px;               // bytes 65 to 72, signed, read here as unsigned
  UINT8 cancel_orig_on_reject;  // byte 73
  UINT8 reserved[41];           // bytes 74 to 114
  UINT16 scratch_pad;           // bytes 115 to 116
} ModifyOrderMessage;

// ---- Reset Risk Message: 39 bytes --------------------------------------------

// Reset or release Firm, Risk Root, or Custom Group ID level lockout conditions resulting from risk profile trips or self-imposed lockouts issued via Cancel Order or Purge Orders messages
entrypoint typedef struct _ResetRiskMessage {
  UINT8 risk_status_id[16];    // bytes 0 to 15
  UINT8 risk_reset[8];         // bytes 16 to 23
  UINT8 clearing_firm[4];      // bytes 24 to 27
  UINT8 risk_root[6];          // bytes 28 to 33
  UINT8 target_matching_unit;  // byte 34
  UINT16 custom_group_id;      // bytes 35 to 36
  UINT16 scratch_pad;          // bytes 37 to 38
} ResetRiskMessage;

