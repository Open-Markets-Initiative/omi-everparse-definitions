// ---- Types -------------------------------------------------------------------

// A Time message is immediately generated and sent when there is a PITCH event for a given clock second
typedef struct _TimeMessage {
  UINT32 time;  // bytes 0 to 3
} TimeMessage;

// The Unit Clear message instructs feed recipients to clear all orders for the Cboe book in the unit specified in the Sequenced Unit Header
typedef struct _UnitClearMessage {
  UINT32 time_offset;  // bytes 0 to 3
} UnitClearMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book
typedef struct _AddOrderLongMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT64 order_id;       // bytes 4 to 11
  UINT8 side_indicator;  // byte 12
  UINT32 quantity;       // bytes 13 to 16
  UINT8 symbol_long[8];  // bytes 17 to 24
  UINT64 price_long;     // bytes 25 to 32
} AddOrderLongMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book.
typedef struct _AddOrderShortMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT16 quantity_short;  // bytes 13 to 14
  UINT8 symbol_short[6];  // bytes 15 to 20
  UINT16 price_short;     // bytes 21 to 22
} AddOrderShortMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book. Expanded version accommodates larger symbol sizes possible through the ISRA plan.
typedef struct _AddOrderExpandedMessage {
  UINT32 time_offset;       // bytes 0 to 3
  UINT64 order_id;          // bytes 4 to 11
  UINT8 side_indicator;     // byte 12
  UINT32 quantity;          // bytes 13 to 16
  UINT8 symbol_long[8];     // bytes 17 to 24
  UINT64 price_long;        // bytes 25 to 32
  UINT8 unused_1 : 1;       // byte 33
  UINT8 si_quote : 1;       // byte 33
  UINT8 unused_6 : 6;       // byte 33
  UINT8 participant_id[4];  // bytes 34 to 37
} AddOrderExpandedMessage;

// Execution Flags
typedef struct _ExecutionFlags {
  UINT8 market_mechanism;   // byte 0
  UINT8 trading_mode;       // byte 1
  UINT8 ex_cum_dividend;    // byte 2
  UINT8 algorithmic_trade;  // byte 3
} ExecutionFlags;

// Order Executed messages are sent when a visible order on the Cboe book is executed in whole or in part
typedef struct _OrderExecutedMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT32 executed_shares;          // bytes 12 to 15
  UINT64 execution_id;             // bytes 16 to 23
  ExecutionFlags execution_flags;  // bytes 24 to 27
} OrderExecutedMessage;

// Order Executed at Price/Size messages are sent when a visible order on the Cboe book is executed in whole or in part at a different price than the limit price on the original Add Order message or the limit order price in the latest Modify Order message referencing the Order Id.
typedef struct _OrderExecutedAtPriceSizeMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT32 executed_shares;          // bytes 12 to 15
  UINT32 remaining_shares;         // bytes 16 to 19
  UINT64 execution_id;             // bytes 20 to 27
  UINT64 price_long;               // bytes 28 to 35
  ExecutionFlags execution_flags;  // bytes 36 to 39
} OrderExecutedAtPriceSizeMessage;

// Reduce Size messages are sent when a visible order on the Cboe book is partially reduced.
typedef struct _ReduceSizeLongMessage {
  UINT32 time_offset;           // bytes 0 to 3
  UINT64 order_id;              // bytes 4 to 11
  UINT32 canceled_shares_long;  // bytes 12 to 15
} ReduceSizeLongMessage;

// Reduce Size messages are sent when a visible order on the Cboe book is partially reduced
typedef struct _ReduceSizeShortMessage {
  UINT32 time_offset;            // bytes 0 to 3
  UINT64 order_id;               // bytes 4 to 11
  UINT16 canceled_shares_short;  // bytes 12 to 13
} ReduceSizeShortMessage;

// The Modify Order message is sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message.
typedef struct _ModifyOrderLongMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
  UINT32 shares_long;  // bytes 12 to 15
  UINT64 price_long;   // bytes 16 to 23
} ModifyOrderLongMessage;

// The Modify Order message is sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message.
typedef struct _ModifyOrderShortMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 order_id;      // bytes 4 to 11
  UINT16 shares_short;  // bytes 12 to 13
  UINT16 price_short;   // bytes 14 to 15
} ModifyOrderShortMessage;

// The Delete Order message is sent whenever an open order is completely canceled. The Order Id refers to the Order Id of the original Add Order message.
typedef struct _DeleteOrderMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
} DeleteOrderMessage;

// Trade Flags
typedef struct _TradeFlags {
  UINT8 market_mechanism;      // byte 0
  UINT8 trading_mode;          // byte 1
  UINT8 transaction_category;  // byte 2
  UINT8 trade_types;           // byte 3
  UINT8 algorithmic_trade;     // byte 4
} TradeFlags;

// The Trade message provides information about executions of complex order auctions on the Cboe complex book.
typedef struct _TradeLongMessage {
  UINT32 time_offset;      // bytes 0 to 3
  UINT64 order_id;         // bytes 4 to 11
  UINT8 side_indicator;    // byte 12
  UINT32 shares_long;      // bytes 13 to 16
  UINT8 symbol_long[8];    // bytes 17 to 24
  UINT64 price_long;       // bytes 25 to 32
  UINT64 execution_id;     // bytes 33 to 40
  TradeFlags trade_flags;  // bytes 41 to 45
} TradeLongMessage;

// The Trade message provides information about executions of non-displayed orders on the Cboe book and routed executions to other trading centers.
typedef struct _TradeShortMessage {
  UINT32 time_offset;      // bytes 0 to 3
  UINT64 order_id;         // bytes 4 to 11
  UINT8 side_indicator;    // byte 12
  UINT16 contracts_short;  // bytes 13 to 14
  UINT8 symbol_short[6];   // bytes 15 to 20
  UINT16 price_short;      // bytes 21 to 22
  UINT64 execution_id;     // bytes 23 to 30
  TradeFlags trade_flags;  // bytes 31 to 35
} TradeShortMessage;

// Extended Trade Flags
typedef struct _ExtendedTradeFlags {
  UINT8 market_mechanism;                     // byte 0
  UINT8 trading_mode;                         // byte 1
  UINT8 transaction_category;                 // byte 2
  UINT8 negotiated_trade;                     // byte 3
  UINT8 crossing_trade;                       // byte 4
  UINT8 modification_indicator;               // byte 5
  UINT8 benchmark_reference_price_indicator;  // byte 6
  UINT8 special_dividend;                     // byte 7
  UINT8 off_book_automated_indicator;         // byte 8
  UINT8 price_formation_discovery_process;    // byte 9
  UINT8 algorithmic_indicator;                // byte 10
  UINT8 publication_mode_deferral_reason;     // byte 11
  UINT8 deferral_or_enrichment_type;          // byte 12
  UINT8 duplicative_indicator;                // byte 13
} ExtendedTradeFlags;

// The Trade message provides information about executions of complex order auctions on the Cboe complex book.
typedef struct _TradeExtendedMessage {
  UINT32 time_offset;                       // bytes 0 to 3
  UINT64 shares_extended;                   // bytes 4 to 11
  UINT8 symbol_long[8];                     // bytes 12 to 19
  UINT64 price_long;                        // bytes 20 to 27
  UINT64 trade_id;                          // bytes 28 to 35
  UINT64 trade_timestamp;                   // bytes 36 to 43
  UINT8 execution_venue[4];                 // bytes 44 to 47
  UINT8 currency[3];                        // bytes 48 to 50
  UINT8 cboe_trade_flags;                   // byte 51
  ExtendedTradeFlags extended_trade_flags;  // bytes 52 to 65
} TradeExtendedMessage;

// This message provides details of trades reported to Cboe, but traded on a symbol not currently known to Cboe
typedef struct _TradeUnknownSymbolMessage {
  UINT32 time_offset;                       // bytes 0 to 3
  UINT64 shares_extended;                   // bytes 4 to 11
  UINT8 symbol_extended[12];                // bytes 12 to 23
  UINT64 price_long;                        // bytes 24 to 31
  UINT64 trade_id;                          // bytes 32 to 39
  UINT64 trade_timestamp;                   // bytes 40 to 47
  UINT8 execution_venue[4];                 // bytes 48 to 51
  UINT8 currency[3];                        // bytes 52 to 54
  UINT8 cboe_trade_flags;                   // byte 55
  ExtendedTradeFlags extended_trade_flags;  // bytes 56 to 69
} TradeUnknownSymbolMessage;

// The End of Session message is sent for each unit when the unit shuts down
typedef struct _EndOfSession {
  UINT32 time_offset;  // bytes 0 to 3
} EndOfSession;

// The Transaction Begin message indicates any subsequent messages, up to the accompanying Transaction End message, are all part of the same transaction block
typedef struct _TransactionBeginMessage {
  UINT32 time_offset;  // bytes 0 to 3
} TransactionBeginMessage;

// The Transaction End message indicates that a transaction indicated by a previous Transaction Begin message has completed
typedef struct _TransactionEndMessage {
  UINT32 time_offset;  // bytes 0 to 3
} TransactionEndMessage;

// The Trading Status message is used to indicate the current trading status of a complex instrument.
typedef struct _TradingStatusMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT8 symbol_long[8];  // bytes 4 to 11
  UINT8 trading_status;  // byte 12
  UINT8 reserved_3[3];   // bytes 13 to 15
} TradingStatusMessage;

// The Statistics Message is used to disseminate the statistics prices: opening, closing, high, low
typedef struct _StatisticsMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 symbol_long[8];       // bytes 4 to 11
  UINT64 price_long;          // bytes 12 to 19
  UINT8 statistic_type;       // byte 20
  UINT8 price_determination;  // byte 21
} StatisticsMessage;

// Auction Update messages are used to disseminate indicative price and size information during auctions for Cboe auction eligible securities
typedef struct _AuctionUpdateMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT8 symbol_long[8];      // bytes 4 to 11
  UINT8 auction_type;        // byte 12
  UINT64 reference_price;    // bytes 13 to 20
  UINT64 indicative_price;   // bytes 21 to 28
  UINT32 indicative_shares;  // bytes 29 to 32
  UINT8 outside_tolerance;   // byte 33
  UINT8 includes_primary;    // byte 34
} AuctionUpdateMessage;

// Auction Summary messages are used to disseminate the results of an auction in a Cboe auction eligible security
typedef struct _AuctionSummaryMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT8 symbol_long[8];  // bytes 4 to 11
  UINT8 auction_type;    // byte 12
  UINT64 price_long;     // bytes 13 to 20
  UINT32 shares_long;    // bytes 21 to 24
} AuctionSummaryMessage;

// Index Quote Messages are sent every second
typedef struct _IndexQuoteMessage {
  UINT64 index_timestamp;  // bytes 0 to 7
  UINT8 index_ticker[10];  // bytes 8 to 17
  UINT64 index_price;      // bytes 18 to 25
  UINT8 index_status;      // byte 26
} IndexQuoteMessage;

// Index Quote EDSP Messages are sent at end of day
typedef struct _IndexQuoteEdspMessage {
  UINT64 index_timestamp;  // bytes 0 to 7
  UINT8 index_ticker[10];  // bytes 8 to 17
  UINT64 index_price;      // bytes 18 to 25
} IndexQuoteEdspMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x20: TimeMessage time_message;
    case 0x97: UnitClearMessage unit_clear_message;
    case 0x40: AddOrderLongMessage add_order_long_message;
    case 0x22: AddOrderShortMessage add_order_short_message;
    case 0x2F: AddOrderExpandedMessage add_order_expanded_message;
    case 0x23: OrderExecutedMessage order_executed_message;
    case 0x24: OrderExecutedAtPriceSizeMessage order_executed_at_price_size_message;
    case 0x25: ReduceSizeLongMessage reduce_size_long_message;
    case 0x26: ReduceSizeShortMessage reduce_size_short_message;
    case 0x27: ModifyOrderLongMessage modify_order_long_message;
    case 0x28: ModifyOrderShortMessage modify_order_short_message;
    case 0x29: DeleteOrderMessage delete_order_message;
    case 0x41: TradeLongMessage trade_long_message;
    case 0x2B: TradeShortMessage trade_short_message;
    case 0x32: TradeExtendedMessage trade_extended_message;
    case 0x35: TradeUnknownSymbolMessage trade_unknown_symbol_message;
    case 0x2D: EndOfSession end_of_session;
    case 0xBC: TransactionBeginMessage transaction_begin_message;
    case 0xBD: TransactionEndMessage transaction_end_message;
    case 0x31: TradingStatusMessage trading_status_message;
    case 0x34: StatisticsMessage statistics_message;
    case 0xAC: AuctionUpdateMessage auction_update_message;
    case 0x96: AuctionSummaryMessage auction_summary_message;
    case 0xD8: IndexQuoteMessage index_quote_message;
    case 0xD9: IndexQuoteEdspMessage index_quote_edsp_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

