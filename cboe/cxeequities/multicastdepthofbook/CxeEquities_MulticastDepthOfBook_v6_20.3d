#define MARKET_MECHANISM_PERIODIC_AUCTION 0x35                                 // Periodic Auction
#define MARKET_MECHANISM_REQUEST_FOR_QUOTES_7_ANY_OTHER_INCLUDING_HYBRID 0x36  // Request For Quotes 7 Any Other Including Hybrid

// Trading Mode: one byte code
#define TRADING_MODE_UNDEFINED_AUCTION 0x31                        // Undefined Auction
#define TRADING_MODE_CONTINUOUS_TRADING 0x32                       // Continuous Trading
#define TRADING_MODE_AT_MARKET_CLOSE_TRADING 0x33                  // At Market Close Trading
#define TRADING_MODE_OUT_OF_MAIN_SESSION 0x34                      // Out Of Main Session
#define TRADING_MODE_TRADE_REPORTING_ON_EXCHANGE 0x35              // Trade Reporting On Exchange
#define TRADING_MODE_TRADE_REPORTING_OFF_EXCHANGE 0x36             // Trade Reporting Off Exchange
#define TRADING_MODE_TRADE_REPORTING_SYSTEMATIC_INTERNALIZER 0x37  // Trade Reporting Systematic Internalizer
#define TRADING_MODE_SCHEDULED_OPENING_AUCTION 0x4F                // Scheduled Opening Auction
#define TRADING_MODE_SCHEDULED_CLOSING_AUCTION 0x4B                // Scheduled Closing Auction
#define TRADING_MODE_SCHEDULED_INTRADAY_AUCTION 0x49               // Scheduled Intraday Auction
#define TRADING_MODE_UNSCHEDULED_AUCTION 0x55                      // Unscheduled Auction

