#define EX_CUM_DIVIDEND_EX_CUM_SPECIAL_DIVIDEND_IF_OPTIONALLY_SET_BY_REPORTING_PARTY 0x45  // Ex Cum Special Dividend If Optionally Set By Reporting Party
#define EX_CUM_DIVIDEND_NOT_SPECIFIED 0x2D                                                 // Not Specified

// Algorithmic Trade: one byte code
#define ALGORITHMIC_TRADE_ALGORITHMIC_TRADE 0x48      // Algorithmic Trade
#define ALGORITHMIC_TRADE_NON_ALGORITHMIC_TRADE 0x2D  // Non Algorithmic Trade

// Transaction Category: one byte code
#define TRANSACTION_CATEGORY_DARK_TRADE 0x44                                 // Dark Trade
#define TRANSACTION_CATEGORY_TRADE_THAT_HAS_RECEIVED_PRICE_IMPROVEMENT 0x52  // Trade That Has Received Price Improvement
#define TRANSACTION_CATEGORY_PACKAGED_TRADE 0x5A                             // Packaged Trade
#define TRANSACTION_CATEGORY_EXCHANGE_FOR_PHYSICALS_TRADE 0x59               // Exchange For Physicals Trade
#define TRANSACTION_CATEGORY_NONE_OF_THE_ABOVE_APPLY 0x2D                    // None Of The Above Apply

// Benchmark Reference Price Indicator: one byte code
#define BENCHMARK_REFERENCE_PRICE_INDICATOR_BENCHMARK_TRADE_IF_OPTIONALLY_SET_BY_REPORTING_PARTY 0x42  // Benchmark Trade If Optionally Set By Reporting Party
#define BENCHMARK_REFERENCE_PRICE_INDICATOR_REFERENCE_PRICE_TRADE 0x53                                 // Reference Price Trade
#define BENCHMARK_REFERENCE_PRICE_INDICATOR_NOT_SPECIFIED 0x2D                                         // Not Specified

// Bats Trade Timing Indicator: one byte code
#define BATS_TRADE_TIMING_INDICATOR_THE_TRADE_WAS_REPORTED_TO_BATS_LATE 0x31                                        // The Trade Was Reported To Bats Late
#define BATS_TRADE_TIMING_INDICATOR_THE_TRADE_WAS_REPORTED_TO_BATS_OUT_OF_THE_MAIN_SESSION 0x32                     // The Trade Was Reported To Bats Out Of The Main Session
#define BATS_TRADE_TIMING_INDICATOR_THE_TRADE_WAS_REPORTED_TO_BATS_LATE_AND_OUT_OF_THE_MAIN_SESSION 0x33            // The Trade Was Reported To Bats Late And Out Of The Main Session
#define BATS_TRADE_TIMING_INDICATOR_OTHERWISE_NOTE_2AND_3ARE_NOT_VALID_VALUES_ON_THE_TRADE_REPORTING_FACILITY 0x2D  // Otherwise Note 2and 3are Not Valid Values On The Trade Reporting Facility

// Negotiated Trade: one byte code
#define NEGOTIATED_TRADE_NEGOTIATED_TRADE_IN_LIQUID_FINANCIAL_INSTRUMENTS 0x31                                  // Negotiated Trade In Liquid Financial Instruments
#define NEGOTIATED_TRADE_NEGOTIATED_TRADE_IN_ILLIQUID_FINANCIAL_INSTRUMENTS 0x32                                // Negotiated Trade In Illiquid Financial Instruments
#define NEGOTIATED_TRADE_NEGOTIATED_TRADE_SUBJECT_TO_CONDITIONS_OTHER_THAN_THE_CURRENT_MARKET_PRICE 0x33        // Negotiated Trade Subject To Conditions Other Than The Current Market Price
#define NEGOTIATED_TRADE_NEGOTIATED_TRADE_WHERE_NONE_OF_THE_ABOVE_APPLY 0x4E                                    // Negotiated Trade Where None Of The Above Apply
#define NEGOTIATED_TRADE_PRE_TRADE_TRANSPARENCY_WAIVER_FOR_ILLIQUID_INSTRUMENT_ON_AN_SI 0x34                    // Pre Trade Transparency Waiver For Illiquid Instrument On An Si
#define NEGOTIATED_TRADE_PRE_TRADE_TRANSPARENCY_WAIVER_FOR_ABOVE_STANDARD_MARKET_SIZE_ON_AN_SI_6_P_jb30of 0x35  // Pre Trade Transparency Waiver For Above Standard Market Size On An Si 6 Pre Trade Transparency Waivers For Illiquid Instrument On An Si And Above Standard Market Size On An Si
#define NEGOTIATED_TRADE_NOT_SPECIFIED 0x2D                                                                     // Not Specified

// Crossing Trade: one byte code
#define CROSSING_TRADE_CROSSING_TRADE 0x58  // Crossing Trade
#define CROSSING_TRADE_NOT_SPECIFIED 0x2D   // Not Specified

// Modification Indicator: one byte code
#define MODIFICATION_INDICATOR_INDICATES_A_MODIFICATION_OF_A_PREVIOUSLY_REPORTED_TRADE 0x41  // Indicates A Modification Of A Previously Reported Trade
#define MODIFICATION_INDICATOR_INDICATES_A_CANCELLATION_OF_A_PREVIOUSLY_REPORTED_TRADE 0x43  // Indicates A Cancellation Of A Previously Reported Trade
#define MODIFICATION_INDICATOR_NOT_SPECIFIED 0x2D                                            // Not Specified

// Off Book Automated Indicator: one byte code
#define OFF_BOOK_AUTOMATED_INDICATOR_AUTOMATED 0x51      // Automated
#define OFF_BOOK_AUTOMATED_INDICATOR_MANUAL 0x4D         // Manual
#define OFF_BOOK_AUTOMATED_INDICATOR_NOT_SPECIFIED 0x2D  // Not Specified

// Price Formation Discovery Process: one byte code
#define PRICE_FORMATION_DISCOVERY_PROCESS_STANDARD_TRADE_FOR_THE_SPECIFIED_MARKET_MECHANISM_OR_TRADING_MODE 0x50                 // Standard Trade For The Specified Market Mechanism Or Trading Mode
#define PRICE_FORMATION_DISCOVERY_PROCESS_NON_PRICE_FORMING_TRADE_FORMERLY_KNOWN_AS_TECHNICAL_TRADE 0x54                         // Non Price Forming Trade Formerly Known As Technical Trade
#define PRICE_FORMATION_DISCOVERY_PROCESS_TRADE_NOT_CONTRIBUTING_TO_PRICE_DISCOVERY_PROCESS_FORMERLY_TECHNICAL_TRAD_hf0g3w 0x4A  // Trade Not Contributing To Price Discovery Process Formerly Technical Trade N Price Is Currently Not Available But Pending

// Publication Mode Deferral Reason: one byte code
#define PUBLICATION_MODE_DEFERRAL_REASON_TRADE_REPORT_REPORTED_LATE_WITHOUT_PERMITTED_DEFERRAL 0x31                             // Trade Report Reported Late Without Permitted Deferral
#define PUBLICATION_MODE_DEFERRAL_REASON_DEFERRAL_TRADE_FOR_LARGE_IN_SCALE 0x32                                                 // Deferral Trade For Large In Scale
#define PUBLICATION_MODE_DEFERRAL_REASON_DEFERRAL_TRADE_FOR_ILLIQUID_INSTRUMENT 0x33                                            // Deferral Trade For Illiquid Instrument
#define PUBLICATION_MODE_DEFERRAL_REASON_DEFERRAL_TRADE_FOR_SIZE_SPECIFIC_5_DEFERRAL_TRADE_FOR_ILLIQUID_INSTRUMENT_6cgmoj 0x34  // Deferral Trade For Size Specific 5 Deferral Trade For Illiquid Instrument And Size Specific 6 Deferral Trade For Illiquid Instrument And Large In Scale
#define PUBLICATION_MODE_DEFERRAL_REASON_NOT_SPECIFIED_IMMEDIATE_PUBLICATION 0x2D                                               // Not Specified Immediate Publication

// Deferral Or Enrichement Type: one byte code
#define DEFERRAL_OR_ENRICHEMENT_TYPE_LIMITED_DETAILS_TRADE 0x31                                                             // Limited Details Trade
#define DEFERRAL_OR_ENRICHEMENT_TYPE_DAILY_AGGREGATED_TRADE 0x32                                                            // Daily Aggregated Trade
#define DEFERRAL_OR_ENRICHEMENT_TYPE_VOLUME_OMISSION_TRADE 0x33                                                             // Volume Omission Trade
#define DEFERRAL_OR_ENRICHEMENT_TYPE_FOUR_WEEKS_AGGREGATION_TRADE 0x34                                                      // Four Weeks Aggregation Trade
#define DEFERRAL_OR_ENRICHEMENT_TYPE_INDEFINITE_AGGREGATION_TRADE 0x35                                                      // Indefinite Aggregation Trade
#define DEFERRAL_OR_ENRICHEMENT_TYPE_VOLUME_OMISSION_TRADE_ELIGIBLE_FOR_SUBSEQUENT_ENRICHMENT_IN_AGGREGATED_FORM 0x36       // Volume Omission Trade Eligible For Subsequent Enrichment In Aggregated Form
#define DEFERRAL_OR_ENRICHEMENT_TYPE_FULL_DETAILS_OF_EARLIER_LIMITED_DETAILS_TRADE 0x37                                     // Full Details Of Earlier Limited Details Trade
#define DEFERRAL_OR_ENRICHEMENT_TYPE_FULL_DETAILS_OF_EARLIER_DAILY_AGGREGATED_TRADE 0x38                                    // Full Details Of Earlier Daily Aggregated Trade
#define DEFERRAL_OR_ENRICHEMENT_TYPE_FULL_DETAILS_OF_EARLIER_VOLUME_OMISSION_TRADE 0x39                                     // Full Details Of Earlier Volume Omission Trade
#define DEFERRAL_OR_ENRICHEMENT_TYPE_FULL_DETAILS_OF_FOUR_WEEKS_AGGREGATION_TRADE 0x56                                      // Full Details Of Four Weeks Aggregation Trade
#define DEFERRAL_OR_ENRICHEMENT_TYPE_FULL_DETAILS_OF_EARLIER_VOLUME_OMISSION_TRADE_ELIGIBLE_FOR_SUBSEQUENT_ENR_si0c55 0x57  // Full Details Of Earlier Volume Omission Trade Eligible For Subsequent Enrichment In Aggregated Form
#define DEFERRAL_OR_ENRICHEMENT_TYPE_NOT_APPLICABLE 0x2D                                                                    // Not Applicable

// Duplicative Indicator: one byte code
#define DUPLICATIVE_INDICATOR_DUPLICATIVE_TRADE_REPORT 0x31  // Duplicative Trade Report
#define DUPLICATIVE_INDICATOR_UNIQUE_TRADE_REPORT 0x2D       // Unique Trade Report

// Status: one byte code
#define STATUS_TRADING 0x54                           // Trading
#define STATUS_OFF_BOOK_REPORTING 0x52                // Off Book Reporting
#define STATUS_CLOSED 0x43                            // Closed
#define STATUS_SUSPENSION 0x53                        // Suspension
#define STATUS_NO_REFERENCE_PRICE 0x4E                // No Reference Price
#define STATUS_VOLATILITY_INTERRUPTION 0x56           // Volatility Interruption
#define STATUS_OPENING_AUCTION 0x4F                   // Opening Auction
#define STATUS_CLOSING_AUCTION 0x45                   // Closing Auction
#define STATUS_HALT 0x48                              // Halt
#define STATUS_MARKET_ORDER_IMBALANCE_EXTENSION 0x4D  // Market Order Imbalance Extension
#define STATUS_PRICE_MONITORING_EXTENSION 0x50        // Price Monitoring Extension

// Statistic Type: one byte code
#define STATISTIC_TYPE_CLOSING_PRICE 0x43           // Closing Price
#define STATISTIC_TYPE_HIGH_PRICE 0x48              // High Price
#define STATISTIC_TYPE_LOW_PRICE 0x4C               // Low Price
#define STATISTIC_TYPE_OPENING_PRICE 0x4F           // Opening Price
#define STATISTIC_TYPE_PREVIOUS_CLOSING_PRICE 0x50  // Previous Closing Price

// Price Determination: one byte code
#define PRICE_DETERMINATION_NORMAL 0x30                                       // Normal
#define PRICE_DETERMINATION_MANUAL_PRICE_OVERRIDE_BY_MARKET_SUPERVISION 0x31  // Manual Price Override By Market Supervision

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING_AUCTION 0x4F     // Opening Auction
#define AUCTION_TYPE_CLOSING_AUCTION 0x43     // Closing Auction
#define AUCTION_TYPE_HALT_AUCTION 0x48        // Halt Auction
#define AUCTION_TYPE_VOLATILITY_AUCTION 0x56  // Volatility Auction
#define AUCTION_TYPE_PERIODIC_AUCTION 0x50    // Periodic Auction

// Outside Tolerance: one byte code
#define OUTSIDE_TOLERANCE_OUTSIDE_TOLERANCE 0x4F  // Outside Tolerance
#define OUTSIDE_TOLERANCE_INSIDE_TOLERANCE 0x49   // Inside Tolerance
#define OUTSIDE_TOLERANCE_NOT_SPECIFIED 0x2D      // Not Specified

// Includes Primary: one byte code
#define INCLUDES_PRIMARY_INCLUDES_PRIMARY 0x50  // Includes Primary
#define INCLUDES_PRIMARY_EXCLUDES_PRIMARY 0x4E  // Excludes Primary
#define INCLUDES_PRIMARY_NOT_SPECIFIED 0x2D     // Not Specified

// ---- Types -------------------------------------------------------------------

// Time
typedef struct _TimeMessage {
  UINT32 time;  // bytes 0 to 3
} TimeMessage;

// Unit Clear
typedef struct _UnitClearMessage {
  UINT32 time_offset;  // bytes 0 to 3
} UnitClearMessage;

// Add Order Long
typedef struct _AddOrderLongMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT64 order_id;       // bytes 4 to 11
  UINT8 side_indicator;  // byte 12
  UINT32 quantity_long;  // bytes 13 to 16
  UINT8 symbol_long[8];  // bytes 17 to 24
  UINT64 price_long;     // bytes 25 to 32
} AddOrderLongMessage;

// Add Order Short
typedef struct _AddOrderShortMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT16 quantity_short;  // bytes 13 to 14
  UINT8 symbol_short[6];  // bytes 15 to 20
  UINT16 price_short;     // bytes 21 to 22
} AddOrderShortMessage;

// Add Order Expanded
typedef struct _AddOrderExpandedMessage {
  UINT32 time_offset;       // bytes 0 to 3
  UINT64 order_id;          // bytes 4 to 11
  UINT8 side_indicator;     // byte 12
  UINT32 quantity_long;     // bytes 13 to 16
  UINT8 symbol_long[8];     // bytes 17 to 24
  UINT64 price_long;        // bytes 25 to 32
  UINT8 unused_1 : 1;       // byte 33
  UINT8 si_quote : 1;       // byte 33
  UINT8 unused_6 : 6;       // byte 33
  UINT8 participant_id[4];  // bytes 34 to 37
} AddOrderExpandedMessage;

// Execution Flags
typedef struct _ExecutionFlags {
  UINT8 market_mechanism;   // byte 0
  UINT8 trading_mode;       // byte 1
  UINT8 ex_cum_dividend;    // byte 2
  UINT8 algorithmic_trade;  // byte 3
} ExecutionFlags;

// Order Executed
typedef struct _OrderExecutedMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT32 executed_shares;          // bytes 12 to 15
  UINT64 execution_id;             // bytes 16 to 23
  ExecutionFlags execution_flags;  // bytes 24 to 27
} OrderExecutedMessage;

// Order Executed at Price/Size
typedef struct _OrderExecutedAtPriceSizeMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT32 executed_shares;          // bytes 12 to 15
  UINT32 remaining_shares;         // bytes 16 to 19
  UINT64 execution_id;             // bytes 20 to 27
  UINT64 price_long;               // bytes 28 to 35
  ExecutionFlags execution_flags;  // bytes 36 to 39
} OrderExecutedAtPriceSizeMessage;

// Reduce Size Long
typedef struct _ReduceSizeLongMessage {
  UINT32 time_offset;            // bytes 0 to 3
  UINT64 order_id;               // bytes 4 to 11
  UINT32 cancelled_shares_long;  // bytes 12 to 15
} ReduceSizeLongMessage;

// Reduce Size Short
typedef struct _ReduceSizeShortMessage {
  UINT32 time_offset;             // bytes 0 to 3
  UINT64 order_id;                // bytes 4 to 11
  UINT16 cancelled_shares_short;  // bytes 12 to 13
} ReduceSizeShortMessage;

// Modify Order Long
typedef struct _ModifyOrderLongMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
  UINT32 shares_long;  // bytes 12 to 15
  UINT64 price_long;   // bytes 16 to 23
} ModifyOrderLongMessage;

// Modify Order Short
typedef struct _ModifyOrderShortMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 order_id;      // bytes 4 to 11
  UINT16 shares_short;  // bytes 12 to 13
  UINT16 price_short;   // bytes 14 to 15
} ModifyOrderShortMessage;

// Delete Order
typedef struct _DeleteOrderMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
} DeleteOrderMessage;

// Trade Flags
typedef struct _TradeFlags {
  UINT8 market_mechanism;                     // byte 0
  UINT8 trading_mode;                         // byte 1
  UINT8 transaction_category;                 // byte 2
  UINT8 benchmark_reference_price_indicator;  // byte 3
  UINT8 algorithmic_trade;                    // byte 4
} TradeFlags;

// Trade Long
typedef struct _TradeLongMessage {
  UINT32 time_offset;      // bytes 0 to 3
  UINT64 order_id;         // bytes 4 to 11
  UINT8 side_indicator;    // byte 12
  UINT32 shares_long;      // bytes 13 to 16
  UINT8 symbol_long[8];    // bytes 17 to 24
  UINT64 price_long;       // bytes 25 to 32
  UINT64 execution_id;     // bytes 33 to 40
  TradeFlags trade_flags;  // bytes 41 to 45
} TradeLongMessage;

// Trade Short
typedef struct _TradeShortMessage {
  UINT32 time_offset;      // bytes 0 to 3
  UINT64 order_id;         // bytes 4 to 11
  UINT8 side_indicator;    // byte 12
  UINT16 shares_short;     // bytes 13 to 14
  UINT8 symbol_short[6];   // bytes 15 to 20
  UINT16 price_short;      // bytes 21 to 22
  UINT64 execution_id;     // bytes 23 to 30
  TradeFlags trade_flags;  // bytes 31 to 35
} TradeShortMessage;

// Extended Trade Flags
typedef struct _ExtendedTradeFlags {
  UINT8 market_mechanism;                     // byte 0
  UINT8 trading_mode;                         // byte 1
  UINT8 transaction_category;                 // byte 2
  UINT8 negotiated_trade;                     // byte 3
  UINT8 crossing_trade;                       // byte 4
  UINT8 modification_indicator;               // byte 5
  UINT8 benchmark_reference_price_indicator;  // byte 6
  UINT8 special_dividend;                     // byte 7
  UINT8 off_book_automated_indicator;         // byte 8
  UINT8 price_formation_discovery_process;    // byte 9
  UINT8 algorithmic_indicator;                // byte 10
  UINT8 publication_mode_deferral_reason;     // byte 11
  UINT8 deferral_or_enrichement_type;         // byte 12
  UINT8 duplicative_indicator;                // byte 13
} ExtendedTradeFlags;

// Trade Extended
typedef struct _TradeExtendedMessage {
  UINT32 time_offset;                       // bytes 0 to 3
  UINT64 shares_extended;                   // bytes 4 to 11
  UINT8 symbol_long[8];                     // bytes 12 to 19
  UINT64 price_long;                        // bytes 20 to 27
  UINT64 trade_id;                          // bytes 28 to 35
  UINT64 trade_timestamp;                   // bytes 36 to 43
  UINT8 execution_venue[4];                 // bytes 44 to 47
  UINT8 currency[3];                        // bytes 48 to 50
  UINT8 bats_trade_timing_indicator;        // byte 51
  ExtendedTradeFlags extended_trade_flags;  // bytes 52 to 65
} TradeExtendedMessage;

// Trade Unknown Symbol
typedef struct _TradeUnknownSymbolMessage {
  UINT32 time_offset;                       // bytes 0 to 3
  UINT64 shares_extended;                   // bytes 4 to 11
  UINT8 symbol_extended[12];                // bytes 12 to 23
  UINT64 price_long;                        // bytes 24 to 31
  UINT64 trade_id;                          // bytes 32 to 39
  UINT64 trade_timestamp;                   // bytes 40 to 47
  UINT8 execution_venue[4];                 // bytes 48 to 51
  UINT8 currency[3];                        // bytes 52 to 54
  UINT8 bats_trade_timing_indicator;        // byte 55
  ExtendedTradeFlags extended_trade_flags;  // bytes 56 to 69
} TradeUnknownSymbolMessage;

// End of Session
typedef struct _EndOfSessionMessage {
  UINT32 time_offset;  // bytes 0 to 3
} EndOfSessionMessage;

// Trading Status
typedef struct _TradingStatusMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT8 symbol_long[8];  // bytes 4 to 11
  UINT8 status;          // byte 12
  UINT8 reserved_3[3];   // bytes 13 to 15
} TradingStatusMessage;

// Statistics Message
typedef struct _StatisticsMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 symbol_long[8];       // bytes 4 to 11
  UINT64 price_long;          // bytes 12 to 19
  UINT8 statistic_type;       // byte 20
  UINT8 price_determination;  // byte 21
} StatisticsMessage;

// Auction Update Message
typedef struct _AuctionUpdateMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT8 symbol_long[8];      // bytes 4 to 11
  UINT8 auction_type;        // byte 12
  UINT64 reference_price;    // bytes 13 to 20
  UINT64 indicative_price;   // bytes 21 to 28
  UINT32 indicative_shares;  // bytes 29 to 32
  UINT8 outside_tolerance;   // byte 33
  UINT8 includes_primary;    // byte 34
} AuctionUpdateMessage;

// Auction Summary Message
typedef struct _AuctionSummaryMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT8 symbol_long[8];  // bytes 4 to 11
  UINT8 auction_type;    // byte 12
  UINT64 price_long;     // bytes 13 to 20
  UINT32 shares_long;    // bytes 21 to 24
} AuctionSummaryMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x20: TimeMessage time_message;
    case 0x97: UnitClearMessage unit_clear_message;
    case 0x40: AddOrderLongMessage add_order_long_message;
    case 0x22: AddOrderShortMessage add_order_short_message;
    case 0x2F: AddOrderExpandedMessage add_order_expanded_message;
    case 0x23: OrderExecutedMessage order_executed_message;
    case 0x24: OrderExecutedAtPriceSizeMessage order_executed_at_price_size_message;
    case 0x25: ReduceSizeLongMessage reduce_size_long_message;
    case 0x26: ReduceSizeShortMessage reduce_size_short_message;
    case 0x27: ModifyOrderLongMessage modify_order_long_message;
    case 0x28: ModifyOrderShortMessage modify_order_short_message;
    case 0x29: DeleteOrderMessage delete_order_message;
    case 0x41: TradeLongMessage trade_long_message;
    case 0x2B: TradeShortMessage trade_short_message;
    case 0x32: TradeExtendedMessage trade_extended_message;
    case 0x35: TradeUnknownSymbolMessage trade_unknown_symbol_message;
    case 0x2D: EndOfSessionMessage end_of_session_message;
    case 0x31: TradingStatusMessage trading_status_message;
    case 0x34: StatisticsMessage statistics_message;
    case 0xAC: AuctionUpdateMessage auction_update_message;
    case 0x96: AuctionSummaryMessage auction_summary_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

