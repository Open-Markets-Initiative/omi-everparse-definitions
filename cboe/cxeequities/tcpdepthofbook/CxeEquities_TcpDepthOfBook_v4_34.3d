// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Frame, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out CxeEquities_TcpDepthOfBook_v4_34.3d
//
// What this definition reads more loosely than the model states:
// - the stream is a run of frames each ending at a byte 10: the caller splits it there and validates each frame, that byte included

// ---- Values ------------------------------------------------------------------

// Packet Type: one byte code
#define PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define PACKET_TYPE_LOGIN_REQUEST_PACKET 0x4C     // Login Request Packet
#define PACKET_TYPE_UNSEQUENCED_DATA_PACKET 0x55  // Unsequenced Data Packet
#define PACKET_TYPE_CLIENT_HEARTBEAT_PACKET 0x52  // Client Heartbeat Packet
#define PACKET_TYPE_LOGOUT_REQUEST_PACKET 0x4F    // Logout Request Packet

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_SYMBOL_CLEAR_MESSAGE 0x68              // Symbol Clear Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x4B                 // Add Order Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_MESSAGE_LONG_FORM 0x4D       // Add Order Message Long Form
#define SEQUENCED_MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x4E            // Order Executed Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE_LONG_FORM 0x67  // Order Executed Message Long Form
#define SEQUENCED_MESSAGE_TYPE_ORDER_CANCEL_MESSAGE 0x46              // Order Cancel Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_CANCEL_MESSAGE_LONG_FORM 0x47    // Order Cancel Message Long Form
#define SEQUENCED_MESSAGE_TYPE_TRADE_MESSAGE 0x56                     // Trade Message
#define SEQUENCED_MESSAGE_TYPE_TRADE_MESSAGE_LONG_FORM 0x57           // Trade Message Long Form
#define SEQUENCED_MESSAGE_TYPE_TRADE_MESSAGE_EXTENDED_FORM 0x76       // Trade Message Extended Form
#define SEQUENCED_MESSAGE_TYPE_TRADE_MESSAGE_UNKNOWN_SYMBOL 0x77      // Trade Message Unknown Symbol
#define SEQUENCED_MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x61            // Trading Status Message
#define SEQUENCED_MESSAGE_TYPE_STATISTICS_MESSAGE 0x59                // Statistics Message
#define SEQUENCED_MESSAGE_TYPE_AUCTION_UPDATE_MESSAGE 0x62            // Auction Update Message
#define SEQUENCED_MESSAGE_TYPE_AUCTION_SUMMARY_MESSAGE 0x66           // Auction Summary Message

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems.
typedef struct _DebugPacket {
  UINT8 text;  // byte 0
} DebugPacket;

// The Soup 2.0 server sends a Login Accepted Packet in response to receiving a valid Login Request from the client.
typedef struct _LoginAcceptedPacket {
  UINT8 session[10];          // bytes 0 to 9
  UINT8 sequence_number[10];  // bytes 10 to 19
} LoginAcceptedPacket;

// The Soup 2.0 server sends this packet in response to an invalid Login Request Packet from the client.
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// Instructs feed recipients to clear all orders for the Cboe book in the specified symbol; sent in recovery events such as a data centre fail-over.
typedef struct _SymbolClearMessage {
  UINT8 symbol_long[8];  // bytes 0 to 7
} SymbolClearMessage;

// Represents a newly accepted visible order on the Cboe book with a day-specific Order ID.
typedef struct _AddOrderMessage {
  UINT8 order_id[12];     // bytes 0 to 11
  UINT8 side_indicator;   // byte 12
  UINT8 shares_short[6];  // bytes 13 to 18
  UINT8 symbol_short[6];  // bytes 19 to 24
  UINT8 price_short[10];  // bytes 25 to 34
  UINT8 display;          // byte 35
} AddOrderMessage;

// Cboe European platform only. As Add Order Message but with longer Shares, Symbol and Price fields.
typedef struct _AddOrderMessageLongForm {
  UINT8 order_id[12];     // bytes 0 to 11
  UINT8 side_indicator;   // byte 12
  UINT8 shares_long[10];  // bytes 13 to 22
  UINT8 symbol_long[8];   // bytes 23 to 30
  UINT8 price_long[19];   // bytes 31 to 49
  UINT8 display;          // byte 50
} AddOrderMessageLongForm;

// Sent when a visible order on the Cboe book is executed in whole or in part at the original Add Order price.
typedef struct _OrderExecutedMessage {
  UINT8 order_id[12];              // bytes 0 to 11
  UINT8 executed_shares_short[6];  // bytes 12 to 17
  UINT8 execution_id[12];          // bytes 18 to 29
  UINT8 execution_flag[4];         // bytes 30 to 33
} OrderExecutedMessage;

// Cboe European platform only. As Order Executed Message but with a longer Executed Shares field.
typedef struct _OrderExecutedMessageLongForm {
  UINT8 order_id[12];              // bytes 0 to 11
  UINT8 executed_shares_long[10];  // bytes 12 to 21
  UINT8 execution_id[12];          // bytes 22 to 33
  UINT8 execution_flags[4];        // bytes 34 to 37
} OrderExecutedMessageLongForm;

// Sent when a visible order on the Cboe book is cancelled in whole or in part.
typedef struct _OrderCancelMessage {
  UINT8 order_id[12];               // bytes 0 to 11
  UINT8 cancelled_shares_short[6];  // bytes 12 to 17
} OrderCancelMessage;

// Cboe European platform only. As Order Cancel Message but with a longer Cancelled Shares field.
typedef struct _OrderCancelMessageLongForm {
  UINT8 order_id[12];               // bytes 0 to 11
  UINT8 cancelled_shares_long[10];  // bytes 12 to 21
} OrderCancelMessageLongForm;

// Provides information about executions of non-displayed orders/shares and negotiated trades. Does not alter the book.
typedef struct _TradeMessage {
  UINT8 order_id[12];      // bytes 0 to 11
  UINT8 side_indicator;    // byte 12
  UINT8 shares_short[6];   // bytes 13 to 18
  UINT8 symbol_short[6];   // bytes 19 to 24
  UINT8 price_short[10];   // bytes 25 to 34
  UINT8 execution_id[12];  // bytes 35 to 46
  UINT8 trade_flags[5];    // bytes 47 to 51
} TradeMessage;

// Cboe European platform only. As Trade Message but with longer Shares and Price fields.
typedef struct _TradeMessageLongForm {
  UINT8 order_id[12];      // bytes 0 to 11
  UINT8 side_indicator;    // byte 12
  UINT8 shares_long[10];   // bytes 13 to 22
  UINT8 symbol_long[8];    // bytes 23 to 30
  UINT8 price_long[19];    // bytes 31 to 49
  UINT8 execution_id[12];  // bytes 50 to 61
  UINT8 trade_flags[5];    // bytes 62 to 66
} TradeMessageLongForm;

// Cboe European platform only. Extended details of trades reported to or executed by Cboe (e.g. privately negotiated trades brought on-exchange).
typedef struct _TradeMessageExtendedForm {
  UINT8 shares_extended[12];       // bytes 0 to 11
  UINT8 symbol_long[8];            // bytes 12 to 19
  UINT8 price_long[19];            // bytes 20 to 38
  UINT8 trade_id[12];              // bytes 39 to 50
  UINT8 trade_date[8];             // bytes 51 to 58
  UINT8 trade_time[8];             // bytes 59 to 66
  UINT8 execution_venue[4];        // bytes 67 to 70
  UINT8 currency[3];               // bytes 71 to 73
  UINT8 cboe_trade_flags;          // byte 74
  UINT8 extended_trade_flags[14];  // bytes 75 to 88
} TradeMessageExtendedForm;

// Cboe European Trade Reporting Facility only. Trades reported to Cboe on a symbol not currently known, identified by ISIN and currency.
typedef struct _TradeMessageUnknownSymbol {
  UINT8 shares_extended[12];       // bytes 0 to 11
  UINT8 symbol_extended[12];       // bytes 12 to 23
  UINT8 price_long[19];            // bytes 24 to 42
  UINT8 trade_id[12];              // bytes 43 to 54
  UINT8 trade_date[8];             // bytes 55 to 62
  UINT8 trade_time[8];             // bytes 63 to 70
  UINT8 execution_venue[4];        // bytes 71 to 74
  UINT8 currency[3];               // bytes 75 to 77
  UINT8 cboe_trade_flags;          // byte 78
  UINT8 extended_trade_flags[14];  // bytes 79 to 92
} TradeMessageUnknownSymbol;

// Indicates the current trading status of a security; sent whenever the status changes and for all Suspended securities before trading hours.
typedef struct _TradingStatusMessage {
  UINT8 symbol_long[8];  // bytes 0 to 7
  UINT8 status;          // byte 8
  UINT8 reserved[3];     // bytes 9 to 11
} TradingStatusMessage;

// Cboe European platform only. Disseminates statistics prices: opening, closing, high, low, previous close.
typedef struct _StatisticsMessage {
  UINT8 symbol_long[8];       // bytes 0 to 7
  UINT8 price_long[19];       // bytes 8 to 26
  UINT8 statistic_type;       // byte 27
  UINT8 price_determination;  // byte 28
} StatisticsMessage;

// Disseminates indicative price and size information during auctions for Cboe auction-eligible securities.
typedef struct _AuctionUpdateMessage {
  UINT8 symbol_long[8];         // bytes 0 to 7
  UINT8 auction_type;           // byte 8
  UINT8 reference_price[19];    // bytes 9 to 27
  UINT8 indicative_price[19];   // bytes 28 to 46
  UINT8 indicative_shares[10];  // bytes 47 to 56
  UINT8 outside_tolerance;      // byte 57
  UINT8 includes_primary;       // byte 58
} AuctionUpdateMessage;

// Disseminates the results of an auction in a Cboe auction-eligible security.
typedef struct _AuctionSummaryMessage {
  UINT8 symbol_long[8];   // bytes 0 to 7
  UINT8 auction_type;     // byte 8
  UINT8 price_long[19];   // bytes 9 to 27
  UINT8 shares_long[10];  // bytes 28 to 37
} AuctionSummaryMessage;

// Branch
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x68: SymbolClearMessage symbol_clear_message;
    case 0x4B: AddOrderMessage add_order_message;
    case 0x4D: AddOrderMessageLongForm add_order_message_long_form;
    case 0x4E: OrderExecutedMessage order_executed_message;
    case 0x67: OrderExecutedMessageLongForm order_executed_message_long_form;
    case 0x46: OrderCancelMessage order_cancel_message;
    case 0x47: OrderCancelMessageLongForm order_cancel_message_long_form;
    case 0x56: TradeMessage trade_message;
    case 0x57: TradeMessageLongForm trade_message_long_form;
    case 0x76: TradeMessageExtendedForm trade_message_extended_form;
    case 0x77: TradeMessageUnknownSymbol trade_message_unknown_symbol;
    case 0x61: TradingStatusMessage trading_status_message;
    case 0x59: StatisticsMessage statistics_message;
    case 0x62: AuctionUpdateMessage auction_update_message;
    case 0x66: AuctionSummaryMessage auction_summary_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol.
typedef struct _SequencedDataPacket (UINT32 available) where (available >= 12) {
  UINT8 timestamp[11];                                                                                                             // bytes 0 to 10
  UINT8 sequenced_message_type;                                                                                                    // byte 11
  SequencedMessage(sequenced_message_type, (available - 12)) sequenced_message[:byte-size-single-element-array (available - 12)];
} SequencedDataPacket;

// The Soup 2.0 client must send a Login Request Packet immediately upon establishing a new TCP/IP socket connection to the server.
typedef struct _LoginRequestPacket {
  UINT8 username[6];                    // bytes 0 to 5
  UINT8 password[10];                   // bytes 6 to 15
  UINT8 requested_session[10];          // bytes 16 to 25
  UINT8 requested_sequence_number[10];  // bytes 26 to 35
} LoginRequestPacket;

// The Unsequenced Data Packets act as an envelope to carry the actual data messages that are transferred from the client to the server. These messages are not sequenced and may be lost in the event of a socket failure.
typedef struct _UnsequencedDataPacket (UINT32 available) where (available >= 1) {
  UINT8 unsequenced_message[(available - 1)];
} UnsequencedDataPacket;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(available) sequenced_data_packet;
    case 0x4C: LoginRequestPacket login_request_packet;
    case 0x55: UnsequencedDataPacket(available) unsequenced_data_packet;
    default: UINT8 unknown[available];
  }
} Payload;

// ---- Packet: Frame -----------------------------------------------------------

// Soup 2.0 Lf terminated record
entrypoint typedef struct _Frame (UINT32 available) where (available >= 2) {
  UINT8 packet_type;                                                                               // byte 0
  Payload(packet_type, (available - 2)) payload[:byte-size-single-element-array (available - 2)];
  UINT8 soup_lf { soup_lf == 10 };
} Frame;

