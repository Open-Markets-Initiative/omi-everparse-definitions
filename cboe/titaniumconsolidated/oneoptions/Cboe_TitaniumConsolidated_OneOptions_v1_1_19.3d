// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Cboe_TitaniumConsolidated_OneOptions_v1_1_19.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SHORT_SYMBOL_SUMMARY_MESSAGE 0xA4  // Short Symbol Summary Message
#define MESSAGE_TYPE_LONG_SYMBOL_SUMMARY_MESSAGE 0xA3   // Long Symbol Summary Message
#define MESSAGE_TYPE_BEST_QUOTE_UPDATE_MESSAGE 0xA5     // Best Quote Update Message
#define MESSAGE_TYPE_CBOE_MARKET_STATUS_MESSAGE 0xA6    // Cboe Market Status Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0xA9                 // Trade Message
#define MESSAGE_TYPE_TRADE_BREAK_MESSAGE 0xAA           // Trade Break Message
#define MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0xAB        // Trading Status Message

// Side Indicator: one byte code
#define SIDE_INDICATOR_BUY_SIDE 0x42   // Buy Side
#define SIDE_INDICATOR_SELL_SIDE 0x53  // Sell Side

// Market Center: one byte code
#define MARKET_CENTER_C_1 0x42   // C 1
#define MARKET_CENTER_C_2 0x57   // C 2
#define MARKET_CENTER_EDGX 0x58  // Edgx
#define MARKET_CENTER_BZX 0x5A   // Bzx

// Market Status: one byte code
#define MARKET_STATUS_NORMAL 0x4E                                // Normal
#define MARKET_STATUS_EXCLUDED_FROM_SYMBOL_SUMMARY_UPDATES 0x45  // Excluded From Symbol Summary Updates
#define MARKET_STATUS_INCOMPLETE 0x49                            // Incomplete

// Trade Condition: one byte code
#define TRADE_CONDITION_SINGLE_LEG_AUCTION_NON_ISO 0x61                                                        // Single Leg Auction Non Iso
#define TRADE_CONDITION_SINGLE_LEG_AUCTION_ISO 0x62                                                            // Single Leg Auction Iso
#define TRADE_CONDITION_SINGLE_LEG_CROSS_NON_ISO 0x63                                                          // Single Leg Cross Non Iso
#define TRADE_CONDITION_SINGLE_LEG_CROSS_ISO 0x64                                                              // Single Leg Cross Iso
#define TRADE_CONDITION_SINGLE_LEG_FLOOR_TRADE 0x65                                                            // Single Leg Floor Trade
#define TRADE_CONDITION_COMPLEX_TO_COMPLEX_ELECTRONIC_TRADE 0x66                                               // Complex To Complex Electronic Trade
#define TRADE_CONDITION_COMPLEX_AUCTION_TRADE 0x67                                                             // Complex Auction Trade
#define TRADE_CONDITION_COMPLEX_CROSS 0x68                                                                     // Complex Cross
#define TRADE_CONDITION_COMPLEX_FLOOR_TRADE 0x69                                                               // Complex Floor Trade
#define TRADE_CONDITION_COMPLEX_ELECTRONIC_TRADE_AGAINST_SINGLE_LEGS 0x6A                                      // Complex Electronic Trade Against Single Legs
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_OPTIONS_AUCTION_TRADE 0x6B                                          // Complex With Stock Options Auction Trade
#define TRADE_CONDITION_COMPLEX_FLOOR_TRADE_AGAINST_SINGLE_LEGS 0x6D                                           // Complex Floor Trade Against Single Legs
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_ELECTRONIC_TRADE 0x6E                                               // Complex With Stock Electronic Trade
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_CROSS 0x6F                                                          // Complex With Stock Cross
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_FLOOR_TRADE 0x70                                                    // Complex With Stock Floor Trade
#define TRADE_CONDITION_COMPLEX_FLOOR_TRADE_OF_PROPRIETARY_PRODUCTS_MARKED_AS_COMBO_ORDER 0x74                 // Complex Floor Trade Of Proprietary Products Marked As Combo Order
#define TRADE_CONDITION_MULTILATERAL_COMPRESSION_TRADE_OF_PROPRIETARY_PRODUCTS 0x75                            // Multilateral Compression Trade Of Proprietary Products
#define TRADE_CONDITION_EXTENDED_HOURS_TRADE 0x76                                                              // Extended Hours Trade
#define TRADE_CONDITION_ELECTRONIC_TRADE 0x49                                                                  // Electronic Trade
#define TRADE_CONDITION_CABINET_ORDER 0x4B                                                                     // Cabinet Order
#define TRADE_CONDITION_FUTURE_OPTIONS_AUCTION_TRADE_ELECTRONIC_EXECUTION_OF_A_MULTI_LEG_FUTUREOP_m4njii 0x4D  // Future Options Auction Trade Electronic Execution Of A Multi Leg Futureoptions Order Traded In A Two Sided Auction
#define TRADE_CONDITION_FUTURE_OPTIONS_AUTO_ELECTRONIC_TRADE_ELECTRONIC_EXECUTION_OF_A_MULTI_LEG__48mzmr 0x4E  // Future Options Auto Electronic Trade Electronic Execution Of A Multi Leg Futureoptions Order Traded On The Complex Book Or In A Coa
#define TRADE_CONDITION_OPENING_TRADE 0x4F                                                                     // Opening Trade
#define TRADE_CONDITION_FUTURE_OPTIONS_CROSS_ELECTRONIC_EXECUTION_OF_A_MULTI_LEG_FUTUREOPTIONS_OR_cxryqg 0x50  // Future Options Cross Electronic Execution Of A Multi Leg Futureoptions Order Traded In A Two Sided Crossing Mechanism That Does Not Go Through An Exposure Period
#define TRADE_CONDITION_ISO 0x53                                                                               // Iso

// Halt Status: one byte code
#define HALT_STATUS_HALTED 0x48            // Halted
#define HALT_STATUS_QUOTE_ONLY 0x51        // Quote Only
#define HALT_STATUS_OPENING_ROTATION 0x52  // Opening Rotation
#define HALT_STATUS_TRADING 0x54           // Trading

// ---- Types -------------------------------------------------------------------

// The Short Symbol Summary message delivers the Cboe consolidated best bid/offer and total executed volume across all applicable Cboe One Options books.
typedef struct _ShortSymbolSummaryMessage {
  UINT64 last_update_timestamp;                  // bytes 0 to 7
  UINT8 symbol[8];                               // bytes 8 to 15
  UINT32 cboe_cumulative_executed_volume_short;  // bytes 16 to 19
  UINT32 consolidated_best_bid_price_short;      // bytes 20 to 23
  UINT32 consolidated_best_bid_quantity_short;   // bytes 24 to 27
  UINT32 consolidated_best_ask_price_short;      // bytes 28 to 31
  UINT32 consolidated_best_ask_quantity_short;   // bytes 32 to 35
  UINT8 reserved_5[5];                           // bytes 36 to 40
} ShortSymbolSummaryMessage;

// The Long Symbol Summary message delivers the Cboe consolidated best bid/offer and total executed volume across all applicable Cboe One Options books.
typedef struct _LongSymbolSummaryMessage {
  UINT64 last_update_timestamp;                 // bytes 0 to 7
  UINT8 symbol[8];                              // bytes 8 to 15
  UINT64 cboe_cumulative_executed_volume_long;  // bytes 16 to 23
  UINT64 consolidated_best_bid_price_long;      // bytes 24 to 31
  UINT64 consolidated_best_bid_quantity_long;   // bytes 32 to 39
  UINT64 consolidated_best_ask_price_long;      // bytes 40 to 47
  UINT64 consolidated_best_ask_quantity_long;   // bytes 48 to 55
  UINT8 reserved_9[9];                          // bytes 56 to 64
} LongSymbolSummaryMessage;

// The Best Quote Update message is used to update one side of the Cboe consolidated quote information for a symbol. Since the message only updates one side of the quote, the previous value for the other side of the quote remains in effect. This message does not affect the executed volume of the symbol.
typedef struct _BestQuoteUpdateMessage {
  UINT64 last_update_timestamp;          // bytes 0 to 7
  UINT8 symbol[8];                       // bytes 8 to 15
  UINT8 side_indicator;                  // byte 16
  UINT64 consolidated_best_quote_price;  // bytes 17 to 24
  UINT64 consolidated_quote_quantity;    // bytes 25 to 32
} BestQuoteUpdateMessage;

// The Cboe Market Status message is disseminated to reflect a change in the status of a market. All markets should be assumed to be Normal unless otherwise indicated by a Cboe Market Status message.
typedef struct _CboeMarketStatusMessage {
  UINT64 timestamp;     // bytes 0 to 7
  UINT8 market_center;  // byte 8
  UINT8 market_status;  // byte 9
  UINT8 reserved_1;     // byte 10
} CboeMarketStatusMessage;

// Trade messages are sent when an order is executed in whole or in part on a Cboe exchange.
typedef struct _TradeMessage {
  UINT64 transaction_time;                      // bytes 0 to 7
  UINT8 symbol[8];                              // bytes 8 to 15
  UINT8 market_center;                          // byte 16
  UINT64 market_center_execution_id;            // bytes 17 to 24
  UINT64 last_price;                            // bytes 25 to 32
  UINT64 last_quantity;                         // bytes 33 to 40
  UINT64 cboe_cumulative_executed_volume_long;  // bytes 41 to 48
  UINT8 trade_condition;                        // byte 49
  UINT8 reserved_8[8];                          // bytes 50 to 57
} TradeMessage;

// The Trade Break message is sent whenever an execution on a Cboe exchange is broken. Trade breaks are rare and only affect applications that rely upon Cboe execution based data.
typedef struct _TradeBreakMessage {
  UINT64 transaction_time;                      // bytes 0 to 7
  UINT8 symbol[8];                              // bytes 8 to 15
  UINT8 market_center;                          // byte 16
  UINT64 market_center_execution_id;            // bytes 17 to 24
  UINT64 cboe_cumulative_executed_volume_long;  // bytes 25 to 32
  UINT8 reserved_9[9];                          // bytes 33 to 41
} TradeBreakMessage;

// The Trading Status message is used to indicate the current trading status of an options contract on a Cboe exchange.
typedef struct _TradingStatusMessage {
  UINT64 timestamp;     // bytes 0 to 7
  UINT8 symbol[8];      // bytes 8 to 15
  UINT8 market_center;  // byte 16
  UINT8 halt_status;    // byte 17
  UINT8 reserved_1;     // byte 18
} TradingStatusMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0xA4: ShortSymbolSummaryMessage short_symbol_summary_message;
    case 0xA3: LongSymbolSummaryMessage long_symbol_summary_message;
    case 0xA5: BestQuoteUpdateMessage best_quote_update_message;
    case 0xA6: CboeMarketStatusMessage cboe_market_status_message;
    case 0xA9: TradeMessage trade_message;
    case 0xAA: TradeBreakMessage trade_break_message;
    case 0xAB: TradingStatusMessage trading_status_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

