// One entry in a repeating Channels group. Repeats NoChannels times within the containing message.
typedef struct _ChannelsCounted (UINT32 count) {
  ChannelsPart128(((count & 128) != 0)) part128;
  ChannelsPart64(((count & 64) != 0)) part64;
  ChannelsPart32(((count & 32) != 0)) part32;
  ChannelsPart16(((count & 16) != 0)) part16;
  ChannelsPart8(((count & 8) != 0)) part8;
  ChannelsPart4(((count & 4) != 0)) part4;
  ChannelsPart2(((count & 2) != 0)) part2;
  ChannelsPart1(((count & 1) != 0)) part1;
} ChannelsCounted;

// Index Definition message published for every index within each cycle. Contains index information including current status, channel name, current trading date, data source, and description. Published on the Cboe Global Indices Definition Feed (CGIDF).
typedef struct _IndexDefinitionMessage {
  UINT32BE current_record_number;                    // bytes 0 to 3
  UINT32BE total_number_of_records;                  // bytes 4 to 7
  Symbol symbol;
  UINT8 description_length;
  UINT8 description[((UINT32) description_length)];
  Date date;
  UINT8 status;
  UINT8 agent_classification[2];
  UINT8 no_channels;
  ChannelsCounted(((UINT32) no_channels)) channels;
} IndexDefinitionMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x10: unit heartbeat_message;
    case 0x16: IndexValueMessage index_value_message;
    case 0x17: ContributorValueMessage contributor_value_message;
    case 0x18: IndexSummaryMessage index_summary_message;
    case 0x19: IndexValueWithStatusMessage index_value_with_status_message;
    case 0x1A: IndexDefinitionMessage index_definition_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Cgif Message containing message header and payload
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 8 };                                                                                                                 // bytes 0 to 1
  UINT8 template_i_d;                                                                                                                                              // byte 2
  UINT8 message_type;                                                                                                                                              // byte 3
  UINT32BE msg_seq_num;                                                                                                                                            // bytes 4 to 7
  Payload(template_i_d, (((UINT32) message_length) - 8)) payload[:byte-size-single-element-array (((UINT32) message_length) - 8)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Cgif Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT8 version;                                                                                                                 // byte 0
  UINT16BE length;                                                                                                               // bytes 1 to 2
  UINT64BE sending_time;                                                                                                         // bytes 3 to 10
  UINT8 number_of_messages;                                                                                                      // byte 11
  UINT32BE first_msg_seq_num;                                                                                                    // bytes 12 to 15
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 16)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_of_messages); };
} Packet;

