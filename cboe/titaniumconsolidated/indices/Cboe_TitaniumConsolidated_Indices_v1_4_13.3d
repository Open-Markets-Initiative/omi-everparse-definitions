// ---- Values ------------------------------------------------------------------

// Template ID: one byte code
#define TEMPLATE_I_D_HEARTBEAT_MESSAGE 0x10                // Heartbeat Message
#define TEMPLATE_I_D_INDEX_VALUE_MESSAGE 0x16              // Index Value Message
#define TEMPLATE_I_D_CONTRIBUTOR_VALUE_MESSAGE 0x17        // Contributor Value Message
#define TEMPLATE_I_D_INDEX_SUMMARY_MESSAGE 0x18            // Index Summary Message
#define TEMPLATE_I_D_INDEX_VALUE_WITH_STATUS_MESSAGE 0x19  // Index Value With Status Message
#define TEMPLATE_I_D_INDEX_DEFINITION_MESSAGE 0x1A         // Index Definition Message

// Message Type: one byte code
#define MESSAGE_TYPE_MARKET_DATA_INCREMENTAL_REFRESH 0x58  // Market Data Incremental Refresh
#define MESSAGE_TYPE_INDEX_DEFINITION 0x44                 // Index Definition
#define MESSAGE_TYPE_HEARTBEAT 0x30                        // Heartbeat

// Md Entry Type: one byte code
#define MD_ENTRY_TYPE_BID 0x30          // Bid
#define MD_ENTRY_TYPE_ASK 0x31          // Ask
#define MD_ENTRY_TYPE_INDEX_VALUE 0x33  // Index Value
#define MD_ENTRY_TYPE_CLOSE 0x35        // Close
#define MD_ENTRY_TYPE_SETTLEMENT 0x36   // Settlement

// Summary Type: one byte code
#define SUMMARY_TYPE_SOD 0x31  // Sod
#define SUMMARY_TYPE_EOD 0x32  // Eod

// Index Status: one byte code
#define INDEX_STATUS_NORMAL 0x4E      // Normal
#define INDEX_STATUS_INDICATIVE 0x49  // Indicative

// Status: one byte code
#define STATUS_ACTIVE 0x01    // Active
#define STATUS_INACTIVE 0x02  // Inactive
#define STATUS_DELETED 0x03   // Deleted

// ---- Types -------------------------------------------------------------------

// Symbol
typedef struct _Symbol {
  UINT8 symbol_length;                           // byte 0, signed, read here as unsigned
  UINT8 symbol_chars[((UINT32) symbol_length)];
} Symbol;

// MDEntryPx
typedef struct _MdEntryPx {
  UINT8 exponent;     // byte 0, signed, read here as unsigned
  UINT32BE mantissa;  // bytes 1 to 4, signed, read here as unsigned
} MdEntryPx;

// One entry in a repeating MDEntries group. Repeats NoMDEntries times within the containing message.
typedef struct _MdEntries {
  UINT8 md_entry_type;    // byte 0
  MdEntryPx md_entry_px;  // bytes 1 to 5
} MdEntries;

// Index Value message containing values associated with a calculated index. May include Index Value, Bid, and Ask MDEntries.
typedef struct _IndexValueMessage {
  Symbol symbol;
  UINT8 no_md_entries;
  MdEntries md_entries[:byte-size (((UINT32) no_md_entries) * 6)];
} IndexValueMessage;

// Contributor Value message containing values associated with a given symbol or index, transmitted when received by Cboe.
typedef struct _ContributorValueMessage {
  UINT64BE transact_time;                                           // bytes 0 to 7
  Symbol symbol;
  UINT8 no_md_entries;
  MdEntries md_entries[:byte-size (((UINT32) no_md_entries) * 6)];
} ContributorValueMessage;

// EffectiveBusinessDate
typedef struct _EffectiveBusinessDate {
  UINT8 byte_length;                       // byte 0, signed, read here as unsigned
  UINT8 effective_business_date_chars[8];  // bytes 1 to 8
} EffectiveBusinessDate;

// Index Summary message containing values associated with start or end of day. Includes an effective business date for reference.
typedef struct _IndexSummaryMessage {
  UINT64BE transact_time;                                           // bytes 0 to 7
  EffectiveBusinessDate effective_business_date;                    // bytes 8 to 16
  UINT8 summary_type;                                               // byte 17
  Symbol symbol;
  UINT8 no_md_entries;
  MdEntries md_entries[:byte-size (((UINT32) no_md_entries) * 6)];
} IndexSummaryMessage;

// Index Value With Status message contains the values associated with a calculated index along with a status describing whether the value is indicative or not. Valid entry types include close and settlement markers.
typedef struct _IndexValueWithStatusMessage {
  UINT8 index_status;                                               // byte 0
  Symbol symbol;
  UINT8 no_md_entries;
  MdEntries md_entries[:byte-size (((UINT32) no_md_entries) * 6)];
} IndexValueWithStatusMessage;

// Date
typedef struct _Date {
  UINT8 byte_length;     // byte 0, signed, read here as unsigned
  UINT8 date_chars[10];  // bytes 1 to 10
} Date;

// One entry in a repeating Channels group. Repeats NoChannels times within the containing message.
typedef struct _Channels {
