// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out C1Options_ComplexOptionsFutures_v1_0_0.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_TIME_MESSAGE 0x20                                           // Time Message
#define MESSAGE_TYPE_UNIT_CLEAR_MESSAGE 0x97                                     // Unit Clear Message
#define MESSAGE_TYPE_TRANSACTION_BEGIN_MESSAGE 0xBC                              // Transaction Begin Message
#define MESSAGE_TYPE_TRANSACTION_END_MESSAGE 0xBD                                // Transaction End Message
#define MESSAGE_TYPE_COMPLEX_OPTIONS_FUTURES_INSTRUMENT_DEFINITION_MESSAGE 0xFC  // Complex Options Futures Instrument Definition Message
#define MESSAGE_TYPE_SYMBOL_MAPPING_MESSAGE 0x2E                                 // Symbol Mapping Message
#define MESSAGE_TYPE_ADD_ORDER_LONG_MESSAGE 0x21                                 // Add Order Long Message
#define MESSAGE_TYPE_ADD_ORDER_SHORT_MESSAGE 0x22                                // Add Order Short Message
#define MESSAGE_TYPE_ADD_ORDER_EXPANDED_MESSAGE 0x2F                             // Add Order Expanded Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x23                                 // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_AT_PRICE_SIZE_MESSAGE 0x24                   // Order Executed At Price Size Message
#define MESSAGE_TYPE_REDUCE_SIZE_LONG_MESSAGE 0x25                               // Reduce Size Long Message
#define MESSAGE_TYPE_REDUCE_SIZE_SHORT_MESSAGE 0x26                              // Reduce Size Short Message
#define MESSAGE_TYPE_MODIFY_ORDER_LONG_MESSAGE 0x27                              // Modify Order Long Message
#define MESSAGE_TYPE_MODIFY_ORDER_SHORT_MESSAGE 0x28                             // Modify Order Short Message
#define MESSAGE_TYPE_DELETE_ORDER_MESSAGE 0x29                                   // Delete Order Message
#define MESSAGE_TYPE_TRADE_LONG_MESSAGE 0x2A                                     // Trade Long Message
#define MESSAGE_TYPE_TRADE_SHORT_MESSAGE 0x2B                                    // Trade Short Message
#define MESSAGE_TYPE_TRADE_FUTURES_OPTIONS_MESSAGE 0xFD                          // Trade Futures Options Message
#define MESSAGE_TYPE_AUCTION_NOTIFICATION_MESSAGE 0xAD                           // Auction Notification Message
#define MESSAGE_TYPE_AUCTION_CANCEL_MESSAGE 0xAE                                 // Auction Cancel Message
#define MESSAGE_TYPE_AUCTION_TRADE_MESSAGE 0xAF                                  // Auction Trade Message
#define MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x31                                 // Trading Status Message
#define MESSAGE_TYPE_OPTIONS_AUCTION_UPDATE_MESSAGE 0xD1                         // Options Auction Update Message
#define MESSAGE_TYPE_AUCTION_SUMMARY_MESSAGE 0x96                                // Auction Summary Message
#define MESSAGE_TYPE_END_OF_SESSION_MESSAGE 0x2D                                 // End Of Session Message

// Complex Instrument Type: one byte code
#define COMPLEX_INSTRUMENT_TYPE_ONE_LEG_IS_A_FUTURES_LEG 0x46  // One Leg Is A Futures Leg

// Leg Security Type: one byte code
#define LEG_SECURITY_TYPE_LEG_IS_AN_OPTION_INSTRUMENT 0x4F   // Leg Is An Option Instrument
#define LEG_SECURITY_TYPE_LEG_IS_AN_FUTURES_INSTRUMENT 0x46  // Leg Is An Futures Instrument

// Symbol Condition: one byte code
#define SYMBOL_CONDITION_NORMAL 0x4E        // Normal
#define SYMBOL_CONDITION_CLOSING_ONLY 0x43  // Closing Only

// Side Indicator: one byte code
#define SIDE_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define SIDE_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Customer Indicator: one byte code
#define CUSTOMER_INDICATOR_NON_CUSTOMER 0x4E  // Non Customer
#define CUSTOMER_INDICATOR_CUSTOMER 0x43      // Customer

// Trade Condition: one byte code
#define TRADE_CONDITION_FUTURE_OPTIONS_AUTO_ELECTRONIC_TRADE 0x4E  // Future Options Auto Electronic Trade
#define TRADE_CONDITION_FUTURE_OPTIONS_AUCTION_TRADE 0x4D          // Future Options Auction Trade
#define TRADE_CONDITION_FUTURE_OPTIONS_CROSS 0x50                  // Future Options Cross

// Auction Type: one byte code
#define AUCTION_TYPE_COMPLEX_AUCTION_COA 0x43  // Complex Auction Coa
#define AUCTION_TYPE_COMPLEX_AIM 0x42          // Complex Aim
#define AUCTION_TYPE_GTH_OPENING 0x47          // Gth Opening
#define AUCTION_TYPE_RTH_OPENING 0x4F          // Rth Opening
#define AUCTION_TYPE_HALT_RE_OPENING 0x48      // Halt Re Opening

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Trading Status: one byte code
#define TRADING_STATUS_HALTED 0x48        // Halted
#define TRADING_STATUS_CURB_TRADING 0x4C  // Curb Trading
#define TRADING_STATUS_QUOTE_ONLY 0x51    // Quote Only
#define TRADING_STATUS_RTH_TRADING 0x54   // Rth Trading

// Gth Trading Status: one byte code
#define GTH_TRADING_STATUS_HALTED 0x48      // Halted
#define GTH_TRADING_STATUS_QUOTE_ONLY 0x51  // Quote Only
#define GTH_TRADING_STATUS_TRADING 0x54     // Trading

// ---- Types -------------------------------------------------------------------

// A Time message is immediately generated and sent when there is a PITCH event for a given clock second. If there is no PITCH event for a given clock second, then no Time message is sent for that second. The Time field is the number of seconds relative to midnight Eastern Time. All subsequent time offset fields for the same unit will use the new Time value as the base until another Time message is received for the same unit. The Time message will also include the Epoch Time field, which is the current time represented as the number of whole seconds since the Epoch (midnight January 1, 1970). A given trading day may span multiple calendar days. Market data recipients must prepare for a crossing of the midnight ET boundary. At such time, a new Time Reference message will be sent and the Time field in subsequent Time messages will reset to reflect the number of seconds from the most recent midnight ET time.
typedef struct _TimeMessage {
  UINT32 time;        // bytes 0 to 3
  UINT32 epoch_time;  // bytes 4 to 7
} TimeMessage;

// The Unit Clear message instructs feed recipients to clear all orders for the Cboe complex book in the unit specified in the Sequenced Unit Header.
typedef struct _UnitClearMessage {
  UINT32 time_offset;  // bytes 0 to 3
} UnitClearMessage;

// The Transaction Begin message indicates any subsequent messages, up to the accompanying Transaction End message, are all part of the same transaction block. All PITCH messages corresponding to such an event would be included between a Transaction Begin and Transaction End. It is important to note that any PITCH Message Type may be included in a transaction block and there is no guarantee that the messages apply to the same price level or even the same Symbol. Transaction Begin messages do not alter the book and can be ignored if messages are being used solely to build a book. Feed processors can use a transaction block as a trigger to postpone publishing a quote update until the end of the transaction block.
typedef struct _TransactionBeginMessage {
  UINT32 time_offset;  // bytes 0 to 3
} TransactionBeginMessage;

// The Transaction End message indicates that a transaction indicated by a previous Transaction Begin message has completed. Transaction End messages do not alter the book and can be ignored if messages are being used solely to build a book.
typedef struct _TransactionEndMessage {
  UINT32 time_offset;  // bytes 0 to 3
} TransactionEndMessage;

// The following fields repeat Leg Count times for multi-leg strategies. Leg Index is zero-based.
typedef struct _ComplexLeg {
  UINT8 leg_symbol[6];      // bytes 0 to 5
  UINT32 leg_ratio;         // bytes 6 to 9, signed, read here as unsigned
  UINT8 leg_security_type;  // byte 10
} ComplexLeg;

// The following fields repeat Futures Leg Price Count times. Futures Price Leg Index is zero-based.
typedef struct _FuturesPriceLeg {
  UINT8 leg_index;           // byte 0
  UINT64 futures_leg_price;  // bytes 1 to 8, signed, read here as unsigned
} FuturesPriceLeg;

// A Complex Options Futures Instrument Definition message represents a complex instrument that is available to place orders. It is sent as a sequenced message the first time a Complex Options Futures Instrument Definition message is sent for a symbol. These messages will also be sent continuously through the day as an unsequenced message (sequence = 0) at variable rates as bandwidth allows. The Time offset field should be ignored on an unsequenced Complex Options Futures Instrument Definition message. The Complex Options Futures Instrument Definition message will contain two or more repeating groups of leg definitions. There is a limit of 16 leg definitions, one of which is a futures leg.
typedef struct _ComplexOptionsFuturesInstrumentDefinitionMessage {
  UINT32 time_offset;                                                                      // bytes 0 to 3
  UINT8 complex_instrument_id_short[6];                                                    // bytes 4 to 9
  UINT8 complex_instrument_underlying[8];                                                  // bytes 10 to 17
  UINT8 complex_instrument_type;                                                           // byte 18
  UINT8 reserved_3[3];                                                                     // bytes 19 to 21
  UINT8 leg_count;                                                                         // byte 22
  UINT8 futures_price_leg_count;                                                           // byte 23
  ComplexLeg complex_leg[:byte-size (((UINT32) futures_price_leg_count) * 11)];
  FuturesPriceLeg futures_price_leg[:byte-size (((UINT32) futures_price_leg_count) * 9)];
} ComplexOptionsFuturesInstrumentDefinitionMessage;

// A Symbol Mapping message is used to map the 6 character multicast feed symbol field to an OSI symbol and Underlying. These messages are not sequenced (sequence = 0) and are sent continuously through the day at variable rates as bandwidth allows.
typedef struct _SymbolMappingMessage {
  UINT8 feed_symbol[6];    // bytes 0 to 5
  UINT8 osi_symbol[21];    // bytes 6 to 26
  UINT8 symbol_condition;  // byte 27
  UINT8 underlying[8];     // bytes 28 to 35
} SymbolMappingMessage;

// An Add Order message represents a newly accepted visible order on the Cboe complex book. It includes a day-specific Order Id assigned by Cboe to the complex order.
typedef struct _AddOrderLongMessage {
  UINT32 time_offset;                    // bytes 0 to 3
  UINT64 order_id;                       // bytes 4 to 11
  UINT8 side_indicator;                  // byte 12
  UINT32 quantity_long;                  // bytes 13 to 16
  UINT8 complex_instrument_id_short[6];  // bytes 17 to 22
  UINT64 signed_price_long;              // bytes 23 to 30, signed, read here as unsigned
  UINT8 reserved_1;                      // byte 31
} AddOrderLongMessage;

// An Add Order message represents a newly accepted visible order on the Cboe complex book. It includes a day-specific Order Id assigned by Cboe to the complex order.
typedef struct _AddOrderShortMessage {
  UINT32 time_offset;                    // bytes 0 to 3
  UINT64 order_id;                       // bytes 4 to 11
  UINT8 side_indicator;                  // byte 12
  UINT16 quantity_short;                 // bytes 13 to 14
  UINT8 complex_instrument_id_short[6];  // bytes 15 to 20
  UINT16 signed_price_short;             // bytes 21 to 22, signed, read here as unsigned
  UINT8 reserved_1;                      // byte 23
} AddOrderShortMessage;

// An Add Order message represents a newly accepted visible order on the Cboe complex book. It includes a day-specific Order Id assigned by Cboe to the complex order.
typedef struct _AddOrderExpandedMessage {
  UINT32 time_offset;                   // bytes 0 to 3
  UINT64 order_id;                      // bytes 4 to 11
  UINT8 side_indicator;                 // byte 12
  UINT32 quantity_long;                 // bytes 13 to 16
  UINT8 complex_instrument_id_long[8];  // bytes 17 to 24
  UINT64 signed_price_long;             // bytes 25 to 32, signed, read here as unsigned
  UINT8 reserved_1;                     // byte 33
  UINT8 participant_id[4];              // bytes 34 to 37
  UINT8 customer_indicator;             // byte 38
  UINT8 client_id[4];                   // bytes 39 to 42
  UINT8 reserved_5[5];                  // bytes 43 to 47
} AddOrderExpandedMessage;

// Order Executed messages are sent when a visible complex order on the Cboe complex book is executed in whole or in part. The execution price equals the limit order price found in the original Add Order message or the limit order price in the latest Modify Order message referencing the Order Id. Note even if there are single leg to complex order executions, this feed will only contain the order execution for the complex order. Any single leg execution information is available on the standard PITCH feed.
typedef struct _OrderExecutedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT32 executed_quantity;  // bytes 12 to 15
  UINT64 execution_id;       // bytes 16 to 23
  UINT8 trade_condition;     // byte 24
} OrderExecutedMessage;

// Order Execution at Price/Size messages are sent when a complex order on the Cboe complex book is executed in whole or in part at a different price than the limit price on the original Add Order message or the limit order price in the latest Modify Order message referencing the Order Id. If the Remaining Quantity field contains a 0 the complex order should be completely removed from the complex book. Order Execution at Price/Size messages may also be sent in the event the existing size for Order Id is not equal to Executed Quantity + Remaining Quantity. In this case the complex order should be prioritized the same as a new complex order.
typedef struct _OrderExecutedAtPriceSizeMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT64 order_id;            // bytes 4 to 11
  UINT32 executed_quantity;   // bytes 12 to 15
  UINT32 remaining_quantity;  // bytes 16 to 19
  UINT64 execution_id;        // bytes 20 to 27
  UINT64 signed_price_long;   // bytes 28 to 35, signed, read here as unsigned
  UINT8 trade_condition;      // byte 36
} OrderExecutedAtPriceSizeMessage;

// Reduce Size messages are sent when a complex order on the Cboe complex book is partially reduced.
typedef struct _ReduceSizeLongMessage {
  UINT32 time_offset;             // bytes 0 to 3
  UINT64 order_id;                // bytes 4 to 11
  UINT32 canceled_quantity_long;  // bytes 12 to 15
} ReduceSizeLongMessage;

// Reduce Size messages are sent when a complex order on the Cboe complex book is partially reduced.
typedef struct _ReduceSizeShortMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT16 canceled_quantity_short;  // bytes 12 to 13
} ReduceSizeShortMessage;

// The Modify Order message is sent whenever an open complex order is visibly modified. The Order Id refers to the Order Id of the original Add Order message. Note that Modify Order messages that appear to be no ops (i.e. they do not appear to modify any relevant fields) will still lose priority.
typedef struct _ModifyOrderLongMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT32 quantity_long;      // bytes 12 to 15
  UINT64 signed_price_long;  // bytes 16 to 23, signed, read here as unsigned
  UINT8 reserved_1;          // byte 24
} ModifyOrderLongMessage;

// The Modify Order message is sent whenever an open complex order is visibly modified. The Order Id refers to the Order Id of the original Add Order message. Note that Modify Order messages that appear to be no ops (i.e. they do not appear to modify any relevant fields) will still lose priority.
typedef struct _ModifyOrderShortMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT64 order_id;            // bytes 4 to 11
  UINT16 quantity_short;      // bytes 12 to 13
  UINT16 signed_price_short;  // bytes 14 to 15, signed, read here as unsigned
  UINT8 reserved_1;           // byte 16
} ModifyOrderShortMessage;

// The Delete Order message is sent whenever a booked order is cancelled or leaves the order book. The Order Id refers to the Order Id of the original Add Order message. An order that is deleted from the book may return to the book later under certain circumstances. Therefore, a Delete Order message does not indicate that a given Order Id will not be sent again on a subsequent Add Order message.
typedef struct _DeleteOrderMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
} DeleteOrderMessage;

// The Trade message provides information about executions of complex order auctions on the Cboe complex book. A Trade message can also be sent when an auction executes against a non-displayed order, such as a contra response. Trade messages are necessary to calculate Cboe execution-based data. Trade messages do not alter the complex book and can be ignored if messages are being used solely to build a complex book. No Add Order message is sent for complex auction orders, and thus, no order modification messages may be sent when complex auctions are executed. Instead, a Trade message is sent whenever a complex auction is executed in whole or in part. A complete view of all Cboe complex executions can be built by combining all Order Executed messages and Trade messages.
typedef struct _TradeLongMessage {
  UINT32 time_offset;                    // bytes 0 to 3
  UINT64 order_id;                       // bytes 4 to 11
  UINT8 side_indicator;                  // byte 12
  UINT32 quantity_long;                  // bytes 13 to 16
  UINT8 complex_instrument_id_short[6];  // bytes 17 to 22
  UINT64 signed_price_long;              // bytes 23 to 30, signed, read here as unsigned
  UINT64 execution_id;                   // bytes 31 to 38
  UINT8 trade_condition;                 // byte 39
} TradeLongMessage;

// The Trade message provides information about executions of complex order auctions on the Cboe complex book. A Trade message can also be sent when an auction executes against a non-displayed order, such as a contra response. Trade messages are necessary to calculate Cboe execution-based data. Trade messages do not alter the complex book and can be ignored if messages are being used solely to build a complex book. No Add Order message is sent for complex auction orders, and thus, no order modification messages may be sent when complex auctions are executed. Instead, a Trade message is sent whenever a complex auction is executed in whole or in part. A complete view of all Cboe complex executions can be built by combining all Order Executed messages and Trade messages.
typedef struct _TradeShortMessage {
  UINT32 time_offset;                    // bytes 0 to 3
  UINT64 order_id;                       // bytes 4 to 11
  UINT8 side_indicator;                  // byte 12
  UINT16 quantity_short;                 // bytes 13 to 14
  UINT8 complex_instrument_id_short[6];  // bytes 15 to 20
  UINT16 signed_price_short;             // bytes 21 to 22, signed, read here as unsigned
  UINT64 execution_id;                   // bytes 23 to 30
  UINT8 trade_condition;                 // byte 31
} TradeShortMessage;

// The Trade message provides information about executions of complex order auctions on the Cboe complex book. A Trade message can also be sent when an auction executes against a non-displayed order, such as a contra response. Trade messages are necessary to calculate Cboe execution-based data. Trade messages do not alter the complex book and can be ignored if messages are being used solely to build a complex book. No Add Order message is sent for complex auction orders, and thus, no order modification messages may be sent when complex auctions are executed. Instead, a Trade message is sent whenever a complex auction is executed in whole or in part. A complete view of all Cboe complex executions can be built by combining all Order Executed messages and Trade messages.
typedef struct _TradeFuturesOptionsMessage {
  UINT32 time_offset;                    // bytes 0 to 3
  UINT64 order_id;                       // bytes 4 to 11
  UINT8 side_indicator;                  // byte 12
  UINT32 quantity_long;                  // bytes 13 to 16
  UINT8 complex_instrument_id_short[6];  // bytes 17 to 22
  UINT64 total_price;                    // bytes 23 to 30, signed, read here as unsigned
  UINT64 execution_id;                   // bytes 31 to 38
  UINT8 trade_condition;                 // byte 39
} TradeFuturesOptionsMessage;

// Auction Notification messages are used to disseminate order details of a complex auction. Auctions will be available for a defined period of time known as the exposure period.
typedef struct _AuctionNotificationMessage {
  UINT32 time_offset;                    // bytes 0 to 3
  UINT8 complex_instrument_id_short[6];  // bytes 4 to 9
  UINT64 auction_id;                     // bytes 10 to 17
  UINT8 auction_type;                    // byte 18
  UINT8 side;                            // byte 19
  UINT64 signed_price_long;              // bytes 20 to 27, signed, read here as unsigned
  UINT32 quantity_long;                  // bytes 28 to 31
  UINT8 customer_indicator;              // byte 32
  UINT8 participant_id[4];               // bytes 33 to 36
  UINT32 auction_end_offset;             // bytes 37 to 40
  UINT8 client_id[4];                    // bytes 41 to 44
} AuctionNotificationMessage;

// Auction Cancel messages are used to disseminate the cancellation of an earlier Auction Notification message as a result of a user cancellation of the original complex auction, a user modification request to change the complex auction price or increase the original complex auction quantity, a fading of the NBBO or to cancel any remaining complex auction quantity from the original Auction Notification following the complex auction termination. A user request to modify the complex auction price or to increase the original complex auction quantity will result in a cancellation of the complex auction followed by a new Auction Notification message. Auction Cancel messages will not be issued for complex auction quantity decrements.
typedef struct _AuctionCancelMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 auction_id;   // bytes 4 to 11
} AuctionCancelMessage;

// Auction Trade messages are used to disseminate executions resulting from a complex auction.
typedef struct _AuctionTradeMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 auction_id;         // bytes 4 to 11
  UINT64 execution_id;       // bytes 12 to 19
  UINT64 signed_price_long;  // bytes 20 to 27, signed, read here as unsigned
  UINT32 quantity_long;      // bytes 28 to 31
} AuctionTradeMessage;

// The Trading Status message is used to indicate the current trading status of a complex instrument. A Trading Status message will be sent whenever a complex instrument trading status changes. A Trading Status message will be sent for all complex instruments as they transition through various trading states. Starting at 7:30 a.m. ET, Cboe will send a Trading Status of Q once orders can be accepted for queuing in preparation for the RTH open. At or after 9:30 a.m. ET, Cboe will send a Trading Status of T as series are open for trading. Cboe will send a Trading Status of L as SPX or VIX series transition from RTH trading to Curb trading. A Trading Status message will also be sent: for a Regulatory Halt Q=Quotingperiod in any series where the underlying has experienced a Regulatory Halt as well as the T=Trading resumption for the same series. for instruments that are in a Q=Quoting period for auctions. The Trading Status field will be used to represent the status of the RTH (9:30 a.m. ET - 4:15 p.m. ET) and Curb sessions. The GTH Trading Status field will be used to represent the status of series that trade during the GTH session. The GTH session runs from 8:15 p.m. to 9:25 a.m. ET for SPX and VIX series.
typedef struct _TradingStatusMessage {
  UINT32 time_offset;          // bytes 0 to 3
  UINT8 complex_symbol_id[6];  // bytes 4 to 9
  UINT8 reserved_2[2];         // bytes 10 to 11
  UINT8 trading_status;        // byte 12
  UINT8 reserved_1;            // byte 13
  UINT8 gth_trading_status;    // byte 14
  UINT8 second_reserved_1;     // byte 15
} TradingStatusMessage;

// Options Auction Update messages are used to disseminate price and size information during the Opening and Re-Opening (halt) process for complex instruments. The Options Auction Update messages are sent every 5 seconds during an opening period. Refer to the Cboe Options Complex Book Process specification for more information.
typedef struct _OptionsAuctionUpdateMessage {
  UINT32 time_offset;                   // bytes 0 to 3
  UINT8 complex_instrument_id_long[8];  // bytes 4 to 11
  UINT8 auction_type;                   // byte 12
  UINT64 reference_price;               // bytes 13 to 20
  UINT32 buy_contracts;                 // bytes 21 to 24
  UINT32 sell_contracts;                // bytes 25 to 28
  UINT64 indicative_price;              // bytes 29 to 36, signed, read here as unsigned
  UINT64 auction_only_price;            // bytes 37 to 44, signed, read here as unsigned
  UINT8 opening_condition;              // byte 45
  UINT64 composite_market_bid_price;    // bytes 46 to 53, signed, read here as unsigned
  UINT64 composite_market_offer_price;  // bytes 54 to 61, signed, read here as unsigned
} OptionsAuctionUpdateMessage;

// Auction Summary messages are used to disseminate the results of an auction of a complex instrument. An Opening or Re-Opening Auction Summary message for each complex instrument is sent at the conclusion of its Opening or Re-Opening auction and represents Cboe opening price. Refer to the Cboe Options Complex Book Process specification for more information. The Auction Summary message has the following format:
typedef struct _AuctionSummaryMessage {
  UINT32 time_offset;                   // bytes 0 to 3
  UINT8 complex_instrument_id_long[8];  // bytes 4 to 11
  UINT8 auction_type;                   // byte 12
  UINT64 signed_price_long;             // bytes 13 to 20, signed, read here as unsigned
  UINT32 quantity_long;                 // bytes 21 to 24
} AuctionSummaryMessage;

// The End of Session message is sent for each unit when the unit shuts down. No more sequenced messages will be delivered for this unit, but heartbeats from the unit may be received.
typedef struct _EndOfSessionMessage {
  UINT32 time_offset;  // bytes 0 to 3
} EndOfSessionMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x20: TimeMessage time_message;
    case 0x97: UnitClearMessage unit_clear_message;
    case 0xBC: TransactionBeginMessage transaction_begin_message;
    case 0xBD: TransactionEndMessage transaction_end_message;
    case 0xFC: ComplexOptionsFuturesInstrumentDefinitionMessage complex_options_futures_instrument_definition_message;
    case 0x2E: SymbolMappingMessage symbol_mapping_message;
    case 0x21: AddOrderLongMessage add_order_long_message;
    case 0x22: AddOrderShortMessage add_order_short_message;
    case 0x2F: AddOrderExpandedMessage add_order_expanded_message;
    case 0x23: OrderExecutedMessage order_executed_message;
    case 0x24: OrderExecutedAtPriceSizeMessage order_executed_at_price_size_message;
    case 0x25: ReduceSizeLongMessage reduce_size_long_message;
    case 0x26: ReduceSizeShortMessage reduce_size_short_message;
    case 0x27: ModifyOrderLongMessage modify_order_long_message;
    case 0x28: ModifyOrderShortMessage modify_order_short_message;
    case 0x29: DeleteOrderMessage delete_order_message;
    case 0x2A: TradeLongMessage trade_long_message;
    case 0x2B: TradeShortMessage trade_short_message;
    case 0xFD: TradeFuturesOptionsMessage trade_futures_options_message;
    case 0xAD: AuctionNotificationMessage auction_notification_message;
    case 0xAE: AuctionCancelMessage auction_cancel_message;
    case 0xAF: AuctionTradeMessage auction_trade_message;
    case 0x31: TradingStatusMessage trading_status_message;
    case 0xD1: OptionsAuctionUpdateMessage options_auction_update_message;
    case 0x96: AuctionSummaryMessage auction_summary_message;
    case 0x2D: EndOfSessionMessage end_of_session_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

