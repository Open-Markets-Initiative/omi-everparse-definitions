// Chicago Board Options Exchange Auction Feed
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out C1Options_AuctionFeed_v1_1_1.3d
//
// What this definition does not state, and the model does:
// - the dispatch that chooses a message by its type
// - a run filling what frames it
//
// License: MIT No Attribution

// ---- Packet Header: 8 bytes --------------------------------------------------

entrypoint typedef struct _PacketHeader {
  UINT16 length;        // bytes 0 to 1
  UINT8 message_count;  // byte 2
  UINT8 unit_;          // byte 3
  UINT32 sequence;      // bytes 4 to 7
} PacketHeader;

// ---- Message Header: 2 bytes -------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT8 message_length;  // byte 0
  UINT8 message_type;    // byte 1
} MessageHeader;

// ---- Time Message: 4 bytes ---------------------------------------------------

// A Time message is sent whenever the source time for a unit passes over a second boundary.
entrypoint typedef struct _TimeMessage {
  UINT32 time;  // bytes 0 to 3
} TimeMessage;

// ---- Unit Clear Message: 4 bytes ---------------------------------------------

// The Unit Clear message instructs feed recipients to clear all orders for the Cboe book in the unit specified in the Sequenced Unit Header. This message will be sent at startup each day.
entrypoint typedef struct _UnitClearMessage {
  UINT32 time_offset;  // bytes 0 to 3
} UnitClearMessage;

// ---- Auction Notification Message: 45 bytes ----------------------------------

// Auction Notification messages are used to disseminate order details of an auction. Auctions will be available for a defined period of time known as the exposure period.
entrypoint typedef struct _AuctionNotificationMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 symbol[6];            // bytes 4 to 9
  UINT64 auction_id;          // bytes 10 to 17
  UINT8 auction_type;         // byte 18
  UINT8 side;                 // byte 19
  UINT64 price;               // bytes 20 to 27
  UINT32 contracts;           // bytes 28 to 31
  UINT8 customer_indicator;   // byte 32
  UINT8 participant_id[4];    // bytes 33 to 36
  UINT32 auction_end_offset;  // bytes 37 to 40
  UINT8 client_id[4];         // bytes 41 to 44
} AuctionNotificationMessage;

// ---- Auction Cancel Message: 12 bytes ----------------------------------------

// Auction Cancel messages are used to disseminate the cancellation of an earlier Auction Notification message as a result of a user cancelation of the original order, a user modification request to change the price or increase the original order quantity, or a fading of the NBBO.
entrypoint typedef struct _AuctionCancelMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 auction_id;   // bytes 4 to 11
} AuctionCancelMessage;

// ---- Auction Trade Message: 32 bytes -----------------------------------------

// Auction Cancel messages are used to disseminate the cancellation of an earlier Auction Notification message as a result of a user cancelation of the original order, a user modification request to change the price or increase the original order quantity, or a fading of the NBBO.
entrypoint typedef struct _AuctionTradeMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 auction_id;    // bytes 4 to 11
  UINT64 execution_id;  // bytes 12 to 19
  UINT64 price;         // bytes 20 to 27
  UINT32 contracts;     // bytes 28 to 31
} AuctionTradeMessage;

// ---- Auction Update Message: 46 bytes ----------------------------------------

// Options Auction Update messages are used to disseminate price and size information during the Opening and Re-Opening (halt) process. The Options Auction Update messages are sent every five seconds during an opening period.
entrypoint typedef struct _AuctionUpdateMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 symbol_extended[8];   // bytes 4 to 11
  UINT8 opening_type;         // byte 12
  UINT64 reference_price;     // bytes 13 to 20
  UINT32 buy_contracts;       // bytes 21 to 24
  UINT32 sell_contracts;      // bytes 25 to 28
  UINT64 indicative_price;    // bytes 29 to 36
  UINT64 auction_only_price;  // bytes 37 to 44
  UINT8 opening_condition;    // byte 45
} AuctionUpdateMessage;

// ---- Auction Summary Message: 25 bytes ---------------------------------------

// Auction Summary messages are used to disseminate the results of the Opening and Re-Opening process. An Opening or Re-Opening Auction Summary message for each symbol is sent at the conclusion of the Opening or Re-Opening process and represents the Cboe opening price.
entrypoint typedef struct _AuctionSummaryMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT8 symbol_extended[8];  // bytes 4 to 11
  UINT8 opening_type;        // byte 12
  UINT64 price;              // bytes 13 to 20
  UINT32 quantity;           // bytes 21 to 24
} AuctionSummaryMessage;

// ---- Width Update Message: 17 bytes ------------------------------------------

// The Width Update message is used to communicate opening quote width multiplier. This message will be sent at the beginning of the day for all underlyings and in the event that the exchange decides to change the quote width multiplier on a per underlying basis.
entrypoint typedef struct _WidthUpdateMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT8 underlying[8];  // bytes 4 to 11
  UINT8 width_type;     // byte 12
  UINT32 multiplier;    // bytes 13 to 16
} WidthUpdateMessage;

// ---- Symbol Mapping Message: 36 bytes ----------------------------------------

// A symbol mapping message is used to map the 6 character multicast feed symbol field to an OSI symbol.
entrypoint typedef struct _SymbolMappingMessage {
  UINT8 feed_symbol[6];    // bytes 0 to 5
  UINT8 osi_symbol[21];    // bytes 6 to 26
  UINT8 symbol_condition;  // byte 27
  UINT8 underlying[8];     // bytes 28 to 35
} SymbolMappingMessage;

// ---- End Of Session Message: 4 bytes -----------------------------------------

// The Width Update message is used to communicate opening quote width multiplier. This message will be sent at the beginning of the day for all underlyings and in the event that the exchange decides to change the quote width multiplier on a per underlying basis.
entrypoint typedef struct _EndOfSessionMessage {
  UINT32 time_offset;  // bytes 0 to 3
} EndOfSessionMessage;

