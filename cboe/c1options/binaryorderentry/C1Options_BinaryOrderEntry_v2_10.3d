  UINT16 custom_group_id;                                                          // bytes 44 to 45
  UINT8 capacity;                                                                  // byte 46
  UINT8 reserved_15[15];                                                           // bytes 47 to 61
  UINT64 send_time;                                                                // bytes 62 to 69
  UINT8 posting_instruction;                                                       // byte 70
  UINT8 session_eligibility;                                                       // byte 71
  UINT8 number_of_quote_updates;                                                   // byte 72
  QuoteUpdate quote_update[:byte-size (((UINT32) number_of_quote_updates) * 32)];
} QuoteUpdateMessage;

// Short Quote Update
typedef struct _ShortQuoteUpdate {
  UINT8 symbol_short[6];   // bytes 0 to 5
  UINT8 side;              // byte 6
  UINT8 open_close;        // byte 7
  UINT32 price_short;      // bytes 8 to 11, signed, read here as unsigned
  UINT16 order_qty_short;  // bytes 12 to 13
  UINT8 reserved_2[2];     // bytes 14 to 15
} ShortQuoteUpdate;

// A shorter version of Quote Update which restricts the information which can be presented.
typedef struct _ShortQuoteUpdateMessage {
  UINT8 quote_update_id[16];                                                                        // bytes 0 to 15
  UINT8 clearing_firm[4];                                                                           // bytes 16 to 19
  UINT8 clearing_account[4];                                                                        // bytes 20 to 23
  UINT16 custom_group_id;                                                                           // bytes 24 to 25
  UINT8 capacity;                                                                                   // byte 26
  UINT8 reserved_3[3];                                                                              // bytes 27 to 29
  UINT64 send_time;                                                                                 // bytes 30 to 37
  UINT8 posting_instruction;                                                                        // byte 38
  UINT8 session_eligibility;                                                                        // byte 39
  UINT8 number_of_short_quote_updates;                                                              // byte 40
  ShortQuoteUpdate short_quote_update[:byte-size (((UINT32) number_of_short_quote_updates) * 16)];
} ShortQuoteUpdateMessage;

