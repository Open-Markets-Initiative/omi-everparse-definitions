// TPHs having in-person Market Makers on the Cboe trading floor may optionally receive Floor Trade Notification messages.
typedef struct _FloorTradeNotificationMessage {
  UINT64 exec_id;                  // bytes 0 to 7
  UINT8 symbol_long[8];            // bytes 8 to 15
  UINT8 put_or_call;               // byte 16
  UINT64 strike_price;             // bytes 17 to 24, signed, read here as unsigned
  UINT32 maturity_date;            // bytes 25 to 28
  UINT32 order_qty_long;           // bytes 29 to 32
  UINT64 price_long;               // bytes 33 to 40, signed, read here as unsigned
  UINT8 side;                      // byte 41
  UINT8 contra_trader[4];          // bytes 42 to 45
  UINT8 floor_trader_acronym[3];   // bytes 46 to 48
  UINT64 trade_time;               // bytes 49 to 56
  UINT8 trade_through_alert_type;  // byte 57
  UINT8 price_type;                // byte 58
  UINT8 reserved_15[15];           // bytes 59 to 73
} FloorTradeNotificationMessage;

// The Add Floor Trade Rejected message is used to indicate that a requested Add Floor Trade has been rejected.
typedef struct _AddFloorTradeRejectedMessage {
  UINT8 cl_ord_id[20];               // bytes 0 to 19
  UINT8 symbol_long[8];              // bytes 20 to 27
  UINT8 put_or_call;                 // byte 28
  UINT64 strike_price;               // bytes 29 to 36, signed, read here as unsigned
  UINT32 maturity_date;              // bytes 37 to 40
  UINT8 multileg_reporting_type;     // byte 41
  UINT8 combo_order;                 // byte 42
  UINT8 account[16];                 // bytes 43 to 58
  UINT8 clearing_optional_data[16];  // bytes 59 to 74
  UINT8 clearing_account[4];         // bytes 75 to 78
  UINT32 cmta_number;                // bytes 79 to 82
  UINT8 floor_trader_acronym[3];     // bytes 83 to 85
  UINT8 side;                        // byte 86
  UINT32 order_qty_long;             // bytes 87 to 90
  UINT64 price_long;                 // bytes 91 to 98, signed, read here as unsigned
  UINT64 transaction_time;           // bytes 99 to 106
  UINT8 open_close;                  // byte 107
  UINT64 trade_time;                 // bytes 108 to 115
  UINT8 contra_trader[4];            // bytes 116 to 119
  UINT8 reserved_16[16];             // bytes 120 to 135
  UINT8 reject_text[60];             // bytes 136 to 195
} AddFloorTradeRejectedMessage;

// The Floor Trade Confirmation Rejected message is used to indicate that a requested Floor Trade Confirmation has been rejected.
typedef struct _FloorTradeConfirmationRejectedMessage {
  UINT8 cl_ord[20];         // bytes 0 to 19
  UINT64 exec_id;           // bytes 20 to 27
  UINT8 symbol_long[8];     // bytes 28 to 35
  UINT8 put_or_call;        // byte 36
  UINT64 strike_price;      // bytes 37 to 44, signed, read here as unsigned
  UINT32 maturity_date;     // bytes 45 to 48
  UINT64 transaction_time;  // bytes 49 to 56
  UINT8 price_type;         // byte 57
  UINT8 reserved_15[15];    // bytes 58 to 72
  UINT8 reject_text[60];    // bytes 73 to 132
} FloorTradeConfirmationRejectedMessage;

// The Delete Floor Trade Rejected message is used to indicate that a requested Delete Floor Trade has been rejected.
typedef struct _DeleteFloorTradeRejectedMessage {
  UINT8 cl_ord_id[20];    // bytes 0 to 19
  UINT64 exec_id;         // bytes 20 to 27
  UINT8 symbol_long[8];   // bytes 28 to 35
  UINT8 put_or_call;      // byte 36
  UINT64 strike_price;    // bytes 37 to 44, signed, read here as unsigned
  UINT32 maturity_date;   // bytes 45 to 48
  UINT8 side;             // byte 49
  UINT8 reserved_16[16];  // bytes 50 to 65
  UINT8 reject_text[60];  // bytes 66 to 125
} DeleteFloorTradeRejectedMessage;

