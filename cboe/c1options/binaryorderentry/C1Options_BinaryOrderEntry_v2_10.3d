// A New Complex Instrument message is used to request that the system create a complex strategy.
typedef struct _NewComplexInstrumentMessage {
  UINT8 cl_ord_id[20];                                                                                                                                                        // bytes 0 to 19
  UINT8 number_of_new_complex_instrument_bitfields;                                                                                                                           // byte 20
  OptionalNewComplexInstrumentBitfield1((number_of_new_complex_instrument_bitfields >= 0x01), number_of_new_complex_instrument_bitfields) new_complex_instrument_bitfield_1;
} NewComplexInstrumentMessage;

// TPHs having in-person Market Makers on the Cboe trading floor can enter their version of a floor trade via the Add Floor Trade message type.
typedef struct _AddFloorTradeMessage {
  UINT8 cl_ord_id[20];               // bytes 0 to 19
  UINT8 symbol_long[8];              // bytes 20 to 27
  UINT8 put_or_call;                 // byte 28
  UINT64 strike_price;               // bytes 29 to 36, signed, read here as unsigned
  UINT32 maturity_date;              // bytes 37 to 40
  UINT8 multileg_reporting_type;     // byte 41
  UINT8 combo_order;                 // byte 42
  UINT8 account[16];                 // bytes 43 to 58
  UINT8 clearing_optional_data[16];  // bytes 59 to 74
  UINT8 clearing_account[4];         // bytes 75 to 78
  UINT32 cmta_number;                // bytes 79 to 82
  UINT8 floor_trader_acronym[3];     // bytes 83 to 85
  UINT8 side;                        // byte 86
  UINT32 order_qty_long;             // bytes 87 to 90
  UINT64 price_long;                 // bytes 91 to 98, signed, read here as unsigned
  UINT64 transaction_time;           // bytes 99 to 106
  UINT8 open_close;                  // byte 107
  UINT64 trade_time;                 // bytes 108 to 115
  UINT8 contra_trader[4];            // bytes 116 to 119
  UINT8 reserved_16[16];             // bytes 120 to 135
} AddFloorTradeMessage;

// TPHs are encouraged to use Floor Trade Confirmation messages to respond to Floor Trade Notification messages if they agree with the terms of the trade. Alternatively, an Add Floor Trade message may be used to enter their version of the floor trade.
typedef struct _FloorTradeConfirmationMessage {
  UINT8 cl_ord_id[20];      // bytes 0 to 19
  UINT64 exec_id;           // bytes 20 to 27
  UINT8 symbol_long[8];     // bytes 28 to 35
  UINT8 put_or_call;        // byte 36
  UINT64 strike_price;      // bytes 37 to 44, signed, read here as unsigned
  UINT32 maturity_date;     // bytes 45 to 48
  UINT64 transaction_time;  // bytes 49 to 56
  UINT8 price_type;         // byte 57
  UINT8 reserved_15[15];    // bytes 58 to 72
} FloorTradeConfirmationMessage;

// TPHs having in-person Market Makers on the Cboe trading floor can request the deletion of their version of a floor trade via the Delete Floor Trade message type.
typedef struct _DeleteFloorTradeMessage {
  UINT8 cl_ord_id[20];    // bytes 0 to 19
  UINT64 exec_id;         // bytes 20 to 27
  UINT8 symbol_long[8];   // bytes 28 to 35
  UINT8 put_or_call;      // byte 36
  UINT64 strike_price;    // bytes 37 to 44, signed, read here as unsigned
  UINT32 maturity_date;   // bytes 45 to 48
  UINT8 side;             // byte 49
  UINT8 reserved_16[16];  // bytes 50 to 65
} DeleteFloorTradeMessage;

