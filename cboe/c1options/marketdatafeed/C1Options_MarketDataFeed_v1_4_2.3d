  UINT64BE sending_time;       // bytes 3 to 10
  UINT8 message_count;         // byte 11
  UINT32BE first_msg_seq_num;  // bytes 12 to 15
} PacketHeader;

// ---- Message Header: 8 bytes -------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;  // bytes 0 to 1
  UINT8 template_id;        // byte 2
  UINT8 message_type;       // byte 3
  UINT32BE msg_seq_num;     // bytes 4 to 7
} MessageHeader;

