#define MESSAGE_TYPE_TIME_REFERENCE_MESSAGE 0xB1                     // Time Reference Message
#define MESSAGE_TYPE_TIME_MESSAGE 0x20                               // Time Message
#define MESSAGE_TYPE_UNIT_CLEAR_MESSAGE 0x97                         // Unit Clear Message
#define MESSAGE_TYPE_SYMBOL_MAPPING_MESSAGE 0x2E                     // Symbol Mapping Message
#define MESSAGE_TYPE_SINGLE_SIDE_UPDATE_EXPANDED_SHORT_MESSAGE 0xD4  // Single Side Update Expanded Short Message
#define MESSAGE_TYPE_SINGLE_SIDE_UPDATE_EXPANDED_LONG_MESSAGE 0xD5   // Single Side Update Expanded Long Message
#define MESSAGE_TYPE_TWO_SIDE_UPDATE_EXPANDED_SHORT_MESSAGE 0xD6     // Two Side Update Expanded Short Message
#define MESSAGE_TYPE_TWO_SIDE_UPDATE_EXPANDED_LONG_MESSAGE 0xD7      // Two Side Update Expanded Long Message
#define MESSAGE_TYPE_TOP_TRADE_MESSAGE 0xB8                          // Top Trade Message
#define MESSAGE_TYPE_OPTIONS_AUCTION_UPDATE_MESSAGE 0xD1             // Options Auction Update Message
#define MESSAGE_TYPE_AUCTION_SUMMARY_MESSAGE 0x96                    // Auction Summary Message
#define MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x31                     // Trading Status Message
#define MESSAGE_TYPE_WIDTH_UPDATE_MESSAGE 0xD2                       // Width Update Message
#define MESSAGE_TYPE_END_OF_SESSION_MESSAGE 0x2D                     // End Of Session Message
#define MESSAGE_TYPE_SOQ_STRIKE_RANGE_UPDATE_MESSAGE 0x9D            // Soq Strike Range Update Message
#define MESSAGE_TYPE_CONSTITUENT_SYMBOL_MAPPING_MESSAGE 0x9E         // Constituent Symbol Mapping Message

// Symbol Condition: one byte code
#define SYMBOL_CONDITION_NORMAL 0x4E        // Normal
#define SYMBOL_CONDITION_CLOSING_ONLY 0x43  // Closing Only

// Side: one byte code
#define SIDE_BID_SIDE 0x42  // Bid Side
#define SIDE_ASK_SIDE 0x53  // Ask Side

// Trade Condition: one byte code
#define TRADE_CONDITION_SINGLE_LEG_AUCTION_NON_ISO_CBOE_AUCTION_TYPES_INCLUDE_AIM_SAM 0x61                     // Single Leg Auction Non Iso Cboe Auction Types Include Aim Sam
#define TRADE_CONDITION_SINGLE_LEG_AUCTION_ISO_CBOE_AUCTION_TYPES_INCLUDE_AIM_ISO_SAM_ISO 0x62                 // Single Leg Auction Iso Cboe Auction Types Include Aim Iso Sam Iso
#define TRADE_CONDITION_SINGLE_LEG_CROSS_NON_ISO_CBOE_AUCTION_TYPES_INCLUDE_CUST_TO_CUST_AIM_QCC 0x63          // Single Leg Cross Non Iso Cboe Auction Types Include Cust To Cust Aim Qcc
#define TRADE_CONDITION_SINGLE_LEG_CROSS_ISO_CBOE_ORDER_TYPE_IS_CUST_TO_CUST_AIM_ISO 0x64                      // Single Leg Cross Iso Cboe Order Type Is Cust To Cust Aim Iso
#define TRADE_CONDITION_SINGLE_LEG_FLOOR_TRADE 0x65                                                            // Single Leg Floor Trade
#define TRADE_CONDITION_COMPLEX_TO_COMPLEX_ELECTRONIC_TRADE_CBOE_AUCTION_TYPE_IS_COA 0x66                      // Complex To Complex Electronic Trade Cboe Auction Type Is Coa
#define TRADE_CONDITION_COMPLEX_AUCTION_TRADE_CBOE_ORDER_TYPES_INCLUDE_C_AIM_C_SAM 0x67                        // Complex Auction Trade Cboe Order Types Include C Aim C Sam
#define TRADE_CONDITION_COMPLEX_CROSS_CBOE_AUCTION_TYPES_INCLUDE_CUST_TO_CUST_C_AIM_C_QCC 0x68                 // Complex Cross Cboe Auction Types Include Cust To Cust C Aim C Qcc
#define TRADE_CONDITION_COMPLEX_FLOOR_TRADE_DEPRECATED_ALL_COMPLEX_FLOOR_EXECUTIONS_ARE_REPORTED__i9zw73 0x69  // Complex Floor Trade Deprecated All Complex Floor Executions Are Reported As Condition M
#define TRADE_CONDITION_COMPLEX_ELECTRONIC_TRADE_AGAINST_SINGLE_LEGS 0x6A                                      // Complex Electronic Trade Against Single Legs
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_OPTIONS_AUCTION_TRADE_CBOE_AUCTION_TYPES_INCLUDE_C_AIM_ecg6wg 0x6B  // Complex With Stock Options Auction Trade Cboe Auction Types Include C Aim W Stock C Sam W Stock
#define TRADE_CONDITION_COMPLEX_FLOOR_TRADE_AGAINST_SINGLE_LEGS_ALL_COMPLEX_FLOOR_EXECUTIONS_ARE__h40jog 0x6D  // Complex Floor Trade Against Single Legs All Complex Floor Executions Are Reported As Condition M
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_ELECTRONIC_TRADE_INCLUDES_COA_AUCTIONS_DONE_ELECTRONICALLY 0x6E     // Complex With Stock Electronic Trade Includes Coa Auctions Done Electronically
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_CROSS_CBOE_AUCTION_TYPES_INCLUDE_C_QCC_W_STOCK 0x6F                 // Complex With Stock Cross Cboe Auction Types Include C Qcc W Stock
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_FLOOR_TRADE 0x70                                                    // Complex With Stock Floor Trade
#define TRADE_CONDITION_COMPLEX_FLOOR_TRADE_OF_PROPRIETARY_PRODUCTS_MARKED_AS_COMBO_ORDER 0x74                 // Complex Floor Trade Of Proprietary Products Marked As Combo Order
#define TRADE_CONDITION_MULTILATERAL_COMPRESSION_TRADE_OF_PROPRIETARY_PRODUCTS 0x75                            // Multilateral Compression Trade Of Proprietary Products
#define TRADE_CONDITION_EXTENDED_HOURS_TRADE_TRANSACTION_REPRESENTS_A_TRADE_EXECUTED_DURING_THE_C_4upzov 0x76  // Extended Hours Trade Transaction Represents A Trade Executed During The Curb Session
#define TRADE_CONDITION_ELECTRONIC_TRADE 0x49                                                                  // Electronic Trade
#define TRADE_CONDITION_CABINET_ORDER 0x4B                                                                     // Cabinet Order
#define TRADE_CONDITION_FUTURE_OPTIONS_AUCTION_TRADE_ELECTRONIC_EXECUTION_OF_A_MULTI_LEG_FUTUREOP_m4njii 0x4D  // Future Options Auction Trade Electronic Execution Of A Multi Leg Futureoptions Order Traded In A Two Sided Auction
#define TRADE_CONDITION_FUTURE_OPTIONS_AUTO_ELECTRONIC_TRADE_ELECTRONIC_EXECUTION_OF_A_MULTI_LEG__qq9kps 0x4E  // Future Options Auto Electronic Trade Electronic Execution Of A Multi Leg Futureoptions Order Traded On The Complex Book Future Options Auto Electronic Trade Electronic Execution Of A Multi Leg Futureoptions Order Traded On The Complex Book Or In A Coa
#define TRADE_CONDITION_OPENING_TRADE 0x4F                                                                     // Opening Trade
#define TRADE_CONDITION_FUTURE_OPTIONS_CROSS_ELECTRONIC_EXECUTION_OF_A_MULTI_LEG_FUTUREOPTIONS_OR_cxryqg 0x50  // Future Options Cross Electronic Execution Of A Multi Leg Futureoptions Order Traded In A Two Sided Crossing Mechanism That Does Not Go Through An Exposure Period
#define TRADE_CONDITION_ISO 0x53                                                                               // Iso
#define TRADE_CONDITION_TRADE_BREAK 0x58                                                                       // Trade Break

// Auction Type: one byte code
#define AUCTION_TYPE_GTH_OPENING 0x47         // Gth Opening
#define AUCTION_TYPE_RTH_OPENING 0x4F         // Rth Opening
#define AUCTION_TYPE_HALT_RE_OPENING 0x48     // Halt Re Opening
#define AUCTION_TYPE_VOLATILITY_OPENING 0x56  // Volatility Opening

// Opening Condition: one byte code
#define OPENING_CONDITION_WOULD_OPEN 0x4F                // Would Open
#define OPENING_CONDITION_NEED_QUOTE_TO_OPEN 0x51        // Need Quote To Open
#define OPENING_CONDITION_NEED_MORE_BUYERS 0x42          // Need More Buyers
#define OPENING_CONDITION_NEED_MORE_SELLERS 0x53         // Need More Sellers
#define OPENING_CONDITION_CROSSED_COMPOSITE_MARKET 0x43  // Crossed Composite Market

// Trading Status: one byte code
#define TRADING_STATUS_HALTED 0x48            // Halted
#define TRADING_STATUS_CURB_TRADING 0x4C      // Curb Trading
#define TRADING_STATUS_QUOTE_ONLY 0x51        // Quote Only
#define TRADING_STATUS_OPENING_ROTATION 0x52  // Opening Rotation
#define TRADING_STATUS_RTH_TRADING 0x54       // Rth Trading

// Gth Trading Status: one byte code
#define GTH_TRADING_STATUS_HALTED 0x48            // Halted
#define GTH_TRADING_STATUS_QUOTE_ONLY 0x51        // Quote Only
#define GTH_TRADING_STATUS_OPENING_ROTATION 0x52  // Opening Rotation
#define GTH_TRADING_STATUS_TRADING 0x54           // Trading

// Width Type: one byte code
#define WIDTH_TYPE_MAX_QUOTE_WIDTH 0x51  // Max Quote Width
#define WIDTH_TYPE_REGULAR 0x52          // Regular
#define WIDTH_TYPE_VOLATILITY 0x56       // Volatility

// ---- Types -------------------------------------------------------------------

// C1 Options Only. The Time Reference message is used to provide a midnight reference point for recipients of the feed. It is sent whenever the system starts up and when the system crosses a midnight boundary. All subsequent Time messages for the same unit will use the last Midnight Reference until another Time Reference message is received for that unit. The Time Reference message includes the Trade Date, so most other sequenced messages will not include that information. Time Reference messages will be included in a spin response.
typedef struct _TimeReferenceMessage {
  UINT32 midnight_reference;  // bytes 0 to 3
  UINT32 time;                // bytes 4 to 7
  UINT32 time_offset;         // bytes 8 to 11
  UINT32 trade_date;          // bytes 12 to 15
} TimeReferenceMessage;

// A Time message is immediately generated and sent when there is a Top event for a given clock second. If there is no Top event for a given clock second, then no Time message is sent for that second. All subsequent time offset fields for the same unit will use the new Time value as the base until another Time message is received for the same unit. The Time field is the number of seconds relative to midnight Eastern Time, which is provided in the Time Reference message. On C1 only, the Time message will also include the Epoch Time field, which is the current time represented as the number of whole seconds since the Epoch (midnight January 1, 1970).
typedef struct _TimeMessage {
  UINT32 time;        // bytes 0 to 3
  UINT32 epoch_time;  // bytes 4 to 7
} TimeMessage;

// The Unit Clear message instructs feed recipients to clear all market snapshots for the book in the unit specified in the Sequenced Unit Header. This message will be sent at startup each day. It would also be distributed in certain recovery events such as a data center fail-over.
typedef struct _UnitClearMessage {
  UINT32 time_offset;  // bytes 0 to 3
} UnitClearMessage;

// A Symbol Mapping message is sent as an unsequenced message. One unsequenced Symbol Mapping message for each Symbol is sent in a continuous loop as bandwidth allows.
typedef struct _SymbolMappingMessage {
  UINT8 feed_symbol[6];    // bytes 0 to 5
  UINT8 osi_symbol[21];    // bytes 6 to 26
  UINT8 symbol_condition;  // byte 27
  UINT8 underlying[8];     // bytes 28 to 35
} SymbolMappingMessage;

// Single Side Update messages provide an updated price and size for a single side of a Symbol. The side is denoted by the Side field. One Single Side Update message may reflect one or more updates to the inside book that were processed at the same time, but will only be done so in a way that can be arbitrated between A/B feeds. The Single Side Update Expanded (Short) message is used whenever possible.
typedef struct _SingleSideUpdateExpandedShortMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT8 symbol[6];                 // bytes 4 to 9
  UINT8 side;                      // byte 10
  UINT8 reserved_low : 3;          // byte 11
  UINT8 aon : 1;                   // byte 11
  UINT8 customer : 1;              // byte 11
  UINT8 reserved_high : 3;         // byte 11
  UINT16 price_short;              // bytes 12 to 13
  UINT16 quantity_short;           // bytes 14 to 15
  UINT16 customer_quantity_short;  // bytes 16 to 17
} SingleSideUpdateExpandedShortMessage;

// Single Side Update Expanded (Long) message is used when the Price cannot be represented by a Binary Short Price or the Quantity cannot be represented by an unsigned 16-bit integer.
typedef struct _SingleSideUpdateExpandedLongMessage {
  UINT32 time_offset;             // bytes 0 to 3
  UINT8 symbol[6];                // bytes 4 to 9
  UINT8 side;                     // byte 10
  UINT8 reserved_low : 3;         // byte 11
  UINT8 aon : 1;                  // byte 11
  UINT8 customer : 1;             // byte 11
  UINT8 reserved_high : 3;        // byte 11
  UINT64 price_long;              // bytes 12 to 19
  UINT32 quantity_long;           // bytes 20 to 23
  UINT32 customer_quantity_long;  // bytes 24 to 27
} SingleSideUpdateExpandedLongMessage;

// Two Side Update messages provide an updated price and size for both sides of a Symbol. One Two Side Update message may reflect one or more updates to the inside book that were processed at the same time, but will only be done so in a way that can be arbitrated between A/B feeds. The Two Side Update Expanded (Short) message is used whenever possible.
typedef struct _TwoSideUpdateExpandedShortMessage {
  UINT32 time_offset;                  // bytes 0 to 3
  UINT8 symbol[6];                     // bytes 4 to 9
  UINT8 reserved_low : 3;              // byte 10
  UINT8 aon : 1;                       // byte 10
  UINT8 customer : 1;                  // byte 10
  UINT8 reserved_high : 3;             // byte 10
  UINT16 bid_price_short;              // bytes 11 to 12
  UINT16 bid_quantity_short;           // bytes 13 to 14
  UINT16 bid_customer_quantity_short;  // bytes 15 to 16
  UINT16 ask_price_short;              // bytes 17 to 18
  UINT16 ask_quantity_short;           // bytes 19 to 20
  UINT16 ask_customer_quantity_short;  // bytes 21 to 22
} TwoSideUpdateExpandedShortMessage;

// Two Side Update Expanded (Long) message is used when the Price cannot be represented by a Binary Short Price or the Quantity cannot be represented by an unsigned 16-bit integer.
typedef struct _TwoSideUpdateExpandedLongMessage {
  UINT32 time_offset;                 // bytes 0 to 3
  UINT8 symbol[6];                    // bytes 4 to 9
  UINT8 reserved_low : 3;             // byte 10
  UINT8 aon : 1;                      // byte 10
  UINT8 customer : 1;                 // byte 10
  UINT8 reserved_high : 3;            // byte 10
  UINT64 bid_price_long;              // bytes 11 to 18
  UINT32 bid_quantity_long;           // bytes 19 to 22
  UINT32 bid_customer_quantity_long;  // bytes 23 to 26
  UINT64 ask_price_long;              // bytes 27 to 34
  UINT32 ask_quantity_long;           // bytes 35 to 38
  UINT32 ask_customer_quantity_long;  // bytes 39 to 42
} TwoSideUpdateExpandedLongMessage;

// The Top Trade message provides information about executions of orders on the book. Top Trade messages are necessary to calculate execution-based data. Top Trade messages do not alter the book. One or more Single Side Update Expanded or Two Side Update Expanded messages will follow a Top Trade message to reflect the updated book. The Top Trade message sends the trade price, trade quantity, execution id, and trade condition of a trade as well as the cumulative volume for the trading session. The Trade Condition value of X (Trade Break) is sent whenever an execution is broken. Trade breaks will contain the Symbol, Quantity, Price, and Execution Id of the original trade.
typedef struct _TopTradeMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT8 symbol[6];        // bytes 4 to 9
  UINT32 quantity_long;   // bytes 10 to 13
  UINT64 price_long;      // bytes 14 to 21
  UINT64 execution_id;    // bytes 22 to 29
  UINT32 total_volume;    // bytes 30 to 33
  UINT8 trade_condition;  // byte 34
} TopTradeMessage;

// Options Auction Update messages are used to disseminate price and size information and Composite Market bid and offer prices during Opening and Re-Opening (halt) auctions. The Auction Update messages are sent every five seconds during an opening period.
typedef struct _OptionsAuctionUpdateMessage {
  UINT32 time_offset;                   // bytes 0 to 3
  UINT8 expanded_symbol[8];             // bytes 4 to 11
  UINT8 auction_type;                   // byte 12
  UINT64 reference_price;               // bytes 13 to 20
  UINT32 buy_contracts;                 // bytes 21 to 24
  UINT32 sell_contracts;                // bytes 25 to 28
  UINT64 indicative_price;              // bytes 29 to 36
  UINT64 auction_only_price;            // bytes 37 to 44
  UINT8 opening_condition;              // byte 45
  UINT64 composite_market_bid_price;    // bytes 46 to 53
  UINT64 composite_market_offer_price;  // bytes 54 to 61
} OptionsAuctionUpdateMessage;

// Auction Summary messages are used to disseminate the results of an auction. An Opening or Re-Opening Auction Summary message for each symbol is sent at the conclusion of its Opening or Re-Opening auction and represents the Cboe opening price.
typedef struct _AuctionSummaryMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT8 symbol_id[8];    // bytes 4 to 11
  UINT8 auction_type;    // byte 12
  UINT64 price_long;     // bytes 13 to 20
  UINT32 quantity_long;  // bytes 21 to 24
} AuctionSummaryMessage;

// The Trading Status message is used to indicate the current trading status of an options contract. A Trading Status message will be sent whenever a security's trading status changes. The Trading Status field will be used to represent the status of the RTH (9:30 a.m. ET - 4:15 p.m. ET) and Curb sessions. The GTH Trading Status field will be used to represent the status of series that trade during the GTH session. The GTH session runs from 8:15 p.m. to 9:25 a.m. ET for GTH-eligible Products (C1 only).
typedef struct _TradingStatusMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT8 symbol[6];           // bytes 4 to 9
  UINT8 reserved_2[2];       // bytes 10 to 11
  UINT8 trading_status;      // byte 12
  UINT8 reserved_1;          // byte 13
  UINT8 gth_trading_status;  // byte 14
  UINT8 second_reserved_1;   // byte 15
} TradingStatusMessage;

// The Width Update message is used to communicate the quote width multiplier for opening collars and for maximum quote width requirements. This message is sent whenever the exchange changes the multiplier intraday on a per-underlying basis.
typedef struct _WidthUpdateMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT8 underlying[8];  // bytes 4 to 11
  UINT8 width_type;     // byte 12
  UINT32 multiplier;    // bytes 13 to 16
} WidthUpdateMessage;

// The End of Session message is sent for each unit when the unit shuts down. No more sequenced messages will be delivered for this unit, but heartbeats from the unit may be received.
typedef struct _EndOfSessionMessage {
  UINT32 time_offset;  // bytes 0 to 3
} EndOfSessionMessage;

// C1 Options Only. The SOQ Strike Range Update message is only available on the C1 Exchange. This message disseminates the minimum and maximum strike prices of the price range used to calculate the Special Opening Quote (SOQ) on a Volatility Settlement date. In the event that multiple distinct SOQ calculations occur on the same day, the applicable SOQ is differentiated by the SOQ Identifier field, which is set to the CSMi symbol on which the final settlement SOQ value is disseminated.
typedef struct _SoqStrikeRangeUpdateMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 soq_identifier[20];   // bytes 4 to 23
  UINT64 lower_strike_price;  // bytes 24 to 31
  UINT64 upper_strike_price;  // bytes 32 to 39
} SoqStrikeRangeUpdateMessage;

// C1 Options Only. The Constituent Symbol Mapping message is used to communicate which options series (if any) are Constituent Series in a Volatility Settlement Special Opening Quote (SOQ). The message is identical to the Symbol Mapping message with the addition of the SOQ Identifier field, which is set to the CSMi symbol on which the final settlement SOQ value is disseminated. The Constituent Symbol Mapping message is sent as an unsequenced message with one message sent for each Constituent Series in a continuous loop as bandwidth allows.
typedef struct _ConstituentSymbolMappingMessage {
  UINT8 feed_symbol[6];      // bytes 0 to 5
  UINT8 osi_symbol[21];      // bytes 6 to 26
  UINT8 symbol_condition;    // byte 27
  UINT8 underlying[8];       // bytes 28 to 35
  UINT8 soq_identifier[20];  // bytes 36 to 55
} ConstituentSymbolMappingMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0xB1: TimeReferenceMessage time_reference_message;
    case 0x20: TimeMessage time_message;
    case 0x97: UnitClearMessage unit_clear_message;
    case 0x2E: SymbolMappingMessage symbol_mapping_message;
    case 0xD4: SingleSideUpdateExpandedShortMessage single_side_update_expanded_short_message;
    case 0xD5: SingleSideUpdateExpandedLongMessage single_side_update_expanded_long_message;
    case 0xD6: TwoSideUpdateExpandedShortMessage two_side_update_expanded_short_message;
    case 0xD7: TwoSideUpdateExpandedLongMessage two_side_update_expanded_long_message;
    case 0xB8: TopTradeMessage top_trade_message;
    case 0xD1: OptionsAuctionUpdateMessage options_auction_update_message;
    case 0x96: AuctionSummaryMessage auction_summary_message;
    case 0x31: TradingStatusMessage trading_status_message;
    case 0xD2: WidthUpdateMessage width_update_message;
    case 0x2D: EndOfSessionMessage end_of_session_message;
    case 0x9D: SoqStrikeRangeUpdateMessage soq_strike_range_update_message;
    case 0x9E: ConstituentSymbolMappingMessage constituent_symbol_mapping_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

