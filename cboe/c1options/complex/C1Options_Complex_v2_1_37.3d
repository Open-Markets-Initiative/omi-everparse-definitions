// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out C1Options_Complex_v2_1_37.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_TIME_REFERENCE_MESSAGE 0xB1                          // Time Reference Message
#define MESSAGE_TYPE_TIME_MESSAGE 0x20                                    // Time Message
#define MESSAGE_TYPE_UNIT_CLEAR_MESSAGE 0x97                              // Unit Clear Message
#define MESSAGE_TYPE_TRANSACTION_BEGIN 0xBC                               // Transaction Begin
#define MESSAGE_TYPE_TRANSACTION_END_MESSAGE 0xBD                         // Transaction End Message
#define MESSAGE_TYPE_COMPLEX_INSTRUMENT_DEFINITION_EXPANDED_MESSAGE 0x9A  // Complex Instrument Definition Expanded Message
#define MESSAGE_TYPE_SYMBOL_MAPPING_MESSAGE 0x2E                          // Symbol Mapping Message
#define MESSAGE_TYPE_ADD_ORDER_LONG_MESSAGE 0x21                          // Add Order Long Message
#define MESSAGE_TYPE_ADD_ORDER_SHORT_MESSAGE 0x22                         // Add Order Short Message
#define MESSAGE_TYPE_ADD_ORDER_EXPANDED_MESSAGE 0x2F                      // Add Order Expanded Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x23                          // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_AT_PRICE_SIZE_MESSAGE 0x24            // Order Executed At Price Size Message
#define MESSAGE_TYPE_REDUCE_SIZE_LONG_MESSAGE 0x25                        // Reduce Size Long Message
#define MESSAGE_TYPE_REDUCE_SIZE_SHORT_MESSAGE 0x26                       // Reduce Size Short Message
#define MESSAGE_TYPE_MODIFY_ORDER_LONG_MESSAGE 0x27                       // Modify Order Long Message
#define MESSAGE_TYPE_MODIFY_ORDER_SHORT_MESSAGE 0x28                      // Modify Order Short Message
#define MESSAGE_TYPE_DELETE_ORDER_MESSAGE 0x29                            // Delete Order Message
#define MESSAGE_TYPE_TRADE_LONG_MESSAGE 0x2A                              // Trade Long Message
#define MESSAGE_TYPE_TRADE_SHORT_MESSAGE 0x2B                             // Trade Short Message
#define MESSAGE_TYPE_AUCTION_NOTIFICATION_MESSAGE 0xAD                    // Auction Notification Message
#define MESSAGE_TYPE_AUCTION_CANCEL_MESSAGE 0xAE                          // Auction Cancel Message
#define MESSAGE_TYPE_AUCTION_TRADE_MESSAGE 0xAF                           // Auction Trade Message
#define MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x31                          // Trading Status Message
#define MESSAGE_TYPE_AUCTION_UPDATE_MESSAGE 0xD1                          // Auction Update Message
#define MESSAGE_TYPE_AUCTION_SUMMARY_MESSAGE 0x96                         // Auction Summary Message
#define MESSAGE_TYPE_END_OF_SESSION_MESSAGE 0x2D                          // End Of Session Message

// Leg Security Type: one byte code
#define LEG_SECURITY_TYPE_OPTION 0x4F  // Option
#define LEG_SECURITY_TYPE_EQUITY 0x45  // Equity

// Symbol Condition: one byte code
#define SYMBOL_CONDITION_NORMAL 0x4E        // Normal
#define SYMBOL_CONDITION_CLOSING_ONLY 0x43  // Closing Only

// Side Indicator: one byte code
#define SIDE_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define SIDE_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Customer Indicator: one byte code
#define CUSTOMER_INDICATOR_NON_CUSTOMER 0x4E  // Non Customer
#define CUSTOMER_INDICATOR_CUSTOMER 0x43      // Customer

// Trade Condition: one byte code
#define TRADE_CONDITION_COMPLEX_TO_COMPLEX_ELECTRONIC_TRADE 0x66       // Complex To Complex Electronic Trade
#define TRADE_CONDITION_COMPLEX_AUCTION_TRADE 0x67                     // Complex Auction Trade
#define TRADE_CONDITION_COMPLEX 0x68                                   // Complex
#define TRADE_CONDITION_COMPLEX_ELECTRONIC_TRADE_AGAINST_SINGLE 0x6A   // Complex Electronic Trade Against Single
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_OPTIONS_AUCTION_TRADE 0x6B  // Complex With Stock Options Auction Trade
#define TRADE_CONDITION_COMPLEX_FLOOR_TRADE_AGAINST_SINGLE_LEG 0x6D    // Complex Floor Trade Against Single Leg
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_ELECTRONIC_TRADE 0x6E       // Complex With Stock Electronic Trade
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_CROSS 0x6F                  // Complex With Stock Cross
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_FLOOR_TRADE 0x70            // Complex With Stock Floor Trade
#define TRADE_CONDITION_COMPLEX_COMBO_ORDER_FLOOR_TRADE 0x74           // Complex Combo Order Floor Trade
#define TRADE_CONDITION_EXTENDED_HOURS_TRADE 0x76                      // Extended Hours Trade
#define TRADE_CONDITION_ELECTRONIC_TRADE 0x49                          // Electronic Trade
#define TRADE_CONDITION_OPENING_TRADE 0x4F                             // Opening Trade

// Auction Type: one byte code
#define AUCTION_TYPE_COMPLEX_AUCTION 0x43               // Complex Auction
#define AUCTION_TYPE_COMPLEX_SOLICITATION_AUCTION 0x53  // Complex Solicitation Auction
#define AUCTION_TYPE_COMPLEX_AIM 0x42                   // Complex Aim
#define AUCTION_TYPE_COA_ALL_OR_NONE 0x4F               // Coa All Or None

// Trading Status: one byte code
#define TRADING_STATUS_HALTED 0x48        // Halted
#define TRADING_STATUS_CURB_TRADING 0x4C  // Curb Trading
#define TRADING_STATUS_QUOTE_ONLY 0x51    // Quote Only
#define TRADING_STATUS_RTH_TRADING 0x54   // Rth Trading

// Gth Trading Status: one byte code
#define GTH_TRADING_STATUS_HALTED 0x48      // Halted
#define GTH_TRADING_STATUS_QUOTE_ONLY 0x51  // Quote Only
#define GTH_TRADING_STATUS_TRADING 0x54     // Trading

// Auction Opening Type: one byte code
#define AUCTION_OPENING_TYPE_GTH 0x47             // Gth
#define AUCTION_OPENING_TYPE_RTH 0x4F             // Rth
#define AUCTION_OPENING_TYPE_HALT_REOPENING 0x48  // Halt Reopening

// ---- Types -------------------------------------------------------------------

// The Time Reference message is used to provide a midnight reference point for recipients of the feed. It is sent whenever the system starts up and when the system crosses a midnight boundary. All subsequent Time messages for the same unit will the use the last Midnight Reference until another Time Reference message is received for that unit. The Time Reference message includes the Trade Date, so most other sequenced messages will not include that information.
typedef struct _TimeReferenceMessage {
  UINT32 midnight_reference;  // bytes 0 to 3
  UINT32 time;                // bytes 4 to 7
  UINT32 time_offset;         // bytes 8 to 11
  UINT32 trade_date;          // bytes 12 to 15
} TimeReferenceMessage;

// A Time message is sent whenever the source time for a unit passes over a second boundary.
typedef struct _TimeMessage {
  UINT32 time;        // bytes 0 to 3
  UINT32 epoch_time;  // bytes 4 to 7
} TimeMessage;

// The Unit Clear message instructs feed recipients to clear all orders for the Cboe book in the unit specified in the Sequenced Unit Header. This message will be sent at startup each day.
typedef struct _UnitClearMessage {
  UINT32 time_offset;  // bytes 0 to 3
} UnitClearMessage;

// The Transaction Begin message indicates any subsequent messages, up to the accompanying Transaction End message, are all part of the same transaction block.
typedef struct _TransactionBegin {
  UINT32 time_offset;  // bytes 0 to 3
} TransactionBegin;

// The Transaction End message indicates that a transaction indicated by a previous Transaction Begin message has completed.
typedef struct _TransactionEndMessage {
  UINT32 time_offset;  // bytes 0 to 3
} TransactionEndMessage;

// Leg for multi-leg strategies
typedef struct _ComplexInstrumentLeg {
  UINT8 leg_symbol[8];      // bytes 0 to 7
  UINT32 leg_ratio;         // bytes 8 to 11, signed, read here as unsigned
  UINT8 leg_security_type;  // byte 12
} ComplexInstrumentLeg;

// A Complex Instrument Definition Expanded message represents a complex instrument that is available to place orders.
typedef struct _ComplexInstrumentDefinitionExpandedMessage {
  UINT32 time_offset;                                                                   // bytes 0 to 3
  UINT8 complex_instrument_id[6];                                                       // bytes 4 to 9
  UINT8 complex_instrument_underlying[8];                                               // bytes 10 to 17
  UINT8 complex_instrument_type[4];                                                     // bytes 18 to 21
  UINT8 leg_count;                                                                      // byte 22
  ComplexInstrumentLeg complex_instrument_leg[:byte-size (((UINT32) leg_count) * 13)];
} ComplexInstrumentDefinitionExpandedMessage;

// A Symbol Mapping message is used to map the 6 character multicast feed symbol field to an OSI symbol and Underlying.
typedef struct _SymbolMappingMessage {
  UINT8 feed_symbol[6];    // bytes 0 to 5
  UINT8 osi_symbol[21];    // bytes 6 to 26
  UINT8 symbol_condition;  // byte 27
  UINT8 underlying[8];     // bytes 28 to 35
} SymbolMappingMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book.
typedef struct _AddOrderLongMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT8 side_indicator;            // byte 12
  UINT32 quantity;                 // bytes 13 to 16
  UINT8 complex_instrument_id[6];  // bytes 17 to 22
  UINT64 price;                    // bytes 23 to 30, signed, read here as unsigned
  UINT8 padding;                   // byte 31
} AddOrderLongMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book.
typedef struct _AddOrderShortMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT8 side_indicator;            // byte 12
  UINT16 quantity_short;           // bytes 13 to 14
  UINT8 complex_instrument_id[6];  // bytes 15 to 20
  UINT16 price_short;              // bytes 21 to 22, signed, read here as unsigned
  UINT8 padding;                   // byte 23
} AddOrderShortMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book. Expanded version accommodates larger symbol sizes possible through the ISRA plan.
typedef struct _AddOrderExpandedMessage {
  UINT32 time_offset;                // bytes 0 to 3
  UINT64 order_id;                   // bytes 4 to 11
  UINT8 side_indicator;              // byte 12
  UINT32 quantity;                   // bytes 13 to 16
  UINT8 complex_instrument_id_8[8];  // bytes 17 to 24
  UINT64 price;                      // bytes 25 to 32, signed, read here as unsigned
  UINT8 reserved_1;                  // byte 33
  UINT8 participant_id[4];           // bytes 34 to 37
  UINT8 customer_indicator;          // byte 38
  UINT8 client_id[4];                // bytes 39 to 42
} AddOrderExpandedMessage;

// Order Executed messages are sent when a visible order on the Cboe book is executed in whole or in part.
typedef struct _OrderExecutedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT32 executed_quantity;  // bytes 12 to 15
  UINT64 execution_id;       // bytes 16 to 23
  UINT8 trade_condition;     // byte 24
} OrderExecutedMessage;

// Order Executed at Price/Size messages are sent when a visible order on the Cboe book is executed in whole or in part at a different price than the limit price on the original Add Order message or the limit order price in the latest Modify Order message referencing the Order Id.
typedef struct _OrderExecutedAtPriceSizeMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT64 order_id;            // bytes 4 to 11
  UINT32 executed_quantity;   // bytes 12 to 15
  UINT32 remaining_quantity;  // bytes 16 to 19
  UINT64 execution_id;        // bytes 20 to 27
  UINT64 price;               // bytes 28 to 35, signed, read here as unsigned
  UINT8 trade_condition;      // byte 36
} OrderExecutedAtPriceSizeMessage;

// Reduce Size messages are sent when a visible order on the Cboe book is partially reduced.
typedef struct _ReduceSizeLongMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT32 canceled_quantity;  // bytes 12 to 15
} ReduceSizeLongMessage;

// Reduce Size messages are sent when a visible order on the Cboe book is partially reduced.
typedef struct _ReduceSizeShortMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT16 canceled_quantity_short;  // bytes 12 to 13
} ReduceSizeShortMessage;

// The Modify Order message is sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message.
typedef struct _ModifyOrderLongMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
  UINT32 quantity;     // bytes 12 to 15
  UINT64 price;        // bytes 16 to 23, signed, read here as unsigned
  UINT8 padding;       // byte 24
} ModifyOrderLongMessage;

// The Modify Order message is sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message.
typedef struct _ModifyOrderShortMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT16 quantity_short;  // bytes 12 to 13
  UINT16 price_short;     // bytes 14 to 15, signed, read here as unsigned
  UINT8 padding;          // byte 16
} ModifyOrderShortMessage;

// The Delete Order message is sent whenever an open order is completely canceled. The Order Id refers to the Order Id of the original Add Order message.
typedef struct _DeleteOrderMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
} DeleteOrderMessage;

// The Trade message provides information about executions of complex order auctions on the Cboe complex book.
typedef struct _TradeLongMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT8 side_indicator;            // byte 12
  UINT32 quantity;                 // bytes 13 to 16
  UINT8 complex_instrument_id[6];  // bytes 17 to 22
  UINT64 price;                    // bytes 23 to 30, signed, read here as unsigned
  UINT64 execution_id;             // bytes 31 to 38
  UINT8 trade_condition;           // byte 39
} TradeLongMessage;

// The Trade message provides information about executions of non-displayed orders on the Cboe book and routed executions to other trading centers.
typedef struct _TradeShortMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT8 side_indicator;            // byte 12
  UINT16 quantity_short;           // bytes 13 to 14
  UINT8 complex_instrument_id[6];  // bytes 15 to 20
  UINT16 price_short;              // bytes 21 to 22, signed, read here as unsigned
  UINT64 execution_id;             // bytes 23 to 30
  UINT8 trade_condition;           // byte 31
} TradeShortMessage;

// Auction Notification messages are used to disseminate order details of a complex auction.
typedef struct _AuctionNotificationMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT8 complex_instrument_id[6];  // bytes 4 to 9
  UINT64 auction_id;               // bytes 10 to 17
  UINT8 auction_type;              // byte 18
  UINT8 side_indicator;            // byte 19
  UINT64 price;                    // bytes 20 to 27, signed, read here as unsigned
  UINT32 quantity;                 // bytes 28 to 31
  UINT8 customer_indicator;        // byte 32
  UINT8 participant_id[4];         // bytes 33 to 36
  UINT32 auction_end_offset;       // bytes 37 to 40
  UINT8 client_id[4];              // bytes 41 to 44
} AuctionNotificationMessage;

// Auction Cancel messages are used to disseminate the cancelation of an earlier Auction Notification message as a result of a user cancelation of the original complex auction, a user modification request to change the complex auction price or increase the original complex auction quantity, a fading of the NBBO or to cancel any remaining complex auction quantity from the original Auction Notification following the complex auction termination.
typedef struct _AuctionCancelMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 auction_id;   // bytes 4 to 11
} AuctionCancelMessage;

// Auction Trade messages are used to disseminate executions resulting from a complex auction.
typedef struct _AuctionTradeMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 auction_id;    // bytes 4 to 11
  UINT64 execution_id;  // bytes 12 to 19
  UINT64 price;         // bytes 20 to 27, signed, read here as unsigned
  UINT32 quantity;      // bytes 28 to 31
} AuctionTradeMessage;

// The Trading Status message is used to indicate the current trading status of a complex instrument.
typedef struct _TradingStatusMessage {
  UINT32 time_offset;          // bytes 0 to 3
  UINT8 complex_symbol_id[6];  // bytes 4 to 9
  UINT8 unused[2];             // bytes 10 to 11
  UINT8 trading_status;        // byte 12
  UINT8 reserved_1;            // byte 13
  UINT8 gth_trading_status;    // byte 14
  UINT8 padding;               // byte 15
} TradingStatusMessage;

// Options Auction Update messages are used to disseminate price and size information during the Opening and Re-Opening (halt) process for complex instruments.
typedef struct _AuctionUpdateMessage {
  UINT32 time_offset;                   // bytes 0 to 3
  UINT8 complex_instrument_id_8[8];     // bytes 4 to 11
  UINT8 auction_opening_type;           // byte 12
  UINT64 reference_price;               // bytes 13 to 20, signed, read here as unsigned
  UINT32 buy_contracts;                 // bytes 21 to 24
  UINT32 sell_contracts;                // bytes 25 to 28
  UINT64 indicative_price;              // bytes 29 to 36, signed, read here as unsigned
  UINT64 auction_only_price;            // bytes 37 to 44, signed, read here as unsigned
  UINT8 opening_condition;              // byte 45
  UINT64 composite_market_bid_price;    // bytes 46 to 53, signed, read here as unsigned
  UINT64 composite_market_offer_price;  // bytes 54 to 61, signed, read here as unsigned
} AuctionUpdateMessage;

// Auction Summary messages are used to disseminate the results of an auction of a complex instrument. An Opening or Re-Opening Auction Summary message for each complex instrument is sent at the conclusion of its Opening or Re-Opening auction and represents Cboe opening price.
typedef struct _AuctionSummaryMessage {
  UINT32 time_offset;                // bytes 0 to 3
  UINT8 complex_instrument_id_8[8];  // bytes 4 to 11
  UINT8 auction_opening_type;        // byte 12
  UINT64 price;                      // bytes 13 to 20, signed, read here as unsigned
  UINT32 quantity;                   // bytes 21 to 24
} AuctionSummaryMessage;

// The End of Session message is sent for each unit when the unit shuts down. No more sequenced messages will be delivered for this unit, but heartbeats from the unit may be received.
typedef struct _EndOfSessionMessage {
  UINT32 time_offset;  // bytes 0 to 3
} EndOfSessionMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0xB1: TimeReferenceMessage time_reference_message;
    case 0x20: TimeMessage time_message;
    case 0x97: UnitClearMessage unit_clear_message;
    case 0xBC: TransactionBegin transaction_begin;
    case 0xBD: TransactionEndMessage transaction_end_message;
    case 0x9A: ComplexInstrumentDefinitionExpandedMessage complex_instrument_definition_expanded_message;
    case 0x2E: SymbolMappingMessage symbol_mapping_message;
    case 0x21: AddOrderLongMessage add_order_long_message;
    case 0x22: AddOrderShortMessage add_order_short_message;
    case 0x2F: AddOrderExpandedMessage add_order_expanded_message;
    case 0x23: OrderExecutedMessage order_executed_message;
    case 0x24: OrderExecutedAtPriceSizeMessage order_executed_at_price_size_message;
    case 0x25: ReduceSizeLongMessage reduce_size_long_message;
    case 0x26: ReduceSizeShortMessage reduce_size_short_message;
    case 0x27: ModifyOrderLongMessage modify_order_long_message;
    case 0x28: ModifyOrderShortMessage modify_order_short_message;
    case 0x29: DeleteOrderMessage delete_order_message;
    case 0x2A: TradeLongMessage trade_long_message;
    case 0x2B: TradeShortMessage trade_short_message;
    case 0xAD: AuctionNotificationMessage auction_notification_message;
    case 0xAE: AuctionCancelMessage auction_cancel_message;
    case 0xAF: AuctionTradeMessage auction_trade_message;
    case 0x31: TradingStatusMessage trading_status_message;
    case 0xD1: AuctionUpdateMessage auction_update_message;
    case 0x96: AuctionSummaryMessage auction_summary_message;
    case 0x2D: EndOfSessionMessage end_of_session_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

