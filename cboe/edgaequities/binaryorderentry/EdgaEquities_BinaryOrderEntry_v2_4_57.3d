  UINT8 order_acknowledgment_return_bitfield_1_min_qty : 1;         // byte 0
  UINT8 order_acknowledgment_return_bitfield_1_reserved_128 : 1;    // byte 0
} OrderAcknowledgmentReturnBitfield1;

// BitSet OrderAcknowledgment byte 1.
casetype _OptionalOrderAcknowledgmentReturnBitfield1 (Bool present) {
  switch (present) {
    case true: OrderAcknowledgmentReturnBitfield1 order_acknowledgment_return_bitfield_1;
    case false: unit absent;
  }
} OptionalOrderAcknowledgmentReturnBitfield1;

