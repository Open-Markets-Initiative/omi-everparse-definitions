#define CANCEL_REASON_MAX_OPEN_ORDERS_COUNT_EXCEEDED 0x6F               // Max Open Orders Count Exceeded
#define CANCEL_REASON_RESERVE_RELOAD 0x72                               // Reserve Reload
#define CANCEL_REASON_RISK_MANAGEMENT_SYMBOL_LEVEL 0x73                 // Risk Management Symbol Level
#define CANCEL_REASON_LIMIT_UP_LIMIT_DOWN 0x75                          // Limit Up Limit Down
#define CANCEL_REASON_WOULD_REMOVE_ON_UNSLIDE 0x77                      // Would Remove On Unslide
#define CANCEL_REASON_CROSSED_MARKET 0x78                               // Crossed Market
#define CANCEL_REASON_ORDER_RECEIVED_BY_CBOE_DURING_REPLAY 0x79         // Order Received By Cboe During Replay

// Cancel Reject Reason: one byte code
#define CANCEL_REJECT_REASON_ADMIN 0x41                                        // Admin
#define CANCEL_REJECT_REASON_CAPACITY_UNDEFINED 0x43                           // Capacity Undefined
#define CANCEL_REJECT_REASON_DUPLICATE_IDENTIFIER 0x44                         // Duplicate Identifier
#define CANCEL_REJECT_REASON_SIZE_REDUCTION_DUE_TO_SWP_RESTATEMENT 0x45        // Size Reduction Due To Swp Restatement
#define CANCEL_REJECT_REASON_FAILED_TO_QUOTE 0x46                              // Failed To Quote
#define CANCEL_REJECT_REASON_HALTED 0x48                                       // Halted
#define CANCEL_REJECT_REASON_INCORRECT_DATA_CENTER 0x49                        // Incorrect Data Center
#define CANCEL_REJECT_REASON_TOO_LATE_TO_CANCEL 0x4A                           // Too Late To Cancel
#define CANCEL_REJECT_REASON_ORDER_RATE_THRESHOLD_EXCEEDED 0x4B                // Order Rate Threshold Exceeded
#define CANCEL_REJECT_REASON_ORDER_WOULD_LOCK_OR_CROSS_NBBO 0x4C               // Order Would Lock Or Cross Nbbo
#define CANCEL_REJECT_REASON_ORDER_SIZE_EXCEEDED 0x4D                          // Order Size Exceeded
#define CANCEL_REJECT_REASON_RAN_OUT_OF_LIQUIDITY_TO_EXECUTE_AGAINST 0x4E      // Ran Out Of Liquidity To Execute Against
#define CANCEL_REJECT_REASON_CL_ORD_ID_DOESNT_MATCH_A_KNOWN_ORDER 0x4F         // Cl Ord Id Doesnt Match A Known Order
#define CANCEL_REJECT_REASON_CANT_MODIFY_AN_ORDER_THAT_IS_PENDING_FILL 0x50    // Cant Modify An Order That Is Pending Fill
#define CANCEL_REJECT_REASON_WAITING_FOR_FIRST_TRADE 0x51                      // Waiting For First Trade
#define CANCEL_REJECT_REASON_ROUTING_UNAVAILABLE 0x52                          // Routing Unavailable
#define CANCEL_REJECT_REASON_SHORT_SALE_PRICE_VIOLATION 0x53                   // Short Sale Price Violation
#define CANCEL_REJECT_REASON_FILL_WOULD_TRADE_THROUGH_THE_NBBO 0x54            // Fill Would Trade Through The Nbbo
#define CANCEL_REJECT_REASON_USER_REQUESTED 0x55                               // User Requested
#define CANCEL_REJECT_REASON_WOULD_WASH 0x56                                   // Would Wash
#define CANCEL_REJECT_REASON_ADD_LIQUIDITY_ONLY_ORDER_WOULD_REMOVE 0x57        // Add Liquidity Only Order Would Remove
#define CANCEL_REJECT_REASON_ORDER_EXPIRED 0x58                                // Order Expired
#define CANCEL_REJECT_REASON_SYMBOL_NOT_SUPPORTED 0x59                         // Symbol Not Supported
#define CANCEL_REJECT_REASON_UNFORESEEN_REASON 0x5A                            // Unforeseen Reason
