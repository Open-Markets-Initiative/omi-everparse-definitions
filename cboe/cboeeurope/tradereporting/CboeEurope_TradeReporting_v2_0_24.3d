// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out CboeEurope_TradeReporting_v2_0_24.3d
//
// What this definition does not state, and the model does:
// - a Reassemble rule
// - a length prefix framing what follows
// - a run counted by a field
// - a field present only on a condition
// - the packet as a whole, which is a counted run of entries of no fixed width, with more read after it or none read by an entry, inside the rest of an optional element read with what follows it, at packet.message.tradecapturereportv2message.trdcaprptsidegrp

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_LOGIN_REQUEST_V_2_MESSAGE 0x37                        // Login Request V 2 Message
#define MESSAGE_TYPE_LOGOUT_REQUEST_MESSAGE 0x02                           // Logout Request Message
#define MESSAGE_TYPE_CLIENT_HEARTBEAT_MESSAGE 0x03                         // Client Heartbeat Message
#define MESSAGE_TYPE_LOGIN_RESPONSE_V_2_MESSAGE 0x24                       // Login Response V 2 Message
#define MESSAGE_TYPE_LOGOUT_MESSAGE 0x08                                   // Logout Message
#define MESSAGE_TYPE_SERVER_HEARTBEAT_MESSAGE 0x09                         // Server Heartbeat Message
#define MESSAGE_TYPE_REPLAY_COMPLETE_MESSAGE 0x13                          // Replay Complete Message
#define MESSAGE_TYPE_TRADE_CAPTURE_REPORT_V_2_MESSAGE 0x3C                 // Trade Capture Report V 2 Message
#define MESSAGE_TYPE_QUOTE_V_2_MESSAGE 0x3D                                // Quote V 2 Message
#define MESSAGE_TYPE_QUOTE_CANCEL_V_2_MESSAGE 0x3E                         // Quote Cancel V 2 Message
#define MESSAGE_TYPE_TRADE_CAPTURE_REPORT_ACKNOWLEDGMENT_V_2_MESSAGE 0x30  // Trade Capture Report Acknowledgment V 2 Message
#define MESSAGE_TYPE_TRADE_CAPTURE_REPORT_REJECT_V_2_MESSAGE 0x31          // Trade Capture Report Reject V 2 Message
#define MESSAGE_TYPE_TRADE_CAPTURE_CONFIRM_V_2_MESSAGE 0x32                // Trade Capture Confirm V 2 Message
#define MESSAGE_TYPE_TRADE_CAPTURE_REPORT_DECLINE_V_2_MESSAGE 0x33         // Trade Capture Report Decline V 2 Message
#define MESSAGE_TYPE_QUOTE_STATUS_V_2_MESSAGE 0x3F                         // Quote Status V 2 Message
#define MESSAGE_TYPE_QUOTE_REJECT_V_2_MESSAGE 0x40                         // Quote Reject V 2 Message

// ---- Message Header: 10 bytes ------------------------------------------------

// 10-byte BOE v2 message header. Every message starts with StartOfMessage = 0xBA 0xBA.
entrypoint typedef struct _MessageHeader {
  UINT16 start_of_message;  // bytes 0 to 1
  UINT16 message_length;    // bytes 2 to 3
  UINT8 message_type;       // byte 4, values MESSAGE_TYPE_
  UINT8 matching_unit;      // byte 5
  UINT32 sequence_number;   // bytes 6 to 9
} MessageHeader;

