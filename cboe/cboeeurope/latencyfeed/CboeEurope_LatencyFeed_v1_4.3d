// ---- Packet Header: 8 bytes --------------------------------------------------

entrypoint typedef struct _PacketHeader {
  UINT16 length;        // bytes 0 to 1
  UINT8 message_count;  // byte 2
  UINT8 unit_;          // byte 3
  UINT32 sequence;      // bytes 4 to 7
} PacketHeader;

// ---- Message Header: 2 bytes -------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT8 message_length;  // byte 0
  UINT8 message_type;    // byte 1
} MessageHeader;

// ---- Latency Stat Message: 110 bytes -----------------------------------------

// A Latency Stat Message demonstrates performance for a specific Matching Engine unit for a specific timeframe
entrypoint typedef struct _LatencyStatMessage {
  UINT8 measurement_type;          // byte 0
  UINT8 matching_unit;             // byte 1
  UINT32 begin_time;               // bytes 2 to 5
  UINT32 end_time;                 // bytes 6 to 9
  UINT32 count;                    // bytes 10 to 13
  UINT8 minimum[8];                // bytes 14 to 21
  UINT8 maximum[8];                // bytes 22 to 29
  UINT8 average[8];                // bytes 30 to 37
  UINT8 standard_deviation[8];     // bytes 38 to 45
  UINT8 mode[8];                   // bytes 46 to 53
  UINT8 percentile_99_point_9[8];  // bytes 54 to 61
  UINT8 percentile_99[8];          // bytes 62 to 69
  UINT8 percentile_95[8];          // bytes 70 to 77
  UINT8 percentile_90[8];          // bytes 78 to 85
  UINT8 percentile_75[8];          // bytes 86 to 93
  UINT8 percentile_50[8];          // bytes 94 to 101
  UINT8 percentile_25[8];          // bytes 102 to 109
} LatencyStatMessage;

