// Chicago Board Options Exchange Multicast Trades
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out MatchNow_MulticastTrades_v1_0_13.3d
//
// What this definition does not state, and the model does:
// - the dispatch that chooses a message by its type
// - a run filling what frames it
// - a field read in bits
//
// License: MIT No Attribution

// ---- Packet Header: 8 bytes --------------------------------------------------

entrypoint typedef struct _PacketHeader {
  UINT16 length;        // bytes 0 to 1
  UINT8 message_count;  // byte 2
  UINT8 unit_;          // byte 3
  UINT32 sequence;      // bytes 4 to 7
} PacketHeader;

// ---- Message Header: 2 bytes -------------------------------------------------

entrypoint typedef struct _MessageHeader {
  UINT8 message_length;  // byte 0
  UINT8 message_type;    // byte 1
} MessageHeader;

// ---- Unit Clear Message: 4 bytes ---------------------------------------------

// Instructs feed recipients to clear all orders for the Cboe Canada order book in the unit specified in the Sequenced Unit Header. Distributed in rare recovery events such as a data center fail-over.
entrypoint typedef struct _UnitClearMessage {
  UINT8 reserved_4[4];  // bytes 0 to 3
} UnitClearMessage;

// ---- Trading Status Message: 30 bytes ----------------------------------------

// Indicates the current trading status of a security in the MATCHNow system (9:30 a.m. - 4:00 p.m. ET). Sequenced Trading Status messages are sent upon system startup for all active securities with Trading Status = S (suspended).
entrypoint typedef struct _TradingStatusMessage {
  UINT64 timestamp;           // bytes 0 to 7
  UINT8 symbol[14];           // bytes 8 to 21
  UINT8 listing_exchange[4];  // bytes 22 to 25
  UINT8 trading_status;       // byte 26
  UINT8 reserved_3[3];        // bytes 27 to 29
} TradingStatusMessage;

// ---- End Of Session Message: 4 bytes -----------------------------------------

// Sent for each unit when the unit shuts down. No additional sequenced messages will be delivered for this unit, but heartbeats from the unit may be received.
entrypoint typedef struct _EndOfSessionMessage {
  UINT8 reserved_4[4];  // bytes 0 to 3
} EndOfSessionMessage;

