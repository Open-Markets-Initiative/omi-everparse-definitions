// ---- Debug Packet: 1 byte ----------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems.
entrypoint typedef struct _DebugPacket {
  UINT8 text;  // byte 0
} DebugPacket;

// ---- Login Accepted Packet: 20 bytes -----------------------------------------

// The Soup 2.0 server sends a Login Accepted Packet in response to receiving a valid Login Request from the client.
entrypoint typedef struct _LoginAcceptedPacket {
  UINT8 session[10];          // bytes 0 to 9
  UINT8 sequence_number[10];  // bytes 10 to 19
} LoginAcceptedPacket;

// ---- Login Rejected Packet: 1 byte -------------------------------------------

// The Soup 2.0 server sends this packet in response to an invalid Login Request Packet from the client.
entrypoint typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// ---- Sequenced Message Header: 9 bytes ---------------------------------------

// Sequenced Message Header
entrypoint typedef struct _SequencedMessageHeader {
  UINT8 timestamp[8];            // bytes 0 to 7
  UINT8 sequenced_message_type;  // byte 8
} SequencedMessageHeader;

// ---- Auction Update Message: 59 bytes ----------------------------------------

// Auction Update messages disseminate Cboe price and size information during auctions for Cboe listed securities and for CMC.
entrypoint typedef struct _AuctionUpdateMessage {
  UINT8 stock_symbol[8];               // bytes 0 to 7
  UINT8 auction_type;                  // byte 8
  UINT8 reference_price_short[10];     // bytes 9 to 18
  UINT8 buy_shares[10];                // bytes 19 to 28
  UINT8 sell_shares[10];               // bytes 29 to 38
  UINT8 indicative_price_short[10];    // bytes 39 to 48
  UINT8 auction_only_price_short[10];  // bytes 49 to 58
} AuctionUpdateMessage;

// ---- Extended Auction Update Message: 71 bytes -------------------------------

// The extended version of the Auction Update message accommodates larger prices.
entrypoint typedef struct _ExtendedAuctionUpdateMessage {
  UINT8 stock_symbol[8];              // bytes 0 to 7
  UINT8 auction_type;                 // byte 8
  UINT8 reference_price_long[14];     // bytes 9 to 22
  UINT8 buy_shares[10];               // bytes 23 to 32
  UINT8 sell_shares[10];              // bytes 33 to 42
  UINT8 indicative_price_long[14];    // bytes 43 to 56
  UINT8 auction_only_price_long[14];  // bytes 57 to 70
} ExtendedAuctionUpdateMessage;

// ---- Auction Summary Message: 29 bytes ---------------------------------------

// Auction Summary messages disseminate the results of a Cboe listed security auction and for Cboe Market Close.
entrypoint typedef struct _AuctionSummaryMessage {
  UINT8 stock_symbol[8];  // bytes 0 to 7
  UINT8 auction_type;     // byte 8
  UINT8 price_short[10];  // bytes 9 to 18
  UINT8 shares[10];       // bytes 19 to 28
} AuctionSummaryMessage;

// ---- Extended Auction Summary Message: 33 bytes ------------------------------

// The extended version of the Auction Summary message accommodates larger prices.
entrypoint typedef struct _ExtendedAuctionSummaryMessage {
  UINT8 stock_symbol[8];  // bytes 0 to 7
  UINT8 auction_type;     // byte 8
  UINT8 price_long[14];   // bytes 9 to 22
  UINT8 shares[10];       // bytes 23 to 32
} ExtendedAuctionSummaryMessage;

// ---- Login Request Packet: 36 bytes ------------------------------------------

// The Soup 2.0 client must send a Login Request Packet immediately upon establishing a new TCP/IP socket connection to the server.
entrypoint typedef struct _LoginRequestPacket {
  UINT8 username[6];                    // bytes 0 to 5
  UINT8 password[10];                   // bytes 6 to 15
  UINT8 requested_session[10];          // bytes 16 to 25
  UINT8 requested_sequence_number[10];  // bytes 26 to 35
} LoginRequestPacket;

