// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Frame, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out BzxEquities_LastSale_v1_2_4.3d
//
// What this definition reads more loosely than the model states:
// - the stream is a run of frames each ending at a byte 10: the caller splits it there and validates each frame, that byte included

// ---- Values ------------------------------------------------------------------

// Packet Type: one byte code
#define PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define PACKET_TYPE_LOGIN_REQUEST_PACKET 0x4C     // Login Request Packet
#define PACKET_TYPE_UNSEQUENCED_DATA_PACKET 0x55  // Unsequenced Data Packet
#define PACKET_TYPE_CLIENT_HEARTBEAT_PACKET 0x52  // Client Heartbeat Packet
#define PACKET_TYPE_LOGOUT_REQUEST_PACKET 0x4F    // Logout Request Packet

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_LAST_SALE_MESSAGE 0x4C           // Last Sale Message
#define SEQUENCED_MESSAGE_TYPE_LAST_SALE_EXTENDED_MESSAGE 0x35  // Last Sale Extended Message
#define SEQUENCED_MESSAGE_TYPE_TRADE_BREAK_MESSAGE 0x42         // Trade Break Message

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems.
typedef struct _DebugPacket {
  UINT8 text;  // byte 0
} DebugPacket;

// The Soup 2.0 server sends a Login Accepted Packet in response to receiving a valid Login Request from the client.
typedef struct _LoginAcceptedPacket {
  UINT8 session[10];          // bytes 0 to 9
  UINT8 sequence_number[10];  // bytes 10 to 19
} LoginAcceptedPacket;

// The Soup 2.0 server sends this packet in response to an invalid Login Request Packet from the client.
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// Last Sale messages are sent when an order on the Cboe book is executed in whole or in part.
typedef struct _LastSaleMessage {
  UINT8 executed_shares[8];  // bytes 0 to 7
  UINT8 stock_symbol[8];     // bytes 8 to 15
  UINT8 price_short[10];     // bytes 16 to 25
  UINT8 execution_id[12];    // bytes 26 to 37
} LastSaleMessage;

// The extended version of the Last Sale message accommodates larger prices.
typedef struct _LastSaleExtendedMessage {
  UINT8 executed_shares[8];  // bytes 0 to 7
  UINT8 stock_symbol[8];     // bytes 8 to 15
  UINT8 price_long[14];      // bytes 16 to 29
  UINT8 execution_id[12];    // bytes 30 to 41
} LastSaleExtendedMessage;

// The Trade Break message is sent whenever an execution on Cboe is broken. Trade breaks are rare and only affect applications that rely upon Cboe execution-based data.
typedef struct _TradeBreakMessage {
  UINT8 execution_id[12];  // bytes 0 to 11
} TradeBreakMessage;

// Branch
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x4C: LastSaleMessage last_sale_message;
    case 0x35: LastSaleExtendedMessage last_sale_extended_message;
    case 0x42: TradeBreakMessage trade_break_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol.
typedef struct _SequencedDataPacket (UINT32 available) where (available >= 9) {
  UINT8 timestamp[8];                                                                                                            // bytes 0 to 7
  UINT8 sequenced_message_type;                                                                                                  // byte 8
  SequencedMessage(sequenced_message_type, (available - 9)) sequenced_message[:byte-size-single-element-array (available - 9)];
} SequencedDataPacket;

// The Soup 2.0 client must send a Login Request Packet immediately upon establishing a new TCP/IP socket connection to the server.
typedef struct _LoginRequestPacket {
  UINT8 username[6];                    // bytes 0 to 5
  UINT8 password[10];                   // bytes 6 to 15
  UINT8 requested_session[10];          // bytes 16 to 25
  UINT8 requested_sequence_number[10];  // bytes 26 to 35
} LoginRequestPacket;

// The Unsequenced Data Packets act as an envelope to carry the actual data messages that are transferred from the client to the server. These messages are not sequenced and may be lost in the event of a socket failure.
typedef struct _UnsequencedDataPacket (UINT32 available) where (available >= 1) {
  UINT8 unsequenced_message[(available - 1)];
} UnsequencedDataPacket;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(available) sequenced_data_packet;
    case 0x4C: LoginRequestPacket login_request_packet;
    case 0x55: UnsequencedDataPacket(available) unsequenced_data_packet;
    default: UINT8 unknown[available];
  }
} Payload;

// ---- Packet: Frame -----------------------------------------------------------

// Soup 2.0 Lf terminated record
entrypoint typedef struct _Frame (UINT32 available) where (available >= 2) {
  UINT8 packet_type;                                                                               // byte 0
  Payload(packet_type, (available - 2)) payload[:byte-size-single-element-array (available - 2)];
  UINT8 soup_lf { soup_lf == 10 };
} Frame;

