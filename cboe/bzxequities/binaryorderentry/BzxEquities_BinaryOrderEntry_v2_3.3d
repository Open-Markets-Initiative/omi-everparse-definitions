// ReturnBitfieldsParamGroup
typedef struct _ReturnBitfieldsParamGroup {
  UINT8 message_type;                                                                 // byte 0
  UINT8 number_of_return_bitfields;                                                   // byte 1
  OptionalReturnBitfield1((number_of_return_bitfields >= 0x01)) return_bitfield_1;
  OptionalReturnBitfield2((number_of_return_bitfields >= 0x02)) return_bitfield_2;
  OptionalReturnBitfield3((number_of_return_bitfields >= 0x03)) return_bitfield_3;
  OptionalReturnBitfield4((number_of_return_bitfields >= 0x04)) return_bitfield_4;
  OptionalReturnBitfield5((number_of_return_bitfields >= 0x05)) return_bitfield_5;
  OptionalReturnBitfield6((number_of_return_bitfields >= 0x06)) return_bitfield_6;
  OptionalReturnBitfield7((number_of_return_bitfields >= 0x07)) return_bitfield_7;
  OptionalReturnBitfield8((number_of_return_bitfields >= 0x08)) return_bitfield_8;
  OptionalReturnBitfield9((number_of_return_bitfields >= 0x09)) return_bitfield_9;
  OptionalReturnBitfield10((number_of_return_bitfields >= 0x0A)) return_bitfield_10;
  OptionalReturnBitfield11((number_of_return_bitfields >= 0x0B)) return_bitfield_11;
  OptionalReturnBitfield12((number_of_return_bitfields >= 0x0C)) return_bitfield_12;
  OptionalReturnBitfield13((number_of_return_bitfields >= 0x0D)) return_bitfield_13;
  OptionalReturnBitfield14((number_of_return_bitfields >= 0x0E)) return_bitfield_14;
  OptionalReturnBitfield15((number_of_return_bitfields >= 0x0F)) return_bitfield_15;
  OptionalReturnBitfield16((number_of_return_bitfields >= 0x10)) return_bitfield_16;
  OptionalReturnBitfield17((number_of_return_bitfields >= 0x11)) return_bitfield_17;
} ReturnBitfieldsParamGroup;

// Raw message bytes
casetype _ParamGroupPayload (UINT8 selector) {
  switch (selector) {
    case 0x80: UnitSequencesParamGroup unit_sequences_param_group;
    case 0x81: ReturnBitfieldsParamGroup return_bitfields_param_group;
  }
} ParamGroupPayload;

// Repeating parameter group appended to the Login Request and Login Response messages. NumberOfParamGroups instances follow (count may be 0 the group is optional). Each instance starts with the 2-byte ParamGroupLength + 1-byte ParamGroupType header; the remaining payload bytes are interpreted per ParamGroupType (0x80 = Unit Sequences Parameter Group, 0x81 = Return Bitfields Parameter Group).
typedef struct _ParamGroup (mutable UINT32 * tally) {
  UINT16 param_group_length;                                                                                                                                       // bytes 0 to 1
  UINT8 param_group_type;                                                                                                                                          // byte 2
  ParamGroupPayload(param_group_type) param_group_payload;
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} ParamGroup;

// A Login Response message is sent in response to a Login Request message. On a successful login, the LoginResponseStatus will be set to A . On a failed login, LoginResponseStatus will be set to a value other than A , and LoginResponseText will be set to an appropriate failure description.
typedef struct _LoginRequestMessage (UINT32 available, mutable UINT32 * tally) where (available >= 19) {
  UINT8 session_sub_id[4];                                                                                                               // bytes 0 to 3
  UINT8 username[4];                                                                                                                     // bytes 4 to 7
  UINT8 password[10];                                                                                                                    // bytes 8 to 17
  UINT8 number_of_param_groups;                                                                                                          // byte 18
  unit param_group_tally_start {:on-success *tally = 0; return true; };
  ParamGroup(tally) param_group[:byte-size (available - 19)];
  unit param_group_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_of_param_groups); };
} LoginRequestMessage;

// A Login Response message is sent in response to a Login Request message. On a successful login, the LoginResponseStatus will be set to A . On a failed login, LoginResponseStatus will be set to a value other than A , and LoginResponseText will be set to an appropriate failure description.
typedef struct _LoginResponseMessage (UINT32 available, mutable UINT32 * tally) where (available >= 68) {
  UINT8 login_response_status;                                                                                                           // byte 0
  UINT8 login_response_text[60];                                                                                                         // bytes 1 to 60
  UINT8 no_unspecified_unit_replay;                                                                                                      // byte 61
