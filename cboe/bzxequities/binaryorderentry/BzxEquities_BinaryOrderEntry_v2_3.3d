casetype _Message (UINT8 selector, UINT32 length, UINT32 length_2, UINT32 length_3, UINT32 length_4, UINT32 length_5, UINT32 length_6, UINT32 length_7, UINT32 length_8, UINT32 length_9, UINT32 length_10, UINT32 length_11, UINT32 length_12, UINT32 length_13, UINT32 length_14, UINT32 length_15, UINT32 length_16, UINT32 length_17, UINT32 length_18, UINT32 available, mutable UINT32 * tally) {
