// ---- Types -------------------------------------------------------------------

// Repeating unit/sequence pair appended after NumberOfUnits in Login Response and Logout messages. NumberOfUnits instances follow (count may be 0). Each instance gives the highest Cboe to Member sequence number available for the named matching unit.
typedef struct _UnitSequences {
  UINT8 unit_number;     // byte 0
  UINT32 unit_sequence;  // bytes 1 to 4
} UnitSequences;

// UnitSequencesParamGroup
typedef struct _UnitSequencesParamGroup {
  UINT8 no_unspecified_unit_replay;                                           // byte 0
  UINT8 number_of_units;                                                      // byte 1
  UnitSequences unit_sequences[:byte-size (((UINT32) number_of_units) * 5)];
} UnitSequencesParamGroup;

// BitSet OrderAcknowledgment byte 1.
typedef struct _ReturnBitfield1 {
  UINT8 return_bitfield_1_side : 1;            // byte 0
  UINT8 return_bitfield_1_peg_difference : 1;  // byte 0
  UINT8 return_bitfield_1_price : 1;           // byte 0
  UINT8 return_bitfield_1_exec_inst : 1;       // byte 0
  UINT8 return_bitfield_1_ord_type : 1;        // byte 0
  UINT8 return_bitfield_1_time_in_force : 1;   // byte 0
  UINT8 return_bitfield_1_min_qty : 1;         // byte 0
  UINT8 return_bitfield_1_max_remove_pct : 1;  // byte 0
} ReturnBitfield1;

// BitSet OrderAcknowledgment byte 1.
casetype _OptionalReturnBitfield1 (Bool present) {
  switch (present) {
    case true: ReturnBitfield1 return_bitfield_1;
    case false: unit absent;
  }
} OptionalReturnBitfield1;

