// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Frame, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out ByxEquities_Top_v1_3_10.3d
//
// What this definition reads more loosely than the model states:
// - the stream is a run of frames each ending at a byte 10: the caller splits it there and validates each frame, that byte included

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_LOGON_MESSAGE 0x4C                      // Logon Message
#define MESSAGE_TYPE_LOGON_REJECTED_MESSAGE 0x4A             // Logon Rejected Message
#define MESSAGE_TYPE_SECONDS_MESSAGE 0x54                    // Seconds Message
#define MESSAGE_TYPE_MILLISECONDS_MESSAGE 0x4D               // Milliseconds Message
#define MESSAGE_TYPE_LOGON_ACCEPTED_MESSAGE 0x43             // Logon Accepted Message
#define MESSAGE_TYPE_EXPANDED_SPIN_MESSAGE 0x73              // Expanded Spin Message
#define MESSAGE_TYPE_EXTENDED_SPIN_MESSAGE 0x53              // Extended Spin Message
#define MESSAGE_TYPE_SPIN_DONE_MESSAGE 0x44                  // Spin Done Message
#define MESSAGE_TYPE_SERVER_HEARTBEAT_MESSAGE 0x48           // Server Heartbeat Message
#define MESSAGE_TYPE_CLIENT_HEARTBEAT_MESSAGE 0x52           // Client Heartbeat Message
#define MESSAGE_TYPE_EXPANDED_BID_UPDATE_MESSAGE 0x45        // Expanded Bid Update Message
#define MESSAGE_TYPE_LONG_BID_UPDATE_MESSAGE 0x42            // Long Bid Update Message
#define MESSAGE_TYPE_SHORT_BID_UPDATE_MESSAGE 0x62           // Short Bid Update Message
#define MESSAGE_TYPE_EXTENDED_BID_UPDATE_MESSAGE 0x4E        // Extended Bid Update Message
#define MESSAGE_TYPE_EXPANDED_ASK_UPDATE_MESSAGE 0x65        // Expanded Ask Update Message
#define MESSAGE_TYPE_LONG_ASK_UPDATE_MESSAGE 0x41            // Long Ask Update Message
#define MESSAGE_TYPE_SHORT_ASK_UPDATE_MESSAGE 0x61           // Short Ask Update Message
#define MESSAGE_TYPE_EXTENDED_ASK_UPDATE_MESSAGE 0x6E        // Extended Ask Update Message
#define MESSAGE_TYPE_EXPANDED_TWO_SIDED_UPDATE_MESSAGE 0x46  // Expanded Two Sided Update Message
#define MESSAGE_TYPE_LONG_TWO_SIDED_UPDATE_MESSAGE 0x55      // Long Two Sided Update Message
#define MESSAGE_TYPE_SHORT_TWO_SIDED_UPDATE_MESSAGE 0x75     // Short Two Sided Update Message
#define MESSAGE_TYPE_EXTENDED_TWO_SIDED_UPDATE_MESSAGE 0x64  // Extended Two Sided Update Message
#define MESSAGE_TYPE_EXPANDED_TRADE_MESSAGE 0x66             // Expanded Trade Message
#define MESSAGE_TYPE_LONG_TRADE_MESSAGE 0x56                 // Long Trade Message
#define MESSAGE_TYPE_SHORT_TRADE_MESSAGE 0x76                // Short Trade Message
#define MESSAGE_TYPE_EXTENDED_TRADE_MESSAGE 0x72             // Extended Trade Message
#define MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x74             // Trading Status Message

// Reg SHO Action: one byte code
#define REG_S_H_O_ACTION_NO_PRICE_TEST_IN_EFFECT 0x30                   // No Price Test In Effect
#define REG_S_H_O_ACTION_REG_SHO_PRICE_TEST_RESTRICTION_IN_EFFECT 0x31  // Reg Sho Price Test Restriction In Effect

// Last Trade Day Indicator: one byte code
#define LAST_TRADE_DAY_INDICATOR_LAST_TRADE_TIME_FOLLOWS_TIME_REFERENCE_MILLISECONDS_SINCE_TODAYS_MIDNIGHT 0x30  // Last Trade Time Follows Time Reference Milliseconds Since Todays Midnight
#define LAST_TRADE_DAY_INDICATOR_LAST_TRADE_TIME_IS_MILLISECONDS_SINCE_YESTERDAYS_MIDNIGHT 0x31                  // Last Trade Time Is Milliseconds Since Yesterdays Midnight

// ---- Types -------------------------------------------------------------------

// Logon Message
typedef struct _LogonMessage {
  UINT8 username[6];   // bytes 0 to 5
  UINT8 password[10];  // bytes 6 to 15
  UINT8 spin_flag;     // byte 16
} LogonMessage;

// Logon Rejected Message
typedef struct _LogonRejectedMessage {
  UINT8 reject_reason;  // byte 0
} LogonRejectedMessage;

// Sent for every second for which at least one message is being generated.
typedef struct _SecondsMessage {
  UINT8 seconds[5];  // bytes 0 to 4
} SecondsMessage;

// Sent for every millisecond for which at least one message is being generated.
typedef struct _MillisecondsMessage {
  UINT8 milliseconds[3];  // bytes 0 to 2
} MillisecondsMessage;

// Expanded Spin Message
typedef struct _ExpandedSpinMessage {
  UINT8 timestamp[8];                // bytes 0 to 7
  UINT8 symbol_extended[8];          // bytes 8 to 15
  UINT8 bid_price_long[10];          // bytes 16 to 25
  UINT8 bid_quantity_long[6];        // bytes 26 to 31
  UINT8 ask_price_long[10];          // bytes 32 to 41
  UINT8 ask_quantity_long[6];        // bytes 42 to 47
  UINT8 last_trade_time[8];          // bytes 48 to 55
  UINT8 last_trade_price_short[10];  // bytes 56 to 65
  UINT8 last_trade_size[6];          // bytes 66 to 71
  UINT8 cumulative_volume_long[9];   // bytes 72 to 80
  UINT8 halt_status;                 // byte 81
  UINT8 reg_s_h_o_action;            // byte 82
  UINT8 last_trade_day_indicator;    // byte 83
  UINT8 reserved_2;                  // byte 84
} ExpandedSpinMessage;

// Extended Spin Message
typedef struct _ExtendedSpinMessage {
  UINT8 timestamp[8];               // bytes 0 to 7
  UINT8 symbol_extended[8];         // bytes 8 to 15
  UINT8 bid_price_extended[14];     // bytes 16 to 29
  UINT8 bid_quantity_long[6];       // bytes 30 to 35
  UINT8 ask_price_extended[14];     // bytes 36 to 49
  UINT8 ask_quantity_long[6];       // bytes 50 to 55
  UINT8 last_trade_time[8];         // bytes 56 to 63
  UINT8 last_trade_price_long[14];  // bytes 64 to 77
  UINT8 last_trade_size[6];         // bytes 78 to 83
  UINT8 cumulative_volume_long[9];  // bytes 84 to 92
  UINT8 halt_status;                // byte 93
  UINT8 reg_s_h_o_action;           // byte 94
  UINT8 last_trade_day_indicator;   // byte 95
  UINT8 reserved_2;                 // byte 96
} ExtendedSpinMessage;

// Expanded Bid Update Message
typedef struct _ExpandedBidUpdateMessage {
  UINT8 symbol_extended[8];    // bytes 0 to 7
  UINT8 bid_price_long[10];    // bytes 8 to 17
  UINT8 bid_quantity_long[6];  // bytes 18 to 23
} ExpandedBidUpdateMessage;

// Long Bid Update Message
typedef struct _LongBidUpdateMessage {
  UINT8 symbol_long[6];        // bytes 0 to 5
  UINT8 bid_price_long[10];    // bytes 6 to 15
  UINT8 bid_quantity_long[6];  // bytes 16 to 21
} LongBidUpdateMessage;

// Short Bid Update Message
typedef struct _ShortBidUpdateMessage {
  UINT8 symbol_short[4];        // bytes 0 to 3
  UINT8 bid_price_short[5];     // bytes 4 to 8
  UINT8 bid_quantity_short[5];  // bytes 9 to 13
} ShortBidUpdateMessage;

// Extended Bid Update Message
typedef struct _ExtendedBidUpdateMessage {
  UINT8 symbol_extended[8];      // bytes 0 to 7
  UINT8 bid_price_extended[14];  // bytes 8 to 21
  UINT8 bid_quantity_long[6];    // bytes 22 to 27
} ExtendedBidUpdateMessage;

// Expanded Ask Update Message
typedef struct _ExpandedAskUpdateMessage {
  UINT8 symbol_extended[8];    // bytes 0 to 7
  UINT8 ask_price_long[10];    // bytes 8 to 17
  UINT8 ask_quantity_long[6];  // bytes 18 to 23
} ExpandedAskUpdateMessage;

// Long Ask Update Message
typedef struct _LongAskUpdateMessage {
  UINT8 symbol_long[6];        // bytes 0 to 5
  UINT8 ask_price_long[10];    // bytes 6 to 15
  UINT8 ask_quantity_long[6];  // bytes 16 to 21
} LongAskUpdateMessage;

// Short Ask Update Message
typedef struct _ShortAskUpdateMessage {
  UINT8 symbol_short[4];        // bytes 0 to 3
  UINT8 ask_price_short[5];     // bytes 4 to 8
  UINT8 ask_quantity_short[5];  // bytes 9 to 13
} ShortAskUpdateMessage;

// Extended Ask Update Message
typedef struct _ExtendedAskUpdateMessage {
  UINT8 symbol_extended[8];      // bytes 0 to 7
  UINT8 ask_price_extended[14];  // bytes 8 to 21
  UINT8 ask_quantity_long[6];    // bytes 22 to 27
} ExtendedAskUpdateMessage;

// Expanded Two-Sided Update Message
typedef struct _ExpandedTwoSidedUpdateMessage {
  UINT8 symbol_extended[8];    // bytes 0 to 7
  UINT8 bid_price_long[10];    // bytes 8 to 17
  UINT8 bid_quantity_long[6];  // bytes 18 to 23
  UINT8 ask_price_long[10];    // bytes 24 to 33
  UINT8 ask_quantity_long[6];  // bytes 34 to 39
} ExpandedTwoSidedUpdateMessage;

// Long Two-Sided Update Message
typedef struct _LongTwoSidedUpdateMessage {
  UINT8 symbol_long[6];        // bytes 0 to 5
  UINT8 bid_price_long[10];    // bytes 6 to 15
  UINT8 bid_quantity_long[6];  // bytes 16 to 21
  UINT8 ask_price_long[10];    // bytes 22 to 31
  UINT8 ask_quantity_long[6];  // bytes 32 to 37
} LongTwoSidedUpdateMessage;

// Short Two-Sided Update Message
typedef struct _ShortTwoSidedUpdateMessage {
  UINT8 symbol_short[4];        // bytes 0 to 3
  UINT8 bid_price_short[5];     // bytes 4 to 8
  UINT8 bid_quantity_short[5];  // bytes 9 to 13
  UINT8 ask_price_short[5];     // bytes 14 to 18
  UINT8 ask_quantity_short[5];  // bytes 19 to 23
} ShortTwoSidedUpdateMessage;

// Extended Two-Sided Update Message
typedef struct _ExtendedTwoSidedUpdateMessage {
  UINT8 symbol_extended[8];      // bytes 0 to 7
  UINT8 bid_price_extended[14];  // bytes 8 to 21
  UINT8 bid_quantity_long[6];    // bytes 22 to 27
  UINT8 ask_price_extended[14];  // bytes 28 to 41
  UINT8 ask_quantity_long[6];    // bytes 42 to 47
} ExtendedTwoSidedUpdateMessage;

// Expanded Trade Message
typedef struct _ExpandedTradeMessage {
  UINT8 symbol_extended[8];         // bytes 0 to 7
  UINT8 last_price_long[10];        // bytes 8 to 17
  UINT8 last_quantity_long[6];      // bytes 18 to 23
  UINT8 cumulative_volume_long[9];  // bytes 24 to 32
} ExpandedTradeMessage;

// Long Trade Message
typedef struct _LongTradeMessage {
  UINT8 symbol_long[6];             // bytes 0 to 5
  UINT8 last_price_long[10];        // bytes 6 to 15
  UINT8 last_quantity_long[6];      // bytes 16 to 21
  UINT8 cumulative_volume_long[9];  // bytes 22 to 30
} LongTradeMessage;

// Short Trade Message
typedef struct _ShortTradeMessage {
  UINT8 symbol_short[4];             // bytes 0 to 3
  UINT8 last_price_short[5];         // bytes 4 to 8
  UINT8 last_quantity_short[5];      // bytes 9 to 13
  UINT8 cumulative_volume_short[7];  // bytes 14 to 20
} ShortTradeMessage;

// Extended Trade Message
typedef struct _ExtendedTradeMessage {
  UINT8 symbol_extended[8];         // bytes 0 to 7
  UINT8 last_price_extended[14];    // bytes 8 to 21
  UINT8 last_quantity_long[6];      // bytes 22 to 27
  UINT8 cumulative_volume_long[9];  // bytes 28 to 36
} ExtendedTradeMessage;

// The Trading Status Message is used to indicate the current trading status of a security.
typedef struct _TradingStatusMessage {
  UINT8 symbol_extended[8];  // bytes 0 to 7
  UINT8 halt_status;         // byte 8
  UINT8 reg_s_h_o_action;    // byte 9
  UINT8 reserved_1;          // byte 10
  UINT8 reserved_2;          // byte 11
} TradingStatusMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x4C: LogonMessage logon_message;
    case 0x4A: LogonRejectedMessage logon_rejected_message;
    case 0x54: SecondsMessage seconds_message;
    case 0x4D: MillisecondsMessage milliseconds_message;
    case 0x43: unit logon_accepted_message;
    case 0x73: ExpandedSpinMessage expanded_spin_message;
    case 0x53: ExtendedSpinMessage extended_spin_message;
    case 0x44: unit spin_done_message;
    case 0x48: unit server_heartbeat_message;
    case 0x52: unit client_heartbeat_message;
    case 0x45: ExpandedBidUpdateMessage expanded_bid_update_message;
    case 0x42: LongBidUpdateMessage long_bid_update_message;
    case 0x62: ShortBidUpdateMessage short_bid_update_message;
    case 0x4E: ExtendedBidUpdateMessage extended_bid_update_message;
    case 0x65: ExpandedAskUpdateMessage expanded_ask_update_message;
    case 0x41: LongAskUpdateMessage long_ask_update_message;
    case 0x61: ShortAskUpdateMessage short_ask_update_message;
    case 0x6E: ExtendedAskUpdateMessage extended_ask_update_message;
    case 0x46: ExpandedTwoSidedUpdateMessage expanded_two_sided_update_message;
    case 0x55: LongTwoSidedUpdateMessage long_two_sided_update_message;
    case 0x75: ShortTwoSidedUpdateMessage short_two_sided_update_message;
    case 0x64: ExtendedTwoSidedUpdateMessage extended_two_sided_update_message;
    case 0x66: ExpandedTradeMessage expanded_trade_message;
    case 0x56: LongTradeMessage long_trade_message;
    case 0x76: ShortTradeMessage short_trade_message;
    case 0x72: ExtendedTradeMessage extended_trade_message;
    case 0x74: TradingStatusMessage trading_status_message;
    default: UINT8 unknown[available];
  }
} Payload;

// ---- Packet: Frame -----------------------------------------------------------

// Cboe TOP Tcp Lf terminated record packet type byte, type-determined payload, terminating LF
entrypoint typedef struct _Frame (UINT32 available) where (available >= 2) {
  UINT8 message_type;                                                                               // byte 0
  Payload(message_type, (available - 2)) payload[:byte-size-single-element-array (available - 2)];
  UINT8 top_lf { top_lf == 10 };
} Frame;

