  UINT32 leaves_qty;               // bytes 63 to 66
  UINT64 display_price;            // bytes 67 to 74, signed, read here as unsigned
  UINT64 working_price;            // bytes 75 to 82, signed, read here as unsigned
  UINT8 base_liquidity_indicator;  // byte 83
