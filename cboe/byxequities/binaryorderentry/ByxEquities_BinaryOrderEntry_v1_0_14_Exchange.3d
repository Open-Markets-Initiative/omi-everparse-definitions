// ---- Exchange Message Header: 12 bytes ---------------------------------------

// Message header of a packet sent by the exchange
entrypoint typedef struct _ExchangeMessageHeader {
  UINT16 start_of_message;       // bytes 0 to 1
  UINT16 message_length;         // bytes 2 to 3
  UINT16 exchange_message_type;  // bytes 4 to 5
  UINT8 matching_unit;           // byte 6
  UINT8 reserved_field;          // byte 7
  UINT32 sequence_number;        // bytes 8 to 11
} ExchangeMessageHeader;

// ---- Logout Response Message: 61 bytes ---------------------------------------

// A Logout Response is usually sent in response to a Logout Request
entrypoint typedef struct _LogoutResponseMessage {
  UINT8 logout_reason;           // byte 0
  UINT8 logout_reason_text[60];  // bytes 1 to 60
} LogoutResponseMessage;

// ---- Order Acknowledgement Us Equities V 1: 82 bytes -------------------------

// Order Acknowledgment messages are sent in response to New Order messages
entrypoint typedef struct _OrderAcknowledgementUsEquitiesV1 {
  UINT16 in_flight;                // bytes 0 to 1
