    case 0x02: unit logout_request_message;
    case 0x03: unit client_heartbeat_message;
    case 0x24: LoginResponseMessage(length_2, tally) login_response_message[:byte-size-single-element-array length_2];
    case 0x08: LogoutMessage logout_message[:byte-size-single-element-array length_3];
    case 0x09: unit server_heartbeat_message;
    case 0x13: unit replay_complete_message;
    case 0x38: NewOrderMessage new_order_message[:byte-size-single-element-array length_4];
    case 0x39: CancelOrderMessage cancel_order_message[:byte-size-single-element-array length_5];
    case 0x3A: ModifyOrderMessage modify_order_message[:byte-size-single-element-array length_6];
    case 0x47: PurgeOrdersMessage purge_orders_message[:byte-size-single-element-array length_7];
    case 0x25: OrderAcknowledgmentMessage order_acknowledgment_message[:byte-size-single-element-array length_8];
    case 0x26: OrderRejectedMessage order_rejected_message[:byte-size-single-element-array length_9];
    case 0x27: OrderModifiedMessage order_modified_message[:byte-size-single-element-array length_10];
    case 0x28: OrderRestatedMessage order_restated_message[:byte-size-single-element-array length_11];
    case 0x29: UserModifyRejectedMessage user_modify_rejected_message[:byte-size-single-element-array length_12];
    case 0x2A: OrderCancelledMessage order_cancelled_message[:byte-size-single-element-array length_13];
    case 0x2B: CancelRejectedMessage cancel_rejected_message[:byte-size-single-element-array length_14];
    case 0x2C: OrderExecutionMessage order_execution_message[:byte-size-single-element-array length_15];
    case 0x2D: TradeCancelOrCorrectMessage trade_cancel_or_correct_message[:byte-size-single-element-array length_16];
    case 0x36: MassCancelAcknowledgmentMessage mass_cancel_acknowledgment_message[:byte-size-single-element-array length_17];
    case 0x48: PurgeRejectedMessage purge_rejected_message[:byte-size-single-element-array length_18];
