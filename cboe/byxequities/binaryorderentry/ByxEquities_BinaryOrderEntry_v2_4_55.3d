  UINT8 cl_ord_id[20];                                                                                                     // bytes 0 to 19
  UINT8 side;                                                                                                              // byte 20
  UINT32 order_qty;                                                                                                        // bytes 21 to 24
  UINT8 number_of_new_order_bitfields;                                                                                     // byte 25
