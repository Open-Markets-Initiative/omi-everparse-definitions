// Repeating unit/sequence pair appended after NumberOfUnits in Login Response and Logout messages. NumberOfUnits instances follow (count may be 0). Each instance gives the highest Cboe to Member sequence number available for the named matching unit.
typedef struct _UnitSequences {
  UINT8 unit_number;     // byte 0
  UINT32 unit_sequence;  // bytes 1 to 4
} UnitSequences;

// UnitSequencesParamGroup
typedef struct _UnitSequencesParamGroup {
  UINT8 no_unspecified_unit_replay;                                           // byte 0
  UINT8 number_of_units;                                                      // byte 1
  UnitSequences unit_sequences[:byte-size (((UINT32) number_of_units) * 5)];
} UnitSequencesParamGroup;

