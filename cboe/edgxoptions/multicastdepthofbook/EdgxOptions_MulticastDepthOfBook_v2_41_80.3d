// Side Indicator: one byte code
#define SIDE_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define SIDE_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Customer Indicator: one byte code
#define CUSTOMER_INDICATOR_NON_CUSTOMER 0x4E           // Non Customer
#define CUSTOMER_INDICATOR_CUSTOMER 0x43               // Customer
#define CUSTOMER_INDICATOR_RETAIL_PRIORITY_ORDER 0x52  // Retail Priority Order

// Trade Condition: one byte code
#define TRADE_CONDITION_SINGLE_LEG_AUCTION_NON_ISO_CBOE_AUCTION_TYPES_INCLUDE_AIM_SAM 0x61                     // Single Leg Auction Non Iso Cboe Auction Types Include Aim Sam
#define TRADE_CONDITION_SINGLE_LEG_AUCTION_ISO_CBOE_AUCTION_TYPES_ARE_AIM_ISO_SAM_ISO 0x62                     // Single Leg Auction Iso Cboe Auction Types Are Aim Iso Sam Iso
#define TRADE_CONDITION_SINGLE_LEG_CROSS_NON_ISO_CBOE_AUCTION_TYPES_INCLUDE_CUST_TO_CUST_AIM_QCC 0x63          // Single Leg Cross Non Iso Cboe Auction Types Include Cust To Cust Aim Qcc
#define TRADE_CONDITION_SINGLE_LEG_CROSS_ISO_CBOE_ORDER_TYPE_IS_CUST_TO_CUST_AIM_ISO 0x64                      // Single Leg Cross Iso Cboe Order Type Is Cust To Cust Aim Iso
#define TRADE_CONDITION_SINGLE_LEG_FLOOR_TRADE 0x65                                                            // Single Leg Floor Trade
#define TRADE_CONDITION_COMPLEX_TO_COMPLEX_ELECTRONIC_TRADE 0x66                                               // Complex To Complex Electronic Trade
#define TRADE_CONDITION_COMPLEX_AUCTION_TRADE 0x67                                                             // Complex Auction Trade
#define TRADE_CONDITION_COMPLEX_CROSS 0x68                                                                     // Complex Cross
#define TRADE_CONDITION_COMPLEX_ELECTRONIC_TRADE_AGAINST_SINGLE_LEGS 0x6A                                      // Complex Electronic Trade Against Single Legs
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_OPTIONS_AUCTION_TRADE 0x6B                                          // Complex With Stock Options Auction Trade
#define TRADE_CONDITION_COMPLEX_FLOOR_TRADE_AGAINST_SINGLE_LEGS 0x6D                                           // Complex Floor Trade Against Single Legs
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_ELECTRONIC_TRADE 0x6E                                               // Complex With Stock Electronic Trade
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_CROSS 0x6F                                                          // Complex With Stock Cross
#define TRADE_CONDITION_COMPLEX_WITH_STOCK_FLOOR_TRADE 0x70                                                    // Complex With Stock Floor Trade
#define TRADE_CONDITION_COMPLEX_FLOOR_TRADE_OF_PROPRIETARY_PRODUCTS_MARKED_AS_COMBO_ORDER 0x74                 // Complex Floor Trade Of Proprietary Products Marked As Combo Order
#define TRADE_CONDITION_MULTILATERAL_COMPRESSION_TRADE_OF_PROPRIETARY_PRODUCTS 0x75                            // Multilateral Compression Trade Of Proprietary Products
#define TRADE_CONDITION_EXTENDED_HOURS_TRADE 0x76                                                              // Extended Hours Trade
#define TRADE_CONDITION_ELECTRONIC_TRADE 0x49                                                                  // Electronic Trade
#define TRADE_CONDITION_CABINET_ORDER 0x4B                                                                     // Cabinet Order
#define TRADE_CONDITION_FUTURE_OPTIONS_AUCTION_TRADE_ELECTRONIC_EXECUTION_OF_A_MULTI_LEG_FUTUREOP_m4njii 0x4D  // Future Options Auction Trade Electronic Execution Of A Multi Leg Futureoptions Order Traded In A Two Sided Auction
#define TRADE_CONDITION_FUTURE_OPTIONS_AUTO_ELECTRONIC_TRADE_ELECTRONIC_EXECUTION_OF_A_MULTI_LEG__48mzmr 0x4E  // Future Options Auto Electronic Trade Electronic Execution Of A Multi Leg Futureoptions Order Traded On The Complex Book Or In A Coa
#define TRADE_CONDITION_FUTURE_OPTIONS_CROSS_ELECTRONIC_EXECUTION_OF_A_MULTI_LEG_FUTUREOPTIONS_OR_cxryqg 0x50  // Future Options Cross Electronic Execution Of A Multi Leg Futureoptions Order Traded In A Two Sided Crossing Mechanism That Does Not Go Through An Exposure Period
#define TRADE_CONDITION_OPENING_TRADE 0x4F                                                                     // Opening Trade
#define TRADE_CONDITION_ISO 0x53                                                                               // Iso

// Symbol Condition: one byte code
#define SYMBOL_CONDITION_NORMAL 0x4E        // Normal
#define SYMBOL_CONDITION_CLOSING_ONLY 0x43  // Closing Only

// Trading Status: one byte code
#define TRADING_STATUS_HALTED 0x48            // Halted
#define TRADING_STATUS_CURB_TRADING 0x4C      // Curb Trading
#define TRADING_STATUS_QUOTE_ONLY 0x51        // Quote Only
#define TRADING_STATUS_OPENING_ROTATION 0x52  // Opening Rotation
#define TRADING_STATUS_RTH_TRADING 0x54       // Rth Trading

// Gth Trading Status: one byte code
#define GTH_TRADING_STATUS_HALTED 0x48            // Halted
#define GTH_TRADING_STATUS_QUOTE_ONLY 0x51        // Quote Only
#define GTH_TRADING_STATUS_OPENING_ROTATION 0x52  // Opening Rotation
#define GTH_TRADING_STATUS_TRADING 0x54           // Trading

// Width Type: one byte code
#define WIDTH_TYPE_REGULAR 0x52          // Regular
#define WIDTH_TYPE_VOLATILITY 0x56       // Volatility
#define WIDTH_TYPE_MAX_QUOTE_WIDTH 0x51  // Max Quote Width

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING_AUCTION 0x4F     // Opening Auction
#define AUCTION_TYPE_CLOSING_AUCTION 0x43     // Closing Auction
#define AUCTION_TYPE_GTH_OPENING 0x47         // Gth Opening
#define AUCTION_TYPE_HALT_AUCTION 0x48        // Halt Auction
#define AUCTION_TYPE_IPO_AUCTION 0x49         // Ipo Auction
#define AUCTION_TYPE_CBOE_MARKET_CLOSE 0x4D   // Cboe Market Close
#define AUCTION_TYPE_VOLITILITY_AUCTION 0x56  // Volitility Auction
#define AUCTION_TYPE_PERIODIC_AUCTION 0x50    // Periodic Auction

// Opening Condition: one byte code
#define OPENING_CONDITION_WOULD_OPEN 0x4F                // Would Open
#define OPENING_CONDITION_NEED_QUOTE_TO_OPEN 0x51        // Need Quote To Open
#define OPENING_CONDITION_NEED_MORE_BUYERS 0x42          // Need More Buyers
#define OPENING_CONDITION_NEED_MORE_SELLERS 0x53         // Need More Sellers
#define OPENING_CONDITION_CROSSED_COMPOSITE_MARKET 0x43  // Crossed Composite Market

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// ---- Types -------------------------------------------------------------------

// A Time message is immediately generated and sent when there is a PITCH event for a given clock second. If there is no PITCH event for a given clock second, then no Time message is sent for that second. The Time field is the number of seconds relative to midnight Eastern Time. All subsequent time offset fields for the same unit will use the new Time message value as the base until another Time message is received for the same unit.
typedef struct _TimeMessage {
  UINT32 time;  // bytes 0 to 3
} TimeMessage;

// The Unit Clear message instructs feed recipients to clear all orders for the Cboe book in the unit specified in the Sequenced Unit Header message. For Equities only, this message will be sent at startup each day. It would also be distributed in certain recovery events such as a data center fail-over.
typedef struct _UnitClearMessage {
  UINT32 time_offset;  // bytes 0 to 3
} UnitClearMessage;

// Options Only. The Transaction Begin message indicates any subsequent messages, up to the accompanying Transaction End message, are all part of the same transaction block. All PITCH messages corresponding to such an event would be included between a Transaction Begin message and Transaction End message. It is important to note that transaction blocks are currently used in US Options for symbol state transitions only, but may be expanded to other use cases with notice. Transaction Begin messages do not alter the book and can be ignored if messages are being used solely to build a book.
typedef struct _TransactionBeginMessage {
  UINT32 time_offset;  // bytes 0 to 3
} TransactionBeginMessage;

// Options Only. The Transaction End message indicates that a transaction indicated by a previous Transaction Begin message has completed. Transaction End messages do not alter the book and can be ignored if messages are being used solely to build a book.
typedef struct _TransactionEndMessage {
  UINT32 time_offset;  // bytes 0 to 3
} TransactionEndMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book. It includes a day-specific Order Id assigned by Cboe to the order.
typedef struct _AddOrderLongMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT64 order_id;       // bytes 4 to 11
  UINT8 side_indicator;  // byte 12
  UINT32 quantity_long;  // bytes 13 to 16
  UINT8 symbol[6];       // bytes 17 to 22
  UINT64 price_long;     // bytes 23 to 30
  UINT8 reserved_3 : 3;  // byte 31
  UINT8 aon : 1;         // byte 31
  UINT8 reserved_4 : 4;  // byte 31
} AddOrderLongMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book. It includes a day-specific Order Id assigned by Cboe to the order.
typedef struct _AddOrderShortMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT16 quantity_short;  // bytes 13 to 14
  UINT8 symbol[6];        // bytes 15 to 20
  UINT16 price_short;     // bytes 21 to 22
  UINT8 reserved_3 : 3;   // byte 23
  UINT8 aon : 1;          // byte 23
  UINT8 reserved_4 : 4;   // byte 23
} AddOrderShortMessage;

// The expanded version of the Add Order message has been made available to accommodate larger symbol sizes possible through the ISRA plan.
typedef struct _AddOrderExpandedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT8 side_indicator;      // byte 12
  UINT32 quantity_long;      // bytes 13 to 16
  UINT8 expanded_symbol[8];  // bytes 17 to 24
  UINT64 price_long;         // bytes 25 to 32
  UINT8 reserved_3 : 3;      // byte 33
  UINT8 aon : 1;             // byte 33
  UINT8 reserved_4 : 4;      // byte 33
  UINT8 participant_id[4];   // bytes 34 to 37
  UINT8 customer_indicator;  // byte 38
  UINT8 client_id[4];        // bytes 39 to 42
  UINT8 reserved_5[5];       // bytes 43 to 47
} AddOrderExpandedMessage;

// Order Executed messages are sent when a visible order on the Cboe book is executed in whole or in part. The execution price equals the limit order price found in the original Add Order message or the limit order price in the latest Modify Order message referencing the Order Id.
typedef struct _OrderExecutedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT32 executed_quantity;  // bytes 12 to 15
  UINT64 execution_id;       // bytes 16 to 23
  UINT8 trade_condition;     // byte 24
} OrderExecutedMessage;

// Order Executed at Price/Size messages are sent when a visible order on the Cboe book is executed in whole or in part at a different price than the limit price on the original Add Order message or the limit order price in the latest Modify Order message referencing the Order Id. If the Remaining Quantity field contains a 0 the order should be completely removed from the book. Order Executed at Price/Size messages may also be sent in cases where the Executed Quantity is greater than the current booked size for Order Id due to Exchange features that allow a portion of an order to be hidden while another portion is displayed.
typedef struct _OrderExecutedAtPriceSizeMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT64 order_id;            // bytes 4 to 11
  UINT32 executed_quantity;   // bytes 12 to 15
  UINT32 remaining_quantity;  // bytes 16 to 19
  UINT64 execution_id;        // bytes 20 to 27
  UINT64 price_long;          // bytes 28 to 35
  UINT8 trade_condition;      // byte 36
} OrderExecutedAtPriceSizeMessage;

// Reduce Size messages are sent when a visible order on the Cboe book is partially reduced.
typedef struct _ReduceSizeLongMessage {
  UINT32 time_offset;             // bytes 0 to 3
  UINT64 order_id;                // bytes 4 to 11
  UINT32 canceled_quantity_long;  // bytes 12 to 15
} ReduceSizeLongMessage;

// Reduce Size messages are sent when a visible order on the Cboe book is partially reduced.
typedef struct _ReduceSizeShortMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT16 canceled_quantity_short;  // bytes 12 to 13
} ReduceSizeShortMessage;

// The Modify Order message is sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message. Note that Modify Order messages that appear to be No Ops (i.e. they do not appear to modify any relevant fields) will still lose priority.
typedef struct _ModifyOrderLongMessage {
  UINT32 time_offset;           // bytes 0 to 3
  UINT64 order_id;              // bytes 4 to 11
  UINT32 quantity_long;         // bytes 12 to 15
  UINT64 price_long;            // bytes 16 to 23
  UINT8 display : 1;            // byte 24
  UINT8 maintain_priority : 1;  // byte 24
  UINT8 reserved_6 : 6;         // byte 24
} ModifyOrderLongMessage;

// The Modify Order message is sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message.
typedef struct _ModifyOrderShortMessage {
  UINT32 time_offset;           // bytes 0 to 3
  UINT64 order_id;              // bytes 4 to 11
  UINT16 quantity_short;        // bytes 12 to 13
  UINT16 price_short;           // bytes 14 to 15
  UINT8 display : 1;            // byte 16
  UINT8 maintain_priority : 1;  // byte 16
  UINT8 reserved_6 : 6;         // byte 16
} ModifyOrderShortMessage;

// The Delete Order message is sent whenever a booked order is cancelled or leaves the order book. The Order Id refers to the Order Id of the original Add Order message. An order that is deleted from the book may return to the book later under certain circumstances. Therefore, a Delete Order message does not indicate that a given Order Id will not be sent again on a subsequent Add Order message.
typedef struct _DeleteOrderMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
} DeleteOrderMessage;

// The Trade message provides information about executions of non-displayed orders on the Cboe book and routed executions to other trading centers. In options a Trade message can also be sent when an auction executes against a non-displayed order, such as a contra response. Trade messages are necessary to calculate Cboe execution-based data. Trade messages do not alter the book and can be ignored if messages are being used solely to build a book. The Order ID of a hidden order is obfuscated by default in the Trade message, but may be optionally disseminated for a member's own orders upon request.
typedef struct _TradeLongMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT32 quantity_long;   // bytes 13 to 16
  UINT8 symbol[6];        // bytes 17 to 22
  UINT64 price_long;      // bytes 23 to 30
  UINT64 execution_id;    // bytes 31 to 38
  UINT8 trade_condition;  // byte 39
} TradeLongMessage;

// The Trade message provides information about executions of non-displayed orders on the Cboe book and routed executions to other trading centers. The Short variant uses a Binary Short Price and 2-byte Quantity.
typedef struct _TradeShortMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT16 quantity_short;  // bytes 13 to 14
  UINT8 symbol[6];        // bytes 15 to 20
  UINT16 price_short;     // bytes 21 to 22
  UINT64 execution_id;    // bytes 23 to 30
  UINT8 trade_condition;  // byte 31
} TradeShortMessage;

// The expanded version of the Trade message has been made available to accommodate larger symbol sizes possible through the ISRA plan.
typedef struct _TradeExpandedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT8 side_indicator;      // byte 12
  UINT32 quantity_long;      // bytes 13 to 16
  UINT8 expanded_symbol[8];  // bytes 17 to 24
  UINT64 price_long;         // bytes 25 to 32
  UINT64 execution_id;       // bytes 33 to 40
  UINT8 trade_condition;     // byte 41
} TradeExpandedMessage;

// The Trade Break message is sent whenever an execution on Cboe is broken. Trade breaks are rare and only affect applications that rely upon Cboe execution-based data. Applications that simply build a Cboe book can ignore Trade Break messages.
typedef struct _TradeBreakMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 execution_id;  // bytes 4 to 11
} TradeBreakMessage;

// The End of Session message is sent for each unit when the unit shuts down. No more sequenced messages will be delivered for this unit, but heartbeats from the unit may be received.
typedef struct _EndOfSessionMessage {
  UINT32 time_offset;  // bytes 0 to 3
} EndOfSessionMessage;

// Options Only. A Symbol Mapping message is used to map the 6 character multicast feed symbol field to an OSI symbol and Underlying. These messages are not sequenced (sequence = 0) and are sent continuously through the day at variable rates as bandwidth allows. Members who consume the 5 Gig or 8 Gig-Shaped Multicast PITCH feeds will be able to receive the full list of symbols in approximately 5 minutes.
typedef struct _SymbolMappingMessage {
  UINT8 feed_symbol[6];    // bytes 0 to 5
  UINT8 osi_symbol[21];    // bytes 6 to 26
  UINT8 symbol_condition;  // byte 27
  UINT8 underlying[8];     // bytes 28 to 35
} SymbolMappingMessage;

// The Trading Status message is used to indicate the current trading status of a security. A Trading Status message will be sent whenever a security's trading status changes. The Trading Status field will be used to represent the status of the RTH (9:30 a.m. ET - 4:15 p.m. ET) and Curb sessions. The GTH Trading Status field will be used to represent the status of series that trade during the GTH session. The GTH session runs from 8:15 p.m. to 9:25 a.m. ET for GTH-eligible Products (C1 Options Only).
typedef struct _TradingStatusMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT8 symbol[6];           // bytes 4 to 9
  UINT8 reserved_2[2];       // bytes 10 to 11
  UINT8 trading_status;      // byte 12
  UINT8 reserved_1;          // byte 13
  UINT8 gth_trading_status;  // byte 14
  UINT8 second_reserved_1;   // byte 15
} TradingStatusMessage;

// Options Only. The Width Update message is used to communicate opening quote width multiplier. This message will be sent in the event that the exchange decides to change the quote width multiplier on a per underlying basis. For complete details on the opening collars see the US Options Opening Process Specification.
typedef struct _WidthUpdateMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT8 underlying[8];  // bytes 4 to 11
  UINT8 width_type;     // byte 12
  UINT32 multiplier;    // bytes 13 to 16
} WidthUpdateMessage;

// Options Only. Options Auction Update messages are used to disseminate price and size information and Composite Market bid and offer prices during Opening and Re-Opening (halt) auctions on the Cboe Options Exchange. Options Auction Update messages are sent every five seconds during an opening period provided that one of the field values has changed. When no values have changed, a message is sent once every 60 seconds. Refer to the Cboe Options Opening Process specification for more information.
typedef struct _OptionsAuctionUpdateMessage {
  UINT32 time_offset;                   // bytes 0 to 3
  UINT8 expanded_symbol[8];             // bytes 4 to 11
  UINT8 auction_type;                   // byte 12
  UINT64 reference_price;               // bytes 13 to 20
  UINT32 buy_contracts;                 // bytes 21 to 24
  UINT32 sell_contracts;                // bytes 25 to 28
  UINT64 indicative_price;              // bytes 29 to 36
  UINT64 auction_only_price;            // bytes 37 to 44
  UINT8 opening_condition;              // byte 45
  UINT64 composite_market_bid_price;    // bytes 46 to 53
  UINT64 composite_market_offer_price;  // bytes 54 to 61
} OptionsAuctionUpdateMessage;

// Auction Summary messages are used to disseminate the results of an auction of a Cboe listed security on BZX, the results of an Opening or Re-Opening of any options series on C1, and for Periodic Auctions on BYX. Auction Summary messages are also used in support of Opening and Re-Openings on the Cboe Options Exchange, including those for both GTH and RTH sessions. These messages indicate the price and size executed in such an Opening or Re-Opening.
typedef struct _AuctionSummaryMessage {
  UINT32 time_offset;       // bytes 0 to 3
  UINT8 stock_symbol[8];    // bytes 4 to 11
  UINT8 auction_type;       // byte 12
  UINT64 price_long;        // bytes 13 to 20
  UINT32 shares_contracts;  // bytes 21 to 24
} AuctionSummaryMessage;

// C1 and EDGX Options Only. Auction Notification messages are used to disseminate order details of an auction. Auctions will be available for a defined period of time known as the exposure period.
typedef struct _AuctionNotificationMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 symbol[6];            // bytes 4 to 9
  UINT64 auction_id;          // bytes 10 to 17
  UINT8 auction_type;         // byte 18
  UINT8 side;                 // byte 19
  UINT64 price_long;          // bytes 20 to 27
  UINT32 contracts;           // bytes 28 to 31
  UINT8 customer_indicator;   // byte 32
  UINT8 participant_id[4];    // bytes 33 to 36
  UINT32 auction_end_offset;  // bytes 37 to 40
  UINT8 client_id[4];         // bytes 41 to 44
} AuctionNotificationMessage;

// C1 and EDGX Options Only. Auction Cancel messages are used to disseminate the cancelation of an earlier Auction Notification message as a result of a user cancelation of the original order, a user modification request to change the price or increase the original order quantity, a fading of the NBBO or to cancel any remaining order quantity from the original Auction Notification messages following the auction termination. A user request to modify the order price or to increase the original order quantity will result in a cancelation of the auction followed by a new Auction Notification message. Auction Cancel messages will not be issued for order quantity decrements.
typedef struct _AuctionCancelMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 auction_id;   // bytes 4 to 11
} AuctionCancelMessage;

// C1 and EDGX Options Only. Auction Trade messages are used to disseminate executions resulting from an options auction.
typedef struct _AuctionTradeMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 auction_id;    // bytes 4 to 11
  UINT64 execution_id;  // bytes 12 to 19
  UINT64 price_long;    // bytes 20 to 27
  UINT32 contracts;     // bytes 28 to 31
} AuctionTradeMessage;

// C1 Only. The SOQ Strike Range Update message is only available on the C1 Exchange. This message disseminates the minimum and maximum strike prices of the strike price range used to calculate the Special Opening Quote (SOQ) on a Volatility Settlement date. In the event that multiple distinct SOQ calculations occur on the same day, the applicable SOQ is differentiated by the SOQ Identifier field, which is set to the CSMi symbol on which the final settlement SOQ value is disseminated.
typedef struct _SoqStrikeRangeUpdateMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 soq_identifier[20];   // bytes 4 to 23
  UINT64 lower_strike_price;  // bytes 24 to 31
  UINT64 upper_strike_price;  // bytes 32 to 39
} SoqStrikeRangeUpdateMessage;

// C1 Only. The Constituent Symbol Mapping message is only available on the C1 Exchange. This message is used to communicate which options series (if any) are Constituent Series in a Volatility Settlement Special Opening Quote (SOQ). The message is identical to the Symbol Mapping message with the addition of the SOQ Identifier field, which is set to the CSMi symbol on which the final settlement SOQ value is disseminated. The Constituent Symbol Mapping message is sent as an unsequenced message with one message sent for each Constituent Series in a continuous loop as bandwidth allows.
typedef struct _ConstituentSymbolMappingMessage {
  UINT8 feed_symbol[6];      // bytes 0 to 5
  UINT8 osi_symbol[21];      // bytes 6 to 26
  UINT8 symbol_condition;    // byte 27
  UINT8 underlying[8];       // bytes 28 to 35
  UINT8 soq_identifier[20];  // bytes 36 to 55
} ConstituentSymbolMappingMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x20: TimeMessage time_message;
    case 0x97: UnitClearMessage unit_clear_message;
    case 0xBC: TransactionBeginMessage transaction_begin_message;
    case 0xBD: TransactionEndMessage transaction_end_message;
    case 0x21: AddOrderLongMessage add_order_long_message;
    case 0x22: AddOrderShortMessage add_order_short_message;
    case 0x2F: AddOrderExpandedMessage add_order_expanded_message;
    case 0x23: OrderExecutedMessage order_executed_message;
    case 0x24: OrderExecutedAtPriceSizeMessage order_executed_at_price_size_message;
    case 0x25: ReduceSizeLongMessage reduce_size_long_message;
    case 0x26: ReduceSizeShortMessage reduce_size_short_message;
    case 0x27: ModifyOrderLongMessage modify_order_long_message;
    case 0x28: ModifyOrderShortMessage modify_order_short_message;
    case 0x29: DeleteOrderMessage delete_order_message;
    case 0x2A: TradeLongMessage trade_long_message;
    case 0x2B: TradeShortMessage trade_short_message;
    case 0x30: TradeExpandedMessage trade_expanded_message;
    case 0x2C: TradeBreakMessage trade_break_message;
    case 0x2D: EndOfSessionMessage end_of_session_message;
    case 0x2E: SymbolMappingMessage symbol_mapping_message;
    case 0x31: TradingStatusMessage trading_status_message;
    case 0xD2: WidthUpdateMessage width_update_message;
    case 0xD1: OptionsAuctionUpdateMessage options_auction_update_message;
    case 0x96: AuctionSummaryMessage auction_summary_message;
    case 0xAD: AuctionNotificationMessage auction_notification_message;
    case 0xAE: AuctionCancelMessage auction_cancel_message;
    case 0xAF: AuctionTradeMessage auction_trade_message;
    case 0x9D: SoqStrikeRangeUpdateMessage soq_strike_range_update_message;
    case 0x9E: ConstituentSymbolMappingMessage constituent_symbol_mapping_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

