// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out EdgxOptions_AuctionFeed_v1_1_44.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_TIME_MESSAGE 0x20                    // Time Message
#define MESSAGE_TYPE_UNIT_CLEAR_MESSAGE 0x97              // Unit Clear Message
#define MESSAGE_TYPE_AUCTION_NOTIFICATION_MESSAGE 0xAD    // Auction Notification Message
#define MESSAGE_TYPE_AUCTION_CANCEL_MESSAGE 0xAE          // Auction Cancel Message
#define MESSAGE_TYPE_AUCTION_TRADE_MESSAGE 0xAF           // Auction Trade Message
#define MESSAGE_TYPE_OPTIONS_AUCTION_UPDATE_MESSAGE 0xD1  // Options Auction Update Message
#define MESSAGE_TYPE_AUCTION_SUMMARY_MESSAGE 0x96         // Auction Summary Message
#define MESSAGE_TYPE_WIDTH_UPDATE_MESSAGE 0xD2            // Width Update Message
#define MESSAGE_TYPE_SYMBOL_MAPPING_MESSAGE 0x2E          // Symbol Mapping Message
#define MESSAGE_TYPE_END_OF_SESSION_MESSAGE 0x2D          // End Of Session Message

// Auction Type: one byte code
#define AUCTION_TYPE_AIM 0x42                             // Aim
#define AUCTION_TYPE_SOLICITATION_AUCTION_MECHANISM 0x53  // Solicitation Auction Mechanism
#define AUCTION_TYPE_STEP_UP_MECHANISM_SUM 0x54           // Step Up Mechanism Sum
#define AUCTION_TYPE_SUM_ALL_OR_NONE 0x41                 // Sum All Or None
#define AUCTION_TYPE_GTH_OPENING 0x47                     // Gth Opening
#define AUCTION_TYPE_RTH_OPENING 0x4F                     // Rth Opening
#define AUCTION_TYPE_HALT_RE_OPENING 0x48                 // Halt Re Opening
#define AUCTION_TYPE_VOLATILITY_OPENING 0x56              // Volatility Opening

// Side: one byte code
#define SIDE_BUY_SIDE 0x42   // Buy Side
#define SIDE_SELL_SIDE 0x53  // Sell Side

// Customer Indicator: one byte code
#define CUSTOMER_INDICATOR_NON_CUSTOMER 0x4E  // Non Customer
#define CUSTOMER_INDICATOR_CUSTOMER 0x43      // Customer

// Opening Condition: one byte code
#define OPENING_CONDITION_WOULD_OPEN 0x4F                // Would Open
#define OPENING_CONDITION_NEED_QUOTE_TO_OPEN 0x51        // Need Quote To Open
#define OPENING_CONDITION_NEED_MORE_BUYERS 0x42          // Need More Buyers
#define OPENING_CONDITION_NEED_MORE_SELLERS 0x53         // Need More Sellers
#define OPENING_CONDITION_CROSSED_COMPOSITE_MARKET 0x43  // Crossed Composite Market

// Width Type: one byte code
#define WIDTH_TYPE_MAX_QUOTE_WIDTH 0x51  // Max Quote Width
#define WIDTH_TYPE_REGULAR 0x52          // Regular
#define WIDTH_TYPE_VOLATILITY 0x56       // Volatility

// Symbol Condition: one byte code
#define SYMBOL_CONDITION_NORMAL 0x4E        // Normal
#define SYMBOL_CONDITION_CLOSING_ONLY 0x43  // Closing Only

// ---- Types -------------------------------------------------------------------

// A Time message is immediately generated and sent when there is an Auction event for a given clock second. If there is no Auction event for a given clock second, then no Time message is sent for that second. All subsequent time offset fields for the same unit will use the new Time value as the base until another Time message is received for the same unit.
typedef struct _TimeMessage {
  UINT32 time;  // bytes 0 to 3
} TimeMessage;

// The Unit Clear message instructs feed recipients to clear all orders for the Cboe book in the unit specified in the Sequenced Unit Header. This message will be sent at startup each day. It would also be distributed in certain recovery events such as a data center fail-over.
typedef struct _UnitClearMessage {
  UINT32 time_offset;  // bytes 0 to 3
} UnitClearMessage;

// Auction Notification messages are used to disseminate order details of an auction. Auctions will be available for a defined period of time known as the exposure period.
typedef struct _AuctionNotificationMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 symbol[6];            // bytes 4 to 9
  UINT64 auction_id;          // bytes 10 to 17
  UINT8 auction_type;         // byte 18
  UINT8 side;                 // byte 19
  UINT64 price;               // bytes 20 to 27
  UINT32 contracts;           // bytes 28 to 31
  UINT8 customer_indicator;   // byte 32
  UINT8 participant_id[4];    // bytes 33 to 36
  UINT32 auction_end_offset;  // bytes 37 to 40
  UINT8 client_id[4];         // bytes 41 to 44
} AuctionNotificationMessage;

// Auction Cancel messages are used to disseminate the cancellation of an earlier Auction Notification message as a result of a user cancellation of the original order, a user modification request to change the price or increase the original order quantity, or a fading of the NBBO. A user request to modify the order price or to increase the original order quantity will result in a cancellation of the auction followed by a new Auction Notification message. Auction Cancel messages will not be issued for order quantity decrements.
typedef struct _AuctionCancelMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 auction_id;   // bytes 4 to 11
} AuctionCancelMessage;

// Auction Trade messages are used to disseminate executions resulting from an options auction.
typedef struct _AuctionTradeMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 auction_id;    // bytes 4 to 11
  UINT64 execution_id;  // bytes 12 to 19
  UINT64 price;         // bytes 20 to 27
  UINT32 contracts;     // bytes 28 to 31
} AuctionTradeMessage;

// Options Auction Update messages are used to disseminate price and size information and Composite Market bid and offer prices during Opening and Re-Opening (halt) auctions on the Cboe Options Exchange. Options Auction Update messages are sent every five seconds during an opening period provided that one of the field values has changed. When no values have changed, a message is sent once every 60 seconds.
typedef struct _OptionsAuctionUpdateMessage {
  UINT32 time_offset;                   // bytes 0 to 3
  UINT8 expanded_symbol[8];             // bytes 4 to 11
  UINT8 auction_type;                   // byte 12
  UINT64 reference_price;               // bytes 13 to 20
  UINT32 buy_contracts;                 // bytes 21 to 24
  UINT32 sell_contracts;                // bytes 25 to 28
  UINT64 indicative_price;              // bytes 29 to 36
  UINT64 auction_only_price;            // bytes 37 to 44
  UINT8 opening_condition;              // byte 45
  UINT64 composite_market_bid_price;    // bytes 46 to 53
  UINT64 composite_market_offer_price;  // bytes 54 to 61
} OptionsAuctionUpdateMessage;

// Auction Summary messages are used to disseminate the results of the Opening and Re-Opening process. An Opening or Re-Opening Auction Summary message for each symbol is sent at the conclusion of the Opening or Re-Opening process and represents the Cboe opening price.
typedef struct _AuctionSummaryMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT8 expanded_symbol[8];  // bytes 4 to 11
  UINT8 auction_type;        // byte 12
  UINT64 price;              // bytes 13 to 20
  UINT32 quantity;           // bytes 21 to 24
} AuctionSummaryMessage;

// The Width Update message is used to communicate opening quote width multiplier. This message will be sent in the event that the exchange decides to change the quote width multiplier on a per underlying basis.
typedef struct _WidthUpdateMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT8 underlying[8];  // bytes 4 to 11
  UINT8 width_type;     // byte 12
  UINT32 multiplier;    // bytes 13 to 16
} WidthUpdateMessage;

// A Symbol Mapping message is used to map the 6 character multicast feed symbol field to an OSI symbol. These messages are sent continuously through the day at variable rates as bandwidth allows. Members who consume the Options Auction feed will be able to receive the full list of symbols in approximately 30 minutes.
typedef struct _SymbolMappingMessage {
  UINT8 feed_symbol[6];    // bytes 0 to 5
  UINT8 osi_symbol[21];    // bytes 6 to 26
  UINT8 symbol_condition;  // byte 27
  UINT8 underlying[8];     // bytes 28 to 35
} SymbolMappingMessage;

// The End of Session message is sent for each unit when the unit shuts down. No more auction messages will be delivered for this unit, but heartbeats from the unit may be received.
typedef struct _EndOfSessionMessage {
  UINT32 time_offset;  // bytes 0 to 3
} EndOfSessionMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x20: TimeMessage time_message;
    case 0x97: UnitClearMessage unit_clear_message;
    case 0xAD: AuctionNotificationMessage auction_notification_message;
    case 0xAE: AuctionCancelMessage auction_cancel_message;
    case 0xAF: AuctionTradeMessage auction_trade_message;
    case 0xD1: OptionsAuctionUpdateMessage options_auction_update_message;
    case 0x96: AuctionSummaryMessage auction_summary_message;
    case 0xD2: WidthUpdateMessage width_update_message;
    case 0x2E: SymbolMappingMessage symbol_mapping_message;
    case 0x2D: EndOfSessionMessage end_of_session_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

