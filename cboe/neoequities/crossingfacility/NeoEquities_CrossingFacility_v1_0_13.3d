// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NeoEquities_CrossingFacility_v1_0_13.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_UNIT_CLEAR_MESSAGE 0x97            // Unit Clear Message
#define MESSAGE_TYPE_INSTRUMENT_DIRECTORY_MESSAGE 0x60  // Instrument Directory Message
#define MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x61        // Trading Status Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x67                 // Trade Message
#define MESSAGE_TYPE_TRADE_BREAK_MESSAGE 0x68           // Trade Break Message
#define MESSAGE_TYPE_TRADE_CORRECTION_MESSAGE 0x69      // Trade Correction Message
#define MESSAGE_TYPE_END_OF_SESSION_MESSAGE 0x2D        // End Of Session Message

// Security Type: one byte code
#define SECURITY_TYPE_EQUITY 0x01                   // Equity
#define SECURITY_TYPE_DEBT 0x02                     // Debt
#define SECURITY_TYPE_CLOSED_END_FUND 0x03          // Closed End Fund
#define SECURITY_TYPE_DEPOSITARY_RECEIPT 0x04       // Depositary Receipt
#define SECURITY_TYPE_EXCHANGE_TRADED_FUND 0x05     // Exchange Traded Fund
#define SECURITY_TYPE_FOREIGN_LISTED_SECURITY 0x06  // Foreign Listed Security
#define SECURITY_TYPE_STRUCTURED_PRODUCT 0x07       // Structured Product
#define SECURITY_TYPE_UNIT 0x08                     // Unit
#define SECURITY_TYPE_WARRANT 0x09                  // Warrant
#define SECURITY_TYPE_UNLISTED_SECURITY 0x34        // Unlisted Security

// Order Book Type: one byte code
#define ORDER_BOOK_TYPE_ALL_BOOKS 0x00          // All Books
#define ORDER_BOOK_TYPE_NEO_L 0x03              // Neo L
#define ORDER_BOOK_TYPE_NEO_N 0x04              // Neo N
#define ORDER_BOOK_TYPE_NEO_D 0x05              // Neo D
#define ORDER_BOOK_TYPE_CROSSING_FACILITY 0x06  // Crossing Facility
#define ORDER_BOOK_TYPE_SST 0x07                // Sst

// Trading Status: one byte code
#define TRADING_STATUS_ACCEPTING 0x41          // Accepting
#define TRADING_STATUS_HALTED_FULL 0x46        // Halted Full
#define TRADING_STATUS_HALTED 0x48             // Halted
#define TRADING_STATUS_DELAYED_CLOSING 0x4D    // Delayed Closing
#define TRADING_STATUS_PRE_CLOSE 0x4F          // Pre Close
#define TRADING_STATUS_POST_CLOSE 0x50         // Post Close
#define TRADING_STATUS_TRADING_SUSPENDED 0x53  // Trading Suspended
#define TRADING_STATUS_TRADING 0x54            // Trading
#define TRADING_STATUS_EXTENDED_TRADING 0x58   // Extended Trading

// Trading Sub Status: one byte code
#define TRADING_SUB_STATUS_NONE 0x20                               // None
#define TRADING_SUB_STATUS_CLOSING_OFFSET 0x43                     // Closing Offset
#define TRADING_SUB_STATUS_DELAYED 0x44                            // Delayed
#define TRADING_SUB_STATUS_IMBALANCE 0x49                          // Imbalance
#define TRADING_SUB_STATUS_HALT_LIFT_SCHEDULE_FOR_OPENING 0x4F     // Halt Lift Schedule For Opening
#define TRADING_SUB_STATUS_HALT_LIFT_SCHEDULE_FOR_RE_OPENING 0x52  // Halt Lift Schedule For Re Opening

// Halt Reason: one byte code
#define HALT_REASON_NONE 0x20                 // None
#define HALT_REASON_BUSINESS 0x42             // Business
#define HALT_REASON_CEASE_TRADING_ORDER 0x43  // Cease Trading Order
#define HALT_REASON_IPO 0x49                  // Ipo
#define HALT_REASON_REGULATORY 0x52           // Regulatory
#define HALT_REASON_SUSPENSION 0x53           // Suspension

// Cross Type: one byte code
#define CROSS_TYPE_NONE 0x00                       // None
#define CROSS_TYPE_INTERNAL_CROSS 0x05             // Internal Cross
#define CROSS_TYPE_BASIS_CROSS 0x0B                // Basis Cross
#define CROSS_TYPE_CONTINGENT_CROSS 0x0C           // Contingent Cross
#define CROSS_TYPE_VWAP_CROSS 0x0E                 // Vwap Cross
#define CROSS_TYPE_REGULAR_CROSS 0x0F              // Regular Cross
#define CROSS_TYPE_DERIVATIVE_CROSS 0x12           // Derivative Cross
#define CROSS_TYPE_CLOSING_PRICE_PUBLICATION 0x13  // Closing Price Publication
#define CROSS_TYPE_NET_ASSET_VALUE_NAV 0x14        // Net Asset Value Nav

// Settlement Type: one byte code
#define SETTLEMENT_TYPE_NO_SPECIAL_SETTLEMENT_TERMS_SPECIFIED 0x00  // No Special Settlement Terms Specified
#define SETTLEMENT_TYPE_CASH 0x01                                   // Cash
#define SETTLEMENT_TYPE_FUTURE 0x06                                 // Future
#define SETTLEMENT_TYPE_NON_NET 0x0B                                // Non Net

// ---- Types -------------------------------------------------------------------

// Instructs feed recipients to clear all orders for the Cboe Canada order book in the unit specified in the Sequenced Unit Header. Distributed in rare recovery events such as a data center fail-over.
typedef struct _UnitClearMessage {
  UINT8 reserved_4[4];  // bytes 0 to 3
} UnitClearMessage;

// Disseminates information for each symbol. A separate Trading Status message indicates the status of each symbol. If no Trading Status message is received for a symbol, it is assumed to be Suspended.
typedef struct _InstrumentDirectoryMessage {
  UINT64 timestamp;             // bytes 0 to 7
  UINT8 unused_3 : 3;           // byte 8
  UINT8 neo_l : 1;              // byte 8
  UINT8 neo_n : 1;              // byte 8
  UINT8 neo_d : 1;              // byte 8
  UINT8 crossing_facility : 1;  // byte 8
  UINT8 sst : 1;                // byte 8
  UINT8 symbol[14];             // bytes 9 to 22
  UINT8 segment[6];             // bytes 23 to 28
  UINT8 currency[3];            // bytes 29 to 31
  UINT32 lot_size;              // bytes 32 to 35
  UINT8 full_name[120];         // bytes 36 to 155
  UINT16 active_market_maker;   // bytes 156 to 157
  UINT8 security_type;          // byte 158
  UINT8 odd_lot_allowed : 1;    // byte 159
  UINT8 closing_eligible : 1;   // byte 159
  UINT8 unused_6 : 6;           // byte 159
  UINT64 previous_close;        // bytes 160 to 167
} InstrumentDirectoryMessage;

// Indicates the current trading status of a security on the Cboe Canada NEO system. Sequenced Trading Status messages are sent upon system startup for all active securities with Trading Status = S (suspended).
typedef struct _TradingStatusMessage {
  UINT64 timestamp;          // bytes 0 to 7
  UINT8 order_book_type;     // byte 8
  UINT8 symbol[14];          // bytes 9 to 22
  UINT8 trading_status;      // byte 23
  UINT8 trading_sub_status;  // byte 24
  UINT8 halt_reason;         // byte 25
} TradingStatusMessage;

// Provides information about executions of orders not displayed on any Cboe Canada trading book. Trade messages may also provide information about displayed orders that are traded at a price other than their displayed price. Trade messages do not alter the book and can be ignored if messages are being used solely to build a book.
typedef struct _TradeMessage {
  UINT64 timestamp;        // bytes 0 to 7
  UINT8 order_book_type;   // byte 8
  UINT8 symbol[14];        // bytes 9 to 22
  UINT32 quantity;         // bytes 23 to 26
  UINT64 price;            // bytes 27 to 34
  UINT64 execution_id;     // bytes 35 to 42
  UINT16 buy_broker_id;    // bytes 43 to 44
  UINT16 sell_broker_id;   // bytes 45 to 46
  UINT8 cross_type;        // byte 47
  UINT8 bypass : 1;        // byte 48
  UINT8 auction : 1;       // byte 48
  UINT8 unused_6 : 6;      // byte 48
  UINT8 settlement_type;   // byte 49
  UINT32 settlement_date;  // bytes 50 to 53
  UINT8 reserved_1;        // byte 54
} TradeMessage;

// Sent whenever an execution on Cboe Canada NEO is cancelled. Applications that simply build a Cboe Canada NEO book can ignore Trade Break messages.
typedef struct _TradeBreakMessage {
  UINT64 timestamp;          // bytes 0 to 7
  UINT8 order_book_type;     // byte 8
  UINT8 symbol[14];          // bytes 9 to 22
  UINT32 original_quantity;  // bytes 23 to 26
  UINT64 original_price;     // bytes 27 to 34
  UINT64 execution_id;       // bytes 35 to 42
} TradeBreakMessage;

// Sent whenever an execution on Cboe Canada NEO is corrected. Applications that simply build a Cboe Canada NEO book can ignore Trade Correction messages.
typedef struct _TradeCorrectionMessage {
  UINT64 timestamp;                  // bytes 0 to 7
  UINT8 order_book_type;             // byte 8
  UINT8 symbol[14];                  // bytes 9 to 22
  UINT32 original_quantity;          // bytes 23 to 26
  UINT64 original_price;             // bytes 27 to 34
  UINT8 original_settlement_type;    // byte 35
  UINT32 original_settlement_date;   // bytes 36 to 39
  UINT32 corrected_quantity;         // bytes 40 to 43
  UINT64 corrected_price;            // bytes 44 to 51
  UINT8 corrected_settlement_type;   // byte 52
  UINT32 corrected_settlement_date;  // bytes 53 to 56
  UINT64 execution_id;               // bytes 57 to 64
} TradeCorrectionMessage;

// Sent for each unit when the unit shuts down. No additional sequenced messages will be delivered for this unit, but heartbeats from the unit may be received.
typedef struct _EndOfSessionMessage {
  UINT8 reserved_4[4];  // bytes 0 to 3
} EndOfSessionMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x97: UnitClearMessage unit_clear_message;
    case 0x60: InstrumentDirectoryMessage instrument_directory_message;
    case 0x61: TradingStatusMessage trading_status_message;
    case 0x67: TradeMessage trade_message;
    case 0x68: TradeBreakMessage trade_break_message;
    case 0x69: TradeCorrectionMessage trade_correction_message;
    case 0x2D: EndOfSessionMessage end_of_session_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

