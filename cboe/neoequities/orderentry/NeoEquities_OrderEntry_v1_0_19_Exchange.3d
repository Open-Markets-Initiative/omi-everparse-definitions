#define EXCHANGE_MESSAGE_TYPE_ORDER_RESTATED_CA_EQUITIES_V_1 0x1969         // Order Restated Ca Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_EXECUTION_CA_EQUITIES_V_1 0x196A        // Order Execution Ca Equities V 1
