// ---- Types -------------------------------------------------------------------

// Unit Sequence
typedef struct _UnitSequence {
  UINT8 unit_number;       // byte 0
  UINT32 sequence_number;  // bytes 1 to 4
} UnitSequence;

// A Login Response message is sent in response to a Login Request message
typedef struct _LoginResponseMessage {
  UINT8 login_response_status;                                              // byte 0
  UINT8 login_response_text[60];                                            // bytes 1 to 60
  UINT32 client_sequence;                                                   // bytes 61 to 64
  UINT8 number_of_units;                                                    // byte 65
  UnitSequence unit_sequence[:byte-size (((UINT32) number_of_units) * 5)];
} LoginResponseMessage;

// A Logout Response is usually sent in response to a Logout Request
typedef struct _LogoutResponseMessage {
  UINT8 logout_reason;           // byte 0
  UINT8 logout_reason_text[60];  // bytes 1 to 60
} LogoutResponseMessage;

// Order Acknowledgement sent in response to a New Order message
typedef struct _OrderAcknowledgementCaEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 account[16];               // bytes 8 to 23
  UINT8 cl_ord_id[20];             // bytes 24 to 43
  UINT16 broker_id;                // bytes 44 to 45
  UINT64 order_id;                 // bytes 46 to 53
  UINT8 exec_inst;                 // byte 54
  UINT32 order_qty;                // bytes 55 to 58
  UINT8 ord_type;                  // byte 59
  UINT64 price;                    // bytes 60 to 67, signed, read here as unsigned
  UINT64 stop_px;                  // bytes 68 to 75, signed, read here as unsigned
  UINT64 working_price;            // bytes 76 to 83, signed, read here as unsigned
  UINT8 side;                      // byte 84
  UINT8 short_marking_exempt;      // byte 85
  UINT8 symbol[14];                // bytes 86 to 99
  UINT8 time_in_force;             // byte 100
  UINT32 max_floor;                // bytes 101 to 104
  UINT64 expire_time;              // bytes 105 to 112
  UINT8 ex_destination;            // byte 113
  UINT8 no_trade_feat;             // byte 114
  UINT8 no_trade_key[6];           // bytes 115 to 120
  UINT8 base_liquidity_indicator;  // byte 121
  UINT32 true_min_qty;             // bytes 122 to 125
  UINT32 expire_date;              // bytes 126 to 129
} OrderAcknowledgementCaEquitiesV1;

// Order Rejected message sent in response to a New Order or New Order Cross that must be rejected
typedef struct _OrderRejectedCaEquitiesV1 {
  UINT64 transaction_time;    // bytes 0 to 7
  UINT8 cl_ord_id[20];        // bytes 8 to 27
  UINT16 broker_id;           // bytes 28 to 29
  UINT8 order_reject_reason;  // byte 30
  UINT8 text[60];             // bytes 31 to 90
} OrderRejectedCaEquitiesV1;

// Order Modified message sent in response to a Modify Order indicating successful modification
typedef struct _OrderModifiedCaEquitiesV1 {
  UINT64 transaction_time;                  // bytes 0 to 7
  UINT8 cl_ord_id[20];                      // bytes 8 to 27
  UINT16 broker_id;                         // bytes 28 to 29
  UINT64 order_id;                          // bytes 30 to 37
  UINT8 account[16];                        // bytes 38 to 53
  UINT8 time_in_force;                      // byte 54
  UINT32 max_floor;                         // bytes 55 to 58
  UINT32 expire_date;                       // bytes 59 to 62
  UINT8 lei_order_origin;                   // byte 63
  UINT8 lei_routing_arrangement_indicator;  // byte 64
  UINT8 umir_account_type;                  // byte 65
  UINT8 lei_customer_account[20];           // bytes 66 to 85
  UINT8 lei_algorithm_id[20];               // bytes 86 to 105
  UINT8 customer_lei[52];                   // bytes 106 to 157
  UINT8 broker_lei[20];                     // bytes 158 to 177
  UINT32 order_qty;                         // bytes 178 to 181
  UINT8 orig_cl_ord_id[20];                 // bytes 182 to 201
  UINT32 leaves_qty;                        // bytes 202 to 205
  UINT64 price;                             // bytes 206 to 213, signed, read here as unsigned
  UINT64 stop_px;                           // bytes 214 to 221, signed, read here as unsigned
  UINT32 true_min_qty;                      // bytes 222 to 225
  UINT64 secondary_order_id;                // bytes 226 to 233
  UINT64 expire_time;                       // bytes 234 to 241
} OrderModifiedCaEquitiesV1;

// Modify Rejected message sent in response to a Modify Order that cannot be modified
typedef struct _ModifyRejectedCaEquitiesV1 {
  UINT64 transaction_time;     // bytes 0 to 7
  UINT8 cl_ord_id[20];         // bytes 8 to 27
  UINT16 broker_id;            // bytes 28 to 29
  UINT8 orig_cl_ord_id[20];    // bytes 30 to 49
  UINT8 text[60];              // bytes 50 to 109
  UINT8 modify_reject_reason;  // byte 110
} ModifyRejectedCaEquitiesV1;

// Order Restated message sent when iceberg order reloads or when self-trade protection reduces an order
typedef struct _OrderRestatedCaEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 cl_ord_id[20];             // bytes 8 to 27
  UINT16 broker_id;                // bytes 28 to 29
  UINT64 order_id;                 // bytes 30 to 37
  UINT32 order_qty;                // bytes 38 to 41
  UINT32 leaves_qty;               // bytes 42 to 45
  UINT64 secondary_order_id;       // bytes 46 to 53
  UINT64 last_px;                  // bytes 54 to 61, signed, read here as unsigned
  UINT32 last_shares;              // bytes 62 to 65
  UINT8 base_liquidity_indicator;  // byte 66
  UINT64 price;                    // bytes 67 to 74, signed, read here as unsigned
  UINT32 true_min_qty;             // bytes 75 to 78
  UINT8 restatement_reason;        // byte 79
} OrderRestatedCaEquitiesV1;

// Order Execution message sent for each fill on an order
typedef struct _OrderExecutionCaEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 cl_ord_id[20];             // bytes 8 to 27
  UINT64 exec_id;                  // bytes 28 to 35
  UINT64 last_px;                  // bytes 36 to 43, signed, read here as unsigned
  UINT32 last_shares;              // bytes 44 to 47
  UINT64 order_id;                 // bytes 48 to 55
  UINT8 side;                      // byte 56
  UINT8 symbol[14];                // bytes 57 to 70
  UINT32 trade_date;               // bytes 71 to 74
  UINT32 leaves_qty;               // bytes 75 to 78
  UINT16 contra_broker;            // bytes 79 to 80
  UINT8 base_liquidity_indicator;  // byte 81
  UINT16 broker_id;                // bytes 82 to 83
  UINT8 principal_trade;           // byte 84
  UINT8 wash_trade;                // byte 85
  UINT8 no_trade_feat;             // byte 86
  UINT8 no_trade_key[6];           // bytes 87 to 92
  UINT8 short_marking_exempt;      // byte 93
  UINT8 matching_priority;         // byte 94
  UINT8 is_self_trade;             // byte 95
  UINT8 fee_code[2];               // bytes 96 to 97
  UINT8 ex_destination;            // byte 98
} OrderExecutionCaEquitiesV1;

// Order Cancelled message
typedef struct _OrderCancelledCaEquitiesV1 {
  UINT64 transaction_time;  // bytes 0 to 7
  UINT8 cl_ord_id[20];      // bytes 8 to 27
  UINT16 broker_id;         // bytes 28 to 29
  UINT8 cancel_reason;      // byte 30
} OrderCancelledCaEquitiesV1;

// Cancel Rejected message sent when a Cancel Order cancellation cannot occur
typedef struct _CancelRejectedCaEquitiesV1 {
  UINT64 transaction_time;     // bytes 0 to 7
  UINT8 cl_ord_id[20];         // bytes 8 to 27
  UINT16 broker_id;            // bytes 28 to 29
  UINT8 text[60];              // bytes 30 to 89
  UINT8 cancel_reject_reason;  // byte 90
} CancelRejectedCaEquitiesV1;

// Carried Restatement message used to indicate restoration of a multi-day GTC or GTD order at the start of a new business day
typedef struct _CarriedRestatementCaEquitiesV1 {
  UINT64 transaction_time;                  // bytes 0 to 7
  UINT64 order_id;                          // bytes 8 to 15
  UINT8 account[16];                        // bytes 16 to 31
  UINT8 cl_ord_id[20];                      // bytes 32 to 51
  UINT16 broker_id;                         // bytes 52 to 53
  UINT8 exec_inst;                          // byte 54
  UINT8 handling_inst;                      // byte 55
  UINT32 order_qty;                         // bytes 56 to 59
  UINT32 cum_qty;                           // bytes 60 to 63
  UINT32 leaves_qty;                        // bytes 64 to 67
  UINT8 ord_type;                           // byte 68
  UINT64 price;                             // bytes 69 to 76, signed, read here as unsigned
  UINT64 stop_px;                           // bytes 77 to 84, signed, read here as unsigned
  UINT8 side;                               // byte 85
  UINT8 symbol[14];                         // bytes 86 to 99
  UINT8 time_in_force;                      // byte 100
  UINT8 settlement_type;                    // byte 101
  UINT32 fut_settl_date;                    // bytes 102 to 105
  UINT8 ex_destination;                     // byte 106
  UINT32 max_floor;                         // bytes 107 to 110
  UINT32 expire_date;                       // bytes 111 to 114
  UINT8 lei_order_origin;                   // byte 115
  UINT8 lei_routing_arrangement_indicator;  // byte 116
  UINT8 umir_account_type;                  // byte 117
  UINT8 umir_user_id[12];                   // bytes 118 to 129
  UINT32 basket_trade;                      // bytes 130 to 133
  UINT8 program_trade;                      // byte 134
  UINT16 jitney;                            // bytes 135 to 136
  UINT8 anonymous;                          // byte 137
  UINT8 umir_regulation_id;                 // byte 138
  UINT8 non_resident;                       // byte 139
  UINT8 bypass;                             // byte 140
  UINT8 ncib;                               // byte 141
  UINT8 short_marking_exempt;               // byte 142
  UINT8 lei_customer_account[20];           // bytes 143 to 162
  UINT8 lei_algorithm_id[20];               // bytes 163 to 182
  UINT8 customer_lei[52];                   // bytes 183 to 234
  UINT8 broker_lei[20];                     // bytes 235 to 254
  UINT8 routing_inst;                       // byte 255
  UINT8 display_indicator;                  // byte 256
  UINT8 matching_state_participation;       // byte 257
  UINT32 true_min_qty;                      // bytes 258 to 261
} CarriedRestatementCaEquitiesV1;

// Done For Day message representing orders persisted during the current day session to carry over to the next session
typedef struct _DoneForDayCaEquitiesV1 {
  UINT64 transaction_time;  // bytes 0 to 7
  UINT8 cl_ord_id[20];      // bytes 8 to 27
  UINT16 broker_id;         // bytes 28 to 29
  UINT8 symbol_short[8];    // bytes 30 to 37
} DoneForDayCaEquitiesV1;

// Trade Cancel or Correct notification that a trade has been busted or corrected
typedef struct _TradeCancelCorrectCaEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 account[16];               // bytes 8 to 23
  UINT8 cl_ord_id[20];             // bytes 24 to 43
  UINT64 exec_id;                  // bytes 44 to 51
  UINT64 exec_ref_id;              // bytes 52 to 59
  UINT64 last_px;                  // bytes 60 to 67, signed, read here as unsigned
  UINT32 last_shares;              // bytes 68 to 71
  UINT8 side;                      // byte 72
  UINT8 symbol[14];                // bytes 73 to 86
  UINT8 base_liquidity_indicator;  // byte 87
  UINT32 corrected_size;           // bytes 88 to 91
  UINT8 umir_user_id[12];          // bytes 92 to 103
  UINT64 corrected_price;          // bytes 104 to 111, signed, read here as unsigned
  UINT8 fee_code[2];               // bytes 112 to 113
  UINT8 settlement_type;           // byte 114
  UINT32 fut_settl_date;           // bytes 115 to 118
} TradeCancelCorrectCaEquitiesV1;

// Branch
casetype _ExchangeMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x01F5: LoginResponseMessage login_response_message;
    case 0x01F6: unit replay_complete;
    case 0x01F7: LogoutResponseMessage logout_response_message;
    case 0x01F8: unit server_heartbeat;
    case 0x1965: OrderAcknowledgementCaEquitiesV1 order_acknowledgement_ca_equities_v_1;
    case 0x1966: OrderRejectedCaEquitiesV1 order_rejected_ca_equities_v_1;
    case 0x1967: OrderModifiedCaEquitiesV1 order_modified_ca_equities_v_1;
    case 0x1968: ModifyRejectedCaEquitiesV1 modify_rejected_ca_equities_v_1;
    case 0x1969: OrderRestatedCaEquitiesV1 order_restated_ca_equities_v_1;
    case 0x196A: OrderExecutionCaEquitiesV1 order_execution_ca_equities_v_1;
    case 0x196B: OrderCancelledCaEquitiesV1 order_cancelled_ca_equities_v_1;
    case 0x196C: CancelRejectedCaEquitiesV1 cancel_rejected_ca_equities_v_1;
    case 0x196E: CarriedRestatementCaEquitiesV1 carried_restatement_ca_equities_v_1;
    case 0x196F: DoneForDayCaEquitiesV1 done_for_day_ca_equities_v_1;
    case 0x1970: TradeCancelCorrectCaEquitiesV1 trade_cancel_correct_ca_equities_v_1;
    default: UINT8 unknown[available];
  }
} ExchangeMessage;

// ---- Packet: ExchangePacket --------------------------------------------------

// Binary Order Entry Tcp Packet sent by the exchange
entrypoint typedef struct _ExchangePacket (UINT32 available) where (available >= 12) {
  UINT16 start_of_message;                                                                                                      // bytes 0 to 1
  UINT16 message_length;                                                                                                        // bytes 2 to 3
  UINT16 exchange_message_type;                                                                                                 // bytes 4 to 5
  UINT8 matching_unit;                                                                                                          // byte 6
  UINT8 reserved_field;                                                                                                         // byte 7
  UINT32 sequence_number;                                                                                                       // bytes 8 to 11
  ExchangeMessage(exchange_message_type, (available - 12)) exchange_message[:byte-size-single-element-array (available - 12)];
} ExchangePacket;

