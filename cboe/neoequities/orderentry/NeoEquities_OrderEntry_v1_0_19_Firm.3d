// Request to modify an existing order
typedef struct _ModifyOrderCaEquitiesV1 {
  UINT8 cl_ord_id[20];                      // bytes 0 to 19
  UINT8 orig_cl_ord_id[20];                 // bytes 20 to 39
  UINT16 broker_id;                         // bytes 40 to 41
  UINT8 account[16];                        // bytes 42 to 57
  UINT32 order_qty;                         // bytes 58 to 61
  UINT64 price;                             // bytes 62 to 69, signed, read here as unsigned
  UINT64 stop_px;                           // bytes 70 to 77, signed, read here as unsigned
  UINT8 time_in_force;                      // byte 78
  UINT32 max_floor;                         // bytes 79 to 82
  UINT32 expire_date;                       // bytes 83 to 86
  UINT8 lei_order_origin;                   // byte 87
  UINT8 lei_routing_arrangement_indicator;  // byte 88
  UINT8 umir_account_type;                  // byte 89
  UINT8 lei_customer_account[20];           // bytes 90 to 109
  UINT8 lei_algorithm_id[20];               // bytes 110 to 129
  UINT8 customer_lei[52];                   // bytes 130 to 181
  UINT8 broker_lei[20];                     // bytes 182 to 201
  UINT8 cancel_orig_on_reject;              // byte 202
  UINT32 true_min_qty;                      // bytes 203 to 206
  UINT64 expire_time;                       // bytes 207 to 214
} ModifyOrderCaEquitiesV1;

// Request to cancel a single order
typedef struct _CancelOrderCaEquitiesV1 {
  UINT16 broker_id;          // bytes 0 to 1
  UINT8 orig_cl_ord_id[20];  // bytes 2 to 21
} CancelOrderCaEquitiesV1;

