// Firm Message Type: 2 byte code
#define FIRM_MESSAGE_TYPE_LOGIN_REQUEST_MESSAGE 0x0001            // Login Request Message
#define FIRM_MESSAGE_TYPE_LOGOUT_REQUEST_MESSAGE 0x0002           // Logout Request Message
#define FIRM_MESSAGE_TYPE_CLIENT_HEARTBEAT_MESSAGE 0x0003         // Client Heartbeat Message
#define FIRM_MESSAGE_TYPE_NEW_ORDER_CA_EQUITIES_V_1 0x1771        // New Order Ca Equities V 1
#define FIRM_MESSAGE_TYPE_NEW_ORDER_CA_EQUITIES_V_2 0x1776        // New Order Ca Equities V 2
#define FIRM_MESSAGE_TYPE_MODIFY_ORDER_CA_EQUITIES_V_1 0x1772     // Modify Order Ca Equities V 1
#define FIRM_MESSAGE_TYPE_CANCEL_ORDER_CA_EQUITIES_V_1 0x1773     // Cancel Order Ca Equities V 1
#define FIRM_MESSAGE_TYPE_NEW_ORDER_CROSS_CA_EQUITIES_V_1 0x1774  // New Order Cross Ca Equities V 1
#define FIRM_MESSAGE_TYPE_NEW_ORDER_CROSS_CA_EQUITIES_V_2 0x1775  // New Order Cross Ca Equities V 2

// Replay Unspecified Unit: one byte code
#define REPLAY_UNSPECIFIED_UNIT_FAIL_IF_UNIT_NOT_SPECIFIED 0x46             // Fail If Unit Not Specified
#define REPLAY_UNSPECIFIED_UNIT_REPLAY_ANY_UNSPECIFIED_UNIT_FROM_ZERO 0x52  // Replay Any Unspecified Unit From Zero
#define REPLAY_UNSPECIFIED_UNIT_SKIP_REPLAY_OF_UNSPECIFIED_UNITS 0x53       // Skip Replay Of Unspecified Units

// Exec Inst: one byte code
#define EXEC_INST_TRADE_AT_THE_PNBBO_MIDPOINT_ONLY 0x4D                                                  // Trade At The Pnbbo Midpoint Only
#define EXEC_INST_TRADE_AT_THE_NEAR_SIDE_PNBBO 0x52                                                      // Trade At The Near Side Pnbbo
#define EXEC_INST_TRADE_AT_THE_LESS_AGGRESSIVE_OF_PNBBO_MIDPOINT_OR_MINIMUM_IMPROVEMENT_FRO_ti5qve 0x70  // Trade At The Less Aggressive Of Pnbbo Midpoint Or Minimum Improvement From The Pnbbo
#define EXEC_INST_LATE_USED_WITH_TIME_IN_FORCE_7_TO_ENTER_A_LATE_LIMIT_ON_CLOSE_LLOC 0x72                // Late Used With Time In Force 7 To Enter A Late Limit On Close Lloc

// Handling Inst: one byte code
#define HANDLING_INST_DIRECT_ACTION_ORDER_DAO 0x31  // Direct Action Order Dao
#define HANDLING_INST_PROTECT_AND_CANCEL 0x35       // Protect And Cancel
#define HANDLING_INST_PROTECT_AND_REPRICE 0x36      // Protect And Reprice

// Ord Type: one byte code
#define ORD_TYPE_MARKET 0x31      // Market
#define ORD_TYPE_LIMIT 0x32       // Limit
#define ORD_TYPE_STOP 0x33        // Stop
#define ORD_TYPE_STOP_LIMIT 0x34  // Stop Limit
#define ORD_TYPE_PEGGED 0x50      // Pegged

// Side: one byte code
#define SIDE_BUY 0x31         // Buy
#define SIDE_SELL 0x32        // Sell
#define SIDE_SELL_SHORT 0x35  // Sell Short

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY 0x30                                  // Day
#define TIME_IN_FORCE_GOOD_TIL_CANCEL_GTC 0x31                  // Good Til Cancel Gtc
#define TIME_IN_FORCE_AT_THE_OPEN_OPG 0x32                      // At The Open Opg
#define TIME_IN_FORCE_IMMEDIATE_OR_CANCEL_IOC 0x33              // Immediate Or Cancel Ioc
#define TIME_IN_FORCE_FILL_OR_KILL_FOK 0x34                     // Fill Or Kill Fok
#define TIME_IN_FORCE_GOOD_TIL_DATE_GTD_GOOD_TIL_TIME_GTT 0x36  // Good Til Date Gtd Good Til Time Gtt
#define TIME_IN_FORCE_AT_THE_CLOSE_ATC 0x37                     // At The Close Atc
#define TIME_IN_FORCE_REGULAR_HOURS_ONLY_RHO 0x52               // Regular Hours Only Rho

// Settlement Type: one byte code
#define SETTLEMENT_TYPE_CASH 0x01     // Cash
#define SETTLEMENT_TYPE_FUTURE 0x06   // Future
#define SETTLEMENT_TYPE_NON_NET 0x0B  // Non Net

// Ex Destination: one byte code
#define EX_DESTINATION_CROSSING_FACILITY 0x43  // Crossing Facility
#define EX_DESTINATION_NEO_D 0x44              // Neo D
#define EX_DESTINATION_NEO_L 0x4C              // Neo L
#define EX_DESTINATION_NEO_N 0x4E              // Neo N
#define EX_DESTINATION_SST 0x53                // Sst

// Lei Order Origin: one byte code
#define LEI_ORDER_ORIGIN_DIRECT_ACCESS_CLIENT 0x05          // Direct Access Client
#define LEI_ORDER_ORIGIN_FOREIGN_DEALER_EQUIVALENT 0x06     // Foreign Dealer Equivalent
#define LEI_ORDER_ORIGIN_ORDER_EXECUTION_ONLY_SERVICE 0x07  // Order Execution Only Service

// Lei Routing Arrangement Indicator: one byte code
#define LEI_ROUTING_ARRANGEMENT_INDICATOR_NO 0x4E   // No
#define LEI_ROUTING_ARRANGEMENT_INDICATOR_YES 0x59  // Yes

// Umir Account Type: one byte code
#define UMIR_ACCOUNT_TYPE_INVENTORY 0x49             // Inventory
#define UMIR_ACCOUNT_TYPE_NON_CLIENT 0x4E            // Non Client
#define UMIR_ACCOUNT_TYPE_CLIENT 0x43                // Client
#define UMIR_ACCOUNT_TYPE_SPECIALIST 0x53            // Specialist
#define UMIR_ACCOUNT_TYPE_OPTIONS_FIRM_ACCOUNT 0x46  // Options Firm Account
#define UMIR_ACCOUNT_TYPE_OPTIONS_MARKET_MAKER 0x4D  // Options Market Maker
#define UMIR_ACCOUNT_TYPE_BUNDLED 0x42               // Bundled
#define UMIR_ACCOUNT_TYPE_MULTI_CLIENT 0x58          // Multi Client

// Program Trade: one byte code
#define PROGRAM_TRADE_YES 0x59  // Yes
#define PROGRAM_TRADE_NO 0x4E   // No

// Anonymous: one byte code
#define ANONYMOUS_YES 0x59  // Yes
#define ANONYMOUS_NO 0x4E   // No

// Umir Regulation Id: one byte code
#define UMIR_REGULATION_ID_SIGNIFICANT_SHAREHOLDER 0x53  // Significant Shareholder
#define UMIR_REGULATION_ID_INSIDER 0x49                  // Insider

// Non Resident: one byte code
#define NON_RESIDENT_YES 0x59  // Yes
#define NON_RESIDENT_NO 0x4E   // No

// Bypass: one byte code
#define BYPASS_YES 0x59  // Yes
#define BYPASS_NO 0x4E   // No

// Ncib: one byte code
#define NCIB_YES 0x59  // Yes
#define NCIB_NO 0x4E   // No

// No Trade Feat: one byte code
#define NO_TRADE_FEAT_SUPPRESS_FROM_TAPE 0x54               // Suppress From Tape
#define NO_TRADE_FEAT_CANCEL_NEWEST 0x4E                    // Cancel Newest
#define NO_TRADE_FEAT_CANCEL_OLDEST 0x4F                    // Cancel Oldest
#define NO_TRADE_FEAT_DECREMENT_LARGER_CANCEL_SMALLER 0x44  // Decrement Larger Cancel Smaller
#define NO_TRADE_FEAT_NO_SELF_TRADE_PROTECTION 0x55         // No Self Trade Protection

// Short Marking Exempt: one byte code
#define SHORT_MARKING_EXEMPT_SHORT_MARKET_EXEMPT 0x30                                      // Short Market Exempt
#define SHORT_MARKING_EXEMPT_BUY_OF_A_NEW_ORDER_CROSS_IS_SHORT_MARKING_EXEMPT 0x31         // Buy Of A New Order Cross Is Short Marking Exempt
#define SHORT_MARKING_EXEMPT_SELL_OF_A_NEW_ORDER_CROSS_IS_SHORT_MARKING_EXEMPT 0x32        // Sell Of A New Order Cross Is Short Marking Exempt
#define SHORT_MARKING_EXEMPT_BOTH_SIDES_OF_A_NEW_ORDER_CROSS_IS_SHORT_MARKING_EXEMPT 0x33  // Both Sides Of A New Order Cross Is Short Marking Exempt

// Routing Inst: one byte code
#define ROUTING_INST_POST_ONLY_CANCEL 0x50   // Post Only Cancel
#define ROUTING_INST_POST_ONLY_REPRICE 0x70  // Post Only Reprice

// Display Indicator: one byte code
#define DISPLAY_INDICATOR_VISIBLE 0x56    // Visible
#define DISPLAY_INDICATOR_INVISIBLE 0x49  // Invisible

// Matching State Participation: one byte code
#define MATCHING_STATE_PARTICIPATION_ACTIVE_ORDERS_ONLY 0x31              // Active Orders Only
#define MATCHING_STATE_PARTICIPATION_PASSIVE_ORDERS_ONLY 0x32             // Passive Orders Only
#define MATCHING_STATE_PARTICIPATION_BOTH_ACTIVE_AND_PASSIVE_ORDERS 0x33  // Both Active And Passive Orders

// Cancel Orig On Reject: one byte code
#define CANCEL_ORIG_ON_REJECT_LEAVE_ORIGINAL_ORDER_ALONE 0x4E                  // Leave Original Order Alone
#define CANCEL_ORIG_ON_REJECT_CANCEL_ORIGINAL_ORDER_IF_REPLACEMENT_FAILS 0x59  // Cancel Original Order If Replacement Fails

// Cross Type: one byte code
#define CROSS_TYPE_BASIS 0x42                // Basis
#define CROSS_TYPE_CONTINGENT 0x43           // Contingent
#define CROSS_TYPE_DERIVATIVE 0x44           // Derivative
#define CROSS_TYPE_INTERNAL 0x49             // Internal
#define CROSS_TYPE_NET_ASSET_VALUE_NAV 0x4E  // Net Asset Value Nav
#define CROSS_TYPE_REGULAR 0x52              // Regular
#define CROSS_TYPE_VWAP 0x56                 // Vwap

// Cross Side: one byte code
#define CROSS_SIDE_CROSS 0x38        // Cross
#define CROSS_SIDE_CROSS_SHORT 0x39  // Cross Short

// Buy Umir Account Type: one byte code
#define BUY_UMIR_ACCOUNT_TYPE_INVENTORY 0x49             // Inventory
#define BUY_UMIR_ACCOUNT_TYPE_NON_CLIENT 0x4E            // Non Client
#define BUY_UMIR_ACCOUNT_TYPE_CLIENT 0x43                // Client
#define BUY_UMIR_ACCOUNT_TYPE_SPECIALIST 0x53            // Specialist
#define BUY_UMIR_ACCOUNT_TYPE_OPTIONS_FIRM_ACCOUNT 0x46  // Options Firm Account
#define BUY_UMIR_ACCOUNT_TYPE_OPTIONS_MARKET_MAKER 0x4D  // Options Market Maker
#define BUY_UMIR_ACCOUNT_TYPE_BUNDLED 0x42               // Bundled
#define BUY_UMIR_ACCOUNT_TYPE_MULTI_CLIENT 0x58          // Multi Client

// Buy Umir Regulation Id: one byte code
#define BUY_UMIR_REGULATION_ID_SIGNIFICANT_SHAREHOLDER 0x53  // Significant Shareholder
#define BUY_UMIR_REGULATION_ID_INSIDER 0x49                  // Insider

// Buy Lei Order Origin: one byte code
#define BUY_LEI_ORDER_ORIGIN_DIRECT_ACCESS_CLIENT 0x05          // Direct Access Client
#define BUY_LEI_ORDER_ORIGIN_FOREIGN_DEALER_EQUIVALENT 0x06     // Foreign Dealer Equivalent
#define BUY_LEI_ORDER_ORIGIN_ORDER_EXECUTION_ONLY_SERVICE 0x07  // Order Execution Only Service

// Buy Lei Routing Arrangemeant Indicator: one byte code
#define BUY_LEI_ROUTING_ARRANGEMEANT_INDICATOR_NO 0x4E   // No
#define BUY_LEI_ROUTING_ARRANGEMEANT_INDICATOR_YES 0x59  // Yes

// Sell Umir Account Type: one byte code
#define SELL_UMIR_ACCOUNT_TYPE_INVENTORY 0x49             // Inventory
#define SELL_UMIR_ACCOUNT_TYPE_NON_CLIENT 0x4E            // Non Client
#define SELL_UMIR_ACCOUNT_TYPE_CLIENT 0x43                // Client
#define SELL_UMIR_ACCOUNT_TYPE_SPECIALIST 0x53            // Specialist
#define SELL_UMIR_ACCOUNT_TYPE_OPTIONS_FIRM_ACCOUNT 0x46  // Options Firm Account
#define SELL_UMIR_ACCOUNT_TYPE_OPTIONS_MARKET_MAKER 0x4D  // Options Market Maker
#define SELL_UMIR_ACCOUNT_TYPE_BUNDLED 0x42               // Bundled
#define SELL_UMIR_ACCOUNT_TYPE_MULTI_CLIENT 0x58          // Multi Client

// Sell Umir Regulation Id: one byte code
#define SELL_UMIR_REGULATION_ID_SIGNIFICANT_SHAREHOLDER 0x53  // Significant Shareholder
#define SELL_UMIR_REGULATION_ID_INSIDER 0x49                  // Insider

// Sell Lei Order Origin: one byte code
#define SELL_LEI_ORDER_ORIGIN_DIRECT_ACCESS_CLIENT 0x05          // Direct Access Client
#define SELL_LEI_ORDER_ORIGIN_FOREIGN_DEALER_EQUIVALENT 0x06     // Foreign Dealer Equivalent
#define SELL_LEI_ORDER_ORIGIN_ORDER_EXECUTION_ONLY_SERVICE 0x07  // Order Execution Only Service

// Sell Lei Routing Arrangement Indicator: one byte code
#define SELL_LEI_ROUTING_ARRANGEMENT_INDICATOR_NO 0x4E   // No
#define SELL_LEI_ROUTING_ARRANGEMENT_INDICATOR_YES 0x59  // Yes

// Buy Lei Routing Arrangement Indicator: one byte code
#define BUY_LEI_ROUTING_ARRANGEMENT_INDICATOR_NO 0x4E   // No
