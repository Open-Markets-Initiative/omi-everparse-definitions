// ---- Types -------------------------------------------------------------------

// Unit Sequence
typedef struct _UnitSequence {
  UINT8 unit_number;       // byte 0
  UINT32 sequence_number;  // bytes 1 to 4
} UnitSequence;

// A Login Request message must be sent as the first message upon connection
typedef struct _LoginRequestMessage {
  UINT8 session_id[4];                                                      // bytes 0 to 3
  UINT8 session_sub_id[4];                                                  // bytes 4 to 7
  UINT8 password[10];                                                       // bytes 8 to 17
  UINT8 replay_unspecified_unit;                                            // byte 18
  UINT8 number_of_units;                                                    // byte 19
  UnitSequence unit_sequence[:byte-size (((UINT32) number_of_units) * 5)];
} LoginRequestMessage;

// New order message for Cboe Canada Equities
typedef struct _NewOrderCaEquitiesV1 {
  UINT8 account[16];                        // bytes 0 to 15
  UINT8 cl_ord_id[20];                      // bytes 16 to 35
  UINT16 broker_id;                         // bytes 36 to 37
  UINT8 exec_inst;                          // byte 38
  UINT8 handling_inst;                      // byte 39
  UINT32 order_qty;                         // bytes 40 to 43
  UINT8 ord_type;                           // byte 44
  UINT64 price;                             // bytes 45 to 52, signed, read here as unsigned
  UINT64 stop_px;                           // bytes 53 to 60, signed, read here as unsigned
  UINT8 side;                               // byte 61
  UINT8 symbol[14];                         // bytes 62 to 75
  UINT8 time_in_force;                      // byte 76
  UINT8 settlement_type;                    // byte 77
  UINT32 fut_settl_date;                    // bytes 78 to 81
  UINT8 ex_destination;                     // byte 82
  UINT32 max_floor;                         // bytes 83 to 86
  UINT64 expire_time;                       // bytes 87 to 94
  UINT32 expire_date;                       // bytes 95 to 98
  UINT8 lei_order_origin;                   // byte 99
  UINT8 lei_routing_arrangement_indicator;  // byte 100
  UINT8 umir_account_type;                  // byte 101
  UINT8 umir_user_id[12];                   // bytes 102 to 113
  UINT32 basket_trade;                      // bytes 114 to 117
  UINT8 program_trade;                      // byte 118
  UINT16 jitney;                            // bytes 119 to 120
  UINT8 anonymous;                          // byte 121
  UINT8 umir_regulation_id;                 // byte 122
  UINT8 non_resident;                       // byte 123
  UINT8 bypass;                             // byte 124
  UINT8 ncib;                               // byte 125
  UINT8 no_trade_feat;                      // byte 126
  UINT8 no_trade_key[6];                    // bytes 127 to 132
  UINT8 short_marking_exempt;               // byte 133
  UINT8 lei_customer_account[20];           // bytes 134 to 153
  UINT8 lei_algorithm_id[20];               // bytes 154 to 173
  UINT8 customer_lei[52];                   // bytes 174 to 225
  UINT8 broker_lei[20];                     // bytes 226 to 245
  UINT8 routing_inst;                       // byte 246
  UINT8 display_indicator;                  // byte 247
  UINT8 matching_state_participation;       // byte 248
  UINT32 true_min_qty;                      // bytes 249 to 252
} NewOrderCaEquitiesV1;

