// Off Book Automated Indicator: one byte code
#define OFF_BOOK_AUTOMATED_INDICATOR_AUTOMATED 0x51      // Automated
#define OFF_BOOK_AUTOMATED_INDICATOR_MANUAL 0x4D         // Manual
#define OFF_BOOK_AUTOMATED_INDICATOR_NOT_SPECIFIED 0x2D  // Not Specified

