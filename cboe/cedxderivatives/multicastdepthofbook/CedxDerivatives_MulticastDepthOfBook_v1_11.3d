#define PRICE_FORMATION_DISCOVERY_PROCESS_STANDARD_TRADE_FOR_THE_SPECIFIED_MARKET_MECHANISM_OR_TRADING_MODE 0x50  // Standard Trade For The Specified Market Mechanism Or Trading Mode
#define PRICE_FORMATION_DISCOVERY_PROCESS_NON_PRICE_FORMING_TRADE 0x54                                            // Non Price Forming Trade
