#define PUBLICATION_MODE_DEFERRAL_REASON_TRADE_REPORT_REPORTED_LATE_WITHOUT_PERMITTED_DEFERRAL 0x31      // Trade Report Reported Late Without Permitted Deferral
#define PUBLICATION_MODE_DEFERRAL_REASON_DEFERRAL_TRADE_FOR_LARGE_IN_SCALE 0x32                          // Deferral Trade For Large In Scale
#define PUBLICATION_MODE_DEFERRAL_REASON_DEFERRAL_TRADE_FOR_ILLIQUID_INSTRUMENT 0x33                     // Deferral Trade For Illiquid Instrument
#define PUBLICATION_MODE_DEFERRAL_REASON_DEFERRAL_TRADE_FOR_SIZE_SPECIFIC 0x34                           // Deferral Trade For Size Specific
#define PUBLICATION_MODE_DEFERRAL_REASON_DEFERRAL_TRADE_FOR_ILLIQUID_INSTRUMENT_AND_SIZE_SPECIFIC 0x35   // Deferral Trade For Illiquid Instrument And Size Specific
#define PUBLICATION_MODE_DEFERRAL_REASON_DEFERRAL_TRADE_FOR_ILLIQUID_INSTRUMENT_AND_LARGE_IN_SCALE 0x36  // Deferral Trade For Illiquid Instrument And Large In Scale
#define PUBLICATION_MODE_DEFERRAL_REASON_NOT_SPECIFIED 0x2D                                              // Not Specified

// Deferral Or Enrichment Type: one byte code
#define DEFERRAL_OR_ENRICHMENT_TYPE_LIMITED_DETAILS_TRADE 0x31                                                             // Limited Details Trade
#define DEFERRAL_OR_ENRICHMENT_TYPE_DAILY_AGGREGATED_TRADE 0x32                                                            // Daily Aggregated Trade
#define DEFERRAL_OR_ENRICHMENT_TYPE_VOLUME_OMISSION_TRADE 0x33                                                             // Volume Omission Trade
#define DEFERRAL_OR_ENRICHMENT_TYPE_FOUR_WEEKS_AGGREGATION_TRADE 0x34                                                      // Four Weeks Aggregation Trade
#define DEFERRAL_OR_ENRICHMENT_TYPE_INDEFINITE_AGGREGATION_TRADE 0x35                                                      // Indefinite Aggregation Trade
#define DEFERRAL_OR_ENRICHMENT_TYPE_VOLUME_OMISSION_TRADE_ELIGIBLE_FOR_SUBSEQUENT_ENRICHMENT_IN_AGGREGATED_FORM 0x36       // Volume Omission Trade Eligible For Subsequent Enrichment In Aggregated Form
#define DEFERRAL_OR_ENRICHMENT_TYPE_FULL_DETAILS_OF_EARLIER_LIMITED_DETAILS_TRADE 0x37                                     // Full Details Of Earlier Limited Details Trade
#define DEFERRAL_OR_ENRICHMENT_TYPE_FULL_DETAILS_OF_EARLIER_DAILY_AGGREGATED_TRADE 0x38                                    // Full Details Of Earlier Daily Aggregated Trade
#define DEFERRAL_OR_ENRICHMENT_TYPE_FULL_DETAILS_OF_EARLIER_VOLUME_OMISSION_TRADE 0x39                                     // Full Details Of Earlier Volume Omission Trade
#define DEFERRAL_OR_ENRICHMENT_TYPE_FULL_DETAILS_OF_FOUR_WEEKS_AGGREGATION_TRADE 0x56                                      // Full Details Of Four Weeks Aggregation Trade
#define DEFERRAL_OR_ENRICHMENT_TYPE_FULL_DETAILS_OF_EARLIER_VOLUME_OMISSION_TRADE_ELIGIBLE_FOR_SUBSEQUENT_ENR_si0c55 0x57  // Full Details Of Earlier Volume Omission Trade Eligible For Subsequent Enrichment In Aggregated Form
#define DEFERRAL_OR_ENRICHMENT_TYPE_NOT_APPLICABLE 0x2D                                                                    // Not Applicable

// Duplicative Indicator: one byte code
#define DUPLICATIVE_INDICATOR_DUPLICATIVE_TRADE_REPORT 0x31  // Duplicative Trade Report
#define DUPLICATIVE_INDICATOR_UNIQUE_TRADE_REPORT 0x2D       // Unique Trade Report

// Status: one byte code
#define STATUS_CLOSED 0x43           // Closed
#define STATUS_QUEUING 0x51          // Queuing
#define STATUS_OPENING_AUCTION 0x4F  // Opening Auction
#define STATUS_TRADING 0x54          // Trading
#define STATUS_SUSPENSION 0x53       // Suspension
#define STATUS_HALTED 0x48           // Halted

// Is Fast: one byte code
#define IS_FAST_NORMAL 0x00  // Normal
#define IS_FAST_FAST 0x01    // Fast

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING_AUCTION 0x4F  // Opening Auction
#define AUCTION_TYPE_AIM 0x42              // Aim
#define AUCTION_TYPE_C_RFQ 0x43            // C Rfq

// Opening Condition: one byte code
#define OPENING_CONDITION_WOULD_OPEN 0x4F                // Would Open
#define OPENING_CONDITION_NEED_QUOTE_TO_OPEN 0x51        // Need Quote To Open
#define OPENING_CONDITION_NEED_MORE_BUYERS 0x42          // Need More Buyers
#define OPENING_CONDITION_NEED_MORE_SELLERS 0x53         // Need More Sellers
#define OPENING_CONDITION_CROSSED_COMPOSITE_MARKET 0x43  // Crossed Composite Market

