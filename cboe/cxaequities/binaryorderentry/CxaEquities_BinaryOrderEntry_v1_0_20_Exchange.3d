} ModifyRejectedAuEquitiesV1;

// ---- Order Restated Au Equities V 1: 76 bytes --------------------------------

// Order restatement for an iceberg reload or a Self-Trade Protection reduction or cancellation
entrypoint typedef struct _OrderRestatedAuEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT16 trading_participant_id;   // bytes 8 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
