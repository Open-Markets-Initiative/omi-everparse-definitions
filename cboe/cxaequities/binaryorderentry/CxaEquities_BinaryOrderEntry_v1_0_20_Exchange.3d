#define NO_TRADE_FEAT_CANCEL_BOTH 0x42                                    // Cancel Both
#define NO_TRADE_FEAT_CANCEL_SMALLEST 0x53                                // Cancel Smallest
#define NO_TRADE_FEAT_DECREMENT_LARGER_CANCEL_SMALLER 0x44                // Decrement Larger Cancel Smaller
#define NO_TRADE_FEAT_SAME_AS_D_ABOVE_BUT_ONLY_DECREMENT_LEAVES_QTY 0x64  // Same As D Above But Only Decrement Leaves Qty
#define NO_TRADE_FEAT_BOOKING_PURPOSE_TRADE 0x58                          // Booking Purpose Trade

// Meqse: one byte code
#define MEQSE_TRUE 0x59   // True
#define MEQSE_FALSE 0x4E  // False

// Directed Wholesale Indicator: one byte code
#define DIRECTED_WHOLESALE_INDICATOR_TRUE 0x59   // True
#define DIRECTED_WHOLESALE_INDICATOR_FALSE 0x4E  // False

// Remove Crossing From Clearing: one byte code
#define REMOVE_CROSSING_FROM_CLEARING_TRUE 0x59   // True
#define REMOVE_CROSSING_FROM_CLEARING_FALSE 0x4E  // False

// Broker Preferencing: one byte code
#define BROKER_PREFERENCING_MATCH_WITH_OTHER_ORDERS_USING_BROKER_PREFERENCING_WHEN_POSSIBLE 0x59  // Match With Other Orders Using Broker Preferencing When Possible
#define BROKER_PREFERENCING_DO_NOT_APPLY_BROKER_PREFERENCING 0x4E                                 // Do Not Apply Broker Preferencing

// Base Liquidity Indicator: one byte code
#define BASE_LIQUIDITY_INDICATOR_ADDED_LIQUIDITY 0x41     // Added Liquidity
#define BASE_LIQUIDITY_INDICATOR_REMOVED_LIQUIDITY 0x52   // Removed Liquidity
#define BASE_LIQUIDITY_INDICATOR_AUCTION_UNCROSSING 0x43  // Auction Uncrossing

// Sub Liquidity Indicator: one byte code
#define SUB_LIQUIDITY_INDICATOR_ADDED_HIDDEN_LIQUIDITY_THAT_WAS_PRICE_IMPROVED 0x49                       // Added Hidden Liquidity That Was Price Improved
#define SUB_LIQUIDITY_INDICATOR_ADDED_LIQUIDITY_NBBO_JOINER 0x4A                                          // Added Liquidity Nbbo Joiner
#define SUB_LIQUIDITY_INDICATOR_ADDED_LIQUIDITY_FROM_THE_HIDDEN_RESERVE_PORTION_OF_AN_ICEBERG_ORDER 0x4B  // Added Liquidity From The Hidden Reserve Portion Of An Iceberg Order
#define SUB_LIQUIDITY_INDICATOR_ADDED_LIQUIDITY_NBBO_SETTER 0x53                                          // Added Liquidity Nbbo Setter
#define SUB_LIQUIDITY_INDICATOR_OPENING_AUCTION_OR_INTRADAY_AUCTION_TRADE 0x4F                            // Opening Auction Or Intraday Auction Trade
#define SUB_LIQUIDITY_INDICATOR_CLOSING_AUCTION_TRADE 0x65                                                // Closing Auction Trade
#define SUB_LIQUIDITY_INDICATOR_HALT_AUCTION_RE_OPENING 0x68                                              // Halt Auction Re Opening

// Routing Inst: one byte code
#define ROUTING_INST_POST_ONLY_NEVER_TAKE_LIQUIDITY 0x50  // Post Only Never Take Liquidity
#define ROUTING_INST_FOCUSED_NEARPOINT 0x46               // Focused Nearpoint

// Display Indicator: one byte code
#define DISPLAY_INDICATOR_POST_ONLY_ORDERS_WHICH_WOULD_LOCK_THE_NBBO_ON_ENTRY_ARE_ALLOWED_TO_DO_SO 0x56   // Post Only Orders Which Would Lock The Nbbo On Entry Are Allowed To Do So
#define DISPLAY_INDICATOR_CANCEL_BACK_A_POST_ONLY_ORDER_ON_ENTRY_IF_IT_WERE_TO_CREATE_A_LOCKED_NBBO 0x52  // Cancel Back A Post Only Order On Entry If It Were To Create A Locked Nbbo

// Order Reject Reason: one byte code
#define ORDER_REJECT_REASON_ADMIN 0x41                                           // Admin
#define ORDER_REJECT_REASON_DUPLICATE_IDENTIFIER_EG_CL_ORD_ID 0x44               // Duplicate Identifier Eg Cl Ord Id
#define ORDER_REJECT_REASON_HALTED 0x48                                          // Halted
#define ORDER_REJECT_REASON_INCORRECT_DATA_CENTRE 0x49                           // Incorrect Data Centre
#define ORDER_REJECT_REASON_ORDER_RATE_THRESHOLD_EXCEEDED 0x4B                   // Order Rate Threshold Exceeded
#define ORDER_REJECT_REASON_ORDER_WOULD_LOCK_OR_CROSS_NBBO 0x4C                  // Order Would Lock Or Cross Nbbo
#define ORDER_REJECT_REASON_RAN_OUT_OF_LIQUIDITY_TO_EXECUTE_AGAINST 0x4E         // Ran Out Of Liquidity To Execute Against
#define ORDER_REJECT_REASON_CL_ORD_ID_DOES_NOT_MATCH_A_KNOWN_ORDER 0x4F          // Cl Ord Id Does Not Match A Known Order
#define ORDER_REJECT_REASON_USER_REQUESTED 0x55                                  // User Requested
#define ORDER_REJECT_REASON_ADD_LIQUIDITY_ONLY_ORDER_WOULD_REMOVE 0x57           // Add Liquidity Only Order Would Remove
#define ORDER_REJECT_REASON_ORDER_EXPIRED 0x58                                   // Order Expired
#define ORDER_REJECT_REASON_SYMBOL_NOT_SUPPORTED 0x59                            // Symbol Not Supported
#define ORDER_REJECT_REASON_UNFORESEEN_REASON 0x5A                               // Unforeseen Reason
#define ORDER_REJECT_REASON_MAX_OPEN_ORDERS_COUNT_EXCEEDED 0x6F                  // Max Open Orders Count Exceeded
#define ORDER_REJECT_REASON_ORDER_RECEIVED_BY_CBOE_AUSTRALIA_DURING_REPLAY 0x79  // Order Received By Cboe Australia During Replay
#define ORDER_REJECT_REASON_SESSION_END 0x7A                                     // Session End

// Modify Reject Reason: one byte code
#define MODIFY_REJECT_REASON_ADMIN 0x41                                           // Admin
