// ---- Values ------------------------------------------------------------------

// Exchange Message Type: 2 byte code
#define EXCHANGE_MESSAGE_TYPE_LOGIN_RESPONSE_MESSAGE 0x01F5                 // Login Response Message
#define EXCHANGE_MESSAGE_TYPE_REPLAY_COMPLETE_MESSAGE 0x01F6                // Replay Complete Message
#define EXCHANGE_MESSAGE_TYPE_LOGOUT_RESPONSE_MESSAGE 0x01F7                // Logout Response Message
#define EXCHANGE_MESSAGE_TYPE_SERVER_HEARTBEAT_MESSAGE 0x01F8               // Server Heartbeat Message
#define EXCHANGE_MESSAGE_TYPE_ORDER_ACKNOWLEDGEMENT_AU_EQUITIES_V_1 0x0DAD  // Order Acknowledgement Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_REJECTED_AU_EQUITIES_V_1 0x0DAE         // Order Rejected Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_MODIFIED_AU_EQUITIES_V_1 0x0DAF         // Order Modified Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_MODIFY_REJECTED_AU_EQUITIES_V_1 0x0DB0        // Modify Rejected Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_RESTATED_AU_EQUITIES_V_1 0x0DB1         // Order Restated Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_EXECUTION_AU_EQUITIES_V_1 0x0DB2        // Order Execution Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_CANCELLED_AU_EQUITIES_V_1 0x0DB3        // Order Cancelled Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_CANCEL_REJECTED_AU_EQUITIES_V_1 0x0DB4        // Cancel Rejected Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_EXECUTION_RESTATEMENT_AU_EQUITIES_V_1 0x0DB5  // Execution Restatement Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_PURGE_ACKNOWLEDGEMENT_AU_EQUITIES_V_1 0x0DB6  // Purge Acknowledgement Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_PURGE_REJECTED_AU_EQUITIES_V_1 0x0DB7         // Purge Rejected Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_TRADE_CANCEL_CORRECT_AU_EQUITIES_V_1 0x0DB8   // Trade Cancel Correct Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_MODIFIED_AU_EQUITIES_V_2 0x0DB9         // Order Modified Au Equities V 2
#define EXCHANGE_MESSAGE_TYPE_CARRIED_RESTATEMENT_AU_EQUITIES_V_1 0x0DBA    // Carried Restatement Au Equities V 1
#define EXCHANGE_MESSAGE_TYPE_DONE_FOR_DAY_AU_EQUITIES_V_1 0x0DBB           // Done For Day Au Equities V 1

// Login Response Status: one byte code
#define LOGIN_RESPONSE_STATUS_ACCEPTED 0x41         // Accepted
#define LOGIN_RESPONSE_STATUS_SESSION_IN_USE 0x42   // Session In Use
#define LOGIN_RESPONSE_STATUS_DISABLED 0x44         // Disabled
#define LOGIN_RESPONSE_STATUS_INVALID_UNIT 0x49     // Invalid Unit
#define LOGIN_RESPONSE_STATUS_INVALID_MESSAGE 0x4D  // Invalid Message
#define LOGIN_RESPONSE_STATUS_NOT_AUTHORIZED 0x4E   // Not Authorized
#define LOGIN_RESPONSE_STATUS_SEQUENCE_AHEAD 0x51   // Sequence Ahead
#define LOGIN_RESPONSE_STATUS_INVALID_SESSION 0x53  // Invalid Session

// Logout Reason: one byte code
#define LOGOUT_REASON_USER_REQUESTED 0x55      // User Requested
#define LOGOUT_REASON_ADMINISTRATIVE 0x41      // Administrative
#define LOGOUT_REASON_PROTOCOL_VIOLATION 0x21  // Protocol Violation

// Exec Inst: one byte code
#define EXEC_INST_MARKET_PEG 0x50      // Market Peg
#define EXEC_INST_PRIMARY_PEG 0x52     // Primary Peg
#define EXEC_INST_MIDPOINT 0x4D        // Midpoint
#define EXEC_INST_BEST_X_ORDER 0x6A    // Best X Order
#define EXEC_INST_MARKET_X_ORDER 0x6B  // Market X Order

// Ord Type: one byte code
#define ORD_TYPE_LIMIT 0x32                // Limit
#define ORD_TYPE_MARKET_ON_CLOSE_MOC 0x35  // Market On Close Moc
#define ORD_TYPE_PEGGED 0x50               // Pegged

// Capacity: one byte code
#define CAPACITY_AGENCY 0x41     // Agency
#define CAPACITY_PRINCIPAL 0x50  // Principal
#define CAPACITY_MIXED 0x58      // Mixed

// Side: one byte code
#define SIDE_BUY 0x31         // Buy
#define SIDE_SELL 0x32        // Sell
#define SIDE_SELL_SHORT 0x35  // Sell Short

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY_DEFAULT 0x30           // Day Default
#define TIME_IN_FORCE_GTC_GOOD_TILL_CANCEL 0x31  // Gtc Good Till Cancel
#define TIME_IN_FORCE_IOC 0x33                   // Ioc
#define TIME_IN_FORCE_FOK 0x34                   // Fok
#define TIME_IN_FORCE_GTD 0x36                   // Gtd

// Undisclosed: one byte code
#define UNDISCLOSED_TRUE 0x59   // True
#define UNDISCLOSED_FALSE 0x4E  // False

// No Trade Feat: one byte code
#define NO_TRADE_FEAT_NO_SELF_TRADE_PROTECTION 0x55                       // No Self Trade Protection
#define NO_TRADE_FEAT_CANCEL_NEWEST 0x4E                                  // Cancel Newest
