  UINT8 capacity;                       // byte 62
  UINT8 side;                           // byte 63
  UINT8 symbol[6];                      // bytes 64 to 69
  UINT8 time_in_force;                  // byte 70
  UINT32 min_qty;                       // bytes 71 to 74
  UINT32 max_floor;                     // bytes 75 to 78
  UINT64 expire_time;                   // bytes 79 to 86
  UINT32 clearing_participant_id;       // bytes 87 to 90
  UINT8 clearing_account[10];           // bytes 91 to 100
  UINT8 undisclosed;                    // byte 101
  UINT8 client_cross_ref[15];           // bytes 102 to 116
  UINT32 short_sell_naked_qty;          // bytes 117 to 120
  UINT32 short_sell_covered_qty;        // bytes 121 to 124
  UINT32 short_sell_long_qty;           // bytes 125 to 128
  UINT16 risk_group_id;                 // bytes 129 to 130
  UINT8 no_trade_feat;                  // byte 131
  UINT8 no_trade_key[10];               // bytes 132 to 141
  UINT8 meqse;                          // byte 142
  UINT8 origin_of_trans[20];            // bytes 143 to 162
  UINT8 intermediary_id[10];            // bytes 163 to 172
  UINT8 directed_wholesale_indicator;   // byte 173
  UINT8 remove_crossing_from_clearing;  // byte 174
  UINT8 broker_preferencing;            // byte 175
  UINT64 working_price;                 // bytes 176 to 183, signed, read here as unsigned
  UINT8 base_liquidity_indicator;       // byte 184
  UINT8 sub_liquidity_indicator;        // byte 185
  UINT8 routing_inst;                   // byte 186
  UINT8 display_indicator;              // byte 187
  UINT32 expire_date;                   // bytes 188 to 191
} OrderAcknowledgementAuEquitiesV1;

// ---- Order Rejected Au Equities V 1: 91 bytes --------------------------------

// Order Rejected messages are sent in response to a New Order which must be rejected
entrypoint typedef struct _OrderRejectedAuEquitiesV1 {
