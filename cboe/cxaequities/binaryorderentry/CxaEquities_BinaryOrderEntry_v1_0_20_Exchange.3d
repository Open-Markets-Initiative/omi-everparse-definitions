// ---- Types -------------------------------------------------------------------

// Unit Sequence
typedef struct _UnitSequence {
  UINT8 unit_number;       // byte 0
  UINT32 sequence_number;  // bytes 1 to 4
} UnitSequence;

// A Login Response message is sent in response to a Login Request message
typedef struct _LoginResponseMessage {
  UINT8 login_response_status;                                              // byte 0
  UINT8 login_response_text[60];                                            // bytes 1 to 60
  UINT32 client_sequence;                                                   // bytes 61 to 64
  UINT8 number_of_units;                                                    // byte 65
  UnitSequence unit_sequence[:byte-size (((UINT32) number_of_units) * 5)];
} LoginResponseMessage;

// A Logout Response is usually sent in response to a Logout Request
typedef struct _LogoutResponseMessage {
  UINT8 logout_reason;           // byte 0
  UINT8 logout_reason_text[60];  // bytes 1 to 60
} LogoutResponseMessage;

// Order Acknowledgement messages are sent in response to a New Order message
typedef struct _OrderAcknowledgementAuEquitiesV1 {
  UINT64 transaction_time;              // bytes 0 to 7
  UINT8 account[10];                    // bytes 8 to 17
  UINT16 trading_participant_id;        // bytes 18 to 19
  UINT8 cl_ord_id[20];                  // bytes 20 to 39
  UINT8 exec_inst;                      // byte 40
  UINT64 order_id;                      // bytes 41 to 48
  UINT32 order_qty;                     // bytes 49 to 52
  UINT8 ord_type;                       // byte 53
  UINT64 price;                         // bytes 54 to 61, signed, read here as unsigned
  UINT8 capacity;                       // byte 62
  UINT8 side;                           // byte 63
  UINT8 symbol[6];                      // bytes 64 to 69
  UINT8 time_in_force;                  // byte 70
  UINT32 min_qty;                       // bytes 71 to 74
  UINT32 max_floor;                     // bytes 75 to 78
  UINT64 expire_time;                   // bytes 79 to 86
  UINT32 clearing_participant_id;       // bytes 87 to 90
  UINT8 clearing_account[10];           // bytes 91 to 100
  UINT8 undisclosed;                    // byte 101
  UINT8 client_cross_ref[15];           // bytes 102 to 116
  UINT32 short_sell_naked_qty;          // bytes 117 to 120
  UINT32 short_sell_covered_qty;        // bytes 121 to 124
  UINT32 short_sell_long_qty;           // bytes 125 to 128
  UINT16 risk_group_id;                 // bytes 129 to 130
  UINT8 no_trade_feat;                  // byte 131
  UINT8 no_trade_key[10];               // bytes 132 to 141
  UINT8 meqse;                          // byte 142
  UINT8 origin_of_trans[20];            // bytes 143 to 162
  UINT8 intermediary_id[10];            // bytes 163 to 172
  UINT8 directed_wholesale_indicator;   // byte 173
  UINT8 remove_crossing_from_clearing;  // byte 174
  UINT8 broker_preferencing;            // byte 175
  UINT64 working_price;                 // bytes 176 to 183, signed, read here as unsigned
  UINT8 base_liquidity_indicator;       // byte 184
  UINT8 sub_liquidity_indicator;        // byte 185
  UINT8 routing_inst;                   // byte 186
  UINT8 display_indicator;              // byte 187
  UINT32 expire_date;                   // bytes 188 to 191
} OrderAcknowledgementAuEquitiesV1;

// Order Rejected messages are sent in response to a New Order which must be rejected
typedef struct _OrderRejectedAuEquitiesV1 {
  UINT64 transaction_time;        // bytes 0 to 7
  UINT16 trading_participant_id;  // bytes 8 to 9
  UINT8 cl_ord_id[20];            // bytes 10 to 29
  UINT8 order_reject_reason;      // byte 30
  UINT8 text[60];                 // bytes 31 to 90
} OrderRejectedAuEquitiesV1;

// Order Modified messages are sent in response to a Modify Order to indicate that the order has been successfully modified
typedef struct _OrderModifiedAuEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT16 trading_participant_id;   // bytes 8 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT8 exec_inst;                 // byte 30
  UINT32 order_qty;                // bytes 31 to 34
  UINT8 orig_cl_ord_id[20];        // bytes 35 to 54
  UINT64 price;                    // bytes 55 to 62, signed, read here as unsigned
  UINT32 min_qty;                  // bytes 63 to 66
  UINT32 max_floor;                // bytes 67 to 70
  UINT32 leaves_qty;               // bytes 71 to 74
  UINT64 secondary_order_id;       // bytes 75 to 82
  UINT32 short_sell_naked_qty;     // bytes 83 to 86
  UINT32 short_sell_covered_qty;   // bytes 87 to 90
  UINT32 short_sell_long_qty;      // bytes 91 to 94
  UINT64 working_price;            // bytes 95 to 102, signed, read here as unsigned
  UINT8 base_liquidity_indicator;  // byte 103
  UINT8 sub_liquidity_indicator;   // byte 104
} OrderModifiedAuEquitiesV1;

// Modify Rejected messages are sent in response to a Modify Order for an order which cannot be modified
typedef struct _ModifyRejectedAuEquitiesV1 {
  UINT64 transaction_time;        // bytes 0 to 7
  UINT16 trading_participant_id;  // bytes 8 to 9
  UINT8 cl_ord_id[20];            // bytes 10 to 29
  UINT8 orig_cl_ord_id[20];       // bytes 30 to 49
  UINT8 modify_reject_reason;     // byte 50
  UINT8 text[60];                 // bytes 51 to 110
} ModifyRejectedAuEquitiesV1;

// Order restatement for an iceberg reload or a Self-Trade Protection reduction or cancellation
typedef struct _OrderRestatedAuEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT16 trading_participant_id;   // bytes 8 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT64 order_id;                 // bytes 30 to 37
  UINT32 order_qty;                // bytes 38 to 41
  UINT64 price;                    // bytes 42 to 49, signed, read here as unsigned
  UINT32 leaves_qty;               // bytes 50 to 53
  UINT64 secondary_order_id;       // bytes 54 to 61
  UINT64 last_px;                  // bytes 62 to 69, signed, read here as unsigned
  UINT32 last_shares;              // bytes 70 to 73
  UINT8 base_liquidity_indicator;  // byte 74
  UINT8 restatement_reason;        // byte 75
} OrderRestatedAuEquitiesV1;

// An Order Execution is sent for each fill on an order
typedef struct _OrderExecutionAuEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT16 trading_participant_id;   // bytes 8 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT64 exec_id;                  // bytes 30 to 37
  UINT8 last_capacity;             // byte 38
  UINT8 last_mkt[4];               // bytes 39 to 42
  UINT64 last_px;                  // bytes 43 to 50, signed, read here as unsigned
  UINT32 last_shares;              // bytes 51 to 54
  UINT8 side;                      // byte 55
  UINT8 symbol[6];                 // bytes 56 to 61
  UINT32 leaves_qty;               // bytes 62 to 65
  UINT64 secondary_order_id;       // bytes 66 to 73
  UINT32 clearing_participant_id;  // bytes 74 to 77
  UINT64 price_improvement;        // bytes 78 to 85, signed, read here as unsigned
  UINT8 transact_id[10];           // bytes 86 to 95
  UINT8 on_market_cross_type;      // byte 96
  UINT8 trade_report_type;         // byte 97
  UINT8 base_liquidity_indicator;  // byte 98
  UINT8 sub_liquidity_indicator;   // byte 99
  UINT16 contra_participant_id;    // bytes 100 to 101
  UINT8 fee_code[2];               // bytes 102 to 103
} OrderExecutionAuEquitiesV1;

// Order Cancelled message
typedef struct _OrderCancelledAuEquitiesV1 {
  UINT64 transaction_time;        // bytes 0 to 7
  UINT16 trading_participant_id;  // bytes 8 to 9
  UINT8 cl_ord_id[20];            // bytes 10 to 29
  UINT8 cancel_reason;            // byte 30
} OrderCancelledAuEquitiesV1;

// A Cancel Rejected message is sent in response to a Cancel Order message to indicate that the cancellation cannot occur
typedef struct _CancelRejectedAuEquitiesV1 {
  UINT64 transaction_time;        // bytes 0 to 7
  UINT16 trading_participant_id;  // bytes 8 to 9
  UINT8 cl_ord_id[20];            // bytes 10 to 29
  UINT8 cancel_reject_reason;     // byte 30
  UINT8 text[60];                 // bytes 31 to 90
} CancelRejectedAuEquitiesV1;

// Order Execution Restated messages will be issued for all (unbroken) fills of MOC orders after the closing price has been determined
typedef struct _ExecutionRestatementAuEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT16 trading_participant_id;   // bytes 8 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT64 exec_id;                  // bytes 30 to 37
  UINT64 last_px;                  // bytes 38 to 45, signed, read here as unsigned
  UINT32 last_shares;              // bytes 46 to 49
  UINT8 side;                      // byte 50
  UINT8 symbol[6];                 // bytes 51 to 56
  UINT8 transact_id[10];           // bytes 57 to 66
  UINT8 base_liquidity_indicator;  // byte 67
  UINT16 contra_participant_id;    // bytes 68 to 69
  UINT8 fee_code[2];               // bytes 70 to 71
  UINT8 exec_restatement_reason;   // byte 72
} ExecutionRestatementAuEquitiesV1;

// A Purge Acknowledgment is an unsequenced message sent when a Purge Orders message requesting an order purge has completed cancelling all individual orders
typedef struct _PurgeAcknowledgementAuEquitiesV1 {
  UINT64 transaction_time;       // bytes 0 to 7
  UINT8 mass_cancel_id[20];      // bytes 8 to 27
  UINT32 cancelled_order_count;  // bytes 28 to 31
} PurgeAcknowledgementAuEquitiesV1;

// A Purge Rejected message is sent in response to a Purge Orders message to indicate that the mass cancellation cannot occur
typedef struct _PurgeRejectedAuEquitiesV1 {
  UINT64 transaction_time;    // bytes 0 to 7
  UINT8 mass_cancel_id[20];   // bytes 8 to 27
  UINT8 purge_reject_reason;  // byte 28
  UINT8 text[60];             // bytes 29 to 88
} PurgeRejectedAuEquitiesV1;

// Used to provide notification that a trade has been cancelled (busted) or corrected (price change only)
typedef struct _TradeCancelCorrectAuEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT16 trading_participant_id;   // bytes 8 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT64 exec_ref_id;              // bytes 30 to 37
  UINT64 last_px;                  // bytes 38 to 45, signed, read here as unsigned
  UINT32 last_shares;              // bytes 46 to 49
  UINT64 orig_time;                // bytes 50 to 57
  UINT8 side;                      // byte 58
  UINT8 symbol[6];                 // bytes 59 to 64
  UINT32 clearing_participant_id;  // bytes 65 to 68
  UINT8 transact_id[10];           // bytes 69 to 78
  UINT64 corrected_price;          // bytes 79 to 86, signed, read here as unsigned
  UINT8 base_liquidity_indicator;  // byte 87
} TradeCancelCorrectAuEquitiesV1;

// Order Modified messages are sent in response to a Modify Order, with ExpireDate for multi-day orders
typedef struct _OrderModifiedAuEquitiesV2 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT16 trading_participant_id;   // bytes 8 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT8 exec_inst;                 // byte 30
  UINT32 order_qty;                // bytes 31 to 34
  UINT8 orig_cl_ord_id[20];        // bytes 35 to 54
  UINT64 price;                    // bytes 55 to 62, signed, read here as unsigned
  UINT32 min_qty;                  // bytes 63 to 66
  UINT32 max_floor;                // bytes 67 to 70
  UINT32 leaves_qty;               // bytes 71 to 74
  UINT64 secondary_order_id;       // bytes 75 to 82
  UINT32 short_sell_naked_qty;     // bytes 83 to 86
  UINT32 short_sell_covered_qty;   // bytes 87 to 90
  UINT32 short_sell_long_qty;      // bytes 91 to 94
  UINT64 working_price;            // bytes 95 to 102, signed, read here as unsigned
  UINT8 base_liquidity_indicator;  // byte 103
  UINT8 sub_liquidity_indicator;   // byte 104
  UINT32 expire_date;              // bytes 105 to 108
} OrderModifiedAuEquitiesV2;

// The Carried Restatement message is used to indicate the restoration of a multi-day GTC or GTD orders at the start of a new business day
typedef struct _CarriedRestatementAuEquitiesV1 {
  UINT64 transaction_time;              // bytes 0 to 7
  UINT8 account[10];                    // bytes 8 to 17
  UINT16 trading_participant_id;        // bytes 18 to 19
  UINT8 cl_ord_id[20];                  // bytes 20 to 39
  UINT8 exec_inst;                      // byte 40
  UINT64 order_id;                      // bytes 41 to 48
  UINT32 order_qty;                     // bytes 49 to 52
  UINT8 ord_type;                       // byte 53
  UINT64 price;                         // bytes 54 to 61, signed, read here as unsigned
  UINT8 capacity;                       // byte 62
  UINT8 side;                           // byte 63
  UINT8 symbol[6];                      // bytes 64 to 69
  UINT8 time_in_force;                  // byte 70
  UINT32 min_qty;                       // bytes 71 to 74
  UINT32 max_floor;                     // bytes 75 to 78
  UINT64 expire_time;                   // bytes 79 to 86
  UINT32 clearing_participant_id;       // bytes 87 to 90
  UINT8 clearing_account[10];           // bytes 91 to 100
  UINT8 undisclosed;                    // byte 101
  UINT8 client_cross_ref[15];           // bytes 102 to 116
  UINT32 short_sell_naked_qty;          // bytes 117 to 120
  UINT32 short_sell_covered_qty;        // bytes 121 to 124
  UINT32 short_sell_long_qty;           // bytes 125 to 128
  UINT16 risk_group_id;                 // bytes 129 to 130
  UINT8 no_trade_feat;                  // byte 131
  UINT8 no_trade_key[10];               // bytes 132 to 141
  UINT8 meqse;                          // byte 142
  UINT8 origin_of_trans[20];            // bytes 143 to 162
  UINT8 intermediary_id[10];            // bytes 163 to 172
  UINT8 directed_wholesale_indicator;   // byte 173
  UINT8 remove_crossing_from_clearing;  // byte 174
  UINT8 broker_preferencing;            // byte 175
  UINT8 routing_inst;                   // byte 176
  UINT8 display_indicator;              // byte 177
  UINT32 expire_date;                   // bytes 178 to 181
} CarriedRestatementAuEquitiesV1;

// Done For Day messages represent orders persisted during the current day session to carry over to the next session
typedef struct _DoneForDayAuEquitiesV1 {
  UINT64 transaction_time;  // bytes 0 to 7
  UINT8 cl_ord_id[20];      // bytes 8 to 27
  UINT8 symbol[6];          // bytes 28 to 33
} DoneForDayAuEquitiesV1;

// Branch
casetype _ExchangeMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x01F5: LoginResponseMessage login_response_message;
    case 0x01F6: unit replay_complete;
    case 0x01F7: LogoutResponseMessage logout_response_message;
    case 0x01F8: unit server_heartbeat;
    case 0x0DAD: OrderAcknowledgementAuEquitiesV1 order_acknowledgement_au_equities_v_1;
    case 0x0DAE: OrderRejectedAuEquitiesV1 order_rejected_au_equities_v_1;
    case 0x0DAF: OrderModifiedAuEquitiesV1 order_modified_au_equities_v_1;
    case 0x0DB0: ModifyRejectedAuEquitiesV1 modify_rejected_au_equities_v_1;
    case 0x0DB1: OrderRestatedAuEquitiesV1 order_restated_au_equities_v_1;
    case 0x0DB2: OrderExecutionAuEquitiesV1 order_execution_au_equities_v_1;
    case 0x0DB3: OrderCancelledAuEquitiesV1 order_cancelled_au_equities_v_1;
    case 0x0DB4: CancelRejectedAuEquitiesV1 cancel_rejected_au_equities_v_1;
    case 0x0DB5: ExecutionRestatementAuEquitiesV1 execution_restatement_au_equities_v_1;
    case 0x0DB6: PurgeAcknowledgementAuEquitiesV1 purge_acknowledgement_au_equities_v_1;
    case 0x0DB7: PurgeRejectedAuEquitiesV1 purge_rejected_au_equities_v_1;
    case 0x0DB8: TradeCancelCorrectAuEquitiesV1 trade_cancel_correct_au_equities_v_1;
    case 0x0DB9: OrderModifiedAuEquitiesV2 order_modified_au_equities_v_2;
    case 0x0DBA: CarriedRestatementAuEquitiesV1 carried_restatement_au_equities_v_1;
    case 0x0DBB: DoneForDayAuEquitiesV1 done_for_day_au_equities_v_1;
    default: UINT8 unknown[available];
  }
} ExchangeMessage;

// ---- Packet: ExchangePacket --------------------------------------------------

// Binary Order Entry Tcp Packet sent by the exchange
entrypoint typedef struct _ExchangePacket (UINT32 available) where (available >= 12) {
  UINT16 start_of_message;                                                                                                      // bytes 0 to 1
  UINT16 message_length;                                                                                                        // bytes 2 to 3
  UINT16 exchange_message_type;                                                                                                 // bytes 4 to 5
  UINT8 matching_unit;                                                                                                          // byte 6
  UINT8 reserved_field;                                                                                                         // byte 7
  UINT32 sequence_number;                                                                                                       // bytes 8 to 11
  ExchangeMessage(exchange_message_type, (available - 12)) exchange_message[:byte-size-single-element-array (available - 12)];
} ExchangePacket;

