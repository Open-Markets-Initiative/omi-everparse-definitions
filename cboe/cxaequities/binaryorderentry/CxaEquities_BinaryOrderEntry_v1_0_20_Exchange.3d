// ---- Order Modified Au Equities V 1: 105 bytes -------------------------------

// Order Modified messages are sent in response to a Modify Order to indicate that the order has been successfully modified
entrypoint typedef struct _OrderModifiedAuEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT16 trading_participant_id;   // bytes 8 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
