// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out CxaEquities_MulticastDepthOfBook_Spin_v1_0_12.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_LOGIN_MESSAGE 0x01                 // Login Message
#define MESSAGE_TYPE_LOGIN_RESPONSE_MESSAGE 0x02        // Login Response Message
#define MESSAGE_TYPE_SPIN_IMAGE_AVAILABLE_MESSAGE 0x80  // Spin Image Available Message
#define MESSAGE_TYPE_SPIN_REQUEST_MESSAGE 0x81          // Spin Request Message
#define MESSAGE_TYPE_SPIN_RESPONSE_MESSAGE 0x82         // Spin Response Message
#define MESSAGE_TYPE_SPIN_FINISHED_MESSAGE 0x83         // Spin Finished Message
#define MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x3B        // Trading Status Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x37             // Add Order Message
#define MESSAGE_TYPE_CALCULATED_VALUE_MESSAGE 0xE3      // Calculated Value Message
#define MESSAGE_TYPE_AUCTION_UPDATE_MESSAGE 0x59        // Auction Update Message

// Login Response Status: one byte code
#define LOGIN_RESPONSE_STATUS_LOGIN_ACCEPTED 0x41                            // Login Accepted
#define LOGIN_RESPONSE_STATUS_NOT_AUTHORISED_INVALID_USERNAME_PASSWORD 0x4E  // Not Authorised Invalid Username Password
#define LOGIN_RESPONSE_STATUS_SESSION_IN_USE 0x42                            // Session In Use
#define LOGIN_RESPONSE_STATUS_INVALID_SESSION 0x53                           // Invalid Session

// Spin Response Status: one byte code
#define SPIN_RESPONSE_STATUS_ACCEPTED 0x41                                                                          // Accepted
#define SPIN_RESPONSE_STATUS_OUT_OF_RANGE_SEQUENCE_REQUESTED_IS_GREATER_THAN_SEQUENCE_AVAILABLE_BY_THE_91uwx5 0x4F  // Out Of Range Sequence Requested Is Greater Than Sequence Available By The Next Spin
#define SPIN_RESPONSE_STATUS_SPIN_ALREADY_IN_PROGRESS_ONLY_ONE_SPIN_CAN_BE_RUNNING_AT_A_TIME 0x53                   // Spin Already In Progress Only One Spin Can Be Running At A Time

// Trading Status: one byte code
#define TRADING_STATUS_CLOSED 0x43             // Closed
#define TRADING_STATUS_PRE_MARKET 0x41         // Pre Market
#define TRADING_STATUS_TRADING 0x54            // Trading
#define TRADING_STATUS_MOC_TRADING 0x4D        // Moc Trading
#define TRADING_STATUS_POST_MARKET 0x50        // Post Market
#define TRADING_STATUS_HALTED 0x48             // Halted
#define TRADING_STATUS_TRADING_SUSPENDED 0x53  // Trading Suspended
#define TRADING_STATUS_PRE_OPEN 0x4F           // Pre Open
#define TRADING_STATUS_PRE_CLOSE 0x45          // Pre Close

// Side Indicator: one byte code
#define SIDE_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define SIDE_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Value Category: one byte code
#define VALUE_CATEGORY_CLOSING_PRICE 0x31        // Closing Price
#define VALUE_CATEGORY_I_NAV_VALUES_ETF 0x32     // I Nav Values Etf
#define VALUE_CATEGORY_INDEX_VALUES 0x33         // Index Values
#define VALUE_CATEGORY_EOD_NAV_FROM_ISSUER 0x34  // Eod Nav From Issuer

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING_INTRADAY_AUCTION 0x4F  // Opening Intraday Auction
#define AUCTION_TYPE_CLOSING_AUCTION 0x43           // Closing Auction
#define AUCTION_TYPE_HALT_AUCTION_RE_OPENING 0x48   // Halt Auction Re Opening

// ---- Types -------------------------------------------------------------------

// First message sent to the Spin Server by the client process after the connection to the Spin Server is established. Failure to login before sending any other message type will result in the connection being dropped by the Spin Server. Identical format to the GRP Login message.
typedef struct _LoginMessage {
  UINT8 session_sub_id[4];  // bytes 0 to 3
  UINT8 username[4];        // bytes 4 to 7
  UINT8 filler[2];          // bytes 8 to 9
  UINT8 password[10];       // bytes 10 to 19
} LoginMessage;

// Sent by the Spin Server to the client process in response to a Login message. The Status field reflects an accepted login or the reason the session was not accepted. If login fails, the connection will be dropped after the Login Response message is sent.
typedef struct _LoginResponseMessage {
  UINT8 login_response_status;  // byte 0
} LoginResponseMessage;

// Sent once per second by the Spin Server, indicating through what sequence number a spin is available.
typedef struct _SpinImageAvailableMessage {
  UINT32 sequence;  // bytes 0 to 3
} SpinImageAvailableMessage;

// Used by a client's process to request transmission of a spin of the unit's order book.
typedef struct _SpinRequestMessage {
  UINT32 sequence;  // bytes 0 to 3
} SpinRequestMessage;

// Sent by the Spin Server in response to a client's Spin Request message indicating whether a spin will be sent.
typedef struct _SpinResponseMessage {
  UINT32 sequence;             // bytes 0 to 3
  UINT32 order_count;          // bytes 4 to 7
  UINT8 spin_response_status;  // byte 8
} SpinResponseMessage;

// Sent to indicate that all messages for the spin requested have been sent. A Spin Finished message is only sent if a Spin Request was not rejected. Upon receipt, any buffered multicast messages should be applied to the client's copy of the book to make it current.
typedef struct _SpinFinishedMessage {
  UINT32 sequence;  // bytes 0 to 3
} SpinFinishedMessage;

// Indicates the current trading status of a security. Included in a spin response so the client can populate trading state for each symbol.
typedef struct _TradingStatusMessage {
  UINT64 timestamp;         // bytes 0 to 7
  UINT8 symbol[6];          // bytes 8 to 13
  UINT8 trading_status;     // byte 14
  UINT8 market_id_code[4];  // bytes 15 to 18
  UINT8 reserved_1;         // byte 19
} TradingStatusMessage;

// Represents an open order on the CXA book. Included in a spin response to reconstruct the open order book at the spin sequence number.
typedef struct _AddOrderMessage {
  UINT64 timestamp;      // bytes 0 to 7
  UINT64 order_id;       // bytes 8 to 15
  UINT8 side_indicator;  // byte 16
  UINT32 quantity;       // bytes 17 to 20
  UINT8 symbol[6];       // bytes 21 to 26
  UINT64 price;          // bytes 27 to 34
  UINT8 pid[4];          // bytes 35 to 38
  UINT8 reserved_1;      // byte 39
} AddOrderMessage;

// Carries the latest calculated market value for a specified symbol. Included in a spin response so the client can populate the latest index, iNAV, or closing price value.
typedef struct _CalculatedValueMessage {
  UINT64 timestamp;        // bytes 0 to 7
  UINT8 symbol[6];         // bytes 8 to 13
  UINT8 value_category;    // byte 14
  UINT64 value;            // bytes 15 to 22
  UINT64 value_timestamp;  // bytes 23 to 30
} CalculatedValueMessage;

// Provides the latest indicative auction price and eligible shares for a symbol in an overlapping order book state. Included in a spin response so the client can populate the current auction state.
typedef struct _AuctionUpdateMessage {
  UINT64 timestamp;         // bytes 0 to 7
  UINT8 symbol[6];          // bytes 8 to 13
  UINT8 auction_type;       // byte 14
  UINT32 buy_shares;        // bytes 15 to 18
  UINT32 sell_shares;       // bytes 19 to 22
  UINT64 indicative_price;  // bytes 23 to 30
  UINT8 reserved_1;         // byte 31
} AuctionUpdateMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: LoginMessage login_message;
    case 0x02: LoginResponseMessage login_response_message;
    case 0x80: SpinImageAvailableMessage spin_image_available_message;
    case 0x81: SpinRequestMessage spin_request_message;
    case 0x82: SpinResponseMessage spin_response_message;
    case 0x83: SpinFinishedMessage spin_finished_message;
    case 0x3B: TradingStatusMessage trading_status_message;
    case 0x37: AddOrderMessage add_order_message;
    case 0xE3: CalculatedValueMessage calculated_value_message;
    case 0x59: AuctionUpdateMessage auction_update_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Tcp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

