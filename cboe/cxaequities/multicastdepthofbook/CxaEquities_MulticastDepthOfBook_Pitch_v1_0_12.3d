// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out CxaEquities_MulticastDepthOfBook_Pitch_v1_0_12.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_UNIT_CLEAR_MESSAGE 0x97               // Unit Clear Message
#define MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x3B           // Trading Status Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x37                // Add Order Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x38           // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_AT_PRICE_MESSAGE 0x58  // Order Executed At Price Message
#define MESSAGE_TYPE_REDUCE_SIZE_MESSAGE 0x39              // Reduce Size Message
#define MESSAGE_TYPE_MODIFY_ORDER_MESSAGE 0x3A             // Modify Order Message
#define MESSAGE_TYPE_DELETE_ORDER_MESSAGE 0x3C             // Delete Order Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x3D                    // Trade Message
#define MESSAGE_TYPE_TRADE_BREAK_MESSAGE 0x3E              // Trade Break Message
#define MESSAGE_TYPE_CALCULATED_VALUE_MESSAGE 0xE3         // Calculated Value Message
#define MESSAGE_TYPE_END_OF_SESSION_MESSAGE 0x2D           // End Of Session Message
#define MESSAGE_TYPE_AUCTION_UPDATE_MESSAGE 0x59           // Auction Update Message
#define MESSAGE_TYPE_AUCTION_SUMMARY_MESSAGE 0x5A          // Auction Summary Message

// Trading Status: one byte code
#define TRADING_STATUS_CLOSED 0x43             // Closed
#define TRADING_STATUS_PRE_MARKET 0x41         // Pre Market
#define TRADING_STATUS_TRADING 0x54            // Trading
#define TRADING_STATUS_MOC_TRADING 0x4D        // Moc Trading
#define TRADING_STATUS_POST_MARKET 0x50        // Post Market
#define TRADING_STATUS_HALTED 0x48             // Halted
#define TRADING_STATUS_TRADING_SUSPENDED 0x53  // Trading Suspended
#define TRADING_STATUS_PRE_OPEN 0x4F           // Pre Open
#define TRADING_STATUS_PRE_CLOSE 0x45          // Pre Close

// Side Indicator: one byte code
#define SIDE_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define SIDE_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Execution Type: one byte code
#define EXECUTION_TYPE_OPENING_INTRADAY_AUCTION 0x4F  // Opening Intraday Auction
#define EXECUTION_TYPE_CLOSING_AUCTION 0x43           // Closing Auction
#define EXECUTION_TYPE_HALT_AUCTION_RE_OPENING 0x48   // Halt Auction Re Opening

// Trade Type: one byte code
#define TRADE_TYPE_BROKER_PREFERRED_TRADE 0x42                      // Broker Preferred Trade
#define TRADE_TYPE_TRADE_RESULTING_FROM_NORMAL_MATCHING_LOGIC 0x4E  // Trade Resulting From Normal Matching Logic
#define TRADE_TYPE_OFF_EXCHANGE_TRADE_REPORT 0x20                   // Off Exchange Trade Report
#define TRADE_TYPE_OPENING_INTRADAY_AUCTION_UNDISCLOSED 0x4F        // Opening Intraday Auction Undisclosed
#define TRADE_TYPE_CLOSING_AUCTION_UNDISCLOSED 0x43                 // Closing Auction Undisclosed
#define TRADE_TYPE_HALT_AUCTION_RE_OPENING_UNDISCLOSED 0x48         // Halt Auction Re Opening Undisclosed

// Trade Designation: one byte code
#define TRADE_DESIGNATION_CXAC_LIMIT 0x43                   // Cxac Limit
#define TRADE_DESIGNATION_CXAP_MID_POINT 0x50               // Cxap Mid Point
#define TRADE_DESIGNATION_CXAN_NEAR_POINT 0x4E              // Cxan Near Point
#define TRADE_DESIGNATION_CXAF_FAR_POINT 0x46               // Cxaf Far Point
#define TRADE_DESIGNATION_CXAM_MOC 0x4D                     // Cxam Moc
#define TRADE_DESIGNATION_NOT_APPLICABLE_OFF_EXCHANGE 0x20  // Not Applicable Off Exchange

// Trade Report Type: one byte code
#define TRADE_REPORT_TYPE_BLOCK_TRADE 0x42                                         // Block Trade
#define TRADE_REPORT_TYPE_LARGE_PORTFOLIO_TRADE 0x50                               // Large Portfolio Trade
#define TRADE_REPORT_TYPE_LARGE_PRINCIPAL_TRANSACTION 0x54                         // Large Principal Transaction
#define TRADE_REPORT_TYPE_TRADES_WITH_PRICE_IMPROVEMENT 0x53                       // Trades With Price Improvement
#define TRADE_REPORT_TYPE_PERMITTED_TRADE_DURING_POST_TRADING_HOURS_PERIOD 0x4C    // Permitted Trade During Post Trading Hours Period
#define TRADE_REPORT_TYPE_PERMITTED_TRADE_DURING_PRE_TRADING_HOURS_PERIOD 0x4D     // Permitted Trade During Pre Trading Hours Period
#define TRADE_REPORT_TYPE_OUT_OF_HOURS_TRADE 0x45                                  // Out Of Hours Trade
#define TRADE_REPORT_TYPE_ETF_TRADE_REPORT_FOR_UNIT_CREATIONS_OR_REDEMPTIONS 0x46  // Etf Trade Report For Unit Creations Or Redemptions
#define TRADE_REPORT_TYPE_NOT_APPLICABLE_ON_EXCHANGE 0x20                          // Not Applicable On Exchange

// Value Category: one byte code
#define VALUE_CATEGORY_CLOSING_PRICE 0x31        // Closing Price
#define VALUE_CATEGORY_I_NAV_VALUES_ETF 0x32     // I Nav Values Etf
#define VALUE_CATEGORY_INDEX_VALUES 0x33         // Index Values
#define VALUE_CATEGORY_EOD_NAV_FROM_ISSUER 0x34  // Eod Nav From Issuer

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING_INTRADAY_AUCTION 0x4F  // Opening Intraday Auction
#define AUCTION_TYPE_CLOSING_AUCTION 0x43           // Closing Auction
#define AUCTION_TYPE_HALT_AUCTION_RE_OPENING 0x48   // Halt Auction Re Opening

// ---- Types -------------------------------------------------------------------

// Instructs feed recipients to clear all orders for the CXA book in the unit specified in the Sequenced Unit Header. Distributed in rare recovery events such as a datacentre fail-over.
typedef struct _UnitClearMessage {
  UINT32 reserved_4;  // bytes 0 to 3
} UnitClearMessage;

// Indicates the current trading status of a security. A Trading Status message will be sent whenever trading status changes for a security.
typedef struct _TradingStatusMessage {
  UINT64 timestamp;         // bytes 0 to 7
  UINT8 symbol[6];          // bytes 8 to 13
  UINT8 trading_status;     // byte 14
  UINT8 market_id_code[4];  // bytes 15 to 18
  UINT8 reserved_1;         // byte 19
} TradingStatusMessage;

// Represents a newly accepted visible or undisclosed order on the CXA book. Includes a day-specific Order Id assigned by CXA to the order.
typedef struct _AddOrderMessage {
  UINT64 timestamp;      // bytes 0 to 7
  UINT64 order_id;       // bytes 8 to 15
  UINT8 side_indicator;  // byte 16
  UINT32 quantity;       // bytes 17 to 20
  UINT8 symbol[6];       // bytes 21 to 26
  UINT64 price;          // bytes 27 to 34
  UINT8 pid[4];          // bytes 35 to 38
  UINT8 reserved_1;      // byte 39
} AddOrderMessage;

// Sent when a visible order on the CXA book is executed in whole or in part. The execution price equals the order price found in the original Add Order message or the order price in the latest Modify Order message referencing the Order Id.
typedef struct _OrderExecutedMessage {
  UINT64 timestamp;          // bytes 0 to 7
  UINT64 order_id;           // bytes 8 to 15
  UINT32 executed_quantity;  // bytes 16 to 19
  UINT64 execution_id;       // bytes 20 to 27
  UINT64 contra_order_id;    // bytes 28 to 35
  UINT8 contra_pid[4];       // bytes 36 to 39
  UINT8 reserved_1;          // byte 40
} OrderExecutedMessage;

// Used to update lit orders that have fully or partially executed in an auction. There is one Order Executed at Price message per auction trade, which includes the order IDs of both resting orders matched in the trade. Each message is followed by either a Reduce Size message (if the contra order has partially executed) or a Delete Order message (if the contra order has fully executed).
typedef struct _OrderExecutedAtPriceMessage {
  UINT64 timestamp;          // bytes 0 to 7
  UINT64 order_id;           // bytes 8 to 15
  UINT32 executed_quantity;  // bytes 16 to 19
  UINT64 execution_id;       // bytes 20 to 27
  UINT64 contra_order_id;    // bytes 28 to 35
  UINT8 contra_pid[4];       // bytes 36 to 39
  UINT8 execution_type;      // byte 40
  UINT64 price;              // bytes 41 to 48
  UINT8 reserved_1;          // byte 49
} OrderExecutedAtPriceMessage;

// Sent when a visible order on the CXA book is partially reduced.
typedef struct _ReduceSizeMessage {
  UINT64 timestamp;           // bytes 0 to 7
  UINT64 order_id;            // bytes 8 to 15
  UINT32 cancelled_quantity;  // bytes 16 to 19
} ReduceSizeMessage;

// Sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message. Modify Order messages that appear to be no ops (i.e., they do not appear to modify any relevant fields) will still lose priority.
typedef struct _ModifyOrderMessage {
  UINT64 timestamp;  // bytes 0 to 7
  UINT64 order_id;   // bytes 8 to 15
  UINT32 quantity;   // bytes 16 to 19
  UINT64 price;      // bytes 20 to 27
  UINT8 reserved_1;  // byte 28
} ModifyOrderMessage;

// Sent whenever a booked order is cancelled or leaves the order book. The Order Id refers to the Order Id of the original Add Order message.
typedef struct _DeleteOrderMessage {
  UINT64 timestamp;  // bytes 0 to 7
  UINT64 order_id;   // bytes 8 to 15
} DeleteOrderMessage;

// Provides information about executions of non-displayed and undisclosed orders (including auction executions of undisclosed orders), on the CXA book or executions that occur off-exchange and reported to CXA. Trade messages for on-exchange electronic executions are necessary to calculate CXA execution-based data. Trade messages do not alter the book and can be ignored if messages are being used solely to build a book.
typedef struct _TradeMessage {
  UINT64 timestamp;                      // bytes 0 to 7
  UINT8 symbol[6];                       // bytes 8 to 13
  UINT32 quantity;                       // bytes 14 to 17
  UINT64 price;                          // bytes 18 to 25
  UINT64 execution_id;                   // bytes 26 to 33
  UINT64 order_id;                       // bytes 34 to 41
  UINT64 contra_order_id;                // bytes 42 to 49
  UINT8 pid[4];                          // bytes 50 to 53
  UINT8 contra_pid[4];                   // bytes 54 to 57
  UINT8 trade_type;                      // byte 58
  UINT8 trade_designation;               // byte 59
  UINT8 trade_report_type;               // byte 60
  UINT64 trade_transaction_time;         // bytes 61 to 68
  UINT8 unused_1 : 1;                    // byte 69
  UINT8 trade_from_converted_order : 1;  // byte 69
  UINT8 unused_6 : 6;                    // byte 69
} TradeMessage;

// Sent whenever an execution on CXA or off-exchange trade reported to CXA is cancelled. A trade correction is performed by sending a Trade Break message followed by a new Trade message with the corrected size and price. Applications that simply build a CXA book can ignore Trade Break messages.
typedef struct _TradeBreakMessage {
  UINT64 timestamp;     // bytes 0 to 7
  UINT64 execution_id;  // bytes 8 to 15
} TradeBreakMessage;

// Sent when CXA calculates market values for a specified symbol or when a calculated market value is reported to CXA. The specified symbol may not trade on CXA, but instead could represent index or iNAV values reported to CXA from third parties as indicated by the Value Category field. The index values will be reported on each of the unitised CXA PITCH feeds and are not specific to an individual unit.
typedef struct _CalculatedValueMessage {
  UINT64 timestamp;        // bytes 0 to 7
  UINT8 symbol[6];         // bytes 8 to 13
  UINT8 value_category;    // byte 14
  UINT64 value;            // bytes 15 to 22
  UINT64 value_timestamp;  // bytes 23 to 30
} CalculatedValueMessage;

// Sent for each unit when the unit shuts down. No additional sequenced messages will be delivered for this unit, but heartbeats from the unit may be received.
typedef struct _EndOfSessionMessage {
  UINT32 reserved_4;  // bytes 0 to 3
} EndOfSessionMessage;

// Sent during Pre-Open and Pre-Close trading states when a symbol has an order update relating to an overlapping order book (where the best bid price is greater than or equal to the best ask price). Includes the potential number of shares and the indicative auction price if the symbol were to undergo an auction now. Only sent if there are updates to the Buy Shares, Sell Shares, or Indicative Price fields.
typedef struct _AuctionUpdateMessage {
  UINT64 timestamp;         // bytes 0 to 7
  UINT8 symbol[6];          // bytes 8 to 13
  UINT8 auction_type;       // byte 14
  UINT32 buy_shares;        // bytes 15 to 18
  UINT32 sell_shares;       // bytes 19 to 22
  UINT64 indicative_price;  // bytes 23 to 30
  UINT8 reserved_1;         // byte 31
} AuctionUpdateMessage;

// Sent at the completion of the Auction per symbol and includes the Auction Price and Shares executed. If there is no overlapping order book at the time of the auction, no auction trades will result, but the Auction Summary message will still be disseminated and contain zeroes in the Price and Shares fields.
typedef struct _AuctionSummaryMessage {
  UINT64 timestamp;    // bytes 0 to 7
  UINT8 symbol[6];     // bytes 8 to 13
  UINT8 auction_type;  // byte 14
  UINT64 price;        // bytes 15 to 22
  UINT32 shares;       // bytes 23 to 26
  UINT8 reserved_1;    // byte 27
} AuctionSummaryMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x97: UnitClearMessage unit_clear_message;
    case 0x3B: TradingStatusMessage trading_status_message;
    case 0x37: AddOrderMessage add_order_message;
    case 0x38: OrderExecutedMessage order_executed_message;
    case 0x58: OrderExecutedAtPriceMessage order_executed_at_price_message;
    case 0x39: ReduceSizeMessage reduce_size_message;
    case 0x3A: ModifyOrderMessage modify_order_message;
    case 0x3C: DeleteOrderMessage delete_order_message;
    case 0x3D: TradeMessage trade_message;
    case 0x3E: TradeBreakMessage trade_break_message;
    case 0xE3: CalculatedValueMessage calculated_value_message;
    case 0x2D: EndOfSessionMessage end_of_session_message;
    case 0x59: AuctionUpdateMessage auction_update_message;
    case 0x5A: AuctionSummaryMessage auction_summary_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

