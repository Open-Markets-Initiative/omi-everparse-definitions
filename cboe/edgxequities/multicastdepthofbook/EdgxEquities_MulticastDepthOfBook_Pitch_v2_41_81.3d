// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_TIME_REFERENCE_MESSAGE 0xB1                // Time Reference Message
#define MESSAGE_TYPE_TIME_MESSAGE 0x20                          // Time Message
#define MESSAGE_TYPE_UNIT_CLEAR_MESSAGE 0x97                    // Unit Clear Message
#define MESSAGE_TYPE_ADD_ORDER_LONG_MESSAGE 0x21                // Add Order Long Message
#define MESSAGE_TYPE_ADD_ORDER_SHORT_MESSAGE 0x22               // Add Order Short Message
#define MESSAGE_TYPE_ADD_ORDER_EXPANDED_MESSAGE 0x2F            // Add Order Expanded Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x23                // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_AT_PRICE_SIZE_MESSAGE 0x24  // Order Executed At Price Size Message
#define MESSAGE_TYPE_REDUCE_SIZE_LONG_MESSAGE 0x25              // Reduce Size Long Message
#define MESSAGE_TYPE_REDUCE_SIZE_SHORT_MESSAGE 0x26             // Reduce Size Short Message
#define MESSAGE_TYPE_MODIFY_ORDER_LONG_MESSAGE 0x27             // Modify Order Long Message
#define MESSAGE_TYPE_MODIFY_ORDER_SHORT_MESSAGE 0x28            // Modify Order Short Message
#define MESSAGE_TYPE_DELETE_ORDER_MESSAGE 0x29                  // Delete Order Message
#define MESSAGE_TYPE_TRADE_LONG_MESSAGE 0x2A                    // Trade Long Message
#define MESSAGE_TYPE_TRADE_SHORT_MESSAGE 0x2B                   // Trade Short Message
#define MESSAGE_TYPE_TRADE_EXPANDED_MESSAGE 0x30                // Trade Expanded Message
#define MESSAGE_TYPE_TRADE_BREAK_MESSAGE 0x2C                   // Trade Break Message
#define MESSAGE_TYPE_END_OF_SESSION_MESSAGE 0x2D                // End Of Session Message
#define MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x31                // Trading Status Message
#define MESSAGE_TYPE_AUCTION_UPDATE_MESSAGE 0x95                // Auction Update Message
#define MESSAGE_TYPE_AUCTION_SUMMARY_MESSAGE 0x96               // Auction Summary Message
#define MESSAGE_TYPE_RETAIL_PRICE_IMPROVEMENT_MESSAGE 0x98      // Retail Price Improvement Message

// Side Indicator: one byte code
#define SIDE_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define SIDE_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Customer Indicator: one byte code
#define CUSTOMER_INDICATOR_NON_CUSTOMER 0x4E                              // Non Customer
#define CUSTOMER_INDICATOR_CUSTOMER 0x43                                  // Customer
#define CUSTOMER_INDICATOR_RETAIL_PRIORITY_ORDER_EDGX_EQUITIES_ONLY 0x52  // Retail Priority Order Edgx Equities Only

// Trading Status: one byte code
#define TRADING_STATUS_ACCEPTING_ORDERS_FOR_QUEUING 0x41  // Accepting Orders For Queuing
#define TRADING_STATUS_HALTED 0x48                        // Halted
#define TRADING_STATUS_QUOTE_ONLY 0x51                    // Quote Only
#define TRADING_STATUS_EXCHANGE_SPECIFIC_SUSPENSION 0x53  // Exchange Specific Suspension
#define TRADING_STATUS_TRADING 0x54                       // Trading

// Reg Sho Action: one byte code
#define REG_SHO_ACTION_NO_PRICE_TEST_IN_EFFECT 0x30                   // No Price Test In Effect
#define REG_SHO_ACTION_REG_SHO_PRICE_TEST_RESTRICTION_IN_EFFECT 0x31  // Reg Sho Price Test Restriction In Effect

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING_AUCTION 0x4F            // Opening Auction
#define AUCTION_TYPE_CLOSING_AUCTION 0x43            // Closing Auction
#define AUCTION_TYPE_HALT_AUCTION 0x48               // Halt Auction
#define AUCTION_TYPE_IPO_AUCTION 0x49                // Ipo Auction
#define AUCTION_TYPE_CBOE_MARKET_CLOSE 0x4D          // Cboe Market Close
#define AUCTION_TYPE_GTH_OPENING_C_1_ONLY 0x47       // Gth Opening C 1 Only
#define AUCTION_TYPE_VOLATILITY_AUCTION 0x56         // Volatility Auction
#define AUCTION_TYPE_PERIODIC_AUCTION_BYX_ONLY 0x50  // Periodic Auction Byx Only

// Retail Price Improvement: one byte code
#define RETAIL_PRICE_IMPROVEMENT_BUY_SIDE_RPI 0x42      // Buy Side Rpi
#define RETAIL_PRICE_IMPROVEMENT_SELL_SIDE_RPI 0x53     // Sell Side Rpi
#define RETAIL_PRICE_IMPROVEMENT_BUY_AND_SELL_RPI 0x41  // Buy And Sell Rpi
#define RETAIL_PRICE_IMPROVEMENT_NO_RPI 0x4E            // No Rpi

// ---- Types -------------------------------------------------------------------

// The Time Reference message is used to provide a midnight reference point for recipients of the feed. It is sent whenever the system starts up and when the system crosses a midnight boundary. All subsequent Time messages for the same unit will use the last Midnight Reference until another Time Reference message is received for that unit. The Time Reference message includes the Trade Date, so most other sequenced messages will not include that information.
typedef struct _TimeReferenceMessage {
  UINT32 midnight_reference;  // bytes 0 to 3
  UINT32 time;                // bytes 4 to 7
  UINT32 time_offset;         // bytes 8 to 11
  UINT32 trade_date;          // bytes 12 to 15
} TimeReferenceMessage;

// A Time message is immediately generated and sent when there is a PITCH event for a given clock second. If there is no PITCH event for a given clock second, then no Time message is sent for that second. The Time field is the number of seconds relative to midnight Eastern Time. All subsequent time offset fields for the same unit will use the new Time message value as the base until another Time message is received for the same unit. On C1 Options only and effective 11/02/26 for BZX/EDGX Equities, the Time message also includes the Epoch Time field.
typedef struct _TimeMessage {
  UINT32 time;        // bytes 0 to 3
  UINT32 epoch_time;  // bytes 4 to 7
} TimeMessage;

// The Unit Clear message instructs feed recipients to clear all orders for the Cboe book in the unit specified in the Sequenced Unit Header message. For Equities only, this message will be sent at startup each day. It would also be distributed in certain recovery events such as a data center fail-over.
typedef struct _UnitClearMessage {
  UINT32 time_offset;  // bytes 0 to 3
} UnitClearMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book. It includes a day-specific Order Id assigned by Cboe to the order. The Long form is used when the price cannot be represented by a Binary Short Price or the Quantity cannot be represented by an unsigned 16-bit integer.
typedef struct _AddOrderLongMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT32 quantity_long;   // bytes 13 to 16
  UINT8 symbol_short[6];  // bytes 17 to 22
  UINT64 price_long;      // bytes 23 to 30
  UINT8 unused_3 : 3;     // byte 31
  UINT8 aon : 1;          // byte 31
  UINT8 unused_4 : 4;     // byte 31
} AddOrderLongMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book. It includes a day-specific Order Id assigned by Cboe to the order. The Short form is used whenever possible.
typedef struct _AddOrderShortMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT16 quantity_short;  // bytes 13 to 14
  UINT8 symbol_short[6];  // bytes 15 to 20
  UINT16 price_short;     // bytes 21 to 22
  UINT8 unused_3 : 3;     // byte 23
  UINT8 aon : 1;          // byte 23
  UINT8 unused_4 : 4;     // byte 23
} AddOrderShortMessage;

// The Expanded version of the Add Order message has been made available to accommodate larger symbol sizes possible through the ISRA plan.
typedef struct _AddOrderExpandedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT8 side_indicator;      // byte 12
  UINT32 quantity_long;      // bytes 13 to 16
  UINT8 symbol_long[8];      // bytes 17 to 24
  UINT64 price_long;         // bytes 25 to 32
  UINT8 unused_3 : 3;        // byte 33
  UINT8 aon : 1;             // byte 33
  UINT8 unused_4 : 4;        // byte 33
  UINT8 participant_id[4];   // bytes 34 to 37
  UINT8 customer_indicator;  // byte 38
} AddOrderExpandedMessage;

// Order Executed messages are sent when a visible order on the Cboe book is executed in whole or in part. The execution price equals the limit order price found in the original Add Order message or the limit order price in the latest Modify Order message referencing the Order Id.
typedef struct _OrderExecutedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT32 executed_quantity;  // bytes 12 to 15
  UINT64 execution_id;       // bytes 16 to 23
} OrderExecutedMessage;

// Order Executed at Price/Size messages are sent when a visible order on the Cboe book is executed in whole or in part at a different price than the limit price on the original Add Order message or the limit order price in the latest Modify Order message referencing the Order Id. If the Remaining Quantity field contains a 0 the order should be completely removed from the book.
typedef struct _OrderExecutedAtPriceSizeMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT64 order_id;            // bytes 4 to 11
  UINT32 executed_quantity;   // bytes 12 to 15
  UINT32 remaining_quantity;  // bytes 16 to 19
  UINT64 execution_id;        // bytes 20 to 27
  UINT64 price_long;          // bytes 28 to 35
} OrderExecutedAtPriceSizeMessage;

// Reduce Size messages are sent when a visible order on the Cboe book is partially reduced. The Long form is used when the Canceled Quantity cannot be represented by an unsigned 16-bit integer.
typedef struct _ReduceSizeLongMessage {
  UINT32 time_offset;             // bytes 0 to 3
  UINT64 order_id;                // bytes 4 to 11
  UINT32 canceled_quantity_long;  // bytes 12 to 15
} ReduceSizeLongMessage;

// Reduce Size messages are sent when a visible order on the Cboe book is partially reduced. The Short form is used whenever possible.
typedef struct _ReduceSizeShortMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT16 canceled_quantity_short;  // bytes 12 to 13
} ReduceSizeShortMessage;

// The Modify Order message is sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message. Note that Modify Order messages that appear to be No Ops (i.e. they do not appear to modify any relevant fields) will still lose priority. The Long form is used when the Price cannot be represented by a Binary Short Price or the Quantity cannot be represented by an unsigned 16-bit integer.
typedef struct _ModifyOrderLongMessage {
  UINT32 time_offset;           // bytes 0 to 3
  UINT64 order_id;              // bytes 4 to 11
  UINT32 quantity_long;         // bytes 12 to 15
  UINT64 price_long;            // bytes 16 to 23
  UINT8 display : 1;            // byte 24
  UINT8 maintain_priority : 1;  // byte 24
  UINT8 unused_6 : 6;           // byte 24
} ModifyOrderLongMessage;

// The Modify Order message is sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message. The Short form is used whenever possible.
typedef struct _ModifyOrderShortMessage {
  UINT32 time_offset;           // bytes 0 to 3
  UINT64 order_id;              // bytes 4 to 11
  UINT16 quantity_short;        // bytes 12 to 13
  UINT16 price_short;           // bytes 14 to 15
  UINT8 display : 1;            // byte 16
  UINT8 maintain_priority : 1;  // byte 16
  UINT8 unused_6 : 6;           // byte 16
} ModifyOrderShortMessage;

// The Delete Order message is sent whenever a booked order is cancelled or leaves the order book. The Order Id refers to the Order Id of the original Add Order message. An order that is deleted from the book may return to the book later under certain circumstances. Therefore, a Delete Order message does not indicate that a given Order Id will not be sent again on a subsequent Add Order message.
typedef struct _DeleteOrderMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
} DeleteOrderMessage;

// The Trade message provides information about executions of non-displayed orders on the Cboe book and routed executions to other trading centers. Trade messages are necessary to calculate Cboe execution-based data. Trade messages do not alter the book and can be ignored if messages are being used solely to build a book. No Add Order message is sent for hidden orders, and thus, no modify order messages may be sent when hidden orders are executed. The Long form is used when the price cannot be represented by a Binary Short Price or the Quantity cannot be represented by an unsigned 16-bit integer.
typedef struct _TradeLongMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT32 quantity_long;   // bytes 13 to 16
  UINT8 symbol_short[6];  // bytes 17 to 22
  UINT64 price_long;      // bytes 23 to 30
  UINT64 execution_id;    // bytes 31 to 38
} TradeLongMessage;

// The Trade message provides information about executions of non-displayed orders on the Cboe book and routed executions to other trading centers. The Short form is used whenever possible.
typedef struct _TradeShortMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT16 quantity_short;  // bytes 13 to 14
  UINT8 symbol_short[6];  // bytes 15 to 20
  UINT16 price_short;     // bytes 21 to 22
  UINT64 execution_id;    // bytes 23 to 30
} TradeShortMessage;

// The Expanded version of the Trade message has been made available to accommodate larger symbol sizes possible through the ISRA plan.
typedef struct _TradeExpandedMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT64 order_id;       // bytes 4 to 11
  UINT8 side_indicator;  // byte 12
  UINT32 quantity_long;  // bytes 13 to 16
  UINT8 symbol_long[8];  // bytes 17 to 24
  UINT64 price_long;     // bytes 25 to 32
  UINT64 execution_id;   // bytes 33 to 40
} TradeExpandedMessage;

// The Trade Break message is sent whenever an execution on Cboe is broken. Trade breaks are rare and only affect applications that rely upon Cboe execution-based data. Applications that simply build a Cboe book can ignore Trade Break messages.
typedef struct _TradeBreakMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 execution_id;  // bytes 4 to 11
} TradeBreakMessage;

// The End of Session message is sent for each unit when the unit shuts down. No more sequenced messages will be delivered for this unit, but heartbeats from the unit may be received.
typedef struct _EndOfSessionMessage {
  UINT32 time_offset;  // bytes 0 to 3
} EndOfSessionMessage;

// The Trading Status message is used to indicate the current trading status of a security. A Trading Status message will be sent whenever a security's trading status changes. Trading Status of S is to be implied at system startup for all symbols. Starting at 6:00 a.m. ET, Cboe will send a Trading Status of A once orders can be accepted for queuing in preparation for the market open. At 7:00 a.m. ET, Cboe will send a Trading Status of T as symbols are open for trading on the Cboe platform. On BZX and EDGX only, Cboe will send a Trading Status of A starting at 2:30 a.m. ET and a Trading Status of T at 4:00 a.m. ET.
typedef struct _TradingStatusMessage {
  UINT32 time_offset;       // bytes 0 to 3
  UINT8 symbol_long[8];     // bytes 4 to 11
  UINT8 trading_status;     // byte 12
  UINT8 reg_sho_action;     // byte 13
  UINT8 reserved_1;         // byte 14
  UINT8 second_reserved_1;  // byte 15
} TradingStatusMessage;

// BYX and BZX Equities Only. Auction Update messages are used to disseminate Cboe price and size information during auctions for Cboe listed securities and for Cboe Market Close (CMC) crosses on BZX, and for Periodic Auctions on BYX. Cboe Auction Update messages support the Cboe Opening, Closing, Halt and IPO Auctions on the BZX Exchange. On the BYX Exchange, Auction Update messages will be sent out at a randomized time between the start of an auction period and the end of the auction period minus 1 millisecond to inform participants that a Periodic Auction is taking place.
typedef struct _AuctionUpdateMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 stock_symbol[8];      // bytes 4 to 11
  UINT8 auction_type;         // byte 12
  UINT64 reference_price;     // bytes 13 to 20
  UINT32 buy_shares;          // bytes 21 to 24
  UINT32 sell_shares;         // bytes 25 to 28
  UINT64 indicative_price;    // bytes 29 to 36
  UINT64 auction_only_price;  // bytes 37 to 44
} AuctionUpdateMessage;

// BYX Equities, BZX Equities, and Options Only. Auction Summary messages are used to disseminate the results of an auction of a Cboe listed security on BZX, the results of an Opening or Re-Opening of any options series on C1, and for Periodic Auctions on BYX. An Auction Summary message will be sent for Cboe Market Close (CMC) once the official closing price for each security is available.
typedef struct _AuctionSummaryMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT8 stock_symbol[8];  // bytes 4 to 11
  UINT8 auction_type;     // byte 12
  UINT64 price_long;      // bytes 13 to 20
  UINT32 shares;          // bytes 21 to 24
} AuctionSummaryMessage;

// BYX and (effective 04/10/26) EDGX Only. The Retail Price Improvement message is only available on the BYX and EDGX Exchanges. This message is a Retail Liquidity Indicator (RLI) that includes symbol and side, but not price and size. An RLI will be disseminated when there is a Retail Price Improving (RPI) order present for a symbol on the Exchange order book OR to indicate a RPI order is no longer available. RPI orders offer price improvement in increments of .001 to Retail Member Organizations. Cboe will disseminate a Retail Price Improvement message when the resting RPI order is priced better than the NBBO.
typedef struct _RetailPriceImprovementMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT8 symbol_long[8];            // bytes 4 to 11
  UINT8 retail_price_improvement;  // byte 12
} RetailPriceImprovementMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0xB1: TimeReferenceMessage time_reference_message;
    case 0x20: TimeMessage time_message;
    case 0x97: UnitClearMessage unit_clear_message;
    case 0x21: AddOrderLongMessage add_order_long_message;
    case 0x22: AddOrderShortMessage add_order_short_message;
    case 0x2F: AddOrderExpandedMessage add_order_expanded_message;
    case 0x23: OrderExecutedMessage order_executed_message;
    case 0x24: OrderExecutedAtPriceSizeMessage order_executed_at_price_size_message;
    case 0x25: ReduceSizeLongMessage reduce_size_long_message;
    case 0x26: ReduceSizeShortMessage reduce_size_short_message;
    case 0x27: ModifyOrderLongMessage modify_order_long_message;
    case 0x28: ModifyOrderShortMessage modify_order_short_message;
    case 0x29: DeleteOrderMessage delete_order_message;
    case 0x2A: TradeLongMessage trade_long_message;
    case 0x2B: TradeShortMessage trade_short_message;
    case 0x30: TradeExpandedMessage trade_expanded_message;
    case 0x2C: TradeBreakMessage trade_break_message;
    case 0x2D: EndOfSessionMessage end_of_session_message;
    case 0x31: TradingStatusMessage trading_status_message;
    case 0x95: AuctionUpdateMessage auction_update_message;
    case 0x96: AuctionSummaryMessage auction_summary_message;
    case 0x98: RetailPriceImprovementMessage retail_price_improvement_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

