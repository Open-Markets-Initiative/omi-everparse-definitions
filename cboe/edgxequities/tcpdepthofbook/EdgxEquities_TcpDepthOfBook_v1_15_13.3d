// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Frame, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out EdgxEquities_TcpDepthOfBook_v1_15_13.3d
//
// What this definition reads more loosely than the model states:
// - the stream is a run of frames each ending at a byte 10: the caller splits it there and validates each frame, that byte included

// ---- Values ------------------------------------------------------------------

// Packet Type: one byte code
#define PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define PACKET_TYPE_LOGIN_REQUEST_PACKET 0x4C     // Login Request Packet
#define PACKET_TYPE_UNSEQUENCED_DATA_PACKET 0x55  // Unsequenced Data Packet
#define PACKET_TYPE_CLIENT_HEARTBEAT_PACKET 0x52  // Client Heartbeat Packet
#define PACKET_TYPE_LOGOUT_REQUEST_PACKET 0x4F    // Logout Request Packet

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_SYMBOL_CLEAR_MESSAGE 0x73              // Symbol Clear Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_SHORT_MESSAGE 0x41           // Add Order Short Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_LONG_MESSAGE 0x64            // Add Order Long Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_EXTENDED_MESSAGE 0x31        // Add Order Extended Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45            // Order Executed Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_CANCEL_MESSAGE 0x58              // Order Cancel Message
#define SEQUENCED_MESSAGE_TYPE_TRADE_SHORT_MESSAGE 0x50               // Trade Short Message
#define SEQUENCED_MESSAGE_TYPE_TRADE_LONG_MESSAGE 0x72                // Trade Long Message
#define SEQUENCED_MESSAGE_TYPE_TRADE_EXTENDED_MESSAGE 0x32            // Trade Extended Message
#define SEQUENCED_MESSAGE_TYPE_TRADE_BREAK_MESSAGE 0x42               // Trade Break Message
#define SEQUENCED_MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x48            // Trading Status Message
#define SEQUENCED_MESSAGE_TYPE_AUCTION_UPDATE_MESSAGE 0x49            // Auction Update Message
#define SEQUENCED_MESSAGE_TYPE_EXTENDED_AUCTION_UPDATE_MESSAGE 0x33   // Extended Auction Update Message
#define SEQUENCED_MESSAGE_TYPE_AUCTION_SUMMARY_MESSAGE 0x4A           // Auction Summary Message
#define SEQUENCED_MESSAGE_TYPE_EXTENDED_AUCTION_SUMMARY_MESSAGE 0x34  // Extended Auction Summary Message
#define SEQUENCED_MESSAGE_TYPE_RETAIL_PRICE_IMPROVEMENT_MESSAGE 0x52  // Retail Price Improvement Message

// Side Indicator: one byte code
#define SIDE_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define SIDE_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Customer Indicator: one byte code
#define CUSTOMER_INDICATOR_RETAIL 0x52  // Retail

// Halt Status: one byte code
#define HALT_STATUS_ACCEPTING_ORDERS_FOR_QUEUING 0x41  // Accepting Orders For Queuing
#define HALT_STATUS_HALTED 0x48                        // Halted
#define HALT_STATUS_QUOTE_ONLY_CBOE_LISTINGS 0x51      // Quote Only Cboe Listings
#define HALT_STATUS_EXCHANGE_SPECIFIC_SUSPENSION 0x53  // Exchange Specific Suspension
#define HALT_STATUS_TRADING 0x54                       // Trading

// Reg Sho Action: one byte code
#define REG_SHO_ACTION_NO_PRICE_TEST_IN_EFFECT 0x30                   // No Price Test In Effect
#define REG_SHO_ACTION_REG_SHO_PRICE_TEST_RESTRICTION_IN_EFFECT 0x31  // Reg Sho Price Test Restriction In Effect

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING_AUCTION 0x4F            // Opening Auction
#define AUCTION_TYPE_CLOSING_AUCTION 0x43            // Closing Auction
#define AUCTION_TYPE_HALT_AUCTION 0x48               // Halt Auction
#define AUCTION_TYPE_IPO_AUCTION 0x49                // Ipo Auction
#define AUCTION_TYPE_CBOE_MARKET_CLOSE 0x4D          // Cboe Market Close
#define AUCTION_TYPE_PERIODIC_AUCTION_BYX_ONLY 0x50  // Periodic Auction Byx Only

// Retail Price Improvement: one byte code
#define RETAIL_PRICE_IMPROVEMENT_BUY_SIDE_RPI 0x42      // Buy Side Rpi
#define RETAIL_PRICE_IMPROVEMENT_SELL_SIDE_RPI 0x53     // Sell Side Rpi
#define RETAIL_PRICE_IMPROVEMENT_BUY_AND_SELL_RPI 0x41  // Buy And Sell Rpi
#define RETAIL_PRICE_IMPROVEMENT_NO_RPI 0x4E            // No Rpi

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems.
typedef struct _DebugPacket {
  UINT8 text;  // byte 0
} DebugPacket;

// The Soup 2.0 server sends a Login Accepted Packet in response to receiving a valid Login Request from the client.
typedef struct _LoginAcceptedPacket {
  UINT8 session[10];          // bytes 0 to 9
  UINT8 sequence_number[10];  // bytes 10 to 19
} LoginAcceptedPacket;

// The Soup 2.0 server sends this packet in response to an invalid Login Request Packet from the client.
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// The Symbol Clear message instructs feed recipients to clear all orders for the Cboe book in the specified symbol.
typedef struct _SymbolClearMessage {
  UINT8 stock_symbol_long[8];  // bytes 0 to 7
} SymbolClearMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book.
typedef struct _AddOrderShortMessage {
  UINT8 order_id[12];           // bytes 0 to 11
  UINT8 side_indicator;         // byte 12
  UINT8 shares_short[6];        // bytes 13 to 18
  UINT8 stock_symbol_short[6];  // bytes 19 to 24
  UINT8 price_short[10];        // bytes 25 to 34
  UINT8 reserved;               // byte 35
} AddOrderShortMessage;

// The long version of the Add Order message accommodates larger symbol sizes possible through the ISRA plan.
typedef struct _AddOrderLongMessage {
  UINT8 order_id[12];          // bytes 0 to 11
  UINT8 side_indicator;        // byte 12
  UINT8 shares_short[6];       // bytes 13 to 18
  UINT8 stock_symbol_long[8];  // bytes 19 to 26
  UINT8 price_short[10];       // bytes 27 to 36
  UINT8 reserved;              // byte 37
  UINT8 participant_id[4];     // bytes 38 to 41
  UINT8 customer_indicator;    // byte 42
} AddOrderLongMessage;

// The extended version of the Add Order message accommodates larger prices.
typedef struct _AddOrderExtendedMessage {
  UINT8 order_id[12];          // bytes 0 to 11
  UINT8 side_indicator;        // byte 12
  UINT8 shares_short[6];       // bytes 13 to 18
  UINT8 stock_symbol_long[8];  // bytes 19 to 26
  UINT8 price_long[14];        // bytes 27 to 40
  UINT8 display;               // byte 41
  UINT8 participant_id[4];     // bytes 42 to 45
  UINT8 customer_indicator;    // byte 46
} AddOrderExtendedMessage;

// Order Executed messages are sent when a visible order on the Cboe book is executed in whole or in part.
typedef struct _OrderExecutedMessage {
  UINT8 order_id[12];        // bytes 0 to 11
  UINT8 executed_shares[6];  // bytes 12 to 17
  UINT8 execution_id[12];    // bytes 18 to 29
} OrderExecutedMessage;

// Order Cancel messages are sent when a visible order on the Cboe book is canceled in whole or in part.
typedef struct _OrderCancelMessage {
  UINT8 order_id[12];        // bytes 0 to 11
  UINT8 canceled_shares[6];  // bytes 12 to 17
} OrderCancelMessage;

// The Trade message provides information about executions of non-displayed orders or shares on the Cboe book and routed orders.
typedef struct _TradeShortMessage {
  UINT8 order_id[12];           // bytes 0 to 11
  UINT8 side_indicator;         // byte 12
  UINT8 shares_short[6];        // bytes 13 to 18
  UINT8 stock_symbol_short[6];  // bytes 19 to 24
  UINT8 price_short[10];        // bytes 25 to 34
  UINT8 execution_id[12];       // bytes 35 to 46
} TradeShortMessage;

// The long version of the Trade message accommodates larger symbol sizes possible through the ISRA plan.
typedef struct _TradeLongMessage {
  UINT8 order_id[12];          // bytes 0 to 11
  UINT8 side_indicator;        // byte 12
  UINT8 shares_short[6];       // bytes 13 to 18
  UINT8 stock_symbol_long[8];  // bytes 19 to 26
  UINT8 price_short[10];       // bytes 27 to 36
  UINT8 execution_id[12];      // bytes 37 to 48
} TradeLongMessage;

// The extended version of the Trade message accommodates larger prices.
typedef struct _TradeExtendedMessage {
  UINT8 order_id[12];          // bytes 0 to 11
  UINT8 side_indicator;        // byte 12
  UINT8 shares_short[6];       // bytes 13 to 18
  UINT8 stock_symbol_long[8];  // bytes 19 to 26
  UINT8 price_long[14];        // bytes 27 to 40
  UINT8 execution_id[12];      // bytes 41 to 52
} TradeExtendedMessage;

// The Trade Break message is sent whenever an execution on Cboe is broken.
typedef struct _TradeBreakMessage {
  UINT8 execution_id[12];  // bytes 0 to 11
} TradeBreakMessage;

// The Trading Status message is used to indicate the current trading status of a security.
typedef struct _TradingStatusMessage {
  UINT8 stock_symbol_long[8];  // bytes 0 to 7
  UINT8 halt_status;           // byte 8
  UINT8 reg_sho_action;        // byte 9
  UINT8 reserved_1;            // byte 10
  UINT8 reserved_2;            // byte 11
} TradingStatusMessage;

// Auction Update messages are used to disseminate Cboe price and size information during auctions for Cboe listed securities on BZX, and for Periodic Auctions on BYX.
typedef struct _AuctionUpdateMessage {
  UINT8 stock_symbol_long[8];          // bytes 0 to 7
  UINT8 auction_type;                  // byte 8
  UINT8 reference_price_short[10];     // bytes 9 to 18
  UINT8 buy_shares[10];                // bytes 19 to 28
  UINT8 sell_shares[10];               // bytes 29 to 38
  UINT8 indicative_price_short[10];    // bytes 39 to 48
  UINT8 auction_only_price_short[10];  // bytes 49 to 58
} AuctionUpdateMessage;

// The extended version of the BZX Auction Update message accommodates larger prices.
typedef struct _ExtendedAuctionUpdateMessage {
  UINT8 stock_symbol_long[8];         // bytes 0 to 7
  UINT8 auction_type;                 // byte 8
  UINT8 reference_price_long[14];     // bytes 9 to 22
  UINT8 buy_shares[10];               // bytes 23 to 32
  UINT8 sell_shares[10];              // bytes 33 to 42
  UINT8 indicative_price_long[14];    // bytes 43 to 56
  UINT8 auction_only_price_long[14];  // bytes 57 to 70
} ExtendedAuctionUpdateMessage;

// Auction Summary messages are used to disseminate the results of an auction of a Cboe listed security on BZX, and for Periodic Auctions on BYX.
typedef struct _AuctionSummaryMessage {
  UINT8 stock_symbol_long[8];  // bytes 0 to 7
  UINT8 auction_type;          // byte 8
  UINT8 price_short[10];       // bytes 9 to 18
  UINT8 shares_long[10];       // bytes 19 to 28
} AuctionSummaryMessage;

// The extended version of the Auction Summary message accommodates larger prices.
typedef struct _ExtendedAuctionSummaryMessage {
  UINT8 stock_symbol_long[8];  // bytes 0 to 7
  UINT8 auction_type;          // byte 8
  UINT8 price_long[14];        // bytes 9 to 22
  UINT8 shares_long[10];       // bytes 23 to 32
} ExtendedAuctionSummaryMessage;

// The Retail Price Improvement message is only available on the BYX Exchange. This message is a Retail Liquidity Indicator (RLI) that includes symbol and side, but not price and size.
typedef struct _RetailPriceImprovementMessage {
  UINT8 stock_symbol_long[8];      // bytes 0 to 7
  UINT8 retail_price_improvement;  // byte 8
} RetailPriceImprovementMessage;

// Branch
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x73: SymbolClearMessage symbol_clear_message;
    case 0x41: AddOrderShortMessage add_order_short_message;
    case 0x64: AddOrderLongMessage add_order_long_message;
    case 0x31: AddOrderExtendedMessage add_order_extended_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x58: OrderCancelMessage order_cancel_message;
    case 0x50: TradeShortMessage trade_short_message;
    case 0x72: TradeLongMessage trade_long_message;
    case 0x32: TradeExtendedMessage trade_extended_message;
    case 0x42: TradeBreakMessage trade_break_message;
    case 0x48: TradingStatusMessage trading_status_message;
    case 0x49: AuctionUpdateMessage auction_update_message;
    case 0x33: ExtendedAuctionUpdateMessage extended_auction_update_message;
    case 0x4A: AuctionSummaryMessage auction_summary_message;
    case 0x34: ExtendedAuctionSummaryMessage extended_auction_summary_message;
    case 0x52: RetailPriceImprovementMessage retail_price_improvement_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol.
typedef struct _SequencedDataPacket (UINT32 available) where (available >= 9) {
  UINT8 timestamp[8];                                                                                                            // bytes 0 to 7
  UINT8 sequenced_message_type;                                                                                                  // byte 8
  SequencedMessage(sequenced_message_type, (available - 9)) sequenced_message[:byte-size-single-element-array (available - 9)];
} SequencedDataPacket;

// The Soup 2.0 client must send a Login Request Packet immediately upon establishing a new TCP/IP socket connection to the server.
typedef struct _LoginRequestPacket {
  UINT8 username[6];                    // bytes 0 to 5
  UINT8 password[10];                   // bytes 6 to 15
  UINT8 requested_session[10];          // bytes 16 to 25
  UINT8 requested_sequence_number[10];  // bytes 26 to 35
} LoginRequestPacket;

// The Unsequenced Data Packets act as an envelope to carry the actual data messages that are transferred from the client to the server. These messages are not sequenced and may be lost in the event of a socket failure.
typedef struct _UnsequencedDataPacket (UINT32 available) where (available >= 1) {
  UINT8 unsequenced_message[(available - 1)];
} UnsequencedDataPacket;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(available) sequenced_data_packet;
    case 0x4C: LoginRequestPacket login_request_packet;
    case 0x55: UnsequencedDataPacket(available) unsequenced_data_packet;
    default: UINT8 unknown[available];
  }
} Payload;

// ---- Packet: Frame -----------------------------------------------------------

// Soup 2.0 Lf terminated record
entrypoint typedef struct _Frame (UINT32 available) where (available >= 2) {
  UINT8 packet_type;                                                                               // byte 0
  Payload(packet_type, (available - 2)) payload[:byte-size-single-element-array (available - 2)];
  UINT8 soup_lf { soup_lf == 10 };
} Frame;

