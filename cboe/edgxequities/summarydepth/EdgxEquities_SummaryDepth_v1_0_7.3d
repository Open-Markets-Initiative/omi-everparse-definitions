// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out EdgxEquities_SummaryDepth_v1_0_7.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_CLEAR_QUOTE_MESSAGE 0xA2         // Clear Quote Message
#define MESSAGE_TYPE_CBOE_MARKET_STATUS_MESSAGE 0xA6  // Cboe Market Status Message
#define MESSAGE_TYPE_ADAP_MESSAGE 0xA7                // Adap Message
#define MESSAGE_TYPE_RPI_MESSAGE 0xA8                 // Rpi Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0xA9               // Trade Message
#define MESSAGE_TYPE_TRADE_BREAK_MESSAGE 0xAA         // Trade Break Message
#define MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0xAB      // Trading Status Message

// Market Status: one byte code
#define MARKET_STATUS_NORMAL 0x4E                      // Normal
#define MARKET_STATUS_EXCLUDED_FROM_ADAP_UPDATES 0x45  // Excluded From Adap Updates
#define MARKET_STATUS_INCOMPLETE 0x49                  // Incomplete

// Session Indicator: one byte code
#define SESSION_INDICATOR_REGULAR_TRADING_SESSION 0x52     // Regular Trading Session
#define SESSION_INDICATOR_PRE_OR_POST_MARKET_SESSION 0x50  // Pre Or Post Market Session

// Retail Price Improvement: one byte code
#define RETAIL_PRICE_IMPROVEMENT_BUY_SIDE_RPI 0x42      // Buy Side Rpi
#define RETAIL_PRICE_IMPROVEMENT_SELL_SIDE_RPI 0x53     // Sell Side Rpi
#define RETAIL_PRICE_IMPROVEMENT_BUY_AND_SELL_RPI 0x41  // Buy And Sell Rpi
#define RETAIL_PRICE_IMPROVEMENT_NO_RPI 0x4E            // No Rpi

// Reg Sho Action: one byte code
#define REG_SHO_ACTION_NO_PRICE_TEST_IN_EFFECT 0x30                   // No Price Test In Effect
#define REG_SHO_ACTION_REG_SHO_PRICE_TEST_RESTRICTION_IN_EFFECT 0x31  // Reg Sho Price Test Restriction In Effect

// ---- Types -------------------------------------------------------------------

// The Clear Quote message instructs feed recipients to clear all quotes and ADAP information for the specified symbol. This message does not affect the executed volume of the symbol.
typedef struct _ClearQuoteMessage {
  UINT64 last_update_timestamp;  // bytes 0 to 7
  UINT8 symbol[8];               // bytes 8 to 15
  UINT8 reserved_1;              // byte 16
} ClearQuoteMessage;

// The Cboe Market Status message is disseminated to reflect a change in the status of the market.
typedef struct _CboeMarketStatusMessage {
  UINT64 timestamp;         // bytes 0 to 7
  UINT8 reserved_1;         // byte 8
  UINT8 market_status;      // byte 9
  UINT8 session_indicator;  // byte 10
} CboeMarketStatusMessage;

// Short Update ADAP Block
typedef struct _ShortUpdateAdapBlock {
  UINT8 reserved_1;       // byte 0
  UINT8 side;             // byte 1
  UINT32 price_short;     // bytes 2 to 5
  UINT32 quantity_short;  // bytes 6 to 9
} ShortUpdateAdapBlock;

// Long Update ADAP Block
typedef struct _LongUpdateAdapBlock {
  UINT8 reserved_1;      // byte 0
  UINT8 side;            // byte 1
  UINT64 price_long;     // bytes 2 to 9
  UINT64 quantity_long;  // bytes 10 to 17
} LongUpdateAdapBlock;

// Branch
casetype _AdapUpdate (UINT8 selector) {
  switch (selector) {
    case 0x0A: ShortUpdateAdapBlock short_update_adap_block;
    case 0x12: LongUpdateAdapBlock long_update_adap_block;
  }
} AdapUpdate;

// ADAP Block
typedef struct _AdapBlock (UINT8 adap_block_size) {
  AdapUpdate(adap_block_size) adap_update;
} AdapBlock;

// ADAP Block
casetype _AdapBlockPart1 (Bool present, UINT8 adap_block_size) {
  switch (present) {
    case true: AdapBlock(adap_block_size) block;
    case false: unit none;
  }
} AdapBlockPart1;

// ADAP Block
typedef struct _AdapBlockBlock2 (UINT8 adap_block_size) {
  AdapBlock(adap_block_size) first;
  AdapBlock(adap_block_size) second;
} AdapBlockBlock2;

// ADAP Block
casetype _AdapBlockPart2 (Bool present, UINT8 adap_block_size) {
  switch (present) {
    case true: AdapBlockBlock2(adap_block_size) block;
    case false: unit none;
  }
} AdapBlockPart2;

// ADAP Block
typedef struct _AdapBlockBlock4 (UINT8 adap_block_size) {
  AdapBlockBlock2(adap_block_size) first;
  AdapBlockBlock2(adap_block_size) second;
} AdapBlockBlock4;

// ADAP Block
casetype _AdapBlockPart4 (Bool present, UINT8 adap_block_size) {
  switch (present) {
    case true: AdapBlockBlock4(adap_block_size) block;
    case false: unit none;
  }
} AdapBlockPart4;

// ADAP Block
typedef struct _AdapBlockBlock8 (UINT8 adap_block_size) {
  AdapBlockBlock4(adap_block_size) first;
  AdapBlockBlock4(adap_block_size) second;
} AdapBlockBlock8;

// ADAP Block
casetype _AdapBlockPart8 (Bool present, UINT8 adap_block_size) {
  switch (present) {
    case true: AdapBlockBlock8(adap_block_size) block;
    case false: unit none;
  }
} AdapBlockPart8;

// ADAP Block
typedef struct _AdapBlockBlock16 (UINT8 adap_block_size) {
  AdapBlockBlock8(adap_block_size) first;
  AdapBlockBlock8(adap_block_size) second;
} AdapBlockBlock16;

// ADAP Block
casetype _AdapBlockPart16 (Bool present, UINT8 adap_block_size) {
  switch (present) {
    case true: AdapBlockBlock16(adap_block_size) block;
    case false: unit none;
  }
} AdapBlockPart16;

// ADAP Block
typedef struct _AdapBlockBlock32 (UINT8 adap_block_size) {
  AdapBlockBlock16(adap_block_size) first;
  AdapBlockBlock16(adap_block_size) second;
} AdapBlockBlock32;

// ADAP Block
casetype _AdapBlockPart32 (Bool present, UINT8 adap_block_size) {
  switch (present) {
    case true: AdapBlockBlock32(adap_block_size) block;
    case false: unit none;
  }
} AdapBlockPart32;

// ADAP Block
typedef struct _AdapBlockBlock64 (UINT8 adap_block_size) {
  AdapBlockBlock32(adap_block_size) first;
  AdapBlockBlock32(adap_block_size) second;
} AdapBlockBlock64;

// ADAP Block
casetype _AdapBlockPart64 (Bool present, UINT8 adap_block_size) {
  switch (present) {
    case true: AdapBlockBlock64(adap_block_size) block;
    case false: unit none;
  }
} AdapBlockPart64;

// ADAP Block
typedef struct _AdapBlockBlock128 (UINT8 adap_block_size) {
  AdapBlockBlock64(adap_block_size) first;
  AdapBlockBlock64(adap_block_size) second;
} AdapBlockBlock128;

// ADAP Block
casetype _AdapBlockPart128 (Bool present, UINT8 adap_block_size) {
  switch (present) {
    case true: AdapBlockBlock128(adap_block_size) block;
    case false: unit none;
  }
} AdapBlockPart128;

// ADAP Block
typedef struct _AdapBlockCounted (UINT32 count, UINT8 adap_block_size) {
  AdapBlockPart128(((count & 128) != 0), adap_block_size) part128;
  AdapBlockPart64(((count & 64) != 0), adap_block_size) part64;
  AdapBlockPart32(((count & 32) != 0), adap_block_size) part32;
  AdapBlockPart16(((count & 16) != 0), adap_block_size) part16;
  AdapBlockPart8(((count & 8) != 0), adap_block_size) part8;
  AdapBlockPart4(((count & 4) != 0), adap_block_size) part4;
  AdapBlockPart2(((count & 2) != 0), adap_block_size) part2;
  AdapBlockPart1(((count & 1) != 0), adap_block_size) part1;
} AdapBlockCounted;

// Each ADAP message delivers one or more updates for a Symbol's ADAP book.
typedef struct _AdapMessage {
  UINT64 last_update_timestamp;                                          // bytes 0 to 7
  UINT8 symbol[8];                                                       // bytes 8 to 15
  UINT8 clear_adap : 1;                                                  // byte 16
  UINT8 adap_complete : 1;                                               // byte 16
  UINT8 block_type : 1;                                                  // byte 16
  UINT8 spare_5 : 5;                                                     // byte 16
  UINT8 spare_reserved_1;                                                // byte 17
  UINT8 adap_blocks;                                                     // byte 18
  UINT8 adap_block_size;                                                 // byte 19
  AdapBlockCounted(((UINT32) adap_blocks), adap_block_size) adap_block;
} AdapMessage;

// The Retail Price Improvement (RPI) message is a retail liquidity indicator that includes symbol and side, but not price and size.
typedef struct _RpiMessage {
  UINT64 timestamp;                // bytes 0 to 7
  UINT8 symbol[8];                 // bytes 8 to 15
  UINT8 reserved_1;                // byte 16
  UINT8 retail_price_improvement;  // byte 17
} RpiMessage;

// Trade messages are sent when an order is executed in whole or in part on the Cboe exchange.
typedef struct _TradeMessage {
  UINT64 transaction_time;                 // bytes 0 to 7
  UINT8 symbol[8];                         // bytes 8 to 15
  UINT8 reserved_1;                        // byte 16
  UINT64 execution_id;                     // bytes 17 to 24
  UINT64 last_price;                       // bytes 25 to 32
  UINT64 last_quantity;                    // bytes 33 to 40
  UINT64 cboe_cumulative_executed_volume;  // bytes 41 to 48
  UINT8 reserved_8[8];                     // bytes 49 to 56
  UINT8 unused_1 : 1;                      // byte 57
  UINT8 last_sale_eligible : 1;            // byte 57
  UINT8 unused_6 : 6;                      // byte 57
} TradeMessage;

// The Trade Break message is sent whenever an execution on the Cboe exchange is broken.
typedef struct _TradeBreakMessage {
  UINT64 transaction_time;                 // bytes 0 to 7
  UINT8 symbol[8];                         // bytes 8 to 15
  UINT8 reserved_1;                        // byte 16
  UINT64 execution_id;                     // bytes 17 to 24
  UINT64 cboe_cumulative_executed_volume;  // bytes 25 to 32
  UINT8 reserved_8[8];                     // bytes 33 to 40
  UINT8 unused_8 : 8;                      // byte 41
} TradeBreakMessage;

// The Trading Status message is used to indicate the current trading status of a security on the Cboe exchange.
typedef struct _TradingStatusMessage {
  UINT64 timestamp;      // bytes 0 to 7
  UINT8 symbol[8];       // bytes 8 to 15
  UINT8 reserved_1;      // byte 16
  UINT8 halt_status;     // byte 17
  UINT8 reg_sho_action;  // byte 18
} TradingStatusMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0xA2: ClearQuoteMessage clear_quote_message;
    case 0xA6: CboeMarketStatusMessage cboe_market_status_message;
    case 0xA7: AdapMessage adap_message;
    case 0xA8: RpiMessage rpi_message;
    case 0xA9: TradeMessage trade_message;
    case 0xAA: TradeBreakMessage trade_break_message;
    case 0xAB: TradingStatusMessage trading_status_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

