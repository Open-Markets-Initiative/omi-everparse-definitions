// Exchange Message Type: 2 byte code
#define EXCHANGE_MESSAGE_TYPE_LOGIN_RESPONSE_MESSAGE 0x01F5                      // Login Response Message
#define EXCHANGE_MESSAGE_TYPE_REPLAY_COMPLETE_MESSAGE 0x01F6                     // Replay Complete Message
#define EXCHANGE_MESSAGE_TYPE_LOGOUT_RESPONSE_MESSAGE 0x01F7                     // Logout Response Message
#define EXCHANGE_MESSAGE_TYPE_SERVER_HEARTBEAT_MESSAGE 0x01F8                    // Server Heartbeat Message
#define EXCHANGE_MESSAGE_TYPE_ORDER_ACKNOWLEDGEMENT_US_EQUITIES_V_1 0x1195       // Order Acknowledgement Us Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_REJECTED_US_EQUITIES_V_1 0x1196              // Order Rejected Us Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_MODIFIED_US_EQUITIES_V_1 0x1197              // Order Modified Us Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_RESTATED_US_EQUITIES_V_1 0x1199              // Order Restated Us Equities V 1
#define EXCHANGE_MESSAGE_TYPE_MODIFY_REJECTED_US_EQUITIES_V_1 0x1198             // Modify Rejected Us Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_CANCELLED_US_EQUITIES_V_1 0x119A             // Order Cancelled Us Equities V 1
#define EXCHANGE_MESSAGE_TYPE_CANCEL_REJECTED_US_EQUITIES_V_1 0x119B             // Cancel Rejected Us Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_EXECUTION_US_EQUITIES_V_1 0x119C             // Order Execution Us Equities V 1
#define EXCHANGE_MESSAGE_TYPE_TRADE_CANCEL_CORRECT_US_EQUITIES_V_1 0x119D        // Trade Cancel Correct Us Equities V 1
#define EXCHANGE_MESSAGE_TYPE_PURGE_REJECTED_US_EQUITIES_V_1 0x11A0              // Purge Rejected Us Equities V 1
#define EXCHANGE_MESSAGE_TYPE_RESET_RISK_ACKNOWLEDGEMENT_US_EQUITIES_V_1 0x119E  // Reset Risk Acknowledgement Us Equities V 1
#define EXCHANGE_MESSAGE_TYPE_PURGE_ACKNOWLEDGEMENT_US_EQUITIES_V_1 0x119F       // Purge Acknowledgement Us Equities V 1

// Login Response Status: one byte code
#define LOGIN_RESPONSE_STATUS_ACCEPTED 0x41                    // Accepted
#define LOGIN_RESPONSE_STATUS_SESSION_IN_USE 0x42              // Session In Use
#define LOGIN_RESPONSE_STATUS_DISABLED 0x44                    // Disabled
#define LOGIN_RESPONSE_STATUS_INVALID_UNIT 0x49                // Invalid Unit
#define LOGIN_RESPONSE_STATUS_INVALID_MESSAGE 0x4D             // Invalid Message
#define LOGIN_RESPONSE_STATUS_NOT_AUTHORIZED 0x4E              // Not Authorized
#define LOGIN_RESPONSE_STATUS_SEQUENCE_AHEAD 0x51              // Sequence Ahead
#define LOGIN_RESPONSE_STATUS_INVALID_SESSION 0x53             // Invalid Session
#define LOGIN_RESPONSE_STATUS_INVALID_REPLAY_INSTRUCTION 0x58  // Invalid Replay Instruction

// Logout Reason: one byte code
#define LOGOUT_REASON_USER_REQUESTED 0x55      // User Requested
#define LOGOUT_REASON_ADMINISTRATIVE 0x41      // Administrative
#define LOGOUT_REASON_PROTOCOL_VIOLATION 0x21  // Protocol Violation

// Side: one byte code
#define SIDE_BUY 0x31                                          // Buy
#define SIDE_SELL 0x32                                         // Sell
#define SIDE_SELL_SHORT_CLIENT_AFFIRMS_ABILITY_TO_BORROW 0x35  // Sell Short Client Affirms Ability To Borrow
#define SIDE_SELL_SHORT_EXEMPT 0x36                            // Sell Short Exempt

// Ord Type: one byte code
#define ORD_TYPE_MARKET 0x31         // Market
#define ORD_TYPE_LIMIT_DEFAULT 0x32  // Limit Default
#define ORD_TYPE_STOP 0x33           // Stop
#define ORD_TYPE_STOP_LIMIT 0x34     // Stop Limit
#define ORD_TYPE_PEGGED 0x50         // Pegged

// Base Liquidity Indicator: one byte code
#define BASE_LIQUIDITY_INDICATOR_ADDED_LIQUIDITY 0x41                           // Added Liquidity
#define BASE_LIQUIDITY_INDICATOR_REMOVED_LIQUIDITY 0x52                         // Removed Liquidity
#define BASE_LIQUIDITY_INDICATOR_ROUTED_TO_ANOTHER_MARKET 0x58                  // Routed To Another Market
#define BASE_LIQUIDITY_INDICATOR_AUCTION_UNCROSSING 0x43                        // Auction Uncrossing
#define BASE_LIQUIDITY_INDICATOR_WAITING_FOR_EXECUTION_AT_PRE_MARKET_TIME 0x57  // Waiting For Execution At Pre Market Time

// Sub Liquidity Indicator: one byte code
#define SUB_LIQUIDITY_INDICATOR_TRADE_ADDED_RPI_LIQUIDITY_BYX_AND_EDGX_ONLY 0x45           // Trade Added Rpi Liquidity Byx And Edgx Only
