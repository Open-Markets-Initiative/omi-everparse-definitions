#define PURGE_REJECT_REASON_CANT_MODIFY_AN_ORDER_THAT_IS_PENDING_FILL 0x50    // Cant Modify An Order That Is Pending Fill
#define PURGE_REJECT_REASON_WAITING_FOR_FIRST_TRADE 0x51                      // Waiting For First Trade
#define PURGE_REJECT_REASON_ROUTING_UNAVAILABLE 0x52                          // Routing Unavailable
#define PURGE_REJECT_REASON_SHORT_SALE_PRICE_VIOLATION 0x53                   // Short Sale Price Violation
#define PURGE_REJECT_REASON_FILL_WOULD_TRADE_THROUGH_THE_NBBO 0x54            // Fill Would Trade Through The Nbbo
#define PURGE_REJECT_REASON_USER_REQUESTED 0x55                               // User Requested
#define PURGE_REJECT_REASON_WOULD_WASH 0x56                                   // Would Wash
#define PURGE_REJECT_REASON_ADD_LIQUIDITY_ONLY_ORDER_WOULD_REMOVE 0x57        // Add Liquidity Only Order Would Remove
#define PURGE_REJECT_REASON_ORDER_EXPIRED 0x58                                // Order Expired
#define PURGE_REJECT_REASON_SYMBOL_NOT_SUPPORTED 0x59                         // Symbol Not Supported
#define PURGE_REJECT_REASON_UNFORESEEN_REASON 0x5A                            // Unforeseen Reason
#define PURGE_REJECT_REASON_RISK_MANAGEMENT_MPID_OR_RISK_GROUP_ID_LEVEL 0x66  // Risk Management Mpid Or Risk Group Id Level
#define PURGE_REJECT_REASON_MARKET_ACCESS_RISK_LIMIT_EXCEEDED 0x6D            // Market Access Risk Limit Exceeded
#define PURGE_REJECT_REASON_MAX_OPEN_ORDERS_COUNT_EXCEEDED 0x6F               // Max Open Orders Count Exceeded
#define PURGE_REJECT_REASON_RESERVE_RELOAD 0x72                               // Reserve Reload
#define PURGE_REJECT_REASON_RISK_MANAGEMENT_SYMBOL_LEVEL 0x73                 // Risk Management Symbol Level
#define PURGE_REJECT_REASON_LIMIT_UP_LIMIT_DOWN_LULD 0x75                     // Limit Up Limit Down Luld
#define PURGE_REJECT_REASON_WOULD_REMOVE_ON_UNSLIDE 0x77                      // Would Remove On Unslide
#define PURGE_REJECT_REASON_CROSSED_MARKET 0x78                               // Crossed Market
#define PURGE_REJECT_REASON_ORDER_RECEIVED_BY_CBOE_DURING_REPLAY 0x79         // Order Received By Cboe During Replay
#define PURGE_REJECT_REASON_SESSION_END 0x7A                                  // Session End

// Risk Reset Result: one byte code
#define RISK_RESET_RESULT_IGNORED_EXCEEDS_1_RESET_PER_100_MILLISECONDS 0x20  // Ignored Exceeds 1 Reset Per 100 Milliseconds
#define RISK_RESET_RESULT_REJECTED_EXCEEDS_RISK_GROUP_ID_LIMIT 0x43          // Rejected Exceeds Risk Group Id Limit
#define RISK_RESET_RESULT_REJECTED_AUTOMATIC_RISK_RESETS_ARE_DISABLED 0x44   // Rejected Automatic Risk Resets Are Disabled
#define RISK_RESET_RESULT_REJECTED_EMPTY_RESET_RISK_FIELD 0x45               // Rejected Empty Reset Risk Field
#define RISK_RESET_RESULT_REJECTED_EXCEEDS_FIRM_RESET_LIMIT 0x46             // Rejected Exceeds Firm Reset Limit
#define RISK_RESET_RESULT_REJECTED_INCORRECT_DATA_CENTER 0x49                // Rejected Incorrect Data Center
#define RISK_RESET_RESULT_REJECTED_INVALID_MATCHING_UNIT 0x4D                // Rejected Invalid Matching Unit
#define RISK_RESET_RESULT_REJECTED_EXCEEDS_SYMBOL_RESET_LIMIT 0x53           // Rejected Exceeds Symbol Reset Limit
#define RISK_RESET_RESULT_REJECTED_INVALID_SYMBOL 0x55                       // Rejected Invalid Symbol
#define RISK_RESET_RESULT_SUCCESS 0x59                                       // Success
#define RISK_RESET_RESULT_REJECTED_INVALID_CLEARING_FIRM 0x63                // Rejected Invalid Clearing Firm
#define RISK_RESET_RESULT_REJECTED_IN_REPLAY 0x79                            // Rejected In Replay

// ---- Types -------------------------------------------------------------------

// Unit Sequence
typedef struct _UnitSequence {
  UINT8 unit_number;       // byte 0
  UINT32 sequence_number;  // bytes 1 to 4
} UnitSequence;

// A Login Response message is sent in response to a Login Request message
typedef struct _LoginResponseMessage {
  UINT8 login_response_status;                                              // byte 0
  UINT8 login_response_text[60];                                            // bytes 1 to 60
  UINT32 client_sequence;                                                   // bytes 61 to 64
  UINT8 number_of_units;                                                    // byte 65
  UnitSequence unit_sequence[:byte-size (((UINT32) number_of_units) * 5)];
} LoginResponseMessage;

// A Logout Response is usually sent in response to a Logout Request
typedef struct _LogoutResponseMessage {
  UINT8 logout_reason;           // byte 0
  UINT8 logout_reason_text[60];  // bytes 1 to 60
} LogoutResponseMessage;

// Order Acknowledgment messages are sent in response to New Order messages
typedef struct _OrderAcknowledgementUsEquitiesV1 {
  UINT16 in_flight;                // bytes 0 to 1
  UINT64 transaction_time;         // bytes 2 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT64 order_id;                 // bytes 30 to 37
  UINT8 side;                      // byte 38
  UINT64 price;                    // bytes 39 to 46, signed, read here as unsigned
  UINT8 ord_type;                  // byte 47
  UINT8 symbol[8];                 // bytes 48 to 55
  UINT8 clearing_firm[4];          // bytes 56 to 59
  UINT32 leaves_qty;               // bytes 60 to 63
  UINT64 display_price;            // bytes 64 to 71, signed, read here as unsigned
  UINT64 working_price;            // bytes 72 to 79, signed, read here as unsigned
  UINT8 base_liquidity_indicator;  // byte 80
  UINT8 sub_liquidity_indicator;   // byte 81
} OrderAcknowledgementUsEquitiesV1;

// Order Rejected messages are sent in response to a New Order message which must be rejected
typedef struct _OrderRejectedUsEquitiesV1 {
  UINT16 in_flight;           // bytes 0 to 1
  UINT64 transaction_time;    // bytes 2 to 9
  UINT8 cl_ord_id[20];        // bytes 10 to 29
  UINT8 clearing_firm[4];     // bytes 30 to 33
  UINT8 order_reject_reason;  // byte 34
  UINT8 text[60];             // bytes 35 to 94
} OrderRejectedUsEquitiesV1;

// Order Modified messages are sent in response to a Modify Request message to indicate that the order has been successfully modified
typedef struct _OrderModifiedUsEquitiesV1 {
  UINT16 in_flight;                // bytes 0 to 1
  UINT64 transaction_time;         // bytes 2 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT8 orig_cl_ord_id[20];        // bytes 30 to 49
  UINT64 order_id;                 // bytes 50 to 57
  UINT8 clearing_firm[4];          // bytes 58 to 61
  UINT8 symbol[8];                 // bytes 62 to 69
  UINT8 side;                      // byte 70
  UINT64 price;                    // bytes 71 to 78, signed, read here as unsigned
  UINT8 ord_type;                  // byte 79
  UINT32 max_floor;                // bytes 80 to 83
  UINT32 order_qty;                // bytes 84 to 87
  UINT64 stop_px;                  // bytes 88 to 95, signed, read here as unsigned
  UINT32 leaves_qty;               // bytes 96 to 99
  UINT64 display_price;            // bytes 100 to 107, signed, read here as unsigned
  UINT64 working_price;            // bytes 108 to 115, signed, read here as unsigned
  UINT8 base_liquidity_indicator;  // byte 116
  UINT64 secondary_order_id;       // bytes 117 to 124
} OrderModifiedUsEquitiesV1;

// Order Restated messages are sent to inform the Member that an order has been asynchronously modified for some reason without an explicit Modify Order message request having been sent
typedef struct _OrderRestatedUsEquitiesV1 {
  UINT16 in_flight;                // bytes 0 to 1
  UINT64 transaction_time;         // bytes 2 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT64 order_id;                 // bytes 30 to 37
  UINT8 clearing_firm[4];          // bytes 38 to 41
  UINT8 symbol[8];                 // bytes 42 to 49
  UINT8 order_restatement_reason;  // byte 50
  UINT32 order_qty;                // bytes 51 to 54
  UINT64 price;                    // bytes 55 to 62, signed, read here as unsigned
  UINT32 leaves_qty;               // bytes 63 to 66
  UINT64 display_price;            // bytes 67 to 74, signed, read here as unsigned
  UINT64 working_price;            // bytes 75 to 82, signed, read here as unsigned
  UINT8 base_liquidity_indicator;  // byte 83
  UINT64 secondary_order_id;       // bytes 84 to 91
  UINT32 last_shares;              // bytes 92 to 95
  UINT64 last_px;                  // bytes 96 to 103, signed, read here as unsigned
  UINT32 cmc_match_qty;            // bytes 104 to 107
} OrderRestatedUsEquitiesV1;

// User Modify Rejected messages are sent in response to a Modify Order message for an order which cannot be modified
typedef struct _ModifyRejectedUsEquitiesV1 {
  UINT16 in_flight;            // bytes 0 to 1
  UINT64 transaction_time;     // bytes 2 to 9
  UINT8 clearing_firm[4];      // bytes 10 to 13
  UINT8 cl_ord_id[20];         // bytes 14 to 33
  UINT8 orig_cl_ord_id[20];    // bytes 34 to 53
  UINT8 modify_reject_reason;  // byte 54
  UINT8 text[60];              // bytes 55 to 114
} ModifyRejectedUsEquitiesV1;

// This message indicates an order has been cancelled
typedef struct _OrderCancelledUsEquitiesV1 {
  UINT16 in_flight;         // bytes 0 to 1
  UINT64 transaction_time;  // bytes 2 to 9
  UINT8 clearing_firm[4];   // bytes 10 to 13
  UINT8 cl_ord_id[20];      // bytes 14 to 33
  UINT8 cancel_reason;      // byte 34
} OrderCancelledUsEquitiesV1;

// A Cancel Rejected message is sent in response to a Cancel Order message to indicate that the cancellation cannot occur
typedef struct _CancelRejectedUsEquitiesV1 {
  UINT16 in_flight;            // bytes 0 to 1
  UINT64 transaction_time;     // bytes 2 to 9
  UINT8 clearing_firm[4];      // bytes 10 to 13
  UINT8 cl_ord_id[20];         // bytes 14 to 33
  UINT8 cancel_reject_reason;  // byte 34
  UINT8 text[60];              // bytes 35 to 94
} CancelRejectedUsEquitiesV1;

// An Order Execution message is sent for each fill on an order
typedef struct _OrderExecutionUsEquitiesV1 {
  UINT16 in_flight;                // bytes 0 to 1
  UINT64 transaction_time;         // bytes 2 to 9
  UINT8 clearing_firm[4];          // bytes 10 to 13
  UINT8 cl_ord_id[20];             // bytes 14 to 33
  UINT64 exec_id;                  // bytes 34 to 41
  UINT32 last_shares;              // bytes 42 to 45
  UINT64 last_px;                  // bytes 46 to 53, signed, read here as unsigned
  UINT32 leaves_qty;               // bytes 54 to 57
  UINT8 base_liquidity_indicator;  // byte 58
  UINT8 sub_liquidity_indicator;   // byte 59
  UINT8 contra_broker[4];          // bytes 60 to 63
  UINT8 side;                      // byte 64
  UINT8 symbol[8];                 // bytes 65 to 72
  UINT8 fee_code[2];               // bytes 73 to 74
  UINT64 access_fee;               // bytes 75 to 82, signed, read here as unsigned
} OrderExecutionUsEquitiesV1;

// Used to relay a trade which has been cancelled (busted) or corrected (price change only)
typedef struct _TradeCancelCorrectUsEquitiesV1 {
  UINT16 in_flight;                // bytes 0 to 1
  UINT64 transaction_time;         // bytes 2 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT64 order_id;                 // bytes 30 to 37
  UINT64 exec_ref_id;              // bytes 38 to 45
  UINT8 side;                      // byte 46
  UINT8 base_liquidity_indicator;  // byte 47
  UINT8 sub_liquidity_indicator;   // byte 48
  UINT8 clearing_firm[4];          // bytes 49 to 52
  UINT8 clearing_account[4];       // bytes 53 to 56
  UINT32 last_shares;              // bytes 57 to 60
  UINT64 last_px;                  // bytes 61 to 68, signed, read here as unsigned
  UINT64 corrected_price;          // bytes 69 to 76, signed, read here as unsigned
  UINT64 orig_time;                // bytes 77 to 84
  UINT8 symbol[8];                 // bytes 85 to 92
  UINT8 capacity;                  // byte 93
} TradeCancelCorrectUsEquitiesV1;

// A Purge Rejected message is sent in response to a Purge Orders message to indicate that the mass cancellation cannot occur
typedef struct _PurgeRejectedUsEquitiesV1 {
  UINT16 in_flight;           // bytes 0 to 1
  UINT64 transaction_time;    // bytes 2 to 9
  UINT8 mass_cancel_id[20];   // bytes 10 to 29
  UINT8 purge_reject_reason;  // byte 30
  UINT8 text[60];             // bytes 31 to 90
} PurgeRejectedUsEquitiesV1;

// Response to a Reset Risk message request
typedef struct _ResetRiskAcknowledgementUsEquitiesV1 {
  UINT16 in_flight;          // bytes 0 to 1
  UINT8 risk_status_id[16];  // bytes 2 to 17
  UINT8 risk_reset_result;   // byte 18
} ResetRiskAcknowledgementUsEquitiesV1;

// A Purge Acknowledgment message is an unsequenced message sent when a Purge Orders message requesting an order purge has completed canceling all individual orders
typedef struct _PurgeAcknowledgementUsEquitiesV1 {
  UINT16 in_flight;              // bytes 0 to 1
  UINT64 transaction_time;       // bytes 2 to 9
  UINT8 mass_cancel_id[20];      // bytes 10 to 29
  UINT32 cancelled_order_count;  // bytes 30 to 33
} PurgeAcknowledgementUsEquitiesV1;

// Branch
casetype _ExchangeMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x01F5: LoginResponseMessage login_response_message;
    case 0x01F6: unit replay_complete;
    case 0x01F7: LogoutResponseMessage logout_response_message;
    case 0x01F8: unit server_heartbeat;
    case 0x1195: OrderAcknowledgementUsEquitiesV1 order_acknowledgement_us_equities_v_1;
    case 0x1196: OrderRejectedUsEquitiesV1 order_rejected_us_equities_v_1;
    case 0x1197: OrderModifiedUsEquitiesV1 order_modified_us_equities_v_1;
    case 0x1199: OrderRestatedUsEquitiesV1 order_restated_us_equities_v_1;
    case 0x1198: ModifyRejectedUsEquitiesV1 modify_rejected_us_equities_v_1;
    case 0x119A: OrderCancelledUsEquitiesV1 order_cancelled_us_equities_v_1;
    case 0x119B: CancelRejectedUsEquitiesV1 cancel_rejected_us_equities_v_1;
    case 0x119C: OrderExecutionUsEquitiesV1 order_execution_us_equities_v_1;
    case 0x119D: TradeCancelCorrectUsEquitiesV1 trade_cancel_correct_us_equities_v_1;
    case 0x11A0: PurgeRejectedUsEquitiesV1 purge_rejected_us_equities_v_1;
    case 0x119E: ResetRiskAcknowledgementUsEquitiesV1 reset_risk_acknowledgement_us_equities_v_1;
    case 0x119F: PurgeAcknowledgementUsEquitiesV1 purge_acknowledgement_us_equities_v_1;
    default: UINT8 unknown[available];
  }
} ExchangeMessage;

// ---- Packet: ExchangePacket --------------------------------------------------

// Binary Order Entry Tcp Packet sent by the exchange
entrypoint typedef struct _ExchangePacket (UINT32 available) where (available >= 12) {
  UINT16 start_of_message;                                                                                                      // bytes 0 to 1
  UINT16 message_length;                                                                                                        // bytes 2 to 3
  UINT16 exchange_message_type;                                                                                                 // bytes 4 to 5
  UINT8 matching_unit;                                                                                                          // byte 6
  UINT8 reserved_field;                                                                                                         // byte 7
  UINT32 sequence_number;                                                                                                       // bytes 8 to 11
  ExchangeMessage(exchange_message_type, (available - 12)) exchange_message[:byte-size-single-element-array (available - 12)];
} ExchangePacket;

