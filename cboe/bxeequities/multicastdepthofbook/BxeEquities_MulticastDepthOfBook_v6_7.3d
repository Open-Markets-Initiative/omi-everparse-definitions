// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_TIME_MESSAGE 0x20                          // Time Message
#define MESSAGE_TYPE_UNIT_CLEAR_MESSAGE 0x97                    // Unit Clear Message
#define MESSAGE_TYPE_ADD_ORDER_LONG_MESSAGE 0x40                // Add Order Long Message
#define MESSAGE_TYPE_ADD_ORDER_SHORT_MESSAGE 0x22               // Add Order Short Message
#define MESSAGE_TYPE_ADD_ORDER_EXPANDED_MESSAGE 0x2F            // Add Order Expanded Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x23                // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_AT_PRICE_SIZE_MESSAGE 0x24  // Order Executed At Price Size Message
#define MESSAGE_TYPE_REDUCE_SIZE_LONG_MESSAGE 0x25              // Reduce Size Long Message
#define MESSAGE_TYPE_REDUCE_SIZE_SHORT_MESSAGE 0x26             // Reduce Size Short Message
#define MESSAGE_TYPE_MODIFY_ORDER_LONG_MESSAGE 0x27             // Modify Order Long Message
#define MESSAGE_TYPE_MODIFY_ORDER_SHORT_MESSAGE 0x28            // Modify Order Short Message
#define MESSAGE_TYPE_DELETE_ORDER_MESSAGE 0x29                  // Delete Order Message
#define MESSAGE_TYPE_TRADE_LONG_MESSAGE 0x41                    // Trade Long Message
#define MESSAGE_TYPE_TRADE_SHORT_MESSAGE 0x2B                   // Trade Short Message
#define MESSAGE_TYPE_TRADE_EXTENDED_MESSAGE 0x32                // Trade Extended Message
#define MESSAGE_TYPE_TRADE_BREAK_MESSAGE 0x2C                   // Trade Break Message
#define MESSAGE_TYPE_END_OF_SESSION_MESSAGE 0x2D                // End Of Session Message
#define MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x31                // Trading Status Message
#define MESSAGE_TYPE_STATISTICS_MESSAGE 0x34                    // Statistics Message
#define MESSAGE_TYPE_AUCTION_UPDATE_MESSAGE 0xAC                // Auction Update Message
#define MESSAGE_TYPE_AUCTION_SUMMARY_MESSAGE 0x96               // Auction Summary Message

// Side Indicator: one byte code
#define SIDE_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define SIDE_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Market Mechanism: one byte code
#define MARKET_MECHANISM_CENTRAL_LIMIT_ORDER_BOOK 0x31  // Central Limit Order Book
#define MARKET_MECHANISM_QUOTE_DRIVEN_MARKET 0x32       // Quote Driven Market
#define MARKET_MECHANISM_DARK_ORDER_BOOK 0x33           // Dark Order Book
#define MARKET_MECHANISM_OFF_BOOK 0x34                  // Off Book

// Trading Mode: one byte code
#define TRADING_MODE_UNDEFINED_AUCTION 0x31                        // Undefined Auction
#define TRADING_MODE_CONTINUOUS_TRADING 0x32                       // Continuous Trading
#define TRADING_MODE_AT_MARKET_CLOSE_TRADING 0x33                  // At Market Close Trading
#define TRADING_MODE_OUT_OF_MAIN_SESSION 0x34                      // Out Of Main Session
#define TRADING_MODE_TRADE_REPORTING_ON_EXCHANGE 0x35              // Trade Reporting On Exchange
#define TRADING_MODE_TRADE_REPORTING_OFF_EXCHANGE 0x36             // Trade Reporting Off Exchange
#define TRADING_MODE_TRADE_REPORTING_SYSTEMATIC_INTERNALIZER 0x37  // Trade Reporting Systematic Internalizer
#define TRADING_MODE_SCHEDULED_OPENING_AUCTION 0x4F                // Scheduled Opening Auction
#define TRADING_MODE_SCHEDULED_CLOSING_AUCTION 0x4B                // Scheduled Closing Auction
#define TRADING_MODE_SCHEDULED_INTRADAY_AUCTION 0x49               // Scheduled Intraday Auction
#define TRADING_MODE_UNSCHEDULED_AUCTION 0x55                      // Unscheduled Auction

// Ex Cum Dividend: one byte code
#define EX_CUM_DIVIDEND_EX_CUM_DIVIDEND_IF_OPTIONALLY_SET_BY_REPORTING_PARTY 0x45  // Ex Cum Dividend If Optionally Set By Reporting Party
#define EX_CUM_DIVIDEND_NOT_SPECIFIED 0x2D                                         // Not Specified

// Transaction Category: one byte code
#define TRANSACTION_CATEGORY_PLAIN_VANILLA_TRADE 0x50    // Plain Vanilla Trade
#define TRANSACTION_CATEGORY_DARK_TRADE 0x44             // Dark Trade
#define TRANSACTION_CATEGORY_TECHNICAL_TRADE 0x54        // Technical Trade
#define TRANSACTION_CATEGORY_GIVE_UP_GIVE_IN_TRADE 0x47  // Give Up Give In Trade
#define TRANSACTION_CATEGORY_TRADE_WITH_CONDITIONS 0x46  // Trade With Conditions

// Bats Trade Timing Indicator: one byte code
#define BATS_TRADE_TIMING_INDICATOR_THE_TRADE_WAS_REPORTED_TO_BATS_CHI_X_EUROPE_LATE 0x31                              // The Trade Was Reported To Bats Chi X Europe Late
#define BATS_TRADE_TIMING_INDICATOR_THE_TRADE_WAS_REPORTED_TO_BATS_CHI_X_EUROPE_OUT_OF_THE_MAIN_SESSION 0x32           // The Trade Was Reported To Bats Chi X Europe Out Of The Main Session
#define BATS_TRADE_TIMING_INDICATOR_THE_TRADE_WAS_REPORTED_TO_BATS_CHI_X_EUROPE_LATE_AND_OUT_OF_THE_MAIN_SESSION 0x33  // The Trade Was Reported To Bats Chi X Europe Late And Out Of The Main Session
#define BATS_TRADE_TIMING_INDICATOR_OTHERWISE_NOTE_THIS_FLAG_IS_NOT_DEFINED_BY_MMT 0x2D                                // Otherwise Note This Flag Is Not Defined By Mmt

// Negotiated Trade: one byte code
#define NEGOTIATED_TRADE_NEGOTIATED_TRADE 0x4E  // Negotiated Trade
#define NEGOTIATED_TRADE_NOT_SPECIFIED 0x2D     // Not Specified

// Crossing Trade: one byte code
#define CROSSING_TRADE_CROSSING_TRADE 0x58  // Crossing Trade
#define CROSSING_TRADE_NOT_SPECIFIED 0x2D   // Not Specified

// Modification Indicator: one byte code
#define MODIFICATION_INDICATOR_INDICATES_A_MODIFICATION_OF_A_PREVIOUSLY_REPORTED_TRADE 0x41  // Indicates A Modification Of A Previously Reported Trade
#define MODIFICATION_INDICATOR_INDICATES_A_CANCELLATION_OF_A_PREVIOUSLY_REPORTED_TRADE 0x43  // Indicates A Cancellation Of A Previously Reported Trade
#define MODIFICATION_INDICATOR_NOT_SPECIFIED 0x2D                                            // Not Specified

// Benchmark Indicator: one byte code
#define BENCHMARK_INDICATOR_BENCHMARK_TRADE_IF_OPTIONALLY_SET_BY_REPORTING_PARTY 0x42  // Benchmark Trade If Optionally Set By Reporting Party
#define BENCHMARK_INDICATOR_NOT_SPECIFIED 0x2D                                         // Not Specified

// Publication Mode: one byte code
#define PUBLICATION_MODE_TRADE_REPORT_HAS_BEEN_DELAYED_AT_THE_REQUEST_OF_THE_REPORTING_PARTY 0x31  // Trade Report Has Been Delayed At The Request Of The Reporting Party
#define PUBLICATION_MODE_NOT_SPECIFIED 0x2D                                                        // Not Specified

// Off Book Automated Indicator: one byte code
#define OFF_BOOK_AUTOMATED_INDICATOR_AUTOMATED 0x51      // Automated
#define OFF_BOOK_AUTOMATED_INDICATOR_MANUAL 0x4D         // Manual
#define OFF_BOOK_AUTOMATED_INDICATOR_NOT_SPECIFIED 0x2D  // Not Specified

// Status: one byte code
#define STATUS_TRADING 0x54                           // Trading
#define STATUS_OFF_BOOK_REPORTING 0x52                // Off Book Reporting
#define STATUS_CLOSED 0x43                            // Closed
#define STATUS_SUSPENSION 0x53                        // Suspension
#define STATUS_NO_REFERENCE_PRICE 0x4E                // No Reference Price
#define STATUS_VOLATILITY_INTERRUPTION 0x56           // Volatility Interruption
#define STATUS_OPENING_AUCTION 0x4F                   // Opening Auction
#define STATUS_CLOSING_AUCTION 0x45                   // Closing Auction
#define STATUS_HALT 0x48                              // Halt
#define STATUS_MARKET_ORDER_IMBALANCE_EXTENSION 0x4D  // Market Order Imbalance Extension
#define STATUS_PRICE_MONITORING_EXTENSION 0x50        // Price Monitoring Extension

// Statistic Type: one byte code
#define STATISTIC_TYPE_CLOSING_PRICE 0x43           // Closing Price
#define STATISTIC_TYPE_HIGH_PRICE 0x48              // High Price
#define STATISTIC_TYPE_LOW_PRICE 0x4C               // Low Price
#define STATISTIC_TYPE_OPENING_PRICE 0x4F           // Opening Price
#define STATISTIC_TYPE_PREVIOUS_CLOSING_PRICE 0x50  // Previous Closing Price

// Price Determination: one byte code
#define PRICE_DETERMINATION_NORMAL 0x30                                       // Normal
#define PRICE_DETERMINATION_MANUAL_PRICE_OVERRIDE_BY_MARKET_SUPERVISION 0x31  // Manual Price Override By Market Supervision

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING_AUCTION 0x4F     // Opening Auction
#define AUCTION_TYPE_CLOSING_AUCTION 0x43     // Closing Auction
#define AUCTION_TYPE_HALT_AUCTION 0x48        // Halt Auction
#define AUCTION_TYPE_VOLATILITY_AUCTION 0x56  // Volatility Auction
#define AUCTION_TYPE_PERIODIC_AUCTION 0x50    // Periodic Auction

// Outside Tolerance: one byte code
#define OUTSIDE_TOLERANCE_OUTSIDE_TOLERANCE 0x4F  // Outside Tolerance
#define OUTSIDE_TOLERANCE_INSIDE_TOLERANCE 0x49   // Inside Tolerance
#define OUTSIDE_TOLERANCE_NOT_SPECIFIED 0x2D      // Not Specified

// Includes Primary: one byte code
#define INCLUDES_PRIMARY_INCLUDES_PRIMARY 0x50  // Includes Primary
#define INCLUDES_PRIMARY_EXCLUDES_PRIMARY 0x4E  // Excludes Primary
#define INCLUDES_PRIMARY_NOT_SPECIFIED 0x2D     // Not Specified

// ---- Types -------------------------------------------------------------------

// Time
typedef struct _TimeMessage {
  UINT32 time;  // bytes 0 to 3
} TimeMessage;

// Unit Clear
typedef struct _UnitClearMessage {
  UINT32 time_offset;  // bytes 0 to 3
} UnitClearMessage;

// Add Order Long
typedef struct _AddOrderLongMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT64 order_id;       // bytes 4 to 11
  UINT8 side_indicator;  // byte 12
  UINT32 quantity_long;  // bytes 13 to 16
  UINT8 symbol_long[8];  // bytes 17 to 24
  UINT64 price_long;     // bytes 25 to 32
} AddOrderLongMessage;

// Add Order Short
typedef struct _AddOrderShortMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT16 quantity_short;  // bytes 13 to 14
  UINT8 symbol_short[6];  // bytes 15 to 20
  UINT16 price_short;     // bytes 21 to 22
} AddOrderShortMessage;

// Add Order Expanded
typedef struct _AddOrderExpandedMessage {
  UINT32 time_offset;       // bytes 0 to 3
  UINT64 order_id;          // bytes 4 to 11
  UINT8 side_indicator;     // byte 12
  UINT32 quantity_long;     // bytes 13 to 16
  UINT8 symbol_long[8];     // bytes 17 to 24
  UINT64 price_long;        // bytes 25 to 32
  UINT8 unused_1 : 1;       // byte 33
  UINT8 si_quote : 1;       // byte 33
  UINT8 unused_6 : 6;       // byte 33
  UINT8 participant_id[4];  // bytes 34 to 37
} AddOrderExpandedMessage;

// Execution Flags
typedef struct _ExecutionFlags {
  UINT8 market_mechanism;  // byte 0
  UINT8 trading_mode;      // byte 1
  UINT8 ex_cum_dividend;   // byte 2
} ExecutionFlags;

// Order Executed
typedef struct _OrderExecutedMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT32 executed_shares;          // bytes 12 to 15
  UINT64 execution_id;             // bytes 16 to 23
  ExecutionFlags execution_flags;  // bytes 24 to 26
} OrderExecutedMessage;

// Order Executed at Price/Size
typedef struct _OrderExecutedAtPriceSizeMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT32 executed_shares;          // bytes 12 to 15
  UINT32 remaining_shares;         // bytes 16 to 19
  UINT64 execution_id;             // bytes 20 to 27
  UINT64 price_long;               // bytes 28 to 35
  ExecutionFlags execution_flags;  // bytes 36 to 38
} OrderExecutedAtPriceSizeMessage;

// Reduce Size Long
typedef struct _ReduceSizeLongMessage {
  UINT32 time_offset;            // bytes 0 to 3
  UINT64 order_id;               // bytes 4 to 11
  UINT32 cancelled_shares_long;  // bytes 12 to 15
} ReduceSizeLongMessage;

// Reduce Size Short
typedef struct _ReduceSizeShortMessage {
  UINT32 time_offset;             // bytes 0 to 3
  UINT64 order_id;                // bytes 4 to 11
  UINT16 cancelled_shares_short;  // bytes 12 to 13
} ReduceSizeShortMessage;

// Modify Order Long
typedef struct _ModifyOrderLongMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
  UINT32 shares_long;  // bytes 12 to 15
  UINT64 price_long;   // bytes 16 to 23
} ModifyOrderLongMessage;

// Modify Order Short
typedef struct _ModifyOrderShortMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 order_id;      // bytes 4 to 11
  UINT16 shares_short;  // bytes 12 to 13
  UINT16 price_short;   // bytes 14 to 15
} ModifyOrderShortMessage;

// Delete Order
typedef struct _DeleteOrderMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
} DeleteOrderMessage;

// Trade Flags
typedef struct _TradeFlags {
  UINT8 market_mechanism;      // byte 0
  UINT8 trading_mode;          // byte 1
  UINT8 transaction_category;  // byte 2
  UINT8 ex_cum_dividend;       // byte 3
} TradeFlags;

// Trade Long
typedef struct _TradeLongMessage {
  UINT32 time_offset;      // bytes 0 to 3
  UINT64 order_id;         // bytes 4 to 11
  UINT8 side_indicator;    // byte 12
  UINT32 shares_long;      // bytes 13 to 16
  UINT8 symbol_long[8];    // bytes 17 to 24
  UINT64 price_long;       // bytes 25 to 32
  UINT64 execution_id;     // bytes 33 to 40
  TradeFlags trade_flags;  // bytes 41 to 44
} TradeLongMessage;

// Trade Short
typedef struct _TradeShortMessage {
  UINT32 time_offset;      // bytes 0 to 3
  UINT64 order_id;         // bytes 4 to 11
  UINT8 side_indicator;    // byte 12
  UINT16 shares_short;     // bytes 13 to 14
  UINT8 symbol_short[6];   // bytes 15 to 20
  UINT16 price_short;      // bytes 21 to 22
  UINT64 execution_id;     // bytes 23 to 30
  TradeFlags trade_flags;  // bytes 31 to 34
} TradeShortMessage;

// Extended Trade Flags
typedef struct _ExtendedTradeFlags {
  UINT8 bats_trade_timing_indicator;   // byte 0
  UINT8 market_mechanism;              // byte 1
  UINT8 trading_mode;                  // byte 2
  UINT8 transaction_category;          // byte 3
  UINT8 negotiated_trade;              // byte 4
  UINT8 crossing_trade;                // byte 5
  UINT8 modification_indicator;        // byte 6
  UINT8 benchmark_indicator;           // byte 7
  UINT8 ex_cum_dividend;               // byte 8
  UINT8 publication_mode;              // byte 9
  UINT8 off_book_automated_indicator;  // byte 10
} ExtendedTradeFlags;

// Trade Extended
typedef struct _TradeExtendedMessage {
  UINT32 time_offset;                       // bytes 0 to 3
  UINT64 shares_extended;                   // bytes 4 to 11
  UINT8 symbol_long[8];                     // bytes 12 to 19
  UINT64 price_long;                        // bytes 20 to 27
  UINT64 trade_id;                          // bytes 28 to 35
  UINT64 trade_timestamp;                   // bytes 36 to 43
  UINT8 execution_venue[4];                 // bytes 44 to 47
  UINT8 currency[3];                        // bytes 48 to 50
  ExtendedTradeFlags extended_trade_flags;  // bytes 51 to 61
} TradeExtendedMessage;

// Trade Break
typedef struct _TradeBreakMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 execution_id;  // bytes 4 to 11
} TradeBreakMessage;

// End of Session
typedef struct _EndOfSessionMessage {
  UINT32 time_offset;  // bytes 0 to 3
} EndOfSessionMessage;

// Trading Status
typedef struct _TradingStatusMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT8 symbol_long[8];  // bytes 4 to 11
  UINT8 status;          // byte 12
  UINT8 reserved_3[3];   // bytes 13 to 15
} TradingStatusMessage;

// Statistics Message
typedef struct _StatisticsMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 symbol_long[8];       // bytes 4 to 11
  UINT64 price_long;          // bytes 12 to 19
  UINT8 statistic_type;       // byte 20
  UINT8 price_determination;  // byte 21
} StatisticsMessage;

// Auction Update Message
typedef struct _AuctionUpdateMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT8 symbol_long[8];      // bytes 4 to 11
  UINT8 auction_type;        // byte 12
  UINT64 reference_price;    // bytes 13 to 20
  UINT64 indicative_price;   // bytes 21 to 28
  UINT32 indicative_shares;  // bytes 29 to 32
  UINT8 outside_tolerance;   // byte 33
  UINT8 includes_primary;    // byte 34
} AuctionUpdateMessage;

// Auction Summary Message
typedef struct _AuctionSummaryMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT8 symbol_long[8];  // bytes 4 to 11
  UINT8 auction_type;    // byte 12
  UINT64 price_long;     // bytes 13 to 20
  UINT32 shares_long;    // bytes 21 to 24
} AuctionSummaryMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x20: TimeMessage time_message;
    case 0x97: UnitClearMessage unit_clear_message;
    case 0x40: AddOrderLongMessage add_order_long_message;
    case 0x22: AddOrderShortMessage add_order_short_message;
    case 0x2F: AddOrderExpandedMessage add_order_expanded_message;
    case 0x23: OrderExecutedMessage order_executed_message;
    case 0x24: OrderExecutedAtPriceSizeMessage order_executed_at_price_size_message;
    case 0x25: ReduceSizeLongMessage reduce_size_long_message;
    case 0x26: ReduceSizeShortMessage reduce_size_short_message;
    case 0x27: ModifyOrderLongMessage modify_order_long_message;
    case 0x28: ModifyOrderShortMessage modify_order_short_message;
    case 0x29: DeleteOrderMessage delete_order_message;
    case 0x41: TradeLongMessage trade_long_message;
    case 0x2B: TradeShortMessage trade_short_message;
    case 0x32: TradeExtendedMessage trade_extended_message;
    case 0x2C: TradeBreakMessage trade_break_message;
    case 0x2D: EndOfSessionMessage end_of_session_message;
    case 0x31: TradingStatusMessage trading_status_message;
    case 0x34: StatisticsMessage statistics_message;
    case 0xAC: AuctionUpdateMessage auction_update_message;
    case 0x96: AuctionSummaryMessage auction_summary_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

