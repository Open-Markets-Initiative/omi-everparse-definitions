  UINT8 symbol[8];                   // bytes 54 to 61
  UINT8 capacity;                    // byte 62
  UINT8 account[16];                 // bytes 63 to 78
  UINT8 clearing_firm[4];            // bytes 79 to 82
  UINT8 clearing_account[4];         // bytes 83 to 86
  UINT8 display_indicator;           // byte 87
  UINT32 max_floor;                  // bytes 88 to 91
  UINT32 order_qty;                  // bytes 92 to 95
  PreventMatch prevent_match;        // bytes 96 to 98
  UINT32 maturity_date;              // bytes 99 to 102
  UINT64 strike_price;               // bytes 103 to 110, signed, read here as unsigned
  UINT8 put_or_call;                 // byte 111
  UINT8 open_close;                  // byte 112
  UINT32 leaves_qty;                 // bytes 113 to 116
  UINT64 display_price;              // bytes 117 to 124, signed, read here as unsigned
  UINT64 working_price;              // bytes 125 to 132, signed, read here as unsigned
  UINT64 expire_time;                // bytes 133 to 140
  UINT8 attributed_quote;            // byte 141
  UINT64 stop_px;                    // bytes 142 to 149, signed, read here as unsigned
  UINT8 routing_inst[4];             // bytes 150 to 153
  UINT8 rout_strategy[6];            // bytes 154 to 159
  UINT8 route_delivery_method[3];    // bytes 160 to 162
  UINT8 ex_destination;              // byte 163
  UINT8 target_party_id[4];          // bytes 164 to 167
  UINT64 auction_id;                 // bytes 168 to 175
  UINT32 cmta_number;                // bytes 176 to 179
  UINT8 routing_firm_id[4];          // bytes 180 to 183
  UINT8 clearing_optional_data[16];  // bytes 184 to 199
  UINT32 cum_qty;                    // bytes 200 to 203
  UINT64 drill_thru_protection;      // bytes 204 to 211, signed, read here as unsigned
  UINT8 equity_party_id[4];          // bytes 212 to 215
  UINT8 client_id_attr[4];           // bytes 216 to 219
  UINT8 frequent_trader_id[6];       // bytes 220 to 225
  UINT8 session_eligibility;         // byte 226
  UINT8 combo_order;                 // byte 227
