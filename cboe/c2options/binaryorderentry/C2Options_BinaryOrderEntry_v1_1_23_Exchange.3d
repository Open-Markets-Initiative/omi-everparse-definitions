} CarriedRestatementMessage;

// ---- Done For Day Message: 46 bytes ------------------------------------------

// The Done For Day messages represent orders persisted during the current day session to carry over to the next session
entrypoint typedef struct _DoneForDayMessage {
  UINT16 in_flight;          // bytes 0 to 1
  UINT64 transaction_time;   // bytes 2 to 9
  UINT8 cl_ord_id[20];       // bytes 10 to 29
  UINT8 clearing_firm[4];    // bytes 30 to 33
  UINT8 routing_firm_id[4];  // bytes 34 to 37
  UINT8 symbol[8];           // bytes 38 to 45
} DoneForDayMessage;

