} PurgeRejectedMessage;

// ---- Reset Risk Acknowledgement Message: 27 bytes ----------------------------

// Response to a Reset Risk message request
entrypoint typedef struct _ResetRiskAcknowledgementMessage {
  UINT16 in_flight;              // bytes 0 to 1
  UINT8 risk_status_id[16];      // bytes 2 to 17
