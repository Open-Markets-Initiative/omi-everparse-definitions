// Chicago Board Options Exchange Binary Order Entry
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out C2Options_BinaryOrderEntry_v1_1_23_Exchange.3d
//
// What this definition does not state, and the model does:
// - a Reassemble rule
// - a run counted by a field
//
// License: MIT No Attribution

// ---- Exchange Message Header: 12 bytes ---------------------------------------

// Message header of a packet sent by the exchange
entrypoint typedef struct _ExchangeMessageHeader {
  UINT16 start_of_message;       // bytes 0 to 1
  UINT16 message_length;         // bytes 2 to 3
  UINT16 exchange_message_type;  // bytes 4 to 5
  UINT8 matching_unit;           // byte 6
  UINT8 reserved_field;          // byte 7
  UINT32 sequence_number;        // bytes 8 to 11
} ExchangeMessageHeader;

// ---- Logout Response Message: 61 bytes ---------------------------------------

// A Logout Response is usually sent in response to a Logout Request
entrypoint typedef struct _LogoutResponseMessage {
  UINT8 logout_reason;           // byte 0
  UINT8 logout_reason_text[60];  // bytes 1 to 60
} LogoutResponseMessage;

// ---- Order Acknowledgement Message: 93 bytes ---------------------------------

// OrderAcknowledgementMessage
entrypoint typedef struct _OrderAcknowledgementMessage {
  UINT16 in_flight;                // bytes 0 to 1
  UINT64 transaction_time;         // bytes 2 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT64 order_id;                 // bytes 30 to 37
  UINT8 side;                      // byte 38
  UINT64 price;                    // bytes 39 to 46, signed, read here as unsigned
  UINT8 symbol[8];                 // bytes 47 to 54
  UINT8 clearing_firm[4];          // bytes 55 to 58
  UINT32 leaves_qty;               // bytes 59 to 62
  UINT64 display_price;            // bytes 63 to 70, signed, read here as unsigned
  UINT64 working_price;            // bytes 71 to 78, signed, read here as unsigned
  UINT8 base_liquidity_indicator;  // byte 79
  UINT8 sub_liquidity_indicator;   // byte 80
  UINT8 routing_firm_id[4];        // bytes 81 to 84
  UINT64 request_received_time;    // bytes 85 to 92
} OrderAcknowledgementMessage;

// ---- Order Rejected Message: 99 bytes ----------------------------------------

// Order Rejected messages are sent in response to a New Order message which must be rejected
entrypoint typedef struct _OrderRejectedMessage {
  UINT16 in_flight;           // bytes 0 to 1
  UINT64 transaction_time;    // bytes 2 to 9
  UINT8 cl_ord_id[20];        // bytes 10 to 29
  UINT8 clearing_firm[4];     // bytes 30 to 33
  UINT8 routing_firm_id[4];   // bytes 34 to 37
  UINT8 order_reject_reason;  // byte 38
  UINT8 text[60];             // bytes 39 to 98
} OrderRejectedMessage;

// ---- Quote Update Rejected Message: 27 bytes ---------------------------------

// Quote Update Rejected messages are sent in response to a Quote Update message when the entire quote block is rejected by the order handler
entrypoint typedef struct _QuoteUpdateRejectedMessage {
  UINT16 in_flight;           // bytes 0 to 1
  UINT64 transaction_time;    // bytes 2 to 9
  UINT8 quote_update_id[16];  // bytes 10 to 25
  UINT8 quote_reject_reason;  // byte 26
} QuoteUpdateRejectedMessage;

// ---- Order Modified Message: 136 bytes ---------------------------------------

// Order Modified messages are sent in response to a Modify Request message to indicate that the order has been successfully modified
entrypoint typedef struct _OrderModifiedMessage {
  UINT16 in_flight;                // bytes 0 to 1
  UINT64 transaction_time;         // bytes 2 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT8 orig_cl_ord_id[20];        // bytes 30 to 49
  UINT64 order_id;                 // bytes 50 to 57
  UINT8 clearing_firm[4];          // bytes 58 to 61
  UINT8 routing_firm_id[4];        // bytes 62 to 65
  UINT8 symbol[8];                 // bytes 66 to 73
  UINT32 order_qty;                // bytes 74 to 77
  UINT64 price;                    // bytes 78 to 85, signed, read here as unsigned
  UINT8 ord_type;                  // byte 86
  UINT32 max_floor;                // bytes 87 to 90
  UINT64 stop_px;                  // bytes 91 to 98, signed, read here as unsigned
  UINT32 leaves_qty;               // bytes 99 to 102
  UINT64 display_price;            // bytes 103 to 110, signed, read here as unsigned
  UINT64 working_price;            // bytes 111 to 118, signed, read here as unsigned
  UINT8 base_liquidity_indicator;  // byte 119
  UINT64 secondary_order_id;       // bytes 120 to 127
  UINT64 request_received_time;    // bytes 128 to 135
} OrderModifiedMessage;

// ---- Order Restated Message: 108 bytes ---------------------------------------

// Order Restated messages are sent to inform the Member that an order has been asynchronously modified
entrypoint typedef struct _OrderRestatedMessage {
  UINT16 in_flight;                // bytes 0 to 1
  UINT64 transaction_time;         // bytes 2 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT64 order_id;                 // bytes 30 to 37
  UINT8 clearing_firm[4];          // bytes 38 to 41
  UINT8 routing_firm_id[4];        // bytes 42 to 45
  UINT8 symbol[8];                 // bytes 46 to 53
  UINT8 order_restatement_reason;  // byte 54
  UINT32 order_qty;                // bytes 55 to 58
  UINT64 price;                    // bytes 59 to 66, signed, read here as unsigned
  UINT32 leaves_qty;               // bytes 67 to 70
  UINT64 display_price;            // bytes 71 to 78, signed, read here as unsigned
  UINT64 working_price;            // bytes 79 to 86, signed, read here as unsigned
  UINT8 base_liquidity_indicator;  // byte 87
  UINT64 secondary_order_id;       // bytes 88 to 95
  UINT32 last_shares;              // bytes 96 to 99
  UINT64 last_px;                  // bytes 100 to 107, signed, read here as unsigned
} OrderRestatedMessage;

// ---- Quote Restated Message: 54 bytes ----------------------------------------

// Quote Restated messages are sent to inform the Member that an order has been asynchronously modified for some reason by the Exchange
entrypoint typedef struct _QuoteRestatedMessage {
  UINT16 in_flight;           // bytes 0 to 1
  UINT64 transaction_time;    // bytes 2 to 9
  UINT8 quote_update_id[16];  // bytes 10 to 25
  UINT64 order_id;            // bytes 26 to 33
  UINT32 leaves_qty;          // bytes 34 to 37
  UINT64 working_price;       // bytes 38 to 45, signed, read here as unsigned
  UINT8 quote_symbol[6];      // bytes 46 to 51
  UINT8 side;                 // byte 52
  UINT8 restatement_reason;   // byte 53
} QuoteRestatedMessage;

// ---- Modify Rejected Message: 119 bytes --------------------------------------

// User Modify Rejected messages are sent in response to a Modify Order message for an order which cannot be modified
entrypoint typedef struct _ModifyRejectedMessage {
  UINT16 in_flight;            // bytes 0 to 1
  UINT64 transaction_time;     // bytes 2 to 9
  UINT8 cl_ord_id[20];         // bytes 10 to 29
  UINT8 clearing_firm[4];      // bytes 30 to 33
  UINT8 routing_firm_id[4];    // bytes 34 to 37
  UINT8 orig_cl_ord_id[20];    // bytes 38 to 57
  UINT8 modify_reject_reason;  // byte 58
  UINT8 text[60];              // bytes 59 to 118
} ModifyRejectedMessage;

// ---- Order Cancelled Message: 56 bytes ---------------------------------------

// This message indicates an order has been cancelled
entrypoint typedef struct _OrderCancelledMessage {
  UINT16 in_flight;              // bytes 0 to 1
  UINT64 transaction_time;       // bytes 2 to 9
  UINT8 cl_ord_id[20];           // bytes 10 to 29
  UINT8 cancel_reason;           // byte 30
  UINT8 cancel_sub_reason;       // byte 31
  UINT8 clearing_firm[4];        // bytes 32 to 35
  UINT8 routing_firm_id[4];      // bytes 36 to 39
  UINT8 symbol[8];               // bytes 40 to 47
  UINT64 request_received_time;  // bytes 48 to 55
} OrderCancelledMessage;

// ---- Quote Cancelled Message: 43 bytes ---------------------------------------

// A Quote Cancelled message will be sent to indicate an unsolicited cancellation of a quote entered with a Quote Update message
entrypoint typedef struct _QuoteCancelledMessage {
  UINT16 in_flight;           // bytes 0 to 1
  UINT64 transaction_time;    // bytes 2 to 9
  UINT8 quote_update_id[16];  // bytes 10 to 25
  UINT64 order_id;            // bytes 26 to 33
  UINT8 quote_symbol[6];      // bytes 34 to 39
  UINT8 side;                 // byte 40
  UINT8 cancel_reason;        // byte 41
  UINT8 cancel_sub_reason;    // byte 42
} QuoteCancelledMessage;

// ---- Cancel Rejected Message: 99 bytes ---------------------------------------

// A Cancel Rejected message is sent in response to a Cancel Order message to indicate that the cancellation cannot occur
entrypoint typedef struct _CancelRejectedMessage {
  UINT16 in_flight;            // bytes 0 to 1
  UINT64 transaction_time;     // bytes 2 to 9
  UINT8 cl_ord_id[20];         // bytes 10 to 29
