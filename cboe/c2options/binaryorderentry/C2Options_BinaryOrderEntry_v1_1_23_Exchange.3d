} CancelRejectedMessage;

// ---- Order Execution Message: 116 bytes --------------------------------------

// An Order Execution message is sent for each fill on an order
entrypoint typedef struct _OrderExecutionMessage {
  UINT16 in_flight;                 // bytes 0 to 1
  UINT64 transaction_time;          // bytes 2 to 9
  UINT8 cl_ord_id[20];              // bytes 10 to 29
  UINT64 exec_id;                   // bytes 30 to 37
  UINT32 last_shares;               // bytes 38 to 41
  UINT64 last_px;                   // bytes 42 to 49, signed, read here as unsigned
  UINT32 leaves_qty;                // bytes 50 to 53
