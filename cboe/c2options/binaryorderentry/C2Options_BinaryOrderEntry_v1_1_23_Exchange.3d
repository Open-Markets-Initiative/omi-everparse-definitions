  UINT8 marketing_fee_code[2];     // bytes 112 to 113
  UINT8 target_party_id[4];        // bytes 114 to 117
  UINT32 cmta_number;              // bytes 118 to 121
} TradeCancelCorrectMessage;

// ---- Purge Rejected Message: 91 bytes ----------------------------------------

// A Purge Rejected message is sent in response to a Purge Orders message to indicate that the mass cancellation cannot occur
entrypoint typedef struct _PurgeRejectedMessage {
  UINT16 in_flight;           // bytes 0 to 1
  UINT64 transaction_time;    // bytes 2 to 9
  UINT8 mass_cancel_id[20];   // bytes 10 to 29
  UINT8 purge_reject_reason;  // byte 30
