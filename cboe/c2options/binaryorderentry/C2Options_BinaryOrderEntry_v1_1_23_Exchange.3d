  UINT8 sub_liquidity_indicator;    // byte 55
  UINT8 contra_broker[4];           // bytes 56 to 59
  UINT8 side;                       // byte 60
  UINT8 symbol[8];                  // bytes 61 to 68
  UINT8 contra_trader[4];           // bytes 69 to 72
  UINT8 clearing_firm[4];           // bytes 73 to 76
  UINT8 contra_capacity;            // byte 77
  UINT8 fee_code[2];                // bytes 78 to 79
  UINT8 marketing_fee_code[2];      // bytes 80 to 81
  UINT8 routing_firm_id[4];         // bytes 82 to 85
  UINT8 cross_exclusion_indicator;  // byte 86
  UINT32 trade_date;                // bytes 87 to 90
  UINT8 multileg_reporting_type;    // byte 91
  UINT64 secondary_exec_id;         // bytes 92 to 99
  UINT8 price_type;                 // byte 100
  UINT8 trade_through_alert_type;   // byte 101
  UINT8 sender_location_id;         // byte 102
  UINT8 floor_trader_acronym[3];    // bytes 103 to 105
  UINT64 floor_trade_time;          // bytes 106 to 113
  UINT8 ex_destination;             // byte 114
  UINT8 equity_ex_destination;      // byte 115
} OrderExecutionMessage;

// ---- Quote Execution Message: 84 bytes ---------------------------------------

// A Quote Execution message is used to indicate an execution has occurred on a resting quote
entrypoint typedef struct _QuoteExecutionMessage {
  UINT16 in_flight;                // bytes 0 to 1
  UINT64 transaction_time;         // bytes 2 to 9
  UINT8 quote_update_id[16];       // bytes 10 to 25
  UINT64 order_id;                 // bytes 26 to 33
  UINT64 exec_id;                  // bytes 34 to 41
  UINT8 quote_symbol[6];           // bytes 42 to 47
  UINT8 clearing_firm[4];          // bytes 48 to 51
  UINT32 last_shares;              // bytes 52 to 55
  UINT64 last_px;                  // bytes 56 to 63, signed, read here as unsigned
  UINT32 leaves_qty;               // bytes 64 to 67
  UINT8 contra_trader[4];          // bytes 68 to 71
  UINT8 contra_capacity;           // byte 72
  UINT8 side;                      // byte 73
  UINT8 base_liquidity_indicator;  // byte 74
  UINT8 sub_liquidity_indicator;   // byte 75
  UINT8 fee_code[2];               // bytes 76 to 77
  UINT8 marketing_fee_code[2];     // bytes 78 to 79
  UINT32 trade_date;               // bytes 80 to 83
} QuoteExecutionMessage;

// ---- Trade Cancel Correct Message: 122 bytes ---------------------------------

// Used to relay a trade which has been cancelled (busted) or corrected
entrypoint typedef struct _TradeCancelCorrectMessage {
  UINT16 in_flight;                // bytes 0 to 1
  UINT64 transaction_time;         // bytes 2 to 9
  UINT8 cl_ord_id[20];             // bytes 10 to 29
  UINT64 order_id;                 // bytes 30 to 37
  UINT64 exec_ref_id;              // bytes 38 to 45
  UINT8 side;                      // byte 46
  UINT8 base_liquidity_indicator;  // byte 47
  UINT8 sub_liquidity_indicator;   // byte 48
  UINT8 clearing_firm[4];          // bytes 49 to 52
  UINT8 clearing_account[4];       // bytes 53 to 56
  UINT32 last_shares;              // bytes 57 to 60
  UINT64 last_px;                  // bytes 61 to 68, signed, read here as unsigned
  UINT64 corrected_price;          // bytes 69 to 76, signed, read here as unsigned
  UINT32 corrected_size;           // bytes 77 to 80
  UINT64 orig_time;                // bytes 81 to 88
  UINT8 symbol[8];                 // bytes 89 to 96
  UINT32 maturity_date;            // bytes 97 to 100
  UINT64 strike_price;             // bytes 101 to 108, signed, read here as unsigned
  UINT8 put_or_call;               // byte 109
