} QuoteUpdateMessage;

typedef struct _QuoteShort {
  UINT8 quote_symbol[6];   // bytes 0 to 5
  UINT8 side;              // byte 6
  UINT8 open_close;        // byte 7
  UINT32 price_short;      // bytes 8 to 11, signed, read here as unsigned
  UINT16 order_qty_short;  // bytes 12 to 13
  UINT16 scratch_pad;      // bytes 14 to 15
} QuoteShort;

// QuRequest to enter or update one or more quotes
typedef struct _QuoteUpdateShortMessage {
  UINT8 quote_update_id[16];                                       // bytes 0 to 15
  UINT8 clearing_firm[4];                                          // bytes 16 to 19
  UINT8 clearing_account[4];                                       // bytes 20 to 23
  UINT16 custom_group_id;                                          // bytes 24 to 25
  UINT64 send_time;                                                // bytes 26 to 33
  UINT8 posting_instruction;                                       // byte 34
  UINT8 session_eligibility;                                       // byte 35
  UINT8 size_modifier;                                             // byte 36
  UINT16 scratch_pad;                                              // bytes 37 to 38
  UINT8 quote_cnt;                                                 // byte 39
  QuoteShort quote_short[:byte-size (((UINT32) quote_cnt) * 16)];
} QuoteUpdateShortMessage;

// Request to cancel a group of orders across all the firm s sessions
typedef struct _PurgeOrdersV2Message {
  UINT8 mass_cancel_id[20];                                                 // bytes 0 to 19
  UINT8 clearing_firm[4];                                                   // bytes 20 to 23
  UINT8 routing_firm_id[4];                                                 // bytes 24 to 27
  UINT8 risk_root[6];                                                       // bytes 28 to 33
  MassCancelInst mass_cancel_inst;                                          // bytes 34 to 41
  UINT64 send_time;                                                         // bytes 42 to 49
  UINT8 target_matching_unit;                                               // byte 50
  UINT16 scratch_pad;                                                       // bytes 51 to 52
  UINT8 custom_group_id_cnt;                                                // byte 53
  UINT16 custom_group_id[:byte-size (((UINT32) custom_group_id_cnt) * 2)];
} PurgeOrdersV2Message;

// Reset or release Firm, Risk Root, or Custom Group ID level lockout conditions resulting from risk profile trips or self-imposed lockouts issued via Cancel Order or Purge Orders messages
typedef struct _ResetRiskMessage {
  UINT8 risk_status_id[16];    // bytes 0 to 15
  UINT8 risk_reset[8];         // bytes 16 to 23
  UINT8 clearing_firm[4];      // bytes 24 to 27
  UINT8 risk_root[6];          // bytes 28 to 33
  UINT8 target_matching_unit;  // byte 34
  UINT16 custom_group_id;      // bytes 35 to 36
  UINT16 scratch_pad;          // bytes 37 to 38
} ResetRiskMessage;

// Branch
casetype _FirmMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0001: LoginRequestMessage login_request_message;
    case 0x0002: unit logout_request;
    case 0x0003: unit client_heartbeat;
    case 0x07D1: NewOrderMessage new_order_message;
    case 0x07D2: NewOrderShortMessage new_order_short_message;
    case 0x07D5: NewComplexInstrumentMessage new_complex_instrument_message;
    case 0x07D6: NewComplexOrderMessage new_complex_order_message;
    case 0x07E7: NewComplexOrderV2Message new_complex_order_v_2_message;
    case 0x07D7: NewComplexOrderShortMessage new_complex_order_short_message;
    case 0x07DA: CancelOrderMessage cancel_order_message;
    case 0x07DF: MassCancelOrderMessage mass_cancel_order_message;
    case 0x07DB: ModifyOrderMessage modify_order_message;
    case 0x07DC: QuoteUpdateMessage quote_update_message;
    case 0x07DD: QuoteUpdateShortMessage quote_update_short_message;
    case 0x07E5: PurgeOrdersV2Message purge_orders_v_2_message;
    case 0x07DE: ResetRiskMessage reset_risk_message;
    default: UINT8 unknown[available];
  }
} FirmMessage;

// ---- Packet: FirmPacket ------------------------------------------------------

// Binary Order Entry Tcp Packet sent by the firm
entrypoint typedef struct _FirmPacket (UINT32 available) where (available >= 12) {
  UINT16 start_of_message;                                                                                          // bytes 0 to 1
  UINT16 message_length;                                                                                            // bytes 2 to 3
  UINT16 firm_message_type;                                                                                         // bytes 4 to 5
  UINT8 matching_unit;                                                                                              // byte 6
  UINT8 reserved_field;                                                                                             // byte 7
  UINT32 sequence_number;                                                                                           // bytes 8 to 11
  FirmMessage(firm_message_type, (available - 12)) firm_message[:byte-size-single-element-array (available - 12)];
} FirmPacket;

