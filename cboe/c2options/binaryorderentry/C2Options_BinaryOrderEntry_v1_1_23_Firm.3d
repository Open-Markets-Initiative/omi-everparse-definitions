typedef struct _ComplexLeg {
  UINT8 symbol[8];       // bytes 0 to 7
  UINT32 maturity_date;  // bytes 8 to 11
  UINT64 strike_price;   // bytes 12 to 19, signed, read here as unsigned
  UINT8 cfi_code[2];     // bytes 20 to 21
  UINT32 ratio_qty;      // bytes 22 to 25
