} ComplexLeg;

// A New Complex Instrument message is used to request that the system create a complex strategy.
typedef struct _NewComplexInstrumentMessage {
  UINT8 cl_ord_id[20];                                           // bytes 0 to 19
  UINT8 clearing_firm[4];                                        // bytes 20 to 23
  UINT16 scratch_pad;                                            // bytes 24 to 25
  UINT8 leg_cnt;                                                 // byte 26
  ComplexLeg complex_leg[:byte-size (((UINT32) leg_cnt) * 27)];
} NewComplexInstrumentMessage;

