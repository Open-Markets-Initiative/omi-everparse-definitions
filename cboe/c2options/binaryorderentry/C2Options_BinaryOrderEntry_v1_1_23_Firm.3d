// Firm Message Type: 2 byte code
#define FIRM_MESSAGE_TYPE_LOGIN_REQUEST_MESSAGE 0x0001            // Login Request Message
#define FIRM_MESSAGE_TYPE_LOGOUT_REQUEST_MESSAGE 0x0002           // Logout Request Message
#define FIRM_MESSAGE_TYPE_CLIENT_HEARTBEAT_MESSAGE 0x0003         // Client Heartbeat Message
#define FIRM_MESSAGE_TYPE_NEW_ORDER_MESSAGE 0x07D1                // New Order Message
#define FIRM_MESSAGE_TYPE_NEW_ORDER_SHORT_MESSAGE 0x07D2          // New Order Short Message
#define FIRM_MESSAGE_TYPE_NEW_COMPLEX_INSTRUMENT_MESSAGE 0x07D5   // New Complex Instrument Message
#define FIRM_MESSAGE_TYPE_NEW_COMPLEX_ORDER_MESSAGE 0x07D6        // New Complex Order Message
#define FIRM_MESSAGE_TYPE_NEW_COMPLEX_ORDER_V_2_MESSAGE 0x07E7    // New Complex Order V 2 Message
#define FIRM_MESSAGE_TYPE_NEW_COMPLEX_ORDER_SHORT_MESSAGE 0x07D7  // New Complex Order Short Message
#define FIRM_MESSAGE_TYPE_CANCEL_ORDER_MESSAGE 0x07DA             // Cancel Order Message
#define FIRM_MESSAGE_TYPE_MASS_CANCEL_ORDER_MESSAGE 0x07DF        // Mass Cancel Order Message
#define FIRM_MESSAGE_TYPE_MODIFY_ORDER_MESSAGE 0x07DB             // Modify Order Message
#define FIRM_MESSAGE_TYPE_QUOTE_UPDATE_MESSAGE 0x07DC             // Quote Update Message
#define FIRM_MESSAGE_TYPE_QUOTE_UPDATE_SHORT_MESSAGE 0x07DD       // Quote Update Short Message
#define FIRM_MESSAGE_TYPE_PURGE_ORDERS_V_2_MESSAGE 0x07E5         // Purge Orders V 2 Message
#define FIRM_MESSAGE_TYPE_RESET_RISK_MESSAGE 0x07DE               // Reset Risk Message

// Replay Instruction: one byte code
#define REPLAY_INSTRUCTION_DEEP_REPLAY_OF_SPECIFIED_UNIT 0x44          // Deep Replay Of Specified Unit
#define REPLAY_INSTRUCTION_FAIL_IF_UNIT_NOT_SPECIFIED 0x46             // Fail If Unit Not Specified
#define REPLAY_INSTRUCTION_REPLAY_ANY_UNSPECIFIED_UNIT_FROM_ZERO 0x52  // Replay Any Unspecified Unit From Zero
#define REPLAY_INSTRUCTION_SKIP_REPLAY_OF_UNSPECIFIED_UNITS 0x53       // Skip Replay Of Unspecified Units

// Side: one byte code
#define SIDE_BUY 0x31   // Buy
#define SIDE_SELL 0x32  // Sell

// Exec Inst: one byte code
#define EXEC_INST_INTERMARKET_SWEEP 0x66  // Intermarket Sweep

// Ord Type: one byte code
#define ORD_TYPE_MARKET 0x31      // Market
#define ORD_TYPE_LIMIT 0x32       // Limit
#define ORD_TYPE_STOP 0x33        // Stop
#define ORD_TYPE_STOP_LIMIT 0x34  // Stop Limit

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY 0x30            // Day
#define TIME_IN_FORCE_GTC 0x31            // Gtc
#define TIME_IN_FORCE_AT_THE_OPEN 0x32    // At The Open
#define TIME_IN_FORCE_IOC 0x33            // Ioc
#define TIME_IN_FORCE_FOK 0x34            // Fok
#define TIME_IN_FORCE_GTD 0x36            // Gtd
#define TIME_IN_FORCE_AT_THE_CLOSEE 0x37  // At The Closee

// Capacity: one byte code
#define CAPACITY_CUSTOMER 0x43                             // Customer
#define CAPACITY_MARKET_MAKER 0x4D                         // Market Maker
#define CAPACITY_FIRM 0x46                                 // Firm
#define CAPACITY_PROFESSIONAL_CUSTOMER 0x55                // Professional Customer
#define CAPACITY_AWAY_MARKET_MAKER 0x4E                    // Away Market Maker
#define CAPACITY_BROKER_DEALER 0x42                        // Broker Dealer
#define CAPACITY_JOINT_BACK_OFFICE 0x4A                    // Joint Back Office
#define CAPACITY_NON_TRADING_PERMIT_HOLDER_AFFILIATE 0x4C  // Non Trading Permit Holder Affiliate

// Display Indicator: one byte code
#define DISPLAY_INDICATOR_DEFAULT 0x56                                                                   // Default
#define DISPLAY_INDICATOR_PRICE_ADJUST 0x50                                                              // Price Adjust
#define DISPLAY_INDICATOR_MULTIPLE_PRICE_ADJUST 0x6D                                                     // Multiple Price Adjust
#define DISPLAY_INDICATOR_REJECT_THE_ORDER_IF_IT_CANNOT_BE_BOOKED_AND_DISPLAYED_WITHOUT_ADJUSTMENT 0x52  // Reject The Order If It Cannot Be Booked And Displayed Without Adjustment

// Put Or Call: one byte code
#define PUT_OR_CALL_PUT 0x30   // Put
#define PUT_OR_CALL_CALL 0x31  // Call

// Open Close: one byte code
#define OPEN_CLOSE_OPEN 0x4F   // Open
#define OPEN_CLOSE_CLOSE 0x43  // Close
#define OPEN_CLOSE_NONE 0x4E   // None

// Attributed Quote: one byte code
#define ATTRIBUTED_QUOTE_DO_NOT_ATTRIBUTE_FIRM_EXECUTING_BROKER_ID_TO_THIS_ORDER 0x4E  // Do Not Attribute Firm Executing Broker Id To This Order
#define ATTRIBUTED_QUOTE_ATTRIBUTE_FIRM_EXECUTING_BROKER_ID_TO_THIS_ORDER 0x59         // Attribute Firm Executing Broker Id To This Order
#define ATTRIBUTED_QUOTE_ATTRIBUTE_CLIENT_ID_ONLY 0x43                                 // Attribute Client Id Only
#define ATTRIBUTED_QUOTE_ATTRIBUTE_BOTH_CLEARING_FIRM_EFID_AND_CLIENT_ID 0x5A          // Attribute Both Clearing Firm Efid And Client Id

// Ex Destination: one byte code
#define EX_DESTINATION_NYSE_ARCA 0x41         // Nyse Arca
#define EX_DESTINATION_NASDAQ_ISE 0x45        // Nasdaq Ise
#define EX_DESTINATION_MIAX 0x46              // Miax
#define EX_DESTINATION_MIAX_PEARL 0x50        // Miax Pearl
#define EX_DESTINATION_MIAX_EMERALD 0x44      // Miax Emerald
#define EX_DESTINATION_EDGX_OPTIONS 0x47      // Edgx Options
#define EX_DESTINATION_C_2 0x48               // C 2
#define EX_DESTINATION_IEX_OPTIONS 0x49       // Iex Options
#define EX_DESTINATION_MX_2_OPTIONS 0x4A      // Mx 2 Options
#define EX_DESTINATION_BOX 0x4B               // Box
#define EX_DESTINATION_MEMX 0x4D              // Memx
#define EX_DESTINATION_NASDAQ 0x4E            // Nasdaq
#define EX_DESTINATION_NASDAQ_TEXAS 0x53      // Nasdaq Texas
#define EX_DESTINATION_NYSE_AMERICAN 0x55     // Nyse American
#define EX_DESTINATION_CBOE_OPTIONS_C_1 0x57  // Cboe Options C 1
#define EX_DESTINATION_NASDAQ_PHLX 0x58       // Nasdaq Phlx
#define EX_DESTINATION_BZX_OPTIONS 0x5A       // Bzx Options
#define EX_DESTINATION_NASDAQ_GEMX 0x67       // Nasdaq Gemx
#define EX_DESTINATION_NASDAQ_MRX 0x6D        // Nasdaq Mrx
#define EX_DESTINATION_MIAX_SAPPHIRE 0x77     // Miax Sapphire

// Use Drill Thru Override: one byte code
#define USE_DRILL_THRU_OVERRIDE_NO 0x4E   // No
#define USE_DRILL_THRU_OVERRIDE_YES 0x59  // Yes

// Stop Px Type: one byte code
#define STOP_PX_TYPE_FIXED_LIMIT_PRICE 0x4C                          // Fixed Limit Price
#define STOP_PX_TYPE_FIXED_UNDERLYING_BID_PRICE_OR_INDEX_LEVEL 0x42  // Fixed Underlying Bid Price Or Index Level
#define STOP_PX_TYPE_FIXED_UNDERLYING_ASK_PRICE_OR_INDEX_LEVEL 0x41  // Fixed Underlying Ask Price Or Index Level

// Cancel Orig On Reject: one byte code
#define CANCEL_ORIG_ON_REJECT_LEAVE_ORIGINAL_ORDER_ALONE 0x4E                   // Leave Original Order Alone
#define CANCEL_ORIG_ON_REJECT_CANCEL_ORIGINAL_ORDER_IF_MODIFICATION_FAILS 0x59  // Cancel Original Order If Modification Fails

// Posting Instruction: one byte code
#define POSTING_INSTRUCTION_POST_ONLY 0x50           // Post Only
#define POSTING_INSTRUCTION_BOOK_ONLY 0x42           // Book Only
#define POSTING_INSTRUCTION_BOOK_ONLY_NO_SLIDE 0x4E  // Book Only No Slide
#define POSTING_INSTRUCTION_POST_ONLY_NO_SLIDE 0x52  // Post Only No Slide
#define POSTING_INSTRUCTION_BOOK_ONLY_IOC 0x49       // Book Only Ioc

// Size Modifier: one byte code
#define SIZE_MODIFIER_REDUCE_OUTSTANDING_SIZE_OF_QUOTE_BY_THE_ORDER_QTY_PROVIDED 0x52  // Reduce Outstanding Size Of Quote By The Order Qty Provided

// ---- Types -------------------------------------------------------------------

// Unit Sequence
typedef struct _UnitSequence {
  UINT8 unit_number;       // byte 0
  UINT32 sequence_number;  // bytes 1 to 4
} UnitSequence;

// A Login Request message must be sent as the first message upon connection
typedef struct _LoginRequestMessage {
  UINT8 session_id[4];                                                      // bytes 0 to 3
  UINT8 session_sub_id[4];                                                  // bytes 4 to 7
  UINT8 password[10];                                                       // bytes 8 to 17
  UINT8 replay_instruction;                                                 // byte 18
  UINT8 number_of_units;                                                    // byte 19
  UnitSequence unit_sequence[:byte-size (((UINT32) number_of_units) * 5)];
} LoginRequestMessage;

typedef struct _PreventMatch {
  UINT8 mtp_modifier;      // byte 0
  UINT8 unique_id_level;   // byte 1
  UINT8 trading_group_id;  // byte 2
} PreventMatch;

// Submission of a new simple (single leg) order to Cboe
typedef struct _NewOrderMessage {
  UINT8 cl_ord_id[20];               // bytes 0 to 19
  UINT8 side;                        // byte 20
  UINT32 order_qty;                  // bytes 21 to 24
  UINT8 clearing_firm[4];            // bytes 25 to 28
  UINT8 clearing_account[4];         // bytes 29 to 32
  UINT64 price;                      // bytes 33 to 40, signed, read here as unsigned
  UINT8 exec_inst;                   // byte 41
  UINT8 ord_type;                    // byte 42
  UINT8 time_in_force;               // byte 43
  UINT32 min_qty;                    // bytes 44 to 47
  UINT32 max_floor;                  // bytes 48 to 51
  UINT8 symbol[8];                   // bytes 52 to 59
  UINT8 capacity;                    // byte 60
  UINT8 routing_inst[4];             // bytes 61 to 64
  UINT8 account[16];                 // bytes 65 to 80
  UINT8 display_indicator;           // byte 81
  PreventMatch prevent_match;        // bytes 82 to 84
  UINT64 expire_time;                // bytes 85 to 92
  UINT32 maturity_date;              // bytes 93 to 96
  UINT64 strike_price;               // bytes 97 to 104, signed, read here as unsigned
  UINT8 put_or_call;                 // byte 105
  UINT8 open_close;                  // byte 106
  UINT32 cmta_number;                // bytes 107 to 110
  UINT8 target_party_id[4];          // bytes 111 to 114
  UINT8 session_eligibility;         // byte 115
  UINT8 attributed_quote;            // byte 116
  UINT32 display_range;              // bytes 117 to 120
  UINT64 stop_px;                    // bytes 121 to 128, signed, read here as unsigned
  UINT8 rout_strategy[6];            // bytes 129 to 134
  UINT8 route_delivery_method[3];    // bytes 135 to 137
  UINT8 ex_destination;              // byte 138
  UINT64 auction_id;                 // bytes 139 to 146
  UINT8 routing_firm_id[4];          // bytes 147 to 150
  UINT16 custom_group_id;            // bytes 151 to 152
  UINT8 clearing_optional_data[16];  // bytes 153 to 168
  UINT8 client_id_attr[4];           // bytes 169 to 172
  UINT8 frequent_trader_id[6];       // bytes 173 to 178
  UINT8 compression;                 // byte 179
  UINT8 floor_destination[4];        // bytes 180 to 183
  UINT8 floor_routing_inst;          // byte 184
  UINT8 order_origin[3];             // bytes 185 to 187
  UINT8 order_router_subsidy;        // byte 188
  UINT8 price_type;                  // byte 189
  UINT8 held;                        // byte 190
  UINT16 scratch_pad;                // bytes 191 to 192
} NewOrderMessage;

