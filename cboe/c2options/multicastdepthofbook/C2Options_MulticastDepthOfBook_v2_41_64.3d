// A Time message is immediately generated and sent when there is a PITCH event for a given clock second
typedef struct _OxTimeMessage {
  UINT32 time;  // bytes 0 to 3
} OxTimeMessage;

// The Unit Clear message instructs feed recipients to clear all orders for the Cboe book in the unit specified in the Sequenced Unit Header
typedef struct _OxUnitClearMessage {
  UINT32 time_offset;  // bytes 0 to 3
} OxUnitClearMessage;

// The Transaction Begin message indicates any subsequent messages, up to the accompanying Transaction End message, are all part of the same transaction block.
typedef struct _OxTransactionBeginMessage {
  UINT32 time_offset;  // bytes 0 to 3
} OxTransactionBeginMessage;

// The Transaction End message indicates that a transaction indicated by a previous Transaction Begin message has completed.
typedef struct _OxTransactionEndMessage {
  UINT32 time_offset;  // bytes 0 to 3
} OxTransactionEndMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book
typedef struct _OxAddOrderLongMessage {
  UINT32 time_offset;    // bytes 0 to 3
  UINT64 order_id;       // bytes 4 to 11
  UINT8 side_indicator;  // byte 12
  UINT32 quantity_long;  // bytes 13 to 16
  UINT8 symbol[6];       // bytes 17 to 22
  UINT64 price_long;     // bytes 23 to 30
  UINT8 reserved_3 : 3;  // byte 31
  UINT8 aon : 1;         // byte 31
  UINT8 reserved_4 : 4;  // byte 31
} OxAddOrderLongMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book
typedef struct _OxAddOrderShortMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT16 quantity_short;  // bytes 13 to 14
  UINT8 symbol[6];        // bytes 15 to 20
  UINT16 price_short;     // bytes 21 to 22
  UINT8 reserved_3 : 3;   // byte 23
  UINT8 aon : 1;          // byte 23
  UINT8 reserved_4 : 4;   // byte 23
} OxAddOrderShortMessage;

// An Add Order message represents a newly accepted visible order on the Cboe book. Expanded version accommodates larger symbol sizes possible through the ISRA plan.
typedef struct _OxAddOrderExpandedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT8 side_indicator;      // byte 12
  UINT32 quantity_long;      // bytes 13 to 16
  UINT8 expanded_symbol[8];  // bytes 17 to 24
  UINT64 price_long;         // bytes 25 to 32
  UINT8 reserved_3 : 3;      // byte 33
  UINT8 aon : 1;             // byte 33
  UINT8 reserved_4 : 4;      // byte 33
  UINT8 participant_id[4];   // bytes 34 to 37
  UINT8 customer_indicator;  // byte 38
  UINT8 client_id[4];        // bytes 39 to 42
  UINT8 reserved_5[5];       // bytes 43 to 47
} OxAddOrderExpandedMessage;

// Order Executed messages are sent when a visible order on the Cboe book is executed in whole or in part
typedef struct _OxOrderExecutedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT32 executed_quantity;  // bytes 12 to 15
  UINT64 execution_id;       // bytes 16 to 23
  UINT8 trade_condition;     // byte 24
} OxOrderExecutedMessage;

// Order Executed at Price/Size messages are sent when a visible order on the Cboe book is executed in whole or in part at a different price than the limit price on the original Add Order message or the limit order price in the latest Modify Order message referencing the Order Id
typedef struct _OxOrderExecutedAtPriceSizeMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT64 order_id;            // bytes 4 to 11
  UINT32 executed_quantity;   // bytes 12 to 15
  UINT32 remaining_quantity;  // bytes 16 to 19
  UINT64 execution_id;        // bytes 20 to 27
  UINT64 price_long;          // bytes 28 to 35
  UINT8 trade_condition;      // byte 36
} OxOrderExecutedAtPriceSizeMessage;

// Reduce Size messages are sent when a visible order on the Cboe book is partially reduced
typedef struct _OxReduceSizeLongMessage {
  UINT32 time_offset;             // bytes 0 to 3
  UINT64 order_id;                // bytes 4 to 11
  UINT32 canceled_quantity_long;  // bytes 12 to 15
} OxReduceSizeLongMessage;

// Reduce Size messages are sent when a visible order on the Cboe book is partially reduced
typedef struct _OxReduceSizeShortMessage {
  UINT32 time_offset;              // bytes 0 to 3
  UINT64 order_id;                 // bytes 4 to 11
  UINT16 canceled_quantity_short;  // bytes 12 to 13
} OxReduceSizeShortMessage;

// The Modify Order message is sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message.
typedef struct _OxModifyOrderLongMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT32 quantity_long;      // bytes 12 to 15
  UINT64 price_long;         // bytes 16 to 23
  UINT8 display : 1;         // byte 24
  UINT8 priority : 1;        // byte 24
  UINT8 reserved_flags : 6;  // byte 24
} OxModifyOrderLongMessage;

// The Modify Order message is sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message.
typedef struct _OxModifyOrderShortMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT16 quantity_short;     // bytes 12 to 13
  UINT16 price_short;        // bytes 14 to 15
  UINT8 display : 1;         // byte 16
  UINT8 priority : 1;        // byte 16
  UINT8 reserved_flags : 6;  // byte 16
} OxModifyOrderShortMessage;

// The Delete Order message is sent whenever a booked order is cancelled or leaves the order book
typedef struct _OxDeleteOrderMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 order_id;     // bytes 4 to 11
} OxDeleteOrderMessage;

// The Trade message provides information about executions of non-displayed orders on the Cboe book and routed executions to other trading centers
typedef struct _OxTradeLongMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT32 quantity_long;   // bytes 13 to 16
  UINT8 symbol[6];        // bytes 17 to 22
  UINT64 price_long;      // bytes 23 to 30
  UINT64 execution_id;    // bytes 31 to 38
  UINT8 trade_condition;  // byte 39
} OxTradeLongMessage;

// The Trade message provides information about executions of non-displayed orders on the Cboe book and routed executions to other trading centers
typedef struct _OxTradeShortMessage {
  UINT32 time_offset;     // bytes 0 to 3
  UINT64 order_id;        // bytes 4 to 11
  UINT8 side_indicator;   // byte 12
  UINT16 quantity_short;  // bytes 13 to 14
  UINT8 symbol[6];        // bytes 15 to 20
  UINT16 price_short;     // bytes 21 to 22
  UINT64 execution_id;    // bytes 23 to 30
  UINT8 trade_condition;  // byte 31
} OxTradeShortMessage;

// The Trade message provides information about executions of non-displayed orders on the Cboe book and routed executions to other trading centers. Expanded version accommodates larger symbol sizes possible through the ISRA plan.
typedef struct _OxTradeExpandedMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT8 side_indicator;      // byte 12
  UINT32 quantity_long;      // bytes 13 to 16
  UINT8 expanded_symbol[8];  // bytes 17 to 24
  UINT64 price_long;         // bytes 25 to 32
  UINT64 execution_id;       // bytes 33 to 40
  UINT8 trade_condition;     // byte 41
} OxTradeExpandedMessage;

// The Trade Break message is sent whenever an execution on Cboe is broken
typedef struct _OxTradeBreakMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 execution_id;  // bytes 4 to 11
} OxTradeBreakMessage;

// The End of Session message is sent for each unit when the unit shuts down
typedef struct _OxEndOfSession {
  UINT32 time_offset;  // bytes 0 to 3
} OxEndOfSession;

// A Symbol Mapping message is used to map the 6 character multicast feed symbol field to an OSI symbol and Underlying. These messages are not sequenced and are sent continuously through the day at variable rates as bandwidth allows.
typedef struct _OxSymbolMappingMessage {
  UINT8 feed_symbol[6];    // bytes 0 to 5
  UINT8 osi_symbol[21];    // bytes 6 to 26
  UINT8 symbol_condition;  // byte 27
  UINT8 underlying[8];     // bytes 28 to 35
} OxSymbolMappingMessage;

// The Trading Status message is used to indicate the current trading status of a security
typedef struct _OxTradingStatusMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT8 symbol[6];           // bytes 4 to 9
  UINT8 reserved_2[2];       // bytes 10 to 11
  UINT8 trading_status;      // byte 12
  UINT8 reserved_1;          // byte 13
  UINT8 gth_trading_status;  // byte 14
  UINT8 second_reserved_1;   // byte 15
} OxTradingStatusMessage;

// The Width Update message is used to communicate opening quote width multiplier. This message will be sent in the event that the exchange decides to change the quote width multiplier on a per underlying basis.
typedef struct _OxWidthUpdateMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT8 underlying[8];  // bytes 4 to 11
  UINT8 width_type;     // byte 12
  UINT32 multiplier;    // bytes 13 to 16
} OxWidthUpdateMessage;

// Options Auction Update messages are used to disseminate price and size information and Composite Market bid and offer prices during Opening and Re-Opening (halt) auctions on the Cboe Options Exchange.
typedef struct _OxOptionsAuctionUpdateMessage {
  UINT32 time_offset;                   // bytes 0 to 3
  UINT8 expanded_symbol[8];             // bytes 4 to 11
  UINT8 auction_type;                   // byte 12
  UINT64 reference_price;               // bytes 13 to 20
  UINT32 buy_contracts;                 // bytes 21 to 24
  UINT32 sell_contracts;                // bytes 25 to 28
  UINT64 indicative_price;              // bytes 29 to 36
  UINT64 auction_only_price;            // bytes 37 to 44
  UINT8 opening_condition;              // byte 45
  UINT64 composite_market_bid_price;    // bytes 46 to 53
  UINT64 composite_market_offer_price;  // bytes 54 to 61
} OxOptionsAuctionUpdateMessage;

// Auction Summary messages are used to disseminate the results of an auction, including Opening and Re-Opening on the Cboe Options Exchange
typedef struct _OxAuctionSummaryMessage {
  UINT32 time_offset;       // bytes 0 to 3
  UINT8 stock_symbol[8];    // bytes 4 to 11
  UINT8 auction_type;       // byte 12
  UINT64 price_long;        // bytes 13 to 20
  UINT32 shares_contracts;  // bytes 21 to 24
} OxAuctionSummaryMessage;

// Auction Notification messages are used to disseminate order details of an auction. Auctions will be available for a defined period of time known as the exposure period.
typedef struct _OxAuctionNotificationMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 symbol[6];            // bytes 4 to 9
  UINT64 auction_id;          // bytes 10 to 17
  UINT8 auction_type;         // byte 18
  UINT8 side;                 // byte 19
  UINT64 price_long;          // bytes 20 to 27
  UINT32 contracts;           // bytes 28 to 31
  UINT8 customer_indicator;   // byte 32
  UINT8 participant_id[4];    // bytes 33 to 36
  UINT32 auction_end_offset;  // bytes 37 to 40
  UINT8 client_id[4];         // bytes 41 to 44
} OxAuctionNotificationMessage;

// Auction Cancel messages are used to disseminate the cancelation of an earlier Auction Notification message.
typedef struct _OxAuctionCancelMessage {
  UINT32 time_offset;  // bytes 0 to 3
  UINT64 auction_id;   // bytes 4 to 11
} OxAuctionCancelMessage;

// Auction Trade messages are used to disseminate executions resulting from an options auction.
typedef struct _OxAuctionTradeMessage {
  UINT32 time_offset;   // bytes 0 to 3
  UINT64 auction_id;    // bytes 4 to 11
  UINT64 execution_id;  // bytes 12 to 19
  UINT64 price_long;    // bytes 20 to 27
  UINT32 contracts;     // bytes 28 to 31
} OxAuctionTradeMessage;

// The SOQ Strike Range Update message is only available on the C1 Exchange. This message disseminates the minimum and maximum strike prices of the strike price range used to calculate the Special Opening Quote (SOQ) on a Volatility Settlement date.
typedef struct _OxSoqStrikeRangeUpdateMessage {
  UINT32 time_offset;         // bytes 0 to 3
  UINT8 soq_identifier[20];   // bytes 4 to 23
  UINT64 lower_strike_price;  // bytes 24 to 31
  UINT64 upper_strike_price;  // bytes 32 to 39
} OxSoqStrikeRangeUpdateMessage;

// The Constituent Symbol Mapping message is only available on the C1 Exchange. This message is used to communicate which options series are Constituent Series in a Volatility Settlement Special Opening Quote (SOQ).
typedef struct _OxConstituentSymbolMappingMessage {
  UINT8 feed_symbol[6];      // bytes 0 to 5
  UINT8 osi_symbol[21];      // bytes 6 to 26
  UINT8 symbol_condition;    // byte 27
  UINT8 underlying[8];       // bytes 28 to 35
  UINT8 soq_identifier[20];  // bytes 36 to 55
} OxConstituentSymbolMappingMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x20: OxTimeMessage ox_time_message;
    case 0x97: OxUnitClearMessage ox_unit_clear_message;
    case 0xBC: OxTransactionBeginMessage ox_transaction_begin_message;
    case 0xBD: OxTransactionEndMessage ox_transaction_end_message;
    case 0x21: OxAddOrderLongMessage ox_add_order_long_message;
    case 0x22: OxAddOrderShortMessage ox_add_order_short_message;
    case 0x2F: OxAddOrderExpandedMessage ox_add_order_expanded_message;
    case 0x23: OxOrderExecutedMessage ox_order_executed_message;
    case 0x24: OxOrderExecutedAtPriceSizeMessage ox_order_executed_at_price_size_message;
    case 0x25: OxReduceSizeLongMessage ox_reduce_size_long_message;
    case 0x26: OxReduceSizeShortMessage ox_reduce_size_short_message;
    case 0x27: OxModifyOrderLongMessage ox_modify_order_long_message;
    case 0x28: OxModifyOrderShortMessage ox_modify_order_short_message;
    case 0x29: OxDeleteOrderMessage ox_delete_order_message;
    case 0x2A: OxTradeLongMessage ox_trade_long_message;
    case 0x2B: OxTradeShortMessage ox_trade_short_message;
    case 0x30: OxTradeExpandedMessage ox_trade_expanded_message;
    case 0x2C: OxTradeBreakMessage ox_trade_break_message;
    case 0x2D: OxEndOfSession ox_end_of_session;
    case 0x2E: OxSymbolMappingMessage ox_symbol_mapping_message;
    case 0x31: OxTradingStatusMessage ox_trading_status_message;
    case 0xD2: OxWidthUpdateMessage ox_width_update_message;
    case 0xD1: OxOptionsAuctionUpdateMessage ox_options_auction_update_message;
    case 0x96: OxAuctionSummaryMessage ox_auction_summary_message;
    case 0xAD: OxAuctionNotificationMessage ox_auction_notification_message;
    case 0xAE: OxAuctionCancelMessage ox_auction_cancel_message;
    case 0xAF: OxAuctionTradeMessage ox_auction_trade_message;
    case 0x9D: OxSoqStrikeRangeUpdateMessage ox_soq_strike_range_update_message;
    case 0x9E: OxConstituentSymbolMappingMessage ox_constituent_symbol_mapping_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

