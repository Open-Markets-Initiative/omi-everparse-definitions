#define PURGE_REJECT_REASON_CANT_MODIFY_AN_ORDER_THAT_IS_PENDING_FILL 0x50               // Cant Modify An Order That Is Pending Fill
#define PURGE_REJECT_REASON_USER_REQUESTED 0x55                                          // User Requested
#define PURGE_REJECT_REASON_WOULD_WASH 0x56                                              // Would Wash
#define PURGE_REJECT_REASON_ORDER_EXPIRED 0x58                                           // Order Expired
#define PURGE_REJECT_REASON_SYMBOL_NOT_SUPPORTED 0x59                                    // Symbol Not Supported
#define PURGE_REJECT_REASON_UNFORESEEN_REASON 0x5A                                       // Unforeseen Reason
#define PURGE_REJECT_REASON_ONLY_CLOSE_TRANSACTIONS_ACCEPTED 0x63                        // Only Close Transactions Accepted
#define PURGE_REJECT_REASON_ORDER_PERSISTED 0x68                                         // Order Persisted
#define PURGE_REJECT_REASON_RISK_MANAGEMENT_E_F_I_D_LEVEL_OR_CUSTOM_GROUP_ID_LEVEL 0x66  // Risk management EFID level or custom group Id level
#define PURGE_REJECT_REASON_MARKET_ACCESS_RISK_LIMIT_EXCEEDED 0x6D                       // Market Access Risk Limit Exceeded
#define PURGE_REJECT_REASON_RISK_MANAGEMENT_CONFIGURATION_IS_INSUFFICIENT 0x6E           // Risk Management Configuration Is Insufficient
#define PURGE_REJECT_REASON_MAX_OPEN_ORDERS_COUNT_EXCEEDED 0x6F                          // Max Open Orders Count Exceeded
#define PURGE_REJECT_REASON_RISK_MANAGEMENT_PRODUCT_LEVEL 0x73                           // Risk Management Product Level
#define PURGE_REJECT_REASON_ORDER_RECEIVED_BY_CFE_DURING_REPLAY 0x79                     // Order Received By Cfe During Replay
#define PURGE_REJECT_REASON_SESSION_END 0x7A                                             // Session End

// Quote Result: one byte code
#define QUOTE_RESULT_NEW_QUOTE 0x41                                      // New Quote
#define QUOTE_RESULT_MODIFIED_LOSS_OF_PRIORITY 0x4C                      // Modified Loss Of Priority
#define QUOTE_RESULT_MODIFIED_RETAINS_PRIORITY 0x52                      // Modified Retains Priority
#define QUOTE_RESULT_NO_CHANGE 0x4E                                      // No Change
#define QUOTE_RESULT_NEW_QUOTE_BUT_MAY_REMOVE_LIQUIDITY 0x44             // New Quote, but may remove liquidity
#define QUOTE_RESULT_MODIFIED_BUT_MAY_REMOVE_LIQUIDITY 0x64              // Modified But May Remove Liquidity
#define QUOTE_RESULT_USER_CANCELLED 0x55                                 // User Cancelled
#define QUOTE_RESULT_ADMIN 0x61                                          // Admin
#define QUOTE_RESULT_REJECTED_DOESNT_MATCH_A_KNOWN_QUOTE 0x4F            // Rejected Doesnt Match A Known Quote
#define QUOTE_RESULT_REJECTED_CANT_POST 0x50                             // Rejected Cant Post
#define QUOTE_RESULT_RISK_MANAGEMENT_EFID_OR_CUSTOM_GROUP_ID_LEVEL 0x66  // Risk Management Efid Or Custom Group Id Level
#define QUOTE_RESULT_REJECTED_SYMBOL_NOT_FOUND 0x53                      // Rejected Symbol Not Found
#define QUOTE_RESULT_REJECTED_INVALID_PRICE 0x70                         // Rejected Invalid Price
#define QUOTE_RESULT_RISK_MANAGEMENT_PRODUCT_ROOT_LEVEL 0x73             // Risk Management Product Root Level
#define QUOTE_RESULT_RISK_MANAGEMENT_CONFIGURATION_IS_INSUFFICIENT 0x6E  // Risk management configuration is insufficient
#define QUOTE_RESULT_REJECTED_OTHER_REASON 0x75                          // Rejected Other Reason

// Quote Reject Reason: one byte code
#define QUOTE_REJECT_REASON_INVALID_EFID 0x43                                      // Invalid Efid
#define QUOTE_REJECT_REASON_INVALID_WASH_ID 0x44                                   // Invalid Wash Id
#define QUOTE_REJECT_REASON_NOT_ENABLED_FOR_QUOTES 0x46                            // Not Enabled For Quotes
#define QUOTE_REJECT_REASON_INCORRECT_DATA_CENTER 0x49                             // Incorrect Data Center
#define QUOTE_REJECT_REASON_MESSAGE_RATE_THRESHOLD 0x4B                            // Message rate threshold
#define QUOTE_REJECT_REASON_INVALID_QUOTE_CNT 0x4C                                 // Invalid Quote Cnt
#define QUOTE_REJECT_REASON_SYMBOLS_NOT_ON_SAME_MATCHING_ENGINE 0x4D               // Symbols Not On Same Matching Engine
#define QUOTE_REJECT_REASON_INVALID_MANUAL_ORDER_INDICATOR 0x4F                    // Invalid Manual Order Indicator
#define QUOTE_REJECT_REASON_INVALID_QUOTE_UPDATE_ID 0x51                           // Invalid Quote Update Id
#define QUOTE_REJECT_REASON_FUTURES_ROOT_DOES_NOT_MATCH_ACROSS_QUOTES 0x52         // Futures Root Does Not Match Across Quotes
#define QUOTE_REJECT_REASON_SYMBOL_NOT_FOUND 0x53                                  // Symbol Not Found
#define QUOTE_REJECT_REASON_INVALID_WASH_PREVENT_TYPE 0x57                         // Invalid Wash Prevent Type
#define QUOTE_REJECT_REASON_ADMIN 0x61                                             // Admin
#define QUOTE_REJECT_REASON_INVALID_CAPACITY 0x63                                  // Invalid Capacity
#define QUOTE_REJECT_REASON_CLOSE_ONLY 0x64                                        // Close Only
#define QUOTE_REJECT_REASON_INVALID_OEOID 0x65                                     // Invalid Oeoid
#define QUOTE_REJECT_REASON_RISK_MANAGEMENT_E_F_I_D_OR_CUSTOM_GROUP_ID_LEVEL 0x66  // Risk management EFID or Custom Group Id level
#define QUOTE_REJECT_REASON_INVALID_CTI_CODE 0x69                                  // Invalid Cti Code
#define QUOTE_REJECT_REASON_INVALID_WASH_METHOD 0x6D                               // Invalid Wash Method
#define QUOTE_REJECT_REASON_EXCEEDS_MAX_NOTIONAL_VALUE_PER_ORDER 0x6E              // Exceeds Max Notional Value Per Order
#define QUOTE_REJECT_REASON_INVALID_OPEN_CLOSE 0x6F                                // Invalid Open Close
#define QUOTE_REJECT_REASON_INVALID_REMOVE 0x72                                    // Invalid Remove
#define QUOTE_REJECT_REASON_INVALID_SIDE 0x73                                      // Invalid Side
#define QUOTE_REJECT_REASON_SYMBOL_RANGE_UNREACHABLE 0x55                          // Symbol Range Unreachable
#define QUOTE_REJECT_REASON_EXCEEDS_MAX_SIZE_PER_ORDER 0x78                        // Exceeds Max Size Per Order
#define QUOTE_REJECT_REASON_QUOTE_RECEIVED_BY_C_F_E_DURING_REPLAY 0x79             // Quote received by CFE during replay
#define QUOTE_REJECT_REASON_INVALID_SIZE_MODIFIER 0x7A                             // Invalid Size Modifier

// Restatement Reason: one byte code
#define RESTATEMENT_REASON_LIQUIDITY 0x51  // Liquidity
#define RESTATEMENT_REASON_WASH 0x57       // Wash

// Risk Reset Result: one byte code
#define RISK_RESET_RESULT_IGNORED 0x20                                     // Ignored
#define RISK_RESET_RESULT_SUCCESS 0x59                                     // Success
#define RISK_RESET_RESULT_REJECTED_EXCEEDS_FIRM_RESET_LIMIT 0x46           // Rejected Exceeds Firm Reset Limit
#define RISK_RESET_RESULT_REJECTED_EXCEEDS_CUSTOM_GROUP_ID_LIMIT 0x43      // Rejected exceeds Custom Group Id limit
#define RISK_RESET_RESULT_REJECTED_EMPTY_RESET_RISK_FIELD 0x45             // Rejected Empty Reset Risk Field
#define RISK_RESET_RESULT_REJECTED_INCORRECT_DATA_CENTER 0x49              // Rejected Incorrect Data Center
#define RISK_RESET_RESULT_REJECTED_EXCEEDS_PRODUCT_LEVEL_RESET_LIMIT 0x53  // Rejected exceeds product level reset limit
#define RISK_RESET_RESULT_REJECTED_INVALID_RISK_ROOT 0x55                  // Rejected Invalid Risk Root
#define RISK_RESET_RESULT_REJECTED_INVALID_EFID_CLEARING_FIRM 0x63         // Rejected Invalid Efid Clearing Firm
#define RISK_RESET_RESULT_REJECTED_IN_REPLAY 0x79                          // Rejected In Replay

// Leg Side: one byte code
#define LEG_SIDE_BUY 0x31   // Buy
#define LEG_SIDE_SELL 0x32  // Sell

// ---- Types -------------------------------------------------------------------

// Unit Sequence
typedef struct _UnitSequence {
  UINT8 unit_number;       // byte 0
  UINT32 sequence_number;  // bytes 1 to 4
} UnitSequence;

// A Login Response message is sent in response to a Login Request message
typedef struct _LoginResponseMessage {
  UINT8 login_response_status;                                              // byte 0
  UINT8 login_response_text[60];                                            // bytes 1 to 60
  UINT32 client_sequence;                                                   // bytes 61 to 64
  UINT8 number_of_units;                                                    // byte 65
  UnitSequence unit_sequence[:byte-size (((UINT32) number_of_units) * 5)];
} LoginResponseMessage;

// A Logout Response is usually sent in response to a Logout Request
typedef struct _LogoutResponseMessage {
  UINT8 logout_reason;           // byte 0
  UINT8 logout_reason_text[60];  // bytes 1 to 60
} LogoutResponseMessage;

typedef struct _PreventMatch {
  UINT8 mtp_modifier;      // byte 0
  UINT8 unique_id_level;   // byte 1
  UINT8 trading_group_id;  // byte 2
} PreventMatch;

// Order Acknowledgement messages are sent in response to a new order message
typedef struct _OrderAcknowledgement {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 cl_ord_id[20];             // bytes 8 to 27
  UINT64 order_id;                 // bytes 28 to 35
  UINT8 side;                      // byte 36
  UINT64 price;                    // bytes 37 to 44, signed, read here as unsigned
  UINT8 ord_type;                  // byte 45
  UINT8 time_in_force;             // byte 46
  UINT32 min_qty;                  // bytes 47 to 50
  UINT8 symbol[8];                 // bytes 51 to 58
  UINT8 capacity;                  // byte 59
  UINT8 account[16];               // bytes 60 to 75
  UINT8 clearing_firm[4];          // bytes 76 to 79
  UINT8 clearing_account[4];       // bytes 80 to 83
  UINT32 order_qty;                // bytes 84 to 87
  PreventMatch prevent_match;      // bytes 88 to 90
  UINT32 maturity_date;            // bytes 91 to 94
  UINT8 open_close;                // byte 95
  UINT32 leaves_qty;               // bytes 96 to 99
  UINT8 base_liquidity_indicator;  // byte 100
  UINT64 expire_time;              // bytes 101 to 108
  UINT8 sub_liquidity_indicator;   // byte 109
  UINT64 stop_px;                  // bytes 110 to 117, signed, read here as unsigned
  UINT32 cmta_number;              // bytes 118 to 121
  UINT8 cti_code;                  // byte 122
  UINT8 manual_order_indicator;    // byte 123
  UINT8 oeo_id[18];                // bytes 124 to 141
  UINT32 cum_qty;                  // bytes 142 to 145
  UINT8 frequent_trader_id[6];     // bytes 146 to 151
  UINT8 cust_order_handling_inst;  // byte 152
  UINT64 request_received_time;    // bytes 153 to 160
} OrderAcknowledgement;

// Order Acknowledgement messages are sent in response to a new order message
typedef struct _OrderAcknowledgementOption {
  UINT64 transaction_time;                              // bytes 0 to 7
  UINT8 cl_ord_id[20];                                  // bytes 8 to 27
  UINT64 order_id;                                      // bytes 28 to 35
  UINT8 side;                                           // byte 36
  UINT64 price;                                         // bytes 37 to 44, signed, read here as unsigned
  UINT8 ord_type;                                       // byte 45
  UINT8 time_in_force;                                  // byte 46
  UINT8 symbol[8];                                      // bytes 47 to 54
  UINT8 security_desc[16];                              // bytes 55 to 70
  UINT8 capacity;                                       // byte 71
  UINT8 account[16];                                    // bytes 72 to 87
  UINT8 clearing_firm[4];                               // bytes 88 to 91
  UINT8 clearing_account[4];                            // bytes 92 to 95
  UINT32 order_qty;                                     // bytes 96 to 99
  PreventMatch prevent_match;                           // bytes 100 to 102
  UINT8 open_close;                                     // byte 103
  UINT32 leaves_qty;                                    // bytes 104 to 107
  UINT8 base_liquidity_indicator;                       // byte 108
  UINT64 expire_time;                                   // bytes 109 to 116
  UINT8 sub_liquidity_indicator;                        // byte 117
  UINT32 cmta_number;                                   // bytes 118 to 121
  UINT8 cti_code;                                       // byte 122
  UINT8 manual_order_indicator;                         // byte 123
  UINT8 oeo_id[18];                                     // bytes 124 to 141
  UINT32 cum_qty;                                       // bytes 142 to 145
  UINT8 frequent_trader_id[6];                          // bytes 146 to 151
  UINT8 cust_order_handling_inst;                       // byte 152
  UINT8 country_code[2];                                // bytes 153 to 154
  UINT64 request_received_time;                         // bytes 155 to 162
  UINT8 leg_cnt;                                        // byte 163
  UINT8 leg_position_effect[(((UINT32) leg_cnt) * 1)];
} OrderAcknowledgementOption;

// Order Rejected messages are sent in response to a New Order which must be rejected
typedef struct _OrderRejected {
  UINT64 transaction_time;    // bytes 0 to 7
  UINT8 cl_ord_id[20];        // bytes 8 to 27
  UINT8 clearing_firm[4];     // bytes 28 to 31
  UINT8 order_reject_reason;  // byte 32
  UINT8 text[60];             // bytes 33 to 92
} OrderRejected;

// Order Modified messages are sent in response to a Modify Order to indicate that the orderhas been successfully modified
typedef struct _OrderModified {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 cl_ord_id[20];             // bytes 8 to 27
  UINT8 orig_cl_ord_id[20];        // bytes 28 to 47
  UINT64 order_id;                 // bytes 48 to 55
  UINT8 clearing_firm[4];          // bytes 56 to 59
  UINT64 price;                    // bytes 60 to 67, signed, read here as unsigned
  UINT8 ord_type;                  // byte 68
  UINT32 order_qty;                // bytes 69 to 72
  UINT32 leaves_qty;               // bytes 73 to 76
  UINT8 base_liquidity_indicator;  // byte 77
  UINT64 stop_px;                  // bytes 78 to 85, signed, read here as unsigned
  UINT8 frequent_trader_id[6];     // bytes 86 to 91
  UINT8 cust_order_handling_inst;  // byte 92
  UINT64 request_received_time;    // bytes 93 to 100
} OrderModified;

// Modify Rejected messages are sent in response to a Modify Order for an order which cannot be modified
typedef struct _ModifyRejected {
  UINT64 transaction_time;     // bytes 0 to 7
  UINT8 cl_ord_id[20];         // bytes 8 to 27
  UINT8 orig_cl_ord_id[20];    // bytes 28 to 47
  UINT8 clearing_firm[4];      // bytes 48 to 51
  UINT8 modify_reject_reason;  // byte 52
  UINT8 text[60];              // bytes 53 to 112
} ModifyRejected;

// AnOrder Executionis sent for each fill on an order
typedef struct _OrderExecution {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 cl_ord_id[20];             // bytes 8 to 27
  UINT64 exec_id;                  // bytes 28 to 35
  UINT32 last_shares;              // bytes 36 to 39
  UINT64 last_px;                  // bytes 40 to 47, signed, read here as unsigned
  UINT32 leaves_qty;               // bytes 48 to 51
  UINT8 base_liquidity_indicator;  // byte 52
  UINT8 sub_liquidity_indicator;   // byte 53
  UINT8 side;                      // byte 54
  UINT8 symbol[8];                 // bytes 55 to 62
  UINT8 clearing_firm[4];          // bytes 63 to 66
  UINT32 maturity_date;            // bytes 67 to 70
  UINT8 fee_code[2];               // bytes 71 to 72
  UINT32 trade_date;               // bytes 73 to 76
  UINT32 clearing_size;            // bytes 77 to 80
  UINT8 pending_status;            // byte 81
  UINT8 multileg_reporting_type;   // byte 82
  UINT64 secondary_exec_id;        // bytes 83 to 90
} OrderExecution;

// An Order Execution is sent for each fill on an order
typedef struct _OrderExecutionOption {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 cl_ord_id[20];             // bytes 8 to 27
  UINT64 exec_id;                  // bytes 28 to 35
  UINT32 last_shares;              // bytes 36 to 39
  UINT64 last_px;                  // bytes 40 to 47, signed, read here as unsigned
  UINT32 leaves_qty;               // bytes 48 to 51
  UINT8 base_liquidity_indicator;  // byte 52
  UINT8 sub_liquidity_indicator;   // byte 53
  UINT8 side;                      // byte 54
  UINT8 symbol[8];                 // bytes 55 to 62
  UINT8 clearing_firm[4];          // bytes 63 to 66
  UINT8 security_desc[16];         // bytes 67 to 82
  UINT8 fee_code[2];               // bytes 83 to 84
  UINT32 trade_date;               // bytes 85 to 88
  UINT32 clearing_size;            // bytes 89 to 92
  UINT8 pending_status;            // byte 93
  UINT8 multileg_reporting_type;   // byte 94
  UINT64 secondary_exec_id;        // bytes 95 to 102
} OrderExecutionOption;

// Order Cancelled message
typedef struct _OrderCancelled {
  UINT64 transaction_time;       // bytes 0 to 7
  UINT8 cl_ord_id[20];           // bytes 8 to 27
  UINT8 clearing_firm[4];        // bytes 28 to 31
  UINT8 cancel_reason;           // byte 32
  UINT64 request_received_time;  // bytes 33 to 40
} OrderCancelled;

// A Cancel Rejected message is sent in response to a Cancel Order message to indicate that the cancellation cannot occur
typedef struct _CancelRejected {
  UINT64 transaction_time;     // bytes 0 to 7
  UINT8 cl_ord_id[20];         // bytes 8 to 27
  UINT8 clearing_firm[4];      // bytes 28 to 31
  UINT8 cancel_reject_reason;  // byte 32
  UINT8 text[60];              // bytes 33 to 92
} CancelRejected;

// A Mass Cancel Acknowledgment is an unsequenced message sent when a Cancel Order or Purge Orders message requesting a mass cancellation has completed cancelling all individual orders
typedef struct _MassCancelAcknowledgement {
  UINT64 transaction_time;       // bytes 0 to 7
  UINT8 mass_cancel_id[20];      // bytes 8 to 27
  UINT32 cancelled_order_count;  // bytes 28 to 31
  UINT64 request_received_time;  // bytes 32 to 39
} MassCancelAcknowledgement;

// A Mass Cancel Rejected message is sent in response to a Mass Cancel Order message to indicate that the mass cancellation cannot occur
typedef struct _MassCancelRejected {
  UINT64 transaction_time;          // bytes 0 to 7
  UINT8 mass_cancel_id[20];         // bytes 8 to 27
  UINT8 mass_cancel_reject_reason;  // byte 28
  UINT8 text[60];                   // bytes 29 to 88
} MassCancelRejected;

// A Purge Acknowledgment is an unsequenced message sent when a Purge Orders message requesting an order purge has completed cancelling all individual orders
typedef struct _PurgeAcknowledgement {
  UINT64 transaction_time;       // bytes 0 to 7
  UINT8 mass_cancel_id[20];      // bytes 8 to 27
  UINT32 cancelled_order_count;  // bytes 28 to 31
  UINT64 request_received_time;  // bytes 32 to 39
} PurgeAcknowledgement;

// A Purge Rejected message is sent in response to a Purge Orders message to indicate that the mass cancellation cannot occur
typedef struct _PurgeRejected {
  UINT64 transaction_time;    // bytes 0 to 7
  UINT8 mass_cancel_id[20];   // bytes 8 to 27
  UINT8 purge_reject_reason;  // byte 28
  UINT8 text[60];             // bytes 29 to 88
} PurgeRejected;

// Used to provide notification that a trade has been cancelled or corrected
typedef struct _TradeCancelCorrect {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 cl_ord_id[20];             // bytes 8 to 27
  UINT64 exec_ref_id;              // bytes 28 to 35
  UINT8 side;                      // byte 36
  UINT8 base_liquidity_indicator;  // byte 37
  UINT8 clearing_firm[4];          // bytes 38 to 41
  UINT8 clearing_account[4];       // bytes 42 to 45
  UINT32 last_shares;              // bytes 46 to 49
  UINT64 last_px;                  // bytes 50 to 57, signed, read here as unsigned
  UINT64 corrected_price;          // bytes 58 to 65, signed, read here as unsigned
  UINT64 orig_time;                // bytes 66 to 73
  UINT8 symbol[8];                 // bytes 74 to 81
  UINT8 capacity;                  // byte 82
  UINT32 maturity_date;            // bytes 83 to 86
  UINT8 open_close;                // byte 87
  UINT32 cmta_number;              // bytes 88 to 91
} TradeCancelCorrect;

// Used to provide notification that an option trade has been cancelled or corrected
typedef struct _TradeCancelCorrectOption {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 cl_ord_id[20];             // bytes 8 to 27
  UINT64 exec_ref_id;              // bytes 28 to 35
  UINT8 side;                      // byte 36
  UINT8 base_liquidity_indicator;  // byte 37
  UINT8 clearing_firm[4];          // bytes 38 to 41
  UINT8 clearing_account[4];       // bytes 42 to 45
  UINT32 last_shares;              // bytes 46 to 49
  UINT64 last_px;                  // bytes 50 to 57, signed, read here as unsigned
  UINT64 corrected_price;          // bytes 58 to 65, signed, read here as unsigned
  UINT64 orig_time;                // bytes 66 to 73
  UINT8 symbol[8];                 // bytes 74 to 81
  UINT8 capacity;                  // byte 82
  UINT8 security_desc[16];         // bytes 83 to 98
  UINT8 open_close;                // byte 99
  UINT32 cmta_number;              // bytes 100 to 103
} TradeCancelCorrectOption;

// A Tas Restatement is sent post-settlement time for each TAS execution during the associated business day to communicate the updated Price and Symbol associated with the cleared execution
typedef struct _TasRestatement {
  UINT64 transaction_time;        // bytes 0 to 7
  UINT8 cl_ord_id[20];            // bytes 8 to 27
  UINT8 clearing_firm[4];         // bytes 28 to 31
  UINT64 exec_id;                 // bytes 32 to 39
  UINT8 side;                     // byte 40
  UINT64 price;                   // bytes 41 to 48, signed, read here as unsigned
  UINT8 symbol[8];                // bytes 49 to 56
  UINT32 maturity_date;           // bytes 57 to 60
  UINT32 last_shares;             // bytes 61 to 64
  UINT64 last_px;                 // bytes 65 to 72, signed, read here as unsigned
  UINT8 fee_code[2];              // bytes 73 to 74
  UINT32 trade_date;              // bytes 75 to 78
  UINT64 clearing_price;          // bytes 79 to 86, signed, read here as unsigned
  UINT8 clearing_symbol[8];       // bytes 87 to 94
  UINT8 multileg_reporting_type;  // byte 95
  UINT64 secondary_exec_id;       // bytes 96 to 103
} TasRestatement;

typedef struct _QuoteUpdateAcknowledgementGroup {
  UINT64 order_id;                // bytes 0 to 7
  UINT8 quote_result;             // byte 8
  UINT8 sub_liquidity_indicator;  // byte 9
} QuoteUpdateAcknowledgementGroup;

// Quote Update Acknowledgment messages are sent in response to a Quote Update or Quote Update Option message
typedef struct _QuoteUpdateAcknowledgement {
  UINT64 transaction_time;                                                                                     // bytes 0 to 7
  UINT8 quote_update_id[16];                                                                                   // bytes 8 to 23
  UINT64 request_received_time;                                                                                // bytes 24 to 31
  UINT8 quote_cnt;                                                                                             // byte 32
  QuoteUpdateAcknowledgementGroup quote_update_acknowledgement_group[:byte-size (((UINT32) quote_cnt) * 10)];
} QuoteUpdateAcknowledgement;

// Quote Update Rejected messages are sent in response to a Quote Update or Quote Update Option message when the entire quote block is rejected by the order handler
typedef struct _QuoteUpdateRejected {
  UINT64 transaction_time;    // bytes 0 to 7
  UINT8 quote_update_id[16];  // bytes 8 to 23
  UINT8 quote_reject_reason;  // byte 24
} QuoteUpdateRejected;

// Quote Restatedmessages are sent to inform the TPH that an order has been asynchronously modified for some reason by CFE
typedef struct _QuoteRestated {
  UINT64 transaction_time;    // bytes 0 to 7
  UINT8 quote_update_id[16];  // bytes 8 to 23
  UINT64 order_id;            // bytes 24 to 31
  UINT32 leaves_qty;          // bytes 32 to 35
  UINT64 working_price;       // bytes 36 to 43, signed, read here as unsigned
  UINT8 quote_symbol[6];      // bytes 44 to 49
  UINT8 side;                 // byte 50
  UINT8 restatement_reason;   // byte 51
} QuoteRestated;

// A Quote Execution message is used to indicate an execution has occurred on a resting quote
typedef struct _QuoteExecution {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 quote_update_id[16];       // bytes 8 to 23
  UINT64 order_id;                 // bytes 24 to 31
  UINT64 exec_id;                  // bytes 32 to 39
  UINT8 quote_symbol[6];           // bytes 40 to 45
  UINT8 clearing_firm[4];          // bytes 46 to 49
  UINT32 last_shares;              // bytes 50 to 53
  UINT64 last_px;                  // bytes 54 to 61, signed, read here as unsigned
  UINT32 leaves_qty;               // bytes 62 to 65
  UINT8 side;                      // byte 66
  UINT8 base_liquidity_indicator;  // byte 67
  UINT8 sub_liquidity_indicator;   // byte 68
  UINT8 fee_code[2];               // bytes 69 to 70
} QuoteExecution;

// A Quote Cancelled message will be sent to indicate an unsolicited cancellation of a quote entered with a Quote Update message
typedef struct _QuoteCancelled {
  UINT64 transaction_time;    // bytes 0 to 7
  UINT8 quote_update_id[16];  // bytes 8 to 23
  UINT64 order_id;            // bytes 24 to 31
  UINT8 quote_symbol[6];      // bytes 32 to 37
  UINT8 side;                 // byte 38
  UINT8 cancel_reason;        // byte 39
} QuoteCancelled;

// A TAS Quote Restatement is sent post-settlement time for each TAS quote execution during the associated business day to communicate the updated Price and Symbol associated with the cleared execution
typedef struct _TasQuoteRestatement {
  UINT64 transaction_time;    // bytes 0 to 7
  UINT8 quote_update_id[16];  // bytes 8 to 23
  UINT64 exec_id;             // bytes 24 to 31
  UINT8 quote_symbol[6];      // bytes 32 to 37
  UINT8 clearing_symbol[8];   // bytes 38 to 45
  UINT64 clearing_price;      // bytes 46 to 53, signed, read here as unsigned
} TasQuoteRestatement;

// Response to a Reset Risk request
typedef struct _ResetRiskAcknowledgement {
  UINT8 risk_status_id[16];      // bytes 0 to 15
  UINT8 risk_reset_result;       // byte 16
  UINT64 request_received_time;  // bytes 17 to 24
} ResetRiskAcknowledgement;

typedef struct _OptionLeg {
  UINT8 leg_symbol[8];   // bytes 0 to 7
  UINT32 leg_ratio_qty;  // bytes 8 to 11
  UINT8 leg_side;        // byte 12
} OptionLeg;

// The New Complex Instrument Acceptedmessage indicates acceptance of a complex strategy
typedef struct _NewComplexInstrumentAcceptedOption {
  UINT64 transaction_time;                                     // bytes 0 to 7
  UINT8 cl_ord_id[20];                                         // bytes 8 to 27
  UINT8 symbol[8];                                             // bytes 28 to 35
  UINT32 no_of_complex_instruments;                            // bytes 36 to 39
  UINT8 leg_cnt;                                               // byte 40
  OptionLeg option_leg[:byte-size (((UINT32) leg_cnt) * 13)];
} NewComplexInstrumentAcceptedOption;

// The New Complex Instrument Rejected indicates that a requested complex strategy has been rejected
typedef struct _NewComplexInstrumentRejectedOption {
  UINT64 transaction_time;                 // bytes 0 to 7
  UINT8 cl_ord_id[20];                     // bytes 8 to 27
  UINT8 clearing_firm[4];                  // bytes 28 to 31
  UINT8 complex_instrument_reject_reason;  // byte 32
  UINT8 text[60];                          // bytes 33 to 92
} NewComplexInstrumentRejectedOption;

// Branch
casetype _ExchangeMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x01F5: LoginResponseMessage login_response_message;
    case 0x01F6: unit replay_complete;
    case 0x01F7: LogoutResponseMessage logout_response_message;
    case 0x01F8: unit server_heartbeat;
    case 0x05DD: OrderAcknowledgement order_acknowledgement;
    case 0x05F3: OrderAcknowledgementOption order_acknowledgement_option;
    case 0x05DE: OrderRejected order_rejected;
    case 0x05DF: OrderModified order_modified;
    case 0x05E0: ModifyRejected modify_rejected;
    case 0x05E1: OrderExecution order_execution;
    case 0x05F4: OrderExecutionOption order_execution_option;
    case 0x05E2: OrderCancelled order_cancelled;
    case 0x05E3: CancelRejected cancel_rejected;
    case 0x05E4: MassCancelAcknowledgement mass_cancel_acknowledgement;
    case 0x05E5: MassCancelRejected mass_cancel_rejected;
    case 0x05E6: PurgeAcknowledgement purge_acknowledgement;
    case 0x05E7: PurgeRejected purge_rejected;
    case 0x05E8: TradeCancelCorrect trade_cancel_correct;
    case 0x05F5: TradeCancelCorrectOption trade_cancel_correct_option;
    case 0x05E9: TasRestatement tas_restatement;
    case 0x05EB: QuoteUpdateAcknowledgement quote_update_acknowledgement;
    case 0x05EC: QuoteUpdateRejected quote_update_rejected;
    case 0x05ED: QuoteRestated quote_restated;
    case 0x05EE: QuoteExecution quote_execution;
    case 0x05EF: QuoteCancelled quote_cancelled;
    case 0x05F0: TasQuoteRestatement tas_quote_restatement;
    case 0x05F2: ResetRiskAcknowledgement reset_risk_acknowledgement;
    case 0x05F6: NewComplexInstrumentAcceptedOption new_complex_instrument_accepted_option;
    case 0x05F7: NewComplexInstrumentRejectedOption new_complex_instrument_rejected_option;
    default: UINT8 unknown[available];
  }
} ExchangeMessage;

// ---- Packet: ExchangePacket --------------------------------------------------

// Binary Order Entry Tcp Packet sent by the exchange
entrypoint typedef struct _ExchangePacket (UINT32 available) where (available >= 12) {
  UINT16 start_of_message;                                                                                                      // bytes 0 to 1
  UINT16 message_length;                                                                                                        // bytes 2 to 3
  UINT16 exchange_message_type;                                                                                                 // bytes 4 to 5
  UINT8 matching_unit;                                                                                                          // byte 6
  UINT8 reserved_field;                                                                                                         // byte 7
  UINT32 sequence_number;                                                                                                       // bytes 8 to 11
  ExchangeMessage(exchange_message_type, (available - 12)) exchange_message[:byte-size-single-element-array (available - 12)];
} ExchangePacket;

