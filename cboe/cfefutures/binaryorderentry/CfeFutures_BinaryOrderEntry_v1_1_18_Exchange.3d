  UINT8 symbol[8];                 // bytes 51 to 58
  UINT8 capacity;                  // byte 59
  UINT8 account[16];               // bytes 60 to 75
  UINT8 clearing_firm[4];          // bytes 76 to 79
  UINT8 clearing_account[4];       // bytes 80 to 83
  UINT32 order_qty;                // bytes 84 to 87
  PreventMatch prevent_match;      // bytes 88 to 90
  UINT32 maturity_date;            // bytes 91 to 94
  UINT8 open_close;                // byte 95
  UINT32 leaves_qty;               // bytes 96 to 99
  UINT8 base_liquidity_indicator;  // byte 100
  UINT64 expire_time;              // bytes 101 to 108
  UINT8 sub_liquidity_indicator;   // byte 109
  UINT64 stop_px;                  // bytes 110 to 117, signed, read here as unsigned
  UINT32 cmta_number;              // bytes 118 to 121
  UINT8 cti_code;                  // byte 122
  UINT8 manual_order_indicator;    // byte 123
  UINT8 oeo_id[18];                // bytes 124 to 141
  UINT32 cum_qty;                  // bytes 142 to 145
  UINT8 frequent_trader_id[6];     // bytes 146 to 151
  UINT8 cust_order_handling_inst;  // byte 152
  UINT64 request_received_time;    // bytes 153 to 160
} OrderAcknowledgement;

