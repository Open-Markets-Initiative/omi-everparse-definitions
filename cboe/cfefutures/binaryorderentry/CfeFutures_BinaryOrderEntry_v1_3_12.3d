#define PENDING_STATUS_PENDING 0x50         // Pending

// Multileg Reporting Type: one byte code
#define MULTILEG_REPORTING_TYPE_SIMPLE_INSTRUMENT_EXECUTION 0x31                           // Simple Instrument Execution
#define MULTILEG_REPORTING_TYPE_SIMPLE_INSTRUMENT_EXECUTION_THAT_IS_PART_OF_A_SPREAD 0x32  // Simple Instrument Execution That Is Part Of A Spread
#define MULTILEG_REPORTING_TYPE_SPREAD_INSTRUMENT_EXECUTION 0x33                           // Spread Instrument Execution

// Purge Reject Reason: one byte code
#define PURGE_REJECT_REASON_ADMIN 0x41                                                    // Admin
#define PURGE_REJECT_REASON_UNKNOWN_MATURITY_DATE 0x42                                    // Unknown Maturity Date
#define PURGE_REJECT_REASON_UNKNOWN_PRODUCT_NAME 0x43                                     // Unknown Product Name
#define PURGE_REJECT_REASON_DUPLICATE_IDENTIFIER 0x44                                     // Duplicate Identifier
#define PURGE_REJECT_REASON_HALTED 0x48                                                   // Halted
#define PURGE_REJECT_REASON_INCORRECT_DATA_CENTER 0x49                                    // Incorrect Data Center
#define PURGE_REJECT_REASON_TOO_LATE_TO_CANCEL 0x4A                                       // Too Late To Cancel
#define PURGE_REJECT_REASON_ORDER_RATE_THRESHOLD_EXCEEDED 0x4B                            // Order Rate Threshold Exceeded
#define PURGE_REJECT_REASON_LIQUIDITY_AVAILABLE_EXCEEDS_ORDER_SIZE 0x4D                   // Liquidity Available Exceeds Order Size
#define PURGE_REJECT_REASON_RAN_OUT_OF_LIQUIDITY_TO_EXECUTE_AGAINST 0x4E                  // Ran Out Of Liquidity To Execute Against
#define PURGE_REJECT_REASON_CL_ORD_ID_DOESNT_MATCH_A_KNOWN_ORDER 0x4F                     // Cl Ord Id Doesnt Match A Known Order
#define PURGE_REJECT_REASON_CANT_MODIFY_AN_ORDER_THAT_IS_PENDING 0x50                     // Cant Modify An Order That Is Pending
#define PURGE_REJECT_REASON_USER_REQUESTED 0x55                                           // User Requested
#define PURGE_REJECT_REASON_WOULD_WASH 0x56                                               // Would Wash
#define PURGE_REJECT_REASON_ORDER_EXPIRED 0x58                                            // Order Expired
#define PURGE_REJECT_REASON_SYMBOL_NOT_SUPPORTED 0x59                                     // Symbol Not Supported
#define PURGE_REJECT_REASON_UNFORESEEN_REASON 0x5A                                        // Unforeseen Reason
#define PURGE_REJECT_REASON_ORDER_PERSISTED 0x68                                          // Order Persisted
#define PURGE_REJECT_REASON_RISK_MANAGEMENT_E_F_I_D_LEVEL_OR_CUSTOM_GROUP_I_D_LEVEL 0x66  // Risk management EFID level or custom group ID level
#define PURGE_REJECT_REASON_MARKET_ACCESS_RISK_LIMIT_EXCEEDED 0x6D                        // Market Access Risk Limit Exceeded
#define PURGE_REJECT_REASON_RISK_MANAGEMENT_CONFIGURATION_IS_INSUFFICIENT 0x6E            // Risk Management Configuration Is Insufficient
#define PURGE_REJECT_REASON_MAX_OPEN_ORDERS_COUNT_EXCEEDED 0x6F                           // Max Open Orders Count Exceeded
#define PURGE_REJECT_REASON_RISK_MANAGEMENT_PRODUCT_LEVEL 0x73                            // Risk Management Product Level
#define PURGE_REJECT_REASON_ORDER_RECEIVED_BY_CFE_DURING_REPLAY 0x79                      // Order Received By Cfe During Replay
#define PURGE_REJECT_REASON_SESSION_END 0x7A                                              // Session End

// Risk Reset Result: one byte code
#define RISK_RESET_RESULT_IGNORED 0x20                                     // Ignored
#define RISK_RESET_RESULT_SUCCESS 0x59                                     // Success
#define RISK_RESET_RESULT_REJECTED_EXCEEDS_FIRM_RESET_LIMIT 0x46           // Rejected Exceeds Firm Reset Limit
#define RISK_RESET_RESULT_REJECTED_EXCEEDS_CUSTOM_GROUP_ID_LIMIT 0x43      // Rejected Exceeds Custom Group Id Limit
#define RISK_RESET_RESULT_REJECTED_EMPTY_RESET_RISK_FIELD 0x45             // Rejected Empty ResetRisk Field
#define RISK_RESET_RESULT_REJECTED_INCORRECT_DATA_CENTER 0x49              // Rejected Incorrect Data Center
#define RISK_RESET_RESULT_REJECTED_EXCEEDS_PRODUCT_LEVEL_RESET_LIMIT 0x53  // Rejected Exceeds Product Level Reset Limit
#define RISK_RESET_RESULT_REJECTED_INVALID_RISK_ROOT 0x55                  // Rejected Invalid RiskRoot
#define RISK_RESET_RESULT_REJECTED_INVALID_EFID_OR_CLEARING_FIRM 0x63      // Rejected Invalid Efid or ClearingFirm
#define RISK_RESET_RESULT_REJECTED_IN_REPLAY 0x79                          // Rejected In Replay

// ---- Types -------------------------------------------------------------------

// Repeating group stated NumberOfUnits times.
typedef struct _Units {
  UINT8 unit_number;     // byte 0
  UINT32 unit_sequence;  // bytes 1 to 4
} Units;

// UnitSequencesParamGroup
typedef struct _UnitSequencesParamGroup {
  UINT8 no_unspecified_unit_replay;                          // byte 0
  UINT8 number_of_units;                                     // byte 1
  Units units[:byte-size (((UINT32) number_of_units) * 5)];
} UnitSequencesParamGroup;

// Repeating group stated NumberOfReturnBitfields times.
typedef struct _ReturnBitfields {
  UINT8 return_bitfield;  // byte 0
} ReturnBitfields;

// ReturnBitfieldsParamGroup
typedef struct _ReturnBitfieldsParamGroup {
  UINT8 message_type;                                                                        // byte 0
  UINT8 number_of_return_bitfields;                                                          // byte 1
  ReturnBitfields return_bitfields[:byte-size (((UINT32) number_of_return_bitfields) * 1)];
} ReturnBitfieldsParamGroup;

// Raw parameter group bytes, read as the group its ParamGroupType names
casetype _ParamGroupPayload (UINT8 selector) {
  switch (selector) {
    case 0x80: UnitSequencesParamGroup unit_sequences_param_group;
    case 0x81: ReturnBitfieldsParamGroup return_bitfields_param_group;
  }
} ParamGroupPayload;

// Repeating group stated NumberOfParamGroups times.
typedef struct _ParamGroup (mutable UINT32 * tally) {
  UINT16 param_group_length;                                                                                                                                       // bytes 0 to 1
  UINT8 param_group_type;                                                                                                                                          // byte 2
  ParamGroupPayload(param_group_type) param_group_payload;
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} ParamGroup;

// Login Request Message.
typedef struct _LoginRequestMessage (UINT32 available, mutable UINT32 * tally) where (available >= 19) {
  UINT8 session_sub_id[4];                                                                                                               // bytes 0 to 3
  UINT8 username[4];                                                                                                                     // bytes 4 to 7
  UINT8 password[10];                                                                                                                    // bytes 8 to 17
  UINT8 number_of_param_groups;                                                                                                          // byte 18
  unit param_group_tally_start {:on-success *tally = 0; return true; };
  ParamGroup(tally) param_group[:byte-size (available - 19)];
  unit param_group_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_of_param_groups); };
} LoginRequestMessage;

// Login Response Message.
typedef struct _LoginResponseMessage (UINT32 available, mutable UINT32 * tally) where (available >= 68) {
  UINT8 login_response_status;                                                                                                           // byte 0
  UINT8 login_response_text[60];                                                                                                         // bytes 1 to 60
  UINT8 no_unspecified_unit_replay;                                                                                                      // byte 61
  UINT32 last_received_sequence_number;                                                                                                  // bytes 62 to 65
  UINT8 number_of_units { (((UINT32) number_of_units) * 5) <= (available - 68) };                                                        // byte 66
  Units units[:byte-size (((UINT32) number_of_units) * 5)];
  UINT8 number_of_param_groups;
  unit param_group_tally_start {:on-success *tally = 0; return true; };
  ParamGroup(tally) param_group[:byte-size ((available - 68) - (((UINT32) number_of_units) * 5))];
  unit param_group_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_of_param_groups); };
} LoginResponseMessage;

// Logout Message.
typedef struct _LogoutMessage {
  UINT8 logout_reason;                                       // byte 0
  UINT8 logout_reason_text[60];                              // bytes 1 to 60
  UINT32 last_received_sequence_number;                      // bytes 61 to 64
  UINT8 number_of_units;                                     // byte 65
  Units units[:byte-size (((UINT32) number_of_units) * 5)];
} LogoutMessage;

// BitSet NewOrder byte 5.
typedef struct _NewOrderBitfield5 {
  UINT8 new_order_bitfield_5_reserved_1 : 1;         // byte 0
  UINT8 new_order_bitfield_5_attributed_quote : 1;   // byte 0
  UINT8 new_order_bitfield_5_booking_type : 1;       // byte 0
  UINT8 new_order_bitfield_5_ext_exec_inst : 1;      // byte 0
  UINT8 new_order_bitfield_5_client_id : 1;          // byte 0
  UINT8 new_order_bitfield_5_investor_id : 1;        // byte 0
  UINT8 new_order_bitfield_5_executor_id : 1;        // byte 0
  UINT8 new_order_bitfield_5_order_origination : 1;  // byte 0
} NewOrderBitfield5;

// BitSet NewOrder byte 5.
casetype _OptionalNewOrderBitfield5 (Bool present) {
  switch (present) {
    case true: NewOrderBitfield5 new_order_bitfield_5;
    case false: unit absent;
  }
} OptionalNewOrderBitfield5;

