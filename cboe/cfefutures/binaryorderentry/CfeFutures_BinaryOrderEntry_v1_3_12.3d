// Branch
casetype _Message (UINT8 selector, UINT32 length, UINT32 length_2, UINT32 length_3, UINT32 length_4, UINT32 length_5, UINT32 length_6, UINT32 length_7, UINT32 length_8, UINT32 length_9, UINT32 length_10, UINT32 length_11, UINT32 length_12, UINT32 length_13, UINT32 length_14, UINT32 length_15, UINT32 length_16, UINT32 length_17, UINT32 length_18, UINT32 length_19, UINT32 length_20, UINT32 length_21, UINT32 length_22, UINT32 length_23, UINT32 length_24, UINT32 length_25, UINT32 length_26, UINT32 length_27, UINT32 length_28, UINT32 length_29, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x37: LoginRequestMessage(length, tally) login_request_message[:byte-size-single-element-array length];
    case 0x02: unit logout_request_message;
    case 0x03: unit client_heartbeat_message;
    case 0x24: LoginResponseMessage(length_2, tally) login_response_message[:byte-size-single-element-array length_2];
    case 0x08: LogoutMessage logout_message[:byte-size-single-element-array length_3];
    case 0x09: unit server_heartbeat_message;
    case 0x13: unit replay_complete_message;
    case 0x38: NewOrderMessage new_order_message[:byte-size-single-element-array length_4];
    case 0x39: CancelOrderMessage cancel_order_message[:byte-size-single-element-array length_5];
    case 0x3A: ModifyOrderMessage modify_order_message[:byte-size-single-element-array length_6];
    case 0x70: QuoteUpdateMessage quote_update_message[:byte-size-single-element-array length_7];
    case 0x47: PurgeOrdersMessage purge_orders_message[:byte-size-single-element-array length_8];
    case 0x56: ResetRiskMessage reset_risk_message[:byte-size-single-element-array length_9];
    case 0x25: OrderAcknowledgmentMessage order_acknowledgment_message[:byte-size-single-element-array length_10];
    case 0x71: QuoteUpdateAcknowledgmentMessage quote_update_acknowledgment_message[:byte-size-single-element-array length_11];
    case 0x26: OrderRejectedMessage order_rejected_message[:byte-size-single-element-array length_12];
    case 0x78: QuoteUpdateRejectedMessage quote_update_rejected_message[:byte-size-single-element-array length_13];
    case 0x27: OrderModifiedMessage order_modified_message[:byte-size-single-element-array length_14];
    case 0x72: QuoteRestatedMessage quote_restated_message[:byte-size-single-element-array length_15];
