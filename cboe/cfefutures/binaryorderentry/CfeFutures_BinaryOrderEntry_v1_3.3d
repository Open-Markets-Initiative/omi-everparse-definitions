// Risk Reset Result: one byte code
#define RISK_RESET_RESULT_IGNORED 0x20                                     // Ignored
#define RISK_RESET_RESULT_SUCCESS 0x59                                     // Success
#define RISK_RESET_RESULT_REJECTED_EXCEEDS_FIRM_RESET_LIMIT 0x46           // Rejected Exceeds Firm Reset Limit
#define RISK_RESET_RESULT_REJECTED_EXCEEDS_CUSTOM_GROUP_ID_LIMIT 0x43      // Rejected Exceeds Custom Group Id Limit
#define RISK_RESET_RESULT_REJECTED_EMPTY_RESET_RISK_FIELD 0x45             // Rejected Empty ResetRisk Field
#define RISK_RESET_RESULT_REJECTED_INCORRECT_DATA_CENTER 0x49              // Rejected Incorrect Data Center
#define RISK_RESET_RESULT_REJECTED_EXCEEDS_PRODUCT_LEVEL_RESET_LIMIT 0x53  // Rejected Exceeds Product Level Reset Limit
#define RISK_RESET_RESULT_REJECTED_INVALID_RISK_ROOT 0x55                  // Rejected Invalid RiskRoot
#define RISK_RESET_RESULT_REJECTED_INVALID_EFID_OR_CLEARING_FIRM 0x63      // Rejected Invalid Efid or ClearingFirm
#define RISK_RESET_RESULT_REJECTED_IN_REPLAY 0x79                          // Rejected In Replay

// ---- Types -------------------------------------------------------------------

// Parameter group header
typedef struct _ParamGroup {
  UINT16 param_group_length;  // bytes 0 to 1
  UINT8 param_group_type;     // byte 2
} ParamGroup;

// A Login Response message is sent in response to a Login Request message. On a successful login, the LoginResponseStatus will be set to A . On a failed login, LoginResponseStatus will be set to a value other than A , and LoginResponseText will be set to an appropriate failure description.
typedef struct _LoginRequestMessage {
  UINT8 session_sub_id[4];                                                     // bytes 0 to 3
  UINT8 username[4];                                                           // bytes 4 to 7
  UINT8 password[10];                                                          // bytes 8 to 17
  UINT8 number_of_param_groups;                                                // byte 18
  ParamGroup param_group[:byte-size (((UINT32) number_of_param_groups) * 3)];
} LoginRequestMessage;

// Unit Sequence
typedef struct _UnitSequence {
  UINT8 unit_number;       // byte 0
  UINT32 sequence_number;  // bytes 1 to 4
} UnitSequence;

// A Login Response message is sent in response to a Login Request message. On a successful login, the LoginResponseStatus will be set to A . On a failed login, LoginResponseStatus will be set to a value other than A , and LoginResponseText will be set to an appropriate failure description.
typedef struct _LoginResponseMessage {
  UINT8 login_response_status;                                                 // byte 0
  UINT8 login_response_text[60];                                               // bytes 1 to 60
  UINT8 no_unspecified_unit_replay;                                            // byte 61
  UINT32 last_received_sequence_number;                                        // bytes 62 to 65
  UINT8 number_of_units;                                                       // byte 66
  UnitSequence unit_sequence[:byte-size (((UINT32) number_of_units) * 5)];
  UINT8 number_of_param_groups;
  ParamGroup param_group[:byte-size (((UINT32) number_of_param_groups) * 3)];
} LoginResponseMessage;

// A Logout is usually sent in response to a Logout Request. Any queued data is transmitted, a Logout is sent, and Cboe will close the connection.
typedef struct _LogoutMessage {
  UINT8 logout_reason;                                                      // byte 0
  UINT8 logout_reason_text[60];                                             // bytes 1 to 60
  UINT32 last_received_sequence_number;                                     // bytes 61 to 64
  UINT8 number_of_units;                                                    // byte 65
  UnitSequence unit_sequence[:byte-size (((UINT32) number_of_units) * 5)];
} LogoutMessage;

// BitSet NewOrder byte 5.
