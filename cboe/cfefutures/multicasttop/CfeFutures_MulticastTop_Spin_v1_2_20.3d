// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out CfeFutures_MulticastTop_Spin_v1_2_20.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_LOGIN_MESSAGE 0x01                            // Login Message
#define MESSAGE_TYPE_LOGIN_RESPONSE_MESSAGE 0x02                   // Login Response Message
#define MESSAGE_TYPE_SPIN_IMAGE_AVAILABLE_MESSAGE 0x80             // Spin Image Available Message
#define MESSAGE_TYPE_SPIN_REQUEST_MESSAGE 0x81                     // Spin Request Message
#define MESSAGE_TYPE_SPIN_RESPONSE_MESSAGE 0x82                    // Spin Response Message
#define MESSAGE_TYPE_SPIN_FINISHED_MESSAGE 0x83                    // Spin Finished Message
#define MESSAGE_TYPE_TIME_REFERENCE_MESSAGE 0xB1                   // Time Reference Message
#define MESSAGE_TYPE_TIME_MESSAGE 0x20                             // Time Message
#define MESSAGE_TYPE_FUTURES_INSTRUMENT_DEFINITION_MESSAGE 0xBB    // Futures Instrument Definition Message
#define MESSAGE_TYPE_FUTURES_VARIANCE_SYMBOL_MAPPING_MESSAGE 0xFA  // Futures Variance Symbol Mapping Message
#define MESSAGE_TYPE_PRICE_LIMITS_MESSAGE 0xBE                     // Price Limits Message
#define MESSAGE_TYPE_MARKET_SNAPSHOT_SHORT_MESSAGE 0xB2            // Market Snapshot Short Message
#define MESSAGE_TYPE_MARKET_SNAPSHOT_LONG_MESSAGE 0xB3             // Market Snapshot Long Message
#define MESSAGE_TYPE_SETTLEMENT_MESSAGE 0xB9                       // Settlement Message
#define MESSAGE_TYPE_END_OF_DAY_SUMMARY_MESSAGE 0xBA               // End Of Day Summary Message

// Login Response Status: one byte code
#define LOGIN_RESPONSE_STATUS_LOGIN_ACCEPTED 0x41                            // Login Accepted
#define LOGIN_RESPONSE_STATUS_NOT_AUTHORIZED_INVALID_USERNAME_PASSWORD 0x4E  // Not Authorized Invalid Username Password
#define LOGIN_RESPONSE_STATUS_SESSION_IN_USE 0x42                            // Session In Use
#define LOGIN_RESPONSE_STATUS_INVALID_SESSION 0x53                           // Invalid Session

// Spin Response Status: one byte code
#define SPIN_RESPONSE_STATUS_ACCEPTED 0x41                                                                          // Accepted
#define SPIN_RESPONSE_STATUS_OUT_OF_RANGE_SEQUENCE_REQUESTED_IS_GREATER_THAN_SEQUENCE_AVAILABLE_BY_THE_91uwx5 0x4F  // Out Of Range Sequence Requested Is Greater Than Sequence Available By The Next Spin
#define SPIN_RESPONSE_STATUS_SPIN_ALREADY_IN_PROGRESS_ONLY_ONE_SPIN_CAN_BE_RUNNING_AT_A_TIME 0x53                   // Spin Already In Progress Only One Spin Can Be Running At A Time

// Trading Status: one byte code
#define TRADING_STATUS_SUSPENDED 0x53  // Suspended
#define TRADING_STATUS_QUEUING 0x51    // Queuing
#define TRADING_STATUS_TRADING 0x54    // Trading
#define TRADING_STATUS_HALTED 0x48     // Halted

// ---- Types -------------------------------------------------------------------

// The Login message is the first message sent to the Spin Server by a user's process after the connection to the Spin Server is established. Failure to login before sending any other message type will result in the connection being dropped by the Spin Server. The format of the Login message for the Spin Server is identical to that of the GRP.
typedef struct _LoginMessage {
  UINT8 session_sub_id[4];  // bytes 0 to 3
  UINT8 username[4];        // bytes 4 to 7
  UINT8 filler[2];          // bytes 8 to 9
  UINT8 password[10];       // bytes 10 to 19
} LoginMessage;

// The Login Response message is sent by the Spin Server to a user's process in response to a Login message.
typedef struct _LoginResponseMessage {
  UINT8 login_response_status;  // byte 0
} LoginResponseMessage;

// The Spin Image Available message is sent once per second and indicates through what sequence number a spin is available.
typedef struct _SpinImageAvailableMessage {
  UINT32 sequence;  // bytes 0 to 3
} SpinImageAvailableMessage;

// The Spin Request message is used by a user's process to request transmission of a spin of the unit's order book.
typedef struct _SpinRequestMessage {
  UINT32 sequence;  // bytes 0 to 3
} SpinRequestMessage;

// The Spin Response message is sent in response to a participant's Spin Request message indicating whether a spin will be sent.
typedef struct _SpinResponseMessage {
  UINT32 sequence;             // bytes 0 to 3
  UINT32 order_count;          // bytes 4 to 7
  UINT8 spin_response_status;  // byte 8
} SpinResponseMessage;

// The Spin Finished message is sent to indicate that all messages for the spin requested have been sent. A Spin Finished message is only sent if a Spin Request was not rejected. Upon receipt of a Spin Finished message, any buffered multicast messages should be applied to the participant's copy of the book to make it current.
typedef struct _SpinFinishedMessage {
  UINT32 sequence;  // bytes 0 to 3
} SpinFinishedMessage;

// The Time Reference message is used to provide a midnight reference point for recipients of the feed. It is sent whenever the system starts up and when the system crosses a midnight boundary.
typedef struct _TimeReferenceMessage {
  UINT32 midnight_reference;  // bytes 0 to 3
  UINT32 time_reference;      // bytes 4 to 7
  UINT32 time_offset;         // bytes 8 to 11
  UINT32 trade_date;          // bytes 12 to 15
} TimeReferenceMessage;

// A Time message is immediately generated and sent when there is a TOP event for a given clock second.
typedef struct _TimeMessage {
  UINT32 time_reference;  // bytes 0 to 3
  UINT32 epoch_time;      // bytes 4 to 7
} TimeMessage;

// Future Leg
typedef struct _FutureLeg {
  UINT32 leg_ratio;     // bytes 0 to 3, signed, read here as unsigned
  UINT8 leg_symbol[6];  // bytes 4 to 9
} FutureLeg;

// The Futures Instrument Definition message can be sent as a sequenced message or an un-sequenced message. It is sent as a sequenced message when the system starts up at the beginning of a trading session or if an instrument is created or modified during a trading day.
typedef struct _FuturesInstrumentDefinitionMessage {
  UINT32 time_offset;                                            // bytes 0 to 3
  UINT8 symbol[6];                                               // bytes 4 to 9
  UINT32 unit_timestamp;                                         // bytes 10 to 13
  UINT8 report_symbol[6];                                        // bytes 14 to 19
  UINT8 variance : 1;                                            // byte 20
  UINT8 reserved_flags_7 : 7;                                    // byte 20
  UINT32 expiration_date;                                        // bytes 21 to 24
  UINT16 contract_size;                                          // bytes 25 to 26
  UINT8 listing_state;                                           // byte 27
  UINT64 price_increment;                                        // bytes 28 to 35
  UINT8 leg_count;                                               // byte 36
  UINT8 leg_offset;                                              // byte 37
  UINT8 reserved_1;                                              // byte 38
  UINT32 contract_date;                                          // bytes 39 to 42
  FutureLeg future_leg[:byte-size (((UINT32) leg_count) * 10)];
} FuturesInstrumentDefinitionMessage;

// The Futures Variance Symbol Mapping message is used to disseminate symbol reference data for S P 500 Variance Futures (VA Futures) symbols.
typedef struct _FuturesVarianceSymbolMappingMessage {
  UINT32 time_offset;           // bytes 0 to 3
  UINT32 unit_timestamp;        // bytes 4 to 7
  UINT8 feed_symbol[6];         // bytes 8 to 13
  UINT8 futures_symbol[12];     // bytes 14 to 25
  UINT64 accrued_day_variance;  // bytes 26 to 33, signed, read here as unsigned
  UINT16 num_final_returns;     // bytes 34 to 35
  UINT16 num_elapsed_returns;   // bytes 36 to 37
} FuturesVarianceSymbolMappingMessage;

// The Price Limits message can be sent as a sequenced or un-sequenced message. It is sent out at the start of the session for products subject to price limits per the contract specifications.
typedef struct _PriceLimitsMessage {
  UINT32 time_offset;        // bytes 0 to 3
  UINT8 symbol[6];           // bytes 4 to 9
  UINT64 upper_price_limit;  // bytes 10 to 17
  UINT64 lower_price_limit;  // bytes 18 to 25
} PriceLimitsMessage;

// A Market Snapshot message provides a snapshot of the price and size for the bid and ask, last trade price, total number of contracts traded, and the current trading status of a single symbol.
typedef struct _MarketSnapshotShortMessage {
  UINT32 time_offset;             // bytes 0 to 3
  UINT8 symbol[6];                // bytes 4 to 9
  UINT32 unit_timestamp;          // bytes 10 to 13
  UINT16 bid_price_short;         // bytes 14 to 15
  UINT16 bid_quantity_short;      // bytes 16 to 17
  UINT16 ask_price_short;         // bytes 18 to 19
  UINT16 ask_quantity_short;      // bytes 20 to 21
  UINT16 last_trade_price_short;  // bytes 22 to 23
  UINT16 last_trade_size_short;   // bytes 24 to 25
  UINT8 last_trade_condition;     // byte 26
  UINT32 total_volume;            // bytes 27 to 30
  UINT8 trading_status;           // byte 31
  UINT8 reserved_3[3];            // bytes 32 to 34
} MarketSnapshotShortMessage;

// A Market Snapshot message provides a snapshot of the price and size for the bid and ask, last trade price, total number of contracts traded, and the current trading status of a single symbol.
typedef struct _MarketSnapshotLongMessage {
  UINT32 time_offset;            // bytes 0 to 3
  UINT8 symbol[6];               // bytes 4 to 9
  UINT32 unit_timestamp;         // bytes 10 to 13
  UINT64 bid_price_long;         // bytes 14 to 21
  UINT32 bid_quantity_long;      // bytes 22 to 25
  UINT64 ask_price_long;         // bytes 26 to 33
  UINT32 ask_quantity_long;      // bytes 34 to 37
  UINT64 last_trade_price_long;  // bytes 38 to 45
  UINT32 last_trade_size_long;   // bytes 46 to 49
  UINT8 last_trade_condition;    // byte 50
  UINT32 total_volume;           // bytes 51 to 54
  UINT8 trading_status;          // byte 55
  UINT8 reserved_3[3];           // bytes 56 to 58
} MarketSnapshotLongMessage;

// Settlement messages are used to provide information concerning indicative, approved, or corrected daily and final settlement prices for CFE products.
typedef struct _SettlementMessage {
  UINT32 time_offset;       // bytes 0 to 3
  UINT8 symbol[6];          // bytes 4 to 9
  UINT32 trade_date;        // bytes 10 to 13
  UINT64 settlement_price;  // bytes 14 to 21
  UINT8 issue;              // byte 22
} SettlementMessage;

// The End of Day Summary message is sent immediately after trading ends for a symbol. No more Market Update messages will follow an End of Day Summary message for a particular symbol.
typedef struct _EndOfDaySummaryMessage {
  UINT32 time_offset;            // bytes 0 to 3
  UINT8 symbol[6];               // bytes 4 to 9
  UINT32 trade_date;             // bytes 10 to 13
  UINT32 open_interest;          // bytes 14 to 17
  UINT64 high_price;             // bytes 18 to 25
  UINT64 low_price;              // bytes 26 to 33
  UINT64 open_price;             // bytes 34 to 41
  UINT64 close_price;            // bytes 42 to 49
  UINT32 total_volume;           // bytes 50 to 53
  UINT32 block_volume;           // bytes 54 to 57
  UINT32 ecrp_volume;            // bytes 58 to 61
  UINT8 high_price_valid : 1;    // byte 62
  UINT8 high_price_is_bid : 1;   // byte 62
  UINT8 low_price_valid : 1;     // byte 62
  UINT8 low_price_is_offer : 1;  // byte 62
  UINT8 offer_close_valid : 1;   // byte 62
  UINT8 reserved_flags_3 : 3;    // byte 62
} EndOfDaySummaryMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: LoginMessage login_message;
    case 0x02: LoginResponseMessage login_response_message;
    case 0x80: SpinImageAvailableMessage spin_image_available_message;
    case 0x81: SpinRequestMessage spin_request_message;
    case 0x82: SpinResponseMessage spin_response_message;
    case 0x83: SpinFinishedMessage spin_finished_message;
    case 0xB1: TimeReferenceMessage time_reference_message;
    case 0x20: TimeMessage time_message;
    case 0xBB: FuturesInstrumentDefinitionMessage futures_instrument_definition_message;
    case 0xFA: FuturesVarianceSymbolMappingMessage futures_variance_symbol_mapping_message;
    case 0xBE: PriceLimitsMessage price_limits_message;
    case 0xB2: MarketSnapshotShortMessage market_snapshot_short_message;
    case 0xB3: MarketSnapshotLongMessage market_snapshot_long_message;
    case 0xB9: SettlementMessage settlement_message;
    case 0xBA: EndOfDaySummaryMessage end_of_day_summary_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

typedef struct _MessageRun (UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pitch Tcp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                             // bytes 0 to 1
  UINT8 message_count;                                                                                                       // byte 2
  UINT8 unit_;                                                                                                               // byte 3
  UINT32 sequence;                                                                                                           // bytes 4 to 7
  Messages(message_count, message_count, (available - 8), tally) messages[:byte-size-single-element-array (available - 8)];
} Packet;

