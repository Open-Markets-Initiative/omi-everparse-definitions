// ---- Types -------------------------------------------------------------------

// Unit Sequence
typedef struct _UnitSequence {
  UINT8 unit_number;       // byte 0
  UINT32 sequence_number;  // bytes 1 to 4
} UnitSequence;

// A Login Response message is sent in response to a Login Request message
typedef struct _LoginResponseMessage {
  UINT8 login_response_status;                                              // byte 0
  UINT8 login_response_text[60];                                            // bytes 1 to 60
  UINT32 client_sequence;                                                   // bytes 61 to 64
  UINT8 number_of_units;                                                    // byte 65
  UnitSequence unit_sequence[:byte-size (((UINT32) number_of_units) * 5)];
} LoginResponseMessage;

// A Logout Response is usually sent in response to a Logout Request
typedef struct _LogoutResponseMessage {
  UINT8 logout_reason;           // byte 0
  UINT8 logout_reason_text[60];  // bytes 1 to 60
} LogoutResponseMessage;

// Order Acknowledgement messages are sent in response to a New Order message
typedef struct _OrderAcknowledgementJpEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 account[10];               // bytes 8 to 17
  UINT8 trading_firm[4];           // bytes 18 to 21
  UINT8 cl_ord_id[20];             // bytes 22 to 41
  UINT64 order_id;                 // bytes 42 to 49
  UINT32 order_qty;                // bytes 50 to 53
  UINT8 ord_type;                  // byte 54
  UINT64 price;                    // bytes 55 to 62, signed, read here as unsigned
  UINT8 capacity;                  // byte 63
  UINT8 side;                      // byte 64
  UINT8 symbol[8];                 // bytes 65 to 72
  UINT8 time_in_force;             // byte 73
  UINT64 expire_time;              // bytes 74 to 81
  UINT8 cash_margin;               // byte 82
  UINT16 risk_group_id;            // bytes 83 to 84
  UINT8 no_trade_feat;             // byte 85
  UINT8 no_trade_key[10];          // bytes 86 to 95
  UINT8 posting_instruction;       // byte 96
  UINT8 order_classification;      // byte 97
  UINT8 margin_transaction_type;   // byte 98
  UINT8 base_liquidity_indicator;  // byte 99
  UINT8 company_id[4];             // bytes 100 to 103
} OrderAcknowledgementJpEquitiesV1;

// Order Rejected messages are sent in response to a New Order which must be rejected
typedef struct _OrderRejectedJpEquitiesV1 {
  UINT64 transaction_time;    // bytes 0 to 7
  UINT8 trading_firm[4];      // bytes 8 to 11
  UINT8 cl_ord_id[20];        // bytes 12 to 31
  UINT8 order_reject_reason;  // byte 32
  UINT8 text[60];             // bytes 33 to 92
} OrderRejectedJpEquitiesV1;

// Order Modified messages are sent in response to a Modify Order to indicate that the order has been successfully modified
typedef struct _OrderModifiedJpEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 trading_firm[4];           // bytes 8 to 11
  UINT8 cl_ord_id[20];             // bytes 12 to 31
  UINT32 order_qty;                // bytes 32 to 35
  UINT8 orig_cl_ord_id[20];        // bytes 36 to 55
  UINT64 order_id;                 // bytes 56 to 63
  UINT64 price;                    // bytes 64 to 71, signed, read here as unsigned
  UINT32 leaves_qty;               // bytes 72 to 75
  UINT8 base_liquidity_indicator;  // byte 76
  UINT8 company_id[4];             // bytes 77 to 80
} OrderModifiedJpEquitiesV1;

// Modify Rejected messages are sent in response to a Modify Order for an order which cannot be modified
typedef struct _ModifyRejectedJpEquitiesV1 {
  UINT64 transaction_time;     // bytes 0 to 7
  UINT8 trading_firm[4];       // bytes 8 to 11
  UINT8 cl_ord_id[20];         // bytes 12 to 31
  UINT8 orig_cl_ord_id[20];    // bytes 32 to 51
  UINT8 modify_reject_reason;  // byte 52
  UINT8 text[60];              // bytes 53 to 112
} ModifyRejectedJpEquitiesV1;

// If an order is cancelled or reduced due to Self-Trade Protection instructions, the order will be restated with reductions to OrderQty and/or LeavesQty
typedef struct _OrderRestatedJpEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 trading_firm[4];           // bytes 8 to 11
  UINT8 cl_ord_id[20];             // bytes 12 to 31
  UINT64 order_id;                 // bytes 32 to 39
  UINT32 order_qty;                // bytes 40 to 43
  UINT64 price;                    // bytes 44 to 51, signed, read here as unsigned
  UINT32 leaves_qty;               // bytes 52 to 55
  UINT64 secondary_order_id;       // bytes 56 to 63
  UINT64 last_px;                  // bytes 64 to 71, signed, read here as unsigned
  UINT32 last_shares;              // bytes 72 to 75
  UINT8 base_liquidity_indicator;  // byte 76
  UINT8 restatement_reason;        // byte 77
} OrderRestatedJpEquitiesV1;

// An Order Execution is sent for each fill on an order
typedef struct _OrderExecutionJpEquitiesV1 {
  UINT64 transaction_time;         // bytes 0 to 7
  UINT8 trading_firm[4];           // bytes 8 to 11
  UINT8 cl_ord_id[20];             // bytes 12 to 31
  UINT64 exec_id;                  // bytes 32 to 39
  UINT8 last_capacity;             // byte 40
  UINT64 last_px;                  // bytes 41 to 48, signed, read here as unsigned
  UINT32 last_shares;              // bytes 49 to 52
  UINT8 side;                      // byte 53
  UINT8 symbol[8];                 // bytes 54 to 61
  UINT32 leaves_qty;               // bytes 62 to 65
  UINT8 base_liquidity_indicator;  // byte 66
} OrderExecutionJpEquitiesV1;

// Order Cancelled message
typedef struct _OrderCancelledJpEquitiesV1 {
  UINT64 transaction_time;  // bytes 0 to 7
  UINT8 trading_firm[4];    // bytes 8 to 11
  UINT8 cl_ord_id[20];      // bytes 12 to 31
  UINT8 cancel_reason;      // byte 32
} OrderCancelledJpEquitiesV1;

// A Cancel Rejected message is sent in response to a Cancel Order message to indicate that the cancellation cannot occur
typedef struct _CancelRejectedJpEquitiesV1 {
  UINT64 transaction_time;     // bytes 0 to 7
  UINT8 trading_firm[4];       // bytes 8 to 11
  UINT8 cl_ord_id[20];         // bytes 12 to 31
  UINT8 cancel_reject_reason;  // byte 32
  UINT8 text[60];              // bytes 33 to 92
} CancelRejectedJpEquitiesV1;

// A Purge Acknowledgment is an unsequenced message sent when a Purge Orders message requesting an order purge has completed cancelling all individual orders
typedef struct _PurgeAcknowledgementJpEquitiesV1 {
  UINT64 transaction_time;       // bytes 0 to 7
  UINT8 mass_cancel_id[20];      // bytes 8 to 27
  UINT32 cancelled_order_count;  // bytes 28 to 31
} PurgeAcknowledgementJpEquitiesV1;

// A Purge Rejected message is sent in response to a Purge Orders message to indicate that the mass cancellation cannot occur
typedef struct _PurgeRejectedJpEquitiesV1 {
  UINT64 transaction_time;    // bytes 0 to 7
  UINT8 mass_cancel_id[20];   // bytes 8 to 27
  UINT8 purge_reject_reason;  // byte 28
  UINT8 text[60];             // bytes 29 to 88
} PurgeRejectedJpEquitiesV1;

// Branch
casetype _ExchangeMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x01F5: LoginResponseMessage login_response_message;
    case 0x01F6: unit replay_complete;
    case 0x01F7: LogoutResponseMessage logout_response_message;
    case 0x01F8: unit server_heartbeat;
    case 0x157D: OrderAcknowledgementJpEquitiesV1 order_acknowledgement_jp_equities_v_1;
    case 0x157E: OrderRejectedJpEquitiesV1 order_rejected_jp_equities_v_1;
    case 0x157F: OrderModifiedJpEquitiesV1 order_modified_jp_equities_v_1;
    case 0x1580: ModifyRejectedJpEquitiesV1 modify_rejected_jp_equities_v_1;
    case 0x1581: OrderRestatedJpEquitiesV1 order_restated_jp_equities_v_1;
    case 0x1582: OrderExecutionJpEquitiesV1 order_execution_jp_equities_v_1;
    case 0x1583: OrderCancelledJpEquitiesV1 order_cancelled_jp_equities_v_1;
    case 0x1584: CancelRejectedJpEquitiesV1 cancel_rejected_jp_equities_v_1;
    case 0x1586: PurgeAcknowledgementJpEquitiesV1 purge_acknowledgement_jp_equities_v_1;
    case 0x1587: PurgeRejectedJpEquitiesV1 purge_rejected_jp_equities_v_1;
    default: UINT8 unknown[available];
  }
} ExchangeMessage;

// ---- Packet: ExchangePacket --------------------------------------------------

// Binary Order Entry Tcp Packet sent by the exchange
entrypoint typedef struct _ExchangePacket (UINT32 available) where (available >= 12) {
  UINT16 start_of_message;                                                                                                      // bytes 0 to 1
  UINT16 message_length;                                                                                                        // bytes 2 to 3
  UINT16 exchange_message_type;                                                                                                 // bytes 4 to 5
  UINT8 matching_unit;                                                                                                          // byte 6
  UINT8 reserved_field;                                                                                                         // byte 7
  UINT32 sequence_number;                                                                                                       // bytes 8 to 11
  ExchangeMessage(exchange_message_type, (available - 12)) exchange_message[:byte-size-single-element-array (available - 12)];
} ExchangePacket;

