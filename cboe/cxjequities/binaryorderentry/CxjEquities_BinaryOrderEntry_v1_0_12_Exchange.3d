// Exchange Message Type: 2 byte code
#define EXCHANGE_MESSAGE_TYPE_LOGIN_RESPONSE_MESSAGE 0x01F5                 // Login Response Message
#define EXCHANGE_MESSAGE_TYPE_REPLAY_COMPLETE_MESSAGE 0x01F6                // Replay Complete Message
#define EXCHANGE_MESSAGE_TYPE_LOGOUT_RESPONSE_MESSAGE 0x01F7                // Logout Response Message
#define EXCHANGE_MESSAGE_TYPE_SERVER_HEARTBEAT_MESSAGE 0x01F8               // Server Heartbeat Message
#define EXCHANGE_MESSAGE_TYPE_ORDER_ACKNOWLEDGEMENT_JP_EQUITIES_V_1 0x157D  // Order Acknowledgement Jp Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_REJECTED_JP_EQUITIES_V_1 0x157E         // Order Rejected Jp Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_MODIFIED_JP_EQUITIES_V_1 0x157F         // Order Modified Jp Equities V 1
#define EXCHANGE_MESSAGE_TYPE_MODIFY_REJECTED_JP_EQUITIES_V_1 0x1580        // Modify Rejected Jp Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_RESTATED_JP_EQUITIES_V_1 0x1581         // Order Restated Jp Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_EXECUTION_JP_EQUITIES_V_1 0x1582        // Order Execution Jp Equities V 1
#define EXCHANGE_MESSAGE_TYPE_ORDER_CANCELLED_JP_EQUITIES_V_1 0x1583        // Order Cancelled Jp Equities V 1
#define EXCHANGE_MESSAGE_TYPE_CANCEL_REJECTED_JP_EQUITIES_V_1 0x1584        // Cancel Rejected Jp Equities V 1
#define EXCHANGE_MESSAGE_TYPE_PURGE_ACKNOWLEDGEMENT_JP_EQUITIES_V_1 0x1586  // Purge Acknowledgement Jp Equities V 1
#define EXCHANGE_MESSAGE_TYPE_PURGE_REJECTED_JP_EQUITIES_V_1 0x1587         // Purge Rejected Jp Equities V 1

// Login Response Status: one byte code
#define LOGIN_RESPONSE_STATUS_ACCEPTED 0x41         // Accepted
#define LOGIN_RESPONSE_STATUS_SESSION_IN_USE 0x42   // Session In Use
#define LOGIN_RESPONSE_STATUS_DISABLED 0x44         // Disabled
#define LOGIN_RESPONSE_STATUS_INVALID_UNIT 0x49     // Invalid Unit
#define LOGIN_RESPONSE_STATUS_INVALID_MESSAGE 0x4D  // Invalid Message
#define LOGIN_RESPONSE_STATUS_NOT_AUTHORIZED 0x4E   // Not Authorized
#define LOGIN_RESPONSE_STATUS_SEQUENCE_AHEAD 0x51   // Sequence Ahead
#define LOGIN_RESPONSE_STATUS_INVALID_SESSION 0x53  // Invalid Session

// Logout Reason: one byte code
#define LOGOUT_REASON_USER_REQUESTED 0x55      // User Requested
#define LOGOUT_REASON_ADMINISTRATIVE 0x41      // Administrative
#define LOGOUT_REASON_PROTOCOL_VIOLATION 0x21  // Protocol Violation

// Ord Type: one byte code
#define ORD_TYPE_LIMIT 0x32  // Limit

// Capacity: one byte code
#define CAPACITY_AGENCY 0x41     // Agency
#define CAPACITY_PRINCIPAL 0x50  // Principal

// Side: one byte code
#define SIDE_BUY 0x31                // Buy
#define SIDE_SELL 0x32               // Sell
#define SIDE_SELL_SHORT 0x35         // Sell Short
#define SIDE_SELL_SHORT_EXEMPT 0x36  // Sell Short Exempt

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY_DEFAULT 0x30  // Day Default
#define TIME_IN_FORCE_IOC 0x33          // Ioc
#define TIME_IN_FORCE_FOK 0x34          // Fok
#define TIME_IN_FORCE_GTD 0x36          // Gtd

// Cash Margin: one byte code
#define CASH_MARGIN_CASH 0x31          // Cash
#define CASH_MARGIN_MARGIN_OPEN 0x32   // Margin Open
#define CASH_MARGIN_MARGIN_CLOSE 0x33  // Margin Close

// No Trade Feat: one byte code
#define NO_TRADE_FEAT_NO_SELF_TRADE_PROTECTION 0x55                       // No Self Trade Protection
#define NO_TRADE_FEAT_CANCEL_NEWEST 0x4E                                  // Cancel Newest
#define NO_TRADE_FEAT_CANCEL_OLDEST 0x4F                                  // Cancel Oldest
#define NO_TRADE_FEAT_CANCEL_BOTH 0x42                                    // Cancel Both
#define NO_TRADE_FEAT_CANCEL_SMALLEST 0x53                                // Cancel Smallest
#define NO_TRADE_FEAT_DECREMENT_LARGER_CANCEL_SMALLER 0x44                // Decrement Larger Cancel Smaller
#define NO_TRADE_FEAT_SAME_AS_D_ABOVE_BUT_ONLY_DECREMENT_LEAVES_QTY 0x64  // Same As D Above But Only Decrement Leaves Qty

// Posting Instruction: one byte code
#define POSTING_INSTRUCTION_POST_ONLY_NEVER_TAKE_LIQUIDITY 0x50  // Post Only Never Take Liquidity

// Order Classification: one byte code
#define ORDER_CLASSIFICATION_NON_LOW_LATENCY_TRADING_AUTO 0x31    // Non Low Latency Trading Auto
#define ORDER_CLASSIFICATION_NON_LOW_LATENCY_TRADING_MANUAL 0x32  // Non Low Latency Trading Manual
#define ORDER_CLASSIFICATION_MARKET_MAKING_STRATEGY 0x33          // Market Making Strategy
#define ORDER_CLASSIFICATION_ARBITRAGE_STRATEGY 0x34              // Arbitrage Strategy
#define ORDER_CLASSIFICATION_DIRECTIONAL_STRATEGY 0x35            // Directional Strategy
#define ORDER_CLASSIFICATION_OTHER_STRATEGY 0x36                  // Other Strategy

// Margin Transaction Type: one byte code
#define MARGIN_TRANSACTION_TYPE_NEGOTIABLE 0x31    // Negotiable
#define MARGIN_TRANSACTION_TYPE_STANDARDIZED 0x32  // Standardized

// Base Liquidity Indicator: one byte code
#define BASE_LIQUIDITY_INDICATOR_ADDED_LIQUIDITY 0x41    // Added Liquidity
#define BASE_LIQUIDITY_INDICATOR_REMOVED_LIQUIDITY 0x52  // Removed Liquidity

// Order Reject Reason: one byte code
#define ORDER_REJECT_REASON_ADMIN 0x41                                       // Admin
#define ORDER_REJECT_REASON_DUPLICATE_IDENTIFIER_EG_CL_ORD_ID 0x44           // Duplicate Identifier Eg Cl Ord Id
#define ORDER_REJECT_REASON_HALTED 0x48                                      // Halted
#define ORDER_REJECT_REASON_INCORRECT_DATA_CENTER 0x49                       // Incorrect Data Center
#define ORDER_REJECT_REASON_ORDER_RATE_THRESHOLD_EXCEEDED 0x4B               // Order Rate Threshold Exceeded
#define ORDER_REJECT_REASON_RAN_OUT_OF_LIQUIDITY_TO_EXECUTE_AGAINST 0x4E     // Ran Out Of Liquidity To Execute Against
#define ORDER_REJECT_REASON_CL_ORD_ID_DOES_NOT_MATCH_A_KNOWN_ORDER 0x4F      // Cl Ord Id Does Not Match A Known Order
#define ORDER_REJECT_REASON_USER_REQUESTED 0x55                              // User Requested
#define ORDER_REJECT_REASON_ADD_LIQUIDITY_ONLY_ORDER_WOULD_REMOVE 0x57       // Add Liquidity Only Order Would Remove
#define ORDER_REJECT_REASON_ORDER_EXPIRED 0x58                               // Order Expired
#define ORDER_REJECT_REASON_SYMBOL_NOT_SUPPORTED 0x59                        // Symbol Not Supported
#define ORDER_REJECT_REASON_UNFORESEEN_REASON 0x5A                           // Unforeseen Reason
#define ORDER_REJECT_REASON_MAX_OPEN_ORDERS_COUNT_EXCEEDED 0x6F              // Max Open Orders Count Exceeded
#define ORDER_REJECT_REASON_ORDER_RECEIVED_BY_CBOE_JAPAN_DURING_REPLAY 0x79  // Order Received By Cboe Japan During Replay
#define ORDER_REJECT_REASON_SESSION_END 0x7A                                 // Session End

// Modify Reject Reason: one byte code
#define MODIFY_REJECT_REASON_ADMIN 0x41                                       // Admin
#define MODIFY_REJECT_REASON_DUPLICATE_IDENTIFIER_EG_CL_ORD_ID 0x44           // Duplicate Identifier Eg Cl Ord Id
#define MODIFY_REJECT_REASON_HALTED 0x48                                      // Halted
#define MODIFY_REJECT_REASON_INCORRECT_DATA_CENTER 0x49                       // Incorrect Data Center
#define MODIFY_REJECT_REASON_ORDER_RATE_THRESHOLD_EXCEEDED 0x4B               // Order Rate Threshold Exceeded
#define MODIFY_REJECT_REASON_RAN_OUT_OF_LIQUIDITY_TO_EXECUTE_AGAINST 0x4E     // Ran Out Of Liquidity To Execute Against
#define MODIFY_REJECT_REASON_CL_ORD_ID_DOES_NOT_MATCH_A_KNOWN_ORDER 0x4F      // Cl Ord Id Does Not Match A Known Order
#define MODIFY_REJECT_REASON_USER_REQUESTED 0x55                              // User Requested
#define MODIFY_REJECT_REASON_ADD_LIQUIDITY_ONLY_ORDER_WOULD_REMOVE 0x57       // Add Liquidity Only Order Would Remove
#define MODIFY_REJECT_REASON_ORDER_EXPIRED 0x58                               // Order Expired
#define MODIFY_REJECT_REASON_SYMBOL_NOT_SUPPORTED 0x59                        // Symbol Not Supported
#define MODIFY_REJECT_REASON_UNFORESEEN_REASON 0x5A                           // Unforeseen Reason
#define MODIFY_REJECT_REASON_MAX_OPEN_ORDERS_COUNT_EXCEEDED 0x6F              // Max Open Orders Count Exceeded
#define MODIFY_REJECT_REASON_ORDER_RECEIVED_BY_CBOE_JAPAN_DURING_REPLAY 0x79  // Order Received By Cboe Japan During Replay
#define MODIFY_REJECT_REASON_SESSION_END 0x7A                                 // Session End

// Restatement Reason: one byte code
#define RESTATEMENT_REASON_WOULD_HAVE_SELF_TRADED 0x57  // Would Have Self Traded

// Last Capacity: one byte code
#define LAST_CAPACITY_AGENT 0x31               // Agent
#define LAST_CAPACITY_CROSS_AS_AGENT 0x32      // Cross As Agent
#define LAST_CAPACITY_CROSS_AS_PRINCIPAL 0x33  // Cross As Principal
#define LAST_CAPACITY_PRINCIPAL 0x34           // Principal

// Cancel Reason: one byte code
#define CANCEL_REASON_ADMIN 0x41                                       // Admin
#define CANCEL_REASON_DUPLICATE_IDENTIFIER_EG_CL_ORD_ID 0x44           // Duplicate Identifier Eg Cl Ord Id
#define CANCEL_REASON_HALTED 0x48                                      // Halted
#define CANCEL_REASON_INCORRECT_DATA_CENTER 0x49                       // Incorrect Data Center
#define CANCEL_REASON_ORDER_RATE_THRESHOLD_EXCEEDED 0x4B               // Order Rate Threshold Exceeded
#define CANCEL_REASON_RAN_OUT_OF_LIQUIDITY_TO_EXECUTE_AGAINST 0x4E     // Ran Out Of Liquidity To Execute Against
#define CANCEL_REASON_CL_ORD_ID_DOES_NOT_MATCH_A_KNOWN_ORDER 0x4F      // Cl Ord Id Does Not Match A Known Order
#define CANCEL_REASON_USER_REQUESTED 0x55                              // User Requested
#define CANCEL_REASON_ADD_LIQUIDITY_ONLY_ORDER_WOULD_REMOVE 0x57       // Add Liquidity Only Order Would Remove
#define CANCEL_REASON_ORDER_EXPIRED 0x58                               // Order Expired
#define CANCEL_REASON_SYMBOL_NOT_SUPPORTED 0x59                        // Symbol Not Supported
#define CANCEL_REASON_UNFORESEEN_REASON 0x5A                           // Unforeseen Reason
#define CANCEL_REASON_MAX_OPEN_ORDERS_COUNT_EXCEEDED 0x6F              // Max Open Orders Count Exceeded
#define CANCEL_REASON_ORDER_RECEIVED_BY_CBOE_JAPAN_DURING_REPLAY 0x79  // Order Received By Cboe Japan During Replay
#define CANCEL_REASON_SESSION_END 0x7A                                 // Session End

// Cancel Reject Reason: one byte code
#define CANCEL_REJECT_REASON_ADMIN 0x41                                       // Admin
#define CANCEL_REJECT_REASON_DUPLICATE_IDENTIFIER_EG_CL_ORD_ID 0x44           // Duplicate Identifier Eg Cl Ord Id
#define CANCEL_REJECT_REASON_HALTED 0x48                                      // Halted
#define CANCEL_REJECT_REASON_INCORRECT_DATA_CENTER 0x49                       // Incorrect Data Center
#define CANCEL_REJECT_REASON_ORDER_RATE_THRESHOLD_EXCEEDED 0x4B               // Order Rate Threshold Exceeded
#define CANCEL_REJECT_REASON_RAN_OUT_OF_LIQUIDITY_TO_EXECUTE_AGAINST 0x4E     // Ran Out Of Liquidity To Execute Against
#define CANCEL_REJECT_REASON_CL_ORD_ID_DOES_NOT_MATCH_A_KNOWN_ORDER 0x4F      // Cl Ord Id Does Not Match A Known Order
#define CANCEL_REJECT_REASON_USER_REQUESTED 0x55                              // User Requested
#define CANCEL_REJECT_REASON_ADD_LIQUIDITY_ONLY_ORDER_WOULD_REMOVE 0x57       // Add Liquidity Only Order Would Remove
#define CANCEL_REJECT_REASON_ORDER_EXPIRED 0x58                               // Order Expired
#define CANCEL_REJECT_REASON_SYMBOL_NOT_SUPPORTED 0x59                        // Symbol Not Supported
#define CANCEL_REJECT_REASON_UNFORESEEN_REASON 0x5A                           // Unforeseen Reason
#define CANCEL_REJECT_REASON_MAX_OPEN_ORDERS_COUNT_EXCEEDED 0x6F              // Max Open Orders Count Exceeded
#define CANCEL_REJECT_REASON_ORDER_RECEIVED_BY_CBOE_JAPAN_DURING_REPLAY 0x79  // Order Received By Cboe Japan During Replay
#define CANCEL_REJECT_REASON_SESSION_END 0x7A                                 // Session End

// Purge Reject Reason: one byte code
#define PURGE_REJECT_REASON_ADMIN 0x41                                       // Admin
#define PURGE_REJECT_REASON_DUPLICATE_IDENTIFIER_EG_CL_ORD_ID 0x44           // Duplicate Identifier Eg Cl Ord Id
#define PURGE_REJECT_REASON_HALTED 0x48                                      // Halted
#define PURGE_REJECT_REASON_INCORRECT_DATA_CENTER 0x49                       // Incorrect Data Center
#define PURGE_REJECT_REASON_ORDER_RATE_THRESHOLD_EXCEEDED 0x4B               // Order Rate Threshold Exceeded
#define PURGE_REJECT_REASON_RAN_OUT_OF_LIQUIDITY_TO_EXECUTE_AGAINST 0x4E     // Ran Out Of Liquidity To Execute Against
#define PURGE_REJECT_REASON_CL_ORD_ID_DOES_NOT_MATCH_A_KNOWN_ORDER 0x4F      // Cl Ord Id Does Not Match A Known Order
#define PURGE_REJECT_REASON_USER_REQUESTED 0x55                              // User Requested
#define PURGE_REJECT_REASON_ADD_LIQUIDITY_ONLY_ORDER_WOULD_REMOVE 0x57       // Add Liquidity Only Order Would Remove
