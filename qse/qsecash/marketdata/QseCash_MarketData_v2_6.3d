// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out QseCash_MarketData_v2_6.3d

// ---- Values ------------------------------------------------------------------

// Packet Type: 2 byte code
#define PACKET_TYPE_GENERIC_QUOTES 0x03E2                // Generic Quotes
#define PACKET_TYPE_GENERIC_MARKET_INFORMATION 0x03E3    // Generic Market Information
#define PACKET_TYPE_GENERIC_INDICES 0x03E4               // Generic Indices
#define PACKET_TYPE_GENERIC_TRADES 0x03E6                // Generic Trades
#define PACKET_TYPE_GENERIC_ORDERBOOK 0x00E6             // Generic Orderbook
#define PACKET_TYPE_REFRESH_COMBINED_PACKET_TYPE 0x03E7  // Refresh Combined Packet Type

// Delivery Flag: one byte code
#define DELIVERY_FLAG_REAL_TIME_MESSAGE_UNCOMPRESSED 0x00       // Real Time Message Uncompressed
#define DELIVERY_FLAG_RETRANSMISSION_MESSAGE_UNCOMPRESSED 0x02  // Retransmission Message Uncompressed
#define DELIVERY_FLAG_REFRESH_MESSAGE_ZLIB_COMPRESSED 0x11      // Refresh Message Zlib Compressed

// Message Type: 2 byte code
#define MESSAGE_TYPE_STOCK_STATE_CHANGE_MESSAGE 0x01F9                  // Stock State Change Message
#define MESSAGE_TYPE_CLASS_STATE_CHANGE_MESSAGE 0x0204                  // Class State Change Message
#define MESSAGE_TYPE_MAIL_MESSAGE 0x020B                                // Mail Message
#define MESSAGE_TYPE_INDICATIVE_MATCHING_PRICE_MESSAGE 0x0212           // Indicative Matching Price Message
#define MESSAGE_TYPE_COLLARS_MESSAGE 0x0219                             // Collars Message
#define MESSAGE_TYPE_SESSION_TIMETABLE_MESSAGE 0x021B                   // Session Timetable Message
#define MESSAGE_TYPE_GLOBAL_MARKET_ACTIVITY_SUMMARY_MESSAGE 0x0221      // Global Market Activity Summary Message
#define MESSAGE_TYPE_START_REFERENTIAL_MESSAGE 0x0226                   // Start Referential Message
#define MESSAGE_TYPE_END_REFERENTIAL_MESSAGE 0x0227                     // End Referential Message
#define MESSAGE_TYPE_REFERENTIAL_MESSAGE 0x022B                         // Referential Message
#define MESSAGE_TYPE_TRADE_CREATION_MESSAGE 0x00DC                      // Trade Creation Message
#define MESSAGE_TYPE_TRADE_CANCELLATION_MESSAGE 0x00DD                  // Trade Cancellation Message
#define MESSAGE_TYPE_TRADE_FULL_INFORMATION_MESSAGE 0x00F0              // Trade Full Information Message
#define MESSAGE_TYPE_PRICE_UPDATE_MESSAGE 0x00F1                        // Price Update Message
#define MESSAGE_TYPE_AUCTION_SUMMARY_MESSAGE 0x00F5                     // Auction Summary Message
#define MESSAGE_TYPE_VWAP_CLOSING_PRICE_MESSAGE 0x00F7                  // Vwap Closing Price Message
#define MESSAGE_TYPE_QUOTES_MESSAGE 0x008C                              // Quotes Message
#define MESSAGE_TYPE_ORDER_UPDATE_MARKET_SHEET_MESSAGE 0x00E6           // Order Update Market Sheet Message
#define MESSAGE_TYPE_ORDERBOOK_RETRANSMISSION_DELIMITER_MESSAGE 0x00E7  // Orderbook Retransmission Delimiter Message
#define MESSAGE_TYPE_REAL_TIME_INDEX_MESSAGE 0x021E                     // Real Time Index Message
#define MESSAGE_TYPE_INDEX_SUMMARY_MESSAGE 0x021F                       // Index Summary Message
#define MESSAGE_TYPE_INDEX_COMPOSITION_MESSAGE 0x0220                   // Index Composition Message
#define MESSAGE_TYPE_START_REFRESH_MESSAGE 0x0244                       // Start Refresh Message
#define MESSAGE_TYPE_END_REFRESH_MESSAGE 0x0245                         // End Refresh Message

// Order Entry Rejection: one byte code
#define ORDER_ENTRY_REJECTION_NOT_APPLICABLE 0x30         // Not Applicable
#define ORDER_ENTRY_REJECTION_ORDER_ENTRY_ALLOWED 0x4E    // Order Entry Allowed
#define ORDER_ENTRY_REJECTION_ORDER_ENTRY_FORBIDDEN 0x59  // Order Entry Forbidden

// Instrument State: one byte code
#define INSTRUMENT_STATE_NOT_APPLICABLE 0x30  // Not Applicable
#define INSTRUMENT_STATE_AUCTION 0x41         // Auction
#define INSTRUMENT_STATE_HALTED 0x48          // Halted
#define INSTRUMENT_STATE_CLOSED 0x43          // Closed

// Instrument Trading Status: one byte code
#define INSTRUMENT_TRADING_STATUS_SUSPENDED 0x53  // Suspended

// Halt Reason: one byte code
#define HALT_REASON_NOT_APPLICABLE 0x30                       // Not Applicable
#define HALT_REASON_HALTED_NO_LIQUIDITY_PROVIDER 0x52         // Halted No Liquidity Provider
#define HALT_REASON_OPENING_PRICE_OUTSIDE_COLLARS 0x43        // Opening Price Outside Collars
#define HALT_REASON_MANUEL_HALTING_BY_MARKET_OPERATIONS 0x4D  // Manuel Halting By Market Operations

// Action Affecting State: one byte code
#define ACTION_AFFECTING_STATE_NOT_APPLICABLE 0x30                                                // Not Applicable
#define ACTION_AFFECTING_STATE_TRADING_ON_THE_INSTRUMENT_AT_THE_OPENING_SENT_BEFORE_O 0x43        // Trading On The Instrument At The Opening Sent Before O
#define ACTION_AFFECTING_STATE_CANCELLED_PROGRAMMED_OPENING 0x44                                  // Cancelled Programmed Opening
#define ACTION_AFFECTING_STATE_INSTRUMENT_MANUALLY_HALTED_BY_MARKET_OPERATIONS 0x4D               // Instrument Manually Halted By Market Operations
#define ACTION_AFFECTING_STATE_INSTRUMENT_IS_BEING_INITIALIZED_BEGINNING_OF_THE_TRADING_DAY 0x4E  // Instrument Is Being Initialized Beginning Of The Trading Day
#define ACTION_AFFECTING_STATE_INSTRUMENT_OPENED 0x4F                                             // Instrument Opened
#define ACTION_AFFECTING_STATE_DEFERRED_PROGRAMMED_OPENING 0x50                                   // Deferred Programmed Opening
#define ACTION_AFFECTING_STATE_AUTOMATIC_HALTING_AT_THE_CLASS_AUCTION 0x52                        // Automatic Halting At The Class Auction

// Instrument State Tcs: one byte code
#define INSTRUMENT_STATE_TCS_NOT_APPLICABLE 0x30            // Not Applicable
#define INSTRUMENT_STATE_TCS_INSTRUMENT_IS_FORBIDDEN 0x53   // Instrument Is Forbidden
#define INSTRUMENT_STATE_TCS_INSTRUMENT_IS_AUTHORIZED 0x41  // Instrument Is Authorized

// Period Side: one byte code
#define PERIOD_SIDE_NOT_APPLICABLE 0x30     // Not Applicable
#define PERIOD_SIDE_BID_ONLY_PERIOD 0x41    // Bid Only Period
#define PERIOD_SIDE_OFFER_ONLY_PERIOD 0x56  // Offer Only Period

// Instrument Group State: one byte code
#define INSTRUMENT_GROUP_STATE_PRE_OPENING 0x50                    // Pre Opening
#define INSTRUMENT_GROUP_STATE_BEGINNING_OF_DAY_CONSULTATION 0x43  // Beginning Of Day Consultation
#define INSTRUMENT_GROUP_STATE_OPENING 0x4F                        // Opening
#define INSTRUMENT_GROUP_STATE_MARKET_SESSION 0x53                 // Market Session
#define INSTRUMENT_GROUP_STATE_TRADING_AT_LAST 0x52                // Trading At Last
#define INSTRUMENT_GROUP_STATE_SURVEILLANCE_INTERVENTION 0x4E      // Surveillance Intervention
#define INSTRUMENT_GROUP_STATE_END_OF_DAY_INQUIRY 0x46             // End Of Day Inquiry
#define INSTRUMENT_GROUP_STATE_INTERRUPTED 0x5A                    // Interrupted
#define INSTRUMENT_GROUP_STATE_FORBIDDEN 0x49                      // Forbidden

// Session Type: one byte code
#define SESSION_TYPE_EARLY 0x45         // Early
#define SESSION_TYPE_CORE_SESSION 0x43  // Core Session
#define SESSION_TYPE_LATE 0x4C          // Late

// Priority Indicator: one byte code
#define PRIORITY_INDICATOR_URGENT_MESSAGE 0x4F      // Urgent Message
#define PRIORITY_INDICATOR_NON_URGENT_MESSAGE 0x4E  // Non Urgent Message

// Type Of Message: one byte code
#define TYPE_OF_MESSAGE_MARKET_INFORMATION_CONTENTS 0x42       // Market Information Contents
#define TYPE_OF_MESSAGE_TECHNICAL_INFORMATION 0x54             // Technical Information
#define TYPE_OF_MESSAGE_MARKET_AND_TECHNICAL_INFORMATION 0x52  // Market And Technical Information

// Collar Type: one byte code
#define COLLAR_TYPE_DYNAMIC_COLLARS 0x44    // Dynamic Collars
#define COLLAR_TYPE_STATIC_THRESHOLDS 0x53  // Static Thresholds

// Period Indicator: one byte code
#define PERIOD_INDICATOR_MORNING_EFFECTIVE_FOR_THE_CURRENT_DAY 0x4D       // Morning Effective For The Current Day
#define PERIOD_INDICATOR_EVENING_EFFECTIVE_FOR_THE_NEXT_TRADING_DAY 0x45  // Evening Effective For The Next Trading Day

// Instrument Category: one byte code
#define INSTRUMENT_CATEGORY_STOCK 0x41                    // Stock
#define INSTRUMENT_CATEGORY_BOND 0x4F                     // Bond
#define INSTRUMENT_CATEGORY_WARRANT_AND_CERTIFICATE 0x57  // Warrant And Certificate
#define INSTRUMENT_CATEGORY_TRACKER 0x54                  // Tracker
#define INSTRUMENT_CATEGORY_MISCELLANEOUS 0x44            // Miscellaneous

// Type Of Derivatives: one byte code
#define TYPE_OF_DERIVATIVES_INAV_INDICATIVE_NET_ASSET_VALUE_FOR_ETF_EXCHANGE_TRADED 0x31  // Inav Indicative Net Asset Value For Etf Exchange Traded
#define TYPE_OF_DERIVATIVES_SUPPORTS_SHORT_TERMS_OPTIONS 0x34                             // Supports Short Terms Options
#define TYPE_OF_DERIVATIVES_SUPPORTS_LONG_TERM_OPTIONS 0x36                               // Supports Long Term Options
#define TYPE_OF_DERIVATIVES_NO 0x39                                                       // No

// Repo Indicator: one byte code
#define REPO_INDICATOR_INSTRUMENT_NEITHER_ELIGIBLE_FOR_THE_SRD_NOR_ELIGIBLE_FOR_THE_LOAN 0x30    // Instrument Neither Eligible For The Srd Nor Eligible For The Loan
#define REPO_INDICATOR_INSTRUMENT_ELIGIBLE_FOR_THE_SRD_AND_FOR_THE_LOAN_AND_LENDING 0x31         // Instrument Eligible For The Srd And For The Loan And Lending
#define REPO_INDICATOR_INSTRUMENT_ELIGIBLE_FOR_THE_SRD_BUT_NOT_FOR_THE_LOAN_AND_LENDING 0x32     // Instrument Eligible For The Srd But Not For The Loan And Lending
#define REPO_INDICATOR_INSTRUMENT_ELIGIBLE_FOR_THE_LOAN_AND_LENDING_MARKET_BUT_NOT_FOR_THE 0x33  // Instrument Eligible For The Loan And Lending Market But Not For The
#define REPO_INDICATOR_NON_SIGNIFICANT 0x38                                                      // Non Significant

// Type Of Unit Exp: one byte code
#define TYPE_OF_UNIT_EXP_IN_UNITS 0x01                                    // In Units
#define TYPE_OF_UNIT_EXP_AS_A_OF_NOMINAL 0x02                             // As A Of Nominal
#define TYPE_OF_UNIT_EXP_AS_A_OF_NOMINAL_INCLUDING_ACCRUED_INTEREST 0x03  // As A Of Nominal Including Accrued Interest
#define TYPE_OF_UNIT_EXP_IN_KILOGRAMS 0x08                                // In Kilograms
#define TYPE_OF_UNIT_EXP_IN_OUNCES 0x09                                   // In Ounces

// Market Indicator: one byte code
#define MARKET_INDICATOR_NOT_USED 0x00     // Not Used
#define MARKET_INDICATOR_CASH 0x01         // Cash
#define MARKET_INDICATOR_NOT_DEFINED 0x09  // Not Defined

// Tax Code: one byte code
#define TAX_CODE_NOT_ELIGIBLE_TO_PEA 0x00  // Not Eligible To Pea
#define TAX_CODE_ELIGIBLE_TO_PEA 0x03      // Eligible To Pea
#define TAX_CODE_NOT_PROVIDED 0x09         // Not Provided

// Algo: one byte code
#define ALGO_FIFO 0x46         // Fifo
#define ALGO_FIFO_ORIGIN 0x4F  // Fifo Origin

// Small Trade Indicator: one byte code
#define SMALL_TRADE_INDICATOR_NOT_A_SMALL_TRADE 0x31  // Not A Small Trade
#define SMALL_TRADE_INDICATOR_SMALL_TRADE 0x32        // Small Trade

// Trad Cond 2: one byte code
#define TRAD_COND_2_NOT_LAST_OF_A_SERIES_OF_TRADES_AT_THE_SAME_PRICE 0x30  // Not Last Of A Series Of Trades At The Same Price
#define TRAD_COND_2_LAST_OF_A_SERIES_OF_TRADE_AT_THE_SAME_PRICE 0x31       // Last Of A Series Of Trade At The Same Price

// Trad Cond 3: one byte code
#define TRAD_COND_3_TRADE_DOES_NOT_STEM_FROM_A_CROSS_ORDER 0x30  // Trade Does Not Stem From A Cross Order
#define TRAD_COND_3_TRADE_STEMS_FROM_A_CROSS_ORDER 0x31          // Trade Stems From A Cross Order
#define TRAD_COND_3_VALUATION_TRADE 0x34                         // Valuation Trade

// Trade Origin: one byte code
#define TRADE_ORIGIN_ORDERS_FROM_THE_BOOK 0x42  // Orders From The Book
#define TRADE_ORIGIN_BLOCK_TRADE 0x4F           // Block Trade

// Opening Trade Indicator: one byte code
#define OPENING_TRADE_INDICATOR_OPENING 0x4F       // Opening
#define OPENING_TRADE_INDICATOR_CORE_SESSION 0x53  // Core Session

// Tick Direction: one byte code
#define TICK_DIRECTION_POSITIVE 0x2B                                    // Positive
#define TICK_DIRECTION_NEGATIVE 0x2D                                    // Negative
#define TICK_DIRECTION_NO_VARIATION_OR_DATA_FIELD_NOT_SIGNIFICANT 0x30  // No Variation Or Data Field Not Significant

// Type Of Price: 2 byte code
#define TYPE_OF_PRICE_TRADE_CANCELLATION 0x0000                     // Trade Cancellation
#define TYPE_OF_PRICE_ASK_PRICE 0x0002                              // Ask Price
#define TYPE_OF_PRICE_BID_PRICE 0x0003                              // Bid Price
#define TYPE_OF_PRICE_FIRST_TRADED_PRICE_ONE_QUOTATION_ONLY 0x0004  // First Traded Price One Quotation Only
#define TYPE_OF_PRICE_MARKET_IMBALANCE_ASK_PRICE 0x0005             // Market Imbalance Ask Price
#define TYPE_OF_PRICE_MARKET_IMBALANCE_BID_PRICE 0x0006             // Market Imbalance Bid Price
#define TYPE_OF_PRICE_CHANGE_OF_FIRST_PRICE 0x001E                  // Change Of First Price
#define TYPE_OF_PRICE_NEW_HIGH_PRICE 0x001F                         // New High Price
#define TYPE_OF_PRICE_NEW_LOW_PRICE 0x0020                          // New Low Price
#define TYPE_OF_PRICE_NEW_LAST_PRICE 0x0021                         // New Last Price
#define TYPE_OF_PRICE_NEW_PREVIOUS_DAYS_CLOSING_PRICE 0x0022        // New Previous Days Closing Price
#define TYPE_OF_PRICE_WARRANT_OPENING_INDICATIVE_VALUE 0x0029       // Warrant Opening Indicative Value
#define TYPE_OF_PRICE_WARRANT_CLOSING_INDICATIVE_VALUE 0x002A       // Warrant Closing Indicative Value
#define TYPE_OF_PRICE_INDICATIVE_PRICE 0x0033                       // Indicative Price

// Type Of Last Price: 2 byte code
#define TYPE_OF_LAST_PRICE_FIRST_TRADED_PRICE 0x0004                       // First Traded Price
#define TYPE_OF_LAST_PRICE_N_TRADED_PRICE_RESUME_AFTER_RESERVATION 0x0007  // N Traded Price Resume After Reservation

// Instrument Valuation Price: one byte code
#define INSTRUMENT_VALUATION_PRICE_NOT_A_VALUATION_PRICE 0x30  // Not A Valuation Price
#define INSTRUMENT_VALUATION_PRICE_VALUATION_PRICE 0x31        // Valuation Price

// Type Of Ask Price: one byte code
#define TYPE_OF_ASK_PRICE_LIMIT_ORDER 0x00                // Limit Order
#define TYPE_OF_ASK_PRICE_MARKET_ORDER 0x01               // Market Order
#define TYPE_OF_ASK_PRICE_AT_OPENING_ORDER_NSC_ONLY 0x02  // At Opening Order Nsc Only

// Type Of Bid Price: one byte code
#define TYPE_OF_BID_PRICE_LIMIT_ORDER 0x00                // Limit Order
#define TYPE_OF_BID_PRICE_MARKET_ORDER 0x01               // Market Order
#define TYPE_OF_BID_PRICE_AT_OPENING_ORDER_NSC_ONLY 0x02  // At Opening Order Nsc Only

// Quote Condition: one byte code
#define QUOTE_CONDITION_NO_LIQUIDITY_PROVIDER_LP 0x30  // No Liquidity Provider Lp
#define QUOTE_CONDITION_LP_ONLY_ON_ASK_SIDE 0x31       // Lp Only On Ask Side
#define QUOTE_CONDITION_LP_ONLY_ON_BID_SIDE 0x32       // Lp Only On Bid Side
#define QUOTE_CONDITION_LP_ON_ASK_AND_BID_SIDES 0x33   // Lp On Ask And Bid Sides

// Order Type: one byte code
#define ORDER_TYPE_MARKET_ORDER 0x31           // Market Order
#define ORDER_TYPE_LIMIT_ORDER 0x32            // Limit Order
#define ORDER_TYPE_MARKET_TO_LIMIT_ORDER 0x4B  // Market To Limit Order
#define ORDER_TYPE_PEG_ORDER 0x50              // Peg Order

// Action Type: one byte code
#define ACTION_TYPE_NEW_ORDER 0x41                                                          // New Order
#define ACTION_TYPE_DELETION_OF_ORDER_IDENTIFIED_BY_ORDER_ID 0x44                           // Deletion Of Order Identified By Order Id
#define ACTION_TYPE_DELETION_OF_ORDER_IDENTIFIED_BY_ORDER_ID_AND_ALL_PRECEDING_ORDERS 0x50  // Deletion Of Order Identified By Order Id And All Preceding Orders
#define ACTION_TYPE_DELETION_OF_ALL_ORDERS_FOR_THE_GIVEN_INSTRUMENT_DEPENDING_ON_THE 0x46   // Deletion Of All Orders For The Given Instrument Depending On The
#define ACTION_TYPE_RETRANSMISSION_OF_ALL_ORDERS_FOR_THE_GIVEN_INSTRUMENT 0x59              // Retransmission Of All Orders For The Given Instrument

// Rebroadcast Indicator: one byte code
#define REBROADCAST_INDICATOR_CURRENT_DAY 0x30   // Current Day
#define REBROADCAST_INDICATOR_PREVIOUS_DAY 0x31  // Previous Day

// ---- Types -------------------------------------------------------------------

// A Stock State Change message is generated by the trading engines to announce a change in the state of an instrument.
typedef struct _StockStateChangeMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE system_id;               // bytes 12 to 15
  UINT16BE source_time_micro_secs;  // bytes 16 to 17
  UINT8 filler_binary_int_2[2];     // bytes 18 to 19
  UINT8 start_date_halting[8];      // bytes 20 to 27
  UINT8 start_time_halting[6];      // bytes 28 to 33
  UINT8 prog_opening_time[6];       // bytes 34 to 39
  UINT8 order_entry_rejection;      // byte 40
  UINT8 instrument_state;           // byte 41
  UINT8 instrument_trading_status;  // byte 42
  UINT8 halt_reason;                // byte 43
  UINT8 action_affecting_state;     // byte 44
  UINT8 instrument_state_tcs;       // byte 45
  UINT8 period_side;                // byte 46
  UINT8 filler_binary_int_1;        // byte 47
} StockStateChangeMessage;

// A Class State Change message announces a change in the trading market phase of a class or instrument group, which instruments belonging to it inherit.
typedef struct _ClassStateChangeMessage {
  UINT32BE source_seq_num;          // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE system_id;               // bytes 8 to 11
  UINT16BE source_time_micro_secs;  // bytes 12 to 13
  UINT8 instrument_group_code[3];   // bytes 14 to 16
  UINT8 instrument_group_state;     // byte 17
  UINT8 session_type;               // byte 18
  UINT8 filler_binary_int_1;        // byte 19
  UINT8 class_state[4];             // bytes 20 to 23
} ClassStateChangeMessage;

// A Mail message carries a free text notice broadcast to market participants.
typedef struct _MailMessage {
  UINT32BE source_seq_num;          // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE system_id;               // bytes 8 to 11
  UINT16BE source_time_micro_secs;  // bytes 12 to 13
  UINT16BE e_mail_msg_number;       // bytes 14 to 15
  UINT16BE number_of_message;       // bytes 16 to 17
  UINT16BE sequence_number;         // bytes 18 to 19
  UINT8 instrument_group_code[3];   // bytes 20 to 22
  UINT8 filler_ascii_str_1;         // byte 23
  UINT8 priority_indicator;         // byte 24
  UINT8 type_of_message;            // byte 25
  UINT8 address_type[2];            // bytes 26 to 27
  UINT8 title[80];                  // bytes 28 to 107
  UINT8 text[854];                  // bytes 108 to 961
  UINT8 filler_ascii_str_2[2];      // bytes 962 to 963
} MailMessage;

// An Indicative Matching Price message gives the price at which the instrument would open, were the opening to occur at this moment.
typedef struct _IndicativeMatchingPriceMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE im_price;                // bytes 12 to 15
  UINT32BE variation;               // bytes 16 to 19, signed, read here as unsigned
  UINT32BE system_id;               // bytes 20 to 23
  UINT16BE source_time_micro_secs;  // bytes 24 to 25
  UINT8 price_scale_code;           // byte 26
  UINT8 variation_scale_code;       // byte 27
  UINT32BE im_volume;               // bytes 28 to 31
} IndicativeMatchingPriceMessage;

// A Collars message gives the upper and lower price thresholds beyond which an instrument is reserved.
typedef struct _CollarsMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE high_collar;             // bytes 12 to 15
  UINT32BE low_collar;              // bytes 16 to 19
  UINT32BE system_id;               // bytes 20 to 23
  UINT16BE source_time_micro_secs;  // bytes 24 to 25
  UINT8 high_scale_code;            // byte 26
  UINT8 low_scale_code;             // byte 27
  UINT8 collar_type;                // byte 28
  UINT8 filler_ascii_str_3[3];      // bytes 29 to 31
} CollarsMessage;

// A Session Timetable message gives the timetable of the trading session for a group of instruments.
typedef struct _SessionTimetableMessage {
  UINT32BE source_seq_num;          // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE system_id;               // bytes 8 to 11
  UINT16BE source_time_micro_secs;  // bytes 12 to 13
  UINT8 instrument_group_code[3];   // bytes 14 to 16
  UINT8 session_type;               // byte 17
  UINT8 time_pre_opening_1[6];      // bytes 18 to 23
  UINT8 time_opening_1[6];          // bytes 24 to 29
  UINT8 time_closing_1[6];          // bytes 30 to 35
  UINT8 time_pre_opening_2[6];      // bytes 36 to 41
  UINT8 time_opening_2[6];          // bytes 42 to 47
  UINT8 time_closing_2[6];          // bytes 48 to 53
  UINT8 time_pre_opening_3[6];      // bytes 54 to 59
  UINT8 time_opening_3[6];          // bytes 60 to 65
  UINT8 time_closing_3[6];          // bytes 66 to 71
  UINT8 eod_time[6];                // bytes 72 to 77
  UINT8 filler_ascii_str_2[2];      // bytes 78 to 79
} SessionTimetableMessage;

// A Global Market Activity Summary message provides an overall summary of the global market activity. This message is used only at Qatar Exchange.
typedef struct _GlobalMarketActivitySummaryMessage {
  UINT32BE source_seq_num;          // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE system_id;               // bytes 8 to 11
  UINT16BE source_time_micro_secs;  // bytes 12 to 13
  UINT32BE nb_trades;               // bytes 14 to 17
  UINT32BE qty_shares;              // bytes 18 to 21
  UINT32BE amount_traded;           // bytes 22 to 25
  UINT8 price_scale_code;           // byte 26
  UINT8 filler_ascii_str_3[3];      // bytes 27 to 29
} GlobalMarketActivitySummaryMessage;

// A Start Referential message marks the beginning of the broadcast of the reference data.
typedef struct _StartReferentialMessage {
  UINT8 indicator;              // byte 0
  UINT8 filler_ascii_str_3[3];  // bytes 1 to 3
} StartReferentialMessage;

// An End Referential message marks the end of the broadcast of the reference data.
typedef struct _EndReferentialMessage {
  UINT8 indicator;              // byte 0
  UINT8 filler_ascii_str_3[3];  // bytes 1 to 3
} EndReferentialMessage;

// A Referential message carries the characteristics of an instrument, including its standard identifiers, trading parameters and reference prices.
typedef struct _ReferentialMessage {
  UINT32BE symbol_index;                     // bytes 0 to 3
  UINT32BE source_seq_num;                   // bytes 4 to 7
  UINT32BE source_time;                      // bytes 8 to 11
  UINT32BE last_adj_price;                   // bytes 12 to 15
  UINT32BE system_id;                        // bytes 16 to 19
  UINT32BE prev_volume_traded;               // bytes 20 to 23
  UINT32BE fix_price_tick;                   // bytes 24 to 27
  UINT16BE source_time_micro_secs;           // bytes 28 to 29
  UINT16BE stock_exchange_code;              // bytes 30 to 31
  UINT16BE type_of_instrument;               // bytes 32 to 33
  UINT8 event_date[8];                       // bytes 34 to 41
  UINT8 instrument_name[18];                 // bytes 42 to 59
  UINT8 period_indicator;                    // byte 60
  UINT8 type_of_market_admission;            // byte 61
  UINT8 issuing_country_code[3];             // bytes 62 to 64
  UINT8 trading_currency[3];                 // bytes 65 to 67
  UINT8 instrument_group_code[3];            // bytes 68 to 70
  UINT8 instrument_category;                 // byte 71
  UINT8 instrument_code[12];                 // bytes 72 to 83
  UINT8 date_of_last_trade[8];               // bytes 84 to 91
  UINT8 underlying_repo_isin_code[12];       // bytes 92 to 103
  UINT8 repo_expiry_date[8];                 // bytes 104 to 111
  UINT8 first_settlement_date[8];            // bytes 112 to 119
  UINT8 type_of_derivatives;                 // byte 120
  UINT8 bic_depositary[11];                  // bytes 121 to 131
  UINT8 icb[4];                              // bytes 132 to 135
  UINT8 mic[4];                              // bytes 136 to 139
  UINT8 underlying_wisin_code[12];           // bytes 140 to 151
  UINT8 depositary_list[25];                 // bytes 152 to 176
  UINT8 main_depositary[5];                  // bytes 177 to 181
  UINT8 type_of_corporate_event[2];          // bytes 182 to 183
  UINT8 time_lag_euronext_utc[5];            // bytes 184 to 188
  UINT8 time_lag_mi_fid_reg_utc[5];          // bytes 189 to 193
  UINT8 cfi[6];                              // bytes 194 to 199
  UINT8 quantity_notation[4];                // bytes 200 to 203
  UINT8 index_set_of_var_price_tick[2];      // bytes 204 to 205
  UINT8 market_feed_code[2];                 // bytes 206 to 207
  UINT8 mic_list[24];                        // bytes 208 to 231
  UINT8 industry_code[4];                    // bytes 232 to 235
  UINT8 industry_text[100];                  // bytes 236 to 335
  UINT8 financial_market_code[3];            // bytes 336 to 338
  UINT8 us_indicators[7];                    // bytes 339 to 345
  UINT8 filler_ascii_str_2[2];               // bytes 346 to 347
  UINT64BE prev_day_capital_traded;          // bytes 348 to 355
  UINT64BE nom_mkt_price;                    // bytes 356 to 363
  UINT64BE lot_size;                         // bytes 364 to 371
  UINT64BE number_instrument_circ;           // bytes 372 to 379
  UINT64BE shares_out;                       // bytes 380 to 387
  UINT64BE auth_shares;                      // bytes 388 to 395
  UINT16BE heading_number;                   // bytes 396 to 397
  UINT8 section_number;                      // byte 398
  UINT8 repo_indicator;                      // byte 399
  UINT8 last_adj_price_scale_code;           // byte 400
  UINT8 type_of_unit_exp;                    // byte 401
  UINT8 market_indicator;                    // byte 402
  UINT8 prev_day_capital_traded_scale_code;  // byte 403
  UINT8 tax_code;                            // byte 404
  UINT8 nom_mkdt_price_scale_code;           // byte 405
  UINT8 lot_size_scale_code;                 // byte 406
  UINT8 fix_price_tick_scale_code;           // byte 407
  UINT8 mnemo[5];                            // bytes 408 to 412
  UINT8 trading_code[12];                    // bytes 413 to 424
  UINT8 filler_ascii_str_3[3];               // bytes 425 to 427
  UINT32BE strike_price;                     // bytes 428 to 431
  UINT8 strike_currency[3];                  // bytes 432 to 434
  UINT8 strike_scale_code;                   // byte 435
  UINT32BE currency_coef;                    // bytes 436 to 439
  UINT8 currency_coef_scale_code;            // byte 440
  UINT8 trading_currency_indicator;          // byte 441
  UINT8 strike_currency_indicator;           // byte 442
  UINT8 market_segment[2];                   // bytes 443 to 444
  UINT8 algo;                                // byte 445
  UINT8 local_name[30];                      // bytes 446 to 475
  UINT32BE small_trade;                      // bytes 476 to 479
  UINT8 filler_binary_int_12[12];            // bytes 480 to 491
} ReferentialMessage;

// A Trade Creation message announces a trade that has just been created in the trading engine.
typedef struct _TradeCreationMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE trade_id_number;         // bytes 8 to 11
  UINT32BE quote_link_id;           // bytes 12 to 15
  UINT32BE source_seq_num;          // bytes 16 to 19
  UINT32BE price;                   // bytes 20 to 23
  UINT32BE volume;                  // bytes 24 to 27
  UINT32BE system_id;               // bytes 28 to 31
  UINT16BE source_time_micro_secs;  // bytes 32 to 33
  UINT8 small_trade_indicator;      // byte 34
  UINT8 trad_cond_2;                // byte 35
  UINT8 trad_cond_3;                // byte 36
  UINT8 trade_origin;               // byte 37
  UINT8 opening_trade_indicator;    // byte 38
  UINT8 price_scale_code;           // byte 39
} TradeCreationMessage;

// A Trade Cancellation message announces the cancellation of a trade previously published.
typedef struct _TradeCancellationMessage {
  UINT32BE symbol_index;              // bytes 0 to 3
  UINT32BE source_time;               // bytes 4 to 7
  UINT32BE source_seq_num;            // bytes 8 to 11
  UINT32BE original_trade_id_number;  // bytes 12 to 15
  UINT32BE system_id;                 // bytes 16 to 19
  UINT16BE source_time_micro_secs;    // bytes 20 to 21
  UINT8 filler_binary_int_2[2];       // bytes 22 to 23
} TradeCancellationMessage;

// A Trade Full Information message carries a trade along with the cumulated statistics of the instrument for the trading day.
typedef struct _TradeFullInformationMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE trade_id_number;         // bytes 8 to 11
  UINT32BE quote_link_id;           // bytes 12 to 15
  UINT32BE source_seq_num;          // bytes 16 to 19
  UINT32BE price;                   // bytes 20 to 23
  UINT32BE volume;                  // bytes 24 to 27
  UINT32BE cumulative_quantity;     // bytes 28 to 31
  UINT32BE highest_price;           // bytes 32 to 35
  UINT32BE lowest_price;            // bytes 36 to 39
  UINT32BE variation_last_price;    // bytes 40 to 43, signed, read here as unsigned
  UINT32BE system_id;               // bytes 44 to 47
  UINT16BE source_time_micro_secs;  // bytes 48 to 49
  UINT8 filler_binary_int_2[2];     // bytes 50 to 51
  UINT8 small_trade_indicator;      // byte 52
  UINT8 trad_cond_2;                // byte 53
  UINT8 trad_cond_3;                // byte 54
  UINT8 trade_origin;               // byte 55
  UINT8 tick_direction;             // byte 56
  UINT8 opening_trade_indicator;    // byte 57
  UINT8 variation_scale_code;       // byte 58
  UINT8 price_scale_code;           // byte 59
} TradeFullInformationMessage;

// A Price Update message updates the statistics of an instrument without carrying a new trade.
typedef struct _PriceUpdateMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE source_seq_num;          // bytes 8 to 11
  UINT32BE price;                   // bytes 12 to 15
  UINT32BE highest_price;           // bytes 16 to 19
  UINT32BE lowest_price;            // bytes 20 to 23
  UINT32BE variation_last_price;    // bytes 24 to 27, signed, read here as unsigned
  UINT32BE system_id;               // bytes 28 to 31
  UINT16BE source_time_micro_secs;  // bytes 32 to 33
  UINT16BE type_of_price;           // bytes 34 to 35
  UINT8 filler_binary_int_2[2];     // bytes 36 to 37
  UINT8 price_scale_code;           // byte 38
  UINT8 variation_scale_code;       // byte 39
} PriceUpdateMessage;

// An Auction Summary message summarises the trades resulting from an auction.
typedef struct _AuctionSummaryMessage {
  UINT32BE symbol_index;             // bytes 0 to 3
  UINT32BE source_time;              // bytes 4 to 7
  UINT32BE source_seq_num;           // bytes 8 to 11
  UINT32BE first_price;              // bytes 12 to 15
  UINT32BE last_price;               // bytes 16 to 19
  UINT32BE highest_price;            // bytes 20 to 23
  UINT32BE lowest_price;             // bytes 24 to 27
  UINT32BE cumulative_quantity;      // bytes 28 to 31
  UINT32BE variation;                // bytes 32 to 35, signed, read here as unsigned
  UINT32BE system_id;                // bytes 36 to 39
  UINT16BE source_time_micro_secs;   // bytes 40 to 41
  UINT16BE type_of_last_price;       // bytes 42 to 43
  UINT8 tick_direction;              // byte 44
  UINT8 instrument_valuation_price;  // byte 45
  UINT8 price_scale_code;            // byte 46
  UINT8 variation_scale_code;        // byte 47
} AuctionSummaryMessage;

// A VWAP - Closing Price message contains the real time Volume-Weighted Average Price for an instrument together with the current closing price. This message is used exclusively at Qatar Exchange.
typedef struct _VwapClosingPriceMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_time;             // bytes 4 to 7
  UINT32BE source_seq_num;          // bytes 8 to 11
  UINT16BE sending_indicator;       // bytes 12 to 13
  UINT16BE closing_price_rule;      // bytes 14 to 15
  UINT32BE closing_price;           // bytes 16 to 19
  UINT32BE adjusted_closing_price;  // bytes 20 to 23
  UINT32BE nb_trades;               // bytes 24 to 27
  UINT32BE qty_shares;              // bytes 28 to 31
  UINT32BE amount_traded;           // bytes 32 to 35
  UINT32BE system_id;               // bytes 36 to 39
  UINT8 price_scale_code;           // byte 40
  UINT8 filler_ascii_str_3[3];      // bytes 41 to 43
} VwapClosingPriceMessage;

// A Quotes message carries the best limits of the order book for an instrument.
typedef struct _QuotesMessage {
  UINT32BE symbol_index;            // bytes 0 to 3
  UINT32BE source_seq_num;          // bytes 4 to 7
  UINT32BE source_time;             // bytes 8 to 11
  UINT32BE quote_link_id;           // bytes 12 to 15
  UINT32BE ask_price;               // bytes 16 to 19
  UINT32BE ask_size;                // bytes 20 to 23
  UINT32BE bid_price;               // bytes 24 to 27
  UINT32BE bid_size;                // bytes 28 to 31
  UINT32BE system_id;               // bytes 32 to 35
  UINT16BE number_ask_orders;       // bytes 36 to 37
  UINT16BE number_bid_orders;       // bytes 38 to 39
  UINT16BE source_time_micro_secs;  // bytes 40 to 41
  UINT8 type_of_ask_price;          // byte 42
  UINT8 type_of_bid_price;          // byte 43
  UINT8 quote_condition;            // byte 44
  UINT8 quote_number;               // byte 45
  UINT8 price_scale_code;           // byte 46
  UINT8 filler_ascii_str_1;         // byte 47
} QuotesMessage;

// An Order Update message carries a single order of the market sheet, so that the order book of an instrument may be rebuilt and maintained.
typedef struct _OrderUpdateMarketSheetMessage {
  UINT32BE symbol_index;               // bytes 0 to 3
  UINT32BE source_time;                // bytes 4 to 7
  UINT32BE source_seq_num;             // bytes 8 to 11
  UINT32BE price;                      // bytes 12 to 15
  UINT32BE aggregated_volume;          // bytes 16 to 19
  UINT32BE volume;                     // bytes 20 to 23
  UINT32BE link_id;                    // bytes 24 to 27
  UINT32BE order_id;                   // bytes 28 to 31
  UINT32BE system_id;                  // bytes 32 to 35
  UINT16BE source_time_micro_secs;     // bytes 36 to 37
  UINT16BE number_orders;              // bytes 38 to 39
  UINT8 side;                          // byte 40
  UINT8 order_type;                    // byte 41
  UINT8 action_type;                   // byte 42
  UINT8 price_scale_code;              // byte 43
  UINT32BE order_date;                 // bytes 44 to 47
  UINT32BE order_priority_date;        // bytes 48 to 51
  UINT32BE order_priority_time;        // bytes 52 to 55
  UINT16BE order_priority_micro_secs;  // bytes 56 to 57
  UINT8 order_origin;                  // byte 58
  UINT8 filler_binary_int_1;           // byte 59
} OrderUpdateMarketSheetMessage;

// An Orderbook Retransmission Delimiter message delimits the retransmission of a market sheet, so that the order book is cleaned before the orders that follow are applied.
typedef struct _OrderbookRetransmissionDelimiterMessage {
  UINT32BE source_time;            // bytes 0 to 3
  UINT32BE source_seq_num;         // bytes 4 to 7
  UINT8 trading_engine_id[2];      // bytes 8 to 9
  UINT8 instance_id;               // byte 10
  UINT8 retransmission_indicator;  // byte 11
} OrderbookRetransmissionDelimiterMessage;

// A Real Time Index message carries the current level of an index.
typedef struct _RealTimeIndexMessage {
  UINT32BE symbol_index;                        // bytes 0 to 3
  UINT32BE source_time;                         // bytes 4 to 7
  UINT32BE index_level;                         // bytes 8 to 11
  UINT32BE forerunner_level;                    // bytes 12 to 15, signed, read here as unsigned
  UINT32BE session_high;                        // bytes 16 to 19
  UINT32BE session_low;                         // bytes 20 to 23
  UINT32BE percentage_of_capitalization;        // bytes 24 to 27
  UINT32BE variation_from_previous_days_price;  // bytes 28 to 31, signed, read here as unsigned
  UINT32BE system_id;                           // bytes 32 to 35
  UINT16BE source_time_micro_secs;              // bytes 36 to 37
  UINT16BE num_of_securities_quoted;            // bytes 38 to 39
  UINT8 index_level_code;                       // byte 40
  UINT8 type_of_level;                          // byte 41
  UINT8 level_scale_code;                       // byte 42
  UINT8 percentage_scale_code;                  // byte 43
  UINT8 variation_scale_code;                   // byte 44
  UINT8 rebroadcast_indicator;                  // byte 45
  UINT8 filler_ascii_str_2[2];                  // bytes 46 to 47
} RealTimeIndexMessage;

// An Index Summary message gives the summary of an index for the trading day.
typedef struct _IndexSummaryMessage {
  UINT32BE symbol_index;                 // bytes 0 to 3
  UINT32BE source_time;                  // bytes 4 to 7
  UINT32BE preliminary_opening_level;    // bytes 8 to 11
  UINT32BE preliminary_opening_time;     // bytes 12 to 15
  UINT32BE first_level;                  // bytes 16 to 19
  UINT32BE first_time;                   // bytes 20 to 23
  UINT32BE opening_reference_level;      // bytes 24 to 27
  UINT32BE opening_reference_time;       // bytes 28 to 31
  UINT32BE closing_reference_level;      // bytes 32 to 35
  UINT32BE closing_reference_time;       // bytes 36 to 39
  UINT32BE percent_variation_prev_clos;  // bytes 40 to 43, signed, read here as unsigned
  UINT32BE high_level;                   // bytes 44 to 47
  UINT32BE high_time;                    // bytes 48 to 51
  UINT32BE low_level;                    // bytes 52 to 55
  UINT32BE low_time;                     // bytes 56 to 59
  UINT32BE clearing_level;               // bytes 60 to 63
  UINT32BE clearing_time;                // bytes 64 to 67
  UINT32BE liquidation_level;            // bytes 68 to 71
  UINT32BE liquidation_time;             // bytes 72 to 75
  UINT32BE system_id;                    // bytes 76 to 79
  UINT16BE source_time_micro_secs;       // bytes 80 to 81
  UINT8 type_of_level;                   // byte 82
  UINT8 level_scale_code;                // byte 83
  UINT8 variation_scale_code;            // byte 84
  UINT8 filler_ascii_str_3[3];           // bytes 85 to 87
} IndexSummaryMessage;

// An Index Composition message transmits one instrument making up an index, its weight and its adjustment coefficient.
typedef struct _IndexCompositionMessage {
  UINT32BE symbol_index;                 // bytes 0 to 3
  UINT32BE source_time;                  // bytes 4 to 7
  UINT32BE instrument_weight;            // bytes 8 to 11
  UINT32BE instrument_factor;            // bytes 12 to 15
  UINT32BE previous_close;               // bytes 16 to 19
  UINT32BE system_id;                    // bytes 20 to 23
  UINT16BE source_time_micro_secs;       // bytes 24 to 25
  UINT16BE number_of_conponents;         // bytes 26 to 27
  UINT8 instrument_id_of_component[12];  // bytes 28 to 39
  UINT8 mnemo[5];                        // bytes 40 to 44
  UINT8 index_frequency;                 // byte 45
  UINT8 price_scale_code;                // byte 46
  UINT8 level_scale_code;                // byte 47
} IndexCompositionMessage;

// A refresh cycle begins with a Start Refresh message on the multicast channels.
typedef struct _StartRefreshMessage {
  UINT32BE last_seq_num;  // bytes 0 to 3
} StartRefreshMessage;

// A refresh cycle ends with an End Refresh message on the multicast channels.
typedef struct _EndRefreshMessage {
  UINT32BE last_seq_num;  // bytes 0 to 3
} EndRefreshMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x01F9: StockStateChangeMessage stock_state_change_message;
    case 0x0204: ClassStateChangeMessage class_state_change_message;
    case 0x020B: MailMessage mail_message;
    case 0x0212: IndicativeMatchingPriceMessage indicative_matching_price_message;
    case 0x0219: CollarsMessage collars_message;
    case 0x021B: SessionTimetableMessage session_timetable_message;
    case 0x0221: GlobalMarketActivitySummaryMessage global_market_activity_summary_message;
    case 0x0226: StartReferentialMessage start_referential_message;
    case 0x0227: EndReferentialMessage end_referential_message;
    case 0x022B: ReferentialMessage referential_message;
    case 0x00DC: TradeCreationMessage trade_creation_message;
    case 0x00DD: TradeCancellationMessage trade_cancellation_message;
    case 0x00F0: TradeFullInformationMessage trade_full_information_message;
    case 0x00F1: PriceUpdateMessage price_update_message;
    case 0x00F5: AuctionSummaryMessage auction_summary_message;
    case 0x00F7: VwapClosingPriceMessage vwap_closing_price_message;
    case 0x008C: QuotesMessage quotes_message;
    case 0x00E6: OrderUpdateMarketSheetMessage order_update_market_sheet_message;
    case 0x00E7: OrderbookRetransmissionDelimiterMessage orderbook_retransmission_delimiter_message;
    case 0x021E: RealTimeIndexMessage real_time_index_message;
    case 0x021F: IndexSummaryMessage index_summary_message;
    case 0x0220: IndexCompositionMessage index_composition_message;
    case 0x0244: StartRefreshMessage start_refresh_message;
    case 0x0245: EndRefreshMessage end_refresh_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_size { message_size >= 2 };                                                                                                                     // bytes 0 to 1
  UINT16BE message_type;                                                                                                                                           // bytes 2 to 3
  Payload(message_type, ((((UINT32) message_size) + 2) - 4)) payload[:byte-size-single-element-array ((((UINT32) message_size) + 2) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// The packet's message area: the messages it counts, or one ZliB block holding them
typedef struct _MessageBuffer (UINT8 number_msg_entries, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_msg_entries); };
} MessageBuffer;

// ---- Packet: Packet ----------------------------------------------------------

// Qse Xdp Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16BE packet_length;                                                                                                       // bytes 0 to 1
  UINT16BE packet_type;                                                                                                         // bytes 2 to 3
  UINT32BE packet_sequence_number;                                                                                              // bytes 4 to 7
  UINT32BE send_time;                                                                                                           // bytes 8 to 11
  UINT16BE service_id;                                                                                                          // bytes 12 to 13
  UINT8 delivery_flag;                                                                                                          // byte 14
  UINT8 number_msg_entries;                                                                                                     // byte 15
  MessageBuffer(number_msg_entries, (available - 16), tally) message_buffer[:byte-size-single-element-array (available - 16)];
} Packet;

