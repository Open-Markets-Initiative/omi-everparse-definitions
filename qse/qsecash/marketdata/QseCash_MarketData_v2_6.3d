  UINT8 filler_ascii_str_1;         // byte 23
  UINT8 priority_indicator;         // byte 24
  UINT8 type_of_message;            // byte 25
  UINT8 address_type[2];            // bytes 26 to 27
  UINT8 title[80];                  // bytes 28 to 107
  UINT8 text[854];                  // bytes 108 to 961
  UINT8 filler_ascii_str_2[2];      // bytes 962 to 963
} MailMessage;

// ---- Indicative Matching Price Message: 32 bytes -----------------------------

// An Indicative Matching Price message gives the price at which the instrument would open, were the opening to occur at this moment.
entrypoint typedef struct _IndicativeMatchingPriceMessage {
