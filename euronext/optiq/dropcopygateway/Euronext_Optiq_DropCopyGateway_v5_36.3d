// DCMarketStatusChangeMessage
typedef struct _DcMarketStatusChangeMessage {
  UINT32 msg_seq_num;                                // bytes 0 to 3
  UINT64 produce_time;                               // bytes 4 to 11
  UINT64 consume_time;                               // bytes 12 to 19
  UINT8 emm;                                         // byte 20
  UINT64 event_id;                                   // bytes 21 to 28
  UINT8 phase_id;                                    // byte 29
  UINT8 trading_group_state;                         // byte 30
  UINT8 instrument_state;                            // byte 31
  UINT8 change_type;                                 // byte 32
  UINT32 symbol_index;                               // bytes 33 to 36
  UINT64 event_time;                                 // bytes 37 to 44
  UINT8 book_state;                                  // byte 45
  UINT8 status_reason;                               // byte 46
  UINT16 no_qualifier : 1;                           // bytes 47 to 48
  UINT16 call_bbo_only : 1;                          // bytes 47 to 48
  UINT16 trading_at_last : 1;                        // bytes 47 to 48
  UINT16 random_uncrossing : 1;                      // bytes 47 to 48
  UINT16 suspended : 1;                              // bytes 47 to 48
  UINT16 wholesale_allowed : 1;                      // bytes 47 to 48
  UINT16 stressed_market_conditions : 1;             // bytes 47 to 48
  UINT16 exceptional_market_conditions : 1;          // bytes 47 to 48
  UINT16 price_improvement_only : 1;                 // bytes 47 to 48
  UINT16 quoting_period : 1;                         // bytes 47 to 48
  UINT16 execution_prevention_across_all_firms : 1;  // bytes 47 to 48
  UINT16 reserved_12_to_16 : 5;                      // bytes 47 to 48
  UINT8 trading_period;                              // byte 49
  UINT8 trading_side;                                // byte 50
  UINT8 price_limits;                                // byte 51
  UINT8 quote_spread_multiplier;                     // byte 52
  UINT8 order_entry_qualifier;                       // byte 53
  UINT8 session;                                     // byte 54
  UINT8 scheduled_event;                             // byte 55
  UINT64 scheduled_event_time;                       // bytes 56 to 63
  UINT8 trading_group_order_entry_qualifier;         // byte 64
  UINT8 instrument_order_entry_qualifier;            // byte 65
  UINT64 phase_time;                                 // bytes 66 to 73
  UINT32 contract_symbol_index;                      // bytes 74 to 77
  UINT8 price_limit_style;                           // byte 78
} DcMarketStatusChangeMessage;

// DCPriceUpdateMessage
typedef struct _DcPriceUpdateMessage {
  UINT32 msg_seq_num;        // bytes 0 to 3
  UINT64 produce_time;       // bytes 4 to 11
  UINT64 consume_time;       // bytes 12 to 19
  UINT8 emm;                 // byte 20
  UINT64 event_id;           // bytes 21 to 28
  UINT64 event_time;         // bytes 29 to 36
  UINT8 price_type;          // byte 37
  UINT32 symbol_index;       // bytes 38 to 41
  UINT64 price_optional;     // bytes 42 to 49, signed, read here as unsigned
  UINT64 quantity_optional;  // bytes 50 to 57
  UINT64 imbalance_qty;      // bytes 58 to 65
  UINT8 imbalance_qty_side;  // byte 66
} DcPriceUpdateMessage;

// FreeTextSection
typedef struct _LongOrderFreeTextSectionGroup {
  UINT8 free_text[18];  // bytes 0 to 17
} LongOrderFreeTextSectionGroup;

// FreeTextSection Block
typedef struct _LongOrderFreeTextSectionGroups {
  UINT8 block_length_short;                                                  // byte 0
  UINT8 num_in_group;                                                        // byte 1
  UINT8 long_order_free_text_section_group[(((UINT32) num_in_group) * 18)];
} LongOrderFreeTextSectionGroups;

// OptionalFields
typedef struct _LongOrderOptionalFieldsGroup {
  UINT64 stop_px;                      // bytes 0 to 7, signed, read here as unsigned
  UINT8 peg_offset;                    // byte 8, signed, read here as unsigned
  UINT64 undisclosed_price;            // bytes 9 to 16, signed, read here as unsigned
  UINT64 disclosed_qty;                // bytes 17 to 24
  UINT32 order_expiration_time;        // bytes 25 to 28
  UINT16 order_expiration_date;        // bytes 29 to 30
  UINT8 unused_bit_1 : 1;              // byte 31
  UINT8 session_1 : 1;                 // byte 31
  UINT8 session_2 : 1;                 // byte 31
  UINT8 session_3 : 1;                 // byte 31
  UINT8 session_4 : 1;                 // byte 31
  UINT8 reserved_6_to_8 : 3;           // byte 31
  UINT8 stop_triggered_time_in_force;  // byte 32
  UINT8 undisclosed_iceberg_type;      // byte 33
} LongOrderOptionalFieldsGroup;

// OptionalFields Block
typedef struct _LongOrderOptionalFieldsGroups {
  UINT8 block_length_short;                                                                                  // byte 0
  UINT8 num_in_group;                                                                                        // byte 1
  LongOrderOptionalFieldsGroup long_order_optional_fields_group[:byte-size (((UINT32) num_in_group) * 34)];
} LongOrderOptionalFieldsGroups;

