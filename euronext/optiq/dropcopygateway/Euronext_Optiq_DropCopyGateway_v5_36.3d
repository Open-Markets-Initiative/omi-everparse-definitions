  UINT16 frame { frame >= 10 };                                                                                    // bytes 0 to 1
  UINT16 block_length;                                                                                             // bytes 2 to 3
  UINT16 template_id;                                                                                              // bytes 4 to 5
  UINT16 schema_id;                                                                                                // bytes 6 to 7
  UINT16 version;                                                                                                  // bytes 8 to 9
  Payload(template_id, (((UINT32) frame) - 10)) payload[:byte-size-single-element-array (((UINT32) frame) - 10)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Optiq Tcp Packet
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

