// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x3E81: DcMarketStatusChangeMessage dc_market_status_change_message;
    case 0x3E83: DcPriceUpdateMessage dc_price_update_message;
    case 0x3E86: LongOrderMessage long_order_message;
    case 0x3E8A: DcShortOrderRejectMessage dc_short_order_reject_message;
    case 0x3E90: DcShortTradeCancellationMessage dc_short_trade_cancellation_message;
    case 0x3E92: DcStaticCollarsMessage dc_static_collars_message;
    case 0x3E95: TradeBustNotificationMessage trade_bust_notification_message;
    case 0x3EB2: DcQuoteMessage dc_quote_message;
    case 0x3EB3: DcafqrfeMessage dcafqrfe_message;
    case 0x3EB4: DcDeclarationNewMessage dc_declaration_new_message;
    case 0x3EB5: DcShortDeclarationRejectMessage dc_short_declaration_reject_message;
    case 0x3EB6: DcShortDeclarationCancelMessage dc_short_declaration_cancel_message;
    case 0x3EB7: DcShortTradeDeclarationMessage dc_short_trade_declaration_message;
    case 0x3EB8: DcShortTradeDeclarationCancellationMessage dc_short_trade_declaration_cancellation_message;
    case 0x3EB9: DcTradeBustDeclarationMessage dc_trade_bust_declaration_message;
    case 0x3EBA: DcTradeMessage dc_trade_message;
    case 0x3EBB: DcShortDeclarationFillMessage dc_short_declaration_fill_message;
    case 0x3EBC: DcQuoteRequestMessage dc_quote_request_message;
    case 0x3EBD: DcClearBookMessage dc_clear_book_message;
    default: UINT8 unknown[available];
  }
} Payload;

