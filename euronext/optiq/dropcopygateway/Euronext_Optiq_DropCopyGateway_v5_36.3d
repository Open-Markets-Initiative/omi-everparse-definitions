  UINT16 leg_6 : 1;                      // bytes 29 to 30
  UINT16 leg_7 : 1;                      // bytes 29 to 30
  UINT16 leg_8 : 1;                      // bytes 29 to 30
  UINT16 leg_9 : 1;                      // bytes 29 to 30
