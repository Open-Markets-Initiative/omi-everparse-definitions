// StartOfSnapshotMessage
typedef struct _StartOfSnapshotMessage {
  UINT64 last_md_seq_num;  // bytes 0 to 7
  UINT64 snapshot_time;    // bytes 8 to 15
} StartOfSnapshotMessage;

// EndOfSnapshotMessage
typedef struct _EndOfSnapshotMessage {
  UINT64 last_md_seq_num;  // bytes 0 to 7
  UINT64 snapshot_time;    // bytes 8 to 15
} EndOfSnapshotMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x044D: StartOfDayMessage start_of_day_message;
    case 0x044E: EndOfDayMessage end_of_day_message;
    case 0x044F: HealthStatusMessage health_status_message;
    case 0x0452: TechnicalNotificationMessage technical_notification_message;
    case 0x03E9: MarketUpdateMessage market_update_message;
    case 0x03EA: OrderUpdateMessage order_update_message;
    case 0x03EB: PriceUpdateMessage price_update_message;
    case 0x03EC: FullTradeInformationMessage full_trade_information_message;
    case 0x03ED: MarketStatusChangeMessage market_status_change_message;
    case 0x03EE: TimetableMessage timetable_message;
    case 0x03EF: StandingDataMessage standing_data_message;
    case 0x03F0: RealTimeIndexMessage real_time_index_message;
    case 0x03F1: StatisticsMessage statistics_message;
    case 0x03F3: IndexSummaryMessage index_summary_message;
    case 0x03F4: StrategyStandingDataMessage strategy_standing_data_message;
    case 0x03F5: ContractStandingDataMessage contract_standing_data_message;
    case 0x03F6: OutrightStandingDataMessage outright_standing_data_message;
    case 0x03F8: LisPackageStructureMessage lis_package_structure_message;
    case 0x0402: ApaQuotesMessage apa_quotes_message;
    case 0x0403: ApaStandingDataMessage apa_standing_data_message;
    case 0x0404: ApaFullTradeInformationMessage apa_full_trade_information_message;
    case 0x04B1: BfInstrumentReferenceMessage bf_instrument_reference_message;
    case 0x04B2: BfTradeMessage bf_trade_message;
    case 0x04B3: BfnavMessage bfnav_message;
    case 0x04B4: BfInstrumentSuspensionMessage bf_instrument_suspension_message;
    case 0x0835: StartOfSnapshotMessage start_of_snapshot_message;
    case 0x0836: EndOfSnapshotMessage end_of_snapshot_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Optiq Udp Message
typedef struct _OptiqMessage {
  UINT16 frame { frame >= 10 };                                                                                    // bytes 0 to 1
  UINT16 block_length;                                                                                             // bytes 2 to 3
  UINT16 template_id;                                                                                              // bytes 4 to 5
  UINT16 schema_id;                                                                                                // bytes 6 to 7
  UINT16 version;                                                                                                  // bytes 8 to 9
  Payload(template_id, (((UINT32) frame) - 10)) payload[:byte-size-single-element-array (((UINT32) frame) - 10)];
} OptiqMessage;

// ---- Packet: Packet ----------------------------------------------------------

// Optiq Udp Packet
entrypoint typedef struct _Packet (UINT32 available) where (available >= 16) {
  MarketDataPacketHeader market_data_packet_header;         // bytes 0 to 15
  OptiqMessage optiq_message[:byte-size (available - 16)];
} Packet;

