// ---- Types -------------------------------------------------------------------

// Optiq Udp Market Data Packet Header
typedef struct _MarketDataPacketHeader {
  UINT64 packet_time;                    // bytes 0 to 7
  UINT32 packet_sequence_number;         // bytes 8 to 11
  UINT16 compression : 1;                // bytes 12 to 13
  UINT16 mdg_restart_count : 3;          // bytes 12 to 13
  UINT16 psn_high_weight : 3;            // bytes 12 to 13
  UINT16 has_start_of_day_snapshot : 1;  // bytes 12 to 13
  UINT16 has_end_of_day_snapshot : 1;    // bytes 12 to 13
  UINT16 has_status_message : 1;         // bytes 12 to 13
  UINT16 reserved_bits : 6;              // bytes 12 to 13
  UINT16 channel_id;                     // bytes 14 to 15
} MarketDataPacketHeader;

// StartOfDayMessage
typedef struct _StartOfDayMessage {
  UINT64 md_seq_num;           // bytes 0 to 7
  UINT16 session_trading_day;  // bytes 8 to 9
} StartOfDayMessage;

// EndOfDayMessage
typedef struct _EndOfDayMessage {
  UINT64 md_seq_num;           // bytes 0 to 7
  UINT16 session_trading_day;  // bytes 8 to 9
} EndOfDayMessage;

// HealthStatusMessage
typedef struct _HealthStatusMessage {
  UINT64 md_seq_num;  // bytes 0 to 7
  UINT64 event_time;  // bytes 8 to 15
} HealthStatusMessage;

// TechnicalNotificationMessage
typedef struct _TechnicalNotificationMessage {
  UINT64 md_seq_num_optional;         // bytes 0 to 7
  UINT8 technical_notification_type;  // byte 8
  UINT8 rebroadcast_indicator;        // byte 9
  UINT64 retransmission_start_time;   // bytes 10 to 17
  UINT64 retransmission_end_time;     // bytes 18 to 25
  UINT32 symbol_index_optional;       // bytes 26 to 29
} TechnicalNotificationMessage;

// Updates
typedef struct _MarketUpdatesGroup {
  UINT8 update_type;         // byte 0
  UINT32 symbol_index;       // bytes 1 to 4
  UINT16 number_of_orders;   // bytes 5 to 6
  UINT64 price;              // bytes 7 to 14, signed, read here as unsigned
  UINT64 quantity_optional;  // bytes 15 to 22
} MarketUpdatesGroup;

// Updates Block
typedef struct _MarketUpdatesGroups {
  UINT8 block_length_short;                                                            // byte 0
  UINT8 num_in_group;                                                                  // byte 1
  MarketUpdatesGroup market_updates_group[:byte-size (((UINT32) num_in_group) * 23)];
} MarketUpdatesGroups;

// MarketUpdateMessage
typedef struct _MarketUpdateMessage {
  UINT64 md_seq_num;                          // bytes 0 to 7
  UINT8 rebroadcast_indicator;                // byte 8
  UINT8 emm;                                  // byte 9
  UINT64 event_time;                          // bytes 10 to 17
  MarketUpdatesGroups market_updates_groups;
} MarketUpdateMessage;

// Orders
typedef struct _OrderUpdatesGroup {
  UINT32 symbol_index;       // bytes 0 to 3
  UINT8 action_type;         // byte 4
  UINT64 order_priority;     // bytes 5 to 12
  UINT64 previous_priority;  // bytes 13 to 20
  UINT8 order_type;          // byte 21
  UINT64 order_px;           // bytes 22 to 29, signed, read here as unsigned
  UINT8 order_side;          // byte 30
  UINT64 order_quantity;     // bytes 31 to 38
  UINT8 peg_offset;          // byte 39, signed, read here as unsigned
} OrderUpdatesGroup;

// Orders Block
typedef struct _OrderUpdatesGroups {
  UINT8 block_length_short;                                                          // byte 0
  UINT8 num_in_group;                                                                // byte 1
