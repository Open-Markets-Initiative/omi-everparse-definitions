  UINT8 efficient_mmt_modification_indicator;        // byte 266
  UINT8 efficient_mmt_benchmark_indicator;           // byte 267
  UINT8 efficient_mmt_special_dividend_indicator;    // byte 268
  UINT8 efficient_mmt_off_book_automated_indicator;  // byte 269
  UINT8 efficient_mmt_contributionto_price;          // byte 270
  UINT8 efficient_mmt_algorithmic_indicator;         // byte 271
  UINT8 efficient_mmt_publication_mode;              // byte 272
  UINT8 efficient_mmt_post_trade_deferral;           // byte 273
