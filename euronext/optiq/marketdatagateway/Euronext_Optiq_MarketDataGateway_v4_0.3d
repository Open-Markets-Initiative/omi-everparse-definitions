  UINT8 optiq_segment;                                            // byte 13
  UINT8 isin_code_optional[12];                                   // bytes 14 to 25
  UINT8 sedol_code[7];                                            // bytes 26 to 32
  UINT8 long_issuer_name[250];                                    // bytes 33 to 282
  UINT8 long_instrument_name[250];                                // bytes 283 to 532
  UINT8 currency_optional[3];                                     // bytes 533 to 535
  UINT16 date_of_initial_listing;                                 // bytes 536 to 537
  UINT64 share_amount_in_issue;                                   // bytes 538 to 545, signed, read here as unsigned
  UINT8 opened_closed_fund;                                       // byte 546
  UINT64 last_nav_price;                                          // bytes 547 to 554, signed, read here as unsigned
  UINT8 gross_of_cdsc_indicator;                                  // byte 555
  UINT64 coupon;                                                  // bytes 556 to 563, signed, read here as unsigned
  UINT8 maturity_date_optional[8];                                // bytes 564 to 571
  UINT64 closing_price;                                           // bytes 572 to 579, signed, read here as unsigned
  UINT8 mic_optional[4];                                          // bytes 580 to 583
  UINT64 gross_dividend_payable_per_unit;                         // bytes 584 to 591, signed, read here as unsigned
  UINT8 dividend_currency[3];                                     // bytes 592 to 594
  UINT16 dividend_record_date;                                    // bytes 595 to 596
  UINT64 dividend_rate;                                           // bytes 597 to 604
  UINT16 ex_dividend_date;                                        // bytes 605 to 606
  UINT16 dividend_payment_date;                                   // bytes 607 to 608
  UINT8 tax_description_attaching_to_a_dividend;                  // byte 609
  UINT8 next_meeting[8];                                          // bytes 610 to 617
  UINT64 gross_dividend_in_euros;                                 // bytes 618 to 625, signed, read here as unsigned
  UINT16 issue_date;                                              // bytes 626 to 627
  UINT8 issuing_country[3];                                       // bytes 628 to 630
  UINT8 cfi_optional[6];                                          // bytes 631 to 636
  UINT8 payment_frequency;                                        // byte 637
  UINT64 minimum_amount;                                          // bytes 638 to 645, signed, read here as unsigned
  UINT8 instrument_category;                                      // byte 646
  UINT8 security_condition;                                       // byte 647
  UINT8 mifid_price_notation[4];                                  // bytes 648 to 651
  UINT8 price_index_level_decimals;                               // byte 652
  UINT8 quantity_decimals;                                        // byte 653
  UINT8 amount_decimals;                                          // byte 654
  UINT8 ratio_multiplier_decimals;                                // byte 655
  InterestPaymentDateRepGroups interest_payment_date_rep_groups;
} BfInstrumentReferenceMessage;

// BFTradeMessage
typedef struct _BfTradeMessage {
  UINT64 md_seq_num_optional;                 // bytes 0 to 7
  UINT8 rebroadcast_indicator;                // byte 8
  UINT32 symbol_index;                        // bytes 9 to 12
  UINT8 mifid_transaction_id[52];             // bytes 13 to 64
  UINT64 event_time;                          // bytes 65 to 72
  UINT64 bid_offer_date_time;                 // bytes 73 to 80
  UINT8 mmt_modification_indicator[4];        // bytes 81 to 84
  UINT64 price;                               // bytes 85 to 92, signed, read here as unsigned
  UINT64 bid_price;                           // bytes 93 to 100, signed, read here as unsigned
  UINT64 offer_price;                         // bytes 101 to 108, signed, read here as unsigned
  UINT64 quantity;                            // bytes 109 to 116
  UINT8 mmt_agency_cross_trade_indicator[4];  // bytes 117 to 120
  UINT8 mmt_benchmark_indicator[4];           // bytes 121 to 124
  UINT8 mmt_special_dividend_indicator[4];    // bytes 125 to 128
  UINT8 mmt_trading_mode;                     // byte 129
  UINT8 mifid_price_notation[4];              // bytes 130 to 133
  UINT8 quantity_notation[3];                 // bytes 134 to 136
  UINT64 notional_amount_traded;              // bytes 137 to 144, signed, read here as unsigned
  UINT8 trading_currency_optional[3];         // bytes 145 to 147
} BfTradeMessage;

// BFNAVMessage
typedef struct _BfnavMessage {
