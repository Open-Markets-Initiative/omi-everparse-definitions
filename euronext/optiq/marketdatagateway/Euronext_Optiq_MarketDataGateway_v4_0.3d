  InterestPaymentDateRepGroup interest_payment_date_rep_group[:byte-size (((UINT32) num_in_group) * 2)];
} InterestPaymentDateRepGroups;

// BFInstrumentReferenceMessage
typedef struct _BfInstrumentReferenceMessage {
