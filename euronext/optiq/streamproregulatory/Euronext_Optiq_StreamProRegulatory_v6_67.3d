#define TEMPLATE_ID_HEALTH_STATUS_MESSAGE 0x044F                  // Health Status Message
#define TEMPLATE_ID_RTS_1_PRE_TRADE_TRANSPARENCY_MESSAGE 0x0322   // Rts 1 Pre Trade Transparency Message
