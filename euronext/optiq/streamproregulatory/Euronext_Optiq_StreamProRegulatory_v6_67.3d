// ---- Types -------------------------------------------------------------------

// Stream Pro Market Data Packet Header
typedef struct _MarketDataPacketHeader {
  UINT64 packet_time;                    // bytes 0 to 7
  UINT32 packet_sequence_number;         // bytes 8 to 11
  UINT16 compression : 1;                // bytes 12 to 13
  UINT16 mdg_restart_count : 3;          // bytes 12 to 13
  UINT16 psn_high_weight : 3;            // bytes 12 to 13
  UINT16 has_start_of_day_snapshot : 1;  // bytes 12 to 13
  UINT16 has_end_of_day_snapshot : 1;    // bytes 12 to 13
  UINT16 has_status_message : 1;         // bytes 12 to 13
  UINT16 reserved_bits : 6;              // bytes 12 to 13
  UINT16 channel_id;                     // bytes 14 to 15
} MarketDataPacketHeader;

// RTS1PreTradeTransparencyMessage
typedef struct _Rts1PreTradeTransparencyMessage {
  UINT8 update_date_and_time[28];                    // bytes 0 to 27
  UINT8 instrument_identification_code[12];          // bytes 28 to 39
  UINT8 side[4];                                     // bytes 40 to 43
  UINT8 market_maker[20];                            // bytes 44 to 63
  UINT8 price[20];                                   // bytes 64 to 83
  UINT8 price_currency[3];                           // bytes 84 to 86
  UINT8 price_notation[4];                           // bytes 87 to 90
  UINT8 quantity[20];                                // bytes 91 to 110
  UINT8 quantity_currency[3];                        // bytes 111 to 113
  UINT8 aggregated_number_of_orders_and_quotes[18];  // bytes 114 to 131
  UINT8 venue[4];                                    // bytes 132 to 135
  UINT8 trading_system_type[4];                      // bytes 136 to 139
  UINT8 trading_phase[4];                            // bytes 140 to 143
  UINT8 publication_date_and_time[28];               // bytes 144 to 171
} Rts1PreTradeTransparencyMessage;

// RTS1PostTradeTransparencyMessage
typedef struct _Rts1PostTradeTransparencyMessage {
  UINT8 trading_date_and_time[28];                 // bytes 0 to 27
  UINT8 instrument_identification_code[12];        // bytes 28 to 39
  UINT8 price[20];                                 // bytes 40 to 59
  UINT8 missing_price[4];                          // bytes 60 to 63
  UINT8 price_currency[3];                         // bytes 64 to 66
  UINT8 price_notation[4];                         // bytes 67 to 70
  UINT8 quantity[20];                              // bytes 71 to 90
  UINT8 venue_of_execution[4];                     // bytes 91 to 94
  UINT8 third_country_trading_venue_execution[4];  // bytes 95 to 98
  UINT8 trading_system_type[4];                    // bytes 99 to 102
  UINT8 publication_date_and_time[28];             // bytes 103 to 130
  UINT8 venue_of_publication[4];                   // bytes 131 to 134
  UINT8 transaction_identification_code[52];       // bytes 135 to 186
  UINT8 flags[100];                                // bytes 187 to 286
} Rts1PostTradeTransparencyMessage;

// RTS2PostTradeTransparencyMessage
typedef struct _Rts2PostTradeTransparencyMessage {
  UINT8 trading_date_and_time[28];                        // bytes 0 to 27
  UINT8 instrument_identification_code[12];               // bytes 28 to 39
  UINT8 price[20];                                        // bytes 40 to 59
  UINT8 missing_price[4];                                 // bytes 60 to 63
  UINT8 price_currency[3];                                // bytes 64 to 66
  UINT8 price_notation[4];                                // bytes 67 to 70
  UINT8 quantity[20];                                     // bytes 71 to 90
  UINT8 quantity_in_measurement_unit[20];                 // bytes 91 to 110
  UINT8 notation_of_the_quantity_in_measurement_unit[4];  // bytes 111 to 114
  UINT8 notional_amount[20];                              // bytes 115 to 134
  UINT8 notional_currency[3];                             // bytes 135 to 137
  UINT8 venue_of_execution[4];                            // bytes 138 to 141
  UINT8 third_country_trading_venue_execution[4];         // bytes 142 to 145
  UINT8 publication_date_and_time[28];                    // bytes 146 to 173
  UINT8 venue_of_publication[4];                          // bytes 174 to 177
  UINT8 transaction_identification_code[52];              // bytes 178 to 229
  UINT8 transaction_to_be_cleared[5];                     // bytes 230 to 234
  UINT8 flags[100];                                       // bytes 235 to 334
  UINT8 trading_system[4];                                // bytes 335 to 338
  UINT8 number_of_transactions[20];                       // bytes 339 to 358
} Rts2PostTradeTransparencyMessage;

// ChannelsConfigurationMessage
typedef struct _ChannelsConfigurationMessage {
  UINT8 message_name[255];               // bytes 0 to 254
  UINT16 session_trading_day;            // bytes 255 to 256
  UINT8 kafka_topic_name[20];            // bytes 257 to 276
  UINT8 kafka_topic_content_label[255];  // bytes 277 to 531
  UINT8 data_set_family[255];            // bytes 532 to 786
  UINT8 environment;                     // byte 787
  UINT8 partition_number;                // byte 788
  UINT8 optiq_segment;                   // byte 789
  UINT8 subsegment;                      // byte 790
  UINT8 channel_type;                    // byte 791
  UINT8 emitter_type;                    // byte 792
} ChannelsConfigurationMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0322: Rts1PreTradeTransparencyMessage rts_1_pre_trade_transparency_message;
    case 0x0323: Rts1PostTradeTransparencyMessage rts_1_post_trade_transparency_message;
    case 0x0324: Rts2PostTradeTransparencyMessage rts_2_post_trade_transparency_message;
    case 0x0325: ChannelsConfigurationMessage channels_configuration_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Stream Pro Message
typedef struct _OptiqMessage {
  UINT16 frame { frame >= 10 };                                                                                    // bytes 0 to 1
  UINT16 block_length;                                                                                             // bytes 2 to 3
  UINT16 template_id;                                                                                              // bytes 4 to 5
  UINT16 schema_id;                                                                                                // bytes 6 to 7
  UINT16 version;                                                                                                  // bytes 8 to 9
  Payload(template_id, (((UINT32) frame) - 10)) payload[:byte-size-single-element-array (((UINT32) frame) - 10)];
} OptiqMessage;

// ---- Packet: Packet ----------------------------------------------------------

// Stream Pro Kafka Packet
entrypoint typedef struct _Packet (UINT32 available) where (available >= 16) {
  MarketDataPacketHeader market_data_packet_header;         // bytes 0 to 15
  OptiqMessage optiq_message[:byte-size (available - 16)];
} Packet;

