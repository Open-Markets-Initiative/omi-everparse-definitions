// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Euronext_Optiq_MarketDataPacket_v1.3d

// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_HEALTH_STATUS_MESSAGE 0x044F  // Health Status Message

// ---- Types -------------------------------------------------------------------

// Optiq Udp Market Data Packet Header
typedef struct _MarketDataPacketHeader {
  UINT64 packet_time;                    // bytes 0 to 7
  UINT32 packet_sequence_number;         // bytes 8 to 11
  UINT16 compression : 1;                // bytes 12 to 13
  UINT16 mdg_restart_count : 3;          // bytes 12 to 13
  UINT16 psn_high_weight : 3;            // bytes 12 to 13
  UINT16 has_start_of_day_snapshot : 1;  // bytes 12 to 13
  UINT16 has_end_of_day_snapshot : 1;    // bytes 12 to 13
  UINT16 has_status_message : 1;         // bytes 12 to 13
  UINT16 reserved_bits : 6;              // bytes 12 to 13
  UINT16 channel_id;                     // bytes 14 to 15
} MarketDataPacketHeader;

// Optiq Sbe message header message identifiers and length of message root
typedef struct _MessageHeader {
  UINT16 block_length;  // bytes 0 to 1
  UINT16 template_id;   // bytes 2 to 3
  UINT16 schema_id;     // bytes 4 to 5
  UINT16 version;       // bytes 6 to 7
} MessageHeader;

// Optiq Udp Message
typedef struct _OptiqMessage {
  UINT16 frame { frame >= 10 };            // bytes 0 to 1
  MessageHeader message_header;            // bytes 2 to 9
  UINT8 payload[(((UINT32) frame) - 10)];
} OptiqMessage;

// ---- Packet: Packet ----------------------------------------------------------

// Optiq Udp Packet
entrypoint typedef struct _Packet (UINT32 available) where (available >= 16) {
  MarketDataPacketHeader market_data_packet_header;         // bytes 0 to 15
  OptiqMessage optiq_message[:byte-size (available - 16)];
} Packet;

