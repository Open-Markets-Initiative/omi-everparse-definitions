// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0001: NewOrderMessage new_order_message;
    case 0x0003: AckMessage ack_message;
    case 0x0004: FillMessage fill_message;
    case 0x0005: KillMessage kill_message;
    case 0x0006: CancelReplaceMessage cancel_replace_message;
    case 0x0007: RejectMessage reject_message;
    case 0x0008: QuotesMessage quotes_message;
    case 0x0009: QuoteAckMessage quote_ack_message;
    case 0x000A: QuoteRequestMessage quote_request_message;
    case 0x000C: CancelRequestMessage cancel_request_message;
    case 0x000D: MassCancelMessage mass_cancel_message;
    case 0x000E: MassCancelAckMessage mass_cancel_ack_message;
    case 0x000F: OpenOrderRequestMessage open_order_request_message;
    case 0x0011: OwnershipRequestAckMessage ownership_request_ack_message;
    case 0x0012: OwnershipRequestMessage ownership_request_message;
    case 0x0013: TradeBustNotificationMessage trade_bust_notification_message;
    case 0x0014: CollarBreachConfirmationMessage collar_breach_confirmation_message;
    case 0x001C: PriceInputMessage price_input_message;
    case 0x0020: LiquidityProviderCommandMessage liquidity_provider_command_message;
    case 0x0021: AskForQuoteMessage ask_for_quote_message;
    case 0x0022: RequestForExecutionMessage request_for_execution_message;
    case 0x0023: RfqNotificationMessage rfq_notification_message;
    case 0x0024: RfqMatchingStatusMessage rfq_matching_status_message;
    case 0x0025: RfqlpMatchingStatusMessage rfqlp_matching_status_message;
    case 0x0027: UserNotificationMessage user_notification_message;
    case 0x002F: MmSignInMessage mm_sign_in_message;
    case 0x0030: MmSignInAckMessage mm_sign_in_ack_message;
    case 0x0032: InstrumentSynchronizationListMessage instrument_synchronization_list_message;
    case 0x0033: SynchronizationTimeMessage synchronization_time_message;
    case 0x003C: SecurityDefinitionRequestMessage security_definition_request_message;
    case 0x003D: SecurityDefinitionAckMessage security_definition_ack_message;
    case 0x003E: MmProtectionRequestMessage mm_protection_request_message;
    case 0x003F: MmProtectionAckMessage mm_protection_ack_message;
    case 0x0040: NewWholesaleOrderMessage new_wholesale_order_message;
    case 0x0041: WholesaleOrderAckMessage wholesale_order_ack_message;
    case 0x0042: RequestForImpliedExecutionMessage request_for_implied_execution_message;
    case 0x0043: CrossOrderMessage cross_order_message;
    case 0x0064: LogonMessage logon_message;
    case 0x0065: LogonAckMessage logon_ack_message;
    case 0x0066: LogonRejectMessage logon_reject_message;
    case 0x0067: LogoutMessage logout_message;
    case 0x006A: unit heartbeat_message;
    case 0x006B: unit test_request_message;
    case 0x006C: TechnicalRejectMessage technical_reject_message;
    case 0x0028: DeclarationEntryMessage declaration_entry_message;
    case 0x0029: DeclarationEntryAckMessage declaration_entry_ack_message;
    case 0x002A: DeclarationNoticeMessage declaration_notice_message;
    case 0x002B: DeclarationCancelAndRefusalMessage declaration_cancel_and_refusal_message;
    case 0x002C: FundPriceInputMessage fund_price_input_message;
    case 0x002D: FundPriceInputAckMessage fund_price_input_ack_message;
    case 0x002E: DeclarationEntryRejectMessage declaration_entry_reject_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Optiq Tcp Message
typedef struct _Message {
  UINT16 frame { frame >= 10 };                                                                                    // bytes 0 to 1
  UINT16 block_length;                                                                                             // bytes 2 to 3
  UINT16 template_id;                                                                                              // bytes 4 to 5
  UINT16 schema_id;                                                                                                // bytes 6 to 7
  UINT16 version;                                                                                                  // bytes 8 to 9
  Payload(template_id, (((UINT32) frame) - 10)) payload[:byte-size-single-element-array (((UINT32) frame) - 10)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Optiq Tcp Packet
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

