// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PseEquities_BasicWithLastSale_v2_3.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_TIME_STAMP_SECONDS_MESSAGE 0x54        // Time Stamp Seconds Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53              // System Event Message
#define MESSAGE_TYPE_TRADING_SCHEDULE_MESSAGE 0x73          // Trading Schedule Message
#define MESSAGE_TYPE_PRICE_TICK_SIZE_MESSAGE 0x4C           // Price Tick Size Message
#define MESSAGE_TYPE_QUANTITY_TICK_SIZE_MESSAGE 0x4D        // Quantity Tick Size Message
#define MESSAGE_TYPE_ORDERBOOK_DIRECTORY_MESSAGE 0x52       // Orderbook Directory Message
#define MESSAGE_TYPE_ORDERBOOK_RESTRICTIONS_MESSAGE 0x6B    // Orderbook Restrictions Message
#define MESSAGE_TYPE_ORDERBOOK_TRADING_ACTION_MESSAGE 0x48  // Orderbook Trading Action Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x50                     // Trade Message
#define MESSAGE_TYPE_TRADE_WITH_BROKER_ID_MESSAGE 0x70      // Trade With Broker Id Message
#define MESSAGE_TYPE_BBO_QUOTATION_MESSAGE 0x4F             // Bbo Quotation Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F                 // Start Of Messages
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53             // Start Of System Hours
#define EVENT_CODE_PRE_OPEN_NO_CANCELLATION_PERIOD 0x52   // Pre Open No Cancellation Period
#define EVENT_CODE_START_OF_MARKET_HOURS 0x51             // Start Of Market Hours
#define EVENT_CODE_SCHEDULED_BREAK_BEGINS 0x41            // Scheduled Break Begins
#define EVENT_CODE_SCHEDULED_BREAK_ENDS 0x42              // Scheduled Break Ends
#define EVENT_CODE_PRE_CLOSE_COMMENCES 0x4C               // Pre Close Commences
#define EVENT_CODE_PRE_CLOSE_NO_CANCELLATION_PERIOD 0x4A  // Pre Close No Cancellation Period
#define EVENT_CODE_TRADING_AT_LAST 0x50                   // Trading At Last
#define EVENT_CODE_END_OF_MARKET_HOURS 0x4D               // End Of Market Hours
#define EVENT_CODE_END_OF_TRADING 0x45                    // End Of Trading
#define EVENT_CODE_END_OF_SYSTEM_MESSAGES 0x43            // End Of System Messages

// Price Type: one byte code
#define PRICE_TYPE_PER_UNIT 0x55    // Per Unit
#define PRICE_TYPE_PERCENTAGE 0x50  // Percentage

// Instrument Type: one byte code
#define INSTRUMENT_TYPE_COMMON_STOCK 0x43     // Common Stock
#define INSTRUMENT_TYPE_PREFERRED_STOCK 0x50  // Preferred Stock
#define INSTRUMENT_TYPE_WARRANT 0x57          // Warrant
#define INSTRUMENT_TYPE_ETF 0x45              // Etf
#define INSTRUMENT_TYPE_PDR 0x44              // Pdr
#define INSTRUMENT_TYPE_INDEX 0x49            // Index

// Short Sell Eligible: one byte code
#define SHORT_SELL_ELIGIBLE_YES 0x59  // Yes
#define SHORT_SELL_ELIGIBLE_NO 0x4E   // No

// Cb Limit Decimals: 4 byte code
#define CB_LIMIT_DECIMALS_ZERO_DECIMALS 0x00000000   // Zero Decimals
#define CB_LIMIT_DECIMALS_ONE_DECIMALS 0x00000001    // One Decimals
#define CB_LIMIT_DECIMALS_TWO_DECIMALS 0x00000002    // Two Decimals
#define CB_LIMIT_DECIMALS_THREE_DECIMALS 0x00000003  // Three Decimals
#define CB_LIMIT_DECIMALS_FOUR_DECIMALS 0x00000004   // Four Decimals
#define CB_LIMIT_DECIMALS_FIVE_DECIMALS 0x00000005   // Five Decimals
#define CB_LIMIT_DECIMALS_SIX_DECIMALS 0x00000006    // Six Decimals
#define CB_LIMIT_DECIMALS_SEVEN_DECIMALS 0x00000007  // Seven Decimals
#define CB_LIMIT_DECIMALS_EIGHT_DECIMALS 0x00000008  // Eight Decimals
#define CB_LIMIT_DECIMALS_NINE_DECIMALS 0x00000009   // Nine Decimals

// Trading State: one byte code
#define TRADING_STATE_TRADING 0x54    // Trading
#define TRADING_STATE_SUSPENDED 0x56  // Suspended

// Reason: one byte code
#define REASON_NORMAL_TRADING 0x4E                 // Normal Trading
#define REASON_SUSPENDED_BY_MARKET_CONTROL 0x53    // Suspended By Market Control
#define REASON_FROZEN_DUE_TO_CIRCUIT_BREAKER 0x46  // Frozen Due To Circuit Breaker
#define REASON_HALTED 0x48                         // Halted

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// Trade Indicator: one byte code
#define TRADE_INDICATOR_REGULAR_TRADE 0x20            // Regular Trade
#define TRADE_INDICATOR_INTENTIONAL_CROSS_TRADE 0x43  // Intentional Cross Trade
#define TRADE_INDICATOR_BLOCK_SALE 0x42               // Block Sale
#define TRADE_INDICATOR_MANUAL_TRADE 0x4D             // Manual Trade

// ---- Types -------------------------------------------------------------------

// Time Stamp - Seconds Message.
typedef struct _TimeStampSecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} TimeStampSecondsMessage;

// System Event Message.
typedef struct _SystemEventMessage {
  UINT32BE timestamp;  // bytes 0 to 3
  UINT8 group[8];      // bytes 4 to 11
  UINT8 event_code;    // byte 12
  UINT32BE orderbook;  // bytes 13 to 16
} SystemEventMessage;

// Trading Schedule Message.
typedef struct _TradingScheduleMessage {
  UINT32BE timestamp;       // bytes 0 to 3
  UINT8 group[8];           // bytes 4 to 11
  UINT8 event_code;         // byte 12
  UINT32BE orderbook;       // bytes 13 to 16
  UINT32BE scheduled_time;  // bytes 17 to 20
} TradingScheduleMessage;

// Tick Size Table.
typedef struct _PriceTickSizeMessage {
  UINT32BE timestamp;           // bytes 0 to 3
  UINT32BE tick_size_table_id;  // bytes 4 to 7
  UINT32BE price_tick_size;     // bytes 8 to 11
  UINT32BE price_start;         // bytes 12 to 15
} PriceTickSizeMessage;

// Tick Size Table.
typedef struct _QuantityTickSizeMessage {
  UINT32BE timestamp;           // bytes 0 to 3
  UINT32BE tick_size_table_id;  // bytes 4 to 7
  UINT64BE quantity_tick_size;  // bytes 8 to 15
  UINT64BE quantity_start;      // bytes 16 to 23
} QuantityTickSizeMessage;

// Orderbook Directory Message.
typedef struct _OrderbookDirectoryMessage {
  UINT32BE timestamp;                    // bytes 0 to 3
  UINT32BE orderbook;                    // bytes 4 to 7
  UINT8 price_type;                      // byte 8
  UINT8 isin[12];                        // bytes 9 to 20
  UINT8 sec_code[12];                    // bytes 21 to 32
  UINT8 currency[3];                     // bytes 33 to 35
  UINT8 group[8];                        // bytes 36 to 43
  UINT64BE lot_size;                     // bytes 44 to 51
  UINT32BE quantity_tick_size_table_id;  // bytes 52 to 55
  UINT32BE price_tick_size_table_id;     // bytes 56 to 59
  UINT32BE price_decimals;               // bytes 60 to 63
  UINT32BE delisting_date;               // bytes 64 to 67
  UINT32BE delisting_time;               // bytes 68 to 71
  UINT8 instrument_type;                 // byte 72
  UINT64BE shares;                       // bytes 73 to 80
  UINT8 product_code[8];                 // bytes 81 to 88
} OrderbookDirectoryMessage;

// Orderbook Restrictions Message.
typedef struct _OrderbookRestrictionsMessage {
  UINT32BE timestamp;          // bytes 0 to 3
  UINT32BE orderbook;          // bytes 4 to 7
  UINT8 short_sell_eligible;   // byte 8
  UINT32BE high_collar;        // bytes 9 to 12
  UINT32BE low_collar;         // bytes 13 to 16
  UINT32BE cb_limit_up;        // bytes 17 to 20
  UINT32BE cb_limit_down;      // bytes 21 to 24
  UINT32BE cb_limit_decimals;  // bytes 25 to 28
} OrderbookRestrictionsMessage;

// Stock Trading Action Message.
typedef struct _OrderbookTradingActionMessage {
  UINT32BE timestamp;   // bytes 0 to 3
  UINT32BE orderbook;   // bytes 4 to 7
  UINT8 trading_state;  // byte 8
  UINT8 reason;         // byte 9
} OrderbookTradingActionMessage;

// Trade Message.
typedef struct _TradeMessage {
  UINT32BE timestamp;          // bytes 0 to 3
  UINT64BE executed_quantity;  // bytes 4 to 11
  UINT32BE orderbook;          // bytes 12 to 15
  UINT8 printable;             // byte 16
  UINT32BE execution_price;    // bytes 17 to 20
  UINT64BE match_number;       // bytes 21 to 28
  UINT8 trade_indicator;       // byte 29
} TradeMessage;

// Trade (with Broker ID) Message.
typedef struct _TradeWithBrokerIdMessage {
  UINT32BE timestamp;          // bytes 0 to 3
  UINT64BE executed_quantity;  // bytes 4 to 11
  UINT32BE orderbook;          // bytes 12 to 15
  UINT8 printable;             // byte 16
  UINT32BE execution_price;    // bytes 17 to 20
  UINT64BE match_number;       // bytes 21 to 28
  UINT8 trade_indicator;       // byte 29
  UINT8 buy_broker_id[4];      // bytes 30 to 33
  UINT8 sell_broker_id[4];     // bytes 34 to 37
} TradeWithBrokerIdMessage;

// BBO Quotation Message.
typedef struct _BboQuotationMessage {
  UINT32BE timestamp;         // bytes 0 to 3
  UINT32BE orderbook;         // bytes 4 to 7
  UINT32BE best_bid_price;    // bytes 8 to 11
  UINT64BE best_bid_size;     // bytes 12 to 19
  UINT32BE best_offer_price;  // bytes 20 to 23
  UINT64BE best_offer_size;   // bytes 24 to 31
} BboQuotationMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: TimeStampSecondsMessage time_stamp_seconds_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x73: TradingScheduleMessage trading_schedule_message;
    case 0x4C: PriceTickSizeMessage price_tick_size_message;
    case 0x4D: QuantityTickSizeMessage quantity_tick_size_message;
    case 0x52: OrderbookDirectoryMessage orderbook_directory_message;
    case 0x6B: OrderbookRestrictionsMessage orderbook_restrictions_message;
    case 0x48: OrderbookTradingActionMessage orderbook_trading_action_message;
    case 0x50: TradeMessage trade_message;
    case 0x70: TradeWithBrokerIdMessage trade_with_broker_id_message;
    case 0x4F: BboQuotationMessage bbo_quotation_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

