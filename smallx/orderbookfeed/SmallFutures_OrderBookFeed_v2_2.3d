// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out SmallFutures_OrderBookFeed_v2_2.3d

// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_INSTRUMENT_TRADING_STATUS_INCREMENTAL_MESSAGE 0x0003         // Instrument Trading Status Incremental Message
#define TEMPLATE_ID_TRADES_INCREMENTAL_MESSAGE 0x0004                            // Trades Incremental Message
#define TEMPLATE_ID_TRADE_CORRECT_MESSAGE 0x0005                                 // Trade Correct Message
#define TEMPLATE_ID_TRADE_BUST_MESSAGE 0x0006                                    // Trade Bust Message
#define TEMPLATE_ID_ORDER_BOOK_INCREMENTAL_MESSAGE 0x0007                        // Order Book Incremental Message
#define TEMPLATE_ID_MARKET_SUMMARY_INCREMENTAL_MESSAGE 0x0008                    // Market Summary Incremental Message
#define TEMPLATE_ID_ORDER_BOOK_SNAPSHOT_MESSAGE 0x000B                           // Order Book Snapshot Message
#define TEMPLATE_ID_MARKET_SUMMARY_SNAPSHOT_MESSAGE 0x000C                       // Market Summary Snapshot Message
#define TEMPLATE_ID_INDEX_VALUE_SNAPSHOT_MESSAGE 0x000D                          // Index Value Snapshot Message
#define TEMPLATE_ID_SINGLE_INSTRUMENT_DEFINITION_INCREMENTAL_V_2_MESSAGE 0x000E  // Single Instrument Definition Incremental V 2 Message
#define TEMPLATE_ID_MULTILEG_DEFINITION_INCREMENTAL_V_2_MESSAGE 0x000F           // Multileg Definition Incremental V 2 Message
#define TEMPLATE_ID_SINGLE_INSTRUMENT_DEFINITION_SNAPSHOT_V_2_MESSAGE 0x0010     // Single Instrument Definition Snapshot V 2 Message
#define TEMPLATE_ID_MULTILEG_DEFINITION_SNAPSHOT_V_2_MESSAGE 0x0011              // Multileg Definition Snapshot V 2 Message

// Instrument Trading Status: one byte code
#define INSTRUMENT_TRADING_STATUS_CLOSED 0x43       // Closed
#define INSTRUMENT_TRADING_STATUS_PRE_OPEN 0x50     // Pre Open
#define INSTRUMENT_TRADING_STATUS_PRE_OPEN_NC 0x4E  // Pre Open Nc
#define INSTRUMENT_TRADING_STATUS_OPEN 0x4F         // Open
#define INSTRUMENT_TRADING_STATUS_PAUSED 0x55       // Paused
#define INSTRUMENT_TRADING_STATUS_HALTED 0x48       // Halted

// Aggressor Side: one byte code
#define AGGRESSOR_SIDE_NO_AGGRESSOR 0x4E  // No Aggressor
#define AGGRESSOR_SIDE_BUY 0x42           // Buy
#define AGGRESSOR_SIDE_SELL 0x53          // Sell

// Trade Update Action: one byte code
#define TRADE_UPDATE_ACTION_NEW 0x4E     // New
#define TRADE_UPDATE_ACTION_DELETE 0x44  // Delete

// Order Update Action: one byte code
#define ORDER_UPDATE_ACTION_NEW 0x4E     // New
#define ORDER_UPDATE_ACTION_UPDATE 0x55  // Update
#define ORDER_UPDATE_ACTION_DELETE 0x44  // Delete

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Open Price Type: one byte code
#define OPEN_PRICE_TYPE_INDICATIVE 0x49  // Indicative
#define OPEN_PRICE_TYPE_TRADED 0x54      // Traded
#define OPEN_PRICE_TYPE_NO_PRICE 0x4E    // No Price

// Settlement Price Type: one byte code
#define SETTLEMENT_PRICE_TYPE_FINAL 0x46        // Final
#define SETTLEMENT_PRICE_TYPE_PRELIMINARY 0x50  // Preliminary
#define SETTLEMENT_PRICE_TYPE_NO_PRICE 0x4E     // No Price

// Instrument Update Action: one byte code
#define INSTRUMENT_UPDATE_ACTION_ADD 0x41     // Add
#define INSTRUMENT_UPDATE_ACTION_DELETE 0x44  // Delete
#define INSTRUMENT_UPDATE_ACTION_MODIFY 0x4D  // Modify

// Instrument Type: one byte code
#define INSTRUMENT_TYPE_FUTURES 0x46  // Futures
#define INSTRUMENT_TYPE_OPTION 0x4F   // Option
#define INSTRUMENT_TYPE_MLEG 0x4D     // Mleg

// Put Or Call: one byte code
#define PUT_OR_CALL_PUT 0x50         // Put
#define PUT_OR_CALL_CALL 0x43        // Call
#define PUT_OR_CALL_NOT_OPTION 0x4E  // Not Option

// Expiration Style: one byte code
#define EXPIRATION_STYLE_STANDARD 0x53  // Standard
#define EXPIRATION_STYLE_DAILY 0x44     // Daily
#define EXPIRATION_STYLE_WEEKLY 0x57    // Weekly
#define EXPIRATION_STYLE_QUATERLY 0x51  // Quaterly

// Exercise Style: one byte code
#define EXERCISE_STYLE_EUROPEAN 0x45    // European
#define EXERCISE_STYLE_AMERICAN 0x41    // American
#define EXERCISE_STYLE_NOT_OPTION 0x4E  // Not Option

// Delivery: one byte code
#define DELIVERY_CASH 0x43      // Cash
#define DELIVERY_PHYSICAL 0x50  // Physical

// Strategy Type: one byte code
#define STRATEGY_TYPE_CUSTOM 0x00                   // Custom
#define STRATEGY_TYPE_FUTURES_CALENDAR 0x01         // Futures Calendar
#define STRATEGY_TYPE_FUTURES_INTER_COMMODITY 0x02  // Futures Inter Commodity
#define STRATEGY_TYPE_COVERED 0x03                  // Covered
#define STRATEGY_TYPE_OPTION_BUTTERFLY 0x04         // Option Butterfly
#define STRATEGY_TYPE_OPTION_VERTICAL 0x05          // Option Vertical
#define STRATEGY_TYPE_OPTION_STRANGLE 0x06          // Option Strangle
#define STRATEGY_TYPE_OPTION_STRADDLE 0x07          // Option Straddle
#define STRATEGY_TYPE_OPTION_DIAGONAL 0x08          // Option Diagonal
#define STRATEGY_TYPE_OPTION_CALENDAR 0x09          // Option Calendar
#define STRATEGY_TYPE_OPTION_IRON_CONDOR 0x0A       // Option Iron Condor
#define STRATEGY_TYPE_PROTECTIVE_PUT 0x0B           // Protective Put

// Leg Side: one byte code
#define LEG_SIDE_BUY 0x42   // Buy
#define LEG_SIDE_SELL 0x53  // Sell

// ---- Types -------------------------------------------------------------------

// Sent on updated instrument trading session status individually for every instrument
typedef struct _InstrumentTradingStatusIncrementalMessage {
  UINT32 instrument_id;             // bytes 0 to 3, signed, read here as unsigned
  UINT64 instrument_message_no;     // bytes 4 to 11, signed, read here as unsigned
  UINT64 transact_time;             // bytes 12 to 19, signed, read here as unsigned
  UINT16 trading_session_date;      // bytes 20 to 21
  UINT8 instrument_trading_status;  // byte 22
  UINT16 transaction_begin : 1;     // bytes 23 to 24
  UINT16 transaction_end : 1;       // bytes 23 to 24
  UINT16 instrument_begin : 1;      // bytes 23 to 24
  UINT16 instrument_end : 1;        // bytes 23 to 24
  UINT16 book_begin : 1;            // bytes 23 to 24
  UINT16 book_end : 1;              // bytes 23 to 24
  UINT16 book_reset : 1;            // bytes 23 to 24
  UINT16 reserved_8_to_16 : 9;      // bytes 23 to 24
} InstrumentTradingStatusIncrementalMessage;

// NoTrades
typedef struct _IncrementalTradeGroup {
  UINT64 trade_id;               // bytes 0 to 7, signed, read here as unsigned
  UINT64 price;                  // bytes 8 to 15, signed, read here as unsigned
  UINT64 size;                   // bytes 16 to 23, signed, read here as unsigned
  UINT8 aggressor_side;          // byte 24
  UINT64 buy_order_id;           // bytes 25 to 32, signed, read here as unsigned
  UINT64 sell_order_id;          // bytes 33 to 40, signed, read here as unsigned
  UINT16 synthetic : 1;          // bytes 41 to 42
  UINT16 auction : 1;            // bytes 41 to 42
  UINT16 reserved_3_to_16 : 14;  // bytes 41 to 42
} IncrementalTradeGroup;

// Trades repeating group
typedef struct _IncrementalTradeGroups {
  UINT16 block_length;                                                                       // bytes 0 to 1
  UINT8 num_in_group;                                                                        // byte 2
  IncrementalTradeGroup incremental_trade_group[:byte-size (((UINT32) num_in_group) * 43)];
} IncrementalTradeGroups;

// Represents a set of trades for a single instrument resulting from a business event processing
typedef struct _TradesIncrementalMessage {
  UINT32 instrument_id;                             // bytes 0 to 3, signed, read here as unsigned
  UINT64 instrument_message_no;                     // bytes 4 to 11, signed, read here as unsigned
  UINT64 transact_time;                             // bytes 12 to 19, signed, read here as unsigned
  UINT16 trading_session_date;                      // bytes 20 to 21
  UINT8 instrument_trading_status;                  // byte 22
  UINT16 transaction_begin : 1;                     // bytes 23 to 24
  UINT16 transaction_end : 1;                       // bytes 23 to 24
  UINT16 instrument_begin : 1;                      // bytes 23 to 24
  UINT16 instrument_end : 1;                        // bytes 23 to 24
  UINT16 book_begin : 1;                            // bytes 23 to 24
  UINT16 book_end : 1;                              // bytes 23 to 24
  UINT16 book_reset : 1;                            // bytes 23 to 24
  UINT16 reserved_8_to_16 : 9;                      // bytes 23 to 24
  UINT64 last_trade_price;                          // bytes 25 to 32, signed, read here as unsigned
  UINT64 last_trade_size;                           // bytes 33 to 40, signed, read here as unsigned
  UINT64 last_trade_time_optional;                  // bytes 41 to 48, signed, read here as unsigned
  UINT64 total_volume;                              // bytes 49 to 56, signed, read here as unsigned
  IncrementalTradeGroups incremental_trade_groups;
} TradesIncrementalMessage;

// NoTrades
typedef struct _TradeCorrectGroup {
  UINT8 trade_update_action;     // byte 0
  UINT64 trade_id;               // bytes 1 to 8, signed, read here as unsigned
  UINT64 time;                   // bytes 9 to 16, signed, read here as unsigned
  UINT64 price;                  // bytes 17 to 24, signed, read here as unsigned
  UINT64 size;                   // bytes 25 to 32, signed, read here as unsigned
  UINT8 aggressor_side;          // byte 33
  UINT64 buy_order_id;           // bytes 34 to 41, signed, read here as unsigned
  UINT64 sell_order_id;          // bytes 42 to 49, signed, read here as unsigned
  UINT16 synthetic : 1;          // bytes 50 to 51
  UINT16 auction : 1;            // bytes 50 to 51
  UINT16 reserved_3_to_16 : 14;  // bytes 50 to 51
} TradeCorrectGroup;

// Trades update repeating group
typedef struct _TradeCorrectGroups {
  UINT16 block_length;                                                               // bytes 0 to 1
  UINT8 num_in_group;                                                                // byte 2
  TradeCorrectGroup trade_correct_group[:byte-size (((UINT32) num_in_group) * 52)];
} TradeCorrectGroups;

// Represents trade correct message for an instrument. In the repeating group there are always 2 trade update records: data for a busted/deleted trade and data for a new correcting trade
typedef struct _TradeCorrectMessage {
  UINT32 instrument_id;                     // bytes 0 to 3, signed, read here as unsigned
  UINT64 instrument_message_no;             // bytes 4 to 11, signed, read here as unsigned
  UINT64 transact_time;                     // bytes 12 to 19, signed, read here as unsigned
  UINT16 trading_session_date;              // bytes 20 to 21
  UINT8 instrument_trading_status;          // byte 22
  UINT16 transaction_begin : 1;             // bytes 23 to 24
  UINT16 transaction_end : 1;               // bytes 23 to 24
  UINT16 instrument_begin : 1;              // bytes 23 to 24
  UINT16 instrument_end : 1;                // bytes 23 to 24
  UINT16 book_begin : 1;                    // bytes 23 to 24
  UINT16 book_end : 1;                      // bytes 23 to 24
  UINT16 book_reset : 1;                    // bytes 23 to 24
  UINT16 reserved_8_to_16 : 9;              // bytes 23 to 24
  UINT64 last_trade_price;                  // bytes 25 to 32, signed, read here as unsigned
  UINT64 last_trade_size;                   // bytes 33 to 40, signed, read here as unsigned
  UINT64 last_trade_time_optional;          // bytes 41 to 48, signed, read here as unsigned
  UINT64 total_volume;                      // bytes 49 to 56, signed, read here as unsigned
  TradeCorrectGroups trade_correct_groups;
} TradeCorrectMessage;

// NoTrades
typedef struct _TradeBustGroup {
  UINT64 trade_id;               // bytes 0 to 7, signed, read here as unsigned
  UINT64 time;                   // bytes 8 to 15, signed, read here as unsigned
  UINT64 price;                  // bytes 16 to 23, signed, read here as unsigned
  UINT64 size;                   // bytes 24 to 31, signed, read here as unsigned
  UINT8 aggressor_side;          // byte 32
  UINT64 buy_order_id;           // bytes 33 to 40, signed, read here as unsigned
  UINT64 sell_order_id;          // bytes 41 to 48, signed, read here as unsigned
  UINT16 synthetic : 1;          // bytes 49 to 50
  UINT16 auction : 1;            // bytes 49 to 50
  UINT16 reserved_3_to_16 : 14;  // bytes 49 to 50
} TradeBustGroup;

// Busted trades repeating group
typedef struct _TradeBustGroups {
  UINT16 block_length;                                                         // bytes 0 to 1
  UINT8 num_in_group;                                                          // byte 2
  TradeBustGroup trade_bust_group[:byte-size (((UINT32) num_in_group) * 51)];
} TradeBustGroups;

// Represents information about one or more busted trades for an instrument
typedef struct _TradeBustMessage {
  UINT32 instrument_id;               // bytes 0 to 3, signed, read here as unsigned
  UINT64 instrument_message_no;       // bytes 4 to 11, signed, read here as unsigned
  UINT64 transact_time;               // bytes 12 to 19, signed, read here as unsigned
  UINT16 trading_session_date;        // bytes 20 to 21
  UINT8 instrument_trading_status;    // byte 22
  UINT16 transaction_begin : 1;       // bytes 23 to 24
  UINT16 transaction_end : 1;         // bytes 23 to 24
  UINT16 instrument_begin : 1;        // bytes 23 to 24
  UINT16 instrument_end : 1;          // bytes 23 to 24
  UINT16 book_begin : 1;              // bytes 23 to 24
  UINT16 book_end : 1;                // bytes 23 to 24
  UINT16 book_reset : 1;              // bytes 23 to 24
  UINT16 reserved_8_to_16 : 9;        // bytes 23 to 24
  UINT64 last_trade_price;            // bytes 25 to 32, signed, read here as unsigned
  UINT64 last_trade_size;             // bytes 33 to 40, signed, read here as unsigned
  UINT64 last_trade_time_optional;    // bytes 41 to 48, signed, read here as unsigned
  UINT64 total_volume;                // bytes 49 to 56, signed, read here as unsigned
  TradeBustGroups trade_bust_groups;
} TradeBustMessage;

// NoOrders
typedef struct _IncrementalOrdersGroup {
  UINT8 order_update_action;       // byte 0
  UINT64 order_id;                 // bytes 1 to 8, signed, read here as unsigned
  UINT64 trade_id_optional;        // bytes 9 to 16, signed, read here as unsigned
  UINT8 side;                      // byte 17
  UINT64 price_optional;           // bytes 18 to 25, signed, read here as unsigned
  UINT64 size;                     // bytes 26 to 33, signed, read here as unsigned
  UINT64 order_priority_optional;  // bytes 34 to 41, signed, read here as unsigned
  UINT16 implied : 1;              // bytes 42 to 43
