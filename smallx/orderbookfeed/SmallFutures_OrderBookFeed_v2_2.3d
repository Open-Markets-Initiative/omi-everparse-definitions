  UINT64 low_price;               // bytes 64 to 71, signed, read here as unsigned
  UINT64 close_price;             // bytes 72 to 79, signed, read here as unsigned
} IndexValueSnapshotMessage;

// Sent on added/updated/deleted futures or option instrument on the market
typedef struct _SingleInstrumentDefinitionIncrementalV2Message {
  UINT32 instrument_id;               // bytes 0 to 3, signed, read here as unsigned
  UINT64 instrument_message_no;       // bytes 4 to 11, signed, read here as unsigned
  UINT64 transact_time;               // bytes 12 to 19, signed, read here as unsigned
  UINT16 trading_session_date;        // bytes 20 to 21
