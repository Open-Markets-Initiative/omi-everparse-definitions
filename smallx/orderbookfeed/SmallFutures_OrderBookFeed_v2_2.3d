  UINT16 transaction_begin : 1;                       // bytes 23 to 24
  UINT16 transaction_end : 1;                         // bytes 23 to 24
  UINT16 instrument_begin : 1;                        // bytes 23 to 24
  UINT16 instrument_end : 1;                          // bytes 23 to 24
  UINT16 book_begin : 1;                              // bytes 23 to 24
  UINT16 book_end : 1;                                // bytes 23 to 24
  UINT16 book_reset : 1;                              // bytes 23 to 24
  UINT16 reserved_8_to_16 : 9;                        // bytes 23 to 24
  IncrementalOrdersGroups incremental_orders_groups;
} OrderBookIncrementalMessage;

// Reflects trading session updated summary information of an instrument
typedef struct _MarketSummaryIncrementalMessage {
  UINT32 instrument_id;             // bytes 0 to 3, signed, read here as unsigned
  UINT64 instrument_message_no;     // bytes 4 to 11, signed, read here as unsigned
  UINT64 transact_time;             // bytes 12 to 19, signed, read here as unsigned
  UINT16 trading_session_date;      // bytes 20 to 21
  UINT8 instrument_trading_status;  // byte 22
  UINT16 transaction_begin : 1;     // bytes 23 to 24
  UINT16 transaction_end : 1;       // bytes 23 to 24
  UINT16 instrument_begin : 1;      // bytes 23 to 24
  UINT16 instrument_end : 1;        // bytes 23 to 24
  UINT16 book_begin : 1;            // bytes 23 to 24
  UINT16 book_end : 1;              // bytes 23 to 24
  UINT16 book_reset : 1;            // bytes 23 to 24
  UINT16 reserved_8_to_16 : 9;      // bytes 23 to 24
  UINT64 open_price;                // bytes 25 to 32, signed, read here as unsigned
  UINT8 open_price_type;            // byte 33
  UINT64 high_price;                // bytes 34 to 41, signed, read here as unsigned
  UINT64 low_price;                 // bytes 42 to 49, signed, read here as unsigned
  UINT64 close_price;               // bytes 50 to 57, signed, read here as unsigned
  UINT64 open_interest;             // bytes 58 to 65, signed, read here as unsigned
  UINT64 settlement_price;          // bytes 66 to 73, signed, read here as unsigned
  UINT8 settlement_price_type;      // byte 74
} MarketSummaryIncrementalMessage;

// NoOrders
typedef struct _SnapshotOrdersGroup {
  UINT64 order_id;               // bytes 0 to 7, signed, read here as unsigned
