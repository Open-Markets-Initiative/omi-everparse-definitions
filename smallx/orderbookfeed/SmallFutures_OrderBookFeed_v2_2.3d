// Contains the last calculated index value and the most recent Open-High-Low-Close values
typedef struct _IndexValueSnapshotMessage {
  UINT32 instrument_id;           // bytes 0 to 3, signed, read here as unsigned
  UINT64 transact_time;           // bytes 4 to 11, signed, read here as unsigned
  UINT16 unused_bits_1_to_2 : 2;  // bytes 12 to 13
