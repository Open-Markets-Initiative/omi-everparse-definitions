  UINT16 transaction_begin : 1;       // bytes 23 to 24
  UINT16 transaction_end : 1;         // bytes 23 to 24
  UINT16 instrument_begin : 1;        // bytes 23 to 24
  UINT16 instrument_end : 1;          // bytes 23 to 24
  UINT16 book_begin : 1;              // bytes 23 to 24
  UINT16 book_end : 1;                // bytes 23 to 24
  UINT16 book_reset : 1;              // bytes 23 to 24
  UINT16 reserved_8_to_16 : 9;        // bytes 23 to 24
  UINT8 instrument_update_action;     // byte 25
  UINT8 symbol[25];                   // bytes 26 to 50
  UINT8 product[8];                   // bytes 51 to 58
  UINT8 description[120];             // bytes 59 to 178
  UINT8 instrument_type;              // byte 179
  UINT16 maturity_date;               // bytes 180 to 181
  UINT16 first_trading_session_date;  // bytes 182 to 183
  UINT16 last_trading_session_date;   // bytes 184 to 185
  UINT16 expiration_date;             // bytes 186 to 187
  UINT8 cfi_code[6];                  // bytes 188 to 193
  UINT8 currency[3];                  // bytes 194 to 196
  UINT64 price_increment;             // bytes 197 to 204, signed, read here as unsigned
  UINT64 price_multiplier;            // bytes 205 to 212, signed, read here as unsigned
  UINT8 underlying_symbol[25];        // bytes 213 to 237
  UINT32 underlying_instrument_id;    // bytes 238 to 241, signed, read here as unsigned
  UINT8 put_or_call;                  // byte 242
  UINT64 strike_price;                // bytes 243 to 250, signed, read here as unsigned
  UINT64 shares_per_contract;         // bytes 251 to 258, signed, read here as unsigned
  UINT8 expiration_style;             // byte 259
  UINT8 exercise_style;               // byte 260
  UINT8 delivery;                     // byte 261
} SingleInstrumentDefinitionIncrementalV2Message;

// NoLegs
typedef struct _LegsGroup {
  UINT32 leg_instrument_id;   // bytes 0 to 3, signed, read here as unsigned
  UINT8 leg_symbol[25];       // bytes 4 to 28
  UINT8 leg_product[8];       // bytes 29 to 36
  UINT64 leg_ratio_quantity;  // bytes 37 to 44, signed, read here as unsigned
  UINT8 leg_side;             // byte 45
} LegsGroup;

// Legs repeating group
typedef struct _LegsGroups {
  UINT16 block_length;                                              // bytes 0 to 1
  UINT8 num_in_group;                                               // byte 2
  LegsGroup legs_group[:byte-size (((UINT32) num_in_group) * 46)];
} LegsGroups;

// Sent on added/updated/deleted multi-leg instrument on the market. Multi-leg instruments with up to 4 legs and ratio from 1 to 5 are supported
typedef struct _MultilegDefinitionIncrementalV2Message {
  UINT32 instrument_id;               // bytes 0 to 3, signed, read here as unsigned
  UINT64 instrument_message_no;       // bytes 4 to 11, signed, read here as unsigned
  UINT64 transact_time;               // bytes 12 to 19, signed, read here as unsigned
  UINT16 trading_session_date;        // bytes 20 to 21
  UINT8 instrument_trading_status;    // byte 22
  UINT16 transaction_begin : 1;       // bytes 23 to 24
  UINT16 transaction_end : 1;         // bytes 23 to 24
  UINT16 instrument_begin : 1;        // bytes 23 to 24
  UINT16 instrument_end : 1;          // bytes 23 to 24
  UINT16 book_begin : 1;              // bytes 23 to 24
  UINT16 book_end : 1;                // bytes 23 to 24
  UINT16 book_reset : 1;              // bytes 23 to 24
  UINT16 reserved_8_to_16 : 9;        // bytes 23 to 24
  UINT8 instrument_update_action;     // byte 25
  UINT8 spread_symbol[120];           // bytes 26 to 145
  UINT8 description[120];             // bytes 146 to 265
  UINT8 instrument_type;              // byte 266
  UINT16 maturity_date;               // bytes 267 to 268
  UINT16 first_trading_session_date;  // bytes 269 to 270
  UINT16 last_trading_session_date;   // bytes 271 to 272
  UINT16 expiration_date;             // bytes 273 to 274
  UINT8 cfi_code[6];                  // bytes 275 to 280
  UINT8 currency[3];                  // bytes 281 to 283
  UINT64 price_increment;             // bytes 284 to 291, signed, read here as unsigned
  UINT64 price_multiplier;            // bytes 292 to 299, signed, read here as unsigned
  UINT8 strategy_type;                // byte 300
  LegsGroups legs_groups;
} MultilegDefinitionIncrementalV2Message;

// Single futures or option instrument definition
typedef struct _SingleInstrumentDefinitionSnapshotV2Message {
  UINT32 instrument_id;                 // bytes 0 to 3, signed, read here as unsigned
  UINT64 instrument_message_no;         // bytes 4 to 11, signed, read here as unsigned
  UINT64 transact_time;                 // bytes 12 to 19, signed, read here as unsigned
  UINT16 trading_session_date;          // bytes 20 to 21
  UINT8 instrument_trading_status;      // byte 22
  UINT16 unused_bits_1_to_2 : 2;        // bytes 23 to 24
  UINT16 instrument_begin : 1;          // bytes 23 to 24
  UINT16 instrument_end : 1;            // bytes 23 to 24
  UINT16 book_begin : 1;                // bytes 23 to 24
  UINT16 book_end : 1;                  // bytes 23 to 24
  UINT16 unused_bit_7 : 1;              // bytes 23 to 24
  UINT16 snapshot_begin : 1;            // bytes 23 to 24
  UINT16 snapshot_end : 1;              // bytes 23 to 24
  UINT16 reserved_10_to_16 : 7;         // bytes 23 to 24
  UINT32 snapshot_instruments_count;    // bytes 25 to 28, signed, read here as unsigned
  UINT64 last_incremental_message_seq;  // bytes 29 to 36, signed, read here as unsigned
  UINT8 symbol[25];                     // bytes 37 to 61
  UINT8 product[8];                     // bytes 62 to 69
  UINT8 description[120];               // bytes 70 to 189
  UINT8 instrument_type;                // byte 190
  UINT16 maturity_date;                 // bytes 191 to 192
  UINT16 first_trading_session_date;    // bytes 193 to 194
  UINT16 last_trading_session_date;     // bytes 195 to 196
  UINT16 expiration_date;               // bytes 197 to 198
  UINT8 cfi_code[6];                    // bytes 199 to 204
  UINT8 currency[3];                    // bytes 205 to 207
  UINT64 price_increment;               // bytes 208 to 215, signed, read here as unsigned
  UINT64 price_multiplier;              // bytes 216 to 223, signed, read here as unsigned
  UINT8 underlying_symbol[25];          // bytes 224 to 248
  UINT32 underlying_instrument_id;      // bytes 249 to 252, signed, read here as unsigned
  UINT8 put_or_call;                    // byte 253
  UINT64 strike_price;                  // bytes 254 to 261, signed, read here as unsigned
  UINT64 shares_per_contract;           // bytes 262 to 269, signed, read here as unsigned
  UINT8 expiration_style;               // byte 270
  UINT8 exercise_style;                 // byte 271
  UINT8 delivery;                       // byte 272
} SingleInstrumentDefinitionSnapshotV2Message;

// Multi-leg instrument definition for futures or option strategies
typedef struct _MultilegDefinitionSnapshotV2Message {
  UINT32 instrument_id;                 // bytes 0 to 3, signed, read here as unsigned
  UINT64 instrument_message_no;         // bytes 4 to 11, signed, read here as unsigned
  UINT64 transact_time;                 // bytes 12 to 19, signed, read here as unsigned
  UINT16 trading_session_date;          // bytes 20 to 21
  UINT8 instrument_trading_status;      // byte 22
  UINT16 unused_bits_1_to_2 : 2;        // bytes 23 to 24
  UINT16 instrument_begin : 1;          // bytes 23 to 24
  UINT16 instrument_end : 1;            // bytes 23 to 24
  UINT16 book_begin : 1;                // bytes 23 to 24
  UINT16 book_end : 1;                  // bytes 23 to 24
  UINT16 unused_bit_7 : 1;              // bytes 23 to 24
  UINT16 snapshot_begin : 1;            // bytes 23 to 24
  UINT16 snapshot_end : 1;              // bytes 23 to 24
  UINT16 reserved_10_to_16 : 7;         // bytes 23 to 24
  UINT32 snapshot_instruments_count;    // bytes 25 to 28, signed, read here as unsigned
  UINT64 last_incremental_message_seq;  // bytes 29 to 36, signed, read here as unsigned
  UINT8 spread_symbol[120];             // bytes 37 to 156
  UINT8 description[120];               // bytes 157 to 276
  UINT8 instrument_type;                // byte 277
  UINT16 maturity_date;                 // bytes 278 to 279
  UINT16 first_trading_session_date;    // bytes 280 to 281
  UINT16 last_trading_session_date;     // bytes 282 to 283
  UINT16 expiration_date;               // bytes 284 to 285
  UINT8 cfi_code[6];                    // bytes 286 to 291
  UINT8 currency[3];                    // bytes 292 to 294
  UINT64 price_increment;               // bytes 295 to 302, signed, read here as unsigned
  UINT64 price_multiplier;              // bytes 303 to 310, signed, read here as unsigned
  UINT8 strategy_type;                  // byte 311
  LegsGroups legs_groups;
} MultilegDefinitionSnapshotV2Message;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0003: InstrumentTradingStatusIncrementalMessage instrument_trading_status_incremental_message;
    case 0x0004: TradesIncrementalMessage trades_incremental_message;
    case 0x0005: TradeCorrectMessage trade_correct_message;
    case 0x0006: TradeBustMessage trade_bust_message;
    case 0x0007: OrderBookIncrementalMessage order_book_incremental_message;
    case 0x0008: MarketSummaryIncrementalMessage market_summary_incremental_message;
    case 0x000B: OrderBookSnapshotMessage order_book_snapshot_message;
    case 0x000C: MarketSummarySnapshotMessage market_summary_snapshot_message;
    case 0x000D: IndexValueSnapshotMessage index_value_snapshot_message;
    case 0x000E: SingleInstrumentDefinitionIncrementalV2Message single_instrument_definition_incremental_v_2_message;
    case 0x000F: MultilegDefinitionIncrementalV2Message multileg_definition_incremental_v_2_message;
    case 0x0010: SingleInstrumentDefinitionSnapshotV2Message single_instrument_definition_snapshot_v_2_message;
    case 0x0011: MultilegDefinitionSnapshotV2Message multileg_definition_snapshot_v_2_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Sbe Frame
typedef struct _SbeFrame (mutable UINT32 * tally) {
  UINT16 frame_length { frame_length >= 10 };                                                                                                                      // bytes 0 to 1
  UINT16 block_length;                                                                                                                                             // bytes 2 to 3
  UINT16 template_id;                                                                                                                                              // bytes 4 to 5
  UINT16 schema_id;                                                                                                                                                // bytes 6 to 7
  UINT16 version;                                                                                                                                                  // bytes 8 to 9
  Payload(template_id, (((UINT32) frame_length) - 10)) payload[:byte-size-single-element-array (((UINT32) frame_length) - 10)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} SbeFrame;

// ---- Packet: Packet ----------------------------------------------------------

// Order Book Feed Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 10) {
  UINT8 channel_id;                                                                                                           // byte 0
  UINT16 incarnation;                                                                                                         // bytes 1 to 2
  UINT8 source;                                                                                                               // byte 3
  UINT8 incarnation_end : 1;                                                                                                  // byte 4
  UINT8 retransmission : 1;                                                                                                   // byte 4
  UINT8 administrative : 1;                                                                                                   // byte 4
  UINT8 reserved_5 : 5;                                                                                                       // byte 4
  UINT32 message_sequence;                                                                                                    // bytes 5 to 8
  UINT8 message_count;                                                                                                        // byte 9
  unit sbe_frame_tally_start {:on-success *tally = 0; return true; };
  SbeFrame(tally) sbe_frame[:byte-size (available - 10)];
  unit sbe_frame_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} Packet;

