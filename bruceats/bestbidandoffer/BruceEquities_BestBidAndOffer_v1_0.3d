// Bruce ATS Best Bid And Offer
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out BruceEquities_BestBidAndOffer_v1_0.3d
//
// What this definition does not state, and the model does:
// - the dispatch that chooses a message by its type
// - a run counted by a field
//
// License: MIT No Attribution

// ---- Packet Header: 20 bytes -------------------------------------------------

// Itch Mold Udp 64 Packet Header
entrypoint typedef struct _PacketHeader {
  UINT8 session[10];         // bytes 0 to 9
  UINT64BE sequence_number;  // bytes 10 to 17
  UINT16BE message_count;    // bytes 18 to 19
} PacketHeader;

// ---- Message Header: 3 bytes -------------------------------------------------

// Mold Udp 64 Message Header
entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;  // bytes 0 to 1
  UINT8 message_type;       // byte 2
} MessageHeader;

// ---- System Event Message: 11 bytes ------------------------------------------

// The System Event message is used to communicate key market or data feed control events.
entrypoint typedef struct _SystemEventMessage {
  UINT16BE stock_locate;  // bytes 0 to 1
  UINT64BE timestamp;     // bytes 2 to 9
  UINT8 event_code;       // byte 10
} SystemEventMessage;

// ---- Stock Directory: 24 bytes -----------------------------------------------

// At the start of each trading day, Bruce disseminates stock directory messages for all active symbols in its trading system.
entrypoint typedef struct _StockDirectory {
  UINT16BE stock_locate;    // bytes 0 to 1
  UINT64BE timestamp;       // bytes 2 to 9
  UINT8 stock[8];           // bytes 10 to 17
  UINT8 market_category;    // byte 18
  UINT32BE round_lot_size;  // bytes 19 to 22
  UINT8 authenticity;       // byte 23
} StockDirectory;

// ---- Stock Trading Action: 19 bytes ------------------------------------------

// Bruce uses this administrative message to indicate the current trading status of a security to the trading community.
entrypoint typedef struct _StockTradingAction {
  UINT16BE stock_locate;  // bytes 0 to 1
  UINT64BE timestamp;     // bytes 2 to 9
  UINT8 stock[8];         // bytes 10 to 17
  UINT8 trading_state;    // byte 18
} StockTradingAction;

// ---- Reg Sho Short Sale Price Test Restricted Indicator: 19 bytes ------------

// For all exchange-listed issues, Bruce relays the Reg SHO Short Sale Price Test Restricted Indicator message when it receives an update from the primary listing exchange.
entrypoint typedef struct _RegShoShortSalePriceTestRestrictedIndicator {
  UINT16BE stock_locate;  // bytes 0 to 1
  UINT64BE timestamp;     // bytes 2 to 9
  UINT8 stock[8];         // bytes 10 to 17
  UINT8 reg_sho_action;   // byte 18
} RegShoShortSalePriceTestRestrictedIndicator;

// ---- Quotation Message: 42 bytes ---------------------------------------------

// BBBO will broadcast a real-time update every time that the system's best bid and offer quote is updated during the trading day.
entrypoint typedef struct _QuotationMessage {
  UINT16BE stock_locate;      // bytes 0 to 1
  UINT64BE timestamp;         // bytes 2 to 9
  UINT8 stock[8];             // bytes 10 to 17
  UINT64BE best_bid_price;    // bytes 18 to 25
  UINT32BE best_bid_size;     // bytes 26 to 29
  UINT64BE best_offer_price;  // bytes 30 to 37
  UINT32BE best_offer_size;   // bytes 38 to 41
} QuotationMessage;

