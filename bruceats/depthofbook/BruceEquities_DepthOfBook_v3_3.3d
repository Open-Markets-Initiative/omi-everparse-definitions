// Bruce ATS Depth Of Book
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out BruceEquities_DepthOfBook_v3_3.3d
//
// What this definition does not state, and the model does:
// - the dispatch that chooses a message by its type
// - a run counted by a field
//
// License: MIT No Attribution

// ---- Packet Header: 20 bytes -------------------------------------------------

// Itch Mold Udp 64 Packet Header
entrypoint typedef struct _PacketHeader {
  UINT8 session[10];         // bytes 0 to 9
  UINT64BE sequence_number;  // bytes 10 to 17
  UINT16BE message_count;    // bytes 18 to 19
} PacketHeader;

// ---- Message Header: 3 bytes -------------------------------------------------

// Mold Udp 64 Message Header
entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;  // bytes 0 to 1
  UINT8 message_type;       // byte 2
} MessageHeader;

// ---- System Event Message: 11 bytes ------------------------------------------

// The System Event message is used to communicate key market or data feed handler events.
entrypoint typedef struct _SystemEventMessage {
  UINT16BE stock_locate;  // bytes 0 to 1
  UINT64BE timestamp;     // bytes 2 to 9
  UINT8 event_code;       // byte 10
} SystemEventMessage;

// ---- Stock Directory Message: 24 bytes ---------------------------------------

// At the start of each trading session, Bruce ATS disseminates stock directory messages for all active symbols in its trading system.
entrypoint typedef struct _StockDirectoryMessage {
  UINT16BE stock_locate;    // bytes 0 to 1
  UINT64BE timestamp;       // bytes 2 to 9
  UINT8 stock[8];           // bytes 10 to 17
  UINT8 market_category;    // byte 18
  UINT32BE round_lot_size;  // bytes 19 to 22
  UINT8 authenticity;       // byte 23
} StockDirectoryMessage;

// ---- Stock Trading Action Message: 19 bytes ----------------------------------

// Bruce ATS uses this administrative message to indicate the current trading status of a security to the trading community.
entrypoint typedef struct _StockTradingActionMessage {
  UINT16BE stock_locate;  // bytes 0 to 1
  UINT64BE timestamp;     // bytes 2 to 9
  UINT8 stock[8];         // bytes 10 to 17
  UINT8 trading_state;    // byte 18
} StockTradingActionMessage;

// ---- Reg Sho Short Sale Price Test Restricted Indicator Message: 19 bytes ----

// For all issues, Bruce ATS relays the Reg SHO Short Sale Price Test Restricted Indicator message when it receives an update from the primary listing exchange.
entrypoint typedef struct _RegShoShortSalePriceTestRestrictedIndicatorMessage {
  UINT16BE stock_locate;  // bytes 0 to 1
  UINT64BE timestamp;     // bytes 2 to 9
  UINT8 stock[8];         // bytes 10 to 17
  UINT8 reg_sho_action;   // byte 18
} RegShoShortSalePriceTestRestrictedIndicatorMessage;

// ---- Add Order Message: 39 bytes ---------------------------------------------

// This message will be generated for orders accepted by the Bruce ATS system and added to the book.
entrypoint typedef struct _AddOrderMessage {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT8 buy_sell_indicator;         // byte 18
  UINT32BE shares;                  // bytes 19 to 22
  UINT8 stock[8];                   // bytes 23 to 30
  UINT64BE price;                   // bytes 31 to 38
} AddOrderMessage;

// ---- Order Executed Message: 30 bytes ----------------------------------------

// This message is sent whenever an order on the book is executed in whole or in part.
entrypoint typedef struct _OrderExecutedMessage {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT32BE executed_shares;         // bytes 18 to 21
  UINT64BE match_number;            // bytes 22 to 29
} OrderExecutedMessage;

// ---- Order Cancel Message: 22 bytes ------------------------------------------

// This message is sent whenever an order on the book is modified as a result of a partial cancellation.
entrypoint typedef struct _OrderCancelMessage {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
  UINT32BE cancelled_shares;        // bytes 18 to 21
} OrderCancelMessage;

// ---- Order Delete Message: 18 bytes ------------------------------------------

// This message is sent whenever an order on the book is being cancelled.
entrypoint typedef struct _OrderDeleteMessage {
  UINT16BE stock_locate;            // bytes 0 to 1
  UINT64BE timestamp;               // bytes 2 to 9
  UINT64BE order_reference_number;  // bytes 10 to 17
} OrderDeleteMessage;

// ---- Order Replace Message: 38 bytes -----------------------------------------

// This message is sent whenever an order on the book has been cancel-replaced.
entrypoint typedef struct _OrderReplaceMessage {
  UINT16BE stock_locate;                     // bytes 0 to 1
  UINT64BE timestamp;                        // bytes 2 to 9
  UINT64BE original_order_reference_number;  // bytes 10 to 17
  UINT64BE new_order_reference_number;       // bytes 18 to 25
  UINT32BE shares;                           // bytes 26 to 29
  UINT64BE price;                            // bytes 30 to 37
} OrderReplaceMessage;

// ---- Trade Correction Message: 38 bytes --------------------------------------

// In the rare case that an adjustment to previously communicated trade / order execution, the Trade Correction Message will be used to communicate the required updates.
entrypoint typedef struct _TradeCorrectionMessage {
  UINT16BE stock_locate;      // bytes 0 to 1
  UINT64BE timestamp;         // bytes 2 to 9
  UINT64BE match_number;      // bytes 10 to 17
  UINT64BE new_match_number;  // bytes 18 to 25
  UINT32BE shares;            // bytes 26 to 29
  UINT64BE price;             // bytes 30 to 37
} TradeCorrectionMessage;

// ---- Trade Break Message: 18 bytes -------------------------------------------

// The Broken Trade Message is sent whenever an execution on Bruce ATS is broken.
entrypoint typedef struct _TradeBreakMessage {
  UINT16BE stock_locate;  // bytes 0 to 1
  UINT64BE timestamp;     // bytes 2 to 9
  UINT64BE match_number;  // bytes 10 to 17
} TradeBreakMessage;

