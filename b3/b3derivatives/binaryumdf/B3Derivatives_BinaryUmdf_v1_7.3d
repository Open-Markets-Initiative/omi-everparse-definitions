// ---- Packet Header: 16 bytes -------------------------------------------------

// B3 Mdp Packet Header
entrypoint typedef struct _PacketHeader {
  UINT8 channel_id;         // byte 0
  UINT8 packet_reserved;    // byte 1
  UINT16 sequence_version;  // bytes 2 to 3
  UINT32 sequence_number;   // bytes 4 to 7
  UINT64 sending_time;      // bytes 8 to 15
} PacketHeader;

// ---- Framing Header: 4 bytes -------------------------------------------------

// B3 Sbe framing header
entrypoint typedef struct _FramingHeader {
  UINT16 message_length;  // bytes 0 to 1
  UINT16 encoding_type;   // bytes 2 to 3
} FramingHeader;

// ---- Message Header: 8 bytes -------------------------------------------------

// B3 Sbe message header message identifiers and length of message root
entrypoint typedef struct _MessageHeader {
  UINT16 block_length;  // bytes 0 to 1
  UINT16 template_id;   // bytes 2 to 3
  UINT16 schema_id;     // bytes 4 to 5
  UINT16 version;       // bytes 6 to 7
} MessageHeader;

// ---- Sequence Message: 4 bytes -----------------------------------------------

// Sequence_2Message
entrypoint typedef struct _SequenceMessage {
  UINT32 next_seq_no;  // bytes 0 to 3
} SequenceMessage;

// ---- Maturity Month Year: 5 bytes --------------------------------------------

// SecurityDefinition_4Message
entrypoint typedef struct _MaturityMonthYear {
  UINT16 year;  // bytes 0 to 1
  UINT8 month;  // byte 2
  UINT8 day;    // byte 3
  UINT8 week;   // byte 4
} MaturityMonthYear;

// ---- Contract Settl Month: 5 bytes -------------------------------------------

// SecurityDefinition_4Message
entrypoint typedef struct _ContractSettlMonth {
  UINT16 year;  // bytes 0 to 1
  UINT8 month;  // byte 2
  UINT8 day;    // byte 3
  UINT8 week;   // byte 4
} ContractSettlMonth;

// ---- Group Size Encoding: 3 bytes --------------------------------------------

// GroupSizeEncoding
entrypoint typedef struct _GroupSizeEncoding {
  UINT16 block_length;  // bytes 0 to 1
  UINT8 num_in_group;   // byte 2
} GroupSizeEncoding;

// ---- Snapshot Full Refresh Header 30 Message: 32 bytes -----------------------

// SnapshotFullRefresh_Header_30Message
entrypoint typedef struct _SnapshotFullRefreshHeader30Message {
  UINT64 security_id;                 // bytes 0 to 7
  UINT32 last_msg_seq_num_processed;  // bytes 8 to 11
  UINT32 tot_num_reports;             // bytes 12 to 15
  UINT32 tot_num_bids;                // bytes 16 to 19
  UINT32 tot_num_offers;              // bytes 20 to 23
  UINT16 tot_num_stats;               // bytes 24 to 25
  UINT8 offset_26_padding_2[2];       // bytes 26 to 27
  UINT32 last_rpt_seq;                // bytes 28 to 31
} SnapshotFullRefreshHeader30Message;

// ---- Execution Summary 55 Message: 64 bytes ----------------------------------

// ExecutionSummary_55Message
entrypoint typedef struct _ExecutionSummary55Message {
  UINT64 security_id;           // bytes 0 to 7
  UINT8 offset_8_padding_2[2];  // bytes 8 to 9
  UINT8 aggressor_side;         // byte 10
  UINT8 offset_11_padding_1;    // byte 11
  UINT64 last_px;               // bytes 12 to 19, signed, read here as unsigned
  UINT64 fill_qty;              // bytes 20 to 27, signed, read here as unsigned
  UINT64 traded_hidden_qty;     // bytes 28 to 35, signed, read here as unsigned
  UINT64 cxl_qty;               // bytes 36 to 43, signed, read here as unsigned
  UINT64 aggressor_time;        // bytes 44 to 51
  UINT32 rpt_seq;               // bytes 52 to 55
  UINT64 md_entry_timestamp;    // bytes 56 to 63
} ExecutionSummary55Message;

