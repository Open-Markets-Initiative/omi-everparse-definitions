typedef struct _SnapshotFullRefreshOrdersMbO71MessageNoMDEntriesGroups {
  UINT16 block_length;                                                                                                                                                 // bytes 0 to 1
  UINT8 num_in_group;                                                                                                                                                  // byte 2
  SnapshotFullRefreshOrdersMbO71MessageNoMDEntriesGroup snapshot_full_refresh_orders_mb_o_71_message_no_m_d_entries_group[:byte-size (((UINT32) num_in_group) * 41)];
} SnapshotFullRefreshOrdersMbO71MessageNoMDEntriesGroups;

// SnapshotFullRefresh_Orders_MBO_71Message
typedef struct _SnapshotFullRefreshOrdersMbO71Message {
  UINT64 security_id;                                                                                                         // bytes 0 to 7
  SnapshotFullRefreshOrdersMbO71MessageNoMDEntriesGroups snapshot_full_refresh_orders_mb_o_71_message_no_m_d_entries_groups;
} SnapshotFullRefreshOrdersMbO71Message;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0001: unit sequence_reset_message;
    case 0x0002: SequenceMessage sequence_message;
    case 0x0009: EmptyBookMessage empty_book_message;
    case 0x000B: ChannelReset11Message channel_reset_11_message;
    case 0x0003: SecurityStatus3Message security_status_3_message;
    case 0x000A: SecurityGroupPhase10Message security_group_phase_10_message;
    case 0x0004: DeprecatedSecurityDefinitionMessage deprecated_security_definition_message;
    case 0x000C: SecurityDefinitionMessage security_definition_message;
    case 0x0005: News5Message news_5_message;
    case 0x000F: OpeningPrice15Message opening_price_15_message;
    case 0x0010: TheoreticalOpeningPrice16Message theoretical_opening_price_16_message;
    case 0x0011: ClosingPrice17Message closing_price_17_message;
    case 0x0013: AuctionImbalance19Message auction_imbalance_19_message;
    case 0x0014: PriceBand20Message price_band_20_message;
    case 0x0015: QuantityBand21Message quantity_band_21_message;
    case 0x0016: PriceBand22Message price_band_22_message;
    case 0x0018: HighPrice24Message high_price_24_message;
    case 0x0019: LowPrice25Message low_price_25_message;
    case 0x001B: LastTradePrice27Message last_trade_price_27_message;
    case 0x001E: SnapshotFullRefreshHeader30Message snapshot_full_refresh_header_30_message;
    case 0x0032: OrderMbO50Message order_mb_o_50_message;
    case 0x0033: DeleteOrderMbO51Message delete_order_mb_o_51_message;
    case 0x0034: MassDeleteOrdersMbO52Message mass_delete_orders_mb_o_52_message;
    case 0x0035: Trade53Message trade_53_message;
    case 0x0036: ForwardTrade54Message forward_trade_54_message;
    case 0x0037: ExecutionSummary55Message execution_summary_55_message;
    case 0x0038: ExecutionStatistics56Message execution_statistics_56_message;
    case 0x0039: TradeBust57Message trade_bust_57_message;
    case 0x0047: SnapshotFullRefreshOrdersMbO71Message snapshot_full_refresh_orders_mb_o_71_message;
    default: UINT8 unknown[available];
  }
} Payload;

// B3 Market Data Message
typedef struct _Message {
  UINT16 message_length { message_length >= 12 };                                                                                    // bytes 0 to 1
  UINT16 encoding_type;                                                                                                              // bytes 2 to 3
  UINT16 block_length;                                                                                                               // bytes 4 to 5
  UINT16 template_id;                                                                                                                // bytes 6 to 7
  UINT16 schema_id;                                                                                                                  // bytes 8 to 9
  UINT16 version;                                                                                                                    // bytes 10 to 11
  Payload(template_id, (((UINT32) message_length) - 12)) payload[:byte-size-single-element-array (((UINT32) message_length) - 12)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// B3 Binary Umdf Packet
entrypoint typedef struct _Packet (UINT32 available) where (available >= 16) {
  PacketHeader packet_header;                    // bytes 0 to 15
  Message message[:byte-size (available - 16)];
} Packet;

