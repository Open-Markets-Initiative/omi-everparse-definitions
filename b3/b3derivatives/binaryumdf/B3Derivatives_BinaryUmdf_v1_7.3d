  UINT64 security_id;                       // bytes 0 to 7
  UINT8 last_trade_msg : 1;                 // byte 8
  UINT8 last_volume_msg : 1;                // byte 8
  UINT8 last_quote_msg : 1;                 // byte 8
  UINT8 last_stats_msg : 1;                 // byte 8
  UINT8 last_implied_msg : 1;               // byte 8
  UINT8 recovery_msg : 1;                   // byte 8
  UINT8 reserved_7 : 1;                     // byte 8
  UINT8 end_of_event : 1;                   // byte 8
  UINT8 trading_session_id;                 // byte 9
  UINT16 opening_price : 1;                 // bytes 10 to 11
  UINT16 crossed : 1;                       // bytes 10 to 11
  UINT16 last_trade_at_the_same_price : 1;  // bytes 10 to 11
  UINT16 out_of_sequence : 1;               // bytes 10 to 11
  UINT16 unused_bits_5_to_6 : 2;            // bytes 10 to 11
  UINT16 trade_on_behalf : 1;               // bytes 10 to 11
  UINT16 unused_bits_8_to_13 : 6;           // bytes 10 to 11
  UINT16 regular_trade : 1;                 // bytes 10 to 11
  UINT16 block_trade : 1;                   // bytes 10 to 11
  UINT16 reserved_16 : 1;                   // bytes 10 to 11
  UINT64 md_future_price;                   // bytes 12 to 19, signed, read here as unsigned
  UINT64 md_entry_size;                     // bytes 20 to 27, signed, read here as unsigned
  UINT32 trade_id;                          // bytes 28 to 31
  UINT32 md_entry_buyer;                    // bytes 32 to 35
  UINT32 md_entry_seller;                   // bytes 36 to 39
  UINT16 trade_date;                        // bytes 40 to 41
  UINT64 md_entry_timestamp;                // bytes 42 to 49
  UINT32 rpt_seq;                           // bytes 50 to 53
  UINT16 seller_days;                       // bytes 54 to 55
  UINT64 md_entry_interest_rate;            // bytes 56 to 63, signed, read here as unsigned
  UINT8 trd_sub_type;                       // byte 64
  UINT8 padding_3[3];                       // bytes 65 to 67
} ForwardTrade54Message;

// ExecutionSummary_55Message
typedef struct _ExecutionSummary55Message {
  UINT64 security_id;           // bytes 0 to 7
  UINT8 offset_8_padding_2[2];  // bytes 8 to 9
  UINT8 aggressor_side;         // byte 10
  UINT8 offset_11_padding_1;    // byte 11
  UINT64 last_px;               // bytes 12 to 19, signed, read here as unsigned
  UINT64 fill_qty;              // bytes 20 to 27, signed, read here as unsigned
  UINT64 traded_hidden_qty;     // bytes 28 to 35, signed, read here as unsigned
  UINT64 cxl_qty;               // bytes 36 to 43, signed, read here as unsigned
  UINT64 aggressor_time;        // bytes 44 to 51
  UINT32 rpt_seq;               // bytes 52 to 55
  UINT64 md_entry_timestamp;    // bytes 56 to 63
} ExecutionSummary55Message;

// ExecutionStatistics_56Message
typedef struct _ExecutionStatistics56Message {
  UINT64 security_id;          // bytes 0 to 7
  UINT8 last_trade_msg : 1;    // byte 8
  UINT8 last_volume_msg : 1;   // byte 8
  UINT8 last_quote_msg : 1;    // byte 8
  UINT8 last_stats_msg : 1;    // byte 8
  UINT8 last_implied_msg : 1;  // byte 8
  UINT8 recovery_msg : 1;      // byte 8
  UINT8 reserved_7 : 1;        // byte 8
  UINT8 end_of_event : 1;      // byte 8
  UINT8 trading_session_id;    // byte 9
  UINT16 trade_date;           // bytes 10 to 11
  UINT64 trade_volume;         // bytes 12 to 19, signed, read here as unsigned
  UINT64 vwap_px;              // bytes 20 to 27, signed, read here as unsigned
  UINT64 net_chg_prev_day;     // bytes 28 to 35, signed, read here as unsigned
  UINT32 number_of_trades;     // bytes 36 to 39
  UINT64 md_entry_timestamp;   // bytes 40 to 47
  UINT32 rpt_seq;              // bytes 48 to 51
} ExecutionStatistics56Message;

// TradeBust_57Message
typedef struct _TradeBust57Message {
  UINT64 security_id;            // bytes 0 to 7
  UINT8 last_trade_msg : 1;      // byte 8
  UINT8 last_volume_msg : 1;     // byte 8
  UINT8 last_quote_msg : 1;      // byte 8
  UINT8 last_stats_msg : 1;      // byte 8
  UINT8 last_implied_msg : 1;    // byte 8
  UINT8 recovery_msg : 1;        // byte 8
  UINT8 reserved_7 : 1;          // byte 8
  UINT8 end_of_event : 1;        // byte 8
  UINT8 trading_session_id;      // byte 9
  UINT8 offset_10_padding_2[2];  // bytes 10 to 11
  UINT64 md_future_price;        // bytes 12 to 19, signed, read here as unsigned
  UINT64 md_entry_size;          // bytes 20 to 27, signed, read here as unsigned
  UINT32 trade_id;               // bytes 28 to 31
  UINT16 trade_date;             // bytes 32 to 33
  UINT8 offset_34_padding_2[2];  // bytes 34 to 35
  UINT64 md_entry_timestamp;     // bytes 36 to 43
  UINT32 rpt_seq;                // bytes 44 to 47
} TradeBust57Message;

// noMDEntries
typedef struct _SnapshotFullRefreshOrdersMbO71MessageNoMDEntriesGroup {
  UINT64 md_corporate_offset_price_optional;  // bytes 0 to 7, signed, read here as unsigned
  UINT64 md_entry_size;                       // bytes 8 to 15, signed, read here as unsigned
  UINT32 md_entry_position_no;                // bytes 16 to 19
  UINT32 entering_firm;                       // bytes 20 to 23
  UINT64 md_insert_timestamp;                 // bytes 24 to 31
  UINT64 secondary_order_id;                  // bytes 32 to 39
  UINT8 md_entry_type;                        // byte 40
} SnapshotFullRefreshOrdersMbO71MessageNoMDEntriesGroup;

