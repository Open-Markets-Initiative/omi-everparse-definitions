// ---- Types -------------------------------------------------------------------

// B3 Mdp Packet Header
typedef struct _PacketHeader {
  UINT8 channel_id;         // byte 0
  UINT8 packet_reserved;    // byte 1
  UINT16 sequence_version;  // bytes 2 to 3
  UINT32 sequence_number;   // bytes 4 to 7
  UINT64 sending_time;      // bytes 8 to 15
} PacketHeader;

// Sequence_2Message
typedef struct _SequenceMessage {
  UINT32 next_seq_no;  // bytes 0 to 3
} SequenceMessage;

// EmptyBook_9Message
typedef struct _EmptyBookMessage {
  UINT64 security_id;           // bytes 0 to 7
  UINT8 last_trade_msg : 1;     // byte 8
  UINT8 last_volume_msg : 1;    // byte 8
  UINT8 last_quote_msg : 1;     // byte 8
  UINT8 last_stats_msg : 1;     // byte 8
  UINT8 last_implied_msg : 1;   // byte 8
  UINT8 recovery_msg : 1;       // byte 8
  UINT8 reserved_7 : 1;         // byte 8
  UINT8 end_of_event : 1;       // byte 8
  UINT8 offset_9_padding_3[3];  // bytes 9 to 11
  UINT64 md_entry_timestamp;    // bytes 12 to 19
} EmptyBookMessage;

// ChannelReset_11Message
typedef struct _ChannelReset11Message {
  UINT8 last_trade_msg : 1;     // byte 0
  UINT8 last_volume_msg : 1;    // byte 0
  UINT8 last_quote_msg : 1;     // byte 0
  UINT8 last_stats_msg : 1;     // byte 0
  UINT8 last_implied_msg : 1;   // byte 0
  UINT8 recovery_msg : 1;       // byte 0
  UINT8 reserved_7 : 1;         // byte 0
  UINT8 end_of_event : 1;       // byte 0
  UINT8 offset_1_padding_3[3];  // bytes 1 to 3
  UINT64 md_entry_timestamp;    // bytes 4 to 11
} ChannelReset11Message;

// SecurityStatus_3Message
typedef struct _SecurityStatus3Message {
  UINT64 security_id;             // bytes 0 to 7
  UINT8 last_trade_msg : 1;       // byte 8
  UINT8 last_volume_msg : 1;      // byte 8
  UINT8 last_quote_msg : 1;       // byte 8
  UINT8 last_stats_msg : 1;       // byte 8
  UINT8 last_implied_msg : 1;     // byte 8
  UINT8 recovery_msg : 1;         // byte 8
  UINT8 reserved_7 : 1;           // byte 8
  UINT8 end_of_event : 1;         // byte 8
  UINT8 trading_session_id;       // byte 9
  UINT8 security_trading_status;  // byte 10
  UINT8 security_trading_event;   // byte 11
  UINT16 trade_date;              // bytes 12 to 13
  UINT8 offset_14_padding_2[2];   // bytes 14 to 15
  UINT64 trad_ses_open_time;      // bytes 16 to 23
  UINT64 transact_time;           // bytes 24 to 31
  UINT32 rpt_seq;                 // bytes 32 to 35
} SecurityStatus3Message;

// SecurityGroupPhase_10Message
typedef struct _SecurityGroupPhase10Message {
  UINT8 security_group[3];       // bytes 0 to 2
  UINT8 offset_3_padding_5[5];   // bytes 3 to 7
  UINT8 last_trade_msg : 1;      // byte 8
  UINT8 last_volume_msg : 1;     // byte 8
  UINT8 last_quote_msg : 1;      // byte 8
  UINT8 last_stats_msg : 1;      // byte 8
  UINT8 last_implied_msg : 1;    // byte 8
  UINT8 recovery_msg : 1;        // byte 8
  UINT8 reserved_7 : 1;          // byte 8
  UINT8 end_of_event : 1;        // byte 8
  UINT8 trading_session_id;      // byte 9
  UINT8 trading_session_sub_id;  // byte 10
  UINT8 security_trading_event;  // byte 11
  UINT16 trade_date;             // bytes 12 to 13
  UINT8 offset_14_padding_2[2];  // bytes 14 to 15
  UINT64 trad_ses_open_time;     // bytes 16 to 23
  UINT64 transact_time;          // bytes 24 to 31
} SecurityGroupPhase10Message;

// SecurityDefinition_4Message
typedef struct _MaturityMonthYear {
  UINT16 year;  // bytes 0 to 1
  UINT8 month;  // byte 2
  UINT8 day;    // byte 3
  UINT8 week;   // byte 4
} MaturityMonthYear;

// noUnderlyings
typedef struct _DeprecatedUnderlyingsGroup {
  UINT64 underlying_security_id;  // bytes 0 to 7
  UINT64 index_pct;               // bytes 8 to 15, signed, read here as unsigned
  UINT64 index_theoretical_qty;   // bytes 16 to 23, signed, read here as unsigned
  UINT8 underlying_symbol[20];    // bytes 24 to 43
} DeprecatedUnderlyingsGroup;

// noUnderlyings Block
typedef struct _DeprecatedUnderlyingsGroups {
  UINT16 block_length;                                                                                 // bytes 0 to 1
  UINT8 num_in_group;                                                                                  // byte 2
  DeprecatedUnderlyingsGroup deprecated_underlyings_group[:byte-size (((UINT32) num_in_group) * 44)];
} DeprecatedUnderlyingsGroups;

// noLegs
typedef struct _DeprecatedLegsGroup {
  UINT64 leg_security_id;   // bytes 0 to 7
  UINT64 leg_ratio_qty;     // bytes 8 to 15, signed, read here as unsigned
  UINT8 leg_security_type;  // byte 16
  UINT8 leg_side;           // byte 17
  UINT8 leg_symbol[20];     // bytes 18 to 37
} DeprecatedLegsGroup;

// noLegs Block
typedef struct _DeprecatedLegsGroups {
  UINT16 block_length;                                                                   // bytes 0 to 1
  UINT8 num_in_group;                                                                    // byte 2
  DeprecatedLegsGroup deprecated_legs_group[:byte-size (((UINT32) num_in_group) * 38)];
} DeprecatedLegsGroups;

// noInstrAttribs
typedef struct _DeprecatedInstrAttribsGroup {
  UINT8 instr_attrib_type;   // byte 0
  UINT8 instr_attrib_value;  // byte 1
} DeprecatedInstrAttribsGroup;

// noInstrAttribs Block
typedef struct _DeprecatedInstrAttribsGroups {
  UINT16 block_length;                                                                                   // bytes 0 to 1
  UINT8 num_in_group;                                                                                    // byte 2
  DeprecatedInstrAttribsGroup deprecated_instr_attribs_group[:byte-size (((UINT32) num_in_group) * 2)];
} DeprecatedInstrAttribsGroups;

// textual description for the financial instrument
casetype _OptionalSecurityDescData (Bool present, UINT32 length) {
  switch (present) {
    case true: UINT8 security_desc_data[length];
    case false: unit absent;
  }
} OptionalSecurityDescData;

// securityDesc data struct
typedef struct _SecurityDesc {
  UINT8 security_desc_length;                                                                                   // byte 0
  OptionalSecurityDescData((security_desc_length > 0x00), ((UINT32) security_desc_length)) security_desc_data;
} SecurityDesc;

// SecurityDefinition_4Message
typedef struct _DeprecatedSecurityDefinitionMessage {
  UINT64 security_id;                                            // bytes 0 to 7
  UINT8 security_exchange[4];                                    // bytes 8 to 11
  UINT8 security_id_source;                                      // byte 12
  UINT8 security_group[3];                                       // bytes 13 to 15
  UINT8 symbol[20];                                              // bytes 16 to 35
