  UINT16 days_to_settlement;                                  // bytes 95 to 96
  QuoteReqId quote_req_id;
  DeskId desk_id;
  Memo memo;
} QuoteMessage;

// QuoteCancelMessage
typedef struct _QuoteCancelMessage {
  BidirectionalBusinessHeader bidirectional_business_header;  // bytes 0 to 19
  UINT64 security_id;                                         // bytes 20 to 27
  UINT64 quote_id_optional;                                   // bytes 28 to 35
  UINT32 account;                                             // bytes 36 to 39
  UINT8 sender_location[10];                                  // bytes 40 to 49
  UINT8 entering_trader[5];                                   // bytes 50 to 54
  UINT8 executing_trader[5];                                  // bytes 55 to 59
  QuoteReqId quote_req_id;
  DeskId desk_id;
  Memo memo;
} QuoteCancelMessage;

// QuoteRequestRejectMessage
typedef struct _QuoteRequestRejectMessage {
  BidirectionalBusinessHeader bidirectional_business_header;  // bytes 0 to 19
  UINT32 quote_request_reject_reason;                         // bytes 20 to 23
  UINT64 security_id;                                         // bytes 24 to 31
  UINT64 quote_id_optional;                                   // bytes 32 to 39
  UINT32 trade_id_optional;                                   // bytes 40 to 43
  UINT32 contra_broker;                                       // bytes 44 to 47
  UINT64 transact_time;                                       // bytes 48 to 55
  UINT8 entering_trader[5];                                   // bytes 56 to 60
  UINT8 settl_type_optional;                                  // byte 61
  UINT64 price_optional;                                      // bytes 62 to 69, signed, read here as unsigned
  UINT64 order_qty_optional;                                  // bytes 70 to 77
  UINT8 sender_location[10];                                  // bytes 78 to 87
  UINT8 executing_trader[5];                                  // bytes 88 to 92
  UINT64 fixed_rate_optional;                                 // bytes 93 to 100, signed, read here as unsigned
  UINT16 days_to_settlement_optional;                         // bytes 101 to 102
  SidesGroups sides_groups;
  QuoteReqId quote_req_id;
  DeskId desk_id;
  Memo memo;
  Text text;
} QuoteRequestRejectMessage;

// PositionMaintenanceCancelRequestMessage
typedef struct _PositionMaintenanceCancelRequestMessage {
  InboundBusinessHeader inbound_business_header;  // bytes 0 to 17
  UINT64 pos_req_id;                              // bytes 18 to 25
  UINT64 security_id;                             // bytes 26 to 33
  UINT64 orig_pos_req_ref_id;                     // bytes 34 to 41
  UINT64 pos_maint_rpt_ref_id;                    // bytes 42 to 49
  UINT8 sender_location[10];                      // bytes 50 to 59
  UINT8 entering_trader[5];                       // bytes 60 to 64
} PositionMaintenanceCancelRequestMessage;

// PositionMaintenanceRequestMessage
typedef struct _PositionMaintenanceRequestMessage {
  InboundBusinessHeader inbound_business_header;  // bytes 0 to 17
  UINT64 pos_req_id;                              // bytes 18 to 25
  UINT64 security_id;                             // bytes 26 to 33
  UINT64 threshold_amount;                        // bytes 34 to 41, signed, read here as unsigned
  UINT32 account;                                 // bytes 42 to 45
  UINT8 sender_location[10];                      // bytes 46 to 55
  UINT8 pos_trans_type;                           // byte 56
  UINT16 clearing_business_date;                  // bytes 57 to 58
  UINT8 contrary_instruction_indicator;           // byte 59
  UINT8 entering_trader[5];                       // bytes 60 to 64
  UINT64 long_qty;                                // bytes 65 to 72
  DeskId desk_id;
  Memo memo;
} PositionMaintenanceRequestMessage;

// noPositions
typedef struct _PositionsGroup {
  UINT8 pos_type;            // byte 0
  UINT64 long_qty_optional;  // bytes 1 to 8
  UINT64 short_qty;          // bytes 9 to 16
} PositionsGroup;

// noPositions Block
typedef struct _PositionsGroups {
  UINT16 block_length;                                                        // bytes 0 to 1
  UINT8 num_in_group;                                                         // byte 2
  PositionsGroup positions_group[:byte-size (((UINT32) num_in_group) * 17)];
} PositionsGroups;

// PositionMaintenanceReportMessage
typedef struct _PositionMaintenanceReportMessage {
  OutboundBusinessHeader outbound_business_header;  // bytes 0 to 17
  UINT64 pos_req_id_optional;                       // bytes 18 to 25
  UINT64 security_id;                               // bytes 26 to 33
  UINT64 pos_maint_rpt_id;                          // bytes 34 to 41
  UINT8 pos_trans_type;                             // byte 42
  UINT8 pos_maint_action;                           // byte 43
  UINT8 pos_maint_status;                           // byte 44
  UINT32 trade_id_optional;                         // bytes 45 to 48
  UINT64 orig_pos_req_ref_id;                       // bytes 49 to 56
  UINT8 account_type;                               // byte 57
  UINT16 clearing_business_date;                    // bytes 58 to 59
  UINT64 threshold_amount;                          // bytes 60 to 67, signed, read here as unsigned
  UINT64 transact_time;                             // bytes 68 to 75
  UINT32 account;                                   // bytes 76 to 79
  UINT8 sender_location[10];                        // bytes 80 to 89
  UINT32 pos_maint_result;                          // bytes 90 to 93
  UINT8 contrary_instruction_indicator;             // byte 94
  PositionsGroups positions_groups;
  DeskId desk_id;
  Memo memo;
  Text text;
} PositionMaintenanceReportMessage;

// AllocationInstructionMessage
typedef struct _AllocationInstructionMessage {
  InboundBusinessHeader inbound_business_header;  // bytes 0 to 17
  UINT64 alloc_id;                                // bytes 18 to 25
  UINT64 security_id;                             // bytes 26 to 33
  UINT8 alloc_trans_type;                         // byte 34
  UINT8 alloc_type;                               // byte 35
  UINT8 alloc_no_orders_type;                     // byte 36
  UINT64 quantity;                                // bytes 37 to 44
  UINT8 sender_location[10];                      // bytes 45 to 54
  UINT8 entering_trader[5];                       // bytes 55 to 59
  UINT32 trade_id;                                // bytes 60 to 63
  UINT16 trade_date_optional;                     // bytes 64 to 65
  UINT64 individual_alloc_id;                     // bytes 66 to 73
  UINT32 alloc_account;                           // bytes 74 to 77
  UINT64 alloc_qty;                               // bytes 78 to 85
  DeskId desk_id;
  Memo memo;
} AllocationInstructionMessage;

// AllocationReportMessage
typedef struct _AllocationReportMessage {
  OutboundBusinessHeader outbound_business_header;  // bytes 0 to 17
  UINT64 alloc_id;                                  // bytes 18 to 25
  UINT64 security_id;                               // bytes 26 to 33
  UINT64 alloc_report_id;                           // bytes 34 to 41
  UINT8 alloc_trans_type;                           // byte 42
  UINT8 alloc_report_type;                          // byte 43
  UINT8 alloc_no_orders_type;                       // byte 44
  UINT32 alloc_rej_code;                            // bytes 45 to 48
  UINT64 quantity;                                  // bytes 49 to 56
  UINT8 alloc_status;                               // byte 57
  UINT16 trade_date_optional;                       // bytes 58 to 59
  UINT64 transact_time;                             // bytes 60 to 67
  UINT8 side;                                       // byte 68
  UINT8 sender_location[10];                        // bytes 69 to 78
  UINT8 entering_trader[5];                         // bytes 79 to 83
} AllocationReportMessage;

// OrderMassActionRequestMessage
typedef struct _OrderMassActionRequestMessage {
  InboundBusinessHeader inbound_business_header;  // bytes 0 to 17
  UINT8 mass_action_type;                         // byte 18
  UINT8 mass_action_scope;                        // byte 19
  UINT64 cl_ord_id;                               // bytes 20 to 27
  UINT8 mass_cancel_restatement_reason;           // byte 28
  UINT8 ord_tag_id;                               // byte 29
  UINT8 side_optional;                            // byte 30
  UINT8 offset_31_padding_1;                      // byte 31
  UINT8 asset[6];                                 // bytes 32 to 37
  UINT64 security_id_optional;                    // bytes 38 to 45
  InvestorId investor_id;                         // bytes 46 to 53
} OrderMassActionRequestMessage;

// OrderMassActionReportMessage
typedef struct _OrderMassActionReportMessage {
  OutboundBusinessHeader outbound_business_header;  // bytes 0 to 17
  UINT8 mass_action_type;                           // byte 18
  UINT8 mass_action_scope;                          // byte 19
  UINT64 cl_ord_id;                                 // bytes 20 to 27
  UINT64 mass_action_report_id;                     // bytes 28 to 35
  UINT64 transact_time;                             // bytes 36 to 43
  UINT8 mass_action_response;                       // byte 44
  UINT8 mass_action_reject_reason;                  // byte 45
  UINT8 mass_cancel_restatement_reason;             // byte 46
  UINT8 ord_tag_id;                                 // byte 47
  UINT8 side_optional;                              // byte 48
  UINT8 offset_49_padding_1;                        // byte 49
  UINT8 asset[6];                                   // bytes 50 to 55
  UINT64 security_id_optional;                      // bytes 56 to 63
  InvestorId investor_id;                           // bytes 64 to 71
  Text text;
} OrderMassActionReportMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0001: NegotiateMessage negotiate_message;
    case 0x0002: NegotiateResponseMessage negotiate_response_message;
    case 0x0003: NegotiateRejectMessage negotiate_reject_message;
    case 0x0004: EstablishMessage establish_message;
    case 0x0005: EstablishAckMessage establish_ack_message;
    case 0x0006: EstablishRejectMessage establish_reject_message;
    case 0x0007: TerminateMessage terminate_message;
    case 0x0008: NotAppliedMessage not_applied_message;
    case 0x0009: SequenceMessage sequence_message;
    case 0x000C: RetransmitRequestMessage retransmit_request_message;
    case 0x000D: RetransmissionMessage retransmission_message;
    case 0x000E: RetransmitRejectMessage retransmit_reject_message;
    case 0x0064: SimpleNewOrderMessage simple_new_order_message;
    case 0x0065: SimpleModifyOrderMessage simple_modify_order_message;
    case 0x0066: NewOrderSingleMessage new_order_single_message;
    case 0x0068: OrderCancelReplaceRequestMessage order_cancel_replace_request_message;
    case 0x0069: OrderCancelRequestMessage order_cancel_request_message;
    case 0x006A: NewOrderCrossMessage new_order_cross_message;
    case 0x00C8: ExecutionReportNewMessage execution_report_new_message;
    case 0x00C9: ExecutionReportModifyMessage execution_report_modify_message;
    case 0x00CA: ExecutionReportCancelMessage execution_report_cancel_message;
    case 0x00CB: ExecutionReportTradeMessage execution_report_trade_message;
    case 0x00CC: ExecutionReportRejectMessage execution_report_reject_message;
    case 0x00CD: ExecutionReportForwardMessage execution_report_forward_message;
    case 0x00CE: BusinessMessageRejectMessage business_message_reject_message;
    case 0x012C: SecurityDefinitionRequestMessage security_definition_request_message;
    case 0x012D: SecurityDefinitionResponseMessage security_definition_response_message;
    case 0x0191: QuoteRequestMessage quote_request_message;
    case 0x0192: QuoteStatusReportMessage quote_status_report_message;
    case 0x0193: QuoteMessage quote_message;
    case 0x0194: QuoteCancelMessage quote_cancel_message;
    case 0x0195: QuoteRequestRejectMessage quote_request_reject_message;
    case 0x01F5: PositionMaintenanceCancelRequestMessage position_maintenance_cancel_request_message;
    case 0x01F6: PositionMaintenanceRequestMessage position_maintenance_request_message;
    case 0x01F7: PositionMaintenanceReportMessage position_maintenance_report_message;
    case 0x0259: AllocationInstructionMessage allocation_instruction_message;
    case 0x025A: AllocationReportMessage allocation_report_message;
    case 0x02BD: OrderMassActionRequestMessage order_mass_action_request_message;
    case 0x02BE: OrderMassActionReportMessage order_mass_action_report_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Simple Open Frame
typedef struct _SimpleOpenFrame {
  UINT16 message_length { message_length >= 12 };                                                                                    // bytes 0 to 1
  UINT16 encoding_type;                                                                                                              // bytes 2 to 3
  UINT16 block_length;                                                                                                               // bytes 4 to 5
  UINT16 template_id;                                                                                                                // bytes 6 to 7
  UINT16 schema_id;                                                                                                                  // bytes 8 to 9
  UINT16 version;                                                                                                                    // bytes 10 to 11
  Payload(template_id, (((UINT32) message_length) - 12)) payload[:byte-size-single-element-array (((UINT32) message_length) - 12)];
} SimpleOpenFrame;

// ---- Packet: Packet ----------------------------------------------------------

// Simple Open Frame Packet
entrypoint typedef struct _Packet (UINT32 available) {
  SimpleOpenFrame simple_open_frame[:byte-size available];
} Packet;

