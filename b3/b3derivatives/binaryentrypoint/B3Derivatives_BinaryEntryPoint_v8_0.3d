#define QUOTE_REJECT_REASON_TRADE_ALREADY_CANCELLED_OR_DOES_NOT_EXIST_TRADE_ID_X_X_X 0x00001F58                          // Trade already cancelled or does not exist Trade Id: <XXX>
#define QUOTE_REJECT_REASON_AVAILABLE_QUANTITY_TO_BLOCK_IS_ZERO 0x00001F5B                                               // Available quantity to block is zero
#define QUOTE_REJECT_REASON_INVALID_OPERATION_FOR_CONTRACT_TYPE 0x00001F5C                                               // Invalid Operation for contract type.
#define QUOTE_REJECT_REASON_FUNCTION_CLOSED_OR_SUSPENDED 0x00001F64                                                      // Function closed or suspended.
#define QUOTE_REJECT_REASON_EXERCISE_PRICE_OUTSIDE_REQUIRED_MONEYNESS 0x00001F67                                         // Exercise price outside required moneyness.
#define QUOTE_REJECT_REASON_INVALID_EXERCISE_REQUEST_ID_TO_CANCEL 0x00001F68                                             // Invalid exercise request id to cancel
#define QUOTE_REJECT_REASON_INVALID_BLOCKING_ID_TO_UNBLOCK 0x00001F7B                                                    // Invalid blocking Id to unblock
#define QUOTE_REJECT_REASON_INVALID_QUANTITY_TO_UNBLOCK 0x00001F7E                                                       // Invalid quantity to unblock
#define QUOTE_REJECT_REASON_ON_BEHALF_OPERATION_NOT_ALLOWED_DURING_C_C_R_RECOVERY 0x00001F7F                             // On Behalf Operation not allowed during CCR recovery
#define QUOTE_REJECT_REASON_PROBLEM_PARSING_INCOMING_MESSAGE 0x00001F81                                                  // Problem parsing incoming message
#define QUOTE_REJECT_REASON_EXERCISE_QUANTITY_SHOULD_BE_GREATER_THAN_ZERO 0x00001F82                                     // Exercise quantity should be greater than zero
#define QUOTE_REJECT_REASON_CONTRARY_EXERCISE_ALREADY_REGISTERED_FOR_THIS_POSITION 0x00001F85                            // Contrary Exercise already registered for this position
#define QUOTE_REJECT_REASON_IN_THE_MONEY_CONTRACT_ALLOWS_CONTRARY_EXERCISE_TO_NOT_EXERCISE_AUTOMATICA_px6z6j 0x00001F86  // In-the-money contract allows Contrary Exercise to not exercise automatically only
#define QUOTE_REJECT_REASON_AT_OUT_THE_MONEY_CONTRACT_ALLOWS_CONTRARY_EXERCISE_TO_EXERCISE_AUTOMATICA_9u4wv6 0x00001F87  // At/Out-the-money contract allows Contrary Exercise to exercise automatically only
