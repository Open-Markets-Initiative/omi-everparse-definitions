// ---- Types -------------------------------------------------------------------

// Credentials data in ASCII.
casetype _OptionalCredentialsData (Bool present, UINT32 length) {
  switch (present) {
    case true: UINT8 credentials_data[length];
    case false: unit absent;
  }
} OptionalCredentialsData;

// credentials data struct
typedef struct _Credentials {
  UINT8 credentials_length;                                                                              // byte 0
  OptionalCredentialsData((credentials_length > 0x00), ((UINT32) credentials_length)) credentials_data;
} Credentials;

// Client system information.
casetype _OptionalClientIpData (Bool present, UINT32 length) {
  switch (present) {
    case true: UINT8 client_ip_data[length];
    case false: unit absent;
  }
} OptionalClientIpData;

// clientIP data struct
typedef struct _ClientIp {
  UINT8 client_ip_length;                                                                       // byte 0
  OptionalClientIpData((client_ip_length > 0x00), ((UINT32) client_ip_length)) client_ip_data;
} ClientIp;

// Client system information.
casetype _OptionalClientAppNameData (Bool present, UINT32 length) {
  switch (present) {
    case true: UINT8 client_app_name_data[length];
    case false: unit absent;
  }
} OptionalClientAppNameData;

// clientAppName data struct
typedef struct _ClientAppName {
  UINT8 client_app_name_length;                                                                                        // byte 0
  OptionalClientAppNameData((client_app_name_length > 0x00), ((UINT32) client_app_name_length)) client_app_name_data;
} ClientAppName;

// Client system information.
casetype _OptionalClientAppVersionData (Bool present, UINT32 length) {
  switch (present) {
    case true: UINT8 client_app_version_data[length];
    case false: unit absent;
  }
} OptionalClientAppVersionData;

// clientAppVersion data struct
typedef struct _ClientAppVersion {
  UINT8 client_app_version_length;                                                                                                 // byte 0
  OptionalClientAppVersionData((client_app_version_length > 0x00), ((UINT32) client_app_version_length)) client_app_version_data;
} ClientAppVersion;

// NegotiateMessage
typedef struct _NegotiateMessage {
  UINT32 session_id;                    // bytes 0 to 3
  UINT64 session_ver_id;                // bytes 4 to 11
  UINT64 timestamp;                     // bytes 12 to 19
  UINT32 entering_firm;                 // bytes 20 to 23
  UINT32 onbehalf_firm;                 // bytes 24 to 27
  Credentials credentials;
  ClientIp client_ip;
  ClientAppName client_app_name;
  ClientAppVersion client_app_version;
} NegotiateMessage;

// NegotiateResponseMessage
typedef struct _NegotiateResponseMessage {
  UINT32 session_id;         // bytes 0 to 3
  UINT64 session_ver_id;     // bytes 4 to 11
  UINT64 request_timestamp;  // bytes 12 to 19
  UINT32 entering_firm;      // bytes 20 to 23
} NegotiateResponseMessage;

// NegotiateRejectMessage
typedef struct _NegotiateRejectMessage {
  UINT32 session_id;              // bytes 0 to 3
  UINT64 session_ver_id;          // bytes 4 to 11
  UINT64 request_timestamp;       // bytes 12 to 19
  UINT32 entering_firm_optional;  // bytes 20 to 23
  UINT8 negotiation_reject_code;  // byte 24
  UINT8 offset_25_padding_3[3];   // bytes 25 to 27
  UINT64 current_session_ver_id;  // bytes 28 to 35
} NegotiateRejectMessage;

// EstablishMessage
typedef struct _EstablishMessage {
  UINT32 session_id;                // bytes 0 to 3
  UINT64 session_ver_id;            // bytes 4 to 11
  UINT64 timestamp;                 // bytes 12 to 19
  UINT64 keep_alive_interval;       // bytes 20 to 27
  UINT32 next_seq_no;               // bytes 28 to 31
  UINT8 cancel_on_disconnect_type;  // byte 32
  UINT8 offset_33_padding_1;        // byte 33
  UINT64 cod_timeout_window;        // bytes 34 to 41
  Credentials credentials;
} EstablishMessage;

// EstablishAckMessage
typedef struct _EstablishAckMessage {
  UINT32 session_id;            // bytes 0 to 3
  UINT64 session_ver_id;        // bytes 4 to 11
  UINT64 request_timestamp;     // bytes 12 to 19
  UINT64 keep_alive_interval;   // bytes 20 to 27
  UINT32 next_seq_no;           // bytes 28 to 31
  UINT32 last_incoming_seq_no;  // bytes 32 to 35
} EstablishAckMessage;

// EstablishRejectMessage
typedef struct _EstablishRejectMessage {
  UINT32 session_id;                     // bytes 0 to 3
  UINT64 session_ver_id;                 // bytes 4 to 11
  UINT64 request_timestamp;              // bytes 12 to 19
  UINT8 establishment_reject_code;       // byte 20
  UINT8 offset_21_padding_1;             // byte 21
  UINT32 last_incoming_seq_no_optional;  // bytes 22 to 25
} EstablishRejectMessage;

// TerminateMessage
typedef struct _TerminateMessage {
  UINT32 session_id;       // bytes 0 to 3
  UINT64 session_ver_id;   // bytes 4 to 11
  UINT8 termination_code;  // byte 12
} TerminateMessage;

// NotAppliedMessage
typedef struct _NotAppliedMessage {
  UINT32 from_seq_no;  // bytes 0 to 3
  UINT32 count;        // bytes 4 to 7
} NotAppliedMessage;

// SequenceMessage
