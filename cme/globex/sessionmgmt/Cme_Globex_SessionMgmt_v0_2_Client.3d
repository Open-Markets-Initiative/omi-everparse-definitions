// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Cme_Globex_SessionMgmt_v0_2_Client.3d

// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_NEGOTIATE 0x00C8                // Negotiate
#define TEMPLATE_ID_NEGOTIATION_REJECT 0x00C9       // Negotiation Reject
#define TEMPLATE_ID_NEGOTIATION_RESPONSE 0x00CA     // Negotiation Response
#define TEMPLATE_ID_TERMINATE 0x00CB                // Terminate
#define TEMPLATE_ID_MARKET_DATA_REQUEST 0x00CD      // Market Data Request
#define TEMPLATE_ID_REQUEST_ACK 0x00CE              // Request Ack
#define TEMPLATE_ID_REQUEST_REJECT 0x00CF           // Request Reject
#define TEMPLATE_ID_SECURITY_LIST_REQUEST 0x00D0    // Security List Request
#define TEMPLATE_ID_SECURITY_STATUS_REQUEST 0x00D1  // Security Status Request
#define TEMPLATE_ID_SUBSCRIBER_HEARTBEAT 0x00D2     // Subscriber Heartbeat

// Error Codes: one byte code
#define ERROR_CODES_HMAC_REJECT 0x00      // Hmac Reject
#define ERROR_CODES_INVALID_VALUE 0x01    // Invalid Value
#define ERROR_CODES_SLOW_CONNECTION 0x02  // Slow Connection
#define ERROR_CODES_OTHER 0x03            // Other

// Subscription Req Type: one byte code
#define SUBSCRIPTION_REQ_TYPE_SNAPSHOT 0x00              // Snapshot
#define SUBSCRIPTION_REQ_TYPE_SNAPSHOT_AND_UPDATES 0x01  // Snapshot And Updates
#define SUBSCRIPTION_REQ_TYPE_UNSUBSCRIBE 0x02           // Unsubscribe

// ---- Types -------------------------------------------------------------------

// Cme Technical Header sent by the subscriber to Cme
typedef struct _ClientTechnicalHeader {
  UINT16 encoding_type;            // bytes 0 to 1
  UINT32 message_sequence_number;  // bytes 2 to 5
  UINT64 sending_time;             // bytes 6 to 13
} ClientTechnicalHeader;

// Negotiate
typedef struct _Negotiate {
  UINT8 hmac_signature[32];  // bytes 0 to 31
  UINT8 access_key_id[20];   // bytes 32 to 51
  UINT64 uuid;               // bytes 52 to 59
  UINT64 request_timestamp;  // bytes 60 to 67
  UINT8 session[5];          // bytes 68 to 72
  UINT8 firm[5];             // bytes 73 to 77
} Negotiate;

// Terminate
typedef struct _Terminate {
  UINT8 reason[48];          // bytes 0 to 47
  UINT64 uuid;               // bytes 48 to 55
  UINT64 request_timestamp;  // bytes 56 to 63
  UINT8 error_codes;         // byte 64
  UINT8 padding_5[5];        // bytes 65 to 69
} Terminate;

// Number of SecurityGroups specified in subscription request. Should be equal 0, when subscription is requested for all groups on the segment or individual Security IDs are listed in the criteria for subscription
typedef struct _MarketDataRequestSecurityGroup {
  UINT8 security_group[6];  // bytes 0 to 5
} MarketDataRequestSecurityGroup;

// NoSecurityGroups Block
typedef struct _MarketDataRequestSecurityGroups {
  UINT16 block_length;                                                      // bytes 0 to 1
  UINT8 num_in_group;                                                       // byte 2
  UINT8 market_data_request_security_group[(((UINT32) num_in_group) * 6)];
} MarketDataRequestSecurityGroups;

// Number of instruments requested. When NoSecurityGroups > 0 specified in the request, the NoRelatedSym should be equal 0
typedef struct _MarketDataRequestRelatedSymbolGroup {
  UINT32 security_id;  // bytes 0 to 3, signed, read here as unsigned
} MarketDataRequestRelatedSymbolGroup;

// NoRelatedSym Block
typedef struct _MarketDataRequestRelatedSymbolGroups {
  UINT16 block_length;                                                                                                     // bytes 0 to 1
  UINT8 num_in_group;                                                                                                      // byte 2
  MarketDataRequestRelatedSymbolGroup market_data_request_related_symbol_group[:byte-size (((UINT32) num_in_group) * 4)];
} MarketDataRequestRelatedSymbolGroups;

// MarketDataRequest
typedef struct _MarketDataRequest {
  UINT32 md_req_id;                                                                // bytes 0 to 3
  UINT8 subscription_req_type;                                                     // byte 4
  MarketDataRequestSecurityGroups market_data_request_security_groups;
  MarketDataRequestRelatedSymbolGroups market_data_request_related_symbol_groups;
} MarketDataRequest;

// NoSecurityGroups Block
typedef struct _SecurityListRequestSecurityGroups {
  UINT16 block_length;                                                        // bytes 0 to 1
  UINT8 num_in_group;                                                         // byte 2
  UINT8 security_list_request_security_group[(((UINT32) num_in_group) * 6)];
} SecurityListRequestSecurityGroups;

// NoRelatedSym Block
typedef struct _SecurityListRequestRelatedSymbolGroups {
  UINT16 block_length;                                                                                                       // bytes 0 to 1
  UINT8 num_in_group;                                                                                                        // byte 2
  MarketDataRequestRelatedSymbolGroup security_list_request_related_symbol_group[:byte-size (((UINT32) num_in_group) * 4)];
} SecurityListRequestRelatedSymbolGroups;

// SecurityListRequest
typedef struct _SecurityListRequest {
  UINT32 md_req_id;                                                                    // bytes 0 to 3
  UINT8 subscription_req_type;                                                         // byte 4
  SecurityListRequestSecurityGroups security_list_request_security_groups;
  SecurityListRequestRelatedSymbolGroups security_list_request_related_symbol_groups;
} SecurityListRequest;

// NoSecurityGroups Block
typedef struct _SecurityStatusRequestSecurityGroups {
  UINT16 block_length;                                                          // bytes 0 to 1
  UINT8 num_in_group;                                                           // byte 2
  UINT8 security_status_request_security_group[(((UINT32) num_in_group) * 6)];
} SecurityStatusRequestSecurityGroups;

// NoRelatedSym Block
typedef struct _SecurityStatusRequestRelatedSymbolGroups {
  UINT16 block_length;                                                                                                         // bytes 0 to 1
  UINT8 num_in_group;                                                                                                          // byte 2
  MarketDataRequestRelatedSymbolGroup security_status_request_related_symbol_group[:byte-size (((UINT32) num_in_group) * 4)];
} SecurityStatusRequestRelatedSymbolGroups;

// SecurityStatusRequest
typedef struct _SecurityStatusRequest {
  UINT32 md_req_id;                                                                        // bytes 0 to 3
  UINT8 subscription_req_type;                                                             // byte 4
  SecurityStatusRequestSecurityGroups security_status_request_security_groups;
  SecurityStatusRequestRelatedSymbolGroups security_status_request_related_symbol_groups;
} SecurityStatusRequest;

// Cme Session Message body sent by the subscriber to Cme
casetype _ClientPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x00C8: Negotiate negotiate;
    case 0x00CB: Terminate terminate;
    case 0x00CD: MarketDataRequest market_data_request;
    case 0x00D0: SecurityListRequest security_list_request;
    case 0x00D1: SecurityStatusRequest security_status_request;
    case 0x00D2: unit subscriber_heartbeat;
    default: UINT8 unknown[available];
  }
} ClientPayload;

// One technical header and the message it carries: the unit the wire repeats
typedef struct _ClientTcpFrame {
  ClientTechnicalHeader client_technical_header;                                                                                                            // bytes 0 to 13
  UINT16 message_size { message_size >= 10 };                                                                                                               // bytes 14 to 15
  UINT16 block_length;                                                                                                                                      // bytes 16 to 17
  UINT16 template_id;                                                                                                                                       // bytes 18 to 19
  UINT16 schema_id;                                                                                                                                         // bytes 20 to 21
  UINT16 version;                                                                                                                                           // bytes 22 to 23
  ClientPayload(template_id, ((((UINT32) message_size) + 14) - 24)) client_payload[:byte-size-single-element-array ((((UINT32) message_size) + 14) - 24)];
} ClientTcpFrame;

// ---- Packet: ClientPacket ----------------------------------------------------

// Cme Sbe Tcp Packet sent by the subscriber to Cme
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientTcpFrame client_tcp_frame[:byte-size available];
} ClientPacket;

