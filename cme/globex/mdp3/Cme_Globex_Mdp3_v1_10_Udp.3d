// ---- Binary Packet Header: 12 bytes ------------------------------------------

// Cme Mdp Packet Header
entrypoint typedef struct _BinaryPacketHeader {
  UINT32 packet_sequence_number;  // bytes 0 to 3
  UINT64 sending_time;            // bytes 4 to 11
} BinaryPacketHeader;

// ---- Simple Binary Header: 8 bytes -------------------------------------------

// Template ID and length of message root
entrypoint typedef struct _SimpleBinaryHeader {
  UINT16 block_length;  // bytes 0 to 1
  UINT16 template_id;   // bytes 2 to 3
  UINT16 schema_id;     // bytes 4 to 5
  UINT16 version;       // bytes 6 to 7
} SimpleBinaryHeader;

// ---- Message Header: 10 bytes ------------------------------------------------

// Message Size followed by the Simple Binary Header
entrypoint typedef struct _MessageHeader {
  UINT16 message_size;                      // bytes 0 to 1
  SimpleBinaryHeader simple_binary_header;  // bytes 2 to 9
} MessageHeader;

// ---- Group Size: 3 bytes -----------------------------------------------------

// Repeating group dimensions
entrypoint typedef struct _GroupSize {
  UINT16 block_length;  // bytes 0 to 1
  UINT8 num_in_group;   // byte 2
} GroupSize;

// ---- Admin Login: 1 byte -----------------------------------------------------

// AdminLogin
entrypoint typedef struct _AdminLogin {
  UINT8 heart_bt_int;  // byte 0, signed, read here as unsigned
} AdminLogin;

// ---- Admin Logout: 180 bytes -------------------------------------------------

// AdminLogout
entrypoint typedef struct _AdminLogout {
  UINT8 logout_text[180];  // bytes 0 to 179
} AdminLogout;

// ---- Group Size 8 Byte: 8 bytes ----------------------------------------------

// 8 Byte aligned repeating group dimensions
entrypoint typedef struct _GroupSize8Byte {
  UINT16 block_length;  // bytes 0 to 1
  UINT8 padding_5[5];   // bytes 2 to 6
  UINT8 num_in_group;   // byte 7
} GroupSize8Byte;

// ---- Maturity Month Year: 5 bytes --------------------------------------------

// MDInstrumentDefinitionFuture
entrypoint typedef struct _MaturityMonthYear {
  UINT16 year;  // bytes 0 to 1
  UINT8 month;  // byte 2
  UINT8 day;    // byte 3
  UINT8 week;   // byte 4
} MaturityMonthYear;

// ---- Negotiate: 78 bytes -----------------------------------------------------

// Negotiate
entrypoint typedef struct _Negotiate {
  UINT8 hmac_signature[32];  // bytes 0 to 31
  UINT8 access_key_id[20];   // bytes 32 to 51
  UINT64 uuid;               // bytes 52 to 59
  UINT64 request_timestamp;  // bytes 60 to 67
  UINT8 session[5];          // bytes 68 to 72
  UINT8 firm[5];             // bytes 73 to 77
} Negotiate;

// ---- Negotiation Reject: 70 bytes --------------------------------------------

// NegotiationReject
entrypoint typedef struct _NegotiationReject {
  UINT8 reason[48];          // bytes 0 to 47
  UINT64 uuid;               // bytes 48 to 55
  UINT64 request_timestamp;  // bytes 56 to 63
  UINT8 error_codes;         // byte 64
  UINT8 padding_5[5];        // bytes 65 to 69
} NegotiationReject;

// ---- Negotiation Response: 22 bytes ------------------------------------------

// NegotiationResponse
entrypoint typedef struct _NegotiationResponse {
  UINT64 uuid;                             // bytes 0 to 7
  UINT64 request_timestamp;                // bytes 8 to 15
  UINT16 secret_key_secure_id_expiration;  // bytes 16 to 17
  UINT8 padding_4[4];                      // bytes 18 to 21
} NegotiationResponse;

// ---- Terminate: 70 bytes -----------------------------------------------------

// Terminate
entrypoint typedef struct _Terminate {
  UINT8 reason[48];          // bytes 0 to 47
  UINT64 uuid;               // bytes 48 to 55
  UINT64 request_timestamp;  // bytes 56 to 63
