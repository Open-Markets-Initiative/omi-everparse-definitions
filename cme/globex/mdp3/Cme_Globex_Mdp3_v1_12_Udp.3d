// Branch
casetype _MdpsessionmgmtPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x00C8: Negotiate negotiate;
    case 0x00C9: NegotiationReject negotiation_reject;
    case 0x00CA: NegotiationResponse negotiation_response;
    case 0x00CB: Terminate terminate;
    case 0x00CD: MarketDataRequest market_data_request;
    case 0x00CE: RequestAck request_ack;
    case 0x00CF: RequestReject request_reject;
    case 0x00D0: SecurityListRequest security_list_request;
    case 0x00D1: SecurityStatusRequest security_status_request;
    case 0x00D2: unit subscriber_heartbeat;
    default: UINT8 unknown[available];
  }
} MdpsessionmgmtPayload;

// Message of sbe schema mdpsessionmgmt (schema id 2)
typedef struct _MdpsessionmgmtMessage (UINT16 template_id, UINT32 available) {
  MdpsessionmgmtPayload(template_id, available) mdpsessionmgmt_payload[:byte-size-single-element-array available];
} MdpsessionmgmtMessage;

// Branch
casetype _Payload (UINT16 selector, UINT16 template_id, UINT32 available) {
  switch (selector) {
    case 0x0001: MktdataMessage(template_id, available) mktdata_message;
    case 0x0002: MdpsessionmgmtMessage(template_id, available) mdpsessionmgmt_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Cme Market Data Message
typedef struct _Mdp3Message {
  UINT16 message_size { message_size >= 10 };                                                                                               // bytes 0 to 1
  UINT16 block_length;                                                                                                                      // bytes 2 to 3
  UINT16 template_id;                                                                                                                       // bytes 4 to 5
  UINT16 schema_id;                                                                                                                         // bytes 6 to 7
  UINT16 version;                                                                                                                           // bytes 8 to 9
  Payload(schema_id, template_id, (((UINT32) message_size) - 10)) payload[:byte-size-single-element-array (((UINT32) message_size) - 10)];
} Mdp3Message;

// ---- Packet: UdpPacket -------------------------------------------------------

// Cme Mdp Packet
entrypoint typedef struct _UdpPacket (UINT32 available) where (available >= 12) {
  BinaryPacketHeader binary_packet_header;                // bytes 0 to 11
  Mdp3Message mdp3_message[:byte-size (available - 12)];
} UdpPacket;

