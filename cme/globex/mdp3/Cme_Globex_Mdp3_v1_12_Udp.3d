  UINT8 last_stats_msg : 1;                                          // byte 8
  UINT8 last_implied_msg : 1;                                        // byte 8
  UINT8 recovery_msg : 1;                                            // byte 8
  UINT8 reserved : 1;                                                // byte 8
  UINT8 end_of_event : 1;                                            // byte 8
  UINT8 padding_2[2];                                                // bytes 9 to 10
  IncrementalRefreshVolumeGroups incremental_refresh_volume_groups;
} MdIncrementalRefreshVolume;

// Indicates the number of repeating symbols specified
typedef struct _RelatedSymGroup {
  UINT8 symbol[20];     // bytes 0 to 19
  UINT32 security_id;   // bytes 20 to 23, signed, read here as unsigned
  UINT32 order_qty;     // bytes 24 to 27, signed, read here as unsigned
  UINT8 quote_type;     // byte 28, signed, read here as unsigned
  UINT8 side_optional;  // byte 29, signed, read here as unsigned
  UINT8 padding_2[2];   // bytes 30 to 31
} RelatedSymGroup;

// NoRelatedSym Block
typedef struct _RelatedSymGroups {
  UINT16 block_length;                                                           // bytes 0 to 1
  UINT8 num_in_group;                                                            // byte 2
  RelatedSymGroup related_sym_group[:byte-size (((UINT32) num_in_group) * 32)];
} RelatedSymGroups;

// QuoteRequest
typedef struct _QuoteRequest {
  UINT64 transact_time;                 // bytes 0 to 7
  UINT8 quote_req_id[23];               // bytes 8 to 30
  UINT8 last_trade_msg : 1;             // byte 31
  UINT8 last_volume_msg : 1;            // byte 31
  UINT8 last_quote_msg : 1;             // byte 31
  UINT8 last_stats_msg : 1;             // byte 31
  UINT8 last_implied_msg : 1;           // byte 31
