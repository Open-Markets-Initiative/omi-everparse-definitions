// Branch
casetype _MktdataPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0004: ChannelReset channel_reset;
    case 0x000C: unit admin_heartbeat;
    case 0x000F: AdminLogin admin_login;
    case 0x0010: AdminLogout admin_logout;
    case 0x001E: SecurityStatus security_status;
    case 0x0025: MdIncrementalRefreshVolume md_incremental_refresh_volume;
    case 0x0027: QuoteRequest quote_request;
    case 0x002E: MdIncrementalRefreshBook md_incremental_refresh_book;
    case 0x002F: MdIncrementalRefreshOrderBook md_incremental_refresh_order_book;
    case 0x0030: MdIncrementalRefreshTradeSummary md_incremental_refresh_trade_summary;
    case 0x0031: MdIncrementalRefreshDailyStatistics md_incremental_refresh_daily_statistics;
    case 0x0032: MdIncrementalRefreshLimitsBanding md_incremental_refresh_limits_banding;
    case 0x0033: MdIncrementalRefreshSessionStatistics md_incremental_refresh_session_statistics;
    case 0x0034: SnapshotFullRefresh snapshot_full_refresh;
    case 0x0035: SnapshotFullRefreshOrderBook snapshot_full_refresh_order_book;
    case 0x0036: MdInstrumentDefinitionFuture md_instrument_definition_future;
    case 0x0037: MdInstrumentDefinitionOption md_instrument_definition_option;
    case 0x0038: MdInstrumentDefinitionSpread md_instrument_definition_spread;
    case 0x0039: MdInstrumentDefinitionFixedIncome md_instrument_definition_fixed_income;
    case 0x003A: MdInstrumentDefinitionRepo md_instrument_definition_repo;
    case 0x003B: SnapshotRefreshTopOrders snapshot_refresh_top_orders;
    case 0x003C: SecurityStatusWorkup security_status_workup;
    case 0x003D: SnapshotFullRefreshTcp snapshot_full_refresh_tcp;
    case 0x003E: CollateralMarketValue collateral_market_value;
    case 0x003F: MdInstrumentDefinitionFx md_instrument_definition_fx;
    case 0x0040: MdIncrementalRefreshBookLongQty md_incremental_refresh_book_long_qty;
    case 0x0041: MdIncrementalRefreshTradeSummaryLongQty md_incremental_refresh_trade_summary_long_qty;
    case 0x0042: MdIncrementalRefreshVolumeLongQty md_incremental_refresh_volume_long_qty;
    case 0x0043: MdIncrementalRefreshSessionStatisticsLongQty md_incremental_refresh_session_statistics_long_qty;
    case 0x0044: SnapshotFullRefreshTcpLongQty snapshot_full_refresh_tcp_long_qty;
    case 0x0045: SnapshotFullRefreshLongQty snapshot_full_refresh_long_qty;
    default: UINT8 unknown[available];
  }
} MktdataPayload;

// Message of sbe schema mktdata (schema id 1)
typedef struct _MktdataMessage (UINT16 template_id, UINT32 available) {
  MktdataPayload(template_id, available) mktdata_payload[:byte-size-single-element-array available];
} MktdataMessage;

// Negotiate
typedef struct _Negotiate {
  UINT8 hmac_signature[32];  // bytes 0 to 31
  UINT8 access_key_id[20];   // bytes 32 to 51
  UINT64 uuid;               // bytes 52 to 59
  UINT64 request_timestamp;  // bytes 60 to 67
  UINT8 session[5];          // bytes 68 to 72
  UINT8 firm[5];             // bytes 73 to 77
} Negotiate;

// NegotiationReject
typedef struct _NegotiationReject {
  UINT8 reason[48];          // bytes 0 to 47
