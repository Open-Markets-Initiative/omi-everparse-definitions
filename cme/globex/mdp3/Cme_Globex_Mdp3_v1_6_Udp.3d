// Cme Mdp Packet Header
typedef struct _BinaryPacketHeader {
  UINT32 packet_sequence_number;  // bytes 0 to 3
  UINT64 sending_time;            // bytes 4 to 11
} BinaryPacketHeader;

// Number of entries in Market Data message
typedef struct _ChannelResetGroup {
  UINT16 appl_id;  // bytes 0 to 1, signed, read here as unsigned
} ChannelResetGroup;

// NoMDEntries Block
typedef struct _ChannelResetGroups {
  UINT16 block_length;                                                              // bytes 0 to 1
  UINT8 num_in_group;                                                               // byte 2
  ChannelResetGroup channel_reset_group[:byte-size (((UINT32) num_in_group) * 2)];
} ChannelResetGroups;

// ChannelReset
typedef struct _ChannelReset {
  UINT64 transact_time;                     // bytes 0 to 7
  UINT8 last_trade_msg : 1;                 // byte 8
  UINT8 last_volume_msg : 1;                // byte 8
  UINT8 last_quote_msg : 1;                 // byte 8
  UINT8 last_stats_msg : 1;                 // byte 8
  UINT8 last_implied_msg : 1;               // byte 8
  UINT8 recovery_msg : 1;                   // byte 8
  UINT8 reserved : 1;                       // byte 8
  UINT8 end_of_event : 1;                   // byte 8
  ChannelResetGroups channel_reset_groups;
} ChannelReset;

// AdminLogin
typedef struct _AdminLogin {
  UINT8 heart_bt_int;  // byte 0, signed, read here as unsigned
} AdminLogin;

// AdminLogout
typedef struct _AdminLogout {
  UINT8 text[180];  // bytes 0 to 179
} AdminLogout;

// MDInstrumentDefinitionFuture
typedef struct _MaturityMonthYear {
  UINT16 year;  // bytes 0 to 1
