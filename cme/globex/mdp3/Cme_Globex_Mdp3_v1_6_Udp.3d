#define SECURITY_TRADING_STATUS_UNKNOWNOR_INVALID 0x14          // Unknownor Invalid
#define SECURITY_TRADING_STATUS_PRE_OPEN 0x15                   // Pre Open
#define SECURITY_TRADING_STATUS_PRE_CROSS 0x18                  // Pre Cross
#define SECURITY_TRADING_STATUS_CROSS 0x19                      // Cross
#define SECURITY_TRADING_STATUS_POST_CLOSE 0x1A                 // Post Close
#define SECURITY_TRADING_STATUS_NO_CHANGE 0x67                  // No Change

