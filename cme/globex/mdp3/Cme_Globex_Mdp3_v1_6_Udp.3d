#define MD_ENTRY_TYPE_BOOK_RESET 0x4A                                // Book Reset
#define MD_ENTRY_TYPE_SESSION_HIGH_BID 0x4E                          // Session High Bid
#define MD_ENTRY_TYPE_SESSION_LOW_OFFER 0x4F                         // Session Low Offer
#define MD_ENTRY_TYPE_FIXING_PRICE 0x57                              // Fixing Price
#define MD_ENTRY_TYPE_ELECTRONIC_VOLUME 0x65                         // Electronic Volume
#define MD_ENTRY_TYPE_THRESHOLD_LIMITSAND_PRICE_BAND_VARIATION 0x67  // Threshold Limitsand Price Band Variation

// Put Or Call: one byte code
#define PUT_OR_CALL_PUT 0x00   // Put
#define PUT_OR_CALL_CALL 0x01  // Call

