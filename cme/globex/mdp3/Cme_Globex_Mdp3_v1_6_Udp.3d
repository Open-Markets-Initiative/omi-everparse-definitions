#define AGGRESSOR_SIDE_NO_AGGRESSOR 0x00  // No Aggressor
#define AGGRESSOR_SIDE_BUY 0x01           // Buy
#define AGGRESSOR_SIDE_SELL 0x02          // Sell

// Md Entry Type: one byte code
#define MD_ENTRY_TYPE_BID 0x30                                       // Bid
#define MD_ENTRY_TYPE_OFFER 0x31                                     // Offer
#define MD_ENTRY_TYPE_TRADE 0x32                                     // Trade
#define MD_ENTRY_TYPE_OPEN_PRICE 0x34                                // Open Price
#define MD_ENTRY_TYPE_SETTLEMENT_PRICE 0x36                          // Settlement Price
#define MD_ENTRY_TYPE_TRADING_SESSION_HIGH_PRICE 0x37                // Trading Session High Price
