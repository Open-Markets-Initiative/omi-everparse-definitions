  UINT8 market_depth;     // byte 3, signed, read here as unsigned
} FeedTypesGroup;

// NoMDFeedTypes Block
typedef struct _FeedTypesGroups {
  UINT16 block_length;                                                        // bytes 0 to 1
  UINT8 num_in_group;                                                         // byte 2
  FeedTypesGroup feed_types_group[:byte-size (((UINT32) num_in_group) * 4)];
} FeedTypesGroups;

// Number of repeating InstrAttribType entries
typedef struct _InstAttribGroup {
  UINT32 electronic_match_eligible : 1;                // bytes 0 to 3
  UINT32 order_cross_eligible : 1;                     // bytes 0 to 3
  UINT32 block_trade_eligible : 1;                     // bytes 0 to 3
