} EventsGroup;

// NoEvents Block
typedef struct _EventsGroups {
  UINT16 block_length;                                                 // bytes 0 to 1
  UINT8 num_in_group;                                                  // byte 2
  EventsGroup events_group[:byte-size (((UINT32) num_in_group) * 9)];
} EventsGroups;

// Number of repeating FeedType entries
typedef struct _FeedTypesGroup {
