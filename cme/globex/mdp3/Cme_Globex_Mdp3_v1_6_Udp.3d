#define HALT_REASON_UNKNOWN 0x05                    // Unknown
#define HALT_REASON_RECOVERY_IN_PROCESS 0x06        // Recovery In Process

// Security Trading Event: one byte code
#define SECURITY_TRADING_EVENT_NO_EVENT 0x00              // No Event
#define SECURITY_TRADING_EVENT_NO_CANCEL 0x01             // No Cancel
#define SECURITY_TRADING_EVENT_RESET_STATISTICS 0x04      // Reset Statistics
#define SECURITY_TRADING_EVENT_IMPLIED_MATCHING_ON 0x05   // Implied Matching On
#define SECURITY_TRADING_EVENT_IMPLIED_MATCHING_OFF 0x06  // Implied Matching Off

// Md Update Action: one byte code
#define MD_UPDATE_ACTION_NEW 0x00          // New
#define MD_UPDATE_ACTION_CHANGE 0x01       // Change
#define MD_UPDATE_ACTION_DELETE 0x02       // Delete
#define MD_UPDATE_ACTION_DELETE_THRU 0x03  // Delete Thru
#define MD_UPDATE_ACTION_DELETE_FROM 0x04  // Delete From
#define MD_UPDATE_ACTION_OVERLAY 0x05      // Overlay

