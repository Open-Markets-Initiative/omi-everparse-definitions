// Branch
casetype _MktdataPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0004: ChannelReset channel_reset;
    case 0x000C: unit admin_heartbeat;
    case 0x000F: AdminLogin admin_login;
    case 0x0010: AdminLogout admin_logout;
    case 0x001B: MdInstrumentDefinitionFuture md_instrument_definition_future;
    case 0x001D: MdInstrumentDefinitionSpread md_instrument_definition_spread;
    case 0x001E: SecurityStatus security_status;
    case 0x0020: MdIncrementalRefreshBook md_incremental_refresh_book;
    case 0x0021: MdIncrementalRefreshDailyStatistics md_incremental_refresh_daily_statistics;
    case 0x0022: MdIncrementalRefreshLimitsBanding md_incremental_refresh_limits_banding;
    case 0x0023: MdIncrementalRefreshSessionStatistics md_incremental_refresh_session_statistics;
    case 0x0024: MdIncrementalRefreshTrade md_incremental_refresh_trade;
    case 0x0025: MdIncrementalRefreshVolume md_incremental_refresh_volume;
    case 0x0026: SnapshotFullRefresh snapshot_full_refresh;
    case 0x0027: QuoteRequest quote_request;
    case 0x0029: MdInstrumentDefinitionOption md_instrument_definition_option;
    case 0x002A: MdIncrementalRefreshTradeSummary md_incremental_refresh_trade_summary;
    default: UINT8 unknown[available];
  }
} MktdataPayload;

// Message of sbe schema mktdata (schema id 1)
typedef struct _MktdataMessage (UINT16 template_id, UINT32 available) {
  MktdataPayload(template_id, available) mktdata_payload[:byte-size-single-element-array available];
} MktdataMessage;

