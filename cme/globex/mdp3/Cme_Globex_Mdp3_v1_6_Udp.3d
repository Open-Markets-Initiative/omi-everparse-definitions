#define TEMPLATE_ID_SUBSCRIBER_HEARTBEAT 0x00D2                       // Subscriber Heartbeat

// Schema Id: 2 byte code
#define SCHEMA_ID_MKTDATA 0x0001         // Mktdata
#define SCHEMA_ID_MDPSESSIONMGMT 0x0002  // Mdpsessionmgmt

// Security Update Action: one byte code
#define SECURITY_UPDATE_ACTION_ADD 0x41     // Add
#define SECURITY_UPDATE_ACTION_DELETE 0x44  // Delete
#define SECURITY_UPDATE_ACTION_MODIFY 0x4D  // Modify

// Md Security Trading Status: one byte code
#define MD_SECURITY_TRADING_STATUS_TRADING_HALT 0x02               // Trading Halt
#define MD_SECURITY_TRADING_STATUS_CLOSE 0x04                      // Close
#define MD_SECURITY_TRADING_STATUS_NEW_PRICE_INDICATION 0x0F       // New Price Indication
#define MD_SECURITY_TRADING_STATUS_READY_TO_TRADE 0x11             // Ready To Trade
#define MD_SECURITY_TRADING_STATUS_NOT_AVAILABLE_FOR_TRADING 0x12  // Not Available For Trading
#define MD_SECURITY_TRADING_STATUS_UNKNOWN_OR_INVALID 0x14         // Unknown Or Invalid
#define MD_SECURITY_TRADING_STATUS_PRE_OPEN 0x15                   // Pre Open
#define MD_SECURITY_TRADING_STATUS_PRE_CROSS 0x18                  // Pre Cross
#define MD_SECURITY_TRADING_STATUS_CROSS 0x19                      // Cross
#define MD_SECURITY_TRADING_STATUS_POST_CLOSE 0x1A                 // Post Close
#define MD_SECURITY_TRADING_STATUS_NO_CHANGE 0x67                  // No Change

// Event Type: one byte code
#define EVENT_TYPE_ACTIVATION 0x05                // Activation
#define EVENT_TYPE_LAST_ELIGIBLE_TRADE_DATE 0x07  // Last Eligible Trade Date

// Leg Side: one byte code
#define LEG_SIDE_BUY_SIDE 0x01   // Buy Side
#define LEG_SIDE_SELL_SIDE 0x02  // Sell Side

// Security Trading Status: one byte code
#define SECURITY_TRADING_STATUS_TRADING_HALT 0x02               // Trading Halt
