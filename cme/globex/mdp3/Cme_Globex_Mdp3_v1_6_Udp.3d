  UINT32 i_link_indicative_mass_quoting_eligible : 1;  // bytes 0 to 3
  UINT32 negative_strike_eligible : 1;                 // bytes 0 to 3
  UINT32 negative_price_outright_eligible : 1;         // bytes 0 to 3
  UINT32 is_fractional : 1;                            // bytes 0 to 3
  UINT32 volatility_quoted_option : 1;                 // bytes 0 to 3
  UINT32 rfq_cross_eligible : 1;                       // bytes 0 to 3
  UINT32 zero_price_outright_eligible : 1;             // bytes 0 to 3
  UINT32 decaying_product_eligibility : 1;             // bytes 0 to 3
  UINT32 variable_product_eligibility : 1;             // bytes 0 to 3
  UINT32 daily_product_eligibility : 1;                // bytes 0 to 3
  UINT32 gt_orders_eligibility : 1;                    // bytes 0 to 3
  UINT32 implied_matching_eligibility : 1;             // bytes 0 to 3
  UINT32 reserved_12 : 12;                             // bytes 0 to 3
} InstAttribGroup;

// NoInstAttrib Block
typedef struct _InstAttribGroups {
  UINT16 block_length;                                                          // bytes 0 to 1
  UINT8 num_in_group;                                                           // byte 2
  InstAttribGroup inst_attrib_group[:byte-size (((UINT32) num_in_group) * 4)];
} InstAttribGroups;

// Number of entries
typedef struct _LotTypeRulesGroup {
