// Fault Tolerance Indicator: one byte code
#define FAULT_TOLERANCE_INDICATOR_BACKUP 0x00   // Backup
#define FAULT_TOLERANCE_INDICATOR_PRIMARY 0x01  // Primary

// Keep Alive Interval Lapsed: one byte code
#define KEEP_ALIVE_INTERVAL_LAPSED_NOT_LAPSED 0x00  // Not Lapsed
#define KEEP_ALIVE_INTERVAL_LAPSED_LAPSED 0x01      // Lapsed

// Split Msg: one byte code
#define SPLIT_MSG_SPLIT_MESSAGE_DELAYED 0x00        // Split Message Delayed
#define SPLIT_MSG_OUTOF_ORDER_MESSAGE_DELAYED 0x01  // Outof Order Message Delayed
#define SPLIT_MSG_COMPLETE_MESSAGE_DELAYED 0x02     // Complete Message Delayed

// Side: one byte code
#define SIDE_BUY 0x01   // Buy
#define SIDE_SELL 0x02  // Sell

// Ord Type: one byte code
#define ORD_TYPE_MARKETWITH_PROTECTION 0x31          // Marketwith Protection
#define ORD_TYPE_LIMIT 0x32                          // Limit
#define ORD_TYPE_STOPWITH_PROTECTION 0x33            // Stopwith Protection
#define ORD_TYPE_STOP_LIMITT 0x34                    // Stop Limitt
#define ORD_TYPE_MARKET_WITH_LEFTOVER_AS_LIMIT 0x4B  // Market With Leftover As Limit

