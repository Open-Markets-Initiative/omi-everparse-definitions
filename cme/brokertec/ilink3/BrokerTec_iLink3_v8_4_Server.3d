  SpreadLegTradeEventsGroups spread_leg_trade_events_groups;
} ExecutionReportTradeAddendumSpreadLeg;

// Total number of order identifiers affected by the OrderMass Action Request. Only used if orders could actually be cancelled otherwise will be set to zero. Must be followed by OrigCIOrdID
typedef struct _AffectedOrdersGroup {
  UINT8 orig_cl_ord_id[20];  // bytes 0 to 19
  UINT64 affected_order_id;  // bytes 20 to 27
  UINT32 cxl_quantity;       // bytes 28 to 31
} AffectedOrdersGroup;

// NoAffectedOrders Block
typedef struct _AffectedOrdersGroups {
  UINT16 block_length;                                                                   // bytes 0 to 1
  UINT8 num_in_group;                                                                    // byte 2
  AffectedOrdersGroup affected_orders_group[:byte-size (((UINT32) num_in_group) * 32)];
} AffectedOrdersGroups;

// An Order Mass Action Report is used to acknowledge an Order Mass Action Request.
typedef struct _OrderMassActionReport {
  UINT32 seq_num;                               // bytes 0 to 3
  UINT64 uuid;                                  // bytes 4 to 11
  UINT8 sender_id[20];                          // bytes 12 to 31
  UINT64 party_details_list_req_id;             // bytes 32 to 39
  UINT64 transact_time;                         // bytes 40 to 47
  UINT64 sending_time_epoch;                    // bytes 48 to 55
  UINT64 order_request_id;                      // bytes 56 to 63
  UINT64 mass_action_report_id;                 // bytes 64 to 71
  UINT8 security_group[6];                      // bytes 72 to 77
  UINT8 location[5];                            // bytes 78 to 82
  UINT32 security_id_optional;                  // bytes 83 to 86, signed, read here as unsigned
  UINT16 delay_duration;                        // bytes 87 to 88
  UINT8 mass_action_response;                   // byte 89
  UINT8 manual_order_indicator;                 // byte 90
  UINT8 mass_action_scope;                      // byte 91
  UINT8 total_affected_orders;                  // byte 92
  UINT8 last_fragment;                          // byte 93
  UINT8 mass_action_reject_reason;              // byte 94
  UINT8 market_segment_id;                      // byte 95
  UINT8 mass_cancel_request_type;               // byte 96
  UINT8 side_optional;                          // byte 97
  UINT8 mass_action_ord_typ;                    // byte 98
  UINT8 mass_cancel_tif;                        // byte 99
  UINT8 split_msg;                              // byte 100
  UINT8 liquidity_flag;                         // byte 101
  UINT8 poss_retrans_flag;                      // byte 102
  UINT64 delay_to_time;                         // bytes 103 to 110
  AffectedOrdersGroups affected_orders_groups;
} OrderMassActionReport;

// SecurityDefinitionResponse
typedef struct _MaturityMonthYear {
  UINT16 year;  // bytes 0 to 1
  UINT8 month;  // byte 2
  UINT8 day;    // byte 3
  UINT8 week;   // byte 4
} MaturityMonthYear;

// Up to 26 legs (i.e., repeating groups) supported for UDS for options. Up to 40 legs (i.e., repeating groups) supported for UDS for futures. Will be set to 0 for REPO
typedef struct _LegOptionDelta {
  UINT32 mantissa_32;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 exponent;      // byte 4, signed, read here as unsigned
} LegOptionDelta;

// Number of legs (repeating groups).
typedef struct _ResponseLegsGroup {
  UINT64 leg_price;                 // bytes 0 to 7, signed, read here as unsigned
  LegOptionDelta leg_option_delta;  // bytes 8 to 12
  UINT32 leg_security_id;           // bytes 13 to 16, signed, read here as unsigned
  UINT8 leg_side;                   // byte 17
  UINT8 leg_ratio_qty;              // byte 18
} ResponseLegsGroup;

// NoLegs Block
typedef struct _ResponseLegsGroups {
  UINT16 block_length;                                                               // bytes 0 to 1
  UINT8 num_in_group;                                                                // byte 2
  ResponseLegsGroup response_legs_group[:byte-size (((UINT32) num_in_group) * 19)];
} ResponseLegsGroups;

// This message is sent in response to an attempt to create a new security definition.
typedef struct _SecurityDefinitionResponse {
  UINT32 seq_num;                            // bytes 0 to 3
  UINT64 uuid;                               // bytes 4 to 11
  UINT8 text[256];                           // bytes 12 to 267
  UINT8 financial_instrument_full_name[35];  // bytes 268 to 302
  UINT8 sender_id[20];                       // bytes 303 to 322
  UINT8 symbol[20];                          // bytes 323 to 342
  UINT64 party_details_list_req_id;          // bytes 343 to 350
  UINT64 security_req_id;                    // bytes 351 to 358
  UINT64 security_response_id;               // bytes 359 to 366
  UINT64 sending_time_epoch;                 // bytes 367 to 374
  UINT8 security_group[6];                   // bytes 375 to 380
  UINT8 security_type[6];                    // bytes 381 to 386
  UINT8 location[5];                         // bytes 387 to 391
  UINT32 security_id_optional;               // bytes 392 to 395, signed, read here as unsigned
  UINT8 currency[3];                         // bytes 396 to 398
  MaturityMonthYear maturity_month_year;     // bytes 399 to 403
  UINT16 delay_duration;                     // bytes 404 to 405
  UINT16 start_date;                         // bytes 406 to 407
  UINT16 end_date;                           // bytes 408 to 409
  UINT8 max_no_of_substitutions;             // byte 410
  UINT32 source_repo_id;                     // bytes 411 to 414, signed, read here as unsigned
  UINT8 termination_type[8];                 // bytes 415 to 422
  UINT8 security_response_type;              // byte 423
  UINT8 expiration_cycle;                    // byte 424
  UINT8 manual_order_indicator;              // byte 425
  UINT8 split_msg;                           // byte 426
  UINT8 auto_quote_request;                  // byte 427
  UINT8 poss_retrans_flag;                   // byte 428
  ResponseLegsGroups response_legs_groups;
} SecurityDefinitionResponse;

// iLink3 message body sent by Cme to the firm
casetype _ServerPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x01F5: NegotiationResponse negotiation_response;
    case 0x01F6: NegotiationReject negotiation_reject;
    case 0x01F8: EstablishmentAck establishment_ack;
    case 0x01F9: EstablishmentReject establishment_reject;
    case 0x01FA: Sequence sequence;
    case 0x01FB: Terminate terminate;
    case 0x01FD: Retransmission retransmission;
    case 0x01FE: RetransmitReject retransmit_reject;
    case 0x0201: NotApplied not_applied;
    case 0x0207: PartyDetailsDefinitionRequestAck party_details_definition_request_ack;
    case 0x0209: BusinessReject business_reject;
    case 0x020A: ExecutionReportNew execution_report_new;
    case 0x020B: ExecutionReportReject execution_report_reject;
    case 0x020C: ExecutionReportElimination execution_report_elimination;
    case 0x020D: ExecutionReportTradeOutright execution_report_trade_outright;
    case 0x020E: ExecutionReportTradeSpread execution_report_trade_spread;
    case 0x020F: ExecutionReportTradeSpreadLeg execution_report_trade_spread_leg;
    case 0x0213: ExecutionReportModify execution_report_modify;
    case 0x0214: ExecutionReportStatus execution_report_status;
    case 0x0216: ExecutionReportCancel execution_report_cancel;
    case 0x0217: OrderCancelReject order_cancel_reject;
    case 0x0218: OrderCancelReplaceReject order_cancel_replace_reject;
    case 0x021A: PartyDetailsListReport party_details_list_report;
    case 0x0221: MassQuoteAck mass_quote_ack;
    case 0x0222: RequestForQuoteAck request_for_quote_ack;
    case 0x0223: QuoteCancelAck quote_cancel_ack;
    case 0x0224: ExecutionReportTradeAddendumOutright execution_report_trade_addendum_outright;
    case 0x0225: ExecutionReportTradeAddendumSpread execution_report_trade_addendum_spread;
    case 0x0226: ExecutionReportTradeAddendumSpreadLeg execution_report_trade_addendum_spread_leg;
    case 0x022E: OrderMassActionReport order_mass_action_report;
    case 0x0231: SecurityDefinitionResponse security_definition_response;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Simple Open Frame sent by Cme to the firm
typedef struct _ServerSimpleOpenFrame {
  UINT16 message_length { message_length >= 12 };                                                                                                 // bytes 0 to 1
  UINT16 encoding_type;                                                                                                                           // bytes 2 to 3
  UINT16 block_length;                                                                                                                            // bytes 4 to 5
  UINT16 template_id;                                                                                                                             // bytes 6 to 7
  UINT16 schema_id;                                                                                                                               // bytes 8 to 9
  UINT16 version;                                                                                                                                 // bytes 10 to 11
  ServerPayload(template_id, (((UINT32) message_length) - 12)) server_payload[:byte-size-single-element-array (((UINT32) message_length) - 12)];
} ServerSimpleOpenFrame;

// ---- Packet: ServerPacket ----------------------------------------------------

// Simple Open Frame Packet sent by Cme to the firm
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSimpleOpenFrame server_simple_open_frame[:byte-size available];
} ServerPacket;

