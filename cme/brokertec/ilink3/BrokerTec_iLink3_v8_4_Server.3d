  UINT8 cross_type;                  // byte 195
  UINT8 aon : 1;                     // byte 196
  UINT8 ob : 1;                      // byte 196
  UINT8 nh : 1;                      // byte 196
  UINT8 reserved_4_to_8 : 5;         // byte 196
  UINT8 execution_mode;              // byte 197
  UINT8 liquidity_flag;              // byte 198
  UINT8 managed_order;               // byte 199
  UINT8 short_sale_type;             // byte 200
  UINT64 delay_to_time;              // bytes 201 to 208
} ExecutionReportNew;

