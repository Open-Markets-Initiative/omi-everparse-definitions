  QuoteCancelAckEntriesGroup quote_cancel_ack_entries_group[:byte-size (((UINT32) num_in_group) * 9)];
} QuoteCancelAckEntriesGroups;

// The number of sets of quotes in the message. Will be populated only for enumerated rejects for Cancel By Quote Set
typedef struct _QuoteCancelAckSetsGroup {
  UINT16 quote_set_id;      // bytes 0 to 1
  UINT16 quote_error_code;  // bytes 2 to 3
} QuoteCancelAckSetsGroup;

// NoQuoteSets Block
typedef struct _QuoteCancelAckSetsGroups {
  UINT16 block_length;                                                                            // bytes 0 to 1
  UINT8 num_in_group;                                                                             // byte 2
  QuoteCancelAckSetsGroup quote_cancel_ack_sets_group[:byte-size (((UINT32) num_in_group) * 4)];
} QuoteCancelAckSetsGroups;

// Quote Cancel Acknowledgment message is used in response to a Quote Cancel message to either accept it or reject it. This message can also be unsolicited in a scenario where CME Globex initiates the cancellation.
typedef struct _QuoteCancelAck {
  UINT32 seq_num;                                               // bytes 0 to 3
  UINT64 uuid;                                                  // bytes 4 to 11
  UINT8 text[256];                                              // bytes 12 to 267
  UINT8 sender_id[20];                                          // bytes 268 to 287
  UINT64 party_details_list_req_id;                             // bytes 288 to 295
  UINT64 request_time;                                          // bytes 296 to 303
  UINT64 sending_time_epoch;                                    // bytes 304 to 311
  UINT8 cancelled_symbol[6];                                    // bytes 312 to 317
  UINT8 location[5];                                            // bytes 318 to 322
  UINT32 quote_id;                                              // bytes 323 to 326
  UINT16 quote_reject_reason;                                   // bytes 327 to 328
  UINT16 delay_duration;                                        // bytes 329 to 330
  UINT8 manual_order_indicator;                                 // byte 331
  UINT8 quote_cxl_status;                                       // byte 332
  UINT8 no_processed_entries;                                   // byte 333
  UINT8 mm_protection_reset;                                    // byte 334
  UINT8 unsolicited_cancel_type;                                // byte 335
  UINT8 split_msg;                                              // byte 336
  UINT8 tot_no_quote_entries_optional;                          // byte 337
  UINT8 liquidity_flag;                                         // byte 338
  UINT8 poss_retrans_flag;                                      // byte 339
  UINT64 delay_to_time;                                         // bytes 340 to 347
  QuoteCancelAckEntriesGroups quote_cancel_ack_entries_groups;
  QuoteCancelAckSetsGroups quote_cancel_ack_sets_groups;
} QuoteCancelAck;

// Number of fills which comprise fill quantity
typedef struct _OutrightTradeEventsGroup {
  UINT64 order_event_px;                // bytes 0 to 7, signed, read here as unsigned
