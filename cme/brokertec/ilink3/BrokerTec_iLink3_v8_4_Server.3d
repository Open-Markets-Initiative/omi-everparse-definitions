} TradeAddendumLegsGroups;

// NoOrderEvents Block
typedef struct _SpreadTradeEventsGroups {
  UINT16 block_length;                                                                            // bytes 0 to 1
  UINT8 num_in_group;                                                                             // byte 2
  OutrightTradeEventsGroup spread_trade_events_group[:byte-size (((UINT32) num_in_group) * 27)];
} SpreadTradeEventsGroups;

// The Execution Report - Trade Addendum Spread message notifies client system of trade cancellation or correction for spreads.
typedef struct _ExecutionReportTradeAddendumSpread {
