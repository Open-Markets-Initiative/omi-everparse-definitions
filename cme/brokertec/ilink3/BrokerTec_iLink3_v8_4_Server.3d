  UINT64 order_id;                   // bytes 100 to 107
  UINT64 price;                      // bytes 108 to 115, signed, read here as unsigned
  UINT64 stop_px;                    // bytes 116 to 123, signed, read here as unsigned
  UINT64 transact_time;              // bytes 124 to 131
  UINT64 sending_time_epoch;         // bytes 132 to 139
  UINT64 order_request_id;           // bytes 140 to 147
  UINT64 cross_id_optional;          // bytes 148 to 155
  UINT64 host_cross_id;              // bytes 156 to 163
  UINT8 location[5];                 // bytes 164 to 168
  UINT32 security_id;                // bytes 169 to 172, signed, read here as unsigned
  UINT32 order_qty;                  // bytes 173 to 176
  UINT32 min_qty;                    // bytes 177 to 180
  UINT32 display_qty;                // bytes 181 to 184
  UINT16 expire_date;                // bytes 185 to 186
  UINT16 delay_duration;             // bytes 187 to 188
  UINT8 ord_type_optional;           // byte 189
  UINT8 side;                        // byte 190
