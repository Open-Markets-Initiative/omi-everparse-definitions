// ---- Types -------------------------------------------------------------------

// Variable Length Data
casetype _OptionalCredentialsData (Bool present, UINT32 length) {
  switch (present) {
    case true: UINT8 credentials_data[length];
    case false: unit absent;
  }
} OptionalCredentialsData;

// Not used and will be set to 0
typedef struct _Credentials {
  UINT16 credentials_length;                                                                               // bytes 0 to 1
  OptionalCredentialsData((credentials_length > 0x0000), ((UINT32) credentials_length)) credentials_data;
} Credentials;

// The Negotiation Response message is sent when a Negotiate message from the customer is accepted by CME.
typedef struct _NegotiationResponse {
  UINT64 uuid;                             // bytes 0 to 7
  UINT64 request_timestamp;                // bytes 8 to 15
  UINT16 secret_key_secure_id_expiration;  // bytes 16 to 17
  UINT8 fault_tolerance_indicator;         // byte 18
  UINT8 split_msg;                         // byte 19
  UINT32 previous_seq_no;                  // bytes 20 to 23
  UINT64 previous_uuid;                    // bytes 24 to 31
  Credentials credentials;
} NegotiationResponse;

// The Negotiation Reject message is sent when CME rejects a Negotiate message sent by the customer.
typedef struct _NegotiationReject {
  UINT8 reason[48];                 // bytes 0 to 47
  UINT64 uuid;                      // bytes 48 to 55
  UINT64 request_timestamp;         // bytes 56 to 63
  UINT16 error_codes;               // bytes 64 to 65
  UINT8 fault_tolerance_indicator;  // byte 66
  UINT8 split_msg;                  // byte 67
} NegotiationReject;

// The Establishment Acknowledgment message is sent when an Establish message from a customer is accepted by CME.
typedef struct _EstablishmentAck {
  UINT64 uuid;                             // bytes 0 to 7
  UINT64 request_timestamp;                // bytes 8 to 15
  UINT32 next_seq_no;                      // bytes 16 to 19
  UINT32 previous_seq_no;                  // bytes 20 to 23
  UINT64 previous_uuid;                    // bytes 24 to 31
  UINT16 keep_alive_interval;              // bytes 32 to 33
  UINT16 secret_key_secure_id_expiration;  // bytes 34 to 35
  UINT8 fault_tolerance_indicator;         // byte 36
  UINT8 split_msg;                         // byte 37
} EstablishmentAck;

// The Establishment Reject message is sent when an Establish message from the customer is rejected by CME.
typedef struct _EstablishmentReject {
  UINT8 reason[48];                 // bytes 0 to 47
  UINT64 uuid;                      // bytes 48 to 55
  UINT64 request_timestamp;         // bytes 56 to 63
  UINT32 next_seq_no;               // bytes 64 to 67
  UINT16 error_codes;               // bytes 68 to 69
  UINT8 fault_tolerance_indicator;  // byte 70
  UINT8 split_msg;                  // byte 71
} EstablishmentReject;

// The Sequence message is used in both Recoverable (CME to customer) and Idempotent (customer to CME) flows.
typedef struct _Sequence {
  UINT64 uuid;                       // bytes 0 to 7
  UINT32 next_seq_no;                // bytes 8 to 11
  UINT8 fault_tolerance_indicator;   // byte 12
  UINT8 keep_alive_interval_lapsed;  // byte 13
} Sequence;

// The Terminate message is sent to indicate that the sender is going to disconnect the TCP socket connection.
typedef struct _Terminate {
  UINT8 reason[48];          // bytes 0 to 47
  UINT64 uuid;               // bytes 48 to 55
  UINT64 request_timestamp;  // bytes 56 to 63
  UINT16 error_codes;        // bytes 64 to 65
  UINT8 split_msg;           // byte 66
} Terminate;

// The Retransmission message is sent when a Retransmit Request message from the customer is accepted by CME.
typedef struct _Retransmission {
  UINT64 uuid;               // bytes 0 to 7
  UINT64 last_uuid;          // bytes 8 to 15
  UINT64 request_timestamp;  // bytes 16 to 23
  UINT32 from_seq_no;        // bytes 24 to 27
  UINT16 msg_count_16;       // bytes 28 to 29
  UINT8 split_msg;           // byte 30
} Retransmission;

// CME Globex sends a Retransmit Reject message when a Retransmit Request message from the customer is rejected.
typedef struct _RetransmitReject {
  UINT8 reason[48];          // bytes 0 to 47
  UINT64 uuid;               // bytes 48 to 55
  UINT64 last_uuid;          // bytes 56 to 63
  UINT64 request_timestamp;  // bytes 64 to 71
  UINT16 error_codes;        // bytes 72 to 73
  UINT8 split_msg;           // byte 74
} RetransmitReject;

// The Not Applied message is sent when CME detects a sequence gap from the customer.
typedef struct _NotApplied {
  UINT64 uuid;         // bytes 0 to 7
  UINT32 from_seq_no;  // bytes 8 to 11
  UINT32 msg_count;    // bytes 12 to 15
  UINT8 split_msg;     // byte 16
} NotApplied;

// Number of party details. More than one occurrence of the same party role is not allowed and will be rejected
typedef struct _PartyDetailsGroup {
  UINT8 party_detail_id[20];  // bytes 0 to 19
  UINT16 party_detail_role;   // bytes 20 to 21
} PartyDetailsGroup;

// NoPartyDetails Block
typedef struct _PartyDetailsGroups {
  UINT16 block_length;                                                               // bytes 0 to 1
  UINT8 num_in_group;                                                                // byte 2
  PartyDetailsGroup party_details_group[:byte-size (((UINT32) num_in_group) * 22)];
} PartyDetailsGroups;

// Number of regulatory publication rules in repeating group. Should always be 1 if being used otherwise set to 0
typedef struct _TrdRegPublicationsGroup {
  UINT8 trd_reg_publication_type;    // byte 0
  UINT8 trd_reg_publication_reason;  // byte 1
} TrdRegPublicationsGroup;

// NoTrdRegPublications Block
typedef struct _TrdRegPublicationsGroups {
  UINT16 block_length;                                                                           // bytes 0 to 1
  UINT8 num_in_group;                                                                            // byte 2
  TrdRegPublicationsGroup trd_reg_publications_group[:byte-size (((UINT32) num_in_group) * 2)];
} TrdRegPublicationsGroups;

// Used to respond to the Party Details Definition Request message indicating whether the request has been accepted.
typedef struct _PartyDetailsDefinitionRequestAck {
  UINT32 seq_num;                                        // bytes 0 to 3
  UINT64 uuid;                                           // bytes 4 to 11
  UINT8 memo[75];                                        // bytes 12 to 86
  UINT8 avg_px_group_id[20];                             // bytes 87 to 106
  UINT64 party_details_list_req_id;                      // bytes 107 to 114
  UINT64 sending_time_epoch;                             // bytes 115 to 122
  UINT64 self_match_prevention_id;                       // bytes 123 to 130
  UINT8 party_detail_request_status;                     // byte 131
  UINT8 cust_order_capacity;                             // byte 132
  UINT8 clearing_account_type;                           // byte 133
  UINT8 self_match_prevention_instruction;               // byte 134
  UINT8 avg_px_indicator;                                // byte 135
  UINT8 clearing_trade_price_type;                       // byte 136
