  UINT16 business_reject_reason;              // bytes 323 to 324
  UINT8 ref_msg_type[2];                      // bytes 325 to 326
  UINT8 poss_retrans_flag;                    // byte 327
  UINT8 manual_order_indicator_optional;      // byte 328
  UINT8 split_msg;                            // byte 329
} BusinessReject;

// Execution Report - New message is sent in response to New Order Single as well as activation of stop orders.
typedef struct _ExecutionReportNew {
