  UINT8 split_msg;                                       // byte 158
  PartyDetailsGroups party_details_groups;
  TrdRegPublicationsGroups trd_reg_publications_groups;
} PartyDetailsDefinitionRequestAck;

// The Business Message Reject message can reject an application-level message, which fulfills session level rules but fails the business rules.
typedef struct _BusinessReject {
  UINT32 seq_num;                             // bytes 0 to 3
  UINT64 uuid;                                // bytes 4 to 11
  UINT8 text[256];                            // bytes 12 to 267
  UINT8 sender_id_optional[20];               // bytes 268 to 287
  UINT64 party_details_list_req_id_optional;  // bytes 288 to 295
  UINT64 sending_time_epoch;                  // bytes 296 to 303
  UINT64 business_reject_ref_id;              // bytes 304 to 311
  UINT8 location_optional[5];                 // bytes 312 to 316
