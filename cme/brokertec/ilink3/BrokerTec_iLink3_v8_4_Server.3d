  UINT8 cl_ord_id[20];                                     // bytes 72 to 91
  UINT64 party_details_list_req_id;                        // bytes 92 to 99
  UINT64 last_px;                                          // bytes 100 to 107, signed, read here as unsigned
  UINT64 order_id;                                         // bytes 108 to 115
  UINT64 transact_time;                                    // bytes 116 to 123
  UINT64 sending_time_epoch;                               // bytes 124 to 131
  UINT64 sec_exec_id;                                      // bytes 132 to 139
  UINT64 orig_secondary_execution_id;                      // bytes 140 to 147
  UINT8 location[5];                                       // bytes 148 to 152
  UINT32 security_id;                                      // bytes 153 to 156, signed, read here as unsigned
  UINT32 last_qty;                                         // bytes 157 to 160
  UINT32 side_trade_id;                                    // bytes 161 to 164
  UINT32 orig_side_trade_id;                               // bytes 165 to 168
  UINT16 trade_date;                                       // bytes 169 to 170
  UINT8 ord_status_trd_cxl;                                // byte 171
  UINT8 exec_type;                                         // byte 172
  UINT8 side;                                              // byte 173
  UINT8 manual_order_indicator;                            // byte 174
  UINT8 poss_retrans_flag;                                 // byte 175
  UINT8 aon : 1;                                           // byte 176
  UINT8 ob : 1;                                            // byte 176
  UINT8 nh : 1;                                            // byte 176
  UINT8 reserved_4_to_8 : 5;                               // byte 176
  UINT8 execution_mode;                                    // byte 177
  UINT8 liquidity_flag;                                    // byte 178
  UINT8 managed_order;                                     // byte 179
  UINT8 short_sale_type;                                   // byte 180
