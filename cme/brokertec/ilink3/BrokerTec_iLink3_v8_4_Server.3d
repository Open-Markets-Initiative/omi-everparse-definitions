  UINT32 security_id;                                  // bytes 153 to 156, signed, read here as unsigned
  UINT32 md_trade_entry_id;                            // bytes 157 to 160
  UINT32 last_qty;                                     // bytes 161 to 164
  UINT32 side_trade_id;                                // bytes 165 to 168
  UINT32 orig_side_trade_id;                           // bytes 169 to 172
  UINT16 trade_date;                                   // bytes 173 to 174
  UINT8 ord_status_trd_cxl;                            // byte 175
  UINT8 exec_type;                                     // byte 176
  UINT8 ord_type_optional;                             // byte 177
  UINT8 side;                                          // byte 178
  UINT8 manual_order_indicator;                        // byte 179
  UINT8 poss_retrans_flag;                             // byte 180
  UINT8 total_num_securities;                          // byte 181
  UINT8 aon : 1;                                       // byte 182
  UINT8 ob : 1;                                        // byte 182
  UINT8 nh : 1;                                        // byte 182
  UINT8 reserved_4_to_8 : 5;                           // byte 182
  UINT8 execution_mode;                                // byte 183
  UINT8 liquidity_flag;                                // byte 184
  UINT8 managed_order;                                 // byte 185
  UINT8 short_sale_type;                               // byte 186
  FillsGroups fills_groups;
  TradeAddendumLegsGroups trade_addendum_legs_groups;
  SpreadTradeEventsGroups spread_trade_events_groups;
} ExecutionReportTradeAddendumSpread;

// NoOrderEvents Block
typedef struct _SpreadLegTradeEventsGroups {
  UINT16 block_length;                                                                                // bytes 0 to 1
  UINT8 num_in_group;                                                                                 // byte 2
  OutrightTradeEventsGroup spread_leg_trade_events_group[:byte-size (((UINT32) num_in_group) * 27)];
} SpreadLegTradeEventsGroups;

// The Execution Report - Trade Addendum Spread Leg message notifies client system of trade cancellation or correction for spread legs.
typedef struct _ExecutionReportTradeAddendumSpreadLeg {
  UINT32 seq_num;                                             // bytes 0 to 3
  UINT64 uuid;                                                // bytes 4 to 11
  UINT8 exec_id[40];                                          // bytes 12 to 51
  UINT8 sender_id[20];                                        // bytes 52 to 71
  UINT8 cl_ord_id[20];                                        // bytes 72 to 91
  UINT64 party_details_list_req_id;                           // bytes 92 to 99
  UINT64 last_px;                                             // bytes 100 to 107, signed, read here as unsigned
  UINT64 order_id;                                            // bytes 108 to 115
  UINT64 transact_time;                                       // bytes 116 to 123
  UINT64 sending_time_epoch;                                  // bytes 124 to 131
  UINT64 sec_exec_id;                                         // bytes 132 to 139
  UINT64 orig_secondary_execution_id;                         // bytes 140 to 147
  UINT8 location[5];                                          // bytes 148 to 152
  UINT32 security_id;                                         // bytes 153 to 156, signed, read here as unsigned
  UINT32 last_qty;                                            // bytes 157 to 160
  UINT32 side_trade_id;                                       // bytes 161 to 164
  UINT32 orig_side_trade_id;                                  // bytes 165 to 168
