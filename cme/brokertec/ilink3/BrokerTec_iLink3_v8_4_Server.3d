  UINT64 transact_time;              // bytes 364 to 371
  UINT64 sending_time_epoch;         // bytes 372 to 379
  UINT64 order_request_id;           // bytes 380 to 387
  UINT8 location[5];                 // bytes 388 to 392
  UINT16 cxl_rej_reason;             // bytes 393 to 394
  UINT16 delay_duration;             // bytes 395 to 396
  UINT8 manual_order_indicator;      // byte 397
  UINT8 poss_retrans_flag;           // byte 398
  UINT8 split_msg;                   // byte 399
  UINT8 liquidity_flag;              // byte 400
  UINT64 delay_to_time;              // bytes 401 to 408
} OrderCancelReplaceReject;

// Used to replay Party Details Definition information such as clearing instructions, order source, self-match parameters, etc. for a particular Firm ID.
typedef struct _PartyDetailsListReport {
  UINT32 seq_num;                                        // bytes 0 to 3
  UINT64 uuid;                                           // bytes 4 to 11
  UINT8 avg_px_group_id[20];                             // bytes 12 to 31
  UINT64 party_details_list_req_id;                      // bytes 32 to 39
  UINT64 party_details_list_report_id;                   // bytes 40 to 47
  UINT64 sending_time_epoch;                             // bytes 48 to 55
  UINT64 self_match_prevention_id;                       // bytes 56 to 63
  UINT16 tot_num_parties;                                // bytes 64 to 65
  UINT8 request_result;                                  // byte 66
  UINT8 last_fragment;                                   // byte 67
  UINT8 cust_order_capacity;                             // byte 68
  UINT8 clearing_account_type;                           // byte 69
  UINT8 self_match_prevention_instruction;               // byte 70
  UINT8 avg_px_indicator;                                // byte 71
  UINT8 clearing_trade_price_type;                       // byte 72
  UINT8 cmta_giveup_cd;                                  // byte 73
  UINT8 cust_order_handling_inst;                        // byte 74
  UINT64 executor;                                       // bytes 75 to 82
  UINT64 idm_short_code;                                 // bytes 83 to 90
  UINT8 poss_retrans_flag;                               // byte 91
  UINT8 split_msg;                                       // byte 92
  PartyDetailsGroups party_details_groups;
  TrdRegPublicationsGroups trd_reg_publications_groups;
} PartyDetailsListReport;

// The number of quoute entries for a quote set.
typedef struct _QuoteAckEntriesGroup {
  UINT32 quote_entry_id;            // bytes 0 to 3
  UINT32 security_id;               // bytes 4 to 7, signed, read here as unsigned
  UINT16 quote_set_id;              // bytes 8 to 9
  UINT8 quote_entry_reject_reason;  // byte 10
} QuoteAckEntriesGroup;

// NoQuoteEntries Block
typedef struct _QuoteAckEntriesGroups {
  UINT16 block_length;                                                                      // bytes 0 to 1
  UINT8 num_in_group;                                                                       // byte 2
  QuoteAckEntriesGroup quote_ack_entries_group[:byte-size (((UINT32) num_in_group) * 11)];
} QuoteAckEntriesGroups;

// The Mass Quote Acknowledgment message is used as the response to a Mass Quote to notify customers of accepted and rejected quotes.
typedef struct _MassQuoteAck {
  UINT32 seq_num;                                  // bytes 0 to 3
  UINT64 uuid;                                     // bytes 4 to 11
  UINT8 text[256];                                 // bytes 12 to 267
  UINT8 sender_id[20];                             // bytes 268 to 287
  UINT64 party_details_list_req_id;                // bytes 288 to 295
  UINT64 request_time;                             // bytes 296 to 303
  UINT64 sending_time_epoch;                       // bytes 304 to 311
  UINT64 quote_req_id_optional;                    // bytes 312 to 319
  UINT8 location[5];                               // bytes 320 to 324
  UINT32 quote_id;                                 // bytes 325 to 328
  UINT16 quote_reject_reason;                      // bytes 329 to 330
  UINT16 delay_duration;                           // bytes 331 to 332
  UINT8 quote_ack_status;                          // byte 333
  UINT8 manual_order_indicator;                    // byte 334
  UINT8 no_processed_entries;                      // byte 335
  UINT8 mm_protection_reset;                       // byte 336
  UINT8 split_msg;                                 // byte 337
  UINT8 liquidity_flag;                            // byte 338
  UINT8 short_sale_type;                           // byte 339
  UINT8 tot_no_quote_entries_optional;             // byte 340
  UINT8 poss_retrans_flag;                         // byte 341
  UINT64 delay_to_time;                            // bytes 342 to 349
  QuoteAckEntriesGroups quote_ack_entries_groups;
} MassQuoteAck;

// Request for Quote Acknowledgment message is used in response to a Request for Quote message to either accept it or reject it.
typedef struct _RequestForQuoteAck {
  UINT32 seq_num;                    // bytes 0 to 3
  UINT64 uuid;                       // bytes 4 to 11
  UINT8 text[256];                   // bytes 12 to 267
  UINT8 sender_id[20];               // bytes 268 to 287
  UINT8 exchange_quote_req_id[17];   // bytes 288 to 304
  UINT64 party_details_list_req_id;  // bytes 305 to 312
  UINT64 request_time;               // bytes 313 to 320
  UINT64 sending_time_epoch;         // bytes 321 to 328
  UINT64 quote_req_id;               // bytes 329 to 336
  UINT8 location[5];                 // bytes 337 to 341
  UINT16 quote_reject_reason;        // bytes 342 to 343
  UINT16 delay_duration;             // bytes 344 to 345
  UINT8 quote_ack_status;            // byte 346
  UINT8 manual_order_indicator;      // byte 347
  UINT8 split_msg;                   // byte 348
  UINT8 poss_retrans_flag;           // byte 349
  UINT64 delay_to_time;              // bytes 350 to 357
} RequestForQuoteAck;

// The number of quote entries for a quote set. Will be populated only for enumerated rejects for Cancel By Instrument
typedef struct _QuoteCancelAckEntriesGroup {
  UINT32 quote_entry_id;            // bytes 0 to 3
  UINT32 security_id;               // bytes 4 to 7, signed, read here as unsigned
  UINT8 quote_entry_reject_reason;  // byte 8
