// ---- Values ------------------------------------------------------------------

// Template Id: 2 byte code
#define TEMPLATE_ID_MD_INCREMENTAL_REFRESH_BTEC 0x0195  // Md Incremental Refresh Btec
#define TEMPLATE_ID_ADMIN_HEARTBEAT 0x019B              // Admin Heartbeat

// Md Update Action: one byte code
#define MD_UPDATE_ACTION_NEW 0x00     // New
#define MD_UPDATE_ACTION_UPDATE 0x01  // Update
#define MD_UPDATE_ACTION_DELETE 0x02  // Delete

// Md Entry Type: one byte code
#define MD_ENTRY_TYPE_BID 0x30               // Bid
#define MD_ENTRY_TYPE_OFFER 0x31             // Offer
#define MD_ENTRY_TYPE_TRADE 0x32             // Trade
#define MD_ENTRY_TYPE_OPEN_PRICE 0x34        // Open Price
#define MD_ENTRY_TYPE_CLOSE_PRICE 0x35       // Close Price
#define MD_ENTRY_TYPE_HIGH_TRADE_PRICE 0x37  // High Trade Price
#define MD_ENTRY_TYPE_LOW_TRADE_PRICE 0x38   // Low Trade Price
#define MD_ENTRY_TYPE_VWAP 0x39              // Vwap
#define MD_ENTRY_TYPE_IMPLIED_BID 0x45       // Implied Bid
#define MD_ENTRY_TYPE_IMPLIED_OFFER 0x46     // Implied Offer
#define MD_ENTRY_TYPE_BOOK_RESET 0x4A        // Book Reset

// ---- Types -------------------------------------------------------------------

// Cme Mdp Packet Header
typedef struct _BinaryPacketHeader {
  UINT32 packet_sequence_number;  // bytes 0 to 3
  UINT64 sending_time;            // bytes 4 to 11
} BinaryPacketHeader;

// Number of data blocks
typedef struct _MdEntryPx {
  UINT64 mantissa;  // bytes 0 to 7, signed, read here as unsigned
  UINT8 exponent;   // byte 8, signed, read here as unsigned
} MdEntryPx;

// Number of data blocks
typedef struct _CouponRate {
  UINT32 mantissa_32;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 exponent;      // byte 4, signed, read here as unsigned
} CouponRate;

// Number of data blocks
typedef struct _IncrementalRefreshBtecGroup {
  UINT8 md_update_action;        // byte 0
  UINT8 md_entry_type;           // byte 1
  MdEntryPx md_entry_px;         // bytes 2 to 10
  UINT32 md_entry_size;          // bytes 11 to 14
  UINT8 md_price_level;          // byte 15
  UINT32 trade_volume;           // bytes 16 to 19
  UINT8 symbol[20];              // bytes 20 to 39
  UINT16 maturity_date;          // bytes 40 to 41
  UINT8 security_alt_id[12];     // bytes 42 to 53
  UINT8 security_alt_id_source;  // byte 54
  CouponRate coupon_rate;        // bytes 55 to 59
  UINT8 trade_condition;         // byte 60
  UINT8 price_type;              // byte 61
} IncrementalRefreshBtecGroup;

// NoMDEntries Block
typedef struct _IncrementalRefreshBtecGroups {
  UINT16 block_length;                                                                                    // bytes 0 to 1
  UINT8 num_in_group;                                                                                     // byte 2
  IncrementalRefreshBtecGroup incremental_refresh_btec_group[:byte-size (((UINT32) num_in_group) * 62)];
} IncrementalRefreshBtecGroups;

// MDIncrementalRefreshBtec
typedef struct _MdIncrementalRefreshBtec {
  UINT16 trade_date;                                             // bytes 0 to 1
  UINT64 transact_time;                                          // bytes 2 to 9
  IncrementalRefreshBtecGroups incremental_refresh_btec_groups;
} MdIncrementalRefreshBtec;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0195: MdIncrementalRefreshBtec md_incremental_refresh_btec;
    case 0x019B: unit admin_heartbeat;
    default: UINT8 unknown[available];
  }
} Payload;

// Cme Market Data Message
typedef struct _Mdp3Message {
  UINT16 message_size { message_size >= 10 };                                                                                    // bytes 0 to 1
  UINT16 block_length;                                                                                                           // bytes 2 to 3
  UINT16 template_id;                                                                                                            // bytes 4 to 5
  UINT16 schema_id;                                                                                                              // bytes 6 to 7
  UINT16 version;                                                                                                                // bytes 8 to 9
  Payload(template_id, (((UINT32) message_size) - 10)) payload[:byte-size-single-element-array (((UINT32) message_size) - 10)];
} Mdp3Message;

// ---- Packet: UdpPacket -------------------------------------------------------

// Cme Mdp Packet
entrypoint typedef struct _UdpPacket (UINT32 available) where (available >= 12) {
  BinaryPacketHeader binary_packet_header;                // bytes 0 to 11
  Mdp3Message mdp3_message[:byte-size (available - 12)];
} UdpPacket;

