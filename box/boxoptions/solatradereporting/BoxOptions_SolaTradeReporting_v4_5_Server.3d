#define TRADE_TYPE_LATE_A_TRADE_ENTERED_BY_THE_BOX_MOC_TO_CORRECT_A_TRADE_EXECUTED_ON_THE_SAME_DAY 0x45   // Late A Trade Entered By The Box Moc To Correct A Trade Executed On The Same Day
