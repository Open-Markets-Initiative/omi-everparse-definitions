// The message the header dispatches to, chosen by its message type.
casetype _ServerMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x3030: unit start_of_day;
    case 0x3032: unit circuit_assurance;
    case 0x3035: unit restart_accepted;
    case 0x3038: unit end_of_trading;
    case 0x3130: ClientSignonAcknowledgment client_signon_acknowledgment;
    case 0x3330: Trade trade;
    case 0x3331: TradeCancel trade_cancel;
    case 0x3430: TradeCancel allocation;
    case 0x3431: TradeCancel allocation_cancel;
    case 0x3530: GiveUp give_up;
    case 0x3531: GiveUpCancel give_up_cancel;
    case 0x3938: unit acknowledgement_message;
    case 0x3939: ErrorMessage error_message;
    default: UINT8 unknown[available];
  }
} ServerMessage;

// ---- Packet: ServerSolaFrame -------------------------------------------------

// One Atr message sent by the Atr server, opened by the header and closed by an end of text
entrypoint typedef struct _ServerSolaFrame (UINT32 available) where (available >= 29) {
  UINT8 source[4];                                                                                                 // bytes 0 to 3
  UINT8 destination[4];                                                                                            // bytes 4 to 7
  UINT16BE message_type;                                                                                           // bytes 8 to 9
  UINT8 message_flag;                                                                                              // byte 10
  UINT8 control_byte;                                                                                              // byte 11
  UINT8 sequence_number[8];                                                                                        // bytes 12 to 19
  UINT8 acknowledgement_sequence_number[8];                                                                        // bytes 20 to 27
  ServerMessage(message_type, (available - 29)) server_message[:byte-size-single-element-array (available - 29)];
  UINT8 sola_message_end { sola_message_end == 3 };
} ServerSolaFrame;

