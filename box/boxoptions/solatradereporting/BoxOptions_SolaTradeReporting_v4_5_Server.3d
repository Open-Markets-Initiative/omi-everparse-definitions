#define TRADE_TYPE_TRADER_CROSSED_ORDERS_A_TRADE_WITH_THE_SAME_TRADER_ID_ON_BOTH_SIDES 0x54               // Trader Crossed Orders A Trade With The Same Trader Id On Both Sides
