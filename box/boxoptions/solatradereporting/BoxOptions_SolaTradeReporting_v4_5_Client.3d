// What this definition reads more loosely than the model states:
// - the stream is a run of frames each ending at a byte 3: the caller splits it there and validates each frame, that byte included

// ---- Values ------------------------------------------------------------------

// Message Type: 2 byte code
#define MESSAGE_TYPE_START_OF_DAY 0x3030                  // Start Of Day
#define MESSAGE_TYPE_START_OF_DAY_ACKNOWLEDGEMENT 0x3031  // Start Of Day Acknowledgement
#define MESSAGE_TYPE_CIRCUIT_ASSURANCE 0x3032             // Circuit Assurance
#define MESSAGE_TYPE_CIRCUIT_RESPONSE 0x3033              // Circuit Response
#define MESSAGE_TYPE_RESTART_REQUEST 0x3034               // Restart Request
#define MESSAGE_TYPE_RESTART_ACCEPTED 0x3035              // Restart Accepted
#define MESSAGE_TYPE_END_OF_TRADING 0x3038                // End Of Trading
#define MESSAGE_TYPE_CLIENT_SIGNON 0x3039                 // Client Signon
#define MESSAGE_TYPE_CLIENT_SIGNON_ACKNOWLEDGMENT 0x3130  // Client Signon Acknowledgment
#define MESSAGE_TYPE_TRADE 0x3330                         // Trade
#define MESSAGE_TYPE_TRADE_CANCEL 0x3331                  // Trade Cancel
#define MESSAGE_TYPE_ALLOCATION 0x3430                    // Allocation
#define MESSAGE_TYPE_ALLOCATION_CANCEL 0x3431             // Allocation Cancel
#define MESSAGE_TYPE_NEW_ALLOCATION 0x3432                // New Allocation
#define MESSAGE_TYPE_MODIFY_ALLOCATION 0x3433             // Modify Allocation
#define MESSAGE_TYPE_DELETE_ALLOCATION 0x3434             // Delete Allocation
#define MESSAGE_TYPE_GIVE_UP 0x3530                       // Give Up
#define MESSAGE_TYPE_GIVE_UP_CANCEL 0x3531                // Give Up Cancel
#define MESSAGE_TYPE_NEW_GIVE_UP 0x3532                   // New Give Up
#define MESSAGE_TYPE_MODIFY_GIVE_UP 0x3533                // Modify Give Up
#define MESSAGE_TYPE_DELETE_GIVE_UP 0x3534                // Delete Give Up
#define MESSAGE_TYPE_ACKNOWLEDGEMENT_MESSAGE 0x3938       // Acknowledgement Message
#define MESSAGE_TYPE_ERROR_MESSAGE 0x3939                 // Error Message

// Message Flag: one byte code
#define MESSAGE_FLAG_RETRANSMITTED_MESSAGE 0x52  // Retransmitted Message
#define MESSAGE_FLAG_DUPLICATED_MESSAGE 0x44     // Duplicated Message

// Account Type: one byte code
#define ACCOUNT_TYPE_PUBLIC_CUSTOMER 0x36                    // Public Customer
#define ACCOUNT_TYPE_BROKER_DEALER 0x37                      // Broker Dealer
#define ACCOUNT_TYPE_MARKET_MAKER 0x38                       // Market Maker
#define ACCOUNT_TYPE_PROFESSIONAL_CUSTOMER 0x54              // Professional Customer
#define ACCOUNT_TYPE_FLOOR_BROKER_CUSTOMER 0x56              // Floor Broker Customer
#define ACCOUNT_TYPE_BROKER_DEALER_CLEARED_AS_CUSTOMER 0x57  // Broker Dealer Cleared As Customer
#define ACCOUNT_TYPE_AWAY_MARKET_MAKER 0x58                  // Away Market Maker
#define ACCOUNT_TYPE_FLOOR_BROKER_DEALER 0x59                // Floor Broker Dealer
#define ACCOUNT_TYPE_FLOOR_MARKET_MAKER 0x5A                 // Floor Market Maker

// Open Close: one byte code
#define OPEN_CLOSE_OPEN 0x4F   // Open
#define OPEN_CLOSE_CLOSE 0x43  // Close

// ---- Types -------------------------------------------------------------------

typedef struct _RestartRequest {
  UINT8 sequence_number[8];  // bytes 0 to 7
} RestartRequest;

typedef struct _ClientSignon {
  UINT8 member_number[4];             // bytes 0 to 3
  UINT8 initial_sequence_number[8];   // bytes 4 to 11
  UINT8 protocol_version[2];          // bytes 12 to 13
  UINT8 time[6];                      // bytes 14 to 19
  UINT8 username[8];                  // bytes 20 to 27
  UINT8 password_md_5_encryption[8];  // bytes 28 to 35
} ClientSignon;

// The guide heads this message 106 bytes, while the fields it states measure 122 including the 28 byte header.
typedef struct _NewAllocation {
  UINT8 reference_transaction_id[10];  // bytes 0 to 9
  UINT8 reference_trade_number[15];    // bytes 10 to 24
  UINT8 give_up_firm[4];               // bytes 25 to 28
  UINT8 volume[8];                     // bytes 29 to 36
  UINT8 account_type;                  // byte 37
  UINT8 open_close;                    // byte 38
  UINT8 client_account_number[12];     // bytes 39 to 50
  UINT8 sub_trader_id[3];              // bytes 51 to 53
  UINT8 cmta_broker[4];                // bytes 54 to 57
  UINT8 client_memo[16];               // bytes 58 to 73
  UINT8 additional_firm[4];            // bytes 74 to 77
  UINT8 additional_client_memo[16];    // bytes 78 to 93
} NewAllocation;

// The guide states this message as having the same structure as message type 42, whose fields are written out here. The guide heads this message 106 bytes, while the fields it states measure 122 including the 28 byte header.
typedef struct _ModifyAllocation {
  UINT8 reference_transaction_id[10];  // bytes 0 to 9
  UINT8 reference_trade_number[15];    // bytes 10 to 24
  UINT8 give_up_firm[4];               // bytes 25 to 28
  UINT8 volume[8];                     // bytes 29 to 36
  UINT8 account_type;                  // byte 37
  UINT8 open_close;                    // byte 38
  UINT8 client_account_number[12];     // bytes 39 to 50
  UINT8 sub_trader_id[3];              // bytes 51 to 53
  UINT8 cmta_broker[4];                // bytes 54 to 57
  UINT8 client_memo[16];               // bytes 58 to 73
  UINT8 additional_firm[4];            // bytes 74 to 77
  UINT8 additional_client_memo[16];    // bytes 78 to 93
} ModifyAllocation;

typedef struct _DeleteAllocation {
  UINT8 reference_transaction_id[10];  // bytes 0 to 9
  UINT8 reference_trade_number[15];    // bytes 10 to 24
} DeleteAllocation;

// The guide states this message as having the same structure as message type 44, whose fields are written out here.
typedef struct _DeleteGiveUp {
  UINT8 reference_transaction_id[10];  // bytes 0 to 9
  UINT8 reference_trade_number[15];    // bytes 10 to 24
} DeleteGiveUp;

// The message the header dispatches to, chosen by its message type.
casetype _ClientMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x3031: unit start_of_day_acknowledgement;
    case 0x3033: unit circuit_response;
    case 0x3034: RestartRequest restart_request;
    case 0x3039: ClientSignon client_signon;
    case 0x3432: NewAllocation new_allocation;
    case 0x3433: ModifyAllocation modify_allocation;
    case 0x3434: DeleteAllocation delete_allocation;
    case 0x3532: ModifyAllocation new_give_up;
    case 0x3533: ModifyAllocation modify_give_up;
    case 0x3534: DeleteGiveUp delete_give_up;
    default: UINT8 unknown[available];
  }
} ClientMessage;

// ---- Packet: ClientSolaFrame -------------------------------------------------

// One Atr message sent by the participant, opened by the header and closed by an end of text
entrypoint typedef struct _ClientSolaFrame (UINT32 available) where (available >= 29) {
  UINT8 source[4];                                                                                                 // bytes 0 to 3
  UINT8 destination[4];                                                                                            // bytes 4 to 7
  UINT16BE message_type;                                                                                           // bytes 8 to 9
  UINT8 message_flag;                                                                                              // byte 10
  UINT8 control_byte;                                                                                              // byte 11
  UINT8 sequence_number[8];                                                                                        // bytes 12 to 19
  UINT8 acknowledgement_sequence_number[8];                                                                        // bytes 20 to 27
  ClientMessage(message_type, (available - 29)) client_message[:byte-size-single-element-array (available - 29)];
  UINT8 sola_message_end { sola_message_end == 3 };
} ClientSolaFrame;

