// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out BoxOptions_SolaUnicast_v4_5_1.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - a run counted by a field
// - a Composite rule
// - the packet as a whole, which is a length or count spelled as text, which 3d cannot read as a number, at packet.solaframe.messagebody.connectionmessage.numberofoptionclassesrequested

// ---- Values ------------------------------------------------------------------

// Expiry Month Code: one byte code
#define EXPIRY_MONTH_CODE_JANUARY_PUT 0x4D    // January Put
#define EXPIRY_MONTH_CODE_FEBRUARY_PUT 0x4E   // February Put
#define EXPIRY_MONTH_CODE_MARCH_PUT 0x4F      // March Put
#define EXPIRY_MONTH_CODE_APRIL_PUT 0x50      // April Put
#define EXPIRY_MONTH_CODE_MAY_PUT 0x51        // May Put
#define EXPIRY_MONTH_CODE_JUNE_PUT 0x52       // June Put
#define EXPIRY_MONTH_CODE_JULY_PUT 0x53       // July Put
#define EXPIRY_MONTH_CODE_AUGUST_PUT 0x54     // August Put
#define EXPIRY_MONTH_CODE_SEPTEMBER_PUT 0x55  // September Put
#define EXPIRY_MONTH_CODE_OCTOBER_PUT 0x56    // October Put
#define EXPIRY_MONTH_CODE_NOVEMBER_PUT 0x57   // November Put

// Strike Price Fraction Indicator: one byte code
#define STRIKE_PRICE_FRACTION_INDICATOR_WHOLE 0x30                      // Whole
#define STRIKE_PRICE_FRACTION_INDICATOR_TEN 0x31                        // Ten
#define STRIKE_PRICE_FRACTION_INDICATOR_HUNDRED 0x32                    // Hundred
#define STRIKE_PRICE_FRACTION_INDICATOR_THOUSAND 0x33                   // Thousand
#define STRIKE_PRICE_FRACTION_INDICATOR_TEN_THOUSAND 0x34               // Ten Thousand
#define STRIKE_PRICE_FRACTION_INDICATOR_HUNDRED_THOUSAND 0x35           // Hundred Thousand
#define STRIKE_PRICE_FRACTION_INDICATOR_MILLION 0x36                    // Million
#define STRIKE_PRICE_FRACTION_INDICATOR_TEN_MILLION 0x37                // Ten Million
#define STRIKE_PRICE_FRACTION_INDICATOR_HUNDRED_MILLION 0x38            // Hundred Million
#define STRIKE_PRICE_FRACTION_INDICATOR_BILLION 0x39                    // Billion
#define STRIKE_PRICE_FRACTION_INDICATOR_NEGATIVE_WHOLE 0x41             // Negative Whole
#define STRIKE_PRICE_FRACTION_INDICATOR_NEGATIVE_TEN 0x42               // Negative Ten
#define STRIKE_PRICE_FRACTION_INDICATOR_NEGATIVE_HUNDRED 0x43           // Negative Hundred
#define STRIKE_PRICE_FRACTION_INDICATOR_NEGATIVE_THOUSAND 0x44          // Negative Thousand
#define STRIKE_PRICE_FRACTION_INDICATOR_NEGATIVE_TEN_THOUSAND 0x45      // Negative Ten Thousand
#define STRIKE_PRICE_FRACTION_INDICATOR_NEGATIVE_HUNDRED_THOUSAND 0x46  // Negative Hundred Thousand
#define STRIKE_PRICE_FRACTION_INDICATOR_NEGATIVE_MILLION 0x47           // Negative Million

// Type Of Instrument: one byte code
#define TYPE_OF_INSTRUMENT_OPTIONS 0x4F    // Options
#define TYPE_OF_INSTRUMENT_LONG_TERM 0x4C  // Long Term

// Type Of Underlying: one byte code
#define TYPE_OF_UNDERLYING_INDEX 0x58     // Index
#define TYPE_OF_UNDERLYING_EQUITIES 0x45  // Equities

// Type Of Options: one byte code
#define TYPE_OF_OPTIONS_REGULAR 0x20  // Regular

// Group Status: one byte code
#define GROUP_STATUS_PREOPENING_PHASE 0x59                 // Preopening Phase
#define GROUP_STATUS_OPENING_PHASE 0x4F                    // Opening Phase
#define GROUP_STATUS_OPENED_FOR_TRADING 0x54               // Opened For Trading
#define GROUP_STATUS_FORBIDDEN_PHASE 0x46                  // Forbidden Phase
#define GROUP_STATUS_TRADING_HALTED 0x48                   // Trading Halted
#define GROUP_STATUS_SURVEILLANCE_INTERVENTION_PHASE 0x41  // Surveillance Intervention Phase
#define GROUP_STATUS_CLOSED 0x43                           // Closed
#define GROUP_STATUS_BEGINNING_OF_DAY_INQUIRIES 0x42       // Beginning Of Day Inquiries

// Bulletin Type: one byte code
#define BULLETIN_TYPE_REGULAR 0x31  // Regular
#define BULLETIN_TYPE_SPECIAL 0x32  // Special

// Continue Marker: one byte code
#define CONTINUE_MARKER_BULLETIN_CONTINUES_IN_NEXT_RECORD 0x30  // Bulletin Continues In Next Record
#define CONTINUE_MARKER_BULLETIN_ENDED 0x31                     // Bulletin Ended

// Initial Order Price Fraction Indicator: one byte code
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_WHOLE 0x30                      // Whole
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_TEN 0x31                        // Ten
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_HUNDRED 0x32                    // Hundred
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_THOUSAND 0x33                   // Thousand
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_TEN_THOUSAND 0x34               // Ten Thousand
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_HUNDRED_THOUSAND 0x35           // Hundred Thousand
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_MILLION 0x36                    // Million
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_TEN_MILLION 0x37                // Ten Million
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_HUNDRED_MILLION 0x38            // Hundred Million
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_BILLION 0x39                    // Billion
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_NEGATIVE_WHOLE 0x41             // Negative Whole
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_NEGATIVE_TEN 0x42               // Negative Ten
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_NEGATIVE_HUNDRED 0x43           // Negative Hundred
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_NEGATIVE_THOUSAND 0x44          // Negative Thousand
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_NEGATIVE_TEN_THOUSAND 0x45      // Negative Ten Thousand
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_NEGATIVE_HUNDRED_THOUSAND 0x46  // Negative Hundred Thousand
#define INITIAL_ORDER_PRICE_FRACTION_INDICATOR_NEGATIVE_MILLION 0x47           // Negative Million

// Initial Order Side: one byte code
#define INITIAL_ORDER_SIDE_BUY 0x42   // Buy
#define INITIAL_ORDER_SIDE_SELL 0x53  // Sell

// Auction Type: one byte code
#define AUCTION_TYPE_REGULAR_PIP 0x47    // Regular Pip
#define AUCTION_TYPE_SOLICITATION 0x42   // Solicitation
#define AUCTION_TYPE_FACILITATION 0x43   // Facilitation
#define AUCTION_TYPE_EXPOSED_ORDER 0x46  // Exposed Order

// Initial Order Price Sign: one byte code
#define INITIAL_ORDER_PRICE_SIGN_POSITIVE 0x2B  // Positive
#define INITIAL_ORDER_PRICE_SIGN_NEGATIVE 0x2D  // Negative

// Deletion Type: one byte code
#define DELETION_TYPE_PRECISE_ORDER 0x31                              // Precise Order
#define DELETION_TYPE_ALL_PREVIOUS_ORDERS_IN_THE_SPECIFIED_SIDE 0x32  // All Previous Orders In The Specified Side
#define DELETION_TYPE_ALL_ORDERS 0x33                                 // All Orders

// Improvement Order Side: one byte code
#define IMPROVEMENT_ORDER_SIDE_BUY 0x42   // Buy
#define IMPROVEMENT_ORDER_SIDE_SELL 0x53  // Sell
#define IMPROVEMENT_ORDER_SIDE_ALL 0x20   // All

// Order Side: one byte code
#define ORDER_SIDE_BUY 0x42   // Buy
#define ORDER_SIDE_SELL 0x53  // Sell

// ---- Message Header: 11 bytes ------------------------------------------------

// Standard Hsvf message header
entrypoint typedef struct _MessageHeader {
  UINT8 sequence_number[9];  // bytes 0 to 8
  UINT8 message_type[2];     // bytes 9 to 10
} MessageHeader;

// ---- End Of Transmission Message: 7 bytes ------------------------------------

// This message will be sent to indicate that the day's transmission is complete
entrypoint typedef struct _EndOfTransmissionMessage {
  UINT8 exchange_id;  // byte 0
  UINT8 time[6];      // bytes 1 to 6
} EndOfTransmissionMessage;

// ---- Circuit Assurance Message: 6 bytes --------------------------------------

// This message is sent out if no messages are sent by BOX for more than one second after the broadcast has started
entrypoint typedef struct _CircuitAssuranceMessage {
  UINT8 time[6];  // bytes 0 to 5
} CircuitAssuranceMessage;

// ---- Gap Sequence Message: 9 bytes -------------------------------------------

// The Gap message signals the beginning and ending sequence numbers of messages relating to classes different from those subscribed to during the connection message
entrypoint typedef struct _GapSequenceMessage {
  UINT8 sequence_numbers_skipped[9];  // bytes 0 to 8
} GapSequenceMessage;

// ---- System Timestamp Message: 9 bytes ---------------------------------------

// This message is sent out every second and contains the time stamp when it was originally transmitted by the trading engine
entrypoint typedef struct _SystemTimestampMessage {
  UINT8 trading_engine_timestamp[9];  // bytes 0 to 8
} SystemTimestampMessage;

// ---- Instrument Description: 20 bytes ----------------------------------------

entrypoint typedef struct _InstrumentDescription {
  UINT8 root_symbol[6];                   // bytes 0 to 5
  UINT8 expiry_month_code;                // byte 6, values EXPIRY_MONTH_CODE_
  UINT8 filler_1;                         // byte 7
  UINT8 strike_price[7];                  // bytes 8 to 14
  UINT8 strike_price_fraction_indicator;  // byte 15, values STRIKE_PRICE_FRACTION_INDICATOR_
  UINT8 expiry_year[2];                   // bytes 16 to 17
  UINT8 expiry_day[2];                    // bytes 18 to 19
} InstrumentDescription;

// ---- Market Flow Indicator: 2 bytes ------------------------------------------

entrypoint typedef struct _MarketFlowIndicator {
  UINT8 type_of_instrument;  // byte 0, values TYPE_OF_INSTRUMENT_
  UINT8 type_of_underlying;  // byte 1, values TYPE_OF_UNDERLYING_
} MarketFlowIndicator;

// ---- Option Marker: 2 bytes --------------------------------------------------

entrypoint typedef struct _OptionMarker {
  UINT8 type_of_market;   // byte 0
  UINT8 type_of_options;  // byte 1, values TYPE_OF_OPTIONS_
} OptionMarker;

// ---- Beginning Of Options Summary Message: 1 byte ----------------------------

// This message indicates that the beginning and the end of day option summaries
entrypoint typedef struct _BeginningOfOptionsSummaryMessage {
  UINT8 exchange_id;  // byte 0
} BeginningOfOptionsSummaryMessage;

// ---- Beginning Of Complex Order Summary Message: 1 byte ----------------------

// This message indicates that the beginning and the end of day Complex Order summaries
entrypoint typedef struct _BeginningOfComplexOrderSummaryMessage {
  UINT8 exchange_id;  // byte 0
} BeginningOfComplexOrderSummaryMessage;

// ---- Group Opening Time Message: 14 bytes ------------------------------------

// Group Opening Time
entrypoint typedef struct _GroupOpeningTimeMessage {
  UINT8 exchange_id;        // byte 0
  UINT8 root_symbol[6];     // bytes 1 to 6
  UINT8 group_status;       // byte 7, values GROUP_STATUS_
  UINT8 scheduled_time[6];  // bytes 8 to 13
} GroupOpeningTimeMessage;

// ---- Group Status Message: 8 bytes -------------------------------------------

// This message will be sent when a group of trading instruments enters a new status
entrypoint typedef struct _GroupStatusMessage {
  UINT8 exchange_id;     // byte 0
  UINT8 root_symbol[6];  // bytes 1 to 6
  UINT8 group_status;    // byte 7, values GROUP_STATUS_
} GroupStatusMessage;

// ---- Complex Order Group Status Message: 4 bytes -----------------------------

// This message will be sent when a group of complex trading instruments enters a new status
entrypoint typedef struct _ComplexOrderGroupStatusMessage {
  UINT8 exchange_id;                               // byte 0
  UINT8 group_of_the_complex_order_instrument[2];  // bytes 1 to 2
  UINT8 group_status;                              // byte 3, values GROUP_STATUS_
} ComplexOrderGroupStatusMessage;

// ---- Bulletins Message: 82 bytes ---------------------------------------------

// When a Trading instrument has been halted by BOX, a Bulletin Message explaining the reason for the halt will be transmitted.
entrypoint typedef struct _BulletinsMessage {
  UINT8 filler_1;               // byte 0
  UINT8 bulletin_type;          // byte 1, values BULLETIN_TYPE_
  UINT8 bulletin_contents[79];  // bytes 2 to 80
  UINT8 continue_marker;        // byte 81, values CONTINUE_MARKER_
} BulletinsMessage;

// ---- End Of Sales Message: 7 bytes -------------------------------------------

// This message is sent when there is no more trading activity to be transmitted
entrypoint typedef struct _EndOfSalesMessage {
  UINT8 reserved;  // byte 0
  UINT8 time[6];   // bytes 1 to 6
} EndOfSalesMessage;

// ---- Option Improvement Process Beginning Message: 73 bytes ------------------

// Start of Option Improvement Process
entrypoint typedef struct _OptionImprovementProcessBeginningMessage {
  UINT8 exchange_id;                                // byte 0
  InstrumentDescription instrument_description;     // bytes 1 to 20
  UINT8 improvement_phase_sequential_number[6];     // bytes 21 to 26
  UINT8 initial_order_price[6];                     // bytes 27 to 32
  UINT8 initial_order_price_fraction_indicator;     // byte 33, values INITIAL_ORDER_PRICE_FRACTION_INDICATOR_
  UINT8 initial_order_quantity[8];                  // bytes 34 to 41
  UINT8 initial_order_side;                         // byte 42, values INITIAL_ORDER_SIDE_
  UINT8 improvement_phase_expiry_time[8];           // bytes 43 to 50
  UINT8 improvement_process_expiry_duration[4];     // bytes 51 to 54
  UINT8 minimum_quantity_for_improvement_order[8];  // bytes 55 to 62
  UINT8 percentage_assured_to_initial_order[8];     // bytes 63 to 70
  UINT8 auction_type;                               // byte 71, values AUCTION_TYPE_
  UINT8 filler_1;                                   // byte 72
} OptionImprovementProcessBeginningMessage;

// ---- Complex Order Improvement Process Beginning Message Message: 83 bytes ----

// Complex Order Improvement Process Beginning Message
entrypoint typedef struct _ComplexOrderImprovementProcessBeginningMessageMessage {
  UINT8 exchange_id;                                // byte 0
  UINT8 complex_order_instrument_symbol[30];        // bytes 1 to 30
  UINT8 improvement_phase_sequential_number[6];     // bytes 31 to 36
  UINT8 initial_order_price_sign;                   // byte 37, values INITIAL_ORDER_PRICE_SIGN_
  UINT8 initial_order_price[6];                     // bytes 38 to 43
  UINT8 initial_order_price_fraction_indicator;     // byte 44, values INITIAL_ORDER_PRICE_FRACTION_INDICATOR_
  UINT8 initial_order_quantity[8];                  // bytes 45 to 52
  UINT8 initial_order_side;                         // byte 53, values INITIAL_ORDER_SIDE_
  UINT8 improvement_phase_expiry_time[8];           // bytes 54 to 61
  UINT8 improvement_process_expiry_duration[4];     // bytes 62 to 65
  UINT8 minimum_quantity_for_improvement_order[8];  // bytes 66 to 73
  UINT8 percentage_assured_to_initial_order[8];     // bytes 74 to 81
  UINT8 auction_type;                               // byte 82, values AUCTION_TYPE_
} ComplexOrderImprovementProcessBeginningMessageMessage;

// ---- Initial And Improvement Order Message: 36 bytes -------------------------

// Initial and Improvement Order (Options) / Exposed Order
entrypoint typedef struct _InitialAndImprovementOrderMessage {
  UINT8 exchange_id;                             // byte 0
  InstrumentDescription instrument_description;  // bytes 1 to 20
  UINT8 deletion_type;                           // byte 21, values DELETION_TYPE_
  UINT8 order_sequence_number[6];                // bytes 22 to 27
  UINT8 improvement_order_side;                  // byte 28, values IMPROVEMENT_ORDER_SIDE_
  UINT8 improvement_phase_sequential_number[6];  // bytes 29 to 34
  UINT8 auction_type;                            // byte 35, values AUCTION_TYPE_
} InitialAndImprovementOrderMessage;

// ---- Complex Order Initial And Improvement Order Message: 46 bytes -----------

// Initial and Improvement Order (Complex Order) / Exposed Order (Complex Order)
entrypoint typedef struct _ComplexOrderInitialAndImprovementOrderMessage {
  UINT8 exchange_id;                             // byte 0
  UINT8 complex_order_instrument_symbol[30];     // bytes 1 to 30
  UINT8 deletion_type;                           // byte 31, values DELETION_TYPE_
  UINT8 order_sequence_number[6];                // bytes 32 to 37
  UINT8 order_side;                              // byte 38, values ORDER_SIDE_
  UINT8 improvement_phase_sequential_number[6];  // bytes 39 to 44
  UINT8 auction_type;                            // byte 45, values AUCTION_TYPE_
} ComplexOrderInitialAndImprovementOrderMessage;

