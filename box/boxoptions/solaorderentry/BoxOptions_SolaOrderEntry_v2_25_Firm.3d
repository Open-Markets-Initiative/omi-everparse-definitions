// Account Type: one byte code
#define ACCOUNT_TYPE_PUBLIC_CUSTOMER 0x36                    // Public Customer
#define ACCOUNT_TYPE_BROKER_DEALER 0x37                      // Broker Dealer
#define ACCOUNT_TYPE_MARKET_MAKER 0x38                       // Market Maker
#define ACCOUNT_TYPE_PROFESSIONAL_CUSTOMER 0x54              // Professional Customer
#define ACCOUNT_TYPE_BROKER_DEALER_CLEARED_AS_CUSTOMER 0x57  // Broker Dealer Cleared As Customer
#define ACCOUNT_TYPE_AWAY_MARKET_MAKER 0x58                  // Away Market Maker

// Open Close: one byte code
#define OPEN_CLOSE_CLOSE_ALL_LEGS_OR_SINGLE_INSTRUMENT 0x43                                               // Close All Legs Or Single Instrument
#define OPEN_CLOSE_OPEN_ALL_LEGS_OR_SINGLE_INSTRUMENT_FOR_COMPLEX_ORDERS_MUST_BE_USED_IT_IND_8dpssz 0x4F  // Open All Legs Or Single Instrument For Complex Orders Must Be Used It Indicates That The Open Close Positions Are Specified In The Post Trading Instruction Field For Legacy Support The Following Values Are Still Supported For Complex Orders
#define OPEN_CLOSE_LEGS_1_ST_LEG_OPEN_2_ND_LEG_CLOSE 0x31                                                 // Legs 1 St Leg Open 2 Nd Leg Close
#define OPEN_CLOSE_LEGS_1_ST_LEG_CLOSE_2_ND_LEG_OPEN 0x32                                                 // Legs 1 St Leg Close 2 Nd Leg Open
#define OPEN_CLOSE_LEGS_1_ST_LEG_OPEN_2_ND_LEG_OPEN_3_RD_LEG_CLOSE 0x33                                   // Legs 1 St Leg Open 2 Nd Leg Open 3 Rd Leg Close
#define OPEN_CLOSE_LEGS_1_ST_LEG_OPEN_2_ND_LEG_CLOSE_3_RD_LEG_OPEN 0x34                                   // Legs 1 St Leg Open 2 Nd Leg Close 3 Rd Leg Open
#define OPEN_CLOSE_LEGS_1_ST_LEG_OPEN_2_ND_LEG_CLOSE_3_RD_LEG_CLOSE 0x35                                  // Legs 1 St Leg Open 2 Nd Leg Close 3 Rd Leg Close
#define OPEN_CLOSE_LEGS_1_ST_LEG_CLOSE_2_ND_LEG_OPEN_3_RD_LEG_OPEN 0x36                                   // Legs 1 St Leg Close 2 Nd Leg Open 3 Rd Leg Open
#define OPEN_CLOSE_LEGS_1_ST_LEG_CLOSE_2_ND_LEG_OPEN_3_RD_LEG_CLOSE 0x37                                  // Legs 1 St Leg Close 2 Nd Leg Open 3 Rd Leg Close
#define OPEN_CLOSE_LEGS_1_ST_LEG_CLOSE_2_ND_LEG_CLOSE_3_RD_LEG_OPEN 0x38                                  // Legs 1 St Leg Close 2 Nd Leg Close 3 Rd Leg Open
#define OPEN_CLOSE_LEGS_1_ST_LEG_OPEN_2_ND_LEG_OPEN_3_RD_LEG_OPEN_4_TH_LEG_CLOSE 0x41                     // Legs 1 St Leg Open 2 Nd Leg Open 3 Rd Leg Open 4 Th Leg Close
#define OPEN_CLOSE_LEGS_1_ST_LEG_OPEN_2_ND_LEG_OPEN_3_RD_LEG_CLOSE_4_TH_LEG_OPEN 0x42                     // Legs 1 St Leg Open 2 Nd Leg Open 3 Rd Leg Close 4 Th Leg Open
#define OPEN_CLOSE_LEGS_1_ST_LEG_OPEN_2_ND_LEG_OPEN_3_RD_LEG_CLOSE_4_TH_LEG_CLOSE 0x44                    // Legs 1 St Leg Open 2 Nd Leg Open 3 Rd Leg Close 4 Th Leg Close
#define OPEN_CLOSE_LEGS_1_ST_LEG_OPEN_2_ND_LEG_CLOSE_3_RD_LEG_OPEN_4_TH_LEG_OPEN 0x45                     // Legs 1 St Leg Open 2 Nd Leg Close 3 Rd Leg Open 4 Th Leg Open
#define OPEN_CLOSE_LEGS_1_ST_LEG_OPEN_2_ND_LEG_CLOSE_3_RD_LEG_OPEN_4_TH_LEG_CLOSE 0x46                    // Legs 1 St Leg Open 2 Nd Leg Close 3 Rd Leg Open 4 Th Leg Close
#define OPEN_CLOSE_LEGS_1_ST_LEG_OPEN_2_ND_LEG_CLOSE_3_RD_LEG_CLOSE_4_TH_LEG_OPEN 0x47                    // Legs 1 St Leg Open 2 Nd Leg Close 3 Rd Leg Close 4 Th Leg Open
#define OPEN_CLOSE_LEGS_1_ST_LEG_OPEN_2_ND_LEG_CLOSE_3_RD_LEG_CLOSE_4_TH_LEG_CLOSE 0x48                   // Legs 1 St Leg Open 2 Nd Leg Close 3 Rd Leg Close 4 Th Leg Close
#define OPEN_CLOSE_LEGS_1_ST_LEG_CLOSE_2_ND_LEG_OPEN_3_RD_LEG_OPEN_4_TH_LEG_OPEN 0x49                     // Legs 1 St Leg Close 2 Nd Leg Open 3 Rd Leg Open 4 Th Leg Open
#define OPEN_CLOSE_LEGS_1_ST_LEG_CLOSE_2_ND_LEG_OPEN_3_RD_LEG_OPEN_4_TH_LEG_CLOSE 0x4A                    // Legs 1 St Leg Close 2 Nd Leg Open 3 Rd Leg Open 4 Th Leg Close
#define OPEN_CLOSE_LEGS_1_ST_LEG_CLOSE_2_ND_LEG_OPEN_3_RD_LEG_CLOSE_4_TH_LEG_OPEN 0x4B                    // Legs 1 St Leg Close 2 Nd Leg Open 3 Rd Leg Close 4 Th Leg Open
#define OPEN_CLOSE_LEGS_1_ST_LEG_CLOSE_2_ND_LEG_OPEN_3_RD_LEG_CLOSE_4_TH_LEG_CLOSE 0x4C                   // Legs 1 St Leg Close 2 Nd Leg Open 3 Rd Leg Close 4 Th Leg Close
#define OPEN_CLOSE_LEGS_1_ST_LEG_CLOSE_2_ND_LEG_CLOSE_3_RD_LEG_OPEN_4_TH_LEG_OPEN 0x4D                    // Legs 1 St Leg Close 2 Nd Leg Close 3 Rd Leg Open 4 Th Leg Open
#define OPEN_CLOSE_LEGS_1_ST_LEG_CLOSE_2_ND_LEG_CLOSE_3_RD_LEG_OPEN_4_TH_LEG_CLOSE 0x4E                   // Legs 1 St Leg Close 2 Nd Leg Close 3 Rd Leg Open 4 Th Leg Close
#define OPEN_CLOSE_LEGS_1_ST_LEG_CLOSE_2_ND_LEG_CLOSE_3_RD_LEG_CLOSE_4_TH_LEG_OPEN 0x50                   // Legs 1 St Leg Close 2 Nd Leg Close 3 Rd Leg Close 4 Th Leg Open

// Hedge Spec: one byte code
#define HEDGE_SPEC_HEDGER 0x48      // Hedger
#define HEDGE_SPEC_SPECULATOR 0x53  // Speculator

// Clearing Operation Mode: one byte code
#define CLEARING_OPERATION_MODE_NO_CLEARING_OPERATION 0x20                                                             // No Clearing Operation
#define CLEARING_OPERATION_MODE_CMTA_CLEARING_MEMBER_TRADING_AGREEMENT_FIRM_WILL_BE_DEFINED_IN_THE_CLEARI_3vux82 0x43  // Cmta Clearing Member Trading Agreement Firm Will Be Defined In The Clearing Destination Field
#define CLEARING_OPERATION_MODE_GIVE_UP_FIRM_WILL_BE_DEFINED_IN_THE_CLEARING_DESTINATION_FIELD 0x47                    // Give Up Firm Will Be Defined In The Clearing Destination Field
#define CLEARING_OPERATION_MODE_BOTH_CMTA_AND_GIVE_UP_FIRMS_WILL_BE_DEFINED_IN_THE_POST_TRADING_INSTRUCTI_34yfxs 0x49  // Both Cmta And Give Up Firms Will Be Defined In The Post Trading Instruction Field The Guide States No Width For This Type One Character Is Inferred From The Values It States Each Of Which Is One Character Wide

// Type Of Cancellation: one byte code
#define TYPE_OF_CANCELLATION_ALL 0x41          // All
#define TYPE_OF_CANCELLATION_LOCKED 0x4C       // Locked
#define TYPE_OF_CANCELLATION_ORDERS_ONLY 0x4F  // Orders Only
#define TYPE_OF_CANCELLATION_QUOTES_ONLY 0x51  // Quotes Only

// Verb Side: one byte code
#define VERB_SIDE_BUY 0x42   // Buy
#define VERB_SIDE_SELL 0x53  // Sell

// Special Price Term: one byte code
#define SPECIAL_PRICE_TERM_SOLICITATION_AUCTION 0x42                                      // Solicitation Auction
#define SPECIAL_PRICE_TERM_FACILITATION_AUCTION 0x43                                      // Facilitation Auction
#define SPECIAL_PRICE_TERM_REGULAR_PIP 0x47                                               // Regular Pip
#define SPECIAL_PRICE_TERM_CUSTOMER_CROSS_ORDER_OR_QUALIFIED_CONTINGENT_CROSS_ORDER 0x58  // Customer Cross Order Or Qualified Contingent Cross Order
#define SPECIAL_PRICE_TERM_DIRECTED_ORDER 0x4F                                            // Directed Order
#define SPECIAL_PRICE_TERM_PREFERENCED_ORDER 0x50                                         // Preferenced Order
#define SPECIAL_PRICE_TERM_FLOOR_TRADE 0x52                                               // Floor Trade
#define SPECIAL_PRICE_TERM_INDICATION_OF_INTEREST 0x41                                    // Indication Of Interest

// Quantity Term: one byte code
#define QUANTITY_TERM_SURRENDER_QUANTITY_FOR_SOLICITATION_FACILITATION_AND_FLOOR_TRADE 0x42                  // Surrender Quantity For Solicitation Facilitation And Floor Trade
#define QUANTITY_TERM_INDICATES_THAT_THE_AUCTION_TYPE_AS_MIP 0x4A                                            // Indicates That The Auction Type As Mip
#define QUANTITY_TERM_NONE_THE_ABOVE_VALUE_INDICATES_THAT_THE_INIT_O_IS_WILLING_TO_SURRENDER_A__1mr1z7 0x20  // None The Above Value Indicates That The Init O Is Willing To Surrender A Portion Of The Total Number Of Contracts

// Price Type: one byte code
#define PRICE_TYPE_LIMIT_PRICE_SET_IN_MESSAGE 0x4C  // Limit Price Set In Message
#define PRICE_TYPE_AT_OPENING_PRICE 0x4F            // At Opening Price
#define PRICE_TYPE_AT_ANY_PRICE_MARKET_ORDER 0x57   // At Any Price Market Order

// Duration Type: one byte code
#define DURATION_TYPE_AUCTION_OR_KILL 0x41                           // Auction Or Kill
#define DURATION_TYPE_ORDER_IS_VALID_UNTIL_GTD_DATE_GTD 0x44         // Order Is Valid Until Gtd Date Gtd
#define DURATION_TYPE_IMMEDIATE_ORDER_CANNOT_BE_BOOKED_FAK 0x45      // Immediate Order Cannot Be Booked Fak
#define DURATION_TYPE_VALID_UNTIL_INSTRUMENT_EXPIRATION_GTC 0x46     // Valid Until Instrument Expiration Gtc
#define DURATION_TYPE_VALID_FOR_THE_CURRENT_DAY_ONLY_DAY 0x4A        // Valid For The Current Day Only Day
#define DURATION_TYPE_VALID_FOR_THE_CURRENT_SESSION_ORDER_ONLY 0x57  // Valid For The Current Session Order Only

// Protection Type Advanced Normal: one byte code
#define PROTECTION_TYPE_ADVANCED_NORMAL_ADVANCED_PROTECTION 0x41           // Advanced Protection
#define PROTECTION_TYPE_ADVANCED_NORMAL_FUNCTIONALLY_EQUIVALENT_TO_N 0x43  // Functionally Equivalent To N
#define PROTECTION_TYPE_ADVANCED_NORMAL_STANDARD_PROTECTION 0x4E           // Standard Protection

