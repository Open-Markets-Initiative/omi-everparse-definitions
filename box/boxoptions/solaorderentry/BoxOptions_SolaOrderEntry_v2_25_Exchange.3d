// ---- Outgoing Header: 30 bytes -----------------------------------------------

// The header on all outgoing exchange messages
entrypoint typedef struct _OutgoingHeader {
  UINT8 message_type[2];         // bytes 0 to 1
  UINT8 message_timestamp[6];    // bytes 2 to 7
  UINT8 user_sequence_i_d[8];    // bytes 8 to 15
  UINT8 exchange_message_id[6];  // bytes 16 to 21
  UINT8 gap_sequence_i_d[2];     // bytes 22 to 23
  UINT8 system_sequence_i_d[6];  // bytes 24 to 29
} OutgoingHeader;

// ---- Heartbeat Question: 20 bytes --------------------------------------------

entrypoint typedef struct _HeartbeatQuestion {
  UINT8 first_user_sequence_i_d[8];                       // bytes 0 to 7
  UINT8 last_exchange_message_id_sent_to_participant[6];  // bytes 8 to 13
  UINT8 time_local[6];                                    // bytes 14 to 19
} HeartbeatQuestion;

// ---- Out Of Sequence: 22 bytes -----------------------------------------------

entrypoint typedef struct _OutOfSequence {
  UINT8 received_user_sequence_id[8];       // bytes 0 to 7
  UINT8 expected_last_user_sequence_id[8];  // bytes 8 to 15
  UINT8 message_time_local[6];              // bytes 16 to 21
} OutOfSequence;

// ---- Technical Error Notice: 218 bytes ---------------------------------------

entrypoint typedef struct _TechnicalErrorNotice {
  UINT8 received_message_type[2];                 // bytes 0 to 1
  UINT8 preceding_user_sequence_i_d_received[8];  // bytes 2 to 9
  UINT8 error_code[4];                            // bytes 10 to 13
  UINT8 error_position[4];                        // bytes 14 to 17
  UINT8 error_message[100];                       // bytes 18 to 117
  UINT8 start_of_message_in_error[100];           // bytes 118 to 217
} TechnicalErrorNotice;

