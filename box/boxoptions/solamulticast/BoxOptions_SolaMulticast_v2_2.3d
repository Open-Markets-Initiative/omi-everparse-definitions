// ---- Message Header: 11 bytes ------------------------------------------------

// Hsvf Udp Market Data Packet Header
entrypoint typedef struct _MessageHeader {
  UINT8 sequence_number[9];  // bytes 0 to 8
  UINT8 message_type[2];     // bytes 9 to 10
} MessageHeader;

// ---- End Of Transmission Message: 7 bytes ------------------------------------

// This message will be sent to indicate that the day's transmission is complete
entrypoint typedef struct _EndOfTransmissionMessage {
  UINT8 exchange_id;  // byte 0
  UINT8 time[6];      // bytes 1 to 6
} EndOfTransmissionMessage;

// ---- Circuit Assurance Message: 6 bytes --------------------------------------

// This message is sent out if no messages are sent by BOX for more than one second after the broadcast has started
entrypoint typedef struct _CircuitAssuranceMessage {
  UINT8 time[6];  // bytes 0 to 5
} CircuitAssuranceMessage;

// ---- System Timestamp Message: 9 bytes ---------------------------------------

// This message is sent out every second and contains the time stamp when it was originally transmitted by the trading engine
entrypoint typedef struct _SystemTimestampMessage {
  UINT8 trading_engine_timestamp[9];  // bytes 0 to 8
} SystemTimestampMessage;

// ---- Instrument Description: 20 bytes ----------------------------------------

entrypoint typedef struct _InstrumentDescription {
  UINT8 root_symbol[6];                   // bytes 0 to 5
  UINT8 expiry_month_code;                // byte 6, values EXPIRY_MONTH_CODE_
  UINT8 filler_1;                         // byte 7
  UINT8 strike_price[7];                  // bytes 8 to 14
  UINT8 strike_price_fraction_indicator;  // byte 15, values STRIKE_PRICE_FRACTION_INDICATOR_
  UINT8 expiry_year[2];                   // bytes 16 to 17
  UINT8 expiry_day[2];                    // bytes 18 to 19
} InstrumentDescription;

// ---- Group Opening Time Message: 14 bytes ------------------------------------

// Group Opening Time
entrypoint typedef struct _GroupOpeningTimeMessage {
  UINT8 exchange_id;        // byte 0
  UINT8 root_symbol[6];     // bytes 1 to 6
  UINT8 group_status;       // byte 7, values GROUP_STATUS_
  UINT8 scheduled_time[6];  // bytes 8 to 13
} GroupOpeningTimeMessage;

// ---- Group Status Message: 8 bytes -------------------------------------------

// This message will be sent when a group of trading instruments enters a new status
entrypoint typedef struct _GroupStatusMessage {
  UINT8 exchange_id;     // byte 0
  UINT8 root_symbol[6];  // bytes 1 to 6
  UINT8 group_status;    // byte 7, values GROUP_STATUS_
} GroupStatusMessage;

// ---- Strategies Group Status Message: 4 bytes --------------------------------

// This message will be sent when a group of complex trading instruments enters a new status
entrypoint typedef struct _StrategiesGroupStatusMessage {
  UINT8 exchange_id;                               // byte 0
  UINT8 group_of_the_complex_order_instrument[2];  // bytes 1 to 2
  UINT8 group_status;                              // byte 3, values GROUP_STATUS_
} StrategiesGroupStatusMessage;

// ---- Market Flow Indicator: 2 bytes ------------------------------------------

entrypoint typedef struct _MarketFlowIndicator {
  UINT8 type_of_instrument;  // byte 0, values TYPE_OF_INSTRUMENT_
  UINT8 type_of_underlying;  // byte 1, values TYPE_OF_UNDERLYING_
} MarketFlowIndicator;

// ---- Option Marker: 2 bytes --------------------------------------------------

entrypoint typedef struct _OptionMarker {
  UINT8 type_of_market;   // byte 0
  UINT8 type_of_options;  // byte 1, values TYPE_OF_OPTIONS_
} OptionMarker;

// ---- Option Instrument Keys Message: 108 bytes -------------------------------

// Option Instrument Keys
entrypoint typedef struct _OptionInstrumentKeysMessage {
  UINT8 exchange_id;                                 // byte 0
  InstrumentDescription instrument_description;      // bytes 1 to 20
  UINT8 strike_price_currency[3];                    // bytes 21 to 23
  UINT8 maximum_number_of_contracts_per_order[6];    // bytes 24 to 29
  UINT8 minimum_number_of_contracts_per_order[6];    // bytes 30 to 35
  UINT8 maximum_threshold_price[6];                  // bytes 36 to 41
  UINT8 maximum_threshold_price_fraction_indicator;  // byte 42, values MAXIMUM_THRESHOLD_PRICE_FRACTION_INDICATOR_
  UINT8 minimum_threshold_price[6];                  // bytes 43 to 48
  UINT8 minimum_threshold_price_fraction_indicator;  // byte 49, values MINIMUM_THRESHOLD_PRICE_FRACTION_INDICATOR_
  UINT8 tick_increment[6];                           // bytes 50 to 55
  UINT8 tick_increment_fraction_indicator;           // byte 56, values TICK_INCREMENT_FRACTION_INDICATOR_
  UINT8 option_type;                                 // byte 57, values OPTION_TYPE_
  MarketFlowIndicator market_flow_indicator;         // bytes 58 to 59
  UINT8 group_instrument[2];                         // bytes 60 to 61
  UINT8 instrument[4];                               // bytes 62 to 65
  UINT8 instrument_external_code[30];                // bytes 66 to 95
  OptionMarker option_marker;                        // bytes 96 to 97
  UINT8 underlying_symbol_root[10];                  // bytes 98 to 107
} OptionInstrumentKeysMessage;

// ---- Beginning Of Options Summary Message: 1 byte ----------------------------

// This message indicates that the beginning and the end of day option summaries
entrypoint typedef struct _BeginningOfOptionsSummaryMessage {
  UINT8 exchange_id;  // byte 0
} BeginningOfOptionsSummaryMessage;

// ---- Beginning Of Complex Order Summary Message: 1 byte ----------------------

// This message indicates that the beginning and the end of day Complex Order summaries
entrypoint typedef struct _BeginningOfComplexOrderSummaryMessage {
  UINT8 exchange_id;  // byte 0
} BeginningOfComplexOrderSummaryMessage;

// ---- End Of Sales Message: 7 bytes -------------------------------------------

// This message is sent when there is no more trading activity to be transmitted
entrypoint typedef struct _EndOfSalesMessage {
  UINT8 reserved;  // byte 0
  UINT8 time[6];   // bytes 1 to 6
} EndOfSalesMessage;

// ---- Start Of Auction On Option Message: 73 bytes ----------------------------

// Start of Auction on Option
entrypoint typedef struct _StartOfAuctionOnOptionMessage {
  UINT8 exchange_id;                                // byte 0
  InstrumentDescription instrument_description;     // bytes 1 to 20
  UINT8 improvement_phase_sequential_number[6];     // bytes 21 to 26
  UINT8 initial_order_price[6];                     // bytes 27 to 32
  UINT8 initial_order_price_fraction_indicator;     // byte 33, values INITIAL_ORDER_PRICE_FRACTION_INDICATOR_
  UINT8 initial_order_quantity[8];                  // bytes 34 to 41
  UINT8 initial_order_side;                         // byte 42, values INITIAL_ORDER_SIDE_
  UINT8 improvement_phase_expiry_time[8];           // bytes 43 to 50
  UINT8 filler_4[4];                                // bytes 51 to 54
  UINT8 minimum_quantity_for_improvement_order[8];  // bytes 55 to 62
  UINT8 percentage_assured_to_initial_order[8];     // bytes 63 to 70
  UINT8 auction_type;                               // byte 71, values AUCTION_TYPE_
  UINT8 filler_1;                                   // byte 72
} StartOfAuctionOnOptionMessage;

// ---- Start Of Auction On Complex Order Message: 83 bytes ---------------------

// Start of Auction on Complex Order
entrypoint typedef struct _StartOfAuctionOnComplexOrderMessage {
  UINT8 exchange_id;                                // byte 0
  UINT8 complex_order_instrument_symbol[30];        // bytes 1 to 30
  UINT8 improvement_phase_sequential_number[6];     // bytes 31 to 36
  UINT8 initial_order_price_sign;                   // byte 37, values INITIAL_ORDER_PRICE_SIGN_
  UINT8 initial_order_price[6];                     // bytes 38 to 43
  UINT8 initial_order_price_fraction_indicator;     // byte 44, values INITIAL_ORDER_PRICE_FRACTION_INDICATOR_
  UINT8 initial_order_quantity[8];                  // bytes 45 to 52
  UINT8 initial_order_side;                         // byte 53, values INITIAL_ORDER_SIDE_
  UINT8 improvement_phase_expiry_time[8];           // bytes 54 to 61
  UINT8 filler_4[4];                                // bytes 62 to 65
  UINT8 minimum_quantity_for_improvement_order[8];  // bytes 66 to 73
  UINT8 percentage_assured_to_initial_order[8];     // bytes 74 to 81
  UINT8 auction_type;                               // byte 82, values AUCTION_TYPE_
} StartOfAuctionOnComplexOrderMessage;

// ---- Start Of Exposition On Option Message: 69 bytes -------------------------

// Start of Exposition on Option
entrypoint typedef struct _StartOfExpositionOnOptionMessage {
  UINT8 exchange_id;                             // byte 0
  InstrumentDescription instrument_description;  // bytes 1 to 20
  UINT8 order_side;                              // byte 21, values ORDER_SIDE_
  UINT8 type_of_order;                           // byte 22, values TYPE_OF_ORDER_
  UINT8 limit_entered_for_an_order[6];           // bytes 23 to 28
  UINT8 limit_fraction_indicator;                // byte 29, values LIMIT_FRACTION_INDICATOR_
  UINT8 order_quantity[8];                       // bytes 30 to 37
  UINT8 order_sequence_number[6];                // bytes 38 to 43
  UINT8 filler_6[6];                             // bytes 44 to 49
  UINT8 type_of_clearing_account;                // byte 50, values TYPE_OF_CLEARING_ACCOUNT_
  UINT8 filler_1;                                // byte 51
  UINT8 end_of_the_exposition[8];                // bytes 52 to 59
  UINT8 auction_type;                            // byte 60, values AUCTION_TYPE_
  UINT8 firm_id[4];                              // bytes 61 to 64
  UINT8 cmta[4];                                 // bytes 65 to 68
} StartOfExpositionOnOptionMessage;

// ---- Start Of Exposition On Complex Order Message: 80 bytes ------------------

// Start of Exposition on Complex Order
entrypoint typedef struct _StartOfExpositionOnComplexOrderMessage {
  UINT8 exchange_id;                          // byte 0
  UINT8 complex_order_instrument_symbol[30];  // bytes 1 to 30
  UINT8 order_side;                           // byte 31, values ORDER_SIDE_
  UINT8 type_of_order;                        // byte 32, values TYPE_OF_ORDER_
  UINT8 limit_entered_for_an_order_sign;      // byte 33, values LIMIT_ENTERED_FOR_AN_ORDER_SIGN_
  UINT8 limit_entered_for_an_order[6];        // bytes 34 to 39
  UINT8 limit_fraction_indicator;             // byte 40, values LIMIT_FRACTION_INDICATOR_
  UINT8 order_quantity[8];                    // bytes 41 to 48
  UINT8 order_sequence_number[6];             // bytes 49 to 54
  UINT8 filler_6[6];                          // bytes 55 to 60
  UINT8 type_of_clearing_account;             // byte 61, values TYPE_OF_CLEARING_ACCOUNT_
  UINT8 filler_1;                             // byte 62
  UINT8 end_of_the_exposition[8];             // bytes 63 to 70
  UINT8 auction_type;                         // byte 71, values AUCTION_TYPE_
  UINT8 firm_id[4];                           // bytes 72 to 75
  UINT8 cmta[4];                              // bytes 76 to 79
} StartOfExpositionOnComplexOrderMessage;

// ---- End Of Auction Or Exposition On Option Message: 36 bytes ----------------

// End of Auction or Exposition on Option
entrypoint typedef struct _EndOfAuctionOrExpositionOnOptionMessage {
  UINT8 exchange_id;                             // byte 0
  InstrumentDescription instrument_description;  // bytes 1 to 20
  UINT8 deletion_type;                           // byte 21, values DELETION_TYPE_
  UINT8 order_sequence_number[6];                // bytes 22 to 27
  UINT8 improvement_order_side;                  // byte 28, values IMPROVEMENT_ORDER_SIDE_
  UINT8 improvement_phase_sequential_number[6];  // bytes 29 to 34
  UINT8 auction_type;                            // byte 35, values AUCTION_TYPE_
} EndOfAuctionOrExpositionOnOptionMessage;

// ---- End Of Auction Or Exposition On Complex Instruments Message: 46 bytes ----

// End of Auction or Exposition on Complex Instruments
entrypoint typedef struct _EndOfAuctionOrExpositionOnComplexInstrumentsMessage {
  UINT8 exchange_id;                             // byte 0
  UINT8 complex_order_instrument_symbol[30];     // bytes 1 to 30
  UINT8 deletion_type;                           // byte 31, values DELETION_TYPE_
  UINT8 order_sequence_number[6];                // bytes 32 to 37
  UINT8 order_side;                              // byte 38, values ORDER_SIDE_
  UINT8 improvement_phase_sequential_number[6];  // bytes 39 to 44
  UINT8 auction_type;                            // byte 45, values AUCTION_TYPE_
} EndOfAuctionOrExpositionOnComplexInstrumentsMessage;

