  UINT16 number_of_ask_orders_short;      // bytes 22 to 23
} Option2SidedQuoteShortMessage;

// Option 1-Sided Quote Long
typedef struct _Option1SidedQuoteLongMessage {
  UINT32 product_id;                     // bytes 0 to 3
  UINT8 status;                          // byte 4
  UINT8 bid_price_changed : 1;           // byte 5
  UINT8 bid_size_changed : 1;            // byte 5
  UINT8 ask_price_changed : 1;           // byte 5
  UINT8 ask_size_changed : 1;            // byte 5
  UINT8 pc_presence_at_bid_price : 1;    // byte 5
  UINT8 pc_presence_at_ask_price : 1;    // byte 5
  UINT8 implied_bid_on_top_of_book : 1;  // byte 5
  UINT8 implied_ask_on_top_of_book : 1;  // byte 5
