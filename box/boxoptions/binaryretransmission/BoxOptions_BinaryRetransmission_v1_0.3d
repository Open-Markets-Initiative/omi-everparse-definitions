// Complex 1-Sided Quote Long
typedef struct _Complex1SidedQuoteLongMessage {
  UINT32 product_id;                     // bytes 0 to 3
  UINT8 status;                          // byte 4
  UINT8 bid_price_changed : 1;           // byte 5
  UINT8 bid_size_changed : 1;            // byte 5
  UINT8 ask_price_changed : 1;           // byte 5
  UINT8 ask_size_changed : 1;            // byte 5
  UINT8 pc_presence_at_bid_price : 1;    // byte 5
  UINT8 pc_presence_at_ask_price : 1;    // byte 5
  UINT8 implied_bid_on_top_of_book : 1;  // byte 5
  UINT8 implied_ask_on_top_of_book : 1;  // byte 5
  UINT8 filler_1;                        // byte 6
  UINT8 side;                            // byte 7
  UINT64 price_long;                     // bytes 8 to 15, signed, read here as unsigned
  UINT32 size_long;                      // bytes 16 to 19
  UINT32 customer_size_long;             // bytes 20 to 23
  UINT32 number_of_orders_long;          // bytes 24 to 27
  UINT8 filler_4[4];                     // bytes 28 to 31
} Complex1SidedQuoteLongMessage;

// Option 1-Sided Quote Short
typedef struct _Option1SidedQuoteShortMessage {
  UINT32 product_id;                     // bytes 0 to 3
  UINT8 status;                          // byte 4
  UINT8 bid_price_changed : 1;           // byte 5
  UINT8 bid_size_changed : 1;            // byte 5
  UINT8 ask_price_changed : 1;           // byte 5
  UINT8 ask_size_changed : 1;            // byte 5
  UINT8 pc_presence_at_bid_price : 1;    // byte 5
  UINT8 pc_presence_at_ask_price : 1;    // byte 5
  UINT8 implied_bid_on_top_of_book : 1;  // byte 5
  UINT8 implied_ask_on_top_of_book : 1;  // byte 5
  UINT8 filler_1;                        // byte 6
  UINT8 side;                            // byte 7
  UINT16 price_short;                    // bytes 8 to 9
  UINT16 size_short;                     // bytes 10 to 11
  UINT16 customer_size_short;            // bytes 12 to 13
  UINT16 number_of_orders_short;         // bytes 14 to 15
} Option1SidedQuoteShortMessage;

// This message is sent out to Data Recipients to request a quote on a given Product ID.
typedef struct _OptionRequestForQuoteMessage {
  UINT32 product_id;  // bytes 0 to 3
  UINT32 size_long;   // bytes 4 to 7
} OptionRequestForQuoteMessage;

// Option Trade
typedef struct _OptionTradeMessage {
  UINT32 product_id;                // bytes 0 to 3
  UINT32 trade_number;              // bytes 4 to 7
  UINT64 trade_price;               // bytes 8 to 15, signed, read here as unsigned
  UINT32 trade_volume;              // bytes 16 to 19
  UINT8 trade_indicator_opra_code;  // byte 20
  UINT8 customer_indicator;         // byte 21
  UINT8 filler_2[2];                // bytes 22 to 23
  UINT8 match_number[8];            // bytes 24 to 31
  UINT32 auction_id;                // bytes 32 to 35
  UINT8 filler_12[12];              // bytes 36 to 47
} OptionTradeMessage;

// Option Trade Cancel
typedef struct _OptionTradeCancelMessage {
  UINT32 product_id;                // bytes 0 to 3
  UINT32 trade_number;              // bytes 4 to 7
  UINT64 trade_price;               // bytes 8 to 15, signed, read here as unsigned
  UINT32 trade_volume;              // bytes 16 to 19
  UINT8 trade_indicator_opra_code;  // byte 20
  UINT8 customer_indicator;         // byte 21
  UINT8 filler_2[2];                // bytes 22 to 23
  UINT8 match_number[8];            // bytes 24 to 31
  UINT32 auction_id;                // bytes 32 to 35
  UINT8 filler_12[12];              // bytes 36 to 47
} OptionTradeCancelMessage;

// Complex Order Trade
typedef struct _ComplexOrderTradeMessage {
  UINT32 product_id;                // bytes 0 to 3
  UINT32 trade_number;              // bytes 4 to 7
  UINT64 trade_price;               // bytes 8 to 15, signed, read here as unsigned
  UINT32 trade_volume;              // bytes 16 to 19
  UINT8 trade_indicator_opra_code;  // byte 20
  UINT8 customer_indicator;         // byte 21
  UINT8 filler_2[2];                // bytes 22 to 23
  UINT8 match_number[8];            // bytes 24 to 31
  UINT32 auction_id;                // bytes 32 to 35
  UINT8 filler_12[12];              // bytes 36 to 47
} ComplexOrderTradeMessage;

// Complex Order Trade Cancel
typedef struct _ComplexOrderTradeCancelMessage {
  UINT32 product_id;                // bytes 0 to 3
  UINT32 trade_number;              // bytes 4 to 7
  UINT64 trade_price;               // bytes 8 to 15, signed, read here as unsigned
  UINT32 trade_volume;              // bytes 16 to 19
  UINT8 trade_indicator_opra_code;  // byte 20
  UINT8 customer_indicator;         // byte 21
  UINT8 filler_2[2];                // bytes 22 to 23
  UINT8 match_number[8];            // bytes 24 to 31
  UINT32 auction_id;                // bytes 32 to 35
  UINT8 filler_12[12];              // bytes 36 to 47
} ComplexOrderTradeCancelMessage;

// Option Auction
typedef struct _OptionAuctionMessage {
  UINT32 product_id;              // bytes 0 to 3
  UINT32 auction_id_or_order_id;  // bytes 4 to 7
  UINT8 type_;                    // byte 8
  UINT8 auction_status;           // byte 9
  UINT8 filler_5[5];              // bytes 10 to 14
  UINT8 side;                     // byte 15
  UINT64 price_long;              // bytes 16 to 23, signed, read here as unsigned
  UINT32 size_long;               // bytes 24 to 27
  UINT8 customer_indicator;       // byte 28
  UINT8 filler_9[9];              // bytes 29 to 37
  UINT16 firm_id;                 // bytes 38 to 39
  UINT64 end_time;                // bytes 40 to 47
} OptionAuctionMessage;

// Option Exposition
typedef struct _OptionExpositionMessage {
  UINT32 product_id;              // bytes 0 to 3
  UINT32 auction_id_or_order_id;  // bytes 4 to 7
  UINT8 type_;                    // byte 8
  UINT8 auction_status;           // byte 9
  UINT8 filler_5[5];              // bytes 10 to 14
  UINT8 side;                     // byte 15
  UINT64 price_long;              // bytes 16 to 23, signed, read here as unsigned
  UINT32 size_long;               // bytes 24 to 27
  UINT8 customer_indicator;       // byte 28
  UINT8 filler_9[9];              // bytes 29 to 37
  UINT16 firm_id;                 // bytes 38 to 39
  UINT64 end_time;                // bytes 40 to 47
} OptionExpositionMessage;

// Complex Order Auction
typedef struct _ComplexOrderAuctionMessage {
  UINT32 product_id;              // bytes 0 to 3
  UINT32 auction_id_or_order_id;  // bytes 4 to 7
  UINT8 type_;                    // byte 8
  UINT8 auction_status;           // byte 9
  UINT8 filler_5[5];              // bytes 10 to 14
  UINT8 side;                     // byte 15
  UINT64 price_long;              // bytes 16 to 23, signed, read here as unsigned
  UINT32 size_long;               // bytes 24 to 27
  UINT8 customer_indicator;       // byte 28
  UINT8 filler_9[9];              // bytes 29 to 37
  UINT16 firm_id;                 // bytes 38 to 39
  UINT64 end_time;                // bytes 40 to 47
} ComplexOrderAuctionMessage;

// Complex Order Exposition
typedef struct _ComplexOrderExpositionMessage {
  UINT32 product_id;              // bytes 0 to 3
  UINT32 auction_id_or_order_id;  // bytes 4 to 7
  UINT8 type_;                    // byte 8
  UINT8 auction_status;           // byte 9
  UINT8 filler_5[5];              // bytes 10 to 14
  UINT8 side;                     // byte 15
  UINT64 price_long;              // bytes 16 to 23, signed, read here as unsigned
  UINT32 size_long;               // bytes 24 to 27
  UINT8 customer_indicator;       // byte 28
  UINT8 filler_9[9];              // bytes 29 to 37
  UINT16 firm_id;                 // bytes 38 to 39
  UINT64 end_time;                // bytes 40 to 47
} ComplexOrderExpositionMessage;

// The trading status of Options on a given Underlying.
typedef struct _TradingStatusMessage {
  UINT8 group[2];                 // bytes 0 to 1
  UINT16 unique_group_id;         // bytes 2 to 3
  UINT8 underlying_symbol[10];    // bytes 4 to 13
  UINT8 status;                   // byte 14
  UINT8 opening_type;             // byte 15
  UINT8 rth : 1;                  // byte 16
  UINT8 reserved_7 : 7;           // byte 16
  UINT8 current_trading_session;  // byte 17
  UINT8 filler_6[6];              // bytes 18 to 23
  UINT64 scheduled_opening_time;  // bytes 24 to 31
  UINT16 quoting_width;           // bytes 32 to 33
  UINT8 quoting_width_type;       // byte 34
  UINT8 filler_5[5];              // bytes 35 to 39
} TradingStatusMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: LoginMessage login_message;
    case 0x02: unit login_acknowledgement_message;
    case 0x03: unit logout_message;
    case 0x04: unit logout_acknowledgement_message;
    case 0x05: RetransmissionRequestMessage retransmission_request_message;
    case 0x06: unit retransmission_begin_message;
    case 0x07: unit retransmission_end_message;
    case 0x08: RetransmissionLineStatusMessage retransmission_line_status_message;
    case 0x09: HeartbeatMessage heartbeat_message;
    case 0x0B: unit end_of_transmission_message;
    case 0x0C: ErrorMessage error_message;
    case 0x14: NonFlexOptionInstrumentMessage non_flex_option_instrument_message;
    case 0x15: FlexOptionInstrumentMessage flex_option_instrument_message;
    case 0x19: ComplexNonFlexInstrumentMessage complex_non_flex_instrument_message;
    case 0x1A: ComplexFlexInstrumentMessage complex_flex_instrument_message;
    case 0x3A: OptionOpeningPriceMessage option_opening_price_message;
    case 0x1E: OptionMarketDepthLongMessage option_market_depth_long_message;
    case 0x28: ComplexMarketDepthLongMessage complex_market_depth_long_message;
    case 0x20: OptionMarketDepthShortMessage option_market_depth_short_message;
    case 0x32: Option2SidedQuoteLongMessage option_2_sided_quote_long_message;
    case 0x3C: Complex2SidedQuoteLongMessage complex_2_sided_quote_long_message;
    case 0x34: Option2SidedQuoteShortMessage option_2_sided_quote_short_message;
    case 0x46: Option1SidedQuoteLongMessage option_1_sided_quote_long_message;
    case 0x50: Complex1SidedQuoteLongMessage complex_1_sided_quote_long_message;
    case 0x48: Option1SidedQuoteShortMessage option_1_sided_quote_short_message;
    case 0x3B: OptionRequestForQuoteMessage option_request_for_quote_message;
    case 0x5A: OptionTradeMessage option_trade_message;
    case 0x5B: OptionTradeCancelMessage option_trade_cancel_message;
    case 0x5F: ComplexOrderTradeMessage complex_order_trade_message;
    case 0x60: ComplexOrderTradeCancelMessage complex_order_trade_cancel_message;
    case 0x64: OptionAuctionMessage option_auction_message;
    case 0x65: OptionExpositionMessage option_exposition_message;
    case 0x69: ComplexOrderAuctionMessage complex_order_auction_message;
    case 0x6A: ComplexOrderExpositionMessage complex_order_exposition_message;
    case 0x6E: TradingStatusMessage trading_status_message;
    default: UINT8 unknown[available];
  }
} Payload;

// A binary message: its 8 byte header and a payload the message type selects
typedef struct _Message {
  UINT16 message_length { message_length >= 8 };                                                                                    // bytes 0 to 1
  UINT8 message_type;                                                                                                               // byte 2
  UINT8 message_header_filler;                                                                                                      // byte 3
  UINT32 time_offset_from_reference_time;                                                                                           // bytes 4 to 7
  Payload(message_type, (((UINT32) message_length) - 8)) payload[:byte-size-single-element-array (((UINT32) message_length) - 8)];
} Message;

// A Binary Block Header followed by its messages
typedef struct _Block {
  UINT16 block_size { block_size >= 32 };                    // bytes 0 to 1
  UINT16 number_of_messages_in_block;                        // bytes 2 to 3
  UINT32 retransmission_request : 1;                         // bytes 4 to 7
  UINT32 different_sequence : 1;                             // bytes 4 to 7
  UINT32 administrative_messages : 1;                        // bytes 4 to 7
  UINT32 option_instrument_present : 1;                      // bytes 4 to 7
  UINT32 complex_instrument_present : 1;                     // bytes 4 to 7
  UINT32 opening_price_present : 1;                          // bytes 4 to 7
  UINT32 market_depth_present : 1;                           // bytes 4 to 7
  UINT32 market_depth_with_customer : 1;                     // bytes 4 to 7
  UINT32 top_of_book_present : 1;                            // bytes 4 to 7
  UINT32 top_of_book_with_customer : 1;                      // bytes 4 to 7
  UINT32 auction_present : 1;                                // bytes 4 to 7
  UINT32 exposition_present : 1;                             // bytes 4 to 7
  UINT32 trade_present : 1;                                  // bytes 4 to 7
  UINT32 trading_status_present : 1;                         // bytes 4 to 7
  UINT32 retransmission_delimiter_present : 1;               // bytes 4 to 7
  UINT32 reserved_bits : 17;                                 // bytes 4 to 7
  UINT8 line_name;                                           // byte 8
  UINT8 block_header_filler[7];                              // bytes 9 to 15
  UINT64 reference_timestamp;                                // bytes 16 to 23
  UINT64 message_sequence_number;                            // bytes 24 to 31
  Message message[:byte-size (((UINT32) block_size) - 32)];
} Block;

// ---- Packet: Packet ----------------------------------------------------------

// Box Binary Market Data Tcp Packet
entrypoint typedef struct _Packet (UINT32 available) {
  Block block[:byte-size available];
} Packet;

