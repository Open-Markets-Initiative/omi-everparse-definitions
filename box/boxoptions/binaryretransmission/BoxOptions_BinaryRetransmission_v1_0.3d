// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out BoxOptions_BinaryRetransmission_v1_0.3d

// ---- Values ------------------------------------------------------------------

// Line Name: one byte code
#define LINE_NAME_TOP_OF_BOOK 0x31               // Top Of Book
#define LINE_NAME_MARKET_DEPTH 0x35              // Market Depth
#define LINE_NAME_COMPLEX 0x43                   // Complex
#define LINE_NAME_AUCTION 0x50                   // Auction
#define LINE_NAME_DICTIONARY 0x44                // Dictionary
#define LINE_NAME_SNAPSHOT_TOP_OF_BOOK 0x54      // Snapshot Top Of Book
#define LINE_NAME_SNAPSHOT_OF_MARKET_DEPTH 0x4D  // Snapshot Of Market Depth

// Message Type: one byte code
#define MESSAGE_TYPE_LOGIN_MESSAGE 0x01                        // Login Message
#define MESSAGE_TYPE_LOGIN_ACKNOWLEDGEMENT_MESSAGE 0x02        // Login Acknowledgement Message
#define MESSAGE_TYPE_LOGOUT_MESSAGE 0x03                       // Logout Message
#define MESSAGE_TYPE_LOGOUT_ACKNOWLEDGEMENT_MESSAGE 0x04       // Logout Acknowledgement Message
#define MESSAGE_TYPE_RETRANSMISSION_REQUEST_MESSAGE 0x05       // Retransmission Request Message
#define MESSAGE_TYPE_RETRANSMISSION_BEGIN_MESSAGE 0x06         // Retransmission Begin Message
#define MESSAGE_TYPE_RETRANSMISSION_END_MESSAGE 0x07           // Retransmission End Message
#define MESSAGE_TYPE_RETRANSMISSION_LINE_STATUS_MESSAGE 0x08   // Retransmission Line Status Message
#define MESSAGE_TYPE_HEARTBEAT_MESSAGE 0x09                    // Heartbeat Message
#define MESSAGE_TYPE_END_OF_TRANSMISSION_MESSAGE 0x0B          // End Of Transmission Message
#define MESSAGE_TYPE_ERROR_MESSAGE 0x0C                        // Error Message
#define MESSAGE_TYPE_NON_FLEX_OPTION_INSTRUMENT_MESSAGE 0x14   // Non Flex Option Instrument Message
#define MESSAGE_TYPE_FLEX_OPTION_INSTRUMENT_MESSAGE 0x15       // Flex Option Instrument Message
#define MESSAGE_TYPE_COMPLEX_NON_FLEX_INSTRUMENT_MESSAGE 0x19  // Complex Non Flex Instrument Message
#define MESSAGE_TYPE_COMPLEX_FLEX_INSTRUMENT_MESSAGE 0x1A      // Complex Flex Instrument Message
#define MESSAGE_TYPE_OPTION_OPENING_PRICE_MESSAGE 0x3A         // Option Opening Price Message
#define MESSAGE_TYPE_OPTION_MARKET_DEPTH_LONG_MESSAGE 0x1E     // Option Market Depth Long Message
#define MESSAGE_TYPE_COMPLEX_MARKET_DEPTH_LONG_MESSAGE 0x28    // Complex Market Depth Long Message
#define MESSAGE_TYPE_OPTION_MARKET_DEPTH_SHORT_MESSAGE 0x20    // Option Market Depth Short Message
#define MESSAGE_TYPE_OPTION_2_SIDED_QUOTE_LONG_MESSAGE 0x32    // Option 2 Sided Quote Long Message
#define MESSAGE_TYPE_COMPLEX_2_SIDED_QUOTE_LONG_MESSAGE 0x3C   // Complex 2 Sided Quote Long Message
#define MESSAGE_TYPE_OPTION_2_SIDED_QUOTE_SHORT_MESSAGE 0x34   // Option 2 Sided Quote Short Message
#define MESSAGE_TYPE_OPTION_1_SIDED_QUOTE_LONG_MESSAGE 0x46    // Option 1 Sided Quote Long Message
#define MESSAGE_TYPE_COMPLEX_1_SIDED_QUOTE_LONG_MESSAGE 0x50   // Complex 1 Sided Quote Long Message
#define MESSAGE_TYPE_OPTION_1_SIDED_QUOTE_SHORT_MESSAGE 0x48   // Option 1 Sided Quote Short Message
#define MESSAGE_TYPE_OPTION_REQUEST_FOR_QUOTE_MESSAGE 0x3B     // Option Request For Quote Message
#define MESSAGE_TYPE_OPTION_TRADE_MESSAGE 0x5A                 // Option Trade Message
#define MESSAGE_TYPE_OPTION_TRADE_CANCEL_MESSAGE 0x5B          // Option Trade Cancel Message
#define MESSAGE_TYPE_COMPLEX_ORDER_TRADE_MESSAGE 0x5F          // Complex Order Trade Message
#define MESSAGE_TYPE_COMPLEX_ORDER_TRADE_CANCEL_MESSAGE 0x60   // Complex Order Trade Cancel Message
#define MESSAGE_TYPE_OPTION_AUCTION_MESSAGE 0x64               // Option Auction Message
#define MESSAGE_TYPE_OPTION_EXPOSITION_MESSAGE 0x65            // Option Exposition Message
#define MESSAGE_TYPE_COMPLEX_ORDER_AUCTION_MESSAGE 0x69        // Complex Order Auction Message
#define MESSAGE_TYPE_COMPLEX_ORDER_EXPOSITION_MESSAGE 0x6A     // Complex Order Exposition Message
#define MESSAGE_TYPE_TRADING_STATUS_MESSAGE 0x6E               // Trading Status Message

// Error Code: one byte code
#define ERROR_CODE_UNKNOWN_MESSAGE_TYPE 0x01                                         // Unknown Message Type
#define ERROR_CODE_INVALID_MESSAGE_LENGTH 0x02                                       // Invalid Message Length
#define ERROR_CODE_INVALID_CHARACTERS 0x03                                           // Invalid Characters
#define ERROR_CODE_INVALID_PROTOCOL_VERSION 0x04                                     // Invalid Protocol Version
#define ERROR_CODE_INVALID_LINE_NAME 0x05                                            // Invalid Line Name
#define ERROR_CODE_MAXIMUM_NUMBER_OF_CONCURRENT_RETRANSMISSION_REQUEST_REACHED 0x06  // Maximum Number Of Concurrent Retransmission Request Reached
#define ERROR_CODE_INVALID_SEQUENCE_NUMBER_RANGE 0x07                                // Invalid Sequence Number Range
#define ERROR_CODE_CONTINUOUS_FEED_REQUEST_IN_PROGRESS 0x08                          // Continuous Feed Request In Progress

// Call Put Code: one byte code
#define CALL_PUT_CODE_PUT 0x00   // Put
#define CALL_PUT_CODE_CALL 0x01  // Call

// Option Type: one byte code
#define OPTION_TYPE_AMERICAN_STANDARD_OPTION 0x00                // American Standard Option
#define OPTION_TYPE_AMERICAN_FLEX_OPTION_PHYSICAL_DELIVERY 0x01  // American Flex Option Physical Delivery
#define OPTION_TYPE_EUROPEAN_FLEX_OPTION_PHYSICAL_DELIVERY 0x02  // European Flex Option Physical Delivery
#define OPTION_TYPE_AMERICAN_FLEX_OPTION_CASH_DELIVERY 0x03      // American Flex Option Cash Delivery
#define OPTION_TYPE_EUROPEAN_FLEX_OPTION_CASH_DELIVERY 0x04      // European Flex Option Cash Delivery

// Posting Action: one byte code
#define POSTING_ACTION_NO_RESTRICTION 0x00       // No Restriction
#define POSTING_ACTION_CLOSING_ONLY_ORDERS 0x01  // Closing Only Orders

// Status: one byte code
#define STATUS_INITIAL 0x00                    // Initial
#define STATUS_PRE_OPENING 0x01                // Pre Opening
#define STATUS_OPENING 0x02                    // Opening
#define STATUS_NORMAL_TRADING 0x03             // Normal Trading
#define STATUS_FORBIDDEN 0x04                  // Forbidden
#define STATUS_TRADING_HALTED 0x05             // Trading Halted
#define STATUS_RESERVED 0x06                   // Reserved
#define STATUS_SUSPENDED 0x07                  // Suspended
#define STATUS_SURVEILLANCE_INTERVENTION 0x08  // Surveillance Intervention
#define STATUS_CLOSED 0x09                     // Closed

// Market Level: one byte code
#define MARKET_LEVEL_PUBLIC_CUSTOMER_PRESENCE_AT_LEVEL_1 0x00  // Public Customer Presence At Level 1
#define MARKET_LEVEL_LEVEL_1 0x01                              // Level 1
#define MARKET_LEVEL_LEVEL_2 0x02                              // Level 2
#define MARKET_LEVEL_LEVEL_3 0x03                              // Level 3
#define MARKET_LEVEL_LEVEL_4 0x04                              // Level 4
#define MARKET_LEVEL_LEVEL_5 0x05                              // Level 5
#define MARKET_LEVEL_IMPLIED_OR_LEGGING 0x06                   // Implied Or Legging

// Side: one byte code
#define SIDE_BUY 0x00   // Buy
#define SIDE_SELL 0x01  // Sell

// Trade Indicator Opra Code: one byte code
#define TRADE_INDICATOR_OPRA_CODE_AUTO 0x49  // Auto
#define TRADE_INDICATOR_OPRA_CODE_CANC 0x41  // Canc
#define TRADE_INDICATOR_OPRA_CODE_OSEQ 0x42  // Oseq
#define TRADE_INDICATOR_OPRA_CODE_ISOI 0x53  // Isoi
#define TRADE_INDICATOR_OPRA_CODE_SLAN 0x61  // Slan
#define TRADE_INDICATOR_OPRA_CODE_SLCN 0x63  // Slcn
#define TRADE_INDICATOR_OPRA_CODE_SLFT 0x65  // Slft
#define TRADE_INDICATOR_OPRA_CODE_MLET 0x66  // Mlet
#define TRADE_INDICATOR_OPRA_CODE_MLAT 0x67  // Mlat
#define TRADE_INDICATOR_OPRA_CODE_MLCT 0x68  // Mlct
#define TRADE_INDICATOR_OPRA_CODE_MLFT 0x69  // Mlft
#define TRADE_INDICATOR_OPRA_CODE_MESL 0x6A  // Mesl
#define TRADE_INDICATOR_OPRA_CODE_MASL 0x6C  // Masl
#define TRADE_INDICATOR_OPRA_CODE_MFSL 0x6D  // Mfsl

// Customer Indicator: one byte code
#define CUSTOMER_INDICATOR_NOT_A_PUBLIC_CUSTOMER 0x00  // Not A Public Customer
#define CUSTOMER_INDICATOR_PUBLIC_CUSTOMER 0x01        // Public Customer

// Type: one byte code
#define TYPE_PRICE_IMPROVEMENT_PROCESS 0x00        // Price Improvement Process
#define TYPE_FACILITATION_CROSSING_MECHANISM 0x01  // Facilitation Crossing Mechanism
#define TYPE_SOLICITATION_CROSSING_MECHANISM 0x02  // Solicitation Crossing Mechanism
#define TYPE_EXPOSITION 0x03                       // Exposition

// Auction Status: one byte code
#define AUCTION_STATUS_START 0x00  // Start
#define AUCTION_STATUS_END 0x01    // End

// Opening Type: one byte code
#define OPENING_TYPE_AUTO 0x00       // Auto
#define OPENING_TYPE_SCHEDULED 0x01  // Scheduled

// Current Trading Session: one byte code
#define CURRENT_TRADING_SESSION_NO_TRADING 0x00       // No Trading
#define CURRENT_TRADING_SESSION_REGULAR_TRADING 0x01  // Regular Trading

// Quoting Width Type: one byte code
#define QUOTING_WIDTH_TYPE_STANDARD_QUOTING_OBLIGATIONS 0x00    // Standard Quoting Obligations
#define QUOTING_WIDTH_TYPE_SPECIAL_QUOTING_RELIEF_APPLIED 0x01  // Special Quoting Relief Applied

// ---- Types -------------------------------------------------------------------

// This message is used by Data Recipients to login to the TCP Retransmission Service.
typedef struct _LoginMessage {
  UINT8 user[16];      // bytes 0 to 15
  UINT8 password[16];  // bytes 16 to 31
} LoginMessage;

// This message is used by Data Recipient to request retransmission of messages by Retransmission Request Types.
typedef struct _RetransmissionRequestMessage {
  UINT8 line_name;                       // byte 0
  UINT8 filler_7[7];                     // bytes 1 to 7
  UINT64 start_message_sequence_number;  // bytes 8 to 15
  UINT64 end_message_sequence_number;    // bytes 16 to 23
} RetransmissionRequestMessage;

// Line
typedef struct _Line {
  UINT8 line_name;                      // byte 0
  UINT8 filler_7[7];                    // bytes 1 to 7
  UINT64 last_message_sequence_number;  // bytes 8 to 15
} Line;

// Indicates the last message number sent for each line of that trading slice.
typedef struct _RetransmissionLineStatusMessage {
  UINT8 filler_7[7];                                        // bytes 0 to 6
  UINT8 number_of_lines;                                    // byte 7
  Line line[:byte-size (((UINT32) number_of_lines) * 16)];
} RetransmissionLineStatusMessage;

// The Heartbeat message is sent out if no messages are sent by BOX for more than one second after the broadcast has started.
typedef struct _HeartbeatMessage {
  UINT64 time;  // bytes 0 to 7
} HeartbeatMessage;

// This message will be sent to indicate an error.
typedef struct _ErrorMessage {
  UINT8 message_type_in_error;  // byte 0
  UINT8 error_code;             // byte 1
  UINT8 filler_6[6];            // bytes 2 to 7
  UINT8 error_text[80];         // bytes 8 to 87
} ErrorMessage;

// Non-FLEX Option Instrument
typedef struct _NonFlexOptionInstrumentMessage {
  UINT32 product_id;                  // bytes 0 to 3
  UINT16 unique_group_id;             // bytes 4 to 5
  UINT8 group[2];                     // bytes 6 to 7
  UINT8 instrument_id[4];             // bytes 8 to 11
  UINT8 root_symbol[6];               // bytes 12 to 17
  UINT16 expiration_year;             // bytes 18 to 19
  UINT8 expiration_month;             // byte 20
  UINT8 expiration_day;               // byte 21
  UINT8 call_put_code;                // byte 22
  UINT8 option_type;                  // byte 23
  UINT64 strike_price;                // bytes 24 to 31, signed, read here as unsigned
  UINT8 underlying_symbol[10];        // bytes 32 to 41
  UINT8 tick_increment_indicator[2];  // bytes 42 to 43
  UINT8 posting_action;               // byte 44
  UINT8 filler_11[11];                // bytes 45 to 55
} NonFlexOptionInstrumentMessage;

// FLEX Option Instrument
typedef struct _FlexOptionInstrumentMessage {
  UINT32 product_id;                  // bytes 0 to 3
  UINT16 unique_group_id;             // bytes 4 to 5
  UINT8 group[2];                     // bytes 6 to 7
  UINT8 instrument_id[4];             // bytes 8 to 11
  UINT8 root_symbol[6];               // bytes 12 to 17
  UINT16 expiration_year;             // bytes 18 to 19
  UINT8 expiration_month;             // byte 20
  UINT8 expiration_day;               // byte 21
  UINT8 call_put_code;                // byte 22
  UINT8 option_type;                  // byte 23
  UINT64 strike_price;                // bytes 24 to 31, signed, read here as unsigned
  UINT8 underlying_symbol[10];        // bytes 32 to 41
  UINT8 tick_increment_indicator[2];  // bytes 42 to 43
  UINT8 posting_action;               // byte 44
  UINT8 filler_11[11];                // bytes 45 to 55
} FlexOptionInstrumentMessage;

// Leg
typedef struct _Leg {
  UINT32 leg_product_id;  // bytes 0 to 3
  UINT32 leg_ratio;       // bytes 4 to 7, signed, read here as unsigned
} Leg;

// Complex Instrument with Non-FLEX Legs
typedef struct _ComplexNonFlexInstrumentMessage {
  UINT32 product_id;                                    // bytes 0 to 3
  UINT8 group[2];                                       // bytes 4 to 5
  UINT8 instrument_id[4];                               // bytes 6 to 9
  UINT8 complex_instrument_symbol[30];                  // bytes 10 to 39
  UINT64 minimum_price_limit;                           // bytes 40 to 47, signed, read here as unsigned
  UINT64 maximum_price_limit;                           // bytes 48 to 55, signed, read here as unsigned
  UINT8 tick_increment_indicator[2];                    // bytes 56 to 57
  UINT8 filler_5[5];                                    // bytes 58 to 62
  UINT8 number_of_legs;                                 // byte 63
  Leg leg[:byte-size (((UINT32) number_of_legs) * 8)];
} ComplexNonFlexInstrumentMessage;

// Complex Instrument with FLEX Legs
typedef struct _ComplexFlexInstrumentMessage {
  UINT32 product_id;                                    // bytes 0 to 3
  UINT8 group[2];                                       // bytes 4 to 5
  UINT8 instrument_id[4];                               // bytes 6 to 9
  UINT8 complex_instrument_symbol[30];                  // bytes 10 to 39
  UINT64 minimum_price_limit;                           // bytes 40 to 47, signed, read here as unsigned
  UINT64 maximum_price_limit;                           // bytes 48 to 55, signed, read here as unsigned
  UINT8 tick_increment_indicator[2];                    // bytes 56 to 57
  UINT8 filler_5[5];                                    // bytes 58 to 62
  UINT8 number_of_legs;                                 // byte 63
  Leg leg[:byte-size (((UINT32) number_of_legs) * 8)];
} ComplexFlexInstrumentMessage;

// This message is used to disseminate the Opening Price on an Option instrument.
typedef struct _OptionOpeningPriceMessage {
  UINT32 product_id;                      // bytes 0 to 3
  UINT8 status;                           // byte 4
  UINT8 moo_orders_on_bid_side : 1;       // byte 5
  UINT8 moo_orders_on_ask_side : 1;       // byte 5
  UINT8 public_customer_on_bid_side : 1;  // byte 5
  UINT8 public_customer_on_ask_side : 1;  // byte 5
  UINT8 reserved_4 : 4;                   // byte 5
  UINT8 filler_2[2];                      // bytes 6 to 7
  UINT64 opening_price;                   // bytes 8 to 15, signed, read here as unsigned
  UINT32 bid_size_long;                   // bytes 16 to 19
  UINT32 public_customer_bid_size;        // bytes 20 to 23
  UINT32 market_on_opening_bid_size;      // bytes 24 to 27
  UINT32 total_number_of_bid_orders;      // bytes 28 to 31
  UINT32 ask_size_long;                   // bytes 32 to 35
  UINT32 public_customer_ask_size;        // bytes 36 to 39
  UINT32 market_on_opening_ask_size;      // bytes 40 to 43
  UINT32 total_number_of_ask_orders;      // bytes 44 to 47
} OptionOpeningPriceMessage;

// Market Depth Long Level
typedef struct _MarketDepthLongLevel {
  UINT8 market_level;                // byte 0
  UINT8 bid_price_changed : 1;       // byte 1
  UINT8 bid_size_changed : 1;        // byte 1
  UINT8 ask_price_changed : 1;       // byte 1
  UINT8 ask_size_changed : 1;        // byte 1
  UINT8 pc_presence_on_bid : 1;      // byte 1
  UINT8 pc_presence_on_ask : 1;      // byte 1
  UINT8 implied_on_bid_side : 1;     // byte 1
  UINT8 implied_on_ask_side : 1;     // byte 1
  UINT8 filler_6[6];                 // bytes 2 to 7
  UINT64 bid_price_long;             // bytes 8 to 15, signed, read here as unsigned
  UINT32 bid_size_long;              // bytes 16 to 19
  UINT32 number_of_bid_orders_long;  // bytes 20 to 23
  UINT64 ask_price_long;             // bytes 24 to 31, signed, read here as unsigned
  UINT32 ask_size_long;              // bytes 32 to 35
  UINT32 number_of_ask_orders_long;  // bytes 36 to 39
} MarketDepthLongLevel;

// Option Market Depth Long
typedef struct _OptionMarketDepthLongMessage {
  UINT32 product_id;                                                                            // bytes 0 to 3
  UINT8 status;                                                                                 // byte 4
  UINT8 filler_2[2];                                                                            // bytes 5 to 6
  UINT8 number_of_levels;                                                                       // byte 7
  MarketDepthLongLevel market_depth_long_level[:byte-size (((UINT32) number_of_levels) * 40)];
} OptionMarketDepthLongMessage;

// Complex Market Depth Long
typedef struct _ComplexMarketDepthLongMessage {
  UINT32 product_id;                                                                            // bytes 0 to 3
  UINT8 status;                                                                                 // byte 4
  UINT8 filler_2[2];                                                                            // bytes 5 to 6
  UINT8 number_of_levels;                                                                       // byte 7
  MarketDepthLongLevel market_depth_long_level[:byte-size (((UINT32) number_of_levels) * 40)];
} ComplexMarketDepthLongMessage;

// Market Depth Short Level
typedef struct _MarketDepthShortLevel {
  UINT8 market_level;                 // byte 0
  UINT8 bid_price_changed : 1;        // byte 1
  UINT8 bid_size_changed : 1;         // byte 1
  UINT8 ask_price_changed : 1;        // byte 1
  UINT8 ask_size_changed : 1;         // byte 1
  UINT8 pc_presence_on_bid : 1;       // byte 1
  UINT8 pc_presence_on_ask : 1;       // byte 1
  UINT8 implied_on_bid_side : 1;      // byte 1
  UINT8 implied_on_ask_side : 1;      // byte 1
  UINT8 filler_2[2];                  // bytes 2 to 3
  UINT16 bid_price_short;             // bytes 4 to 5
  UINT16 bid_size_short;              // bytes 6 to 7
  UINT16 number_of_bid_orders_short;  // bytes 8 to 9
  UINT16 ask_price_short;             // bytes 10 to 11
  UINT16 ask_size_short;              // bytes 12 to 13
  UINT16 number_of_ask_orders_short;  // bytes 14 to 15
} MarketDepthShortLevel;

// Market Depth (MD) Short message is applicable to Options only
typedef struct _OptionMarketDepthShortMessage {
  UINT32 product_id;                                                                              // bytes 0 to 3
  UINT8 status;                                                                                   // byte 4
  UINT8 filler_2[2];                                                                              // bytes 5 to 6
  UINT8 number_of_levels;                                                                         // byte 7
  MarketDepthShortLevel market_depth_short_level[:byte-size (((UINT32) number_of_levels) * 16)];
} OptionMarketDepthShortMessage;

// Option 2-Sided Quote - Long
typedef struct _Option2SidedQuoteLongMessage {
  UINT32 product_id;                     // bytes 0 to 3
  UINT8 status;                          // byte 4
  UINT8 bid_price_changed : 1;           // byte 5
  UINT8 bid_size_changed : 1;            // byte 5
  UINT8 ask_price_changed : 1;           // byte 5
  UINT8 ask_size_changed : 1;            // byte 5
  UINT8 pc_presence_at_bid_price : 1;    // byte 5
  UINT8 pc_presence_at_ask_price : 1;    // byte 5
  UINT8 implied_bid_on_top_of_book : 1;  // byte 5
  UINT8 implied_ask_on_top_of_book : 1;  // byte 5
  UINT8 filler_2[2];                     // bytes 6 to 7
  UINT64 bid_price_long;                 // bytes 8 to 15, signed, read here as unsigned
  UINT32 bid_size_long;                  // bytes 16 to 19
  UINT32 bid_public_customer_size_long;  // bytes 20 to 23
  UINT32 number_of_bid_orders_long;      // bytes 24 to 27
  UINT8 filler_4[4];                     // bytes 28 to 31
  UINT64 ask_price_long;                 // bytes 32 to 39, signed, read here as unsigned
  UINT32 ask_size_long;                  // bytes 40 to 43
  UINT32 ask_public_customer_size_long;  // bytes 44 to 47
  UINT32 number_of_ask_orders_long;      // bytes 48 to 51
  UINT8 second_filler_4[4];              // bytes 52 to 55
} Option2SidedQuoteLongMessage;

