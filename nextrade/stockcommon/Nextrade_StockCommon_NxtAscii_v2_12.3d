    case 0x4330353151: InvestorActivitiesPerAnIndustryMessage investor_activities_per_an_industry_message_2;
    case 0x4235353153: CurrentMovementMessage current_movement_message;
    case 0x4235353151: CurrentMovementMessage current_movement_message_2;
    case 0x5030353153: ProgramTradingActivityPerInvestorMessage program_trading_activity_per_investor_message;
    case 0x5030353151: ProgramTradingActivityPerInvestorMessage program_trading_activity_per_investor_message_2;
    case 0x4333353153: ProgramTradingInformationPerIssueAggregatedInformationMessage program_trading_information_per_issue_aggregated_information_message;
    case 0x4333353151: ProgramTradingInformationPerIssueAggregatedInformationMessage program_trading_information_per_issue_aggregated_information_message_2;
    case 0x4A30353153: ProgramTradingInformationOfTotalAggregatedInformationMessage program_trading_information_of_total_aggregated_information_message;
    case 0x4A30353151: ProgramTradingInformationOfTotalAggregatedInformationMessage program_trading_information_of_total_aggregated_information_message_2;
    case 0x4D34353153: MarketOperationScheduleMessage market_operation_schedule_message;
    case 0x4D34353151: MarketOperationScheduleMessage market_operation_schedule_message_2;
