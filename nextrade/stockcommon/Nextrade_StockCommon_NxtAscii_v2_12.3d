    case 0x4239353153: TopFiveTradersActivitiesMessage top_five_traders_activities_message;
    case 0x4239353151: TopFiveTradersActivitiesMessage top_five_traders_activities_message_2;
    case 0x4130353153: EquitiesBatchDataMessage equities_batch_data_message;
