casetype _Payload (UINT64 selector, UINT32 available) {
  switch (selector) {
    case 0x4932353030: PollingDataMessage polling_data_message;
    case 0x4236353153: SecuritiesQuote10LevelMessage securities_quote_10_level_message;
    case 0x4236353151: SecuritiesQuote10LevelMessage securities_quote_10_level_message_2;
    case 0x4133353153: SecuritiesOrderFilledMessage securities_order_filled_message;
    case 0x4133353151: SecuritiesOrderFilledMessage securities_order_filled_message_2;
