// ---- Packet: Packet ----------------------------------------------------------

// Nextrade Market Data Udp Packet
entrypoint typedef struct _Packet (UINT32 available) where (available >= 5) {
  UINT32BE t_r_code_0;                                                                                                                        // bytes 0 to 3, the first 4 of 5 characters a choice is made on
  UINT8 t_r_code_1;                                                                                                                           // byte 4
  Payload(((((UINT64) t_r_code_0) << 8) | ((UINT64) t_r_code_1)), (available - 5)) payload[:byte-size-single-element-array (available - 5)];
} Packet;

