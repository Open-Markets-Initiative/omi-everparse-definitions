    case 0x4531353151: ClosingPriceTradingQuoteMessage closing_price_trading_quote_message_2;
    case 0x4232353153: EquitiesSnapshot10LevelMessage equities_snapshot_10_level_message;
    case 0x4232353151: EquitiesSnapshot10LevelMessage equities_snapshot_10_level_message_2;
