  UINT8 vi_type_code;                                  // byte 50
  UINT8 a_base_price_to_trigger_static_vi[11];         // bytes 51 to 61
  UINT8 a_base_price_to_trigger_dynamic_vi[11];        // bytes 62 to 72
  UINT8 vi_triggering_price[11];                       // bytes 73 to 83
  UINT8 disparate_ratio_to_trigger_static_vi[13];      // bytes 84 to 96
  UINT8 disparate_ratio_to_trigger_dynamic_vi[13];     // bytes 97 to 109
  UINT8 end_keyword;                                   // byte 110
} TriggeringRemovingViMessage;

// Total Ask/Bid volume per Issue on Closing Price Trade.
typedef struct _ClosingPriceTradingQuoteMessage {
  UINT8 message_sequence_number[8];                    // bytes 0 to 7
  UINT8 board_id[2];                                   // bytes 8 to 9
  UINT8 isin_code[12];                                 // bytes 10 to 21
  UINT8 a_designated_number_for_an_issue_from_krx[6];  // bytes 22 to 27
  UINT8 total_ask_volume[12];                          // bytes 28 to 39
  UINT8 total_bid_volume[12];                          // bytes 40 to 51
  UINT8 end_keyword;                                   // byte 52
} ClosingPriceTradingQuoteMessage;

