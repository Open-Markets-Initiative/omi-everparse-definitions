  UINT8 the_best_bid[11];                              // bytes 169 to 179
  UINT8 end_keyword;                                   // byte 180
} SecuritiesOrderFilledMessage;

// The data is provided per an issue if a Market Operation Trading session event occurs.
typedef struct _MarketOperationTsMessage {
  UINT8 message_sequence_number[8];                    // bytes 0 to 7
  UINT8 board_id[2];                                   // bytes 8 to 9
  UINT8 session_id[2];                                 // bytes 10 to 11
  UINT8 isin_code[12];                                 // bytes 12 to 23
  UINT8 a_designated_number_for_an_issue_from_krx[6];  // bytes 24 to 29
  UINT8 processing_time_of_trading_system[12];         // bytes 30 to 41
  UINT8 board_event_id[3];                             // bytes 42 to 44
  UINT8 start_time_of_a_board_event[9];                // bytes 45 to 53
  UINT8 board_event_group_code[5];                     // bytes 54 to 58
  UINT8 trading_halt_reason_code[3];                   // bytes 59 to 61
  UINT8 end_keyword;                                   // byte 62
} MarketOperationTsMessage;

// The data is provided in case of an issue closing per board.
typedef struct _IssueClosingMessage {
  UINT8 message_sequence_number[8];                                                // bytes 0 to 7
  UINT8 board_id[2];                                                               // bytes 8 to 9
  UINT8 isin_code[12];                                                             // bytes 10 to 21
  UINT8 a_designated_number_for_an_issue_from_krx[6];                              // bytes 22 to 27
  UINT8 closing_price[11];                                                         // bytes 28 to 38
  UINT8 closing_price_type_code;                                                   // byte 39
  UINT8 upper_limit_price_on_the_single_price_trade_in_the_off_hours_session[11];  // bytes 40 to 50
  UINT8 lower_limit_price_on_the_single_price_trade_in_the_off_hours_session[11];  // bytes 51 to 61
  UINT8 closing_price_weighted_stock_price_average[11];                            // bytes 62 to 72
  UINT8 closing_price_base_price_of_buy_in[11];                                    // bytes 73 to 83
  UINT8 closing_price_upper_limit_of_buy_in[11];                                   // bytes 84 to 94
  UINT8 closing_price_lower_limit_of_buy_in[11];                                   // bytes 95 to 105
  UINT8 end_keyword;                                                               // byte 106
} IssueClosingMessage;

// Triggering/removing VI (Volatility Interruption).
typedef struct _TriggeringRemovingViMessage {
  UINT8 message_sequence_number[8];                    // bytes 0 to 7
  UINT8 board_id[2];                                   // bytes 8 to 9
  UINT8 isin_code[12];                                 // bytes 10 to 21
