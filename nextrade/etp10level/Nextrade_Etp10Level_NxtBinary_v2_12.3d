// The data is provided per an issue if a Market Operation Trading session event occurs.
typedef struct _MarketOperationTsMessage {
  UINT32 message_sequence_number;                    // bytes 0 to 3, signed, read here as unsigned
  UINT8 board_id[2];                                 // bytes 4 to 5
  UINT8 session_id[2];                               // bytes 6 to 7
  UINT8 isin_code[12];                               // bytes 8 to 19
  UINT32 a_designated_number_for_an_issue_from_krx;  // bytes 20 to 23, signed, read here as unsigned
  UINT8 processing_time_of_trading_system[12];       // bytes 24 to 35
  UINT8 board_event_id[3];                           // bytes 36 to 38
  UINT8 start_time_of_a_board_event[9];              // bytes 39 to 47
  UINT32 board_event_group_code;                     // bytes 48 to 51, signed, read here as unsigned
  UINT8 trading_halt_reason_code[3];                 // bytes 52 to 54
  UINT32 end_keyword;                                // bytes 55 to 58, signed, read here as unsigned
} MarketOperationTsMessage;

