// ---- Server Packet Header: 3 bytes -------------------------------------------

// Packet header of a packet sent by the server
entrypoint typedef struct _ServerPacketHeader {
  UINT16BE packet_length;    // bytes 0 to 1
  UINT8 server_packet_type;  // byte 2
} ServerPacketHeader;

// ---- Login Accepted Packet: 30 bytes -----------------------------------------

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
entrypoint typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// ---- Login Rejected Packet: 1 byte -------------------------------------------

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
entrypoint typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// ---- Seconds Message: 4 bytes ------------------------------------------------

// This message is sent every second for which at least one message is being generated.
entrypoint typedef struct _SecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} SecondsMessage;

// ---- Order Book Directory Message: 129 bytes ---------------------------------

// Order book directory messages are disseminated for all active securities, including halted securities, in the AIX Trading system.
entrypoint typedef struct _OrderBookDirectoryMessage {
  UINT32BE nanoseconds;                          // bytes 0 to 3
  UINT32BE order_book_id;                        // bytes 4 to 7
  UINT8 symbol[32];                              // bytes 8 to 39
  UINT8 long_name[32];                           // bytes 40 to 71
  UINT8 isin[12];                                // bytes 72 to 83
  UINT8 financial_product;                       // byte 84
  UINT8 trading_currency[3];                     // bytes 85 to 87
  UINT16BE number_of_decimals_in_price;          // bytes 88 to 89
  UINT16BE number_of_decimals_in_nominal_value;  // bytes 90 to 91
  UINT32BE odd_lot_size;                         // bytes 92 to 95
  UINT32BE round_lot_size;                       // bytes 96 to 99
  UINT32BE block_lot_size;                       // bytes 100 to 103
  UINT64BE nominal_value;                        // bytes 104 to 111
  UINT8 reserved_1;                              // byte 112
  UINT32BE underlying_order_book_id;             // bytes 113 to 116
  UINT32BE strike_price;                         // bytes 117 to 120, signed, read here as unsigned
  UINT32BE expiration_date;                      // bytes 121 to 124
  UINT16BE number_of_decimals_in_strike_price;   // bytes 125 to 126
  UINT8 put_or_call;                             // byte 127
  UINT8 ranking_type;                            // byte 128
} OrderBookDirectoryMessage;

// ---- Tick Size Table Entry Message: 24 bytes ---------------------------------

// This message contains information on a tick size for a price range.
entrypoint typedef struct _TickSizeTableEntryMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
  UINT64BE tick_size;      // bytes 8 to 15
  UINT32BE price_from;     // bytes 16 to 19, signed, read here as unsigned
  UINT32BE price_to;       // bytes 20 to 23, signed, read here as unsigned
} TickSizeTableEntryMessage;

// ---- Short Sell Status Message: 9 bytes --------------------------------------

// A Short Sell Status Message indicates the short sell rules of an order book.
entrypoint typedef struct _ShortSellStatusMessage {
  UINT32BE nanoseconds;          // bytes 0 to 3
  UINT32BE order_book_id;        // bytes 4 to 7
  UINT8 short_sale_restriction;  // byte 8
} ShortSellStatusMessage;

// ---- Order Book State Message: 28 bytes --------------------------------------

// The Order book state message relays information on state changes.
entrypoint typedef struct _OrderBookStateMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
  UINT8 state_name[20];    // bytes 8 to 27
} OrderBookStateMessage;

// ---- Add Order Message: 44 bytes ---------------------------------------------

// An Add Order Message indicates that a new order has been accepted by the AIX Trading system and was added to the displayable book.
entrypoint typedef struct _AddOrderMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT64BE order_id;                 // bytes 4 to 11
  UINT32BE order_book_id;            // bytes 12 to 15
  UINT8 side;                        // byte 16
  UINT32BE ranking_sequence_number;  // bytes 17 to 20
  UINT64BE quantity;                 // bytes 21 to 28
  UINT32BE price;                    // bytes 29 to 32, signed, read here as unsigned
  UINT16BE order_attributes;         // bytes 33 to 34
  UINT8 lot_type;                    // byte 35
  UINT64BE ranking_time;             // bytes 36 to 43
} AddOrderMessage;

// ---- End Of Snapshot Message: 20 bytes ---------------------------------------

// The end of snapshot message returns the current ITCH sequence number to be used when connecting to the ITCH feed.
entrypoint typedef struct _EndOfSnapshotMessage {
  UINT8 sequence_number[20];  // bytes 0 to 19
} EndOfSnapshotMessage;

