// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out SixSwissExchange_TotalView_v1_24_0.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_TIME_STAMP_SECONDS_MESSAGE 0x54         // Time Stamp Seconds Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53               // System Event Message
#define MESSAGE_TYPE_QUANTITY_TICK_SIZE_MESSAGE 0x4D         // Quantity Tick Size Message
#define MESSAGE_TYPE_PRICE_TICK_SIZE_MESSAGE 0x4C            // Price Tick Size Message
#define MESSAGE_TYPE_ORDERBOOK_DIRECTORY_MESSAGE 0x52        // Orderbook Directory Message
#define MESSAGE_TYPE_ORDERBOOK_TRADING_ACTION_MESSAGE 0x48   // Orderbook Trading Action Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x41                  // Add Order Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45             // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_WITH_PRICE_MESSAGE 0x43  // Order Executed With Price Message
#define MESSAGE_TYPE_EXECUTION_SUMMARY_MESSAGE 0x59          // Execution Summary Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x50                      // Trade Message
#define MESSAGE_TYPE_BROKEN_TRADE_MESSAGE 0x42               // Broken Trade Message
#define MESSAGE_TYPE_ORDER_DELETE_MESSAGE 0x44               // Order Delete Message
#define MESSAGE_TYPE_ORDER_REPLACE_MESSAGE 0x55              // Order Replace Message
#define MESSAGE_TYPE_INDICATIVE_PRICE_QUANTITY_MESSAGE 0x49  // Indicative Price Quantity Message

// Event Code: one byte code
#define EVENT_CODE_BREAK 0x41                     // Break
#define EVENT_CODE_RESUMPTION_AFTER_BREAK 0x42    // Resumption After Break
#define EVENT_CODE_END_OF_MESSAGES 0x43           // End Of Messages
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x45       // End Of System Hours
#define EVENT_CODE_START_OF_ACCEPTING 0x49        // Start Of Accepting
#define EVENT_CODE_END_OF_MARKET_HOURS 0x4D       // End Of Market Hours
#define EVENT_CODE_START_OF_MESSAGES 0x4F         // Start Of Messages
#define EVENT_CODE_START_OF_MARKET_HOURS 0x51     // Start Of Market Hours
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x53     // Start Of System Hours
#define EVENT_CODE_AUCTION_CLOSES 0x55            // Auction Closes
#define EVENT_CODE_AUCTION_STARTS 0x56            // Auction Starts
#define EVENT_CODE_START_OF_TRADING_AT_LAST 0x54  // Start Of Trading At Last
#define EVENT_CODE_END_OF_TRADING_AT_LAST 0x4C    // End Of Trading At Last
#define EVENT_CODE_SYNCHRONIZED_WITH_GROUP 0x20   // Synchronized With Group

// Price Type: one byte code
#define PRICE_TYPE_PER_UNIT 0x55    // Per Unit
#define PRICE_TYPE_PERCENTAGE 0x50  // Percentage

// Trading State: one byte code
#define TRADING_STATE_TRADING 0x54                                            // Trading
#define TRADING_STATE_SUSPENDED 0x56                                          // Suspended
#define TRADING_STATE_SWISS_AT_MID_ORDER_BOOK_SUSPENDED 0x4D                  // Swiss At Mid Order Book Suspended
#define TRADING_STATE_SWISS_EBBO_ORDER_BOOK_SUSPENDED 0x45                    // Swiss Ebbo Order Book Suspended
#define TRADING_STATE_SWISS_EBBO_AND_SWISS_AT_MID_ORDER_BOOKS_SUSPENDED 0x4F  // Swiss Ebbo And Swiss At Mid Order Books Suspended
#define TRADING_STATE_UNDERLYING_CONDITION 0x55                               // Underlying Condition
#define TRADING_STATE_QUOTE_ON_DEMAND_ORDER_BOOK_SUSPENDED 0x51               // Quote On Demand Order Book Suspended
#define TRADING_STATE_CLOB_SUSPENDED_AND_QOD_ORDER_BOOK_IN_TRADING 0x43       // Clob Suspended And Qod Order Book In Trading
#define TRADING_STATE_LP_BID_ONLY_ACTIVE 0x4C                                 // Lp Bid Only Active
#define TRADING_STATE_LP_BID_ONLY_ACTIVE_AND_QOD_ORDER_BOOK_SUSPENDED 0x50    // Lp Bid Only Active And Qod Order Book Suspended

// Book Condition: one byte code
#define BOOK_CONDITION_DELAY_AUCTION 0x44                              // Delay Auction
#define BOOK_CONDITION_STOP_TRADING 0x48                               // Stop Trading
#define BOOK_CONDITION_STOP_TRADING_WITH_NON_OPENING 0x4A              // Stop Trading With Non Opening
#define BOOK_CONDITION_DELAY_AUCTION_WITH_NON_OPENING 0x4C             // Delay Auction With Non Opening
#define BOOK_CONDITION_NORMAL_TRADING 0x4E                             // Normal Trading
#define BOOK_CONDITION_NON_OPENING 0x50                                // Non Opening
#define BOOK_CONDITION_LP_BID_ONLY_REASON_US_WITHHOLDING_TAX 0x31      // Lp Bid Only Reason Us Withholding Tax
#define BOOK_CONDITION_LP_BID_ONLY_REASON_ISSUER_SOLD_OUT 0x32         // Lp Bid Only Reason Issuer Sold Out
#define BOOK_CONDITION_LP_BID_ONLY_REASON_ISSUER_BUSINESS_POLICY 0x33  // Lp Bid Only Reason Issuer Business Policy
#define BOOK_CONDITION_LP_BID_ONLY_REASON_SUCCESSOR_PRODUCT 0x34       // Lp Bid Only Reason Successor Product
#define BOOK_CONDITION_LP_BID_ONLY_REASON_PRODUCT_WORTHLESS 0x35       // Lp Bid Only Reason Product Worthless

// Order Verb: one byte code
#define ORDER_VERB_BUY 0x42                     // Buy
#define ORDER_VERB_SELL 0x53                    // Sell
#define ORDER_VERB_REFERENCE_PRICE_UPDATE 0x20  // Reference Price Update

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// Aggressor Side: one byte code
#define AGGRESSOR_SIDE_BUY 0x42   // Buy
#define AGGRESSOR_SIDE_SELL 0x53  // Sell

// Far Side: one byte code
#define FAR_SIDE_BUY 0x42                        // Buy
#define FAR_SIDE_SELL 0x53                       // Sell
#define FAR_SIDE_NO_FAR_QUANTITY_REMAINING 0x20  // No Far Quantity Remaining

// Book Type: one byte code
#define BOOK_TYPE_SWISS_EBBO 0x45                              // Swiss Ebbo
#define BOOK_TYPE_QUOTE_DRIVEN_MARKET 0x4C                     // Quote Driven Market
#define BOOK_TYPE_SWISS_AT_MID 0x4D                            // Swiss At Mid
#define BOOK_TYPE_CENTRAL_LIMIT_ORDER_BOOK_NON_DISPLAYED 0x4E  // Central Limit Order Book Non Displayed
#define BOOK_TYPE_QUOTE_ON_DEMAND 0x51                         // Quote On Demand

// Trading Session Id: one byte code
#define TRADING_SESSION_ID_OPENING_AUCTION 0x30     // Opening Auction
#define TRADING_SESSION_ID_INTRADAY_AUCTION 0x31    // Intraday Auction
#define TRADING_SESSION_ID_CONTINUOUS_TRADING 0x32  // Continuous Trading
#define TRADING_SESSION_ID_CLOSING_AUCTION 0x33     // Closing Auction
#define TRADING_SESSION_ID_AT_MARKET_CLOSE 0x34     // At Market Close

// Reason: one byte code
#define REASON_CONSENT 0x43      // Consent
#define REASON_SUPERVISORY 0x53  // Supervisory

// Cross Type: one byte code
#define CROSS_TYPE_CLOSING_AUCTION 0x43      // Closing Auction
#define CROSS_TYPE_INTRADAY_AUCTION 0x49     // Intraday Auction
#define CROSS_TYPE_PRE_OPENING_AUCTION 0x4F  // Pre Opening Auction

// ---- Types -------------------------------------------------------------------

// Timestamp of seconds since midnight, used in combination with the nanoseconds timestamp of each message
typedef struct _TimeStampSecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} TimeStampSecondsMessage;

// Sent as a result of trade events at the system, group and Orderbook level
typedef struct _SystemEventMessage {
  UINT32BE timestamp;  // bytes 0 to 3
  UINT8 group[8];      // bytes 4 to 11
  UINT8 event_code;    // byte 12
  UINT32BE orderbook;  // bytes 13 to 16
} SystemEventMessage;

// Shows the Quantity Tick (Category) of a Security
typedef struct _QuantityTickSizeMessage {
  UINT32BE timestamp;               // bytes 0 to 3
  UINT32BE quantity_tick_table_id;  // bytes 4 to 7
  UINT32BE quantity_tick_size;      // bytes 8 to 11
  UINT32BE quantity_start;          // bytes 12 to 15
} QuantityTickSizeMessage;

// Shows the Price Tick (Category) of a Security
typedef struct _PriceTickSizeMessage {
  UINT32BE timestamp;            // bytes 0 to 3
  UINT32BE price_tick_table_id;  // bytes 4 to 7
  UINT32BE price_tick_size;      // bytes 8 to 11
  UINT32BE price_start;          // bytes 12 to 15
} PriceTickSizeMessage;

// Provides the basic reference data for the active Orderbooks for a specific OBM partition
typedef struct _OrderbookDirectoryMessage {
  UINT32BE timestamp;               // bytes 0 to 3
  UINT32BE orderbook;               // bytes 4 to 7
  UINT8 price_type;                 // byte 8
  UINT8 isin[12];                   // bytes 9 to 20
  UINT8 currency[3];                // bytes 21 to 23
  UINT8 group[8];                   // bytes 24 to 31
  UINT32BE minimum_quantity;        // bytes 32 to 35
  UINT32BE quantity_tick_table_id;  // bytes 36 to 39
  UINT32BE price_tick_table_id;     // bytes 40 to 43
  UINT32BE price_decimals;          // bytes 44 to 47
  UINT32BE delisting_date;          // bytes 48 to 51
  UINT32BE delisting_time;          // bytes 52 to 55
  UINT32BE qod_price_decimals;      // bytes 56 to 59
  UINT8 security_exchange[4];       // bytes 60 to 63
  UINT8 reference_exchange[4];      // bytes 64 to 67
} OrderbookDirectoryMessage;

// Sent as a result of an Orderbook state or condition change
typedef struct _OrderbookTradingActionMessage {
  UINT32BE timestamp;    // bytes 0 to 3
  UINT32BE orderbook;    // bytes 4 to 7
  UINT8 trading_state;   // byte 8
  UINT8 book_condition;  // byte 9
} OrderbookTradingActionMessage;

// A new order has been accepted and added to the book; an Order Number and Quantity of zero carries the reference price
typedef struct _AddOrderMessage {
  UINT32BE timestamp;       // bytes 0 to 3
  UINT64BE order_number;    // bytes 4 to 11
  UINT8 order_verb;         // byte 12
  UINT32BE order_quantity;  // bytes 13 to 16
  UINT32BE orderbook;       // bytes 17 to 20
  UINT32BE order_price;     // bytes 21 to 24
} AddOrderMessage;

// An order on the book has been executed in whole or in part
typedef struct _OrderExecutedMessage {
  UINT32BE timestamp;          // bytes 0 to 3
  UINT64BE order_number;       // bytes 4 to 11
  UINT32BE executed_quantity;  // bytes 12 to 15
  UINT64BE match_number;       // bytes 16 to 23
} OrderExecutedMessage;

// An order on the book has been executed at a price different from its initial display price
typedef struct _OrderExecutedWithPriceMessage {
  UINT32BE timestamp;          // bytes 0 to 3
  UINT64BE order_number;       // bytes 4 to 11
  UINT32BE executed_quantity;  // bytes 12 to 15
  UINT64BE match_number;       // bytes 16 to 23
  UINT8 printable;             // byte 24
  UINT32BE execution_price;    // bytes 25 to 28
} OrderExecutedWithPriceMessage;

// Sent prior to the individual order execution and trade messages for an incoming order that executes in the CLOB or QDM order book
typedef struct _ExecutionSummaryMessage {
  UINT32BE timestamp;                   // bytes 0 to 3
  UINT32BE orderbook;                   // bytes 4 to 7
  UINT8 aggressor_side;                 // byte 8
  UINT32BE total_mpob_quantity;         // bytes 9 to 12
  UINT32BE total_ebbo_book_quantity;    // bytes 13 to 16
  UINT32BE total_clobqdm_quantity;      // bytes 17 to 20
  UINT32BE resting_hidden_quantity;     // bytes 21 to 24
  UINT32BE resting_cancelled_quantity;  // bytes 25 to 28
  UINT8 far_side;                       // byte 29
  UINT32BE far_price;                   // bytes 30 to 33
  UINT32BE far_quantity_remaining;      // bytes 34 to 37
  UINT16BE number_of_executions;        // bytes 38 to 39
} ExecutionSummaryMessage;

// Informs about a trade without pre-trade transparency
typedef struct _TradeMessage {
  UINT32BE timestamp;          // bytes 0 to 3
  UINT64BE execution_time;     // bytes 4 to 11
  UINT32BE orderbook;          // bytes 12 to 15
  UINT32BE executed_quantity;  // bytes 16 to 19
  UINT32BE execution_price;    // bytes 20 to 23
  UINT64BE match_number;       // bytes 24 to 31
  UINT8 book_type;             // byte 32
  UINT8 trading_session_id;    // byte 33
} TradeMessage;

// Informs about a SIX Swiss Exchange mistrade decision
typedef struct _BrokenTradeMessage {
  UINT32BE timestamp;     // bytes 0 to 3
  UINT64BE match_number;  // bytes 4 to 11
  UINT8 reason;           // byte 12
} BrokenTradeMessage;

// Sent whenever an order on the Orderbook is being cancelled
typedef struct _OrderDeleteMessage {
  UINT32BE timestamp;     // bytes 0 to 3
  UINT64BE order_number;  // bytes 4 to 11
} OrderDeleteMessage;

// Sent whenever an order on the Orderbook has been cancel-replaced
typedef struct _OrderReplaceMessage {
  UINT32BE timestamp;              // bytes 0 to 3
  UINT64BE original_order_number;  // bytes 4 to 11
  UINT64BE new_order_number;       // bytes 12 to 19
  UINT32BE order_quantity;         // bytes 20 to 23
  UINT32BE order_price;            // bytes 24 to 27
} OrderReplaceMessage;

// Sent during non-automatic matching periods telling the users what would happen if the book was uncrossed now
typedef struct _IndicativePriceQuantityMessage {
  UINT32BE timestamp;                     // bytes 0 to 3
  UINT64BE theoretical_opening_quantity;  // bytes 4 to 11
  UINT32BE orderbook;                     // bytes 12 to 15
  UINT32BE best_bid;                      // bytes 16 to 19
  UINT32BE best_offer;                    // bytes 20 to 23
  UINT32BE theoretical_opening_price;     // bytes 24 to 27
  UINT8 cross_type;                       // byte 28
} IndicativePriceQuantityMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: TimeStampSecondsMessage time_stamp_seconds_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x4D: QuantityTickSizeMessage quantity_tick_size_message;
    case 0x4C: PriceTickSizeMessage price_tick_size_message;
    case 0x52: OrderbookDirectoryMessage orderbook_directory_message;
    case 0x48: OrderbookTradingActionMessage orderbook_trading_action_message;
    case 0x41: AddOrderMessage add_order_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceMessage order_executed_with_price_message;
    case 0x59: ExecutionSummaryMessage execution_summary_message;
    case 0x50: TradeMessage trade_message;
    case 0x42: BrokenTradeMessage broken_trade_message;
    case 0x44: OrderDeleteMessage order_delete_message;
    case 0x55: OrderReplaceMessage order_replace_message;
    case 0x49: IndicativePriceQuantityMessage indicative_price_quantity_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

