// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out BorsaIstanbul_GeniumInet_v21_12.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SECONDS_MESSAGE 0x54                    // Seconds Message
#define MESSAGE_TYPE_ORDER_BOOK_DIRECTORY 0x52               // Order Book Directory
#define MESSAGE_TYPE_COMBINATION_ORDER_BOOK_LEG 0x4D         // Combination Order Book Leg
#define MESSAGE_TYPE_TICK_SIZE_TABLE_ENTRY 0x4C              // Tick Size Table Entry
#define MESSAGE_TYPE_SHORT_SELL_STATUS 0x56                  // Short Sell Status
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53               // System Event Message
#define MESSAGE_TYPE_ORDER_BOOK_STATE_MESSAGE 0x4F           // Order Book State Message
#define MESSAGE_TYPE_ADD_ORDER_NO_MPID_ATTRIBUTION 0x41      // Add Order No Mpid Attribution
#define MESSAGE_TYPE_ADD_ORDER_WITH_MPID_ATTRIBUTION 0x46    // Add Order With Mpid Attribution
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45             // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_WITH_PRICE_MESSAGE 0x43  // Order Executed With Price Message
#define MESSAGE_TYPE_ORDER_REPLACE_MESSAGE 0x55              // Order Replace Message
#define MESSAGE_TYPE_ORDER_DELETE_MESSAGE 0x44               // Order Delete Message
#define MESSAGE_TYPE_ORDER_BOOK_FLUSH_MESSAGE 0x59           // Order Book Flush Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x50                      // Trade Message
#define MESSAGE_TYPE_EQUILIBRIUM_PRICE_UPDATE 0x5A           // Equilibrium Price Update

// Financial Product: one byte code
#define FINANCIAL_PRODUCT_OPTION 0x01                          // Option
#define FINANCIAL_PRODUCT_FORWARD 0x02                         // Forward
#define FINANCIAL_PRODUCT_FUTURE 0x03                          // Future
#define FINANCIAL_PRODUCT_FRA 0x04                             // Fra
#define FINANCIAL_PRODUCT_CASH 0x05                            // Cash
#define FINANCIAL_PRODUCT_PAYMENT 0x06                         // Payment
#define FINANCIAL_PRODUCT_EXCHANGE_RATE 0x07                   // Exchange Rate
#define FINANCIAL_PRODUCT_INTEREST_RATE_SWAP 0x08              // Interest Rate Swap
#define FINANCIAL_PRODUCT_REPO 0x09                            // Repo
#define FINANCIAL_PRODUCT_SYNTHETIC_BOX_LEG_OR_REFERENCE 0x0A  // Synthetic Box Leg Or Reference
#define FINANCIAL_PRODUCT_STANDARD_COMBINATION 0x0B            // Standard Combination
#define FINANCIAL_PRODUCT_GUARANTEE 0x0C                       // Guarantee
#define FINANCIAL_PRODUCT_OTC_GENERAL 0x0D                     // Otc General
#define FINANCIAL_PRODUCT_EQUITY_WARRANT 0x0E                  // Equity Warrant
#define FINANCIAL_PRODUCT_SECURITY_LENDING 0x0F                // Security Lending
#define FINANCIAL_PRODUCT_CERTIFICATE 0x12                     // Certificate

// Put Or Call: one byte code
#define PUT_OR_CALL_UNDEFINED 0x00  // Undefined
#define PUT_OR_CALL_CALL 0x01       // Call
#define PUT_OR_CALL_PUT 0x02        // Put

// Ranking Type: one byte code
#define RANKING_TYPE_PRICE_TIME 0x01  // Price Time

// Leg Side: one byte code
#define LEG_SIDE_AS_DEFINED 0x42  // As Defined
#define LEG_SIDE_OPPOSITE 0x43    // Opposite

// Short Sale Restriction: one byte code
#define SHORT_SALE_RESTRICTION_NO_RESTRICTIONS 0x00                          // No Restrictions
#define SHORT_SALE_RESTRICTION_SHORT_SELLING_NOT_ALLOWED 0x01                // Short Selling Not Allowed
#define SHORT_SALE_RESTRICTION_SHORT_SELLING_ALLOWED_WITH_UP_TICK_RULE 0x02  // Short Selling Allowed With Up Tick Rule

// Event Code: one byte code
#define EVENT_CODE_START_OF_MESSAGES 0x4F  // Start Of Messages
#define EVENT_CODE_END_OF_MESSAGES 0x43    // End Of Messages

// Side: one byte code
#define SIDE_BUY_ORDER 0x42   // Buy Order
#define SIDE_SELL_ORDER 0x53  // Sell Order

// Lot Type: one byte code
#define LOT_TYPE_ROUND_LOT 0x02  // Round Lot

// Occurred At Cross: one byte code
#define OCCURRED_AT_CROSS_NO 0x4E   // No
#define OCCURRED_AT_CROSS_YES 0x59  // Yes

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// ---- Types -------------------------------------------------------------------

// Sent every second for which at least one ITCH message is being generated. Contains the number of seconds since the start of 1970-01-01 00:00:00 UTC, also called Unix Time.
typedef struct _SecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} SecondsMessage;

// At the start of each trading day, Order book directory messages are disseminated for all active securities, including halted securities. Intra-day transmissions may occur when new order books are added or updates to existing order books occur.
typedef struct _OrderBookDirectory {
  UINT32BE nanoseconds;                // bytes 0 to 3
  UINT32BE order_book_id;              // bytes 4 to 7
  UINT8 symbol[32];                    // bytes 8 to 39
  UINT8 long_name[32];                 // bytes 40 to 71
  UINT8 isin[12];                      // bytes 72 to 83
  UINT8 financial_product;             // byte 84
  UINT8 trading_currency[3];           // bytes 85 to 87
  UINT16BE decimals_in_price;          // bytes 88 to 89
  UINT16BE decimals_in_nominal_value;  // bytes 90 to 91
  UINT32BE odd_lot_size;               // bytes 92 to 95
  UINT32BE round_lot_size;             // bytes 96 to 99
  UINT32BE block_lot_size;             // bytes 100 to 103
  UINT64BE nominal_value;              // bytes 104 to 111
  UINT8 number_of_legs;                // byte 112
  UINT32BE underlying_order_book_id;   // bytes 113 to 116
  UINT32BE strike_price;               // bytes 117 to 120, signed, read here as unsigned
  UINT32BE expiration_date;            // bytes 121 to 124
  UINT16BE decimals_in_strike_price;   // bytes 125 to 126
  UINT8 put_or_call;                   // byte 127
  UINT8 ranking_type;                  // byte 128
} OrderBookDirectory;

// Provides a mapping between a combination order book and one of the combination leg order books. One message is generated per leg that the combination consists of.
typedef struct _CombinationOrderBookLeg {
  UINT32BE nanoseconds;                // bytes 0 to 3
  UINT32BE combination_order_book_id;  // bytes 4 to 7
  UINT32BE leg_order_book_id;          // bytes 8 to 11
  UINT8 leg_side;                      // byte 12
  UINT32BE leg_ratio;                  // bytes 13 to 16
} CombinationOrderBookLeg;

// Contains information on a tick size for a price range. Together, all Tick Size messages with the same order book ID form a complete Tick Size Table.
typedef struct _TickSizeTableEntry {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
  UINT64BE tick_size;      // bytes 8 to 15
  UINT32BE price_from;     // bytes 16 to 19, signed, read here as unsigned
  UINT32BE price_to;       // bytes 20 to 23, signed, read here as unsigned
} TickSizeTableEntry;

// Indicates the short sell rules of an order book. Sent for order books which might have short sell allowing prior to the start of system. If an order book is absent from this message, clients should assume that the order book has no short selling rules at the start-of-day reference data messages. If short sell rules change during the day for an order book, this message will be re-sent for that order book.
typedef struct _ShortSellStatus {
  UINT32BE nanoseconds;          // bytes 0 to 3
  UINT32BE order_book_id;        // bytes 4 to 7
  UINT8 short_sale_restriction;  // byte 8
} ShortSellStatus;

// Used to signal a market or data feed handler event.
typedef struct _SystemEventMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT8 event_code;      // byte 4
} SystemEventMessage;

// Relays information on order book state changes.
typedef struct _OrderBookStateMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
  UINT8 state_name[20];    // bytes 8 to 27
} OrderBookStateMessage;

// Indicates that a new order has been accepted by the Genium INET Trading system and was added to the displayable book. Generated for unattributed orders. The message includes an Order ID that is unique per order book and side.
typedef struct _AddOrderNoMpidAttribution {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT64BE order_id;                 // bytes 4 to 11
  UINT32BE order_book_id;            // bytes 12 to 15
  UINT8 side;                        // byte 16
  UINT32BE ranking_sequence_number;  // bytes 17 to 20
  UINT64BE quantity;                 // bytes 21 to 28
  UINT32BE price;                    // bytes 29 to 32, signed, read here as unsigned
  UINT16BE reserved_2 : 2;           // bytes 33 to 34
  UINT16BE bait_implied_order : 1;   // bytes 33 to 34
  UINT16BE reserved_13 : 13;         // bytes 33 to 34
  UINT8 lot_type;                    // byte 35
  UINT64BE ranking_time;             // bytes 36 to 43
} AddOrderNoMpidAttribution;

// Note: This message is not used, it remains in the ITCH specification for future reference and is not applicable for BIST markets. Would be generated for attributed orders and quotations entered into the Genium INET Trading system.
typedef struct _AddOrderWithMpidAttribution {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT64BE order_id;                // bytes 4 to 11
  UINT32BE order_book_id;           // bytes 12 to 15
  UINT8 side;                       // byte 16
  UINT8 reserved_4[4];              // bytes 17 to 20
  UINT64BE quantity;                // bytes 21 to 28
  UINT32BE price;                   // bytes 29 to 32, signed, read here as unsigned
  UINT16BE reserved_2 : 2;          // bytes 33 to 34
  UINT16BE bait_implied_order : 1;  // bytes 33 to 34
  UINT16BE reserved_13 : 13;        // bytes 33 to 34
  UINT8 lot_type;                   // byte 35
  UINT8 participant_id[7];          // bytes 36 to 42
} AddOrderWithMpidAttribution;

// Sent whenever an order on the book is executed in whole or in part. Modify Order messages always include the Order ID, Order book ID and Side of the Add Order to which the update applies.
typedef struct _OrderExecutedMessage {
  UINT32BE nanoseconds;        // bytes 0 to 3
  UINT64BE order_id;           // bytes 4 to 11
  UINT32BE order_book_id;      // bytes 12 to 15
  UINT8 side;                  // byte 16
  UINT64BE executed_quantity;  // bytes 17 to 24
  UINT64BE match_id;           // bytes 25 to 32
  UINT32BE combo_group_id;     // bytes 33 to 36
  UINT8 reserved_14[14];       // bytes 37 to 50
} OrderExecutedMessage;

// Sent in the relatively rare event that an order on the book is executed in whole or in part with a price different than the initial display price. Combination orders on the book that execute will always be represented by this message, with the Printable flag set to N; leg trades are published with the Trade message and are printable.
typedef struct _OrderExecutedWithPriceMessage {
  UINT32BE nanoseconds;        // bytes 0 to 3
  UINT64BE order_id;           // bytes 4 to 11
  UINT32BE order_book_id;      // bytes 12 to 15
  UINT8 side;                  // byte 16
  UINT64BE executed_quantity;  // bytes 17 to 24
  UINT64BE match_id;           // bytes 25 to 32
  UINT32BE combo_group_id;     // bytes 33 to 36
  UINT8 reserved_14[14];       // bytes 37 to 50
  UINT32BE trade_price;        // bytes 51 to 54, signed, read here as unsigned
  UINT8 occurred_at_cross;     // byte 55
  UINT8 printable;             // byte 56
} OrderExecutedWithPriceMessage;

// Note: This message is not used, it remains in the ITCH specification for future reference and is not applicable for BIST markets. A replace of an existing order would be represented by an Order Delete Message followed by an Order Add Message but the original order ID would remain. This message would be sent whenever an order on the book has been cancel-replaced. The Side and Order book ID remain the same as the original order.
typedef struct _OrderReplaceMessage {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT64BE order_id;                 // bytes 4 to 11
  UINT32BE order_book_id;            // bytes 12 to 15
  UINT8 side;                        // byte 16
  UINT32BE new_order_book_position;  // bytes 17 to 20
  UINT64BE quantity;                 // bytes 21 to 28
  UINT32BE price;                    // bytes 29 to 32, signed, read here as unsigned
  UINT16BE reserved_2 : 2;           // bytes 33 to 34
  UINT16BE bait_implied_order : 1;   // bytes 33 to 34
  UINT16BE reserved_13 : 13;         // bytes 33 to 34
} OrderReplaceMessage;

// Sent whenever an order on the book is being deleted. There will be no remaining quantity, so the order should be removed from the book. Normally, no Order Delete message is sent when an order is completely filled.
typedef struct _OrderDeleteMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT64BE order_id;       // bytes 4 to 11
  UINT32BE order_book_id;  // bytes 12 to 15
  UINT8 side;              // byte 16
} OrderDeleteMessage;

// Sent whenever an order book is flushed. All remaining orders are no longer accessible and should be removed from the book. Markets by order dissemination may be disabled during auctions by configuration; in such cases every existing order of the order book is removed by this message immediately prior to the auction. Owners of these orders must not interpret this as order cancellations, and should use the private order flow to determine the state of their orders.
typedef struct _OrderBookFlushMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
} OrderBookFlushMessage;

// Designed to provide execution details for normal match events involving non-displayable order types. Also used to publish individual cross trades. Since no Add Order Message is generated when a non-displayed order is initially received, the Order Executed message cannot be used for all matches; the Trade Message reports a match for a non-displayable order in the book. Trade Messages should be included in trade tickers as well as volume and other market statistics.
typedef struct _TradeMessage {
  UINT32BE nanoseconds;     // bytes 0 to 3
  UINT64BE match_id;        // bytes 4 to 11
  UINT32BE combo_group_id;  // bytes 12 to 15
  UINT8 side;               // byte 16
  UINT64BE quantity;        // bytes 17 to 24
  UINT32BE order_book_id;   // bytes 25 to 28
  UINT32BE trade_price;     // bytes 29 to 32, signed, read here as unsigned
  UINT8 reserved_14[14];    // bytes 33 to 46
  UINT8 printable;          // byte 47
  UINT8 occurred_at_cross;  // byte 48
} TradeMessage;

// Used when auctions occur. Provides the changes in equilibrium price. Markets by order dissemination may be disabled during auctions by configuration.
typedef struct _EquilibriumPriceUpdate {
  UINT32BE nanoseconds;                                  // bytes 0 to 3
  UINT32BE order_book_id;                                // bytes 4 to 7
  UINT64BE available_bid_quantity_at_equilibrium_price;  // bytes 8 to 15
  UINT64BE available_ask_quantity_at_equilibrium_price;  // bytes 16 to 23
  UINT32BE equilibrium_price;                            // bytes 24 to 27, signed, read here as unsigned
  UINT32BE best_bid_price;                               // bytes 28 to 31, signed, read here as unsigned
  UINT32BE best_ask_price;                               // bytes 32 to 35, signed, read here as unsigned
  UINT64BE best_bid_quantity;                            // bytes 36 to 43
  UINT64BE best_ask_quantity;                            // bytes 44 to 51
} EquilibriumPriceUpdate;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: SecondsMessage seconds_message;
    case 0x52: OrderBookDirectory order_book_directory;
    case 0x4D: CombinationOrderBookLeg combination_order_book_leg;
    case 0x4C: TickSizeTableEntry tick_size_table_entry;
    case 0x56: ShortSellStatus short_sell_status;
    case 0x53: SystemEventMessage system_event_message;
    case 0x4F: OrderBookStateMessage order_book_state_message;
    case 0x41: AddOrderNoMpidAttribution add_order_no_mpid_attribution;
    case 0x46: AddOrderWithMpidAttribution add_order_with_mpid_attribution;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceMessage order_executed_with_price_message;
    case 0x55: OrderReplaceMessage order_replace_message;
    case 0x44: OrderDeleteMessage order_delete_message;
    case 0x59: OrderBookFlushMessage order_book_flush_message;
    case 0x50: TradeMessage trade_message;
    case 0x5A: EquilibriumPriceUpdate equilibrium_price_update;
    default: UINT8 unknown[available];
  }
} Payload;

// Mold Udp64 Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 1)) payload[:byte-size-single-element-array (((UINT32) message_length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Mold Udp64 Message
typedef struct _MessageRun (UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} MessageRun;

// Branch
casetype _Messages (UINT16 selector, UINT16 message_count, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0000: unit heartbeat;
    case 0xFFFF: unit end_of_session;
    default: MessageRun(message_count, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Itch Mold Udp 64 Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                           // bytes 0 to 9
  UINT64BE sequence_number;                                                                                                    // bytes 10 to 17
  UINT16BE message_count;                                                                                                      // bytes 18 to 19
  Messages(message_count, message_count, (available - 20), tally) messages[:byte-size-single-element-array (available - 20)];
} Packet;

