// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out BorsaIstanbul_GeniumInet_v2_7_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_SECONDS_MESSAGE 0x54                  // Seconds Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_BOOK_DIRECTORY 0x52             // Order Book Directory
#define SEQUENCED_MESSAGE_TYPE_COMBINATION_ORDER_BOOK_LEG 0x4D       // Combination Order Book Leg
#define SEQUENCED_MESSAGE_TYPE_TICK_SIZE_TABLE_ENTRY 0x4C            // Tick Size Table Entry
#define SEQUENCED_MESSAGE_TYPE_SHORT_SELL_STATUS 0x56                // Short Sell Status
#define SEQUENCED_MESSAGE_TYPE_ORDER_BOOK_STATE_MESSAGE 0x4F         // Order Book State Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_NO_MPID_ATTRIBUTION 0x41    // Add Order No Mpid Attribution
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_WITH_MPID_ATTRIBUTION 0x46  // Add Order With Mpid Attribution
#define SEQUENCED_MESSAGE_TYPE_END_OF_SNAPSHOT_MESSAGE 0x47          // End Of Snapshot Message

// Financial Product: one byte code
#define FINANCIAL_PRODUCT_OPTION 0x01                          // Option
#define FINANCIAL_PRODUCT_FORWARD 0x02                         // Forward
#define FINANCIAL_PRODUCT_FUTURE 0x03                          // Future
#define FINANCIAL_PRODUCT_FRA 0x04                             // Fra
#define FINANCIAL_PRODUCT_CASH 0x05                            // Cash
#define FINANCIAL_PRODUCT_PAYMENT 0x06                         // Payment
#define FINANCIAL_PRODUCT_EXCHANGE_RATE 0x07                   // Exchange Rate
#define FINANCIAL_PRODUCT_INTEREST_RATE_SWAP 0x08              // Interest Rate Swap
#define FINANCIAL_PRODUCT_REPO 0x09                            // Repo
#define FINANCIAL_PRODUCT_SYNTHETIC_BOX_LEG_OR_REFERENCE 0x0A  // Synthetic Box Leg Or Reference
#define FINANCIAL_PRODUCT_STANDARD_COMBINATION 0x0B            // Standard Combination
#define FINANCIAL_PRODUCT_GUARANTEE 0x0C                       // Guarantee
#define FINANCIAL_PRODUCT_OTC_GENERAL 0x0D                     // Otc General
#define FINANCIAL_PRODUCT_EQUITY_WARRANT 0x0E                  // Equity Warrant
#define FINANCIAL_PRODUCT_SECURITY_LENDING 0x0F                // Security Lending
#define FINANCIAL_PRODUCT_CERTIFICATE 0x12                     // Certificate

// Put Or Call: one byte code
#define PUT_OR_CALL_UNDEFINED 0x00  // Undefined
#define PUT_OR_CALL_CALL 0x01       // Call
#define PUT_OR_CALL_PUT 0x02        // Put

// Ranking Type: one byte code
#define RANKING_TYPE_PRICE_TIME 0x01  // Price Time

// Leg Side: one byte code
#define LEG_SIDE_AS_DEFINED 0x42  // As Defined
#define LEG_SIDE_OPPOSITE 0x43    // Opposite

// Short Sale Restriction: one byte code
#define SHORT_SALE_RESTRICTION_NO_RESTRICTIONS 0x00                          // No Restrictions
#define SHORT_SALE_RESTRICTION_SHORT_SELLING_NOT_ALLOWED 0x01                // Short Selling Not Allowed
#define SHORT_SALE_RESTRICTION_SHORT_SELLING_ALLOWED_WITH_UP_TICK_RULE 0x02  // Short Selling Allowed With Up Tick Rule

// Side: one byte code
#define SIDE_BUY_ORDER 0x42   // Buy Order
#define SIDE_SELL_ORDER 0x53  // Sell Order

// Lot Type: one byte code
#define LOT_TYPE_ROUND_LOT 0x02  // Round Lot

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// Sent every second for which at least one message is being generated. Contains the number of seconds since the start of 1970-01-01 00:00:00 UTC, also called Unix Time.
typedef struct _SecondsMessage {
  UINT32BE second;  // bytes 0 to 3
} SecondsMessage;

// Order book directory messages are disseminated for all active securities, including halted securities, in the Genium INET Trading system.
typedef struct _OrderBookDirectory {
  UINT32BE nanoseconds;                // bytes 0 to 3
  UINT32BE order_book_id;              // bytes 4 to 7
  UINT8 symbol[32];                    // bytes 8 to 39
  UINT8 long_name[32];                 // bytes 40 to 71
  UINT8 isin[12];                      // bytes 72 to 83
  UINT8 financial_product;             // byte 84
  UINT8 trading_currency[3];           // bytes 85 to 87
  UINT16BE decimals_in_price;          // bytes 88 to 89
  UINT16BE decimals_in_nominal_value;  // bytes 90 to 91
  UINT32BE odd_lot_size;               // bytes 92 to 95
  UINT32BE round_lot_size;             // bytes 96 to 99
  UINT32BE block_lot_size;             // bytes 100 to 103
  UINT64BE nominal_value;              // bytes 104 to 111
  UINT8 number_of_legs;                // byte 112
  UINT32BE underlying_order_book_id;   // bytes 113 to 116
  UINT32BE strike_price;               // bytes 117 to 120, signed, read here as unsigned
  UINT32BE expiration_date;            // bytes 121 to 124
  UINT16BE decimals_in_strike_price;   // bytes 125 to 126
  UINT8 put_or_call;                   // byte 127
  UINT8 ranking_type;                  // byte 128
} OrderBookDirectory;

// A specialized directory message used when Combination order books are traded at the marketplace. It represents both standard combinations defined by the exchange, and tailor-made combinations created by members.
typedef struct _CombinationOrderBookLeg {
  UINT32BE nanoseconds;                // bytes 0 to 3
  UINT32BE combination_order_book_id;  // bytes 4 to 7
  UINT32BE leg_order_book_id;          // bytes 8 to 11
  UINT8 leg_side;                      // byte 12
  UINT32BE leg_ratio;                  // bytes 13 to 16
} CombinationOrderBookLeg;

// Contains information on a tick size for a price range. Together, all Tick Size messages with the same order book ID form a complete Tick Size Table.
typedef struct _TickSizeTableEntry {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
  UINT64BE tick_size;      // bytes 8 to 15
  UINT32BE price_from;     // bytes 16 to 19, signed, read here as unsigned
  UINT32BE price_to;       // bytes 20 to 23, signed, read here as unsigned
} TickSizeTableEntry;

// Indicates the short sell rules of an order book. Sent for order books which might have short sell allowing prior to the start of system. If an order book is absent from this message, clients should assume that the order book has no short selling rules at the start-of-day reference data messages.
typedef struct _ShortSellStatus {
  UINT32BE nanoseconds;          // bytes 0 to 3
  UINT32BE order_book_id;        // bytes 4 to 7
  UINT8 short_sale_restriction;  // byte 8
} ShortSellStatus;

// Relays information on order book state changes.
typedef struct _OrderBookStateMessage {
  UINT32BE nanoseconds;    // bytes 0 to 3
  UINT32BE order_book_id;  // bytes 4 to 7
  UINT8 state_name[20];    // bytes 8 to 27
} OrderBookStateMessage;

// Indicates that a new order has been accepted by the Genium INET Trading system and was added to the displayable book. Generated for unattributed orders. The message includes an Order ID that is unique per order book and side.
typedef struct _AddOrderNoMpidAttribution {
  UINT32BE nanoseconds;              // bytes 0 to 3
  UINT64BE order_id;                 // bytes 4 to 11
  UINT32BE order_book_id;            // bytes 12 to 15
  UINT8 side;                        // byte 16
  UINT32BE ranking_sequence_number;  // bytes 17 to 20
  UINT64BE quantity;                 // bytes 21 to 28
  UINT32BE price;                    // bytes 29 to 32, signed, read here as unsigned
  UINT16BE reserved_2 : 2;           // bytes 33 to 34
  UINT16BE bait_implied_order : 1;   // bytes 33 to 34
  UINT16BE reserved_13 : 13;         // bytes 33 to 34
  UINT8 lot_type;                    // byte 35
  UINT64BE ranking_time;             // bytes 36 to 43
} AddOrderNoMpidAttribution;

// Note: not applicable for BIST markets. Would be generated for attributed orders and quotations entered into the Genium INET Trading system.
typedef struct _AddOrderWithMpidAttribution {
  UINT32BE nanoseconds;             // bytes 0 to 3
  UINT64BE order_id;                // bytes 4 to 11
  UINT32BE order_book_id;           // bytes 12 to 15
  UINT8 side;                       // byte 16
  UINT8 reserved_4[4];              // bytes 17 to 20
  UINT64BE quantity;                // bytes 21 to 28
  UINT32BE price;                   // bytes 29 to 32, signed, read here as unsigned
  UINT16BE reserved_2 : 2;          // bytes 33 to 34
  UINT16BE bait_implied_order : 1;  // bytes 33 to 34
  UINT16BE reserved_13 : 13;        // bytes 33 to 34
  UINT8 lot_type;                   // byte 35
  UINT8 participant_id[7];          // bytes 36 to 42
} AddOrderWithMpidAttribution;

// Returns the current ITCH sequence number to be used when connecting to the ITCH feed. To maintain a real-time order display, firms should begin to process real-time Genium INET ITCH messages beginning with the sequence number stated in this snapshot message. After transmission, the user will be logged out immediately by the system.
typedef struct _EndOfSnapshotMessage {
  UINT8 sequence_number[20];  // bytes 0 to 19
} EndOfSnapshotMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: SecondsMessage seconds_message;
    case 0x52: OrderBookDirectory order_book_directory;
    case 0x4D: CombinationOrderBookLeg combination_order_book_leg;
    case 0x4C: TickSizeTableEntry tick_size_table_entry;
    case 0x56: ShortSellStatus short_sell_status;
    case 0x4F: OrderBookStateMessage order_book_state_message;
    case 0x41: AddOrderNoMpidAttribution add_order_no_mpid_attribution;
    case 0x46: AddOrderWithMpidAttribution add_order_with_mpid_attribution;
    case 0x47: EndOfSnapshotMessage end_of_snapshot_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat;
    case 0x5A: unit end_of_session;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

