// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out CixAts_CixAspen_Snapshot_v1_1.3d

// ---- Values ------------------------------------------------------------------

// Packet Type: one byte code
#define PACKET_TYPE_LOGIN_MESSAGE 0x4C             // Login Message
#define PACKET_TYPE_CLIENT_HEARTBEAT_MESSAGE 0x52  // Client Heartbeat Message
#define PACKET_TYPE_SUCCESSFUL_LOGIN_MESSAGE 0x41  // Successful Login Message
#define PACKET_TYPE_LOGIN_REJECT_MESSAGE 0x4A      // Login Reject Message
#define PACKET_TYPE_SERVER_HEARTBEAT_MESSAGE 0x48  // Server Heartbeat Message
#define PACKET_TYPE_BINARY_DATA_MESSAGE 0x53       // Binary Data Message

// Feed Identifier: one byte code
#define FEED_IDENTIFIER_ASPEN 0x41           // Aspen
#define FEED_IDENTIFIER_ASPEN_VERT 0x56      // Aspen Vert
#define FEED_IDENTIFIER_MIDPOINT 0x4D        // Midpoint
#define FEED_IDENTIFIER_ASPEN_UAT 0x42       // Aspen Uat
#define FEED_IDENTIFIER_ASPEN_VERT_UAT 0x57  // Aspen Vert Uat
#define FEED_IDENTIFIER_MIDPOINT_UAT 0x4E    // Midpoint Uat

// Reason Code: one byte code
#define REASON_CODE_INVALID_USER_PASSWORD 0x41       // Invalid User Password
#define REASON_CODE_INVALID_SEQUENCE 0x42            // Invalid Sequence
#define REASON_CODE_INVALID_MARKET_DAY_FEED_ID 0x53  // Invalid Market Day Feed Id

// Message Type: one byte code
#define MESSAGE_TYPE_MARKET_EVENT_MESSAGE 0x41          // Market Event Message
#define MESSAGE_TYPE_SYMBOL_INFORMATION_MESSAGE 0x42    // Symbol Information Message
#define MESSAGE_TYPE_SYMBOL_STATE_MESSAGE 0x43          // Symbol State Message
#define MESSAGE_TYPE_NEW_ORDER_ADD_MESSAGE 0x44         // New Order Add Message
#define MESSAGE_TYPE_ORDER_PARTIAL_CANCEL_MESSAGE 0x46  // Order Partial Cancel Message
#define MESSAGE_TYPE_ORDER_CANCEL_ALL_MESSAGE 0x47      // Order Cancel All Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x4A        // Order Executed Message
#define MESSAGE_TYPE_END_OF_SNAPSHOT_MESSAGE 0x58       // End Of Snapshot Message

// Event: one byte code
#define EVENT_START_OF_SESSION 0x4F           // Start Of Session
#define EVENT_MARKET_ACCEPTING_ORDERS 0x53    // Market Accepting Orders
#define EVENT_MARKET_OPEN_FOR_TRADING 0x51    // Market Open For Trading
#define EVENT_MARKET_CLOSED_FOR_TRADING 0x45  // Market Closed For Trading
#define EVENT_END_OF_SESSION 0x43             // End Of Session

// Listing Market: one byte code
#define LISTING_MARKET_TSX 0x54      // Tsx
#define LISTING_MARKET_VENTURE 0x56  // Venture
#define LISTING_MARKET_CSE 0x43      // Cse
#define LISTING_MARKET_NEO 0x4E      // Neo

// State: one byte code
#define STATE_HALTED 0x48   // Halted
#define STATE_TRADING 0x54  // Trading

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// ---- Types -------------------------------------------------------------------

// The client must login to the server before it will receive data
typedef struct _LoginMessage {
  UINT8 user[6];                   // bytes 0 to 5
  UINT8 pass[10];                  // bytes 6 to 15
  UINT8 market_day_identifier[9];  // bytes 16 to 24
  UINT8 feed_identifier;           // byte 25
  UINT8 requested_sequence[20];    // bytes 26 to 45
} LoginMessage;

// Sent by the server to accept a Login Message
typedef struct _SuccessfulLoginMessage {
  UINT8 market_day_identifier[9];  // bytes 0 to 8
  UINT8 feed_identifier;           // byte 9
  UINT8 next_sequence[20];         // bytes 10 to 29
} SuccessfulLoginMessage;

// Sent by the server to reject a Login Message
typedef struct _LoginRejectMessage {
  UINT8 reason_code;  // byte 0
} LoginRejectMessage;

// Transitions in the overall session state
typedef struct _MarketEventMessage {
  UINT8 reserved_2[2];  // bytes 0 to 1
  UINT64 timestamp;     // bytes 2 to 9
  UINT8 event;          // byte 10
} MarketEventMessage;

// Reference data for each symbol that may be traded
typedef struct _SymbolInformationMessage {
  UINT64 timestamp;       // bytes 0 to 7
  UINT16 symbol_id;       // bytes 8 to 9
  UINT8 symbol[11];       // bytes 10 to 20
  UINT8 listing_market;   // byte 21
  UINT32 board_lot_size;  // bytes 22 to 25
} SymbolInformationMessage;

// Individual symbol trading state (halts)
typedef struct _SymbolStateMessage {
  UINT64 timestamp;  // bytes 0 to 7
  UINT16 symbol_id;  // bytes 8 to 9
  UINT8 symbol[11];  // bytes 10 to 20
  UINT8 state;       // byte 21
  UINT8 reserved_1;  // byte 22
  UINT8 info[4];     // bytes 23 to 26
} SymbolStateMessage;

// A new resting order added to the book
typedef struct _NewOrderAddMessage {
  UINT64 timestamp;  // bytes 0 to 7
  UINT16 symbol_id;  // bytes 8 to 9
  UINT64 order_id;   // bytes 10 to 17
  UINT8 side;        // byte 18
  UINT64 quantity;   // bytes 19 to 26
  UINT8 symbol[11];  // bytes 27 to 37
  UINT64 price;      // bytes 38 to 45
  UINT8 broker[3];   // bytes 46 to 48
  UINT8 reserved_1;  // byte 49
} NewOrderAddMessage;

// Part of a resting order is canceled
typedef struct _OrderPartialCancelMessage {
  UINT64 timestamp;          // bytes 0 to 7
  UINT64 order_id;           // bytes 8 to 15
  UINT64 quantity_canceled;  // bytes 16 to 23
} OrderPartialCancelMessage;

// Sent when the order is canceled in its entirety
typedef struct _OrderCancelAllMessage {
  UINT64 timestamp;  // bytes 0 to 7
  UINT64 order_id;   // bytes 8 to 15
} OrderCancelAllMessage;

// Sent when an order is executed
typedef struct _OrderExecutedMessage {
  UINT64 timestamp;        // bytes 0 to 7
  UINT64 order_id;         // bytes 8 to 15
  UINT64 quantity;         // bytes 16 to 23
  UINT64 execution_id;     // bytes 24 to 31
  UINT8 side;              // byte 32
  UINT64 price;            // bytes 33 to 40
  UINT8 broker[3];         // bytes 41 to 43
  UINT8 contra_broker[3];  // bytes 44 to 46
} OrderExecutedMessage;

// Sent once the snapshot has completed
typedef struct _EndOfSnapshotMessage {
  UINT64 sequence;  // bytes 0 to 7
} EndOfSnapshotMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: MarketEventMessage market_event_message;
    case 0x42: SymbolInformationMessage symbol_information_message;
    case 0x43: SymbolStateMessage symbol_state_message;
    case 0x44: NewOrderAddMessage new_order_add_message;
    case 0x46: OrderPartialCancelMessage order_partial_cancel_message;
    case 0x47: OrderCancelAllMessage order_cancel_all_message;
    case 0x4A: OrderExecutedMessage order_executed_message;
    case 0x58: EndOfSnapshotMessage end_of_snapshot_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Carries one encapsulated application message as a Message Type byte followed by its payload
typedef struct _BinaryDataMessage (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                               // byte 0
  Payload(message_type, (available - 1)) payload[:byte-size-single-element-array (available - 1)];
} BinaryDataMessage;

// Branch
casetype _PacketPayload (UINT8 selector, UINT32 length, UINT32 available) {
  switch (selector) {
    case 0x4C: LoginMessage login_message;
    case 0x52: unit client_heartbeat_message;
    case 0x41: SuccessfulLoginMessage successful_login_message;
    case 0x4A: LoginRejectMessage login_reject_message;
    case 0x48: unit server_heartbeat_message;
    case 0x53: BinaryDataMessage(length) binary_data_message[:byte-size-single-element-array length];
    default: UINT8 unknown[available];
  }
} PacketPayload;

// Length delimited TcpOut packet
typedef struct _TcpPacket {
  UINT16 length { length >= 3 };                                                                                                                         // bytes 0 to 1
  UINT8 packet_type;                                                                                                                                     // byte 2
  PacketPayload(packet_type, (((UINT32) length) - 3), (((UINT32) length) - 3)) packet_payload[:byte-size-single-element-array (((UINT32) length) - 3)];
} TcpPacket;

// ---- Packet: Packet ----------------------------------------------------------

// TcpOut Packet
entrypoint typedef struct _Packet (UINT32 available) {
  TcpPacket tcp_packet[:byte-size available];
} Packet;

