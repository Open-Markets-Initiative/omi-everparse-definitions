// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AthexDerivatives_Relaxed_v5_2.3d

// ---- Values ------------------------------------------------------------------

// Message Category: one byte code
#define MESSAGE_CATEGORY_APA_POST_TRADE_MESSAGE 0x55  // Apa Post Trade Message
#define MESSAGE_CATEGORY_APA_PRE_TRADE_MESSAGE 0x56   // Apa Pre Trade Message

// Message Subcategory: one byte code
#define MESSAGE_SUBCATEGORY_GENERIC 0x20                         // Generic
#define MESSAGE_SUBCATEGORY_BOND 0x42                            // Bond
#define MESSAGE_SUBCATEGORY_ETF 0x45                             // Etf
#define MESSAGE_SUBCATEGORY_STOCK_INDEX 0x49                     // Stock Index
#define MESSAGE_SUBCATEGORY_ETF_INDICATIVE_NET_ASSET_VALUE 0x4E  // Etf Indicative Net Asset Value
#define MESSAGE_SUBCATEGORY_STOCK_RIGHTS 0x53                    // Stock Rights
#define MESSAGE_SUBCATEGORY_WARRANT 0x57                         // Warrant
#define MESSAGE_SUBCATEGORY_OPTION 0x4F                          // Option
#define MESSAGE_SUBCATEGORY_FUTURE 0x46                          // Future
#define MESSAGE_SUBCATEGORY_REPOS 0x52                           // Repos
#define MESSAGE_SUBCATEGORY_STANDARD_COMBINATIONS 0x56           // Standard Combinations

// Trade Id Indicator: one byte code
#define TRADE_ID_INDICATOR_OASIS_TRADE_ID 0x31        // Oasis Trade Id
#define TRADE_ID_INDICATOR_OTHER_VENUE_TRADE_ID 0x32  // Other Venue Trade Id

// Transaction To Be Cleared: one byte code
#define TRANSACTION_TO_BE_CLEARED_FALSE 0x30  // False
#define TRANSACTION_TO_BE_CLEARED_TRUE 0x31   // True

// Deferral Indicator: one byte code
#define DEFERRAL_INDICATOR_FALSE 0x30  // False
#define DEFERRAL_INDICATOR_TRUE 0x31   // True

// Lmtf: one byte code
#define LMTF_FALSE 0x30  // False
#define LMTF_TRUE 0x31   // True

// Fulf: one byte code
#define FULF_FALSE 0x30  // False
#define FULF_TRUE 0x31   // True

// Datf: one byte code
#define DATF_FALSE 0x30  // False
#define DATF_TRUE 0x31   // True

// Fula: one byte code
#define FULA_FALSE 0x30  // False
#define FULA_TRUE 0x31   // True

// Volo: one byte code
#define VOLO_FALSE 0x30  // False
#define VOLO_TRUE 0x31   // True

// Fulv: one byte code
#define FULV_FALSE 0x30  // False
#define FULV_TRUE 0x31   // True

// Fwaf: one byte code
#define FWAF_FALSE 0x30  // False
#define FWAF_TRUE 0x31   // True

// Fulj: one byte code
#define FULJ_FALSE 0x30  // False
#define FULJ_TRUE 0x31   // True

// Idaf: one byte code
#define IDAF_FALSE 0x30  // False
#define IDAF_TRUE 0x31   // True

// Volw: one byte code
#define VOLW_FALSE 0x30  // False
#define VOLW_TRUE 0x31   // True

// Coaf: one byte code
#define COAF_FALSE 0x30  // False
#define COAF_TRUE 0x31   // True

// Quote Type: one byte code
#define QUOTE_TYPE_BID 0x31    // Bid
#define QUOTE_TYPE_OFFER 0x32  // Offer

// Quote Liquidity: one byte code
#define QUOTE_LIQUIDITY_LIQUID_MARKET 0x31    // Liquid Market
#define QUOTE_LIQUIDITY_ILLIQUID_MARKET 0x32  // Illiquid Market

// ---- Types -------------------------------------------------------------------

// Transmitted whenever a trade is reported to the Ids subsystem, for the Athex Apa post trade transparency service required by Mifid II
typedef struct _ApaPostTradeMessage {
  UINT8 report_status[4];                                  // bytes 0 to 3
  UINT8 trading_date_and_time[20];                         // bytes 4 to 23
  UINT8 trade_id_indicator;                                // byte 24
  UINT8 trade_id[52];                                      // bytes 25 to 76
  UINT8 venue[4];                                          // bytes 77 to 80
  UINT8 transaction_to_be_cleared;                         // byte 81
  UINT8 price_notation[4];                                 // bytes 82 to 85
  UINT8 price[18];                                         // bytes 86 to 103
  UINT8 price_currency[3];                                 // bytes 104 to 106
  UINT8 quantity[18];                                      // bytes 107 to 124
  UINT8 quantity_currency[3];                              // bytes 125 to 127
  UINT8 notation_of_the_quantity_in_measurement_unit[25];  // bytes 128 to 152
  UINT8 quantity_in_measurement_unit[18];                  // bytes 153 to 170
  UINT8 notional_amount[18];                               // bytes 171 to 188
  UINT8 notional_currency[3];                              // bytes 189 to 191
  UINT8 instrument_id_type[4];                             // bytes 192 to 195
  UINT8 instrument_id[12];                                 // bytes 196 to 207
  UINT8 instrument_full_name[350];                         // bytes 208 to 557
  UINT8 instrument_classification[6];                      // bytes 558 to 563
  UINT8 price_multiplier[18];                              // bytes 564 to 581
  UINT8 underlying_instrument_code[12];                    // bytes 582 to 593
  UINT8 underlying_index_name[25];                         // bytes 594 to 618
  UINT8 term_of_the_underlying_index[7];                   // bytes 619 to 625
  UINT8 option_type[4];                                    // bytes 626 to 629
  UINT8 strike_price[18];                                  // bytes 630 to 647
  UINT8 strike_price_currency[3];                          // bytes 648 to 650
  UINT8 strike_price_notation[4];                          // bytes 651 to 654
  UINT8 option_exercise_style[4];                          // bytes 655 to 658
  UINT8 maturity_date[8];                                  // bytes 659 to 666
  UINT8 expiry_date[8];                                    // bytes 667 to 674
  UINT8 delivery_type[4];                                  // bytes 675 to 678
  UINT8 type_emission_allowance[4];                        // bytes 679 to 682
  UINT8 otc_post_trade_indicator[4];                       // bytes 683 to 686
  UINT8 deferral_indicator;                                // byte 687
  UINT8 lmtf;                                              // byte 688
  UINT8 fulf;                                              // byte 689
  UINT8 datf;                                              // byte 690
  UINT8 fula;                                              // byte 691
  UINT8 volo;                                              // byte 692
  UINT8 fulv;                                              // byte 693
  UINT8 fwaf;                                              // byte 694
  UINT8 fulj;                                              // byte 695
  UINT8 idaf;                                              // byte 696
  UINT8 volw;                                              // byte 697
  UINT8 coaf;                                              // byte 698
} ApaPostTradeMessage;

// Transmitted whenever a quote is reported to the Ids subsystem by the Athex Apa service, for the Athex Apa pre trade transparency service
typedef struct _ApaPreTradeMessage {
  UINT8 report_status[4];                                  // bytes 0 to 3
  UINT8 quote_type;                                        // byte 4
  UINT8 quote_id[52];                                      // bytes 5 to 56
  UINT8 event_time[20];                                    // bytes 57 to 76
  UINT8 quote_liquidity;                                   // byte 77
  UINT8 venue_mic[4];                                      // bytes 78 to 81
  UINT8 submitting_entity_identification_code[20];         // bytes 82 to 101
  UINT8 price_notation[4];                                 // bytes 102 to 105
  UINT8 price[18];                                         // bytes 106 to 123
  UINT8 price_currency[3];                                 // bytes 124 to 126
  UINT8 quantity[18];                                      // bytes 127 to 144
  UINT8 quantity_currency[3];                              // bytes 145 to 147
  UINT8 notation_of_the_quantity_in_measurement_unit[25];  // bytes 148 to 172
  UINT8 quantity_in_measurement_unit[18];                  // bytes 173 to 190
  UINT8 notional_amount[18];                               // bytes 191 to 208
  UINT8 notional_currency[3];                              // bytes 209 to 211
  UINT8 instrument_id_type[4];                             // bytes 212 to 215
  UINT8 instrument_id[12];                                 // bytes 216 to 227
  UINT8 instrument_full_name[350];                         // bytes 228 to 577
  UINT8 instrument_classification[6];                      // bytes 578 to 583
  UINT8 price_multiplier[18];                              // bytes 584 to 601
  UINT8 underlying_instrument_code[12];                    // bytes 602 to 613
  UINT8 underlying_index_name[25];                         // bytes 614 to 638
  UINT8 term_of_the_underlying_index[7];                   // bytes 639 to 645
  UINT8 option_type[4];                                    // bytes 646 to 649
  UINT8 strike_price[18];                                  // bytes 650 to 667
  UINT8 strike_price_currency[3];                          // bytes 668 to 670
  UINT8 strike_price_notation[4];                          // bytes 671 to 674
  UINT8 option_exercise_style[4];                          // bytes 675 to 678
  UINT8 maturity_date[8];                                  // bytes 679 to 686
  UINT8 expiry_date[8];                                    // bytes 687 to 694
  UINT8 delivery_type[4];                                  // bytes 695 to 698
} ApaPreTradeMessage;

// Branch
casetype _MessageText (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x55: ApaPostTradeMessage apa_post_trade_message;
    case 0x56: ApaPreTradeMessage apa_pre_trade_message;
    default: UINT8 unknown[available];
  }
} MessageText;

// ---- Packet: Packet ----------------------------------------------------------

// Athex Ids Tcp Packet
entrypoint typedef struct _Packet (UINT32 available) where (available >= 38) {
  UINT8 soh;                                                                                                       // byte 0
  UINT8 vendor_identifier[2];                                                                                      // bytes 1 to 2
  UINT8 message_category;                                                                                          // byte 3
  UINT8 message_subcategory;                                                                                       // byte 4
  UINT8 venue_i_d[4];                                                                                              // bytes 5 to 8
  UINT8 message_sequence_number[7];                                                                                // bytes 9 to 15
  UINT8 publication_timestamp[20];                                                                                 // bytes 16 to 35
  MessageText(message_category, (available - 38)) message_text[:byte-size-single-element-array (available - 38)];
  UINT8 etx;
  UINT8 lrc;
} Packet;

