// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AthexDerivatives_RealTime_v5_2.3d
//
// What this definition does not state, and the model does:
// - the dispatch that chooses a message by its type
// - a field filling what is left of what holds it
// - a run counted by a field
// - a length prefix framing what follows
// - the packet as a whole, which is a length or count spelled as text, which 3d cannot read as a number, at packet.messagetext.quotemessage.quotelevels

// ---- Values ------------------------------------------------------------------

// Message Category: one byte code
#define MESSAGE_CATEGORY_CONTROL_MESSAGE 0x4B                                               // Control Message
#define MESSAGE_CATEGORY_TRADE_MESSAGE 0x41                                                 // Trade Message
#define MESSAGE_CATEGORY_QUOTE_MESSAGE 0x42                                                 // Quote Message
#define MESSAGE_CATEGORY_INDEX_MESSAGE 0x43                                                 // Index Message
#define MESSAGE_CATEGORY_INSTRUMENT_SUMMARY_MESSAGE 0x47                                    // Instrument Summary Message
#define MESSAGE_CATEGORY_CANCELLED_TRADE_MESSAGE 0x49                                       // Cancelled Trade Message
#define MESSAGE_CATEGORY_CLOSING_PRICE_MESSAGE 0x4C                                         // Closing Price Message
#define MESSAGE_CATEGORY_PROJECTED_AUCTION_AUCTION_OPEN_PROJECTED_CLOSE_PRICE_MESSAGE 0x4D  // Projected Auction Auction Open Projected Close Price Message
#define MESSAGE_CATEGORY_HIGH_LOW_LIMIT_MODIFICATION_MESSAGE 0x4E                           // High Low Limit Modification Message
#define MESSAGE_CATEGORY_INSTRUMENT_STATE_MESSAGE 0x4F                                      // Instrument State Message
#define MESSAGE_CATEGORY_MARKET_STATUS_MESSAGE 0x50                                         // Market Status Message
#define MESSAGE_CATEGORY_ORDER_MESSAGE 0x51                                                 // Order Message
#define MESSAGE_CATEGORY_CANCELLED_ORDER_MESSAGE 0x52                                       // Cancelled Order Message
#define MESSAGE_CATEGORY_EXCHANGE_NOTIFICATIONS_MESSAGE 0x53                                // Exchange Notifications Message

// Message Subcategory: one byte code
#define MESSAGE_SUBCATEGORY_GENERIC 0x20                         // Generic
#define MESSAGE_SUBCATEGORY_BOND 0x42                            // Bond
#define MESSAGE_SUBCATEGORY_ETF 0x45                             // Etf
#define MESSAGE_SUBCATEGORY_STOCK_INDEX 0x49                     // Stock Index
#define MESSAGE_SUBCATEGORY_ETF_INDICATIVE_NET_ASSET_VALUE 0x4E  // Etf Indicative Net Asset Value
#define MESSAGE_SUBCATEGORY_STOCK_RIGHTS 0x53                    // Stock Rights
#define MESSAGE_SUBCATEGORY_WARRANT 0x57                         // Warrant
#define MESSAGE_SUBCATEGORY_OPTION 0x4F                          // Option
#define MESSAGE_SUBCATEGORY_FUTURE 0x46                          // Future
#define MESSAGE_SUBCATEGORY_REPOS 0x52                           // Repos
#define MESSAGE_SUBCATEGORY_STANDARD_COMBINATIONS 0x56           // Standard Combinations

// Board Id: one byte code
#define BOARD_ID_MAIN_BOARD 0x4D           // Main Board
#define BOARD_ID_ODD_LOT_BOARD 0x4F        // Odd Lot Board
#define BOARD_ID_PRE_AGREED_BOARD 0x42     // Pre Agreed Board
#define BOARD_ID_SPECIAL_TERMS_BOARD 0x53  // Special Terms Board
#define BOARD_ID_FORCED_SALES_BOARD 0x46   // Forced Sales Board

// Trade Type: one byte code
#define TRADE_TYPE_NEW 0x4E     // New
#define TRADE_TYPE_EDIT 0x45    // Edit
#define TRADE_TYPE_CANCEL 0x43  // Cancel

// Trade Source: one byte code
#define TRADE_SOURCE_TRADING_PLATFORM 0x54  // Trading Platform
#define TRADE_SOURCE_CLEARING_SYSTEM 0x43   // Clearing System

// Buy Order Type: one byte code
#define BUY_ORDER_TYPE_STRATEGY 0x42  // Strategy
#define BUY_ORDER_TYPE_QUOTE 0x51     // Quote
#define BUY_ORDER_TYPE_NORMAL 0x4E    // Normal

// Sell Order Type: one byte code
#define SELL_ORDER_TYPE_STRATEGY 0x42  // Strategy
#define SELL_ORDER_TYPE_QUOTE 0x51     // Quote
#define SELL_ORDER_TYPE_NORMAL 0x4E    // Normal

// Buy Algo Flag: one byte code
#define BUY_ALGO_FLAG_FLAG_ON 0x59  // Flag On

// Sell Algo Flag: one byte code
#define SELL_ALGO_FLAG_FLAG_ON 0x59  // Flag On

// Sdiv Flag: one byte code
#define SDIV_FLAG_FLAG_ON 0x59  // Flag On

// Dupl Flag: one byte code
#define DUPL_FLAG_FLAG_ON 0x59  // Flag On

// Price Flag: one byte code
#define PRICE_FLAG_PROJECTED_AUCTION_PRICE 0x30  // Projected Auction Price
#define PRICE_FLAG_AUCTION_OPEN_PRICE 0x31       // Auction Open Price
#define PRICE_FLAG_PROJECTED_CLOSE 0x32          // Projected Close

// Phase Id: one byte code
#define PHASE_ID_START_PHASE 0x20            // Start Phase
#define PHASE_ID_PRE_CALL 0x50               // Pre Call
#define PHASE_ID_CONTINUOUS 0x54             // Continuous
#define PHASE_ID_ATC_ORDERS_RELEASED 0x41    // Atc Orders Released
#define PHASE_ID_CLOSING_PRICE_TRADING 0x43  // Closing Price Trading
#define PHASE_ID_STOP 0x53                   // Stop

// Instrument Status: one byte code
#define INSTRUMENT_STATUS_ACTIVE 0x41     // Active
#define INSTRUMENT_STATUS_HALT 0x48       // Halt
#define INSTRUMENT_STATUS_SUSPENDED 0x53  // Suspended
#define INSTRUMENT_STATUS_RESUMED 0x52    // Resumed

// Halt Suspend Reason: one byte code
#define HALT_SUSPEND_REASON_NO_REASON 0x20               // No Reason
#define HALT_SUSPEND_REASON_EXCHANGE 0x45                // Exchange
#define HALT_SUSPEND_REASON_VOLATILITY_INTERRUPTER 0x56  // Volatility Interrupter

// Market Status: one byte code
#define MARKET_STATUS_PRE_CALL 0x50               // Pre Call
#define MARKET_STATUS_PROJECTED_AUCTION 0x4A      // Projected Auction
#define MARKET_STATUS_CONTINUOUS 0x54             // Continuous
#define MARKET_STATUS_CLOSING_PRICE_TRADING 0x43  // Closing Price Trading
#define MARKET_STATUS_RUN_OFF 0x52                // Run Off
#define MARKET_STATUS_END_OF_DAY 0x45             // End Of Day
#define MARKET_STATUS_HALT 0x48                   // Halt

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Original Price Type: one byte code
#define ORIGINAL_PRICE_TYPE_LIMIT_PRICE 0x4C   // Limit Price
#define ORIGINAL_PRICE_TYPE_MARKET 0x4D        // Market
#define ORIGINAL_PRICE_TYPE_AT_THE_OPEN 0x4F   // At The Open
#define ORIGINAL_PRICE_TYPE_AT_THE_CLOSE 0x43  // At The Close

// Order Lifetime: one byte code
#define ORDER_LIFETIME_DAY 0x44               // Day
#define ORDER_LIFETIME_GOOD_TILL_CANCEL 0x43  // Good Till Cancel
#define ORDER_LIFETIME_GOOD_TILL_DATE 0x45    // Good Till Date

// Special Conditions: one byte code
#define SPECIAL_CONDITIONS_NONE 0x4E                 // None
#define SPECIAL_CONDITIONS_FILL_OR_KILL 0x46         // Fill Or Kill
#define SPECIAL_CONDITIONS_IMMEDIATE_OR_CANCEL 0x49  // Immediate Or Cancel
#define SPECIAL_CONDITIONS_STOP_INSTRUMENT 0x53      // Stop Instrument
#define SPECIAL_CONDITIONS_STOP_INDEX 0x44           // Stop Index
#define SPECIAL_CONDITIONS_ALL_OR_NONE 0x41          // All Or None
#define SPECIAL_CONDITIONS_MINIMUM_FILL 0x4D         // Minimum Fill
#define SPECIAL_CONDITIONS_MULTIPLE_OF 0x4F          // Multiple Of

// Order Type: one byte code
#define ORDER_TYPE_STRATEGY 0x42  // Strategy
#define ORDER_TYPE_QUOTE 0x51     // Quote
#define ORDER_TYPE_NORMAL 0x4E    // Normal

// ---- Message Header: 35 bytes ------------------------------------------------

// Thirty five character header succeeding the Soh character of every message packet
entrypoint typedef struct _MessageHeader {
  UINT8 vendor_identifier[2];        // bytes 0 to 1
  UINT8 message_category;            // byte 2, values MESSAGE_CATEGORY_
  UINT8 message_subcategory;         // byte 3, values MESSAGE_SUBCATEGORY_
  UINT8 venue_i_d[4];                // bytes 4 to 7
  UINT8 message_sequence_number[7];  // bytes 8 to 14
  UINT8 publication_timestamp[20];   // bytes 15 to 34
} MessageHeader;

// ---- Trade Message: 147 bytes ------------------------------------------------

// Transmitted when an instrument trade occurs in the trading platform or the clearing system
entrypoint typedef struct _TradeMessage {
  UINT8 symbol[15];                // bytes 0 to 14
  UINT8 board_id;                  // byte 15, values BOARD_ID_
  UINT8 trade_number[6];           // bytes 16 to 21
  UINT8 buy_order_number[8];       // bytes 22 to 29
  UINT8 buy_order_date[8];         // bytes 30 to 37
  UINT8 sell_order_number[8];      // bytes 38 to 45
  UINT8 sell_order_date[8];        // bytes 46 to 53
  UINT8 price[9];                  // bytes 54 to 62
  UINT8 volume[17];                // bytes 63 to 79
  UINT8 total_volume[17];          // bytes 80 to 96
  UINT8 trade_type;                // byte 97, values TRADE_TYPE_
  UINT8 trade_source;              // byte 98, values TRADE_SOURCE_
  UINT8 buy_order_type;            // byte 99, values BUY_ORDER_TYPE_
  UINT8 sell_order_type;           // byte 100, values SELL_ORDER_TYPE_
  UINT8 buy_waiver_indicator[4];   // bytes 101 to 104
  UINT8 sell_waiver_indicator[4];  // bytes 105 to 108
  UINT8 notional_amount[14];       // bytes 109 to 122
  UINT8 buy_algo_flag;             // byte 123, values BUY_ALGO_FLAG_
  UINT8 sell_algo_flag;            // byte 124, values SELL_ALGO_FLAG_
  UINT8 sdiv_flag;                 // byte 125, values SDIV_FLAG_
  UINT8 dupl_flag;                 // byte 126, values DUPL_FLAG_
  UINT8 time_stamp[20];            // bytes 127 to 146
} TradeMessage;

// ---- Index Message: 24 bytes -------------------------------------------------

// Transmitted every time the trading platform calculates the price of a given index
entrypoint typedef struct _IndexMessage {
  UINT8 symbol[15];      // bytes 0 to 14
  UINT8 index_price[9];  // bytes 15 to 23
} IndexMessage;

// ---- Instrument Summary Message: 103 bytes -----------------------------------

// Transmitted for each instrument right after the corresponding market status changes to End of Day
entrypoint typedef struct _InstrumentSummaryMessage {
  UINT8 symbol[15];             // bytes 0 to 14
  UINT8 opening_price[9];       // bytes 15 to 23
  UINT8 high[9];                // bytes 24 to 32
  UINT8 low[9];                 // bytes 33 to 41
  UINT8 last[9];                // bytes 42 to 50
  UINT8 closing_price[9];       // bytes 51 to 59
  UINT8 start_of_day_price[9];  // bytes 60 to 68
  UINT8 total_volume[17];       // bytes 69 to 85
  UINT8 total_value[17];        // bytes 86 to 102
} InstrumentSummaryMessage;

// ---- Cancelled Trade Message: 147 bytes --------------------------------------

// Transmitted when an instrument trade cancellation occurs in the trading platform or clearing system
entrypoint typedef struct _CancelledTradeMessage {
  UINT8 symbol[15];                // bytes 0 to 14
  UINT8 board_id;                  // byte 15, values BOARD_ID_
  UINT8 trade_number[6];           // bytes 16 to 21
  UINT8 buy_order_number[8];       // bytes 22 to 29
  UINT8 buy_order_date[8];         // bytes 30 to 37
  UINT8 sell_order_number[8];      // bytes 38 to 45
  UINT8 sell_order_date[8];        // bytes 46 to 53
  UINT8 cancelled_trade_price[9];  // bytes 54 to 62
  UINT8 cancelled_volume[17];      // bytes 63 to 79
  UINT8 total_volume[17];          // bytes 80 to 96
  UINT8 trade_type;                // byte 97, values TRADE_TYPE_
  UINT8 trade_source;              // byte 98, values TRADE_SOURCE_
  UINT8 buy_order_type;            // byte 99, values BUY_ORDER_TYPE_
  UINT8 sell_order_type;           // byte 100, values SELL_ORDER_TYPE_
  UINT8 buy_waiver_indicator[4];   // bytes 101 to 104
  UINT8 sell_waiver_indicator[4];  // bytes 105 to 108
  UINT8 notional_amount[14];       // bytes 109 to 122
  UINT8 buy_algo_flag;             // byte 123, values BUY_ALGO_FLAG_
  UINT8 sell_algo_flag;            // byte 124, values SELL_ALGO_FLAG_
  UINT8 sdiv_flag;                 // byte 125, values SDIV_FLAG_
  UINT8 dupl_flag;                 // byte 126, values DUPL_FLAG_
  UINT8 time_stamp[20];            // bytes 127 to 146
} CancelledTradeMessage;

// ---- Closing Price Message: 32 bytes -----------------------------------------

// Transmitted for every instrument whose closing price has been calculated by the trading platform, and again whenever the trading platform recalculates one
entrypoint typedef struct _ClosingPriceMessage {
  UINT8 symbol[15];        // bytes 0 to 14
  UINT8 closing[9];        // bytes 15 to 23
  UINT8 open_interest[8];  // bytes 24 to 31
} ClosingPriceMessage;

// ---- Projected Auction Auction Open Projected Close Price Message: 62 bytes ----

// Transmitted whenever the trading platform calculates a Projected Auction, Auction Open or Projected Close price for the instrument
entrypoint typedef struct _ProjectedAuctionAuctionOpenProjectedClosePriceMessage {
  UINT8 symbol[15];      // bytes 0 to 14
  UINT8 price_flag;      // byte 15, values PRICE_FLAG_
  UINT8 price[9];        // bytes 16 to 24
  UINT8 volume[17];      // bytes 25 to 41
  UINT8 time_stamp[20];  // bytes 42 to 61
} ProjectedAuctionAuctionOpenProjectedClosePriceMessage;

// ---- High Low Limit Modification Message: 56 bytes ---------------------------

// Transmitted at the beginning of the trading day, and whenever the static High and Low limits for the given instrument change
entrypoint typedef struct _HighLowLimitModificationMessage {
  UINT8 symbol[15];             // bytes 0 to 14
  UINT8 ceiling_price[9];       // bytes 15 to 23
  UINT8 floor_price[9];         // bytes 24 to 32
  UINT8 start_of_day_price[9];  // bytes 33 to 41
  UINT8 accrued_interest[14];   // bytes 42 to 55
} HighLowLimitModificationMessage;

// ---- Instrument State Message: 38 bytes --------------------------------------

// Transmitted at the beginning of the trading day, and whenever the instrument changes its trading phase or its status
entrypoint typedef struct _InstrumentStateMessage {
  UINT8 symbol[15];           // bytes 0 to 14
  UINT8 phase_id;             // byte 15, values PHASE_ID_
  UINT8 instrument_status;    // byte 16, values INSTRUMENT_STATUS_
  UINT8 halt_suspend_reason;  // byte 17, values HALT_SUSPEND_REASON_
  UINT8 time_stamp[20];       // bytes 18 to 37
} InstrumentStateMessage;

// ---- Market Status Message: 2 bytes ------------------------------------------

// Transmitted whenever the market changes its status
entrypoint typedef struct _MarketStatusMessage {
  UINT8 market_id;      // byte 0
  UINT8 market_status;  // byte 1, values MARKET_STATUS_
} MarketStatusMessage;

// ---- Order Message: 147 bytes ------------------------------------------------

// Transmitted at the beginning of the trading session for an order whose lifetime spans multiple days, when a new order is entered in the trading platform, and when an already placed order is changed. It is not transmitted for Combinations
entrypoint typedef struct _OrderMessage {
  UINT8 symbol[15];                 // bytes 0 to 14
  UINT8 board_id;                   // byte 15, values BOARD_ID_
  UINT8 order_number[8];            // bytes 16 to 23
  UINT8 order_entry_date[8];        // bytes 24 to 31
  UINT8 order_status[2];            // bytes 32 to 33
  UINT8 side;                       // byte 34, values SIDE_
  UINT8 volume[17];                 // bytes 35 to 51
  UINT8 matched_volume[17];         // bytes 52 to 68
  UINT8 price[9];                   // bytes 69 to 77
  UINT8 original_price_type;        // byte 78, values ORIGINAL_PRICE_TYPE_
  UINT8 order_lifetime;             // byte 79, values ORDER_LIFETIME_
  UINT8 special_conditions;         // byte 80, values SPECIAL_CONDITIONS_
  UINT8 condition_volume[17];       // bytes 81 to 97
  UINT8 order_release_date[8];      // bytes 98 to 105
  UINT8 order_release_time[12];     // bytes 106 to 117
  UINT8 last_order_update_date[8];  // bytes 118 to 125
  UINT8 order_type;                 // byte 126, values ORDER_TYPE_
  UINT8 time_stamp[20];             // bytes 127 to 146
} OrderMessage;

// ---- Cancelled Order Message: 117 bytes --------------------------------------

// Transmitted whenever an order is cancelled. It is not transmitted for Combinations
entrypoint typedef struct _CancelledOrderMessage {
  UINT8 symbol[15];            // bytes 0 to 14
  UINT8 board_id;              // byte 15, values BOARD_ID_
  UINT8 order_number[8];       // bytes 16 to 23
  UINT8 order_entry_date[8];   // bytes 24 to 31
  UINT8 side;                  // byte 32, values SIDE_
  UINT8 volume[17];            // bytes 33 to 49
  UINT8 matched_volume[17];    // bytes 50 to 66
  UINT8 price[9];              // bytes 67 to 75
  UINT8 original_price_type;   // byte 76, values ORIGINAL_PRICE_TYPE_
  UINT8 order_lifetime;        // byte 77, values ORDER_LIFETIME_
  UINT8 special_conditions;    // byte 78, values SPECIAL_CONDITIONS_
  UINT8 condition_volume[17];  // bytes 79 to 95
  UINT8 order_type;            // byte 96, values ORDER_TYPE_
  UINT8 time_stamp[20];        // bytes 97 to 116
} CancelledOrderMessage;

