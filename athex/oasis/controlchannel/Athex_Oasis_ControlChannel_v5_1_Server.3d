// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Athex_Oasis_ControlChannel_v5_1_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Message Type: 2 byte code
#define SERVER_MESSAGE_TYPE_SERVER_LOGIN 0x534C                     // Server Login
#define SERVER_MESSAGE_TYPE_SERVER_CLOSE_CONNECTION 0x5343          // Server Close Connection
#define SERVER_MESSAGE_TYPE_SERVER_CHANNEL_STATUS 0x5353            // Server Channel Status
#define SERVER_MESSAGE_TYPE_SERVER_TRANSMISSION 0x5354              // Server Transmission
#define SERVER_MESSAGE_TYPE_SERVER_RETRANSMISSION 0x5352            // Server Retransmission
#define SERVER_MESSAGE_TYPE_SERVER_AUTHENTICATION_CHALLENGE 0x4143  // Server Authentication Challenge
#define SERVER_MESSAGE_TYPE_SERVER_GENERAL_ERROR 0x4745             // Server General Error
#define SERVER_MESSAGE_TYPE_SERVER_GENERAL_NOTIFICATION 0x474E      // Server General Notification

// Result: 2 byte code
#define RESULT_SUCCESS 0x0000                                 // Success
#define RESULT_INVALID_USER_NAME 0x0065                       // Invalid User Name
#define RESULT_INVALID_USER_PASSWORD 0x0066                   // Invalid User Password
#define RESULT_INVALID_RANDOM_NUMBER 0x0067                   // Invalid Random Number
#define RESULT_ALREADY_LOGGED_IN 0x0068                       // Already Logged In
#define RESULT_INVALID_CHANNEL_TYPE 0x00C9                    // Invalid Channel Type
#define RESULT_TRANSMISSION_NEVER_STARTED 0x012D              // Transmission Never Started
#define RESULT_TRANSMISSION_NEVER_STOPPED 0x012E              // Transmission Never Stopped
#define RESULT_INVALID_LAST_PACKET_SENT 0x012F                // Invalid Last Packet Sent
#define RESULT_INVALID_TRANSMISSION_DATA_FEED_TYPE 0x0130     // Invalid Transmission Data Feed Type
#define RESULT_DATA_FEED_TYPE_NOT_ALLOWED 0x0131              // Data Feed Type Not Allowed
#define RESULT_INVALID_RETRANSMISSION_RANGE 0x0191            // Invalid Retransmission Range
#define RESULT_INVALID_RETRANSMISSION_ID 0x0192               // Invalid Retransmission Id
#define RESULT_INVALID_RETRANSMISSION_CATEGORY 0x0193         // Invalid Retransmission Category
#define RESULT_INVALID_RETRANSMISSION_INSTRUMENT_TYPE 0x0194  // Invalid Retransmission Instrument Type
#define RESULT_RETRANSMISSION_NOT_ALLOWED 0x0195              // Retransmission Not Allowed
#define RESULT_NO_MORE_RETRANSMISSIONS 0x0197                 // No More Retransmissions
#define RESULT_DATA_CHANNEL_DOWN 0x01F5                       // Data Channel Down
#define RESULT_CONTROL_CHANNEL_AUTHENTICATED 0x01F6           // Control Channel Authenticated
#define RESULT_INVALID_CHANNEL_TYPE_TO_CHECK 0x01F7           // Invalid Channel Type To Check

// Channel: one byte code
#define CHANNEL_CONTROL 0x43  // Control
#define CHANNEL_DATA 0x44     // Data

// State: one byte code
#define STATE_BEGIN 0x42  // Begin
#define STATE_STOP 0x53   // Stop

// Errortype: one byte code
#define ERRORTYPE_SYSTEMIC 0x53     // Systemic
#define ERRORTYPE_TRANSACTION 0x54  // Transaction

// Errorid: 2 byte code
#define ERRORID_DATA_CHANNEL_LOST 0x0001                // Data Channel Lost
#define ERRORID_SERVER_CLOSED_DATA_CHANNEL 0x0002       // Server Closed Data Channel
#define ERRORID_SERVER_LOGGED_OFF_CLIENT 0x0003         // Server Logged Off Client
#define ERRORID_RETRANSMISSION_CONTAINS_NO_DATA 0x0004  // Retransmission Contains No Data
#define ERRORID_DATA_CHANNEL_EXISTS 0x0005              // Data Channel Exists

// Notiftype: one byte code
#define NOTIFTYPE_SYSTEMIC 0x53     // Systemic
#define NOTIFTYPE_TRANSACTION 0x54  // Transaction

// Notifid: 2 byte code
#define NOTIFID_RETRANSMISSION_ENDED 0x0006  // Retransmission Ended

// ---- Types -------------------------------------------------------------------

// Sent by the Iocp in reply to a client's 'CL' request
typedef struct _ServerLoginMessage {
  UINT16 result;  // bytes 0 to 1, signed, read here as unsigned
  UINT32 snum;    // bytes 2 to 5, signed, read here as unsigned
} ServerLoginMessage;

// Sent by the Iocp in reply to a client's 'CC' request
typedef struct _ServerCloseConnectionMessage {
  UINT16 result;  // bytes 0 to 1, signed, read here as unsigned
  UINT32 snum;    // bytes 2 to 5, signed, read here as unsigned
  UINT8 channel;  // byte 6
} ServerCloseConnectionMessage;

// Sent by the Iocp in reply to a client's 'CS' request
typedef struct _ServerChannelStatusMessage {
  UINT16 result;  // bytes 0 to 1, signed, read here as unsigned
  UINT32 snum;    // bytes 2 to 5, signed, read here as unsigned
  UINT8 channel;  // byte 6
} ServerChannelStatusMessage;

// Sent by the Iocp in reply to a client's 'CT' request
typedef struct _ServerTransmissionMessage {
  UINT16 result;       // bytes 0 to 1, signed, read here as unsigned
  UINT32 snum;         // bytes 2 to 5, signed, read here as unsigned
  UINT8 state;         // byte 6
  UINT32 lstpacksent;  // bytes 7 to 10, signed, read here as unsigned
} ServerTransmissionMessage;

// Sent by the Iocp in reply to a client's 'CR' request
typedef struct _ServerRetransmissionMessage {
  UINT16 result;   // bytes 0 to 1, signed, read here as unsigned
  UINT32 snum;     // bytes 2 to 5, signed, read here as unsigned
  UINT8 state;     // byte 6
  UINT32 rid;      // bytes 7 to 10, signed, read here as unsigned
  UINT32 rrangeb;  // bytes 11 to 14, signed, read here as unsigned
  UINT32 rrangee;  // bytes 15 to 18, signed, read here as unsigned
} ServerRetransmissionMessage;

// First message of the authentication phase, carrying the random number the client computes its password hash with
typedef struct _ServerAuthenticationChallengeMessage {
  UINT32 snum;     // bytes 0 to 3, signed, read here as unsigned
  UINT32 randnum;  // bytes 4 to 7, signed, read here as unsigned
} ServerAuthenticationChallengeMessage;

// Sent by the Iocp when a systemic or transaction error occurs
typedef struct _ServerGeneralErrorMessage {
  UINT32 snum;      // bytes 0 to 3, signed, read here as unsigned
  UINT8 errortype;  // byte 4
  UINT16 errorid;   // bytes 5 to 6, signed, read here as unsigned
} ServerGeneralErrorMessage;

// Sent by the Iocp when a systemic or transaction notification occurs
typedef struct _ServerGeneralNotificationMessage {
  UINT32 snum;      // bytes 0 to 3, signed, read here as unsigned
  UINT8 notiftype;  // byte 4
  UINT16 notifid;   // bytes 5 to 6, signed, read here as unsigned
  UINT32 retrid;    // bytes 7 to 10, signed, read here as unsigned
} ServerGeneralNotificationMessage;

// Branch
casetype _ServerPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x534C: ServerLoginMessage server_login_message;
    case 0x5343: ServerCloseConnectionMessage server_close_connection_message;
    case 0x5353: ServerChannelStatusMessage server_channel_status_message;
    case 0x5354: ServerTransmissionMessage server_transmission_message;
    case 0x5352: ServerRetransmissionMessage server_retransmission_message;
    case 0x4143: ServerAuthenticationChallengeMessage server_authentication_challenge_message;
    case 0x4745: ServerGeneralErrorMessage server_general_error_message;
    case 0x474E: ServerGeneralNotificationMessage server_general_notification_message;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// ---- Packet: ServerPacket ----------------------------------------------------

// Iocp control message sent by the server over the control channel
entrypoint typedef struct _ServerPacket (UINT32 available) where (available >= 2) {
  UINT16BE server_message_type;                                                                                         // bytes 0 to 1
  ServerPayload(server_message_type, (available - 2)) server_payload[:byte-size-single-element-array (available - 2)];
} ServerPacket;

