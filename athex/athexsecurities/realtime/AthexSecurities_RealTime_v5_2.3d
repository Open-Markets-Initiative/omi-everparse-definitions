// ---- Message Header: 35 bytes ------------------------------------------------

// Thirty five character header succeeding the Soh character of every message packet
entrypoint typedef struct _MessageHeader {
  UINT8 vendor_identifier[2];        // bytes 0 to 1
  UINT8 message_category;            // byte 2
  UINT8 message_subcategory;         // byte 3
  UINT8 venue_i_d[4];                // bytes 4 to 7
  UINT8 message_sequence_number[7];  // bytes 8 to 14
  UINT8 publication_timestamp[20];   // bytes 15 to 34
} MessageHeader;

// ---- Trade Message: 147 bytes ------------------------------------------------

// Transmitted when an instrument trade occurs in the trading platform or the clearing system
entrypoint typedef struct _TradeMessage {
  UINT8 symbol[15];                // bytes 0 to 14
  UINT8 board_id;                  // byte 15
  UINT8 trade_number[6];           // bytes 16 to 21
  UINT8 buy_order_number[8];       // bytes 22 to 29
  UINT8 buy_order_date[8];         // bytes 30 to 37
  UINT8 sell_order_number[8];      // bytes 38 to 45
  UINT8 sell_order_date[8];        // bytes 46 to 53
  UINT8 price[9];                  // bytes 54 to 62
  UINT8 volume[17];                // bytes 63 to 79
  UINT8 total_volume[17];          // bytes 80 to 96
  UINT8 trade_type;                // byte 97
  UINT8 trade_source;              // byte 98
  UINT8 buy_order_type;            // byte 99
  UINT8 sell_order_type;           // byte 100
  UINT8 buy_waiver_indicator[4];   // bytes 101 to 104
  UINT8 sell_waiver_indicator[4];  // bytes 105 to 108
  UINT8 notional_amount[14];       // bytes 109 to 122
  UINT8 buy_algo_flag;             // byte 123
  UINT8 sell_algo_flag;            // byte 124
  UINT8 sdiv_flag;                 // byte 125
  UINT8 dupl_flag;                 // byte 126
  UINT8 time_stamp[20];            // bytes 127 to 146
} TradeMessage;

// ---- Index Message: 24 bytes -------------------------------------------------

// Transmitted every time the trading platform calculates the price of a given index
entrypoint typedef struct _IndexMessage {
  UINT8 symbol[15];      // bytes 0 to 14
  UINT8 index_price[9];  // bytes 15 to 23
} IndexMessage;

// ---- Instrument Summary Message: 103 bytes -----------------------------------

// Transmitted for each instrument right after the corresponding market status changes to End of Day
entrypoint typedef struct _InstrumentSummaryMessage {
  UINT8 symbol[15];             // bytes 0 to 14
  UINT8 opening_price[9];       // bytes 15 to 23
  UINT8 high[9];                // bytes 24 to 32
  UINT8 low[9];                 // bytes 33 to 41
  UINT8 last[9];                // bytes 42 to 50
  UINT8 closing_price[9];       // bytes 51 to 59
  UINT8 start_of_day_price[9];  // bytes 60 to 68
  UINT8 total_volume[17];       // bytes 69 to 85
  UINT8 total_value[17];        // bytes 86 to 102
} InstrumentSummaryMessage;

// ---- Cancelled Trade Message: 147 bytes --------------------------------------

// Transmitted when an instrument trade cancellation occurs in the trading platform or clearing system
entrypoint typedef struct _CancelledTradeMessage {
  UINT8 symbol[15];                // bytes 0 to 14
  UINT8 board_id;                  // byte 15
  UINT8 trade_number[6];           // bytes 16 to 21
  UINT8 buy_order_number[8];       // bytes 22 to 29
  UINT8 buy_order_date[8];         // bytes 30 to 37
  UINT8 sell_order_number[8];      // bytes 38 to 45
  UINT8 sell_order_date[8];        // bytes 46 to 53
  UINT8 cancelled_trade_price[9];  // bytes 54 to 62
  UINT8 cancelled_volume[17];      // bytes 63 to 79
  UINT8 total_volume[17];          // bytes 80 to 96
  UINT8 trade_type;                // byte 97
  UINT8 trade_source;              // byte 98
  UINT8 buy_order_type;            // byte 99
  UINT8 sell_order_type;           // byte 100
  UINT8 buy_waiver_indicator[4];   // bytes 101 to 104
  UINT8 sell_waiver_indicator[4];  // bytes 105 to 108
  UINT8 notional_amount[14];       // bytes 109 to 122
  UINT8 buy_algo_flag;             // byte 123
  UINT8 sell_algo_flag;            // byte 124
  UINT8 sdiv_flag;                 // byte 125
  UINT8 dupl_flag;                 // byte 126
  UINT8 time_stamp[20];            // bytes 127 to 146
} CancelledTradeMessage;

// ---- Closing Price Message: 32 bytes -----------------------------------------

// Transmitted for every instrument whose closing price has been calculated by the trading platform, and again whenever the trading platform recalculates one
entrypoint typedef struct _ClosingPriceMessage {
  UINT8 symbol[15];        // bytes 0 to 14
  UINT8 closing[9];        // bytes 15 to 23
  UINT8 open_interest[8];  // bytes 24 to 31
} ClosingPriceMessage;

// ---- Projected Auction Auction Open Projected Close Price Message: 62 bytes ----

// Transmitted whenever the trading platform calculates a Projected Auction, Auction Open or Projected Close price for the instrument
entrypoint typedef struct _ProjectedAuctionAuctionOpenProjectedClosePriceMessage {
  UINT8 symbol[15];      // bytes 0 to 14
  UINT8 price_flag;      // byte 15
  UINT8 price[9];        // bytes 16 to 24
  UINT8 volume[17];      // bytes 25 to 41
  UINT8 time_stamp[20];  // bytes 42 to 61
} ProjectedAuctionAuctionOpenProjectedClosePriceMessage;

// ---- High Low Limit Modification Message: 56 bytes ---------------------------

// Transmitted at the beginning of the trading day, and whenever the static High and Low limits for the given instrument change
entrypoint typedef struct _HighLowLimitModificationMessage {
  UINT8 symbol[15];             // bytes 0 to 14
  UINT8 ceiling_price[9];       // bytes 15 to 23
  UINT8 floor_price[9];         // bytes 24 to 32
  UINT8 start_of_day_price[9];  // bytes 33 to 41
  UINT8 accrued_interest[14];   // bytes 42 to 55
} HighLowLimitModificationMessage;

// ---- Instrument State Message: 38 bytes --------------------------------------

// Transmitted at the beginning of the trading day, and whenever the instrument changes its trading phase or its status
entrypoint typedef struct _InstrumentStateMessage {
  UINT8 symbol[15];           // bytes 0 to 14
  UINT8 phase_id;             // byte 15
  UINT8 instrument_status;    // byte 16
  UINT8 halt_suspend_reason;  // byte 17
  UINT8 time_stamp[20];       // bytes 18 to 37
} InstrumentStateMessage;

// ---- Market Status Message: 2 bytes ------------------------------------------

// Transmitted whenever the market changes its status
entrypoint typedef struct _MarketStatusMessage {
  UINT8 market_id;      // byte 0
  UINT8 market_status;  // byte 1
} MarketStatusMessage;

// ---- Order Message: 147 bytes ------------------------------------------------

// Transmitted at the beginning of the trading session for an order whose lifetime spans multiple days, when a new order is entered in the trading platform, and when an already placed order is changed. It is not transmitted for Combinations
entrypoint typedef struct _OrderMessage {
  UINT8 symbol[15];                 // bytes 0 to 14
  UINT8 board_id;                   // byte 15
  UINT8 order_number[8];            // bytes 16 to 23
  UINT8 order_entry_date[8];        // bytes 24 to 31
  UINT8 order_status[2];            // bytes 32 to 33
  UINT8 side;                       // byte 34
  UINT8 volume[17];                 // bytes 35 to 51
  UINT8 matched_volume[17];         // bytes 52 to 68
  UINT8 price[9];                   // bytes 69 to 77
  UINT8 original_price_type;        // byte 78
  UINT8 order_lifetime;             // byte 79
  UINT8 special_conditions;         // byte 80
  UINT8 condition_volume[17];       // bytes 81 to 97
  UINT8 order_release_date[8];      // bytes 98 to 105
  UINT8 order_release_time[12];     // bytes 106 to 117
  UINT8 last_order_update_date[8];  // bytes 118 to 125
  UINT8 order_type;                 // byte 126
  UINT8 time_stamp[20];             // bytes 127 to 146
} OrderMessage;

// ---- Cancelled Order Message: 117 bytes --------------------------------------

// Transmitted whenever an order is cancelled. It is not transmitted for Combinations
entrypoint typedef struct _CancelledOrderMessage {
  UINT8 symbol[15];            // bytes 0 to 14
  UINT8 board_id;              // byte 15
  UINT8 order_number[8];       // bytes 16 to 23
  UINT8 order_entry_date[8];   // bytes 24 to 31
  UINT8 side;                  // byte 32
  UINT8 volume[17];            // bytes 33 to 49
  UINT8 matched_volume[17];    // bytes 50 to 66
  UINT8 price[9];              // bytes 67 to 75
  UINT8 original_price_type;   // byte 76
  UINT8 order_lifetime;        // byte 77
  UINT8 special_conditions;    // byte 78
  UINT8 condition_volume[17];  // bytes 79 to 95
  UINT8 order_type;            // byte 96
  UINT8 time_stamp[20];        // bytes 97 to 116
} CancelledOrderMessage;

