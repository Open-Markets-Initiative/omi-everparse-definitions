// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out A2XEquities_TradingProtocol_v2_9_3.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - the dispatch that chooses a message by its type
// - a field read in bits
// - the packet as a whole, which is a union whose readings take different widths, at packet.message.payload.orderaddresponsemessage.orderaddresponsestatus

// ---- Values ------------------------------------------------------------------

// Msg Type: one byte code
#define MSG_TYPE_LOGIN_MESSAGE 0x01                   // Login Message
#define MSG_TYPE_LOGIN_RESPONSE_MESSAGE 0x02          // Login Response Message
#define MSG_TYPE_HEARTBEAT 0x00                       // Heartbeat
#define MSG_TYPE_LOGOUT_REQUEST_MESSAGE 0x03          // Logout Request Message
#define MSG_TYPE_LOGOUT_MESSAGE 0x04                  // Logout Message
#define MSG_TYPE_ORDER_ADD_MESSAGE 0x18               // Order Add Message
#define MSG_TYPE_ORDER_ADD_EXTENDED_MESSAGE 0x19      // Order Add Extended Message
#define MSG_TYPE_ORDER_ADD_RESPONSE_MESSAGE 0x06      // Order Add Response Message
#define MSG_TYPE_ORDER_CANCEL_MESSAGE 0x07            // Order Cancel Message
#define MSG_TYPE_ORDER_CANCEL_RESPONSE_MESSAGE 0x08   // Order Cancel Response Message
#define MSG_TYPE_ORDER_MODIFY_MESSAGE 0x09            // Order Modify Message
#define MSG_TYPE_ORDER_MODIFY_EXTENDED_MESSAGE 0x16   // Order Modify Extended Message
#define MSG_TYPE_ORDER_MODIFY_RESPONSE_MESSAGE 0x0A   // Order Modify Response Message
#define MSG_TYPE_ICEBERG_ORDER_REFRESH_MESSAGE 0x17   // Iceberg Order Refresh Message
#define MSG_TYPE_TRADE_CAPTURE_MESSAGE 0x1A           // Trade Capture Message
#define MSG_TYPE_TRADE_CAPTURE_RESPONSE_MESSAGE 0x12  // Trade Capture Response Message
#define MSG_TYPE_TRADE_MESSAGE 0x0B                   // Trade Message
#define MSG_TYPE_TRADE_BUST_MESSAGE 0x0C              // Trade Bust Message

// Result Code: one byte code
#define RESULT_CODE_SUCCESSFUL_LOGIN 0x00        // Successful Login
#define RESULT_CODE_ALREADY_LOGGED_IN 0x01       // Already Logged In
#define RESULT_CODE_SEQUENCE_NUMBER_ERROR 0x02   // Sequence Number Error
#define RESULT_CODE_UNSUPPORTED_PROTOCOL 0x03    // Unsupported Protocol
#define RESULT_CODE_FAILED_AUTHENTICATION 0x04   // Failed Authentication
#define RESULT_CODE_UNKNOWN_SOURCE_NETWORK 0x05  // Unknown Source Network

// Logout Reason Code: one byte code
#define LOGOUT_REASON_CODE_USER_REQUESTED 0x00         // User Requested
#define LOGOUT_REASON_CODE_ADMIN 0x01                  // Admin
#define LOGOUT_REASON_CODE_DISCONNECT 0x02             // Disconnect
#define LOGOUT_REASON_CODE_END_OF_DAY 0x03             // End Of Day
#define LOGOUT_REASON_CODE_INACTIVITY_TIMEOUT 0x04     // Inactivity Timeout
#define LOGOUT_REASON_CODE_PROTOCOL_ERROR 0x05         // Protocol Error
#define LOGOUT_REASON_CODE_SEQUENCE_NUMBER_ERROR 0x06  // Sequence Number Error

// Order Type: one byte code
#define ORDER_TYPE_LIMIT_ORDER 0x01                                              // Limit Order
#define ORDER_TYPE_AUCTION_ON_DEMAND_LIMIT_ORDER 0x02                            // Auction On Demand Limit Order
#define ORDER_TYPE_AUCTION_ON_DEMAND_TRADE_AT_MIDDLE_LIMIT_OR_PEGGED_LIMIT 0x03  // Auction On Demand Trade At Middle Limit Or Pegged Limit
#define ORDER_TYPE_MARKET_AT_CLOSE 0x06                                          // Market At Close
#define ORDER_TYPE_POST_ONLY_CANCEL_REPLACE 0x08                                 // Post Only Cancel Replace
#define ORDER_TYPE_POST_ONLY 0x09                                                // Post Only

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY 0x01                  // Day
#define TIME_IN_FORCE_FILL_OR_KILL 0x02         // Fill Or Kill
#define TIME_IN_FORCE_IMMEDIATE_OR_CANCEL 0x03  // Immediate Or Cancel
#define TIME_IN_FORCE_GOOD_FOR_AUCTION 0x09     // Good For Auction

// Side: one byte code
#define SIDE_BUY_ORDER 0x01   // Buy Order
#define SIDE_SELL_ORDER 0x02  // Sell Order

// Order Capacity: one byte code
#define ORDER_CAPACITY_UNCHANGED 0x00  // Unchanged
#define ORDER_CAPACITY_AGENCY 0x01     // Agency
#define ORDER_CAPACITY_PRINCIPAL 0x02  // Principal

// Trade Capture Type: one byte code
#define TRADE_CAPTURE_TYPE_LARGE_IN_SCALE 0x01              // Large In Scale
#define TRADE_CAPTURE_TYPE_NEGOTIATED_BENCHMARK_CROSS 0x03  // Negotiated Benchmark Cross
#define TRADE_CAPTURE_TYPE_MATCHED_PRINCIPAL 0x05           // Matched Principal

// Buy Order Capacity: one byte code
#define BUY_ORDER_CAPACITY_AGENCY 0x01     // Agency
#define BUY_ORDER_CAPACITY_PRINCIPAL 0x02  // Principal

// Sell Order Capacity: one byte code
#define SELL_ORDER_CAPACITY_AGENCY 0x01     // Agency
#define SELL_ORDER_CAPACITY_PRINCIPAL 0x02  // Principal

// Ccp Code: one byte code
#define CCP_CODE_SELF_CLEARING 0x01  // Self Clearing
#define CCP_CODE_EMCFNL_2_A 0x02     // Emcfnl 2 A

// Liq Indicator: one byte code
#define LIQ_INDICATOR_ADDED_LIQUIDITY 0x01                    // Added Liquidity
#define LIQ_INDICATOR_REMOVED_LIQUIDITY 0x02                  // Removed Liquidity
#define LIQ_INDICATOR_REMOVED_LIQUIDITY_HIDDEN_QUANTITY 0x03  // Removed Liquidity Hidden Quantity

// ---- Message Header: 7 bytes -------------------------------------------------

// A2X Atp message header
entrypoint typedef struct _MessageHeader {
  UINT16 length;      // bytes 0 to 1
  UINT8 msg_type;     // byte 2, values MSG_TYPE_
  UINT32 msg_seq_no;  // bytes 3 to 6
} MessageHeader;

// ---- Login Message: 40 bytes -------------------------------------------------

// The Login message is the initial message used to establish a trading session. It is also used to re-establish a session after a break.
entrypoint typedef struct _LoginMessage {
  UINT16 protocol_version;    // bytes 0 to 1
  UINT8 sender_id[16];        // bytes 2 to 17
  UINT8 password[16];         // bytes 18 to 33
  UINT16 inactivity_timeout;  // bytes 34 to 35
  UINT32 atp_seq_no;          // bytes 36 to 39
} LoginMessage;

// ---- Login Response Message: 5 bytes -----------------------------------------

// The Login Response message is sent by A2X to acknowledge a Login request, and either accept or reject it.
entrypoint typedef struct _LoginResponseMessage {
  UINT8 result_code;     // byte 0, values RESULT_CODE_
  UINT32 client_seq_no;  // bytes 1 to 4
} LoginResponseMessage;

// ---- Logout Message: 33 bytes ------------------------------------------------

// The Logout message is usually sent as a response to the Logout Request however it may also be sent by A2X in case of a low sequence number or other protocol violation, or for other reasons. The TCP/IP connection is closed immediately after this message has been sent.
entrypoint typedef struct _LogoutMessage {
  UINT8 logout_reason_code;  // byte 0, values LOGOUT_REASON_CODE_
  UINT8 reason_text[32];     // bytes 1 to 32
} LogoutMessage;

// ---- Order Add Message: 46 bytes ---------------------------------------------

// The Add Order message is sent by the trading Member to enter an order for a particular security.
entrypoint typedef struct _OrderAddMessage {
  UINT32 security_id_long;  // bytes 0 to 3
  UINT8 order_type;         // byte 4, values ORDER_TYPE_
  UINT8 time_in_force;      // byte 5, values TIME_IN_FORCE_
  UINT8 side;               // byte 6, values SIDE_
  UINT32 quantity;          // bytes 7 to 10
  UINT64 price;             // bytes 11 to 18
  UINT8 order_capacity;     // byte 19, values ORDER_CAPACITY_
  UINT16 account;           // bytes 20 to 21
  UINT64 user_tag;          // bytes 22 to 29
  UINT8 reserved_16[16];    // bytes 30 to 45
} OrderAddMessage;

// ---- Order Add Extended Message: 54 bytes ------------------------------------

// The Order Add Extended message is sent by the trading Member to enter an order for a particular security with additional attributes.
entrypoint typedef struct _OrderAddExtendedMessage {
  UINT32 security_id_long;  // bytes 0 to 3
  UINT8 order_type;         // byte 4, values ORDER_TYPE_
  UINT8 time_in_force;      // byte 5, values TIME_IN_FORCE_
  UINT8 side;               // byte 6, values SIDE_
  UINT32 quantity;          // bytes 7 to 10
  UINT64 price;             // bytes 11 to 18
  UINT8 order_capacity;     // byte 19, values ORDER_CAPACITY_
  UINT16 account;           // bytes 20 to 21
  UINT64 user_tag;          // bytes 22 to 29
  UINT8 reserved_16[16];    // bytes 30 to 45
  UINT32 display_quantity;  // bytes 46 to 49
  UINT32 min_qty;           // bytes 50 to 53
} OrderAddExtendedMessage;

// ---- Order Cancel Message: 28 bytes ------------------------------------------

// The Order Cancel message is sent when a user wishes to cancel an open order.
entrypoint typedef struct _OrderCancelMessage {
  UINT32 order_ref;       // bytes 0 to 3
  UINT64 user_tag;        // bytes 4 to 11
  UINT8 reserved_16[16];  // bytes 12 to 27
} OrderCancelMessage;

// ---- Order Modify Message: 41 bytes ------------------------------------------

// The Order Modify message is sent when a user wishes to modify an open order. Order quantity and/or limit price may be modified. Both values must be included, even if one of them is unchanged.
entrypoint typedef struct _OrderModifyMessage {
  UINT32 order_ref;       // bytes 0 to 3
  UINT64 price;           // bytes 4 to 11
  UINT32 quantity;        // bytes 12 to 15
  UINT64 user_tag;        // bytes 16 to 23
  UINT8 reserved_16[16];  // bytes 24 to 39
  UINT8 order_capacity;   // byte 40, values ORDER_CAPACITY_
} OrderModifyMessage;

// ---- Order Modify Extended Message: 45 bytes ---------------------------------

// The Order Modify Extended message is sent when a user wants to modify an open Order Add Extended. Order quantity and/or limit price and/or display quantity and/or minimum quantity may be modified. All values must be included, even if some are unchanged.
entrypoint typedef struct _OrderModifyExtendedMessage {
  UINT32 order_ref;         // bytes 0 to 3
  UINT64 price;             // bytes 4 to 11
  UINT32 quantity;          // bytes 12 to 15
  UINT64 user_tag;          // bytes 16 to 23
  UINT8 reserved_16[16];    // bytes 24 to 39
  UINT8 order_capacity;     // byte 40, values ORDER_CAPACITY_
  UINT32 display_quantity;  // bytes 41 to 44
} OrderModifyExtendedMessage;

// ---- Iceberg Order Refresh Message: 16 bytes ---------------------------------

// A2X sends an Iceberg Order Refresh message to notify the Member when an iceberg order is refreshed from the non-displayed reserve quantity.
entrypoint typedef struct _IcebergOrderRefreshMessage {
  UINT32 order_ref;         // bytes 0 to 3
  UINT32 orig_a2_x_ord_id;  // bytes 4 to 7
  UINT32 new_a2_x_ord_id;   // bytes 8 to 11
  UINT32 quantity;          // bytes 12 to 15
} IcebergOrderRefreshMessage;

// ---- Trade Capture Message: 48 bytes -----------------------------------------

// A2X uses a Trade Capture Report message for the purpose of allowing members to submit Large in Scale (LS), Negotiated Benchmark Cross (NBC) and Matched Principal (MP) trades to the exchange.
entrypoint typedef struct _TradeCaptureMessage {
  UINT32 quantity;            // bytes 0 to 3
  UINT64 price;               // bytes 4 to 11
  UINT32 security_id_long;    // bytes 12 to 15
  UINT8 trade_capture_type;   // byte 16, values TRADE_CAPTURE_TYPE_
  UINT8 reserved_1;           // byte 17
  UINT64 user_tag;            // bytes 18 to 25
  UINT8 reserved_8[8];        // bytes 26 to 33
  UINT16 buy_account;         // bytes 34 to 35
  UINT8 buy_order_capacity;   // byte 36, values BUY_ORDER_CAPACITY_
  UINT8 reserved_long_2[8];   // bytes 37 to 44
  UINT16 sell_account;        // bytes 45 to 46
  UINT8 sell_order_capacity;  // byte 47, values SELL_ORDER_CAPACITY_
} TradeCaptureMessage;

// ---- Trade Message: 41 bytes -------------------------------------------------

// The Trade message is published when an order executes. The Trade message is also used to communicate indicative trade reports at lock time for Market at Close orders. Note that the price and tradeRef values will be zero for indicative trade reports published when MaC orders are matched at lock time.
entrypoint typedef struct _TradeMessage {
  UINT32 order_ref;          // bytes 0 to 3
  UINT32 quantity;           // bytes 4 to 7
  UINT64 price;              // bytes 8 to 15
  UINT8 side;                // byte 16, values SIDE_
  UINT32 trade_ref;          // bytes 17 to 20
  UINT8 ccp_code;            // byte 21, values CCP_CODE_
  UINT8 liq_indicator;       // byte 22, values LIQ_INDICATOR_
  UINT16 security_id_short;  // bytes 23 to 24
  UINT64 trade_timestamp;    // bytes 25 to 32
  UINT64 user_tag;           // bytes 33 to 40
} TradeMessage;

// ---- Trade Bust Message: 29 bytes --------------------------------------------

// If a trade is invalidated, a Trade Bust message is sent to notify the trading Member.
entrypoint typedef struct _TradeBustMessage {
  UINT32 order_ref;       // bytes 0 to 3
  UINT32 quantity;        // bytes 4 to 7
  UINT64 price;           // bytes 8 to 15
  UINT8 side;             // byte 16, values SIDE_
  UINT32 trade_ref;       // bytes 17 to 20
  UINT64 bust_timestamp;  // bytes 21 to 28
} TradeBustMessage;

