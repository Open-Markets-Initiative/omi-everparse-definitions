#define MARKET2_PHYSICALLY_SETTLED_USD_GOLD_FUTURES 0x74                                               // Physically Settled Usd Gold Futures
#define MARKET2_CHINA_5_YEAR_GOVERNMENT_BOND_FUTURES 0x75                                              // China 5 Year Government Bond Futures
#define MARKET2_USD_BASE_AND_FERROUS_FUTURES 0x76                                                      // Usd Base And Ferrous Futures
#define MARKET2_CNH_LONDON_METAL_MINI_FUTURES 0x78                                                     // Cnh London Metal Mini Futures
#define MARKET2_CASH_SETTLED_RMB_CURRENCY_FUTURES 0x7A                                                 // Cash Settled Rmb Currency Futures
#define MARKET2_CASH_SETTLED_CNHUSD_FUTURES 0x7D                                                       // Cash Settled Cnhusd Futures
#define MARKET2_STOCK_FUTURES_IN_OMD_D_PARTITION_3 0x8D                                                // Stock Futures In Omd D Partition 3
#define MARKET2_STOCK_OPTIONS_IN_OMD_D_PARTITION_3 0x8F                                                // Stock Options In Omd D Partition 3
#define MARKET2_WEEKLY_STOCK_OPTIONS_IN_OMD_D_PARTITION_3 0x91                                         // Weekly Stock Options In Omd D Partition 3
#define MARKET2_MSCI_CHINA_A_50_CONNECT_INDEX_FUTURES 0x99                                             // Msci China A 50 Connect Index Futures
#define MARKET2_MSCI_JPY_INDEX_FUTURES_PRICE_NTR 0xA0                                                  // Msci Jpy Index Futures Price Ntr
#define MARKET2_MSCI_USD_INDEX_FUTURES_NTR 0xA1                                                        // Msci Usd Index Futures Ntr
#define MARKET2_MSCI_USD_INDEX_FUTURES_OPTIONS_PRICE_MARKET_163 0xA3                                   // Msci Usd Index Futures Options Price Market 163
#define MARKET2_MSCI_USD_INDEX_FUTURES_OPTIONS_PRICE_MARKET_164 0xA4                                   // Msci Usd Index Futures Options Price Market 164
#define MARKET2_MSCI_USD_INDEX_FUTURES_OPTIONS_PRICE_MARKET_166 0xA6                                   // Msci Usd Index Futures Options Price Market 166
#define MARKET2_MSCI_USD_INDEX_FUTURES_OPTIONS_PRICE_MARKET_168 0xA8                                   // Msci Usd Index Futures Options Price Market 168
#define MARKET2_MSCI_SGD_INDEX_FUTURES_PRICE 0xAA                                                      // Msci Sgd Index Futures Price

// Instrument: one byte code
#define INSTRUMENT_IF_NOT_AVAILABLE 0x00                                                      // If Not Available
#define INSTRUMENT_FUTURES 0x04                                                               // Futures
#define INSTRUMENT_CALL_AMERICAN_STYLE 0x06                                                   // Call American Style
#define INSTRUMENT_PUT_AMERICAN_STYLE 0x07                                                    // Put American Style
#define INSTRUMENT_CALL_EUROPEAN_STYLE 0x16                                                   // Call European Style
#define INSTRUMENT_PUT_EUROPEAN_STYLE 0x17                                                    // Put European Style
#define INSTRUMENT_OPTIONS_STRADDLE 0xAA                                                      // Options Straddle
#define INSTRUMENT_OPTIONS_STRANGLE 0xAB                                                      // Options Strangle
#define INSTRUMENT_STANDARD_COMBO_SERIES_FOR_STOCK_OPTIONS_MARKET_SOM_SYNTHETIC_FUTURES 0xAC  // Standard Combo Series For Stock Options Market Som Synthetic Futures
#define INSTRUMENT_TIME_SPREAD_LEVEL_01 0xC9                                                  // Time Spread Level 01
#define INSTRUMENT_TIME_SPREAD_LEVEL_02 0xCA                                                  // Time Spread Level 02
#define INSTRUMENT_TIME_SPREAD_LEVEL_03 0xCB                                                  // Time Spread Level 03
#define INSTRUMENT_TIME_SPREAD_LEVEL_04 0xCC                                                  // Time Spread Level 04
#define INSTRUMENT_TIME_SPREAD_LEVEL_05 0xCD                                                  // Time Spread Level 05
#define INSTRUMENT_TIME_SPREAD_LEVEL_06 0xCE                                                  // Time Spread Level 06
#define INSTRUMENT_TIME_SPREAD_LEVEL_07 0xCF                                                  // Time Spread Level 07
#define INSTRUMENT_TIME_SPREAD_LEVEL_08 0xD0                                                  // Time Spread Level 08
#define INSTRUMENT_TIME_SPREAD_LEVEL_09 0xD1                                                  // Time Spread Level 09
#define INSTRUMENT_TIME_SPREAD_LEVEL_10 0xD2                                                  // Time Spread Level 10
#define INSTRUMENT_TIME_SPREAD_LEVEL_11 0xD3                                                  // Time Spread Level 11
#define INSTRUMENT_TIME_SPREAD_LEVEL_12 0xD4                                                  // Time Spread Level 12
#define INSTRUMENT_TIME_SPREAD_LEVEL_13 0xD5                                                  // Time Spread Level 13
#define INSTRUMENT_TIME_SPREAD_LEVEL_14 0xD6                                                  // Time Spread Level 14
#define INSTRUMENT_TIME_SPREAD_LEVEL_15 0xD7                                                  // Time Spread Level 15
#define INSTRUMENT_TIME_SPREAD_LEVEL_16 0xD8                                                  // Time Spread Level 16
#define INSTRUMENT_TIME_SPREAD_LEVEL_17 0xD9                                                  // Time Spread Level 17
#define INSTRUMENT_TIME_SPREAD_LEVEL_18 0xDA                                                  // Time Spread Level 18
#define INSTRUMENT_TIME_SPREAD_LEVEL_19 0xDB                                                  // Time Spread Level 19
#define INSTRUMENT_TIME_SPREAD_LEVEL_20 0xDC                                                  // Time Spread Level 20
#define INSTRUMENT_TIME_SPREAD_LEVEL_21 0xDD                                                  // Time Spread Level 21
#define INSTRUMENT_TIME_SPREAD_LEVEL_22 0xDE                                                  // Time Spread Level 22
#define INSTRUMENT_TIME_SPREAD_LEVEL_23 0xDF                                                  // Time Spread Level 23
#define INSTRUMENT_TAILOR_MADE_COMBINATION 0xFA                                               // Tailor Made Combination
#define INSTRUMENT_EXCHANGE_RATE 0xFE                                                         // Exchange Rate
#define INSTRUMENT_PAYMENT_CURRENCY 0xFF                                                      // Payment Currency

// State: 2 byte code
#define STATE_END_OF_THE_CURRENT_STATE_IF_NOT_AVAILABLE 0x0000                 // End Of The Current State If Not Available
#define STATE_OPEN_ALLOCATION 0x0001                                           // Open Allocation
#define STATE_MARKET_CLOSED 0x0002                                             // Market Closed
#define STATE_MARKET_OPEN 0x0003                                               // Market Open
#define STATE_PREOPEN_SESSION 0x0004                                           // Preopen Session
#define STATE_PREOPEN_ALLOCATION_SESSION 0x0005                                // Preopen Allocation Session
#define STATE_MARKET_PAUSE 0x0006                                              // Market Pause
#define STATE_PREMARKET_ACTIVITIES 0x0007                                      // Premarket Activities
#define STATE_CLEARING_SESSION_STARTED 0x0008                                  // Clearing Session Started
#define STATE_CLEARING_SESSION_CLOSED 0x0009                                   // Clearing Session Closed
#define STATE_AHFT_MARKET_CLOSED 0x000A                                        // Ahft Market Closed
#define STATE_AHFT_RESET_PRICE_INFORMATION 0x000B                              // Ahft Reset Price Information
#define STATE_AHFT_INACTIVE_NON_ORDER 0x000C                                   // Ahft Inactive Non Order
#define STATE_AHFT_RESET_PRICE_INFORMATION_FOR_NEXT_BUSINESS_DAY 0x000D        // Ahft Reset Price Information For Next Business Day
#define STATE_AHFT_MARKET_OPEN 0x000E                                          // Ahft Market Open
#define STATE_AHFT_MARKET_OPEN_PRICE_LIMIT 0x000F                              // Ahft Market Open Price Limit
#define STATE_AHFT_PREMARKET_ACTIVITIES 0x0010                                 // Ahft Premarket Activities
#define STATE_MARKET_OPEN_WITH_PRICE_CONTROLS 0x0011                           // Market Open With Price Controls
#define STATE_MARKET_CLOSED_TODAY 0x0012                                       // Market Closed Today
#define STATE_MARKET_OPEN_WITH_DYNAMIC_PRICE_BANDING_MECHANISM 0x0013          // Market Open With Dynamic Price Banding Mechanism
#define STATE_SITE_FAILOVER 0x0014                                             // Site Failover
#define STATE_MARKET_CLOSED_TODAY_E 0x0015                                     // Market Closed Today E
#define STATE_AHFT_MARKET_CLOSED_E 0x0016                                      // Ahft Market Closed E
#define STATE_MARKET_OPEN_WITH_DPBM_AND_VCM 0x0017                             // Market Open With Dpbm And Vcm
#define STATE_MARKET_OPEN_WITH_VCM 0x0018                                      // Market Open With Vcm
#define STATE_VCM_COOL_OFF_STATUS_WITH_DYNAMIC_PRICE_BANDING_MECHANSIM 0x0019  // Vcm Cool Off Status With Dynamic Price Banding Mechansim
#define STATE_VCM_COOL_OFF_STATUS 0x001A                                       // Vcm Cool Off Status
#define STATE_RESET_COUNTER_FOR_VCM 0x001B                                     // Reset Counter For Vcm
#define STATE_HALT 0x001C                                                      // Halt
#define STATE_RESET_PRICE_INFORMATION 0x001D                                   // Reset Price Information
#define STATE_BLOCK_TRADE_ONLY 0x001E                                          // Block Trade Only

// Suspension Indicator: one byte code
#define SUSPENSION_INDICATOR_SUSPENDED_FOR_TRADING 0x01  // Suspended For Trading
#define SUSPENSION_INDICATOR_NOT_SUSPENDED 0x02          // Not Suspended
#define SUSPENSION_INDICATOR_LOCKED 0x03                 // Locked

// Suspended: one byte code
#define SUSPENDED_YES 0x59  // Yes
#define SUSPENDED_NO 0x4E   // No

// Locked: one byte code
#define LOCKED_YES 0x01  // Yes
#define LOCKED_NO 0x02   // No

// Trade Side: one byte code
#define TRADE_SIDE_NOT_AVAILABLE 0x00  // Not Available
#define TRADE_SIDE_NOT_DEFINED 0x01    // Not Defined
#define TRADE_SIDE_BUY_ORDER 0x02      // Buy Order
#define TRADE_SIDE_SELL_ORDER 0x03     // Sell Order

// Trade State: one byte code
#define TRADE_STATE_GIVEN_UP_TRADE 0x01  // Given Up Trade
#define TRADE_STATE_RECTIFIED 0x02       // Rectified
#define TRADE_STATE_DELETED 0x03         // Deleted

// ---- Types -------------------------------------------------------------------

// The aggregate order book is sent whenever there is a orderbook change
typedef struct _BookEntry {
  UINT64 aggregate_quantity;  // bytes 0 to 7
  UINT32 price;               // bytes 8 to 11, signed, read here as unsigned
  UINT32 number_of_orders;    // bytes 12 to 15
  UINT8 side;                 // byte 16
  UINT8 filler_1;             // byte 17
  UINT8 price_level;          // byte 18
  UINT8 update_action;        // byte 19
  UINT8 filler_4[4];          // bytes 20 to 23
} BookEntry;

// The aggregate order book is sent whenever there is a orderbook change
typedef struct _AggregateOrderBookUpdateMessage {
  UINT32 orderbook_id;                                            // bytes 0 to 3
  UINT8 filler_3[3];                                              // bytes 4 to 6
  UINT8 no_entries;                                               // byte 7
  BookEntry book_entry[:byte-size (((UINT32) no_entries) * 24)];
} AggregateOrderBookUpdateMessage;

// The Calculated Opening Price (COP) message indicates an instrument's theoretical opening price during the pre-opening phases of the market prior to an auction
typedef struct _CalculatedOpeningPriceMessage {
  UINT32 orderbook_id;              // bytes 0 to 3
  UINT32 calculated_opening_price;  // bytes 4 to 7, signed, read here as unsigned
  UINT8 filler_4[4];                // bytes 8 to 11
  UINT64 quantity;                  // bytes 12 to 19
} CalculatedOpeningPriceMessage;

// The Sequence Reset message is sent on each multicast channel at start of day
typedef struct _SequenceReset {
  UINT32 new_seq_no;  // bytes 0 to 3
} SequenceReset;

// The Disaster Recovery Signal message is sent on a dedicated multicast channel whenever a site failover scenario is triggered
typedef struct _DisasterRecoverySignalMessage {
  UINT32 dr_status;  // bytes 0 to 3
} DisasterRecoverySignalMessage;

// Contains implied volitility
typedef struct _ImpliedVolatilityMessage {
  UINT32 orderbook_id;        // bytes 0 to 3
  UINT32 implied_volatility;  // bytes 4 to 7
} ImpliedVolatilityMessage;

// The Market Alert message is generated periodically to relay market announcements and alerts
typedef struct _MarketAlertMessage {
  UINT16 alert_id;                             // bytes 0 to 1
  UINT8 source;                                // byte 2
  UINT8 filler_1;                              // byte 3
  UINT8 header[320];                           // bytes 4 to 323
  UINT8 last_fragment;                         // byte 324
  UINT8 info_type;                             // byte 325
  UINT8 priority;                              // byte 326
  UINT8 no_lines;                              // byte 327
  UINT8 content[(((UINT32) no_lines) * 320)];
} MarketAlertMessage;

// Issued to show the Previous Day settlement price and open interest
typedef struct _OpenInterestMessage {
  UINT16 day_indicator;  // bytes 0 to 1
  UINT8 filler_6[6];     // bytes 2 to 7
  UINT32 orderbook_id;   // bytes 8 to 11
  UINT32 settlement;     // bytes 12 to 15, signed, read here as unsigned
  UINT32 deal_count;     // bytes 16 to 19
  UINT32 gross_oi;       // bytes 20 to 23, signed, read here as unsigned
  UINT32 net_oi;         // bytes 24 to 27, signed, read here as unsigned
  UINT64 turnover;       // bytes 28 to 35
} OpenInterestMessage;

// The Quote Request message is generated whenever market participants request a new quotation
typedef struct _QuoteRequest {
  UINT32 orderbook_id;    // bytes 0 to 3
  UINT32 number_of_lots;  // bytes 4 to 7, signed, read here as unsigned
  UINT8 bid_ask_flag;     // byte 8
  UINT8 filler_3[3];      // bytes 9 to 11
} QuoteRequest;

// Describes individual commodities available from the OMD-D system
typedef struct _CommodityDefinitionMessage {
  UINT16 commodity_code;               // bytes 0 to 1
  UINT16 decimal_in_underlying_price;  // bytes 2 to 3
  UINT8 isin_code[12];                 // bytes 4 to 15
  UINT8 base_currency[3];              // bytes 16 to 18
  UINT8 underlying_price_unit;         // byte 19
  UINT8 commodity_name[32];            // bytes 20 to 51
  UINT64 nominal_value;                // bytes 52 to 59, signed, read here as unsigned
  UINT8 underlying_code[20];           // bytes 60 to 79
  UINT8 underlying_type;               // byte 80
  UINT8 effective_tomorrow;            // byte 81
  UINT8 commodity_id[6];               // bytes 82 to 87
  UINT8 filler_2[2];                   // bytes 88 to 89
} CommodityDefinitionMessage;

// Describes individual instrument classes available from the OMD-D system
typedef struct _ClassDefinitionMessage {
  UINT8 country;                     // byte 0
  UINT8 market;                      // byte 1
  UINT8 instrument_group;            // byte 2
  UINT8 modifier;                    // byte 3
  UINT16 commodity_code;             // bytes 4 to 5
  UINT8 filler_2[2];                 // bytes 6 to 7
  UINT32 price_quotation_factor;     // bytes 8 to 11, signed, read here as unsigned
  UINT32 contract_size;              // bytes 12 to 15
  UINT16 decimal_in_strike_price;    // bytes 16 to 17
  UINT16 decimal_in_contract_size;   // bytes 18 to 19
  UINT16 decimal_in_premium;         // bytes 20 to 21
  UINT16 ranking_type;               // bytes 22 to 23
  UINT8 tradable;                    // byte 24
  UINT8 premium_unit_4_price;        // byte 25
  UINT8 base_currency[3];            // bytes 26 to 28
  UINT8 instrument_class_id[14];     // bytes 29 to 42
  UINT8 instrument_class_name[32];   // bytes 43 to 74
  UINT8 is_fractions;                // byte 75
  UINT8 settlement_currency_id[32];  // bytes 76 to 107
  UINT8 effective_tomorrow;          // byte 108
  UINT32 tick_step_size;             // bytes 109 to 112, signed, read here as unsigned
  UINT8 filler_1;                    // byte 113
} ClassDefinitionMessage;

// Describes basic series information
typedef struct _SeriesDefinitionBaseMessage {
  UINT32 orderbook_id;              // bytes 0 to 3
  UINT8 symbol[32];                 // bytes 4 to 35
  UINT8 financial_product;          // byte 36
  UINT16 number_of_decimals_price;  // bytes 37 to 38
  UINT8 number_of_legs;             // byte 39
  UINT32 strike_price;              // bytes 40 to 43, signed, read here as unsigned
  UINT8 expiration_date[8];         // bytes 44 to 51
  UINT16 decimal_in_strike_price;   // bytes 52 to 53
  UINT8 put_or_call;                // byte 54
  UINT8 filler_1;                   // byte 55
} SeriesDefinitionBaseMessage;

// Describes series static data
typedef struct _SeriesDefinitionExtendedMessage {
  UINT32 orderbook_id;             // bytes 0 to 3
  UINT8 symbol[32];                // bytes 4 to 35
  UINT8 country;                   // byte 36
  UINT8 market;                    // byte 37
  UINT8 instrument_group;          // byte 38
  UINT8 modifier;                  // byte 39
  UINT16 commodity_code;           // bytes 40 to 41
  UINT16 expiry_date;              // bytes 42 to 43
  UINT32 strike_price;             // bytes 44 to 47, signed, read here as unsigned
  UINT64 contract_size_extended;   // bytes 48 to 55, signed, read here as unsigned
  UINT8 isin_code[12];             // bytes 56 to 67
  UINT8 series_status;             // byte 68
  UINT8 effective_tomorrow;        // byte 69
  UINT32 price_quotation_factor;   // bytes 70 to 73, signed, read here as unsigned
  UINT8 price_method;              // byte 74
  UINT8 filler_1;                  // byte 75
  UINT8 effective_exp_date[8];     // bytes 76 to 83
  UINT64 date_time_last_trading;   // bytes 84 to 91, signed, read here as unsigned
  UINT64 date_time_first_trading;  // bytes 92 to 99, signed, read here as unsigned
} SeriesDefinitionExtendedMessage;

// Describes a combination orderbook
typedef struct _CombinationDefinitionMessage {
  UINT32 combo_orderbook_id;  // bytes 0 to 3
  UINT32 leg_orderbook_id;    // bytes 4 to 7
  UINT8 filler_3[3];          // bytes 8 to 10
  UINT8 leg_side;             // byte 11
  UINT32 leg_ratio;           // bytes 12 to 15, signed, read here as unsigned
} CombinationDefinitionMessage;

// This message is published to mark the end of a refresh cycle
typedef struct _RefreshComplete {
  UINT32 last_seq_num;  // bytes 0 to 3
} RefreshComplete;

// Provides series information including high, low and open prices
typedef struct _SeriesStatisticsMessage {
  UINT32 orderbook_id;         // bytes 0 to 3
  UINT8 session;               // byte 4
  UINT8 filler_3[3];           // bytes 5 to 7
  UINT32 open_;                // bytes 8 to 11, signed, read here as unsigned
  UINT32 high;                 // bytes 12 to 15, signed, read here as unsigned
  UINT32 low;                  // bytes 16 to 19, signed, read here as unsigned
  UINT64 trade_report_volume;  // bytes 20 to 27
  UINT32 deal_count;           // bytes 28 to 31
  UINT32 price;                // bytes 32 to 35, signed, read here as unsigned
  UINT64 turnover;             // bytes 36 to 43
} SeriesStatisticsMessage;

// The Market Status message can be used to derive the active state of a series
typedef struct _MarketStatusMessage {
  UINT16 state_level;              // bytes 0 to 1
  UINT8 market;                    // byte 2
  UINT8 instrument;                // byte 3
  UINT32 orderbook_id;             // bytes 4 to 7
  UINT16 commodity_code;           // bytes 8 to 9
  UINT8 filler_2[2];               // bytes 10 to 11
  UINT8 actual_start_date[8];      // bytes 12 to 19
  UINT8 actual_start_time[6];      // bytes 20 to 25
  UINT8 planned_start_date[8];     // bytes 26 to 33
  UINT8 planned_start_time[6];     // bytes 34 to 39
  UINT16 seconds_to_state_change;  // bytes 40 to 41
  UINT16 state;                    // bytes 42 to 43
  UINT8 priority;                  // byte 44
  UINT8 filler_3[3];               // bytes 45 to 47
} MarketStatusMessage;

// The Series Status message is generated whenever there is a change to suspension indicator or series status, or when the date/time of last trading is changed
typedef struct _SeriesStatusMessage {
  UINT32 orderbook_id;         // bytes 0 to 3
  UINT8 suspension_indicator;  // byte 4
  UINT8 series_status;         // byte 5
  UINT8 filler_2[2];           // bytes 6 to 7
} SeriesStatusMessage;

// The Commodity Status message is generated whenever a commodity status changes
typedef struct _CommodityStatusMessage {
  UINT16 commodity_code;  // bytes 0 to 1
  UINT8 suspended;        // byte 2
  UINT8 locked;           // byte 3
} CommodityStatusMessage;

// The trade message is generated each time a trade has been performed
typedef struct _TradeMessage {
  UINT32 orderbook_id;                 // bytes 0 to 3
  UINT64 order_id;                     // bytes 4 to 11
  UINT32 price;                        // bytes 12 to 15, signed, read here as unsigned
  UINT64 trade_id;                     // bytes 16 to 23
  UINT32 combo_group_id;               // bytes 24 to 27
  UINT8 trade_side;                    // byte 28
  UINT8 printable : 1;                 // byte 29
  UINT8 occurred_at_cross : 1;         // byte 29
  UINT8 reported_trade : 1;            // byte 29
  UINT8 unused_5 : 5;                  // byte 29
  UINT16 late_trade : 1;               // bytes 30 to 31
  UINT16 internal_trade_or_cross : 1;  // bytes 30 to 31
  UINT16 unused_1 : 1;                 // bytes 30 to 31
  UINT16 buy_write : 1;                // bytes 30 to 31
  UINT16 off_market : 1;               // bytes 30 to 31
  UINT16 unused_11 : 11;               // bytes 30 to 31
  UINT16 reported_trade_2 : 1;         // bytes 32 to 33
  UINT16 unused_15 : 15;               // bytes 32 to 33
  UINT8 filler_2[2];                   // bytes 34 to 35
  UINT64 quantity;                     // bytes 36 to 43
  UINT64 trade_time;                   // bytes 44 to 51
} TradeMessage;

// Represents a trade amendment or cancellation
typedef struct _TradeAmendmentMessage {
  UINT64 trade_id;        // bytes 0 to 7
  UINT32 combo_group_id;  // bytes 8 to 11
  UINT32 price;           // bytes 12 to 15, signed, read here as unsigned
  UINT64 quantity;        // bytes 16 to 23
  UINT64 trade_time;      // bytes 24 to 31
  UINT8 trade_state;      // byte 32
  UINT8 filler_3[3];      // bytes 33 to 35
} TradeAmendmentMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0161: AggregateOrderBookUpdateMessage aggregate_order_book_update_message;
    case 0x016C: CalculatedOpeningPriceMessage calculated_opening_price_message;
    case 0x0064: SequenceReset sequence_reset;
    case 0x0069: DisasterRecoverySignalMessage disaster_recovery_signal_message;
    case 0x016F: ImpliedVolatilityMessage implied_volatility_message;
    case 0x0143: MarketAlertMessage market_alert_message;
    case 0x016E: OpenInterestMessage open_interest_message;
    case 0x0150: QuoteRequest quote_request;
    case 0x012D: CommodityDefinitionMessage commodity_definition_message;
    case 0x012E: ClassDefinitionMessage class_definition_message;
    case 0x012F: SeriesDefinitionBaseMessage series_definition_base_message;
    case 0x0130: SeriesDefinitionExtendedMessage series_definition_extended_message;
    case 0x0131: CombinationDefinitionMessage combination_definition_message;
    case 0x00CB: RefreshComplete refresh_complete;
    case 0x016B: SeriesStatisticsMessage series_statistics_message;
    case 0x0140: MarketStatusMessage market_status_message;
    case 0x0141: SeriesStatusMessage series_status_message;
    case 0x0142: CommodityStatusMessage commodity_status_message;
    case 0x015E: TradeMessage trade_message;
    case 0x0164: TradeAmendmentMessage trade_amendment_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16 msg_size { msg_size >= 4 };                                                                                                                               // bytes 0 to 1
  UINT16 msg_type;                                                                                                                                                 // bytes 2 to 3
  Payload(msg_type, (((UINT32) msg_size) - 4)) payload[:byte-size-single-element-array (((UINT32) msg_size) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// The packet's message area: the messages it counts, or one ZliB block holding them
typedef struct _MessageBuffer (UINT8 msg_count, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) msg_count); };
} MessageBuffer;

// ---- Packet: Packet ----------------------------------------------------------

// Omd Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16 pkt_size;                                                                                                     // bytes 0 to 1
  UINT8 msg_count;                                                                                                     // byte 2
  UINT8 compression_mode;                                                                                              // byte 3
  UINT32 seq_num;                                                                                                      // bytes 4 to 7
  UINT64 send_time;                                                                                                    // bytes 8 to 15
  MessageBuffer(msg_count, (available - 16), tally) message_buffer[:byte-size-single-element-array (available - 16)];
} Packet;

