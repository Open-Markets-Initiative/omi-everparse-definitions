// ---- Packet Header: 16 bytes -------------------------------------------------

// Omd packet header (byte-identical to the Udp form; SeqNum and SendTime set to 0 on Tcp per 3.5)
entrypoint typedef struct _PacketHeader {
  UINT16 pkt_size;         // bytes 0 to 1
  UINT8 msg_count;         // byte 2
  UINT8 compression_mode;  // byte 3
  UINT32 seq_num;          // bytes 4 to 7
  UINT64 send_time;        // bytes 8 to 15
} PacketHeader;

// ---- Msg Header: 4 bytes -----------------------------------------------------

// Omd message header
entrypoint typedef struct _MsgHeader {
  UINT16 msg_size;  // bytes 0 to 1
  UINT16 msg_type;  // bytes 2 to 3
} MsgHeader;

// ---- Add Order: 32 bytes -----------------------------------------------------

// Generated when a new order is inserted into the order book.
entrypoint typedef struct _AddOrder {
  UINT32 orderbook_id;         // bytes 0 to 3
  UINT64 order_id;             // bytes 4 to 11
  UINT64 price;                // bytes 12 to 19, signed, read here as unsigned
  UINT32 quantity;             // bytes 20 to 23
  UINT8 side;                  // byte 24
  UINT8 lot_type;              // byte 25
  UINT8 order_type;            // byte 26
  UINT32 order_book_position;  // bytes 27 to 30
  UINT8 filler_1;              // byte 31
} AddOrder;

// ---- Aggregate Implied Order: 22 bytes ---------------------------------------

// Generated whenever there is an update on implied order at the given implied price.
entrypoint typedef struct _AggregateImpliedOrder {
  UINT32 orderbook_id;      // bytes 0 to 3
  UINT64 implied_price;     // bytes 4 to 11, signed, read here as unsigned
  UINT64 implied_quantity;  // bytes 12 to 19
  UINT8 side;               // byte 20
  UINT8 filler_1;           // byte 21
} AggregateImpliedOrder;

// ---- Calculated Opening Price Message: 24 bytes ------------------------------

// The Calculated Opening Price (COP) message indicates an instrument's theoretical opening price during the pre-opening phases of the market prior to an auction
entrypoint typedef struct _CalculatedOpeningPriceMessage {
  UINT32 orderbook_id;                 // bytes 0 to 3
  UINT64 calculated_opening_price;     // bytes 4 to 11, signed, read here as unsigned
  UINT8 filler_4[4];                   // bytes 12 to 15
  UINT64 calculated_opening_quantity;  // bytes 16 to 23
} CalculatedOpeningPriceMessage;

// ---- Sequence Reset: 4 bytes -------------------------------------------------

// The Sequence Reset message is sent on each multicast channel at start of day
entrypoint typedef struct _SequenceReset {
  UINT32 new_seq_no;  // bytes 0 to 3
} SequenceReset;

// ---- Disaster Recovery Signal Message: 4 bytes -------------------------------

// The Disaster Recovery Signal message is sent on a dedicated multicast channel whenever a site failover scenario is triggered
entrypoint typedef struct _DisasterRecoverySignalMessage {
  UINT32 dr_status;  // bytes 0 to 3
} DisasterRecoverySignalMessage;

// ---- Delete Order: 14 bytes --------------------------------------------------

// Generated when an existing order is deleted.
entrypoint typedef struct _DeleteOrder {
