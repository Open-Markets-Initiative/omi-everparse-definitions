} ImpliedVolatilityMessage;

// ---- Modify Order: 32 bytes --------------------------------------------------

// Generated when an existing order identified by the OrderID is modified.
entrypoint typedef struct _ModifyOrder {
  UINT32 orderbook_id;         // bytes 0 to 3
