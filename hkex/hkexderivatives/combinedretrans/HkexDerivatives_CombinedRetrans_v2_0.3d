  UINT64 order_id;      // bytes 4 to 11
  UINT8 side;           // byte 12
  UINT8 filler_1;       // byte 13
} DeleteOrder;

// ---- Implied Volatility Message: 8 bytes -------------------------------------

// Contains implied volitility
entrypoint typedef struct _ImpliedVolatilityMessage {
  UINT32 orderbook_id;        // bytes 0 to 3
