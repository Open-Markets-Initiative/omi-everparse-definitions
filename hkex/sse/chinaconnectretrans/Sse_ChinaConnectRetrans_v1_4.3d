// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Sse_ChinaConnectRetrans_v1_4.3d

// ---- Values ------------------------------------------------------------------

// Msg Type: 2 byte code
#define MSG_TYPE_SEQUENCE_RESET_MESSAGE 0x0064            // Sequence Reset Message
#define MSG_TYPE_DISASTER_RECOVERY_SIGNAL_MESSAGE 0x0069  // Disaster Recovery Signal Message
#define MSG_TYPE_MARKET_DEFINITION_MESSAGE 0x0262         // Market Definition Message
#define MSG_TYPE_LOGON_MESSAGE 0x0065                     // Logon Message
#define MSG_TYPE_LOGON_RESPONSE_MESSAGE 0x0066            // Logon Response Message
#define MSG_TYPE_RETRANSMISSION_REQUEST_MESSAGE 0x00C9    // Retransmission Request Message
#define MSG_TYPE_RETRANSMISSION_RESPONSE_MESSAGE 0x00CA   // Retransmission Response Message
#define MSG_TYPE_SECURITY_DEFINITION_MESSAGE 0x0263       // Security Definition Message
#define MSG_TYPE_SECURITY_STATUS_MESSAGE 0x026D           // Security Status Message
#define MSG_TYPE_STATISTICS_MESSAGE 0x0294                // Statistics Message
#define MSG_TYPE_TOP_OF_BOOK_MESSAGE 0x028F               // Top Of Book Message

// Dr Status: 4 byte code
#define DR_STATUS_DR_IN_PROGRESS 0x00000001  // Dr In Progress
#define DR_STATUS_DR_COMPLETED 0x00000002    // Dr Completed

// Session Status: one byte code
#define SESSION_STATUS_SESSION_ACTIVE 0x00                  // Session Active
#define SESSION_STATUS_INVALID_USERNAME_OR_IP_ADDRESS 0x05  // Invalid Username Or Ip Address
#define SESSION_STATUS_USER_ALREADY_CONNECTED 0x64          // User Already Connected

// Retrans Status: one byte code
#define RETRANS_STATUS_REQUEST_ACCEPTED 0x00                    // Request Accepted
#define RETRANS_STATUS_UNKNOWN_OR_UNAUTHORIZED_CHANNEL_ID 0x01  // Unknown Or Unauthorized Channel Id
#define RETRANS_STATUS_MESSAGES_NOT_AVAILABLE 0x02              // Messages Not Available
#define RETRANS_STATUS_EXCEEDS_MAXIMUM_SEQUENCE_RANGE 0x64      // Exceeds Maximum Sequence Range
#define RETRANS_STATUS_EXCEEDS_MAXIMUM_REQUESTS_IN_A_DAY 0x65   // Exceeds Maximum Requests In A Day

// Shortsell Flag: one byte code
#define SHORTSELL_FLAG_SHORT_SELL_ALLOWED 0x59      // Short Sell Allowed
#define SHORTSELL_FLAG_SHORT_SELL_NOT_ALLOWED 0x4E  // Short Sell Not Allowed

// Security Trading Status: one byte code
#define SECURITY_TRADING_STATUS_TRADING_HALT 0x02  // Trading Halt
#define SECURITY_TRADING_STATUS_RESUME 0x03        // Resume

// ---- Types -------------------------------------------------------------------

// The Sequence Reset message is sent on each multicast channel at start of day. The client must ignore the sequence number of the Sequence Reset message itself, and set the next expected sequence number to NewSeqNo. On receipt clients must clear all cached data for all eligible instruments traded in SSE and SZSE and then subscribe to the refresh channels.
typedef struct _SequenceResetMessage {
  UINT32 new_seq_no;  // bytes 0 to 3
} SequenceResetMessage;

// The Disaster Recovery (DR) Signal message is sent on a dedicated multicast channel whenever site failover is triggered.
typedef struct _DisasterRecoverySignalMessage {
  UINT32 dr_status;  // bytes 0 to 3
} DisasterRecoverySignalMessage;

// The Market Definition message is generated at the start of the business day for each market (SSE or SZSE). Market Definition messages for different markets are sent via different channels.
typedef struct _MarketDefinitionMessage {
  UINT8 market_code[4];         // bytes 0 to 3
  UINT8 market_name[25];        // bytes 4 to 28
  UINT8 currency_code[3];       // bytes 29 to 31
  UINT32 number_of_securities;  // bytes 32 to 35
} MarketDefinitionMessage;

// The Logon message enables client authentication. Not required for multicast channels; only used for retransmission requests. Client sends Logon containing username to OMD-CC which responds with Logon Response.
typedef struct _LogonMessage {
  UINT8 username[12];  // bytes 0 to 11
} LogonMessage;

// Response to a Logon request indicating session status.
typedef struct _LogonResponseMessage {
  UINT8 session_status;  // byte 0
  UINT8 filler_3[3];     // bytes 1 to 3
} LogonResponseMessage;

// Client-initiated request to retransmit a range of messages from a specific multicast channel.
typedef struct _RetransmissionRequestMessage {
  UINT16 channel_id;     // bytes 0 to 1
  UINT8 filler_2[2];     // bytes 2 to 3
  UINT32 begin_seq_num;  // bytes 4 to 7
  UINT32 end_seq_num;    // bytes 8 to 11
} RetransmissionRequestMessage;

// Server response to a Retransmission Request indicating whether the range can be resent.
typedef struct _RetransmissionResponseMessage {
  UINT16 channel_id;     // bytes 0 to 1
  UINT8 retrans_status;  // byte 2
  UINT8 filler_1;        // byte 3
  UINT32 begin_seq_num;  // bytes 4 to 7
  UINT32 end_seq_num;    // bytes 8 to 11
} RetransmissionResponseMessage;

// The Security Definition message contains all the reference data for a security. Security Definition messages for different markets (SSE and SZSE) are sent via different channels.
typedef struct _SecurityDefinitionMessage {
  UINT32 security_code;           // bytes 0 to 3
  UINT8 market_code[4];           // bytes 4 to 7
  UINT8 isin_code[12];            // bytes 8 to 19
  UINT8 instrument_type[4];       // bytes 20 to 23
  UINT8 filler_2[2];              // bytes 24 to 25
  UINT8 security_short_name[40];  // bytes 26 to 65
  UINT8 currency_code[3];         // bytes 66 to 68
  UINT8 filler_60[60];            // bytes 69 to 128
  UINT8 security_name_gb[60];     // bytes 129 to 188
  UINT32 lot_size;                // bytes 189 to 192
  UINT32 previous_closing_price;  // bytes 193 to 196, signed, read here as unsigned
  UINT8 filler_1;                 // byte 197
  UINT8 shortsell_flag;           // byte 198
  UINT8 filler_6[6];              // bytes 199 to 204
  UINT32 listing_date;            // bytes 205 to 208
  UINT8 filler_7[7];              // bytes 209 to 215
} SecurityDefinitionMessage;

// The Security Status message is generated at the start of the business day if the security is halted, and whenever a security state or trading phase changes. Security Status messages for different markets (SSE and SZSE) are sent via different channels.
typedef struct _SecurityStatusMessage {
  UINT32 security_code;           // bytes 0 to 3
  UINT8 security_trading_status;  // byte 4
  UINT8 filler_3[3];              // bytes 5 to 7
  UINT8 trading_phase_code[8];    // bytes 8 to 15
} SecurityStatusMessage;

// The Statistics message provides statistics including turnover. Statistics messages for different markets (SSE and SZSE) are sent via different channels.
typedef struct _StatisticsMessage {
  UINT32 security_code;  // bytes 0 to 3
  UINT64 shares_traded;  // bytes 4 to 11
  UINT64 turnover;       // bytes 12 to 19, signed, read here as unsigned
  UINT32 high_price;     // bytes 20 to 23, signed, read here as unsigned
  UINT32 low_price;      // bytes 24 to 27, signed, read here as unsigned
  UINT32 last_price;     // bytes 28 to 31, signed, read here as unsigned
  UINT32 opening_price;  // bytes 32 to 35, signed, read here as unsigned
  UINT8 filler_12[12];   // bytes 36 to 47
} StatisticsMessage;

// The Top Of Book (TOB) message is generated when the top price level has been modified. TOB messages for different markets (SSE and SZSE) are sent via different channels.
typedef struct _TopOfBookMessage {
  UINT32 security_code;           // bytes 0 to 3
  UINT64 aggregate_bid_quantity;  // bytes 4 to 11
  UINT64 aggregate_ask_quantity;  // bytes 12 to 19
  UINT32 bid_price;               // bytes 20 to 23, signed, read here as unsigned
  UINT32 ask_price;               // bytes 24 to 27, signed, read here as unsigned
  UINT8 filler_8[8];              // bytes 28 to 35
} TopOfBookMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0064: SequenceResetMessage sequence_reset_message;
    case 0x0069: DisasterRecoverySignalMessage disaster_recovery_signal_message;
    case 0x0262: MarketDefinitionMessage market_definition_message;
    case 0x0065: LogonMessage logon_message;
    case 0x0066: LogonResponseMessage logon_response_message;
    case 0x00C9: RetransmissionRequestMessage retransmission_request_message;
    case 0x00CA: RetransmissionResponseMessage retransmission_response_message;
    case 0x0263: SecurityDefinitionMessage security_definition_message;
    case 0x026D: SecurityStatusMessage security_status_message;
    case 0x0294: StatisticsMessage statistics_message;
    case 0x028F: TopOfBookMessage top_of_book_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16 msg_size { msg_size >= 4 };                                                                                                                               // bytes 0 to 1
  UINT16 msg_type;                                                                                                                                                 // bytes 2 to 3
  Payload(msg_type, (((UINT32) msg_size) - 4)) payload[:byte-size-single-element-array (((UINT32) msg_size) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Omd Tcp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16 pkt_size;                                                                                                      // bytes 0 to 1
  UINT8 msg_count;                                                                                                      // byte 2
  UINT8 filler;                                                                                                         // byte 3
  UINT32 seq_num;                                                                                                       // bytes 4 to 7
  UINT64 send_time;                                                                                                     // bytes 8 to 15
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 16)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) msg_count); };
} Packet;

