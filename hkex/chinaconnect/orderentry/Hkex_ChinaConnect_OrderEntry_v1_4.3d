    case 0x02: ResendRequestMessage(body_field_bit_0, body_field_bit_1) resend_request_message;
    case 0x03: RejectMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2, body_field_bit_3, body_field_bit_4, body_field_bit_5) reject_message;
    case 0x04: SequenceResetMessage(body_field_bit_0, body_field_bit_1) sequence_reset_message;
    case 0x0B: NewOrderSingleMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2, body_field_bit_3, body_field_bit_4, body_field_bit_5, body_field_bit_6, body_field_bit_7, body_field_bit_8, body_field_bit_9, body_field_bit_10, body_field_bit_11, body_field_bit_12, body_field_bit_14, body_field_bit_15, body_field_bit_16, body_field_bit_18, body_field_bit_20, body_field_bit_21) new_order_single_message;
    case 0x0D: CancelOrderMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2, body_field_bit_3, body_field_bit_4, body_field_bit_5, body_field_bit_6, body_field_bit_7, body_field_bit_8, body_field_bit_9, body_field_bit_10) cancel_order_message;
    case 0x0A: ExecutionReportMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2, body_field_bit_3, body_field_bit_4, body_field_bit_5, body_field_bit_6, body_field_bit_7, body_field_bit_8, body_field_bit_9, body_field_bit_10, body_field_bit_11, body_field_bit_12, body_field_bit_13, body_field_bit_14, body_field_bit_15, body_field_bit_17, body_field_bit_18, body_field_bit_19, body_field_bit_20, body_field_bit_21, body_field_bit_22, body_field_bit_23, body_field_bit_24, body_field_bit_25, body_field_bit_26, body_field_bit_27, body_field_bit_28, body_field_bit_29, body_field_bit_30, body_field_bit_31, body_field_bit_32, body_field_bit_33, body_field_bit_38, body_field_bit_40, body_field_bit_41) execution_report_message;
    case 0x09: BusinessMessageRejectMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2, body_field_bit_3, body_field_bit_4, body_field_bit_5) business_message_reject_message;
    case 0x1B: PartyEntitlementRequestMessage(body_field_bit_0) party_entitlement_request_message;
    case 0x1C: PartyEntitlementReportMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2, body_field_bit_3, body_field_bit_4, body_field_bit_5, body_field_bit_6) party_entitlement_report_message;
    case 0x19: ThrottleEntitlementRequestMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2) throttle_entitlement_request_message;
    case 0x1A: ThrottleEntitlementResponseMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2) throttle_entitlement_response_message;
  }
} Payload;

