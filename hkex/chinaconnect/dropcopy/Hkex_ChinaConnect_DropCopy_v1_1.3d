// Body of the message, the one the Message Type names
casetype _Payload (UINT8 selector, UINT8 body_field_bit_0, UINT8 body_field_bit_1, UINT8 body_field_bit_2, UINT8 body_field_bit_3, UINT8 body_field_bit_4, UINT8 body_field_bit_5, UINT8 body_field_bit_6, UINT8 body_field_bit_7, UINT8 body_field_bit_8, UINT8 body_field_bit_9, UINT8 body_field_bit_11, UINT8 body_field_bit_12, UINT8 body_field_bit_13, UINT8 body_field_bit_14, UINT8 body_field_bit_15, UINT8 body_field_bit_17, UINT8 body_field_bit_18, UINT8 body_field_bit_19, UINT8 body_field_bit_20, UINT8 body_field_bit_21, UINT8 body_field_bit_22, UINT8 body_field_bit_23, UINT8 body_field_bit_24, UINT8 body_field_bit_25, UINT8 body_field_bit_26, UINT8 body_field_bit_27, UINT8 body_field_bit_28, UINT8 body_field_bit_30, UINT8 body_field_bit_31, UINT8 body_field_bit_32, UINT8 body_field_bit_33, UINT8 body_field_bit_37, UINT8 body_field_bit_38, UINT8 body_field_bit_40, UINT8 body_field_bit_41) {
  switch (selector) {
    case 0x07: LookupRequestMessage(body_field_bit_0, body_field_bit_1) lookup_request_message;
    case 0x08: LookupResponseMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2, body_field_bit_3, body_field_bit_4, body_field_bit_5, body_field_bit_6) lookup_response_message;
    case 0x05: LogonMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2, body_field_bit_3, body_field_bit_4, body_field_bit_5) logon_message;
    case 0x06: LogoutMessage(body_field_bit_0, body_field_bit_1) logout_message;
    case 0x00: HeartbeatMessage(body_field_bit_0) heartbeat_message;
    case 0x01: TestRequestMessage(body_field_bit_0) test_request_message;
    case 0x02: ResendRequestMessage(body_field_bit_0, body_field_bit_1) resend_request_message;
    case 0x03: RejectMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2, body_field_bit_3, body_field_bit_4, body_field_bit_5) reject_message;
    case 0x04: SequenceResetMessage(body_field_bit_0, body_field_bit_1) sequence_reset_message;
    case 0x09: BusinessMessageRejectMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2, body_field_bit_3, body_field_bit_4, body_field_bit_5) business_message_reject_message;
    case 0x0A: ExecutionReportMessage(body_field_bit_0, body_field_bit_1, body_field_bit_2, body_field_bit_3, body_field_bit_4, body_field_bit_5, body_field_bit_6, body_field_bit_7, body_field_bit_8, body_field_bit_9, body_field_bit_11, body_field_bit_12, body_field_bit_13, body_field_bit_14, body_field_bit_15, body_field_bit_17, body_field_bit_18, body_field_bit_19, body_field_bit_20, body_field_bit_21, body_field_bit_22, body_field_bit_23, body_field_bit_24, body_field_bit_25, body_field_bit_26, body_field_bit_27, body_field_bit_28, body_field_bit_30, body_field_bit_31, body_field_bit_32, body_field_bit_33, body_field_bit_37, body_field_bit_38, body_field_bit_40, body_field_bit_41) execution_report_message;
  }
} Payload;

