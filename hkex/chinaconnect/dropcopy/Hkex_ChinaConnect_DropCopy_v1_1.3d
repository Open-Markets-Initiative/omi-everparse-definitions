typedef struct _ExecutionReportMessage (UINT8 body_field_bit_0, UINT8 body_field_bit_1, UINT8 body_field_bit_2, UINT8 body_field_bit_3, UINT8 body_field_bit_4, UINT8 body_field_bit_5, UINT8 body_field_bit_6, UINT8 body_field_bit_7, UINT8 body_field_bit_8, UINT8 body_field_bit_9, UINT8 body_field_bit_11, UINT8 body_field_bit_12, UINT8 body_field_bit_13, UINT8 body_field_bit_14, UINT8 body_field_bit_15, UINT8 body_field_bit_17, UINT8 body_field_bit_18, UINT8 body_field_bit_19, UINT8 body_field_bit_20, UINT8 body_field_bit_21, UINT8 body_field_bit_22, UINT8 body_field_bit_23, UINT8 body_field_bit_24, UINT8 body_field_bit_25, UINT8 body_field_bit_26, UINT8 body_field_bit_27, UINT8 body_field_bit_28, UINT8 body_field_bit_30, UINT8 body_field_bit_31, UINT8 body_field_bit_32, UINT8 body_field_bit_33, UINT8 body_field_bit_37, UINT8 body_field_bit_38, UINT8 body_field_bit_40, UINT8 body_field_bit_41) {
