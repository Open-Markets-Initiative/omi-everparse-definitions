    case true: UINT8 lot_type;
    case false: unit absent;
  }
} OptionalLotType;

// Code to identify the reason for an Execution Report message with Exec
casetype _OptionalExecRestatementReason (Bool present) {
  switch (present) {
    case true: UINT16 exec_restatement_reason;
    case false: unit absent;
  }
} OptionalExecRestatementReason;

// The point in the matching process at which this trade was matched:
casetype _OptionalMatchType (Bool present) {
  switch (present) {
    case true: UINT8 match_type;
    case false: unit absent;
  }
} OptionalMatchType;

// The Broker ID on the opposite side of the trade
casetype _OptionalCounterpartyBrokerID (Bool present) {
  switch (present) {
    case true: UINT8 counterparty_broker_i_d[12];
    case false: unit absent;
  }
} OptionalCounterpartyBrokerID;

// Execution Size
casetype _OptionalExecutionQuantity (Bool present) {
  switch (present) {
    case true: UINT64 execution_quantity;
    case false: unit absent;
  }
} OptionalExecutionQuantity;

// Execution price
casetype _OptionalExecutionPrice (Bool present) {
  switch (present) {
    case true: UINT64 execution_price;
    case false: unit absent;
  }
} OptionalExecutionPrice;

// Indicates if the message is a drop copy:
casetype _OptionalCopyMessageIndicator (Bool present) {
  switch (present) {
    case true: UINT8 copy_message_indicator;
    case false: unit absent;
  }
} OptionalCopyMessageIndicator;

// Identifier assigned to a trade by the matching system
casetype _OptionalTradeMatchID (Bool present) {
  switch (present) {
    case true: UINT8 trade_match_i_d[25];
    case false: unit absent;
  }
} OptionalTradeMatchID;

// Investor ID as assigned by CCASS for a Special Segregated Account (SPSA). Limited to maximum 6
casetype _OptionalSPSAInvestorID (Bool present) {
  switch (present) {
    case true: UINT8 s_p_s_a_investor_i_d[21];
    case false: unit absent;
  }
} OptionalSPSAInvestorID;

// Indicates date of trading day (Format: YYYYMMDD)
casetype _OptionalTradeDate (Bool present) {
  switch (present) {
    case true: UINT32 trade_date;
    case false: unit absent;
  }
} OptionalTradeDate;

