// ---- Packet Header: 16 bytes -------------------------------------------------

// Omd packet header (byte-identical to the Udp form; SeqNum and SendTime set to 0 on Tcp per 3.5)
entrypoint typedef struct _PacketHeader {
  UINT16 pkt_size;   // bytes 0 to 1
  UINT8 msg_count;   // byte 2
  UINT8 filler;      // byte 3
  UINT32 seq_num;    // bytes 4 to 7
  UINT64 send_time;  // bytes 8 to 15
} PacketHeader;

// ---- Msg Header: 4 bytes -----------------------------------------------------

// Omd message header
entrypoint typedef struct _MsgHeader {
  UINT16 msg_size;  // bytes 0 to 1
  UINT16 msg_type;  // bytes 2 to 3
} MsgHeader;

// ---- Add Order Message: 28 bytes ---------------------------------------------

// The Add Order message is generated when a new order is inserted into the order book. The OrderId is unique per security but will not increment consecutively. Note for Securities instruments the OrderBookPosition is always set to zero.
entrypoint typedef struct _AddOrderMessage {
  UINT32 security_code;        // bytes 0 to 3
  UINT64 order_id;             // bytes 4 to 11
  UINT32 price;                // bytes 12 to 15, signed, read here as unsigned
  UINT32 quantity;             // bytes 16 to 19
  UINT16 side;                 // bytes 20 to 21
  UINT8 order_type;            // byte 22
  UINT8 filler_1;              // byte 23
  UINT32 order_book_position;  // bytes 24 to 27, signed, read here as unsigned
} AddOrderMessage;

// ---- Sequence Reset Message: 4 bytes -----------------------------------------

// The Sequence Reset message is sent on each multicast channel at start of day. It may also be sent when there is a need for the rectification of stock reference data before market open.
entrypoint typedef struct _SequenceResetMessage {
  UINT32 new_seq_no;  // bytes 0 to 3
} SequenceResetMessage;

// ---- Disaster Recovery Signal Message: 4 bytes -------------------------------

// The Disaster Recovery (DR) Signal message is sent on a dedicated multicast channel whenever a site failover scenario is triggered.
entrypoint typedef struct _DisasterRecoverySignalMessage {
  UINT32 dr_status;  // bytes 0 to 3
} DisasterRecoverySignalMessage;

// ---- Delete Order Message: 16 bytes ------------------------------------------

// The Delete Order message is generated when an existing order identified by the OrderId is deleted.
entrypoint typedef struct _DeleteOrderMessage {
  UINT32 security_code;  // bytes 0 to 3
  UINT64 order_id;       // bytes 4 to 11
  UINT16 side;           // bytes 12 to 13
  UINT8 filler_2[2];     // bytes 14 to 15
} DeleteOrderMessage;

// ---- Indicative Equilibrium Price Message: 16 bytes --------------------------

// The Indicative Equilibrium Price (IEP) message is generated whenever there is change of the IEP or Indicative Equilibrium Volume (IEV) during Pre-Opening Session (POS) or Closing Auction Session (CAS). The IEP is 0 when IEP does not exist.
entrypoint typedef struct _IndicativeEquilibriumPriceMessage {
  UINT32 security_code;       // bytes 0 to 3
  UINT32 price;               // bytes 4 to 7, signed, read here as unsigned
  UINT64 aggregate_quantity;  // bytes 8 to 15
} IndicativeEquilibriumPriceMessage;

// ---- Modify Order Message: 24 bytes ------------------------------------------

// The Modify Order message is generated when an existing order identified by the OrderId is modified. The only attribute that can be modified is the quantity. Note for Securities instruments the OrderBookPosition is always set to zero.
entrypoint typedef struct _ModifyOrderMessage {
  UINT32 security_code;        // bytes 0 to 3
  UINT64 order_id;             // bytes 4 to 11
  UINT32 quantity;             // bytes 12 to 15
  UINT16 side;                 // bytes 16 to 17
  UINT8 filler_2[2];           // bytes 18 to 19
  UINT32 order_book_position;  // bytes 20 to 23, signed, read here as unsigned
} ModifyOrderMessage;

// ---- Order Imbalance Message: 16 bytes ---------------------------------------

// The Order Imbalance message provides order imbalance information at the Indicative Equilibrium Price (IEP) during the Pre-Opening Session (POS) and Closing Auction Session (CAS).
entrypoint typedef struct _OrderImbalanceMessage {
  UINT32 security_code;             // bytes 0 to 3
  UINT8 order_imbalance_direction;  // byte 4
  UINT8 filler_1;                   // byte 5
  UINT64 order_imbalance_quantity;  // bytes 6 to 13
  UINT8 filler_2[2];                // bytes 14 to 15
} OrderImbalanceMessage;

// ---- Market Definition Message: 36 bytes -------------------------------------

// The Market Definition message is generated at the start of the business day for each market segment.
entrypoint typedef struct _MarketDefinitionMessage {
  UINT8 market_code[4];         // bytes 0 to 3
  UINT8 market_name[25];        // bytes 4 to 28
  UINT8 currency_code[3];       // bytes 29 to 31
  UINT32 number_of_securities;  // bytes 32 to 35
} MarketDefinitionMessage;

// ---- Face Value Composite: 9 bytes -------------------------------------------

// Bond face value scaled at runtime by DecimalsInFaceValue. 0 mantissa means Not available.
entrypoint typedef struct _FaceValueComposite {
  UINT64 face_value;             // bytes 0 to 7
  UINT8 decimals_in_face_value;  // byte 8
} FaceValueComposite;

// ---- Call Price Composite: 5 bytes -------------------------------------------

// CBBC call price scaled at runtime by DecimalsInCallPrice. 0 mantissa means Not available.
entrypoint typedef struct _CallPriceComposite {
  UINT32 call_price;             // bytes 0 to 3, signed, read here as unsigned
  UINT8 decimals_in_call_price;  // byte 4
} CallPriceComposite;

// ---- Entitlement Composite: 5 bytes ------------------------------------------

// Warrant entitlement scaled at runtime by DecimalsInEntitlement. 0 mantissa means Not available.
entrypoint typedef struct _EntitlementComposite {
  UINT32 entitlement;             // bytes 0 to 3, signed, read here as unsigned
  UINT8 decimals_in_entitlement;  // byte 4
} EntitlementComposite;

// ---- Currency Rate Message: 12 bytes -----------------------------------------

// The Currency Rate message provides the foreign exchange conversion rates between various foreign currencies and the Hong Kong dollar.
entrypoint typedef struct _CurrencyRateMessage {
  UINT8 currency_code[3];  // bytes 0 to 2
  UINT8 filler_1;          // byte 3
  UINT16 currency_factor;  // bytes 4 to 5
  UINT8 filler_2[2];       // bytes 6 to 7
  UINT32 currency_rate;    // bytes 8 to 11
} CurrencyRateMessage;

// ---- Reference Price Message: 16 bytes ---------------------------------------

// Reference price, lower and upper price limits for order input during an applicable auction session (POS or CAS). Sent again when there is any change.
entrypoint typedef struct _ReferencePriceMessage {
  UINT32 security_code;    // bytes 0 to 3
  UINT32 reference_price;  // bytes 4 to 7, signed, read here as unsigned
  UINT32 lower_price;      // bytes 8 to 11, signed, read here as unsigned
  UINT32 upper_price;      // bytes 12 to 15, signed, read here as unsigned
} ReferencePriceMessage;

// ---- Refresh Complete Message: 4 bytes ---------------------------------------

// This message is published to mark the end of a refresh.
entrypoint typedef struct _RefreshCompleteMessage {
  UINT32 last_seq_num;  // bytes 0 to 3
} RefreshCompleteMessage;

// ---- Logon Message: 12 bytes -------------------------------------------------

// The Logon message enables client authentication. Not required for multicast channels; only used for retransmission requests.
entrypoint typedef struct _LogonMessage {
  UINT8 username[12];  // bytes 0 to 11
} LogonMessage;

// ---- Logon Response Message: 4 bytes -----------------------------------------

// Response to a Logon request indicating session status.
entrypoint typedef struct _LogonResponseMessage {
  UINT8 session_status;  // byte 0
  UINT8 filler_3[3];     // bytes 1 to 3
} LogonResponseMessage;

// ---- Retransmission Request Message: 12 bytes --------------------------------

// Client-initiated request to retransmit a range of messages from a specific multicast channel.
entrypoint typedef struct _RetransmissionRequestMessage {
  UINT16 channel_id;     // bytes 0 to 1
  UINT8 filler_2[2];     // bytes 2 to 3
  UINT32 begin_seq_num;  // bytes 4 to 7
  UINT32 end_seq_num;    // bytes 8 to 11
} RetransmissionRequestMessage;

// ---- Retransmission Response Message: 12 bytes -------------------------------

// Server response to a Retransmission Request indicating whether the range can be resent.
entrypoint typedef struct _RetransmissionResponseMessage {
  UINT16 channel_id;     // bytes 0 to 1
  UINT8 retrans_status;  // byte 2
  UINT8 filler_1;        // byte 3
  UINT32 begin_seq_num;  // bytes 4 to 7
  UINT32 end_seq_num;    // bytes 8 to 11
} RetransmissionResponseMessage;

// ---- Trading Session Status Message: 28 bytes --------------------------------

// The Trading Session Status provides information on the status of a market segment. It is sent whenever there is change of trading session. This message may be sent on a separate multicast channel from order and trade data and therefore may not be synchronized.
entrypoint typedef struct _TradingSessionStatusMessage {
  UINT8 market_code[4];            // bytes 0 to 3
  UINT8 filler_1;                  // byte 4
  UINT8 trading_session_sub_id;    // byte 5
  UINT8 trading_ses_status;        // byte 6
  UINT8 trading_ses_control_flag;  // byte 7
  UINT8 filler_4[4];               // bytes 8 to 11
  UINT64 start_date_time;          // bytes 12 to 19
  UINT64 end_date_time;            // bytes 20 to 27
} TradingSessionStatusMessage;

// ---- Security Status Message: 8 bytes ----------------------------------------

// The Security Status message is generated at the start of the business day if the security is not available for trading, and whenever a security state changes.
entrypoint typedef struct _SecurityStatusMessage {
  UINT32 security_code;        // bytes 0 to 3
  UINT8 suspension_indicator;  // byte 4
  UINT8 filler_3[3];           // bytes 5 to 7
} SecurityStatusMessage;

// ---- Trade Message: 28 bytes -------------------------------------------------

// The Trade message is generated each time a trade has been performed.
entrypoint typedef struct _TradeMessage {
  UINT32 security_code;  // bytes 0 to 3
  UINT32 trade_id;       // bytes 4 to 7
  UINT32 price;          // bytes 8 to 11, signed, read here as unsigned
  UINT32 quantity;       // bytes 12 to 15
  UINT16 trd_type;       // bytes 16 to 17, signed, read here as unsigned
  UINT8 filler_2[2];     // bytes 18 to 19
  UINT64 trade_time;     // bytes 20 to 27
} TradeMessage;

// ---- Trade Cancel Message: 8 bytes -------------------------------------------

// The Trade Cancel message is generated when a trade has been cancelled.
entrypoint typedef struct _TradeCancelMessage {
  UINT32 security_code;  // bytes 0 to 3
  UINT32 trade_id;       // bytes 4 to 7
} TradeCancelMessage;

// ---- Vcm Trigger Message: 32 bytes -------------------------------------------

// The VCM Trigger message is generated whenever a cooling off period is triggered by Volatility Control Mechanism (VCM).
entrypoint typedef struct _VcmTriggerMessage {
  UINT32 security_code;           // bytes 0 to 3
  UINT64 cooling_off_start_time;  // bytes 4 to 11
  UINT64 cooling_off_end_time;    // bytes 12 to 19
  UINT32 vcm_reference_price;     // bytes 20 to 23, signed, read here as unsigned
  UINT32 vcm_lower_price;         // bytes 24 to 27, signed, read here as unsigned
  UINT32 vcm_upper_price;         // bytes 28 to 31, signed, read here as unsigned
} VcmTriggerMessage;

