// Time In Force: one byte code
#define TIME_IN_FORCE_IOC 0x49  // Ioc

// Mass Cancel Scope: one byte code
#define MASS_CANCEL_SCOPE_MASS_CANCEL_ALL_OPEN_SIMPLE_BINARY_ORDERS_AR_AND_STANDARD_BINARY_DAY_AND__azcagr 0x41  // Mass Cancel All Open Simple Binary Orders Ar And Standard Binary Day And Block All Subsequent Simple And Complex Binary Orders
#define MASS_CANCEL_SCOPE_MASS_CANCEL_ALL_OPEN_SIMPLE_BINARY_ORDERS 0x44                                         // Mass Cancel All Open Simple Binary Orders

// Trigger Reason: one byte code
#define TRIGGER_REASON_LINE_DISCONNECT_TRIGGERED_PROTECTION 0x4C               // Line Disconnect Triggered Protection
#define TRIGGER_REASON_SAPPHIRE_HELP_DESK_TRIGGERED_PROTECTION 0x42            // Sapphire Help Desk Triggered Protection
#define TRIGGER_REASON_FIRM_INITIATED_MASS_CANCEL 0x55                         // Firm Initiated Mass Cancel
#define TRIGGER_REASON_ARM_TRIGGERED_PROTECTION 0x52                           // Arm Triggered Protection
#define TRIGGER_REASON_ARM_2_FIRM_LEVEL_PROTECTION_INITIATED_MASS_CANCEL 0x46  // Arm 2 Firm Level Protection Initiated Mass Cancel
#define TRIGGER_REASON_UNDEFINED_REASON 0x4A                                   // Undefined Reason
#define TRIGGER_REASON_DOWNGRADED_FROM_OLDER_VERSION 0x2A                      // Downgraded From Older Version

// Login Status: one byte code
#define LOGIN_STATUS_LOGIN_SUCCESSFUL 0x20                                   // Login Successful
#define LOGIN_STATUS_REJECTED 0x58                                           // Rejected
#define LOGIN_STATUS_REQUESTED_SESSION_IS_NOT_AVAILABLE 0x53                 // Requested Session Is Not Available
#define LOGIN_STATUS_INVALID_START_SEQUENCE_NUMBER_REQUESTED 0x4E            // Invalid Start Sequence Number Requested
#define LOGIN_STATUS_INCOMPATIBLE_SESSION_PROTOCOL_VERSION 0x49              // Incompatible Session Protocol Version
#define LOGIN_STATUS_INCOMPATIBLE_APPLICATION_PROTOCOL_VERSION 0x41          // Incompatible Application Protocol Version
#define LOGIN_STATUS_REQUEST_REJECTED_BECAUSE_CLIENT_ALREADY_LOGGED_IN 0x4C  // Request Rejected Because Client Already Logged In

// Logout Reason: one byte code
#define LOGOUT_REASON_GRACEFUL_LOGOUT 0x20                     // Graceful Logout
#define LOGOUT_REASON_BAD_SESM_PACKET 0x42                     // Bad Sesm Packet
#define LOGOUT_REASON_TIMED_OUT_WAITING_FOR_LOGIN_PACKET 0x4C  // Timed Out Waiting For Login Packet
#define LOGOUT_REASON_APPLICATION_TERMINATING_CONNECTION 0x41  // Application Terminating Connection

// Goodbye Reason: one byte code
#define GOODBYE_REASON_BAD_SESM_PACKET 0x42                     // Bad Sesm Packet
#define GOODBYE_REASON_TIMED_OUT_WAITING_FOR_LOGIN_PACKET 0x4C  // Timed Out Waiting For Login Packet
#define GOODBYE_REASON_APPLICATION_TERMINATING_CONNECTION 0x41  // Application Terminating Connection

// ---- Types -------------------------------------------------------------------

// This is the message format that will be used to disseminate all Option series traded on Sapphire for the current session on the cloud associated for this connection
typedef struct _SeriesUpdate {
  UINT64 product_add_update_time;                  // bytes 0 to 7
  UINT32 product_id;                               // bytes 8 to 11
  UINT8 underlying_symbol[11];                     // bytes 12 to 22
  UINT8 security_symbol[6];                        // bytes 23 to 28
  UINT8 expiration_date[8];                        // bytes 29 to 36
  UINT32 strike_price;                             // bytes 37 to 40
  UINT8 call_or_put;                               // byte 41
  UINT8 opening_time[8];                           // bytes 42 to 49
  UINT8 closing_time[8];                           // bytes 50 to 57
  UINT8 restricted_option;                         // byte 58
  UINT8 long_term_option;                          // byte 59
  UINT8 active_on_sapphire;                        // byte 60
  UINT8 sapphire_bbo_posting_increment_indicator;  // byte 61
  UINT8 order_acceptance_increment_indicator;      // byte 62
  UINT8 opening_underlying_market_code;            // byte 63
  UINT8 reserved_12[12];                           // bytes 64 to 75
} SeriesUpdate;

// This message indicates if the complex binary order is accepted or rejected. Note that this message does not report executions
typedef struct _ComplexBinaryOrderResponse {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT64 order_id;           // bytes 8 to 15
  UINT8 status;              // byte 16
  UINT8 reserved_16[16];     // bytes 17 to 32
} ComplexBinaryOrderResponse;

// This message format is used to notify the firms of the state changes of the system. This is an exchange-wide notification and not a symbol or member-based notification
typedef struct _SystemStateNotification {
  UINT64 notification_time;  // bytes 0 to 7
  UINT8 meo_version[8];      // bytes 8 to 15
  UINT8 session_id;          // byte 16
  UINT8 system_status;       // byte 17
} SystemStateNotification;

// This message format will be used to notify the firms of changes to the trading status of all the options of an underlying
typedef struct _UnderlyingTradingStatusNotification {
  UINT64 notification_time;     // bytes 0 to 7
  UINT8 underlying_symbol[11];  // bytes 8 to 18
  UINT8 trading_status;         // byte 19
  UINT8 event_reason;           // byte 20
  UINT64 expected_event_time;   // bytes 21 to 28
} UnderlyingTradingStatusNotification;

// This message format will be used to notify the firms if and when Sapphire grants relief from valid opening width parameters for Opening as specified by regulatory circulars of Sapphire
typedef struct _OpeningWidthReliefNotification {
  UINT64 notification_time;     // bytes 0 to 7
  UINT8 underlying_symbol[11];  // bytes 8 to 18
  UINT32 relief_multiplier;     // bytes 19 to 22
} OpeningWidthReliefNotification;

// This message format will be used to notify firms of their ARM settings
typedef struct _ArmProtectionSettingsNotification {
  UINT64 notification_time;                // bytes 0 to 7
  UINT8 mpid[4];                           // bytes 8 to 11
  UINT8 underlying_symbol[11];             // bytes 12 to 22
  UINT32 allowable_engagement_percentage;  // bytes 23 to 26
  UINT16 counting_period;                  // bytes 27 to 28
  UINT8 action;                            // byte 29
  UINT8 source;                            // byte 30
} ArmProtectionSettingsNotification;

// This message format will be used to notify firms of their ARM2 Underlying Level protection settings
typedef struct _Arm2UnderlyingLevelProtectionSettingsNotification {
  UINT64 notification_time;      // bytes 0 to 7
  UINT8 mpid[4];                 // bytes 8 to 11
  UINT8 action;                  // byte 12
  UINT8 underlying_symbol[11];   // bytes 13 to 23
  UINT32 arm_threshold_count;    // bytes 24 to 27
  UINT32 arm_2_counting_period;  // bytes 28 to 31
  UINT8 reserved_16[16];         // bytes 32 to 47
} Arm2UnderlyingLevelProtectionSettingsNotification;

// This message format will be used to notify firms when a Single Side Liquidity Protection is triggered for an Option or Strategy
typedef struct _SingleSideLiquidityProtectionTriggerNotification {
  UINT64 notification_time;             // bytes 0 to 7
  UINT8 mpid[4];                        // bytes 8 to 11
  UINT8 security_id_scope;              // byte 12
  UINT32 security_id;                   // bytes 13 to 16
  UINT8 side;                           // byte 17
  UINT32 triggering_client_message_id;  // bytes 18 to 21
  UINT8 triggering_bulk_order_index;    // byte 22
  UINT8 reserved_4[4];                  // bytes 23 to 26
} SingleSideLiquidityProtectionTriggerNotification;

// This message format will be used to notify firms about ARM2 Underlying Level protection events
typedef struct _Arm2UnderlyingLevelProtectionNotification {
  UINT64 notification_time;      // bytes 0 to 7
  UINT8 mpid[4];                 // bytes 8 to 11
  UINT8 underlying_symbol[11];   // bytes 12 to 22
  UINT8 notification_type;       // byte 23
  UINT32 arm_threshold_count;    // bytes 24 to 27
  UINT32 arm_2_counting_period;  // bytes 28 to 31
  UINT8 reserved_16[16];         // bytes 32 to 47
} Arm2UnderlyingLevelProtectionNotification;

// This message format will be used to notify firms about ARM2 Firm Level protection events
typedef struct _Arm2FirmLevelProtectionNotification {
  UINT64 notification_time;      // bytes 0 to 7
  UINT32 arm_threshold_count;    // bytes 8 to 11
  UINT32 arm_2_counting_period;  // bytes 12 to 15
  UINT8 notification_type;       // byte 16
  UINT8 reserved_16[16];         // bytes 17 to 32
} Arm2FirmLevelProtectionNotification;

// This is the message format that will be used to notify firms about Simple or Complex order cancels. By default this is not a sequenced message; firms can request it to be configured as a sequenced message
typedef struct _CancelNotification {
  UINT64 notification_time;       // bytes 0 to 7
  UINT8 mpid[4];                  // bytes 8 to 11
  UINT8 security_id_scope;        // byte 12
  UINT32 security_id;             // bytes 13 to 16
  UINT32 client_message_id;       // bytes 17 to 20
  UINT32 client_order_id;         // bytes 21 to 24
  UINT8 bulk_order_index;         // byte 25
  UINT8 side;                     // byte 26
  UINT32 size;                    // bytes 27 to 30
  UINT64 engine_sequence_number;  // bytes 31 to 38
  UINT8 cancel_reason;            // byte 39
  UINT8 reserved_8[8];            // bytes 40 to 47
} CancelNotification;

// This message format will be used to notify the firms of executions of their orders
typedef struct _ExecutionNotification {
  UINT64 notification_time;   // bytes 0 to 7
  UINT8 mpid[4];              // bytes 8 to 11
  UINT8 liquidity_type;       // byte 12
  UINT32 product_id;          // bytes 13 to 16
  UINT32 client_message_id;   // bytes 17 to 20
  UINT32 client_order_id;     // bytes 21 to 24
  UINT8 bulk_order_index;     // byte 25
  UINT32 trade_id;            // bytes 26 to 29
  UINT64 execution_id;        // bytes 30 to 37
  UINT8 trade_status;         // byte 38
  UINT32 last_price;          // bytes 39 to 42
  UINT8 side;                 // byte 43
  UINT32 last_size;           // bytes 44 to 47
  UINT8 liquidity_indicator;  // byte 48
  UINT8 reserved_15[15];      // bytes 49 to 63
} ExecutionNotification;

// 2 to 13 legs
typedef struct _Legs {
  UINT32 product_id;     // bytes 0 to 3
  UINT32 leg_ratio_qty;  // bytes 4 to 7
  UINT8 leg_side;        // byte 8
  UINT8 reserved_8[8];   // bytes 9 to 16
} Legs;

// This is the message format that will be used to disseminate stock option strategies traded on Sapphire for the current session
typedef struct _ComplexStrategyDefinitionNotification {
  UINT64 notification_time;                                // bytes 0 to 7
  UINT32 strategy_id;                                      // bytes 8 to 11
  UINT8 underlying_symbol[11];                             // bytes 12 to 22
  UINT8 active_on_sapphire;                                // byte 23
  UINT8 reserved_1;                                        // byte 24
  UINT8 update_reason;                                     // byte 25
  UINT8 reserved_10[10];                                   // bytes 26 to 35
  UINT8 number_of_legs;                                    // byte 36
  Legs legs[:byte-size (((UINT32) number_of_legs) * 17)];
} ComplexStrategyDefinitionNotification;

// This message format will be used to notify the firm of a stock leg execution from a stock-tied complex binary order
typedef struct _StockLegExecutionNotification {
  UINT64 notification_time;          // bytes 0 to 7
  UINT8 mpid[4];                     // bytes 8 to 11
  UINT8 underlying_symbol[11];       // bytes 12 to 22
  UINT8 liquidity_type;              // byte 23
  UINT32 client_message_id;          // bytes 24 to 27
  UINT32 trade_id;                   // bytes 28 to 31
  UINT64 execution_id;               // bytes 32 to 39
  UINT8 trade_status;                // byte 40
  UINT32 last_price;                 // bytes 41 to 44
  UINT8 side;                        // byte 45
  UINT8 stock_sell_short_indicator;  // byte 46
  UINT32 last_size;                  // bytes 47 to 50
  UINT8 reserved_16[16];             // bytes 51 to 66
} StockLegExecutionNotification;

// Branch
casetype _SequencedMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x5355: SeriesUpdate series_update;
    case 0x4352: ComplexBinaryOrderResponse complex_binary_order_response;
    case 0x534E: SystemStateNotification system_state_notification;
    case 0x554E: UnderlyingTradingStatusNotification underlying_trading_status_notification;
    case 0x514E: OpeningWidthReliefNotification opening_width_relief_notification;
    case 0x414E: ArmProtectionSettingsNotification arm_protection_settings_notification;
    case 0x4132: Arm2UnderlyingLevelProtectionSettingsNotification arm_2_underlying_level_protection_settings_notification;
    case 0x5158: SingleSideLiquidityProtectionTriggerNotification single_side_liquidity_protection_trigger_notification;
    case 0x5550: Arm2UnderlyingLevelProtectionNotification arm_2_underlying_level_protection_notification;
    case 0x4650: Arm2FirmLevelProtectionNotification arm_2_firm_level_protection_notification;
    case 0x584E: CancelNotification cancel_notification;
    case 0x454E: ExecutionNotification execution_notification;
    case 0x5343: ComplexStrategyDefinitionNotification complex_strategy_definition_notification;
    case 0x4353: StockLegExecutionNotification stock_leg_execution_notification;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Server application can choose to use Sequenced data packets to send all messages that must be recoverable by the client in case of a connection loss
typedef struct _SequencedDataPacket (UINT32 available) where (available >= 10) {
  UINT64 sequence_number;                                                                                                          // bytes 0 to 7
  UINT16BE sequenced_message_type;                                                                                                 // bytes 8 to 9
  SequencedMessage(sequenced_message_type, (available - 10)) sequenced_message[:byte-size-single-element-array (available - 10)];
} SequencedDataPacket;

// Firms can use this message format to set up their ARM protection settings for each session. Changes to these settings can be made throughout the day
typedef struct _ArmSettingsUpdateRequest {
  UINT32 client_message_id;                // bytes 0 to 3
  UINT8 mpid[4];                           // bytes 4 to 7
  UINT8 action;                            // byte 8
  UINT8 underlying_symbol[11];             // bytes 9 to 19
  UINT32 allowable_engagement_percentage;  // bytes 20 to 23
  UINT16 counting_period;                  // bytes 24 to 25
} ArmSettingsUpdateRequest;

// Sapphire uses this format to respond to the firm with a status of their ARM protection settings request
typedef struct _ArmSettingsUpdateResponse {
  UINT32 client_message_id;          // bytes 0 to 3
  UINT8 mpid[4];                     // bytes 4 to 7
  UINT8 underlying_symbol[11];       // bytes 8 to 18
  UINT8 arm_settings_update_status;  // byte 19
} ArmSettingsUpdateResponse;

// Firms can use this message format to set up their ARM2 Underlying Level protection settings for each session. Changes to these settings can be made throughout the day
typedef struct _Arm2UnderlyingLevelProtectionSettingsUpdateRequest {
  UINT32 client_message_id;      // bytes 0 to 3
  UINT8 mpid[4];                 // bytes 4 to 7
  UINT8 action;                  // byte 8
  UINT8 underlying_symbol[11];   // bytes 9 to 19
  UINT32 arm_threshold_count;    // bytes 20 to 23
  UINT32 arm_2_counting_period;  // bytes 24 to 27
} Arm2UnderlyingLevelProtectionSettingsUpdateRequest;

// Sapphire uses this format to respond to the firm with a status of their ARM2 Underlying level protection Settings Update Request
typedef struct _Arm2UnderlyingLevelProtectionSettingsUpdateResponse {
  UINT32 client_message_id;            // bytes 0 to 3
  UINT8 mpid[4];                       // bytes 4 to 7
  UINT8 underlying_symbol[11];         // bytes 8 to 18
  UINT8 arm_2_settings_update_status;  // byte 19
} Arm2UnderlyingLevelProtectionSettingsUpdateResponse;

// Market Making firms can use this message format to communicate to Sapphire which of their MM MPIDs is assigned or unassigned in a product
typedef struct _SeriesAssignmentRequest {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT32 product_id;         // bytes 8 to 11
  UINT8 action;              // byte 12
} SeriesAssignmentRequest;

// Sapphire uses this format to respond to the firm assignment request
typedef struct _SeriesAssignmentResponse {
  UINT32 client_message_id;          // bytes 0 to 3
  UINT8 mpid[4];                     // bytes 4 to 7
  UINT8 assignment_settings_status;  // byte 8
} SeriesAssignmentResponse;

// 1 to 25 single-side Order, cancel or replace
typedef struct _LiquidityUnits {
  UINT8 liquidity_unit[40];  // bytes 0 to 39
} LiquidityUnits;

// Firms can use this message format to send up to 25 orders, cancels or cancel replaces. The orders are processed in the sequence according to their position in the message
typedef struct _SimpleBulkLiquidityMessage {
  UINT32 client_message_id;                                       // bytes 0 to 3
  UINT64 client_send_time;                                        // bytes 4 to 11
  UINT8 liquidity_unit_count;                                     // byte 12
  UINT8 reserved_4[4];                                            // bytes 13 to 16
  UINT8 liquidity_units[(((UINT32) liquidity_unit_count) * 40)];
} SimpleBulkLiquidityMessage;

// 1 to N single-side order responses
typedef struct _OrderResponse {
  UINT8 order_status;              // byte 0
  UINT64 engine_sequence_number;   // bytes 1 to 8
  UINT64 engine_transaction_time;  // bytes 9 to 16
  UINT32 open_size;                // bytes 17 to 20
} OrderResponse;

// This message format will be used to inform the firm of the status of Orders sent in the Bulk Liquidity Message request
typedef struct _SimpleBulkLiquidityMessageResponse {
  UINT32 client_message_id;                                                        // bytes 0 to 3
  UINT8 bulk_order_status;                                                         // byte 4
  UINT8 order_count;                                                               // byte 5
  UINT8 invalid_order_count;                                                       // byte 6
  UINT64 order_ack_time;                                                           // bytes 7 to 14
  OrderResponse order_response[:byte-size (((UINT32) invalid_order_count) * 21)];
} SimpleBulkLiquidityMessageResponse;

// This is the format for a Complex Binary Order message that can be sent to match with a resting Complex orders on the complex book
typedef struct _ComplexBinaryOrderRequest {
  UINT32 client_message_id;          // bytes 0 to 3
  UINT8 mpid[4];                     // bytes 4 to 7
  UINT64 client_send_time;           // bytes 8 to 15
  UINT32 strategy_id;                // bytes 16 to 19
  UINT8 time_in_force;               // byte 20
  UINT64 net_price;                  // bytes 21 to 28, signed, read here as unsigned
  UINT32 size;                       // bytes 29 to 32
  UINT8 side;                        // byte 33
  UINT8 stock_sell_short_indicator;  // byte 34
  UINT8 reserved_16[16];             // bytes 35 to 50
} ComplexBinaryOrderRequest;

// Firms can use this message format to request the cancelation of all Simple orders for an MPID for all series for an underlying
typedef struct _LiquidityMassCancelRequest {
  UINT32 client_message_id;     // bytes 0 to 3
  UINT8 mpid[4];                // bytes 4 to 7
  UINT64 client_send_time;      // bytes 8 to 15
  UINT8 underlying_symbol[11];  // bytes 16 to 26
  UINT8 mass_cancel_scope;      // byte 27
  UINT8 reserved_7[7];          // bytes 28 to 34
} LiquidityMassCancelRequest;

// This message format will be used to inform the firm about the status of their previous Mass Cancel request
typedef struct _LiquidityMassCancelResponse {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT8 status;              // byte 8
} LiquidityMassCancelResponse;

// Following an order protection being engaged for a given MPID and underlying, firms must use this message format to reset their Order Protection in order to start sending orders for any option or a complex strategy of the specified underlying
typedef struct _LiquidityProtectionResetRequest {
  UINT32 client_message_id;     // bytes 0 to 3
  UINT8 mpid[4];                // bytes 4 to 7
  UINT8 underlying_symbol[11];  // bytes 8 to 18
} LiquidityProtectionResetRequest;

// This message format is used to inform the firms of the status of their Order Protection Reset Request
typedef struct _LiquidityProtectionResetResponse {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT8 status;              // byte 8
} LiquidityProtectionResetResponse;

// Request to reset Single Side Liquidity Protection for the specific Option or Complex Strategy
typedef struct _SingleSideLiquidityProtectionResetRequest {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT8 security_id_scope;   // byte 8
  UINT32 security_id;        // bytes 9 to 12
  UINT8 side;                // byte 13
  UINT8 reserved_4[4];       // bytes 14 to 17
} SingleSideLiquidityProtectionResetRequest;

// Response to Single Side Liquidity Protection Reset Request
typedef struct _SingleSideLiquidityProtectionResetResponse {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT8 reserved_4[4];       // bytes 8 to 11
  UINT8 status;              // byte 12
} SingleSideLiquidityProtectionResetResponse;

// This message format will be used to notify firms when order protection is triggered for an MPID
typedef struct _LiquidityProtectionTriggerNotification {
  UINT64 notification_time;     // bytes 0 to 7
  UINT8 mpid[4];                // bytes 8 to 11
  UINT8 underlying_symbol[11];  // bytes 12 to 22
  UINT8 trigger_reason;         // byte 23
} LiquidityProtectionTriggerNotification;

// Branch
casetype _UnsequencedMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x4153: ArmSettingsUpdateRequest arm_settings_update_request;
    case 0x4141: ArmSettingsUpdateResponse arm_settings_update_response;
    case 0x3253: Arm2UnderlyingLevelProtectionSettingsUpdateRequest arm_2_underlying_level_protection_settings_update_request;
    case 0x3252: Arm2UnderlyingLevelProtectionSettingsUpdateResponse arm_2_underlying_level_protection_settings_update_response;
    case 0x5341: SeriesAssignmentRequest series_assignment_request;
    case 0x4152: SeriesAssignmentResponse series_assignment_response;
    case 0x6C6D: SimpleBulkLiquidityMessage simple_bulk_liquidity_message;
    case 0x4C52: SimpleBulkLiquidityMessageResponse simple_bulk_liquidity_message_response;
    case 0x434F: ComplexBinaryOrderRequest complex_binary_order_request;
    case 0x7871: LiquidityMassCancelRequest liquidity_mass_cancel_request;
    case 0x5852: LiquidityMassCancelResponse liquidity_mass_cancel_response;
    case 0x5058: LiquidityProtectionResetRequest liquidity_protection_reset_request;
    case 0x5052: LiquidityProtectionResetResponse liquidity_protection_reset_response;
    case 0x5353: SingleSideLiquidityProtectionResetRequest single_side_liquidity_protection_reset_request;
    case 0x5354: SingleSideLiquidityProtectionResetResponse single_side_liquidity_protection_reset_response;
    case 0x5150: LiquidityProtectionTriggerNotification liquidity_protection_trigger_notification;
    case 0x584E: CancelNotification cancel_notification;
    default: UINT8 unknown[available];
  }
} UnsequencedMessage;

// Each unsequenced data packet carries one unsequenced message from the higher-level protocol
typedef struct _UnsequencedDataPacket (UINT32 available) where (available >= 2) {
  UINT16BE unsequenced_message_type;                                                                                                   // bytes 0 to 1
  UnsequencedMessage(unsequenced_message_type, (available - 2)) unsequenced_message[:byte-size-single-element-array (available - 2)];
} UnsequencedDataPacket;

// The SesM client uses this packet to allow the server to authenticate the client and to convey to the server the last sequenced packet that the client received
typedef struct _LoginRequest {
  UINT8 sesm_version[5];             // bytes 0 to 4
  UINT8 username[5];                 // bytes 5 to 9
  UINT8 computer_id[8];              // bytes 10 to 17
  UINT8 application_protocol[8];     // bytes 18 to 25
  UINT8 requested_session;           // byte 26
  UINT64 requested_sequence_number;  // bytes 27 to 34
} LoginRequest;

// The SesM server sends a Login response packet in response to a Login request packet from the client
typedef struct _LoginResponse {
  UINT8 login_status;              // byte 0
  UINT8 session_id;                // byte 1
  UINT64 highest_sequence_number;  // bytes 2 to 9
} LoginResponse;

// The SesM client uses this packet to request the server to retransmit a range of packets
typedef struct _RetransmissionRequest {
  UINT64 start_sequence_number;  // bytes 0 to 7
  UINT64 end_sequence_number;    // bytes 8 to 15
} RetransmissionRequest;

// The client may send a Logout request packet to request the connection be terminated
typedef struct _LogoutRequest (UINT16 sesm_packet_length) where (sesm_packet_length >= 2) {
  UINT8 logout_reason;                                     // byte 0
  UINT8 logout_text[(((UINT32) sesm_packet_length) - 2)];
} LogoutRequest;

// The server may send a GoodBye packet to inform the client a reason for termination of the connection just before it terminates the connection
typedef struct _GoodbyePacket (UINT16 sesm_packet_length) where (sesm_packet_length >= 2) {
  UINT8 goodbye_reason;                                    // byte 0
  UINT8 logout_text[(((UINT32) sesm_packet_length) - 2)];
} GoodbyePacket;

// A Test packet can be sent by either side of a SesM connection at anytime; Test packets are intended to provide human readable text that may aid in debugging problems
typedef struct _TestPacket (UINT16 sesm_packet_length) where (sesm_packet_length >= 1) {
  UINT8 test_text[(((UINT32) sesm_packet_length) - 1)];
} TestPacket;

// Branch
casetype _SesmPayload (UINT8 selector, UINT32 length, UINT32 length_2, UINT16 sesm_packet_length, UINT32 available) {
  switch (selector) {
    case 0x53: SequencedDataPacket(length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x55: UnsequencedDataPacket(length_2) unsequenced_data_packet[:byte-size-single-element-array length_2];
    case 0x4C: LoginRequest login_request;
    case 0x52: LoginResponse login_response;
    case 0x43: unit synchronization_complete;
    case 0x41: RetransmissionRequest retransmission_request;
    case 0x58: LogoutRequest(sesm_packet_length) logout_request;
    case 0x47: GoodbyePacket(sesm_packet_length) goodbye_packet;
    case 0x45: unit end_of_session;
    case 0x30: unit server_heartbeat;
    case 0x31: unit client_heartbeat;
    case 0x54: TestPacket(sesm_packet_length) test_packet;
    default: UINT8 unknown[available];
  }
} SesmPayload;

// SesM Tcp Packet
typedef struct _SesmTcpPacket {
  UINT16 sesm_packet_length { sesm_packet_length >= 1 };                                                                                                                                                                                                           // bytes 0 to 1
  UINT8 sesm_packet_type;                                                                                                                                                                                                                                          // byte 2
  SesmPayload(sesm_packet_type, (((UINT32) sesm_packet_length) - 1), (((UINT32) sesm_packet_length) - 1), sesm_packet_length, ((((UINT32) sesm_packet_length) + 2) - 3)) sesm_payload[:byte-size-single-element-array ((((UINT32) sesm_packet_length) + 2) - 3)];
} SesmTcpPacket;

// ---- Packet: Packet ----------------------------------------------------------

// SesM Packet
entrypoint typedef struct _Packet (UINT32 available) {
  SesmTcpPacket sesm_tcp_packet[:byte-size available];
} Packet;

