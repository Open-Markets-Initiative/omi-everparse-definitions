// This is the message format that will be used, in the refresh service and during trading hours, to disseminate both sides of the Sapphire Top of Market for options with low premiums and small aggregate Sapphire Best Bid or Offer (SBBO) size.
typedef struct _SimpleDoubleSidedTopOfMarketBestBidOrOfferCompactFormatMessage {
  UINT32 nanoseconds;                         // bytes 0 to 3
  UINT32 product_id;                          // bytes 4 to 7
  UINT16 bid_price_short;                     // bytes 8 to 9
  UINT16 bid_size_short;                      // bytes 10 to 11
  UINT16 bid_priority_customer_size_short;    // bytes 12 to 13
  UINT8 bid_condition;                        // byte 14
  UINT16 offer_price_short;                   // bytes 15 to 16
  UINT16 offer_size_short;                    // bytes 17 to 18
  UINT16 offer_priority_customer_size_short;  // bytes 19 to 20
  UINT8 offer_condition;                      // byte 21
} SimpleDoubleSidedTopOfMarketBestBidOrOfferCompactFormatMessage;

// This is the message format that will be used, in the refresh service and during trading hours, to disseminate both sides of the Sapphire Top of Market for options with high premiums or large aggregate Sapphire Best Bid or Offer (SBBO) sizes.
typedef struct _SimpleDoubleSidedTopOfMarketBestBidOrOfferWideFormatMessage {
  UINT32 nanoseconds;                        // bytes 0 to 3
  UINT32 product_id;                         // bytes 4 to 7
  UINT32 bid_price_long;                     // bytes 8 to 11
  UINT32 bid_size_long;                      // bytes 12 to 15
  UINT32 bid_priority_customer_size_long;    // bytes 16 to 19
  UINT8 bid_condition;                       // byte 20
  UINT32 offer_price_long;                   // bytes 21 to 24
  UINT32 offer_size_long;                    // bytes 25 to 28
  UINT32 offer_priority_customer_size_long;  // bytes 29 to 32
  UINT8 offer_condition;                     // byte 33
} SimpleDoubleSidedTopOfMarketBestBidOrOfferWideFormatMessage;

// This is the message format that will be used to disseminate Trades that are resulting from executions on Sapphire during the current trading session.
typedef struct _LastSaleMessage {
  UINT32 nanoseconds;                 // bytes 0 to 3
  UINT32 product_id;                  // bytes 4 to 7
  UINT32 trade_id;                    // bytes 8 to 11
  UINT8 correction_number;            // byte 12
  UINT32 reference_trade_id;          // bytes 13 to 16
  UINT8 reference_correction_number;  // byte 17
  UINT32 trade_price;                 // bytes 18 to 21
  UINT32 trade_size;                  // bytes 22 to 25
  UINT8 trade_condition;              // byte 26
} LastSaleMessage;

// This is the message format that will be used to disseminate canceled Trades that are resulting from Trade cancellations or corrections on Sapphire during the current trading session.
typedef struct _TradeCancelMessage {
  UINT32 nanoseconds;       // bytes 0 to 3
  UINT32 product_id;        // bytes 4 to 7
  UINT32 trade_id;          // bytes 8 to 11
  UINT8 correction_number;  // byte 12
  UINT32 trade_price;       // bytes 13 to 16
  UINT32 trade_size;        // bytes 17 to 20
  UINT8 trade_condition;    // byte 21
} TradeCancelMessage;

// This message format will be used to notify firms of changes to the trading status of all the options of an underlying.
typedef struct _UnderlyingTradingStatusNotificationMessage {
  UINT32 nanoseconds;                            // bytes 0 to 3
  UINT8 underlying_symbol[11];                   // bytes 4 to 14
  UINT8 trading_status;                          // byte 15
  UINT8 event_reason;                            // byte 16
  UINT32 expected_event_time_seconds_part;       // bytes 17 to 20
  UINT32 expected_event_time_nano_seconds_part;  // bytes 21 to 24
} UnderlyingTradingStatusNotificationMessage;

// Branch
casetype _Data (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x31: SystemTimeMessage system_time_message;
    case 0x50: SeriesUpdateMessage series_update_message;
    case 0x53: SystemStateMessage system_state_message;
    case 0x42: SimpleTopOfMarketBestBidOrOfferCompactFormatBidMessage simple_top_of_market_best_bid_or_offer_compact_format_bid_message;
    case 0x68: SimpleTopOfMarketBestBidOrOfferCompactFormatBidPriorityCu_d9qcyn simple_top_of_market_best_bid_or_offer_compact_format_bid_priority_custom_o63ph4;
    case 0x4F: SimpleTopOfMarketBestBidOrOfferCompactFormatOfferMessage simple_top_of_market_best_bid_or_offer_compact_format_offer_message;
    case 0x69: SimpleTopOfMarketBestBidOrOfferCompactFormatOfferPriority_y8656s simple_top_of_market_best_bid_or_offer_compact_format_offer_priority_cust_55yt15;
    case 0x57: SimpleTopOfMarketBestBidOrOfferWideFormatBidMessage simple_top_of_market_best_bid_or_offer_wide_format_bid_message;
    case 0x6A: SimpleTopOfMarketBestBidOrOfferWideFormatBidPriorityCusto_halmqr simple_top_of_market_best_bid_or_offer_wide_format_bid_priority_customer_message;
    case 0x41: SimpleTopOfMarketBestBidOrOfferWideFormatOfferMessage simple_top_of_market_best_bid_or_offer_wide_format_offer_message;
    case 0x6B: SimpleTopOfMarketBestBidOrOfferWideFormatOfferPriorityCus_csoaog simple_top_of_market_best_bid_or_offer_wide_format_offer_priority_custome_qm6ueh;
    case 0x64: SimpleDoubleSidedTopOfMarketBestBidOrOfferCompactFormatMessage simple_double_sided_top_of_market_best_bid_or_offer_compact_format_message;
    case 0x44: SimpleDoubleSidedTopOfMarketBestBidOrOfferWideFormatMessage simple_double_sided_top_of_market_best_bid_or_offer_wide_format_message;
    case 0x54: LastSaleMessage last_sale_message;
    case 0x58: TradeCancelMessage trade_cancel_message;
    case 0x48: UnderlyingTradingStatusNotificationMessage underlying_trading_status_notification_message;
    default: UINT8 unknown[available];
  }
} Data;

typedef struct _ApplicationMessage (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                         // byte 0
  Data(message_type, (available - 1)) data[:byte-size-single-element-array (available - 1)];
} ApplicationMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 length, UINT32 available) {
  switch (selector) {
    case 0x00: unit heartbeat;
    case 0x01: unit start_of_session;
    case 0x02: unit end_of_session;
    case 0x03: ApplicationMessage(length) application_message[:byte-size-single-element-array length];
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _MachMessage {
  UINT64 sequence_number;                                                                                                                                           // bytes 0 to 7
  UINT16 packet_length { packet_length >= 12 };                                                                                                                     // bytes 8 to 9
  UINT8 packet_type;                                                                                                                                                // byte 10
  UINT8 session_number;                                                                                                                                             // byte 11
  Payload(packet_type, (((UINT32) packet_length) - 12), (((UINT32) packet_length) - 12)) payload[:byte-size-single-element-array (((UINT32) packet_length) - 12)];
} MachMessage;

// ---- Packet: UdpPacket -------------------------------------------------------

entrypoint typedef struct _UdpPacket (UINT32 available) {
  MachMessage mach_message[:byte-size available];
} UdpPacket;

