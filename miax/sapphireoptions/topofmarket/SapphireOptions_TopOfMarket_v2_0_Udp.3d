typedef struct _SimpleTopOfMarketBestBidOrOfferWideFormatOfferMessage {
  UINT32 nanoseconds;                          // bytes 0 to 3
  UINT32 product_id;                           // bytes 4 to 7
  UINT32 s_b_b_o_price_long;                   // bytes 8 to 11
  UINT32 s_b_b_o_size_long;                    // bytes 12 to 15
