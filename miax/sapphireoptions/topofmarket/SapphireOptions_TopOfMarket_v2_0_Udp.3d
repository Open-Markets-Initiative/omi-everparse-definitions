// This is the message format that will be used to disseminate Sapphire Top of Market for options with high premiums or large aggregate Sapphire Best Bid or Offer (SBBO) size. W = Simple Top of Market on Bid side.
typedef struct _SimpleTopOfMarketBestBidOrOfferWideFormatBidMessage {
  UINT32 nanoseconds;                          // bytes 0 to 3
  UINT32 product_id;                           // bytes 4 to 7
  UINT32 s_b_b_o_price_long;                   // bytes 8 to 11
  UINT32 s_b_b_o_size_long;                    // bytes 12 to 15
  UINT32 s_b_b_o_priority_customer_size_long;  // bytes 16 to 19
  UINT8 sbbo_condition;                        // byte 20
} SimpleTopOfMarketBestBidOrOfferWideFormatBidMessage;

