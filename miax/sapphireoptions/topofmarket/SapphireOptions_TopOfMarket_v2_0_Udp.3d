// ---- Types -------------------------------------------------------------------

// This is the message format that will be used to disseminate the seconds part of the timestamp that is applicable to all messages that are sent in the current second.
typedef struct _SystemTimeMessage {
  UINT32 seconds;  // bytes 0 to 3
} SystemTimeMessage;

// This is the message format that will be used to disseminate all Option series traded on Sapphire for the current session. The product ID sent in this message is what will be disseminated in Top of Market BBO and Last Sale messages.
typedef struct _SeriesUpdateMessage {
  UINT32 nanoseconds;                              // bytes 0 to 3
  UINT32 product_id;                               // bytes 4 to 7
  UINT8 underlying_symbol[11];                     // bytes 8 to 18
  UINT8 security_symbol[6];                        // bytes 19 to 24
  UINT8 expiration_date[8];                        // bytes 25 to 32
  UINT32 strike_price;                             // bytes 33 to 36
  UINT8 call_or_put;                               // byte 37
  UINT8 opening_time[8];                           // bytes 38 to 45
  UINT8 closing_time[8];                           // bytes 46 to 53
  UINT8 restricted_option;                         // byte 54
  UINT8 long_term_option;                          // byte 55
  UINT8 active_on_sapphire;                        // byte 56
  UINT8 sapphire_bbo_posting_increment_indicator;  // byte 57
  UINT8 liquidity_acceptance_increment_indicator;  // byte 58
  UINT8 opening_underlying_market_code;            // byte 59
  UINT8 reserved_12[12];                           // bytes 60 to 71
} SeriesUpdateMessage;

// This message format is used to notify the firms of the state changes of the system. This is a notification that applies to each Underlying group. Firms can use notifications as triggers in their system to ensure electronic synchronization of systems.
typedef struct _SystemStateMessage {
  UINT32 nanoseconds;     // bytes 0 to 3
  UINT8 to_m_version[8];  // bytes 4 to 11
  UINT32 session_id;      // bytes 12 to 15
  UINT8 system_status;    // byte 16
} SystemStateMessage;

// This is the message format that will be used to disseminate each side of the Sapphire Top of Market for options with low premiums and small aggregate Sapphire Best Bid or Offer (SBBO) size. B = Top of Market on Bid side.
typedef struct _SimpleTopOfMarketBestBidOrOfferCompactFormatBidMessage {
  UINT32 nanoseconds;                           // bytes 0 to 3
  UINT32 product_id;                            // bytes 4 to 7
  UINT16 s_b_b_o_price_short;                   // bytes 8 to 9
  UINT16 s_b_b_o_size_short;                    // bytes 10 to 11
  UINT16 s_b_b_o_priority_customer_size_short;  // bytes 12 to 13
  UINT8 sbbo_condition;                         // byte 14
} SimpleTopOfMarketBestBidOrOfferCompactFormatBidMessage;

// Simple Top of Market on Bid side with Priority Customer establishing new aggressive price.
typedef struct _SimpleTopOfMarketBestBidOrOfferCompactFormatBidPriorityCu_d9qcyn {
  UINT32 nanoseconds;                           // bytes 0 to 3
  UINT32 product_id;                            // bytes 4 to 7
  UINT16 s_b_b_o_price_short;                   // bytes 8 to 9
  UINT16 s_b_b_o_size_short;                    // bytes 10 to 11
  UINT16 s_b_b_o_priority_customer_size_short;  // bytes 12 to 13
  UINT8 sbbo_condition;                         // byte 14
} SimpleTopOfMarketBestBidOrOfferCompactFormatBidPriorityCu_d9qcyn;

// This is the message format that will be used to disseminate each side of the Sapphire Top of Market for options with low premiums and small aggregate Sapphire Best Bid or Offer (SBBO) size. O = Top of Market on Offer side.
typedef struct _SimpleTopOfMarketBestBidOrOfferCompactFormatOfferMessage {
  UINT32 nanoseconds;                           // bytes 0 to 3
