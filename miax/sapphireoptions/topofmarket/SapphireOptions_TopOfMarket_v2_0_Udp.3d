  UINT16 s_b_b_o_price_short;                   // bytes 8 to 9
  UINT16 s_b_b_o_size_short;                    // bytes 10 to 11
  UINT16 s_b_b_o_priority_customer_size_short;  // bytes 12 to 13
  UINT8 sbbo_condition;                         // byte 14
} SimpleTopOfMarketBestBidOrOfferCompactFormatOfferMessage;

// Simple Top of Market on Offer side with Priority Customer establishing new aggressive price.
typedef struct _SimpleTopOfMarketBestBidOrOfferCompactFormatOfferPriority_y8656s {
  UINT32 nanoseconds;                           // bytes 0 to 3
