// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out MiaxOptions_TopOfMarket_v1_3.3d

// ---- Values ------------------------------------------------------------------

// Packet Type: one byte code
#define PACKET_TYPE_HEARTBEAT 0x00            // Heartbeat
#define PACKET_TYPE_START_OF_SESSION 0x01     // Start Of Session
#define PACKET_TYPE_END_OF_SESSION 0x02       // End Of Session
#define PACKET_TYPE_APPLICATION_MESSAGE 0x03  // Application Message

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_TIME_MESSAGE 0x31                           // System Time Message
#define MESSAGE_TYPE_SERIES_UPDATE_MESSAGE 0x50                         // Series Update Message
#define MESSAGE_TYPE_SYSTEM_STATE_MESSAGE 0x53                          // System State Message
#define MESSAGE_TYPE_TOP_OF_MARKET_BID_COMPACT_MESSAGE 0x42             // Top Of Market Bid Compact Message
#define MESSAGE_TYPE_TOP_OF_MARKET_OFFER_COMPACT_MESSAGE 0x4F           // Top Of Market Offer Compact Message
#define MESSAGE_TYPE_TOP_OF_MARKET_BID_WIDE_MESSAGE 0x57                // Top Of Market Bid Wide Message
#define MESSAGE_TYPE_TOP_OF_MARKET_OFFER_WIDE_MESSAGE 0x41              // Top Of Market Offer Wide Message
#define MESSAGE_TYPE_LAST_SALE_MESSAGE 0x54                             // Last Sale Message
#define MESSAGE_TYPE_TRADE_CANCEL_MESSAGE 0x58                          // Trade Cancel Message
#define MESSAGE_TYPE_LIQUIDITY_SEEKING_EVENT_NOTIFICATION_MESSAGE 0x4C  // Liquidity Seeking Event Notification Message

// Call Or Put: one byte code
#define CALL_OR_PUT_CALL 0x43  // Call
#define CALL_OR_PUT_PUT 0x50   // Put

// Restricted Option: one byte code
#define RESTRICTED_OPTION_ACCEPT_POSITION_CLOSING 0x59  // Accept Position Closing
#define RESTRICTED_OPTION_ACCEPT_OPEN_AND_CLOSE 0x4E    // Accept Open And Close

// Long Term Option: one byte code
#define LONG_TERM_OPTION_FAR_MONTH_EXPIRATION 0x59   // Far Month Expiration
#define LONG_TERM_OPTION_NEAR_MONTH_EXPIRATION 0x4E  // Near Month Expiration

// Active On Miax: one byte code
#define ACTIVE_ON_MIAX_ACTIVE 0x41    // Active
#define ACTIVE_ON_MIAX_INACTIVE 0x49  // Inactive

// Miax Bbo Posting Increment Indicator: one byte code
#define MIAX_BBO_POSTING_INCREMENT_INDICATOR_PENNY 0x50            // Penny
#define MIAX_BBO_POSTING_INCREMENT_INDICATOR_PENNY_OR_NICKEL 0x4E  // Penny Or Nickel
#define MIAX_BBO_POSTING_INCREMENT_INDICATOR_NICKEL_OR_DIME 0x44   // Nickel Or Dime

// Liquidity Acceptance Increment Indicator: one byte code
#define LIQUIDITY_ACCEPTANCE_INCREMENT_INDICATOR_PENNY 0x50            // Penny
#define LIQUIDITY_ACCEPTANCE_INCREMENT_INDICATOR_PENNY_OR_NICKEL 0x4E  // Penny Or Nickel
#define LIQUIDITY_ACCEPTANCE_INCREMENT_INDICATOR_NICKEL_OR_DIME 0x44   // Nickel Or Dime

// Opening Underlying Market Code: one byte code
#define OPENING_UNDERLYING_MARKET_CODE_NYSE_AMEX 0x41           // Nyse Amex
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_BX 0x42       // Nasdaq Omx Bx
#define OPENING_UNDERLYING_MARKET_CODE_NSE 0x43                 // Nse
#define OPENING_UNDERLYING_MARKET_CODE_FINRA_ADF 0x44           // Finra Adf
#define OPENING_UNDERLYING_MARKET_CODE_MARKET_INDEPENDENT 0x45  // Market Independent
#define OPENING_UNDERLYING_MARKET_CODE_ISE 0x49                 // Ise
#define OPENING_UNDERLYING_MARKET_CODE_EDGA 0x4A                // Edga
#define OPENING_UNDERLYING_MARKET_CODE_EDGX 0x4B                // Edgx
#define OPENING_UNDERLYING_MARKET_CODE_CSE 0x4D                 // Cse
#define OPENING_UNDERLYING_MARKET_CODE_NYSE_EURONEXT 0x4E       // Nyse Euronext
#define OPENING_UNDERLYING_MARKET_CODE_NYSE_ARCA 0x50           // Nyse Arca
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_UTP 0x51      // Nasdaq Omx Utp
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_CTA 0x54      // Nasdaq Omx Cta
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_PHLX 0x58     // Nasdaq Omx Phlx
#define OPENING_UNDERLYING_MARKET_CODE_BATS_Y 0x59              // Bats Y
#define OPENING_UNDERLYING_MARKET_CODE_BATS 0x5A                // Bats

// System Status: one byte code
#define SYSTEM_STATUS_START_OF_SYSTEM_HOURS 0x53  // Start Of System Hours
#define SYSTEM_STATUS_END_OF_SYSTEM_HOURS 0x43    // End Of System Hours
#define SYSTEM_STATUS_START_TEST_SESSION 0x31     // Start Test Session
#define SYSTEM_STATUS_END_OF_TEST_SESSION 0x32    // End Of Test Session

// Mbbo Condition: one byte code
#define MBBO_CONDITION_REGULAR 0x41                   // Regular
#define MBBO_CONDITION_PUBLIC_CUSTOMER_INTEREST 0x42  // Public Customer Interest
#define MBBO_CONDITION_NOT_FIRM 0x43                  // Not Firm
#define MBBO_CONDITION_RESERVED 0x52                  // Reserved
#define MBBO_CONDITION_TRADING_HALT 0x54              // Trading Halt

// Trade Condition: one byte code
#define TRADE_CONDITION_REGULAR 0x20                                                                           // Regular
#define TRADE_CONDITION_CANCEL_OF_TRADE_PREVIOUSLY_REPORTED_OTHER_THAN_AS_THE_LAST_OR_OPENING 0x41             // Cancel Of Trade Previously Reported Other Than As The Last Or Opening
#define TRADE_CONDITION_LATE_AND_IS_OUT_OF_SEQUENCE 0x42                                                       // Late And Is Out Of Sequence
#define TRADE_CONDITION_CANCEL_OF_THE_LAST_REPORTED_TRADE 0x43                                                 // Cancel Of The Last Reported Trade
#define TRADE_CONDITION_LATE_AND_IS_IN_CORRECT_SEQUENCE 0x44                                                   // Late And Is In Correct Sequence
#define TRADE_CONDITION_CANCEL_OF_THE_FIRST_REPORTED_TRADE 0x45                                                // Cancel Of The First Reported Trade
#define TRADE_CONDITION_LATE_REPORT_OF_THE_OPENING_TRADE_AND_IS_OUT_OF_SEQUENCE 0x46                           // Late Report Of The Opening Trade And Is Out Of Sequence
#define TRADE_CONDITION_CANCEL_OF_THE_ONLY_REPORTED_TRADE 0x47                                                 // Cancel Of The Only Reported Trade
#define TRADE_CONDITION_LATE_REPORT_OF_THE_OPENING_TRADE_AND_IS_IN_CORRECT_SEQUENCE 0x48                       // Late Report Of The Opening Trade And Is In Correct Sequence
#define TRADE_CONDITION_RESERVED_I 0x49                                                                        // Reserved I
#define TRADE_CONDITION_REOPENING_OF_AN_OPTION 0x4A                                                            // Reopening Of An Option
#define TRADE_CONDITION_RESERVED_K 0x4B                                                                        // Reserved K
#define TRADE_CONDITION_RESERVED_L 0x4C                                                                        // Reserved L
#define TRADE_CONDITION_RESERVED_M 0x4D                                                                        // Reserved M
#define TRADE_CONDITION_RESERVED_N 0x4E                                                                        // Reserved N
#define TRADE_CONDITION_RESERVED_O 0x4F                                                                        // Reserved O
#define TRADE_CONDITION_RESERVED_P 0x50                                                                        // Reserved P
#define TRADE_CONDITION_RESERVED_Q 0x51                                                                        // Reserved Q
#define TRADE_CONDITION_EXECUTION_OF_AN_ORDER_WHICH_WAS_STOPPED_AT_A_PRICE_THAT_DID_NOT_CONSTITUT_92fcoo 0x52  // Execution Of An Order Which Was Stopped At A Price That Did Not Constitute A Trade Through On Another Market At The Time Of The Stop
#define TRADE_CONDITION_EXECUTION_OF_AN_ISO_ORDER 0x53                                                         // Execution Of An Iso Order
#define TRADE_CONDITION_RESERVED_T 0x54                                                                        // Reserved T
#define TRADE_CONDITION_TRADE_THROUGH_EXEMPT 0x58                                                              // Trade Through Exempt

// Event Type: one byte code
#define EVENT_TYPE_LIQUIDITY_REFRESH_MECHANISM 0x4C            // Liquidity Refresh Mechanism
#define EVENT_TYPE_OPENING_REOPENING_IMBALANCE_MECHANISM 0x4F  // Opening Reopening Imbalance Mechanism
#define EVENT_TYPE_ROUTE_MECHANISM 0x52                        // Route Mechanism

// Imbalance Side: one byte code
#define IMBALANCE_SIDE_BID 0x42  // Bid
#define IMBALANCE_SIDE_ASK 0x41  // Ask

// ---- Types -------------------------------------------------------------------

// This is the message format that will be used to disseminate the seconds part of the timestamp that is applicable to all messages that are sent in the current second.
typedef struct _SystemTimeMessage {
  UINT32 seconds;  // bytes 0 to 3
} SystemTimeMessage;

// This is the message format that will be used to disseminate all Option series traded on MIAX for the current session. The product ID sent in this message is what will be disseminated in Top of Market BBO and Last Sale messages.
typedef struct _SeriesUpdateMessage {
  UINT32 nanoseconds;                              // bytes 0 to 3
  UINT32 product_id;                               // bytes 4 to 7
  UINT8 underlying_symbol[11];                     // bytes 8 to 18
  UINT8 security_symbol[6];                        // bytes 19 to 24
  UINT8 expiration_date[8];                        // bytes 25 to 32
  UINT32 strike_price;                             // bytes 33 to 36
  UINT8 call_or_put;                               // byte 37
  UINT8 opening_time[8];                           // bytes 38 to 45
  UINT8 closing_time[8];                           // bytes 46 to 53
  UINT8 restricted_option;                         // byte 54
  UINT8 long_term_option;                          // byte 55
  UINT8 active_on_miax;                            // byte 56
  UINT8 miax_bbo_posting_increment_indicator;      // byte 57
  UINT8 liquidity_acceptance_increment_indicator;  // byte 58
  UINT8 opening_underlying_market_code;            // byte 59
  UINT32 priority_quote_width;                     // bytes 60 to 63
  UINT8 reserved_8[8];                             // bytes 64 to 71
} SeriesUpdateMessage;

// This message format is used to notify the firms of the state changes of the system. This is a notification that applies to each Underlying group. Firms can use notifications as triggers in their system to ensure electronic synchronization of systems.
typedef struct _SystemStateMessage {
  UINT32 nanoseconds;     // bytes 0 to 3
  UINT8 to_m_version[8];  // bytes 4 to 11
  UINT32 session_id;      // bytes 12 to 15
  UINT8 system_status;    // byte 16
} SystemStateMessage;

// This is the message format that will be used to disseminate each side of the MIAX Top of Market for options with low premiums and small aggregate MIAX Best Bid or Offer (MBBO) size.
typedef struct _TopOfMarketBidCompactMessage {
  UINT32 nanoseconds;    // bytes 0 to 3
  UINT32 product_id;     // bytes 4 to 7
  UINT16 mbbo_price_2;   // bytes 8 to 9
  UINT16 mbbo_size_2;    // bytes 10 to 11
  UINT8 reserved_2[2];   // bytes 12 to 13
  UINT8 mbbo_condition;  // byte 14
} TopOfMarketBidCompactMessage;

// This is the message format that will be used to disseminate MIAX Top of Market for options with high premiums or large aggregate MIAX Best Bid or Offer (MBBO) size.
typedef struct _TopOfMarketBidWideMessage {
  UINT32 nanoseconds;    // bytes 0 to 3
  UINT32 product_id;     // bytes 4 to 7
  UINT32 mbbo_price_4;   // bytes 8 to 11
  UINT32 mbbo_size_4;    // bytes 12 to 15
  UINT8 reserved_4[4];   // bytes 16 to 19
  UINT8 mbbo_condition;  // byte 20
} TopOfMarketBidWideMessage;

// This is the message format that will be used to disseminate Trades that are resulting from executions on MIAX during the current trading session.
typedef struct _LastSaleMessage {
  UINT32 nanoseconds;                 // bytes 0 to 3
  UINT32 product_id;                  // bytes 4 to 7
  UINT32 trade_id;                    // bytes 8 to 11
  UINT8 correction_number;            // byte 12
  UINT32 reference_trade_id;          // bytes 13 to 16
  UINT8 reference_correction_number;  // byte 17
  UINT32 trade_price;                 // bytes 18 to 21
  UINT32 trade_size;                  // bytes 22 to 25
  UINT8 trade_condition;              // byte 26
} LastSaleMessage;

// This is the message format that will be used to disseminate canceled Trades that are resulting from Trade cancellations or corrections on MIAX during the current trading session
typedef struct _TradeCancelMessage {
  UINT32 nanoseconds;       // bytes 0 to 3
  UINT32 product_id;        // bytes 4 to 7
  UINT32 trade_id;          // bytes 8 to 11
  UINT8 correction_number;  // byte 12
  UINT32 trade_price;       // bytes 13 to 16
  UINT32 trade_size;        // bytes 17 to 20
  UINT8 trade_condition;    // byte 21
} TradeCancelMessage;

// This is the message format that will be used to disseminate information each time a Liquidity seeking event (defined in Event Type field below) starts at MIAX.
typedef struct _LiquiditySeekingEventNotificationMessage {
  UINT32 nanoseconds;     // bytes 0 to 3
  UINT32 product_id;      // bytes 4 to 7
  UINT8 event_type;       // byte 8
  UINT32 event_id;        // bytes 9 to 12
  UINT32 price;           // bytes 13 to 16
  UINT8 imbalance_side;   // byte 17
  UINT32 quantity_1;      // bytes 18 to 21
  UINT32 quantity_2;      // bytes 22 to 25
  UINT32 quantity_3;      // bytes 26 to 29
  UINT32 quantity_4;      // bytes 30 to 33
  UINT8 reserved_12[12];  // bytes 34 to 45
} LiquiditySeekingEventNotificationMessage;

// Branch
casetype _Data (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x31: SystemTimeMessage system_time_message;
    case 0x50: SeriesUpdateMessage series_update_message;
    case 0x53: SystemStateMessage system_state_message;
    case 0x42: TopOfMarketBidCompactMessage top_of_market_bid_compact_message;
    case 0x4F: TopOfMarketBidCompactMessage top_of_market_offer_compact_message;
    case 0x57: TopOfMarketBidWideMessage top_of_market_bid_wide_message;
    case 0x41: TopOfMarketBidWideMessage top_of_market_offer_wide_message;
    case 0x54: LastSaleMessage last_sale_message;
    case 0x58: TradeCancelMessage trade_cancel_message;
    case 0x4C: LiquiditySeekingEventNotificationMessage liquidity_seeking_event_notification_message;
    default: UINT8 unknown[available];
  }
} Data;

typedef struct _ApplicationMessage (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                         // byte 0
  Data(message_type, (available - 1)) data[:byte-size-single-element-array (available - 1)];
} ApplicationMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 length, UINT32 available) {
  switch (selector) {
    case 0x00: unit heartbeat;
    case 0x01: unit start_of_session;
    case 0x02: unit end_of_session;
    case 0x03: ApplicationMessage(length) application_message[:byte-size-single-element-array length];
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _MachMessage {
  UINT64 sequence_number;                                                                                                                                           // bytes 0 to 7
  UINT16 packet_length { packet_length >= 12 };                                                                                                                     // bytes 8 to 9
  UINT8 packet_type;                                                                                                                                                // byte 10
  UINT8 session_number;                                                                                                                                             // byte 11
  Payload(packet_type, (((UINT32) packet_length) - 12), (((UINT32) packet_length) - 12)) payload[:byte-size-single-element-array (((UINT32) packet_length) - 12)];
} MachMessage;

// ---- Packet: Packet ----------------------------------------------------------

entrypoint typedef struct _Packet (UINT32 available) {
  MachMessage mach_message[:byte-size available];
} Packet;

