// ---- Sesm Packet Header: 3 bytes ---------------------------------------------

// SesM packet header
entrypoint typedef struct _SesmPacketHeader {
  UINT16 sesm_packet_length;  // bytes 0 to 1
  UINT8 sesm_packet_type;     // byte 2
} SesmPacketHeader;

// ---- Refresh Request Message: 1 byte -----------------------------------------

// Sent by the firm over the ToM Retransmission Interface (SesM Unsequenced Data Packet) to request a Last Value Refresh of a particular data set identified by Refresh Message Type.
entrypoint typedef struct _RefreshRequestMessage {
  UINT8 refresh_message_type;  // byte 0
} RefreshRequestMessage;

// ---- System Time Message: 4 bytes --------------------------------------------

// This is the message format that will be used to disseminate the seconds part of the timestamp that is applicable to all messages that are sent in the current second.
entrypoint typedef struct _SystemTimeMessage {
  UINT32 seconds;  // bytes 0 to 3
} SystemTimeMessage;

// ---- Simple Series Update Message: 72 bytes ----------------------------------

// This is the message format that will be used to disseminate all Option series traded on MIAX for the current session. The product ID sent in this message is what will be disseminated in Top of Market BBO and Last Sale messages.
entrypoint typedef struct _SimpleSeriesUpdateMessage {
  UINT32 nanoseconds;                              // bytes 0 to 3
  UINT32 product_id;                               // bytes 4 to 7
  UINT8 underlying_symbol[11];                     // bytes 8 to 18
  UINT8 security_symbol[6];                        // bytes 19 to 24
  UINT8 expiration_date[8];                        // bytes 25 to 32
  UINT32 strike_price;                             // bytes 33 to 36
  UINT8 call_or_put;                               // byte 37
  UINT8 opening_time[8];                           // bytes 38 to 45
  UINT8 closing_time[8];                           // bytes 46 to 53
  UINT8 restricted_option;                         // byte 54
  UINT8 long_term_option;                          // byte 55
  UINT8 active_on_miax;                            // byte 56
  UINT8 miax_bbo_posting_increment_indicator;      // byte 57
  UINT8 liquidity_acceptance_increment_indicator;  // byte 58
  UINT8 opening_underlying_market_code;            // byte 59
  UINT32 priority_quote_width;                     // bytes 60 to 63
  UINT8 reserved_8[8];                             // bytes 64 to 71
} SimpleSeriesUpdateMessage;

// ---- System State Message: 17 bytes ------------------------------------------

// This message format is used to notify the firms of the state changes of the system. This is a notification that applies to each Underlying group. Firms can use notifications as triggers in their system to ensure electronic synchronization of systems.
entrypoint typedef struct _SystemStateMessage {
  UINT32 nanoseconds;     // bytes 0 to 3
  UINT8 to_m_version[8];  // bytes 4 to 11
  UINT32 session_id;      // bytes 12 to 15
  UINT8 system_status;    // byte 16
} SystemStateMessage;

// ---- Simple Top Of Market Best Bid Or Offer Compact Bid Message: 15 bytes ----

// This is the message format that will be used to disseminate each side of the MIAX Simple Top of Market for options with low premiums and small aggregate MIAX Best Bid or Offer (MBBO) size. B = Simple Top of Market on Bid side.
entrypoint typedef struct _SimpleTopOfMarketBestBidOrOfferCompactBidMessage {
  UINT32 nanoseconds;                           // bytes 0 to 3
  UINT32 product_id;                            // bytes 4 to 7
  UINT16 m_b_b_o_price_short;                   // bytes 8 to 9
  UINT16 m_b_b_o_size_short;                    // bytes 10 to 11
  UINT16 m_b_b_o_priority_customer_size_short;  // bytes 12 to 13
  UINT8 mbbo_condition;                         // byte 14
} SimpleTopOfMarketBestBidOrOfferCompactBidMessage;

// ---- Simple Top Of Market Best Bid Or Offer Compact Offer Message: 15 bytes ----

// This is the message format that will be used to disseminate each side of the MIAX Simple Top of Market for options with low premiums and small aggregate MIAX Best Bid or Offer (MBBO) size. O = Simple Top of Market on Offer side.
entrypoint typedef struct _SimpleTopOfMarketBestBidOrOfferCompactOfferMessage {
  UINT32 nanoseconds;                           // bytes 0 to 3
  UINT32 product_id;                            // bytes 4 to 7
  UINT16 m_b_b_o_price_short;                   // bytes 8 to 9
  UINT16 m_b_b_o_size_short;                    // bytes 10 to 11
  UINT16 m_b_b_o_priority_customer_size_short;  // bytes 12 to 13
  UINT8 mbbo_condition;                         // byte 14
} SimpleTopOfMarketBestBidOrOfferCompactOfferMessage;

// ---- Simple Top Of Market Best Bid Or Offer Wide Bid Message: 21 bytes -------

// This is the message format that will be used to disseminate MIAX Simple Top of Market for options with high premiums or large aggregate MIAX Best Bid or Offer (MBBO) size. b = Simple Top of Market on Bid side (wide).
entrypoint typedef struct _SimpleTopOfMarketBestBidOrOfferWideBidMessage {
  UINT32 nanoseconds;                          // bytes 0 to 3
  UINT32 product_id;                           // bytes 4 to 7
  UINT32 m_b_b_o_price_long;                   // bytes 8 to 11
  UINT32 m_b_b_o_size_long;                    // bytes 12 to 15
  UINT32 m_b_b_o_priority_customer_size_long;  // bytes 16 to 19
  UINT8 mbbo_condition;                        // byte 20
} SimpleTopOfMarketBestBidOrOfferWideBidMessage;

// ---- Simple Top Of Market Best Bid Or Offer Wide Offer Message: 21 bytes -----

// This is the message format that will be used to disseminate MIAX Simple Top of Market for options with high premiums or large aggregate MIAX Best Bid or Offer (MBBO) size. o = Simple Top of Market on Offer side (wide).
entrypoint typedef struct _SimpleTopOfMarketBestBidOrOfferWideOfferMessage {
  UINT32 nanoseconds;                          // bytes 0 to 3
  UINT32 product_id;                           // bytes 4 to 7
  UINT32 m_b_b_o_price_long;                   // bytes 8 to 11
  UINT32 m_b_b_o_size_long;                    // bytes 12 to 15
  UINT32 m_b_b_o_priority_customer_size_long;  // bytes 16 to 19
  UINT8 mbbo_condition;                        // byte 20
} SimpleTopOfMarketBestBidOrOfferWideOfferMessage;

// ---- Simple Double Sided Top Of Market Best Bid Or Offer Compact Message: 22 bytes ----

// This is the message format that will be used in the real-time feed and refresh service to disseminate both sides of the MIAX Simple Top of Market for options with low premiums and small aggregate MIAX Best Bid or Offer (MBBO) size.
entrypoint typedef struct _SimpleDoubleSidedTopOfMarketBestBidOrOfferCompactMessage {
  UINT32 nanoseconds;                         // bytes 0 to 3
  UINT32 product_id;                          // bytes 4 to 7
  UINT16 bid_price_short;                     // bytes 8 to 9
  UINT16 bid_size_short;                      // bytes 10 to 11
  UINT16 bid_priority_customer_size_short;    // bytes 12 to 13
  UINT8 bid_condition;                        // byte 14
  UINT16 offer_price_short;                   // bytes 15 to 16
  UINT16 offer_size_short;                    // bytes 17 to 18
  UINT16 offer_priority_customer_size_short;  // bytes 19 to 20
  UINT8 offer_condition;                      // byte 21
} SimpleDoubleSidedTopOfMarketBestBidOrOfferCompactMessage;

// ---- Simple Double Sided Top Of Market Best Bid Or Offer Wide Message: 34 bytes ----

// This is the message format that will be used in the real-time feed and refresh service to disseminate both sides of the MIAX Simple Top of Market for options with high premiums or large aggregate MIAX Best Bid or Offer (MBBO) sizes.
entrypoint typedef struct _SimpleDoubleSidedTopOfMarketBestBidOrOfferWideMessage {
  UINT32 nanoseconds;                        // bytes 0 to 3
  UINT32 product_id;                         // bytes 4 to 7
  UINT32 bid_price_long;                     // bytes 8 to 11
  UINT32 bid_size_long;                      // bytes 12 to 15
  UINT32 bid_priority_customer_size_long;    // bytes 16 to 19
  UINT8 bid_condition;                       // byte 20
  UINT32 offer_price_long;                   // bytes 21 to 24
  UINT32 offer_size_long;                    // bytes 25 to 28
  UINT32 offer_priority_customer_size_long;  // bytes 29 to 32
  UINT8 offer_condition;                     // byte 33
} SimpleDoubleSidedTopOfMarketBestBidOrOfferWideMessage;

// ---- Last Sale Message: 27 bytes ---------------------------------------------

// This is the message format that will be used to disseminate Trades that are resulting from executions on MIAX during the current trading session.
entrypoint typedef struct _LastSaleMessage {
  UINT32 nanoseconds;                 // bytes 0 to 3
  UINT32 product_id;                  // bytes 4 to 7
  UINT32 trade_id;                    // bytes 8 to 11
  UINT8 correction_number;            // byte 12
  UINT32 reference_trade_id;          // bytes 13 to 16
  UINT8 reference_correction_number;  // byte 17
  UINT32 trade_price;                 // bytes 18 to 21
  UINT32 trade_size;                  // bytes 22 to 25
  UINT8 trade_condition;              // byte 26
} LastSaleMessage;

// ---- Trade Cancel Message: 22 bytes ------------------------------------------

// This is the message format that will be used to disseminate canceled Trades that are resulting from Trade cancellations or corrections on MIAX during the current trading session.
entrypoint typedef struct _TradeCancelMessage {
  UINT32 nanoseconds;       // bytes 0 to 3
  UINT32 product_id;        // bytes 4 to 7
  UINT32 trade_id;          // bytes 8 to 11
  UINT8 correction_number;  // byte 12
  UINT32 trade_price;       // bytes 13 to 16
  UINT32 trade_size;        // bytes 17 to 20
  UINT8 trade_condition;    // byte 21
} TradeCancelMessage;

// ---- Underlying Trading Status Notification Message: 25 bytes ----------------

// This message format will be used to notify firms of changes to the trading status of all the options of an underlying.
entrypoint typedef struct _UnderlyingTradingStatusNotificationMessage {
  UINT32 nanoseconds;                            // bytes 0 to 3
  UINT8 underlying_symbol[11];                   // bytes 4 to 14
  UINT8 trading_status;                          // byte 15
  UINT8 event_reason;                            // byte 16
  UINT32 expected_event_time_seconds_part;       // bytes 17 to 20
  UINT32 expected_event_time_nano_seconds_part;  // bytes 21 to 24
} UnderlyingTradingStatusNotificationMessage;

// ---- End Of Refresh Notification Message: 1 byte -----------------------------

// Sent by MIAX Options over the ToM Retransmission Interface (SesM Unsequenced Data Packet) when the refresh response is complete.
entrypoint typedef struct _EndOfRefreshNotificationMessage {
  UINT8 refresh_message_type;  // byte 0
} EndOfRefreshNotificationMessage;

// ---- Login Request: 35 bytes -------------------------------------------------

// The SesM client must send a Login request packet immediately upon establishing a new TCP/IP socket connection to the server
entrypoint typedef struct _LoginRequest {
  UINT8 sesm_version[5];               // bytes 0 to 4
  UINT8 username[5];                   // bytes 5 to 9
  UINT8 computer_id[8];                // bytes 10 to 17
  UINT8 application_protocol[8];       // bytes 18 to 25
  UINT8 requested_trading_session_id;  // byte 26
  UINT64 requested_sequence_number;    // bytes 27 to 34
} LoginRequest;

// ---- Login Response: 11 bytes ------------------------------------------------

// The SesM server sends a Login response packet in response a Login request packet from the client
entrypoint typedef struct _LoginResponse {
  UINT8 number_of_matching_engines;  // byte 0
  UINT8 login_status;                // byte 1
  UINT8 trading_session_id;          // byte 2
  UINT64 highest_sequence_number;    // bytes 3 to 10
} LoginResponse;

// ---- Synchronization Complete: 1 byte ----------------------------------------

// The SesM server sends a Login response packet in response a Login request packet from the client
entrypoint typedef struct _SynchronizationComplete {
  UINT8 number_of_matching_engines;  // byte 0
} SynchronizationComplete;

// ---- Retransmission Request: 16 bytes ----------------------------------------

// The SesM client uses this packet to request a retransmission server to retransmit a range of packets
entrypoint typedef struct _RetransmissionRequest {
  UINT64 start_sequence_number;  // bytes 0 to 7
  UINT64 end_sequence_number;    // bytes 8 to 15
} RetransmissionRequest;

