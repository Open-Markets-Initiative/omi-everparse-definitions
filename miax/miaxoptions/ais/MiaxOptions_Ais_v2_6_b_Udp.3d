  UINT32 matched_quantity;                // bytes 89 to 92
  UINT8 opening_condition;                // byte 93
  UINT32 mbb;                             // bytes 94 to 97
  UINT32 mbo;                             // bytes 98 to 101
  UINT8 reserved_8[8];                    // bytes 102 to 109
} TheoreticalSettlementReferencePriceNotificationMessage;

// ---- Theoretical Settlement Price Notification Message: 32 bytes -------------

// This message format will be used to notify firms of the Theoretical Settlement Price, on the settlement day, until the Final Settlement Price is determined.
entrypoint typedef struct _TheoreticalSettlementPriceNotificationMessage {
  UINT32 nanoseconds;                   // bytes 0 to 3
  UINT8 settlement_symbol[8];           // bytes 4 to 11
  UINT32 theoretical_settlement_price;  // bytes 12 to 15
  UINT8 reserved_16[16];                // bytes 16 to 31
} TheoreticalSettlementPriceNotificationMessage;

