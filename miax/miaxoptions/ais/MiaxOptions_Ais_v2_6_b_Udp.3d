} SystemStateMessage;

// ---- Simple Liquidity Seeking Event Notification Message: 46 bytes -----------

// This is the message format that will be used to disseminate information each time a Liquidity seeking event (defined in Event Type field below) starts at MIAX.
entrypoint typedef struct _SimpleLiquiditySeekingEventNotificationMessage {
  UINT32 nanoseconds;        // bytes 0 to 3
