// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out MiaxOptions_ComplexTopOfMarket_v1_3.3d

// ---- Values ------------------------------------------------------------------

// Packet Type: one byte code
#define PACKET_TYPE_HEARTBEAT 0x00            // Heartbeat
#define PACKET_TYPE_START_OF_SESSION 0x01     // Start Of Session
#define PACKET_TYPE_END_OF_SESSION 0x02       // End Of Session
#define PACKET_TYPE_APPLICATION_MESSAGE 0x03  // Application Message

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_TIME_MESSAGE 0x31                                 // System Time Message
#define MESSAGE_TYPE_SIMPLE_SERIES_UPDATE_MESSAGE 0x50                        // Simple Series Update Message
#define MESSAGE_TYPE_COMPLEX_STRATEGY_DEFINITION_MESSAGE 0x43                 // Complex Strategy Definition Message
#define MESSAGE_TYPE_SYSTEM_STATE_MESSAGE 0x53                                // System State Message
#define MESSAGE_TYPE_COMPLEX_TOP_OF_MARKET_BID_COMPACT_MESSAGE 0x62           // Complex Top Of Market Bid Compact Message
#define MESSAGE_TYPE_COMPLEX_TOP_OF_MARKET_OFFER_COMPACT_MESSAGE 0x6F         // Complex Top Of Market Offer Compact Message
#define MESSAGE_TYPE_COMPLEX_TOP_OF_MARKET_BID_WIDE_MESSAGE 0x65              // Complex Top Of Market Bid Wide Message
#define MESSAGE_TYPE_COMPLEX_TOP_OF_MARKET_OFFER_WIDE_MESSAGE 0x66            // Complex Top Of Market Offer Wide Message
#define MESSAGE_TYPE_COMPLEX_DOUBLE_SIDED_TOP_OF_MARKET_COMPACT_MESSAGE 0x6D  // Complex Double Sided Top Of Market Compact Message
#define MESSAGE_TYPE_COMPLEX_DOUBLE_SIDED_TOP_OF_MARKET_WIDE_MESSAGE 0x77     // Complex Double Sided Top Of Market Wide Message
#define MESSAGE_TYPE_STRATEGY_LAST_SALE_MESSAGE 0x74                          // Strategy Last Sale Message
#define MESSAGE_TYPE_UNDERLYING_TRADING_STATUS_NOTIFICATION_MESSAGE 0x48      // Underlying Trading Status Notification Message

// Call Or Put: one byte code
#define CALL_OR_PUT_CALL 0x43  // Call
#define CALL_OR_PUT_PUT 0x50   // Put

// Restricted Option: one byte code
#define RESTRICTED_OPTION_YES 0x59  // Yes
#define RESTRICTED_OPTION_NO 0x4E   // No

// Long Term Option: one byte code
#define LONG_TERM_OPTION_YES 0x59  // Yes
#define LONG_TERM_OPTION_NO 0x4E   // No

// Active On Miax: one byte code
#define ACTIVE_ON_MIAX_ACTIVE 0x41    // Active
#define ACTIVE_ON_MIAX_INACTIVE 0x49  // Inactive

// Miax Bbo Posting Increment Indicator: one byte code
#define MIAX_BBO_POSTING_INCREMENT_INDICATOR_PENNY 0x50            // Penny
#define MIAX_BBO_POSTING_INCREMENT_INDICATOR_PENNY_OR_NICKEL 0x4E  // Penny Or Nickel
#define MIAX_BBO_POSTING_INCREMENT_INDICATOR_NICKEL_OR_DIME 0x44   // Nickel Or Dime

// Liquidity Acceptance Increment Indicator: one byte code
#define LIQUIDITY_ACCEPTANCE_INCREMENT_INDICATOR_PENNY 0x50            // Penny
#define LIQUIDITY_ACCEPTANCE_INCREMENT_INDICATOR_PENNY_OR_NICKEL 0x4E  // Penny Or Nickel
#define LIQUIDITY_ACCEPTANCE_INCREMENT_INDICATOR_NICKEL_OR_DIME 0x44   // Nickel Or Dime

// Opening Underlying Market Code: one byte code
#define OPENING_UNDERLYING_MARKET_CODE_NYSE_AMEX 0x41           // Nyse Amex
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_BX 0x42       // Nasdaq Omx Bx
#define OPENING_UNDERLYING_MARKET_CODE_NSE 0x43                 // Nse
#define OPENING_UNDERLYING_MARKET_CODE_FINRA_ADF 0x44           // Finra Adf
#define OPENING_UNDERLYING_MARKET_CODE_MARKET_INDEPENDENT 0x45  // Market Independent
#define OPENING_UNDERLYING_MARKET_CODE_ISE 0x49                 // Ise
#define OPENING_UNDERLYING_MARKET_CODE_EDGA 0x4A                // Edga
#define OPENING_UNDERLYING_MARKET_CODE_EDGX 0x4B                // Edgx
#define OPENING_UNDERLYING_MARKET_CODE_CSE 0x4D                 // Cse
#define OPENING_UNDERLYING_MARKET_CODE_NYSE_EURONEXT 0x4E       // Nyse Euronext
#define OPENING_UNDERLYING_MARKET_CODE_NYSE_ARCA 0x50           // Nyse Arca
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_UTP 0x51      // Nasdaq Omx Utp
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_CTA 0x54      // Nasdaq Omx Cta
#define OPENING_UNDERLYING_MARKET_CODE_IEX 0x56                 // Iex
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_PHLX 0x58     // Nasdaq Omx Phlx
#define OPENING_UNDERLYING_MARKET_CODE_BATS_Y 0x59              // Bats Y
#define OPENING_UNDERLYING_MARKET_CODE_BATS 0x5A                // Bats

// Update Reason: one byte code
#define UPDATE_REASON_NEW_STRATEGY_CREATED 0x4E  // New Strategy Created
#define UPDATE_REASON_UPDATED 0x55               // Updated

// Leg Side: one byte code
#define LEG_SIDE_BID 0x42  // Bid
#define LEG_SIDE_ASK 0x41  // Ask

// System Status: one byte code
#define SYSTEM_STATUS_START_OF_SYSTEM_HOURS 0x53  // Start Of System Hours
#define SYSTEM_STATUS_END_OF_SYSTEM_HOURS 0x43    // End Of System Hours
#define SYSTEM_STATUS_START_TEST_SESSION 0x31     // Start Test Session
#define SYSTEM_STATUS_END_OF_TEST_SESSION 0x32    // End Of Test Session

// Top Of Market Quote Condition: one byte code
#define TOP_OF_MARKET_QUOTE_CONDITION_REGULAR 0x41                   // Regular
#define TOP_OF_MARKET_QUOTE_CONDITION_TRADING_HALT 0x54              // Trading Halt
#define TOP_OF_MARKET_QUOTE_CONDITION_WIDE 0x57                      // Wide
#define TOP_OF_MARKET_QUOTE_CONDITION_SIMPLE_AUCTION 0x53            // Simple Auction
#define TOP_OF_MARKET_QUOTE_CONDITION_COMPLEX_AUCTION 0x43           // Complex Auction
#define TOP_OF_MARKET_QUOTE_CONDITION_SIMPLE_MARKET_PROTECTION 0x4D  // Simple Market Protection
#define TOP_OF_MARKET_QUOTE_CONDITION_LEG_MARKET_PROTECTION 0x4C     // Leg Market Protection

// Bid Condition: one byte code
#define BID_CONDITION_REGULAR 0x41                   // Regular
#define BID_CONDITION_TRADING_HALT 0x54              // Trading Halt
#define BID_CONDITION_WIDE 0x57                      // Wide
#define BID_CONDITION_SIMPLE_AUCTION 0x53            // Simple Auction
#define BID_CONDITION_COMPLEX_AUCTION 0x43           // Complex Auction
#define BID_CONDITION_SIMPLE_MARKET_PROTECTION 0x4D  // Simple Market Protection
#define BID_CONDITION_LEG_MARKET_PROTECTION 0x4C     // Leg Market Protection

// Offer Condition: one byte code
#define OFFER_CONDITION_REGULAR 0x41                   // Regular
#define OFFER_CONDITION_TRADING_HALT 0x54              // Trading Halt
#define OFFER_CONDITION_WIDE 0x57                      // Wide
#define OFFER_CONDITION_SIMPLE_AUCTION 0x53            // Simple Auction
#define OFFER_CONDITION_COMPLEX_AUCTION 0x43           // Complex Auction
#define OFFER_CONDITION_SIMPLE_MARKET_PROTECTION 0x4D  // Simple Market Protection
#define OFFER_CONDITION_LEG_MARKET_PROTECTION 0x4C     // Leg Market Protection

// Trade Condition: one byte code
#define TRADE_CONDITION_MATCHED 0x53  // Matched
#define TRADE_CONDITION_LEGGED 0x4C   // Legged

// Trading Status: one byte code
#define TRADING_STATUS_HALTED 0x48   // Halted
#define TRADING_STATUS_RESUMED 0x52  // Resumed
#define TRADING_STATUS_OPENED 0x4F   // Opened

// Event Reason: one byte code
#define EVENT_REASON_AUTOMATIC 0x41  // Automatic
#define EVENT_REASON_MANUAL 0x4D     // Manual

// ---- Types -------------------------------------------------------------------

// This is the message format that will be used to disseminate the seconds part of the timestamp that is applicable to all messages that are sent in the current second.
typedef struct _SystemTimeMessage {
  UINT32 seconds;  // bytes 0 to 3
} SystemTimeMessage;

// This is the message format that will be used to disseminate all Option series traded on MIAX for the current session. The product ID sent in this message is what will be disseminated in Top of Market BBO and Last Sale messages.
typedef struct _SimpleSeriesUpdateMessage {
  UINT32 nanoseconds;                              // bytes 0 to 3
  UINT32 product_id;                               // bytes 4 to 7
  UINT8 underlying_symbol[11];                     // bytes 8 to 18
  UINT8 security_symbol[6];                        // bytes 19 to 24
  UINT8 expiration_date[8];                        // bytes 25 to 32
  UINT32 strike_price;                             // bytes 33 to 36
  UINT8 call_or_put;                               // byte 37
  UINT8 opening_time[8];                           // bytes 38 to 45
  UINT8 closing_time[8];                           // bytes 46 to 53
  UINT8 restricted_option;                         // byte 54
  UINT8 long_term_option;                          // byte 55
  UINT8 active_on_miax;                            // byte 56
  UINT8 miax_bbo_posting_increment_indicator;      // byte 57
  UINT8 liquidity_acceptance_increment_indicator;  // byte 58
  UINT8 opening_underlying_market_code;            // byte 59
  UINT32 priority_quote_width;                     // bytes 60 to 63
  UINT8 reserved_8[8];                             // bytes 64 to 71
} SimpleSeriesUpdateMessage;

// Complex Strategy Number of Legs
typedef struct _LegDefinition {
  UINT32 product_id;     // bytes 0 to 3
  UINT16 leg_ratio_qty;  // bytes 4 to 5
  UINT8 leg_side;        // byte 6
  UINT8 reserved_8[8];   // bytes 7 to 14
} LegDefinition;

// This is the message format that will be used to disseminate stock option strategies traded on MIAX for the current session.
typedef struct _ComplexStrategyDefinitionMessage {
  UINT32 nanoseconds;                                                         // bytes 0 to 3
  UINT32 strategy_id;                                                         // bytes 4 to 7
  UINT8 underlying_symbol[11];                                                // bytes 8 to 18
  UINT8 active_on_miax;                                                       // byte 19
  UINT8 reserved_1;                                                           // byte 20
  UINT8 update_reason;                                                        // byte 21
  UINT8 reserved_10[10];                                                      // bytes 22 to 31
  UINT8 number_of_legs;                                                       // byte 32
  LegDefinition leg_definition[:byte-size (((UINT32) number_of_legs) * 15)];
} ComplexStrategyDefinitionMessage;

// This message format is used to notify the firms of the state changes of the system. This is a notification that applies to each Underlying group. Firms can use notifications as triggers in their system to ensure electronic synchronization of systems.
typedef struct _SystemStateMessage {
  UINT32 nanoseconds;   // bytes 0 to 3
  UINT8 version[8];     // bytes 4 to 11
  UINT32 session_id;    // bytes 12 to 15
  UINT8 system_status;  // byte 16
} SystemStateMessage;

// This is the message format that will be used to disseminate each side of the MIAX Complex Top of Market for options with low Net Price and small aggregate MIAX Best Bid or Offer (MBBO) size
typedef struct _ComplexTopOfMarketBidCompactMessage {
  UINT32 nanoseconds;                   // bytes 0 to 3
  UINT32 strategy_id;                   // bytes 4 to 7
  UINT16 price_2;                       // bytes 8 to 9, signed, read here as unsigned
  UINT16 size_2;                        // bytes 10 to 11
  UINT16 priority_customer_size_2;      // bytes 12 to 13
  UINT8 top_of_market_quote_condition;  // byte 14
} ComplexTopOfMarketBidCompactMessage;

// This is the message format that will be used to disseminate MIAX Complex Top of Market for strategies with high net price or large aggregate MIAX Best Bid or Offer (MBBO) size.
typedef struct _ComplexTopOfMarketBidWideMessage {
  UINT32 nanoseconds;                   // bytes 0 to 3
  UINT32 strategy_id;                   // bytes 4 to 7
  UINT64 price_8;                       // bytes 8 to 15, signed, read here as unsigned
  UINT32 size_4;                        // bytes 16 to 19
  UINT32 priority_customer_size_4;      // bytes 20 to 23
  UINT8 top_of_market_quote_condition;  // byte 24
} ComplexTopOfMarketBidWideMessage;

// This is the message format that will be used to disseminate both sides of the MIAX top of market for strategies (cMBBO) with low net price and small aggregate size.
typedef struct _ComplexDoubleSidedTopOfMarketCompactMessage {
  UINT32 nanoseconds;                     // bytes 0 to 3
  UINT32 strategy_id;                     // bytes 4 to 7
  UINT16 bid_price_2;                     // bytes 8 to 9, signed, read here as unsigned
  UINT16 bid_size_2;                      // bytes 10 to 11
  UINT16 bid_priority_customer_size_2;    // bytes 12 to 13
  UINT8 bid_condition;                    // byte 14
  UINT16 offer_price_2;                   // bytes 15 to 16, signed, read here as unsigned
  UINT16 offer_size_2;                    // bytes 17 to 18
  UINT16 offer_priority_customer_size_2;  // bytes 19 to 20
  UINT8 offer_condition;                  // byte 21
} ComplexDoubleSidedTopOfMarketCompactMessage;

// This is the message format that will be used to disseminate both sides of the MIAX top of market for strategies (cMBBO) with net prices or aggregate sizes which cannot be specified in the compact format.
typedef struct _ComplexDoubleSidedTopOfMarketWideMessage {
  UINT32 nanoseconds;                     // bytes 0 to 3
  UINT32 strategy_id;                     // bytes 4 to 7
  UINT64 bid_price_8;                     // bytes 8 to 15, signed, read here as unsigned
  UINT32 bid_size_4;                      // bytes 16 to 19
  UINT32 bid_priority_customer_size_4;    // bytes 20 to 23
  UINT8 bid_condition;                    // byte 24
  UINT64 offer_price_8;                   // bytes 25 to 32, signed, read here as unsigned
  UINT32 offer_size_4;                    // bytes 33 to 36
  UINT32 offer_priority_customer_size_4;  // bytes 37 to 40
  UINT8 offer_condition;                  // byte 41
} ComplexDoubleSidedTopOfMarketWideMessage;

// This is the message format that will be used to disseminate Trades that are resulting from executions on MIAX during the current trading session
typedef struct _StrategyLastSaleMessage {
  UINT32 nanoseconds;     // bytes 0 to 3
  UINT32 strategy_id;     // bytes 4 to 7
  UINT32 trade_id;        // bytes 8 to 11
  UINT64 net_price;       // bytes 12 to 19, signed, read here as unsigned
  UINT32 trade_size;      // bytes 20 to 23
  UINT8 trade_condition;  // byte 24
  UINT8 reserved_16[16];  // bytes 25 to 40
} StrategyLastSaleMessage;

// This message format will be used to notify firms of changes to the trading status of all the options of an underlying
typedef struct _UnderlyingTradingStatusNotificationMessage {
  UINT32 nanoseconds;                       // bytes 0 to 3
  UINT8 underlying_symbol[11];              // bytes 4 to 14
  UINT8 trading_status;                     // byte 15
  UINT8 event_reason;                       // byte 16
  UINT32 expected_event_time_seconds;       // bytes 17 to 20
  UINT32 expected_event_time_nano_seconds;  // bytes 21 to 24
} UnderlyingTradingStatusNotificationMessage;

// Branch
casetype _Data (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x31: SystemTimeMessage system_time_message;
    case 0x50: SimpleSeriesUpdateMessage simple_series_update_message;
    case 0x43: ComplexStrategyDefinitionMessage complex_strategy_definition_message;
    case 0x53: SystemStateMessage system_state_message;
    case 0x62: ComplexTopOfMarketBidCompactMessage complex_top_of_market_bid_compact_message;
    case 0x6F: ComplexTopOfMarketBidCompactMessage complex_top_of_market_offer_compact_message;
    case 0x65: ComplexTopOfMarketBidWideMessage complex_top_of_market_bid_wide_message;
    case 0x66: ComplexTopOfMarketBidWideMessage complex_top_of_market_offer_wide_message;
    case 0x6D: ComplexDoubleSidedTopOfMarketCompactMessage complex_double_sided_top_of_market_compact_message;
    case 0x77: ComplexDoubleSidedTopOfMarketWideMessage complex_double_sided_top_of_market_wide_message;
    case 0x74: StrategyLastSaleMessage strategy_last_sale_message;
    case 0x48: UnderlyingTradingStatusNotificationMessage underlying_trading_status_notification_message;
    default: UINT8 unknown[available];
  }
} Data;

typedef struct _ApplicationMessage (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                         // byte 0
  Data(message_type, (available - 1)) data[:byte-size-single-element-array (available - 1)];
} ApplicationMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 length, UINT32 available) {
  switch (selector) {
    case 0x00: unit heartbeat;
    case 0x01: unit start_of_session;
    case 0x02: unit end_of_session;
    case 0x03: ApplicationMessage(length) application_message[:byte-size-single-element-array length];
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _MachMessage {
  UINT64 sequence_number;                                                                                                                                           // bytes 0 to 7
  UINT16 packet_length { packet_length >= 12 };                                                                                                                     // bytes 8 to 9
  UINT8 packet_type;                                                                                                                                                // byte 10
  UINT8 session_number;                                                                                                                                             // byte 11
  Payload(packet_type, (((UINT32) packet_length) - 12), (((UINT32) packet_length) - 12)) payload[:byte-size-single-element-array (((UINT32) packet_length) - 12)];
} MachMessage;

// ---- Packet: Packet ----------------------------------------------------------

entrypoint typedef struct _Packet (UINT32 available) {
  MachMessage mach_message[:byte-size available];
} Packet;

