// ---- Types -------------------------------------------------------------------

// This message format is used to notify firms of the state changes of the system. Firms can use notifications as triggers in their system to ensure electronic synchronization of systems.
typedef struct _SystemState {
  UINT64 notification_time;   // bytes 0 to 7
  UINT8 ctd_version[8];       // bytes 8 to 15
  UINT32 trading_session_id;  // bytes 16 to 19
  UINT8 system_status;        // byte 20
} SystemState;

// This is the message format that will be used to disseminate all MIAX trade related content for entitled parties. MIAX sends trades, trade corrections and trade cancels using this message. This is a sequenced message.
typedef struct _TradeMessage {
  UINT64 processing_time;                      // bytes 0 to 7
  UINT64 trade_time;                           // bytes 8 to 15
  UINT32 trade_as_of_date;                     // bytes 16 to 19
  UINT8 trade_action;                          // byte 20
  UINT8 trade_type;                            // byte 21
  UINT32 trade_id;                             // bytes 22 to 25
  UINT64 execution_id;                         // bytes 26 to 33
  UINT8 correction_number;                     // byte 34
  UINT32 transaction_id;                       // bytes 35 to 38
  UINT64 reference_trade_time;                 // bytes 39 to 46
  UINT32 reference_trade_id;                   // bytes 47 to 50
  UINT8 reference_correction_number;           // byte 51
  UINT8 correction_type;                       // byte 52
  UINT32 event_id;                             // bytes 53 to 56
  UINT32 strategy_id;                          // bytes 57 to 60
  UINT8 reserved_12[12];                       // bytes 61 to 72
  UINT32 product_id;                           // bytes 73 to 76
  UINT8 underlying_symbol[11];                 // bytes 77 to 87
  UINT8 underlying_type;                       // byte 88
  UINT8 security_symbol[6];                    // bytes 89 to 94
  UINT32 expiration_date;                      // bytes 95 to 98
  UINT32 strike_price;                         // bytes 99 to 102
  UINT8 call_or_put;                           // byte 103
  UINT8 reserved_8[8];                         // bytes 104 to 111
  UINT8 side;                                  // byte 112
  UINT32 price;                                // bytes 113 to 116
  UINT32 size;                                 // bytes 117 to 120
  UINT8 trade_condition;                       // byte 121
  UINT8 second_reserved_8[8];                  // bytes 122 to 129
  UINT8 class_fee_type;                        // byte 130
  UINT8 miax_bbo_posting_increment_indicator;  // byte 131
  UINT8 execution_exchange;                    // byte 132
  UINT32 routed_order_quantity;                // bytes 133 to 136
  UINT8 market_maker_role;                     // byte 137
  UINT8 traded_with_directed_mm;               // byte 138
  UINT8 market_state;                          // byte 139
  UINT8 auction_type;                          // byte 140
  UINT8 directed_status;                       // byte 141
  UINT8 strategy_state;                        // byte 142
  UINT8 strategy_auction_type;                 // byte 143
  UINT8 reserved_14[14];                       // bytes 144 to 157
  UINT8 executing_mpid[4];                     // bytes 158 to 161
  UINT32 order_date;                           // bytes 162 to 165
  UINT8 fix_order_id[30];                      // bytes 166 to 195
  UINT32 client_message_id;                    // bytes 196 to 199
  UINT8 bulk_quote_index;                      // byte 200
  UINT8 open_close_indicator;                  // byte 201
  UINT8 liquidity_type;                        // byte 202
  UINT8 mm_priority_indicator;                 // byte 203
  UINT8 liquidity_indicator;                   // byte 204
  UINT8 liquidity_timer_role;                  // byte 205
  UINT8 time_in_force;                         // byte 206
  UINT8 billing_mpid[4];                       // bytes 207 to 210
  UINT8 leg_reference_id[5];                   // bytes 211 to 215
  UINT8 strategy_timer_role;                   // byte 216
  UINT8 reserved_5[5];                         // bytes 217 to 221
  UINT8 clearing_mpid[4];                      // bytes 222 to 225
  UINT8 member_type;                           // byte 226
  UINT8 origin;                                // byte 227
  UINT32 clearing_number;                      // bytes 228 to 231
  UINT32 cmta;                                 // bytes 232 to 235
  UINT8 multi_account[5];                      // bytes 236 to 240
  UINT8 account_id[10];                        // bytes 241 to 250
  UINT8 supplementary_id[13];                  // bytes 251 to 263
  UINT8 allocation_id[4];                      // bytes 264 to 267
  UINT32 billing_clearing_number;              // bytes 268 to 271
  UINT8 third_reserved_8[8];                   // bytes 272 to 279
  UINT8 mpid[4];                               // bytes 280 to 283
  UINT8 contra_member_type;                    // byte 284
  UINT8 contra_origin;                         // byte 285
  UINT32 contra_clearing_number;               // bytes 286 to 289
  UINT32 contra_cmta;                          // bytes 290 to 293
  UINT8 contra_time_in_force;                  // byte 294
  UINT8 contra_liquidity_timer_role;           // byte 295
  UINT8 contra_strategy_timer_role;            // byte 296
  UINT8 reserved_13[13];                       // bytes 297 to 309
} TradeMessage;

// Firms configured to use Risk Protection Monitoring will receive User Notification communicating the status of Risk checks. Field Event Type is used to determine the reason for the notification. The following message will be used to disseminate all MIAX Risk Protection Monitor (RPM) related notifications. Sequenced and UnSequenced Pkt based on Event Type: solicited event types (T, R, W, D, A, P, U) are Sequenced messages at the SesM protocol level and recoverable; unsolicited (S) are Unsequenced and not recoverable.
typedef struct _RiskNotificationMessage {
  UINT64 processing_time;                  // bytes 0 to 7
  UINT8 mpid_group_id[32];                 // bytes 8 to 39
  UINT8 metric_id[32];                     // bytes 40 to 71
  UINT8 route_id[32];                      // bytes 72 to 103
  UINT8 metric_type;                       // byte 104
  UINT8 protection_type;                   // byte 105
  UINT8 event_type;                        // byte 106
  UINT32 event_id;                         // bytes 107 to 110
  UINT32 configured_counting_time_period;  // bytes 111 to 114
  UINT32 configured_max_quantity;          // bytes 115 to 118
  UINT32 current_quantity;                 // bytes 119 to 122
  UINT32 max_peak_quantity;                // bytes 123 to 126
  UINT8 percentage_level;                  // byte 127
  UINT8 reserved_32[32];                   // bytes 128 to 159
} RiskNotificationMessage;

// Branch
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemState system_state;
    case 0x54: TradeMessage trade_message;
    case 0x52: RiskNotificationMessage risk_notification_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Server application can choose to use Sequenced data packets to send all messages that must be recoverable by the client in case of a connection loss
typedef struct _SequencedDataPacket (UINT32 available) where (available >= 9) {
  UINT64 sequence_number;                                                                                                        // bytes 0 to 7
  UINT8 sequenced_message_type;                                                                                                  // byte 8
  SequencedMessage(sequenced_message_type, (available - 9)) sequenced_message[:byte-size-single-element-array (available - 9)];
} SequencedDataPacket;

// Branch
casetype _UnsequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x52: RiskNotificationMessage risk_notification_message;
    default: UINT8 unknown[available];
  }
} UnsequencedMessage;

// Each unsequenced data packet carries one unsequenced message from the higher-level protocol
typedef struct _UnsequencedDataPacket (UINT32 available) where (available >= 1) {
  UINT8 unsequenced_message_type;                                                                                                      // byte 0
  UnsequencedMessage(unsequenced_message_type, (available - 1)) unsequenced_message[:byte-size-single-element-array (available - 1)];
} UnsequencedDataPacket;

// The SesM client uses this packet to allow the server to authenticate the client and to convey to the server the last sequenced packet that the client received
typedef struct _LoginRequest {
  UINT8 sesm_version[5];             // bytes 0 to 4
  UINT8 username[5];                 // bytes 5 to 9
  UINT8 computer_id[8];              // bytes 10 to 17
  UINT8 application_protocol[8];     // bytes 18 to 25
  UINT8 requested_session;           // byte 26
  UINT64 requested_sequence_number;  // bytes 27 to 34
} LoginRequest;

// The SesM server sends a Login response packet in response to a Login request packet from the client
typedef struct _LoginResponse {
  UINT8 login_status;              // byte 0
  UINT8 session_id;                // byte 1
  UINT64 highest_sequence_number;  // bytes 2 to 9
} LoginResponse;

// The SesM client uses this packet to request the server to retransmit a range of packets
typedef struct _RetransmissionRequest {
  UINT64 start_sequence_number;  // bytes 0 to 7
  UINT64 end_sequence_number;    // bytes 8 to 15
} RetransmissionRequest;

// The client may send a Logout request packet to request the connection be terminated
typedef struct _LogoutRequest (UINT16 sesm_packet_length) where (sesm_packet_length >= 2) {
  UINT8 logout_reason;                                     // byte 0
  UINT8 logout_text[(((UINT32) sesm_packet_length) - 2)];
} LogoutRequest;

// The server may send a GoodBye packet to inform the client a reason for termination of the connection just before it terminates the connection
typedef struct _GoodbyePacket (UINT16 sesm_packet_length) where (sesm_packet_length >= 2) {
  UINT8 goodbye_reason;                                    // byte 0
  UINT8 logout_text[(((UINT32) sesm_packet_length) - 2)];
} GoodbyePacket;

// A Test packet can be sent by either side of a SesM connection at anytime; Test packets are intended to provide human readable text that may aid in debugging problems
typedef struct _TestPacket (UINT16 sesm_packet_length) where (sesm_packet_length >= 1) {
  UINT8 test_text[(((UINT32) sesm_packet_length) - 1)];
} TestPacket;

// Branch
casetype _SesmPayload (UINT8 selector, UINT32 length, UINT32 length_2, UINT16 sesm_packet_length, UINT32 available) {
  switch (selector) {
    case 0x53: SequencedDataPacket(length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x55: UnsequencedDataPacket(length_2) unsequenced_data_packet[:byte-size-single-element-array length_2];
    case 0x4C: LoginRequest login_request;
    case 0x52: LoginResponse login_response;
    case 0x43: unit synchronization_complete;
    case 0x41: RetransmissionRequest retransmission_request;
    case 0x58: LogoutRequest(sesm_packet_length) logout_request;
    case 0x47: GoodbyePacket(sesm_packet_length) goodbye_packet;
    case 0x45: unit end_of_session;
    case 0x30: unit server_heartbeat;
    case 0x31: unit client_heartbeat;
    case 0x54: TestPacket(sesm_packet_length) test_packet;
    default: UINT8 unknown[available];
  }
} SesmPayload;

// SesM Tcp Packet
typedef struct _SesmTcpPacket {
  UINT16 sesm_packet_length { sesm_packet_length >= 1 };                                                                                                                                                                                                           // bytes 0 to 1
  UINT8 sesm_packet_type;                                                                                                                                                                                                                                          // byte 2
  SesmPayload(sesm_packet_type, (((UINT32) sesm_packet_length) - 1), (((UINT32) sesm_packet_length) - 1), sesm_packet_length, ((((UINT32) sesm_packet_length) + 2) - 3)) sesm_payload[:byte-size-single-element-array ((((UINT32) sesm_packet_length) + 2) - 3)];
} SesmTcpPacket;

// ---- Packet: Packet ----------------------------------------------------------

// SesM Packet
entrypoint typedef struct _Packet (UINT32 available) {
  SesmTcpPacket sesm_tcp_packet[:byte-size available];
} Packet;

