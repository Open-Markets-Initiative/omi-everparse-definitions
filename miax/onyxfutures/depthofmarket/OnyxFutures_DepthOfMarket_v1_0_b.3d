// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out OnyxFutures_DepthOfMarket_v1_0_b.3d

// ---- Values ------------------------------------------------------------------

// Packet Type: one byte code
#define PACKET_TYPE_HEARTBEAT 0x00            // Heartbeat
#define PACKET_TYPE_START_OF_SESSION 0x01     // Start Of Session
#define PACKET_TYPE_END_OF_SESSION 0x02       // End Of Session
#define PACKET_TYPE_APPLICATION_MESSAGE 0x03  // Application Message

// Message Type: one byte code
#define MESSAGE_TYPE_SIMPLE_INSTRUMENT_DEFINITION_MESSAGE 0x01            // Simple Instrument Definition Message
#define MESSAGE_TYPE_COMPLEX_INSTRUMENT_DEFINITION_MESSAGE 0x02           // Complex Instrument Definition Message
#define MESSAGE_TYPE_SYSTEM_STATE_MESSAGE 0x03                            // System State Message
#define MESSAGE_TYPE_INSTRUMENT_TRADING_STATUS_NOTIFICATION_MESSAGE 0x04  // Instrument Trading Status Notification Message
#define MESSAGE_TYPE_ANTICIPATED_OPENING_PRICE_MESSAGE 0x05               // Anticipated Opening Price Message
#define MESSAGE_TYPE_SETTLEMENT_PRICE_UPDATE_MESSAGE 0x06                 // Settlement Price Update Message
#define MESSAGE_TYPE_OPEN_INTEREST_UPDATE_MESSAGE 0x07                    // Open Interest Update Message
#define MESSAGE_TYPE_TOTAL_VOLUME_UPDATE_MESSAGE 0x08                     // Total Volume Update Message
#define MESSAGE_TYPE_INSTRUMENT_CLEAR_MESSAGE 0x09                        // Instrument Clear Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x0A                               // Add Order Message
#define MESSAGE_TYPE_MODIFY_ORDER_MESSAGE 0x0B                            // Modify Order Message
#define MESSAGE_TYPE_DELETE_ORDER_MESSAGE 0x0C                            // Delete Order Message
#define MESSAGE_TYPE_ORDER_EXECUTION_MESSAGE 0x0D                         // Order Execution Message
#define MESSAGE_TYPE_TRADE_CANCEL_MESSAGE 0x0E                            // Trade Cancel Message

// Underlying Asset Type: one byte code
#define UNDERLYING_ASSET_TYPE_EQUITY_INDEX 0x45           // Equity Index
#define UNDERLYING_ASSET_TYPE_COMMODITY_AGRICULTURE 0x41  // Commodity Agriculture

// Instrument Id Source: one byte code
#define INSTRUMENT_ID_SOURCE_EXCHANGE 0x45  // Exchange

// Instrument Type: one byte code
#define INSTRUMENT_TYPE_FUTURES 0x46  // Futures

// Currency: one byte code
#define CURRENCY_USD 0x55  // Usd

// Settlement Currency: one byte code
#define SETTLEMENT_CURRENCY_USD 0x55  // Usd

// Match Algorithm: one byte code
#define MATCH_ALGORITHM_PRICE_THEN_TIME 0x50  // Price Then Time

// Settlement Price Type Calc Method: one byte code
#define SETTLEMENT_PRICE_TYPE_CALC_METHOD_ACTUAL 0x41       // Actual
#define SETTLEMENT_PRICE_TYPE_CALC_METHOD_THEORETICAL 0x54  // Theoretical

// Trading Collar Variation Type: one byte code
#define TRADING_COLLAR_VARIATION_TYPE_PRODUCT_DOLLAR_COLLAR_VALUE 0x44      // Product Dollar Collar Value
#define TRADING_COLLAR_VARIATION_TYPE_PRODUCT_COLLAR_PERCENTAGE_VALUE 0x50  // Product Collar Percentage Value
#define TRADING_COLLAR_VARIATION_TYPE_STANDARD_CALENDAR_SPREAD 0x53         // Standard Calendar Spread
#define TRADING_COLLAR_VARIATION_TYPE_EQUITY_CALENDAR_SPREAD 0x45           // Equity Calendar Spread
#define TRADING_COLLAR_VARIATION_TYPE_BUTTERFLY_SPREAD 0x42                 // Butterfly Spread

// System Status: one byte code
#define SYSTEM_STATUS_START_OF_SYSTEM_HOURS 0x53  // Start Of System Hours
#define SYSTEM_STATUS_END_OF_SYSTEM_HOURS 0x43    // End Of System Hours
#define SYSTEM_STATUS_START_OF_TEST_SESSION 0x31  // Start Of Test Session
#define SYSTEM_STATUS_END_OF_TEST_SESSION 0x32    // End Of Test Session

// Trading Status: one byte code
#define TRADING_STATUS_PRE_OPEN 0x01          // Pre Open
#define TRADING_STATUS_OPENING_FREEZE 0x02    // Opening Freeze
#define TRADING_STATUS_TRADING 0x03           // Trading
#define TRADING_STATUS_HALT 0x04              // Halt
#define TRADING_STATUS_OPERATIONAL_HALT 0x05  // Operational Halt
#define TRADING_STATUS_CLOSED 0x06            // Closed

// Market State: one byte code
#define MARKET_STATE_PRE_OPENING 0x01                 // Pre Opening
#define MARKET_STATE_EXTENDED_1_TRADING_SESSION 0x02  // Extended 1 Trading Session
#define MARKET_STATE_REGULAR_TRADING_SESSION 0x03     // Regular Trading Session
#define MARKET_STATE_EXTENDED_2_TRADING_SESSION 0x04  // Extended 2 Trading Session

// Settlement Price Type: one byte code
#define SETTLEMENT_PRICE_TYPE_DAILY 0x44  // Daily
#define SETTLEMENT_PRICE_TYPE_FINAL 0x46  // Final

// Order Type: one byte code
#define ORDER_TYPE_SIMPLE_ORDER 0x53   // Simple Order
#define ORDER_TYPE_COMPLEX_ORDER 0x43  // Complex Order
#define ORDER_TYPE_DERIVED_ORDER 0x44  // Derived Order

// Order Side: one byte code
#define ORDER_SIDE_BUY 0x42   // Buy
#define ORDER_SIDE_SELL 0x53  // Sell

// Aggressor Side: one byte code
#define AGGRESSOR_SIDE_BUY 0x42             // Buy
#define AGGRESSOR_SIDE_SELL 0x53            // Sell
#define AGGRESSOR_SIDE_NOT_APPLICABLE 0x4E  // Not Applicable

// ---- Types -------------------------------------------------------------------

// used to disseminate all Simple Instruments traded on MIAX FuturesOnyx for the current trading session
typedef struct _SimpleInstrumentDefinitionMessage {
  UINT64 timestamp;                         // bytes 0 to 7
  UINT32 instrument_id;                     // bytes 8 to 11
  UINT8 underlying_asset_type;              // byte 12
  UINT8 underlying_asset[4];                // bytes 13 to 16
  UINT8 product_group_code[6];              // bytes 17 to 22
  UINT8 exchange[4];                        // bytes 23 to 26
  UINT8 instrument_id_source;               // byte 27
  UINT8 instrument_type;                    // byte 28
  UINT32 maturity_month_year;               // bytes 29 to 32
  UINT8 currency;                           // byte 33
  UINT8 settlement_currency;                // byte 34
  UINT8 match_algorithm;                    // byte 35
  UINT32 minimum_size;                      // bytes 36 to 39
  UINT32 maximum_size;                      // bytes 40 to 43
  UINT64 tick;                              // bytes 44 to 51, signed, read here as unsigned
  UINT8 unit_of_measure[5];                 // bytes 52 to 56
  UINT32 unit_of_measure_quantity;          // bytes 57 to 60
  UINT64 settlement_price;                  // bytes 61 to 68, signed, read here as unsigned
  UINT8 settlement_price_type_calc_method;  // byte 69
  UINT32 total_volume;                      // bytes 70 to 73
  UINT32 open_interest_quantity;            // bytes 74 to 77
  UINT64 high_limit_price;                  // bytes 78 to 85, signed, read here as unsigned
  UINT64 low_limit_price;                   // bytes 86 to 93, signed, read here as unsigned
  UINT8 trading_collar_variation_type;      // byte 94
  UINT64 trading_collar_variation;          // bytes 95 to 102, signed, read here as unsigned
  UINT8 reserved_16[16];                    // bytes 103 to 118
} SimpleInstrumentDefinitionMessage;

// Complex Strategy Number of Legs
typedef struct _InstrumentLeg {
  UINT32 instrument_id;        // bytes 0 to 3
  UINT32 leg_ratio;            // bytes 4 to 7, signed, read here as unsigned
  UINT32 maturity_month_year;  // bytes 8 to 11
  UINT8 reserved_8[8];         // bytes 12 to 19
} InstrumentLeg;

// Used to disseminate all Complex Instruments traded on MIAX Futures Onyx for the current trading session
typedef struct _ComplexInstrumentDefinitionMessage {
  UINT64 timestamp;                                                           // bytes 0 to 7
  UINT32 instrument_id;                                                       // bytes 8 to 11
  UINT8 underlying_asset_type;                                                // byte 12
  UINT8 underlying_asset[4];                                                  // bytes 13 to 16
  UINT8 product_group_code[6];                                                // bytes 17 to 22
  UINT8 spread_type;                                                          // byte 23
  UINT8 exchange[4];                                                          // bytes 24 to 27
  UINT8 instrument_id_source;                                                 // byte 28
  UINT8 instrument_type;                                                      // byte 29
  UINT8 currency;                                                             // byte 30
  UINT8 settlement_currency;                                                  // byte 31
  UINT8 match_algorithm;                                                      // byte 32
  UINT32 minimum_size;                                                        // bytes 33 to 36
  UINT32 maximum_size;                                                        // bytes 37 to 40
  UINT64 tick;                                                                // bytes 41 to 48, signed, read here as unsigned
  UINT8 unit_of_measure[5];                                                   // bytes 49 to 53
  UINT32 unit_of_measure_quantity;                                            // bytes 54 to 57
  UINT8 trading_collar_variation_type;                                        // byte 58
  UINT64 trading_collar_variation;                                            // bytes 59 to 66, signed, read here as unsigned
  UINT8 reserved_16[16];                                                      // bytes 67 to 82
  UINT8 number_of_legs;                                                       // byte 83
  InstrumentLeg instrument_leg[:byte-size (((UINT32) number_of_legs) * 20)];
} ComplexInstrumentDefinitionMessage;

typedef struct _SystemStateMessage {
  UINT64 timestamp;      // bytes 0 to 7
  UINT8 dom_version[8];  // bytes 8 to 15
  UINT8 session_id;      // byte 16
  UINT8 system_status;   // byte 17
} SystemStateMessage;

// Used to notify firms of changes to the trading status of a particular Simple or Complex instrument
typedef struct _InstrumentTradingStatusNotificationMessage {
  UINT64 timestamp;      // bytes 0 to 7
  UINT32 instrument_id;  // bytes 8 to 11
  UINT8 trading_status;  // byte 12
  UINT8 market_state;    // byte 13
} InstrumentTradingStatusNotificationMessage;

// used to publish Anticipated Opening Price Messages for each Simple Instrument and Complex Instrument before the start of trading
typedef struct _AnticipatedOpeningPriceMessage {
  UINT64 timestamp;                  // bytes 0 to 7
  UINT32 instrument_id;              // bytes 8 to 11
  UINT64 anticipated_opening_price;  // bytes 12 to 19, signed, read here as unsigned
  UINT32 opening_match_quantity;     // bytes 20 to 23
} AnticipatedOpeningPriceMessage;

// Used to publish a Settlement Price Update and will be disseminated for each Simple Instrument as the Settlement Price is calculated for the Futures Instrument
typedef struct _SettlementPriceUpdateMessage {
  UINT64 timestamp;                         // bytes 0 to 7
  UINT16 trade_date;                        // bytes 8 to 9
  UINT32 instrument_id;                     // bytes 10 to 13
  UINT64 settlement_price;                  // bytes 14 to 21, signed, read here as unsigned
  UINT8 settlement_price_type;              // byte 22
  UINT8 settlement_price_type_calc_method;  // byte 23
} SettlementPriceUpdateMessage;

// Used to publish an Open Interest Update for each Simple Instrument once after the end of the last Trading Session
typedef struct _OpenInterestUpdateMessage {
  UINT64 timestamp;               // bytes 0 to 7
  UINT16 trade_date;              // bytes 8 to 9
  UINT32 instrument_id;           // bytes 10 to 13
  UINT32 open_interest_quantity;  // bytes 14 to 17
} OpenInterestUpdateMessage;

// used to publish a Total Volume Update for each Simple Instrument at the end of the last Trading Session
typedef struct _TotalVolumeUpdateMessage {
  UINT64 timestamp;      // bytes 0 to 7
  UINT16 trade_date;     // bytes 8 to 9
  UINT32 instrument_id;  // bytes 10 to 13
  UINT32 total_volume;   // bytes 14 to 17
} TotalVolumeUpdateMessage;

// Used to indicate that the MIAX Futures Onyx book for a Simple or Complex instrument has been cleared of all orders
typedef struct _InstrumentClearMessage {
  UINT64 timestamp;      // bytes 0 to 7
  UINT32 instrument_id;  // bytes 8 to 11
} InstrumentClearMessage;

// Used when an order is added to the MIAX Futures Onyx book
typedef struct _AddOrderMessage {
  UINT64 timestamp;      // bytes 0 to 7
  UINT32 instrument_id;  // bytes 8 to 11
  UINT8 order_type;      // byte 12
  UINT64 order_id;       // bytes 13 to 20
  UINT8 order_side;      // byte 21
  UINT64 price;          // bytes 22 to 29, signed, read here as unsigned
  UINT32 size;           // bytes 30 to 33
} AddOrderMessage;

typedef struct _ModifyOrderMessage {
  UINT64 timestamp;          // bytes 0 to 7
  UINT32 instrument_id;      // bytes 8 to 11
  UINT64 order_id;           // bytes 12 to 19
  UINT64 price;              // bytes 20 to 27, signed, read here as unsigned
  UINT32 size;               // bytes 28 to 31
  UINT8 order_position : 1;  // byte 32
  UINT8 unused : 7;          // byte 32
} ModifyOrderMessage;

// used to indicate that an order has been removed from the MIAX Futures Onyx book
typedef struct _DeleteOrderMessage {
  UINT64 timestamp;      // bytes 0 to 7
  UINT32 instrument_id;  // bytes 8 to 11
  UINT64 order_id;       // bytes 12 to 19
} DeleteOrderMessage;

// Used when a Simple or Complex order on the book executes in whole or in part
typedef struct _OrderExecutionMessage {
  UINT64 timestamp;         // bytes 0 to 7
  UINT16 trade_date;        // bytes 8 to 9
  UINT32 instrument_id;     // bytes 10 to 13
  UINT64 buy_order_id;      // bytes 14 to 21
  UINT64 sell_order_id;     // bytes 22 to 29
  UINT8 aggressor_side;     // byte 30
  UINT64 trade_id;          // bytes 31 to 38
  UINT8 correction_number;  // byte 39
  UINT64 price;             // bytes 40 to 47, signed, read here as unsigned
  UINT32 size;              // bytes 48 to 51
} OrderExecutionMessage;

// used to publish cancellation of a Simple Instrument trade which was previously published via an Order Execution Message
typedef struct _TradeCancelMessage {
  UINT64 timestamp;         // bytes 0 to 7
  UINT16 trade_date;        // bytes 8 to 9
  UINT32 instrument_id;     // bytes 10 to 13
  UINT64 trade_id;          // bytes 14 to 21
  UINT8 correction_number;  // byte 22
  UINT64 price;             // bytes 23 to 30, signed, read here as unsigned
  UINT32 size;              // bytes 31 to 34
} TradeCancelMessage;

// Branch
casetype _Data (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: SimpleInstrumentDefinitionMessage simple_instrument_definition_message;
    case 0x02: ComplexInstrumentDefinitionMessage complex_instrument_definition_message;
    case 0x03: SystemStateMessage system_state_message;
    case 0x04: InstrumentTradingStatusNotificationMessage instrument_trading_status_notification_message;
    case 0x05: AnticipatedOpeningPriceMessage anticipated_opening_price_message;
    case 0x06: SettlementPriceUpdateMessage settlement_price_update_message;
    case 0x07: OpenInterestUpdateMessage open_interest_update_message;
    case 0x08: TotalVolumeUpdateMessage total_volume_update_message;
    case 0x09: InstrumentClearMessage instrument_clear_message;
    case 0x0A: AddOrderMessage add_order_message;
    case 0x0B: ModifyOrderMessage modify_order_message;
    case 0x0C: DeleteOrderMessage delete_order_message;
    case 0x0D: OrderExecutionMessage order_execution_message;
    case 0x0E: TradeCancelMessage trade_cancel_message;
    default: UINT8 unknown[available];
  }
} Data;

typedef struct _ApplicationMessage (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                         // byte 0
  Data(message_type, (available - 1)) data[:byte-size-single-element-array (available - 1)];
} ApplicationMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 length, UINT32 available) {
  switch (selector) {
    case 0x03: ApplicationMessage(length) application_message[:byte-size-single-element-array length];
    case 0x00: unit heartbeat;
    case 0x01: unit start_of_session;
    case 0x02: unit end_of_session;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _MachMessage {
  UINT64 sequence_number;                                                                                                                                           // bytes 0 to 7
  UINT16 packet_length { packet_length >= 12 };                                                                                                                     // bytes 8 to 9
  UINT8 packet_type;                                                                                                                                                // byte 10
  UINT8 session_number;                                                                                                                                             // byte 11
  Payload(packet_type, (((UINT32) packet_length) - 12), (((UINT32) packet_length) - 12)) payload[:byte-size-single-element-array (((UINT32) packet_length) - 12)];
} MachMessage;

// ---- Packet: Packet ----------------------------------------------------------

entrypoint typedef struct _Packet (UINT32 available) {
  MachMessage mach_message[:byte-size available];
} Packet;

