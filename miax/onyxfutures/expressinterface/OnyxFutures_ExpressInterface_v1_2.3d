#define LOGOUT_REASON_APPLICATION_TERMINATING_CONNECTION 0x41  // Application Terminating Connection

// ---- Types -------------------------------------------------------------------

// An acknowledgement for a New Order Request accepted by MIAX Futures Onyx
typedef struct _NewOrderResponseMessage {
  UINT64 matching_engine_time;  // bytes 0 to 7
  UINT8 mp_id[5];               // bytes 8 to 12
  UINT8 client_order_id[20];    // bytes 13 to 32
  UINT32 instrument_id;         // bytes 33 to 36
  UINT64 order_id;              // bytes 37 to 44
  UINT8 order_status;           // byte 45
  UINT8 reserved_10[10];        // bytes 46 to 55
} NewOrderResponseMessage;

// Acknowledgement for a Modify Order Request accepted by MIAX Futures Onyx
typedef struct _ModifyOrderResponse {
  UINT64 matching_engine_time;         // bytes 0 to 7
  UINT8 mp_id[5];                      // bytes 8 to 12
  UINT8 client_order_id[20];           // bytes 13 to 32
  UINT8 original_client_order_id[20];  // bytes 33 to 52
  UINT32 instrument_id;                // bytes 53 to 56
  UINT64 order_id;                     // bytes 57 to 64
  UINT32 leaves_qty;                   // bytes 65 to 68
  UINT8 modify_status;                 // byte 69
  UINT8 reserved_10[10];               // bytes 70 to 79
} ModifyOrderResponse;

// provides response to an Order Cancel Request
typedef struct _CancelOrderResponse {
  UINT64 matching_engine_time;         // bytes 0 to 7
  UINT8 mp_id[5];                      // bytes 8 to 12
  UINT8 client_order_id[20];           // bytes 13 to 32
  UINT8 original_client_order_id[20];  // bytes 33 to 52
  UINT32 instrument_id;                // bytes 53 to 56
  UINT64 order_id;                     // bytes 57 to 64
  UINT8 cancel_status;                 // byte 65
  UINT8 reserved_10[10];               // bytes 66 to 75
} CancelOrderResponse;

// used to inform the Firm about the status of their previous Mass Cancel Request
typedef struct _MassCancelResponse {
  UINT64 matching_engine_time;  // bytes 0 to 7
  UINT8 mp_id[5];               // bytes 8 to 12
  UINT8 client_order_id[20];    // bytes 13 to 32
  UINT8 mass_cancel_status;     // byte 33
  UINT8 reserved_10[10];        // bytes 34 to 43
} MassCancelResponse;

// response to the Strategy Creation Request
typedef struct _StrategyCreationResponseMessage {
  UINT64 matching_engine_time;     // bytes 0 to 7
  UINT8 mp_id[5];                  // bytes 8 to 12
  UINT8 client_order_id[20];       // bytes 13 to 32
  UINT32 instrument_id;            // bytes 33 to 36
  UINT8 strategy_creation_status;  // byte 37
  UINT8 reserved_16[16];           // bytes 38 to 53
} StrategyCreationResponseMessage;

// published whenever system state events take place
typedef struct _SystemStateNotificationMessage {
  UINT64 matching_engine_time;  // bytes 0 to 7
  UINT8 version[8];             // bytes 8 to 15
  UINT8 session_id;             // byte 16
  UINT8 system_status;          // byte 17
  UINT8 reserved_8[8];          // bytes 18 to 25
} SystemStateNotificationMessage;

// published whenever New Order Request is accepted by MIAX Futures Onyx
typedef struct _NewOrderNotification {
  UINT64 matching_engine_time;                  // bytes 0 to 7
  UINT8 mp_id[5];                               // bytes 8 to 12
  UINT64 order_id;                              // bytes 13 to 20
  UINT64 client_send_time;                      // bytes 21 to 28
  UINT8 operator_id[18];                        // bytes 29 to 46
  UINT8 operator_location[6];                   // bytes 47 to 52
  UINT8 account[16];                            // bytes 53 to 68
  UINT8 client_order_id[20];                    // bytes 69 to 88
  UINT32 instrument_id;                         // bytes 89 to 92
  UINT64 price;                                 // bytes 93 to 100, signed, read here as unsigned
  UINT64 stop_order_trigger_price;              // bytes 101 to 108, signed, read here as unsigned
  UINT32 size;                                  // bytes 109 to 112
  UINT16 side : 1;                              // bytes 113 to 114
  UINT16 unused_15 : 15;                        // bytes 113 to 114
  UINT8 time_in_force;                          // byte 115
  UINT8 order_type;                             // byte 116
  UINT8 self_trade_protection_level : 3;        // byte 117
  UINT8 self_trade_protection_instruction : 3;  // byte 117
  UINT8 unused_2 : 2;                           // byte 117
  UINT8 self_trade_protection_group[2];         // bytes 118 to 119
  UINT8 purge_group;                            // byte 120
  UINT8 customer_order_handling_instruction;    // byte 121
  UINT8 customer_of_firm_designation : 1;       // byte 122
  UINT8 manual_order_indicator : 1;             // byte 122
  UINT8 open_close_position_indicator : 1;      // byte 122
  UINT8 side_clearing_trade_price_type : 1;     // byte 122
  UINT8 unused_4 : 4;                           // byte 122
  UINT32 min_qty;                               // bytes 123 to 126
  UINT16 order_expiry_date;                     // bytes 127 to 128
  UINT64 trading_collar_dollar_value;           // bytes 129 to 136, signed, read here as unsigned
  UINT8 cti_code;                               // byte 137
  UINT8 text_memo[20];                          // bytes 138 to 157
  UINT8 reserved_32[32];                        // bytes 158 to 189
} NewOrderNotification;

// published whenever a Modify Order Request is accepted by MIAX Futures Onyx
typedef struct _ModifyOrderNotification {
  UINT64 matching_engine_time;                // bytes 0 to 7
  UINT8 mp_id[5];                             // bytes 8 to 12
  UINT64 order_id;                            // bytes 13 to 20
  UINT64 client_send_time;                    // bytes 21 to 28
  UINT32 leaves_qty;                          // bytes 29 to 32
  UINT8 operator_id[18];                      // bytes 33 to 50
  UINT8 operator_location[6];                 // bytes 51 to 56
  UINT8 client_order_id[20];                  // bytes 57 to 76
  UINT8 original_client_order_id[20];         // bytes 77 to 96
  UINT32 instrument_id;                       // bytes 97 to 100
  UINT64 price;                               // bytes 101 to 108, signed, read here as unsigned
  UINT64 stop_order_trigger_price;            // bytes 109 to 116, signed, read here as unsigned
  UINT32 size;                                // bytes 117 to 120
  UINT16 order_expiry_date;                   // bytes 121 to 122
  UINT8 self_trade_protection_group[2];       // bytes 123 to 124
  UINT8 purge_group;                          // byte 125
  UINT8 customer_order_handling_instruction;  // byte 126
  UINT8 customer_of_firm_designation : 1;     // byte 127
  UINT8 manual_order_indicator : 1;           // byte 127
  UINT8 open_close_position_indicator : 1;    // byte 127
  UINT8 side_clearing_trade_price_type : 1;   // byte 127
  UINT8 unused_4 : 4;                         // byte 127
  UINT8 reserved_32[32];                      // bytes 128 to 159
} ModifyOrderNotification;

// used when Cancel Order Request is accepted by MIAX Futures Onyx or when unsolicited order cancels or order size reductions are to be notified to firms
typedef struct _CancelReduceSizeOrderNotification {
  UINT64 matching_engine_time;  // bytes 0 to 7
  UINT8 mp_id[5];               // bytes 8 to 12
  UINT8 operator_id[18];        // bytes 13 to 30
  UINT8 operator_location[6];   // bytes 31 to 36
  UINT8 client_order_id[20];    // bytes 37 to 56
  UINT32 instrument_id;         // bytes 57 to 60
  UINT64 order_id;              // bytes 61 to 68
  UINT64 client_send_time;      // bytes 69 to 76
  UINT32 leaves_qty;            // bytes 77 to 80
  UINT8 cancel_reason;          // byte 81
  UINT64 last_price;            // bytes 82 to 89, signed, read here as unsigned
  UINT32 last_size;             // bytes 90 to 93
  UINT8 reserved_8[8];          // bytes 94 to 101
} CancelReduceSizeOrderNotification;

// used to notify the firms about order status updates
typedef struct _OrderStatusUpdateNotification {
  UINT64 matching_engine_time;  // bytes 0 to 7
  UINT32 instrument_id;         // bytes 8 to 11
  UINT64 order_id;              // bytes 12 to 19
  UINT8 update_status;          // byte 20
  UINT8 order_type;             // byte 21
  UINT8 time_in_force;          // byte 22
  UINT8 reserved_30[30];        // bytes 23 to 52
} OrderStatusUpdateNotification;

// used to notify the firms of their Simple order executions, trade corrections and cancellations
typedef struct _SimpleExecutionNotification {
  UINT64 matching_engine_time;   // bytes 0 to 7
  UINT8 mp_id[5];                // bytes 8 to 12
  UINT8 operator_id[18];         // bytes 13 to 30
  UINT8 operator_location[6];    // bytes 31 to 36
  UINT32 instrument_id;          // bytes 37 to 40
  UINT8 client_order_id[20];     // bytes 41 to 60
  UINT64 simple_trade_id;        // bytes 61 to 68
  UINT64 complex_trade_id;       // bytes 69 to 76
  UINT64 execution_id;           // bytes 77 to 84
  UINT16 trade_date;             // bytes 85 to 86
  UINT8 correction_number;       // byte 87
  UINT8 trade_status;            // byte 88
  UINT64 last_price;             // bytes 89 to 96, signed, read here as unsigned
  UINT32 last_size;              // bytes 97 to 100
  UINT16 side : 1;               // bytes 101 to 102
  UINT16 unused_15 : 15;         // bytes 101 to 102
  UINT8 cti_code;                // byte 103
  UINT8 text_memo[20];           // bytes 104 to 123
  UINT8 liquidity_indicator[3];  // bytes 124 to 126
  UINT8 reserved_32[32];         // bytes 127 to 158
} SimpleExecutionNotification;

// used to notify the firms of their Complex order executions
typedef struct _ComplexExecutionNotification {
  UINT64 matching_engine_time;  // bytes 0 to 7
  UINT8 mp_id[5];               // bytes 8 to 12
  UINT32 instrument_id;         // bytes 13 to 16
  UINT8 client_order_id[20];    // bytes 17 to 36
  UINT64 complex_trade_id;      // bytes 37 to 44
  UINT16 trade_date;            // bytes 45 to 46
  UINT64 last_net_price;        // bytes 47 to 54, signed, read here as unsigned
  UINT32 last_size;             // bytes 55 to 58
  UINT16 side : 1;              // bytes 59 to 60
  UINT16 unused_15 : 15;        // bytes 59 to 60
  UINT8 reserved_32[32];        // bytes 61 to 92
} ComplexExecutionNotification;

// Branch
casetype _SequencedMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x4E52: NewOrderResponseMessage new_order_response_message;
    case 0x4D52: ModifyOrderResponse modify_order_response;
    case 0x4352: CancelOrderResponse cancel_order_response;
    case 0x5852: MassCancelResponse mass_cancel_response;
    case 0x5352: StrategyCreationResponseMessage strategy_creation_response_message;
    case 0x534E: SystemStateNotificationMessage system_state_notification_message;
    case 0x4F31: NewOrderNotification new_order_notification;
    case 0x4D4E: ModifyOrderNotification modify_order_notification;
    case 0x584E: CancelReduceSizeOrderNotification cancel_reduce_size_order_notification;
    case 0x4F53: OrderStatusUpdateNotification order_status_update_notification;
    case 0x454E: SimpleExecutionNotification simple_execution_notification;
    case 0x434E: ComplexExecutionNotification complex_execution_notification;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The SesM server uses Sequenced data packets to send all messages that must be recoverable by the client in case of a connection loss
typedef struct _SequencedDataPacket (UINT16 sesm_packet_length) where (sesm_packet_length >= 11) {
  UINT64 sequence_number;                                                                                                                                                  // bytes 0 to 7
  UINT16BE sequenced_message_type;                                                                                                                                         // bytes 8 to 9
  SequencedMessage(sequenced_message_type, (((UINT32) sesm_packet_length) - 11)) sequenced_message[:byte-size-single-element-array (((UINT32) sesm_packet_length) - 11)];
} SequencedDataPacket;

// use this format to send a single New Order Request
typedef struct _NewOrderRequestMessage {
  UINT64 client_send_time;                      // bytes 0 to 7
  UINT8 mp_id[5];                               // bytes 8 to 12
  UINT8 operator_id[18];                        // bytes 13 to 30
  UINT8 operator_location[6];                   // bytes 31 to 36
  UINT8 account[16];                            // bytes 37 to 52
  UINT8 client_order_id[20];                    // bytes 53 to 72
  UINT32 instrument_id;                         // bytes 73 to 76
  UINT64 price;                                 // bytes 77 to 84, signed, read here as unsigned
  UINT64 stop_order_trigger_price;              // bytes 85 to 92, signed, read here as unsigned
  UINT32 size;                                  // bytes 93 to 96
  UINT16 side : 1;                              // bytes 97 to 98
  UINT16 unused_15 : 15;                        // bytes 97 to 98
  UINT8 time_in_force;                          // byte 99
  UINT8 order_type;                             // byte 100
  UINT8 self_trade_protection_level : 3;        // byte 101
  UINT8 self_trade_protection_instruction : 3;  // byte 101
  UINT8 unused_2 : 2;                           // byte 101
  UINT8 self_trade_protection_group[2];         // bytes 102 to 103
  UINT8 purge_group;                            // byte 104
  UINT8 customer_order_handling_instruction;    // byte 105
  UINT8 customer_of_firm_designation : 1;       // byte 106
  UINT8 manual_order_indicator : 1;             // byte 106
  UINT8 open_close_position_indicator : 1;      // byte 106
  UINT8 side_clearing_trade_price_type : 1;     // byte 106
  UINT8 unused_4 : 4;                           // byte 106
  UINT32 min_qty;                               // bytes 107 to 110
  UINT16 order_expiry_date;                     // bytes 111 to 112
  UINT64 trading_collar_dollar_value;           // bytes 113 to 120, signed, read here as unsigned
  UINT8 cti_code;                               // byte 121
  UINT8 text_memo[20];                          // bytes 122 to 141
  UINT8 reserved_32[32];                        // bytes 142 to 173
} NewOrderRequestMessage;

// use this format to send a request to modify a resting order
typedef struct _ModifyOrderRequestMessage {
  UINT64 client_send_time;                    // bytes 0 to 7
  UINT8 mp_id[5];                             // bytes 8 to 12
  UINT8 operator_id[18];                      // bytes 13 to 30
  UINT8 operator_location[6];                 // bytes 31 to 36
  UINT8 client_order_id[20];                  // bytes 37 to 56
  UINT8 original_client_order_id[20];         // bytes 57 to 76
  UINT32 instrument_id;                       // bytes 77 to 80
  UINT64 price;                               // bytes 81 to 88, signed, read here as unsigned
  UINT64 stop_order_trigger_price;            // bytes 89 to 96, signed, read here as unsigned
  UINT32 size;                                // bytes 97 to 100
  UINT16 order_expiry_date;                   // bytes 101 to 102
  UINT8 self_trade_protection_group[2];       // bytes 103 to 104
  UINT8 purge_group;                          // byte 105
  UINT8 customer_order_handling_instruction;  // byte 106
  UINT8 customer_of_firm_designation : 1;     // byte 107
  UINT8 manual_order_indicator : 1;           // byte 107
  UINT8 open_close_position_indicator : 1;    // byte 107
  UINT8 side_clearing_trade_price_type : 1;   // byte 107
  UINT8 unused_4 : 4;                         // byte 107
  UINT8 reserved_32[32];                      // bytes 108 to 139
} ModifyOrderRequestMessage;

// a cancel request for a resting order
typedef struct _CancelOrderRequestMessage {
  UINT64 client_send_time;             // bytes 0 to 7
  UINT8 mp_id[5];                      // bytes 8 to 12
  UINT8 operator_id[18];               // bytes 13 to 30
  UINT8 operator_location[6];          // bytes 31 to 36
  UINT64 order_id;                     // bytes 37 to 44
  UINT8 client_order_id[20];           // bytes 45 to 64
  UINT8 original_client_order_id[20];  // bytes 65 to 84
  UINT32 instrument_id;                // bytes 85 to 88
  UINT8 reserved_10[10];               // bytes 89 to 98
} CancelOrderRequestMessage;

// request the cancellation of all orders based on the requested scope and the provided criteria
typedef struct _MassCancelRequest {
  UINT64 client_send_time;      // bytes 0 to 7
  UINT8 mp_id[5];               // bytes 8 to 12
  UINT8 operator_id[18];        // bytes 13 to 30
  UINT8 operator_location[6];   // bytes 31 to 36
  UINT8 reserved_10[10];        // bytes 37 to 46
  UINT8 client_order_id[20];    // bytes 47 to 66
  UINT8 scope;                  // byte 67
  UINT8 action;                 // byte 68
  UINT8 product_group_code[6];  // bytes 69 to 74
  UINT8 product_type;           // byte 75
  UINT8 purge_group;            // byte 76
  UINT8 reserved_9[9];          // bytes 77 to 85
} MassCancelRequest;

// Number of Legs
typedef struct _StrategyLeg {
  UINT32 instrument_id;  // bytes 0 to 3
  UINT32 leg_ratio;      // bytes 4 to 7, signed, read here as unsigned
  UINT8 reserved_8[8];   // bytes 8 to 15
} StrategyLeg;

// create a Complex Strategy order
typedef struct _StrategyCreationRequest {
  UINT64 client_send_time;                                                // bytes 0 to 7
  UINT8 mp_id[5];                                                         // bytes 8 to 12
  UINT8 operator_id[18];                                                  // bytes 13 to 30
  UINT8 operator_location[6];                                             // bytes 31 to 36
  UINT8 client_order_id[20];                                              // bytes 37 to 56
  UINT8 reserved_16[16];                                                  // bytes 57 to 72
  UINT8 number_of_legs;                                                   // byte 73
  StrategyLeg strategy_leg[:byte-size (((UINT32) number_of_legs) * 16)];
} StrategyCreationRequest;

// Branch
casetype _UnsequencedMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x4E31: NewOrderRequestMessage new_order_request_message;
    case 0x4E52: NewOrderResponseMessage new_order_response_message;
    case 0x4D31: ModifyOrderRequestMessage modify_order_request_message;
    case 0x4D52: ModifyOrderResponse modify_order_response;
    case 0x434F: CancelOrderRequestMessage cancel_order_request_message;
    case 0x4352: CancelOrderResponse cancel_order_response;
    case 0x5851: MassCancelRequest mass_cancel_request;
    case 0x5852: MassCancelResponse mass_cancel_response;
    case 0x5344: StrategyCreationRequest strategy_creation_request;
    case 0x5352: StrategyCreationResponseMessage strategy_creation_response_message;
    default: UINT8 unknown[available];
  }
} UnsequencedMessage;

// Each unsequenced data packet carries one unsequenced message from the higher-level protocol
typedef struct _UnsequencedDataPacket (UINT32 available) where (available >= 2) {
  UINT16BE unsequenced_message_type;                                                                                                   // bytes 0 to 1
  UnsequencedMessage(unsequenced_message_type, (available - 2)) unsequenced_message[:byte-size-single-element-array (available - 2)];
} UnsequencedDataPacket;

// The SesM client must send a Login request packet immediately upon establishing a new TCP/IP socket connection to the server
typedef struct _LoginRequest {
  UINT8 sesm_version[5];             // bytes 0 to 4
  UINT8 username[5];                 // bytes 5 to 9
  UINT8 computer_id[8];              // bytes 10 to 17
  UINT8 application_protocol[8];     // bytes 18 to 25
  UINT8 requested_session;           // byte 26
  UINT64 requested_sequence_number;  // bytes 27 to 34
} LoginRequest;

// The SesM server sends a Login response packet in response a Login request packet from the client
typedef struct _LoginResponse {
  UINT8 login_status;              // byte 0
  UINT8 session_id;                // byte 1
  UINT64 highest_sequence_number;  // bytes 2 to 9
} LoginResponse;

// The SesM client uses this packet to request the server to retransmit a range of packets
typedef struct _RetransmissionRequest {
  UINT64 start_sequence_number;  // bytes 0 to 7
  UINT64 end_sequence_number;    // bytes 8 to 15
} RetransmissionRequest;

// The client may send a Logout request packet to request the connection be terminated
typedef struct _LogoutRequest (UINT16 sesm_packet_length) where (sesm_packet_length >= 2) {
  UINT8 logout_reason;                                     // byte 0
  UINT8 logout_text[(((UINT32) sesm_packet_length) - 2)];
} LogoutRequest;

// The server may send a GoodBye packet to inform the client a reason for termination of the connection just before it terminates the connection
typedef struct _GoodbyePacket (UINT16 sesm_packet_length) where (sesm_packet_length >= 2) {
  UINT8 logout_reason;                                     // byte 0
  UINT8 logout_text[(((UINT32) sesm_packet_length) - 2)];
} GoodbyePacket;

// Branch
casetype _SesmPayload (UINT8 selector, UINT32 length, UINT32 length_2, UINT16 sesm_packet_length, UINT32 available) {
  switch (selector) {
    case 0x53: SequencedDataPacket(sesm_packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x55: UnsequencedDataPacket(length_2) unsequenced_data_packet[:byte-size-single-element-array length_2];
    case 0x4C: LoginRequest login_request;
    case 0x52: LoginResponse login_response;
    case 0x43: unit synchronization_complete;
    case 0x41: RetransmissionRequest retransmission_request;
    case 0x58: LogoutRequest(sesm_packet_length) logout_request;
    case 0x47: GoodbyePacket(sesm_packet_length) goodbye_packet;
    case 0x45: unit end_of_session;
    case 0x30: unit server_heartbeat;
    case 0x31: unit client_heartbeat;
    default: UINT8 unknown[available];
  }
} SesmPayload;

// SesM Tcp Packet
typedef struct _SesmTcpPacket {
  UINT16 sesm_packet_length { sesm_packet_length >= 1 };                                                                                                                                                                                                           // bytes 0 to 1
  UINT8 sesm_packet_type;                                                                                                                                                                                                                                          // byte 2
  SesmPayload(sesm_packet_type, (((UINT32) sesm_packet_length) - 1), (((UINT32) sesm_packet_length) - 1), sesm_packet_length, ((((UINT32) sesm_packet_length) + 2) - 3)) sesm_payload[:byte-size-single-element-array ((((UINT32) sesm_packet_length) + 2) - 3)];
} SesmTcpPacket;

// ---- Packet: Packet ----------------------------------------------------------

// SesM Packet
entrypoint typedef struct _Packet (UINT32 available) {
  SesmTcpPacket sesm_tcp_packet[:byte-size available];
} Packet;

