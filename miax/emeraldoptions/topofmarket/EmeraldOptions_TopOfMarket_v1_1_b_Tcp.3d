#define MESSAGE_TYPE_SIMPLE_TOP_OF_MARKET_BEST_BID_OR_OFFER_COMPACT_OFFER_MESSAGE 0x4F         // Simple Top Of Market Best Bid Or Offer Compact Offer Message
#define MESSAGE_TYPE_SIMPLE_TOP_OF_MARKET_BEST_BID_OR_OFFER_WIDE_BID_MESSAGE 0x57              // Simple Top Of Market Best Bid Or Offer Wide Bid Message
#define MESSAGE_TYPE_SIMPLE_TOP_OF_MARKET_BEST_BID_OR_OFFER_WIDE_OFFER_MESSAGE 0x41            // Simple Top Of Market Best Bid Or Offer Wide Offer Message
#define MESSAGE_TYPE_SIMPLE_DOUBLE_SIDED_TOP_OF_MARKET_BEST_BID_OR_OFFER_COMPACT_MESSAGE 0x64  // Simple Double Sided Top Of Market Best Bid Or Offer Compact Message
#define MESSAGE_TYPE_SIMPLE_DOUBLE_SIDED_TOP_OF_MARKET_BEST_BID_OR_OFFER_WIDE_MESSAGE 0x44     // Simple Double Sided Top Of Market Best Bid Or Offer Wide Message
#define MESSAGE_TYPE_LAST_SALE_MESSAGE 0x54                                                    // Last Sale Message
#define MESSAGE_TYPE_TRADE_CANCEL_MESSAGE 0x58                                                 // Trade Cancel Message
#define MESSAGE_TYPE_UNDERLYING_TRADING_STATUS_NOTIFICATION_MESSAGE 0x48                       // Underlying Trading Status Notification Message

// Call Or Put: one byte code
#define CALL_OR_PUT_CALL 0x43  // Call
#define CALL_OR_PUT_PUT 0x50   // Put

// Restricted Option: one byte code
