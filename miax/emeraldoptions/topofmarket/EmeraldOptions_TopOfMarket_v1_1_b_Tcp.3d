#define EBBO_CONDITION_REGULAR 0x41                   // Regular
#define EBBO_CONDITION_PUBLIC_CUSTOMER_INTEREST 0x42  // Public Customer Interest
#define EBBO_CONDITION_NOT_FIRM 0x43                  // Not Firm
#define EBBO_CONDITION_RESERVED 0x52                  // Reserved
#define EBBO_CONDITION_TRADING_HALT 0x54              // Trading Halt

// Bid Condition: one byte code
#define BID_CONDITION_REGULAR 0x41                   // Regular
