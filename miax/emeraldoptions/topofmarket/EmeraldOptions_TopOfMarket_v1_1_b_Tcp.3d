#define SESM_PACKET_TYPE_CLIENT_HEARTBEAT 0x31          // Client Heartbeat
#define SESM_PACKET_TYPE_TEST_PACKET 0x54               // Test Packet

// Unsequenced Message Type: one byte code
#define UNSEQUENCED_MESSAGE_TYPE_REFRESH_REQUEST_MESSAGE 0x52              // Refresh Request Message
#define UNSEQUENCED_MESSAGE_TYPE_REFRESH_RESPONSE_MESSAGE 0x72             // Refresh Response Message
#define UNSEQUENCED_MESSAGE_TYPE_END_OF_REFRESH_NOTIFICATION_MESSAGE 0x45  // End Of Refresh Notification Message

// Refresh Message Type: one byte code
#define REFRESH_MESSAGE_TYPE_SIMPLE_SERIES_UPDATE_REFRESH 0x50       // Simple Series Update Refresh
#define REFRESH_MESSAGE_TYPE_SIMPLE_TOP_OF_MARKET_REFRESH 0x51       // Simple Top Of Market Refresh
#define REFRESH_MESSAGE_TYPE_UNDERLYING_TRADING_STATUS_REFRESH 0x55  // Underlying Trading Status Refresh
#define REFRESH_MESSAGE_TYPE_SYSTEM_STATE_REFRESH 0x53               // System State Refresh

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_TIME_MESSAGE 0x31                                                  // System Time Message
#define MESSAGE_TYPE_SIMPLE_SERIES_UPDATE_MESSAGE 0x50                                         // Simple Series Update Message
#define MESSAGE_TYPE_SYSTEM_STATE_MESSAGE 0x53                                                 // System State Message
