#define BID_CONDITION_NOT_FIRM 0x43                  // Not Firm
#define BID_CONDITION_RESERVED 0x52                  // Reserved
#define BID_CONDITION_TRADING_HALT 0x54              // Trading Halt

// Offer Condition: one byte code
#define OFFER_CONDITION_REGULAR 0x41                   // Regular
#define OFFER_CONDITION_PUBLIC_CUSTOMER_INTEREST 0x42  // Public Customer Interest
#define OFFER_CONDITION_NOT_FIRM 0x43                  // Not Firm
#define OFFER_CONDITION_RESERVED 0x52                  // Reserved
#define OFFER_CONDITION_TRADING_HALT 0x54              // Trading Halt

// Trade Condition: one byte code
#define TRADE_CONDITION_CANCEL_OF_TRADE_PREVIOUSLY_REPORTED_OTHER_THAN_AS_THE_LAST_OR_OPENING 0x41             // Cancel Of Trade Previously Reported Other Than As The Last Or Opening
#define TRADE_CONDITION_LATE_AND_IS_OUT_OF_SEQUENCE 0x42                                                       // Late And Is Out Of Sequence
#define TRADE_CONDITION_CANCEL_OF_THE_LAST_REPORTED_TRADE 0x43                                                 // Cancel Of The Last Reported Trade
#define TRADE_CONDITION_LATE_AND_IS_IN_CORRECT_SEQUENCE 0x44                                                   // Late And Is In Correct Sequence
#define TRADE_CONDITION_CANCEL_OF_THE_FIRST_REPORTED_TRADE 0x45                                                // Cancel Of The First Reported Trade
#define TRADE_CONDITION_LATE_REPORT_OF_THE_OPENING_TRADE_AND_IS_OUT_OF_SEQUENCE 0x46                           // Late Report Of The Opening Trade And Is Out Of Sequence
#define TRADE_CONDITION_CANCEL_OF_THE_ONLY_REPORTED_TRADE 0x47                                                 // Cancel Of The Only Reported Trade
#define TRADE_CONDITION_LATE_REPORT_OF_THE_OPENING_TRADE_AND_IS_IN_CORRECT_SEQUENCE 0x48                       // Late Report Of The Opening Trade And Is In Correct Sequence
#define TRADE_CONDITION_AUTO 0x49                                                                              // Auto
#define TRADE_CONDITION_REOPENING_OF_AN_OPTION 0x4A                                                            // Reopening Of An Option
#define TRADE_CONDITION_RESERVED_K 0x4B                                                                        // Reserved K
#define TRADE_CONDITION_A_BUY_AND_A_SELL_IN_THE_SAME_CLASS 0x4C                                                // A Buy And A Sell In The Same Class
#define TRADE_CONDITION_A_BUY_AND_A_SELL_IN_A_PUT_AND_A_CALL 0x4D                                              // A Buy And A Sell In A Put And A Call
#define TRADE_CONDITION_RESERVED_N 0x4E                                                                        // Reserved N
#define TRADE_CONDITION_RESERVED_O 0x4F                                                                        // Reserved O
#define TRADE_CONDITION_BUY_OR_SELL_OF_A_CALL_OR_PUT 0x50                                                      // Buy Or Sell Of A Call Or Put
#define TRADE_CONDITION_BUY_OF_A_CALL_AND_A_SELL_OF_A_PUT_FOR_THE_SAME_UNDERLYING_STOCK_OR_INDEX 0x51          // Buy Of A Call And A Sell Of A Put For The Same Underlying Stock Or Index
#define TRADE_CONDITION_EXECUTION_OF_AN_ORDER_WHICH_WAS_STOPPED_AT_A_PRICE_THAT_DID_NOT_CONSTITUT_92fcoo 0x52  // Execution Of An Order Which Was Stopped At A Price That Did Not Constitute A Trade Through On Another Market At The Time Of The Stop
#define TRADE_CONDITION_EXECUTION_OF_AN_ISO_ORDER 0x53                                                         // Execution Of An Iso Order
#define TRADE_CONDITION_RESERVED_T 0x54                                                                        // Reserved T
#define TRADE_CONDITION_TRADE_THROUGH_EXEMPT 0x58                                                              // Trade Through Exempt
#define TRADE_CONDITION_PAIRED_PRIME 0x61                                                                      // Paired Prime
#define TRADE_CONDITION_RESERVED_B 0x62                                                                        // Reserved b
#define TRADE_CONDITION_PRIME_CUSTOMER_TO_CUSTOMER_CROSS_OR_PRIME_QCC 0x63                                     // Prime Customer To Customer Cross Or Prime Qcc
#define TRADE_CONDITION_RESERVED_D 0x64                                                                        // Reserved d
#define TRADE_CONDITION_RESERVED_E 0x65                                                                        // Reserved e
#define TRADE_CONDITION_COMPLEX_TRANSACTION_THAT_IS_NOT_COMPLEX_STOCK_TIED_AND_DOES_NOT_INVOLVE_LEGGING 0x66   // Complex Transaction That Is Not Complex Stock Tied And Does Not Involve Legging
#define TRADE_CONDITION_COMPLEX_PRIME_TRANSACTION_THAT_IS_NOT_COMPLEX_STOCK_TIED_AND_DOES_NOT_INV_fnhuva 0x67  // Complex Prime Transaction That Is Not Complex Stock Tied And Does Not Involve Legging
#define TRADE_CONDITION_COMPLEX_PRIME_CUSTOMER_TO_CUSTOMER_CROSS_OR_COMPLEX_PRIME_QCC_TRANSACTION_2nlmg4 0x68  // Complex Prime Customer To Customer Cross Or Complex Prime Qcc Transaction That Is Not Complex Stock Tied
#define TRADE_CONDITION_RESERVED_I 0x69                                                                        // Reserved i
#define TRADE_CONDITION_COMPLEX_LEGGING_TRANSACTION_THAT_IS_NOT_COMPLEX_STOCK_TIED 0x6A                        // Complex Legging Transaction That Is Not Complex Stock Tied
#define TRADE_CONDITION_COMPLEX_PRIME_STOCK_TIED_TRANSACTION_THAT_DOES_NOT_INVOLVE_LEGGING 0x6B                // Complex Prime Stock Tied Transaction That Does Not Involve Legging
#define TRADE_CONDITION_COMPLEX_PRIME_LEGGING_TRANSACTION_THAT_IS_NOT_COMPLEX_STOCK_TIED 0x6C                  // Complex Prime Legging Transaction That Is Not Complex Stock Tied
#define TRADE_CONDITION_RESERVED_M 0x6D                                                                        // Reserved m
#define TRADE_CONDITION_COMPLEX_STOCK_TIED_TRANSACTION_THAT_DOES_NOT_INVOLVE_LEGGING 0x6E                      // Complex Stock Tied Transaction That Does Not Involve Legging
#define TRADE_CONDITION_COMPLEX_CUSTOMER_TO_CUSTOMER_CROSS_STOCK_TIED_OR_COMPLEX_QCC_STOCK_TIED_T_4k8o8e 0x6F  // Complex Customer To Customer Cross Stock Tied Or Complex Qcc Stock Tied Transaction
#define TRADE_CONDITION_RESERVED_P 0x70                                                                        // Reserved p
#define TRADE_CONDITION_RESERVED_Q 0x71                                                                        // Reserved q
#define TRADE_CONDITION_RESERVED_R 0x72                                                                        // Reserved r
#define TRADE_CONDITION_RESERVED_S 0x73                                                                        // Reserved s
#define TRADE_CONDITION_RESERVED_LOWER_CASE_T 0x74                                                             // Reserved Lower Case T

// Trading Status: one byte code
#define TRADING_STATUS_HALTED 0x48   // Halted
#define TRADING_STATUS_RESUMED 0x52  // Resumed
#define TRADING_STATUS_OPENED 0x4F   // Opened

// Event Reason: one byte code
#define EVENT_REASON_AUTOMATIC 0x41  // Automatic
#define EVENT_REASON_MANUAL 0x4D     // Manual

// Login Status: one byte code
#define LOGIN_STATUS_SUCCESSFUL 0x20                                         // Successful
#define LOGIN_STATUS_INVALID_TRADING_SESSION_REQUESTED 0x53                  // Invalid Trading Session Requested
#define LOGIN_STATUS_NO_ACTIVE_TRADING_SESSION_EXISTS 0x55                   // No Active Trading Session Exists
#define LOGIN_STATUS_REJECTED 0x58                                           // Rejected
#define LOGIN_STATUS_INVALID_START_SEQUENCE_NUMBER_REQUESTED 0x4E            // Invalid Start Sequence Number Requested
#define LOGIN_STATUS_INCOMPATIBLE_SESSION_PROTOCOL_VERSION 0x49              // Incompatible Session Protocol Version
#define LOGIN_STATUS_INCOMPATIBLE_APPLICATION_PROTOCOL_VERSION 0x41          // Incompatible Application Protocol Version
#define LOGIN_STATUS_REQUEST_REJECTED_BECAUSE_CLIENT_ALREADY_LOGGED_IN 0x4C  // Request Rejected Because Client Already Logged In

// Logout Reason: one byte code
#define LOGOUT_REASON_GRACEFUL_LOGOUT 0x20                     // Graceful Logout
#define LOGOUT_REASON_BAD_PACKET 0x42                          // Bad Packet
#define LOGOUT_REASON_TIMED_OUT 0x4C                           // Timed Out
#define LOGOUT_REASON_APPLICATION_TERMINATING_CONNECTION 0x41  // Application Terminating Connection

// ---- Types -------------------------------------------------------------------

// The SesM server uses Sequenced data packets to send all messages that must be recoverable by the client in case of a connection loss
typedef struct _SequencedDataPacket {
  UINT64 sequence_number;        // bytes 0 to 7
  UINT8 matching_engine_id;      // byte 8
  UINT8 sequenced_message_type;  // byte 9
} SequencedDataPacket;

// Sent by the firm over the ToM Retransmission Interface (SesM Unsequenced Data Packet) to request a Last Value Refresh of a particular data set identified by Refresh Message Type.
typedef struct _RefreshRequestMessage {
  UINT8 refresh_message_type;  // byte 0
} RefreshRequestMessage;

// This is the message format that will be used to disseminate the seconds part of the timestamp that is applicable to all messages that are sent in the current second.
typedef struct _SystemTimeMessage {
  UINT32 seconds;  // bytes 0 to 3
} SystemTimeMessage;

// This is the message format that will be used to disseminate all Option series traded on Emerald for the current session. The product ID sent in this message is what will be disseminated in Top of Market BBO and Last Sale messages.
typedef struct _SimpleSeriesUpdateMessage {
  UINT32 nanoseconds;                              // bytes 0 to 3
  UINT32 product_id;                               // bytes 4 to 7
  UINT8 underlying_symbol[11];                     // bytes 8 to 18
  UINT8 security_symbol[6];                        // bytes 19 to 24
  UINT8 expiration_date[8];                        // bytes 25 to 32
  UINT32 strike_price;                             // bytes 33 to 36
  UINT8 call_or_put;                               // byte 37
  UINT8 opening_time[8];                           // bytes 38 to 45
  UINT8 closing_time[8];                           // bytes 46 to 53
  UINT8 restricted_option;                         // byte 54
  UINT8 long_term_option;                          // byte 55
  UINT8 active_on_miax;                            // byte 56
  UINT8 emerald_bbo_posting_increment_indicator;   // byte 57
  UINT8 liquidity_acceptance_increment_indicator;  // byte 58
  UINT8 opening_underlying_market_code;            // byte 59
  UINT32 priority_quote_width;                     // bytes 60 to 63
  UINT8 reserved_8[8];                             // bytes 64 to 71
} SimpleSeriesUpdateMessage;

// This message format is used to notify the firms of the state changes of the system. This is a notification that applies to each Underlying group. Firms can use notifications as triggers in their system to ensure electronic synchronization of systems.
typedef struct _SystemStateMessage {
  UINT32 nanoseconds;     // bytes 0 to 3
  UINT8 to_m_version[8];  // bytes 4 to 11
  UINT32 session_id;      // bytes 12 to 15
  UINT8 system_status;    // byte 16
} SystemStateMessage;

// This is the message format that will be used to disseminate each side of the Emerald Simple Top of Market for options with low premiums and small aggregate Emerald Best Bid or Offer (EBBO) size. B = Emerald Simple Top of Market on Bid side.
typedef struct _SimpleTopOfMarketBestBidOrOfferCompactBidMessage {
  UINT32 nanoseconds;                           // bytes 0 to 3
  UINT32 product_id;                            // bytes 4 to 7
  UINT16 e_b_b_o_price_short;                   // bytes 8 to 9
  UINT16 e_b_b_o_size_short;                    // bytes 10 to 11
  UINT16 e_b_b_o_priority_customer_size_short;  // bytes 12 to 13
  UINT8 ebbo_condition;                         // byte 14
} SimpleTopOfMarketBestBidOrOfferCompactBidMessage;

// This is the message format that will be used to disseminate each side of the Emerald Simple Top of Market for options with low premiums and small aggregate Emerald Best Bid or Offer (EBBO) size. O = Emerald Simple Top of Market on Offer side.
typedef struct _SimpleTopOfMarketBestBidOrOfferCompactOfferMessage {
  UINT32 nanoseconds;                           // bytes 0 to 3
  UINT32 product_id;                            // bytes 4 to 7
  UINT16 e_b_b_o_price_short;                   // bytes 8 to 9
  UINT16 e_b_b_o_size_short;                    // bytes 10 to 11
  UINT16 e_b_b_o_priority_customer_size_short;  // bytes 12 to 13
  UINT8 ebbo_condition;                         // byte 14
} SimpleTopOfMarketBestBidOrOfferCompactOfferMessage;

// This is the message format that will be used to disseminate Emerald Simple Top of Market for options with high premiums or large aggregate Emerald Best Bid or Offer (EBBO) size. W = Emerald Simple Top of Market on Bid side (wide).
typedef struct _SimpleTopOfMarketBestBidOrOfferWideBidMessage {
  UINT32 nanoseconds;                          // bytes 0 to 3
  UINT32 product_id;                           // bytes 4 to 7
  UINT32 e_b_b_o_price_long;                   // bytes 8 to 11
  UINT32 e_b_b_o_size_long;                    // bytes 12 to 15
  UINT32 e_b_b_o_priority_customer_size_long;  // bytes 16 to 19
  UINT8 ebbo_condition;                        // byte 20
} SimpleTopOfMarketBestBidOrOfferWideBidMessage;

// This is the message format that will be used to disseminate Emerald Simple Top of Market for options with high premiums or large aggregate Emerald Best Bid or Offer (EBBO) size. A = Emerald Simple Top of Market on Offer side (wide).
typedef struct _SimpleTopOfMarketBestBidOrOfferWideOfferMessage {
  UINT32 nanoseconds;                          // bytes 0 to 3
  UINT32 product_id;                           // bytes 4 to 7
  UINT32 e_b_b_o_price_long;                   // bytes 8 to 11
  UINT32 e_b_b_o_size_long;                    // bytes 12 to 15
  UINT32 e_b_b_o_priority_customer_size_long;  // bytes 16 to 19
  UINT8 ebbo_condition;                        // byte 20
} SimpleTopOfMarketBestBidOrOfferWideOfferMessage;

// This is the message format that will be used in the real-time feed and refresh service to disseminate both sides of the Emerald Simple Top of Market for options with low premiums and small aggregate Emerald Best Bid or Offer (EBBO) size.
typedef struct _SimpleDoubleSidedTopOfMarketBestBidOrOfferCompactMessage {
  UINT32 nanoseconds;                         // bytes 0 to 3
  UINT32 product_id;                          // bytes 4 to 7
  UINT16 bid_price_short;                     // bytes 8 to 9
  UINT16 bid_size_short;                      // bytes 10 to 11
  UINT16 bid_priority_customer_size_short;    // bytes 12 to 13
  UINT8 bid_condition;                        // byte 14
  UINT16 offer_price_short;                   // bytes 15 to 16
  UINT16 offer_size_short;                    // bytes 17 to 18
  UINT16 offer_priority_customer_size_short;  // bytes 19 to 20
  UINT8 offer_condition;                      // byte 21
} SimpleDoubleSidedTopOfMarketBestBidOrOfferCompactMessage;

// This is the message format that will be used in the real-time feed and refresh service to disseminate both sides of the Emerald Simple Top of Market for options with high premiums or large aggregate Emerald Best Bid or Offer (EBBO) sizes.
typedef struct _SimpleDoubleSidedTopOfMarketBestBidOrOfferWideMessage {
  UINT32 nanoseconds;                        // bytes 0 to 3
  UINT32 product_id;                         // bytes 4 to 7
  UINT32 bid_price_long;                     // bytes 8 to 11
  UINT32 bid_size_long;                      // bytes 12 to 15
  UINT32 bid_priority_customer_size_long;    // bytes 16 to 19
  UINT8 bid_condition;                       // byte 20
  UINT32 offer_price_long;                   // bytes 21 to 24
  UINT32 offer_size_long;                    // bytes 25 to 28
  UINT32 offer_priority_customer_size_long;  // bytes 29 to 32
  UINT8 offer_condition;                     // byte 33
} SimpleDoubleSidedTopOfMarketBestBidOrOfferWideMessage;

// This is the message format that will be used to disseminate Trades that are resulting from executions on Emerald during the current trading session.
typedef struct _LastSaleMessage {
  UINT32 nanoseconds;                 // bytes 0 to 3
  UINT32 product_id;                  // bytes 4 to 7
  UINT32 trade_id;                    // bytes 8 to 11
  UINT8 correction_number;            // byte 12
  UINT32 reference_trade_id;          // bytes 13 to 16
  UINT8 reference_correction_number;  // byte 17
  UINT32 trade_price;                 // bytes 18 to 21
  UINT32 trade_size;                  // bytes 22 to 25
  UINT8 trade_condition;              // byte 26
} LastSaleMessage;

// This is the message format that will be used to disseminate canceled Trades that are resulting from Trade cancellations or corrections on Emerald during the current trading session.
typedef struct _TradeCancelMessage {
  UINT32 nanoseconds;       // bytes 0 to 3
  UINT32 product_id;        // bytes 4 to 7
  UINT32 trade_id;          // bytes 8 to 11
  UINT8 correction_number;  // byte 12
  UINT32 trade_price;       // bytes 13 to 16
  UINT32 trade_size;        // bytes 17 to 20
  UINT8 trade_condition;    // byte 21
} TradeCancelMessage;

// This message format will be used to notify firms of changes to the trading status of all the options of an underlying.
typedef struct _UnderlyingTradingStatusNotificationMessage {
  UINT32 nanoseconds;                            // bytes 0 to 3
  UINT8 underlying_symbol[11];                   // bytes 4 to 14
  UINT8 trading_status;                          // byte 15
  UINT8 event_reason;                            // byte 16
  UINT32 expected_event_time_seconds_part;       // bytes 17 to 20
  UINT32 expected_event_time_nano_seconds_part;  // bytes 21 to 24
} UnderlyingTradingStatusNotificationMessage;

// Branch
casetype _Data (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x31: SystemTimeMessage system_time_message;
    case 0x50: SimpleSeriesUpdateMessage simple_series_update_message;
    case 0x53: SystemStateMessage system_state_message;
    case 0x42: SimpleTopOfMarketBestBidOrOfferCompactBidMessage simple_top_of_market_best_bid_or_offer_compact_bid_message;
    case 0x4F: SimpleTopOfMarketBestBidOrOfferCompactOfferMessage simple_top_of_market_best_bid_or_offer_compact_offer_message;
    case 0x57: SimpleTopOfMarketBestBidOrOfferWideBidMessage simple_top_of_market_best_bid_or_offer_wide_bid_message;
    case 0x41: SimpleTopOfMarketBestBidOrOfferWideOfferMessage simple_top_of_market_best_bid_or_offer_wide_offer_message;
    case 0x64: SimpleDoubleSidedTopOfMarketBestBidOrOfferCompactMessage simple_double_sided_top_of_market_best_bid_or_offer_compact_message;
    case 0x44: SimpleDoubleSidedTopOfMarketBestBidOrOfferWideMessage simple_double_sided_top_of_market_best_bid_or_offer_wide_message;
    case 0x54: LastSaleMessage last_sale_message;
    case 0x58: TradeCancelMessage trade_cancel_message;
    case 0x48: UnderlyingTradingStatusNotificationMessage underlying_trading_status_notification_message;
    default: UINT8 unknown[available];
  }
} Data;

typedef struct _ApplicationMessage (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                         // byte 0
  Data(message_type, (available - 1)) data[:byte-size-single-element-array (available - 1)];
} ApplicationMessage;

// Sent by MIAX Emerald over the ToM Retransmission Interface (SesM Unsequenced Data Packet) carrying one Application Message that satisfies a previous Refresh Request. Note: MIAX Emerald PDF assigns Response Type R (uppercase) to this message, colliding with the Request Type R byte; lowercase r is used here to match the Pearl convention for case-distinct discrimination.
typedef struct _RefreshResponseMessage (UINT16 sesm_packet_length) where (sesm_packet_length >= 10) {
  UINT64 sequence_number;                                                                                                                              // bytes 0 to 7
  ApplicationMessage((((UINT32) sesm_packet_length) - 10)) application_message[:byte-size-single-element-array (((UINT32) sesm_packet_length) - 10)];
} RefreshResponseMessage;

// Sent by MIAX Emerald over the ToM Retransmission Interface (SesM Unsequenced Data Packet) when the refresh response is complete.
typedef struct _EndOfRefreshNotificationMessage {
  UINT8 refresh_message_type;  // byte 0
} EndOfRefreshNotificationMessage;

// Branch
casetype _UnsequencedMessage (UINT8 selector, UINT16 sesm_packet_length, UINT32 available) {
  switch (selector) {
    case 0x52: RefreshRequestMessage refresh_request_message;
    case 0x72: RefreshResponseMessage(sesm_packet_length) refresh_response_message;
    case 0x45: EndOfRefreshNotificationMessage end_of_refresh_notification_message;
    default: UINT8 unknown[available];
  }
} UnsequencedMessage;

// Each unsequenced data packet carries one unsequenced message from the higher-lever protocol
typedef struct _UnsequencedDataPacket (UINT16 sesm_packet_length, UINT32 available) where (available >= 1) {
  UINT8 unsequenced_message_type;                                                                                                                          // byte 0
  UnsequencedMessage(unsequenced_message_type, sesm_packet_length, (available - 1)) unsequenced_message[:byte-size-single-element-array (available - 1)];
} UnsequencedDataPacket;

// The SesM client must send a Login request packet immediately upon establishing a new TCP/IP socket connection to the server
typedef struct _LoginRequest {
  UINT8 sesm_version[5];               // bytes 0 to 4
  UINT8 username[5];                   // bytes 5 to 9
  UINT8 computer_id[8];                // bytes 10 to 17
  UINT8 application_protocol[8];       // bytes 18 to 25
  UINT8 requested_trading_session_id;  // byte 26
  UINT64 requested_sequence_number;    // bytes 27 to 34
} LoginRequest;

// The SesM server sends a Login response packet in response a Login request packet from the client
typedef struct _LoginResponse {
  UINT8 number_of_matching_engines;  // byte 0
  UINT8 login_status;                // byte 1
  UINT8 trading_session_id;          // byte 2
  UINT64 highest_sequence_number;    // bytes 3 to 10
} LoginResponse;

// The SesM server sends a Login response packet in response a Login request packet from the client
typedef struct _SynchronizationComplete {
  UINT8 number_of_matching_engines;  // byte 0
} SynchronizationComplete;

// The SesM client uses this packet to request a retransmission server to retransmit a range of packets
typedef struct _RetransmissionRequest {
  UINT64 start_sequence_number;  // bytes 0 to 7
  UINT64 end_sequence_number;    // bytes 8 to 15
} RetransmissionRequest;

// The client may send a Logout request packet to request the connection be terminated
typedef struct _LogoutRequest (UINT16 sesm_packet_length) where (sesm_packet_length >= 2) {
  UINT8 logout_reason;                                     // byte 0
  UINT8 logout_text[(((UINT32) sesm_packet_length) - 2)];
} LogoutRequest;

// The server may send a GoodBye packet to inform the client a reason for termination of the connection just before it terminates the connection
typedef struct _GoodbyePacket (UINT16 sesm_packet_length) where (sesm_packet_length >= 2) {
  UINT8 logout_reason;                                     // byte 0
  UINT8 logout_text[(((UINT32) sesm_packet_length) - 2)];
} GoodbyePacket;

// Test packets are intended to provide human readable text that may aid in debugging problems
typedef struct _TestPacket (UINT16 sesm_packet_length) where (sesm_packet_length >= 1) {
  UINT8 test_text[(((UINT32) sesm_packet_length) - 1)];
} TestPacket;

// Branch
casetype _SesmPayload (UINT8 selector, UINT32 length, UINT32 length_2, UINT16 sesm_packet_length, UINT32 available) {
  switch (selector) {
    case 0x73: SequencedDataPacket sequenced_data_packet[:byte-size-single-element-array length];
    case 0x55: UnsequencedDataPacket(sesm_packet_length, length_2) unsequenced_data_packet[:byte-size-single-element-array length_2];
    case 0x6C: LoginRequest login_request;
    case 0x72: LoginResponse login_response;
    case 0x63: SynchronizationComplete synchronization_complete;
    case 0x61: RetransmissionRequest retransmission_request;
    case 0x58: LogoutRequest(sesm_packet_length) logout_request;
    case 0x47: GoodbyePacket(sesm_packet_length) goodbye_packet;
    case 0x75: unit trading_session_update;
    case 0x30: unit server_heartbeat;
    case 0x31: unit client_heartbeat;
    case 0x54: TestPacket(sesm_packet_length) test_packet;
    default: UINT8 unknown[available];
  }
} SesmPayload;

// SesM Tcp Packet
typedef struct _SesmTcpPacket {
  UINT16 sesm_packet_length { sesm_packet_length >= 1 };                                                                                                                                                                                                           // bytes 0 to 1
  UINT8 sesm_packet_type;                                                                                                                                                                                                                                          // byte 2
  SesmPayload(sesm_packet_type, (((UINT32) sesm_packet_length) - 1), (((UINT32) sesm_packet_length) - 1), sesm_packet_length, ((((UINT32) sesm_packet_length) + 2) - 3)) sesm_payload[:byte-size-single-element-array ((((UINT32) sesm_packet_length) + 2) - 3)];
} SesmTcpPacket;

// ---- Packet: TcpPacket -------------------------------------------------------

// SesM Packet
entrypoint typedef struct _TcpPacket (UINT32 available) {
  SesmTcpPacket sesm_tcp_packet[:byte-size available];
} TcpPacket;

