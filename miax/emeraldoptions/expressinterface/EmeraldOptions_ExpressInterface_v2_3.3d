#define E_QUOTE_TYPE_OPG 0x4F         // Opg
#define E_QUOTE_TYPE_AOC 0x41         // Aoc
#define E_QUOTE_TYPE_IOC 0x49         // Ioc
#define E_QUOTE_TYPE_ISO 0x53         // Iso
#define E_QUOTE_TYPE_FUTURE_USE 0x50  // Future Use

// Simple Mass Quote Cancel Status: one byte code
#define SIMPLE_MASS_QUOTE_CANCEL_STATUS_CANCEL_SUCCESSFUL 0x20                                   // Cancel Successful
#define SIMPLE_MASS_QUOTE_CANCEL_STATUS_INVALID_UNDERLYING 0x55                                  // Invalid Underlying
#define SIMPLE_MASS_QUOTE_CANCEL_STATUS_MASS_QUOTE_CANCEL_STILL_IN_PROGRESS 0x49                 // Mass Quote Cancel Still In Progress
#define SIMPLE_MASS_QUOTE_CANCEL_STATUS_HALT_TRIGGERED_CLEANUP_OF_QUOTES_STILL_IN_PROGRESS 0x48  // Halt Triggered Cleanup Of Quotes Still In Progress
#define SIMPLE_MASS_QUOTE_CANCEL_STATUS_ALL_QUOTE_HAVE_ALREADY_BEEN_CANCELED 0x4E                // All Quote Have Already Been Canceled
#define SIMPLE_MASS_QUOTE_CANCEL_STATUS_NOT_PERMITTED 0x58                                       // Not Permitted
#define SIMPLE_MASS_QUOTE_CANCEL_STATUS_UNKNOWN_MPID 0x4D                                        // Unknown Mpid
#define SIMPLE_MASS_QUOTE_CANCEL_STATUS_EMERALD_CLOSED_REQUEST_CANNOT_BE_COMPLETED 0x43          // Emerald Closed Request Cannot Be Completed
#define SIMPLE_MASS_QUOTE_CANCEL_STATUS_UNDEFINED_ERROR 0x5A                                     // Undefined Error

// Simple Mass Cancel: one byte code
#define SIMPLE_MASS_CANCEL_MASS_CANCEL_SIMPLE_QUOTES_AND_E_QUOTES 0x59                                            // Mass Cancel Simple Quotes And E Quotes
#define SIMPLE_MASS_CANCEL_DO_NOT_MASS_CANCEL_SIMPLE_QUOTES_AND_E_QUOTES 0x4E                                     // Do Not Mass Cancel Simple Quotes And E Quotes
#define SIMPLE_MASS_CANCEL_MASS_CANCEL_SIMPLE_QUOTES_ONLY_UNDERLYING_SYMBOL_MUST_BE_FILLED_WITH_VALI_hkypot 0x51  // Mass Cancel Simple Quotes Only Underlying Symbol Must Be Filled With Valid Underlying For This Option

// Complex Mass Cancel: one byte code
#define COMPLEX_MASS_CANCEL_MASS_CANCEL_COMPLEX_E_QUOTES_ONLY 0x59       // Mass Cancel Complex E Quotes Only
#define COMPLEX_MASS_CANCEL_DO_NOT_MASS_CANCEL_COMPLEX_LIQUIDITIES 0x4E  // Do Not Mass Cancel Complex Liquidities

// Simple Mass Liquidity Cancel Status: one byte code
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_SIMPLE_MASS_LIQUIDITY_CANCEL_SUCCESSFUL 0x20                  // Simple Mass Liquidity Cancel Successful
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_INVALID_UNDERLYING 0x55                                       // Invalid Underlying
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_SIMPLE_MASS_LIQUIDITY_CANCEL_STILL_IN_PROGRESS 0x49           // Simple Mass Liquidity Cancel Still In Progress
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_HALT_TRIGGERED_CLEANUP_OF_LIQUIDITIES_STILL_IN_PROGRESS 0x48  // Halt Triggered Cleanup Of Liquidities Still In Progress
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_ALL_LIQUIDITIES_HAVE_ALREADY_BEEN_CANCELED 0x4E               // All Liquidities Have Already Been Canceled
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_NOT_PERMITTED 0x58                                            // Not Permitted
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_UNKNOWN_MPID 0x4D                                             // Unknown Mpid
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_EMERALD_CLOSED_REQUEST_CANNOT_BE_COMPLETED 0x43               // Emerald Closed Request Cannot Be Completed
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_INVALID_REQUEST 0x4A                                          // Invalid Request
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_FEATURE_NOT_SUPPORTED 0x45                                    // Feature Not Supported
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_UNDEFINED_ERROR 0x5A                                          // Undefined Error
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_NOT_REQUESTED 0x51                                            // Not Requested
#define SIMPLE_MASS_LIQUIDITY_CANCEL_STATUS_DOWNGRADED_FROM_OLDER_VERSION 0x2A                            // Downgraded From Older Version

// Complex Mass Liquidity Cancel Status: one byte code
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_COMPLEX_MASS_LIQUIDITY_CANCEL_SUCCESSFUL 0x20                 // Complex Mass Liquidity Cancel Successful
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_INVALID_UNDERLYING 0x55                                       // Invalid Underlying
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_COMPLEX_MASS_LIQUIDITY_CANCEL_STILL_IN_PROGRESS 0x49          // Complex Mass Liquidity Cancel Still In Progress
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_HALT_TRIGGERED_CLEANUP_OF_LIQUIDITIES_STILL_IN_PROGRESS 0x48  // Halt Triggered Cleanup Of Liquidities Still In Progress
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_ALL_LIQUIDITIES_HAVE_ALREADY_BEEN_CANCELED 0x4E               // All Liquidities Have Already Been Canceled
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_NOT_PERMITTED 0x58                                            // Not Permitted
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_UNKNOWN_MPID 0x4D                                             // Unknown Mpid
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_EMERALD_CLOSED_REQUEST_CANNOT_BE_COMPLETED 0x43               // Emerald Closed Request Cannot Be Completed
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_INVALID_REQUEST 0x4A                                          // Invalid Request
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_FEATURE_NOT_SUPPORTED 0x45                                    // Feature Not Supported
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_UNDEFINED_ERROR 0x5A                                          // Undefined Error
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_NOT_REQUESTED 0x51                                            // Not Requested
#define COMPLEX_MASS_LIQUIDITY_CANCEL_STATUS_DOWNGRADED_FROM_OLDER_VERSION 0x2A                            // Downgraded From Older Version

// Quote Protection Reset Status: one byte code
#define QUOTE_PROTECTION_RESET_STATUS_QUOTE_PROTECTION_RESET_SUCCESSFUL 0x20                   // Quote Protection Reset Successful
#define QUOTE_PROTECTION_RESET_STATUS_INVALID_UNDERLYING 0x55                                  // Invalid Underlying
#define QUOTE_PROTECTION_RESET_STATUS_MASS_QUOTE_CANCEL_STILL_IN_PROGRESS 0x49                 // Mass Quote Cancel Still In Progress
#define QUOTE_PROTECTION_RESET_STATUS_HALT_TRIGGERED_CLEANUP_OF_QUOTES_STILL_IN_PROGRESS 0x48  // Halt Triggered Cleanup Of Quotes Still In Progress
#define QUOTE_PROTECTION_RESET_STATUS_UNKNOWN_MPID 0x4D                                        // Unknown Mpid
#define QUOTE_PROTECTION_RESET_STATUS_NOT_PERMITTED 0x58                                       // Not Permitted
#define QUOTE_PROTECTION_RESET_STATUS_EMERALD_CLOSED_REQUEST_CANNOT_BE_COMPLETED 0x43          // Emerald Closed Request Cannot Be Completed
#define QUOTE_PROTECTION_RESET_STATUS_ARM_2_UNDERLYING_LEVEL_PROTECTION_IS_IN_EFFECT 0x41      // Arm 2 Underlying Level Protection Is In Effect
#define QUOTE_PROTECTION_RESET_STATUS_ARM_2_FIRM_LEVEL_PROTECTION_IS_IN_EFFECT 0x46            // Arm 2 Firm Level Protection Is In Effect
#define QUOTE_PROTECTION_RESET_STATUS_KILL_SWITCH_PROTECTION_IS_IN_EFFECT 0x4B                 // Kill Switch Protection Is In Effect
#define QUOTE_PROTECTION_RESET_STATUS_UNDEFINED_ERROR 0x5A                                     // Undefined Error
#define QUOTE_PROTECTION_RESET_STATUS_DOWNGRADED_FROM_OLDER_VERSION 0x2A                       // Downgraded From Older Version

// Simple Liquidity Reset: one byte code
#define SIMPLE_LIQUIDITY_RESET_YES 0x59  // Yes
#define SIMPLE_LIQUIDITY_RESET_NO 0x4E   // No

// Complex Liquidity Reset: one byte code
#define COMPLEX_LIQUIDITY_RESET_YES 0x59  // Yes
#define COMPLEX_LIQUIDITY_RESET_NO 0x4E   // No

// Simple Liquidity Protection Reset Status: one byte code
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_SIMPLE_LIQUIDITY_PROTECTION_RESET_SUCCESSFUL 0x20            // Simple Liquidity Protection Reset Successful
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_INVALID_UNDERLYING 0x55                                      // Invalid Underlying
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_SIMPLE_MASS_LIQUIDITY_CANCEL_STILL_IN_PROGRESS 0x49          // Simple Mass Liquidity Cancel Still In Progress
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_HALT_TRIGGERED_CLEANUP_OF_LIQUIDATES_STILL_IN_PROGRESS 0x48  // Halt Triggered Cleanup Of Liquidates Still In Progress
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_UNKNOWN_MPID 0x4D                                            // Unknown Mpid
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_NOT_PERMITTED 0x58                                           // Not Permitted
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_EMERALD_CLOSED_REQUEST_CANNOT_BE_COMPLETED 0x43              // Emerald Closed Request Cannot Be Completed
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_ARM_2_UNDERLYING_LEVEL_PROTECTION_IS_IN_EFFECT 0x41          // Arm 2 Underlying Level Protection Is In Effect
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_ARM_2_FIRM_LEVEL_PROTECTION_IS_IN_EFFECT 0x46                // Arm 2 Firm Level Protection Is In Effect
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_KILL_SWITCH_PROTECTION_IS_IN_EFFECT 0x4B                     // Kill Switch Protection Is In Effect
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_FEATURE_NOT_SUPPORTED 0x45                                   // Feature Not Supported
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_UNDEFINED_ERROR 0x5A                                         // Undefined Error
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_INVALID_REQUEST 0x4A                                         // Invalid Request
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_NOT_REQUESTED 0x51                                           // Not Requested
#define SIMPLE_LIQUIDITY_PROTECTION_RESET_STATUS_DOWNGRADED_FROM_OLDER_VERSION 0x2A                           // Downgraded From Older Version

// Complex Liquidity Protection Reset Status: one byte code
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_COMPLEX_LIQUIDITY_PROTECTION_RESET_SUCCESSFUL 0x20            // Complex Liquidity Protection Reset Successful
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_INVALID_UNDERLYING 0x55                                       // Invalid Underlying
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_COMPLEX_MASS_LIQUIDITY_CANCEL_STILL_IN_PROGRESS 0x49          // Complex Mass Liquidity Cancel Still In Progress
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_HALT_TRIGGERED_CLEANUP_OF_LIQUIDITIES_STILL_IN_PROGRESS 0x48  // Halt Triggered Cleanup Of Liquidities Still In Progress
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_UNKNOWN_MPID 0x4D                                             // Unknown Mpid
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_NOT_PERMITTED 0x58                                            // Not Permitted
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_EMERALD_CLOSED_REQUEST_CANNOT_BE_COMPLETED 0x43               // Emerald Closed Request Cannot Be Completed
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_ARM_2_UNDERLYING_LEVEL_PROTECTION_IS_IN_EFFECT 0x41           // Arm 2 Underlying Level Protection Is In Effect
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_ARM_2_FIRM_LEVEL_PROTECTION_IS_IN_EFFECT 0x46                 // Arm 2 Firm Level Protection Is In Effect
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_KILL_SWITCH_PROTECTION_IS_IN_EFFECT 0x4B                      // Kill Switch Protection Is In Effect
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_FEATURE_NOT_SUPPORTED 0x45                                    // Feature Not Supported
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_UNDEFINED_ERROR 0x5A                                          // Undefined Error
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_INVALID_REQUEST 0x4A                                          // Invalid Request
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_NOT_REQUESTED 0x51                                            // Not Requested
#define COMPLEX_LIQUIDITY_PROTECTION_RESET_STATUS_DOWNGRADED_FROM_OLDER_VERSION 0x2A                            // Downgraded From Older Version

// Status: one byte code
#define STATUS_SINGLE_SIDE_PROTECTION_RESET_REQUEST_SUCCESSFUL 0x20  // Single Side Protection Reset Request Successful
#define STATUS_INVALID_MPID 0x4D                                     // Invalid Mpid
#define STATUS_INVALID_SECURITY_ID_SCOPE 0x43                        // Invalid Security Id Scope
#define STATUS_INVALID_SECURITY_ID 0x49                              // Invalid Security Id
#define STATUS_INVALID_SIDE 0x53                                     // Invalid Side
#define STATUS_FEATURE_NOT_ENABLED 0x45                              // Feature Not Enabled
#define STATUS_UNDEFINED_ERROR 0x5A                                  // Undefined Error
#define STATUS_DOWNGRADED_FROM_OLDER_VERSION 0x2A                    // Downgraded From Older Version

// Trigger Reason: one byte code
#define TRIGGER_REASON_EXCHANGE_INITIATED_MASS_QUOTE_CANCEL 0x45                     // Exchange Initiated Mass Quote Cancel
#define TRIGGER_REASON_FIRM_INITIATED_MASS_QUOTE_CANCEL 0x55                         // Firm Initiated Mass Quote Cancel
#define TRIGGER_REASON_ARM_TRIGGERED_PROTECTION 0x52                                 // Arm Triggered Protection
#define TRIGGER_REASON_TRADING_HALT 0x54                                             // Trading Halt
#define TRIGGER_REASON_KILL_SWITCH_PROTECTION_IS_IN_EFFECT_FUTURE_USE 0x4B           // Kill Switch Protection Is In Effect Future Use
#define TRIGGER_REASON_ARM_2_FIRM_LEVEL_PROTECTION_INITIATED_MASS_QUOTE_CANCEL 0x46  // Arm 2 Firm Level Protection Initiated Mass Quote Cancel
#define TRIGGER_REASON_RESERVED_FOR_FUTURE_USE 0x4A                                  // Reserved For Future Use
#define TRIGGER_REASON_DOWNGRADED_FROM_OLDER_VERSION 0x2A                            // Downgraded From Older Version

// Login Status: one byte code
#define LOGIN_STATUS_LOGIN_SUCCESSFUL 0x20                                   // Login Successful
#define LOGIN_STATUS_REJECTED 0x58                                           // Rejected
#define LOGIN_STATUS_REQUESTED_SESSION_IS_NOT_AVAILABLE 0x53                 // Requested Session Is Not Available
#define LOGIN_STATUS_INVALID_START_SEQUENCE_NUMBER_REQUESTED 0x4E            // Invalid Start Sequence Number Requested
#define LOGIN_STATUS_INCOMPATIBLE_SESSION_PROTOCOL_VERSION 0x49              // Incompatible Session Protocol Version
#define LOGIN_STATUS_INCOMPATIBLE_APPLICATION_PROTOCOL_VERSION 0x41          // Incompatible Application Protocol Version
#define LOGIN_STATUS_REQUEST_REJECTED_BECAUSE_CLIENT_ALREADY_LOGGED_IN 0x4C  // Request Rejected Because Client Already Logged In

// Logout Reason: one byte code
#define LOGOUT_REASON_GRACEFUL_LOGOUT 0x20                     // Graceful Logout
#define LOGOUT_REASON_BAD_SESM_PACKET 0x42                     // Bad Sesm Packet
#define LOGOUT_REASON_TIMED_OUT_WAITING_FOR_LOGIN_PACKET 0x4C  // Timed Out Waiting For Login Packet
#define LOGOUT_REASON_APPLICATION_TERMINATING_CONNECTION 0x41  // Application Terminating Connection

// Goodbye Reason: one byte code
#define GOODBYE_REASON_BAD_SESM_PACKET 0x42                     // Bad Sesm Packet
#define GOODBYE_REASON_TIMED_OUT_WAITING_FOR_LOGIN_PACKET 0x4C  // Timed Out Waiting For Login Packet
#define GOODBYE_REASON_APPLICATION_TERMINATING_CONNECTION 0x41  // Application Terminating Connection

// ---- Types -------------------------------------------------------------------

// This is the message format that will be used to disseminate all Option series traded on MIAX for the current session on the cloud associated for this connection.
typedef struct _SimpleSeriesUpdate {
  UINT64 product_add_update_time;                 // bytes 0 to 7
  UINT32 product_id;                              // bytes 8 to 11
  UINT8 underlying_symbol[11];                    // bytes 12 to 22
  UINT8 security_symbol[6];                       // bytes 23 to 28
  UINT8 expiration_date[8];                       // bytes 29 to 36
  UINT32 strike_price;                            // bytes 37 to 40
  UINT8 call_or_put;                              // byte 41
  UINT8 opening_time[8];                          // bytes 42 to 49
  UINT8 closing_time[8];                          // bytes 50 to 57
  UINT8 restricted_option;                        // byte 58
  UINT8 long_term_option;                         // byte 59
  UINT8 active_on_emerald;                        // byte 60
  UINT8 emerald_bbo_posting_increment_indicator;  // byte 61
  UINT8 quote_acceptance_increment_indicator;     // byte 62
  UINT8 opening_underlying_market_code;           // byte 63
  UINT32 priority_quote_width;                    // bytes 64 to 67
  UINT8 reserved_8[8];                            // bytes 68 to 75
} SimpleSeriesUpdate;

// This message format will be used to convey to the firms the Valid Quote Width settings applicable to the Opening process of Emerald Options market. Each message describes a row of the Valid Quote Width table with a low end of the applicable price range and corresponding maximum quote width. The high end of the applicable price range is up to, but not including the next row s low end applicable price range if provided or infinity for the last row. If the table has to be reloaded, all rows will be resent. Refer to Appendix C: Messaging for Valid Quote Width for Opening for an example.
typedef struct _ValidQuoteWidthForOpening {
  UINT64 notification_time;            // bytes 0 to 7
  UINT8 mpv_class;                     // byte 8
  UINT32 low_end_of_applicable_range;  // bytes 9 to 12
  UINT32 maximum_quote_width;          // bytes 13 to 16
  UINT32 long_term_option_multiplier;  // bytes 17 to 20
} ValidQuoteWidthForOpening;

// This message indicates if the eQuote was accepted or rejected. Note that this message does not report executions. For executions, please refer to the Execution notification. For the unexecuted part that gets canceled, please refer to the Cancel notification.
typedef struct _SimpleEnhancedQuoteEQuoteResponse {
  UINT32 client_message_id;      // bytes 0 to 3
  UINT8 mpid[4];                 // bytes 4 to 7
  UINT64 e_quote_id;             // bytes 8 to 15
  UINT8 e_quote_request_status;  // byte 16
} SimpleEnhancedQuoteEQuoteResponse;

// This message indicates if the complex eQuote was accepted or rejected. Note that this message does not report executions. For executions, please refer to the Execution notification. For the handling of any unexecuted portion that was canceled, please refer to the Cancel notification.
typedef struct _ComplexEnhancedQuoteEQuoteResponse {
  UINT32 client_message_id;      // bytes 0 to 3
  UINT8 mpid[4];                 // bytes 4 to 7
  UINT64 e_quote_id;             // bytes 8 to 15
  UINT8 e_quote_request_status;  // byte 16
} ComplexEnhancedQuoteEQuoteResponse;

// This message format is used to notify the firms of the state changes of the system. This is an exchange-wide notification and not a symbol or member based notification.
typedef struct _SystemStateNotification {
  UINT64 notification_time;  // bytes 0 to 7
  UINT8 mei_version[8];      // bytes 8 to 15
  UINT8 session_id;          // byte 16
  UINT8 system_status;       // byte 17
} SystemStateNotification;

// This message format will be used to notify the firms of changes to the trading status of an option.
typedef struct _ProductTradingStatusNotification {
  UINT64 notification_time;    // bytes 0 to 7
  UINT32 product_id;           // bytes 8 to 11
  UINT8 trading_status;        // byte 12
  UINT64 expected_event_time;  // bytes 13 to 20
} ProductTradingStatusNotification;

// This message format will be used to notify the firms of changes to the trading status of all the options of an underlying.
typedef struct _UnderlyingTradingStatusNotification {
  UINT64 notification_time;     // bytes 0 to 7
  UINT8 underlying_symbol[11];  // bytes 8 to 18
  UINT8 trading_status;         // byte 19
  UINT8 event_reason;           // byte 20
  UINT64 expected_event_time;   // bytes 21 to 28
} UnderlyingTradingStatusNotification;

// This message format will be used to notify the firms if and when Emerald grants relief to the valid quote width parameters for Opening as specified in the rules and regulatory circulars of MIAX Options market.
typedef struct _QuoteWidthReliefNotification {
  UINT64 notification_time;     // bytes 0 to 7
  UINT8 underlying_symbol[11];  // bytes 8 to 18
  UINT32 relief_multiplier;     // bytes 19 to 22
} QuoteWidthReliefNotification;

// This message format will be used to notify firms of their ARM settings. All the ARM settings will be published upon system initialization and each subsequent change will also be published.
typedef struct _SimpleArmProtectionSettingsNotification {
  UINT64 notification_time;                // bytes 0 to 7
  UINT8 mpid[4];                           // bytes 8 to 11
  UINT8 underlying_symbol[11];             // bytes 12 to 22
  UINT32 allowable_engagement_percentage;  // bytes 23 to 26
  UINT16 counting_period;                  // bytes 27 to 28
  UINT8 action;                            // byte 29
  UINT8 source;                            // byte 30
} SimpleArmProtectionSettingsNotification;

// This message format will be used to notify firms of their ARM2 Underlying Level protection settings.
typedef struct _Arm2UnderlyingLevelProtectionSettingsNotification {
  UINT64 notification_time;      // bytes 0 to 7
  UINT8 mpid[4];                 // bytes 8 to 11
  UINT8 action;                  // byte 12
  UINT8 underlying_symbol[11];   // bytes 13 to 23
  UINT32 arm_threshold_count;    // bytes 24 to 27
  UINT32 arm_2_counting_period;  // bytes 28 to 31
  UINT8 reserved_16[16];         // bytes 32 to 47
} Arm2UnderlyingLevelProtectionSettingsNotification;

// This message format will be used to notify firms when a Single Side Liquidity Protection is triggered for a Emerald Option or Complex Strategy.
typedef struct _SingleSideLiquidityProtectionTriggerNotification {
  UINT64 notification_time;             // bytes 0 to 7
  UINT8 mpid[4];                        // bytes 8 to 11
  UINT8 security_id_scope;              // byte 12
  UINT32 security_id;                   // bytes 13 to 16
  UINT8 side;                           // byte 17
  UINT32 triggering_client_message_id;  // bytes 18 to 21
  UINT8 triggering_bulk_quote_index;    // byte 22
  UINT8 reserved_4[4];                  // bytes 23 to 26
} SingleSideLiquidityProtectionTriggerNotification;

// This message format will be used to notify firms about ARM2 Underlying Level protection events.
typedef struct _Arm2UnderlyingLevelProtectionNotification {
  UINT64 notification_time;      // bytes 0 to 7
  UINT8 mpid[4];                 // bytes 8 to 11
  UINT8 underlying_symbol[11];   // bytes 12 to 22
  UINT8 notification_type;       // byte 23
  UINT32 arm_threshold_count;    // bytes 24 to 27
  UINT32 arm_2_counting_period;  // bytes 28 to 31
  UINT8 reserved_16[16];         // bytes 32 to 47
} Arm2UnderlyingLevelProtectionNotification;

// This message format will be used to notify firms about ARM2 Firm Level protection events.
typedef struct _Arm2FirmLevelProtectionNotification {
  UINT64 notification_time;      // bytes 0 to 7
  UINT32 arm_threshold_count;    // bytes 8 to 11
  UINT32 arm_2_counting_period;  // bytes 12 to 15
  UINT8 notification_type;       // byte 16
  UINT8 reserved_16[16];         // bytes 17 to 32
} Arm2FirmLevelProtectionNotification;

// This is the message format that will be used to notify firms about system generated or firm requested simple quote and simple or complex eQuote cancels.
typedef struct _CancelNotification {
  UINT64 notification_time;          // bytes 0 to 7
  UINT8 mpid[4];                     // bytes 8 to 11
  UINT32 product_id_or_strategy_id;  // bytes 12 to 15
  UINT8 liquidity_type;              // byte 16
  UINT32 client_message_id;          // bytes 17 to 20
  UINT8 bulk_quote_index;            // byte 21
  UINT8 quotee_quote_side;           // byte 22
  UINT32 size;                       // bytes 23 to 26
  UINT64 engine_sequence_number;     // bytes 27 to 34
  UINT8 cancel_reason;               // byte 35
} CancelNotification;

// This message format will be used to notify the firms of executions of their simple quotes and simple or complex eQuotes.
typedef struct _OptionExecutionNotification {
  UINT64 notification_time;  // bytes 0 to 7
  UINT8 mpid[4];             // bytes 8 to 11
  UINT32 product_id;         // bytes 12 to 15
  UINT8 liquidity_type;      // byte 16
  UINT32 client_message_id;  // bytes 17 to 20
  UINT8 bulk_quote_index;    // byte 21
  UINT32 event_id;           // bytes 22 to 25
  UINT32 trade_id;           // bytes 26 to 29
  UINT64 execution_id;       // bytes 30 to 37
  UINT8 reserved_1;          // byte 38
  UINT8 trade_status;        // byte 39
  UINT32 last_price;         // bytes 40 to 43
  UINT8 side;                // byte 44
  UINT32 last_size;          // bytes 45 to 48
} OptionExecutionNotification;

// This message format will be used to notify the firm of a stock leg execution from a stock-tied complex eQuote.
typedef struct _StockLegExecutionNotification {
  UINT64 notification_time;          // bytes 0 to 7
  UINT8 mpid[4];                     // bytes 8 to 11
  UINT8 underlying_symbol[11];       // bytes 12 to 22
  UINT8 liquidity_type;              // byte 23
  UINT32 client_message_id;          // bytes 24 to 27
  UINT32 event_id;                   // bytes 28 to 31
  UINT32 trade_id;                   // bytes 32 to 35
  UINT64 execution_id;               // bytes 36 to 43
  UINT8 trade_status;                // byte 44
  UINT32 last_price;                 // bytes 45 to 48
  UINT8 side;                        // byte 49
  UINT8 stock_sell_short_indicator;  // byte 50
  UINT32 last_size;                  // bytes 51 to 54
  UINT8 reserved_16[16];             // bytes 55 to 70
} StockLegExecutionNotification;

// Branch
casetype _SequencedMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x5355: SimpleSeriesUpdate simple_series_update;
    case 0x5157: ValidQuoteWidthForOpening valid_quote_width_for_opening;
    case 0x4552: SimpleEnhancedQuoteEQuoteResponse simple_enhanced_quote_e_quote_response;
    case 0x4352: ComplexEnhancedQuoteEQuoteResponse complex_enhanced_quote_e_quote_response;
    case 0x534E: SystemStateNotification system_state_notification;
    case 0x544E: ProductTradingStatusNotification product_trading_status_notification;
    case 0x554E: UnderlyingTradingStatusNotification underlying_trading_status_notification;
    case 0x514E: QuoteWidthReliefNotification quote_width_relief_notification;
    case 0x414E: SimpleArmProtectionSettingsNotification simple_arm_protection_settings_notification;
    case 0x4132: Arm2UnderlyingLevelProtectionSettingsNotification arm_2_underlying_level_protection_settings_notification;
    case 0x5158: SingleSideLiquidityProtectionTriggerNotification single_side_liquidity_protection_trigger_notification;
    case 0x5550: Arm2UnderlyingLevelProtectionNotification arm_2_underlying_level_protection_notification;
    case 0x4650: Arm2FirmLevelProtectionNotification arm_2_firm_level_protection_notification;
    case 0x584E: CancelNotification cancel_notification;
    case 0x454E: OptionExecutionNotification option_execution_notification;
    case 0x5354: StockLegExecutionNotification stock_leg_execution_notification;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Server application can choose to use Sequenced data packets to send all messages that must be recoverable by the client in case of a connection loss
typedef struct _SequencedDataPacket (UINT32 available) where (available >= 10) {
  UINT64 sequence_number;                                                                                                          // bytes 0 to 7
  UINT16BE sequenced_message_type;                                                                                                 // bytes 8 to 9
  SequencedMessage(sequenced_message_type, (available - 10)) sequenced_message[:byte-size-single-element-array (available - 10)];
} SequencedDataPacket;

// Firms can use this message format to set up their ARM protection settings for each session. Changes to these settings can be made throughout the day.
typedef struct _SimpleArmSettingsUpdateRequest {
  UINT32 client_message_id;                // bytes 0 to 3
  UINT8 mpid[4];                           // bytes 4 to 7
  UINT8 action;                            // byte 8
  UINT8 underlying_symbol[11];             // bytes 9 to 19
  UINT32 allowable_engagement_percentage;  // bytes 20 to 23
  UINT16 counting_period;                  // bytes 24 to 25
} SimpleArmSettingsUpdateRequest;

// MIAX uses this format to respond to the firm with a status of their ARM protection settings request.
typedef struct _SimpleArmSettingsUpdateResponse {
  UINT32 client_message_id;          // bytes 0 to 3
  UINT8 mpid[4];                     // bytes 4 to 7
  UINT8 underlying_symbol[11];       // bytes 8 to 18
  UINT8 arm_settings_update_status;  // byte 19
} SimpleArmSettingsUpdateResponse;

// Firms can use this message format to set up their ARM2 Underlying Level protection settings for each session. Changes to these settings can be made throughout the day.
typedef struct _Arm2UnderlyingLevelProtectionSettingsUpdateRequest {
  UINT32 client_message_id;      // bytes 0 to 3
  UINT8 mpid[4];                 // bytes 4 to 7
  UINT8 action;                  // byte 8
  UINT8 underlying_symbol[11];   // bytes 9 to 19
  UINT32 arm_threshold_count;    // bytes 20 to 23
  UINT32 arm_2_counting_period;  // bytes 24 to 27
} Arm2UnderlyingLevelProtectionSettingsUpdateRequest;

// Emerald uses this format to respond to the firm with a status of their ARM2 Underlying level protection Settings Update Request.
typedef struct _Arm2UnderlyingLevelProtectionSettingsUpdateResponse {
  UINT32 client_message_id;          // bytes 0 to 3
  UINT8 mpid[4];                     // bytes 4 to 7
  UINT8 underlying_symbol[11];       // bytes 8 to 18
  UINT8 arm_settings_update_status;  // byte 19
} Arm2UnderlyingLevelProtectionSettingsUpdateResponse;

// 1 to 50 single-side quotes
typedef struct _SingleSideQuote {
  UINT32 product_id;       // bytes 0 to 3
  UINT8 quote_parameters;  // byte 4
  UINT32 price;            // bytes 5 to 8
  UINT32 size;             // bytes 9 to 12
  UINT8 side;              // byte 13
  UINT8 reserved_2[2];     // bytes 14 to 15
} SingleSideQuote;

// Firms can use this message format to send up to 50 single-sided quotes. Single sided quotes enables the firms to prioritize the update of more important quotes and sides ahead of other quotes.
typedef struct _SimpleBulkQuoteMessage {
  UINT32 client_message_id;                                                     // bytes 0 to 3
  UINT8 mpid[4];                                                                // bytes 4 to 7
  UINT64 client_send_time;                                                      // bytes 8 to 15
  UINT8 quote_count;                                                            // byte 16
  UINT8 reserved_32[32];                                                        // bytes 17 to 48
  SingleSideQuote single_side_quote[:byte-size (((UINT32) quote_count) * 16)];
} SimpleBulkQuoteMessage;

// 1 to 50 single-side quote responses
typedef struct _SingleSideQuoteResponse {
  UINT8 quote_status;             // byte 0
  UINT64 engine_sequence_number;  // bytes 1 to 8
} SingleSideQuoteResponse;

// This message format will be used to inform the firm of the status of quotes sent in the bulk quote request.
typedef struct _SimpleBulkQuoteResponse {
  UINT32 client_message_id;                                                                             // bytes 0 to 3
  UINT8 mpid[4];                                                                                        // bytes 4 to 7
  UINT8 bulk_quote_status;                                                                              // byte 8
  UINT8 quote_count;                                                                                    // byte 9
  UINT8 invalid_quote_count;                                                                            // byte 10
  UINT64 quote_ack_time;                                                                                // bytes 11 to 18
  SingleSideQuoteResponse single_side_quote_response[:byte-size (((UINT32) invalid_quote_count) * 9)];
} SimpleBulkQuoteResponse;

// This is the format for an eQuote message that can be sent either to match with orders and quotes on the Emerald book or when responding to a liquidity seeking event.
typedef struct _SimpleEnhancedQuoteEQuoteMessage {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT64 client_send_time;   // bytes 8 to 15
  UINT32 product_id;         // bytes 16 to 19
  UINT8 e_quote_action;      // byte 20
  UINT8 e_quote_type;        // byte 21
  UINT32 event_id;           // bytes 22 to 25
  UINT32 target_message_id;  // bytes 26 to 29
  UINT32 price;              // bytes 30 to 33
  UINT32 size;               // bytes 34 to 37
  UINT8 side;                // byte 38
  UINT8 reserved_4[4];       // bytes 39 to 42
} SimpleEnhancedQuoteEQuoteMessage;

// This is the format for a Complex eQuote message that can be sent either to match with complex book or when responding to a complex auction liquidity seeking event.
typedef struct _ComplexEnhancedQuoteEQuoteMessage {
  UINT32 client_message_id;          // bytes 0 to 3
  UINT8 mpid[4];                     // bytes 4 to 7
  UINT64 client_send_time;           // bytes 8 to 15
  UINT32 strategy_id;                // bytes 16 to 19
  UINT8 e_quote_action;              // byte 20
  UINT8 e_quote_type;                // byte 21
  UINT32 complex_event_id;           // bytes 22 to 25
  UINT32 target_message_id;          // bytes 26 to 29
  UINT64 net_price;                  // bytes 30 to 37, signed, read here as unsigned
  UINT32 size;                       // bytes 38 to 41
  UINT8 side;                        // byte 42
  UINT8 stock_sell_short_indicator;  // byte 43
  UINT8 reserved_15[15];             // bytes 44 to 58
} ComplexEnhancedQuoteEQuoteMessage;

// Firms can use this message format to request the cancelation of all simple quotes and eQuotes for an MPID, or all simple quotes and eQuotes for an MPID for all series for an underlying
typedef struct _SimpleMassQuoteCancelRequest {
  UINT32 client_message_id;     // bytes 0 to 3
  UINT8 mpid[4];                // bytes 4 to 7
  UINT64 client_send_time;      // bytes 8 to 15
  UINT8 underlying_symbol[11];  // bytes 16 to 26
  UINT8 reserved_4[4];          // bytes 27 to 30
} SimpleMassQuoteCancelRequest;

// This message format will be used to inform the firm about the status of their previous simple mass quote cancel request.
typedef struct _SimpleMassQuoteCancelResponse {
  UINT32 client_message_id;               // bytes 0 to 3
  UINT8 mpid[4];                          // bytes 4 to 7
  UINT8 simple_mass_quote_cancel_status;  // byte 8
} SimpleMassQuoteCancelResponse;

// Firms can use this message format to request the cancellation of all simple quotes and simple/complex eQuotes for an MPID, or all simple quotes and simple/complex eQuotes for an MPID for all series and/or strategies for an underlying
typedef struct _MassLiquidityCancelRequestSimpleAndComplex {
  UINT32 client_message_id;     // bytes 0 to 3
  UINT8 mpid[4];                // bytes 4 to 7
  UINT64 client_send_time;      // bytes 8 to 15
  UINT8 underlying_symbol[11];  // bytes 16 to 26
  UINT8 simple_mass_cancel;     // byte 27
  UINT8 complex_mass_cancel;    // byte 28
  UINT8 reserved_8[8];          // bytes 29 to 36
} MassLiquidityCancelRequestSimpleAndComplex;

// This message format will be used to inform the firm about the status of their previous Mass Liquidity Cancel Request.
typedef struct _MassLiquidityCancelResponse {
  UINT32 client_message_id;                    // bytes 0 to 3
  UINT8 mpid[4];                               // bytes 4 to 7
  UINT8 simple_mass_liquidity_cancel_status;   // byte 8
  UINT8 complex_mass_liquidity_cancel_status;  // byte 9
} MassLiquidityCancelResponse;

// Following a quote protection being engaged for a given MPID and underlying, firms must use this message format to reset their Quote Protection in order to start quoting for any option of the specified underlying.
typedef struct _SimpleQuoteProtectionResetRequest {
  UINT32 client_message_id;     // bytes 0 to 3
  UINT8 mpid[4];                // bytes 4 to 7
  UINT8 underlying_symbol[11];  // bytes 8 to 18
} SimpleQuoteProtectionResetRequest;

// This message format is used to inform the firms of the status of their Simple Quote Protection Reset Request.
typedef struct _SimpleQuoteProtectionResetResponse {
  UINT32 client_message_id;             // bytes 0 to 3
  UINT8 mpid[4];                        // bytes 4 to 7
  UINT8 quote_protection_reset_status;  // byte 8
} SimpleQuoteProtectionResetResponse;

// Following a quote protection being engaged for a given MPID and underlying, firms must use this message format to reset their Complex Liquidity Protection and/or Simple Liquidity Protection in order to start submitting new simple or complex liquidities for any strategy of the specified underlying and/or products of the specified underlying.
typedef struct _LiquidityProtectionResetRequest {
  UINT32 client_message_id;       // bytes 0 to 3
  UINT8 mpid[4];                  // bytes 4 to 7
  UINT8 underlying_symbol[11];    // bytes 8 to 18
  UINT8 simple_liquidity_reset;   // byte 19
  UINT8 complex_liquidity_reset;  // byte 20
  UINT8 reserved_8[8];            // bytes 21 to 28
} LiquidityProtectionResetRequest;

// Response to the Liquidity Protection Reset Request
typedef struct _LiquidityProtectionResetResponse {
  UINT32 client_message_id;                         // bytes 0 to 3
  UINT8 mpid[4];                                    // bytes 4 to 7
  UINT8 simple_liquidity_protection_reset_status;   // byte 8
  UINT8 complex_liquidity_protection_reset_status;  // byte 9
} LiquidityProtectionResetResponse;

// Request to reset Single Side Liquidity Protection for the specific Option or Complex Strategy.
typedef struct _SingleSideLiquidityProtectionResetRequest {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT8 security_id_scope;   // byte 8
  UINT32 security_id;        // bytes 9 to 12
  UINT8 side;                // byte 13
  UINT8 reserved_4[4];       // bytes 14 to 17
} SingleSideLiquidityProtectionResetRequest;

// Response to Single Side Liquidity Protection Reset Request
typedef struct _SingleSideLiquidityProtectionResetResponse {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT8 reserved_4[4];       // bytes 8 to 11
  UINT8 status;              // byte 12
} SingleSideLiquidityProtectionResetResponse;

// This message format will be used to notify firms when an MPID is placed under simple quote protection. Simple Quote protection can be triggered due to any one of the reasons listed in the message below.
typedef struct _SimpleQuoteProtectionTriggerNotification {
  UINT64 notification_time;     // bytes 0 to 7
  UINT8 mpid[4];                // bytes 8 to 11
  UINT8 underlying_symbol[11];  // bytes 12 to 22
  UINT8 trigger_reason;         // byte 23
} SimpleQuoteProtectionTriggerNotification;

// This message format will be used to notify firms when an MPID is placed under complex liquidity protection. Complex Liquidity protection can be triggered due to any one of the reasons listed in the message below.
typedef struct _ComplexLiquidityProtectionTriggerNotification {
  UINT64 notification_time;     // bytes 0 to 7
  UINT8 mpid[4];                // bytes 8 to 11
  UINT8 underlying_symbol[11];  // bytes 12 to 22
  UINT8 trigger_reason;         // byte 23
} ComplexLiquidityProtectionTriggerNotification;

// Branch
casetype _UnsequencedMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x4153: SimpleArmSettingsUpdateRequest simple_arm_settings_update_request;
    case 0x4141: SimpleArmSettingsUpdateResponse simple_arm_settings_update_response;
    case 0x3253: Arm2UnderlyingLevelProtectionSettingsUpdateRequest arm_2_underlying_level_protection_settings_update_request;
    case 0x3252: Arm2UnderlyingLevelProtectionSettingsUpdateResponse arm_2_underlying_level_protection_settings_update_response;
    case 0x7171: SimpleBulkQuoteMessage simple_bulk_quote_message;
    case 0x5152: SimpleBulkQuoteResponse simple_bulk_quote_response;
    case 0x6571: SimpleEnhancedQuoteEQuoteMessage simple_enhanced_quote_e_quote_message;
    case 0x6365: ComplexEnhancedQuoteEQuoteMessage complex_enhanced_quote_e_quote_message;
    case 0x7871: SimpleMassQuoteCancelRequest simple_mass_quote_cancel_request;
    case 0x5852: SimpleMassQuoteCancelResponse simple_mass_quote_cancel_response;
    case 0x786B: MassLiquidityCancelRequestSimpleAndComplex mass_liquidity_cancel_request_simple_and_complex;
    case 0x5850: MassLiquidityCancelResponse mass_liquidity_cancel_response;
    case 0x5058: SimpleQuoteProtectionResetRequest simple_quote_protection_reset_request;
    case 0x5052: SimpleQuoteProtectionResetResponse simple_quote_protection_reset_response;
    case 0x5043: LiquidityProtectionResetRequest liquidity_protection_reset_request;
    case 0x504B: LiquidityProtectionResetResponse liquidity_protection_reset_response;
    case 0x5353: SingleSideLiquidityProtectionResetRequest single_side_liquidity_protection_reset_request;
    case 0x5352: SingleSideLiquidityProtectionResetResponse single_side_liquidity_protection_reset_response;
    case 0x5150: SimpleQuoteProtectionTriggerNotification simple_quote_protection_trigger_notification;
    case 0x5143: ComplexLiquidityProtectionTriggerNotification complex_liquidity_protection_trigger_notification;
    case 0x584E: CancelNotification cancel_notification;
    default: UINT8 unknown[available];
  }
} UnsequencedMessage;

// Each unsequenced data packet carries one unsequenced message from the higher-level protocol
typedef struct _UnsequencedDataPacket (UINT32 available) where (available >= 2) {
  UINT16BE unsequenced_message_type;                                                                                                   // bytes 0 to 1
  UnsequencedMessage(unsequenced_message_type, (available - 2)) unsequenced_message[:byte-size-single-element-array (available - 2)];
} UnsequencedDataPacket;

// The SesM client uses this packet to allow the server to authenticate the client and to convey to the server the last sequenced packet that the client received
typedef struct _LoginRequest {
  UINT8 sesm_version[5];             // bytes 0 to 4
  UINT8 username[5];                 // bytes 5 to 9
  UINT8 computer_id[8];              // bytes 10 to 17
  UINT8 application_protocol[8];     // bytes 18 to 25
  UINT8 requested_session;           // byte 26
  UINT64 requested_sequence_number;  // bytes 27 to 34
} LoginRequest;

// The SesM server sends a Login response packet in response to a Login request packet from the client
typedef struct _LoginResponse {
  UINT8 login_status;              // byte 0
  UINT8 session_id;                // byte 1
  UINT64 highest_sequence_number;  // bytes 2 to 9
} LoginResponse;

// The SesM client uses this packet to request the server to retransmit a range of packets
typedef struct _RetransmissionRequest {
  UINT64 start_sequence_number;  // bytes 0 to 7
  UINT64 end_sequence_number;    // bytes 8 to 15
} RetransmissionRequest;

// The client may send a Logout request packet to request the connection be terminated
typedef struct _LogoutRequest (UINT16 sesm_packet_length) where (sesm_packet_length >= 2) {
  UINT8 logout_reason;                                     // byte 0
  UINT8 logout_text[(((UINT32) sesm_packet_length) - 2)];
} LogoutRequest;

// The server may send a GoodBye packet to inform the client a reason for termination of the connection just before it terminates the connection
typedef struct _GoodbyePacket (UINT16 sesm_packet_length) where (sesm_packet_length >= 2) {
  UINT8 goodbye_reason;                                    // byte 0
  UINT8 logout_text[(((UINT32) sesm_packet_length) - 2)];
} GoodbyePacket;

// A Test packet can be sent by either side of a SesM connection at anytime; Test packets are intended to provide human readable text that may aid in debugging problems
typedef struct _TestPacket (UINT16 sesm_packet_length) where (sesm_packet_length >= 1) {
  UINT8 test_text[(((UINT32) sesm_packet_length) - 1)];
} TestPacket;

// Branch
casetype _SesmPayload (UINT8 selector, UINT32 length, UINT32 length_2, UINT16 sesm_packet_length, UINT32 available) {
  switch (selector) {
    case 0x53: SequencedDataPacket(length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x55: UnsequencedDataPacket(length_2) unsequenced_data_packet[:byte-size-single-element-array length_2];
    case 0x4C: LoginRequest login_request;
    case 0x52: LoginResponse login_response;
    case 0x43: unit synchronization_complete;
    case 0x41: RetransmissionRequest retransmission_request;
    case 0x58: LogoutRequest(sesm_packet_length) logout_request;
    case 0x47: GoodbyePacket(sesm_packet_length) goodbye_packet;
    case 0x45: unit end_of_session;
    case 0x30: unit server_heartbeat;
    case 0x31: unit client_heartbeat;
    case 0x54: TestPacket(sesm_packet_length) test_packet;
    default: UINT8 unknown[available];
  }
} SesmPayload;

// SesM Tcp Packet
typedef struct _SesmTcpPacket {
  UINT16 sesm_packet_length { sesm_packet_length >= 1 };                                                                                                                                                                                                           // bytes 0 to 1
  UINT8 sesm_packet_type;                                                                                                                                                                                                                                          // byte 2
  SesmPayload(sesm_packet_type, (((UINT32) sesm_packet_length) - 1), (((UINT32) sesm_packet_length) - 1), sesm_packet_length, ((((UINT32) sesm_packet_length) + 2) - 3)) sesm_payload[:byte-size-single-element-array ((((UINT32) sesm_packet_length) + 2) - 3)];
} SesmTcpPacket;

// ---- Packet: Packet ----------------------------------------------------------

// SesM Packet
entrypoint typedef struct _Packet (UINT32 available) {
  SesmTcpPacket sesm_tcp_packet[:byte-size available];
} Packet;

