// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, UdpPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out EmeraldOptions_Ais_v1_0_b_Udp.3d

// ---- Values ------------------------------------------------------------------

// Packet Type: one byte code
#define PACKET_TYPE_HEARTBEAT 0x00            // Heartbeat
#define PACKET_TYPE_START_OF_SESSION 0x01     // Start Of Session
#define PACKET_TYPE_END_OF_SESSION 0x02       // End Of Session
#define PACKET_TYPE_APPLICATION_MESSAGE 0x03  // Application Message

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_TIME_MESSAGE 0x31                                   // System Time Message
#define MESSAGE_TYPE_SIMPLE_SERIES_UPDATE_MESSAGE 0x50                          // Simple Series Update Message
#define MESSAGE_TYPE_COMPLEX_STRATEGY_DEFINITION_UPDATE_MESSAGE 0x43            // Complex Strategy Definition Update Message
#define MESSAGE_TYPE_SYSTEM_STATE_MESSAGE 0x53                                  // System State Message
#define MESSAGE_TYPE_SIMPLE_LIQUIDITY_SEEKING_EVENT_NOTIFICATION_MESSAGE 0x4C   // Simple Liquidity Seeking Event Notification Message
#define MESSAGE_TYPE_COMPLEX_LIQUIDITY_SEEKING_EVENT_NOTIFICATION_MESSAGE 0x6C  // Complex Liquidity Seeking Event Notification Message
#define MESSAGE_TYPE_UNDERLYING_TRADING_STATUS_NOTIFICATION_MESSAGE 0x48        // Underlying Trading Status Notification Message

// Call Or Put: one byte code
#define CALL_OR_PUT_CALL 0x43  // Call
#define CALL_OR_PUT_PUT 0x50   // Put

// Restricted Option: one byte code
#define RESTRICTED_OPTION_YES 0x59  // Yes
#define RESTRICTED_OPTION_NO 0x4E   // No

// Long Term Option: one byte code
#define LONG_TERM_OPTION_YES 0x59  // Yes
#define LONG_TERM_OPTION_NO 0x4E   // No

// Active On Emerald: one byte code
#define ACTIVE_ON_EMERALD_ACTIVE 0x41    // Active
#define ACTIVE_ON_EMERALD_INACTIVE 0x49  // Inactive

// Emerald Bbo Posting Increment Indicator: one byte code
#define EMERALD_BBO_POSTING_INCREMENT_INDICATOR_PENNY 0x50            // Penny
#define EMERALD_BBO_POSTING_INCREMENT_INDICATOR_PENNY_OR_NICKEL 0x4E  // Penny Or Nickel
#define EMERALD_BBO_POSTING_INCREMENT_INDICATOR_NICKEL_OR_DIME 0x44   // Nickel Or Dime

// Liquidity Acceptance Increment Indicator: one byte code
#define LIQUIDITY_ACCEPTANCE_INCREMENT_INDICATOR_PENNY 0x50            // Penny
#define LIQUIDITY_ACCEPTANCE_INCREMENT_INDICATOR_PENNY_OR_NICKEL 0x4E  // Penny Or Nickel
#define LIQUIDITY_ACCEPTANCE_INCREMENT_INDICATOR_NICKEL_OR_DIME 0x44   // Nickel Or Dime

// Opening Underlying Market Code: one byte code
#define OPENING_UNDERLYING_MARKET_CODE_NYSE_AMEX 0x41                          // Nyse Amex
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_TEXAS 0x42                       // Nasdaq Texas
#define OPENING_UNDERLYING_MARKET_CODE_NATIONAL_STOCK_EXCHANGE 0x43            // National Stock Exchange
#define OPENING_UNDERLYING_MARKET_CODE_FINRA_ADF 0x44                          // Finra Adf
#define OPENING_UNDERLYING_MARKET_CODE_MARKET_INDEPENDENT 0x45                 // Market Independent
#define OPENING_UNDERLYING_MARKET_CODE_TXSE 0x46                               // Txse
#define OPENING_UNDERLYING_MARKET_CODE_MIAX_PEARL_EQUITIES 0x48                // Miax Pearl Equities
#define OPENING_UNDERLYING_MARKET_CODE_INTERNATIONAL_SECURITIES_EXCHANGE 0x49  // International Securities Exchange
#define OPENING_UNDERLYING_MARKET_CODE_EDGA_EXCHANGE_INC 0x4A                  // Edga Exchange Inc
#define OPENING_UNDERLYING_MARKET_CODE_EDGX_EXCHANGE_INC 0x4B                  // Edgx Exchange Inc
#define OPENING_UNDERLYING_MARKET_CODE_LTSE 0x4C                               // Ltse
#define OPENING_UNDERLYING_MARKET_CODE_CHICAGO_STOCK_EXCHANGE 0x4D             // Chicago Stock Exchange
#define OPENING_UNDERLYING_MARKET_CODE_NYSE_EURONEXT 0x4E                      // Nyse Euronext
#define OPENING_UNDERLYING_MARKET_CODE_NYSE_ARCA_EXCHANGE 0x50                 // Nyse Arca Exchange
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_UTP 0x51                     // Nasdaq Omx Utp
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_CTA 0x54                     // Nasdaq Omx Cta
#define OPENING_UNDERLYING_MARKET_CODE_MEMX 0x55                               // Memx
#define OPENING_UNDERLYING_MARKET_CODE_IEX 0x56                                // Iex
#define OPENING_UNDERLYING_MARKET_CODE_CBOE_STOCK_EXCHANGE 0x57                // Cboe Stock Exchange
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_PHLX 0x58                    // Nasdaq Omx Phlx
#define OPENING_UNDERLYING_MARKET_CODE_BATS_Y_EXCHANGE_INC 0x59                // Bats Y Exchange Inc
#define OPENING_UNDERLYING_MARKET_CODE_BATS_EXCHANGE_INC 0x5A                  // Bats Exchange Inc

// Update Reason: one byte code
#define UPDATE_REASON_NEW_STRATEGY_CREATED 0x4E  // New Strategy Created
#define UPDATE_REASON_UPDATED 0x55               // Updated

// Leg Side: one byte code
#define LEG_SIDE_BID 0x42  // Bid
#define LEG_SIDE_ASK 0x41  // Ask

// System Status: one byte code
#define SYSTEM_STATUS_START_OF_SYSTEM_HOURS 0x53  // Start Of System Hours
#define SYSTEM_STATUS_END_OF_SYSTEM_HOURS 0x43    // End Of System Hours
#define SYSTEM_STATUS_START_OF_TEST_SESSION 0x31  // Start Of Test Session
#define SYSTEM_STATUS_END_OF_TEST_SESSION 0x32    // End Of Test Session

// Event Type: one byte code
#define EVENT_TYPE_OPENING_REOPENING_IMBALANCE_MECHANISM 0x4F   // Opening Reopening Imbalance Mechanism
#define EVENT_TYPE_OPENING_ROUTE_MECHANISM 0x52                 // Opening Route Mechanism
#define EVENT_TYPE_EMERALD_PRIME_PAIRED_ORDER 0x50              // Emerald Prime Paired Order
#define EVENT_TYPE_SETTLEMENT_OPENING_IMBALANCE_MECHANISM 0x53  // Settlement Opening Imbalance Mechanism
#define EVENT_TYPE_LIQUIDITY_EXPOSURE_PROCESS 0x45              // Liquidity Exposure Process
#define EVENT_TYPE_COMPLEX_ORDER_AUCTION 0x43                   // Complex Order Auction

// Imbalance Side: one byte code
#define IMBALANCE_SIDE_BID 0x42  // Bid
#define IMBALANCE_SIDE_ASK 0x41  // Ask

// Side: one byte code
#define SIDE_BID 0x42  // Bid
#define SIDE_ASK 0x41  // Ask

// Trading Status: one byte code
#define TRADING_STATUS_HALTED 0x48   // Halted
#define TRADING_STATUS_RESUMED 0x52  // Resumed
#define TRADING_STATUS_OPENED 0x4F   // Opened
#define TRADING_STATUS_CLOSED 0x43   // Closed

// Event Reason: one byte code
#define EVENT_REASON_AUTOMATIC 0x41  // Automatic
#define EVENT_REASON_MANUAL 0x4D     // Manual

// ---- Types -------------------------------------------------------------------

// This is the message format that will be used to disseminate the seconds part of the timestamp that is applicable to all messages that are sent in the current second.
typedef struct _SystemTimeMessage {
  UINT32 seconds;  // bytes 0 to 3
} SystemTimeMessage;

// This is the message format that will be used to disseminate all Option series traded on Emerald for the current session.
typedef struct _SimpleSeriesUpdateMessage {
  UINT32 nanoseconds;                              // bytes 0 to 3
  UINT32 product_id;                               // bytes 4 to 7
  UINT8 underlying_symbol[11];                     // bytes 8 to 18
  UINT8 security_symbol[6];                        // bytes 19 to 24
  UINT8 expiration_date[8];                        // bytes 25 to 32
  UINT32 strike_price;                             // bytes 33 to 36
  UINT8 call_or_put;                               // byte 37
  UINT8 opening_time[8];                           // bytes 38 to 45
  UINT8 closing_time[8];                           // bytes 46 to 53
  UINT8 restricted_option;                         // byte 54
  UINT8 long_term_option;                          // byte 55
  UINT8 active_on_emerald;                         // byte 56
  UINT8 emerald_bbo_posting_increment_indicator;   // byte 57
  UINT8 liquidity_acceptance_increment_indicator;  // byte 58
  UINT8 opening_underlying_market_code;            // byte 59
  UINT32 priority_quote_width;                     // bytes 60 to 63
  UINT8 reserved_8[8];                             // bytes 64 to 71
} SimpleSeriesUpdateMessage;

// Complex Strategy Number of Legs
typedef struct _LegDefinition {
  UINT32 product_id;     // bytes 0 to 3
  UINT16 leg_ratio_qty;  // bytes 4 to 5
  UINT8 leg_side;        // byte 6
  UINT8 reserved_8[8];   // bytes 7 to 14
} LegDefinition;

// This is the message format that will be used to disseminate stock option strategies traded on Emerald for the current session.
typedef struct _ComplexStrategyDefinitionUpdateMessage {
  UINT32 nanoseconds;                                                         // bytes 0 to 3
  UINT32 strategy_id;                                                         // bytes 4 to 7
  UINT8 underlying_symbol[11];                                                // bytes 8 to 18
  UINT8 active_on_emerald;                                                    // byte 19
  UINT8 reserved_1;                                                           // byte 20
  UINT8 update_reason;                                                        // byte 21
  UINT8 reserved_10[10];                                                      // bytes 22 to 31
  UINT8 number_of_legs;                                                       // byte 32
  LegDefinition leg_definition[:byte-size (((UINT32) number_of_legs) * 15)];
} ComplexStrategyDefinitionUpdateMessage;

// This message format is used to notify the firms of the state changes of the system. This is a notification that applies to each Underlying group. Firms can use notifications as triggers in their system to ensure electronic synchronization of systems.
typedef struct _SystemStateMessage {
  UINT32 nanoseconds;    // bytes 0 to 3
  UINT8 ais_version[8];  // bytes 4 to 11
  UINT32 session_id;     // bytes 12 to 15
  UINT8 system_status;   // byte 16
} SystemStateMessage;

// This is the message format that will be used to disseminate information each time a Liquidity seeking event (defined in Event Type field below) starts at Emerald.
typedef struct _SimpleLiquiditySeekingEventNotificationMessage {
  UINT32 nanoseconds;        // bytes 0 to 3
  UINT32 product_id;         // bytes 4 to 7
  UINT8 event_type;          // byte 8
  UINT32 event_id;           // bytes 9 to 12
  UINT32 price_short;        // bytes 13 to 16
  UINT8 imbalance_side;      // byte 17
  UINT32 quantity_1;         // bytes 18 to 21
  UINT32 quantity_2;         // bytes 22 to 25
  UINT32 quantity_3;         // bytes 26 to 29
  UINT32 quantity_4;         // bytes 30 to 33
  UINT8 attributable_id[4];  // bytes 34 to 37
  UINT8 reserved_8[8];       // bytes 38 to 45
} SimpleLiquiditySeekingEventNotificationMessage;

// This is the message format that will be used to disseminate information each time a Liquidity seeking event (defined in Event Type field below) starts at Emerald
typedef struct _ComplexLiquiditySeekingEventNotificationMessage {
  UINT32 nanoseconds;         // bytes 0 to 3
  UINT32 strategy_id;         // bytes 4 to 7
  UINT8 event_type;           // byte 8
  UINT32 event_id;            // bytes 9 to 12
  UINT8 side;                 // byte 13
  UINT64 price_long;          // bytes 14 to 21, signed, read here as unsigned
  UINT32 matched_quantity;    // bytes 22 to 25
  UINT32 imbalance_quantity;  // bytes 26 to 29, signed, read here as unsigned
  UINT8 attributable_id[4];   // bytes 30 to 33
  UINT8 reserved_8[8];        // bytes 34 to 41
} ComplexLiquiditySeekingEventNotificationMessage;

// This message format will be used to notify firms of changes to the trading status of all the options of an underlying.
typedef struct _UnderlyingTradingStatusNotificationMessage {
  UINT32 nanoseconds;                            // bytes 0 to 3
  UINT8 underlying_symbol[11];                   // bytes 4 to 14
  UINT8 trading_status;                          // byte 15
  UINT8 event_reason;                            // byte 16
  UINT32 expected_event_time_seconds_part;       // bytes 17 to 20
  UINT32 expected_event_time_nano_seconds_part;  // bytes 21 to 24
} UnderlyingTradingStatusNotificationMessage;

// Branch
casetype _Data (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x31: SystemTimeMessage system_time_message;
    case 0x50: SimpleSeriesUpdateMessage simple_series_update_message;
    case 0x43: ComplexStrategyDefinitionUpdateMessage complex_strategy_definition_update_message;
    case 0x53: SystemStateMessage system_state_message;
    case 0x4C: SimpleLiquiditySeekingEventNotificationMessage simple_liquidity_seeking_event_notification_message;
    case 0x6C: ComplexLiquiditySeekingEventNotificationMessage complex_liquidity_seeking_event_notification_message;
    case 0x48: UnderlyingTradingStatusNotificationMessage underlying_trading_status_notification_message;
    default: UINT8 unknown[available];
  }
} Data;

typedef struct _ApplicationMessage (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                         // byte 0
  Data(message_type, (available - 1)) data[:byte-size-single-element-array (available - 1)];
} ApplicationMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 length, UINT32 available) {
  switch (selector) {
    case 0x00: unit heartbeat;
    case 0x01: unit start_of_session;
    case 0x02: unit end_of_session;
    case 0x03: ApplicationMessage(length) application_message[:byte-size-single-element-array length];
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _MachMessage {
  UINT64 sequence_number;                                                                                                                                           // bytes 0 to 7
  UINT16 packet_length { packet_length >= 12 };                                                                                                                     // bytes 8 to 9
  UINT8 packet_type;                                                                                                                                                // byte 10
  UINT8 session_number;                                                                                                                                             // byte 11
  Payload(packet_type, (((UINT32) packet_length) - 12), (((UINT32) packet_length) - 12)) payload[:byte-size-single-element-array (((UINT32) packet_length) - 12)];
} MachMessage;

// ---- Packet: UdpPacket -------------------------------------------------------

entrypoint typedef struct _UdpPacket (UINT32 available) {
  MachMessage mach_message[:byte-size available];
} UdpPacket;

