// ---- Esesm Packet Header: 3 bytes --------------------------------------------

// ESesM packet header
entrypoint typedef struct _EsesmPacketHeader {
  UINT16 esesm_packet_length;  // bytes 0 to 1
  UINT8 esesm_packet_type;     // byte 2
} EsesmPacketHeader;

// ---- Refresh Request Message: 1 byte -----------------------------------------

// Sent by the firm over the ToM Retransmission Interface (ESeSM Unsequenced Data Packet) to request a Last Value Refresh of a particular data set identified by Refresh Message Type.
entrypoint typedef struct _RefreshRequestMessage {
  UINT8 refresh_message_type;  // byte 0
} RefreshRequestMessage;

// ---- Refresh Response Message: 8 bytes ---------------------------------------

// Sent by MIAX Pearl Equities over the ToM Retransmission Interface (ESeSM Unsequenced Data Packet) carrying one Application Message that satisfies a previous Refresh Request.
entrypoint typedef struct _RefreshResponseMessage {
  UINT64 sequence_number;  // bytes 0 to 7
} RefreshResponseMessage;

// ---- End Of Refresh Notification Message: 1 byte -----------------------------

// Sent by MIAX Pearl Equities over the ToM Retransmission Interface (ESeSM Unsequenced Data Packet) when the refresh response is complete.
entrypoint typedef struct _EndOfRefreshNotificationMessage {
  UINT8 refresh_message_type;  // byte 0
} EndOfRefreshNotificationMessage;

// ---- Synchronization Complete: 1 byte ----------------------------------------

// The ESesM server sends a Synchronization complete packet when it is done replaying all the old packets and is ready to start sending new packets from the Matching Engine
entrypoint typedef struct _SynchronizationComplete {
  UINT8 matching_engine_id;  // byte 0
} SynchronizationComplete;

// ---- Retransmission Request: 16 bytes ----------------------------------------

// The ESesM client uses this packet to request a retransmission server to retransmit a range of packets
entrypoint typedef struct _RetransmissionRequest {
  UINT64 start_sequence_number;  // bytes 0 to 7
  UINT64 end_sequence_number;    // bytes 8 to 15
} RetransmissionRequest;

// ---- Trading Session Update: 2 bytes -----------------------------------------

// The ESesM server sends a Trading Session Update packet to inform the client that a new trading session is starting on the specified Matching Engine
entrypoint typedef struct _TradingSessionUpdate {
  UINT8 matching_engine_id;  // byte 0
