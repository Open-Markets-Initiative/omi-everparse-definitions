// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, UdpPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PearlEquities_DepthOfMarket_v1_3_d_Udp.3d

// ---- Values ------------------------------------------------------------------

// Mach Packet Type: one byte code
#define MACH_PACKET_TYPE_HEARTBEAT 0x00            // Heartbeat
#define MACH_PACKET_TYPE_START_OF_SESSION 0x01     // Start Of Session
#define MACH_PACKET_TYPE_END_OF_SESSION 0x02       // End Of Session
#define MACH_PACKET_TYPE_APPLICATION_MESSAGE 0x03  // Application Message

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_TIME_MESSAGE 0x31                           // System Time Message
#define MESSAGE_TYPE_SYMBOL_UPDATE_MESSAGE 0x01                         // Symbol Update Message
#define MESSAGE_TYPE_SYSTEM_STATE_MESSAGE 0x53                          // System State Message
#define MESSAGE_TYPE_SECURITY_TRADING_STATUS_NOTIFICATION_MESSAGE 0x04  // Security Trading Status Notification Message
#define MESSAGE_TYPE_SYMBOL_CLEAR_MESSAGE 0x05                          // Symbol Clear Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x14                             // Add Order Message
#define MESSAGE_TYPE_MODIFY_ORDER_MESSAGE 0x15                          // Modify Order Message
#define MESSAGE_TYPE_DELETE_ORDER_MESSAGE 0x17                          // Delete Order Message
#define MESSAGE_TYPE_ORDER_EXECUTION_MESSAGE 0x18                       // Order Execution Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x0A                                 // Trade Message
#define MESSAGE_TYPE_TRADE_CANCEL_MESSAGE 0x0B                          // Trade Cancel Message

// Test Security Indicator: one byte code
#define TEST_SECURITY_INDICATOR_YES 0x59  // Yes
#define TEST_SECURITY_INDICATOR_NO 0x4E   // No

// Primary Market Code: one byte code
#define PRIMARY_MARKET_CODE_NYSE_AMERICAN 0x41             // Nyse American
#define PRIMARY_MARKET_CODE_NASDAQ_TEXAS 0x42              // Nasdaq Texas
#define PRIMARY_MARKET_CODE_NYSE_NATIONAL 0x43             // Nyse National
#define PRIMARY_MARKET_CODE_TEXAS_STOCK_EXCHANGE 0x46      // Texas Stock Exchange
#define PRIMARY_MARKET_CODE_N24_X_EXCHANGE 0x47            // N24X Exchange
#define PRIMARY_MARKET_CODE_MIAX_PEARL_EQUITIES 0x48       // Miax Pearl Equities
#define PRIMARY_MARKET_CODE_NASDAQ_ISE 0x49                // Nasdaq Ise
#define PRIMARY_MARKET_CODE_CBOE_EDGA_EXCHANGE 0x4A        // Cboe Edga Exchange
#define PRIMARY_MARKET_CODE_CBOE_EDGX_EXCHANGE 0x4B        // Cboe Edgx Exchange
#define PRIMARY_MARKET_CODE_LONG_TERM_STOCK_EXCHANGE 0x4C  // Long Term Stock Exchange
#define PRIMARY_MARKET_CODE_NYSE_TEXAS 0x4D                // Nyse Texas
#define PRIMARY_MARKET_CODE_NEW_YORK_STOCK_EXCHANGE 0x4E   // New York Stock Exchange
#define PRIMARY_MARKET_CODE_NYSE_ARCA 0x50                 // Nyse Arca
#define PRIMARY_MARKET_CODE_NASDAQ 0x51                    // Nasdaq
#define PRIMARY_MARKET_CODE_MEMBERS_EXCHANGE 0x55          // Members Exchange
#define PRIMARY_MARKET_CODE_INVESTORS_EXCHANGE 0x56        // Investors Exchange
#define PRIMARY_MARKET_CODE_CBOE_STOCK_EXCHANGE 0x57       // Cboe Stock Exchange
#define PRIMARY_MARKET_CODE_NASDAQ_PHLX 0x58               // Nasdaq Phlx
#define PRIMARY_MARKET_CODE_CBOE_BYX_EXCHANGE 0x59         // Cboe Byx Exchange
#define PRIMARY_MARKET_CODE_CBOE_BZX_EXCHANGE 0x5A         // Cboe Bzx Exchange

// System Status: one byte code
#define SYSTEM_STATUS_START_OF_SYSTEM_HOURS 0x53  // Start Of System Hours
#define SYSTEM_STATUS_END_OF_SYSTEM_HOURS 0x43    // End Of System Hours
#define SYSTEM_STATUS_START_OF_TEST_SESSION 0x31  // Start Of Test Session
#define SYSTEM_STATUS_END_OF_TEST_SESSION 0x32    // End Of Test Session

// Trading Status: one byte code
#define TRADING_STATUS_PRE_OPEN 0x01          // Pre Open
#define TRADING_STATUS_TRADING 0x02           // Trading
#define TRADING_STATUS_HALT 0x03              // Halt
#define TRADING_STATUS_OPERATIONAL_HALT 0x04  // Operational Halt
#define TRADING_STATUS_CLOSED 0x05            // Closed

// Market State: one byte code
#define MARKET_STATE_PRE_OPENING 0x01              // Pre Opening
#define MARKET_STATE_EARLY_TRADING_SESSION 0x02    // Early Trading Session
#define MARKET_STATE_REGULAR_TRADING_SESSION 0x03  // Regular Trading Session
#define MARKET_STATE_LATE_TRADING_SESSION 0x04     // Late Trading Session

// Short Sale Restriction: one byte code
#define SHORT_SALE_RESTRICTION_SHORT_SALE_RESTRICTION_IS_IN_EFFECT 0x59      // Short Sale Restriction Is In Effect
#define SHORT_SALE_RESTRICTION_SHORT_SALE_RESTRICTION_IS_NOT_IN_EFFECT 0x4E  // Short Sale Restriction Is Not In Effect

// Order Side: one byte code
#define ORDER_SIDE_BUY 0x42   // Buy
#define ORDER_SIDE_SELL 0x53  // Sell

// ---- Types -------------------------------------------------------------------

// This message is used to disseminate the seconds part of the timestamp that is applicable to all messages that are sent in the current second.
typedef struct _SystemTimeMessage {
  UINT32 seconds;  // bytes 0 to 3
} SystemTimeMessage;

// This is the message format that will be used to disseminate all security symbols traded on MIAX Pearl Equities for the current trading session. The Symbol ID sent in this message will be disseminated in Depth of Market messages.
typedef struct _SymbolUpdateMessage {
  UINT32 nanoseconds;             // bytes 0 to 3
  UINT32 symbol_id;               // bytes 4 to 7
  UINT8 ticker_symbol[11];        // bytes 8 to 18
  UINT8 reserved_1;               // byte 19
  UINT8 test_security_indicator;  // byte 20
  UINT8 second_reserved_1;        // byte 21
  UINT16 lot_size;                // bytes 22 to 23
  UINT8 opening_time[8];          // bytes 24 to 31
  UINT8 closing_time[8];          // bytes 32 to 39
  UINT8 primary_market_code;      // byte 40
} SymbolUpdateMessage;

// This is the message format that will be used to notify firms of the state changes of the system. This is a notification that applies to all symbols on the feed.
typedef struct _SystemStateMessage {
  UINT32 nanoseconds;     // bytes 0 to 3
  UINT8 do_m_version[8];  // bytes 4 to 11
  UINT8 session_id;       // byte 12
  UINT8 system_status;    // byte 13
} SystemStateMessage;

// This message is used to notify firms of changes to the trading status of a particular security.
typedef struct _SecurityTradingStatusNotificationMessage {
  UINT32 nanoseconds;            // bytes 0 to 3
  UINT32 symbol_id;              // bytes 4 to 7
  UINT8 trading_status;          // byte 8
  UINT8 market_state;            // byte 9
  UINT8 short_sale_restriction;  // byte 10
} SecurityTradingStatusNotificationMessage;

// This message format is used to indicate that the MIAX Pearl Equities book for a symbol has been cleared of all orders.
typedef struct _SymbolClearMessage {
  UINT32 nanoseconds;  // bytes 0 to 3
  UINT32 symbol_id;    // bytes 4 to 7
} SymbolClearMessage;

// This is the message format that will be used when a displayed order is received and added to MIAX Pearl Equities book. It includes an Order ID that is unique to the order across the exchange and across trading days.
typedef struct _AddOrderMessage {
  UINT32 nanoseconds;        // bytes 0 to 3
  UINT32 symbol_id;          // bytes 4 to 7
  UINT64 order_id;           // bytes 8 to 15
  UINT8 order_side;          // byte 16
  UINT64 price;              // bytes 17 to 24
  UINT32 size;               // bytes 25 to 28
  UINT8 attributable_id[4];  // bytes 29 to 32
} AddOrderMessage;

// This message format is used to publish price/size changes for an existing displayed order on MIAX Pearl Equities book.
typedef struct _ModifyOrderMessage {
  UINT32 nanoseconds;        // bytes 0 to 3
  UINT32 symbol_id;          // bytes 4 to 7
  UINT64 order_id;           // bytes 8 to 15
  UINT64 price;              // bytes 16 to 23
  UINT32 size;               // bytes 24 to 27
  UINT8 order_position : 1;  // byte 28
  UINT8 reserved_7 : 7;      // byte 28
} ModifyOrderMessage;

// This message format is used to indicate that a displayed order has been removed from the MIAX Pearl Equities book.
typedef struct _DeleteOrderMessage {
  UINT32 nanoseconds;  // bytes 0 to 3
  UINT32 symbol_id;    // bytes 4 to 7
  UINT64 order_id;     // bytes 8 to 15
} DeleteOrderMessage;

// This message format is used when a displayed order on the book executes in whole or in part. The execution is identified by a unique Trade ID that is unique across the exchange for the trading day. Subsequent partial executions of the order would be published with the same Order ID but different Trade ID.
typedef struct _OrderExecutionMessage {
  UINT32 nanoseconds;               // bytes 0 to 3
  UINT32 symbol_id;                 // bytes 4 to 7
  UINT64 order_id;                  // bytes 8 to 15
  UINT64 trade_id;                  // bytes 16 to 23
  UINT64 price;                     // bytes 24 to 31
  UINT32 size;                      // bytes 32 to 35
  UINT8 sip_reporting : 1;          // byte 36
  UINT8 traded_against_retail : 1;  // byte 36
  UINT8 reserved_6 : 6;             // byte 36
} OrderExecutionMessage;

// This message format is used to publish trade executions for orders not displayed on the book. Executions for orders routed and executed in another trading center and trade corrections are also published using this message.
typedef struct _TradeMessage {
  UINT32 nanoseconds;                // bytes 0 to 3
  UINT32 symbol_id;                  // bytes 4 to 7
  UINT64 trade_id;                   // bytes 8 to 15
  UINT8 correction_number;           // byte 16
  UINT64 price;                      // bytes 17 to 24
  UINT32 size;                       // bytes 25 to 28
  UINT8 sip_reporting : 1;           // byte 29
  UINT8 retail_trade_indicator : 1;  // byte 29
  UINT8 reserved_6 : 6;              // byte 29
} TradeMessage;

// This message format is used to publish cancellation of a trade which was previously published via an Order Execution Message or a Trade Message.
typedef struct _TradeCancelMessage {
  UINT32 nanoseconds;       // bytes 0 to 3
  UINT32 symbol_id;         // bytes 4 to 7
  UINT64 trade_id;          // bytes 8 to 15
  UINT8 correction_number;  // byte 16
  UINT64 price;             // bytes 17 to 24
  UINT32 size;              // bytes 25 to 28
} TradeCancelMessage;

// Branch
casetype _Data (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x31: SystemTimeMessage system_time_message;
    case 0x01: SymbolUpdateMessage symbol_update_message;
    case 0x53: SystemStateMessage system_state_message;
    case 0x04: SecurityTradingStatusNotificationMessage security_trading_status_notification_message;
    case 0x05: SymbolClearMessage symbol_clear_message;
    case 0x14: AddOrderMessage add_order_message;
    case 0x15: ModifyOrderMessage modify_order_message;
    case 0x17: DeleteOrderMessage delete_order_message;
    case 0x18: OrderExecutionMessage order_execution_message;
    case 0x0A: TradeMessage trade_message;
    case 0x0B: TradeCancelMessage trade_cancel_message;
    default: UINT8 unknown[available];
  }
} Data;

typedef struct _ApplicationMessage (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                         // byte 0
  Data(message_type, (available - 1)) data[:byte-size-single-element-array (available - 1)];
} ApplicationMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 length, UINT32 available) {
  switch (selector) {
    case 0x00: unit heartbeat;
    case 0x01: unit start_of_session;
    case 0x02: unit end_of_session;
    case 0x03: ApplicationMessage(length) application_message[:byte-size-single-element-array length];
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _MachMessage {
  UINT64 sequence_number;                                                                                                                                                               // bytes 0 to 7
  UINT16 mach_packet_length { mach_packet_length >= 12 };                                                                                                                               // bytes 8 to 9
  UINT8 mach_packet_type;                                                                                                                                                               // byte 10
  UINT8 session_number;                                                                                                                                                                 // byte 11
  Payload(mach_packet_type, (((UINT32) mach_packet_length) - 12), (((UINT32) mach_packet_length) - 12)) payload[:byte-size-single-element-array (((UINT32) mach_packet_length) - 12)];
} MachMessage;

// ---- Packet: UdpPacket -------------------------------------------------------

entrypoint typedef struct _UdpPacket (UINT32 available) {
  MachMessage mach_message[:byte-size available];
} UdpPacket;

