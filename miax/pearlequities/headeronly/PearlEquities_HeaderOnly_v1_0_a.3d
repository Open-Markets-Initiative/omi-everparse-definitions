// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PearlEquities_HeaderOnly_v1_0_a.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - a length prefix framing what follows
// - a run counted by a field
// - the packet as a whole, which is a field of no fixed width, at packet.esesmtcppacket.esesmpayload.sequenceddatapacket.sequencedmessage

// ---- Values ------------------------------------------------------------------

// Esesm Packet Type: one byte code
#define ESESM_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x73     // Sequenced Data Packet
#define ESESM_PACKET_TYPE_UNSEQUENCED_DATA_PACKET 0x55   // Unsequenced Data Packet
#define ESESM_PACKET_TYPE_LOGIN_REQUEST 0x6C             // Login Request
#define ESESM_PACKET_TYPE_LOGIN_RESPONSE 0x72            // Login Response
#define ESESM_PACKET_TYPE_SYNCHRONIZATION_COMPLETE 0x63  // Synchronization Complete
#define ESESM_PACKET_TYPE_RETRANSMISSION_REQUEST 0x61    // Retransmission Request
#define ESESM_PACKET_TYPE_LOGOUT_REQUEST 0x58            // Logout Request
#define ESESM_PACKET_TYPE_GOODBYE_PACKET 0x47            // Goodbye Packet
#define ESESM_PACKET_TYPE_TRADING_SESSION_UPDATE 0x75    // Trading Session Update
#define ESESM_PACKET_TYPE_SERVER_HEARTBEAT 0x30          // Server Heartbeat
#define ESESM_PACKET_TYPE_CLIENT_HEARTBEAT 0x31          // Client Heartbeat
#define ESESM_PACKET_TYPE_TEST_PACKET 0x54               // Test Packet

// ---- Esesm Packet Header: 3 bytes --------------------------------------------

// ESesM packet header
entrypoint typedef struct _EsesmPacketHeader {
  UINT16 esesm_packet_length;  // bytes 0 to 1
  UINT8 esesm_packet_type;     // byte 2, values ESESM_PACKET_TYPE_
} EsesmPacketHeader;

// ---- Synchronization Complete: 1 byte ----------------------------------------

// The ESesM server sends a Synchronization complete packet when it is done replaying all the old packets and is ready to start sending new packets from the Matching Engine
entrypoint typedef struct _SynchronizationComplete {
  UINT8 matching_engine_id;  // byte 0
} SynchronizationComplete;

// ---- Retransmission Request: 16 bytes ----------------------------------------

// The ESesM client uses this packet to request a retransmission server to retransmit a range of packets
entrypoint typedef struct _RetransmissionRequest {
  UINT64 start_sequence_number;  // bytes 0 to 7
  UINT64 end_sequence_number;    // bytes 8 to 15
} RetransmissionRequest;

// ---- Trading Session Update: 2 bytes -----------------------------------------

// The ESesM server sends a Trading Session Update packet to inform the client that a new trading session is starting on the specified Matching Engine
entrypoint typedef struct _TradingSessionUpdate {
  UINT8 matching_engine_id;  // byte 0
  UINT8 trading_session_id;  // byte 1
} TradingSessionUpdate;

