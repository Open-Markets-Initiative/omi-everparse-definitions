#define UNSEQUENCED_MESSAGE_TYPE_MODIFY_ORDER_REQUEST_MESSAGE 0x4D31              // Modify Order Request Message
#define UNSEQUENCED_MESSAGE_TYPE_MODIFY_ORDER_RESPONSE 0x4D52                     // Modify Order Response
#define UNSEQUENCED_MESSAGE_TYPE_CANCEL_ORDER_REQUEST 0x434F                      // Cancel Order Request
#define UNSEQUENCED_MESSAGE_TYPE_CANCEL_ORDER_RESPONSE 0x4352                     // Cancel Order Response
#define UNSEQUENCED_MESSAGE_TYPE_MASS_CANCEL_REQUEST 0x5851                       // Mass Cancel Request
#define UNSEQUENCED_MESSAGE_TYPE_MASS_CANCEL_RESPONSE 0x5852                      // Mass Cancel Response
#define UNSEQUENCED_MESSAGE_TYPE_RESERVE_ORDER_REPLENISHMENT_NOTIFICATION 0x5241  // Reserve Order Replenishment Notification
#define UNSEQUENCED_MESSAGE_TYPE_EXECUTION_NOTIFICATION 0x454E                    // Execution Notification

// Scope: one byte code
#define SCOPE_PURGE_ALL_ORDERS_FOR_SPECIFIED_MPID 0x4D  // Purge All Orders For Specified Mpid

// Action: one byte code
#define ACTION_BLOCK_ONLY 0x42                               // Block Only
#define ACTION_MASS_CANCEL_ONLY 0x4D                         // Mass Cancel Only
#define ACTION_BLOCK_AND_MASS_CANCEL 0x58                    // Block And Mass Cancel
#define ACTION_REMOVE_BLOCKING_FOR_THE_SPECIFIED_SCOPE 0x52  // Remove Blocking For The Specified Scope

// Matching Engine Status: one byte code
#define MATCHING_ENGINE_STATUS_SUCCESSFUL 0x20                                                // Successful
#define MATCHING_ENGINE_STATUS_INVALID_MPID 0x49                                              // Invalid Mpid
#define MATCHING_ENGINE_STATUS_MPID_NOT_PERMITTED 0x58                                        // Mpid Not Permitted
#define MATCHING_ENGINE_STATUS_REQUEST_IS_NOT_PERMITTED_FOR_THIS_SESSION 0x50                 // Request Is Not Permitted For This Session
#define MATCHING_ENGINE_STATUS_INVALID_SCOPE 0x52                                             // Invalid Scope
#define MATCHING_ENGINE_STATUS_INVALID_ACTION 0x41                                            // Invalid Action
#define MATCHING_ENGINE_STATUS_MATCHING_ENGINE_NOT_AVAILABLE 0x43                             // Matching Engine Not Available
#define MATCHING_ENGINE_STATUS_STATE_OF_THE_REQUEST_FOR_THIS_MATCHING_ENGINE_IS_UNKNOWN 0x55  // State Of The Request For This Matching Engine Is Unknown
#define MATCHING_ENGINE_STATUS_INVALID_CLIENT_ORDER_ID 0x4F                                   // Invalid Client Order Id
#define MATCHING_ENGINE_STATUS_UNDEFINED_REASON 0x5A                                          // Undefined Reason
#define MATCHING_ENGINE_STATUS_DOWNGRADED_FROM_OLDER_VERSION 0x2A                             // Downgraded From Older Version

// Login Status: one byte code
#define LOGIN_STATUS_SUCCESSFUL 0x20                                                     // Successful
#define LOGIN_STATUS_INVALID_TRADING_SESSION_REQUESTED 0x53                              // Invalid Trading Session Requested
#define LOGIN_STATUS_INVALID_START_SEQUENCE_NUMBER_REQUESTED 0x4E                        // Invalid Start Sequence Number Requested
#define LOGIN_STATUS_NO_ACTIVE_TRADING_SESSION_EXISTS 0x55                               // No Active Trading Session Exists
#define LOGIN_STATUS_REJECTED 0x58                                                       // Rejected
#define LOGIN_STATUS_INCOMPATIBLE_SESSION_PROTOCOL_VERSION 0x49                          // Incompatible Session Protocol Version
#define LOGIN_STATUS_INCOMPATIBLE_APPLICATION_PROTOCOL_VERSION 0x41                      // Incompatible Application Protocol Version
#define LOGIN_STATUS_INVALID_NUMBER_OF_MATCHING_ENGINES_SPECIFIED_IN_LOGIN_REQUEST 0x43  // Invalid Number Of Matching Engines Specified In Login Request
#define LOGIN_STATUS_REQUEST_REJECTED_BECAUSE_CLIENT_ALREADY_LOGGED_IN 0x4C              // Request Rejected Because Client Already Logged In

// Logout Reason: one byte code
#define LOGOUT_REASON_GRACEFUL_LOGOUT 0x20                     // Graceful Logout
#define LOGOUT_REASON_BAD_PACKET 0x42                          // Bad Packet
#define LOGOUT_REASON_TIMED_OUT 0x4C                           // Timed Out
#define LOGOUT_REASON_APPLICATION_TERMINATING_CONNECTION 0x41  // Application Terminating Connection

// Goodbye Reason: one byte code
#define GOODBYE_REASON_BAD_PACKET 0x42                          // Bad Packet
#define GOODBYE_REASON_TIMED_OUT 0x4C                           // Timed Out
#define GOODBYE_REASON_APPLICATION_TERMINATING_CONNECTION 0x41  // Application Terminating Connection

// ---- Types -------------------------------------------------------------------

// used to disseminate all security symbols traded on MIAX Pearl Equities for the current session
typedef struct _SymbolUpdateMessage {
  UINT64 matching_engine_time;    // bytes 0 to 7
  UINT32 symbol_id;               // bytes 8 to 11
  UINT8 ticker_symbol[11];        // bytes 12 to 22
  UINT8 reserved_1;               // byte 23
  UINT8 test_security_indicator;  // byte 24
  UINT8 second_reserved_1;        // byte 25
  UINT32 lot_size;                // bytes 26 to 29
  UINT8 opening_time[8];          // bytes 30 to 37
  UINT8 closing_time[8];          // bytes 38 to 45
  UINT8 primary_market_code;      // byte 46
  UINT8 reserved_12[12];          // bytes 47 to 58
} SymbolUpdateMessage;

// provides an acknowledgement for a New Order Request accepted by MIAX Pearl Equities
typedef struct _NewOrderResponseMessage {
  UINT64 matching_engine_time;  // bytes 0 to 7
  UINT8 mpid[4];                // bytes 8 to 11
  UINT8 client_order_id[20];    // bytes 12 to 31
  UINT32 symbol_id;             // bytes 32 to 35
  UINT64 order_id;              // bytes 36 to 43
  UINT64 price;                 // bytes 44 to 51
  UINT32 size;                  // bytes 52 to 55
  UINT8 order_status;           // byte 56
  UINT8 reserved_10[10];        // bytes 57 to 66
} NewOrderResponseMessage;

// This message format provides acknowledgement for a Modify Order Request accepted by MIAX Pearl Equities
typedef struct _ModifyOrderResponse {
  UINT64 matching_engine_time;         // bytes 0 to 7
  UINT8 mpid[4];                       // bytes 8 to 11
  UINT8 client_order_id[20];           // bytes 12 to 31
  UINT8 original_client_order_id[20];  // bytes 32 to 51
  UINT32 symbol_id;                    // bytes 52 to 55
  UINT64 order_id;                     // bytes 56 to 63
  UINT32 leaves_qty;                   // bytes 64 to 67
  UINT64 price;                        // bytes 68 to 75
  UINT8 modify_status;                 // byte 76
  UINT8 reserved_10[10];               // bytes 77 to 86
} ModifyOrderResponse;

// This message format provides response to an Order Cancel Request
typedef struct _CancelOrderResponse {
  UINT64 matching_engine_time;         // bytes 0 to 7
  UINT8 mpid[4];                       // bytes 8 to 11
  UINT8 client_order_id[20];           // bytes 12 to 31
  UINT8 original_client_order_id[20];  // bytes 32 to 51
  UINT32 symbol_id;                    // bytes 52 to 55
  UINT64 order_id;                     // bytes 56 to 63
  UINT32 leaves_qty;                   // bytes 64 to 67
  UINT8 cancel_status;                 // byte 68
  UINT8 reserved_10[10];               // bytes 69 to 78
} CancelOrderResponse;

// This message is published whenever system state events take place
typedef struct _SystemStateNotification {
  UINT64 matching_engine_time;  // bytes 0 to 7
  UINT8 meo_version[8];         // bytes 8 to 15
  UINT8 session_id;             // byte 16
  UINT8 system_status;          // byte 17
  UINT8 reserved_8[8];          // bytes 18 to 25
} SystemStateNotification;

// This message is published whenever New Order Request is accepted by MIAX Pearl Equities exchange
typedef struct _NewOrderNotification {
  UINT64 matching_engine_time;                  // bytes 0 to 7
  UINT8 mpid[4];                                // bytes 8 to 11
  UINT64 order_id;                              // bytes 12 to 19
  UINT8 client_order_id[20];                    // bytes 20 to 39
  UINT32 symbol_id;                             // bytes 40 to 43
  UINT64 price;                                 // bytes 44 to 51
  UINT32 size;                                  // bytes 52 to 55
  UINT16 side : 1;                              // bytes 56 to 57
  UINT16 short_sale_indicator : 2;              // bytes 56 to 57
  UINT16 displayed : 1;                         // bytes 56 to 57
  UINT16 post_only : 1;                         // bytes 56 to 57
  UINT16 locate_required : 1;                   // bytes 56 to 57
  UINT16 iso : 1;                               // bytes 56 to 57
  UINT16 retail_order : 1;                      // bytes 56 to 57
  UINT16 attributable_order : 2;                // bytes 56 to 57
  UINT16 min_qty_exec_type : 2;                 // bytes 56 to 57
  UINT16 unused_4 : 4;                          // bytes 56 to 57
  UINT8 time_in_force;                          // byte 58
  UINT8 order_type;                             // byte 59
  UINT8 price_sliding_and_reprice_frequency;    // byte 60
  UINT8 self_trade_protection_level : 3;        // byte 61
  UINT8 self_trade_protection_instruction : 3;  // byte 61
  UINT8 unused_2 : 2;                           // byte 61
  UINT8 self_trade_protection_group;            // byte 62
  UINT8 routing_instruction : 3;                // byte 63
  UINT8 routing_strategy : 5;                   // byte 63
  UINT64 trading_collar_dollar_value;           // bytes 64 to 71, signed, read here as unsigned
  UINT8 capacity;                               // byte 72
  UINT8 account[16];                            // bytes 73 to 88
  UINT8 clearing_account[4];                    // bytes 89 to 92
  UINT32 min_qty;                               // bytes 93 to 96
  UINT32 max_floor_qty;                         // bytes 97 to 100
  UINT32 display_range_qty;                     // bytes 101 to 104
  UINT8 reserved_32[32];                        // bytes 105 to 136
} NewOrderNotification;

// This message is published whenever a Modify Order Request is accepted by MIAX Pearl Equities
typedef struct _ModifyOrderNotification {
  UINT64 matching_engine_time;         // bytes 0 to 7
  UINT8 mpid[4];                       // bytes 8 to 11
  UINT8 client_order_id[20];           // bytes 12 to 31
  UINT8 original_client_order_id[20];  // bytes 32 to 51
  UINT32 symbol_id;                    // bytes 52 to 55
  UINT64 order_id;                     // bytes 56 to 63
  UINT64 price;                        // bytes 64 to 71
  UINT32 size;                         // bytes 72 to 75
  UINT32 leaves_qty;                   // bytes 76 to 79
  UINT8 short_sale_indicator : 2;      // byte 80
  UINT8 locate_required : 1;           // byte 80
  UINT8 unused_5 : 5;                  // byte 80
  UINT32 min_qty;                      // bytes 81 to 84
  UINT32 max_floor_qty;                // bytes 85 to 88
  UINT8 pending_modify_status;         // byte 89
  UINT8 pending_reject_reason;         // byte 90
  UINT8 reserved_30[30];               // bytes 91 to 120
} ModifyOrderNotification;

// This is the message format that will be used when Cancel Order Request is accepted by MIAX Pearl Equities or when unsolicited order cancels or order size reductions are to be notified to firms
typedef struct _CancelReduceSizeOrderNotification {
  UINT64 matching_engine_time;  // bytes 0 to 7
  UINT8 mpid[4];                // bytes 8 to 11
  UINT8 client_order_id[20];    // bytes 12 to 31
  UINT32 symbol_id;             // bytes 32 to 35
  UINT64 order_id;              // bytes 36 to 43
  UINT32 leaves_qty;            // bytes 44 to 47
  UINT8 cancel_reason;          // byte 48
  UINT64 last_price;            // bytes 49 to 56
  UINT32 last_size;             // bytes 57 to 60
  UINT8 pending_cancel_status;  // byte 61
  UINT8 pending_reject_reason;  // byte 62
  UINT8 reserved_8[8];          // bytes 63 to 70
} CancelReduceSizeOrderNotification;

// This is the message format that will be used to notify firms about order reprices
typedef struct _OrderPriceUpdateNotification {
  UINT64 matching_engine_time;  // bytes 0 to 7
  UINT32 symbol_id;             // bytes 8 to 11
  UINT64 order_id;              // bytes 12 to 19
  UINT64 working_price;         // bytes 20 to 27
  UINT8 reserved_10[10];        // bytes 28 to 37
} OrderPriceUpdateNotification;

// This is the message format that will be used to notify firms of their Reserve order replenishment events
typedef struct _ReserveOrderReplenishmentNotification {
  UINT64 matching_engine_time;  // bytes 0 to 7
  UINT32 symbol_id;             // bytes 8 to 11
  UINT64 order_id;              // bytes 12 to 19
  UINT64 secondary_order_id;    // bytes 20 to 27
  UINT32 display_qty;           // bytes 28 to 31
  UINT8 reserved_10[10];        // bytes 32 to 41
} ReserveOrderReplenishmentNotification;

// This message format will be used to notify the firms of their order executions, trade corrections and cancellations
typedef struct _ExecutionNotification {
  UINT64 matching_engine_time;   // bytes 0 to 7
  UINT8 mpid[4];                 // bytes 8 to 11
  UINT32 symbol_id;              // bytes 12 to 15
  UINT8 client_order_id[20];     // bytes 16 to 35
  UINT64 trade_id;               // bytes 36 to 43
  UINT64 execution_id;           // bytes 44 to 51
  UINT8 correction_number;       // byte 52
  UINT8 trade_status;            // byte 53
  UINT64 last_price;             // bytes 54 to 61
  UINT32 last_size;              // bytes 62 to 65
  UINT16 side : 1;               // bytes 66 to 67
  UINT16 unused_15 : 15;         // bytes 66 to 67
  UINT8 reserved_1;              // byte 68
  UINT8 executing_exchange;      // byte 69
  UINT64 secondary_order_id;     // bytes 70 to 77
  UINT8 liquidity_indicator[3];  // bytes 78 to 80
  UINT8 reserved_9[9];           // bytes 81 to 89
} ExecutionNotification;

// Branch
casetype _SequencedMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x5355: SymbolUpdateMessage symbol_update_message;
    case 0x4E52: NewOrderResponseMessage new_order_response_message;
    case 0x4D52: ModifyOrderResponse modify_order_response;
    case 0x4352: CancelOrderResponse cancel_order_response;
    case 0x534E: SystemStateNotification system_state_notification;
    case 0x4F31: NewOrderNotification new_order_notification;
    case 0x4D4E: ModifyOrderNotification modify_order_notification;
    case 0x584E: CancelReduceSizeOrderNotification cancel_reduce_size_order_notification;
    case 0x5055: OrderPriceUpdateNotification order_price_update_notification;
    case 0x5241: ReserveOrderReplenishmentNotification reserve_order_replenishment_notification;
    case 0x454E: ExecutionNotification execution_notification;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The ESesM server uses Sequenced data packets to send all messages that must be recoverable by the client in case of a connection loss
typedef struct _SequencedDataPacket (UINT32 available) where (available >= 11) {
  UINT64 sequence_number;                                                                                                          // bytes 0 to 7
  UINT8 matching_engine_id;                                                                                                        // byte 8
  UINT16BE sequenced_message_type;                                                                                                 // bytes 9 to 10
  SequencedMessage(sequenced_message_type, (available - 11)) sequenced_message[:byte-size-single-element-array (available - 11)];
} SequencedDataPacket;

// Firms can use this format to send a single New Order Request
typedef struct _NewOrderRequestMessage {
  UINT8 reserved_8[8];                          // bytes 0 to 7
  UINT8 mpid[4];                                // bytes 8 to 11
  UINT8 client_order_id[20];                    // bytes 12 to 31
  UINT32 symbol_id;                             // bytes 32 to 35
  UINT64 price;                                 // bytes 36 to 43
  UINT32 size;                                  // bytes 44 to 47
  UINT16 side : 1;                              // bytes 48 to 49
  UINT16 short_sale_indicator : 2;              // bytes 48 to 49
  UINT16 displayed : 1;                         // bytes 48 to 49
  UINT16 post_only : 1;                         // bytes 48 to 49
  UINT16 locate_required : 1;                   // bytes 48 to 49
  UINT16 iso : 1;                               // bytes 48 to 49
  UINT16 retail_order : 1;                      // bytes 48 to 49
  UINT16 attributable_order : 2;                // bytes 48 to 49
  UINT16 min_qty_exec_type : 2;                 // bytes 48 to 49
  UINT16 unused_4 : 4;                          // bytes 48 to 49
  UINT8 time_in_force;                          // byte 50
  UINT8 order_type;                             // byte 51
  UINT8 price_sliding_and_reprice_frequency;    // byte 52
  UINT8 self_trade_protection_level : 3;        // byte 53
  UINT8 self_trade_protection_instruction : 3;  // byte 53
  UINT8 unused_2 : 2;                           // byte 53
  UINT8 self_trade_protection_group;            // byte 54
  UINT8 routing_instruction : 3;                // byte 55
  UINT8 routing_strategy : 5;                   // byte 55
  UINT64 trading_collar_dollar_value;           // bytes 56 to 63, signed, read here as unsigned
  UINT8 capacity;                               // byte 64
  UINT8 account[16];                            // bytes 65 to 80
  UINT8 clearing_account[4];                    // bytes 81 to 84
  UINT32 min_qty;                               // bytes 85 to 88
  UINT32 max_floor_qty;                         // bytes 89 to 92
  UINT32 display_range_qty;                     // bytes 93 to 96
  UINT8 reserved_32[32];                        // bytes 97 to 128
} NewOrderRequestMessage;

// Firms can use this format to send a request to modify a resting order
typedef struct _ModifyOrderRequestMessage {
  UINT8 reserved_8[8];                 // bytes 0 to 7
  UINT8 mpid[4];                       // bytes 8 to 11
  UINT8 client_order_id[20];           // bytes 12 to 31
  UINT8 original_client_order_id[20];  // bytes 32 to 51
  UINT32 symbol_id;                    // bytes 52 to 55
  UINT64 price;                        // bytes 56 to 63
  UINT32 size;                         // bytes 64 to 67
  UINT8 short_sale_indicator : 2;      // byte 68
  UINT8 locate_required : 1;           // byte 68
  UINT8 unused_5 : 5;                  // byte 68
  UINT32 min_qty;                      // bytes 69 to 72
  UINT32 max_floor_qty;                // bytes 73 to 76
  UINT8 reserved_32[32];               // bytes 77 to 108
} ModifyOrderRequestMessage;

// Firms can use this format to send a cancel request for a resting order
typedef struct _CancelOrderRequest {
  UINT8 reserved_8[8];                 // bytes 0 to 7
  UINT8 mpid[4];                       // bytes 8 to 11
  UINT8 client_order_id[20];           // bytes 12 to 31
  UINT8 original_client_order_id[20];  // bytes 32 to 51
  UINT32 symbol_id;                    // bytes 52 to 55
  UINT8 reserved_10[10];               // bytes 56 to 65
} CancelOrderRequest;

// Firms can use this message format to request the cancellation of all orders for an MPID
typedef struct _MassCancelRequest {
  UINT8 reserved_8[8];        // bytes 0 to 7
  UINT8 mpid[4];              // bytes 8 to 11
  UINT8 client_order_id[20];  // bytes 12 to 31
  UINT8 scope;                // byte 32
  UINT8 action;               // byte 33
  UINT8 reserved_10[10];      // bytes 34 to 43
} MassCancelRequest;

// Status response for the Mass Cancel Request from each Matching Engine, in sequential order
typedef struct _MatchingEngine {
  UINT8 matching_engine_status;  // byte 0
} MatchingEngine;

// This message format will be used to inform the Firm about the status of their previous Mass Cancel Request
typedef struct _MassCancelResponse {
  UINT64 notification_time;                                                                // bytes 0 to 7
  UINT8 mpid[4];                                                                           // bytes 8 to 11
  UINT8 client_order_id[20];                                                               // bytes 12 to 31
  UINT8 number_of_matching_engines;                                                        // byte 32
  MatchingEngine matching_engine[:byte-size (((UINT32) number_of_matching_engines) * 1)];
  UINT8 reserved_10[10];
} MassCancelResponse;

// Branch
casetype _UnsequencedMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x4E31: NewOrderRequestMessage new_order_request_message;
    case 0x4E52: NewOrderResponseMessage new_order_response_message;
    case 0x4D31: ModifyOrderRequestMessage modify_order_request_message;
    case 0x4D52: ModifyOrderResponse modify_order_response;
    case 0x434F: CancelOrderRequest cancel_order_request;
    case 0x4352: CancelOrderResponse cancel_order_response;
    case 0x5851: MassCancelRequest mass_cancel_request;
    case 0x5852: MassCancelResponse mass_cancel_response;
    case 0x5241: ReserveOrderReplenishmentNotification reserve_order_replenishment_notification;
    case 0x454E: ExecutionNotification execution_notification;
    default: UINT8 unknown[available];
  }
} UnsequencedMessage;

// Each unsequenced data packet carries one unsequenced message from the higher-lever protocol
typedef struct _UnsequencedDataPacket (UINT32 available) where (available >= 2) {
  UINT16BE unsequenced_message_type;                                                                                                   // bytes 0 to 1
  UnsequencedMessage(unsequenced_message_type, (available - 2)) unsequenced_message[:byte-size-single-element-array (available - 2)];
} UnsequencedDataPacket;

// The trading session and sequence number the client asks of one matching engine, repeated once for each the login request counts
typedef struct _RequestedMatchingEngine {
  UINT8 requested_trading_session_id;  // byte 0
  UINT64 requested_sequence_number;    // bytes 1 to 8
} RequestedMatchingEngine;

// The ESesM client must send a Login request packet immediately upon establishing a new TCP/IP socket connection to the server
typedef struct _LoginRequest {
  UINT8 esesm_version[5];                                                                                     // bytes 0 to 4
  UINT8 username[5];                                                                                          // bytes 5 to 9
  UINT8 computer_id[8];                                                                                       // bytes 10 to 17
  UINT8 application_protocol[8];                                                                              // bytes 18 to 25
  UINT8 number_of_matching_engines;                                                                           // byte 26
  RequestedMatchingEngine requested_matching_engine[:byte-size (((UINT32) number_of_matching_engines) * 9)];
} LoginRequest;

// The login status, trading session and highest sequence number of one matching engine, repeated once for each the login response counts
typedef struct _LoginMatchingEngine {
  UINT8 login_status;              // byte 0
  UINT8 trading_session_id;        // byte 1
  UINT64 highest_sequence_number;  // bytes 2 to 9
} LoginMatchingEngine;

// The ESesM server sends a Login response packet in response to a Login request packet from the client
typedef struct _LoginResponse {
  UINT8 number_of_matching_engines;                                                                    // byte 0
  LoginMatchingEngine login_matching_engine[:byte-size (((UINT32) number_of_matching_engines) * 10)];
} LoginResponse;

// The ESesM server sends a Synchronization complete packet when it is done replaying all the old packets and is ready to start sending new packets from the Matching Engine
typedef struct _SynchronizationComplete {
  UINT8 matching_engine_id;  // byte 0
} SynchronizationComplete;

// The ESesM client uses this packet to request a retransmission server to retransmit a range of packets
typedef struct _RetransmissionRequest {
  UINT64 start_sequence_number;  // bytes 0 to 7
  UINT64 end_sequence_number;    // bytes 8 to 15
} RetransmissionRequest;

// The client may send a Logout request packet to request the connection be terminated
typedef struct _LogoutRequest (UINT16 esesm_packet_length) where (esesm_packet_length >= 2) {
  UINT8 logout_reason;                                      // byte 0
  UINT8 logout_text[(((UINT32) esesm_packet_length) - 2)];
} LogoutRequest;

// The server may send a GoodBye packet to inform the client a reason for termination of the connection just before it terminates the connection
typedef struct _GoodbyePacket (UINT16 esesm_packet_length) where (esesm_packet_length >= 2) {
  UINT8 goodbye_reason;                                     // byte 0
  UINT8 logout_text[(((UINT32) esesm_packet_length) - 2)];
} GoodbyePacket;

// The ESesM server sends a Trading Session Update packet to inform the client that a new trading session is starting on the specified Matching Engine
typedef struct _TradingSessionUpdate {
  UINT8 matching_engine_id;  // byte 0
  UINT8 trading_session_id;  // byte 1
} TradingSessionUpdate;

// Test packets are intended to provide human readable text that may aid in debugging problems
typedef struct _TestPacket (UINT16 esesm_packet_length) where (esesm_packet_length >= 1) {
  UINT8 test_text[(((UINT32) esesm_packet_length) - 1)];
} TestPacket;

// Branch
casetype _EsesmPayload (UINT8 selector, UINT32 length, UINT32 length_2, UINT16 esesm_packet_length, UINT32 available) {
  switch (selector) {
    case 0x73: SequencedDataPacket(length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x55: UnsequencedDataPacket(length_2) unsequenced_data_packet[:byte-size-single-element-array length_2];
    case 0x6C: LoginRequest login_request;
    case 0x72: LoginResponse login_response;
    case 0x63: SynchronizationComplete synchronization_complete;
    case 0x61: RetransmissionRequest retransmission_request;
    case 0x58: LogoutRequest(esesm_packet_length) logout_request;
    case 0x47: GoodbyePacket(esesm_packet_length) goodbye_packet;
    case 0x75: TradingSessionUpdate trading_session_update;
    case 0x30: unit server_heartbeat;
    case 0x31: unit client_heartbeat;
    case 0x54: TestPacket(esesm_packet_length) test_packet;
    default: UINT8 unknown[available];
  }
} EsesmPayload;

// ESesM Tcp Packet
typedef struct _EsesmTcpPacket {
  UINT16 esesm_packet_length { esesm_packet_length >= 1 };                                                                                                                                                                                                                 // bytes 0 to 1
  UINT8 esesm_packet_type;                                                                                                                                                                                                                                                 // byte 2
  EsesmPayload(esesm_packet_type, (((UINT32) esesm_packet_length) - 1), (((UINT32) esesm_packet_length) - 1), esesm_packet_length, ((((UINT32) esesm_packet_length) + 2) - 3)) esesm_payload[:byte-size-single-element-array ((((UINT32) esesm_packet_length) + 2) - 3)];
} EsesmTcpPacket;

// ---- Packet: Packet ----------------------------------------------------------

// ESesM Packet
entrypoint typedef struct _Packet (UINT32 available) {
  EsesmTcpPacket esesm_tcp_packet[:byte-size available];
} Packet;

