// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out PearlOptions_TopOfMarket_v1_0_b.3d

// ---- Values ------------------------------------------------------------------

// Packet Type: one byte code
#define PACKET_TYPE_HEARTBEAT 0x00            // Heartbeat
#define PACKET_TYPE_START_OF_SESSION 0x01     // Start Of Session
#define PACKET_TYPE_END_OF_SESSION 0x02       // End Of Session
#define PACKET_TYPE_APPLICATION_MESSAGE 0x03  // Application Message

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_TIME_MESSAGE 0x31                         // System Time Message
#define MESSAGE_TYPE_SERIES_UPDATE_MESSAGE 0x50                       // Series Update Message
#define MESSAGE_TYPE_SYSTEM_STATE_MESSAGE 0x53                        // System State Message
#define MESSAGE_TYPE_COMPACT_TOP_OF_MARKET_BID_MESSAGE 0x42           // Compact Top Of Market Bid Message
#define MESSAGE_TYPE_COMPACT_TOP_OF_MARKET_BEST_OFFER_MESSAGE 0x4F    // Compact Top Of Market Best Offer Message
#define MESSAGE_TYPE_WIDE_TOP_OF_MARKET_BEST_BID_MESSAGE 0x57         // Wide Top Of Market Best Bid Message
#define MESSAGE_TYPE_WIDE_TOP_OF_MARKET_BEST_OFFER_MESSAGE 0x41       // Wide Top Of Market Best Offer Message
#define MESSAGE_TYPE_COMPACT_DOUBLE_SIDED_TOP_OF_MARKET_MESSAGE 0x64  // Compact Double Sided Top Of Market Message
#define MESSAGE_TYPE_WIDE_DOUBLE_SIDED_TOP_OF_MARKET_MESSAGE 0x44     // Wide Double Sided Top Of Market Message
#define MESSAGE_TYPE_LAST_SALE_MESSAGE 0x54                           // Last Sale Message
#define MESSAGE_TYPE_TRADE_CANCEL_MESSAGE 0x58                        // Trade Cancel Message
#define MESSAGE_TYPE_UNDERLYING_TRADING_STATUS_NOTIFICATION 0x48      // Underlying Trading Status Notification

// Call Or Put: one byte code
#define CALL_OR_PUT_CALL 0x43  // Call
#define CALL_OR_PUT_PUT 0x50   // Put

// Restricted Option: one byte code
#define RESTRICTED_OPTION_POSITION_CLOSING_ORDERS_ONLY 0x59  // Position Closing Orders Only
#define RESTRICTED_OPTION_OPEN_AND_CLOSE_POSITIONS 0x4E      // Open And Close Positions

// Long Term Option: one byte code
#define LONG_TERM_OPTION_FAR_MONTH 0x59   // Far Month
#define LONG_TERM_OPTION_NEAR_MONTH 0x4E  // Near Month

// Active On Pearl: one byte code
#define ACTIVE_ON_PEARL_ACTIVE_TRADABLE 0x41        // Active Tradable
#define ACTIVE_ON_PEARL_INACTIVE_NOT_TRADABLE 0x49  // Inactive Not Tradable

// Pearl Bbo Posting Increment Indicator: one byte code
#define PEARL_BBO_POSTING_INCREMENT_INDICATOR_PENNY 0x50            // Penny
#define PEARL_BBO_POSTING_INCREMENT_INDICATOR_PENNY_OR_NICKEL 0x4E  // Penny Or Nickel
#define PEARL_BBO_POSTING_INCREMENT_INDICATOR_NICKEL_OR_DIME 0x44   // Nickel Or Dime

// Liquidity Acceptance Increment Indicator: one byte code
#define LIQUIDITY_ACCEPTANCE_INCREMENT_INDICATOR_PENNY 0x50            // Penny
#define LIQUIDITY_ACCEPTANCE_INCREMENT_INDICATOR_PENNY_OR_NICKEL 0x4E  // Penny Or Nickel
#define LIQUIDITY_ACCEPTANCE_INCREMENT_INDICATOR_NICKEL_OR_DIME 0x44   // Nickel Or Dime

// Opening Underlying Market Code: one byte code
#define OPENING_UNDERLYING_MARKET_CODE_NYSE_AMEX 0x41                 // Nyse Amex
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_BX 0x42             // Nasdaq Omx Bx
#define OPENING_UNDERLYING_MARKET_CODE_NATIONAL_STOCK 0x43            // National Stock
#define OPENING_UNDERLYING_MARKET_CODE_FINRA_ADF 0x44                 // Finra Adf
#define OPENING_UNDERLYING_MARKET_CODE_MARKET_INDEPENDENT 0x45        // Market Independent
#define OPENING_UNDERLYING_MARKET_CODE_INTERNATIONAL_SECURITIES 0x49  // International Securities
#define OPENING_UNDERLYING_MARKET_CODE_EDGA_EXCHANGE 0x4A             // Edga Exchange
#define OPENING_UNDERLYING_MARKET_CODE_EDGX_EXCHANGE 0x4B             // Edgx Exchange
#define OPENING_UNDERLYING_MARKET_CODE_CHICAGO_STOCK 0x4D             // Chicago Stock
#define OPENING_UNDERLYING_MARKET_CODE_NYSE_EURONEXT 0x4E             // Nyse Euronext
#define OPENING_UNDERLYING_MARKET_CODE_NYSE_ARCA 0x50                 // Nyse Arca
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_UTP 0x51            // Nasdaq Omx Utp
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_CTA 0x54            // Nasdaq Omx Cta
#define OPENING_UNDERLYING_MARKET_CODE_IEX 0x56                       // Iex
#define OPENING_UNDERLYING_MARKET_CODE_NASDAQ_OMX_PHLX 0x58           // Nasdaq Omx Phlx
#define OPENING_UNDERLYING_MARKET_CODE_BATS_Y_EXCHANGE 0x59           // Bats Y Exchange
#define OPENING_UNDERLYING_MARKET_CODE_BATS_EXCHANGE 0x5A             // Bats Exchange

// System Status: one byte code
#define SYSTEM_STATUS_START_OF_SYSTEM_HOURS 0x53  // Start Of System Hours
#define SYSTEM_STATUS_END_OF_SYSTEM_HOURS 0x43    // End Of System Hours
#define SYSTEM_STATUS_START_OF_TEST_SESSION 0x31  // Start Of Test Session
#define SYSTEM_STATUS_END_OF_TEST_SESSION 0x32    // End Of Test Session

// Pbbo Condition: one byte code
#define PBBO_CONDITION_REGULAR 0x41                                  // Regular
#define PBBO_CONDITION_QUOTE_CONTAINS_PUBLIC_CUSTOMER_INTEREST 0x42  // Quote Contains Public Customer Interest
#define PBBO_CONDITION_QUOTE_IS_NOT_FIRM 0x43                        // Quote Is Not Firm
#define PBBO_CONDITION_RESERVED_FOR_FUTURE_USE 0x52                  // Reserved For Future Use
#define PBBO_CONDITION_TRADING_HALT 0x54                             // Trading Halt

// Bid Condition: one byte code
#define BID_CONDITION_REGULAR 0x41                                  // Regular
#define BID_CONDITION_QUOTE_CONTAINS_PUBLIC_CUSTOMER_INTEREST 0x42  // Quote Contains Public Customer Interest
#define BID_CONDITION_QUOTE_IS_NOT_FIRM 0x43                        // Quote Is Not Firm
#define BID_CONDITION_RESERVED_FOR_FUTURE_USE 0x52                  // Reserved For Future Use
#define BID_CONDITION_TRADING_HALT 0x54                             // Trading Halt

// Offer Condition: one byte code
#define OFFER_CONDITION_REGULAR 0x41                                  // Regular
#define OFFER_CONDITION_QUOTE_CONTAINS_PUBLIC_CUSTOMER_INTEREST 0x42  // Quote Contains Public Customer Interest
#define OFFER_CONDITION_QUOTE_IS_NOT_FIRM 0x43                        // Quote Is Not Firm
#define OFFER_CONDITION_RESERVED_FOR_FUTURE_USE 0x52                  // Reserved For Future Use
#define OFFER_CONDITION_TRADING_HALT 0x54                             // Trading Halt

// Trade Condition: one byte code
#define TRADE_CONDITION_REGULAR 0x20                                                                           // Regular
#define TRADE_CONDITION_CANCEL_OF_TRADE 0x41                                                                   // Cancel Of Trade
#define TRADE_CONDITION_TRADE_THAT_IS_LATE_AND_IS_OUT_OF_SEQUENCE 0x42                                         // Trade That Is Late And Is Out Of Sequence
#define TRADE_CONDITION_CANCEL_OF_THE_LAST_REPORTED_TRADE 0x43                                                 // Cancel Of The Last Reported Trade
#define TRADE_CONDITION_TRADE_THAT_IS_LATE_AND_IS_IN_CORRECT_SEQUENCE 0x44                                     // Trade That Is Late And Is In Correct Sequence
#define TRADE_CONDITION_CANCEL_OF_THE_FIRST_OPENING_REPORTED_TRADE 0x45                                        // Cancel Of The First Opening Reported Trade
#define TRADE_CONDITION_TRADE_THAT_IS_LATE_REPORT_OF_THE_OPENING_TRADE_AND_IS_OUT_OF_SEQUENCE 0x46             // Trade That Is Late Report Of The Opening Trade And Is Out Of Sequence
#define TRADE_CONDITION_CANCEL_OF_THE_ONLY_REPORTED_TRADE 0x47                                                 // Cancel Of The Only Reported Trade
#define TRADE_CONDITION_TRADE_THAT_IS_LATE_REPORT_OF_THE_OPENING_TRADE_AND_IS_IN_CORRECT_SEQUENCE 0x48         // Trade That Is Late Report Of The Opening Trade And Is In Correct Sequence
#define TRADE_CONDITION_RESERVED_FOR_FUTURE_USE_I 0x49                                                         // Reserved For Future Use I
#define TRADE_CONDITION_TRADE_DUE_TO_REOPENING_OF_AN_OPTION_IN_WHICH_TRADING_HAS_BEEN_PREVIOUSLY_HALTED 0x4A   // Trade Due To Reopening Of An Option In Which Trading Has Been Previously Halted
#define TRADE_CONDITION_RESERVED_FOR_FUTURE_USE_K 0x4B                                                         // Reserved For Future Use K
#define TRADE_CONDITION_RESERVED_FOR_FUTURE_USE_L 0x4C                                                         // Reserved For Future Use L
#define TRADE_CONDITION_RESERVED_FOR_FUTURE_USE_M 0x4D                                                         // Reserved For Future Use M
#define TRADE_CONDITION_RESERVED_FOR_FUTURE_USE_N 0x4E                                                         // Reserved For Future Use N
#define TRADE_CONDITION_RESERVED_FOR_FUTURE_USE_O 0x4F                                                         // Reserved For Future Use O
#define TRADE_CONDITION_RESERVED_FOR_FUTURE_USE_P 0x50                                                         // Reserved For Future Use P
#define TRADE_CONDITION_RESERVED_FOR_FUTURE_USE_Q 0x51                                                         // Reserved For Future Use Q
#define TRADE_CONDITION_TRADE_WAS_THE_EXECUTION_OF_AN_ORDER_WHICH_WAS_STOPPED_AT_A_PRICE_THAT_DID_ha8vxl 0x52  // Trade Was The Execution Of An Order Which Was Stopped At A Price That Did Not Constitute A Trade Through On Another Market At The Time Of The Stop
#define TRADE_CONDITION_TRADE_WAS_THE_EXECUTION_OF_AN_ORDER_IDENTIFIED 0x53                                    // Trade Was The Execution Of An Order Identified
#define TRADE_CONDITION_RESERVED_FOR_FUTURE_USE_T 0x54                                                         // Reserved For Future Use T
#define TRADE_CONDITION_TRADE_THAT_IS_TRADE_THROUGH_EXEMPT 0x58                                                // Trade That Is Trade Through Exempt

// Event Reason: one byte code
#define EVENT_REASON_RESULTED_FROM_AUTOMATICMARKET_DRIVEN_EVENT 0x41  // Resulted From Automaticmarket Driven Event
#define EVENT_REASON_MANUALLY_INITIATED 0x4D                          // Manually Initiated

// ---- Types -------------------------------------------------------------------

// This is the message format that will be used to disseminate the seconds part of the timestamp that is applicable to all messages that are sent in the current second.
typedef struct _SystemTimeMessage {
  UINT32 seconds;  // bytes 0 to 3
} SystemTimeMessage;

// This is the message format that will be used to disseminate all Option series traded on PEARL for the current session. The product ID sent in this message is what will be disseminated in Top of Market BBO and Last Sale messages.
typedef struct _SeriesUpdateMessage {
  UINT32 nanoseconds;                              // bytes 0 to 3
  UINT32 product_id;                               // bytes 4 to 7
  UINT8 underlying_symbol[11];                     // bytes 8 to 18
  UINT8 security_symbol[6];                        // bytes 19 to 24
  UINT8 expiration_date[8];                        // bytes 25 to 32
  UINT32 strike_price;                             // bytes 33 to 36
  UINT8 call_or_put;                               // byte 37
  UINT8 opening_time[8];                           // bytes 38 to 45
  UINT8 closing_time[8];                           // bytes 46 to 53
  UINT8 restricted_option;                         // byte 54
  UINT8 long_term_option;                          // byte 55
  UINT8 active_on_pearl;                           // byte 56
  UINT8 pearl_bbo_posting_increment_indicator;     // byte 57
  UINT8 liquidity_acceptance_increment_indicator;  // byte 58
  UINT8 opening_underlying_market_code;            // byte 59
  UINT8 reserved_12[12];                           // bytes 60 to 71
} SeriesUpdateMessage;

// This message format is used to notify the firms of the state changes of the system. This is a notification that applies to each Underlying group. Firms can use notifications as triggers in their system to ensure electronic synchronization of systems.
typedef struct _SystemStateMessage {
  UINT32 nanoseconds;     // bytes 0 to 3
  UINT8 to_m_version[8];  // bytes 4 to 11
  UINT32 session_id;      // bytes 12 to 15
  UINT8 system_status;    // byte 16
} SystemStateMessage;

// This is the message format that will be used to disseminate each side of the PEARL Top of Market for options with low premiums and small aggregate PEARL Best Bid or Offer (PBBO) size.
typedef struct _CompactTopOfMarketBidMessage {
  UINT32 nanoseconds;                  // bytes 0 to 3
  UINT32 product_id;                   // bytes 4 to 7
  UINT16 pbbo_price;                   // bytes 8 to 9
  UINT16 pbbo_size;                    // bytes 10 to 11
  UINT16 pbbo_priority_customer_size;  // bytes 12 to 13
  UINT8 pbbo_condition;                // byte 14
} CompactTopOfMarketBidMessage;

// This is the message format that will be used, in the refresh service and during trading hours, to disseminate both sides of the PEARL Top of Market for options with low premiums and small aggregate PEARL Best Bid or Offer (PBBO) size.
typedef struct _WideTopOfMarketBestBidMessage {
  UINT32 nanoseconds;                       // bytes 0 to 3
  UINT32 product_id;                        // bytes 4 to 7
  UINT32 wide_pbbo_price;                   // bytes 8 to 11
  UINT32 wide_pbbo_size;                    // bytes 12 to 15
  UINT32 wide_pbbo_priority_customer_size;  // bytes 16 to 19
  UINT8 pbbo_condition;                     // byte 20
} WideTopOfMarketBestBidMessage;

// This is the message format that will be used, in the refresh service and during trading hours, to disseminate both sides of the PEARL Top of Market for options with low premiums and small aggregate PEARL Best Bid or Offer (PBBO) size.
typedef struct _CompactDoubleSidedTopOfMarketMessage {
  UINT32 nanoseconds;                   // bytes 0 to 3
  UINT32 product_id;                    // bytes 4 to 7
  UINT16 bid_price;                     // bytes 8 to 9
  UINT16 bid_size;                      // bytes 10 to 11
  UINT16 bid_priority_customer_size;    // bytes 12 to 13
  UINT8 bid_condition;                  // byte 14
  UINT16 offer_price;                   // bytes 15 to 16
  UINT16 offer_size;                    // bytes 17 to 18
  UINT16 offer_priority_customer_size;  // bytes 19 to 20
  UINT8 offer_condition;                // byte 21
} CompactDoubleSidedTopOfMarketMessage;

// This is the message format that will be used, in the refresh service and during trading hours, to disseminate both sides of the PEARL Top of Market for options with high premiums or large aggregate PEARL Best Bid or Offer (PBBO) sizes.
typedef struct _WideDoubleSidedTopOfMarketMessage {
  UINT32 nanoseconds;                        // bytes 0 to 3
  UINT32 product_id;                         // bytes 4 to 7
  UINT32 wide_bid_price;                     // bytes 8 to 11
  UINT32 wide_bid_size;                      // bytes 12 to 15
  UINT32 wide_bid_priority_customer_size;    // bytes 16 to 19
  UINT8 bid_condition;                       // byte 20
  UINT32 wide_offer_price;                   // bytes 21 to 24
  UINT32 wide_offer_size;                    // bytes 25 to 28
  UINT32 wide_offer_priority_customer_size;  // bytes 29 to 32
  UINT8 offer_condition;                     // byte 33
} WideDoubleSidedTopOfMarketMessage;

// This is the message format that will be used to disseminate Trades that are resulting from executions on PEARL during the current trading session.
typedef struct _LastSaleMessage {
  UINT32 nanoseconds;                 // bytes 0 to 3
  UINT32 product_id;                  // bytes 4 to 7
  UINT32 trade_id;                    // bytes 8 to 11
  UINT8 correction_number;            // byte 12
  UINT32 reference_trade_id;          // bytes 13 to 16
  UINT8 reference_correction_number;  // byte 17
  UINT32 trade_price;                 // bytes 18 to 21
  UINT32 trade_size;                  // bytes 22 to 25
  UINT8 trade_condition;              // byte 26
} LastSaleMessage;

// This is the message format that will be used to disseminate canceled Trades that are resulting from Trade cancellations or corrections on PEARL during the current trading session.
typedef struct _TradeCancelMessage {
  UINT32 nanoseconds;       // bytes 0 to 3
  UINT32 product_id;        // bytes 4 to 7
  UINT32 trade_id;          // bytes 8 to 11
  UINT8 correction_number;  // byte 12
  UINT32 trade_price;       // bytes 13 to 16
  UINT32 trade_size;        // bytes 17 to 20
  UINT8 trade_condition;    // byte 21
} TradeCancelMessage;

// This message format will be used to notify firms of changes to the trading status of all the options of an underlying.
typedef struct _UnderlyingTradingStatusNotification {
  UINT32 nanoseconds;                            // bytes 0 to 3
  UINT8 underlying_symbol[11];                   // bytes 4 to 14
  UINT8 trading_status;                          // byte 15
  UINT8 event_reason;                            // byte 16
  UINT32 expected_event_time_seconds_part;       // bytes 17 to 20
  UINT32 expected_event_time_nano_seconds_part;  // bytes 21 to 24
} UnderlyingTradingStatusNotification;

// Branch
casetype _Data (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x31: SystemTimeMessage system_time_message;
    case 0x50: SeriesUpdateMessage series_update_message;
    case 0x53: SystemStateMessage system_state_message;
    case 0x42: CompactTopOfMarketBidMessage compact_top_of_market_bid_message;
    case 0x4F: CompactTopOfMarketBidMessage compact_top_of_market_best_offer_message;
    case 0x57: WideTopOfMarketBestBidMessage wide_top_of_market_best_bid_message;
    case 0x41: WideTopOfMarketBestBidMessage wide_top_of_market_best_offer_message;
    case 0x64: CompactDoubleSidedTopOfMarketMessage compact_double_sided_top_of_market_message;
    case 0x44: WideDoubleSidedTopOfMarketMessage wide_double_sided_top_of_market_message;
    case 0x54: LastSaleMessage last_sale_message;
    case 0x58: TradeCancelMessage trade_cancel_message;
    case 0x48: UnderlyingTradingStatusNotification underlying_trading_status_notification;
    default: UINT8 unknown[available];
  }
} Data;

typedef struct _ApplicationMessage (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                         // byte 0
  Data(message_type, (available - 1)) data[:byte-size-single-element-array (available - 1)];
} ApplicationMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 length, UINT32 available) {
  switch (selector) {
    case 0x03: ApplicationMessage(length) application_message[:byte-size-single-element-array length];
    case 0x00: unit heartbeat;
    case 0x01: unit start_of_session;
    case 0x02: unit end_of_session;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _MachMessage {
  UINT64 sequence_number;                                                                                                                                           // bytes 0 to 7
  UINT16 packet_length { packet_length >= 12 };                                                                                                                     // bytes 8 to 9
  UINT8 packet_type;                                                                                                                                                // byte 10
  UINT8 session_number;                                                                                                                                             // byte 11
  Payload(packet_type, (((UINT32) packet_length) - 12), (((UINT32) packet_length) - 12)) payload[:byte-size-single-element-array (((UINT32) packet_length) - 12)];
} MachMessage;

// ---- Packet: Packet ----------------------------------------------------------

entrypoint typedef struct _Packet (UINT32 available) {
  MachMessage mach_message[:byte-size available];
} Packet;

