// ---- Sesm Packet Header: 3 bytes ---------------------------------------------

// SesM packet header
entrypoint typedef struct _SesmPacketHeader {
  UINT16 sesm_packet_length;  // bytes 0 to 1
  UINT8 sesm_packet_type;     // byte 2
} SesmPacketHeader;

// ---- Series Update: 76 bytes -------------------------------------------------

// This is the message format that will be used to disseminate all Option series traded on Pearl for the current session on the cloud associated for this connection
entrypoint typedef struct _SeriesUpdate {
  UINT64 product_add_update_time;               // bytes 0 to 7
  UINT32 product_id;                            // bytes 8 to 11
  UINT8 underlying_symbol[11];                  // bytes 12 to 22
  UINT8 security_symbol[6];                     // bytes 23 to 28
  UINT8 expiration_date[8];                     // bytes 29 to 36
  UINT32 strike_price;                          // bytes 37 to 40
  UINT8 call_or_put;                            // byte 41
  UINT8 opening_time[8];                        // bytes 42 to 49
  UINT8 closing_time[8];                        // bytes 50 to 57
  UINT8 restricted_option;                      // byte 58
  UINT8 long_term_option;                       // byte 59
  UINT8 active_on_pearl;                        // byte 60
  UINT8 pearl_bbo_posting_increment_indicator;  // byte 61
  UINT8 order_acceptance_increment_indicator;   // byte 62
  UINT8 opening_underlying_market_code;         // byte 63
  UINT8 reserved_12[12];                        // bytes 64 to 75
} SeriesUpdate;

// ---- System State Notification: 18 bytes -------------------------------------

// This message format is used to notify the firms of the state changes of the system. This is an exchange-wide notification and not a symbol or member-based notification
entrypoint typedef struct _SystemStateNotification {
  UINT64 notification_time;  // bytes 0 to 7
  UINT8 meo_version[8];      // bytes 8 to 15
  UINT8 session_id;          // byte 16
  UINT8 system_status;       // byte 17
} SystemStateNotification;

// ---- Underlying Trading Status Notification: 29 bytes ------------------------

// This message format will be used to notify the firms of changes to the trading status of all the options of an underlying
entrypoint typedef struct _UnderlyingTradingStatusNotification {
  UINT64 notification_time;     // bytes 0 to 7
  UINT8 underlying_symbol[11];  // bytes 8 to 18
  UINT8 trading_status;         // byte 19
  UINT8 event_reason;           // byte 20
  UINT64 expected_event_time;   // bytes 21 to 28
} UnderlyingTradingStatusNotification;

// ---- Opening Width Relief Notification: 23 bytes -----------------------------

// This message format will be used to notify the firms if and when Pearl grants relief from valid opening width parameters for Opening as specified by regulatory circulars of Pearl
entrypoint typedef struct _OpeningWidthReliefNotification {
  UINT64 notification_time;     // bytes 0 to 7
  UINT8 underlying_symbol[11];  // bytes 8 to 18
  UINT32 relief_multiplier;     // bytes 19 to 22
} OpeningWidthReliefNotification;

// ---- Arm Protection Settings Notification: 59 bytes --------------------------

// This message format will be used to notify firms of their ARM settings
entrypoint typedef struct _ArmProtectionSettingsNotification {
  UINT64 notification_time;                        // bytes 0 to 7
  UINT8 mpid[4];                                   // bytes 8 to 11
  UINT8 underlying_symbol[11];                     // bytes 12 to 22
  UINT32 allowable_engagement_percentage;          // bytes 23 to 26
  UINT16 counting_period;                          // bytes 27 to 28
  UINT8 action;                                    // byte 29
  UINT8 source;                                    // byte 30
  UINT16 market_maker_origin_multiplier;           // bytes 31 to 32
  UINT16 away_market_maker_origin_multiplier;      // bytes 33 to 34
  UINT16 broker_dealer_origin_multiplier;          // bytes 35 to 36
  UINT16 firm_origin_multiplier;                   // bytes 37 to 38
  UINT16 priority_customer_origin_multiplier;      // bytes 39 to 40
  UINT16 non_priority_customer_origin_multiplier;  // bytes 41 to 42
  UINT8 reserved_16[16];                           // bytes 43 to 58
} ArmProtectionSettingsNotification;

// ---- Arm 2 Underlying Level Protection Settings Notification: 48 bytes -------

// This message format will be used to notify firms of their ARM2 Underlying Level protection settings
entrypoint typedef struct _Arm2UnderlyingLevelProtectionSettingsNotification {
  UINT64 notification_time;      // bytes 0 to 7
  UINT8 mpid[4];                 // bytes 8 to 11
  UINT8 action;                  // byte 12
  UINT8 underlying_symbol[11];   // bytes 13 to 23
  UINT32 arm_threshold_count;    // bytes 24 to 27
  UINT32 arm_2_counting_period;  // bytes 28 to 31
  UINT8 reserved_16[16];         // bytes 32 to 47
} Arm2UnderlyingLevelProtectionSettingsNotification;

// ---- Single Side Liquidity Protection Trigger Notification: 26 bytes ---------

// This message format will be used to notify firms when a Single Side Liquidity Protection is triggered for an Option
entrypoint typedef struct _SingleSideLiquidityProtectionTriggerNotification {
  UINT64 notification_time;             // bytes 0 to 7
  UINT8 mpid[4];                        // bytes 8 to 11
  UINT32 product_id;                    // bytes 12 to 15
  UINT8 side;                           // byte 16
  UINT32 triggering_client_message_id;  // bytes 17 to 20
  UINT8 triggering_bulk_order_index;    // byte 21
  UINT8 reserved_4[4];                  // bytes 22 to 25
} SingleSideLiquidityProtectionTriggerNotification;

// ---- Arm 2 Underlying Level Protection Notification: 48 bytes ----------------

// This message format will be used to notify firms about ARM2 Underlying Level protection events
entrypoint typedef struct _Arm2UnderlyingLevelProtectionNotification {
  UINT64 notification_time;      // bytes 0 to 7
  UINT8 mpid[4];                 // bytes 8 to 11
  UINT8 underlying_symbol[11];   // bytes 12 to 22
  UINT8 notification_type;       // byte 23
  UINT32 arm_threshold_count;    // bytes 24 to 27
  UINT32 arm_2_counting_period;  // bytes 28 to 31
  UINT8 reserved_16[16];         // bytes 32 to 47
} Arm2UnderlyingLevelProtectionNotification;

// ---- Arm 2 Firm Level Protection Notification: 33 bytes ----------------------

// This message format will be used to notify firms about ARM2 Firm Level protection events
entrypoint typedef struct _Arm2FirmLevelProtectionNotification {
  UINT64 notification_time;      // bytes 0 to 7
  UINT32 arm_threshold_count;    // bytes 8 to 11
  UINT32 arm_2_counting_period;  // bytes 12 to 15
  UINT8 notification_type;       // byte 16
  UINT8 reserved_16[16];         // bytes 17 to 32
} Arm2FirmLevelProtectionNotification;

// ---- Cancel Notification: 40 bytes -------------------------------------------

// This is the message format that will be used to notify firms about order cancels. By default this is not a sequenced message; firms can request it to be configured as a sequenced message
entrypoint typedef struct _CancelNotification {
  UINT64 notification_time;       // bytes 0 to 7
  UINT8 mpid[4];                  // bytes 8 to 11
  UINT32 product_id;              // bytes 12 to 15
  UINT8 liquidity_type;           // byte 16
  UINT32 client_message_id;       // bytes 17 to 20
  UINT32 client_order_id;         // bytes 21 to 24
  UINT8 bulk_order_index;         // byte 25
  UINT8 side;                     // byte 26
  UINT32 size;                    // bytes 27 to 30
  UINT64 engine_sequence_number;  // bytes 31 to 38
  UINT8 cancel_reason;            // byte 39
} CancelNotification;

// ---- Execution Notification: 64 bytes ----------------------------------------

// This message format will be used to notify the firms of executions of their orders
entrypoint typedef struct _ExecutionNotification {
  UINT64 notification_time;   // bytes 0 to 7
  UINT8 mpid[4];              // bytes 8 to 11
  UINT32 product_id;          // bytes 12 to 15
  UINT8 liquidity_type;       // byte 16
  UINT32 client_message_id;   // bytes 17 to 20
  UINT32 client_order_id;     // bytes 21 to 24
  UINT8 bulk_order_index;     // byte 25
  UINT32 trade_id;            // bytes 26 to 29
  UINT64 execution_id;        // bytes 30 to 37
  UINT8 trade_status;         // byte 38
  UINT32 last_price;          // bytes 39 to 42
  UINT8 side;                 // byte 43
  UINT32 last_size;           // bytes 44 to 47
  UINT8 liquidity_indicator;  // byte 48
  UINT8 reserved_15[15];      // bytes 49 to 63
} ExecutionNotification;

// ---- Arm Settings Update Request: 54 bytes -----------------------------------

// Firms can use this message format to set up their ARM protection settings for each session. Changes to these settings can be made throughout the day
entrypoint typedef struct _ArmSettingsUpdateRequest {
  UINT32 client_message_id;                        // bytes 0 to 3
  UINT8 mpid[4];                                   // bytes 4 to 7
  UINT8 action;                                    // byte 8
  UINT8 underlying_symbol[11];                     // bytes 9 to 19
  UINT32 allowable_engagement_percentage;          // bytes 20 to 23
  UINT16 counting_period;                          // bytes 24 to 25
  UINT16 market_maker_origin_multiplier;           // bytes 26 to 27
  UINT16 away_market_maker_origin_multiplier;      // bytes 28 to 29
  UINT16 broker_dealer_origin_multiplier;          // bytes 30 to 31
  UINT16 firm_origin_multiplier;                   // bytes 32 to 33
  UINT16 priority_customer_origin_multiplier;      // bytes 34 to 35
  UINT16 non_priority_customer_origin_multiplier;  // bytes 36 to 37
  UINT8 reserved_16[16];                           // bytes 38 to 53
} ArmSettingsUpdateRequest;

// ---- Arm Settings Update Response: 20 bytes ----------------------------------

// Pearl uses this format to respond to the firm with a status of their ARM protection settings request
entrypoint typedef struct _ArmSettingsUpdateResponse {
  UINT32 client_message_id;          // bytes 0 to 3
  UINT8 mpid[4];                     // bytes 4 to 7
  UINT8 underlying_symbol[11];       // bytes 8 to 18
  UINT8 arm_settings_update_status;  // byte 19
} ArmSettingsUpdateResponse;

// ---- Arm 2 Underlying Level Protection Settings Update Request: 28 bytes -----

// Firms can use this message format to set up their ARM2 Underlying Level protection settings for each session. Changes to these settings can be made throughout the day
entrypoint typedef struct _Arm2UnderlyingLevelProtectionSettingsUpdateRequest {
  UINT32 client_message_id;      // bytes 0 to 3
  UINT8 mpid[4];                 // bytes 4 to 7
  UINT8 action;                  // byte 8
  UINT8 underlying_symbol[11];   // bytes 9 to 19
  UINT32 arm_threshold_count;    // bytes 20 to 23
  UINT32 arm_2_counting_period;  // bytes 24 to 27
} Arm2UnderlyingLevelProtectionSettingsUpdateRequest;

// ---- Arm 2 Underlying Level Protection Settings Update Response: 20 bytes ----

// Pearl uses this format to respond to the firm with a status of their ARM2 Underlying level protection Settings Update Request
entrypoint typedef struct _Arm2UnderlyingLevelProtectionSettingsUpdateResponse {
  UINT32 client_message_id;            // bytes 0 to 3
  UINT8 mpid[4];                       // bytes 4 to 7
  UINT8 underlying_symbol[11];         // bytes 8 to 18
  UINT8 arm_2_settings_update_status;  // byte 19
} Arm2UnderlyingLevelProtectionSettingsUpdateResponse;

// ---- Series Assignment Request: 13 bytes -------------------------------------

// Market Making firms can use this message format to communicate to Pearl which of their MM MPIDs is assigned or unassigned in a product
entrypoint typedef struct _SeriesAssignmentRequest {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT32 product_id;         // bytes 8 to 11
  UINT8 action;              // byte 12
} SeriesAssignmentRequest;

// ---- Series Assignment Response: 9 bytes -------------------------------------

// Pearl uses this format to respond to the firm assignment request
entrypoint typedef struct _SeriesAssignmentResponse {
  UINT32 client_message_id;          // bytes 0 to 3
  UINT8 mpid[4];                     // bytes 4 to 7
  UINT8 assignment_settings_status;  // byte 8
} SeriesAssignmentResponse;

// ---- Self Trade Protection Designation Request: 9 bytes ----------------------

// Firms can use this message format to communicate to Pearl which of their EEM MPIDs are designated for self-trade protection
entrypoint typedef struct _SelfTradeProtectionDesignationRequest {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT8 action;              // byte 8
} SelfTradeProtectionDesignationRequest;

// ---- Self Trade Protection Designation Response: 9 bytes ---------------------

// Pearl uses this format to respond to the firm assignment request
entrypoint typedef struct _SelfTradeProtectionDesignationResponse {
  UINT32 client_message_id;            // bytes 0 to 3
  UINT8 mpid[4];                       // bytes 4 to 7
  UINT8 self_trade_protection_status;  // byte 8
} SelfTradeProtectionDesignationResponse;

// ---- Liquidity Mass Cancel Response: 9 bytes ---------------------------------

// This message format will be used to inform the firm about the status of their previous Mass Cancel request
entrypoint typedef struct _LiquidityMassCancelResponse {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT8 status;              // byte 8
} LiquidityMassCancelResponse;

// ---- Liquidity Protection Reset Response: 9 bytes ----------------------------

// This message format is used to inform the firms of the status of their Order Protection Reset Request
entrypoint typedef struct _LiquidityProtectionResetResponse {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT8 status;              // byte 8
} LiquidityProtectionResetResponse;

// ---- Single Side Liquidity Protection Reset Request: 17 bytes ----------------

// Request to reset Single Side Liquidity Protection for the specific Option and Side for a given MPID
entrypoint typedef struct _SingleSideLiquidityProtectionResetRequest {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT32 product_id;         // bytes 8 to 11
  UINT8 side;                // byte 12
  UINT8 reserved_4[4];       // bytes 13 to 16
} SingleSideLiquidityProtectionResetRequest;

// ---- Single Side Liquidity Protection Reset Response: 13 bytes ---------------

// Response to Single Side Liquidity Protection Reset Request
entrypoint typedef struct _SingleSideLiquidityProtectionResetResponse {
  UINT32 client_message_id;  // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT8 reserved_4[4];       // bytes 8 to 11
  UINT8 status;              // byte 12
} SingleSideLiquidityProtectionResetResponse;

// ---- Liquidity Protection Trigger Notification: 24 bytes ---------------------

// This message format will be used to notify firms when order protection is triggered for an MPID
entrypoint typedef struct _LiquidityProtectionTriggerNotification {
  UINT64 notification_time;     // bytes 0 to 7
  UINT8 mpid[4];                // bytes 8 to 11
  UINT8 underlying_symbol[11];  // bytes 12 to 22
  UINT8 trigger_reason;         // byte 23
} LiquidityProtectionTriggerNotification;

// ---- Order Notification: 63 bytes --------------------------------------------

// This is the message format that will be used to notify firms about orders sent by firms. Note that this is sent for new orders only (including replaces) and it is meant to provide a copy of the order
entrypoint typedef struct _OrderNotification {
  UINT64 notification_time;       // bytes 0 to 7
  UINT32 client_order_id;         // bytes 8 to 11
  UINT32 client_message_id;       // bytes 12 to 15
  UINT8 bulk_order_index;         // byte 16
  UINT32 target_client_order_id;  // bytes 17 to 20
  UINT8 mpid[4];                  // bytes 21 to 24
  UINT32 product_id;              // bytes 25 to 28
  UINT8 time_in_force_tif;        // byte 29
  UINT8 order_instruction;        // byte 30
  UINT8 origin;                   // byte 31
  UINT8 mvp;                      // byte 32, signed, read here as unsigned
  UINT32 price;                   // bytes 33 to 36
  UINT32 size;                    // bytes 37 to 40
  UINT8 side;                     // byte 41
  UINT8 open_close;               // byte 42
  UINT8 covered_uncovered;        // byte 43
  UINT8 clearing_account[5];      // bytes 44 to 48
  UINT32 cmta;                    // bytes 49 to 52
  UINT8 account[10];              // bytes 53 to 62
} OrderNotification;

// ---- Done For The Day Notification: 63 bytes ---------------------------------

// This is the message format that will be used to notify firms about the final status of the binary orders at the end of day after end of LOW
entrypoint typedef struct _DoneForTheDayNotification {
  UINT64 notification_time;       // bytes 0 to 7
  UINT32 client_order_id;         // bytes 8 to 11
  UINT32 client_message_id;       // bytes 12 to 15
  UINT8 bulk_order_index;         // byte 16
  UINT32 target_client_order_id;  // bytes 17 to 20
  UINT8 mpid[4];                  // bytes 21 to 24
  UINT32 product_id;              // bytes 25 to 28
  UINT8 time_in_force_tif;        // byte 29
  UINT8 order_instruction;        // byte 30
  UINT8 origin;                   // byte 31
  UINT8 mvp;                      // byte 32, signed, read here as unsigned
  UINT32 price;                   // bytes 33 to 36
  UINT32 size;                    // bytes 37 to 40
  UINT8 side;                     // byte 41
  UINT8 open_close;               // byte 42
  UINT8 covered_uncovered;        // byte 43
  UINT8 clearing_account[5];      // bytes 44 to 48
  UINT32 cmta;                    // bytes 49 to 52
  UINT8 account[10];              // bytes 53 to 62
} DoneForTheDayNotification;

// ---- Login Request: 35 bytes -------------------------------------------------

// The SesM client uses this packet to allow the server to authenticate the client and to convey to the server the last sequenced packet that the client received
entrypoint typedef struct _LoginRequest {
  UINT8 sesm_version[5];             // bytes 0 to 4
  UINT8 username[5];                 // bytes 5 to 9
  UINT8 computer_id[8];              // bytes 10 to 17
  UINT8 application_protocol[8];     // bytes 18 to 25
  UINT8 requested_session;           // byte 26
  UINT64 requested_sequence_number;  // bytes 27 to 34
} LoginRequest;

// ---- Login Response: 10 bytes ------------------------------------------------

// The SesM server sends a Login response packet in response to a Login request packet from the client
entrypoint typedef struct _LoginResponse {
  UINT8 login_status;              // byte 0
  UINT8 session_id;                // byte 1
  UINT64 highest_sequence_number;  // bytes 2 to 9
} LoginResponse;

// ---- Retransmission Request: 16 bytes ----------------------------------------

// The SesM client uses this packet to request the server to retransmit a range of packets
entrypoint typedef struct _RetransmissionRequest {
  UINT64 start_sequence_number;  // bytes 0 to 7
  UINT64 end_sequence_number;    // bytes 8 to 15
} RetransmissionRequest;

