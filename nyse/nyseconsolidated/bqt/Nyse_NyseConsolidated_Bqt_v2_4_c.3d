  UINT16 nyse_group_market_id_of_low_price;            // bytes 34 to 35
  UINT16 market_id_of_open_price;                      // bytes 36 to 37
  UINT8 num_close_prices;                              // byte 38
  UINT16 nyse_group_market_id_of_the_close;            // bytes 39 to 40
  UINT32 primary_listing_market_official_close_price;  // bytes 41 to 44, signed, read here as unsigned
  UINT32 consolidated_high_price;                      // bytes 45 to 48, signed, read here as unsigned
  UINT32 consolidated_low_price;                       // bytes 49 to 52, signed, read here as unsigned
  UINT32 consolidated_first_price;                     // bytes 53 to 56, signed, read here as unsigned
  UINT32 consolidated_last_price;                      // bytes 57 to 60, signed, read here as unsigned
  UINT8 complete;                                      // byte 61
} ConsolidatedFractionalStockSummaryMessage;

