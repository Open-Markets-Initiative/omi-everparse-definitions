// ---- Consolidated Fractional Stock Summary Message: 62 bytes -----------------

// The stock summary message is sent every 1 minute, after a security is Open.
entrypoint typedef struct _ConsolidatedFractionalStockSummaryMessage {
  UINT32 source_time;                                  // bytes 0 to 3
  UINT32 source_time_ns;                               // bytes 4 to 7
  UINT32 symbol_index;                                 // bytes 8 to 11
