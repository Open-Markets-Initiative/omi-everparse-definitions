#define MANUAL_ACTION_TYPE_REDUCE_MANUAL_DMM_QTY 0x02     // Reduce Manual Dmm Qty
#define MANUAL_ACTION_TYPE_OPENING_AUCTION 0x03           // Opening Auction
#define MANUAL_ACTION_TYPE_REOPENING_AUCTION 0x04         // Reopening Auction
#define MANUAL_ACTION_TYPE_CLOSING_AUCTION 0x05           // Closing Auction
#define MANUAL_ACTION_TYPE_MANUAL_CROSS 0x06              // Manual Cross
#define MANUAL_ACTION_TYPE_CANCEL_ALL_MANUAL_ORDERS 0x07  // Cancel All Manual Orders

// Risk Ack Type: one byte code
#define RISK_ACK_TYPE_SOLICITED 0x00    // Solicited
#define RISK_ACK_TYPE_UNSOLICITED 0x01  // Unsolicited

// Risk User Type: one byte code
#define RISK_USER_TYPE_ENTERING_FIRM 0x45              // Entering Firm
#define RISK_USER_TYPE_CLEARING_FIRM 0x43              // Clearing Firm
#define RISK_USER_TYPE_OPTIONS_MARKET_MAKER_FIRM 0x4F  // Options Market Maker Firm

// Risk Control Type: one byte code
#define RISK_CONTROL_TYPE_NOT_APPLICABLE 0x00                         // Not Applicable
#define RISK_CONTROL_TYPE_SINGLE_ORDER_MAX_QTY 0x01                   // Single Order Max Qty
#define RISK_CONTROL_TYPE_SINGLE_ORDER_MAX_NOTIONAL_VALUE 0x02        // Single Order Max Notional Value
#define RISK_CONTROL_TYPE_GROSS_CREDIT_EXECUTED 0x03                  // Gross Credit Executed
#define RISK_CONTROL_TYPE_GROSS_CREDIT_OPEN 0x04                      // Gross Credit Open
#define RISK_CONTROL_TYPE_GROSS_CREDIT_OPEN_PLUS_EXECUTED 0x05        // Gross Credit Open Plus Executed
#define RISK_CONTROL_TYPE_MAXIMUM_DUPLICATIVE_ORDERS 0x06             // Maximum Duplicative Orders
#define RISK_CONTROL_TYPE_RESERVED_FOR_FUTURE_USE_7 0x07              // Reserved For Future Use 7
#define RISK_CONTROL_TYPE_ACTIVITY_ROLLING_TRANSACTION 0x08           // Activity Rolling Transaction
#define RISK_CONTROL_TYPE_ACTIVITY_ROLLING_VOLUME 0x09                // Activity Rolling Volume
#define RISK_CONTROL_TYPE_ACTIVITY_ROLLING_PERCENTAGE 0x0A            // Activity Rolling Percentage
#define RISK_CONTROL_TYPE_ACTIVITY_GLOBAL_RISK_MITIGATION 0x0B        // Activity Global Risk Mitigation
#define RISK_CONTROL_TYPE_RESERVED_FOR_FUTURE_USE_12 0x0C             // Reserved For Future Use 12
#define RISK_CONTROL_TYPE_REJECT_MARKET_ORDERS 0x0D                   // Reject Market Orders
#define RISK_CONTROL_TYPE_REJECT_MOO_AND_MOC 0x0E                     // Reject Moo And Moc
#define RISK_CONTROL_TYPE_NOT_AVAILABLE_15 0x0F                       // Not Available 15
#define RISK_CONTROL_TYPE_NOT_AVAILABLE_16 0x10                       // Not Available 16
#define RISK_CONTROL_TYPE_REJECT_EARLY_TRADING_SESSION 0x11           // Reject Early Trading Session
#define RISK_CONTROL_TYPE_REJECT_LATE_TRADING_SESSION 0x12            // Reject Late Trading Session
#define RISK_CONTROL_TYPE_REJECT_RESTRICTED_SYMBOL 0x13               // Reject Restricted Symbol
#define RISK_CONTROL_TYPE_REJECT_SELL_SHORT_FOR_SYMBOL 0x14           // Reject Sell Short For Symbol
#define RISK_CONTROL_TYPE_REJECT_SELL_SHORT_EXEMPT_FOR_SYMBOL 0x15    // Reject Sell Short Exempt For Symbol
#define RISK_CONTROL_TYPE_SINGLE_ORDER_MAX_QTY_PCT_ADV 0x16           // Single Order Max Qty Pct Adv
#define RISK_CONTROL_TYPE_LOPP_EQUITIES_CUSTOM_LIMITS 0x17            // Lopp Equities Custom Limits
#define RISK_CONTROL_TYPE_LOPP_EQUITIES_EARLY_LATE_MULTIPLIER 0x18    // Lopp Equities Early Late Multiplier
#define RISK_CONTROL_TYPE_LOPP_EQUITIES_CLOSING_ONLY_MULTIPLIER 0x19  // Lopp Equities Closing Only Multiplier
#define RISK_CONTROL_TYPE_LOPP_OPTIONS_SINGLE_LEG_CUSTOM_LIMITS 0x1A  // Lopp Options Single Leg Custom Limits
#define RISK_CONTROL_TYPE_LOPP_OPTIONS_COMPLEX_CUSTOM_LIMITS 0x1B     // Lopp Options Complex Custom Limits
#define RISK_CONTROL_TYPE_REQUIRE_LOCATE_BROKER 0x1C                  // Require Locate Broker
#define RISK_CONTROL_TYPE_ORDER_RATE_THRESHOLD 0x1D                   // Order Rate Threshold
#define RISK_CONTROL_TYPE_REJECT_ISO_IOC 0x1E                         // Reject Iso Ioc
#define RISK_CONTROL_TYPE_REJECT_ISO_DAY 0x1F                         // Reject Iso Day

// Risk Control Activation: one byte code
#define RISK_CONTROL_ACTIVATION_RISK_CONTROL_TURNED_OFF 0x00  // Risk Control Turned Off
#define RISK_CONTROL_ACTIVATION_RISK_CONTROL_TURNED_ON 0x01   // Risk Control Turned On

// Risk Action Type: one byte code
#define RISK_ACTION_TYPE_NOT_APPLICABLE 0x00                         // Not Applicable
#define RISK_ACTION_TYPE_QUERY_RISK_ENTITY 0x01                      // Query Risk Entity
#define RISK_ACTION_TYPE_KILL_SWITCH_BLOCK 0x02                      // Kill Switch Block
#define RISK_ACTION_TYPE_KILL_SWITCH_UNBLOCK 0x03                    // Kill Switch Unblock
#define RISK_ACTION_TYPE_KILL_SWITCH_CANCEL_AUCTION_ORDERS 0x04      // Kill Switch Cancel Auction Orders
#define RISK_ACTION_TYPE_KILL_SWITCH_CANCEL_NON_AUCTION_ORDERS 0x05  // Kill Switch Cancel Non Auction Orders
#define RISK_ACTION_TYPE_KILL_SWITCH_CANCEL_GTC_ORDERS 0x06          // Kill Switch Cancel Gtc Orders
#define RISK_ACTION_TYPE_APPROVE_REINSTATEMENT 0x07                  // Approve Reinstatement
#define RISK_ACTION_TYPE_RISK_ENTITY_REINSTATED 0x08                 // Risk Entity Reinstated
#define RISK_ACTION_TYPE_ADD_SYMBOL_LEVEL_RISK_ENTITY 0x09           // Add Symbol Level Risk Entity
#define RISK_ACTION_TYPE_REMOVE_SYMBOL_LEVEL_RISK_ENTITY 0x0A        // Remove Symbol Level Risk Entity

// Breach Action Response: one byte code
#define BREACH_ACTION_RESPONSE_NOT_APPLICABLE 0x00    // Not Applicable
#define BREACH_ACTION_RESPONSE_NOTIFY_ONLY 0x01       // Notify Only
#define BREACH_ACTION_RESPONSE_CANCEL_AND_BLOCK 0x02  // Cancel And Block
#define BREACH_ACTION_RESPONSE_BLOCK 0x03             // Block

// Ioc Attribution: one byte code
#define IOC_ATTRIBUTION_NOT_APPLICABLE 0x00      // Not Applicable
#define IOC_ATTRIBUTION_INCLUDE_IOC_ORDERS 0x01  // Include Ioc Orders
#define IOC_ATTRIBUTION_EXCLUDE_IOC_ORDERS 0x02  // Exclude Ioc Orders

// Blocked By Breach Indicator: one byte code
#define BLOCKED_BY_BREACH_INDICATOR_NOT_BLOCKED 0x00           // Not Blocked
#define BLOCKED_BY_BREACH_INDICATOR_BLOCKED_BY_BREACH 0x01     // Blocked By Breach
#define BLOCKED_BY_BREACH_INDICATOR_BLOCKED_BY_ARB_CHECK 0x02  // Blocked By Arb Check
#define BLOCKED_BY_BREACH_INDICATOR_BLOCKED_BY_INTRINSIC 0x03  // Blocked By Intrinsic

// Blocked By Kill Switch Indicator: one byte code
#define BLOCKED_BY_KILL_SWITCH_INDICATOR_NOT_BLOCKED 0x00  // Not Blocked
#define BLOCKED_BY_KILL_SWITCH_INDICATOR_BLOCKED 0x01      // Blocked

// Reinstatement Required By Self: one byte code
#define REINSTATEMENT_REQUIRED_BY_SELF_NOT_REQUIRED 0x00  // Not Required
#define REINSTATEMENT_REQUIRED_BY_SELF_REQUIRED 0x01      // Required

// Reinstatement Required By Other: one byte code
#define REINSTATEMENT_REQUIRED_BY_OTHER_NOT_REQUIRED 0x00  // Not Required
#define REINSTATEMENT_REQUIRED_BY_OTHER_REQUIRED 0x01      // Required

// Price Scale: one byte code
#define PRICE_SCALE_NO_DECIMALS 0x00   // No Decimals
#define PRICE_SCALE_TWO_DECIMALS 0x02  // Two Decimals

// Threshold Breach Level: one byte code
#define THRESHOLD_BREACH_LEVEL_NOT_APPLICABLE 0x00            // Not Applicable
#define THRESHOLD_BREACH_LEVEL_GREATER_THAN_50_PERCENT 0x01   // Greater Than 50 Percent
#define THRESHOLD_BREACH_LEVEL_GREATER_THAN_75_PERCENT 0x02   // Greater Than 75 Percent
#define THRESHOLD_BREACH_LEVEL_GREATER_THAN_90_PERCENT 0x03   // Greater Than 90 Percent
#define THRESHOLD_BREACH_LEVEL_GREATER_THAN_100_PERCENT 0x04  // Greater Than 100 Percent

// ---- Types -------------------------------------------------------------------

// Pillar Stream Login Response Message Branch
typedef struct _LoginResponse {
  UINT8 username[16];  // bytes 0 to 15
  UINT8 status;        // byte 16
} LoginResponse;

// Pillar Stream Protocol Stream Identifier
typedef struct _StreamId {
  UINT32 sess;   // bytes 0 to 3
  UINT32 value;  // bytes 4 to 7
} StreamId;

// The message contains stream ID and sequence of next message on stream
typedef struct _StreamAvail {
  StreamId stream_id;  // bytes 0 to 7
  UINT64 next_seq;     // bytes 8 to 15
  UINT8 access;        // byte 16
} StreamAvail;

// Heartbeat must be sent once a second
typedef struct _Heartbeat {
  unit empty;
} Heartbeat;

// Response to Open
typedef struct _OpenResponse {
  StreamId stream_id;  // bytes 0 to 7
  UINT8 status;        // byte 8
  UINT8 access;        // byte 9
} OpenResponse;

// Response to Close Message
typedef struct _CloseResponse {
  StreamId stream_id;  // bytes 0 to 7
  UINT8 status;        // byte 8
} CloseResponse;

// Pillar Stream Sequenced Message Identifier
typedef struct _SeqMsgId {
  StreamId stream_id;  // bytes 0 to 7
  UINT64 seq;          // bytes 8 to 15
} SeqMsgId;

// This message is published for each security traded on the market for which a gateway session is configured to trade and provides the information needed to enter orders for those securities.
typedef struct _EquitiesSymbolReferenceDataMessage {
  UINT64 transact_time;         // bytes 0 to 7
  UINT32 symbol_id;             // bytes 8 to 11
  UINT8 nyse_symbol[24];        // bytes 12 to 35
  UINT8 listed_mic[4];          // bytes 36 to 39
  UINT8 round_lot_size;         // byte 40
  UINT8 adv_risk_range_id;      // byte 41
  UINT8 reserved_7[7];          // bytes 42 to 48
  UINT16 mpv_class_id;          // bytes 49 to 50
  UINT8 test_symbol_indicator;  // byte 51
} EquitiesSymbolReferenceDataMessage;

// DMM Symbol Reference Data
typedef struct _DmmSymbolReferenceDataMessage {
  UINT64 transact_time;           // bytes 0 to 7
  UINT32 symbol_id;               // bytes 8 to 11
  UINT8 nyse_symbol[24];          // bytes 12 to 35
  UINT8 book[8];                  // bytes 36 to 43
  UINT8 mpid[4];                  // bytes 44 to 47
  UINT8 dmm_unit_num[3];          // bytes 48 to 50
  UINT8 post[2];                  // bytes 51 to 52
  UINT64 median_volume;           // bytes 53 to 60
  UINT64 rd_seq;                  // bytes 61 to 68
  UINT64 ridge_price;             // bytes 69 to 76, signed, read here as unsigned
  UINT64 ppp_1;                   // bytes 77 to 84, signed, read here as unsigned
  UINT64 ppp_2;                   // bytes 85 to 92, signed, read here as unsigned
  UINT64 ppp_3;                   // bytes 93 to 100, signed, read here as unsigned
  UINT64 open_on_trade_max_qty;   // bytes 101 to 108
  UINT64 close_on_trade_max_qty;  // bytes 109 to 116
  UINT64 lmocp;                   // bytes 117 to 124, signed, read here as unsigned
} DmmSymbolReferenceDataMessage;

// Defines a single Minimum Price Variant (MPV) Class by name and identification number and provides attributes belonging to that class.
typedef struct _MinimumPriceVariantClassReferenceDataMessage {
  UINT64 transact_time;      // bytes 0 to 7
  UINT8 mpv_class_name[20];  // bytes 8 to 27
  UINT16 mpv_class_id;       // bytes 28 to 29
  UINT64 rpimpv;             // bytes 30 to 37, signed, read here as unsigned
  UINT64 luldmpv;            // bytes 38 to 45, signed, read here as unsigned
} MinimumPriceVariantClassReferenceDataMessage;

// MPVLevelDefinition
typedef struct _MpvLevelDefinition {
  UINT8 mpv_level_name[24];  // bytes 0 to 23
  UINT64 price;              // bytes 24 to 31, signed, read here as unsigned
  UINT64 quoting_mpv;        // bytes 32 to 39, signed, read here as unsigned
  UINT64 trading_mpv;        // bytes 40 to 47, signed, read here as unsigned
  UINT16 mpv_class_id;       // bytes 48 to 49
} MpvLevelDefinition;

// Defines one or more Minimum Price Variant (MPV) Levels within a single MPV Class. Each embedded MPVLevelDefinition structure defines a single MPV Level.
typedef struct _MinimumPriceVariantLevelReferenceDataMessage (UINT32 available) where (available >= 8) {
  UINT64 transact_time;                                                 // bytes 0 to 7
  MpvLevelDefinition mpv_level_definition[:byte-size (available - 8)];
} MinimumPriceVariantLevelReferenceDataMessage;

// This message is published for each MPID configured on a gateway session and indicates the current status of the MPID.
typedef struct _MpidConfigurationMessage {
  UINT64 transact_time;   // bytes 0 to 7
  UINT8 mpid_status;      // byte 8
  UINT8 mpid[4];          // bytes 9 to 12
  UINT8 username[16];     // bytes 13 to 28
  UINT8 reserved_50[50];  // bytes 29 to 78
} MpidConfigurationMessage;

// This message is published for each MMID configured on a gateway session and provides the character representation of a Market Maker and the integer MMID value assigned to it.
typedef struct _MmidConfigurationMessage {
  UINT64 transact_time;     // bytes 0 to 7
  UINT8 market_maker[10];   // bytes 8 to 17
  UINT32 mmid;              // bytes 18 to 21
  UINT8 username[16];       // bytes 22 to 37
  UINT8 reserved_100[100];  // bytes 38 to 137
} MmidConfigurationMessage;

// Indicates the current configured settings for the gateway session.
typedef struct _SessionConfigurationAcknowledgementMessage {
  UINT64 transact_time;                          // bytes 0 to 7
  UINT8 user_session_type;                       // byte 8
  UINT8 user_session_status;                     // byte 9
  UINT8 username[16];                            // bytes 10 to 25
  UINT8 mic[4];                                  // bytes 26 to 29
  UINT8 cancel_on_disconnect;                    // byte 30
  UINT8 throttle_preference;                     // byte 31
  UINT16 throttle_window;                        // bytes 32 to 33
  UINT16 throttle_threshold;                     // bytes 34 to 35
  UINT8 symbol_eligibility;                      // byte 36
  UINT32 max_order_quantity;                     // bytes 37 to 40
  UINT8 self_trade_prevention;                   // byte 41
  UINT8 order_priority_update_ack_subscription;  // byte 42
  UINT8 ack_status;                              // byte 43
  UINT8 bold_designation;                        // byte 44
  UINT8 reserved_49[49];                         // bytes 45 to 93
} SessionConfigurationAcknowledgementMessage;

// Pillar Stream Sub Message Item Header
typedef struct _SubMsgHeader {
  UINT16 sub_msg_type;    // bytes 0 to 1
  UINT16 sub_msg_length;  // bytes 2 to 3
} SubMsgHeader;

// OptionalOrderAddOn
typedef struct _OptionalOrderAddOn {
  SubMsgHeader sub_msg_header;  // bytes 0 to 3
  UINT8 deliver_to_comp_id[5];  // bytes 4 to 8
  UINT32 max_floor;             // bytes 9 to 12
  UINT8 locate_broker[4];       // bytes 13 to 16
  UINT8 reserved_8[8];          // bytes 17 to 24
  UINT64 offset_price;          // bytes 25 to 32, signed, read here as unsigned
  UINT64 effective_time;        // bytes 33 to 40
} OptionalOrderAddOn;

// OptionalOrderAddOn
casetype _OptionalOptionalOrderAddOn (Bool present) {
  switch (present) {
    case true: OptionalOrderAddOn optional_order_add_on;
    case false: unit absent;
  }
} OptionalOptionalOrderAddOn;

// OptionalRoutingStrategyAddOn
typedef struct _OptionalRoutingStrategyAddOn {
  SubMsgHeader sub_msg_header;  // bytes 0 to 3
  UINT8 routing_strategy;       // byte 4
  UINT8 reserved_27[27];        // bytes 5 to 31
} OptionalRoutingStrategyAddOn;

// OptionalRoutingStrategyAddOn
casetype _OptionalOptionalRoutingStrategyAddOn (Bool present) {
  switch (present) {
    case true: OptionalRoutingStrategyAddOn optional_routing_strategy_add_on;
    case false: unit absent;
  }
} OptionalOptionalRoutingStrategyAddOn;

// OptionalSettlementTypeAddOn
typedef struct _OptionalSettlementTypeAddOn {
  SubMsgHeader sub_msg_header;  // bytes 0 to 3
  UINT8 settlement_type;        // byte 4
} OptionalSettlementTypeAddOn;

// OptionalSettlementTypeAddOn
casetype _OptionalOptionalSettlementTypeAddOn (Bool present) {
  switch (present) {
    case true: OptionalSettlementTypeAddOn optional_settlement_type_add_on;
    case false: unit absent;
  }
} OptionalOptionalSettlementTypeAddOn;

// Exchange acknowledgement in response to an Order or Cancel/Replace request.
typedef struct _OrderAndCancelReplaceAcknowledgementMessage (UINT16 seq_msg_length) {
  UINT64 transact_time;                                                                               // bytes 0 to 7
  UINT32 symbol_id;                                                                                   // bytes 8 to 11
  UINT8 mpid[4];                                                                                      // bytes 12 to 15
  UINT32 mmid;                                                                                        // bytes 16 to 19
  UINT8 m_p_sub_i_d_1;                                                                                // byte 20
  UINT64 cl_ord_id;                                                                                   // bytes 21 to 28
  UINT64 orig_cl_ord_id;                                                                              // bytes 29 to 36
  UINT64 unused_12 : 12;                                                                              // bytes 37 to 44
  UINT64 sub_id_indicator : 1;                                                                        // bytes 37 to 44
  UINT64 special_ord_type : 4;                                                                        // bytes 37 to 44
  UINT64 locate_reqd_1 : 1;                                                                           // bytes 37 to 44
  UINT64 retail_indicator : 1;                                                                        // bytes 37 to 44
  UINT64 attributed_quote : 3;                                                                        // bytes 37 to 44
  UINT64 order_capacity : 3;                                                                          // bytes 37 to 44
  UINT64 interest_type : 3;                                                                           // bytes 37 to 44
  UINT64 trading_session_id : 3;                                                                      // bytes 37 to 44
  UINT64 time_in_force : 3;                                                                           // bytes 37 to 44
  UINT64 proactive_if_locked : 3;                                                                     // bytes 37 to 44
  UINT64 self_trade_type_3 : 3;                                                                       // bytes 37 to 44
  UINT64 cancel_instead_of_reprice : 4;                                                               // bytes 37 to 44
  UINT64 routing_inst : 4;                                                                            // bytes 37 to 44
  UINT64 extended_exec_inst : 4;                                                                      // bytes 37 to 44
  UINT64 exec_inst : 4;                                                                               // bytes 37 to 44
  UINT64 ord_type : 4;                                                                                // bytes 37 to 44
  UINT64 side_bits : 4;                                                                               // bytes 37 to 44
  UINT64 price;                                                                                       // bytes 45 to 52, signed, read here as unsigned
  UINT32 order_qty;                                                                                   // bytes 53 to 56
  UINT32 min_qty;                                                                                     // bytes 57 to 60
  UINT64 order_id;                                                                                    // bytes 61 to 68
  UINT32 leaves_qty;                                                                                  // bytes 69 to 72
  UINT64 working_price;                                                                               // bytes 73 to 80, signed, read here as unsigned
  UINT8 working_away_from_display;                                                                    // byte 81
  UINT8 pre_liquidity_indicator[4];                                                                   // bytes 82 to 85
  UINT16 reason_code;                                                                                 // bytes 86 to 87
  UINT8 ack_type;                                                                                     // byte 88
  UINT8 throttled : 1;                                                                                // byte 89
  UINT8 unused_7 : 7;                                                                                 // byte 89
  UINT8 user_data[8];                                                                                 // bytes 90 to 97
  OptionalOptionalOrderAddOn((seq_msg_length == 0x008F)) optional_order_add_on;
  OptionalOptionalRoutingStrategyAddOn((seq_msg_length == 0x0086)) optional_routing_strategy_add_on;
  OptionalOptionalSettlementTypeAddOn((seq_msg_length == 0x006B)) optional_settlement_type_add_on;
} OrderAndCancelReplaceAcknowledgementMessage;

// Used as a Modify Request Acknowledgement, Cancel Request Acknowledgement, UROUT, and Billable Cancel, distinguished by AckType.
typedef struct _OrderModifyCancelRequestAcknowledgmentAndUroutMessage {
  UINT64 transact_time;    // bytes 0 to 7
  UINT32 symbol_id;        // bytes 8 to 11
  UINT8 mpid[4];           // bytes 12 to 15
  UINT64 order_id;         // bytes 16 to 23
  UINT64 ref_cl_ord_id;    // bytes 24 to 31
  UINT64 orig_cl_ord_id;   // bytes 32 to 39
  UINT64 price;            // bytes 40 to 47, signed, read here as unsigned
  UINT32 order_qty;        // bytes 48 to 51
  UINT32 leaves_qty;       // bytes 52 to 55
  UINT8 side;              // byte 56
  UINT8 locate_reqd_u_81;  // byte 57
  UINT16 reason_code;      // bytes 58 to 59
  UINT8 ack_type;          // byte 60
  UINT8 throttled : 1;     // byte 61
  UINT8 unused_7 : 7;      // byte 61
  UINT8 user_data[8];      // bytes 62 to 69
} OrderModifyCancelRequestAcknowledgmentAndUroutMessage;

// Unsolicited message sent by the Exchange to notify the firm of a Reserve Order replenishment event. The displayed portion of a Reserve Order has been replenished according to MaxFloor and assigned a new OrderID.
typedef struct _OrderPriorityUpdateAcknowledgmentMessage {
  UINT64 transact_time;              // bytes 0 to 7
  UINT32 symbol_id;                  // bytes 8 to 11
  UINT8 mpid[4];                     // bytes 12 to 15
  UINT64 order_id;                   // bytes 16 to 23
  UINT64 cl_ord_id;                  // bytes 24 to 31
  UINT64 working_price;              // bytes 32 to 39, signed, read here as unsigned
  UINT32 order_qty;                  // bytes 40 to 43
  UINT8 working_away_from_display;   // byte 44
  UINT8 pre_liquidity_indicator[4];  // bytes 45 to 48
  UINT8 ack_type;                    // byte 49
  UINT8 user_data[8];                // bytes 50 to 57
} OrderPriorityUpdateAcknowledgmentMessage;

// Returned on executions for Orders and indicates whether an order has been partially or entirely filled.
typedef struct _ExecutionReportMessage (UINT16 seq_msg_length) {
  UINT64 transact_time;                                                                             // bytes 0 to 7
  UINT32 symbol_id;                                                                                 // bytes 8 to 11
  UINT8 mpid[4];                                                                                    // bytes 12 to 15
  UINT64 order_id;                                                                                  // bytes 16 to 23
  UINT64 cl_ord_id;                                                                                 // bytes 24 to 31
  UINT64 deal_id;                                                                                   // bytes 32 to 39
  UINT64 last_px;                                                                                   // bytes 40 to 47, signed, read here as unsigned
  UINT32 leaves_qty;                                                                                // bytes 48 to 51
  UINT32 cum_qty;                                                                                   // bytes 52 to 55
  UINT32 last_qty;                                                                                  // bytes 56 to 59
  UINT8 liquidity_indicator[4];                                                                     // bytes 60 to 63
  UINT8 displayed_liquidity_indicator[4];                                                           // bytes 64 to 67
  UINT8 locate_reqd_u_81;                                                                           // byte 68
  UINT8 participant_type;                                                                           // byte 69
  UINT16 reason_code;                                                                               // bytes 70 to 71
  UINT8 user_data[8];                                                                               // bytes 72 to 79
  OptionalOptionalSettlementTypeAddOn((seq_msg_length == 0x0059)) optional_settlement_type_add_on;
} ExecutionReportMessage;

// Pillar reference sequenced message identifier
typedef struct _RefSeqMsgId {
  StreamId stream_id;  // bytes 0 to 7
  UINT64 seq;          // bytes 8 to 15
} RefSeqMsgId;

// This message is sent as a result of a report bust or correction (NYSE Texas only).
typedef struct _TradeBustCorrectMessage {
  UINT64 transact_time;        // bytes 0 to 7
  UINT32 symbol_id;            // bytes 8 to 11
  UINT8 mpid[4];               // bytes 12 to 15
  UINT64 order_id;             // bytes 16 to 23
  UINT64 cl_ord_id;            // bytes 24 to 31
  RefSeqMsgId ref_seq_msg_id;  // bytes 32 to 47
  UINT64 deal_id;              // bytes 48 to 55
  UINT64 last_px;              // bytes 56 to 63, signed, read here as unsigned
  UINT32 last_qty;             // bytes 64 to 67
  UINT16 reason_code;          // bytes 68 to 69
  UINT8 user_data[8];          // bytes 70 to 77
} TradeBustCorrectMessage;

// This message informs the firm that a New Order, Cancel, Cancel/Replace, or Modify request has been rejected. For NYSE DMM sessions it is also used to reject TG Action and Manual Action Response.
typedef struct _ApplicationLayerRejectMessage {
  UINT64 transact_time;  // bytes 0 to 7
  UINT32 symbol_id;      // bytes 8 to 11
  UINT8 mpid[4];         // bytes 12 to 15
  UINT64 cl_ord_id;      // bytes 16 to 23
  UINT16 reason_code;    // bytes 24 to 25
  UINT8 reject_type;     // byte 26
  UINT8 user_data[8];    // bytes 27 to 34
  UINT8 reserved_4[4];   // bytes 35 to 38
} ApplicationLayerRejectMessage;

// Response to a Symbol Subscription Request indicating whether the DMM session is subscribed to the symbol.
typedef struct _SymbolSubscriptionAcknowledgementMessage {
  UINT64 transact_time;       // bytes 0 to 7
  UINT32 symbol_id;           // bytes 8 to 11
  UINT8 username[16];         // bytes 12 to 27
  UINT8 subscription_status;  // byte 28
} SymbolSubscriptionAcknowledgementMessage;

// Defines the beginning boundary of a multi-message sequence originating from Pillar that must be processed atomically by the firm.
typedef struct _GtBeginMessage {
  UINT64 transact_time;  // bytes 0 to 7
} GtBeginMessage;

// Defines the ending boundary of a multi-message sequence originating from Pillar that must be processed atomically by the firm.
typedef struct _GtEndMessage {
  UINT64 transact_time;  // bytes 0 to 7
} GtEndMessage;

// Provides opening, re-opening, and closing auction imbalance and DMM interest information at each eligible auction price point. Sent as part of a multi-message between GT Begin and GT End.
typedef struct _AuctionPriceDataMessage {
  UINT64 transact_time;           // bytes 0 to 7
  UINT32 symbol_id;               // bytes 8 to 11
  UINT8 imbalance_side;           // byte 12
  UINT8 side_of_unpaired_qty;     // byte 13
  UINT32 imbalance_volume;        // bytes 14 to 17
  UINT64 price;                   // bytes 18 to 25, signed, read here as unsigned
  UINT32 paired_qty;              // bytes 26 to 29
  UINT32 unpaired_qty;            // bytes 30 to 33
  UINT32 buy_dmm_available_qty;   // bytes 34 to 37
  UINT32 sell_dmm_available_qty;  // bytes 38 to 41
} AuctionPriceDataMessage;

// Request from Pillar to open, re-open, or close a symbol with an auction trade.
typedef struct _AuctionRequestMessage {
  UINT64 transact_time;     // bytes 0 to 7
  UINT32 symbol_id;         // bytes 8 to 11
  UINT8 auction_type;       // byte 12
  UINT64 ssr_filing_price;  // bytes 13 to 20, signed, read here as unsigned
} AuctionRequestMessage;

// ManualActionID
typedef struct _ManualActionId {
  StreamId stream_id;  // bytes 0 to 7
  UINT64 seq;          // bytes 8 to 15
} ManualActionId;

// Manual action details initiated by a DMM on the NYSE Trading Floor via DBK GUI.
typedef struct _ManualActionRequestMessage {
  UINT64 transact_time;              // bytes 0 to 7
  UINT32 symbol_id;                  // bytes 8 to 11
  UINT8 introducing_badge_id[4];     // bytes 12 to 15
