// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AmexEquities_ImbalancesFeed_v2_1_f.3d

// ---- Values ------------------------------------------------------------------

// Delivery Flag: one byte code
#define DELIVERY_FLAG_HEARTBEAT 0x01                        // Heartbeat
#define DELIVERY_FLAG_XDP_FAILOVER 0x0A                     // Xdp Failover
#define DELIVERY_FLAG_ORIGINAL_MESSAGE 0x0B                 // Original Message
#define DELIVERY_FLAG_SEQUENCE_NUMBER_RESET_MESSAGE 0x0C    // Sequence Number Reset Message
#define DELIVERY_FLAG_ONE_RETRANSMISSION_PACKET 0x0D        // One Retransmission Packet
#define DELIVERY_FLAG_RETRANSMISSION_SEQUENCE_MESSAGE 0x0F  // Retransmission Sequence Message
#define DELIVERY_FLAG_ONE_REFRESH_PACKET 0x11               // One Refresh Packet
#define DELIVERY_FLAG_REFRESH_SEQUENCE_START 0x12           // Refresh Sequence Start
#define DELIVERY_FLAG_REFRESH_SEQUENCE_MESSAGE 0x13         // Refresh Sequence Message
#define DELIVERY_FLAG_REFRESH_SEQUENCE_END 0x14             // Refresh Sequence End
#define DELIVERY_FLAG_MESSAGE_UNAVAILABLE 0x15              // Message Unavailable

// Message Type: 2 byte code
#define MESSAGE_TYPE_SEQUENCE_NUMBER_RESET_MESSAGE 0x0001         // Sequence Number Reset Message
#define MESSAGE_TYPE_SYMBOL_INDEX_MAPPING_MESSAGE 0x0003          // Symbol Index Mapping Message
#define MESSAGE_TYPE_RETRANSMISSION_REQUEST_MESSAGE 0x000A        // Retransmission Request Message
#define MESSAGE_TYPE_REQUEST_RESPONSE_MESSAGE 0x000B              // Request Response Message
#define MESSAGE_TYPE_HEARTBEAT_RESPONSE_MESSAGE 0x000C            // Heartbeat Response Message
#define MESSAGE_TYPE_SYMBOL_INDEX_MAPPING_REQUEST_MESSAGE 0x000D  // Symbol Index Mapping Request Message
#define MESSAGE_TYPE_REFRESH_REQUEST_MESSAGE 0x000F               // Refresh Request Message
#define MESSAGE_TYPE_MESSAGE_UNAVAILABLE_MESSAGE 0x001F           // Message Unavailable Message
#define MESSAGE_TYPE_SYMBOL_CLEAR_MESSAGE 0x0020                  // Symbol Clear Message
#define MESSAGE_TYPE_SECURITY_STATUS_MESSAGE 0x0022               // Security Status Message
#define MESSAGE_TYPE_REFRESH_HEADER_MESSAGE 0x0023                // Refresh Header Message
#define MESSAGE_TYPE_IMBALANCE_MESSAGE 0x0069                     // Imbalance Message

// Auction Type: one byte code
#define AUCTION_TYPE_EARLY_OPENING 0x4F         // Early Opening
#define AUCTION_TYPE_CORE_OPENING 0x4D          // Core Opening
#define AUCTION_TYPE_REOPENING 0x48             // Reopening
#define AUCTION_TYPE_CLOSING 0x43               // Closing
#define AUCTION_TYPE_REGULATORY_IMBALANCE 0x52  // Regulatory Imbalance

// Imbalance Side: one byte code
#define IMBALANCE_SIDE_NO_IMBALANCE 0x20  // No Imbalance
#define IMBALANCE_SIDE_BUY_SIDE 0x42      // Buy Side
#define IMBALANCE_SIDE_SELL_SIDE 0x53     // Sell Side

// Auction Status: one byte code
#define AUCTION_STATUS_WILL_RUN_OPEN_CLOSE 0x00                 // Will Run Open Close
#define AUCTION_STATUS_WILL_RUN_INTEREST 0x01                   // Will Run Interest
#define AUCTION_STATUS_WILL_NOT_RUN_IMBALANCE 0x02              // Will Not Run Imbalance
#define AUCTION_STATUS_WILL_NOT_RUN_TRANSITION_TO_CLOSING 0x03  // Will Not Run Transition To Closing

// Freeze Status: one byte code
#define FREEZE_STATUS_NO_IMBALANCE_FREEZE 0x00  // No Imbalance Freeze
#define FREEZE_STATUS_IMBALANCE_FREEZE 0x01     // Imbalance Freeze

// ---- Types -------------------------------------------------------------------

// The time when this packet was published to the multicast channel
typedef struct _SendTime {
  UINT32 seconds;      // bytes 0 to 3
  UINT32 nanoseconds;  // bytes 4 to 7
} SendTime;

// This message is sent to reset the Message Sequence Number at start of day, or in response to failures.
typedef struct _SequenceNumberResetMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT8 product_id;       // byte 8
  UINT8 channel_id;       // byte 9
} SequenceNumberResetMessage;

// This message is published over the real-time data channels at system startup or in the context of a refresh sequence after a Matching Engine or XDP Publisher failover. It provides referential data for a single specified symbol.
typedef struct _SymbolIndexMappingMessage {
  UINT32 symbol_index;       // bytes 0 to 3
  UINT8 symbol[11];          // bytes 4 to 14
  UINT8 reserved_1;          // byte 15
  UINT16 market_id;          // bytes 16 to 17
  UINT8 system_id;           // byte 18
  UINT8 exchange_code;       // byte 19
  UINT8 price_scale_code;    // byte 20
  UINT8 security_type;       // byte 21
  UINT16 lot_size;           // bytes 22 to 23
  UINT32 prev_close_price;   // bytes 24 to 27
  UINT32 prev_close_volume;  // bytes 28 to 31
  UINT8 price_resolution;    // byte 32
  UINT8 round_lot;           // byte 33
  UINT16 mpv;                // bytes 34 to 35
  UINT16 unit_of_trade;      // bytes 36 to 37
  UINT8 reserved_2[2];       // bytes 38 to 39
} SymbolIndexMappingMessage;

// Clients who have experienced a sequence number gap and need a retransmission of the missed messages should send a Retransmission Request message via TCP to the Request Controller. A Request Response message will be sent over the TCP connection back to the client, and if the request was valid, the requested message(s) will be re-published over the relevant Retransmission multicast channel.
typedef struct _RetransmissionRequestMessage {
  UINT32 begin_seq_num;  // bytes 0 to 3
  UINT32 end_seq_num;    // bytes 4 to 7
  UINT8 source_id[10];   // bytes 8 to 17
  UINT8 product_id;      // byte 18
  UINT8 channel_id;      // byte 19
} RetransmissionRequestMessage;

// This message will be sent immediately via TCP/IP in response to the client s request for retransmission, refresh or Symbol Mapping messages.
typedef struct _RequestResponseMessage {
  UINT32 request_seq_num;  // bytes 0 to 3
  UINT32 begin_seq_num;    // bytes 4 to 7
  UINT32 end_seq_num;      // bytes 8 to 11
  UINT8 source_id[10];     // bytes 12 to 21
  UINT8 product_id;        // byte 22
  UINT8 channel_id;        // byte 23
  UINT8 status;            // byte 24
} RequestResponseMessage;

// Clients who remain connected to the Retransmission Server intraday must respond to a Heartbeat with a Heartbeat Response message within 5 seconds. If no timely client response is received, the connection will be closed.
typedef struct _HeartbeatResponseMessage {
  UINT8 source_id[10];  // bytes 0 to 9
} HeartbeatResponseMessage;

// This message is sent by clients via TCP/IP requesting the Symbol Index Mapping messages for one or all symbols in a specified channel.
typedef struct _SymbolIndexMappingRequestMessage {
  UINT32 symbol_index;      // bytes 0 to 3
  UINT8 source_id[10];      // bytes 4 to 13
  UINT8 product_id;         // byte 14
  UINT8 channel_id;         // byte 15
  UINT8 retransmit_method;  // byte 16
} SymbolIndexMappingRequestMessage;

// Clients who have experienced a failure and need a refresh of the state of one or all symbols in a specific channel should send a Retransmission Request message via TCP to the Request Controller. A Request Response message will be sent over the TCP connection back to the client, and if the request was valid, the requested message(s) will be published over the relevant Refresh multicast channel.
typedef struct _RefreshRequestMessage {
  UINT32 symbol_index;  // bytes 0 to 3
  UINT8 source_id[10];  // bytes 4 to 13
  UINT8 product_id;     // byte 14
  UINT8 channel_id;     // byte 15
} RefreshRequestMessage;

// This message will be sent over the Retransmission multicast channels to inform clients of unavailability of a range of messages (or part of a range) for which they may have requested a retransmission.
typedef struct _MessageUnavailableMessage {
  UINT32 begin_seq_num;  // bytes 0 to 3
  UINT32 end_seq_num;    // bytes 4 to 7
  UINT8 product_id;      // byte 8
  UINT8 channel_id;      // byte 9
} MessageUnavailableMessage;

// In case of a failure and recovery of a Matching Engine or an XDP Publisher, the publisher may send a full state refresh for every symbol affected. This kind of unrequested refresh is preceded by a Symbol Clear message. The client should react to receipt of a Symbol Clear message by clearing all state information for the specified symbol in anticipation of receiving a full state refresh.
typedef struct _SymbolClearMessage {
  UINT32 source_time;          // bytes 0 to 3
  UINT32 source_time_ns;       // bytes 4 to 7
  UINT32 symbol_index;         // bytes 8 to 11
  UINT32 next_source_seq_num;  // bytes 12 to 15
} SymbolClearMessage;

// This message informs clients of changes in the status of a specific security, such as Trading Halts, Short Sale Restriction state changes, etc.
typedef struct _SecurityStatusMessage {
  UINT32 source_time;                // bytes 0 to 3
  UINT32 source_time_ns;             // bytes 4 to 7
  UINT32 symbol_index;               // bytes 8 to 11
  UINT32 symbol_seq_num;             // bytes 12 to 15
  UINT8 security_status;             // byte 16
  UINT8 halt_condition;              // byte 17
  UINT8 reserved_4[4];               // bytes 18 to 21
  UINT32 price_1;                    // bytes 22 to 25
  UINT32 price_2;                    // bytes 26 to 29
  UINT8 ssr_triggering_exchange_id;  // byte 30
  UINT32 ssr_triggering_volume;      // bytes 31 to 34
  UINT32 time;                       // bytes 35 to 38
  UINT8 ssr_state;                   // byte 39
  UINT8 market_state;                // byte 40
  UINT8 session_state;               // byte 41
} SecurityStatusMessage;

// Sequence number fields that only the full Refresh Header carries.
typedef struct _FullRefreshHeader {
  UINT32 last_seq_num;         // bytes 0 to 3
  UINT32 last_symbol_seq_num;  // bytes 4 to 7
} FullRefreshHeader;

// Sequence number fields that only the full Refresh Header carries.
casetype _OptionalFullRefreshHeader (Bool present) {
  switch (present) {
    case true: FullRefreshHeader full_refresh_header;
    case false: unit absent;
  }
} OptionalFullRefreshHeader;

// The first message in each packet of refresh messages published over the Refresh multicast channels is of this type.
typedef struct _RefreshHeaderMessage {
  UINT16 current_refresh_pkt;                                                      // bytes 0 to 1
  UINT16 total_refresh_pkts;                                                       // bytes 2 to 3
  OptionalFullRefreshHeader((current_refresh_pkt == 0x0001)) full_refresh_header;
} RefreshHeaderMessage;

// Imbalance messages are sent periodically during auctions to update price and volume information. If there is no change to the calculated fields, no message will be generated.
typedef struct _ImbalanceMessage {
  UINT32 source_time;                     // bytes 0 to 3
  UINT32 source_time_ns;                  // bytes 4 to 7
  UINT32 symbol_index;                    // bytes 8 to 11
  UINT32 symbol_seq_num;                  // bytes 12 to 15
  UINT32 reference_price;                 // bytes 16 to 19
  UINT32 paired_qty;                      // bytes 20 to 23
  UINT32 total_imbalance_qty;             // bytes 24 to 27
  UINT32 market_imbalance_qty;            // bytes 28 to 31
  UINT16 auction_time;                    // bytes 32 to 33
  UINT8 auction_type;                     // byte 34
  UINT8 imbalance_side;                   // byte 35
  UINT32 continuous_book_clearing_price;  // bytes 36 to 39
  UINT32 closing_only_clearing_price;     // bytes 40 to 43
  UINT32 ssr_filing_price;                // bytes 44 to 47
  UINT32 indicative_match_price;          // bytes 48 to 51
  UINT32 upper_collar;                    // bytes 52 to 55
  UINT32 lower_collar;                    // bytes 56 to 59
  UINT8 auction_status;                   // byte 60
  UINT8 freeze_status;                    // byte 61
  UINT8 num_extensions;                   // byte 62
} ImbalanceMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0001: SequenceNumberResetMessage sequence_number_reset_message;
    case 0x0003: SymbolIndexMappingMessage symbol_index_mapping_message;
    case 0x000A: RetransmissionRequestMessage retransmission_request_message;
    case 0x000B: RequestResponseMessage request_response_message;
    case 0x000C: HeartbeatResponseMessage heartbeat_response_message;
    case 0x000D: SymbolIndexMappingRequestMessage symbol_index_mapping_request_message;
    case 0x000F: RefreshRequestMessage refresh_request_message;
    case 0x001F: MessageUnavailableMessage message_unavailable_message;
    case 0x0020: SymbolClearMessage symbol_clear_message;
    case 0x0022: SecurityStatusMessage security_status_message;
    case 0x0023: RefreshHeaderMessage refresh_header_message;
    case 0x0069: ImbalanceMessage imbalance_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_size { message_size >= 4 };                                                                                                                       // bytes 0 to 1
  UINT16 message_type;                                                                                                                                             // bytes 2 to 3
  Payload(message_type, (((UINT32) message_size) - 4)) payload[:byte-size-single-element-array (((UINT32) message_size) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Xdp Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16 packet_size;                                                                                                       // bytes 0 to 1
  UINT8 delivery_flag;                                                                                                      // byte 2
  UINT8 message_count;                                                                                                      // byte 3
  UINT32 sequence_number;                                                                                                   // bytes 4 to 7
  SendTime send_time;                                                                                                       // bytes 8 to 15
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 16)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} Packet;

