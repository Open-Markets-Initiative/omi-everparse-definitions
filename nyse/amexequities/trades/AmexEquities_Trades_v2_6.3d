// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AmexEquities_Trades_v2_6.3d

// ---- Values ------------------------------------------------------------------

// Delivery Flag: one byte code
#define DELIVERY_FLAG_HEARTBEAT 0x01                        // Heartbeat
#define DELIVERY_FLAG_PILLAR_FAILOVER 0x0A                  // Pillar Failover
#define DELIVERY_FLAG_ORIGINAL_MESSAGE 0x0B                 // Original Message
#define DELIVERY_FLAG_SEQUENCE_NUMBER_RESET_MESSAGE 0x0C    // Sequence Number Reset Message
#define DELIVERY_FLAG_ONE_RETRANSMISSION_PACKET 0x0D        // One Retransmission Packet
#define DELIVERY_FLAG_RETRANSMISSION_SEQUENCE_MESSAGE 0x0F  // Retransmission Sequence Message
#define DELIVERY_FLAG_ONE_REFRESH_PACKET 0x11               // One Refresh Packet
#define DELIVERY_FLAG_REFRESH_SEQUENCE_START 0x12           // Refresh Sequence Start
#define DELIVERY_FLAG_REFRESH_SEQUENCE_MESSAGE 0x13         // Refresh Sequence Message
#define DELIVERY_FLAG_REFRESH_SEQUENCE_END 0x14             // Refresh Sequence End
#define DELIVERY_FLAG_MESSAGE_UNAVAILABLE 0x15              // Message Unavailable

// Message Type: 2 byte code
#define MESSAGE_TYPE_SEQUENCE_NUMBER_RESET_MESSAGE 0x0001                  // Sequence Number Reset Message
#define MESSAGE_TYPE_SOURCE_TIME_REFERENCE_MESSAGE 0x0002                  // Source Time Reference Message
#define MESSAGE_TYPE_SYMBOL_INDEX_MAPPING_MESSAGE 0x0003                   // Symbol Index Mapping Message
#define MESSAGE_TYPE_SYMBOL_CLEAR_MESSAGE 0x0020                           // Symbol Clear Message
#define MESSAGE_TYPE_SECURITY_STATUS_MESSAGE 0x0022                        // Security Status Message
#define MESSAGE_TYPE_RETRANSMISSION_REQUEST_MESSAGE 0x000A                 // Retransmission Request Message
#define MESSAGE_TYPE_SYMBOL_INDEX_MAPPING_REQUEST_MESSAGE 0x000D           // Symbol Index Mapping Request Message
#define MESSAGE_TYPE_REFRESH_REQUEST_MESSAGE 0x000F                        // Refresh Request Message
#define MESSAGE_TYPE_MESSAGE_UNAVAILABLE_MESSAGE 0x001F                    // Message Unavailable Message
#define MESSAGE_TYPE_REFRESH_HEADER_MESSAGE 0x0023                         // Refresh Header Message
#define MESSAGE_TYPE_REQUEST_RESPONSE_MESSAGE 0x000B                       // Request Response Message
#define MESSAGE_TYPE_HEARTBEAT_RESPONSE_MESSAGE 0x000C                     // Heartbeat Response Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x00DC                                  // Trade Message
#define MESSAGE_TYPE_TRADE_CANCEL_MESSAGE 0x00DD                           // Trade Cancel Message
#define MESSAGE_TYPE_TRADE_CORRECTION_MESSAGE 0x00DE                       // Trade Correction Message
#define MESSAGE_TYPE_STOCK_SUMMARY_MESSAGE 0x00DF                          // Stock Summary Message
#define MESSAGE_TYPE_TRF_FRACTIONAL_TRADE_MESSAGE 0x00D2                   // Trf Fractional Trade Message
#define MESSAGE_TYPE_TRF_TRADE_CANCEL_MESSAGE 0x00D8                       // Trf Trade Cancel Message
#define MESSAGE_TYPE_TRF_FRACTIONAL_TRADE_CORRECTION_MESSAGE 0x00D4        // Trf Fractional Trade Correction Message
#define MESSAGE_TYPE_TRF_FRACTIONAL_PRIOR_DAY_TRADE_MESSAGE 0x00D5         // Trf Fractional Prior Day Trade Message
#define MESSAGE_TYPE_TRF_FRACTIONAL_PRIOR_DAY_TRADE_CANCEL_MESSAGE 0x00D6  // Trf Fractional Prior Day Trade Cancel Message

// Market Id: 2 byte code
#define MARKET_ID_NYSE_EQUITIES 0x0001           // Nyse Equities
#define MARKET_ID_NYSE_ARCA_EQUITIES 0x0003      // Nyse Arca Equities
#define MARKET_ID_NYSE_ARCA_OPTIONS 0x0004       // Nyse Arca Options
#define MARKET_ID_NYSE_BONDS 0x0005              // Nyse Bonds
#define MARKET_ID_NYSE_AMERICAN_OPTIONS 0x0008   // Nyse American Options
#define MARKET_ID_NYSE_AMERICAN_EQUITIES 0x0009  // Nyse American Equities
#define MARKET_ID_NYSE_NATIONAL_EQUITIES 0x000A  // Nyse National Equities
#define MARKET_ID_NYSE_TEXAS_EQUITIES 0x000B     // Nyse Texas Equities

// Exchange Code: one byte code
#define EXCHANGE_CODE_NYSE_AMERICAN 0x41  // Nyse American
#define EXCHANGE_CODE_LTSE 0x4C           // Ltse
#define EXCHANGE_CODE_NYSE_TEXAS 0x4D     // Nyse Texas
#define EXCHANGE_CODE_NYSE 0x4E           // Nyse
#define EXCHANGE_CODE_NYSE_ARCA 0x50      // Nyse Arca
#define EXCHANGE_CODE_NASDAQ 0x51         // Nasdaq
#define EXCHANGE_CODE_IEX 0x56            // Iex
#define EXCHANGE_CODE_CBOE 0x5A           // Cboe

// Security Type: one byte code
#define SECURITY_TYPE_ADR 0x41                             // Adr
#define SECURITY_TYPE_COMMON_STOCK 0x43                    // Common Stock
#define SECURITY_TYPE_DEBENTURES 0x44                      // Debentures
#define SECURITY_TYPE_ETF 0x45                             // Etf
#define SECURITY_TYPE_FOREIGN 0x46                         // Foreign
#define SECURITY_TYPE_US_DEPOSITARY_SHARES 0x48            // Us Depositary Shares
#define SECURITY_TYPE_UNITS 0x49                           // Units
#define SECURITY_TYPE_INDEX_LINKED_NOTES 0x4C              // Index Linked Notes
#define SECURITY_TYPE_MISCLIQUID_TRUST 0x4D                // Miscliquid Trust
#define SECURITY_TYPE_ORDINARY_SHARES 0x4F                 // Ordinary Shares
#define SECURITY_TYPE_PREFERRED_STOCK 0x50                 // Preferred Stock
#define SECURITY_TYPE_RIGHTS 0x52                          // Rights
#define SECURITY_TYPE_SHARES_OF_BENEFICIARY_INTEREST 0x53  // Shares Of Beneficiary Interest
#define SECURITY_TYPE_TEST 0x54                            // Test
#define SECURITY_TYPE_CLOSED_END_FUND 0x55                 // Closed End Fund
#define SECURITY_TYPE_WARRANT 0x57                         // Warrant

// Price Resolution: one byte code
#define PRICE_RESOLUTION_ALL_PENNY 0x00     // All Penny
#define PRICE_RESOLUTION_PENNY_NICKEL 0x01  // Penny Nickel
#define PRICE_RESOLUTION_NICKEL_DIME 0x05   // Nickel Dime

// Round Lot: one byte code
#define ROUND_LOT_YES 0x59  // Yes
#define ROUND_LOT_NO 0x4E   // No

// Security Status: one byte code
#define SECURITY_STATUS_TRADING_HALT 0x34                            // Trading Halt
#define SECURITY_STATUS_RESUME 0x35                                  // Resume
#define SECURITY_STATUS_SUSPEND 0x36                                 // Suspend
#define SECURITY_STATUS_SHORT_SALE_RESTRICTION_ACTIVATED_DAY_1 0x41  // Short Sale Restriction Activated Day 1
#define SECURITY_STATUS_SHORT_SALE_RESTRICTION_CONTINUED_DAY_2 0x43  // Short Sale Restriction Continued Day 2
#define SECURITY_STATUS_SHORT_SALE_RESTRICTION_DEACTIVATED 0x44      // Short Sale Restriction Deactivated
#define SECURITY_STATUS_PRE_OPENING 0x50                             // Pre Opening
#define SECURITY_STATUS_BEGIN_ACCEPTING_ORDERS 0x42                  // Begin Accepting Orders
#define SECURITY_STATUS_EARLY_SESSION 0x45                           // Early Session
#define SECURITY_STATUS_CORE_SESSION 0x4F                            // Core Session
#define SECURITY_STATUS_LATE_SESSION_NON_NYSE_ONLY 0x4C              // Late Session Non Nyse Only
#define SECURITY_STATUS_CLOSED 0x58                                  // Closed
#define SECURITY_STATUS_HALT_RESUME_PRICE_INDICATION 0x49            // Halt Resume Price Indication
#define SECURITY_STATUS_PRE_OPENING_PRICE_INDICATION 0x47            // Pre Opening Price Indication

// Halt Condition: one byte code
#define HALT_CONDITION_SECURITY_NOT_DELAYEDHALTED 0x7E                // Security Not Delayedhalted
#define HALT_CONDITION_NEWS_RELEASED_NEWS_DISSEMINATION 0x44          // News Released News Dissemination
#define HALT_CONDITION_ORDER_IMBALANCE 0x49                           // Order Imbalance
#define HALT_CONDITION_NEWS_PENDING 0x50                              // News Pending
#define HALT_CONDITION_LULD_PAUSE 0x4D                                // Luld Pause
#define HALT_CONDITION_EQUIPMENT_CHANGEOVER 0x58                      // Equipment Changeover
#define HALT_CONDITION_ADDITIONAL_INFORMATION_REQUESTED 0x41          // Additional Information Requested
#define HALT_CONDITION_REGULATORY_CONCERN 0x43                        // Regulatory Concern
#define HALT_CONDITION_MERGER_EFFECTIVE 0x45                          // Merger Effective
#define HALT_CONDITION_ETF_COMPONENT_PRICES_NOT_AVAILABLE 0x46        // Etf Component Prices Not Available
#define HALT_CONDITION_CORPORATE_ACTION 0x4E                          // Corporate Action
#define HALT_CONDITION_NEW_SECURITY_OFFERING 0x4F                     // New Security Offering
#define HALT_CONDITION_INTRADAY_INDICATIVE_VALUE_NOT_AVAILABLE 0x56   // Intraday Indicative Value Not Available
#define HALT_CONDITION_SUSPEND 0x36                                   // Suspend
#define HALT_CONDITION_MARKET_WIDE_CIRCUIT_BREAKER_HALT_LEVEL_1 0x31  // Market Wide Circuit Breaker Halt Level 1
#define HALT_CONDITION_MARKET_WIDE_CIRCUIT_BREAKER_HALT_LEVEL_2 0x32  // Market Wide Circuit Breaker Halt Level 2
#define HALT_CONDITION_MARKET_WIDE_CIRCUIT_BREAKER_HALT_LEVEL_3 0x33  // Market Wide Circuit Breaker Halt Level 3

// Ssr Triggering Exchange Id: one byte code
#define SSR_TRIGGERING_EXCHANGE_ID_NYSE_AMERICAN 0x41   // Nyse American
#define SSR_TRIGGERING_EXCHANGE_ID_NASDAQ_OMX_BX 0x42   // Nasdaq Omx Bx
#define SSR_TRIGGERING_EXCHANGE_ID_NYSE_NATIONAL 0x43   // Nyse National
#define SSR_TRIGGERING_EXCHANGE_ID_FINRA 0x44           // Finra
#define SSR_TRIGGERING_EXCHANGE_ID_N24_X 0x47           // N24X
#define SSR_TRIGGERING_EXCHANGE_ID_MIAMI_PERAL 0x48     // Miami Peral
#define SSR_TRIGGERING_EXCHANGE_ID_NASDAQ_ISE 0x49      // Nasdaq Ise
#define SSR_TRIGGERING_EXCHANGE_ID_CBOE_EDGA 0x4A       // Cboe Edga
#define SSR_TRIGGERING_EXCHANGE_ID_CBOE_EDGX 0x4B       // Cboe Edgx
#define SSR_TRIGGERING_EXCHANGE_ID_LTSE 0x4C            // Ltse
#define SSR_TRIGGERING_EXCHANGE_ID_NYSE_TEXAS 0x4D      // Nyse Texas
#define SSR_TRIGGERING_EXCHANGE_ID_NYSE 0x4E            // Nyse
#define SSR_TRIGGERING_EXCHANGE_ID_NYSE_ARCA 0x50       // Nyse Arca
#define SSR_TRIGGERING_EXCHANGE_ID_NASDAQ 0x51          // Nasdaq
#define SSR_TRIGGERING_EXCHANGE_ID_NASDAQ_OMX 0x54      // Nasdaq Omx
#define SSR_TRIGGERING_EXCHANGE_ID_MEMX 0x55            // Memx
#define SSR_TRIGGERING_EXCHANGE_ID_IEX 0x56             // Iex
#define SSR_TRIGGERING_EXCHANGE_ID_CBSX 0x57            // Cbsx
#define SSR_TRIGGERING_EXCHANGE_ID_NASDAQ_OMX_PSX 0x58  // Nasdaq Omx Psx
#define SSR_TRIGGERING_EXCHANGE_ID_CBOE_BYX 0x59        // Cboe Byx
#define SSR_TRIGGERING_EXCHANGE_ID_CBOE_BZX 0x5A        // Cboe Bzx
#define SSR_TRIGGERING_EXCHANGE_ID_NO_VALUE 0x20        // No Value

// Ssr State: one byte code
#define SSR_STATE_NO_SHORT_SALE_RESTRICTION_IN_EFFECT 0x7E  // No Short Sale Restriction In Effect
#define SSR_STATE_SHORT_SALE_RESTRICTION_IN_EFFECT 0x45     // Short Sale Restriction In Effect

// Market State: one byte code
#define MARKET_STATE_PRE_OPENING 0x50                 // Pre Opening
#define MARKET_STATE_EARLY_SESSION 0x45               // Early Session
#define MARKET_STATE_CORE_SESSION 0x4F                // Core Session
#define MARKET_STATE_LATE_SESSION_NON_NYSE_ONLY 0x4C  // Late Session Non Nyse Only
#define MARKET_STATE_CLOSED 0x58                      // Closed

// Retransmit Method: one byte code
#define RETRANSMIT_METHOD_DELIVER_VIA_UDP 0x00  // Deliver Via Udp

// Status: one byte code
#define STATUS_MESSAGE_WAS_ACCEPTED 0x30                                                              // Message Was Accepted
#define STATUS_REJECTED_DUE_TO_AN_INVALID_SOURCE_ID 0x31                                              // Rejected Due To An Invalid Source Id
#define STATUS_REJECTED_DUE_TO_MAXIMUM_SEQUENCE_RANGE_SEE_THRESHOLD_LIMITS 0x33                       // Rejected Due To Maximum Sequence Range See Threshold Limits
#define STATUS_REJECTED_DUE_TO_MAXIMUM_REQUEST_IN_A_DAY 0x34                                          // Rejected Due To Maximum Request In A Day
#define STATUS_REJECTED_DUE_TO_MAXIMUM_NUMBER_OF_REFRESH_REQUESTS_IN_A_DAY 0x35                       // Rejected Due To Maximum Number Of Refresh Requests In A Day
#define STATUS_REJECTED_REQUEST_MESSAGE_SEQ_NUM_TTL_TIME_TO_LIVE_IS_TOO_OLD_USE_REFRESH__dkpgxt 0x36  // Rejected Request Message Seq Num Ttl Time To Live Is Too Old Use Refresh To Recover Current State If Necessary
#define STATUS_REJECTED_DUE_TO_AN_INVALID_CHANNEL_ID 0x37                                             // Rejected Due To An Invalid Channel Id
#define STATUS_REJECTED_DUE_TO_AN_INVALID_PRODUCT_ID 0x38                                             // Rejected Due To An Invalid Product Id
#define STATUS_REJECTED_DUE_TO_1_INVALID_MSG_TYPE_OR_2_MISMATCH_BETWEEN_MSG_TYPE_AND_MSG_SIZE 0x39    // Rejected Due To 1 Invalid Msg Type Or 2 Mismatch Between Msg Type And Msg Size

// Trade Cond 1: one byte code
#define TRADE_COND_1_REGULAR_SALE 0x40           // Regular Sale
#define TRADE_COND_1_CASH 0x43                   // Cash
#define TRADE_COND_1_REGULAR_SALE_TRF_ONLY 0x20  // Regular Sale Trf Only
#define TRADE_COND_1_SELLER_TRF_ONLY 0x52        // Seller Trf Only

// Trade Cond 2: one byte code
#define TRADE_COND_2_NA 0x20                                            // Na
#define TRADE_COND_2_INTERMARKET_SWEEP_ORDER 0x46                       // Intermarket Sweep Order
#define TRADE_COND_2_MARKET_CENTER_OPENING_TRADE 0x4F                   // Market Center Opening Trade
#define TRADE_COND_2_DERIVATIVELY_PRICED_TRF_ONLY 0x34                  // Derivatively Priced Trf Only
#define TRADE_COND_2_REOPENING_TRADE 0x35                               // Reopening Trade
#define TRADE_COND_2_MARKET_CENTER_CLOSING_TRADE 0x36                   // Market Center Closing Trade
#define TRADE_COND_2_QUALIFIED_CONTINGENT_TRADE_TRF_OR_TEXAS_ONLY 0x37  // Qualified Contingent Trade Trf Or Texas Only
#define TRADE_COND_2_CORRECTED_CONSOLIDATED_CLOSE 0x39                  // Corrected Consolidated Close

// Trade Cond 3: one byte code
#define TRADE_COND_3_NA 0x20                                   // Na
#define TRADE_COND_3_EXTENDED_HOURS_TRADE 0x54                 // Extended Hours Trade
#define TRADE_COND_3_EXTENDED_HOURS_SOLD_OUT_OF_SEQUENCE 0x55  // Extended Hours Sold Out Of Sequence
#define TRADE_COND_3_SOLD 0x5A                                 // Sold

// Trade Cond 4: one byte code
#define TRADE_COND_4_NA 0x20                                  // Na
#define TRADE_COND_4_ODD_LOT_TRADE 0x49                       // Odd Lot Trade
#define TRADE_COND_4_OFFICIAL_CLOSING_PRICE 0x4D              // Official Closing Price
#define TRADE_COND_4_OFFICIAL_OPEN_PRICE 0x51                 // Official Open Price
#define TRADE_COND_4_CONTINGENT_TRADE_TRF_OR_TEXAS_ONLY 0x56  // Contingent Trade Trf Or Texas Only
#define TRADE_COND_4_PRIOR_REFERENCE_PRICE_TRF_ONLY 0x50      // Prior Reference Price Trf Only
#define TRADE_COND_4_WEIGHTED_AVERAGE_PRICE_TRF_ONLY 0x57     // Weighted Average Price Trf Only

// ---- Types -------------------------------------------------------------------

// The time when this packet was published to the multicast channel
typedef struct _SendTime {
  UINT32 seconds;      // bytes 0 to 3
  UINT32 nanoseconds;  // bytes 4 to 7
} SendTime;

// This message is sent to reset the Message Sequence Number at start of day, or in response to failures.
typedef struct _SequenceNumberResetMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT8 product_id;       // byte 8
  UINT8 channel_id;       // byte 9
} SequenceNumberResetMessage;

// For high-volume feeds, this message is sent at the start of every second during periods of active data publication. The client can concatenate the SourceTime field with the SourceTimeNS field in subsequent market data messages to get full 8-byte Matching Engine event timestamps.
typedef struct _SourceTimeReferenceMessage {
  UINT32 id;              // bytes 0 to 3
  UINT32 symbol_seq_num;  // bytes 4 to 7
  UINT32 source_time;     // bytes 8 to 11
} SourceTimeReferenceMessage;

// This message is published over the real-time data channels at system startup or in the context of a refresh sequence after a Matching Engine or Pillar Publisher failover. It provides referential data for a single specified symbol.
typedef struct _SymbolIndexMappingMessage {
  UINT32 symbol_index;       // bytes 0 to 3
  UINT8 symbol[11];          // bytes 4 to 14
  UINT8 reserved_1;          // byte 15
  UINT16 market_id;          // bytes 16 to 17
  UINT8 system_id;           // byte 18
  UINT8 exchange_code;       // byte 19
  UINT8 price_scale_code;    // byte 20
  UINT8 security_type;       // byte 21
  UINT16 lot_size;           // bytes 22 to 23
  UINT32 prev_close_price;   // bytes 24 to 27
  UINT32 prev_close_volume;  // bytes 28 to 31
  UINT8 price_resolution;    // byte 32
  UINT8 round_lot;           // byte 33
  UINT16 mpv;                // bytes 34 to 35
  UINT16 unit_of_trade;      // bytes 36 to 37
  UINT8 reserved_2[2];       // bytes 38 to 39
} SymbolIndexMappingMessage;

// In case of a failure and recovery of a Matching Engine or an Pillar Publisher, the publisher may send a full state refresh for every symbol affected. This unrequested refresh is preceded by a Symbol Clear message. The client should react to receipt of a Symbol Clear message by clearing all state information for the specified symbol in anticipation of receiving a full state refresh.
typedef struct _SymbolClearMessage {
  UINT32 source_time;          // bytes 0 to 3
  UINT32 source_time_ns;       // bytes 4 to 7
  UINT32 symbol_index;         // bytes 8 to 11
  UINT32 next_source_seq_num;  // bytes 12 to 15
} SymbolClearMessage;

// This message informs clients of changes in the status of a specific security, such as Trading Halts, Short Sale Restriction state changes, etc.
typedef struct _SecurityStatusMessage {
  UINT32 source_time;                // bytes 0 to 3
  UINT32 source_time_ns;             // bytes 4 to 7
  UINT32 symbol_index;               // bytes 8 to 11
  UINT32 symbol_seq_num;             // bytes 12 to 15
  UINT8 security_status;             // byte 16
  UINT8 halt_condition;              // byte 17
  UINT8 reserved_4[4];               // bytes 18 to 21
  UINT32 price_1;                    // bytes 22 to 25
  UINT32 price_2;                    // bytes 26 to 29
  UINT8 ssr_triggering_exchange_id;  // byte 30
  UINT32 ssr_triggering_volume;      // bytes 31 to 34
  UINT32 time;                       // bytes 35 to 38
  UINT8 ssr_state;                   // byte 39
  UINT8 market_state;                // byte 40
  UINT8 session_state;               // byte 41
} SecurityStatusMessage;

// Clients who have experienced a sequence number gap and need a retransmission of the missed messages should send a Retransmission Request message via TCP to the Request Controller.
typedef struct _RetransmissionRequestMessage {
  UINT32 begin_seq_num;  // bytes 0 to 3
  UINT32 end_seq_num;    // bytes 4 to 7
  UINT8 source_id[10];   // bytes 8 to 17
  UINT8 product_id;      // byte 18
  UINT8 channel_id;      // byte 19
} RetransmissionRequestMessage;

// This message is sent by clients via TCP/IP requesting the Symbol Index Mapping messages for one or all symbols in a specified channel.
typedef struct _SymbolIndexMappingRequestMessage {
  UINT32 symbol_index;      // bytes 0 to 3
  UINT8 source_id[10];      // bytes 4 to 13
  UINT8 product_id;         // byte 14
  UINT8 channel_id;         // byte 15
  UINT8 retransmit_method;  // byte 16
} SymbolIndexMappingRequestMessage;

// Clients who have experienced a failure and need a refresh of the state of one or all symbols in a specific channel should send a Refresh Request message via TCP to the Request Controller.
typedef struct _RefreshRequestMessage {
  UINT32 symbol_index;  // bytes 0 to 3
  UINT8 source_id[10];  // bytes 4 to 13
  UINT8 product_id;     // byte 14
  UINT8 channel_id;     // byte 15
} RefreshRequestMessage;

// This message will be sent over the Retransmission multicast channels to inform clients of unavailability of a range of messages (or part of a range) for which they may have requested a retransmission.
typedef struct _MessageUnavailableMessage {
  UINT32 begin_seq_num;  // bytes 0 to 3
  UINT32 end_seq_num;    // bytes 4 to 7
  UINT8 product_id;      // byte 8
  UINT8 channel_id;      // byte 9
} MessageUnavailableMessage;

// Sequence number fields that only the full Refresh Header carries.
typedef struct _FullRefreshHeader {
  UINT32 last_seq_num;         // bytes 0 to 3
  UINT32 last_symbol_seq_num;  // bytes 4 to 7
} FullRefreshHeader;

// Sequence number fields that only the full Refresh Header carries.
casetype _OptionalFullRefreshHeader (Bool present) {
  switch (present) {
    case true: FullRefreshHeader full_refresh_header;
    case false: unit absent;
  }
} OptionalFullRefreshHeader;

// The first message in each packet of refresh messages published over the Refresh multicast channels is of this type.
typedef struct _RefreshHeaderMessage {
  UINT16 current_refresh_pkt;                                                      // bytes 0 to 1
  UINT16 total_refresh_pkts;                                                       // bytes 2 to 3
  OptionalFullRefreshHeader((current_refresh_pkt == 0x0001)) full_refresh_header;
} RefreshHeaderMessage;

// This message will be sent immediately via TCP/IP in response to the client's request for retransmission, refresh or Symbol Mapping messages.
typedef struct _RequestResponseMessage {
  UINT32 request_seq_num;  // bytes 0 to 3
  UINT32 begin_seq_num;    // bytes 4 to 7
  UINT32 end_seq_num;      // bytes 8 to 11
  UINT8 source_id[10];     // bytes 12 to 21
  UINT8 product_id;        // byte 22
  UINT8 channel_id;        // byte 23
  UINT8 status;            // byte 24
} RequestResponseMessage;

// Clients who remain connected to the Retransmission Server intraday must respond to a Heartbeat with a Heartbeat Response message within 5 seconds. If no timely client response is received, the connection will be closed.
typedef struct _HeartbeatResponseMessage {
  UINT8 source_id[10];  // bytes 0 to 9
} HeartbeatResponseMessage;

// A Trade message is sent when there is an execution on the order book.
typedef struct _TradeMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT32 symbol_index;    // bytes 8 to 11
  UINT32 symbol_seq_num;  // bytes 12 to 15
  UINT32 trade_id;        // bytes 16 to 19
  UINT32 price;           // bytes 20 to 23, signed, read here as unsigned
  UINT32 volume;          // bytes 24 to 27
  UINT8 trade_cond_1;     // byte 28
  UINT8 trade_cond_2;     // byte 29
  UINT8 trade_cond_3;     // byte 30
  UINT8 trade_cond_4;     // byte 31
} TradeMessage;

// In the event that an earlier trade has been reported in error, a Trade Cancel message is sent.
typedef struct _TradeCancelMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 symbol_index;       // bytes 8 to 11
  UINT32 symbol_seq_num;     // bytes 12 to 15
  UINT32 original_trade_id;  // bytes 16 to 19
} TradeCancelMessage;

// In the event that an earlier trade has been reported with one or multiple fields in error, a Trade Correction message is sent.
typedef struct _TradeCorrectionMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 symbol_index;       // bytes 8 to 11
  UINT32 symbol_seq_num;     // bytes 12 to 15
  UINT32 original_trade_id;  // bytes 16 to 19
  UINT32 trade_id;           // bytes 20 to 23
  UINT32 price;              // bytes 24 to 27, signed, read here as unsigned
  UINT32 volume;             // bytes 28 to 31
  UINT8 trade_cond_1;        // byte 32
  UINT8 trade_cond_2;        // byte 33
  UINT8 trade_cond_3;        // byte 34
  UINT8 trade_cond_4;        // byte 35
} TradeCorrectionMessage;

// The stock summary message is sent every 1 minute on a separate channel from the main trades feed.
typedef struct _StockSummaryMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT32 symbol_index;    // bytes 8 to 11
  UINT32 high_price;      // bytes 12 to 15, signed, read here as unsigned
  UINT32 low_price;       // bytes 16 to 19, signed, read here as unsigned
  UINT32 open_;           // bytes 20 to 23
  UINT32 close;           // bytes 24 to 27
  UINT32 total_volume;    // bytes 28 to 31
} StockSummaryMessage;

// TRF Fractional Trade Message. New message effective 1/12/26.
typedef struct _TrfFractionalTradeMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 symbol_index;       // bytes 8 to 11
  UINT32 symbol_seq_num;     // bytes 12 to 15
  UINT32 trade_id;           // bytes 16 to 19
  UINT32 price;              // bytes 20 to 23, signed, read here as unsigned
  UINT64 fractional_volume;  // bytes 24 to 31
  UINT8 trade_cond_1;        // byte 32
  UINT8 trade_cond_2;        // byte 33
  UINT8 trade_cond_3;        // byte 34
  UINT8 trade_cond_4;        // byte 35
  UINT32 exec_day_time;      // bytes 36 to 39
  UINT32 exec_day_time_ns;   // bytes 40 to 43
} TrfFractionalTradeMessage;

// TRF Trade Cancel Message. Same structure as Trade Cancel Message (221).
typedef struct _TrfTradeCancelMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 symbol_index;       // bytes 8 to 11
  UINT32 symbol_seq_num;     // bytes 12 to 15
  UINT32 original_trade_id;  // bytes 16 to 19
} TrfTradeCancelMessage;

// TRF Fractional Trade Correction Message. New message effective 1/12/26.
typedef struct _TrfFractionalTradeCorrectionMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 symbol_index;       // bytes 8 to 11
  UINT32 symbol_seq_num;     // bytes 12 to 15
  UINT32 original_trade_id;  // bytes 16 to 19
  UINT32 trade_id;           // bytes 20 to 23
  UINT32 price;              // bytes 24 to 27, signed, read here as unsigned
  UINT64 fractional_volume;  // bytes 28 to 35
  UINT8 trade_cond_1;        // byte 36
  UINT8 trade_cond_2;        // byte 37
  UINT8 trade_cond_3;        // byte 38
  UINT8 trade_cond_4;        // byte 39
  UINT32 exec_day_time;      // bytes 40 to 43
  UINT32 exec_day_time_ns;   // bytes 44 to 47
} TrfFractionalTradeCorrectionMessage;

// If a TRF participant firm fails to report a trade on the day in which it occurs, the firm may report the trade on a subsequent day by publishing a Prior Day Trade message. New message effective 1/12/26.
typedef struct _TrfFractionalPriorDayTradeMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 symbol_index;       // bytes 8 to 11
  UINT32 symbol_seq_num;     // bytes 12 to 15
  UINT32 trade_id;           // bytes 16 to 19
  UINT32 price;              // bytes 20 to 23, signed, read here as unsigned
  UINT64 fractional_volume;  // bytes 24 to 31
  UINT8 trade_cond_1;        // byte 32
  UINT8 trade_cond_2;        // byte 33
  UINT8 trade_cond_3;        // byte 34
  UINT8 trade_cond_4;        // byte 35
  UINT32 prior_day_time;     // bytes 36 to 39
  UINT32 prior_day_time_ns;  // bytes 40 to 43
} TrfFractionalPriorDayTradeMessage;

// If a TRF participant firm discovers that it has reported a trade with an inaccurate price or volume on a previous day, the firm may correct the trade on a subsequent day by publishing a Prior Day Trade Cancel message, followed by a Prior Day Trade. New message effective 1/12/26.
typedef struct _TrfFractionalPriorDayTradeCancelMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 symbol_index;       // bytes 8 to 11
  UINT32 symbol_seq_num;     // bytes 12 to 15
  UINT32 trade_id;           // bytes 16 to 19
  UINT32 price;              // bytes 20 to 23, signed, read here as unsigned
  UINT64 fractional_volume;  // bytes 24 to 31
  UINT32 prior_day_time;     // bytes 32 to 35
  UINT32 prior_day_time_ns;  // bytes 36 to 39
} TrfFractionalPriorDayTradeCancelMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0001: SequenceNumberResetMessage sequence_number_reset_message;
    case 0x0002: SourceTimeReferenceMessage source_time_reference_message;
    case 0x0003: SymbolIndexMappingMessage symbol_index_mapping_message;
    case 0x0020: SymbolClearMessage symbol_clear_message;
    case 0x0022: SecurityStatusMessage security_status_message;
    case 0x000A: RetransmissionRequestMessage retransmission_request_message;
    case 0x000D: SymbolIndexMappingRequestMessage symbol_index_mapping_request_message;
    case 0x000F: RefreshRequestMessage refresh_request_message;
    case 0x001F: MessageUnavailableMessage message_unavailable_message;
    case 0x0023: RefreshHeaderMessage refresh_header_message;
    case 0x000B: RequestResponseMessage request_response_message;
    case 0x000C: HeartbeatResponseMessage heartbeat_response_message;
    case 0x00DC: TradeMessage trade_message;
    case 0x00DD: TradeCancelMessage trade_cancel_message;
    case 0x00DE: TradeCorrectionMessage trade_correction_message;
    case 0x00DF: StockSummaryMessage stock_summary_message;
    case 0x00D2: TrfFractionalTradeMessage trf_fractional_trade_message;
    case 0x00D8: TrfTradeCancelMessage trf_trade_cancel_message;
    case 0x00D4: TrfFractionalTradeCorrectionMessage trf_fractional_trade_correction_message;
    case 0x00D5: TrfFractionalPriorDayTradeMessage trf_fractional_prior_day_trade_message;
    case 0x00D6: TrfFractionalPriorDayTradeCancelMessage trf_fractional_prior_day_trade_cancel_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Pillar message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_size { message_size >= 4 };                                                                                                                       // bytes 0 to 1
  UINT16 message_type;                                                                                                                                             // bytes 2 to 3
  Payload(message_type, (((UINT32) message_size) - 4)) payload[:byte-size-single-element-array (((UINT32) message_size) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Pillar message
typedef struct _MessageRun (UINT8 number_msgs, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_msgs); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 number_msgs, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x01: unit heartbeat;
    default: MessageRun(number_msgs, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pillar common client udp packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16 pkt_size;                                                                                                           // bytes 0 to 1
  UINT8 delivery_flag;                                                                                                       // byte 2
  UINT8 number_msgs;                                                                                                         // byte 3
  UINT32 seq_num;                                                                                                            // bytes 4 to 7
  SendTime send_time;                                                                                                        // bytes 8 to 15
  Messages(delivery_flag, number_msgs, (available - 16), tally) messages[:byte-size-single-element-array (available - 16)];
} Packet;

