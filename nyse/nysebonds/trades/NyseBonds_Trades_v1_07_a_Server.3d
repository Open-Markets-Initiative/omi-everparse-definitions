// New York Stock Exchange Trades
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out NyseBonds_Trades_v1_07_a_Server.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
//
// License: MIT No Attribution

// ---- Message Header: 4 bytes -------------------------------------------------

// Nyse Arca Binary Protocol message header
entrypoint typedef struct _MessageHeader {
  UINT16BE message_body_length;  // bytes 0 to 1
  UINT8 message_type;            // byte 2
  UINT8 padding;                 // byte 3
} MessageHeader;

// ---- Login Accepted Message: 6 bytes -----------------------------------------

// Sent to indicate a successful login. Carries the current version of ArcaTrade.
entrypoint typedef struct _LoginAcceptedMessage {
  UINT8 version_id[5];    // bytes 0 to 4
  UINT8 padding_ascii_1;  // byte 5
} LoginAcceptedMessage;

// ---- Login Rejected Message: 2 bytes -----------------------------------------

// Sent when login fails authentication, the client does not log in within 30 seconds, no trade data feed was subscribed to, the sequence number was invalid, or no connections are available. The socket is closed afterwards.
entrypoint typedef struct _LoginRejectedMessage {
  UINT8 reject_code;      // byte 0
  UINT8 padding_ascii_1;  // byte 1
} LoginRejectedMessage;

// ---- Test Response Message: 20 bytes -----------------------------------------

// Sent in response to a Test Request, echoing back any text the request carried.
entrypoint typedef struct _TestResponseMessage {
  UINT8 test_message[20];  // bytes 0 to 19
} TestResponseMessage;

// ---- Last Sale Message: 64 bytes ---------------------------------------------

// Sent when an order partially trades or completely trades.
entrypoint typedef struct _LastSaleMessage {
  UINT32BE last_sale_time;          // bytes 0 to 3
  UINT32BE sequence_number;         // bytes 4 to 7
  UINT32BE trade_reference_number;  // bytes 8 to 11
  UINT32BE quantity;                // bytes 12 to 15
  UINT32BE price;                   // bytes 16 to 19
  UINT8 price_scale_code;           // byte 20
  UINT8 system_code;                // byte 21
  UINT8 exchange_code;              // byte 22
  UINT8 trade_condition;            // byte 23
  UINT8 security_type;              // byte 24
  UINT8 nyse_bond_symbol[22];       // bytes 25 to 46
  UINT8 cusip_isin[14];             // bytes 47 to 60
  UINT8 padding_ascii_3[3];         // bytes 61 to 63
} LastSaleMessage;

// ---- Trade Bust Or Correction Message: 64 bytes ------------------------------

// Sent when trades are busted or corrected. The Event Code field says which.
entrypoint typedef struct _TradeBustOrCorrectionMessage {
  UINT32BE last_sale_time;          // bytes 0 to 3
  UINT32BE sequence_number;         // bytes 4 to 7
  UINT32BE trade_reference_number;  // bytes 8 to 11
  UINT32BE quantity;                // bytes 12 to 15
  UINT32BE price;                   // bytes 16 to 19
  UINT8 price_scale_code;           // byte 20
  UINT8 system_code;                // byte 21
  UINT8 event_code;                 // byte 22
  UINT8 exchange_code;              // byte 23
  UINT8 trade_condition;            // byte 24
  UINT8 security_type;              // byte 25
  UINT8 nyse_bond_symbol[22];       // bytes 26 to 47
  UINT8 cusip_isin[14];             // bytes 48 to 61
  UINT8 padding_ascii_2[2];         // bytes 62 to 63
} TradeBustOrCorrectionMessage;

// ---- Nyse Bond Closing Price Message: 64 bytes -------------------------------

// Sent during day end processing with the final closing price and volume for a bond. The specification notes this message is not supported at the time of writing and will be implemented in a future release.
entrypoint typedef struct _NyseBondClosingPriceMessage {
  UINT32BE closing_time;            // bytes 0 to 3
  UINT32BE sequence_number;         // bytes 4 to 7
  UINT32BE trade_reference_number;  // bytes 8 to 11
  UINT32BE quantity;                // bytes 12 to 15
  UINT32BE closing_price;           // bytes 16 to 19
  UINT8 price_scale_code;           // byte 20
  UINT8 system_code;                // byte 21
  UINT8 exchange_code;              // byte 22
  UINT8 trade_condition;            // byte 23
  UINT8 security_type;              // byte 24
  UINT8 nyse_bond_symbol[22];       // bytes 25 to 46
  UINT8 cusip_isin[14];             // bytes 47 to 60
  UINT8 padding_ascii_3[3];         // bytes 61 to 63
} NyseBondClosingPriceMessage;

