// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NyseBonds_DepthOfBook_v4_01_b_Server.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_LOGIN_ACCEPTED_MESSAGE 0x51  // Login Accepted Message
#define MESSAGE_TYPE_LOGIN_REJECTED_MESSAGE 0x52  // Login Rejected Message
#define MESSAGE_TYPE_HEARTBEAT_MESSAGE 0x48       // Heartbeat Message
#define MESSAGE_TYPE_TEST_RESPONSE_MESSAGE 0x53   // Test Response Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x4E       // Add Order Message
#define MESSAGE_TYPE_MODIFY_ORDER_MESSAGE 0x43    // Modify Order Message
#define MESSAGE_TYPE_DELETE_ORDER_MESSAGE 0x4B    // Delete Order Message
#define MESSAGE_TYPE_IMBALANCE_MESSAGE 0x57       // Imbalance Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x59    // System Event Message

// Reject Code: one byte code
#define REJECT_CODE_NOT_AUTHORIZED 0x41                      // Not Authorized
#define REJECT_CODE_MAXIMUM_SERVER_CONNECTIONS_REACHED 0x4D  // Maximum Server Connections Reached
#define REJECT_CODE_INVALID_SUBSCRIPTION 0x52                // Invalid Subscription
#define REJECT_CODE_INVALID_SEQUENCE 0x53                    // Invalid Sequence
#define REJECT_CODE_TIMEOUT 0x54                             // Timeout

// Price Scale Code: one byte code
#define PRICE_SCALE_CODE_NO_DIVISION 0x30           // No Division
#define PRICE_SCALE_CODE_TEN 0x31                   // Ten
#define PRICE_SCALE_CODE_ONE_HUNDRED 0x32           // One Hundred
#define PRICE_SCALE_CODE_ONE_THOUSAND 0x33          // One Thousand
#define PRICE_SCALE_CODE_TEN_THOUSAND 0x34          // Ten Thousand
#define PRICE_SCALE_CODE_ONE_HUNDRED_THOUSAND 0x35  // One Hundred Thousand
#define PRICE_SCALE_CODE_ONE_MILLION 0x36           // One Million

// Exchange Code: one byte code
#define EXCHANGE_CODE_NYSE_LISTED_BOND 0x4E  // Nyse Listed Bond

// System Code: one byte code
#define SYSTEM_CODE_BONDS 0x46  // Bonds

// Buy Sell Indicator: one byte code
#define BUY_SELL_INDICATOR_BUY_ORDER 0x42   // Buy Order
#define BUY_SELL_INDICATOR_SELL_ORDER 0x53  // Sell Order

// Flat Pricing: one byte code
#define FLAT_PRICING_FLAT_PRICING_IS_IN_EFFECT 0x46  // Flat Pricing Is In Effect

// Trading Action: one byte code
#define TRADING_ACTION_CALLED 0x01                                   // Called
#define TRADING_ACTION_DELISTED 0x02                                 // Delisted
#define TRADING_ACTION_EX_INTEREST 0x03                              // Ex Interest
#define TRADING_ACTION_MISSED_AN_INTEREST_PAYMENT 0x04               // Missed An Interest Payment
#define TRADING_ACTION_BANKRUPT 0x05                                 // Bankrupt
#define TRADING_ACTION_LATE_FILING 0x06                              // Late Filing
#define TRADING_ACTION_BELOW_LISTING_STANDARDS 0x07                  // Below Listing Standards
#define TRADING_ACTION_LATE_FILING_AND_BELOW_LISTING_STANDARDS 0x08  // Late Filing And Below Listing Standards
#define TRADING_ACTION_BANKRUPT_AND_LATE_FILING 0x09                 // Bankrupt And Late Filing
#define TRADING_ACTION_BANKRUPT_AND_BELOW_LISTING_STANDARDS 0x0A     // Bankrupt And Below Listing Standards

// Security Type: one byte code
#define SECURITY_TYPE_CORPORATE_BONDS 0x01  // Corporate Bonds

// Order Type: one byte code
#define ORDER_TYPE_UNSPECIFIED 0x00       // Unspecified
#define ORDER_TYPE_ALL_OR_NONE 0x01       // All Or None
#define ORDER_TYPE_MINIMUM_QUANTITY 0x02  // Minimum Quantity

// Auction Type: one byte code
#define AUCTION_TYPE_OPEN 0x4F     // Open
#define AUCTION_TYPE_MARKET 0x4D   // Market
#define AUCTION_TYPE_HALT 0x48     // Halt
#define AUCTION_TYPE_CLOSING 0x43  // Closing

// Event Code: one byte code
#define EVENT_CODE_CLEAR_BOOK 0x43            // Clear Book
#define EVENT_CODE_CLEAR_BOOK_BY_SYMBOL 0x53  // Clear Book By Symbol
#define EVENT_CODE_HALT_SYMBOL 0x48           // Halt Symbol
#define EVENT_CODE_UN_HALT_SYMBOL 0x55        // Un Halt Symbol

// ---- Types -------------------------------------------------------------------

// Sent to indicate a successful login. Carries the current version of the Nyse ArcaBook protocol.
typedef struct _LoginAcceptedMessage {
  UINT8 version_id[5];    // bytes 0 to 4
  UINT8 padding_ascii_1;  // byte 5
} LoginAcceptedMessage;

// Sent when login fails authentication, the client does not log in within 5 seconds, no order data feed was subscribed to, the sequence number was invalid, no connections are available, or a timeout occurred. The socket is closed afterwards.
typedef struct _LoginRejectedMessage {
  UINT8 reject_code;      // byte 0
  UINT8 padding_ascii_1;  // byte 1
} LoginRejectedMessage;

// Sent in response to a Test Request, echoing back any text the request carried.
typedef struct _TestResponseMessage {
  UINT8 test_message[20];  // bytes 0 to 19
} TestResponseMessage;

// Sent for a new open order. The Order Reference Number is unique per order book, while the Sequence Number is unique across all order books.
typedef struct _AddOrderMessage {
  UINT32BE time;                    // bytes 0 to 3
  UINT32BE sequence_number;         // bytes 4 to 7
  UINT32BE order_reference_number;  // bytes 8 to 11
  UINT32BE quantity;                // bytes 12 to 15
  UINT32BE price;                   // bytes 16 to 19
  UINT8 price_scale_code;           // byte 20
  UINT8 exchange_code;              // byte 21
  UINT8 system_code;                // byte 22
  UINT8 buy_sell_indicator;         // byte 23
  UINT8 flat_pricing;               // byte 24
  UINT8 trading_action;             // byte 25
  UINT8 security_type;              // byte 26
  UINT8 order_type;                 // byte 27
  UINT8 nyse_bond_symbol[22];       // bytes 28 to 49
  UINT8 cusip_isin[14];             // bytes 50 to 63
  UINT8 quote_id[5];                // bytes 64 to 68
  UINT8 padding_ascii_3[3];         // bytes 69 to 71
  UINT32BE minimum_quantity;        // bytes 72 to 75
} AddOrderMessage;

// Sent when an order in a Nyse Bonds book is modified: its price or size changes, it is partially filled, or it is routed away with shares remaining. The Order Reference Number refers to the original Add Order.
typedef struct _ModifyOrderMessage {
  UINT32BE time;                    // bytes 0 to 3
  UINT32BE sequence_number;         // bytes 4 to 7
  UINT32BE order_reference_number;  // bytes 8 to 11
  UINT32BE quantity;                // bytes 12 to 15
  UINT32BE price;                   // bytes 16 to 19
  UINT8 price_scale_code;           // byte 20
  UINT8 exchange_code;              // byte 21
  UINT8 system_code;                // byte 22
  UINT8 buy_sell_indicator;         // byte 23
  UINT8 flat_pricing;               // byte 24
  UINT8 trading_action;             // byte 25
  UINT8 security_type;              // byte 26
  UINT8 order_type;                 // byte 27
  UINT8 nyse_bond_symbol[22];       // bytes 28 to 49
  UINT8 cusip_isin[14];             // bytes 50 to 63
  UINT8 quote_id[5];                // bytes 64 to 68
  UINT8 padding_ascii_3[3];         // bytes 69 to 71
  UINT32BE minimum_quantity;        // bytes 72 to 75
} ModifyOrderMessage;

// Sent when an order is taken off the open order book because it was cancelled, expired, routed to an away market, or filled.
typedef struct _DeleteOrderMessage {
  UINT32BE time;                    // bytes 0 to 3
  UINT32BE sequence_number;         // bytes 4 to 7
  UINT32BE order_reference_number;  // bytes 8 to 11
  UINT8 exchange_code;              // byte 12
  UINT8 system_code;                // byte 13
  UINT8 buy_sell_indicator;         // byte 14
  UINT8 flat_pricing;               // byte 15
  UINT8 trading_action;             // byte 16
  UINT8 security_type;              // byte 17
  UINT8 order_type;                 // byte 18
  UINT8 nyse_bond_symbol[22];       // bytes 19 to 40
  UINT8 cusip_isin[14];             // bytes 41 to 54
  UINT8 quote_id[5];                // bytes 55 to 59
} DeleteOrderMessage;

// Sent in response to orders submitted during pending auctions, at the conclusion of the Opening, Market Order and Closing Auctions, and for Halt Auctions. Total and market imbalance volumes are negative for a sell imbalance.
typedef struct _ImbalanceMessage {
  UINT32BE time;               // bytes 0 to 3
  UINT32BE sequence_number;    // bytes 4 to 7
  UINT32BE match_quantity;     // bytes 8 to 11
  UINT32BE total_imbalance;    // bytes 12 to 15
  UINT32BE market_imbalance;   // bytes 16 to 19
  UINT32BE price;              // bytes 20 to 23
  UINT8 price_scale_code;      // byte 24
  UINT8 exchange_code;         // byte 25
  UINT8 system_code;           // byte 26
  UINT8 auction_type;          // byte 27
  UINT8 flat_pricing;          // byte 28
  UINT8 trading_action;        // byte 29
  UINT8 security_type;         // byte 30
  UINT8 quote_condition;       // byte 31
  UINT8 nyse_bond_symbol[22];  // bytes 32 to 53
  UINT8 cusip_isin[14];        // bytes 54 to 67
  UINT8 auction_time[4];       // bytes 68 to 71
} ImbalanceMessage;

// Sent to indicate a special system event to an order book. The Event Code says what happened and the System Code which book is affected. Also carries the next sequence number subscribers should expect, which is generally the current one plus one but may restart at 1.
typedef struct _SystemEventMessage {
  UINT32BE time;                           // bytes 0 to 3
  UINT32BE sequence_number;                // bytes 4 to 7
  UINT32BE next_expected_sequence_number;  // bytes 8 to 11
  UINT8 event_code;                        // byte 12
  UINT8 system_code;                       // byte 13
  UINT8 nyse_bond_symbol[22];              // bytes 14 to 35
  UINT8 cusip_isin[14];                    // bytes 36 to 49
  UINT8 padding_ascii_2[2];                // bytes 50 to 51
} SystemEventMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x51: LoginAcceptedMessage login_accepted_message;
    case 0x52: LoginRejectedMessage login_rejected_message;
    case 0x48: unit heartbeat_message;
    case 0x53: TestResponseMessage test_response_message;
    case 0x4E: AddOrderMessage add_order_message;
    case 0x43: ModifyOrderMessage modify_order_message;
    case 0x4B: DeleteOrderMessage delete_order_message;
    case 0x57: ImbalanceMessage imbalance_message;
    case 0x59: SystemEventMessage system_event_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Nyse Abp message sent by the exchange
typedef struct _Message {
  UINT16BE message_body_length;                                                                                                   // bytes 0 to 1
  UINT8 message_type;                                                                                                             // byte 2
  UINT8 padding;                                                                                                                  // byte 3
  Payload(message_type, ((UINT32) message_body_length)) payload[:byte-size-single-element-array ((UINT32) message_body_length)];
} Message;

// ---- Packet: ServerPacket ----------------------------------------------------

// Nyse Abp Tcp packet sent by the exchange to the client
entrypoint typedef struct _ServerPacket (UINT32 available) {
  Message message[:byte-size available];
} ServerPacket;

