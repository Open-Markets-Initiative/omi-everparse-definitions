// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NyseBonds_DepthOfBook_v4_01_b_Client.3d

// ---- Types -------------------------------------------------------------------

// Authenticates the subscriber and names which order data the session subscribes to. A starting sequence number of 0 requests current data; a greater number than the exchange holds is treated as 0, and a negative one is rejected
typedef struct _LoginMessage {
  UINT8 username[8];                // bytes 0 to 7
  UINT8 password[10];               // bytes 8 to 17
  UINT8 login_sequence_number[10];  // bytes 18 to 27
  UINT8 listed_subscription;        // byte 28
  UINT8 etf_subscription;           // byte 29
  UINT8 otc_subscription;           // byte 30
  UINT8 global_otc_subscription;    // byte 31
  UINT8 bond_subscription;          // byte 32
  UINT8 etx;                        // byte 33
} LoginMessage;

// Closes the session. Carries only its type code and the terminator
typedef struct _LogoffMessage {
  UINT8 etx;  // byte 0
} LogoffMessage;

// Answers a Heartbeat Request. The exchange closes the connection if no response arrives within 60 seconds. Table 9 of the specification labels the second field Username , which is a copy and paste slip - its own description reads Message Terminating Character
typedef struct _HeartbeatResponseMessage {
  UINT8 etx;  // byte 0
} HeartbeatResponseMessage;

// Signals or tests that the Tcp connection is open. Any text given is echoed back in a Test Response
typedef struct _TestRequestMessage {
  UINT8 test_request_text[20];  // bytes 0 to 19
  UINT8 etx;                    // byte 20
} TestRequestMessage;

// Session message body sent by the client, dispatched on the message type
casetype _ClientData (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x4C: LoginMessage login_message;
    case 0x4F: LogoffMessage logoff_message;
    case 0x48: HeartbeatResponseMessage heartbeat_response_message;
    case 0x54: TestRequestMessage test_request_message;
    default: UINT8 unknown[available];
  }
} ClientData;

// ---- Packet: ClientPacket ----------------------------------------------------

// Nyse Abp Tcp packet sent by the client to the exchange
entrypoint typedef struct _ClientPacket (UINT32 available) where (available >= 1) {
  UINT8 client_message_type;                                                                                      // byte 0
  ClientData(client_message_type, (available - 1)) client_data[:byte-size-single-element-array (available - 1)];
} ClientPacket;

