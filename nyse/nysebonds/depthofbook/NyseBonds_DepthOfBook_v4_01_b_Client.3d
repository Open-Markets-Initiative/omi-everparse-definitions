// ---- Client Message Header: 1 byte -------------------------------------------

// The single Ascii type code that opens every client message
entrypoint typedef struct _ClientMessageHeader {
  UINT8 client_message_type;  // byte 0
} ClientMessageHeader;

// ---- Login Message: 34 bytes -------------------------------------------------

// Authenticates the subscriber and names which order data the session subscribes to. A starting sequence number of 0 requests current data; a greater number than the exchange holds is treated as 0, and a negative one is rejected
entrypoint typedef struct _LoginMessage {
  UINT8 username[8];                // bytes 0 to 7
  UINT8 password[10];               // bytes 8 to 17
  UINT8 login_sequence_number[10];  // bytes 18 to 27
  UINT8 listed_subscription;        // byte 28
  UINT8 etf_subscription;           // byte 29
  UINT8 otc_subscription;           // byte 30
  UINT8 global_otc_subscription;    // byte 31
  UINT8 bond_subscription;          // byte 32
  UINT8 etx;                        // byte 33
} LoginMessage;

// ---- Logoff Message: 1 byte --------------------------------------------------

// Closes the session. Carries only its type code and the terminator
entrypoint typedef struct _LogoffMessage {
  UINT8 etx;  // byte 0
} LogoffMessage;

// ---- Heartbeat Response Message: 1 byte --------------------------------------

// Answers a Heartbeat Request. The exchange closes the connection if no response arrives within 60 seconds. Table 9 of the specification labels the second field Username , which is a copy and paste slip - its own description reads Message Terminating Character
entrypoint typedef struct _HeartbeatResponseMessage {
  UINT8 etx;  // byte 0
} HeartbeatResponseMessage;

// ---- Test Request Message: 21 bytes ------------------------------------------

// Signals or tests that the Tcp connection is open. Any text given is echoed back in a Test Response
entrypoint typedef struct _TestRequestMessage {
  UINT8 test_request_text[20];  // bytes 0 to 19
  UINT8 etx;                    // byte 20
} TestRequestMessage;

