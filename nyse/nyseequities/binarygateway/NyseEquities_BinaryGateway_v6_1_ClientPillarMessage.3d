// Branch
casetype _ClientSequencedMessage (UINT16 selector, UINT32 length, UINT32 length_2, UINT32 length_3, UINT32 length_4, UINT32 length_5, UINT32 length_6, UINT32 length_7, UINT32 length_8, UINT32 length_9, UINT16 seq_msg_length) {
