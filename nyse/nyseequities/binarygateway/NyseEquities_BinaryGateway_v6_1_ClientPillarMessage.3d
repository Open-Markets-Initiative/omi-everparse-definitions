    case 0x0282: unit sequenced_filler_message;
    case 0x0240: NewOrderSingleAndCancelReplaceRequestMessage(seq_msg_length) new_order_single_and_cancel_replace_request_message[:byte-size-single-element-array length_2];
    case 0x0280: OrderCancelRequestMessage order_cancel_request_message[:byte-size-single-element-array length_3];
    case 0x0270: OrderModifyRequestMessage order_modify_request_message[:byte-size-single-element-array length_4];
    case 0x0281: BulkCancelRequestMessage bulk_cancel_request_message[:byte-size-single-element-array length_5];
    case 0x0346: SymbolSubscriptionRequestMessage symbol_subscription_request_message[:byte-size-single-element-array length_6];
    case 0x0343: unit tg_begin_message;
    case 0x0344: unit tg_end_message;
    case 0x0354: ManualActionResponseMessage manual_action_response_message[:byte-size-single-element-array length_7];
    case 0x0330: RiskLimitUpdateRequestMessage risk_limit_update_request_message[:byte-size-single-element-array length_8];
    case 0x0331: RiskActionRequestMessage risk_action_request_message[:byte-size-single-element-array length_9];
  }
} ClientSequencedMessage;

// Used to transmit a stream message
typedef struct _ClientSeqMsg {
  SeqMsgId seq_msg_id;                                                                                                                                                                                                                                                                                                                                                                     // bytes 0 to 15
  UINT8 reserved_4[4];                                                                                                                                                                                                                                                                                                                                                                     // bytes 16 to 19
  UINT64 timestamp;                                                                                                                                                                                                                                                                                                                                                                        // bytes 20 to 27
  UINT16 seq_msg_type;                                                                                                                                                                                                                                                                                                                                                                     // bytes 28 to 29
  UINT16 seq_msg_length { seq_msg_length >= 4 };                                                                                                                                                                                                                                                                                                                                           // bytes 30 to 31
  ClientSequencedMessage(seq_msg_type, (((UINT32) seq_msg_length) - 4), (((UINT32) seq_msg_length) - 4), (((UINT32) seq_msg_length) - 4), (((UINT32) seq_msg_length) - 4), (((UINT32) seq_msg_length) - 4), (((UINT32) seq_msg_length) - 4), (((UINT32) seq_msg_length) - 4), (((UINT32) seq_msg_length) - 4), (((UINT32) seq_msg_length) - 4), seq_msg_length) client_sequenced_message;
} ClientSeqMsg;

// Branch
casetype _ClientMessage (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0201: LoginMessage login_message;
    case 0x0204: Heartbeat heartbeat;
    case 0x0205: Open open_;
    case 0x0207: Close close;
    case 0x0905: ClientSeqMsg client_seq_msg;
    default: UINT8 unknown[available];
  }
} ClientMessage;

// ---- Packet: ClientPillarMessage ---------------------------------------------

// Pillar Stream message sent by the member firm
entrypoint typedef struct _ClientPillarMessage (UINT32 available) where (available >= 4) {
  UINT16 msg_type;                                                                                           // bytes 0 to 1
  UINT16 msg_length;                                                                                         // bytes 2 to 3
  ClientMessage(msg_type, (available - 4)) client_message[:byte-size-single-element-array (available - 4)];
} ClientPillarMessage;

