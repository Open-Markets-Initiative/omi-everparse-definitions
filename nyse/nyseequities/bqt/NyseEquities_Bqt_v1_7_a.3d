  UINT8 num_close_prices;          // byte 34
  UINT16 market_id_of_the_close;   // bytes 35 to 36
  UINT32 close;                    // bytes 37 to 40
} ConsolidatedStockSummaryMessage;

// ---- Consolidated Volume Message: 14 bytes -----------------------------------

// Published on consolidated volume channels
entrypoint typedef struct _ConsolidatedVolumeMessage {
  UINT32 symbol_index;       // bytes 0 to 3
  UINT32 symbol_seq_number;  // bytes 4 to 7
  UINT32 total_volume;       // bytes 8 to 11
  UINT8 reason;              // byte 12
  UINT8 complete;            // byte 13
} ConsolidatedVolumeMessage;

