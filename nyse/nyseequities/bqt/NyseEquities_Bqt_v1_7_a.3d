  UINT8 trade_condition_4;   // byte 35
  UINT16 market_id;          // bytes 36 to 37
} ConsolidatedTradeCorrectionMessage;

// ---- Consolidated Stock Summary Message: 41 bytes ----------------------------

// The stock summary message is sent every 1 minute regardless of whether there is a change to a particular value or not. In the event that there is no volume on the stock, the stock summary message will not be disseminated.
entrypoint typedef struct _ConsolidatedStockSummaryMessage {
  UINT32 source_time;              // bytes 0 to 3
  UINT32 source_time_ns;           // bytes 4 to 7
  UINT32 symbol_index;             // bytes 8 to 11
  UINT32 high_price;               // bytes 12 to 15
  UINT32 low_price;                // bytes 16 to 19
