  UINT32 price_1;                    // bytes 22 to 25
  UINT32 price_2;                    // bytes 26 to 29
  UINT8 ssr_triggering_exchange_id;  // byte 30
  UINT32 ssr_triggering_volume;      // bytes 31 to 34
  UINT32 time;                       // bytes 35 to 38
  UINT8 ssr_state;                   // byte 39
  UINT8 market_state;                // byte 40
  UINT8 session_state;               // byte 41
} ConsolidatedSecurityStatusMessage;

// ---- Bqt Message: 31 bytes ---------------------------------------------------

// This message is sent when an event causes a change in one or both sides of the BBO.
entrypoint typedef struct _BqtMessage {
  UINT32 symbol_index;             // bytes 0 to 3
  UINT32 symbol_seq_number;        // bytes 4 to 7
  UINT32 ask_price;                // bytes 8 to 11
  UINT32 ask_volume;               // bytes 12 to 15
  UINT32 bid_price;                // bytes 16 to 19
  UINT32 bid_volume;               // bytes 20 to 23
  UINT8 ask_quote_condition;       // byte 24
  UINT8 bid_quote_condition;       // byte 25
  UINT8 retail_pricing_indicator;  // byte 26
  UINT16 market_id_of_best_ask;    // bytes 27 to 28
  UINT16 market_id_of_best_bid;    // bytes 29 to 30
} BqtMessage;

// ---- Consolidated Single Sided Quote Message: 21 bytes -----------------------

// This message is sent when an event causes a change in only one side of a BBO.
entrypoint typedef struct _ConsolidatedSingleSidedQuoteMessage {
  UINT32 symbol_index;       // bytes 0 to 3
  UINT32 symbol_seq_number;  // bytes 4 to 7
  UINT8 side;                // byte 8
  UINT32 price;              // bytes 9 to 12
  UINT32 volume;             // bytes 13 to 16
  UINT8 quote_condition;     // byte 17
  UINT8 rpi_indicator;       // byte 18
  UINT16 market_id;          // bytes 19 to 20
} ConsolidatedSingleSidedQuoteMessage;

// ---- Consolidated Trade Message: 34 bytes ------------------------------------

// The Trade messages provided on the Trades feed are the same Trade messages provided to the Cta. All Trades are passed through and marked with the originating Market ID.
entrypoint typedef struct _ConsolidatedTradeMessage {
  UINT32 source_time;       // bytes 0 to 3
  UINT32 source_time_ns;    // bytes 4 to 7
  UINT32 symbol_index;      // bytes 8 to 11
