} ConsolidatedTradeCancelMessage;

// ---- Consolidated Trade Correction Message: 38 bytes -------------------------

// This message is sent when a trade is corrected
entrypoint typedef struct _ConsolidatedTradeCorrectionMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 symbol_index;       // bytes 8 to 11
  UINT32 symbol_seq_number;  // bytes 12 to 15
