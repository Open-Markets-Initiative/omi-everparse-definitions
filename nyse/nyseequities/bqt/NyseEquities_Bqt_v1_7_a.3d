  UINT8 trade_condition_3;  // byte 30
  UINT8 trade_condition_4;  // byte 31
  UINT16 market_id;         // bytes 32 to 33
} ConsolidatedTradeMessage;

// ---- Consolidated Trade Cancel Message: 22 bytes -----------------------------

// This message is sent when a trade is cancelled
entrypoint typedef struct _ConsolidatedTradeCancelMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 symbol_index;       // bytes 8 to 11
  UINT32 symbol_seq_number;  // bytes 12 to 15
  UINT32 trade_id;           // bytes 16 to 19
