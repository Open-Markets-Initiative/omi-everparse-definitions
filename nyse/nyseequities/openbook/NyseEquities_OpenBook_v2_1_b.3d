// New York Stock Exchange Open Book
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out NyseEquities_OpenBook_v2_1_b.3d
//
// What this definition does not state, and the model does:
// - a length prefix framing what follows
// - a run counted by a field
// - a run filling what frames it
//
// License: MIT No Attribution

// ---- Packet Header: 16 bytes -------------------------------------------------

entrypoint typedef struct _PacketHeader {
  UINT16BE packet_size;       // bytes 0 to 1
  UINT16BE message_type;      // bytes 2 to 3
  UINT32BE sequence_number;   // bytes 4 to 7
  UINT32BE timestamp;         // bytes 8 to 11
  UINT8 product_id;           // byte 12
  UINT8 retransmission_flag;  // byte 13
  UINT8 message_count;        // byte 14
  UINT8 link_flag;            // byte 15
} PacketHeader;

// ---- Sequence Number Reset Message: 4 bytes ----------------------------------

// This message is sent to reset the Packet Sequence Number.
entrypoint typedef struct _SequenceNumberResetMessage {
  UINT32BE next_sequence_number;  // bytes 0 to 3, signed, read here as unsigned
} SequenceNumberResetMessage;

// ---- Unavailable Message: 8 bytes --------------------------------------------

// This message will be sent over the Retransmission multicast channels to inform the clients of unavailability of a range of messages for which they have requested a retransmission.
entrypoint typedef struct _UnavailableMessage {
  UINT32BE begin_seq_num;  // bytes 0 to 3, signed, read here as unsigned
  UINT32BE end_seq_num;    // bytes 4 to 7, signed, read here as unsigned
} UnavailableMessage;

// ---- Request Response Message: 28 bytes --------------------------------------

// This message will be sent immediately via TCP/IP in response to the client's request for a retransmission, refresh, or Symbol Index information. The requested information will follow in the appropriate retransmission or refresh channel.
entrypoint typedef struct _RequestResponseMessage {
  UINT32BE source_seq_num;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 source_id[20];      // bytes 4 to 23
  UINT8 status;             // byte 24
  UINT8 reject_reason;      // byte 25
  UINT8 filler_2[2];        // bytes 26 to 27
} RequestResponseMessage;

// ---- Retransmission Request Message: 28 bytes --------------------------------

// This message is sent by clients to request a retransmission of missed packets. In response, a Request Response message (type 10) will be sent back over the Request TCP connection, and the retransmitted packets will be delivered over the Retransmission channels.
entrypoint typedef struct _RetransmissionRequestMessage {
  UINT32BE begin_seq_num;  // bytes 0 to 3, signed, read here as unsigned
  UINT32BE end_seq_num;    // bytes 4 to 7, signed, read here as unsigned
  UINT8 source_id[20];     // bytes 8 to 27
} RetransmissionRequestMessage;

// ---- Book Refresh Request Message: 36 bytes ----------------------------------

// This message is sent by clients requesting a full book refresh.
entrypoint typedef struct _BookRefreshRequestMessage {
  UINT8 symbol_16[16];  // bytes 0 to 15
  UINT8 source_id[20];  // bytes 16 to 35
} BookRefreshRequestMessage;

// ---- Heartbeat Response Message: 20 bytes ------------------------------------

// Clients that remain connected to the Request server intraday must respond within 120 seconds to any heartbeat received with a single message of this type in its own packet. This response demonstrates that the TCP connection is still alive and prevents the Request Server from closing the connection.
entrypoint typedef struct _HeartbeatResponseMessage {
  UINT8 source_id[20];  // bytes 0 to 19
} HeartbeatResponseMessage;

// ---- Extended Book Refresh Request Message: 26 bytes -------------------------

// The Extended Book Refresh Request message allows the client to request a refresh by symbol index as opposed to symbol, and to request a refresh of all symbols in a channel.
entrypoint typedef struct _ExtendedBookRefreshRequestMessage {
  UINT8 source_id[20];    // bytes 0 to 19
  UINT32BE symbol_index;  // bytes 20 to 23, signed, read here as unsigned
  UINT16BE msg_type;      // bytes 24 to 25, signed, read here as unsigned
} ExtendedBookRefreshRequestMessage;

// ---- Symbol Index Mapping Request Message: 24 bytes --------------------------

// This message is sent by clients requesting a refresh of Symbol Index mapping information only.
entrypoint typedef struct _SymbolIndexMappingRequestMessage {
  UINT8 source_id[20];    // bytes 0 to 19
  UINT32BE symbol_index;  // bytes 20 to 23, signed, read here as unsigned
} SymbolIndexMappingRequestMessage;

