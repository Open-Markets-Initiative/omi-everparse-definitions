// ---- Send Time: 8 bytes ------------------------------------------------------

// The time when this packet was published to the multicast channel
entrypoint typedef struct _SendTime {
  UINT32 seconds;      // bytes 0 to 3
  UINT32 nanoseconds;  // bytes 4 to 7
} SendTime;

// ---- Packet Header: 16 bytes -------------------------------------------------

// Pillar common client udp packet header
entrypoint typedef struct _PacketHeader {
  UINT16 pkt_size;      // bytes 0 to 1
  UINT8 delivery_flag;  // byte 2
  UINT8 number_msgs;    // byte 3
  UINT32 seq_num;       // bytes 4 to 7
  SendTime send_time;   // bytes 8 to 15
} PacketHeader;

// ---- Message Header: 4 bytes -------------------------------------------------

// Pillar message header
entrypoint typedef struct _MessageHeader {
  UINT16 message_size;  // bytes 0 to 1
  UINT16 message_type;  // bytes 2 to 3
} MessageHeader;

