// New York Stock Exchange Deep Feed
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out ArcaOptions_DeepFeed_v1_2_f.3d
//
// What this definition does not state, and the model does:
// - the dispatch that chooses a message by its type
// - a run filling what frames it
// - a field present only on a condition
//
// License: MIT No Attribution

// ---- Send Time: 8 bytes ------------------------------------------------------

// The time when this packet was published to the multicast channel
entrypoint typedef struct _SendTime {
  UINT32 seconds;      // bytes 0 to 3
  UINT32 nanoseconds;  // bytes 4 to 7
} SendTime;

// ---- Packet Header: 16 bytes -------------------------------------------------

// Pillar common client udp packet header
entrypoint typedef struct _PacketHeader {
  UINT16 pkt_size;      // bytes 0 to 1
  UINT8 delivery_flag;  // byte 2
  UINT8 number_msgs;    // byte 3
  UINT32 seq_num;       // bytes 4 to 7
  SendTime send_time;   // bytes 8 to 15
} PacketHeader;

// ---- Message Header: 4 bytes -------------------------------------------------

// Pillar message header
entrypoint typedef struct _MessageHeader {
  UINT16 message_size;  // bytes 0 to 1
  UINT16 message_type;  // bytes 2 to 3
} MessageHeader;

// ---- Sequence Number Reset Message: 10 bytes ---------------------------------

// This message is sent to reset the Message Sequence Number at start of day, or in response to failures.
entrypoint typedef struct _SequenceNumberResetMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT8 product_id;       // byte 8
  UINT8 channel_id;       // byte 9
} SequenceNumberResetMessage;

// ---- Time Reference Message: 12 bytes ----------------------------------------

// This message is sent at the start of every second during periods of active data publication
entrypoint typedef struct _TimeReferenceMessage {
  UINT32 id;            // bytes 0 to 3
  UINT8 reserved_4[4];  // bytes 4 to 7
  UINT32 source_time;   // bytes 8 to 11
} TimeReferenceMessage;

// ---- Symbol Index Mapping Message: 40 bytes ----------------------------------

// This message is published over the real-time data channels at system startup or in the context of a refresh sequence after a Matching Engine or XDP Publisher failover. It provides referential data for a single specified symbol.
entrypoint typedef struct _SymbolIndexMappingMessage {
  UINT32 symbol_index;       // bytes 0 to 3
  UINT8 symbol[11];          // bytes 4 to 14
  UINT8 reserved_1;          // byte 15
  UINT16 market_id;          // bytes 16 to 17
  UINT8 system_id;           // byte 18
  UINT8 exchange_code;       // byte 19
  UINT8 price_scale_code;    // byte 20
  UINT8 security_type;       // byte 21
  UINT16 lot_size;           // bytes 22 to 23
  UINT32 prev_close_price;   // bytes 24 to 27
  UINT32 prev_close_volume;  // bytes 28 to 31
  UINT8 price_resolution;    // byte 32
  UINT8 round_lot;           // byte 33
  UINT8 reserved_6[6];       // bytes 34 to 39
} SymbolIndexMappingMessage;

// ---- Retransmission Request Message: 20 bytes --------------------------------

// Clients who have experienced a sequence number gap and need a retransmission of the missed messages should send a Retransmission Request message via TCP to the Request Controller. A Request Response message will be sent over the TCP connection back to the client, and if the request was valid, the requested message(s) will be re-published over the relevant Retransmission multicast channel.
entrypoint typedef struct _RetransmissionRequestMessage {
  UINT32 begin_seq_num;  // bytes 0 to 3
  UINT32 end_seq_num;    // bytes 4 to 7
  UINT8 source_id[10];   // bytes 8 to 17
  UINT8 product_id;      // byte 18
  UINT8 channel_id;      // byte 19
} RetransmissionRequestMessage;

// ---- Request Response Message: 25 bytes --------------------------------------

// This message will be sent immediately via TCP/IP in response to the client s request for retransmission, refresh or Symbol Mapping messages.
entrypoint typedef struct _RequestResponseMessage {
  UINT32 request_seq_num;  // bytes 0 to 3
  UINT32 begin_seq_num;    // bytes 4 to 7
  UINT32 end_seq_num;      // bytes 8 to 11
  UINT8 source_id[10];     // bytes 12 to 21
  UINT8 product_id;        // byte 22
  UINT8 channel_id;        // byte 23
  UINT8 status;            // byte 24
} RequestResponseMessage;

// ---- Heartbeat Response Message: 10 bytes ------------------------------------

// Clients who remain connected to the Retransmission Server intraday must respond to a Heartbeat with a Heartbeat Response message within 5 seconds. If no timely client response is received, the connection will be closed.
entrypoint typedef struct _HeartbeatResponseMessage {
  UINT8 source_id[10];  // bytes 0 to 9
} HeartbeatResponseMessage;

// ---- Symbol Index Mapping Request Message: 17 bytes --------------------------

// This message is sent by clients via TCP/IP requesting the Symbol Index Mapping messages for one or all symbols in a specified channel.
entrypoint typedef struct _SymbolIndexMappingRequestMessage {
  UINT32 symbol_index;      // bytes 0 to 3
  UINT8 source_id[10];      // bytes 4 to 13
  UINT8 product_id;         // byte 14
  UINT8 channel_id;         // byte 15
  UINT8 retransmit_method;  // byte 16
} SymbolIndexMappingRequestMessage;

// ---- Refresh Request Message: 16 bytes ---------------------------------------

// Clients who have experienced a failure and need a refresh of the state of one or all symbols in a specific channel should send a Retransmission Request message via TCP to the Request Controller. A Request Response message will be sent over the TCP connection back to the client, and if the request was valid, the requested message(s) will be published over the relevant Refresh multicast channel.
entrypoint typedef struct _RefreshRequestMessage {
  UINT32 symbol_index;  // bytes 0 to 3
  UINT8 source_id[10];  // bytes 4 to 13
  UINT8 product_id;     // byte 14
  UINT8 channel_id;     // byte 15
} RefreshRequestMessage;

// ---- Message Unavailable Message: 10 bytes -----------------------------------

// This message will be sent over the Retransmission multicast channels to inform clients of unavailability of a range of messages (or part of a range) for which they may have requested a retransmission.
entrypoint typedef struct _MessageUnavailableMessage {
  UINT32 begin_seq_num;  // bytes 0 to 3
  UINT32 end_seq_num;    // bytes 4 to 7
  UINT8 product_id;      // byte 8
  UINT8 channel_id;      // byte 9
} MessageUnavailableMessage;

// ---- Symbol Clear Message: 16 bytes ------------------------------------------

// In case of a failure and recovery of a Matching Engine or an XDP Publisher, the publisher may send a full state refresh for every symbol affected. This kind of unrequested refresh is preceded by a Symbol Clear message. The client should react to receipt of a Symbol Clear message by clearing all state information for the specified symbol in anticipation of receiving a full state refresh.
entrypoint typedef struct _SymbolClearMessage {
  UINT32 source_time;          // bytes 0 to 3
  UINT32 source_time_ns;       // bytes 4 to 7
  UINT32 symbol_index;         // bytes 8 to 11
  UINT32 next_source_seq_num;  // bytes 12 to 15
} SymbolClearMessage;

// ---- Security Status Message: 42 bytes ---------------------------------------

// This message informs clients of changes in the status of a specific security, such as Trading Halts, Short Sale Restriction state changes, etc.
entrypoint typedef struct _SecurityStatusMessage {
  UINT32 source_time;                // bytes 0 to 3
  UINT32 source_time_ns;             // bytes 4 to 7
  UINT32 symbol_index;               // bytes 8 to 11
  UINT32 symbol_seq_num;             // bytes 12 to 15
  UINT8 security_status;             // byte 16
  UINT8 halt_condition;              // byte 17
  UINT8 reserved_4[4];               // bytes 18 to 21
  UINT32 price_1;                    // bytes 22 to 25
  UINT32 price_2;                    // bytes 26 to 29
  UINT8 ssr_triggering_exchange_id;  // byte 30
  UINT32 ssr_triggering_volume;      // bytes 31 to 34
  UINT32 time;                       // bytes 35 to 38
  UINT8 ssr_state;                   // byte 39
  UINT8 market_state;                // byte 40
  UINT8 session_state;               // byte 41
} SecurityStatusMessage;

// ---- Outright Series Index Mapping: 51 bytes ---------------------------------

// This message is published over the real-time data channels at system startup or in the context of a refresh sequence after a Matching Engine or PILLAR Publisher failover.
entrypoint typedef struct _OutrightSeriesIndexMapping {
  UINT32 series_index;           // bytes 0 to 3
  UINT8 series_type;             // byte 4
  UINT16 market_id;              // bytes 5 to 6
  UINT8 system_id;               // byte 7
  UINT8 option_symbol_root[6];   // bytes 8 to 13
  UINT8 underlying_symbol[11];   // bytes 14 to 24
  UINT32 underlying_index;       // bytes 25 to 28
  UINT8 price_scale_code;        // byte 29
  UINT16 contract_multiplier;    // bytes 30 to 31
  UINT8 maturity_date[6];        // bytes 32 to 37
  UINT8 put_or_call;             // byte 38
  UINT8 strike_price[10];        // bytes 39 to 48
  UINT8 closing_only_indicator;  // byte 49
  UINT8 reserved_1;              // byte 50
} OutrightSeriesIndexMapping;

// ---- Options Status Message: 19 bytes ----------------------------------------

// This message informs clients of changes in the status of a specific option outright series and complex series
entrypoint typedef struct _OptionsStatusMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT32 series_index;    // bytes 8 to 11
  UINT32 series_seq_num;  // bytes 12 to 15
  UINT8 series_status;    // byte 16
  UINT8 market_state;     // byte 17
  UINT8 halt_condition;   // byte 18
} OptionsStatusMessage;

// ---- Options Add Order Message: 36 bytes -------------------------------------

// An Options Add Order message is published when a new visible order has been received and added to the book.
entrypoint typedef struct _OptionsAddOrderMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 series_index;    // bytes 4 to 7
  UINT32 series_seq_num;  // bytes 8 to 11
  UINT64 order_id;        // bytes 12 to 19
  UINT32 price;           // bytes 20 to 23, signed, read here as unsigned
  UINT32 volume;          // bytes 24 to 27
  UINT8 side;             // byte 28
  UINT8 firm_id[5];       // bytes 29 to 33
  UINT8 reserved_1;       // byte 34
  UINT8 cust_indicator;   // byte 35
} OptionsAddOrderMessage;

// ---- Options Modify Order Message: 31 bytes ----------------------------------

// An Options Modify Order message is sent when the price or volume of an order is changed due to an event other than a cancel-replace, or full or partial execution.
entrypoint typedef struct _OptionsModifyOrderMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 series_index;    // bytes 4 to 7
  UINT32 series_seq_num;  // bytes 8 to 11
  UINT64 order_id;        // bytes 12 to 19
  UINT32 price;           // bytes 20 to 23, signed, read here as unsigned
  UINT32 volume;          // bytes 24 to 27
  UINT8 position_change;  // byte 28
  UINT8 side;             // byte 29
  UINT8 cust_indicator;   // byte 30
} OptionsModifyOrderMessage;

// ---- Options Delete Order Message: 21 bytes ----------------------------------

// An Options Modify Order message is sent when the price or volume of an order is changed due to an event other than a cancel-replace, or full or partial execution.
entrypoint typedef struct _OptionsDeleteOrderMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 series_index;    // bytes 4 to 7
  UINT32 series_seq_num;  // bytes 8 to 11
  UINT64 order_id;        // bytes 12 to 19
  UINT8 reserved_1;       // byte 20
} OptionsDeleteOrderMessage;

// ---- Options Order Execution Message: 17 bytes -------------------------------

// An Options Order Execution message is sent when an order is partially or fully executed.
entrypoint typedef struct _OptionsOrderExecutionMessage {
  UINT32 series_index;    // bytes 0 to 3
  UINT32 series_seq_num;  // bytes 4 to 7
  UINT64 order_id;        // bytes 8 to 15
  UINT8 reserved_1;       // byte 16
} OptionsOrderExecutionMessage;

// ---- Options Replace Order Message: 39 bytes ---------------------------------

// An Options Replace Order message is published when a cancel/replace order is received.
entrypoint typedef struct _OptionsReplaceOrderMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 series_index;    // bytes 4 to 7
  UINT32 series_seq_num;  // bytes 8 to 11
  UINT64 order_id;        // bytes 12 to 19
  UINT64 new_order_id;    // bytes 20 to 27
  UINT32 price;           // bytes 28 to 31, signed, read here as unsigned
  UINT32 volume;          // bytes 32 to 35
  UINT8 side;             // byte 36
  UINT8 reserved_1;       // byte 37
  UINT8 cust_indicator;   // byte 38
} OptionsReplaceOrderMessage;

// ---- Options Imbalance Message: 57 bytes -------------------------------------

// Options Imbalance messages are published once a second during opening and re-opening auctions to update price and volume information.
entrypoint typedef struct _OptionsImbalanceMessage {
  UINT32 source_time_ns;                   // bytes 0 to 3
  UINT32 series_index;                     // bytes 4 to 7
  UINT32 series_seq_num;                   // bytes 8 to 11
  UINT8 reserved_4[4];                     // bytes 12 to 15
  UINT32 paired_qty;                       // bytes 16 to 19
  UINT32 total_imbalance_qty;              // bytes 20 to 23
  UINT32 market_imbalance_qty;             // bytes 24 to 27
  UINT8 reserved_2[2];                     // bytes 28 to 29
  UINT8 auction_type;                      // byte 30
  UINT8 imbalance_side;                    // byte 31
  UINT32 continuous_book_clearing_price;   // bytes 32 to 35, signed, read here as unsigned
  UINT32 auction_interest_clearing_price;  // bytes 36 to 39, signed, read here as unsigned
  UINT8 second_reserved_4[4];              // bytes 40 to 43
  UINT32 indicative_match_price;           // bytes 44 to 47, signed, read here as unsigned
  UINT32 upper_collar;                     // bytes 48 to 51, signed, read here as unsigned
  UINT32 lower_collar;                     // bytes 52 to 55, signed, read here as unsigned
  UINT8 auction_status;                    // byte 56
} OptionsImbalanceMessage;

// ---- Options Add Order Refresh Message: 36 bytes -----------------------------

// See the Pillar Common Client Specification for details on Time Reference and Symbol/Series Index Mapping messages, and Order ID and Price field formats.
entrypoint typedef struct _OptionsAddOrderRefreshMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 series_index;    // bytes 4 to 7
  UINT32 series_seq_num;  // bytes 8 to 11
  UINT64 order_id;        // bytes 12 to 19
  UINT32 price;           // bytes 20 to 23, signed, read here as unsigned
  UINT32 volume;          // bytes 24 to 27
  UINT8 side;             // byte 28
  UINT8 firm_id[5];       // bytes 29 to 33
  UINT8 reserved_1;       // byte 34
  UINT8 cust_indicator;   // byte 35
} OptionsAddOrderRefreshMessage;

// ---- Options Series Rfq Message: 36 bytes ------------------------------------

// The Request for outright series RFQ data is published for outright series.
entrypoint typedef struct _OptionsSeriesRfqMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 series_index;    // bytes 4 to 7
  UINT32 series_seq_num;  // bytes 8 to 11
  UINT8 side;             // byte 12
  UINT8 type_;            // byte 13
  UINT8 capacity;         // byte 14
  UINT32 total_quantity;  // bytes 15 to 18
  UINT32 working_price;   // bytes 19 to 22, signed, read here as unsigned
  UINT32 participant;     // bytes 23 to 26
  UINT64 auction_id;      // bytes 27 to 34
  UINT8 rfq_status;       // byte 35
} OptionsSeriesRfqMessage;

// ---- Options Non Displayed Trade Message: 30 bytes ---------------------------

// An Options Non Displayed Trade message is published as a result of a match between two non-displayed orders.
entrypoint typedef struct _OptionsNonDisplayedTradeMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 series_index;    // bytes 4 to 7
  UINT32 series_seq_num;  // bytes 8 to 11
  UINT32 trade_id;        // bytes 12 to 15
  UINT32 price;           // bytes 16 to 19, signed, read here as unsigned
  UINT32 volume;          // bytes 20 to 23
  UINT8 printable_flag;   // byte 24
  UINT8 trade_cond_1;     // byte 25
  UINT8 reserved_3[3];    // bytes 26 to 28
  UINT8 price_type;       // byte 29
} OptionsNonDisplayedTradeMessage;

// ---- Options Cross Trade Message: 25 bytes -----------------------------------

// An Options Cross Trade message is published on completion of a crossing from the opening and re-opening auction, and shows the bulk volume that traded in the auction. The Cross Type field indicates the auction type. Additionally, a non-printable Order Execution or Non-Displayed Trade message will be published for each order that traded.
entrypoint typedef struct _OptionsCrossTradeMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 series_index;    // bytes 4 to 7
  UINT32 series_seq_num;  // bytes 8 to 11
  UINT32 cross_id;        // bytes 12 to 15
  UINT32 price;           // bytes 16 to 19, signed, read here as unsigned
  UINT32 volume;          // bytes 20 to 23
  UINT8 cross_type;       // byte 24
} OptionsCrossTradeMessage;

// ---- Options Trade Cancel Message: 16 bytes ----------------------------------

// In the event that an earlier trade has been reported in error, an Options Trade Cancel message is published.
entrypoint typedef struct _OptionsTradeCancelMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 series_index;    // bytes 4 to 7
  UINT32 series_seq_num;  // bytes 8 to 11
  UINT32 trade_id;        // bytes 12 to 15
} OptionsTradeCancelMessage;

// ---- Options Outright Series Summary Message: 28 bytes -----------------------

// The outright series summary message is published every 60 seconds, on a separate multicast channel from the main feed.
entrypoint typedef struct _OptionsOutrightSeriesSummaryMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 series_index;    // bytes 4 to 7
  UINT32 high_price;      // bytes 8 to 11, signed, read here as unsigned
  UINT32 low_price;       // bytes 12 to 15, signed, read here as unsigned
  UINT32 open_;           // bytes 16 to 19, signed, read here as unsigned
  UINT32 close;           // bytes 20 to 23, signed, read here as unsigned
  UINT32 total_volume;    // bytes 24 to 27
} OptionsOutrightSeriesSummaryMessage;

