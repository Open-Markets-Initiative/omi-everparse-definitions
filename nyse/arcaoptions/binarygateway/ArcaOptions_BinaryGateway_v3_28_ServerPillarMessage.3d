// Ack Type: one byte code
#define ACK_TYPE_NEW_INTEREST 0x01                          // New Interest
#define ACK_TYPE_ORDER_PRIORITY_UPDATE_NEW_ORDER_ID 0x02    // Order Priority Update New Order Id
#define ACK_TYPE_ORDER_PRIORITY_UPDATE_SAME_ORDER_ID 0x03   // Order Priority Update Same Order Id
#define ACK_TYPE_BULK_CANCEL_ACK 0x04                       // Bulk Cancel Ack
#define ACK_TYPE_PENDING_CANCEL 0x05                        // Pending Cancel
#define ACK_TYPE_PENDING_REPLACE 0x06                       // Pending Replace
#define ACK_TYPE_PENDING_MODIFY 0x07                        // Pending Modify
#define ACK_TYPE_REPLACED 0x08                              // Replaced
#define ACK_TYPE_MODIFIED 0x09                              // Modified
#define ACK_TYPE_CANCELED 0x0B                              // Canceled
#define ACK_TYPE_DONE_FOR_DAY 0x0C                          // Done For Day
#define ACK_TYPE_GTC_RENEWAL_OR_RESTATEMENT 0x11            // Gtc Renewal Or Restatement
#define ACK_TYPE_INDIVIDUAL_MARKET_MAKER_QUOTE_REJECT 0x12  // Individual Market Maker Quote Reject

// Leg Open Close: 8 byte code
#define LEG_OPEN_CLOSE_OPEN 0x0000000000000000   // Open
#define LEG_OPEN_CLOSE_CLOSE 0x0000000000000001  // Close

// Self Trade Type: one byte code
#define SELF_TRADE_TYPE_USE_SESSION_CONFIGURATION 0x00  // Use Session Configuration
#define SELF_TRADE_TYPE_NO_SELF_TRADE_PREVENTION 0x01   // No Self Trade Prevention
#define SELF_TRADE_TYPE_CANCEL_NEWEST 0x02              // Cancel Newest
#define SELF_TRADE_TYPE_CANCEL_OLDEST 0x03              // Cancel Oldest
#define SELF_TRADE_TYPE_CANCEL_BOTH 0x04                // Cancel Both

// Side: one byte code
#define SIDE_NO_CHANGE_IN_SIDE 0x00  // No Change In Side
#define SIDE_BUY 0x01                // Buy
#define SIDE_SELL 0x02               // Sell

// Locate Reqd: one byte code
#define LOCATE_REQD_NO_LOCATE_REQD 0x00  // No Locate Reqd

// Bulk Action: one byte code
#define BULK_ACTION_NOT_APPLICABLE 0x00             // Not Applicable
#define BULK_ACTION_CANCEL_SINGLE_LEG_ONLY 0x01     // Cancel Single Leg Only
#define BULK_ACTION_CANCEL_COMPLEX_ONLY 0x02        // Cancel Complex Only
#define BULK_ACTION_CANCEL_SINGLE_AND_COMPLEX 0x03  // Cancel Single And Complex
#define BULK_ACTION_BLOCK_AND_CANCEL 0x04           // Block And Cancel
#define BULK_ACTION_UNBLOCK 0x05                    // Unblock

// Cancel Scope: one byte code
#define CANCEL_SCOPE_ORDERS_ONLY 0x00        // Orders Only
#define CANCEL_SCOPE_QUOTES_ONLY 0x01        // Quotes Only
#define CANCEL_SCOPE_ORDERS_AND_QUOTES 0x02  // Orders And Quotes

// Multileg Reporting Type: one byte code
#define MULTILEG_REPORTING_TYPE_SINGLE_LEG_SECURITY 0x01                   // Single Leg Security
#define MULTILEG_REPORTING_TYPE_INDIVIDUAL_LEG_OF_MULTI_LEG_SECURITY 0x02  // Individual Leg Of Multi Leg Security
#define MULTILEG_REPORTING_TYPE_MULTI_LEG_SECURITY 0x03                    // Multi Leg Security

// Participant Type: one byte code
#define PARTICIPANT_TYPE_NOT_APPLICABLE 0x00  // Not Applicable

// Contra Open Close: one byte code
#define CONTRA_OPEN_CLOSE_NOT_APPLICABLE 0x00  // Not Applicable
#define CONTRA_OPEN_CLOSE_OPEN 0x01            // Open
#define CONTRA_OPEN_CLOSE_CLOSE 0x02           // Close

// Contra Customer Or Firm: one byte code
#define CONTRA_CUSTOMER_OR_FIRM_NOT_APPLICABLE 0x00     // Not Applicable
#define CONTRA_CUSTOMER_OR_FIRM_CUSTOMER 0x01           // Customer
#define CONTRA_CUSTOMER_OR_FIRM_FIRM 0x02               // Firm
#define CONTRA_CUSTOMER_OR_FIRM_BROKER 0x03             // Broker
#define CONTRA_CUSTOMER_OR_FIRM_MARKET_MAKER 0x04       // Market Maker
#define CONTRA_CUSTOMER_OR_FIRM_AWAY_MARKET_MAKER 0x05  // Away Market Maker
#define CONTRA_CUSTOMER_OR_FIRM_PROF_CUSTOMER 0x06      // Prof Customer

// Contra Cross Type: 2 byte code
#define CONTRA_CROSS_TYPE_NOT_APPLICABLE 0x0000              // Not Applicable
#define CONTRA_CROSS_TYPE_QCC 0x000A                         // Qcc
#define CONTRA_CROSS_TYPE_CUSTOMER_TO_CUSTOMER_CROSS 0x000B  // Customer To Customer Cross

// Contra Covered Or Uncovered: one byte code
#define CONTRA_COVERED_OR_UNCOVERED_NOT_APPLICABLE 0x00  // Not Applicable
#define CONTRA_COVERED_OR_UNCOVERED_EXPOSED 0x01         // Exposed
#define CONTRA_COVERED_OR_UNCOVERED_COVERED 0x02         // Covered

// Covered Or Uncovered: one byte code
#define COVERED_OR_UNCOVERED_NOT_APPLICABLE 0x00  // Not Applicable
#define COVERED_OR_UNCOVERED_EXPOSED 0x01         // Exposed
#define COVERED_OR_UNCOVERED_COVERED 0x02         // Covered

// Open Close: one byte code
#define OPEN_CLOSE_NOT_APPLICABLE 0x00  // Not Applicable
#define OPEN_CLOSE_OPEN 0x01            // Open
#define OPEN_CLOSE_CLOSE 0x02           // Close

// Bust Correct Indicator: one byte code
#define BUST_CORRECT_INDICATOR_TRADE_BUST 0x00        // Trade Bust
#define BUST_CORRECT_INDICATOR_TRADE_CORRECTION 0x01  // Trade Correction

// Reject Type: one byte code
#define REJECT_TYPE_ORDER_OR_CANCEL_REPLACE_REJECT 0x01      // Order Or Cancel Replace Reject
#define REJECT_TYPE_MODIFY_REQUEST_REJECT 0x02               // Modify Request Reject
#define REJECT_TYPE_CANCEL_REQUEST_REJECT 0x03               // Cancel Request Reject
#define REJECT_TYPE_NEW_BULK_QUOTE_REJECT 0x05               // New Bulk Quote Reject
#define REJECT_TYPE_RISK_LIMIT_UPDATE_REQUEST_REJECT 0x07    // Risk Limit Update Request Reject
#define REJECT_TYPE_BULK_CANCEL_REQUEST_REJECT_OPTIONS 0x08  // Bulk Cancel Request Reject Options
#define REJECT_TYPE_CROSS_ORDER_REJECT 0x09                  // Cross Order Reject
#define REJECT_TYPE_NEW_COMPLEX_SERIES_REQUEST_REJECT 0x0A   // New Complex Series Request Reject
#define REJECT_TYPE_RISK_ACTION_REQUEST_REJECT 0x0B          // Risk Action Request Reject

// Risk User Type: one byte code
#define RISK_USER_TYPE_ENTERING_FIRM 0x45              // Entering Firm
#define RISK_USER_TYPE_CLEARING_FIRM 0x43              // Clearing Firm
#define RISK_USER_TYPE_OPTIONS_MARKET_MAKER_FIRM 0x4F  // Options Market Maker Firm

// Risk Control Type: one byte code
#define RISK_CONTROL_TYPE_NOT_APPLICABLE 0x00                                   // Not Applicable
#define RISK_CONTROL_TYPE_SINGLE_ORDER_MAX_QTY 0x01                             // Single Order Max Qty
#define RISK_CONTROL_TYPE_SINGLE_ORDER_MAX_NOTIONAL 0x02                        // Single Order Max Notional
#define RISK_CONTROL_TYPE_GROSS_CREDIT_EXECUTED 0x03                            // Gross Credit Executed
#define RISK_CONTROL_TYPE_GROSS_CREDIT_OPEN 0x04                                // Gross Credit Open
#define RISK_CONTROL_TYPE_GROSS_CREDIT_OPEN_AND_EXECUTED 0x05                   // Gross Credit Open And Executed
#define RISK_CONTROL_TYPE_MAXIMUM_DUPLICATIVE_ORDERS 0x06                       // Maximum Duplicative Orders
#define RISK_CONTROL_TYPE_ACTIVITY_ROLLING_TRANSACTION 0x08                     // Activity Rolling Transaction
#define RISK_CONTROL_TYPE_ACTIVITY_ROLLING_VOLUME 0x09                          // Activity Rolling Volume
#define RISK_CONTROL_TYPE_ACTIVITY_ROLLING_PERCENTAGE 0x0A                      // Activity Rolling Percentage
#define RISK_CONTROL_TYPE_GLOBAL_RISK_MITIGATION_PROTECTION 0x0B                // Global Risk Mitigation Protection
#define RISK_CONTROL_TYPE_REJECT_MARKET_ORDERS 0x0D                             // Reject Market Orders
#define RISK_CONTROL_TYPE_REJECT_MOO_AND_MOC 0x0E                               // Reject Moo And Moc
#define RISK_CONTROL_TYPE_REJECT_RESTRICTED_SYMBOL 0x13                         // Reject Restricted Symbol
#define RISK_CONTROL_TYPE_LIMIT_ORDER_PRICE_PROTECTION_OPTIONS_SINGLE_LEG 0x1A  // Limit Order Price Protection Options Single Leg
#define RISK_CONTROL_TYPE_LIMIT_ORDER_PRICE_PROTECTION_OPTIONS_COMPLEX 0x1B     // Limit Order Price Protection Options Complex
#define RISK_CONTROL_TYPE_ORDER_RATE_THRESHOLD 0x1D                             // Order Rate Threshold
#define RISK_CONTROL_TYPE_REJECT_ISOIOC 0x1E                                    // Reject Isoioc
#define RISK_CONTROL_TYPE_REJECT_ISO_DAY 0x1F                                   // Reject Iso Day

// Risk Control Activation: one byte code
#define RISK_CONTROL_ACTIVATION_OFF 0x00  // Off
#define RISK_CONTROL_ACTIVATION_ON 0x01   // On

// Risk Action Type: one byte code
#define RISK_ACTION_TYPE_NOT_APPLICABLE 0x00                         // Not Applicable
#define RISK_ACTION_TYPE_QUERY 0x01                                  // Query
#define RISK_ACTION_TYPE_KILL_SWITCH_BLOCK 0x02                      // Kill Switch Block
#define RISK_ACTION_TYPE_KILL_SWITCH_UNBLOCK 0x03                    // Kill Switch Unblock
#define RISK_ACTION_TYPE_KILL_SWITCH_CANCEL_AUCTION_ORDERS 0x04      // Kill Switch Cancel Auction Orders
#define RISK_ACTION_TYPE_KILL_SWITCH_CANCEL_NON_AUCTION_ORDERS 0x05  // Kill Switch Cancel Non Auction Orders
#define RISK_ACTION_TYPE_KILL_SWITCH_CANCEL_GTC_ORDERS 0x06          // Kill Switch Cancel Gtc Orders
#define RISK_ACTION_TYPE_APPROVE_REINSTATEMENT 0x07                  // Approve Reinstatement
#define RISK_ACTION_TYPE_RISK_ENTITY_REINSTATED 0x08                 // Risk Entity Reinstated

// Breach Action Response: one byte code
#define BREACH_ACTION_RESPONSE_NOT_APPLICABLE 0x00                       // Not Applicable
#define BREACH_ACTION_RESPONSE_NOTIFICATIONS_ONLY 0x01                   // Notifications Only
#define BREACH_ACTION_RESPONSE_CANCEL_NON_AUCTION_ORDERS_AND_BLOCK 0x02  // Cancel Non Auction Orders And Block
#define BREACH_ACTION_RESPONSE_BLOCK 0x03                                // Block

// Ioc Attribution: one byte code
#define IOC_ATTRIBUTION_NOT_APPLICABLE 0x00  // Not Applicable
#define IOC_ATTRIBUTION_INCLUDE_IOC 0x01     // Include Ioc
#define IOC_ATTRIBUTION_EXCLUDE_IOC 0x02     // Exclude Ioc

// Blocked By Breach Indicator: one byte code
#define BLOCKED_BY_BREACH_INDICATOR_NOT_BLOCKED_BY_BREACH 0x00             // Not Blocked By Breach
#define BLOCKED_BY_BREACH_INDICATOR_BLOCKED_BY_BREACH 0x01                 // Blocked By Breach
#define BLOCKED_BY_BREACH_INDICATOR_BLOCKED_BY_ARBITRAGE_CHECK 0x02        // Blocked By Arbitrage Check
#define BLOCKED_BY_BREACH_INDICATOR_BLOCKED_BY_INTRINSIC_VALUE_CHECK 0x03  // Blocked By Intrinsic Value Check

// Blocked By Kill Switch Indicator: one byte code
#define BLOCKED_BY_KILL_SWITCH_INDICATOR_NOT_BLOCKED_BY_KILL_SWITCH 0x00  // Not Blocked By Kill Switch
#define BLOCKED_BY_KILL_SWITCH_INDICATOR_BLOCKED_BY_KILL_SWITCH 0x01      // Blocked By Kill Switch

// Reinstatement Required By Self: one byte code
#define REINSTATEMENT_REQUIRED_BY_SELF_NOT_REQUIRED 0x00  // Not Required
#define REINSTATEMENT_REQUIRED_BY_SELF_REQUIRED 0x01      // Required

// Reinstatement Required By Other: one byte code
#define REINSTATEMENT_REQUIRED_BY_OTHER_NOT_REQUIRED 0x00  // Not Required
#define REINSTATEMENT_REQUIRED_BY_OTHER_REQUIRED 0x01      // Required

// Price Scale: one byte code
#define PRICE_SCALE_NO_DECIMALS 0x00   // No Decimals
#define PRICE_SCALE_TWO_DECIMALS 0x02  // Two Decimals

// Threshold Breach Level: one byte code
#define THRESHOLD_BREACH_LEVEL_NOT_APPLICABLE 0x00            // Not Applicable
#define THRESHOLD_BREACH_LEVEL_GREATER_THAN_100_PERCENT 0x04  // Greater Than 100 Percent

// Leg Side: one byte code
#define LEG_SIDE_BUY 0x01   // Buy
#define LEG_SIDE_SELL 0x02  // Sell

// ---- Types -------------------------------------------------------------------

// Pillar Stream Login Response Message Branch
typedef struct _LoginResponse {
  UINT8 username[16];  // bytes 0 to 15
  UINT8 status;        // byte 16
} LoginResponse;

// Pillar Stream Protocol Stream Identifier
typedef struct _StreamId {
  UINT32 sess;   // bytes 0 to 3
  UINT32 value;  // bytes 4 to 7
} StreamId;

// The message contains stream ID and sequence of next message on stream
typedef struct _StreamAvail {
  StreamId stream_id;  // bytes 0 to 7
  UINT64 next_seq;     // bytes 8 to 15
  UINT8 access;        // byte 16
} StreamAvail;

// Heartbeat must be sent once a second
typedef struct _Heartbeat {
  unit empty;
} Heartbeat;

// Response to Open
typedef struct _OpenResponse {
  StreamId stream_id;  // bytes 0 to 7
  UINT8 status;        // byte 8
  UINT8 access;        // byte 9
} OpenResponse;

// Response to Close Message
typedef struct _CloseResponse {
  StreamId stream_id;  // bytes 0 to 7
  UINT8 status;        // byte 8
} CloseResponse;

// Pillar Stream Sequenced Message Identifier
typedef struct _SeqMsgId {
  StreamId stream_id;  // bytes 0 to 7
  UINT64 seq;          // bytes 8 to 15
} SeqMsgId;

// Publishes reference data for each underlying symbol configured for trading
typedef struct _UnderlyingSymbolReferenceDataMessage {
  UINT64 transact_time;          // bytes 0 to 7
  UINT32 symbol_id;              // bytes 8 to 11
  UINT8 nyse_symbol[24];         // bytes 12 to 35
  UINT8 listed_mic[4];           // bytes 36 to 39
  UINT8 underlying_type;         // byte 40
  UINT64 max_order_price;        // bytes 41 to 48, signed, read here as unsigned
  UINT16 mpv_class_id;           // bytes 49 to 50
  UINT8 test_symbol_indicator;   // byte 51
  UINT8 channel_id;              // byte 52
  UINT8 legal_width_multiplier;  // byte 53
} UnderlyingSymbolReferenceDataMessage;

// Publishes reference data for each options series, including series index and symbology required for order entry
typedef struct _SeriesReferenceDataMessage {
  UINT64 transact_time;          // bytes 0 to 7
  UINT32 series_index;           // bytes 8 to 11
  UINT32 symbol_id;              // bytes 12 to 15
  UINT8 occ_symbol_root[24];     // bytes 16 to 39
  UINT8 put_or_call;             // byte 40
  UINT64 strike_price;           // bytes 41 to 48
  UINT8 maturity_date[8];        // bytes 49 to 56
  UINT32 contract_multiplier;    // bytes 57 to 60
  UINT8 series_type;             // byte 61
  UINT8 closing_only_indicator;  // byte 62
} SeriesReferenceDataMessage;

// Defines a minimum price variant class and its identifying attributes
typedef struct _MinimumPriceVariantClassReferenceDataMessage {
  UINT64 transact_time;      // bytes 0 to 7
  UINT8 mpv_class_name[20];  // bytes 8 to 27
  UINT16 mpv_class_id;       // bytes 28 to 29
  UINT64 rpimpv;             // bytes 30 to 37
  UINT64 luldmpv;            // bytes 38 to 45
} MinimumPriceVariantClassReferenceDataMessage;

// Defines a single minimum price variant level within an MPV class
typedef struct _MpvLevelDefinition {
  UINT8 mpv_level_name[24];        // bytes 0 to 23
  UINT64 order_entry_limit_price;  // bytes 24 to 31
  UINT64 quoting_mpv;              // bytes 32 to 39
  UINT64 trading_mpv;              // bytes 40 to 47
  UINT16 mpv_class_id;             // bytes 48 to 49
} MpvLevelDefinition;

// Defines one or more minimum price variant levels within a single MPV class
typedef struct _MinimumPriceVariantLevelReferenceDataMessage (UINT32 available) where (available >= 8) {
  UINT64 transact_time;                                                 // bytes 0 to 7
  MpvLevelDefinition mpv_level_definition[:byte-size (available - 8)];
} MinimumPriceVariantLevelReferenceDataMessage;

// Publishes the current configuration and status of each MPID configured on a gateway session
typedef struct _MpidConfigurationMessage {
  UINT64 transact_time;   // bytes 0 to 7
  UINT8 mpid_status;      // byte 8
  UINT8 mpid[4];          // bytes 9 to 12
  UINT8 username[16];     // bytes 13 to 28
  UINT8 reserved_50[50];  // bytes 29 to 78
} MpidConfigurationMessage;

// Publishes appointment information for market makers for each appointed underlying symbol
typedef struct _OptionsMarketMakerSymbolAppointmentReferenceDataMessage {
  UINT64 transact_time;      // bytes 0 to 7
  UINT32 symbol_id;          // bytes 8 to 11
  UINT8 nyse_symbol[24];     // bytes 12 to 35
  UINT8 market_maker[10];    // bytes 36 to 45
  UINT8 mpid[4];             // bytes 46 to 49
  UINT8 mm_type;             // byte 50
  UINT8 appointment_status;  // byte 51
  UINT8 reserved_50[50];     // bytes 52 to 101
} OptionsMarketMakerSymbolAppointmentReferenceDataMessage;

// Provides the current configured session settings and acknowledgement status for a session configuration request
typedef struct _SessionConfigurationAcknowledgementMessage {
  UINT64 transact_time;                          // bytes 0 to 7
  UINT8 user_session_type;                       // byte 8
  UINT8 user_session_status;                     // byte 9
  UINT8 username[16];                            // bytes 10 to 25
  UINT8 mic[4];                                  // bytes 26 to 29
  UINT8 cancel_on_disconnect;                    // byte 30
  UINT8 throttle_preference;                     // byte 31
  UINT16 throttle_window;                        // bytes 32 to 33
  UINT16 throttle_threshold;                     // bytes 34 to 35
  UINT8 symbol_eligibility;                      // byte 36
  UINT32 max_order_quantity;                     // bytes 37 to 40
  UINT8 self_trade_prevention;                   // byte 41
  UINT8 order_priority_update_ack_subscription;  // byte 42
  UINT8 ack_status;                              // byte 43
  UINT8 bold_designation;                        // byte 44
  UINT8 reserved_49[49];                         // bytes 45 to 93
} SessionConfigurationAcknowledgementMessage;

// Pillar Stream Sub Message Item Header
typedef struct _SubMsgHeader {
  UINT16 sub_msg_type;    // bytes 0 to 1
  UINT16 sub_msg_length;  // bytes 2 to 3
} SubMsgHeader;

// OptionalOrderAddOn
typedef struct _OptionalOrderAddOn {
  SubMsgHeader sub_msg_header;  // bytes 0 to 3
  UINT64 stop_px;               // bytes 4 to 11, signed, read here as unsigned
  UINT32 max_floor;             // bytes 12 to 15
  UINT8 deliver_to_comp_id[5];  // bytes 16 to 20
  UINT8 clearing_firm[5];       // bytes 21 to 25
  UINT8 optional_data[16];      // bytes 26 to 41
  UINT8 clearing_account[5];    // bytes 42 to 46
} OptionalOrderAddOn;

// OptionalOrderAddOn
casetype _OptionalOptionalOrderAddOn (Bool present) {
  switch (present) {
    case true: OptionalOrderAddOn optional_order_add_on;
    case false: unit absent;
  }
} OptionalOptionalOrderAddOn;

// Order and Cancel/Replace Acknowledgement Message
typedef struct _OrderAndCancelReplaceAcknowledgementMessage (UINT16 seq_msg_length) {
  UINT32 symbol_id;                                                              // bytes 0 to 3
  UINT8 mpid[4];                                                                 // bytes 4 to 7
  UINT8 market_maker[10];                                                        // bytes 8 to 17
  UINT8 mp_sub_id[4];                                                            // bytes 18 to 21
  UINT64 cl_ord_id;                                                              // bytes 22 to 29
  UINT64 orig_cl_ord_id;                                                         // bytes 30 to 37
  UINT8 bitfield_order_instructions[16];                                         // bytes 38 to 53
  UINT64 price;                                                                  // bytes 54 to 61, signed, read here as unsigned
  UINT32 order_qty;                                                              // bytes 62 to 65
  UINT32 min_qty;                                                                // bytes 66 to 69
  UINT8 user_data[10];                                                           // bytes 70 to 79
  UINT64 transact_time;                                                          // bytes 80 to 87
  UINT64 order_id;                                                               // bytes 88 to 95
  UINT32 leaves_qty;                                                             // bytes 96 to 99
  UINT64 working_price;                                                          // bytes 100 to 107, signed, read here as unsigned
  UINT8 working_away_from_display;                                               // byte 108
  UINT8 pre_liquidity_indicator[4];                                              // bytes 109 to 112
  UINT16 reason_code;                                                            // bytes 113 to 114
  UINT8 ack_type;                                                                // byte 115
  UINT8 throttled : 1;                                                           // byte 116
  UINT8 unused_7 : 7;                                                            // byte 116
  UINT64 leg_open_close;                                                         // bytes 117 to 124
  UINT64 auction_id;                                                             // bytes 125 to 132
  OptionalOptionalOrderAddOn((seq_msg_length == 0x00B8)) optional_order_add_on;
} OrderAndCancelReplaceAcknowledgementMessage;

// Quote acknowledgment structure for Bulk Quote acknowledgments
typedef struct _QuoteAckGroup {
  UINT32 series_index;              // bytes 0 to 3
  UINT8 side;                       // byte 4
  UINT8 ack_type;                   // byte 5
  UINT64 price;                     // bytes 6 to 13, signed, read here as unsigned
  UINT32 quantity;                  // bytes 14 to 17
  UINT16 reason_code;               // bytes 18 to 19
  UINT8 working_away_from_display;  // byte 20
} QuoteAckGroup;

// Bulk Quote Acknowledgment Message
typedef struct _BulkQuoteAcknowledgmentMessage {
  UINT64 transact_time;                                                          // bytes 0 to 7
  UINT8 mpid[4];                                                                 // bytes 8 to 11
  UINT8 market_maker[10];                                                        // bytes 12 to 21
  UINT8 sub_id[4];                                                               // bytes 22 to 25
  UINT64 cl_ord_id;                                                              // bytes 26 to 33
  UINT8 throttled : 1;                                                           // byte 34
  UINT8 unused_7 : 7;                                                            // byte 34
  UINT8 self_trade_type;                                                         // byte 35
  UINT32 group_id;                                                               // bytes 36 to 39
  UINT8 repeating_groups;                                                        // byte 40
  QuoteAckGroup quote_ack_group[:byte-size (((UINT32) repeating_groups) * 21)];
} BulkQuoteAcknowledgmentMessage;

// Quote acknowledgment structure including OrderID for Bulk Quote acknowledgments
typedef struct _QuoteAckWithIdGroup {
  UINT32 series_index;              // bytes 0 to 3
  UINT8 side;                       // byte 4
  UINT8 ack_type;                   // byte 5
  UINT64 price;                     // bytes 6 to 13, signed, read here as unsigned
  UINT32 quantity;                  // bytes 14 to 17
  UINT16 reason_code;               // bytes 18 to 19
  UINT8 working_away_from_display;  // byte 20
  UINT64 order_id;                  // bytes 21 to 28
} QuoteAckWithIdGroup;

// Bulk Quote Acknowledgment Message
typedef struct _BulkQuoteAcknowledgmentWithDetailsMessage {
  UINT64 transact_time;                                                                        // bytes 0 to 7
  UINT8 mpid[4];                                                                               // bytes 8 to 11
  UINT8 market_maker[10];                                                                      // bytes 12 to 21
  UINT8 sub_id[4];                                                                             // bytes 22 to 25
  UINT64 cl_ord_id;                                                                            // bytes 26 to 33
  UINT8 throttled : 1;                                                                         // byte 34
  UINT8 unused_7 : 7;                                                                          // byte 34
  UINT8 self_trade_type;                                                                       // byte 35
  UINT32 group_id;                                                                             // bytes 36 to 39
  UINT8 repeating_groups;                                                                      // byte 40
  QuoteAckWithIdGroup quote_ack_with_id_group[:byte-size (((UINT32) repeating_groups) * 29)];
} BulkQuoteAcknowledgmentWithDetailsMessage;

// Order Single/Complex Modify/Cancel Request Acknowledgment and UROUT Message
typedef struct _OrderSingleComplexModifyCancelRequestAcknowledgmentAndUro_in8liw {
  UINT64 transact_time;              // bytes 0 to 7
  UINT32 symbol_id;                  // bytes 8 to 11
  UINT8 mpid[4];                     // bytes 12 to 15
  UINT64 order_id;                   // bytes 16 to 23
  UINT64 ref_cl_ord_id;              // bytes 24 to 31
  UINT64 orig_cl_ord_id;             // bytes 32 to 39
  UINT64 price;                      // bytes 40 to 47, signed, read here as unsigned
  UINT32 order_qty;                  // bytes 48 to 51
  UINT32 leaves_qty;                 // bytes 52 to 55
  UINT8 side;                        // byte 56
  UINT8 locate_reqd;                 // byte 57
  UINT16 reason_code;                // bytes 58 to 59
  UINT8 ack_type;                    // byte 60
  UINT8 throttled : 1;               // byte 61
  UINT8 unused_7 : 7;                // byte 61
  UINT8 user_data[10];               // bytes 62 to 71
  UINT32 group_id;                   // bytes 72 to 75
  UINT8 market_maker[10];            // bytes 76 to 85
  UINT8 target_cancel_username[16];  // bytes 86 to 101
  UINT8 target_cancel_mpid[4];       // bytes 102 to 105
  UINT8 bulk_action;                 // byte 106
  UINT8 cancel_scope;                // byte 107
} OrderSingleComplexModifyCancelRequestAcknowledgmentAndUro_in8liw;

// Order Priority Update Acknowledgment Message
typedef struct _OrderPriorityUpdateAcknowledgmentMessage {
  UINT64 transact_time;              // bytes 0 to 7
  UINT32 symbol_id;                  // bytes 8 to 11
  UINT8 mpid[4];                     // bytes 12 to 15
  UINT64 order_id;                   // bytes 16 to 23
  UINT64 cl_ord_id;                  // bytes 24 to 31
  UINT64 working_price;              // bytes 32 to 39, signed, read here as unsigned
  UINT32 order_qty;                  // bytes 40 to 43
  UINT8 working_away_from_display;   // byte 44
  UINT8 pre_liquidity_indicator[4];  // bytes 45 to 48
  UINT8 ack_type;                    // byte 49
  UINT8 user_data[10];               // bytes 50 to 59
} OrderPriorityUpdateAcknowledgmentMessage;

// Execution Report Message
typedef struct _ExecutionReportMessage (UINT16 seq_msg_length) {
  UINT64 transact_time;                                                          // bytes 0 to 7
  UINT32 symbol_id;                                                              // bytes 8 to 11
  UINT8 mpid[4];                                                                 // bytes 12 to 15
  UINT64 order_id;                                                               // bytes 16 to 23
  UINT64 cl_ord_id;                                                              // bytes 24 to 31
  UINT64 deal_id;                                                                // bytes 32 to 39
  UINT64 last_px;                                                                // bytes 40 to 47, signed, read here as unsigned
  UINT32 leaves_qty;                                                             // bytes 48 to 51
  UINT32 cum_qty;                                                                // bytes 52 to 55
  UINT32 last_qty;                                                               // bytes 56 to 59
  UINT8 liquidity_indicator[4];                                                  // bytes 60 to 63
  UINT8 multileg_reporting_type;                                                 // byte 64
  UINT8 reserved_1;                                                              // byte 65
  UINT8 reserved_2[2];                                                           // bytes 66 to 67
  UINT8 locate_reqd;                                                             // byte 68
  UINT8 participant_type;                                                        // byte 69
  UINT16 reason_code;                                                            // bytes 70 to 71
  UINT8 user_data[10];                                                           // bytes 72 to 81
  UINT8 side;                                                                    // byte 82
  UINT8 market_maker[10];                                                        // bytes 83 to 92
  UINT8 contra_market_maker[10];                                                 // bytes 93 to 102
  UINT8 contra_clearing_firm[5];                                                 // bytes 103 to 107
  UINT8 contra_mpid[4];                                                          // bytes 108 to 111
  UINT8 contra_open_close;                                                       // byte 112
  UINT8 contra_customer_or_firm;                                                 // byte 113
  UINT8 contra_clearing_account[5];                                              // bytes 114 to 118
  UINT16 contra_cross_type;                                                      // bytes 119 to 120
  UINT8 contra_covered_or_uncovered;                                             // byte 121
  UINT8 covered_or_uncovered;                                                    // byte 122
  UINT64 cross_id;                                                               // bytes 123 to 130
  UINT8 open_close;                                                              // byte 131
  OptionalOptionalOrderAddOn((seq_msg_length == 0x00B7)) optional_order_add_on;
} ExecutionReportMessage;

// Pillar reference sequenced message identifier
typedef struct _RefSeqMsgId {
  StreamId stream_id;  // bytes 0 to 7
  UINT64 seq;          // bytes 8 to 15
} RefSeqMsgId;

// Trade Bust/Correct Message
typedef struct _TradeBustCorrectMessage {
  UINT64 transact_time;          // bytes 0 to 7
  UINT32 symbol_id;              // bytes 8 to 11
  UINT8 mpid[4];                 // bytes 12 to 15
  UINT64 order_id;               // bytes 16 to 23
  UINT64 cl_ord_id;              // bytes 24 to 31
  RefSeqMsgId ref_seq_msg_id;    // bytes 32 to 47
  UINT64 deal_id;                // bytes 48 to 55
  UINT64 last_px;                // bytes 56 to 63, signed, read here as unsigned
  UINT32 last_qty;               // bytes 64 to 67
  UINT16 reason_code;            // bytes 68 to 69
  UINT8 user_data[10];           // bytes 70 to 79
  UINT8 bust_correct_indicator;  // byte 80
} TradeBustCorrectMessage;

// Application Layer Reject Message
typedef struct _ApplicationLayerRejectMessage {
  UINT64 transact_time;  // bytes 0 to 7
  UINT32 symbol_id;      // bytes 8 to 11
  UINT8 mpid[4];         // bytes 12 to 15
  UINT64 cl_ord_id;      // bytes 16 to 23
  UINT16 reason_code;    // bytes 24 to 25
  UINT8 reject_type;     // byte 26
  UINT8 user_data[10];   // bytes 27 to 36
  UINT8 reserved_4[4];   // bytes 37 to 40
} ApplicationLayerRejectMessage;

// Risk Control Acknowledgement Message
typedef struct _RiskControlAcknowledgementMessage {
  UINT32 symbol_id;                        // bytes 0 to 3
  UINT8 mpid[4];                           // bytes 4 to 7
  UINT8 market_maker[10];                  // bytes 8 to 17
  UINT8 mp_sub_id[4];                      // bytes 18 to 21
  UINT8 reserved_4[4];                     // bytes 22 to 25
  UINT8 clearing_number[5];                // bytes 26 to 30
  UINT64 cl_ord_id;                        // bytes 31 to 38
  UINT8 risk_ack_type;                     // byte 39
  UINT32 risk_user_crd;                    // bytes 40 to 43
  UINT8 risk_user_type;                    // byte 44
  UINT8 risk_control_type;                 // byte 45
