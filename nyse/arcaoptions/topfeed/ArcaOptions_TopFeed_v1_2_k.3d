#define TRADE_COND_1_COMPLEX_ORDER_TO_COMPLEX_ORDER_FLOOR_TRADE 0x69                         // Complex Order To Complex Order Floor Trade
#define TRADE_COND_1_COMPLEX_ORDER_TRADING_ELECTRONICALLY_WITH_OUTRIGHT_SERIES 0x6A          // Complex Order Trading Electronically With Outright Series
#define TRADE_COND_1_COMPLEX_ORDER_TO_OUTRIGHT_SERIES_ORDER_FLOOR_TRADE 0x6D                 // Complex Order To Outright Series Order Floor Trade
#define TRADE_COND_1_COMPLEX_ORDER_WITH_STOCK_TO_COMPLEX_ORDER_WITH_STOCK_FLOOR_TRADE 0x70   // Complex Order With Stock To Complex Order With Stock Floor Trade
#define TRADE_COND_1_COMPLEX_ORDER_WITH_STOCK_TO_OUTRIGHT_SERIES_ORDER_FLOOR_TRADE 0x73      // Complex Order With Stock To Outright Series Order Floor Trade
#define TRADE_COND_1_EXTENDED_HOURS_TRADE 0x76                                               // Extended Hours Trade
#define TRADE_COND_1_LATE_REPORT_OF_OPENING_TRADE_CORRECT_SEQUENCE 0x48                      // Late Report Of Opening Trade Correct Sequence
#define TRADE_COND_1_LATE_REPORT_OF_OPENING_TRADE_OUT_OF_SEQUENCE 0x46                       // Late Report Of Opening Trade Out Of Sequence
#define TRADE_COND_1_TRANSACTION_REPORTED_LATE_CORRECT_SEQUENCE 0x44                         // Transaction Reported Late Correct Sequence
#define TRADE_COND_1_TRANSACTION_REPORTED_LATE_OUT_OF_SEQUENCE 0x42                          // Transaction Reported Late Out Of Sequence

// Trade Cond 2: one byte code
#define TRADE_COND_2_NA 0x20                           // Na
#define TRADE_COND_2_MARKET_CENTER_OPENING_TRADE 0x4F  // Market Center Opening Trade
#define TRADE_COND_2_REOPENING_TRADE 0x35              // Reopening Trade

// Trade Cond 4: one byte code
#define TRADE_COND_4_NA 0x20                   // Na
#define TRADE_COND_4_OFFICIAL_OPEN_PRICE 0x51  // Official Open Price

// Auction Type: one byte code
#define AUCTION_TYPE_EARLY_OPENING_AUCTION 0x4F          // Early Opening Auction
#define AUCTION_TYPE_CORE_OPENING_AUCTION 0x4D           // Core Opening Auction
#define AUCTION_TYPE_REOPENING_AUCTION_HALT_RESUME 0x48  // Reopening Auction Halt Resume

// Imbalance Side: one byte code
#define IMBALANCE_SIDE_BUY_SIDE 0x42      // Buy Side
#define IMBALANCE_SIDE_SELL_SIDE 0x53     // Sell Side
#define IMBALANCE_SIDE_NO_IMBALANCE 0x20  // No Imbalance

// Auction Status: one byte code
#define AUCTION_STATUS_WILL_RUN_AS_USUAL 0x00                                                // Will Run As Usual
#define AUCTION_STATUS_AUCTION_WILL_NOT_RUN_BECAUSE_LEGAL_WIDTH_QUOTE_DOES_NOT_EXIST 0x04    // Auction Will Not Run Because Legal Width Quote Does Not Exist
#define AUCTION_STATUS_AUCTION_WILL_NOT_RUN_BECAUSE_MARKET_MAKER_QUOTE_IS_NOT_RECEIVED 0x05  // Auction Will Not Run Because Market Maker Quote Is Not Received

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Type: one byte code
#define TYPE_BOLD_OUTRIGHT_ONLY 0x42           // Bold Outright Only
#define TYPE_COA_COMPLEX_ONLY 0x43             // Coa Complex Only
#define TYPE_FLEX_PRICE_IMPROVEMENT_CUBE 0x46  // Flex Price Improvement Cube
#define TYPE_FLEX_AON_SOLICITATION_CUBE 0x4C   // Flex Aon Solicitation Cube
#define TYPE_PRICE_IMPROVEMENT_CUBE 0x50       // Price Improvement Cube
#define TYPE_AON_SOLICITATION_CUBE 0x53        // Aon Solicitation Cube

