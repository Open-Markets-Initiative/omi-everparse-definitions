#define CAPACITY_NA 0x20                     // Na
#define CAPACITY_CUSTOMER 0x30               // Customer
#define CAPACITY_FIRM 0x31                   // Firm
#define CAPACITY_BROKER_DEALER 0x32          // Broker Dealer
#define CAPACITY_MARKET_MAKER 0x33           // Market Maker
#define CAPACITY_AWAY_MARKET_MAKER 0x35      // Away Market Maker
#define CAPACITY_PROFESSIONAL_CUSTOMER 0x38  // Professional Customer

// Rfq Status: one byte code
#define RFQ_STATUS_START_OF_RFQ_AUCTION 0x4F  // Start Of Rfq Auction
#define RFQ_STATUS_END_OF_RFQ_AUCTION 0x51    // End Of Rfq Auction

// ---- Types -------------------------------------------------------------------

// The time when this packet was published to the multicast channel
typedef struct _SendTime {
  UINT32 seconds;      // bytes 0 to 3
  UINT32 nanoseconds;  // bytes 4 to 7
} SendTime;

// Sent to reset the Message Sequence Number at start of day, or in response to failure recoveries.
typedef struct _SequenceNumberResetMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT8 product_id;       // byte 8
  UINT8 channel_id;       // byte 9
} SequenceNumberResetMessage;

// Sent at the start of every second during periods of active data publication.
typedef struct _SourceTimeReferenceMessage {
  UINT32 id;              // bytes 0 to 3
  UINT32 symbol_seq_num;  // bytes 4 to 7
  UINT32 source_time;     // bytes 8 to 11
} SourceTimeReferenceMessage;

// Published over the real-time data channels at system startup or in the context of a refresh sequence. Provides referential data for a single specified symbol or underlying symbol.
typedef struct _SymbolIndexMappingMessage {
  UINT32 symbol_index;         // bytes 0 to 3
  UINT8 symbol[11];            // bytes 4 to 14
  UINT8 reserved_1;            // byte 15
  UINT16 market_id;            // bytes 16 to 17
  UINT8 system_id;             // byte 18
  UINT8 exchange_code;         // byte 19
  UINT8 price_scale_code;      // byte 20
  UINT8 security_type;         // byte 21
  UINT16 lot_size;             // bytes 22 to 23
  UINT32 prev_close_price;     // bytes 24 to 27
  UINT32 prev_close_volume;    // bytes 28 to 31
  UINT8 price_resolution;      // byte 32
  UINT8 round_lot;             // byte 33
  UINT8 reserved_2[2];         // bytes 34 to 35
  UINT8 second_reserved_2[2];  // bytes 36 to 37
  UINT8 third_reserved_2[2];   // bytes 38 to 39
} SymbolIndexMappingMessage;

// In case of a failure and recovery, the publisher may send a full state refresh for every symbol or series affected, preceded by a Symbol Clear message.
typedef struct _SymbolClearMessage {
  UINT32 source_time;          // bytes 0 to 3
  UINT32 source_time_ns;       // bytes 4 to 7
  UINT32 symbol_index;         // bytes 8 to 11
  UINT32 next_source_seq_num;  // bytes 12 to 15
} SymbolClearMessage;

// Informs clients of changes in the status of a specific security or underlying symbol, such as Trading Halts, Short Sale Restriction state changes, etc.
typedef struct _SecurityStatusMessage {
  UINT32 source_time;                // bytes 0 to 3
  UINT32 source_time_ns;             // bytes 4 to 7
  UINT32 symbol_index;               // bytes 8 to 11
  UINT32 symbol_seq_num;             // bytes 12 to 15
  UINT8 security_status;             // byte 16
  UINT8 halt_condition;              // byte 17
  UINT8 reserved_4[4];               // bytes 18 to 21
  UINT32 price_1;                    // bytes 22 to 25
  UINT32 price_2;                    // bytes 26 to 29
  UINT8 ssr_triggering_exchange_id;  // byte 30
  UINT32 ssr_triggering_volume;      // bytes 31 to 34
  UINT32 time;                       // bytes 35 to 38
  UINT8 ssr_state;                   // byte 39
  UINT8 market_state;                // byte 40
  UINT8 session_state;               // byte 41
} SecurityStatusMessage;

// Published over the real-time data channels at system startup or in the context of a refresh sequence. Provides referential data for a single specified options outright series.
typedef struct _OutrightSeriesIndexMappingMessage {
  UINT32 series_index;           // bytes 0 to 3
  UINT8 series_type;             // byte 4
  UINT16 market_id;              // bytes 5 to 6
  UINT8 system_id;               // byte 7
  UINT8 option_symbol_root[6];   // bytes 8 to 13
  UINT8 underlying_symbol[11];   // bytes 14 to 24
  UINT32 underlying_index;       // bytes 25 to 28
  UINT8 price_scale_code;        // byte 29
  UINT16 contract_multiplier;    // bytes 30 to 31
  UINT8 maturity_date[6];        // bytes 32 to 37
  UINT8 put_or_call;             // byte 38
  UINT8 strike_price[10];        // bytes 39 to 48
  UINT8 closing_only_indicator;  // byte 49
  UINT8 reserved_1;              // byte 50
} OutrightSeriesIndexMappingMessage;

// Informs clients of changes in the status of a specific option outright series and complex series, such as Trading Halts.
typedef struct _OptionsStatusMessage {
  UINT32 source_time;                   // bytes 0 to 3
  UINT32 source_time_ns;                // bytes 4 to 7
  UINT32 series_index;                  // bytes 8 to 11
  UINT32 series_seq_num;                // bytes 12 to 15
  UINT8 series_status;                  // byte 16
  UINT8 market_state;                   // byte 17
  UINT8 options_status_halt_condition;  // byte 18
} OptionsStatusMessage;

typedef struct _ComplexSeriesIndexMappingLeg {
  UINT32 symbol_index;      // bytes 0 to 3
  UINT16 leg_ratio_qty;     // bytes 4 to 5
  UINT8 leg_side;           // byte 6
  UINT8 leg_security_type;  // byte 7
} ComplexSeriesIndexMappingLeg;

// Published over the real-time data channels at system startup or in the context of a refresh sequence. Provides referential data for a single specified options complex series.
typedef struct _ComplexSeriesIndexMappingMessage {
  UINT32 series_index;                                                                                    // bytes 0 to 3
  UINT16 market_id;                                                                                       // bytes 4 to 5
  UINT8 system_id;                                                                                        // byte 6
  UINT16 no_of_legs;                                                                                      // bytes 7 to 8
  ComplexSeriesIndexMappingLeg complex_series_index_mapping_leg[:byte-size (((UINT32) no_of_legs) * 8)];
} ComplexSeriesIndexMappingMessage;

// Sent by clients via TCP/IP to request retransmission of missed messages.
typedef struct _RetransmissionRequestMessage {
  UINT32 begin_seq_num;  // bytes 0 to 3
  UINT32 end_seq_num;    // bytes 4 to 7
  UINT8 source_id[10];   // bytes 8 to 17
  UINT8 product_id;      // byte 18
  UINT8 channel_id;      // byte 19
} RetransmissionRequestMessage;

// Sequence number fields that only the full Refresh Header carries.
typedef struct _FullRefreshHeader {
  UINT32 last_seq_num;         // bytes 0 to 3
  UINT32 last_symbol_seq_num;  // bytes 4 to 7
} FullRefreshHeader;

// Sequence number fields that only the full Refresh Header carries.
casetype _OptionalFullRefreshHeader (Bool present) {
  switch (present) {
    case true: FullRefreshHeader full_refresh_header;
    case false: unit absent;
  }
} OptionalFullRefreshHeader;

// The first message in each packet of refresh messages published over the Refresh multicast channels.
typedef struct _RefreshHeaderMessage {
  UINT16 current_refresh_pkt;                                                      // bytes 0 to 1
  UINT16 total_refresh_pkts;                                                       // bytes 2 to 3
  OptionalFullRefreshHeader((current_refresh_pkt == 0x0001)) full_refresh_header;
} RefreshHeaderMessage;

// Sent by clients via TCP/IP to request a refresh of the state of one or all symbols in a specific channel.
typedef struct _RefreshRequestMessage {
  UINT32 symbol_index;  // bytes 0 to 3
  UINT8 source_id[10];  // bytes 4 to 13
  UINT8 product_id;     // byte 14
  UINT8 channel_id;     // byte 15
} RefreshRequestMessage;

// Sent by clients via TCP/IP requesting the Symbol Index Mapping messages for one or all symbols in a specified channel.
typedef struct _SymbolIndexMappingRequestMessage {
  UINT32 symbol_index;      // bytes 0 to 3
  UINT8 source_id[10];      // bytes 4 to 13
  UINT8 product_id;         // byte 14
  UINT8 channel_id;         // byte 15
  UINT8 retransmit_method;  // byte 16
} SymbolIndexMappingRequestMessage;

// Sent over the Retransmission multicast channels to inform clients of unavailability of a range of messages.
typedef struct _MessageUnavailableMessage {
  UINT32 begin_seq_num;  // bytes 0 to 3
  UINT32 end_seq_num;    // bytes 4 to 7
  UINT8 product_id;      // byte 8
  UINT8 channel_id;      // byte 9
} MessageUnavailableMessage;

// Sent immediately via TCP/IP in response to the client's request for retransmission, refresh or Symbol Mapping messages.
typedef struct _RequestResponseMessage {
  UINT32 request_seq_num;  // bytes 0 to 3
  UINT32 begin_seq_num;    // bytes 4 to 7
  UINT32 end_seq_num;      // bytes 8 to 11
  UINT8 source_id[10];     // bytes 12 to 21
  UINT8 product_id;        // byte 22
  UINT8 channel_id;        // byte 23
  UINT8 status;            // byte 24
} RequestResponseMessage;

// Clients who remain connected to the Retransmission Server intraday must respond to a Heartbeat with a Heartbeat Response message within 5 seconds.
typedef struct _HeartbeatResponseMessage {
  UINT8 source_id[10];  // bytes 0 to 9
} HeartbeatResponseMessage;

// An Options quote message is sent when any event results in a new top of book value on either side of the market.
typedef struct _OptionsQuoteMessage {
  UINT32 source_time_ns;       // bytes 0 to 3
  UINT32 series_index;         // bytes 4 to 7
  UINT32 series_seq_num;       // bytes 8 to 11
  UINT32 ask_price;            // bytes 12 to 15, signed, read here as unsigned
  UINT32 ask_volume;           // bytes 16 to 19
  UINT32 bid_price;            // bytes 20 to 23, signed, read here as unsigned
  UINT32 bid_volume;           // bytes 24 to 27
  UINT8 quote_condition;       // byte 28
  UINT8 reserved_1;            // byte 29
  UINT32 ask_customer_volume;  // bytes 30 to 33
  UINT32 bid_customer_volume;  // bytes 34 to 37
} OptionsQuoteMessage;

// An Options Trade message is sent when there is an execution on the order book.
typedef struct _OptionsTradeMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT32 series_index;    // bytes 8 to 11
  UINT32 series_seq_num;  // bytes 12 to 15
  UINT32 trade_id;        // bytes 16 to 19
  UINT32 price;           // bytes 20 to 23, signed, read here as unsigned
  UINT32 volume;          // bytes 24 to 27
  UINT8 trade_cond_1;     // byte 28
  UINT8 trade_cond_2;     // byte 29
  UINT8 reserved_1;       // byte 30
  UINT8 trade_cond_4;     // byte 31
} OptionsTradeMessage;

// In the event that an earlier trade has been reported in error, an Options Trade Cancel message is sent.
typedef struct _OptionsTradeCancelMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 series_index;       // bytes 8 to 11
  UINT32 series_seq_num;     // bytes 12 to 15
  UINT32 original_trade_id;  // bytes 16 to 19
} OptionsTradeCancelMessage;

// In the event that an earlier trade has been reported with one or multiple fields in error, an Options Trade Correction message is sent.
typedef struct _OptionsTradeCorrectionMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 series_index;       // bytes 8 to 11
  UINT32 series_seq_num;     // bytes 12 to 15
  UINT32 original_trade_id;  // bytes 16 to 19
  UINT32 trade_id;           // bytes 20 to 23
  UINT32 price;              // bytes 24 to 27, signed, read here as unsigned
  UINT32 volume;             // bytes 28 to 31
  UINT8 trade_cond_1;        // byte 32
  UINT8 reserved_1;          // byte 33
  UINT8 second_reserved_1;   // byte 34
  UINT8 third_reserved_1;    // byte 35
} OptionsTradeCorrectionMessage;

// Options Imbalance messages are published every 5 seconds during opening and reopening auctions to update price and volume information.
typedef struct _OptionsImbalanceMessage {
  UINT32 source_time;                      // bytes 0 to 3
  UINT32 source_time_ns;                   // bytes 4 to 7
  UINT32 series_index;                     // bytes 8 to 11
  UINT32 series_seq_num;                   // bytes 12 to 15
  UINT8 reserved_4[4];                     // bytes 16 to 19
  UINT32 paired_qty;                       // bytes 20 to 23
  UINT32 total_imbalance_qty;              // bytes 24 to 27
  UINT32 market_imbalance_qty;             // bytes 28 to 31
  UINT8 reserved_2[2];                     // bytes 32 to 33
  UINT8 auction_type;                      // byte 34
  UINT8 imbalance_side;                    // byte 35
  UINT32 continuous_book_clearing_price;   // bytes 36 to 39, signed, read here as unsigned
  UINT32 auction_interest_clearing_price;  // bytes 40 to 43, signed, read here as unsigned
  UINT8 second_reserved_4[4];              // bytes 44 to 47
  UINT32 indicative_match_price;           // bytes 48 to 51, signed, read here as unsigned
  UINT32 upper_collar;                     // bytes 52 to 55, signed, read here as unsigned
  UINT32 lower_collar;                     // bytes 56 to 59, signed, read here as unsigned
  UINT8 auction_status;                    // byte 60
} OptionsImbalanceMessage;

// The Request for Series RFQ message is published for outright series. It is generated by the matching engine to solicit interest in an auction or order.
typedef struct _SeriesRfqMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT32 series_index;    // bytes 8 to 11
  UINT32 series_seq_num;  // bytes 12 to 15
  UINT8 side;             // byte 16
  UINT8 type_;            // byte 17
  UINT8 capacity;         // byte 18
  UINT32 total_quantity;  // bytes 19 to 22
  UINT32 working_price;   // bytes 23 to 26, signed, read here as unsigned
  UINT32 participant;     // bytes 27 to 30
  UINT64 auction_id;      // bytes 31 to 38
  UINT8 rfq_status;       // byte 39
} SeriesRfqMessage;

// The outright series summary message is sent every 60 seconds, on a separate multicast channel from the main feed.
typedef struct _OutrightSeriesSummaryMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT32 series_index;    // bytes 8 to 11
  UINT32 high_price;      // bytes 12 to 15, signed, read here as unsigned
  UINT32 low_price;       // bytes 16 to 19, signed, read here as unsigned
  UINT32 open_;           // bytes 20 to 23, signed, read here as unsigned
  UINT32 close;           // bytes 24 to 27, signed, read here as unsigned
  UINT32 total_volume;    // bytes 28 to 31
} OutrightSeriesSummaryMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0001: SequenceNumberResetMessage sequence_number_reset_message;
    case 0x0002: SourceTimeReferenceMessage source_time_reference_message;
    case 0x0003: SymbolIndexMappingMessage symbol_index_mapping_message;
    case 0x0020: SymbolClearMessage symbol_clear_message;
    case 0x0022: SecurityStatusMessage security_status_message;
    case 0x0032: OutrightSeriesIndexMappingMessage outright_series_index_mapping_message;
    case 0x0033: OptionsStatusMessage options_status_message;
    case 0x003C: ComplexSeriesIndexMappingMessage complex_series_index_mapping_message;
    case 0x000A: RetransmissionRequestMessage retransmission_request_message;
    case 0x0023: RefreshHeaderMessage refresh_header_message;
    case 0x000F: RefreshRequestMessage refresh_request_message;
    case 0x000D: SymbolIndexMappingRequestMessage symbol_index_mapping_request_message;
    case 0x001F: MessageUnavailableMessage message_unavailable_message;
    case 0x000B: RequestResponseMessage request_response_message;
    case 0x000C: HeartbeatResponseMessage heartbeat_response_message;
    case 0x0154: OptionsQuoteMessage options_quote_message;
    case 0x0140: OptionsTradeMessage options_trade_message;
    case 0x0141: OptionsTradeCancelMessage options_trade_cancel_message;
    case 0x0142: OptionsTradeCorrectionMessage options_trade_correction_message;
    case 0x0131: OptionsImbalanceMessage options_imbalance_message;
    case 0x0133: SeriesRfqMessage series_rfq_message;
    case 0x0143: OutrightSeriesSummaryMessage outright_series_summary_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Pillar message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_size { message_size >= 4 };                                                                                                                       // bytes 0 to 1
  UINT16 message_type;                                                                                                                                             // bytes 2 to 3
  Payload(message_type, (((UINT32) message_size) - 4)) payload[:byte-size-single-element-array (((UINT32) message_size) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Pillar message
typedef struct _MessageRun (UINT8 number_msgs, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_msgs); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 number_msgs, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x01: unit heartbeat;
    default: MessageRun(number_msgs, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pillar common client udp packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16 pkt_size;                                                                                                           // bytes 0 to 1
  UINT8 delivery_flag;                                                                                                       // byte 2
  UINT8 number_msgs;                                                                                                         // byte 3
  UINT32 seq_num;                                                                                                            // bytes 4 to 7
  SendTime send_time;                                                                                                        // bytes 8 to 15
  Messages(delivery_flag, number_msgs, (available - 16), tally) messages[:byte-size-single-element-array (available - 16)];
} Packet;

