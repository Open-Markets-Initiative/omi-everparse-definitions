#define TRADE_COND_1_OUTRIGHT_SERIES_CUBE_ORDER_TRADE 0x61                                   // Outright Series Cube Order Trade
#define TRADE_COND_1_OUTRIGHT_SERIES_QCC_ORDER_OR_CUSTOMER_TO_CUSTOMER_CROSS_ORDER 0x63      // Outright Series Qcc Order Or Customer To Customer Cross Order
