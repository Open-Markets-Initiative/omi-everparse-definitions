#define MESSAGE_TYPE_OUTRIGHT_SERIES_INDEX_MAPPING_MESSAGE 0x0032  // Outright Series Index Mapping Message
#define MESSAGE_TYPE_OPTIONS_STATUS_MESSAGE 0x0033                 // Options Status Message
#define MESSAGE_TYPE_COMPLEX_SERIES_INDEX_MAPPING_MESSAGE 0x003C   // Complex Series Index Mapping Message
#define MESSAGE_TYPE_RETRANSMISSION_REQUEST_MESSAGE 0x000A         // Retransmission Request Message
#define MESSAGE_TYPE_REFRESH_HEADER_MESSAGE 0x0023                 // Refresh Header Message
#define MESSAGE_TYPE_REFRESH_REQUEST_MESSAGE 0x000F                // Refresh Request Message
#define MESSAGE_TYPE_SYMBOL_INDEX_MAPPING_REQUEST_MESSAGE 0x000D   // Symbol Index Mapping Request Message
#define MESSAGE_TYPE_MESSAGE_UNAVAILABLE_MESSAGE 0x001F            // Message Unavailable Message
#define MESSAGE_TYPE_REQUEST_RESPONSE_MESSAGE 0x000B               // Request Response Message
#define MESSAGE_TYPE_HEARTBEAT_RESPONSE_MESSAGE 0x000C             // Heartbeat Response Message
#define MESSAGE_TYPE_OPTIONS_QUOTE_MESSAGE 0x0154                  // Options Quote Message
#define MESSAGE_TYPE_OPTIONS_TRADE_MESSAGE 0x0140                  // Options Trade Message
#define MESSAGE_TYPE_OPTIONS_TRADE_CANCEL_MESSAGE 0x0141           // Options Trade Cancel Message
#define MESSAGE_TYPE_OPTIONS_TRADE_CORRECTION_MESSAGE 0x0142       // Options Trade Correction Message
#define MESSAGE_TYPE_OPTIONS_IMBALANCE_MESSAGE 0x0131              // Options Imbalance Message
#define MESSAGE_TYPE_SERIES_RFQ_MESSAGE 0x0133                     // Series Rfq Message
#define MESSAGE_TYPE_OUTRIGHT_SERIES_SUMMARY_MESSAGE 0x0143        // Outright Series Summary Message

// Market Id: 2 byte code
#define MARKET_ID_NYSE_EQUITIES 0x0001           // Nyse Equities
#define MARKET_ID_NYSE_ARCA_EQUITIES 0x0003      // Nyse Arca Equities
#define MARKET_ID_NYSE_ARCA_OPTIONS 0x0004       // Nyse Arca Options
