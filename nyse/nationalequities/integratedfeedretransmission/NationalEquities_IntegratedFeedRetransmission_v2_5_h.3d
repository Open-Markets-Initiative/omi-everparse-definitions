#define SSR_TRIGGERING_EXCHANGE_ID_CBOE_EDGA 0x4A       // Cboe Edga
#define SSR_TRIGGERING_EXCHANGE_ID_CBOE_EDGX 0x4B       // Cboe Edgx
#define SSR_TRIGGERING_EXCHANGE_ID_LTSE 0x4C            // Ltse
#define SSR_TRIGGERING_EXCHANGE_ID_NYSE_TEXAS 0x4D      // Nyse Texas
#define SSR_TRIGGERING_EXCHANGE_ID_NYSE 0x4E            // Nyse
#define SSR_TRIGGERING_EXCHANGE_ID_NYSE_ARCA 0x50       // Nyse Arca
#define SSR_TRIGGERING_EXCHANGE_ID_NASDAQ 0x51          // Nasdaq
#define SSR_TRIGGERING_EXCHANGE_ID_NASDAQ_OMX 0x54      // Nasdaq Omx
#define SSR_TRIGGERING_EXCHANGE_ID_MEMX 0x55            // Memx
#define SSR_TRIGGERING_EXCHANGE_ID_IEX 0x56             // Iex
#define SSR_TRIGGERING_EXCHANGE_ID_CBSX 0x57            // Cbsx
#define SSR_TRIGGERING_EXCHANGE_ID_NASDAQ_OMX_PSX 0x58  // Nasdaq Omx Psx
#define SSR_TRIGGERING_EXCHANGE_ID_CBOE_BYX 0x59        // Cboe Byx
#define SSR_TRIGGERING_EXCHANGE_ID_CBOE_BZX 0x5A        // Cboe Bzx
#define SSR_TRIGGERING_EXCHANGE_ID_NO_VALUE 0x20        // No Value

// Ssr State: one byte code
#define SSR_STATE_NO_SHORT_SALE_RESTRICTION_IN_EFFECT 0x7E  // No Short Sale Restriction In Effect
#define SSR_STATE_SHORT_SALE_RESTRICTION_IN_EFFECT 0x45     // Short Sale Restriction In Effect

// Market State: one byte code
#define MARKET_STATE_PRE_OPENING 0x50                 // Pre Opening
#define MARKET_STATE_OVERNIGHT_SESSION 0x4E           // Overnight Session
#define MARKET_STATE_EARLY_SESSION 0x45               // Early Session
#define MARKET_STATE_CORE_SESSION 0x4F                // Core Session
#define MARKET_STATE_LATE_SESSION_NON_NYSE_ONLY 0x4C  // Late Session Non Nyse Only
#define MARKET_STATE_CLOSED 0x58                      // Closed

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Printable Flag: one byte code
#define PRINTABLE_FLAG_NOT_PRINTED_TO_THE_SIP 0x00  // Not Printed To The Sip
#define PRINTABLE_FLAG_PRINTED_TO_THE_SIP 0x01      // Printed To The Sip

// Trade Cond 1: one byte code
#define TRADE_COND_1_REGULAR_SALE 0x40     // Regular Sale
#define TRADE_COND_1_CASH_TEXAS_ONLY 0x43  // Cash Texas Only

// Trade Cond 2: one byte code
#define TRADE_COND_2_NA 0x20                                                       // Na
#define TRADE_COND_2_INTERMARKET_SWEEP_ORDER 0x46                                  // Intermarket Sweep Order
#define TRADE_COND_2_MARKET_CENTER_OPENING_TRADE_ARCA_AMERICAN_AND_NYSE_ONLY 0x4F  // Market Center Opening Trade Arca American And Nyse Only
#define TRADE_COND_2_REOPENING_TRADE_ARCA_AMERICAN_AND_NYSE_ONLY 0x35              // Reopening Trade Arca American And Nyse Only
#define TRADE_COND_2_MARKET_CENTER_CLOSING_TRADE_ARCA_AMERICAN_AND_NYSE_ONLY 0x36  // Market Center Closing Trade Arca American And Nyse Only
#define TRADE_COND_2_QUALIFIED_CONTINGENT_TRADE_TEXAS_ONLY 0x37                    // Qualified Contingent Trade Texas Only

// Trade Cond 3: one byte code
#define TRADE_COND_3_NA 0x20                                   // Na
#define TRADE_COND_3_EXTENDED_HOURS_TRADE 0x54                 // Extended Hours Trade
#define TRADE_COND_3_EXTENDED_HOURS_SOLD_OUT_OF_SEQUENCE 0x55  // Extended Hours Sold Out Of Sequence
#define TRADE_COND_3_SOLD 0x5A                                 // Sold

// Trade Cond 4: one byte code
#define TRADE_COND_4_NA 0x20                           // Na
#define TRADE_COND_4_ODD_LOT_TRADE 0x49                // Odd Lot Trade
#define TRADE_COND_4_CONTINGENT_TRADE_TEXAS_ONLY 0x56  // Contingent Trade Texas Only

// Auction Type: one byte code
#define AUCTION_TYPE_EARLY_OPENING_AUCTION 0x4F          // Early Opening Auction
#define AUCTION_TYPE_CORE_OPENING_AUCTION 0x4D           // Core Opening Auction
#define AUCTION_TYPE_REOPENING_AUCTION_HALT_RESUME 0x48  // Reopening Auction Halt Resume
#define AUCTION_TYPE_CLOSING_AUCTION 0x43                // Closing Auction
#define AUCTION_TYPE_EXTREME_CLOSING_IMBALANCE 0x50      // Extreme Closing Imbalance
#define AUCTION_TYPE_SIGNIFICANT_CLOSING_IMBALANCE 0x52  // Significant Closing Imbalance

// Imbalance Side: one byte code
#define IMBALANCE_SIDE_BUY_SIDE 0x42      // Buy Side
#define IMBALANCE_SIDE_SELL_SIDE 0x53     // Sell Side
#define IMBALANCE_SIDE_NO_IMBALANCE 0x20  // No Imbalance

// Auction Status: one byte code
#define AUCTION_STATUS_WILL_RUN_AS_ALWAYS_FOR_OPEN_AND_CLOSE 0x00                                     // Will Run As Always For Open And Close
#define AUCTION_STATUS_WILL_RUN_INTEREST_EXISTS_INSIDE_OR_AT_THE_COLLARS_OR_IS_FULLY_PAIRED_OFF 0x01  // Will Run Interest Exists Inside Or At The Collars Or Is Fully Paired Off
#define AUCTION_STATUS_WILL_NOT_RUN_BECAUSE_THERE_IS_AN_IMBALANCE_THROUGH_THE_COLLARS 0x02            // Will Not Run Because There Is An Imbalance Through The Collars
#define AUCTION_STATUS_WILL_NOT_RUN_WILL_TRANSITION_TO_THE_CLOSING_AUCTION_INSTEAD 0x03               // Will Not Run Will Transition To The Closing Auction Instead

// Freeze Status: one byte code
#define FREEZE_STATUS_IMBALANCE_FREEZE_NOT_IN_EFFECT 0x00  // Imbalance Freeze Not In Effect
#define FREEZE_STATUS_IMBALANCE_FREEZE_IS_IN_EFFECT 0x01   // Imbalance Freeze Is In Effect

// Unpaired Side: one byte code
#define UNPAIRED_SIDE_BUY_SIDE 0x42        // Buy Side
#define UNPAIRED_SIDE_SELL_SIDE 0x53       // Sell Side
#define UNPAIRED_SIDE_NOT_APPLICABLE 0x20  // Not Applicable

// Cross Type: one byte code
#define CROSS_TYPE_MARKET_CENTER_EARLY_OPENING_AUCTION 0x45  // Market Center Early Opening Auction
#define CROSS_TYPE_MARKET_CENTER_OPENING_AUCTION 0x4F        // Market Center Opening Auction
#define CROSS_TYPE_MARKET_CENTER_REOPENING_AUCTION 0x35      // Market Center Reopening Auction
#define CROSS_TYPE_MARKET_CENTER_CLOSING_AUCTION 0x36        // Market Center Closing Auction

// Rpi Indicator: one byte code
#define RPI_INDICATOR_NO_RETAIL_INTEREST_DEFAULT 0x20                  // No Retail Interest Default
#define RPI_INDICATOR_RETAIL_INTEREST_ON_THE_BID_SIDE 0x41             // Retail Interest On The Bid Side
#define RPI_INDICATOR_RETAIL_INTEREST_ON_THE_OFFER_SIDE 0x42           // Retail Interest On The Offer Side
#define RPI_INDICATOR_RETAIL_INTEREST_ON_THE_BID_AND_OFFER_SIDES 0x43  // Retail Interest On The Bid And Offer Sides

// ---- Types -------------------------------------------------------------------

// The time when this packet was published to the multicast channel
typedef struct _SendTime {
  UINT32 seconds;      // bytes 0 to 3
  UINT32 nanoseconds;  // bytes 4 to 7
} SendTime;

// This message is sent to reset the Message Sequence Number at start of day, or in response to failures.
typedef struct _SequenceNumberResetMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT8 product_id;       // byte 8
  UINT8 channel_id;       // byte 9
} SequenceNumberResetMessage;

// For high-volume feeds, this message is sent at the start of every second during periods of active data publication. The client can concatenate the SourceTime field with the SourceTimeNS field in subsequent market data messages to get full 8-byte Matching Engine event timestamps.
typedef struct _SourceTimeReferenceMessage {
  UINT32 id;              // bytes 0 to 3
  UINT32 symbol_seq_num;  // bytes 4 to 7
  UINT32 source_time;     // bytes 8 to 11
} SourceTimeReferenceMessage;

// This message is published over the real-time data channels at system startup or in the context of a refresh sequence after a Matching Engine or Pillar Publisher failover. It provides referential data for a single specified symbol.
typedef struct _SymbolIndexMappingMessage {
  UINT32 symbol_index;        // bytes 0 to 3
  UINT8 symbol[11];           // bytes 4 to 14
  UINT8 reserved_1;           // byte 15
  UINT16 market_id;           // bytes 16 to 17
  UINT8 system_id;            // byte 18
  UINT8 exchange_code;        // byte 19
  UINT8 price_scale_code;     // byte 20
  UINT8 security_type;        // byte 21
  UINT16 lot_size;            // bytes 22 to 23
  UINT32 prev_close_price;    // bytes 24 to 27
  UINT32 prev_close_volume;   // bytes 28 to 31
  UINT8 price_resolution;     // byte 32
  UINT8 round_lot;            // byte 33
  UINT16 mpv;                 // bytes 34 to 35
  UINT16 unit_of_trade;       // bytes 36 to 37
  UINT8 late_close_eligible;  // byte 38
  UINT8 eth_eligible;         // byte 39
} SymbolIndexMappingMessage;

// In case of a failure and recovery of a Matching Engine or an Pillar Publisher, the publisher may send a full state refresh for every symbol affected. This unrequested refresh is preceded by a Symbol Clear message. The client should react to receipt of a Symbol Clear message by clearing all state information for the specified symbol in anticipation of receiving a full state refresh.
typedef struct _SymbolClearMessage {
  UINT32 source_time;          // bytes 0 to 3
  UINT32 source_time_ns;       // bytes 4 to 7
  UINT32 symbol_index;         // bytes 8 to 11
  UINT32 next_source_seq_num;  // bytes 12 to 15
} SymbolClearMessage;

// This message informs clients of changes in the status of a specific security, such as Trading Halts, Short Sale Restriction state changes, etc.
typedef struct _SecurityStatusMessage {
  UINT32 source_time;                // bytes 0 to 3
  UINT32 source_time_ns;             // bytes 4 to 7
  UINT32 symbol_index;               // bytes 8 to 11
  UINT32 symbol_seq_num;             // bytes 12 to 15
  UINT8 security_status;             // byte 16
  UINT8 halt_condition;              // byte 17
  UINT8 reserved_4[4];               // bytes 18 to 21
  UINT32 price_1;                    // bytes 22 to 25
  UINT32 price_2;                    // bytes 26 to 29
  UINT8 ssr_triggering_exchange_id;  // byte 30
  UINT32 ssr_triggering_volume;      // bytes 31 to 34
  UINT32 time;                       // bytes 35 to 38
  UINT8 ssr_state;                   // byte 39
  UINT8 market_state;                // byte 40
  UINT8 session_state;               // byte 41
} SecurityStatusMessage;

// This message will be sent over the Retransmission multicast channels to inform clients of unavailability of a range of messages (or part of a range) for which they may have requested a retransmission.
typedef struct _MessageUnavailableMessage {
  UINT32 begin_seq_num;  // bytes 0 to 3
  UINT32 end_seq_num;    // bytes 4 to 7
  UINT8 product_id;      // byte 8
  UINT8 channel_id;      // byte 9
} MessageUnavailableMessage;

// An Add Order message is published when a new visible order has been received and added to the book.
typedef struct _AddOrderMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 symbol_index;    // bytes 4 to 7
  UINT32 symbol_seq_num;  // bytes 8 to 11
  UINT64 order_id;        // bytes 12 to 19
  UINT32 price;           // bytes 20 to 23, signed, read here as unsigned
  UINT32 volume;          // bytes 24 to 27
  UINT8 side;             // byte 28
  UINT8 firm_id[5];       // bytes 29 to 33
  UINT8 reserved_1;       // byte 34
} AddOrderMessage;

// A Modify Order message is sent when the price or volume of an order is changed.
typedef struct _ModifyOrderMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 symbol_index;    // bytes 4 to 7
  UINT32 symbol_seq_num;  // bytes 8 to 11
  UINT64 order_id;        // bytes 12 to 19
  UINT32 price;           // bytes 20 to 23, signed, read here as unsigned
  UINT32 volume;          // bytes 24 to 27
  UINT8 position_change;  // byte 28
  UINT8 side;             // byte 29
  UINT8 reserved_1;       // byte 30
} ModifyOrderMessage;

// A Delete Order message is published when an order is taken off of the book.
typedef struct _DeleteOrderMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 symbol_index;    // bytes 4 to 7
  UINT32 symbol_seq_num;  // bytes 8 to 11
  UINT64 order_id;        // bytes 12 to 19
  UINT8 reserved_1;       // byte 20
} DeleteOrderMessage;

// An Order Execution message is sent when an order is partially or fully executed.
typedef struct _OrderExecutionMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 symbol_index;    // bytes 4 to 7
  UINT32 symbol_seq_num;  // bytes 8 to 11
  UINT64 order_id;        // bytes 12 to 19
  UINT32 trade_id;        // bytes 20 to 23
  UINT32 price;           // bytes 24 to 27, signed, read here as unsigned
  UINT32 volume;          // bytes 28 to 31
  UINT8 printable_flag;   // byte 32
  UINT8 reserved_1;       // byte 33
  UINT8 trade_cond_1;     // byte 34
  UINT8 trade_cond_2;     // byte 35
  UINT8 trade_cond_3;     // byte 36
  UINT8 trade_cond_4;     // byte 37
} OrderExecutionMessage;

// A Replace Order message is published when a cancel/replace order is received and executed.
typedef struct _ReplaceOrderMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 symbol_index;    // bytes 4 to 7
  UINT32 symbol_seq_num;  // bytes 8 to 11
  UINT64 order_id;        // bytes 12 to 19
  UINT64 new_order_id;    // bytes 20 to 27
  UINT32 price;           // bytes 28 to 31, signed, read here as unsigned
  UINT32 volume;          // bytes 32 to 35
  UINT8 side;             // byte 36
  UINT8 reserved_1;       // byte 37
} ReplaceOrderMessage;

// Imbalance messages are published once a second during auctions to update price and volume information.
typedef struct _ImbalanceMessage {
  UINT32 source_time;                      // bytes 0 to 3
  UINT32 source_time_ns;                   // bytes 4 to 7
  UINT32 symbol_index;                     // bytes 8 to 11
  UINT32 symbol_seq_num;                   // bytes 12 to 15
  UINT32 reference_price;                  // bytes 16 to 19, signed, read here as unsigned
  UINT32 paired_qty;                       // bytes 20 to 23
  UINT32 total_imbalance_qty;              // bytes 24 to 27
  UINT32 market_imbalance_qty;             // bytes 28 to 31
  UINT16 auction_time;                     // bytes 32 to 33
  UINT8 auction_type;                      // byte 34
  UINT8 imbalance_side;                    // byte 35
  UINT32 continuous_book_clearing_price;   // bytes 36 to 39, signed, read here as unsigned
  UINT32 auction_interest_clearing_price;  // bytes 40 to 43, signed, read here as unsigned
  UINT32 ssr_filing_price;                 // bytes 44 to 47, signed, read here as unsigned
  UINT32 indicative_match_price;           // bytes 48 to 51, signed, read here as unsigned
  UINT32 upper_collar;                     // bytes 52 to 55, signed, read here as unsigned
  UINT32 lower_collar;                     // bytes 56 to 59, signed, read here as unsigned
  UINT8 auction_status;                    // byte 60
  UINT8 freeze_status;                     // byte 61
  UINT8 num_extensions;                    // byte 62
  UINT32 unpaired_qty;                     // bytes 63 to 66
  UINT8 unpaired_side;                     // byte 67
  UINT8 reserved_1;                        // byte 68
} ImbalanceMessage;

// The Add Order Refresh message can be sent in either of two contexts: refresh response or symbol refresh.
typedef struct _AddOrderRefreshMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT32 symbol_index;    // bytes 8 to 11
  UINT32 symbol_seq_num;  // bytes 12 to 15
  UINT64 order_id;        // bytes 16 to 23
  UINT32 price;           // bytes 24 to 27, signed, read here as unsigned
  UINT32 volume;          // bytes 28 to 31
  UINT8 side;             // byte 32
  UINT8 firm_id[5];       // bytes 33 to 37
  UINT8 reserved_1;       // byte 38
} AddOrderRefreshMessage;

// A Non Displayed Trade message is sent as a result of a match between two non-displayed orders.
typedef struct _NonDisplayedTradeMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 symbol_index;    // bytes 4 to 7
  UINT32 symbol_seq_num;  // bytes 8 to 11
  UINT32 trade_id;        // bytes 12 to 15
  UINT32 price;           // bytes 16 to 19, signed, read here as unsigned
  UINT32 volume;          // bytes 20 to 23
  UINT8 printable_flag;   // byte 24
  UINT8 trade_cond_1;     // byte 25
  UINT8 trade_cond_2;     // byte 26
  UINT8 trade_cond_3;     // byte 27
  UINT8 trade_cond_4;     // byte 28
} NonDisplayedTradeMessage;

// A Cross Trade message is published on completion of a crossing auction.
typedef struct _CrossTradeMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 symbol_index;    // bytes 4 to 7
  UINT32 symbol_seq_num;  // bytes 8 to 11
  UINT32 cross_id;        // bytes 12 to 15
  UINT32 price;           // bytes 16 to 19, signed, read here as unsigned
  UINT32 volume;          // bytes 20 to 23
  UINT8 cross_type;       // byte 24
} CrossTradeMessage;

// In the event that an earlier trade has been reported in error, a Trade Cancel message is sent.
typedef struct _TradeCancelMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 symbol_index;    // bytes 4 to 7
  UINT32 symbol_seq_num;  // bytes 8 to 11
  UINT32 trade_id;        // bytes 12 to 15
} TradeCancelMessage;

// In the event that an earlier Cross Trade has been reported in error, a Cross Correction message is sent.
typedef struct _CrossCorrectionMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 symbol_index;    // bytes 4 to 7
  UINT32 symbol_seq_num;  // bytes 8 to 11
  UINT32 cross_id;        // bytes 12 to 15
  UINT32 volume;          // bytes 16 to 19
} CrossCorrectionMessage;

// Published when RPI interest is added or removed between the best bid and best offer price.
typedef struct _RetailPriceImprovementMessage {
  UINT32 source_time_ns;  // bytes 0 to 3
  UINT32 symbol_index;    // bytes 4 to 7
  UINT32 symbol_seq_num;  // bytes 8 to 11
  UINT8 rpi_indicator;    // byte 12
} RetailPriceImprovementMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0001: SequenceNumberResetMessage sequence_number_reset_message;
    case 0x0002: SourceTimeReferenceMessage source_time_reference_message;
    case 0x0003: SymbolIndexMappingMessage symbol_index_mapping_message;
    case 0x0020: SymbolClearMessage symbol_clear_message;
    case 0x0022: SecurityStatusMessage security_status_message;
    case 0x001F: MessageUnavailableMessage message_unavailable_message;
    case 0x0064: AddOrderMessage add_order_message;
    case 0x0065: ModifyOrderMessage modify_order_message;
    case 0x0066: DeleteOrderMessage delete_order_message;
    case 0x0067: OrderExecutionMessage order_execution_message;
    case 0x0068: ReplaceOrderMessage replace_order_message;
    case 0x0069: ImbalanceMessage imbalance_message;
    case 0x006A: AddOrderRefreshMessage add_order_refresh_message;
    case 0x006E: NonDisplayedTradeMessage non_displayed_trade_message;
    case 0x006F: CrossTradeMessage cross_trade_message;
    case 0x0070: TradeCancelMessage trade_cancel_message;
    case 0x0071: CrossCorrectionMessage cross_correction_message;
    case 0x0072: RetailPriceImprovementMessage retail_price_improvement_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Pillar message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_size { message_size >= 4 };                                                                                                                       // bytes 0 to 1
  UINT16 message_type;                                                                                                                                             // bytes 2 to 3
  Payload(message_type, (((UINT32) message_size) - 4)) payload[:byte-size-single-element-array (((UINT32) message_size) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Pillar message
typedef struct _MessageRun (UINT8 number_msgs, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_msgs); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 number_msgs, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x01: unit heartbeat;
    default: MessageRun(number_msgs, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// Pillar common client udp packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16 pkt_size;                                                                                                           // bytes 0 to 1
  UINT8 delivery_flag;                                                                                                       // byte 2
  UINT8 number_msgs;                                                                                                         // byte 3
  UINT32 seq_num;                                                                                                            // bytes 4 to 7
  SendTime send_time;                                                                                                        // bytes 8 to 15
  Messages(delivery_flag, number_msgs, (available - 16), tally) messages[:byte-size-single-element-array (available - 16)];
} Packet;

