// ---- Msg Header: 4 bytes -----------------------------------------------------

// Pillar Stream Message Header
entrypoint typedef struct _MsgHeader {
  UINT16 msg_type;    // bytes 0 to 1
  UINT16 msg_length;  // bytes 2 to 3
} MsgHeader;

// ---- Stream Id: 8 bytes ------------------------------------------------------

// Pillar Stream Protocol Stream Identifier
entrypoint typedef struct _StreamId {
  UINT32 sess;   // bytes 0 to 3
  UINT32 value;  // bytes 4 to 7
} StreamId;

// ---- Seq Msg Id: 16 bytes ----------------------------------------------------

// Pillar Stream Sequenced Message Identifier
entrypoint typedef struct _SeqMsgId {
  StreamId stream_id;  // bytes 0 to 7
  UINT64 seq;          // bytes 8 to 15
} SeqMsgId;

// ---- Seq Msg Header: 4 bytes -------------------------------------------------

// Pillar Stream Sequenced Message Header
entrypoint typedef struct _SeqMsgHeader {
  UINT16 seq_msg_type;    // bytes 0 to 1
  UINT16 seq_msg_length;  // bytes 2 to 3
} SeqMsgHeader;

// ---- Sub Msg Header: 4 bytes -------------------------------------------------

// Pillar Stream Sub Message Item Header
entrypoint typedef struct _SubMsgHeader {
  UINT16 sub_msg_type;    // bytes 0 to 1
  UINT16 sub_msg_length;  // bytes 2 to 3
} SubMsgHeader;

// ---- Manual Action Id: 16 bytes ----------------------------------------------

// ManualActionID
entrypoint typedef struct _ManualActionId {
