  UINT32 price;                 // bytes 16 to 19
  UINT32 volume;                // bytes 20 to 23
  UINT8 side;                   // byte 24
  UINT8 order_idgtc_indicator;  // byte 25
  UINT8 reason_code;            // byte 26
} ModifyOrderMessage;

// ---- Delete Order Message: 19 bytes ------------------------------------------

// Sent when an order is taken off of the order book: the order is cancelled, expires, or is routed to an away market. Size of the message: 23 bytes (NYSE, NYSE MKT and NYSE Arca).
entrypoint typedef struct _DeleteOrderMessage {
  UINT32 source_time_ns;        // bytes 0 to 3
  UINT32 symbol_index;          // bytes 4 to 7
