  UINT32 price;                 // bytes 16 to 19
  UINT32 volume;                // bytes 20 to 23
  UINT8 order_idgtc_indicator;  // byte 24
  UINT8 reason_code;            // byte 25
  UINT32 trade_id;              // bytes 26 to 29
} ExecutionMessage;

