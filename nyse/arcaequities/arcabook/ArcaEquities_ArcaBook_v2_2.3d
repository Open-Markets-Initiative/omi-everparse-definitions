// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out ArcaEquities_ArcaBook_v2_2.3d

// ---- Values ------------------------------------------------------------------

// Delivery Flag: one byte code
#define DELIVERY_FLAG_HEARTBEAT 0x01                        // Heartbeat
#define DELIVERY_FLAG_X_D_P_FAILOVER 0x0A                   // XDP Failover
#define DELIVERY_FLAG_ORIGINAL_MESSAGE 0x0B                 // Original Message
#define DELIVERY_FLAG_SEQUENCE_NUMBER_RESET_MESSAGE 0x0C    // Sequence Number Reset Message
#define DELIVERY_FLAG_ONE_RETRANSMISSION_PACKET 0x0D        // One Retransmission Packet
#define DELIVERY_FLAG_RETRANSMISSION_SEQUENCE_MESSAGE 0x0F  // Retransmission Sequence Message
#define DELIVERY_FLAG_ONE_REFRESH_PACKET 0x11               // One Refresh Packet
#define DELIVERY_FLAG_REFRESH_SEQUENCE_START 0x12           // Refresh Sequence Start
#define DELIVERY_FLAG_REFRESH_SEQUENCE_MESSAGE 0x13         // Refresh Sequence Message
#define DELIVERY_FLAG_REFRESH_SEQUENCE_END 0x14             // Refresh Sequence End
#define DELIVERY_FLAG_MESSAGE_UNAVAILABLE 0x15              // Message Unavailable

// Message Type: 2 byte code
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x0064                     // Add Order Message
#define MESSAGE_TYPE_MODIFY_ORDER_MESSAGE 0x0065                  // Modify Order Message
#define MESSAGE_TYPE_DELETE_ORDER_MESSAGE 0x0066                  // Delete Order Message
#define MESSAGE_TYPE_EXECUTION_MESSAGE 0x0067                     // Execution Message
#define MESSAGE_TYPE_IMBALANCE_MESSAGE 0x0069                     // Imbalance Message
#define MESSAGE_TYPE_ADD_ORDER_REFRESH_MESSAGE 0x006A             // Add Order Refresh Message
#define MESSAGE_TYPE_ATTRIBUTED_ADD_ORDER_MESSAGE 0x006B          // Attributed Add Order Message
#define MESSAGE_TYPE_ATTRIBUTED_ADD_ORDER_REFRESH_MESSAGE 0x006C  // Attributed Add Order Refresh Message

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Order Idgtc Indicator: one byte code
#define ORDER_IDGTC_INDICATOR_DAY_ORDER 0x00  // Day Order
#define ORDER_IDGTC_INDICATOR_GTC_ORDER 0x01  // Gtc Order

// Trade Session: one byte code
#define TRADE_SESSION_OK_FOR_MORNING_HOURS 0x01                    // Ok For Morning Hours
#define TRADE_SESSION_OK_FOR_NATIONAL_HOURS_CORE 0x02              // Ok For National Hours Core
#define TRADE_SESSION_OK_FOR_MORNING_AND_CORE 0x03                 // Ok For Morning And Core
#define TRADE_SESSION_OK_FOR_LATE_HOURS 0x04                       // Ok For Late Hours
#define TRADE_SESSION_OK_FOR_CORE_AND_LATE 0x06                    // Ok For Core And Late
#define TRADE_SESSION_OK_FOR_MORNING_CORE_AND_LATE 0x07            // Ok For Morning Core And Late
#define TRADE_SESSION_OK_FOR_OVERNIGHT_HOURS 0x08                  // Ok For Overnight Hours
#define TRADE_SESSION_OK_FOR_OVERNIGHT_MORNING_CORE_AND_LATE 0x0F  // Ok For Overnight Morning Core And Late

// Auction Type: one byte code
#define AUCTION_TYPE_EARLY_OPENING_AUCTION 0x4F  // Early Opening Auction
#define AUCTION_TYPE_CORE_OPENING_AUCTION 0x4D   // Core Opening Auction
#define AUCTION_TYPE_TRADING_HALT_AUCTION 0x48   // Trading Halt Auction
#define AUCTION_TYPE_CLOSING_AUCTION 0x43        // Closing Auction

// ---- Types -------------------------------------------------------------------

// The time when this packet was published to the multicast channel
typedef struct _SendTime {
  UINT32 seconds;      // bytes 0 to 3
  UINT32 nanoseconds;  // bytes 4 to 7
} SendTime;

// ArcaBook Add Order Message
typedef struct _AddOrderMessage {
  UINT32 source_time_ns;        // bytes 0 to 3
  UINT32 symbol_index;          // bytes 4 to 7
  UINT32 symbol_seq_num;        // bytes 8 to 11
  UINT32 order_id;              // bytes 12 to 15
  UINT32 price;                 // bytes 16 to 19
  UINT32 volume;                // bytes 20 to 23
  UINT8 side;                   // byte 24
  UINT8 order_idgtc_indicator;  // byte 25
  UINT8 trade_session;          // byte 26
} AddOrderMessage;

// ArcaBook Modify Order Message
typedef struct _ModifyOrderMessage {
  UINT32 source_time_ns;        // bytes 0 to 3
  UINT32 symbol_index;          // bytes 4 to 7
  UINT32 symbol_seq_num;        // bytes 8 to 11
  UINT32 order_id;              // bytes 12 to 15
  UINT32 price;                 // bytes 16 to 19
  UINT32 volume;                // bytes 20 to 23
  UINT8 side;                   // byte 24
  UINT8 order_idgtc_indicator;  // byte 25
  UINT8 reason_code;            // byte 26
} ModifyOrderMessage;

// ArcaBook Delete Order Message
typedef struct _DeleteOrderMessage {
  UINT32 source_time_ns;        // bytes 0 to 3
  UINT32 symbol_index;          // bytes 4 to 7
  UINT32 symbol_seq_num;        // bytes 8 to 11
  UINT32 order_id;              // bytes 12 to 15
  UINT8 side;                   // byte 16
  UINT8 order_idgtc_indicator;  // byte 17
  UINT8 reason_code;            // byte 18
} DeleteOrderMessage;

// ArcaBook Execution Message
typedef struct _ExecutionMessage {
  UINT32 source_time_ns;        // bytes 0 to 3
  UINT32 symbol_index;          // bytes 4 to 7
  UINT32 symbol_seq_num;        // bytes 8 to 11
  UINT32 order_id;              // bytes 12 to 15
  UINT32 price;                 // bytes 16 to 19
  UINT32 volume;                // bytes 20 to 23
  UINT8 order_idgtc_indicator;  // byte 24
  UINT8 reason_code;            // byte 25
  UINT32 trade_id;              // bytes 26 to 29
} ExecutionMessage;

// ArcaBook Imbalance Message
typedef struct _ImbalanceMessage {
  UINT32 source_time;                     // bytes 0 to 3
  UINT32 source_time_ns;                  // bytes 4 to 7
  UINT32 symbol_index;                    // bytes 8 to 11
  UINT32 symbol_seq_num;                  // bytes 12 to 15
  UINT32 indicative_match_price;          // bytes 16 to 19
  UINT32 paired_qty;                      // bytes 20 to 23
  UINT32 total_imbalance_qty;             // bytes 24 to 27
  UINT32 market_imbalance_qty;            // bytes 28 to 31
  UINT16 auction_time;                    // bytes 32 to 33
  UINT8 auction_type;                     // byte 34
  UINT8 imbalance_side;                   // byte 35
  UINT32 continuous_book_clearing_price;  // bytes 36 to 39
  UINT32 closing_only_clearing_price;     // bytes 40 to 43
  UINT32 ssr_filing_price;                // bytes 44 to 47
} ImbalanceMessage;

// ArcaBook Add Order Refresh Message
typedef struct _AddOrderRefreshMessage {
  UINT32 source_time;           // bytes 0 to 3
  UINT32 source_time_ns;        // bytes 4 to 7
  UINT32 symbol_index;          // bytes 8 to 11
  UINT32 symbol_seq_num;        // bytes 12 to 15
  UINT32 order_id;              // bytes 16 to 19
  UINT32 price;                 // bytes 20 to 23
  UINT32 volume;                // bytes 24 to 27
  UINT8 side;                   // byte 28
  UINT8 order_idgtc_indicator;  // byte 29
  UINT8 trade_session;          // byte 30
} AddOrderRefreshMessage;

// ArcaBook Attributed Add Order Message
typedef struct _AttributedAddOrderMessage {
  UINT32 source_time_ns;        // bytes 0 to 3
  UINT32 symbol_index;          // bytes 4 to 7
  UINT32 symbol_seq_num;        // bytes 8 to 11
  UINT32 order_id;              // bytes 12 to 15
  UINT32 price;                 // bytes 16 to 19
  UINT32 volume;                // bytes 20 to 23
  UINT8 side;                   // byte 24
  UINT8 order_idgtc_indicator;  // byte 25
  UINT8 trade_session;          // byte 26
  UINT8 firm_id[5];             // bytes 27 to 31
} AttributedAddOrderMessage;

// ArcaBook Attributed Add Order Refresh Message
typedef struct _AttributedAddOrderRefreshMessage {
  UINT32 source_time;           // bytes 0 to 3
  UINT32 source_time_ns;        // bytes 4 to 7
  UINT32 symbol_index;          // bytes 8 to 11
  UINT32 symbol_seq_num;        // bytes 12 to 15
  UINT32 order_id;              // bytes 16 to 19
  UINT32 price;                 // bytes 20 to 23
  UINT32 volume;                // bytes 24 to 27
  UINT8 side;                   // byte 28
  UINT8 order_idgtc_indicator;  // byte 29
  UINT8 trade_session;          // byte 30
  UINT8 firm_id[5];             // bytes 31 to 35
} AttributedAddOrderRefreshMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0064: AddOrderMessage add_order_message;
    case 0x0065: ModifyOrderMessage modify_order_message;
    case 0x0066: DeleteOrderMessage delete_order_message;
    case 0x0067: ExecutionMessage execution_message;
    case 0x0069: ImbalanceMessage imbalance_message;
    case 0x006A: AddOrderRefreshMessage add_order_refresh_message;
    case 0x006B: AttributedAddOrderMessage attributed_add_order_message;
    case 0x006C: AttributedAddOrderRefreshMessage attributed_add_order_refresh_message;
    default: UINT8 unknown[available];
  }
} Payload;

// ArcaBook message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_size { message_size >= 4 };                                                                                                                       // bytes 0 to 1
  UINT16 message_type;                                                                                                                                             // bytes 2 to 3
  Payload(message_type, (((UINT32) message_size) - 4)) payload[:byte-size-single-element-array (((UINT32) message_size) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ArcaBook message
typedef struct _MessageRun (UINT8 number_msgs, UINT32 available, mutable UINT32 * tally) {
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size available];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) number_msgs); };
} MessageRun;

// Branch
casetype _Messages (UINT8 selector, UINT8 number_msgs, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x01: unit heartbeat;
    default: MessageRun(number_msgs, available, tally) message;
  }
} Messages;

// ---- Packet: Packet ----------------------------------------------------------

// ArcaBook common client udp packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16 pkt_size;                                                                                                           // bytes 0 to 1
  UINT8 delivery_flag;                                                                                                       // byte 2
  UINT8 number_msgs;                                                                                                         // byte 3
  UINT32 seq_num;                                                                                                            // bytes 4 to 7
  SendTime send_time;                                                                                                        // bytes 8 to 15
  Messages(delivery_flag, number_msgs, (available - 16), tally) messages[:byte-size-single-element-array (available - 16)];
} Packet;

