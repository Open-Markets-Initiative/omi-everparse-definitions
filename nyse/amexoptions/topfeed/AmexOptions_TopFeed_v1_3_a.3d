// ---- Underlying Index Mapping Message: 24 bytes ------------------------------

// On system startup, each multicast channel sends all the symbols on its channel. Underlying Index Mapping messages are published first, followed by all Series Index Mapping messages, and for the Complex feed, Complex Symbol Definitions last of all.
entrypoint typedef struct _UnderlyingIndexMappingMessage {
  UINT32 underlying_index;      // bytes 0 to 3
  UINT8 underlying_symbol[11];  // bytes 4 to 14
  UINT8 channel_id;             // byte 15
  UINT16 market_id;             // bytes 16 to 17
  UINT8 system_id;              // byte 18
  UINT8 exchange_code;          // byte 19
  UINT8 price_scale_code;       // byte 20
  UINT8 security_type;          // byte 21
  UINT8 price_resolution;       // byte 22
  UINT8 reserved_1;             // byte 23
} UnderlyingIndexMappingMessage;

// ---- Series Index Mapping Message: 56 bytes ----------------------------------

// On system startup, each multicast channel sends all the symbols on its channel. Underlying Index Mapping messages are published first, followed by all Series Index Mapping messages, and for the Complex feed, Complex Symbol Definitions last of all.
entrypoint typedef struct _SeriesIndexMappingMessage {
  UINT32 series_index;          // bytes 0 to 3
  UINT8 channel_id;             // byte 4
  UINT8 reserved_a_1;           // byte 5
  UINT16 market_id;             // bytes 6 to 7
  UINT8 system_id;              // byte 8
  UINT8 reserved_b_1;           // byte 9
  UINT16 stream_id;             // bytes 10 to 11
  UINT32 underlying_index;      // bytes 12 to 15
  UINT16 contract_multiplier;   // bytes 16 to 17
  UINT8 maturity_date[6];       // bytes 18 to 23
  UINT8 put_or_call;            // byte 24
  UINT8 strike_price[10];       // bytes 25 to 34
  UINT8 price_scale_code;       // byte 35
  UINT8 underlying_symbol[11];  // bytes 36 to 46
  UINT8 option_symbol_root[5];  // bytes 47 to 51
  UINT32 group_id;              // bytes 52 to 55
} SeriesIndexMappingMessage;

// ---- Stream Id Message: 4 bytes ----------------------------------------------

// In all multicast channels, a Stream ID Message is sent immediately after each packet header to uniquely identify the source or Stream ID of the data in the packet.
entrypoint typedef struct _StreamIdMessage {
  UINT16 stream_id;     // bytes 0 to 1
  UINT8 reserved_2[2];  // bytes 2 to 3
} StreamIdMessage;

// ---- Sequence Number Reset Message: 10 bytes ---------------------------------

// This message is sent to reset the Message Sequence Number at start of day, or in response to failures.
entrypoint typedef struct _SequenceNumberResetMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT8 product_id;       // byte 8
  UINT8 channel_id;       // byte 9
} SequenceNumberResetMessage;

