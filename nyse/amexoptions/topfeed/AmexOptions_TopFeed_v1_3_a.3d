// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AmexOptions_TopFeed_v1_3_a.3d

// ---- Values ------------------------------------------------------------------

// Delivery Flag: one byte code
#define DELIVERY_FLAG_HEARTBEAT 0x01                           // Heartbeat
#define DELIVERY_FLAG_CONTAINS_ORIGINAL_AND_REFRESH_MSGS 0x02  // Contains Original And Refresh Msgs
#define DELIVERY_FLAG_CONTAINS_ONLY_REFRESH_MESSAGES 0x03      // Contains Only Refresh Messages
#define DELIVERY_FLAG_X_D_P_FAILOVER 0x0A                      // XDP Failover
#define DELIVERY_FLAG_CONTAINS_ONLY_ORIGINAL_MESSAGES 0x0B     // Contains Only Original Messages
#define DELIVERY_FLAG_SEQUENCE_NUMBER_RESET_MESSAGE 0x0C       // Sequence Number Reset Message

// Message Type: 2 byte code
#define MESSAGE_TYPE_OUTRIGHT_QUOTE_MESSAGE 0x0191              // Outright Quote Message
#define MESSAGE_TYPE_OUTRIGHT_TRADE_MESSAGE 0x0197              // Outright Trade Message
#define MESSAGE_TYPE_OUTRIGHT_TRADE_CANCEL_MESSAGE 0x0199       // Outright Trade Cancel Message
#define MESSAGE_TYPE_OUTRIGHT_TRADE_CORRECTION_MESSAGE 0x019B   // Outright Trade Correction Message
#define MESSAGE_TYPE_OUTRIGHT_IMBALANCE_MESSAGE 0x019D          // Outright Imbalance Message
#define MESSAGE_TYPE_OUTRIGHT_CROSSING_RFQ_MESSAGE 0x019F       // Outright Crossing Rfq Message
#define MESSAGE_TYPE_OUTRIGHT_BOLD_RFQ_MESSAGE 0x01D7           // Outright Bold Rfq Message
#define MESSAGE_TYPE_OUTRIGHT_SUMMARY_MESSAGE 0x01A1            // Outright Summary Message
#define MESSAGE_TYPE_UNDERLYING_STATUS_MESSAGE 0x01A3           // Underlying Status Message
#define MESSAGE_TYPE_OUTRIGHT_SERIES_STATUS_MESSAGE 0x01A5      // Outright Series Status Message
#define MESSAGE_TYPE_REFRESH_OUTRIGHT_QUOTE_MESSAGE 0x01F5      // Refresh Outright Quote Message
#define MESSAGE_TYPE_REFRESH_OUTRIGHT_TRADE_MESSAGE 0x01FB      // Refresh Outright Trade Message
#define MESSAGE_TYPE_REFRESH_OUTRIGHT_IMBALANCE_MESSAGE 0x01FD  // Refresh Outright Imbalance Message
#define MESSAGE_TYPE_UNDERLYING_INDEX_MAPPING_MESSAGE 0x01B3    // Underlying Index Mapping Message
#define MESSAGE_TYPE_SERIES_INDEX_MAPPING_MESSAGE 0x01B5        // Series Index Mapping Message
#define MESSAGE_TYPE_STREAM_ID_MESSAGE 0x01C7                   // Stream Id Message
#define MESSAGE_TYPE_SEQUENCE_NUMBER_RESET_MESSAGE 0x0001       // Sequence Number Reset Message

// Quote Condition: one byte code
#define QUOTE_CONDITION_REGULAR_TRADING 0x31                     // Regular Trading
#define QUOTE_CONDITION_ROTATION 0x32                            // Rotation
#define QUOTE_CONDITION_TRADING_HALTED 0x33                      // Trading Halted
#define QUOTE_CONDITION_PRE_OPEN 0x34                            // Pre Open
#define QUOTE_CONDITION_ROTATION_LEGAL_WIDTH_QUOTE_PENDING 0x35  // Rotation Legal Width Quote Pending

// Trade Cond 1: one byte code
#define TRADE_COND_1_REGULAR_TRADE 0x20      // Regular Trade
#define TRADE_COND_1_LATE_REPORT 0x49        // Late Report
#define TRADE_COND_1_FLOOR_TRADE 0x52        // Floor Trade
#define TRADE_COND_1_I_S_O_SWEEP_TRADE 0x53  // ISO Sweep Trade

// Trade Cond 2: one byte code
#define TRADE_COND_2_COMPLEX_TRADE_WITH_EQUITY_TRADE 0x50  // Complex Trade With Equity Trade
#define TRADE_COND_2_COMPLEX_TRADE 0x4C                    // Complex Trade

// Auction Type: one byte code
#define AUCTION_TYPE_OPENING 0x4F  // Opening
#define AUCTION_TYPE_HALT 0x48     // Halt

// Imbalance Side: one byte code
#define IMBALANCE_SIDE_BUY 0x42           // Buy
#define IMBALANCE_SIDE_SELL 0x53          // Sell
#define IMBALANCE_SIDE_NO_IMBALANCE 0x20  // No Imbalance

// Market Imbalance Side: one byte code
#define MARKET_IMBALANCE_SIDE_BUY 0x42           // Buy
#define MARKET_IMBALANCE_SIDE_SELL 0x53          // Sell
#define MARKET_IMBALANCE_SIDE_NO_IMBALANCE 0x20  // No Imbalance

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Capacity: one byte code
#define CAPACITY_NOT_SPECIFIED 0x20          // Not Specified
#define CAPACITY_CUSTOMER 0x30               // Customer
#define CAPACITY_FIRM 0x31                   // Firm
#define CAPACITY_BROKER_DEALER 0x32          // Broker Dealer
#define CAPACITY_MARKET_MAKER 0x33           // Market Maker
#define CAPACITY_PROFESSIONAL_CUSTOMER 0x38  // Professional Customer

// Security Status: one byte code
#define SECURITY_STATUS_LIGHT_UP_A_DARK_SERIES 0x4C  // Light Up A Dark Series
#define SECURITY_STATUS_OPEN_A_DARK_SERIES 0x4E      // Open A Dark Series
#define SECURITY_STATUS_OPEN 0x4F                    // Open
#define SECURITY_STATUS_CLOSE 0x58                   // Close
#define SECURITY_STATUS_HALT 0x53                    // Halt
#define SECURITY_STATUS_UNHALT 0x55                  // Unhalt
#define SECURITY_STATUS_UNHALT_A_DARK_SERIES 0x54    // Unhalt A Dark Series
#define SECURITY_STATUS_END_OF_RFQ_AUCTION 0x51      // End Of Rfq Auction

// Market Id: 2 byte code
#define MARKET_ID_NYSE_CASH 0x0001              // Nyse Cash
#define MARKET_ID_EUROPE_CASH 0x0002            // Europe Cash
#define MARKET_ID_NYSE_ARCA_CASH 0x0003         // Nyse Arca Cash
#define MARKET_ID_NYSE_ARCA_OPTIONS 0x0004      // Nyse Arca Options
#define MARKET_ID_NYSE_ARCA_BONDS 0x0005        // Nyse Arca Bonds
#define MARKET_ID_ARCA_EDGE 0x0006              // Arca Edge
#define MARKET_ID_LIFFE 0x0007                  // Liffe
#define MARKET_ID_NYSE_AMERICAN_OPTIONS 0x0008  // Nyse American Options
#define MARKET_ID_NYSE_MKT_CASH 0x0009          // Nyse Mkt Cash

// Exchange Code: one byte code
#define EXCHANGE_CODE_NYSE 0x4E                         // Nyse
#define EXCHANGE_CODE_NYSE_ARCA 0x50                    // Nyse Arca
#define EXCHANGE_CODE_NASDAQ 0x51                       // Nasdaq
#define EXCHANGE_CODE_NYSE_MKT 0x41                     // Nyse Mkt
#define EXCHANGE_CODE_GLOBAL_OTC 0x31                   // Global Otc
#define EXCHANGE_CODE_ARCA_LOCAL_NON_TAPE_B_INDEX 0x32  // Arca Local Non Tape B Index

// Security Type: one byte code
#define SECURITY_TYPE_ADR 0x41                             // Adr
#define SECURITY_TYPE_COMMON_STOCK 0x43                    // Common Stock
#define SECURITY_TYPE_DEBENTURES 0x44                      // Debentures
#define SECURITY_TYPE_ETF 0x45                             // Etf
#define SECURITY_TYPE_FOREIGN 0x46                         // Foreign
#define SECURITY_TYPE_AMERICAN_DEPOSITORY_SHARES 0x48      // American Depository Shares
#define SECURITY_TYPE_UNITS 0x49                           // Units
#define SECURITY_TYPE_MISCLIQUID_TRUST 0x4D                // Miscliquid Trust
#define SECURITY_TYPE_ORDINARY_SHARES 0x4F                 // Ordinary Shares
#define SECURITY_TYPE_PREFERRED_STOCK 0x50                 // Preferred Stock
#define SECURITY_TYPE_RIGHTS 0x52                          // Rights
#define SECURITY_TYPE_SHARES_OF_BENEFICIARY_INTEREST 0x53  // Shares Of Beneficiary Interest
#define SECURITY_TYPE_TEST 0x54                            // Test
#define SECURITY_TYPE_CLOSED_END_FUND 0x55                 // Closed End Fund
#define SECURITY_TYPE_WARRANT 0x57                         // Warrant
#define SECURITY_TYPE_INDEX 0x58                           // Index

// Price Resolution: one byte code
#define PRICE_RESOLUTION_ALL_PENNY 0x00     // All Penny
#define PRICE_RESOLUTION_PENNY_NICKEL 0x01  // Penny Nickel
#define PRICE_RESOLUTION_NICKEL_DIME 0x05   // Nickel Dime

// Put Or Call: one byte code
#define PUT_OR_CALL_PUT 0x00   // Put
#define PUT_OR_CALL_CALL 0x01  // Call

// ---- Types -------------------------------------------------------------------

// The time when this packet was published to the multicast channel
typedef struct _SendTime {
  UINT32 seconds;      // bytes 0 to 3
  UINT32 nanoseconds;  // bytes 4 to 7
} SendTime;

// The Outright Quote message provides the price and aggregated volume for the best bid and best offer. Volumes aggregate quote and order interest. The message also indicates aggregated Customer volumes within the overall volumes.
typedef struct _OutrightQuoteMessage {
  UINT32 source_time;          // bytes 0 to 3
  UINT32 source_time_ns;       // bytes 4 to 7
  UINT32 series_index;         // bytes 8 to 11
  UINT32 symbol_seq_num;       // bytes 12 to 15
  UINT32 ask_price;            // bytes 16 to 19, signed, read here as unsigned
  UINT32 bid_price;            // bytes 20 to 23, signed, read here as unsigned
  UINT16 ask_volume;           // bytes 24 to 25
  UINT16 bid_volume;           // bytes 26 to 27
  UINT16 ask_customer_volume;  // bytes 28 to 29
  UINT16 bid_customer_volume;  // bytes 30 to 31
  UINT8 quote_condition;       // byte 32
  UINT8 reserved_1;            // byte 33
  UINT8 reserved_2[2];         // bytes 34 to 35
} OutrightQuoteMessage;

// The Outright Trade message is used to publish all Last Sales for outright symbols.
typedef struct _OutrightTradeMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT32 series_index;    // bytes 8 to 11
  UINT32 symbol_seq_num;  // bytes 12 to 15
  UINT32 trade_id;        // bytes 16 to 19
  UINT32 price;           // bytes 20 to 23, signed, read here as unsigned
  UINT32 volume_4;        // bytes 24 to 27
  UINT8 trade_cond_1;     // byte 28
  UINT8 trade_cond_2;     // byte 29
  UINT8 reserved_2[2];    // bytes 30 to 31
} OutrightTradeMessage;

// The Trade Cancel message is used to cancel or bust a trade.
typedef struct _OutrightTradeCancelMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 series_index;       // bytes 8 to 11
  UINT32 symbol_seq_num;     // bytes 12 to 15
  UINT32 original_trade_id;  // bytes 16 to 19
} OutrightTradeCancelMessage;

// The Trade Correction message is used to correct a trade.
typedef struct _OutrightTradeCorrectionMessage {
  UINT32 source_time;        // bytes 0 to 3
  UINT32 source_time_ns;     // bytes 4 to 7
  UINT32 series_index;       // bytes 8 to 11
  UINT32 symbol_seq_num;     // bytes 12 to 15
  UINT32 original_trade_id;  // bytes 16 to 19
  UINT32 trade_id;           // bytes 20 to 23
  UINT32 price;              // bytes 24 to 27, signed, read here as unsigned
  UINT32 volume_4;           // bytes 28 to 31
  UINT8 trade_cond_1;        // byte 32
  UINT8 trade_cond_2;        // byte 33
  UINT8 reserved_2[2];       // bytes 34 to 35
} OutrightTradeCorrectionMessage;

// The Outright Imbalance message is sent during the Pre-opening phase or a symbol Halt to provide indicative opening price and net imbalance of all orders at that price which are orders eligible for next Auction.
typedef struct _OutrightImbalanceMessage {
  UINT32 source_time;           // bytes 0 to 3
  UINT32 source_time_ns;        // bytes 4 to 7
  UINT32 series_index;          // bytes 8 to 11
  UINT32 symbol_seq_num;        // bytes 12 to 15
  UINT32 reference_price;       // bytes 16 to 19, signed, read here as unsigned
  UINT16 paired_qty;            // bytes 20 to 21
  UINT16 total_imbalance_qty;   // bytes 22 to 23
  UINT16 market_imbalance_qty;  // bytes 24 to 25
  UINT8 auction_type;           // byte 26
  UINT8 imbalance_side;         // byte 27
  UINT8 market_imbalance_side;  // byte 28
  UINT8 reserved_3[3];          // bytes 29 to 31
} OutrightImbalanceMessage;

// The Outright Crossing RFQ (Request for Quote) message is sent out in the event of an auction on an outright order.
typedef struct _OutrightCrossingRfqMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_ns;       // bytes 4 to 7
  UINT32 series_index;    // bytes 8 to 11
  UINT32 symbol_seq_num;  // bytes 12 to 15
  UINT8 side;             // byte 16
  UINT8 reserved_1;       // byte 17
  UINT16 volume_2;        // bytes 18 to 19
  UINT32 price;           // bytes 20 to 23, signed, read here as unsigned
} OutrightCrossingRfqMessage;

// The Outright BOLD RFQ (Request for Quote) message notifies clients of a special exposure order (a BOLD order) available for execution on a first-come first-served basis.
typedef struct _OutrightBoldRfqMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_ns;       // bytes 4 to 7
  UINT32 series_index;    // bytes 8 to 11
  UINT32 symbol_seq_num;  // bytes 12 to 15
  UINT8 side;             // byte 16
  UINT8 capacity;         // byte 17
  UINT16 contracts;       // bytes 18 to 19
  UINT32 price;           // bytes 20 to 23, signed, read here as unsigned
  UINT8 participant[4];   // bytes 24 to 27
} OutrightBoldRfqMessage;

// The Outright summary message provides trading highlights of the day. It is sent out once at the end of the trading day as soon as a symbol closes.
typedef struct _OutrightSummaryMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT32 series_index;    // bytes 8 to 11
  UINT32 symbol_seq_num;  // bytes 12 to 15
  UINT32 high_price;      // bytes 16 to 19, signed, read here as unsigned
  UINT32 low_price;       // bytes 20 to 23, signed, read here as unsigned
  UINT32 open_;           // bytes 24 to 27, signed, read here as unsigned
  UINT32 close;           // bytes 28 to 31, signed, read here as unsigned
  UINT32 total_volume;    // bytes 32 to 35
} OutrightSummaryMessage;

// The Underlying Status message is used to inform the subscribers of changes in the status of an Underlying symbol.
typedef struct _UnderlyingStatusMessage {
  UINT32 source_time;         // bytes 0 to 3
  UINT32 source_time_ns;      // bytes 4 to 7
  UINT32 underlying_index;    // bytes 8 to 11
  UINT32 underlying_seq_num;  // bytes 12 to 15
  UINT8 security_status;      // byte 16
  UINT8 halt_condition;       // byte 17
  UINT8 reserved_2[2];        // bytes 18 to 19
} UnderlyingStatusMessage;

// The Series Status message is used to inform the subscribers of changes in symbol status of an outright symbol.
typedef struct _OutrightSeriesStatusMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT32 series_index;    // bytes 8 to 11
  UINT32 symbol_seq_num;  // bytes 12 to 15
  UINT8 security_status;  // byte 16
  UINT8 halt_condition;   // byte 17
  UINT8 reserved_2[2];    // bytes 18 to 19
} OutrightSeriesStatusMessage;

// The Refresh Quote message is sent in the event no quote messages are published for the symbol for 2 consecutive minutes.
typedef struct _RefreshOutrightQuoteMessage {
  UINT32 source_time;          // bytes 0 to 3
  UINT32 source_time_ns;       // bytes 4 to 7
  UINT32 series_index;         // bytes 8 to 11
  UINT32 symbol_seq_num;       // bytes 12 to 15
  UINT32 ask_price;            // bytes 16 to 19, signed, read here as unsigned
  UINT32 bid_price;            // bytes 20 to 23, signed, read here as unsigned
  UINT16 ask_volume;           // bytes 24 to 25
  UINT16 bid_volume;           // bytes 26 to 27
  UINT16 ask_customer_volume;  // bytes 28 to 29
  UINT16 bid_customer_volume;  // bytes 30 to 31
  UINT8 quote_condition;       // byte 32
  UINT8 reserved_1;            // byte 33
  UINT8 reserved_2[2];         // bytes 34 to 35
} RefreshOutrightQuoteMessage;

// The Refresh Outright Trade message is sent in the event no Outright Trade messages are published for the symbol for 2 consecutive minutes.
typedef struct _RefreshOutrightTradeMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT32 series_index;    // bytes 8 to 11
  UINT32 symbol_seq_num;  // bytes 12 to 15
  UINT32 trade_id;        // bytes 16 to 19
  UINT32 price;           // bytes 20 to 23, signed, read here as unsigned
  UINT32 volume_4;        // bytes 24 to 27
  UINT8 trade_cond_1;     // byte 28
  UINT8 trade_cond_2;     // byte 29
  UINT8 reserved_2[2];    // bytes 30 to 31
} RefreshOutrightTradeMessage;

// The Refresh Outright Imbalance message is sent in the event no Outright Imbalance messages are published for the symbol for 2 consecutive minutes during Pre-opening or a symbol Halt.
typedef struct _RefreshOutrightImbalanceMessage {
  UINT32 source_time;           // bytes 0 to 3
  UINT32 source_time_ns;        // bytes 4 to 7
  UINT32 series_index;          // bytes 8 to 11
  UINT32 symbol_seq_num;        // bytes 12 to 15
  UINT32 reference_price;       // bytes 16 to 19, signed, read here as unsigned
  UINT16 paired_qty;            // bytes 20 to 21
  UINT16 total_imbalance_qty;   // bytes 22 to 23
  UINT16 market_imbalance_qty;  // bytes 24 to 25
  UINT8 auction_type;           // byte 26
  UINT8 imbalance_side;         // byte 27
  UINT8 market_imbalance_side;  // byte 28
  UINT8 reserved_3[3];          // bytes 29 to 31
} RefreshOutrightImbalanceMessage;

// On system startup, each multicast channel sends all the symbols on its channel. Underlying Index Mapping messages are published first, followed by all Series Index Mapping messages, and for the Complex feed, Complex Symbol Definitions last of all.
typedef struct _UnderlyingIndexMappingMessage {
  UINT32 underlying_index;      // bytes 0 to 3
  UINT8 underlying_symbol[11];  // bytes 4 to 14
  UINT8 channel_id;             // byte 15
  UINT16 market_id;             // bytes 16 to 17
  UINT8 system_id;              // byte 18
  UINT8 exchange_code;          // byte 19
  UINT8 price_scale_code;       // byte 20
  UINT8 security_type;          // byte 21
  UINT8 price_resolution;       // byte 22
  UINT8 reserved_1;             // byte 23
} UnderlyingIndexMappingMessage;

// On system startup, each multicast channel sends all the symbols on its channel. Underlying Index Mapping messages are published first, followed by all Series Index Mapping messages, and for the Complex feed, Complex Symbol Definitions last of all.
typedef struct _SeriesIndexMappingMessage {
  UINT32 series_index;          // bytes 0 to 3
  UINT8 channel_id;             // byte 4
  UINT8 reserved_a_1;           // byte 5
  UINT16 market_id;             // bytes 6 to 7
  UINT8 system_id;              // byte 8
  UINT8 reserved_b_1;           // byte 9
  UINT16 stream_id;             // bytes 10 to 11
  UINT32 underlying_index;      // bytes 12 to 15
  UINT16 contract_multiplier;   // bytes 16 to 17
  UINT8 maturity_date[6];       // bytes 18 to 23
  UINT8 put_or_call;            // byte 24
  UINT8 strike_price[10];       // bytes 25 to 34
  UINT8 price_scale_code;       // byte 35
  UINT8 underlying_symbol[11];  // bytes 36 to 46
  UINT8 option_symbol_root[5];  // bytes 47 to 51
  UINT32 group_id;              // bytes 52 to 55
} SeriesIndexMappingMessage;

// In all multicast channels, a Stream ID Message is sent immediately after each packet header to uniquely identify the source or Stream ID of the data in the packet.
typedef struct _StreamIdMessage {
  UINT16 stream_id;     // bytes 0 to 1
  UINT8 reserved_2[2];  // bytes 2 to 3
} StreamIdMessage;

// This message is sent to reset the Message Sequence Number at start of day, or in response to failures.
typedef struct _SequenceNumberResetMessage {
  UINT32 source_time;     // bytes 0 to 3
  UINT32 source_time_ns;  // bytes 4 to 7
  UINT8 product_id;       // byte 8
  UINT8 channel_id;       // byte 9
  UINT8 reserved_2[2];    // bytes 10 to 11
} SequenceNumberResetMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0191: OutrightQuoteMessage outright_quote_message;
    case 0x0197: OutrightTradeMessage outright_trade_message;
    case 0x0199: OutrightTradeCancelMessage outright_trade_cancel_message;
    case 0x019B: OutrightTradeCorrectionMessage outright_trade_correction_message;
    case 0x019D: OutrightImbalanceMessage outright_imbalance_message;
    case 0x019F: OutrightCrossingRfqMessage outright_crossing_rfq_message;
    case 0x01D7: OutrightBoldRfqMessage outright_bold_rfq_message;
    case 0x01A1: OutrightSummaryMessage outright_summary_message;
    case 0x01A3: UnderlyingStatusMessage underlying_status_message;
    case 0x01A5: OutrightSeriesStatusMessage outright_series_status_message;
    case 0x01F5: RefreshOutrightQuoteMessage refresh_outright_quote_message;
    case 0x01FB: RefreshOutrightTradeMessage refresh_outright_trade_message;
    case 0x01FD: RefreshOutrightImbalanceMessage refresh_outright_imbalance_message;
    case 0x01B3: UnderlyingIndexMappingMessage underlying_index_mapping_message;
    case 0x01B5: SeriesIndexMappingMessage series_index_mapping_message;
    case 0x01C7: StreamIdMessage stream_id_message;
    case 0x0001: SequenceNumberResetMessage sequence_number_reset_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_size { message_size >= 4 };                                                                                                                       // bytes 0 to 1
  UINT16 message_type;                                                                                                                                             // bytes 2 to 3
  Payload(message_type, (((UINT32) message_size) - 4)) payload[:byte-size-single-element-array (((UINT32) message_size) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Xdp Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16 packet_size;                                                                                                       // bytes 0 to 1
  UINT8 delivery_flag;                                                                                                      // byte 2
  UINT8 message_count;                                                                                                      // byte 3
  UINT32 sequence_number;                                                                                                   // bytes 4 to 7
  SendTime send_time;                                                                                                       // bytes 8 to 15
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 16)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} Packet;

