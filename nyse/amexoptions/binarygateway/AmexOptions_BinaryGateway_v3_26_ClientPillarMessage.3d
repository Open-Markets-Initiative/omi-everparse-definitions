// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPillarMessage, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out AmexOptions_BinaryGateway_v3_26_ClientPillarMessage.3d

// ---- Values ------------------------------------------------------------------

// Msg Type: 2 byte code
#define MSG_TYPE_LOGIN 0x0201           // Login
#define MSG_TYPE_LOGIN_RESPONSE 0x0202  // Login Response
#define MSG_TYPE_STREAM_AVAIL 0x0203    // Stream Avail
#define MSG_TYPE_HEARTBEAT 0x0204       // Heartbeat
#define MSG_TYPE_OPEN 0x0205            // Open
#define MSG_TYPE_OPEN_RESPONSE 0x0206   // Open Response
#define MSG_TYPE_CLOSE 0x0207           // Close
#define MSG_TYPE_CLOSE_RESPONSE 0x0208  // Close Response
#define MSG_TYPE_SEQ_MSG 0x0905         // Seq Msg

// Seq Msg Type: 2 byte code
#define SEQ_MSG_TYPE_SESSION_CONFIGURATION_REQUEST_MESSAGE 0x0220                                        // Session Configuration Request Message
#define SEQ_MSG_TYPE_SEQUENCED_FILLER_MESSAGE 0x0282                                                     // Sequenced Filler Message
#define SEQ_MSG_TYPE_NEW_ORDER_MESSAGE 0x0248                                                            // New Order Message
#define SEQ_MSG_TYPE_ORDER_CANCEL_REQUEST_MESSAGE 0x0250                                                 // Order Cancel Request Message
#define SEQ_MSG_TYPE_ORDER_MODIFY_REQUEST_MESSAGE 0x0251                                                 // Order Modify Request Message
#define SEQ_MSG_TYPE_NEW_BULK_QUOTE_TYPE_243_MESSAGE 0x0243                                              // New Bulk Quote Type 243 Message
#define SEQ_MSG_TYPE_NEW_BULK_QUOTE_TYPE_259_MESSAGE 0x0259                                              // New Bulk Quote Type 259 Message
#define SEQ_MSG_TYPE_NEW_ORDER_CROSS_MESSAGE 0x0222                                                      // New Order Cross Message
#define SEQ_MSG_TYPE_BULK_CANCEL_REQUEST_TYPE_223_MESSAGE 0x0223                                         // Bulk Cancel Request Type 223 Message
#define SEQ_MSG_TYPE_BULK_CANCEL_REQUEST_TYPE_224_MESSAGE 0x0224                                         // Bulk Cancel Request Type 224 Message
#define SEQ_MSG_TYPE_RISK_LIMIT_UPDATE_REQUEST_MESSAGE 0x0330                                            // Risk Limit Update Request Message
#define SEQ_MSG_TYPE_RISK_ACTION_REQUEST_MESSAGE 0x0331                                                  // Risk Action Request Message
#define SEQ_MSG_TYPE_NEW_COMPLEX_SERIES_REQUEST_MESSAGE 0x0357                                           // New Complex Series Request Message
#define SEQ_MSG_TYPE_UNDERLYING_SYMBOL_REFERENCE_DATA_MESSAGE 0x0233                                     // Underlying Symbol Reference Data Message
#define SEQ_MSG_TYPE_SERIES_REFERENCE_DATA_MESSAGE 0x0234                                                // Series Reference Data Message
#define SEQ_MSG_TYPE_MINIMUM_PRICE_VARIANT_CLASS_REFERENCE_DATA_MESSAGE 0x0230                           // Minimum Price Variant Class Reference Data Message
#define SEQ_MSG_TYPE_MINIMUM_PRICE_VARIANT_LEVEL_REFERENCE_DATA_MESSAGE 0x0231                           // Minimum Price Variant Level Reference Data Message
#define SEQ_MSG_TYPE_MPID_CONFIGURATION_MESSAGE 0x0272                                                   // Mpid Configuration Message
#define SEQ_MSG_TYPE_OPTIONS_MARKET_MAKER_SYMBOL_APPOINTMENT_REFERENCE_DATA_MESSAGE 0x0833               // Options Market Maker Symbol Appointment Reference Data Message
#define SEQ_MSG_TYPE_SESSION_CONFIGURATION_ACKNOWLEDGEMENT_MESSAGE 0x0221                                // Session Configuration Acknowledgement Message
#define SEQ_MSG_TYPE_ORDER_AND_CANCEL_REPLACE_ACKNOWLEDGEMENT_MESSAGE 0x0269                             // Order And Cancel Replace Acknowledgement Message
#define SEQ_MSG_TYPE_BULK_QUOTE_ACKNOWLEDGMENT_TYPE_294_MESSAGE 0x0294                                   // Bulk Quote Acknowledgment Type 294 Message
#define SEQ_MSG_TYPE_BULK_QUOTE_ACKNOWLEDGMENT_MESSAGE 0x0308                                            // Bulk Quote Acknowledgment Message
#define SEQ_MSG_TYPE_ORDER_SINGLE_COMPLEX_MODIFY_CANCEL_REQUEST_ACKNOWLEDGMENT_AND_UROUT_MESSAGE 0x0278  // Order Single Complex Modify Cancel Request Acknowledgment And Urout Message
#define SEQ_MSG_TYPE_ORDER_PRIORITY_UPDATE_ACKNOWLEDGMENT_MESSAGE 0x0268                                 // Order Priority Update Acknowledgment Message
#define SEQ_MSG_TYPE_EXECUTION_REPORT_MESSAGE 0x0295                                                     // Execution Report Message
#define SEQ_MSG_TYPE_TRADE_BUST_CORRECT_MESSAGE 0x0293                                                   // Trade Bust Correct Message
#define SEQ_MSG_TYPE_APPLICATION_LAYER_REJECT_MESSAGE 0x0267                                             // Application Layer Reject Message
#define SEQ_MSG_TYPE_RISK_CONTROL_ACKNOWLEDGEMENT_MESSAGE 0x0332                                         // Risk Control Acknowledgement Message
#define SEQ_MSG_TYPE_RISK_CONTROL_ALERT_MESSAGE 0x0333                                                   // Risk Control Alert Message
#define SEQ_MSG_TYPE_COMPLEX_SERIES_REQUEST_ACKNOWLEDGEMENT_MESSAGE 0x0358                               // Complex Series Request Acknowledgement Message

// Cancel On Disconnect: one byte code
#define CANCEL_ON_DISCONNECT_CANCEL_DAY_ORDERS 0x01  // Cancel Day Orders
#define CANCEL_ON_DISCONNECT_CANCEL_ALL_ORDERS 0x02  // Cancel All Orders

// Throttle Preference: one byte code
#define THROTTLE_PREFERENCE_QUEUE_WHEN_THROTTLED 0x00   // Queue When Throttled
#define THROTTLE_PREFERENCE_REJECT_WHEN_THROTTLED 0x01  // Reject When Throttled

// Self Trade Prevention: one byte code
#define SELF_TRADE_PREVENTION_NO_SELF_TRADE_PREVENTION 0x01  // No Self Trade Prevention
#define SELF_TRADE_PREVENTION_CANCEL_NEWEST 0x02             // Cancel Newest
#define SELF_TRADE_PREVENTION_CANCEL_OLDEST 0x03             // Cancel Oldest
#define SELF_TRADE_PREVENTION_CANCEL_BOTH 0x04               // Cancel Both

// Order Priority Update Ack Subscription: one byte code
#define ORDER_PRIORITY_UPDATE_ACK_SUBSCRIPTION_NOT_SUBSCRIBED 0x00                       // Not Subscribed
#define ORDER_PRIORITY_UPDATE_ACK_SUBSCRIPTION_ORDER_PRIORITY_UPDATE_ONLY 0x01           // Order Priority Update Only
#define ORDER_PRIORITY_UPDATE_ACK_SUBSCRIPTION_ORDER_PRIORITY_UPDATE_AND_REPRICING 0x02  // Order Priority Update And Repricing

// Bold Designation: one byte code
#define BOLD_DESIGNATION_NOT_APPLICABLE 0x00                                 // Not Applicable
#define BOLD_DESIGNATION_EXPOSE_ORDER_INFO_ONLY 0x04                         // Expose Order Info Only
#define BOLD_DESIGNATION_EXPOSE_ORDER_INFO_AND_CAPACITY 0x05                 // Expose Order Info And Capacity
#define BOLD_DESIGNATION_EXPOSE_ORDER_INFO_AND_PARTICIPANT_ID 0x06           // Expose Order Info And Participant Id
#define BOLD_DESIGNATION_EXPOSE_ORDER_INFO_CAPACITY_AND_PARTICIPANT_ID 0x07  // Expose Order Info Capacity And Participant Id
#define BOLD_DESIGNATION_NO_BOLD_DEFAULTING 0x08                             // No Bold Defaulting

// Leg Open Close: 8 byte code
#define LEG_OPEN_CLOSE_OPEN 0x0000000000000000   // Open
#define LEG_OPEN_CLOSE_CLOSE 0x0000000000000001  // Close

// Side U 81: one byte code
#define SIDE_U_81_NO_CHANGE_IN_SIDE 0x00  // No Change In Side
#define SIDE_U_81_BUY 0x01                // Buy
#define SIDE_U_81_SELL 0x02               // Sell

// Locate Reqd U 81: one byte code
#define LOCATE_REQD_U_81_NO_LOCATE_REQD 0x00  // No Locate Reqd

// Self Trade Type U 81: one byte code
#define SELF_TRADE_TYPE_U_81_USE_SESSION_CONFIGURATION 0x00  // Use Session Configuration
#define SELF_TRADE_TYPE_U_81_NO_SELF_TRADE_PREVENTION 0x01   // No Self Trade Prevention
#define SELF_TRADE_TYPE_U_81_CANCEL_NEWEST 0x02              // Cancel Newest
#define SELF_TRADE_TYPE_U_81_CANCEL_OLDEST 0x03              // Cancel Oldest
#define SELF_TRADE_TYPE_U_81_CANCEL_BOTH 0x04                // Cancel Both

// Bulk Action: one byte code
#define BULK_ACTION_NOT_APPLICABLE 0x00             // Not Applicable
#define BULK_ACTION_CANCEL_SINGLE_LEG_ONLY 0x01     // Cancel Single Leg Only
#define BULK_ACTION_CANCEL_COMPLEX_ONLY 0x02        // Cancel Complex Only
#define BULK_ACTION_CANCEL_SINGLE_AND_COMPLEX 0x03  // Cancel Single And Complex
#define BULK_ACTION_BLOCK_AND_CANCEL 0x04           // Block And Cancel
#define BULK_ACTION_UNBLOCK 0x05                    // Unblock

// Cancel Scope: one byte code
#define CANCEL_SCOPE_ORDERS_ONLY 0x00        // Orders Only
#define CANCEL_SCOPE_QUOTES_ONLY 0x01        // Quotes Only
#define CANCEL_SCOPE_ORDERS_AND_QUOTES 0x02  // Orders And Quotes

// Risk User Type: one byte code
#define RISK_USER_TYPE_ENTERING_FIRM 0x45              // Entering Firm
#define RISK_USER_TYPE_CLEARING_FIRM 0x43              // Clearing Firm
#define RISK_USER_TYPE_OPTIONS_MARKET_MAKER_FIRM 0x4F  // Options Market Maker Firm

// Risk Control Type: one byte code
#define RISK_CONTROL_TYPE_NOT_APPLICABLE 0x00                                   // Not Applicable
#define RISK_CONTROL_TYPE_SINGLE_ORDER_MAX_QTY 0x01                             // Single Order Max Qty
#define RISK_CONTROL_TYPE_SINGLE_ORDER_MAX_NOTIONAL 0x02                        // Single Order Max Notional
#define RISK_CONTROL_TYPE_GROSS_CREDIT_EXECUTED 0x03                            // Gross Credit Executed
#define RISK_CONTROL_TYPE_GROSS_CREDIT_OPEN 0x04                                // Gross Credit Open
#define RISK_CONTROL_TYPE_GROSS_CREDIT_OPEN_AND_EXECUTED 0x05                   // Gross Credit Open And Executed
#define RISK_CONTROL_TYPE_MAXIMUM_DUPLICATIVE_ORDERS 0x06                       // Maximum Duplicative Orders
#define RISK_CONTROL_TYPE_ACTIVITY_ROLLING_TRANSACTION 0x08                     // Activity Rolling Transaction
#define RISK_CONTROL_TYPE_ACTIVITY_ROLLING_VOLUME 0x09                          // Activity Rolling Volume
#define RISK_CONTROL_TYPE_ACTIVITY_ROLLING_PERCENTAGE 0x0A                      // Activity Rolling Percentage
#define RISK_CONTROL_TYPE_GLOBAL_RISK_MITIGATION_PROTECTION 0x0B                // Global Risk Mitigation Protection
#define RISK_CONTROL_TYPE_REJECT_MARKET_ORDERS 0x0D                             // Reject Market Orders
#define RISK_CONTROL_TYPE_REJECT_MOO_AND_MOC 0x0E                               // Reject Moo And Moc
#define RISK_CONTROL_TYPE_REJECT_RESTRICTED_SYMBOL 0x13                         // Reject Restricted Symbol
#define RISK_CONTROL_TYPE_LIMIT_ORDER_PRICE_PROTECTION_OPTIONS_SINGLE_LEG 0x1A  // Limit Order Price Protection Options Single Leg
#define RISK_CONTROL_TYPE_LIMIT_ORDER_PRICE_PROTECTION_OPTIONS_COMPLEX 0x1B     // Limit Order Price Protection Options Complex
#define RISK_CONTROL_TYPE_ORDER_RATE_THRESHOLD 0x1D                             // Order Rate Threshold
#define RISK_CONTROL_TYPE_REJECT_ISOIOC 0x1E                                    // Reject Isoioc
#define RISK_CONTROL_TYPE_REJECT_ISO_DAY 0x1F                                   // Reject Iso Day

// Risk Control Activation: one byte code
#define RISK_CONTROL_ACTIVATION_OFF 0x00  // Off
#define RISK_CONTROL_ACTIVATION_ON 0x01   // On

// Breach Action Request: one byte code
#define BREACH_ACTION_REQUEST_NOT_APPLICABLE 0x00      // Not Applicable
#define BREACH_ACTION_REQUEST_NOTIFICATIONS_ONLY 0x01  // Notifications Only
#define BREACH_ACTION_REQUEST_CANCEL_AND_BLOCK 0x02    // Cancel And Block
#define BREACH_ACTION_REQUEST_BLOCK_ONLY 0x03          // Block Only

// Ioc Attribution: one byte code
#define IOC_ATTRIBUTION_NOT_APPLICABLE 0x00  // Not Applicable
#define IOC_ATTRIBUTION_INCLUDE_IOC 0x01     // Include Ioc
#define IOC_ATTRIBUTION_EXCLUDE_IOC 0x02     // Exclude Ioc

// Price Scale: one byte code
#define PRICE_SCALE_NO_DECIMALS 0x00   // No Decimals
#define PRICE_SCALE_TWO_DECIMALS 0x02  // Two Decimals

// Risk Action Type: one byte code
#define RISK_ACTION_TYPE_NOT_APPLICABLE 0x00                         // Not Applicable
#define RISK_ACTION_TYPE_QUERY 0x01                                  // Query
#define RISK_ACTION_TYPE_KILL_SWITCH_BLOCK 0x02                      // Kill Switch Block
#define RISK_ACTION_TYPE_KILL_SWITCH_UNBLOCK 0x03                    // Kill Switch Unblock
#define RISK_ACTION_TYPE_KILL_SWITCH_CANCEL_AUCTION_ORDERS 0x04      // Kill Switch Cancel Auction Orders
#define RISK_ACTION_TYPE_KILL_SWITCH_CANCEL_NON_AUCTION_ORDERS 0x05  // Kill Switch Cancel Non Auction Orders
#define RISK_ACTION_TYPE_KILL_SWITCH_CANCEL_GTC_ORDERS 0x06          // Kill Switch Cancel Gtc Orders
#define RISK_ACTION_TYPE_APPROVE_REINSTATEMENT 0x07                  // Approve Reinstatement
#define RISK_ACTION_TYPE_RISK_ENTITY_REINSTATED 0x08                 // Risk Entity Reinstated

// Leg Side: one byte code
#define LEG_SIDE_BUY 0x01   // Buy
#define LEG_SIDE_SELL 0x02  // Sell

// ---- Types -------------------------------------------------------------------

// Client must send Login before any other message
typedef struct _LoginMessage {
  UINT8 username[16];  // bytes 0 to 15
  UINT8 password[32];  // bytes 16 to 47
  UINT8 mic[4];        // bytes 48 to 51
  UINT8 version[20];   // bytes 52 to 71
} LoginMessage;

// Heartbeat must be sent once a second
typedef struct _Heartbeat {
  unit empty;
} Heartbeat;

// Pillar Stream Protocol Stream Identifier
typedef struct _StreamId {
  UINT32 sess;   // bytes 0 to 3
  UINT32 value;  // bytes 4 to 7
} StreamId;

// Request open a stream for reading or writing
typedef struct _Open {
  StreamId stream_id;  // bytes 0 to 7
  UINT64 start_seq;    // bytes 8 to 15
  UINT64 end_seq;      // bytes 16 to 23
  UINT8 access;        // byte 24
  UINT8 mode;          // byte 25
} Open;

// Request close stream
typedef struct _Close {
  StreamId stream_id;  // bytes 0 to 7
} Close;

// Pillar Stream Sequenced Message Identifier
typedef struct _SeqMsgId {
  StreamId stream_id;  // bytes 0 to 7
  UINT64 seq;          // bytes 8 to 15
} SeqMsgId;

// Request to update gateway session configuration settings
typedef struct _SessionConfigurationRequestMessage {
  UINT8 username[16];                            // bytes 0 to 15
  UINT8 cancel_on_disconnect;                    // byte 16
  UINT8 throttle_preference;                     // byte 17
  UINT8 self_trade_prevention;                   // byte 18
  UINT8 order_priority_update_ack_subscription;  // byte 19
  UINT8 bold_designation;                        // byte 20
  UINT8 reserved_49[49];                         // bytes 21 to 69
} SessionConfigurationRequestMessage;

// Pillar Stream Sub Message Item Header
typedef struct _SubMsgHeader {
  UINT16 sub_msg_type;    // bytes 0 to 1
  UINT16 sub_msg_length;  // bytes 2 to 3
} SubMsgHeader;

// OptionalOrderAddOn
typedef struct _OptionalOrderAddOn {
  SubMsgHeader sub_msg_header;  // bytes 0 to 3
  UINT64 stop_px;               // bytes 4 to 11, signed, read here as unsigned
  UINT32 max_floor;             // bytes 12 to 15
  UINT8 deliver_to_comp_id[5];  // bytes 16 to 20
  UINT8 clearing_firm[5];       // bytes 21 to 25
  UINT8 optional_data[16];      // bytes 26 to 41
  UINT8 clearing_account[5];    // bytes 42 to 46
} OptionalOrderAddOn;

// OptionalOrderAddOn
casetype _OptionalOptionalOrderAddOn (Bool present) {
  switch (present) {
    case true: OptionalOrderAddOn optional_order_add_on;
    case false: unit absent;
  }
} OptionalOptionalOrderAddOn;

// Used to submit new single-leg or complex option orders and cancel/replace requests
typedef struct _NewOrderMessage (UINT16 seq_msg_length) {
  UINT32 symbol_id;                                                              // bytes 0 to 3
  UINT8 mpid[4];                                                                 // bytes 4 to 7
  UINT8 market_maker[10];                                                        // bytes 8 to 17
  UINT8 mp_sub_id[4];                                                            // bytes 18 to 21
  UINT64 cl_ord_id;                                                              // bytes 22 to 29
  UINT64 orig_cl_ord_id;                                                         // bytes 30 to 37
  UINT8 bitfield_order_instructions[16];                                         // bytes 38 to 53
  UINT64 price;                                                                  // bytes 54 to 61, signed, read here as unsigned
  UINT32 order_qty;                                                              // bytes 62 to 65
  UINT32 min_qty;                                                                // bytes 66 to 69
  UINT8 user_data[10];                                                           // bytes 70 to 79
  UINT64 leg_open_close;                                                         // bytes 80 to 87
  UINT64 auction_id;                                                             // bytes 88 to 95
  OptionalOptionalOrderAddOn((seq_msg_length == 0x0093)) optional_order_add_on;
} NewOrderMessage;

// Request to cancel a single targeted single-leg or complex order
typedef struct _OrderCancelRequestMessage {
  UINT32 symbol_id;       // bytes 0 to 3
  UINT8 mpid[4];          // bytes 4 to 7
  UINT64 cl_ord_id;       // bytes 8 to 15
  UINT64 orig_cl_ord_id;  // bytes 16 to 23
} OrderCancelRequestMessage;

// Request to reduce order quantity while preserving order ranking and original OrderID
typedef struct _OrderModifyRequestMessage {
  UINT32 symbol_id;        // bytes 0 to 3
  UINT8 mpid[4];           // bytes 4 to 7
  UINT64 cl_ord_id;        // bytes 8 to 15
  UINT64 orig_cl_ord_id;   // bytes 16 to 23
  UINT32 order_qty;        // bytes 24 to 27
  UINT8 side_u_81;         // byte 28
  UINT8 locate_reqd_u_81;  // byte 29
} OrderModifyRequestMessage;

// Repeating group containing one to twenty single-sided market maker quotes
typedef struct _QuoteRequestGroup {
  UINT32 series_index;      // bytes 0 to 3
  UINT8 side_2 : 2;         // byte 4
  UINT8 mm_quote_type : 3;  // byte 4
  UINT8 unused_3 : 3;       // byte 4
  UINT64 price;             // bytes 5 to 12, signed, read here as unsigned
  UINT32 order_qty;         // bytes 13 to 16
} QuoteRequestGroup;

// Allows a market maker to submit up to 20 single-sided quotes for the same underlying in a single message
typedef struct _NewBulkQuoteType243Message (UINT32 available) where (available >= 39) {
  UINT8 mpid[4];                                                       // bytes 0 to 3
  UINT8 market_maker[10];                                              // bytes 4 to 13
  UINT8 sub_id[4];                                                     // bytes 14 to 17
  UINT64 cl_ord_id;                                                    // bytes 18 to 25
  UINT8 self_trade_type_u_81;                                          // byte 26
  UINT32 group_id;                                                     // bytes 27 to 30
  UINT64 mm_sent_time;                                                 // bytes 31 to 38
  QuoteRequestGroup quote_request_group[:byte-size (available - 39)];
} NewBulkQuoteType243Message;

// Exposed
typedef struct _Exposed {
  SubMsgHeader sub_msg_header;            // bytes 0 to 3
  UINT32 symbol_id;                       // bytes 4 to 7
  UINT8 mpid[4];                          // bytes 8 to 11
  UINT8 market_maker[10];                 // bytes 12 to 21
  UINT8 mp_sub_id[4];                     // bytes 22 to 25
  UINT64 cl_ord_id;                       // bytes 26 to 33
  UINT64 orig_cl_ord_id;                  // bytes 34 to 41
  UINT8 bitfield_order_instructions[16];  // bytes 42 to 57
  UINT64 price;                           // bytes 58 to 65, signed, read here as unsigned
  UINT32 order_qty;                       // bytes 66 to 69
  UINT32 min_qty;                         // bytes 70 to 73
  UINT8 user_data[10];                    // bytes 74 to 83
  UINT64 leg_open_close;                  // bytes 84 to 91
  UINT64 auction_id;                      // bytes 92 to 99
} Exposed;

// Covered
typedef struct _Covered {
  SubMsgHeader sub_msg_header;            // bytes 0 to 3
  UINT32 symbol_id;                       // bytes 4 to 7
  UINT8 mpid[4];                          // bytes 8 to 11
  UINT8 market_maker[10];                 // bytes 12 to 21
  UINT8 mp_sub_id[4];                     // bytes 22 to 25
  UINT64 cl_ord_id;                       // bytes 26 to 33
  UINT64 orig_cl_ord_id;                  // bytes 34 to 41
  UINT8 bitfield_order_instructions[16];  // bytes 42 to 57
  UINT64 price;                           // bytes 58 to 65, signed, read here as unsigned
  UINT32 order_qty;                       // bytes 66 to 69
  UINT32 min_qty;                         // bytes 70 to 73
  UINT8 user_data[10];                    // bytes 74 to 83
  UINT64 leg_open_close;                  // bytes 84 to 91
  UINT64 auction_id;                      // bytes 92 to 99
} Covered;

// Used to submit cross orders for single-leg or complex options
typedef struct _NewOrderCrossMessage {
  UINT64 cross_id;                    // bytes 0 to 7
  UINT8 allocation_pct;               // byte 8
  UINT8 clearing_firm_exposed[5];     // bytes 9 to 13
  UINT8 clearing_account_exposed[5];  // bytes 14 to 18
  UINT8 optional_data_exposed[16];    // bytes 19 to 34
  UINT8 clearing_firm_covered[5];     // bytes 35 to 39
  UINT8 clearing_account_covered[5];  // bytes 40 to 44
  UINT8 optional_data_covered[16];    // bytes 45 to 60
  UINT8 reserved_16[16];              // bytes 61 to 76
  Exposed exposed;                    // bytes 77 to 176
  Covered covered;                    // bytes 177 to 276
} NewOrderCrossMessage;

// Request to cancel orders and/or market maker quotes in bulk based on specified criteria
typedef struct _BulkCancelRequestType223Message {
  UINT32 symbol_id;                  // bytes 0 to 3
  UINT8 mpid[4];                     // bytes 4 to 7
  UINT8 market_maker[10];            // bytes 8 to 17
  UINT64 cl_ord_id;                  // bytes 18 to 25
  UINT64 mm_sent_time;               // bytes 26 to 33
  UINT8 side_u_81;                   // byte 34
  UINT32 group_id;                   // bytes 35 to 38
  UINT8 target_cancel_username[16];  // bytes 39 to 54
  UINT8 bulk_action;                 // byte 55
  UINT8 cancel_scope;                // byte 56
  UINT8 target_cancel_mpid[4];       // bytes 57 to 60
} BulkCancelRequestType223Message;

// Request to cancel orders in bulk based on symbol, side, and user or firm criteria
typedef struct _BulkCancelRequestType224Message {
  UINT32 symbol_id;                  // bytes 0 to 3
  UINT8 mpid[4];                     // bytes 4 to 7
  UINT8 mp_sub_id[4];                // bytes 8 to 11
  UINT64 cl_ord_id;                  // bytes 12 to 19
  UINT8 side_u_81;                   // byte 20
  UINT8 target_cancel_username[16];  // bytes 21 to 36
  UINT8 bulk_action;                 // byte 37
  UINT8 target_cancel_mpid[4];       // bytes 38 to 41
  UINT8 reserved_20[20];             // bytes 42 to 61
} BulkCancelRequestType224Message;

// Request to create, update, activate, or deactivate Pillar risk control limits for entitled risk entities
typedef struct _RiskLimitUpdateRequestMessage {
  UINT32 symbol_id;               // bytes 0 to 3
  UINT8 mpid[4];                  // bytes 4 to 7
  UINT8 market_maker[10];         // bytes 8 to 17
  UINT8 mp_sub_id[4];             // bytes 18 to 21
  UINT8 reserved_4[4];            // bytes 22 to 25
  UINT8 clearing_number[5];       // bytes 26 to 30
  UINT64 cl_ord_id;               // bytes 31 to 38
  UINT32 risk_user_crd;           // bytes 39 to 42
  UINT8 risk_user_type;           // byte 43
  UINT8 risk_control_type;        // byte 44
  UINT8 risk_control_activation;  // byte 45
  UINT64 usd_limit;               // bytes 46 to 53, signed, read here as unsigned
  UINT32 time_limit;              // bytes 54 to 57, signed, read here as unsigned
  UINT32 percentage_limit;        // bytes 58 to 61, signed, read here as unsigned
  UINT32 count_limit;             // bytes 62 to 65, signed, read here as unsigned
  UINT8 breach_action_request;    // byte 66
  UINT8 ioc_attribution;          // byte 67
  UINT8 risk_range_id;            // byte 68
  UINT64 risk_minimum_value;      // bytes 69 to 76, signed, read here as unsigned
  UINT8 price_scale;              // byte 77
  UINT8 reserved_190[190];        // bytes 78 to 267
} RiskLimitUpdateRequestMessage;

// Request to query risk entities, invoke kill switch actions, or approve reinstatement for Pillar risk controls
typedef struct _RiskActionRequestMessage {
  UINT32 symbol_id;          // bytes 0 to 3
  UINT8 mpid[4];             // bytes 4 to 7
  UINT8 market_maker[10];    // bytes 8 to 17
  UINT8 mp_sub_id[4];        // bytes 18 to 21
  UINT8 reserved_4[4];       // bytes 22 to 25
  UINT8 clearing_number[5];  // bytes 26 to 30
  UINT64 cl_ord_id;          // bytes 31 to 38
  UINT32 risk_user_crd;      // bytes 39 to 42
  UINT8 risk_user_type;      // byte 43
  UINT8 risk_control_type;   // byte 44
  UINT8 risk_action_type;    // byte 45
  UINT8 risk_range_id;       // byte 46
  UINT8 reserved_199[199];   // bytes 47 to 245
} RiskActionRequestMessage;

// Repeating group defining each leg of the complex series
typedef struct _ComplexSeriesLegGroup {
  UINT32 leg_symbol_id;  // bytes 0 to 3
  UINT16 leg_ratio_qty;  // bytes 4 to 5
  UINT8 leg_side;        // byte 6
} ComplexSeriesLegGroup;

