#define MESSAGE_TYPE_RECOVERY_TRADE_MESSAGE 0x76                  // Recovery Trade Message
#define MESSAGE_TYPE_AUCTION_INFO_MESSAGE 0x49                    // Auction Info Message
#define MESSAGE_TYPE_STATISTICS_MESSAGE 0x77                      // Statistics Message
#define MESSAGE_TYPE_EXTENDED_STATISTICS_MESSAGE 0x80             // Extended Statistics Message
#define MESSAGE_TYPE_CONSOLIDATED_STATISTICS_MESSAGE 0x64         // Consolidated Statistics Message
#define MESSAGE_TYPE_INDEX_MESSAGE 0x62                           // Index Message
#define MESSAGE_TYPE_AON_INFO_MESSAGE 0x65                        // Aon Info Message
#define MESSAGE_TYPE_NEWS_MESSAGE 0x75                            // News Message
#define MESSAGE_TYPE_UPDATE_PRICE_POINT_MESSAGE 0x73              // Update Price Point Message
#define MESSAGE_TYPE_DELETE_PRICE_POINT_MESSAGE 0x72              // Delete Price Point Message
#define MESSAGE_TYPE_TOP_OF_BOOK_MESSAGE 0x71                     // Top Of Book Message

// Login Status: one byte code
#define LOGIN_STATUS_LOGIN_ACCEPTED 0x41            // Login Accepted
#define LOGIN_STATUS_COMP_ID_INACTIVE_LOCKED 0x61   // Comp Id Inactive Locked
#define LOGIN_STATUS_LOGIN_LIMIT_REACHED 0x62       // Login Limit Reached
#define LOGIN_STATUS_SERVICE_UNAVAILABLE 0x63       // Service Unavailable
#define LOGIN_STATUS_CONCURRENT_LIMIT_REACHED 0x64  // Concurrent Limit Reached
#define LOGIN_STATUS_FAILED_OTHER 0x65              // Failed Other

// Replay Status: one byte code
#define REPLAY_STATUS_REQUEST_ACCEPTED 0x41           // Request Accepted
#define REPLAY_STATUS_REQUEST_LIMIT_REACHED 0x44      // Request Limit Reached
#define REPLAY_STATUS_INVALID_MARKET_DATA_GROUP 0x49  // Invalid Market Data Group
#define REPLAY_STATUS_OUT_OF_RANGE 0x4F               // Out Of Range
#define REPLAY_STATUS_REPLAY_UNAVAILABLE 0x55         // Replay Unavailable
#define REPLAY_STATUS_CONCURRENT_LIMIT_REACHED 0x63   // Concurrent Limit Reached
#define REPLAY_STATUS_UNSUPPORTED_MESSAGE_TYPE 0x64   // Unsupported Message Type
#define REPLAY_STATUS_FAILED_OTHER 0x65               // Failed Other

// Event Code: one byte code
#define EVENT_CODE_END_OF_DAY 0x43    // End Of Day
#define EVENT_CODE_START_OF_DAY 0x4F  // Start Of Day

// Symbol Status: one byte code
#define SYMBOL_STATUS_HALTED 0x48     // Halted
#define SYMBOL_STATUS_SUSPENDED 0x53  // Suspended
#define SYMBOL_STATUS_INACTIVE 0x61   // Inactive
#define SYMBOL_STATUS_ACTIVE 0x20     // Active

// Option Type: one byte code
#define OPTION_TYPE_CALL_OPTION 0x43    // Call Option
#define OPTION_TYPE_PUT_OPTION 0x50     // Put Option
#define OPTION_TYPE_NOT_AN_OPTION 0x20  // Not An Option

// Trading Status: one byte code
#define TRADING_STATUS_HALT 0x48                                 // Halt
#define TRADING_STATUS_REGULAR_TRADING 0x54                      // Regular Trading
#define TRADING_STATUS_OPENING_AUCTION_CALL 0x61                 // Opening Auction Call
#define TRADING_STATUS_POST_CLOSE 0x62                           // Post Close
#define TRADING_STATUS_MARKET_CLOSE 0x63                         // Market Close
#define TRADING_STATUS_CLOSING_AUCTION_CALL 0x64                 // Closing Auction Call
#define TRADING_STATUS_RE_OPENING_AUCTION_CALL 0x65              // Re Opening Auction Call
#define TRADING_STATUS_PAUSE 0x6C                                // Pause
#define TRADING_STATUS_ORDER_ENTRY 0x6E                          // Order Entry
#define TRADING_STATUS_AUCTION_INITIATION 0x70                   // Auction Initiation
#define TRADING_STATUS_START_OF_AUCTION_CALL 0x71                // Start Of Auction Call
#define TRADING_STATUS_END_OF_AUCTION_CALL 0x72                  // End Of Auction Call
#define TRADING_STATUS_START_OF_AON_ORDER_ENTRY 0x73             // Start Of Aon Order Entry
#define TRADING_STATUS_END_OF_AON_ORDER_ENTRY 0x74               // End Of Aon Order Entry
#define TRADING_STATUS_CLOSING_PRICE_CROSS 0x75                  // Closing Price Cross
#define TRADING_STATUS_RESERVED_FOR_BACKWARD_COMPATIBILITY 0x76  // Reserved For Backward Compatibility
#define TRADING_STATUS_NO_ACTIVE_SESSION 0x77                    // No Active Session
#define TRADING_STATUS_END_OF_POST_CLOSE 0x78                    // End Of Post Close
#define TRADING_STATUS_PRE_TRADING 0x79                          // Pre Trading
#define TRADING_STATUS_CLOSING_PRICE_PUBLICATION 0x7A            // Closing Price Publication
#define TRADING_STATUS_INTRADAY_AUCTION_CALL 0x6F                // Intraday Auction Call
#define TRADING_STATUS_AUCTION_EXECUTION 0x30                    // Auction Execution

// Session Change Reason: one byte code
#define SESSION_CHANGE_REASON_SCHEDULED_TRANSITION 0x00        // Scheduled Transition
#define SESSION_CHANGE_REASON_EXTENDED_BY_MARKET_OPS 0x01      // Extended By Market Ops
#define SESSION_CHANGE_REASON_SHORTENED_BY_MARKET_OPS 0x02     // Shortened By Market Ops
#define SESSION_CHANGE_REASON_MARKET_ORDER_EXTENSION 0x03      // Market Order Extension
#define SESSION_CHANGE_REASON_PRICE_MONITORING_EXTENSION 0x04  // Price Monitoring Extension
#define SESSION_CHANGE_REASON_CIRCUIT_BREAKER_TRIPPED 0x05     // Circuit Breaker Tripped
#define SESSION_CHANGE_REASON_UNAVAILABLE 0x09                 // Unavailable

// Sub Book: one byte code
#define SUB_BOOK_REGULAR 0x01           // Regular
#define SUB_BOOK_OFF_BOOK 0x02          // Off Book
#define SUB_BOOK_ODD_LOT 0x03           // Odd Lot
#define SUB_BOOK_BLOCK_TRADE 0x04       // Block Trade
#define SUB_BOOK_ALL_OR_NONE 0x05       // All Or None
#define SUB_BOOK_EARLY_SETTLEMENT 0x06  // Early Settlement
#define SUB_BOOK_AUCTION 0x07           // Auction
#define SUB_BOOK_BULLETIN_BOARD 0x09    // Bulletin Board

// Side: one byte code
#define SIDE_BUY_ORDER 0x42   // Buy Order
#define SIDE_SELL_ORDER 0x53  // Sell Order

// Settlement Type: one byte code
#define SETTLEMENT_TYPE_CASH_T_PLUS_0 0x31          // Cash T Plus 0
#define SETTLEMENT_TYPE_EARLY_SETTLE_T_PLUS_1 0x32  // Early Settle T Plus 1
#define SETTLEMENT_TYPE_T_PLUS_2 0x33               // T Plus 2
#define SETTLEMENT_TYPE_REGULAR_T_PLUS_3 0x34       // Regular T Plus 3

// Book Type: one byte code
#define BOOK_TYPE_MBP_MBO_STATISTICS 0x30  // Mbp Mbo Statistics
#define BOOK_TYPE_TOP_OF_BOOK 0x31         // Top Of Book

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// Auction Type: one byte code
#define AUCTION_TYPE_RE_OPENING_AUCTION 0x41    // Re Opening Auction
#define AUCTION_TYPE_CLOSING_AUCTION 0x43       // Closing Auction
#define AUCTION_TYPE_OPENING_AUCTION 0x4F       // Opening Auction
#define AUCTION_TYPE_INTRA_DAY_AUCTION 0x4B     // Intra Day Auction
#define AUCTION_TYPE_NOT_AN_AUCTION_TRADE 0x20  // Not An Auction Trade

// Trade Type: one byte code
#define TRADE_TYPE_ON_BOOK_TRADE 0x54   // On Book Trade
#define TRADE_TYPE_OFF_BOOK_TRADE 0x4E  // Off Book Trade

// Action Type: one byte code
#define ACTION_TYPE_CANCELLED_TRADE 0x43  // Cancelled Trade
#define ACTION_TYPE_TRADE 0x4E            // Trade
#define ACTION_TYPE_AMEND_TRADE 0x41      // Amend Trade

// Auction Trade Type: one byte code
#define AUCTION_TRADE_TYPE_BULK_TRADE 0x42           // Bulk Trade
#define AUCTION_TRADE_TYPE_SUPPLEMENTARY_TRADE 0x53  // Supplementary Trade

// Imbalance Direction: one byte code
#define IMBALANCE_DIRECTION_BUY_IMBALANCE 0x42                    // Buy Imbalance
#define IMBALANCE_DIRECTION_NO_IMBALANCE 0x4E                     // No Imbalance
#define IMBALANCE_DIRECTION_INSUFFICIENT_ORDERS_FOR_AUCTION 0x4F  // Insufficient Orders For Auction
#define IMBALANCE_DIRECTION_SELL_IMBALANCE 0x53                   // Sell Imbalance

// Statistic Type: one byte code
#define STATISTIC_TYPE_CLOSING_PRICE 0x43   // Closing Price
#define STATISTIC_TYPE_OPENING_PRICE 0x4F   // Opening Price
#define STATISTIC_TYPE_PREVIOUS_CLOSE 0x50  // Previous Close

// Open Close Indicator: one byte code
#define OPEN_CLOSE_INDICATOR_AUCTION_TRADE 0x41          // Auction Trade
#define OPEN_CLOSE_INDICATOR_REGULAR_TRADE 0x42          // Regular Trade
#define OPEN_CLOSE_INDICATOR_MID_POINT 0x43              // Mid Point
#define OPEN_CLOSE_INDICATOR_LAST_REGULAR_TRADE 0x44     // Last Regular Trade
#define OPEN_CLOSE_INDICATOR_LAST_AUCTION 0x45           // Last Auction
#define OPEN_CLOSE_INDICATOR_MANUAL 0x46                 // Manual
#define OPEN_CLOSE_INDICATOR_VWAP 0x48                   // Vwap
#define OPEN_CLOSE_INDICATOR_PREVIOUS_CLOSE 0x49         // Previous Close
#define OPEN_CLOSE_INDICATOR_THEORETICAL_PRICE 0x54      // Theoretical Price
#define OPEN_CLOSE_INDICATOR_BEST_BID 0x55               // Best Bid
#define OPEN_CLOSE_INDICATOR_BEST_OFFER 0x56             // Best Offer
#define OPEN_CLOSE_INDICATOR_NONE 0x57                   // None
#define OPEN_CLOSE_INDICATOR_VWAP_OF_LAST_N_TRADES 0x58  // Vwap Of Last N Trades
#define OPEN_CLOSE_INDICATOR_REFERENCE_PRICE 0x59        // Reference Price
#define OPEN_CLOSE_INDICATOR_PRICE_UNAVAILABLE 0x5A      // Price Unavailable

// Statistics Type: one byte code
#define STATISTICS_TYPE_MARKET 0x00           // Market
#define STATISTICS_TYPE_SECTOR 0x01           // Sector
#define STATISTICS_TYPE_INSTRUMENT_TYPE 0x02  // Instrument Type

// Update Type: one byte code
#define UPDATE_TYPE_INTRA_DAY 0x00       // Intra Day
#define UPDATE_TYPE_CLOSING 0x01         // Closing
#define UPDATE_TYPE_PREVIOUS_CLOSE 0x02  // Previous Close
#define UPDATE_TYPE_INDICATIVE 0x03      // Indicative
#define UPDATE_TYPE_HIGH 0x04            // High
#define UPDATE_TYPE_LOW 0x05             // Low

// Aon Status: one byte code
#define AON_STATUS_ACTIVE 0x41     // Active
#define AON_STATUS_COMPLETED 0x43  // Completed
#define AON_STATUS_HALTED 0x48     // Halted
#define AON_STATUS_INACTIVE 0x49   // Inactive
#define AON_STATUS_CANCELLED 0x58  // Cancelled

// Urgency: one byte code
#define URGENCY_REGULAR 0x30        // Regular
#define URGENCY_HIGH_PRIORITY 0x31  // High Priority
#define URGENCY_LOW_PRIORITY 0x32   // Low Priority

// Price Point Action: one byte code
#define PRICE_POINT_ACTION_ADD 0x30     // Add
#define PRICE_POINT_ACTION_CHANGE 0x31  // Change

// Top Of Book Action: one byte code
#define TOP_OF_BOOK_ACTION_UPDATE 0x31  // Update
#define TOP_OF_BOOK_ACTION_DELETE 0x32  // Delete

// ---- Types -------------------------------------------------------------------

// Used by the client to login to the Replay or Snapshot channel.
typedef struct _LoginRequestMessage {
  UINT8 username[6];   // bytes 0 to 5
  UINT8 password[10];  // bytes 6 to 15
} LoginRequestMessage;

// Used by the server to accept or reject a login request to the Replay or Snapshot channel.
typedef struct _LoginResponseMessage {
  UINT8 login_status;  // byte 0
} LoginResponseMessage;

// Used by the client to request a retransmission of messages on the Replay channel.
typedef struct _ReplayRequestMessage {
  UINT8 market_data_group;  // byte 0
  UINT32 first_message;     // bytes 1 to 4
  UINT16 count;             // bytes 5 to 6
} ReplayRequestMessage;

// Used by the server to respond to a retransmission request on the Replay channel.
typedef struct _ReplayResponseMessage {
  UINT8 market_data_group;  // byte 0
  UINT32 first_message;     // bytes 1 to 4
  UINT16 count;             // bytes 5 to 6
  UINT8 replay_status;      // byte 7
} ReplayResponseMessage;

// Sent by the server for every second for which at least one application message is generated; its time is the reference for the nanosecond offsets of every other application message.
typedef struct _TimeMessage {
  UINT32 seconds;  // bytes 0 to 3
} TimeMessage;

// Sent to indicate the start and end of the day.
typedef struct _SystemEventMessage {
  UINT32 nanosecond;  // bytes 0 to 3
  UINT8 event_code;   // byte 4
} SystemEventMessage;

// Used to disseminate information (e.g. symbol, segment, ISIN, underlying, etc.) on each instrument.
typedef struct _SymbolDirectoryMessage {
  UINT32 nanosecond;                // bytes 0 to 3
  UINT8 symbol[12];                 // bytes 4 to 15
  UINT8 symbol_status;              // byte 16
  UINT8 identification_number[12];  // bytes 17 to 28
  UINT8 segment[6];                 // bytes 29 to 34
  UINT8 expiration_date[8];         // bytes 35 to 42
  UINT8 underlying[6];              // bytes 43 to 48
  UINT32 strike_price;              // bytes 49 to 52, signed, read here as unsigned
  UINT8 option_type;                // byte 53
  UINT8 issuer[6];                  // bytes 54 to 59
  UINT8 issue_date[8];              // bytes 60 to 67
  UINT32 coupon;                    // bytes 68 to 71, signed, read here as unsigned
  UINT8 inverse_order_book : 1;     // byte 72
  UINT8 reserved_17 : 7;            // byte 72
  UINT8 regular : 1;                // byte 73
  UINT8 off_book : 1;               // byte 73
  UINT8 block_trade : 1;            // byte 73
  UINT8 odd_lot : 1;                // byte 73
  UINT8 early_settlement : 1;       // byte 73
  UINT8 bulletin_board : 1;         // byte 73
  UINT8 auction : 1;                // byte 73
  UINT8 all_or_none : 1;            // byte 73
  UINT8 corporate_action[5];        // bytes 74 to 78
  UINT64 issued_quantity;           // bytes 79 to 86, signed, read here as unsigned
} SymbolDirectoryMessage;

// Indicates the trading session (e.g. pre-opening, regular trading, etc.) that currently applies to an instrument.
typedef struct _SymbolStatusMessage {
  UINT32 nanosecond;            // bytes 0 to 3
  UINT8 symbol[12];             // bytes 4 to 15
  UINT8 trading_status;         // byte 16
  UINT8 reserved_07 : 8;        // byte 17
  UINT8 halt_reason[4];         // bytes 18 to 21
  UINT8 session_change_reason;  // byte 22
  UINT8 new_end_time[8];        // bytes 23 to 30
  UINT8 sub_book;               // byte 31
} SymbolStatusMessage;

// Sent to indicate that an anonymous limit or market order is added to the order book.
typedef struct _AddOrderMessage {
  UINT32 nanosecond;         // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT8 side;                // byte 12
  UINT32 quantity;           // bytes 13 to 16
  UINT8 symbol[12];          // bytes 17 to 28
  UINT32 price;              // bytes 29 to 32, signed, read here as unsigned
  UINT8 reserved_03 : 4;     // byte 33
  UINT8 market_order : 1;    // byte 33
  UINT8 bulletin_board : 1;  // byte 33
  UINT8 reserved_67 : 2;     // byte 33
  UINT8 sub_book;            // byte 34
  UINT8 settlement_type;     // byte 35
  UINT32 interest_rate;      // bytes 36 to 39, signed, read here as unsigned
  UINT8 term;                // byte 40
} AddOrderMessage;

// Indicates that an attributable limit order is added to the order book. The identity of the submitting firm is included in the message.
typedef struct _AddAttributedOrderMessage {
  UINT32 nanosecond;         // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT8 side;                // byte 12
  UINT32 quantity;           // bytes 13 to 16
  UINT8 symbol[12];          // bytes 17 to 28
  UINT32 price;              // bytes 29 to 32, signed, read here as unsigned
  UINT8 attribution[6];      // bytes 33 to 38
  UINT8 reserved_04 : 5;     // byte 39
  UINT8 bulletin_board : 1;  // byte 39
  UINT8 reserved_67 : 2;     // byte 39
  UINT8 sub_book;            // byte 40
} AddAttributedOrderMessage;

// Sent to indicate that the remainder of a displayed order is cancelled.
typedef struct _OrderDeletedMessage {
  UINT32 nanosecond;  // bytes 0 to 3
  UINT64 order_id;    // bytes 4 to 11
} OrderDeletedMessage;

// Indicates that the displayed quantity or price of a displayed order has been updated, and whether the order has retained or lost its time priority.
typedef struct _OrderModifiedMessage {
  UINT32 nanosecond;        // bytes 0 to 3
  UINT64 order_id;          // bytes 4 to 11
  UINT32 new_quantity;      // bytes 12 to 15
  UINT32 new_price;         // bytes 16 to 19, signed, read here as unsigned
  UINT8 priority_flag : 1;  // byte 20
  UINT8 reserved_17 : 7;    // byte 20
  UINT8 settlement_type;    // byte 21
  UINT32 interest_rate;     // bytes 22 to 25, signed, read here as unsigned
  UINT8 term;               // byte 26
} OrderModifiedMessage;

// Sent to instruct recipients to remove all orders from the order book for the specified instrument.
typedef struct _OrderBookClearMessage {
  UINT32 nanosecond;  // bytes 0 to 3
  UINT8 symbol[12];   // bytes 4 to 15
  UINT8 sub_book;     // byte 16
  UINT8 book_type;    // byte 17
} OrderBookClearMessage;

// Indicates that the displayed portion of an order is fully or partially filled at its displayed price. The executed quantity is included in the message.
typedef struct _OrderExecutedMessage {
  UINT32 nanosecond;                  // bytes 0 to 3
  UINT64 order_id;                    // bytes 4 to 11
  UINT32 executed_quantity;           // bytes 12 to 15
  UINT64 trade_id;                    // bytes 16 to 23
  UINT8 buy_firm[6];                  // bytes 24 to 29
  UINT8 sell_firm[6];                 // bytes 30 to 35
  UINT64 last_opt_px;                 // bytes 36 to 43, signed, read here as unsigned
  UINT64 volatility;                  // bytes 44 to 51, signed, read here as unsigned
  UINT64 underlying_reference_price;  // bytes 52 to 59, signed, read here as unsigned
} OrderExecutedMessage;

// Sent if a displayed order is fully or partially filled at a price that is different from its displayed price, with an indication of whether the trade should update time and sales and statistics displays.
typedef struct _OrderExecutedWithPriceSizeMessage {
  UINT32 nanosecond;                  // bytes 0 to 3
  UINT64 order_id;                    // bytes 4 to 11
  UINT32 executed_quantity;           // bytes 12 to 15
  UINT32 display_quantity;            // bytes 16 to 19
  UINT64 trade_id;                    // bytes 20 to 27
  UINT8 printable;                    // byte 28
  UINT32 price;                       // bytes 29 to 32, signed, read here as unsigned
  UINT8 buy_firm[6];                  // bytes 33 to 38
  UINT8 sell_firm[6];                 // bytes 39 to 44
  UINT64 last_opt_px;                 // bytes 45 to 52, signed, read here as unsigned
  UINT64 volatility;                  // bytes 53 to 60, signed, read here as unsigned
  UINT64 underlying_reference_price;  // bytes 61 to 68, signed, read here as unsigned
} OrderExecutedWithPriceSizeMessage;

// Sent if the non-displayed portion of an iceberg order or a reserve order is fully or partially filled, or if the negotiated non-disclosed order in the block trade order book is executed.
typedef struct _TradeMessage {
  UINT32 nanosecond;                  // bytes 0 to 3
  UINT32 executed_quantity;           // bytes 4 to 7
  UINT8 symbol[12];                   // bytes 8 to 19
  UINT32 price;                       // bytes 20 to 23, signed, read here as unsigned
  UINT64 trade_id;                    // bytes 24 to 31
  UINT8 sub_book;                     // byte 32
  UINT8 buy_firm[6];                  // bytes 33 to 38
  UINT8 sell_firm[6];                 // bytes 39 to 44
  UINT64 last_opt_px;                 // bytes 45 to 52, signed, read here as unsigned
  UINT64 volatility;                  // bytes 53 to 60, signed, read here as unsigned
  UINT64 underlying_reference_price;  // bytes 61 to 68, signed, read here as unsigned
} TradeMessage;

// Sent to report details of an auction (e.g. opening, closing, intra-day, etc.).
typedef struct _AuctionTradeMessage {
  UINT32 nanosecond;                  // bytes 0 to 3
  UINT32 executed_quantity;           // bytes 4 to 7
  UINT8 symbol[12];                   // bytes 8 to 19
  UINT32 price;                       // bytes 20 to 23, signed, read here as unsigned
  UINT64 trade_id;                    // bytes 24 to 31
  UINT8 auction_type;                 // byte 32
  UINT64 last_opt_px;                 // bytes 33 to 40, signed, read here as unsigned
  UINT64 volatility;                  // bytes 41 to 48, signed, read here as unsigned
  UINT64 underlying_reference_price;  // bytes 49 to 56, signed, read here as unsigned
} AuctionTradeMessage;

// Sent to report the details of an off-book trade.
typedef struct _OffBookTradeMessage {
  UINT32 nanosecond;                  // bytes 0 to 3
  UINT32 executed_quantity;           // bytes 4 to 7
  UINT8 symbol[12];                   // bytes 8 to 19
  UINT32 price;                       // bytes 20 to 23, signed, read here as unsigned
  UINT64 trade_id;                    // bytes 24 to 31
  UINT8 off_book_trade_type[4];       // bytes 32 to 35
  UINT8 trade_time[8];                // bytes 36 to 43
  UINT8 trade_date[8];                // bytes 44 to 51
  UINT64 last_opt_px;                 // bytes 52 to 59, signed, read here as unsigned
  UINT64 volatility;                  // bytes 60 to 67, signed, read here as unsigned
  UINT64 underlying_reference_price;  // bytes 68 to 75, signed, read here as unsigned
} OffBookTradeMessage;

// Sent to indicate that a previously reported trade is cancelled.
typedef struct _TradeBreakMessage {
  UINT32 nanosecond;  // bytes 0 to 3
  UINT64 trade_id;    // bytes 4 to 11
  UINT8 trade_type;   // byte 12
} TradeBreakMessage;

// Sent to report the correction of the executed quantity of a trade.
typedef struct _TradeCorrectionMessage {
  UINT32 nanosecond;   // bytes 0 to 3
  UINT64 trade_id;     // bytes 4 to 11
  UINT8 symbol[12];    // bytes 12 to 23
  UINT32 price;        // bytes 24 to 27, signed, read here as unsigned
  UINT32 quantity;     // bytes 28 to 31
  UINT8 sub_book;      // byte 32
  UINT8 buy_firm[6];   // bytes 33 to 38
  UINT8 sell_firm[6];  // bytes 39 to 44
} TradeCorrectionMessage;

// Sent on the Snapshot channel to retransmit the trades published on the Real-Time channel.
typedef struct _RecoveryTradeMessage {
  UINT32 nanosecond;                  // bytes 0 to 3
  UINT32 executed_quantity;           // bytes 4 to 7
  UINT8 symbol[12];                   // bytes 8 to 19
  UINT32 price;                       // bytes 20 to 23, signed, read here as unsigned
  UINT64 trade_id;                    // bytes 24 to 31
  UINT8 auction_type;                 // byte 32
  UINT8 off_book_trade_type[4];       // bytes 33 to 36
  UINT8 trade_time[8];                // bytes 37 to 44
  UINT8 trade_date[8];                // bytes 45 to 52
  UINT8 action_type;                  // byte 53
  UINT8 sub_book;                     // byte 54
  UINT8 buy_firm[6];                  // bytes 55 to 60
  UINT8 sell_firm[6];                 // bytes 61 to 66
  UINT64 last_opt_px;                 // bytes 67 to 74, signed, read here as unsigned
  UINT64 volatility;                  // bytes 75 to 82, signed, read here as unsigned
  UINT64 underlying_reference_price;  // bytes 83 to 90, signed, read here as unsigned
  UINT8 auction_trade_type;           // byte 91
} RecoveryTradeMessage;

// Indicative auction information for an instrument; the document labels the message type Indicative Auction Info.
typedef struct _AuctionInfoMessage {
  UINT32 nanosecond;          // bytes 0 to 3
  UINT32 paired_quantity;     // bytes 4 to 7
  UINT32 imbalance_quantity;  // bytes 8 to 11
  UINT8 imbalance_direction;  // byte 12
  UINT8 symbol[12];           // bytes 13 to 24
  UINT32 price;               // bytes 25 to 28, signed, read here as unsigned
  UINT8 auction_type;         // byte 29
} AuctionInfoMessage;

// Sent to disseminate the opening, closing and previous closing prices of an instrument.
typedef struct _StatisticsMessage {
  UINT32 nanosecond;           // bytes 0 to 3
  UINT8 symbol[12];            // bytes 4 to 15
  UINT8 statistic_type;        // byte 16
  UINT32 price;                // bytes 17 to 20, signed, read here as unsigned
  UINT8 open_close_indicator;  // byte 21
  UINT8 sub_book;              // byte 22
} StatisticsMessage;

// Sent to disseminate the high, low, VWAP, volume, turnover and other statistics of an instrument for a sub book.
typedef struct _ExtendedStatisticsMessage {
  UINT32 nanosecond;                // bytes 0 to 3
  UINT8 symbol[12];                 // bytes 4 to 15
  UINT32 high_price;                // bytes 16 to 19, signed, read here as unsigned
  UINT32 low_price;                 // bytes 20 to 23, signed, read here as unsigned
  UINT32 vwap;                      // bytes 24 to 27, signed, read here as unsigned
  UINT32 volume;                    // bytes 28 to 31
  UINT64 turnover;                  // bytes 32 to 39, signed, read here as unsigned
  UINT32 trades;                    // bytes 40 to 43
  UINT8 reserved_8[8];              // bytes 44 to 51
  UINT8 sub_book;                   // byte 52
  UINT64 notional_exposure;         // bytes 53 to 60, signed, read here as unsigned
  UINT64 notional_delta_exposure;   // bytes 61 to 68, signed, read here as unsigned
  UINT64 daily_foreign_buy_value;   // bytes 69 to 76, signed, read here as unsigned
  UINT64 daily_foreign_sell_value;  // bytes 77 to 84, signed, read here as unsigned
  UINT64 market_capitalization;     // bytes 85 to 92, signed, read here as unsigned
} ExtendedStatisticsMessage;

// Sent to disseminate the volume, turnover and trades of a market, sector or instrument type.
typedef struct _ConsolidatedStatisticsMessage {
  UINT32 nanosecond;                // bytes 0 to 3
  UINT8 statistics_type;            // byte 4
  UINT8 symbol[12];                 // bytes 5 to 16
  UINT32 volume;                    // bytes 17 to 20
  UINT64 turnover;                  // bytes 21 to 28, signed, read here as unsigned
  UINT32 trades;                    // bytes 29 to 32
  UINT64 daily_foreign_buy_value;   // bytes 33 to 40, signed, read here as unsigned
  UINT64 daily_foreign_sell_value;  // bytes 41 to 48, signed, read here as unsigned
  UINT64 market_capitalization;     // bytes 49 to 56, signed, read here as unsigned
} ConsolidatedStatisticsMessage;

// Sent to disseminate the value of an index.
typedef struct _IndexMessage {
  UINT32 nanosecond;                // bytes 0 to 3
  UINT8 symbol[12];                 // bytes 4 to 15
  UINT32 index_value;               // bytes 16 to 19, signed, read here as unsigned
  UINT8 update_type;                // byte 20
  UINT32 perctg_diff_from_closing;  // bytes 21 to 24, signed, read here as unsigned
} IndexMessage;

// Sent to disseminate the details of an All or None auction.
typedef struct _AonInfoMessage {
  UINT32 nanosecond;  // bytes 0 to 3
  UINT8 symbol[12];   // bytes 4 to 15
  UINT32 price;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 side;         // byte 20
  UINT32 quantity;    // bytes 21 to 24
  UINT8 aon_status;   // byte 25
  UINT8 date[8];      // bytes 26 to 33
} AonInfoMessage;

// Sent to disseminate an announcement.
typedef struct _NewsMessage {
  UINT32 nanosecond;       // bytes 0 to 3
  UINT8 time[8];           // bytes 4 to 11
  UINT8 urgency;           // byte 12
  UINT8 headline[100];     // bytes 13 to 112
  UINT8 text[750];         // bytes 113 to 862
  UINT8 instruments[100];  // bytes 863 to 962
  UINT8 underlyings[100];  // bytes 963 to 1062
} NewsMessage;

// Communicates the addition of a new price point or a size update to an already published price point.
typedef struct _UpdatePricePointMessage {
  UINT32 nanosecond;           // bytes 0 to 3
  UINT8 symbol[12];            // bytes 4 to 15
  UINT8 regular : 1;           // byte 16
  UINT8 reserved_11 : 1;       // byte 16
  UINT8 block_trade : 1;       // byte 16
  UINT8 odd_lot : 1;           // byte 16
  UINT8 early_settlement : 1;  // byte 16
  UINT8 bulletin_board : 1;    // byte 16
  UINT8 default_auction : 1;   // byte 16
  UINT8 reserved_7 : 1;        // byte 16
  UINT8 price_point_action;    // byte 17
  UINT8 side;                  // byte 18
  UINT8 price_level;           // byte 19
  UINT32 price;                // bytes 20 to 23, signed, read here as unsigned
  UINT32 quantity;             // bytes 24 to 27
  UINT32 splits;               // bytes 28 to 31
  UINT8 reserved_03 : 4;       // byte 32
  UINT8 market_order : 1;      // byte 32
  UINT8 reserved_57 : 3;       // byte 32
  UINT8 reserved_1;            // byte 33
} UpdatePricePointMessage;

// Communicates the removal of a price point.
typedef struct _DeletePricePointMessage {
  UINT32 nanosecond;           // bytes 0 to 3
  UINT8 symbol[12];            // bytes 4 to 15
  UINT8 regular : 1;           // byte 16
  UINT8 reserved_11 : 1;       // byte 16
  UINT8 block_trade : 1;       // byte 16
  UINT8 odd_lot : 1;           // byte 16
  UINT8 early_settlement : 1;  // byte 16
  UINT8 bulletin_board : 1;    // byte 16
  UINT8 default_auction : 1;   // byte 16
  UINT8 reserved_7 : 1;        // byte 16
  UINT8 side;                  // byte 17
  UINT8 price_level;           // byte 18
  UINT8 reserved_1;            // byte 19
} DeletePricePointMessage;

// Communicates the best price and cumulative visible size of a side of an order book.
typedef struct _TopOfBookMessage {
  UINT32 nanosecond;             // bytes 0 to 3
  UINT8 symbol[12];              // bytes 4 to 15
  UINT8 regular : 1;             // byte 16
  UINT8 reserved_11 : 1;         // byte 16
  UINT8 block_trade : 1;         // byte 16
  UINT8 odd_lot : 1;             // byte 16
  UINT8 early_settlement : 1;    // byte 16
  UINT8 bulletin_board : 1;      // byte 16
  UINT8 default_auction : 1;     // byte 16
  UINT8 reserved_7 : 1;          // byte 16
  UINT8 top_of_book_action;      // byte 17
  UINT8 side;                    // byte 18
  UINT32 price;                  // bytes 19 to 22, signed, read here as unsigned
  UINT32 quantity;               // bytes 23 to 26
  UINT32 market_order_quantity;  // bytes 27 to 30
  UINT8 reserved_2[2];           // bytes 31 to 32
} TopOfBookMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: LoginRequestMessage login_request_message;
    case 0x02: LoginResponseMessage login_response_message;
    case 0x03: ReplayRequestMessage replay_request_message;
    case 0x04: ReplayResponseMessage replay_response_message;
    case 0x05: unit logout_request_message;
    case 0x54: TimeMessage time_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x52: SymbolDirectoryMessage symbol_directory_message;
    case 0x48: SymbolStatusMessage symbol_status_message;
    case 0x41: AddOrderMessage add_order_message;
    case 0x46: AddAttributedOrderMessage add_attributed_order_message;
    case 0x44: OrderDeletedMessage order_deleted_message;
    case 0x55: OrderModifiedMessage order_modified_message;
    case 0x79: OrderBookClearMessage order_book_clear_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceSizeMessage order_executed_with_price_size_message;
    case 0x50: TradeMessage trade_message;
    case 0x51: AuctionTradeMessage auction_trade_message;
    case 0x78: OffBookTradeMessage off_book_trade_message;
    case 0x42: TradeBreakMessage trade_break_message;
    case 0x60: TradeCorrectionMessage trade_correction_message;
    case 0x76: RecoveryTradeMessage recovery_trade_message;
    case 0x49: AuctionInfoMessage auction_info_message;
    case 0x77: StatisticsMessage statistics_message;
    case 0x80: ExtendedStatisticsMessage extended_statistics_message;
    case 0x64: ConsolidatedStatisticsMessage consolidated_statistics_message;
    case 0x62: IndexMessage index_message;
    case 0x65: AonInfoMessage aon_info_message;
    case 0x75: NewsMessage news_message;
    case 0x73: UpdatePricePointMessage update_price_point_message;
    case 0x72: DeletePricePointMessage delete_price_point_message;
    case 0x71: TopOfBookMessage top_of_book_message;
    default: UINT8 unknown[available];
  }
} Payload;

// One Mitch message: its message header and payload
typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_length { message_length >= 3 };                                                                                                                   // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 3)) payload[:byte-size-single-element-array (((UINT32) message_length) - 3)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// One unit on the tcp stream: the unit header and its payload messages
typedef struct _TcpUnit (mutable UINT32 * tally) {
  UINT16 length { length >= 8 };                                                                                            // bytes 0 to 1
  UINT8 message_count;                                                                                                      // byte 2
  UINT8 market_data_group;                                                                                                  // byte 3
  UINT32 sequence_number;                                                                                                   // bytes 4 to 7
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (((UINT32) length) - 8)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} TcpUnit;

// ---- Packet: Packet ----------------------------------------------------------

// Nairobi Mitch Tcp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) {
  TcpUnit(tally) tcp_unit[:byte-size available];
} Packet;

