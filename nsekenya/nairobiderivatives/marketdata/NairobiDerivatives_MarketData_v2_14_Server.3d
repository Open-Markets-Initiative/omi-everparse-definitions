} IndicesCode;

// ---- Indices Description: 50 bytes -------------------------------------------

// Provides a description for the index.
entrypoint typedef struct _IndicesDescription {
  UINT8 indices_description_length_byte;     // byte 0
  UINT8 indices_description_characters[49];  // bytes 1 to 49
} IndicesDescription;

// ---- Indices Data: 104 bytes -------------------------------------------------

// Indices Data
entrypoint typedef struct _IndicesData {
  UINT32 indices_sequence;                 // bytes 0 to 3, signed, read here as unsigned
  IndicesCode indices_code;                // bytes 4 to 23
  IndicesDescription indices_description;  // bytes 24 to 73
  Classification classification;           // bytes 74 to 103
} IndicesData;

// ---- Shares In Issue Data: 40 bytes ------------------------------------------

// Shares in Issue Data
entrypoint typedef struct _SharesInIssueData {
  UINT32 shares_in_issue_sequence;  // bytes 0 to 3, signed, read here as unsigned
  UINT32 instrument_sequence;       // bytes 4 to 7, signed, read here as unsigned
  UINT8 balance[8];                 // bytes 8 to 15
  UINT8 current_value[8];           // bytes 16 to 23
  UINT8 previous_balance[8];        // bytes 24 to 31
  UINT8 previous_value[8];          // bytes 32 to 39
} SharesInIssueData;

// ---- Trade Date: 12 bytes ----------------------------------------------------

// Trade Date
entrypoint typedef struct _TradeDate {
  UINT32 year;   // bytes 0 to 3, signed, read here as unsigned
  UINT32 month;  // bytes 4 to 7, signed, read here as unsigned
  UINT32 day;    // bytes 8 to 11, signed, read here as unsigned
} TradeDate;

// ---- Index Data: 36 bytes ----------------------------------------------------

// Index Data
entrypoint typedef struct _IndexData {
  UINT32 index_data_sequence;      // bytes 0 to 3, signed, read here as unsigned
  UINT32 indices_sequence;         // bytes 4 to 7, signed, read here as unsigned
  TradeDate trade_date;            // bytes 8 to 19
  UINT8 index_value[8];            // bytes 20 to 27
  UINT8 market_capitalization[8];  // bytes 28 to 35
} IndexData;

// ---- Index Constituents Data: 12 bytes ---------------------------------------

// Index Constituents Data
entrypoint typedef struct _IndexConstituentsData {
  UINT32 index_instrument_sequence;  // bytes 0 to 3, signed, read here as unsigned
  UINT32 indices_sequence;           // bytes 4 to 7, signed, read here as unsigned
  UINT32 instrument_sequence;        // bytes 8 to 11, signed, read here as unsigned
} IndexConstituentsData;

// ---- Secondary Expiry Date: 12 bytes -----------------------------------------

// Secondary Expiry Date
entrypoint typedef struct _SecondaryExpiryDate {
  UINT32 year;   // bytes 0 to 3, signed, read here as unsigned
  UINT32 month;  // bytes 4 to 7, signed, read here as unsigned
  UINT32 day;    // bytes 8 to 11, signed, read here as unsigned
} SecondaryExpiryDate;

// ---- Order Contract: 48 bytes ------------------------------------------------

// Order Contract
entrypoint typedef struct _OrderContract {
  UINT8 identifier_prefix_b_4[4];             // bytes 0 to 3
  ExpiryDate expiry_date;                     // bytes 4 to 15
  UINT8 instrument_name_b_5[5];               // bytes 16 to 20
  UINT8 strike[8];                            // bytes 21 to 28
  UINT8 call_put_b_1;                         // byte 29
  SecondaryExpiryDate secondary_expiry_date;  // bytes 30 to 41
  UINT8 secondary_instrument_name_b_5[5];     // bytes 42 to 46
  UINT8 is_delta_option;                      // byte 47
} OrderContract;

// ---- Completed Trade Message: 156 bytes --------------------------------------

// Sent when an order has been matched or trading has occurred between two parties.
entrypoint typedef struct _CompletedTradeMessage {
  OrderContract order_contract;     // bytes 0 to 47
  UINT32 sequence_number;           // bytes 48 to 51, signed, read here as unsigned
  UINT8 price[8];                   // bytes 52 to 59
  UINT8 quantity_d_8[8];            // bytes 60 to 67
  UINT8 open_price[8];              // bytes 68 to 75
  UINT8 previous_closing_price[8];  // bytes 76 to 83
  UINT8 closing_price[8];           // bytes 84 to 91
  UINT8 change[8];                  // bytes 92 to 99
  UINT8 open_interest[8];           // bytes 100 to 107
  UINT8 low[8];                     // bytes 108 to 115
  UINT8 high[8];                    // bytes 116 to 123
  UINT8 day_volume[8];              // bytes 124 to 131
  UINT8 vwap[8];                    // bytes 132 to 139
  UINT32 trade_type;                // bytes 140 to 143, values TRADE_TYPE_, signed, read here as unsigned
  TradeDate trade_date;             // bytes 144 to 155
} CompletedTradeMessage;

// ---- Last Dealt Time: 4 bytes ------------------------------------------------

// Last Dealt Time
entrypoint typedef struct _LastDealtTime {
  UINT8 hours;     // byte 0
  UINT8 minutes;   // byte 1
  UINT8 seconds;   // byte 2
  UINT8 unused_1;  // byte 3
} LastDealtTime;

// ---- Display: 204 bytes ------------------------------------------------------

// Display
entrypoint typedef struct _Display {
  UINT8 trading_anonymous;                     // byte 0
  Contract contract;                           // bytes 1 to 48
  UINT8 mid_price[8];                          // bytes 49 to 56
  UINT8 last_dealt_price[8];                   // bytes 57 to 64
  LastDealtTime last_dealt_time;               // bytes 65 to 68
  UINT64 deal_volume;                          // bytes 69 to 76, signed, read here as unsigned
  UINT8 high_price[8];                         // bytes 77 to 84
  UINT8 low_price[8];                          // bytes 85 to 92
  UINT64 days_volume_i_8;                      // bytes 93 to 100, signed, read here as unsigned
  UINT32 last_order_qty;                       // bytes 101 to 104, signed, read here as unsigned
  UINT8 last_order_buy_sell;                   // byte 105
  UINT8 last_order_price[8];                   // bytes 106 to 113
  UINT8 number_of_depth;                       // byte 114
  UINT8 open_interest[8];                      // bytes 115 to 122
  UINT8 change[8];                             // bytes 123 to 130
  UINT8 auction;                               // byte 131, values AUCTION_
  UINT8 contract_status;                       // byte 132, values CONTRACT_STATUS_
  UINT8 odd_lot;                               // byte 133
  UINT64 last_traded_quantity;                 // bytes 134 to 141, signed, read here as unsigned
  UINT32 date_sequence;                        // bytes 142 to 145, signed, read here as unsigned
  UINT32 secondary_contract_date_sequence;     // bytes 146 to 149, signed, read here as unsigned
  UINT32 strike_sequence;                      // bytes 150 to 153, signed, read here as unsigned
  UINT32 market_shard_global_sequence_number;  // bytes 154 to 157, signed, read here as unsigned
  UINT32 stack_sequence_number;                // bytes 158 to 161, signed, read here as unsigned
  UINT8 unused_21[21];                         // bytes 162 to 182
  UpdateTime update_time;                      // bytes 183 to 186
  UINT8 vwap[8];                               // bytes 187 to 194
  UINT8 closing_price[8];                      // bytes 195 to 202
  UINT8 reserved_1;                            // byte 203
} Display;

// ---- Buy Who Member: 6 bytes -------------------------------------------------

// Member bidding
entrypoint typedef struct _BuyWhoMember {
  UINT8 buy_who_length_byte;    // byte 0
  UINT8 buy_who_characters[5];  // bytes 1 to 5
} BuyWhoMember;

// ---- Buy Who Unique Member: 6 bytes ------------------------------------------

// Anonymous contract: length byte 0, then the unique member number
entrypoint typedef struct _BuyWhoUniqueMember {
  UINT8 buy_who_length_byte;    // byte 0
  UINT32 unique_member_number;  // bytes 1 to 4, signed, read here as unsigned
  UINT8 unused_1;               // byte 5
} BuyWhoUniqueMember;

// ---- Sell Who Member: 6 bytes ------------------------------------------------

// Member asking
entrypoint typedef struct _SellWhoMember {
  UINT8 sell_who_length_byte;    // byte 0
  UINT8 sell_who_characters[5];  // bytes 1 to 5
} SellWhoMember;

// ---- Sell Who Unique Member: 6 bytes -----------------------------------------

// Anonymous contract: length byte 0, then the unique member number
entrypoint typedef struct _SellWhoUniqueMember {
  UINT8 sell_who_length_byte;   // byte 0
  UINT32 unique_member_number;  // bytes 1 to 4, signed, read here as unsigned
  UINT8 unused_1;               // byte 5
} SellWhoUniqueMember;

// ---- Index Sequence Number: 4 bytes ------------------------------------------

// Indicates the sequence number of the index.
entrypoint typedef struct _IndexSequenceNumber {
  UINT8 index_sequence_number_length_byte;    // byte 0
  UINT8 index_sequence_number_characters[3];  // bytes 1 to 3
} IndexSequenceNumber;

// ---- Indices Message: 44 bytes -----------------------------------------------

// Each Index will be sent in this format.
entrypoint typedef struct _IndicesMessage {
  IndexSequenceNumber index_sequence_number;  // bytes 0 to 3
  UINT8 opening_price[8];                     // bytes 4 to 11
  UINT8 index_price[8];                       // bytes 12 to 19
  UpdateTime update_time;                     // bytes 20 to 23
  UpdateDate update_date;                     // bytes 24 to 35
  UINT8 market_capitalisation[8];             // bytes 36 to 43
} IndicesMessage;

// ---- Message P 250: 250 bytes ------------------------------------------------

// A Description of the error.
entrypoint typedef struct _MessageP250 {
  UINT8 message_p_250_length_byte;      // byte 0
  UINT8 message_p_250_characters[249];  // bytes 1 to 249
} MessageP250;

// ---- Exchange Announcements Message: 263 bytes -------------------------------

// Error and information messages.
entrypoint typedef struct _ExchangeAnnouncementsMessage {
  UINT32 market_number_i_4;              // bytes 0 to 3, signed, read here as unsigned
  UINT32 market_shard_number_i_4;        // bytes 4 to 7, signed, read here as unsigned
  UINT32 error_number;                   // bytes 8 to 11, values ERROR_NUMBER_, signed, read here as unsigned
  UINT8 information_or_error_indicator;  // byte 12, values INFORMATION_OR_ERROR_INDICATOR_
  MessageP250 message_p_250;             // bytes 13 to 262
} ExchangeAnnouncementsMessage;

// ---- Notification Of Failure Message: 12 bytes -------------------------------

// Sent on the failure or the recovery of the exchange trading system.
entrypoint typedef struct _NotificationOfFailureMessage {
  UINT32 failure_notice_identifier;  // bytes 0 to 3, values FAILURE_NOTICE_IDENTIFIER_, signed, read here as unsigned
  UINT32 market_number_i_4;          // bytes 4 to 7, signed, read here as unsigned
  UINT32 market_shard_number_i_4;    // bytes 8 to 11, signed, read here as unsigned
} NotificationOfFailureMessage;

// ---- Reference Message Type: 3 bytes -----------------------------------------

// Indicates the message type of the incoming message this reject is in response to.
entrypoint typedef struct _ReferenceMessageType {
  UINT8 reference_message_type_length_byte;    // byte 0
  UINT8 reference_message_type_characters[2];  // bytes 1 to 2
} ReferenceMessageType;

// ---- Text P 250: 250 bytes ---------------------------------------------------

// The text of the rejection message.
entrypoint typedef struct _TextP250 {
  UINT8 text_p_250_length_byte;      // byte 0
  UINT8 text_p_250_characters[249];  // bytes 1 to 249
} TextP250;

// ---- Business Message Reject Message: 257 bytes ------------------------------

// Returned in response to an incoming message to indicate a failure to process this message for some business validation failure.
entrypoint typedef struct _BusinessMessageRejectMessage {
  UINT32 reference_sequence_number;             // bytes 0 to 3, signed, read here as unsigned
  ReferenceMessageType reference_message_type;  // bytes 4 to 6
  TextP250 text_p_250;                          // bytes 7 to 256
} BusinessMessageRejectMessage;

