#define SERVER_MESSAGE_TYPE_NOTIFICATION_OF_FAILURE_MESSAGE 0x7F     // Notification Of Failure Message
#define SERVER_MESSAGE_TYPE_BUSINESS_MESSAGE_REJECT_MESSAGE 0x84     // Business Message Reject Message

