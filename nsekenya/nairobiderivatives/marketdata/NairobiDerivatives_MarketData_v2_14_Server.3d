} GroupDescription;

// ---- First Trade Reference: 10 bytes -----------------------------------------

// Indicates the reference number of the first trade on this instrument.
entrypoint typedef struct _FirstTradeReference {
  UINT8 first_trade_reference_length_byte;    // byte 0
  UINT8 first_trade_reference_characters[9];  // bytes 1 to 9
} FirstTradeReference;

// ---- Display Name: 30 bytes --------------------------------------------------

// This field allows the exchange to indicate how an instrument should be presented.
entrypoint typedef struct _DisplayName {
  UINT8 display_name_length_byte;     // byte 0
  UINT8 display_name_characters[29];  // bytes 1 to 29
} DisplayName;

// ---- Classification: 30 bytes ------------------------------------------------

// This field defines the instrument classification to which the bonds belongs to.
entrypoint typedef struct _Classification {
  UINT8 classification_length_byte;     // byte 0
