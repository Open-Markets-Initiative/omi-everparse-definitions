// Server Message Type: one byte code
#define SERVER_MESSAGE_TYPE_SUCCESSFUL_LOG_IN_RESPONSE_MESSAGE 0x01  // Successful Log In Response Message
#define SERVER_MESSAGE_TYPE_HEART_BEAT_MESSAGE 0x0A                  // Heart Beat Message
#define SERVER_MESSAGE_TYPE_SESSION_KEY_CHALLENGE_MESSAGE 0x10       // Session Key Challenge Message
