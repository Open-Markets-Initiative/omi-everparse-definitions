#define LINKED_TO_FLOATING_RATE_NONE 0x4E       // None
#define LINKED_TO_FLOATING_RATE_CPI_INDEX 0x43  // Cpi Index

// Price Rate: one byte code
#define PRICE_RATE_PRICE 0x50  // Price
#define PRICE_RATE_RATE 0x52   // Rate

// Call Or Put: one byte code
#define CALL_OR_PUT_CALL 0x43  // Call
#define CALL_OR_PUT_PUT 0x50   // Put

// Message Category Type: 2 byte code
#define MESSAGE_CATEGORY_TYPE_GENERAL 0x0001     // General
#define MESSAGE_CATEGORY_TYPE_INSTRUMENT 0x0002  // Instrument
#define MESSAGE_CATEGORY_TYPE_SECTOR 0x0003      // Sector

// Trade Type: 4 byte code
#define TRADE_TYPE_NORMAL 0x00000000  // Normal
#define TRADE_TYPE_ODD 0x00000001     // Odd

// Auction: one byte code
#define AUCTION_CONTRACT_IS_OPEN 0x00                     // Contract Is Open
#define AUCTION_CONTRACT_IS_IN_AUCTION 0x01               // Contract Is In Auction
#define AUCTION_CONTRACT_IS_CLOSED 0x02                   // Contract Is Closed
#define AUCTION_CONTRACT_IS_SUSPENDED 0x03                // Contract Is Suspended
#define AUCTION_CONTRACT_IN_OPEN_ORDER_PERIOD 0x04        // Contract In Open Order Period
#define AUCTION_CONTRACT_IS_AFTER_OPEN_PERIOD 0x05        // Contract Is After Open Period
#define AUCTION_CONTRACT_INSTRUMENT_HAS_BEEN_HALTED 0x06  // Contract Instrument Has Been Halted

// Contract Status: one byte code
#define CONTRACT_STATUS_BID_OR_OFFER_ACTIVITY_WITH_NO_CHANGE_TO_BEST_BID_OR_OFFER 0x00                         // Bid Or Offer Activity With No Change To Best Bid Or Offer
#define CONTRACT_STATUS_BID_ACTIVITY_WHICH_HAS_CHANGED_THE_BEST_BID_ON_THIS_CONTRACT 0x01                      // Bid Activity Which Has Changed The Best Bid On This Contract
#define CONTRACT_STATUS_OFFER_ACTIVITY_WHICH_HAS_CHANGED_THE_BEST_OFFER_ON_THIS_CONTRACT 0x02                  // Offer Activity Which Has Changed The Best Offer On This Contract
#define CONTRACT_STATUS_BID_OR_OFFER_ACTIVITY_WHICH_HAS_CHANGED_BOTH_THE_BEST_BID_AND_OFFER_ON_TH_8tb7dp 0x03  // Bid Or Offer Activity Which Has Changed Both The Best Bid And Offer On This Contract
#define CONTRACT_STATUS_TRADE_ACTIVITY_HAS_BEEN_RECORDED_ON_THIS_CONTRACT_WITH_NO_CHANGE_TO_THE_B_8i524x 0x04  // Trade Activity Has Been Recorded On This Contract With No Change To The Best Bid Or Offer Indicates That The Close Price Has Updated
#define CONTRACT_STATUS_TRADE_ACTIVITY_WHICH_HAS_CHANGED_THE_BEST_BID_ON_THIS_CONTRACT 0x05                    // Trade Activity Which Has Changed The Best Bid On This Contract
#define CONTRACT_STATUS_TRADE_ACTIVITY_WHICH_HAS_CHANGED_THE_BEST_OFFER_ON_THIS_CONTRACT 0x06                  // Trade Activity Which Has Changed The Best Offer On This Contract
#define CONTRACT_STATUS_TRADE_ACTIVITY_WHICH_HAS_CHANGED_THE_BEST_BID_AND_OFFER_ON_THIS_CONTRACT 0x07          // Trade Activity Which Has Changed The Best Bid And Offer On This Contract

