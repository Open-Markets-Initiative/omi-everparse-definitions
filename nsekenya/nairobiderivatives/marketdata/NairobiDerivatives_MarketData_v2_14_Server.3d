#define FAILURE_NOTICE_IDENTIFIER_MARKET_SHARD_HAS_FAILED 0x00000001     // Market Shard Has Failed
#define FAILURE_NOTICE_IDENTIFIER_MARKET_SHARD_HAS_RECOVERED 0x00000002  // Market Shard Has Recovered

// ---- Transport Header: 4 bytes -----------------------------------------------

// Table 1: Transport Header
entrypoint typedef struct _TransportHeader {
  UINT8 start_byte;       // byte 0
  UINT16 message_length;  // bytes 1 to 2
  UINT8 length_check;     // byte 3
} TransportHeader;

// ---- User Name: 16 bytes -----------------------------------------------------

// User name as assigned by the exchange
entrypoint typedef struct _UserName {
  UINT8 user_name_length_byte;     // byte 0
  UINT8 user_name_characters[15];  // bytes 1 to 15
} UserName;

// ---- Time: 4 bytes -----------------------------------------------------------

// Time
entrypoint typedef struct _Time {
  UINT8 hours;     // byte 0
  UINT8 minutes;   // byte 1
  UINT8 seconds;   // byte 2
  UINT8 unused_1;  // byte 3
} Time;

// ---- Server Message Header: 29 bytes -----------------------------------------

// Table 2: Message Header
entrypoint typedef struct _ServerMessageHeader {
  UINT32 sequence_number;     // bytes 0 to 3, signed, read here as unsigned
  UserName user_name;         // bytes 4 to 19
  UINT32 user_number;         // bytes 20 to 23, signed, read here as unsigned
  Time time;                  // bytes 24 to 27
  UINT8 server_message_type;  // byte 28, values SERVER_MESSAGE_TYPE_
} ServerMessageHeader;

// ---- Today Date: 12 bytes ----------------------------------------------------

// Today date
entrypoint typedef struct _TodayDate {
  UINT32 year;   // bytes 0 to 3, signed, read here as unsigned
  UINT32 month;  // bytes 4 to 7, signed, read here as unsigned
  UINT32 day;    // bytes 8 to 11, signed, read here as unsigned
} TodayDate;

// ---- Country Code: 4 bytes ---------------------------------------------------

// Indicates the exchanges country code.
entrypoint typedef struct _CountryCode {
  UINT8 country_code_length_byte;    // byte 0
  UINT8 country_code_characters[3];  // bytes 1 to 3
} CountryCode;

// ---- Previous Business Day: 12 bytes -----------------------------------------

// Previous Business Day
entrypoint typedef struct _PreviousBusinessDay {
  UINT32 year;   // bytes 0 to 3, signed, read here as unsigned
  UINT32 month;  // bytes 4 to 7, signed, read here as unsigned
  UINT32 day;    // bytes 8 to 11, signed, read here as unsigned
} PreviousBusinessDay;

// ---- Text P 50: 50 bytes -----------------------------------------------------

// Indicates further detail on logon failures and success.
entrypoint typedef struct _TextP50 {
  UINT8 text_p_50_length_byte;     // byte 0
  UINT8 text_p_50_characters[49];  // bytes 1 to 49
} TextP50;

// ---- Member Code P 6: 6 bytes ------------------------------------------------

// Member code of affiliated member.
entrypoint typedef struct _MemberCodeP6 {
  UINT8 member_code_p_6_length_byte;    // byte 0
  UINT8 member_code_p_6_characters[5];  // bytes 1 to 5
} MemberCodeP6;

// ---- Session Key Challenge Message: 243 bytes --------------------------------

// Returned to a user when a successful TCP socket connection is established to the system.
entrypoint typedef struct _SessionKeyChallengeMessage {
  UINT8 challenge[243];  // bytes 0 to 242
} SessionKeyChallengeMessage;

// ---- Download Date: 12 bytes -------------------------------------------------

// Download Date
entrypoint typedef struct _DownloadDate {
  UINT32 year;   // bytes 0 to 3, signed, read here as unsigned
  UINT32 month;  // bytes 4 to 7, signed, read here as unsigned
  UINT32 day;    // bytes 8 to 11, signed, read here as unsigned
} DownloadDate;

// ---- Date: 12 bytes ----------------------------------------------------------

// Date
entrypoint typedef struct _Date {
  UINT32 year;   // bytes 0 to 3, signed, read here as unsigned
  UINT32 month;  // bytes 4 to 7, signed, read here as unsigned
  UINT32 day;    // bytes 8 to 11, signed, read here as unsigned
} Date;

// ---- Instrument Name P 5: 5 bytes --------------------------------------------

// Defines the instrument which represents this contract.
entrypoint typedef struct _InstrumentNameP5 {
  UINT8 instrument_name_p_5_length_byte;    // byte 0
  UINT8 instrument_name_p_5_characters[4];  // bytes 1 to 4
} InstrumentNameP5;

// ---- Secondary Date: 12 bytes ------------------------------------------------

// Secondary Date
entrypoint typedef struct _SecondaryDate {
  UINT32 year;   // bytes 0 to 3, signed, read here as unsigned
  UINT32 month;  // bytes 4 to 7, signed, read here as unsigned
  UINT32 day;    // bytes 8 to 11, signed, read here as unsigned
} SecondaryDate;

// ---- Secondary Instrument Name P 5: 5 bytes ----------------------------------

// For strategy type products such as Product spreads, represents the instrument name of the second leg of the contract.
entrypoint typedef struct _SecondaryInstrumentNameP5 {
  UINT8 secondary_instrument_name_p_5_length_byte;    // byte 0
  UINT8 secondary_instrument_name_p_5_characters[4];  // bytes 1 to 4
} SecondaryInstrumentNameP5;

// ---- Contract: 48 bytes ------------------------------------------------------

// Contract
entrypoint typedef struct _Contract {
  UINT32 identifier_prefix_i_4;                             // bytes 0 to 3, signed, read here as unsigned
  Date date;                                                // bytes 4 to 15
  InstrumentNameP5 instrument_name_p_5;                     // bytes 16 to 20
  UINT8 strike[8];                                          // bytes 21 to 28
  UINT8 call_put_c_1;                                       // byte 29
  SecondaryDate secondary_date;                             // bytes 30 to 41
  SecondaryInstrumentNameP5 secondary_instrument_name_p_5;  // bytes 42 to 46
  UINT8 is_delta_option;                                    // byte 47
} Contract;

// ---- Market Display Data: 80 bytes -------------------------------------------

// Market Display Data
entrypoint typedef struct _MarketDisplayData {
  UINT32 display_sequence;            // bytes 0 to 3, signed, read here as unsigned
  Contract contract;                  // bytes 4 to 51
  UINT8 open_price[8];                // bytes 52 to 59
  UINT32 instrument_sequence;         // bytes 60 to 63, signed, read here as unsigned
  UINT32 date_sequence;               // bytes 64 to 67, signed, read here as unsigned
  UINT32 strike_sequence;             // bytes 68 to 71, signed, read here as unsigned
  UINT32 second_instrument_sequence;  // bytes 72 to 75, signed, read here as unsigned
  UINT32 second_date_sequence;        // bytes 76 to 79, signed, read here as unsigned
} MarketDisplayData;

// ---- Isin Code: 13 bytes -----------------------------------------------------

// ISIN number of the instrument.
entrypoint typedef struct _IsinCode {
