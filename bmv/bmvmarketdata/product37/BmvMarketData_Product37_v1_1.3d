// ---- INTRA Multicast Header: 17 bytes ----------------------------------------

// BMV INTRA Multicast Header
entrypoint typedef struct _INTRAMulticastHeader {
  UINT16BE length;           // bytes 0 to 1, signed, read here as unsigned
  UINT8 total_messages;      // byte 2, signed, read here as unsigned
  UINT8 market_data_group;   // byte 3, signed, read here as unsigned
  UINT8 session;             // byte 4, signed, read here as unsigned
  UINT32BE sequence_number;  // bytes 5 to 8, signed, read here as unsigned
  UINT64BE datetime;         // bytes 9 to 16, signed, read here as unsigned
} INTRAMulticastHeader;

// ---- Message Header: 4 bytes -------------------------------------------------

// Message length and message type
entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;  // bytes 0 to 1, signed, read here as unsigned
  UINT16BE message_type;    // bytes 2 to 3
} MessageHeader;

// ---- Order Adition Message: 35 bytes -----------------------------------------

// When the order is accepted by the BMV central system, this message is disseminated to the relevant media.
entrypoint typedef struct _OrderAditionMessage {
  UINT32BE id_instrument;  // bytes 0 to 3, signed, read here as unsigned
  UINT64BE date_and_hour;  // bytes 4 to 11, signed, read here as unsigned
  UINT32BE folio;          // bytes 12 to 15, signed, read here as unsigned
  UINT8 direction;         // byte 16
  UINT32BE volume;         // bytes 17 to 20, signed, read here as unsigned
  UINT64BE price;          // bytes 21 to 28, signed, read here as unsigned
  UINT8 participant[5];    // bytes 29 to 33
  UINT8 operation_type;    // byte 34
} OrderAditionMessage;

// ---- Execution Of Orders Message: 33 bytes -----------------------------------

// The message is disseminated as soon as there is a match in the BMV's electronic system.
entrypoint typedef struct _ExecutionOfOrdersMessage {
  UINT32BE id_instrument;    // bytes 0 to 3, signed, read here as unsigned
  UINT64BE date;             // bytes 4 to 11, signed, read here as unsigned
  UINT32BE folio;            // bytes 12 to 15, signed, read here as unsigned
  UINT32BE volume;           // bytes 16 to 19, signed, read here as unsigned
  UINT32BE trade_number;     // bytes 20 to 23, signed, read here as unsigned
  UINT64BE execution_price;  // bytes 24 to 31, signed, read here as unsigned
  UINT8 operation_type;      // byte 32
} ExecutionOfOrdersMessage;

// ---- Order Cancellation Message: 17 bytes ------------------------------------

// This message indicates the fully elimination of an order in the trading floor
entrypoint typedef struct _OrderCancellationMessage {
  UINT32BE id_instrument;  // bytes 0 to 3, signed, read here as unsigned
  UINT64BE date;           // bytes 4 to 11, signed, read here as unsigned
  UINT32BE folio;          // bytes 12 to 15, signed, read here as unsigned
  UINT8 operation_type;    // byte 16
} OrderCancellationMessage;

// ---- Order Change Message: 42 bytes ------------------------------------------

// Message sent when the order modifies any of its data, the system assigns it a new priority in the electronic book, the order to be replaced is identified with the original Instrument, Date, and Folio, and the new priority assignment in the electronic book appears in the New Date and Folio fields.
entrypoint typedef struct _OrderChangeMessage {
  UINT32BE id_instrument;   // bytes 0 to 3, signed, read here as unsigned
  UINT64BE original_date;   // bytes 4 to 11, signed, read here as unsigned
  UINT32BE original_folio;  // bytes 12 to 15, signed, read here as unsigned
  UINT64BE new_date;        // bytes 16 to 23, signed, read here as unsigned
  UINT32BE new_folio;       // bytes 24 to 27, signed, read here as unsigned
  UINT8 direction;          // byte 28
  UINT32BE volume;          // bytes 29 to 32, signed, read here as unsigned
  UINT64BE price;           // bytes 33 to 40, signed, read here as unsigned
  UINT8 operation_type;     // byte 41
} OrderChangeMessage;

