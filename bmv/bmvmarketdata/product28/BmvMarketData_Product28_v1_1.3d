// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out BmvMarketData_Product28_v1_1.3d

// ---- Values ------------------------------------------------------------------

// Market Data Group: one byte code
#define MARKET_DATA_GROUP_INDEPTH_LOCAL_MARKET 0x01                                                              // Indepth Local Market
#define MARKET_DATA_GROUP_INDEPTH_GLOBAL_MARKET 0x02                                                             // Indepth Global Market
#define MARKET_DATA_GROUP_TWENTY_PRICE_LEVELS_OF_LOCAL_MARKET 0x03                                               // Twenty Price Levels Of Local Market
#define MARKET_DATA_GROUP_TWENTY_PRICE_LEVELS_OF_GLOBAL_MARKET 0x04                                              // Twenty Price Levels Of Global Market
#define MARKET_DATA_GROUP_BEST_OFFERS_OF_LOCAL_MARKET 0x05                                                       // Best Offers Of Local Market
#define MARKET_DATA_GROUP_BEST_OFFERS_OF_GLOBAL_MARKET 0x06                                                      // Best Offers Of Global Market
#define MARKET_DATA_GROUP_TEN_PRICE_LEVELS_OF_DERIVATIVE_FUTURES 0x07                                            // Ten Price Levels Of Derivative Futures
#define MARKET_DATA_GROUP_TEN_PRICE_LEVELS_OF_DERIVATIVE_OPTIONS 0x08                                            // Ten Price Levels Of Derivative Options
#define MARKET_DATA_GROUP_BEST_OFFERS_FOR_DERIVATIVE_FUTURES 0x09                                                // Best Offers For Derivative Futures
#define MARKET_DATA_GROUP_BEST_OFFERS_FOR_DERIVATIVE_OPTIONS 0x0A                                                // Best Offers For Derivative Options
#define MARKET_DATA_GROUP_MONEY_MARKET 0x0B                                                                      // Money Market
#define MARKET_DATA_GROUP_INDICES_COMPONENTS 0x0C                                                                // Indices Components
#define MARKET_DATA_GROUP_LEVEL_OF_INDICES 0x0D                                                                  // Level Of Indices
#define MARKET_DATA_GROUP_LEVELS_OF_INAVS 0x0E                                                                   // Levels Of Inavs
#define MARKET_DATA_GROUP_INDEPTH_LOCAL_AND_GLOBAL_MARKET 0x0F                                                   // Indepth Local And Global Market
#define MARKET_DATA_GROUP_TWENTY_PRICE_LEVELS_OF_LOCAL_AND_GLOBAL_MARKET 0x10                                    // Twenty Price Levels Of Local And Global Market
#define MARKET_DATA_GROUP_BEST_OFFERS_OF_LOCAL_AND_GLOBAL_MARKET_WITH_MONEY_MARKET 0x11                          // Best Offers Of Local And Global Market With Money Market
#define MARKET_DATA_GROUP_TWENTY_PRICE_LEVELS_OF_LOCAL_AND_GLOBAL_MARKET_INDICES_COMPONENTS_LEVEL_O_mqjyxj 0x12  // Twenty Price Levels Of Local And Global Market Indices Components Level Of Indices And Levels Of Inavs
#define MARKET_DATA_GROUP_TEN_PRICE_LEVELS_OF_DERIVATIVE_FUTURES_AND_DERIVATIVE_OPTIONS 0x13                     // Ten Price Levels Of Derivative Futures And Derivative Options
#define MARKET_DATA_GROUP_BEST_OFFERS_FOR_DERIVATIVE_FUTURES_AND_DERIVATIVE_OPTIONS 0x14                         // Best Offers For Derivative Futures And Derivative Options
#define MARKET_DATA_GROUP_ADDED_VALUE_WITH_BENCHMARK 0x15                                                        // Added Value With Benchmark
#define MARKET_DATA_GROUP_ADDED_VALUE_WITH_CAPITALIZATION_RULES 0x16                                             // Added Value With Capitalization Rules
#define MARKET_DATA_GROUP_INDICES_LEVELS_WITH_DELAY 0x17                                                         // Indices Levels With Delay
#define MARKET_DATA_GROUP_LOCAL_AND_GLOBAL_MARKET_WITH_MONEY_MARKET_BEST_POSITIONS_WITH_DELAY 0x18               // Local And Global Market With Money Market Best Positions With Delay
#define MARKET_DATA_GROUP_EQUITIES_MARKET_TRADES_CONSOLIDATED_FEED 0x19                                          // Equities Market Trades Consolidated Feed
#define MARKET_DATA_GROUP_BEST_BID_OF_THE_EQUITIES_MARKET_CONSOLIDATED_FEED 0x1A                                 // Best Bid Of The Equities Market Consolidated Feed
#define MARKET_DATA_GROUP_FULL_DEPTH_CONSOLIDATED_FEED 0x1B                                                      // Full Depth Consolidated Feed
#define MARKET_DATA_GROUP_CLOSING_PRICE_ORIGIN 0x1C                                                              // Closing Price Origin
#define MARKET_DATA_GROUP_ANALYTICS_PRICE_AND_MARKET_DEPTH 0x1D                                                  // Analytics Price And Market Depth
#define MARKET_DATA_GROUP_ANALYTICS_MARKET_QUALITY 0x20                                                          // Analytics Market Quality
#define MARKET_DATA_GROUP_ANALYTICS_SPREAD_PERFORMANCE 0x21                                                      // Analytics Spread Performance
#define MARKET_DATA_GROUP_ANALYTICS_NEGOTIATION 0x22                                                             // Analytics Negotiation
#define MARKET_DATA_GROUP_INDICES_COMPONENTS_STRATEGY 0x23                                                       // Indices Components Strategy
#define MARKET_DATA_GROUP_INDICES_COMPONENTS_E_S_G 0x24                                                          // Indices Components ESG
#define MARKET_DATA_GROUP_M_O_C_LOCAL_AND_GLOBAL_MARKET 0x25                                                     // MOC Local And Global Market
#define MARKET_DATA_GROUP_CHANNEL_ZERO_CATALOGS 0x28                                                             // Channel Zero Catalogs

// Message Type: one byte code
#define MESSAGE_TYPE_EVENTS_SYSTEM_MESSAGE 0x53         // Events System Message
#define MESSAGE_TYPE_CLOSING_PRICE_ORIGIN_MESSAGE 0x7E  // Closing Price Origin Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_SYSTEM_HOURS 0x41                // Start Of System Hours
#define EVENT_CODE_CANCELATION_OF_OFFERS 0x42                // Cancelation Of Offers
#define EVENT_CODE_START_OF_OPENING_AUCTION 0x43             // Start Of Opening Auction
#define EVENT_CODE_START_OF_CONTINUOUS_MARKET 0x44           // Start Of Continuous Market
#define EVENT_CODE_START_OF_WAP_PERIOD 0x45                  // Start Of Wap Period
#define EVENT_CODE_CONTINUOUS_MARKET_ENDS 0x46               // Continuous Market Ends
#define EVENT_CODE_START_OF_AFTER_CLOSING_PHASE 0x47         // Start Of After Closing Phase
#define EVENT_CODE_IT_ENDS_AFTER_CLOSING 0x48                // It Ends After Closing
#define EVENT_CODE_TRANSMISSION_OF_FINAL_PRICES_ENDS 0x4A    // Transmission Of Final Prices Ends
#define EVENT_CODE_END_OF_SYSTEM_HOURS 0x4B                  // End Of System Hours
#define EVENT_CODE_START_OF_ADMINISTRATIVE_RECESS 0x4D       // Start Of Administrative Recess
#define EVENT_CODE_END_OF_ADMINISTRATIVE_RECESS 0x4E         // End Of Administrative Recess
#define EVENT_CODE_START_DVMAMX_MARKETS 0x4F                 // Start Dvmamx Markets
#define EVENT_CODE_END_OF_DVMA_MARKETS 0x50                  // End Of Dvma Markets
#define EVENT_CODE_END_OF_MX_MARKETS 0x51                    // End Of Mx Markets
#define EVENT_CODE_START_OF_OPC_MODALITY 0x52                // Start Of Opc Modality
#define EVENT_CODE_END_OF_OPC_MODALITY 0x53                  // End Of Opc Modality
#define EVENT_CODE_START_OF_SETTLEMENT_AUCTION 0x54          // Start Of Settlement Auction
#define EVENT_CODE_END_OF_SETTLEMENT_AUCTION 0x55            // End Of Settlement Auction
#define EVENT_CODE_FINAL_REGISTER_OF_SETTLEMENT_PRICES 0x56  // Final Register Of Settlement Prices
#define EVENT_CODE_OPEN_INTEREST 0x57                        // Open Interest

// Market: one byte code
#define MARKET_LOCAL 0x4C                   // Local
#define MARKET_GLOBAL 0x47                  // Global
#define MARKET_LOCAL_DEBT 0x44              // Local Debt
#define MARKET_GLOBAL_DEBT 0x46             // Global Debt
#define MARKET_MONEY 0x45                   // Money
#define MARKET_DOLLAR_OPTION_MARKET 0x4D    // Dollar Option Market
#define MARKET_STOCK_MARKET 0x58            // Stock Market
#define MARKET_FOREX_AND_RATES_MARKET 0x56  // Forex And Rates Market
#define MARKET_FIXED_INCOME 0x4A            // Fixed Income
#define MARKET_VARIABLE_INCOME 0x42         // Variable Income
#define MARKET_METALS 0x54                  // Metals
#define MARKET_MUTUAL_FUNDS 0x49            // Mutual Funds
#define MARKET_WARRANTS 0x57                // Warrants
#define MARKET_ALL_MARKETS 0x20             // All Markets

// Sending: one byte code
#define SENDING_PREOPENING 0x41     // Preopening
#define SENDING_AFTER_CLOSING 0x43  // After Closing

// ---- Types -------------------------------------------------------------------

// The system of events message is used to inform that an event has occurred, which needs to be of public domain.
typedef struct _EventsSystemMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 event_code;            // byte 4
  UINT8 market;                // byte 5
  UINT64BE sending_time;       // bytes 6 to 13, signed, read here as unsigned
  UINT64BE ending_time;        // bytes 14 to 21, signed, read here as unsigned
} EventsSystemMessage;

// Closing price origin
typedef struct _ClosingPriceOriginMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT64BE origin_price;       // bytes 4 to 11, signed, read here as unsigned
  UINT8 sending;               // byte 12
} ClosingPriceOriginMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: EventsSystemMessage events_system_message;
    case 0x7E: ClosingPriceOriginMessage closing_price_origin_message;
    default: UINT8 unknown[available];
  }
} Payload;

// BMV INTRA Multicast message block
typedef struct _MessageBlock (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1, signed, read here as unsigned
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, ((((UINT32) message_length) + 2) - 3)) payload[:byte-size-single-element-array ((((UINT32) message_length) + 2) - 3)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} MessageBlock;

// ---- Packet: Packet ----------------------------------------------------------

// Bmv INTRA Multicast Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 17) {
  UINT16BE length;                                                                                                                 // bytes 0 to 1, signed, read here as unsigned
  UINT8 total_messages;                                                                                                            // byte 2, signed, read here as unsigned
  UINT8 market_data_group;                                                                                                         // byte 3, signed, read here as unsigned
  UINT8 session;                                                                                                                   // byte 4, signed, read here as unsigned
  UINT32BE sequence_number;                                                                                                        // bytes 5 to 8, signed, read here as unsigned
  UINT64BE datetime;                                                                                                               // bytes 9 to 16, signed, read here as unsigned
  unit message_block_tally_start {:on-success *tally = 0; return true; };
  MessageBlock(tally) message_block[:byte-size (available - 17)];
  unit message_block_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) total_messages); };
} Packet;

