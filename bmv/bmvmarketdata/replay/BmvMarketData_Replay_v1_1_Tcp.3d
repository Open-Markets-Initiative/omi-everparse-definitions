  UINT8 price_setter;          // byte 29
  UINT8 operation_type;        // byte 30
  UINT64BE amount;             // bytes 31 to 38, signed, read here as unsigned
  UINT8 buy_broker[5];         // bytes 39 to 43
  UINT8 sell_broker[5];        // bytes 44 to 48
  UINT8 settlement;            // byte 49
  UINT8 auction_indicator;     // byte 50
} CapitalTradesMessage;

// ---- Probable Allocation Price Message: 16 bytes -----------------------------

// Sent during any auction type (Opening, Continuous, Volatility and Intraday) and only on instruments where there is already a virtual match or pre-allocation.
entrypoint typedef struct _ProbableAllocationPriceMessage {
  UINT32BE instrument_number;          // bytes 0 to 3, signed, read here as unsigned
  UINT64BE probable_allocation_price;  // bytes 4 to 11, signed, read here as unsigned
