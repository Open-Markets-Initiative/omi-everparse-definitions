// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x6361: CatalogForInstrumentsBelongingToTheLocalAndGlobalStockMar_gc6yau catalog_for_instruments_belonging_to_the_local_and_global_stock_market_message;
    case 0x6362: CatalogOfInstrumentsThatBelongToTheDebtMetalsAndMoneyMark_a9x5rm catalog_of_instruments_that_belong_to_the_debt_metals_and_money_market_message;
    case 0x6363: CatalogForInstrumentsBelongingToTheCapitalWarrantsMarketMessage catalog_for_instruments_belonging_to_the_capital_warrants_market_message;
    case 0x6364: OptionsFuturesAndSwapsDerivativesMarketInstrumentsCatalogMessage options_futures_and_swaps_derivatives_market_instruments_catalog_message;
    case 0x6365: CatalogSentForInstrumentsBelongingToCapitalTracsMessage catalog_sent_for_instruments_belonging_to_capital_tracs_message;
    case 0x6366: CatalogSentForInstrumentsBelongingToMutualFundsMessage catalog_sent_for_instruments_belonging_to_mutual_funds_message;
    case 0x6367: CatalogSentForInstrumentsBelongingToTheStrategyDerivative_nw7mmt catalog_sent_for_instruments_belonging_to_the_strategy_derivative_market_message;
    case 0x6379: UnderlyingValueOnWarrantsCatalogMessage underlying_value_on_warrants_catalog_message;
    default: UINT8 unknown[available];
  }
} Payload;

// BMV INTRA Multicast message block
typedef struct _MessageBlock (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 2 };                                                                                                                 // bytes 0 to 1, signed, read here as unsigned
  UINT16BE message_type;                                                                                                                                           // bytes 2 to 3
  Payload(message_type, ((((UINT32) message_length) + 2) - 4)) payload[:byte-size-single-element-array ((((UINT32) message_length) + 2) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} MessageBlock;

// ---- Packet: Packet ----------------------------------------------------------

// Bmv INTRA Multicast Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 17) {
  UINT16BE length;                                                                                                                 // bytes 0 to 1, signed, read here as unsigned
  UINT8 total_messages;                                                                                                            // byte 2, signed, read here as unsigned
  UINT8 market_data_group;                                                                                                         // byte 3, signed, read here as unsigned
  UINT8 session;                                                                                                                   // byte 4, signed, read here as unsigned
  UINT32BE sequence_number;                                                                                                        // bytes 5 to 8, signed, read here as unsigned
  UINT64BE datetime;                                                                                                               // bytes 9 to 16, signed, read here as unsigned
  unit message_block_tally_start {:on-success *tally = 0; return true; };
  MessageBlock(tally) message_block[:byte-size (available - 17)];
  unit message_block_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) total_messages); };
} Packet;

