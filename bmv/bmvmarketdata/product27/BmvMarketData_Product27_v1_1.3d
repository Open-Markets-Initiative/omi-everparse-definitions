// ---- Weighted Average Price Message: 21 bytes --------------------------------

// This message will have the weighted average price (WAP) per instrument and is sent for each transaction generated within the calculation period of the WAP (last 20 minutes of the trading session); when there are no more trades in this period, the message is sent with the Weighted Average Price in zeros.
entrypoint typedef struct _WeightedAveragePriceMessage {
  UINT32BE instrument_number;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                     // byte 4
  UINT64BE weighted_average_price;  // bytes 5 to 12, signed, read here as unsigned
  UINT64BE volatility;              // bytes 13 to 20, signed, read here as unsigned
} WeightedAveragePriceMessage;

// ---- System Events Message: 31 bytes -----------------------------------------

// The system events message is used to inform that an event has taken place, which needs to be disclosed to the public for its attention.
entrypoint typedef struct _SystemEventsMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                // byte 4
  UINT8 code_of_event;         // byte 5
  UINT8 market;                // byte 6
  UINT64BE send_time;          // bytes 7 to 14, signed, read here as unsigned
  UINT64BE end_time;           // bytes 15 to 22, signed, read here as unsigned
  UINT8 group[8];              // bytes 23 to 30
} SystemEventsMessage;

