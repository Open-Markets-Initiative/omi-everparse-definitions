#define CONCERTATION_AUCTION_OF_CHAIN_OF_FORWARDS 0x64                      // Auction Of Chain Of Forwards
#define CONCERTATION_DEPTH_OF_ROUND 0x65                                    // Depth Of Round
#define CONCERTATION_ROUND_OF_CHAIN_OF_FORWARDS 0x66                        // Round Of Chain Of Forwards
#define CONCERTATION_ROLLOVER_SENTRA 0x67                                   // Rollover Sentra
#define CONCERTATION_TYPE_ROUND 0x68                                        // Type Round
#define CONCERTATION_AUCTIONS 0x69                                          // Auctions
#define CONCERTATION_LEG_OF_BLOCK_TRADE_OF_ROLLOVER 0x6A                    // Leg Of Block Trade Of Rollover
#define CONCERTATION_LEG_OF_BLOCK_TRADE_OF_FOREIGN_CURRENCY_STRATEGY 0x6B   // Leg Of Block Trade Of Foreign Currency Strategy
#define CONCERTATION_BLOCK_TRADE_OF_FOREIGN_CURRENCY_STRATEGY 0x6C          // Block Trade Of Foreign Currency Strategy
#define CONCERTATION_BLOCK_TRADE_OF_CHAIN_OF_FORWARDS 0x6D                  // Block Trade Of Chain Of Forwards
#define CONCERTATION_BLOCKTRADE_OF_ROLLOVER 0x6E                            // Blocktrade Of Rollover
#define CONCERTATION_CROSSING_OF_CHAIN_OF_FORWARDS 0x6F                     // Crossing Of Chain Of Forwards
#define CONCERTATION_SELL_AUTO_ENTRY_OF_CHAIN_OF_FORWARDS 0x70              // Sell Auto Entry Of Chain Of Forwards
#define CONCERTATION_BUY_AUTO_ENTRY_OF_CHAIN_OF_FORWARDS 0x71               // Buy Auto Entry Of Chain Of Forwards
#define CONCERTATION_SWAP_BLOCK_TRADE 0x72                                  // Swap Block Trade
#define CONCERTATION_SWAP_BLOCK_TRADE_WITH_CONTINUOUS_COUPON 0x73           // Swap Block Trade With Continuous Coupon
#define CONCERTATION_BLOCK_TRADE_OF_UNWIND 0x74                             // Block Trade Of Unwind
#define CONCERTATION_BLOCK_TRADE_OF_SUBSTITUTION 0x75                       // Block Trade Of Substitution
#define CONCERTATION_VOICE_OVER 0x7A                                        // Voice Over
#define CONCERTATION_FIRM_ORDER 0x23                                        // Firm Order
#define CONCERTATION_IPO_CROSS 0x49                                         // Ipo Cross
#define CONCERTATION_UNINTENTIONAL_SELF_CROSS 0x2B                          // Unintentional Self Cross
#define CONCERTATION_WITHOUT_CONCERTATION 0x26                              // Without Concertation
#define CONCERTATION_INAV_TO_CLOSING_PRICE_TRADING 0x28                     // Inav To Closing Price Trading
#define CONCERTATION_INAV_AFTER_CLOSING 0x29                                // Inav After Closing

// Side: one byte code
#define SIDE_BUY 0x00   // Buy
#define SIDE_SELL 0x01  // Sell

// Offer Direction: one byte code
#define OFFER_DIRECTION_BUY 0x43   // Buy
#define OFFER_DIRECTION_SELL 0x56  // Sell

// Trend: one byte code
#define TREND_INCREASE 0x41           // Increase
#define TREND_DECREASE 0x42           // Decrease
#define TREND_WITHOUT_CHANGE 0x53     // Without Change
#define TREND_WITHOUT_OPERATION 0x20  // Without Operation

// Indices Status: one byte code
#define INDICES_STATUS_PREVIOUS 0x41             // Previous
#define INDICES_STATUS_PRELIMINARY 0x50          // Preliminary
#define INDICES_STATUS_PRELIMINARY_FIGURES 0x43  // Preliminary Figures
#define INDICES_STATUS_FINAL 0x44                // Final

// ---- Types -------------------------------------------------------------------

// The system of events message is used to inform that an event has occurred, which needs to be of public domain.
typedef struct _EventsSystemMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 event_code;            // byte 4
  UINT8 market;                // byte 5
  UINT64BE sending_time;       // bytes 6 to 13, signed, read here as unsigned
  UINT64BE ending_time;        // bytes 14 to 21, signed, read here as unsigned
} EventsSystemMessage;

// This message is sent when a transaction is cancelled from the BMV system.
typedef struct _TradeCancellationMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT32BE trade_number;       // bytes 4 to 7, signed, read here as unsigned
} TradeCancellationMessage;

// All instruments are in a certain status before and during trading session.
typedef struct _StatusChangesMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 instrument_status;     // byte 4
} StatusChangesMessage;

// For equities market, this message will be sent for each operation containing weighted average price per instrument generated within WAP calculation period (last 20 minutes of trading).
typedef struct _WeightedAveragePriceSettlementPricesMessage {
  UINT32BE instrument_number;       // bytes 0 to 3, signed, read here as unsigned
  UINT64BE weighted_average_price;  // bytes 4 to 11, signed, read here as unsigned
  UINT64BE volatility;              // bytes 12 to 19, signed, read here as unsigned
} WeightedAveragePriceSettlementPricesMessage;

// Contains information on any BMV accepted transaction.
typedef struct _CapitalTradesMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT64BE trade_time;         // bytes 4 to 11, signed, read here as unsigned
  UINT32BE volume;             // bytes 12 to 15, signed, read here as unsigned
  UINT64BE price;              // bytes 16 to 23, signed, read here as unsigned
  UINT8 concertation_type;     // byte 24
  UINT32BE trade_number;       // bytes 25 to 28, signed, read here as unsigned
  UINT8 price_setter;          // byte 29
  UINT8 operation_type;        // byte 30
  UINT64BE amount;             // bytes 31 to 38, signed, read here as unsigned
  UINT8 buy[5];                // bytes 39 to 43
  UINT8 sell[5];               // bytes 44 to 48
  UINT8 settlement;            // byte 49
  UINT8 auction_indicator;     // byte 50
} CapitalTradesMessage;

// Sent during any auction type (Opening, Continuous, Volatility and Intraday) and only on instruments where there is already a virtual match or pre-allocation.
typedef struct _ProbableAllocationPriceMessage {
  UINT32BE instrument_number;          // bytes 0 to 3, signed, read here as unsigned
  UINT64BE probable_allocation_price;  // bytes 4 to 11, signed, read here as unsigned
  UINT32BE volume;                     // bytes 12 to 15, signed, read here as unsigned
} ProbableAllocationPriceMessage;

// Sent at the moment one of the Continuous, Volatility or SIC auctions is generated.
typedef struct _ContinuousAuctionsBeginningMessage {
  UINT32BE instrument_number;          // bytes 0 to 3, signed, read here as unsigned
  UINT64BE beginning_time_of_auction;  // bytes 4 to 11, signed, read here as unsigned
  UINT64BE end_auction_time;           // bytes 12 to 19, signed, read here as unsigned
} ContinuousAuctionsBeginningMessage;

// Generated when an instrument enters a posture in the hidden electronic Middle Price book.
typedef struct _MiddlePriceExistingQuotesMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 existing_postures;     // byte 4
} MiddlePriceExistingQuotesMessage;

// Sent whenever there is a debt or capital instrument placement.
typedef struct _RegistryOperationsMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 offer_type;            // byte 4
  UINT8 income;                // byte 5
  UINT8 value_type[4];         // bytes 6 to 9
  UINT8 issuer[7];             // bytes 10 to 16
  UINT8 series[6];             // bytes 17 to 22
  UINT64BE maximum_volume;     // bytes 23 to 30, signed, read here as unsigned
  UINT64BE registered_volume;  // bytes 31 to 38, signed, read here as unsigned
  UINT64BE price_rate;         // bytes 39 to 46, signed, read here as unsigned
  UINT64BE settlement_date;    // bytes 47 to 54, signed, read here as unsigned
  UINT8 firm[5];               // bytes 55 to 59
  UINT8 movement;              // byte 60
} RegistryOperationsMessage;

// Contains any mutual funds operation realized.
typedef struct _MutualFundTradesMessage {
  UINT32BE instrument_number;             // bytes 0 to 3, signed, read here as unsigned
  UINT64BE trade_date;                    // bytes 4 to 11, signed, read here as unsigned
  UINT64BE price;                         // bytes 12 to 19, signed, read here as unsigned
  UINT64BE book_value;                    // bytes 20 to 27, signed, read here as unsigned
  UINT32BE number_of_sales_transactions;  // bytes 28 to 31, signed, read here as unsigned
  UINT64BE sales_volume;                  // bytes 32 to 39, signed, read here as unsigned
  UINT32BE number_of_buy_transactions;    // bytes 40 to 43, signed, read here as unsigned
  UINT64BE buy_volume;                    // bytes 44 to 51, signed, read here as unsigned
} MutualFundTradesMessage;

// Message sent every half hour during trading session, informing general tradability by instrument.
typedef struct _TradabilityMessage {
  UINT32BE instrument_number;     // bytes 0 to 3, signed, read here as unsigned
  UINT32BE number_of_operations;  // bytes 4 to 7, signed, read here as unsigned
  UINT64BE volume_long;           // bytes 8 to 15, signed, read here as unsigned
  UINT64BE amount;                // bytes 16 to 23, signed, read here as unsigned
  UINT64BE opening_price;         // bytes 24 to 31, signed, read here as unsigned
  UINT64BE maximum;               // bytes 32 to 39, signed, read here as unsigned
  UINT64BE minimum;               // bytes 40 to 47, signed, read here as unsigned
  UINT64BE average;               // bytes 48 to 55, signed, read here as unsigned
  UINT64BE last;                  // bytes 56 to 63, signed, read here as unsigned
} TradabilityMessage;

// When an operation has been pre-assigned to the at closing and average day Price electronic books, a virtual trade message is sent, where also notifying of this operation.
typedef struct _VirtualTradesMessage {
  UINT32BE instrument_number;   // bytes 0 to 3, signed, read here as unsigned
  UINT8 virtual_trades_status;  // byte 4
  UINT8 operation_type;         // byte 5
  UINT32BE number;              // bytes 6 to 9, signed, read here as unsigned
  UINT32BE volume;              // bytes 10 to 13, signed, read here as unsigned
  UINT8 concertation;           // byte 14
  UINT8 buy[5];                 // bytes 15 to 19
  UINT8 sell[5];                // bytes 20 to 24
} VirtualTradesMessage;

// One price level of the Depth message
typedef struct _PriceLevel {
  UINT64BE price;             // bytes 0 to 7, signed, read here as unsigned
  UINT16BE number_of_orders;  // bytes 8 to 9, signed, read here as unsigned
  UINT32BE volume;            // bytes 10 to 13, signed, read here as unsigned
} PriceLevel;

// Market depth: up to 20 best buy or sale price levels (10 on the derivatives groups 7, 8 and 19), as many as Purchase or sale levels.
typedef struct _DepthMessage {
  UINT32BE instrument_number;                                                    // bytes 0 to 3, signed, read here as unsigned
  UINT8 side;                                                                    // byte 4, signed, read here as unsigned
  UINT8 purchase_or_sale_levels;                                                 // byte 5, signed, read here as unsigned
  PriceLevel price_level[:byte-size (((UINT32) purchase_or_sale_levels) * 14)];
} DepthMessage;

// Message sent by instrument when best offer changes in the electronic book.
typedef struct _BestOfferMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT32BE volume;             // bytes 4 to 7, signed, read here as unsigned
  UINT64BE price_rate;         // bytes 8 to 15, signed, read here as unsigned
  UINT8 offer_direction;       // byte 16
  UINT8 operation_type;        // byte 17
} BestOfferMessage;

// Information about the MSE Indices.
typedef struct _GeneralIndicesMessage {
  UINT8 component[2];     // bytes 0 to 1
  UINT8 sector;           // byte 2, signed, read here as unsigned
  UINT64BE indices_hour;  // bytes 3 to 10, signed, read here as unsigned
  UINT64BE volume_long;   // bytes 11 to 18, signed, read here as unsigned
  UINT32BE indices;       // bytes 19 to 22, signed, read here as unsigned
  UINT32BE variation;     // bytes 23 to 26, signed, read here as unsigned
  UINT32BE percentage;    // bytes 27 to 30, signed, read here as unsigned
  UINT8 trend;            // byte 31
  UINT8 indices_status;   // byte 32
} GeneralIndicesMessage;

// TRACS dissemination during continuous market trading hours.
typedef struct _InavMessage {
  UINT32BE trac_number;                // bytes 0 to 3, signed, read here as unsigned
  UINT64BE theoretical_current_price;  // bytes 4 to 11, signed, read here as unsigned
} InavMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: EventsSystemMessage events_system_message;
    case 0x48: TradeCancellationMessage trade_cancellation_message;
    case 0x34: StatusChangesMessage status_changes_message;
    case 0x4D: WeightedAveragePriceSettlementPricesMessage weighted_average_price_settlement_prices_message;
    case 0x50: CapitalTradesMessage capital_trades_message;
    case 0x32: ProbableAllocationPriceMessage probable_allocation_price_message;
    case 0x33: ContinuousAuctionsBeginningMessage continuous_auctions_beginning_message;
    case 0x35: MiddlePriceExistingQuotesMessage middle_price_existing_quotes_message;
    case 0x5A: RegistryOperationsMessage registry_operations_message;
    case 0x59: MutualFundTradesMessage mutual_fund_trades_message;
    case 0x45: TradabilityMessage tradability_message;
    case 0x56: VirtualTradesMessage virtual_trades_message;
    case 0x31: DepthMessage depth_message;
    case 0x4F: BestOfferMessage best_offer_message;
    case 0x55: GeneralIndicesMessage general_indices_message;
    case 0x47: InavMessage inav_message;
    default: UINT8 unknown[available];
  }
} Payload;

// BMV INTRA Multicast message block
typedef struct _MessageBlock (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1, signed, read here as unsigned
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, ((((UINT32) message_length) + 2) - 3)) payload[:byte-size-single-element-array ((((UINT32) message_length) + 2) - 3)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} MessageBlock;

// ---- Packet: Packet ----------------------------------------------------------

// Bmv INTRA Multicast Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 17) {
  UINT16BE length;                                                                                                                 // bytes 0 to 1, signed, read here as unsigned
  UINT8 total_messages;                                                                                                            // byte 2, signed, read here as unsigned
  UINT8 market_data_group;                                                                                                         // byte 3, signed, read here as unsigned
  UINT8 session;                                                                                                                   // byte 4, signed, read here as unsigned
  UINT32BE sequence_number;                                                                                                        // bytes 5 to 8, signed, read here as unsigned
  UINT64BE datetime;                                                                                                               // bytes 9 to 16, signed, read here as unsigned
  unit message_block_tally_start {:on-success *tally = 0; return true; };
  MessageBlock(tally) message_block[:byte-size (available - 17)];
  unit message_block_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) total_messages); };
} Packet;

