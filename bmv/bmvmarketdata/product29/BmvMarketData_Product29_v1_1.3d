// Bolsa Mexicana de Valores Bmv Market Data Product 29
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out BmvMarketData_Product29_v1_1.3d
//
// What this definition does not state, and the model does:
// - a run counted by a field
//
// License: MIT No Attribution

// ---- INTRA Multicast Header: 17 bytes ----------------------------------------

// BMV INTRA Multicast Header
entrypoint typedef struct _INTRAMulticastHeader {
  UINT16BE length;           // bytes 0 to 1, signed, read here as unsigned
  UINT8 total_messages;      // byte 2, signed, read here as unsigned
  UINT8 market_data_group;   // byte 3, signed, read here as unsigned
  UINT8 session;             // byte 4, signed, read here as unsigned
  UINT32BE sequence_number;  // bytes 5 to 8, signed, read here as unsigned
  UINT64BE datetime;         // bytes 9 to 16, signed, read here as unsigned
} INTRAMulticastHeader;

// ---- Message Header: 3 bytes -------------------------------------------------

// Message length and message type
entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;  // bytes 0 to 1, signed, read here as unsigned
  UINT8 message_type;       // byte 2
} MessageHeader;

// ---- Last Quote Message: 23 bytes --------------------------------------------

// Message sent by instrument when the best bid is modified in the electronic book by the Origin Exchange; denotes the side that is modified, the sale or the purchase.
entrypoint typedef struct _LastQuoteMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                // byte 4
  UINT64BE volume;             // bytes 5 to 12, signed, read here as unsigned
  UINT64BE price_rate;         // bytes 13 to 20, signed, read here as unsigned
  UINT8 direction_of_the_bid;  // byte 21
  UINT8 type_of_trading;       // byte 22
} LastQuoteMessage;

// ---- Benchmark Trade Message: 25 bytes ---------------------------------------

// Trading statistics by trade.
entrypoint typedef struct _BenchmarkTradeMessage {
  UINT8 origin;                   // byte 0
  UINT64BE average_volume;        // bytes 1 to 8, signed, read here as unsigned
  UINT64BE average_traded_value;  // bytes 9 to 16, signed, read here as unsigned
  UINT8 market;                   // byte 17
  UINT8 sector;                   // byte 18, signed, read here as unsigned
  UINT32BE instrument_number;     // bytes 19 to 22, signed, read here as unsigned
  UINT8 indices[2];               // bytes 23 to 24
} BenchmarkTradeMessage;

// ---- Price Leaderboard Message: 33 bytes -------------------------------------

// Measures time proportion that a stock Exchange maintains the best bid and (or) ask throughout the session.
entrypoint typedef struct _PriceLeaderboardMessage {
  UINT8 origin;                 // byte 0
  UINT32BE t_best_bid;          // bytes 1 to 4, signed, read here as unsigned
  UINT32BE t_tie_best_bid;      // bytes 5 to 8, signed, read here as unsigned
  UINT32BE t_without_best_bid;  // bytes 9 to 12, signed, read here as unsigned
  UINT32BE t_best_ask;          // bytes 13 to 16, signed, read here as unsigned
  UINT32BE t_tie_best_ask;      // bytes 17 to 20, signed, read here as unsigned
  UINT32BE t_without_best_ask;  // bytes 21 to 24, signed, read here as unsigned
  UINT8 market;                 // byte 25
  UINT8 sector;                 // byte 26, signed, read here as unsigned
  UINT32BE instrument_number;   // bytes 27 to 30, signed, read here as unsigned
  UINT8 indices[2];             // bytes 31 to 32
} PriceLeaderboardMessage;

// ---- Trading Sniper Message: 73 bytes ----------------------------------------

// Quotes composition analysis, full and first ten depth levels
entrypoint typedef struct _TradingSniperMessage {
  UINT8 origin;                // byte 0
  UINT64BE depth_bid;          // bytes 1 to 8, signed, read here as unsigned
  UINT64BE depth_ask;          // bytes 9 to 16, signed, read here as unsigned
  UINT64BE depth_bid_10_l;     // bytes 17 to 24, signed, read here as unsigned
  UINT64BE depth_ask_10_l;     // bytes 25 to 32, signed, read here as unsigned
  UINT64BE vwp_bid_10_l;       // bytes 33 to 40, signed, read here as unsigned
  UINT64BE vwp_ask_10_l;       // bytes 41 to 48, signed, read here as unsigned
  UINT64BE vwp_bid;            // bytes 49 to 56, signed, read here as unsigned
  UINT64BE vwp_ask;            // bytes 57 to 64, signed, read here as unsigned
  UINT8 market;                // byte 65
  UINT8 sector;                // byte 66, signed, read here as unsigned
  UINT32BE instrument_number;  // bytes 67 to 70, signed, read here as unsigned
  UINT8 indices[2];            // bytes 71 to 72
} TradingSniperMessage;

// ---- Depth At Best Prices Message: 25 bytes ----------------------------------

// Identify the deepest quotes depth for the national best bid and offer.
entrypoint typedef struct _DepthAtBestPricesMessage {
  UINT8 origin;                // byte 0
  UINT16BE instruments_bb;     // bytes 1 to 2, signed, read here as unsigned
  UINT16BE instruments_gv_bb;  // bytes 3 to 4, signed, read here as unsigned
  UINT32BE ratio_v_at_bb;      // bytes 5 to 8, signed, read here as unsigned
  UINT16BE instruments_ba;     // bytes 9 to 10, signed, read here as unsigned
  UINT16BE instruments_gv_ba;  // bytes 11 to 12, signed, read here as unsigned
  UINT32BE ratio_v_at_ba;      // bytes 13 to 16, signed, read here as unsigned
  UINT8 market;                // byte 17
  UINT8 sector;                // byte 18, signed, read here as unsigned
  UINT32BE instrument_number;  // bytes 19 to 22, signed, read here as unsigned
  UINT8 indices[2];            // bytes 23 to 24
} DepthAtBestPricesMessage;

