// ---- Types -------------------------------------------------------------------

// Any transaction made in mutual funds is reported.
typedef struct _MutualFundsTradesMessage {
  UINT32BE instrument_number;          // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                        // byte 4
  UINT64BE date_of_the_trade;          // bytes 5 to 12, signed, read here as unsigned
  UINT64BE price;                      // bytes 13 to 20, signed, read here as unsigned
  UINT64BE book_value;                 // bytes 21 to 28, signed, read here as unsigned
  UINT32BE number_of_sales_trades;     // bytes 29 to 32, signed, read here as unsigned
  UINT64BE sales_volume;               // bytes 33 to 40, signed, read here as unsigned
  UINT32BE number_of_purchase_trades;  // bytes 41 to 44, signed, read here as unsigned
  UINT64BE purchase_volume;            // bytes 45 to 52, signed, read here as unsigned
} MutualFundsTradesMessage;

// The message is sent when one of the ongoing, volatility or SIC bidding sessions is generated.
typedef struct _OpeningOfContinuousAuctionsMessage {
  UINT32BE instrument_number;             // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                           // byte 4
  UINT64BE auction_session_startup_time;  // bytes 5 to 12, signed, read here as unsigned
  UINT64BE auction_session_end_time;      // bytes 13 to 20, signed, read here as unsigned
} OpeningOfContinuousAuctionsMessage;

// This message is generated when an instrument enters a bid in the hidden electronic book At Mean Price.
typedef struct _ExistenceOfBidsAtMidPriceMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                // byte 4
  UINT8 bids_existing;         // byte 5
} ExistenceOfBidsAtMidPriceMessage;

// Catalogue sent for instruments pertaining to the Local Fixed rate, Global Fixed rate and metals markets.
typedef struct _CatalogueOfDebtAndMetalsInstrumentsMessage {
  UINT32BE number_of_the_instrument;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                       // byte 4
  UINT8 type_of_value[2];             // bytes 5 to 6
  UINT8 issuing_company[7];           // bytes 7 to 13
  UINT8 issuance[6];                  // bytes 14 to 19
  UINT64BE date_of_issuance;          // bytes 20 to 27, signed, read here as unsigned
  UINT64BE date_of_maturity;          // bytes 28 to 35, signed, read here as unsigned
  UINT64BE price_rate_of_reference;   // bytes 36 to 43, signed, read here as unsigned
  UINT64BE date_of_reference;         // bytes 44 to 51, signed, read here as unsigned
  UINT8 reference;                    // byte 52
  UINT16BE term_days;                 // bytes 53 to 54, signed, read here as unsigned
  UINT16BE coupon_period;             // bytes 55 to 56, signed, read here as unsigned
  UINT8 isin[12];                     // bytes 57 to 68
  UINT8 market;                       // byte 69
  UINT64BE current_nominal_value;     // bytes 70 to 77, signed, read here as unsigned
  UINT64BE original_nominal_value;    // bytes 78 to 85, signed, read here as unsigned
  UINT64BE outstanding_shares;        // bytes 86 to 93, signed, read here as unsigned
  UINT64BE amount_placed;             // bytes 94 to 101, signed, read here as unsigned
  UINT8 trades_rate_price;            // byte 102
} CatalogueOfDebtAndMetalsInstrumentsMessage;

// Catalogue sent for instrument pertaining to the investment companies.
typedef struct _CatalogSentForInstrumentsBelongingToMutualFundsMessage {
  UINT32BE number_of_the_instrument;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                       // byte 4
  UINT8 type_of_value[2];             // bytes 5 to 6
  UINT8 issuing_company[7];           // bytes 7 to 13
  UINT8 series[6];                    // bytes 14 to 19
  UINT8 sector;                       // byte 20, signed, read here as unsigned
  UINT8 sub_sector;                   // byte 21, signed, read here as unsigned
  UINT8 industry;                     // byte 22, signed, read here as unsigned
  UINT8 sub_industry;                 // byte 23, signed, read here as unsigned
  UINT8 trading_company[10];          // bytes 24 to 33
  UINT64BE reference_price;           // bytes 34 to 41, signed, read here as unsigned
  UINT64BE reference_date;            // bytes 42 to 49, signed, read here as unsigned
  UINT8 reference;                    // byte 50
  UINT8 isin[12];                     // bytes 51 to 62
  UINT8 rating[15];                   // bytes 63 to 77
} CatalogSentForInstrumentsBelongingToMutualFundsMessage;

// This message will have the weighted average price (WAP) per instrument and is sent for each transaction generated within the calculation period of the WAP (last 20 minutes of the trading session); when there are no more trades in this period, the message is sent with the Weighted Average Price in zeros.
typedef struct _WeightedAveragePriceMessage {
  UINT32BE instrument_number;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                     // byte 4
  UINT64BE weighted_average_price;  // bytes 5 to 12, signed, read here as unsigned
  UINT64BE volatility;              // bytes 13 to 20, signed, read here as unsigned
} WeightedAveragePriceMessage;

// The system events message is used to inform that an event has taken place, which needs to be disclosed to the public for its attention.
typedef struct _SystemEventsMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                // byte 4
  UINT8 code_of_event;         // byte 5
  UINT8 market;                // byte 6
  UINT64BE send_time;          // bytes 7 to 14, signed, read here as unsigned
  UINT64BE end_time;           // bytes 15 to 22, signed, read here as unsigned
  UINT8 group[8];              // bytes 23 to 30
} SystemEventsMessage;

// This message is sent to define the reference price of an instrument.
typedef struct _ReferencePriceMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                // byte 4
  UINT64BE price;              // bytes 5 to 12, signed, read here as unsigned
  UINT8 price_type;            // byte 13
} ReferencePriceMessage;

// This message is sent when there has been a change in the status of the instruments.
typedef struct _ChangesInStatusMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                // byte 4
  UINT8 status;                // byte 5
  UINT8 reason;                // byte 6
} ChangesInStatusMessage;

// Catalogue for instruments pertaining to the Equities Warrants market.
typedef struct _CatalogForInstrumentsBelongingToTheCapitalWarrantsMarketMessage {
  UINT32BE number_of_the_instrument;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                       // byte 4
  UINT8 type_of_value[2];             // bytes 5 to 6
  UINT8 issuing_company[7];           // bytes 7 to 13
  UINT8 series[6];                    // bytes 14 to 19
  UINT8 type_of_warrant;              // byte 20
  UINT64BE date_of_maturity;          // bytes 21 to 28, signed, read here as unsigned
  UINT64BE price_of_exercise;         // bytes 29 to 36, signed, read here as unsigned
  UINT64BE reference_price;           // bytes 37 to 44, signed, read here as unsigned
  UINT64BE reference_date;            // bytes 45 to 52, signed, read here as unsigned
  UINT8 reference;                    // byte 53
  UINT8 isin[12];                     // bytes 54 to 65
} CatalogForInstrumentsBelongingToTheCapitalWarrantsMarketMessage;

// Catalogue sent for instruments pertaining to the equities TRACS.
typedef struct _CatalogSentForInstrumentsBelongingToCapitalTracsMessage {
  UINT32BE number_of_the_trac;          // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                         // byte 4
  UINT8 name_of_the_trac[8];            // bytes 5 to 12
  UINT8 underlying_issuing_company[7];  // bytes 13 to 19
  UINT8 underlying_series[6];           // bytes 20 to 25
  UINT64BE securities;                  // bytes 26 to 33, signed, read here as unsigned
  UINT64BE excluded_securities;         // bytes 34 to 41, signed, read here as unsigned
  UINT64BE price;                       // bytes 42 to 49, signed, read here as unsigned
  UINT64BE component_in_cash;           // bytes 50 to 57, signed, read here as unsigned
  UINT64BE excluded_value;              // bytes 58 to 65, signed, read here as unsigned
  UINT64BE number_of_certificates;      // bytes 66 to 73, signed, read here as unsigned
  UINT64BE theoretical_price;           // bytes 74 to 81, signed, read here as unsigned
} CatalogSentForInstrumentsBelongingToCapitalTracsMessage;

// Disclosure of the TRACS during the trading hours of the ongoing market.
typedef struct _ConsolidatedInavMessage {
  UINT32BE number_of_the_trac;         // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                        // byte 4
  UINT64BE current_theoretical_price;  // bytes 5 to 12, signed, read here as unsigned
} ConsolidatedInavMessage;

// Catalog of instruments from the local and global stock markets.
typedef struct _CatalogForInstrumentsBelongingToTheLocalAndGlobalStockMar_gc6yau {
  UINT32BE mse_instrument_number;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 value_of_type[2];               // bytes 4 to 5
  UINT8 issuing_company[7];             // bytes 6 to 12
  UINT8 series[6];                      // bytes 13 to 18
  UINT64BE last_price;                  // bytes 19 to 26, signed, read here as unsigned
  UINT64BE ppp_weighted_average_price;  // bytes 27 to 34, signed, read here as unsigned
  UINT64BE reference_date;              // bytes 35 to 42, signed, read here as unsigned
  UINT8 reference;                      // byte 43
  UINT16BE coupon_in_effect;            // bytes 44 to 45, signed, read here as unsigned
  UINT8 marketability;                  // byte 46
  UINT32BE numerical_marketability;     // bytes 47 to 50, signed, read here as unsigned
  UINT8 isin[12];                       // bytes 51 to 62
  UINT8 market;                         // byte 63
  UINT64BE registered_values;           // bytes 64 to 71, signed, read here as unsigned
  UINT8 exchange;                       // byte 72
} CatalogForInstrumentsBelongingToTheLocalAndGlobalStockMar_gc6yau;

// The message is sent during any type of bidding (Opening, Ongoing, Volatility and Intraday) and only in the instruments where there already is a virtual term matching or pre-allotment.
typedef struct _ProbablePriceOfAllocationMessage {
  UINT32BE instrument_number;             // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                           // byte 4
  UINT64BE probable_price_of_allocation;  // bytes 5 to 12, signed, read here as unsigned
  UINT64BE volume;                        // bytes 13 to 20, signed, read here as unsigned
} ProbablePriceOfAllocationMessage;

// Relation between identifiers of instruments between BIVA and BMV.
typedef struct _RelationBetweenBmvbivaInstrumentsMessage {
  UINT32BE number_of_the_bmv_instrument;  // bytes 0 to 3, signed, read here as unsigned
  UINT32BE biva_instrument;               // bytes 4 to 7, signed, read here as unsigned
  UINT8 type_of_trading;                  // byte 8
} RelationBetweenBmvbivaInstrumentsMessage;

// Informs about any transaction which was accepted at the BMV or BIVA.
typedef struct _EquitiesMarketTradesMessage {
  UINT32BE instrument_number;                // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                              // byte 4
  UINT64BE time_of_the_trade;                // bytes 5 to 12, signed, read here as unsigned
  UINT64BE volume;                           // bytes 13 to 20, signed, read here as unsigned
  UINT64BE price;                            // bytes 21 to 28, signed, read here as unsigned
  UINT8 type_of_agreement;                   // byte 29
  UINT64BE consecutive_number_of_the_trade;  // bytes 30 to 37, signed, read here as unsigned
  UINT8 sets_price;                          // byte 38
  UINT8 type_of_trading;                     // byte 39
  UINT64BE amount;                           // bytes 40 to 47, signed, read here as unsigned
  UINT8 purchases[5];                        // bytes 48 to 52
  UINT8 sells[5];                            // bytes 53 to 57
  UINT8 settlement;                          // byte 58
  UINT8 auction_indicator;                   // byte 59
  UINT8 indicator;                           // byte 60
} EquitiesMarketTradesMessage;

// This message in sent when a transaction is cancelled from BMV or BIVA system.
typedef struct _ConsolidatedTradeCancellationMessage {
  UINT32BE instrument_number;                // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                              // byte 4
  UINT64BE consecutive_number_of_the_trade;  // bytes 5 to 12, signed, read here as unsigned
} ConsolidatedTradeCancellationMessage;

// Message sent by instrument when the best bid is modified in the electronic book by the Origin Exchange; denotes the side that is modified, the sale or the purchase.
typedef struct _LastQuoteMessage {
  UINT32BE instrument_number;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 origin;                // byte 4
  UINT64BE volume;             // bytes 5 to 12, signed, read here as unsigned
  UINT64BE price_rate;         // bytes 13 to 20, signed, read here as unsigned
  UINT8 direction_of_the_bid;  // byte 21
  UINT8 type_of_trading;       // byte 22
} LastQuoteMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x28: MutualFundsTradesMessage mutual_funds_trades_message;
    case 0x29: OpeningOfContinuousAuctionsMessage opening_of_continuous_auctions_message;
    case 0x2C: ExistenceOfBidsAtMidPriceMessage existence_of_bids_at_mid_price_message;
    case 0x2E: CatalogueOfDebtAndMetalsInstrumentsMessage catalogue_of_debt_and_metals_instruments_message;
    case 0x30: CatalogSentForInstrumentsBelongingToMutualFundsMessage catalog_sent_for_instruments_belonging_to_mutual_funds_message;
    case 0x36: WeightedAveragePriceMessage weighted_average_price_message;
    case 0x37: SystemEventsMessage system_events_message;
    case 0x38: ReferencePriceMessage reference_price_message;
    case 0x39: ChangesInStatusMessage changes_in_status_message;
    case 0x54: CatalogForInstrumentsBelongingToTheCapitalWarrantsMarketMessage catalog_for_instruments_belonging_to_the_capital_warrants_market_message;
    case 0x5B: CatalogSentForInstrumentsBelongingToCapitalTracsMessage catalog_sent_for_instruments_belonging_to_capital_tracs_message;
    case 0x5D: ConsolidatedInavMessage consolidated_inav_message;
    case 0x68: CatalogForInstrumentsBelongingToTheLocalAndGlobalStockMar_gc6yau catalog_for_instruments_belonging_to_the_local_and_global_stock_market_message;
    case 0x69: ProbablePriceOfAllocationMessage probable_price_of_allocation_message;
    case 0x6A: RelationBetweenBmvbivaInstrumentsMessage relation_between_bmvbiva_instruments_message;
    case 0x70: EquitiesMarketTradesMessage equities_market_trades_message;
    case 0x71: ConsolidatedTradeCancellationMessage consolidated_trade_cancellation_message;
    case 0x6D: LastQuoteMessage last_quote_message;
    default: UINT8 unknown[available];
  }
} Payload;

// BMV INTRA Multicast message block
typedef struct _MessageBlock (mutable UINT32 * tally) {
  UINT16BE message_length { message_length >= 1 };                                                                                                                 // bytes 0 to 1, signed, read here as unsigned
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, ((((UINT32) message_length) + 2) - 3)) payload[:byte-size-single-element-array ((((UINT32) message_length) + 2) - 3)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} MessageBlock;

// ---- Packet: Packet ----------------------------------------------------------

// Bmv INTRA Multicast Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 17) {
  UINT16BE length;                                                                                                                 // bytes 0 to 1, signed, read here as unsigned
  UINT8 total_messages;                                                                                                            // byte 2, signed, read here as unsigned
  UINT8 market_data_group;                                                                                                         // byte 3, signed, read here as unsigned
  UINT8 session;                                                                                                                   // byte 4, signed, read here as unsigned
  UINT32BE sequence_number;                                                                                                        // bytes 5 to 8, signed, read here as unsigned
  UINT64BE datetime;                                                                                                               // bytes 9 to 16, signed, read here as unsigned
  unit message_block_tally_start {:on-success *tally = 0; return true; };
  MessageBlock(tally) message_block[:byte-size (available - 17)];
  unit message_block_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) total_messages); };
} Packet;

