// Bolsa Mexicana de Valores Bmv Market Data Product 33
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out BmvMarketData_Product33_v1_1.3d
//
// What this definition does not state, and the model does:
// - a run counted by a field
//
// License: MIT No Attribution

// ---- INTRA Multicast Header: 17 bytes ----------------------------------------

// BMV INTRA Multicast Header
entrypoint typedef struct _INTRAMulticastHeader {
  UINT16BE length;           // bytes 0 to 1, signed, read here as unsigned
  UINT8 total_messages;      // byte 2, signed, read here as unsigned
  UINT8 market_data_group;   // byte 3, signed, read here as unsigned
  UINT8 session;             // byte 4, signed, read here as unsigned
  UINT32BE sequence_number;  // bytes 5 to 8, signed, read here as unsigned
  UINT64BE datetime;         // bytes 9 to 16, signed, read here as unsigned
} INTRAMulticastHeader;

// ---- Message Header: 3 bytes -------------------------------------------------

// Message length and message type
entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;  // bytes 0 to 1, signed, read here as unsigned
  UINT8 message_type;       // byte 2
} MessageHeader;

// ---- Big Picture Message: 37 bytes -------------------------------------------

// Market share summary of the stock exchanges.
entrypoint typedef struct _BigPictureMessage {
  UINT8 origin;                  // byte 0
  UINT32BE trades;               // bytes 1 to 4, signed, read here as unsigned
  UINT64BE volume;               // bytes 5 to 12, signed, read here as unsigned
  UINT64BE traded_value;         // bytes 13 to 20, signed, read here as unsigned
  UINT32BE market_share_amount;  // bytes 21 to 24, signed, read here as unsigned
  UINT32BE market_share_trades;  // bytes 25 to 28, signed, read here as unsigned
  UINT8 market;                  // byte 29
  UINT8 sector;                  // byte 30, signed, read here as unsigned
  UINT32BE instrument_number;    // bytes 31 to 34, signed, read here as unsigned
  UINT8 indices[2];              // bytes 35 to 36
} BigPictureMessage;

// ---- Effective Spread Message: 33 bytes --------------------------------------

// Transaction cost analysis benchmark.
entrypoint typedef struct _EffectiveSpreadMessage {
  UINT8 origin;                  // byte 0
  UINT32BE es_mxn;               // bytes 1 to 4, signed, read here as unsigned
  UINT32BE es_basis_points;      // bytes 5 to 8, signed, read here as unsigned
  UINT32BE es_mxn_bid;           // bytes 9 to 12, signed, read here as unsigned
  UINT32BE es_basis_points_bid;  // bytes 13 to 16, signed, read here as unsigned
  UINT32BE es_mxn_ask;           // bytes 17 to 20, signed, read here as unsigned
  UINT32BE es_basis_points_ask;  // bytes 21 to 24, signed, read here as unsigned
  UINT8 market;                  // byte 25
  UINT8 sector;                  // byte 26, signed, read here as unsigned
  UINT32BE instrument_number;    // bytes 27 to 30, signed, read here as unsigned
  UINT8 indices[2];              // bytes 31 to 32
} EffectiveSpreadMessage;

// ---- Spread Quality Message: 21 bytes ----------------------------------------

// Quality of the quoted spread throughout the session.
entrypoint typedef struct _SpreadQualityMessage {
  UINT8 origin;                       // byte 0
  UINT32BE time_best_spread;          // bytes 1 to 4, signed, read here as unsigned
  UINT32BE time_tie_best_spread;      // bytes 5 to 8, signed, read here as unsigned
  UINT32BE time_without_best_spread;  // bytes 9 to 12, signed, read here as unsigned
  UINT8 market;                       // byte 13
  UINT8 sector;                       // byte 14, signed, read here as unsigned
  UINT32BE instrument_number;         // bytes 15 to 18, signed, read here as unsigned
  UINT8 indices[2];                   // bytes 19 to 20
} SpreadQualityMessage;

// ---- Spread Message: 25 bytes ------------------------------------------------

// Evolution of the simple spread throughout the session.
entrypoint typedef struct _SpreadMessage {
  UINT8 origin;                  // byte 0
  UINT32BE spread_mxn;           // bytes 1 to 4, signed, read here as unsigned
  UINT32BE spread_basis_points;  // bytes 5 to 8, signed, read here as unsigned
  UINT32BE spread_average;       // bytes 9 to 12, signed, read here as unsigned
  UINT32BE number_of_spreads;    // bytes 13 to 16, signed, read here as unsigned
  UINT8 market;                  // byte 17
  UINT8 sector;                  // byte 18, signed, read here as unsigned
  UINT32BE instrument_number;    // bytes 19 to 22, signed, read here as unsigned
  UINT8 indices[2];              // bytes 23 to 24
} SpreadMessage;

