// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out FinraOrf_Tdds_v2_1.3d

// ---- Values ------------------------------------------------------------------

// Message Category: one byte code
#define MESSAGE_CATEGORY_TRADE 0x54           // Trade
#define MESSAGE_CATEGORY_ADMINISTRATIVE 0x41  // Administrative
#define MESSAGE_CATEGORY_CONTROL 0x43         // Control

// Trade Message Type: one byte code
#define TRADE_MESSAGE_TYPE_TRADE_REPORT_SHORT_FORM_MESSAGE 0x35  // Trade Report Short Form Message
#define TRADE_MESSAGE_TYPE_TRADE_REPORT_LONG_FORM_MESSAGE 0x36   // Trade Report Long Form Message
#define TRADE_MESSAGE_TYPE_TRADE_CANCEL_ERROR_MESSAGE 0x37       // Trade Cancel Error Message
#define TRADE_MESSAGE_TYPE_TRADE_CORRECTION_MESSAGE 0x38         // Trade Correction Message

// Sale Condition Level 1: one byte code
#define SALE_CONDITION_LEVEL_1_REGULAR_TRADE 0x40  // Regular Trade
#define SALE_CONDITION_LEVEL_1_CASH_TRADE 0x43     // Cash Trade
#define SALE_CONDITION_LEVEL_1_NEXT_DAY 0x4E       // Next Day
#define SALE_CONDITION_LEVEL_1_SELLER 0x52         // Seller

// Price Change Indicator: one byte code
#define PRICE_CHANGE_INDICATOR_NO_PRICE_CHANGE 0x30               // No Price Change
#define PRICE_CHANGE_INDICATOR_LAST_PRICE_CHANGED 0x31            // Last Price Changed
#define PRICE_CHANGE_INDICATOR_LOW_PRICE_CHANGED 0x32             // Low Price Changed
#define PRICE_CHANGE_INDICATOR_LAST_AND_LOW_PRICES_CHANGED 0x33   // Last And Low Prices Changed
#define PRICE_CHANGE_INDICATOR_HIGH_PRICE_CHANGED 0x34            // High Price Changed
#define PRICE_CHANGE_INDICATOR_LAST_AND_HIGH_PRICES_CHANGED 0x35  // Last And High Prices Changed
#define PRICE_CHANGE_INDICATOR_HIGH_AND_LOW_PRICES_CHANGED 0x36   // High And Low Prices Changed
#define PRICE_CHANGE_INDICATOR_ALL_PRICES_CHANGED 0x37            // All Prices Changed

// As Of Indicator: one byte code
#define AS_OF_INDICATOR_AS_OF 0x41                    // As Of
#define AS_OF_INDICATOR_REVERSAL 0x52                 // Reversal
#define AS_OF_INDICATOR_CURRENT_DAY_TRANSACTION 0x20  // Current Day Transaction

// Sale Condition Level 3: one byte code
#define SALE_CONDITION_LEVEL_3_EXECUTED_OUTSIDE_NORMAL_MARKET_HOURS 0x54                          // Executed Outside Normal Market Hours
#define SALE_CONDITION_LEVEL_3_EXECUTED_OUTSIDE_NORMAL_MARKET_HOURS_AND_TRADE_REPORTED_LATE 0x55  // Executed Outside Normal Market Hours And Trade Reported Late
#define SALE_CONDITION_LEVEL_3_EXECUTED_DURING_NORMAL_MARKET_HOURS_AND_TRADE_REPORTED_LATE 0x5A   // Executed During Normal Market Hours And Trade Reported Late
#define SALE_CONDITION_LEVEL_3_NOT_AVAILABLE 0x20                                                 // Not Available

// Sale Condition Level 4: one byte code
#define SALE_CONDITION_LEVEL_4_ODD_LOT_TRADE 0x49          // Odd Lot Trade
#define SALE_CONDITION_LEVEL_4_PRIOR_REFERENCE_PRICE 0x50  // Prior Reference Price
#define SALE_CONDITION_LEVEL_4_AVERAGE_PRICE_TRADE 0x57    // Average Price Trade
#define SALE_CONDITION_LEVEL_4_NOT_AVAILABLE 0x20          // Not Available

// Report Function: one byte code
#define REPORT_FUNCTION_CANCEL 0x43      // Cancel
#define REPORT_FUNCTION_ERROR 0x45       // Error
#define REPORT_FUNCTION_CORRECTION 0x4E  // Correction

// Last Sale Price Market Center: one byte code
#define LAST_SALE_PRICE_MARKET_CENTER_OOTC 0x75            // Ootc
#define LAST_SALE_PRICE_MARKET_CENTER_NOT_APPLICABLE 0x20  // Not Applicable

// Administrative Message Type: one byte code
#define ADMINISTRATIVE_MESSAGE_TYPE_GENERAL_ADMINISTRATIVE_MESSAGE 0x41             // General Administrative Message
#define ADMINISTRATIVE_MESSAGE_TYPE_CLOSING_TRADE_SUMMARY_REPORT_MESSAGE 0x32       // Closing Trade Summary Report Message
#define ADMINISTRATIVE_MESSAGE_TYPE_TRADING_ACTION_MESSAGE 0x48                     // Trading Action Message
#define ADMINISTRATIVE_MESSAGE_TYPE_MARKET_WIDE_CIRCUIT_BREAKER_EVENT_MESSAGE 0x4D  // Market Wide Circuit Breaker Event Message

// Closing Price Market Center: one byte code
#define CLOSING_PRICE_MARKET_CENTER_OOTC 0x75            // Ootc
#define CLOSING_PRICE_MARKET_CENTER_NOT_APPLICABLE 0x20  // Not Applicable

// Net Change Direction: one byte code
#define NET_CHANGE_DIRECTION_POSITIVE_OR_ZERO_NET_CHANGE 0x2B  // Positive Or Zero Net Change
#define NET_CHANGE_DIRECTION_NEGATIVE_NET_CHANGE 0x2D          // Negative Net Change
#define NET_CHANGE_DIRECTION_NO_TRADE_OR_UNAFFECTED 0x20       // No Trade Or Unaffected

// Action: one byte code
#define ACTION_TRADING_HALT 0x48                      // Trading Halt
#define ACTION_QUOTATION_RESUMPTION 0x51              // Quotation Resumption
#define ACTION_TRADING_RESUMPTION 0x54                // Trading Resumption
#define ACTION_QUOTATION_AND_TRADING_RESUMPTION 0x58  // Quotation And Trading Resumption

// Control Message Type: one byte code
#define CONTROL_MESSAGE_TYPE_START_OF_DAY_MESSAGE 0x49                    // Start Of Day Message
#define CONTROL_MESSAGE_TYPE_END_OF_DAY_MESSAGE 0x4A                      // End Of Day Message
#define CONTROL_MESSAGE_TYPE_MARKET_SESSION_OPEN_MESSAGE 0x4F             // Market Session Open Message
#define CONTROL_MESSAGE_TYPE_MARKET_SESSION_CLOSE_MESSAGE 0x43            // Market Session Close Message
#define CONTROL_MESSAGE_TYPE_END_OF_RETRANSMISSION_REQUESTS_MESSAGE 0x4B  // End Of Retransmission Requests Message
#define CONTROL_MESSAGE_TYPE_END_OF_TRANSMISSIONS_MESSAGE 0x5A            // End Of Transmissions Message
#define CONTROL_MESSAGE_TYPE_LINE_INTEGRITY_MESSAGE 0x54                  // Line Integrity Message
#define CONTROL_MESSAGE_TYPE_SEQUENCE_NUMBER_RESET_MESSAGE 0x4C           // Sequence Number Reset Message
#define CONTROL_MESSAGE_TYPE_END_OF_TRADE_REPORTING_MESSAGE 0x58          // End Of Trade Reporting Message

// ---- Types -------------------------------------------------------------------

// Datetime
typedef struct _Datetime {
  UINT8 year[4];               // bytes 0 to 3
  UINT8 month[2];              // bytes 4 to 5
  UINT8 day[2];                // bytes 6 to 7
  UINT8 hour[2];               // bytes 8 to 9
  UINT8 minute[2];             // bytes 10 to 11
  UINT8 second[2];             // bytes 12 to 13
  UINT8 fractional_second[9];  // bytes 14 to 22
} Datetime;

// Message Header
typedef struct _MessageHeader {
  UINT8 trade_identifier[8];             // bytes 0 to 7
  UINT8 market_center_originator_id[2];  // bytes 8 to 9
  Datetime datetime;                     // bytes 10 to 32
} MessageHeader;

// Economized trade report
typedef struct _TradeReportShortFormMessage {
  MessageHeader message_header;    // bytes 0 to 32
  UINT8 security_symbol_short[5];  // bytes 33 to 37
  UINT8 sale_condition_level_1;    // byte 38
  UINT8 trade_price_denominator;   // byte 39
  UINT8 trade_price_short[6];      // bytes 40 to 45
  UINT8 report_volume_short[6];    // bytes 46 to 51
  UINT8 price_change_indicator;    // byte 52
} TradeReportShortFormMessage;

// Original Dissemination Date
typedef struct _OriginalDisseminationDate {
  UINT8 year[4];   // bytes 0 to 3
  UINT8 month[2];  // bytes 4 to 5
  UINT8 day[2];    // bytes 6 to 7
} OriginalDisseminationDate;

// Execution Datetime
typedef struct _ExecutionDatetime {
  UINT8 year[4];               // bytes 0 to 3
  UINT8 month[2];              // bytes 4 to 5
  UINT8 day[2];                // bytes 6 to 7
  UINT8 hour[2];               // bytes 8 to 9
  UINT8 minute[2];             // bytes 10 to 11
  UINT8 second[2];             // bytes 12 to 13
  UINT8 fractional_second[9];  // bytes 14 to 22
} ExecutionDatetime;

// Trade Information
typedef struct _TradeInformation {
  UINT8 report_volume[8];                // bytes 0 to 7
  UINT8 trade_price_denominator;         // byte 8
  UINT8 trade_price[12];                 // bytes 9 to 20
  UINT8 currency[3];                     // bytes 21 to 23
  UINT8 as_of_indicator;                 // byte 24
  ExecutionDatetime execution_datetime;  // bytes 25 to 47
  UINT8 sale_condition_level_1;          // byte 48
  UINT8 sale_condition_level_2;          // byte 49
  UINT8 sale_condition_level_3;          // byte 50
  UINT8 sale_condition_level_4;          // byte 51
  UINT8 sellers_sale_days[2];            // bytes 52 to 53
  UINT8 price_change_indicator;          // byte 54
} TradeInformation;

// Complete trade report
typedef struct _TradeReportLongFormMessage {
  MessageHeader message_header;                           // bytes 0 to 32
  UINT8 security_symbol[14];                              // bytes 33 to 46
  OriginalDisseminationDate original_dissemination_date;  // bytes 47 to 54
  TradeInformation trade_information;                     // bytes 55 to 109
} TradeReportLongFormMessage;

// Original Trade Information
typedef struct _OriginalTradeInformation {
  UINT8 report_volume[8];                // bytes 0 to 7
  UINT8 trade_price_denominator;         // byte 8
  UINT8 trade_price[12];                 // bytes 9 to 20
  UINT8 currency[3];                     // bytes 21 to 23
  UINT8 as_of_indicator;                 // byte 24
  ExecutionDatetime execution_datetime;  // bytes 25 to 47
  UINT8 sale_condition_level_1;          // byte 48
  UINT8 sale_condition_level_2;          // byte 49
  UINT8 sale_condition_level_3;          // byte 50
  UINT8 sale_condition_level_4;          // byte 51
  UINT8 sellers_sale_days[2];            // bytes 52 to 53
} OriginalTradeInformation;

// Trade Summary Information
typedef struct _TradeSummaryInformation {
  UINT8 high_price_denominator;         // byte 0
  UINT8 high_price[12];                 // bytes 1 to 12
  UINT8 low_price_denominator;          // byte 13
  UINT8 low_price[12];                  // bytes 14 to 25
  UINT8 last_sale_price_denominator;    // byte 26
  UINT8 last_sale_price[12];            // bytes 27 to 38
  UINT8 last_sale_price_market_center;  // byte 39
  UINT8 total_security_volume[11];      // bytes 40 to 50
  UINT8 price_change_indicator;         // byte 51
} TradeSummaryInformation;

// This message is used to notify TDDS customers if a trade report entered during the current business day, or up to the past three business days, has been canceled
typedef struct _TradeCancelErrorMessage {
  MessageHeader message_header;                           // bytes 0 to 32
  UINT8 security_symbol[14];                              // bytes 33 to 46
  OriginalDisseminationDate original_dissemination_date;  // bytes 47 to 54
  UINT8 report_function;                                  // byte 55
  OriginalTradeInformation original_trade_information;    // bytes 56 to 109
  TradeSummaryInformation trade_summary_information;      // bytes 110 to 161
} TradeCancelErrorMessage;

// Corrected Trade Information
typedef struct _CorrectedTradeInformation {
  UINT8 report_volume[8];                // bytes 0 to 7
  UINT8 trade_price_denominator;         // byte 8
  UINT8 trade_price[12];                 // bytes 9 to 20
  UINT8 currency[3];                     // bytes 21 to 23
  UINT8 as_of_indicator;                 // byte 24
  ExecutionDatetime execution_datetime;  // bytes 25 to 47
  UINT8 sale_condition_level_1;          // byte 48
  UINT8 sale_condition_level_2;          // byte 49
  UINT8 sale_condition_level_3;          // byte 50
  UINT8 sale_condition_level_4;          // byte 51
  UINT8 sellers_sale_days[2];            // bytes 52 to 53
} CorrectedTradeInformation;

// Used to notify TDDS customers if a trade report entered during the current business day, or up to the past three business days, has been modified
typedef struct _TradeCorrectionMessage {
  MessageHeader message_header;                           // bytes 0 to 32
  UINT8 security_symbol[14];                              // bytes 33 to 46
  OriginalDisseminationDate original_dissemination_date;  // bytes 47 to 54
  UINT8 report_function;                                  // byte 55
  OriginalTradeInformation original_trade_information;    // bytes 56 to 109
  CorrectedTradeInformation corrected_trade_information;  // bytes 110 to 163
  TradeSummaryInformation trade_summary_information;      // bytes 164 to 215
} TradeCorrectionMessage;

// Branch
casetype _TradeMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x35: TradeReportShortFormMessage trade_report_short_form_message;
    case 0x36: TradeReportLongFormMessage trade_report_long_form_message;
    case 0x37: TradeCancelErrorMessage trade_cancel_error_message;
    case 0x38: TradeCorrectionMessage trade_correction_message;
    default: UINT8 unknown[available];
  }
} TradeMessagePayload;

// Trade Messages Header
typedef struct _TradeMessage (UINT32 available) where (available >= 1) {
  UINT8 trade_message_type;                                                                                                         // byte 0
  TradeMessagePayload(trade_message_type, (available - 1)) trade_message_payload[:byte-size-single-element-array (available - 1)];
} TradeMessage;

// A variable length, free-form text message format will be used on an as-needed basis
typedef struct _GeneralAdministrativeMessage (UINT16 length) where (length >= 35) {
  MessageHeader message_header;          // bytes 0 to 32
  UINT8 text[(((UINT32) length) - 35)];
} GeneralAdministrativeMessage;

// The closing trade summary will reflect the daily high, low, and closing prices as well as the total volume for the security
typedef struct _ClosingTradeSummaryReportMessage {
  MessageHeader message_header;        // bytes 0 to 32
  UINT8 security_symbol[14];           // bytes 33 to 46
  UINT8 daily_high_price_denominator;  // byte 47
  UINT8 daily_high_price[12];          // bytes 48 to 59
  UINT8 daily_low_price_denominator;   // byte 60
  UINT8 daily_low_price[12];           // bytes 61 to 72
  UINT8 closing_price_market_center;   // byte 73
  UINT8 closing_price_denominator;     // byte 74
  UINT8 closing_price[12];             // bytes 75 to 86
  UINT8 reserved_1;                    // byte 87
  UINT8 net_change_denominator;        // byte 88
  UINT8 net_change_amount[10];         // bytes 89 to 98
  UINT8 net_change_direction;          // byte 99
  UINT8 currency[3];                   // bytes 100 to 102
  UINT8 total_security_volume[11];     // bytes 103 to 113
} ClosingTradeSummaryReportMessage;

// Action Datetime
typedef struct _ActionDatetime {
  UINT8 year[4];               // bytes 0 to 3
  UINT8 month[2];              // bytes 4 to 5
  UINT8 day[2];                // bytes 6 to 7
  UINT8 hour[2];               // bytes 8 to 9
  UINT8 minute[2];             // bytes 10 to 11
  UINT8 second[2];             // bytes 12 to 13
  UINT8 fractional_second[9];  // bytes 14 to 22
} ActionDatetime;

// FINRA will disseminate this message to inform customers of trading actions, such as halts or trading resumptions which affect individual OTCBB or Other OTC securities
typedef struct _TradingActionMessage {
  MessageHeader message_header;         // bytes 0 to 32
  UINT8 security_symbol[14];            // bytes 33 to 46
  UINT8 action;                         // byte 47
  ActionDatetime action_datetime;       // bytes 48 to 70
  UINT8 trading_action_reason_code[6];  // bytes 71 to 76
} TradingActionMessage;

// FINRA will disseminate this message to inform customers of an extraordinary market event trading action or a market wide circuit breaker event which will affect all security symbols for either OTCBB, Other OTC or both OTCBB and Other OTC market places
typedef struct _MarketWideCircuitBreakerEventMessage {
  MessageHeader message_header;                      // bytes 0 to 32
  UINT8 action;                                      // byte 33
  ActionDatetime action_datetime;                    // bytes 34 to 56
  UINT8 market_wide_circuit_breaker_reason_code[6];  // bytes 57 to 62
} MarketWideCircuitBreakerEventMessage;

// Branch
casetype _AdministrativeMessagePayload (UINT8 selector, UINT16 length, UINT32 available) {
  switch (selector) {
    case 0x41: GeneralAdministrativeMessage(length) general_administrative_message;
    case 0x32: ClosingTradeSummaryReportMessage closing_trade_summary_report_message;
    case 0x48: TradingActionMessage trading_action_message;
    case 0x4D: MarketWideCircuitBreakerEventMessage market_wide_circuit_breaker_event_message;
    default: UINT8 unknown[available];
  }
} AdministrativeMessagePayload;

// Administrative Messages Header
typedef struct _AdministrativeMessage (UINT16 length, UINT32 available) where (available >= 1) {
  UINT8 administrative_message_type;                                                                                                                                   // byte 0
  AdministrativeMessagePayload(administrative_message_type, length, (available - 1)) administrative_message_payload[:byte-size-single-element-array (available - 1)];
} AdministrativeMessage;

// The Start of Day control message signifies the beginning of each operational cycle for TDDS processing
typedef struct _StartOfDayMessage {
  MessageHeader message_header;  // bytes 0 to 32
} StartOfDayMessage;

// The End of Day control message signals the end of active message dissemination for the TDDS operational cycle
typedef struct _EndOfDayMessage {
  MessageHeader message_header;  // bytes 0 to 32
} EndOfDayMessage;

// The Market Session Open Control Message signifies the opening of FINRA s market systems for the session indicated in the Message Header
typedef struct _MarketSessionOpenMessage {
  MessageHeader message_header;  // bytes 0 to 32
} MarketSessionOpenMessage;

// The Session Close Control Message signals the closing of FINRA s market systems for the session indicated in the Message Header
typedef struct _MarketSessionCloseMessage {
  MessageHeader message_header;  // bytes 0 to 32
} MarketSessionCloseMessage;

// This message signals that no further retransmission requests will be honored. The End of Retransmission Requests message will be sent three times, at one-minute intervals
typedef struct _EndOfRetransmissionRequestsMessage {
  MessageHeader message_header;  // bytes 0 to 32
} EndOfRetransmissionRequestsMessage;

// The End of Transmissions Message signals that there will be no further transmissions of data sent through the TDDS line.
typedef struct _EndOfTransmissionsMessage {
  MessageHeader message_header;  // bytes 0 to 32
} EndOfTransmissionsMessage;

// The Line Integrity Control Message will be transmitted at approximately one-minute intervals to verify the operational integrity of the TDDS message transmission, and will be intermixed with other messages
typedef struct _LineIntegrityMessage {
  MessageHeader message_header;  // bytes 0 to 32
} LineIntegrityMessage;

// The Sequence Number Reset Message forces the resetting of the Sequence Number. The Sequence Number will either be reset to zero or to a number greater than the last number previously transmitted
typedef struct _SequenceNumberResetMessage {
  MessageHeader message_header;  // bytes 0 to 32
} SequenceNumberResetMessage;

// The End of Trade Reporting Control Message signals that the ORF system is closed for market participant trade transactions
typedef struct _EndOfTradeReportingMessage {
  MessageHeader message_header;  // bytes 0 to 32
} EndOfTradeReportingMessage;

// Branch
casetype _ControlMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x49: StartOfDayMessage start_of_day_message;
    case 0x4A: EndOfDayMessage end_of_day_message;
    case 0x4F: MarketSessionOpenMessage market_session_open_message;
    case 0x43: MarketSessionCloseMessage market_session_close_message;
    case 0x4B: EndOfRetransmissionRequestsMessage end_of_retransmission_requests_message;
    case 0x5A: EndOfTransmissionsMessage end_of_transmissions_message;
    case 0x54: LineIntegrityMessage line_integrity_message;
    case 0x4C: SequenceNumberResetMessage sequence_number_reset_message;
    case 0x58: EndOfTradeReportingMessage end_of_trade_reporting_message;
    default: UINT8 unknown[available];
  }
} ControlMessagePayload;

// Control Messages Header
typedef struct _ControlMessage (UINT32 available) where (available >= 1) {
  UINT8 control_message_type;                                                                                                             // byte 0
  ControlMessagePayload(control_message_type, (available - 1)) control_message_payload[:byte-size-single-element-array (available - 1)];
} ControlMessage;

// Branch
casetype _Payload (UINT8 selector, UINT16 length, UINT32 available) {
  switch (selector) {
    case 0x54: TradeMessage(available) trade_message;
    case 0x41: AdministrativeMessage(length, available) administrative_message;
    case 0x43: ControlMessage(available) control_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE length { length >= 1 };                                                                                                                                 // bytes 0 to 1
  UINT8 message_category;                                                                                                                                          // byte 2
  Payload(message_category, length, (((UINT32) length) - 1)) payload[:byte-size-single-element-array (((UINT32) length) - 1)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Mold Udp64 Dfi Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 20) {
  UINT8 session[10];                                                                                                // bytes 0 to 9
  UINT64BE sequence;                                                                                                // bytes 10 to 17
  UINT16BE count;                                                                                                   // bytes 18 to 19
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 20)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) count); };
} Packet;

