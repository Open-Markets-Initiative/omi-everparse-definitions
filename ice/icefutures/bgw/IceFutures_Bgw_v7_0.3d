} MassQuoteReportMessage;

// ResendRequestMessage
typedef struct _ResendRequestMessage {
  UINT32 begin_seq_no;  // bytes 0 to 3
  UINT32 end_seq_no;    // bytes 4 to 7
} ResendRequestMessage;

// ResendReportMessage
typedef struct _ResendReportMessage {
  UINT32 begin_seq_no;   // bytes 0 to 3
  UINT32 end_seq_no;     // bytes 4 to 7
  UINT8 status;          // byte 8
  UINT32 exchange_code;  // bytes 9 to 12, signed, read here as unsigned
  UINT8 text[100];       // bytes 13 to 112
} ResendReportMessage;

// SequenceResetMessage
typedef struct _SequenceResetMessage {
  UINT32 new_seq_no;    // bytes 0 to 3
  UINT8 gap_fill_flag;  // byte 4
} SequenceResetMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0000: SimpleOpenFramingHeaderMessage simple_open_framing_header_message;
    case 0x0001: LogonRequestMessage logon_request_message;
    case 0x0065: LogonReportMessage logon_report_message;
    case 0x000D: LogoutRequestMessage logout_request_message;
    case 0x0071: LogoutReportMessage logout_report_message;
    case 0x0033: unit heart_beat_message;
    case 0x0072: ErrorMessage error_message;
    case 0x0074: NewsMessage news_message;
    case 0x0070: SecurityDefinitionReportStrategyMessage security_definition_report_strategy_message;
    case 0x0073: SecurityDefinitionReportMessage security_definition_report_message;
    case 0x009B: SecurityDefinitionRejectMessage security_definition_reject_message;
    case 0x000F: SecurityDefinitionRequestMessage security_definition_request_message;
    case 0x009A: SecurityDefinitionReportProductMessage security_definition_report_product_message;
    case 0x07D1: IpRequestMessage ip_request_message;
    case 0x07D2: IpReportMessage ip_report_message;
    case 0x0002: TraderLogonRequestMessage trader_logon_request_message;
    case 0x0066: TraderLogonReportMessage trader_logon_report_message;
    case 0x0003: TraderLogoutRequestMessage trader_logout_request_message;
    case 0x0067: TraderLogoutReportMessage trader_logout_report_message;
    case 0x0004: NewOrderRequestMessage new_order_request_message;
    case 0x0005: CancelReplaceRequestMessage cancel_replace_request_message;
    case 0x0006: CancelRequestMessage cancel_request_message;
    case 0x0007: QuoteRequestMessage quote_request_message;
    case 0x0008: NewOrderCrossRequestMessage new_order_cross_request_message;
    case 0x0009: OrderMassCancelRequestMessage order_mass_cancel_request_message;
    case 0x000A: MassQuoteRequestMessage mass_quote_request_message;
    case 0x000B: QuoteCancelRequestMessage quote_cancel_request_message;
    case 0x000C: SecurityDefinitionRequestCreateStrategyMessage security_definition_request_create_strategy_message;
    case 0x000E: SecurityDefinitionRequestCreateFlexMessage security_definition_request_create_flex_message;
    case 0x0068: ExecutionReportNewMessage execution_report_new_message;
    case 0x0069: ExecutionReportModifyMessage execution_report_modify_message;
    case 0x006A: ExecutionReportCancelMessage execution_report_cancel_message;
    case 0x0097: ExecutionReportRejectMessage execution_report_reject_message;
    case 0x0098: ExecutionReportSnapshotMessage execution_report_snapshot_message;
    case 0x0099: ExecutionReportTradeMessage execution_report_trade_message;
    case 0x006B: QuoteReportMessage quote_report_message;
    case 0x006C: NewOrderCrossReportMessage new_order_cross_report_message;
    case 0x006D: OrderMassCancelReportMessage order_mass_cancel_report_message;
    case 0x006E: MassQuoteReportMessage mass_quote_report_message;
    case 0x0010: ResendRequestMessage resend_request_message;
    case 0x0075: ResendReportMessage resend_report_message;
    case 0x006F: SequenceResetMessage sequence_reset_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Simple Open Frame
typedef struct _SimpleOpenFrame {
  UINT16 message_length { message_length >= 25 };                                                                                    // bytes 0 to 1
  UINT16 encoding_type;                                                                                                              // bytes 2 to 3
  UINT16 block_length;                                                                                                               // bytes 4 to 5
  UINT16 template_id;                                                                                                                // bytes 6 to 7
  UINT16 schema_id;                                                                                                                  // bytes 8 to 9
  UINT16 version;                                                                                                                    // bytes 10 to 11
  UINT32 sequence_id;                                                                                                                // bytes 12 to 15
  UINT64 send_time;                                                                                                                  // bytes 16 to 23
  UINT8 poss_dupe : 1;                                                                                                               // byte 24
  UINT8 poss_resend : 1;                                                                                                             // byte 24
  UINT8 reserved_bits : 6;                                                                                                           // byte 24
  Payload(template_id, (((UINT32) message_length) - 25)) payload[:byte-size-single-element-array (((UINT32) message_length) - 25)];
} SimpleOpenFrame;

// ---- Packet: Packet ----------------------------------------------------------

// Simple Open Frame Packet
entrypoint typedef struct _Packet (UINT32 available) {
  SimpleOpenFrame simple_open_frame[:byte-size available];
} Packet;

