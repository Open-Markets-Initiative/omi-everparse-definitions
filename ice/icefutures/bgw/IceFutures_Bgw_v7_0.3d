#define QUOTE_REJECT_REASON_INVALID_CLEARING_ACCOUNT_STATUS 0x6B  // Invalid Clearing Account Status
#define QUOTE_REJECT_REASON_INVALID_CLEARING_LIMITS 0x6C          // Invalid Clearing Limits
#define QUOTE_REJECT_REASON_INVALID_MARKET_ID 0x6D                // Invalid Market Id
#define QUOTE_REJECT_REASON_EXCEEDS_ALLOWED_MASS_QUOTE_SETS 0x6E  // Exceeds Allowed Mass Quote Sets
#define QUOTE_REJECT_REASON_EXCEEDS_ALLOWED_MASS_QUOTES 0x6F      // Exceeds Allowed Mass Quotes
#define QUOTE_REJECT_REASON_INVALID_MASS_QUOTE_ID 0x70            // Invalid Mass Quote Id

// Rfc Status: one byte code
#define RFC_STATUS_NONE 0x00                           // None
#define RFC_STATUS_SUCCESS 0x01                        // Success
#define RFC_STATUS_PARTIAL_SUCCESS_BID_FAILURE 0x02    // Partial Success Bid Failure
#define RFC_STATUS_PARTIAL_SUCCESS_OFFER_FAILURE 0x03  // Partial Success Offer Failure
#define RFC_STATUS_FAILURE 0x04                        // Failure

// Mass Cancel Response: one byte code
#define MASS_CANCEL_RESPONSE_REJECTED 0x00                    // Rejected
#define MASS_CANCEL_RESPONSE_CANCEL_FOR_TRADING_SESSION 0x06  // Cancel For Trading Session
#define MASS_CANCEL_RESPONSE_CANCEL_ALL_FOR_TRADER 0x0A       // Cancel All For Trader

// Mass Cancel Reject Reason: one byte code
#define MASS_CANCEL_REJECT_REASON_UNSUPPORTED 0x00              // Unsupported
#define MASS_CANCEL_REJECT_REASON_INVALID_TRADING_SESSION 0x06  // Invalid Trading Session
#define MASS_CANCEL_REJECT_REASON_INVALID_MARKET 0x07           // Invalid Market
#define MASS_CANCEL_REJECT_REASON_OTHER 0x63                    // Other

// Quote Entry Reject Reason: one byte code
#define QUOTE_ENTRY_REJECT_REASON_OTHER 0x63                                 // Other
#define QUOTE_ENTRY_REJECT_REASON_RISK_PROTECTION_ACTIVE 0x66                // Risk Protection Active
#define QUOTE_ENTRY_REJECT_REASON_RISK_PROTECTION_ACTIVE_FOR_SELL_SIDE 0x71  // Risk Protection Active For Sell Side

// Status: one byte code
#define STATUS_SUCCESS 0x00          // Success
#define STATUS_PARTIAL_SUCCESS 0x01  // Partial Success
#define STATUS_FAILURE 0x02          // Failure

// Gap Fill Flag: one byte code
#define GAP_FILL_FLAG_FALSE 0x00  // False
#define GAP_FILL_FLAG_TRUE 0x01   // True

