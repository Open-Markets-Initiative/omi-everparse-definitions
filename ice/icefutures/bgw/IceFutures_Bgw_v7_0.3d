// noQuoteSets
typedef struct _MassQuoteReportMessageNoQuoteSetsGroup {
  UINT32 quote_set_id;                        // bytes 0 to 3, signed, read here as unsigned
  UINT32 underlying_symbol;                   // bytes 4 to 7, signed, read here as unsigned
  UINT32 quote_entry_id;                      // bytes 8 to 11, signed, read here as unsigned
  UINT32 symbol;                              // bytes 12 to 15, signed, read here as unsigned
  UINT8 quote_entry_reject_reason;            // byte 16
