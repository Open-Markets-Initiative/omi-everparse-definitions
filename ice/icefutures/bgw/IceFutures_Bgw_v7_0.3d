  UINT8 quote_reject_reason;                                                               // byte 31
  UINT64 transact_time_optional;                                                           // bytes 32 to 39
  UINT64 me_acceptance_time_optional;                                                      // bytes 40 to 47
  UINT32 exchange_code;                                                                    // bytes 48 to 51, signed, read here as unsigned
  UINT8 text[100];                                                                         // bytes 52 to 151
