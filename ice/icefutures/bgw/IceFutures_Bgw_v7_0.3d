  UINT64 cum_qty;                                // bytes 86 to 93, signed, read here as unsigned
  UINT64 price_optional;                         // bytes 94 to 101, signed, read here as unsigned
  UINT64 stop_px;                                // bytes 102 to 109, signed, read here as unsigned
  UINT16 expire_date;                            // bytes 110 to 111
  UINT64 time_priority;                          // bytes 112 to 119
  UINT8 time_in_force;                           // byte 120
  UINT8 order_status;                            // byte 121
  UINT8 order_state;                             // byte 122
  UINT32 give_up_clearing_firm;                  // bytes 123 to 126, signed, read here as unsigned
  UINT32 clearing_firm_optional;                 // bytes 127 to 130, signed, read here as unsigned
  UINT8 direct_electronic_access;                // byte 131
  UINT8 trading_capacity;                        // byte 132
  UINT8 liquidity_provision;                     // byte 133
  UINT8 commodity_deriv_indicator;               // byte 134
  UINT64 investment_decision;                    // bytes 135 to 142, signed, read here as unsigned
  UINT64 execution_decision;                     // bytes 143 to 150, signed, read here as unsigned
  UINT64 client_id_code;                         // bytes 151 to 158, signed, read here as unsigned
  UINT64 mifid_id;                               // bytes 159 to 166, signed, read here as unsigned
  UINT64 self_match_prevention_id;               // bytes 167 to 174, signed, read here as unsigned
  UINT8 self_match_prevention_instruction;       // byte 175
  UINT8 manual_order_indicator;                  // byte 176
  UINT8 exec_inst;                               // byte 177
  UINT8 cust_order_handling_inst;                // byte 178
  UINT8 position_effect;                         // byte 179
  UINT8 alloc_handl_inst;                        // byte 180
  UINT8 clearing_account_optional[14];           // bytes 181 to 194
  UINT8 customer_account_ref_id[12];             // bytes 195 to 206
  UINT8 memo[30];                                // bytes 207 to 236
  UINT8 allocation_account[20];                  // bytes 237 to 256
  UINT8 on_behalf_of_comp_id[41];                // bytes 257 to 297
  UINT8 on_behalf_of_sub_i_d_optional[41];       // bytes 298 to 338
  UINT8 on_behalf_of_location_i_d_optional[41];  // bytes 339 to 379
} ExecutionReportSnapshotMessage;

// ExecutionReport_TradeMessage
typedef struct _ExecutionReportTradeMessage {
  UINT8 originator_user_id[20];         // bytes 0 to 19
  UINT64 exec_i_d_int_64;               // bytes 20 to 27, signed, read here as unsigned
  UINT64 cl_ord_id;                     // bytes 28 to 35, signed, read here as unsigned
  UINT32 symbol;                        // bytes 36 to 39, signed, read here as unsigned
  UINT8 ord_type;                       // byte 40
  UINT8 side;                           // byte 41
  UINT64 order_id;                      // bytes 42 to 49, signed, read here as unsigned
  OrigOrderId orig_order_id;            // bytes 50 to 65
  UINT64 leaves_qty;                    // bytes 66 to 73, signed, read here as unsigned
  UINT64 cum_qty;                       // bytes 74 to 81, signed, read here as unsigned
  UINT64 last_px;                       // bytes 82 to 89, signed, read here as unsigned
  UINT64 last_shares;                   // bytes 90 to 97, signed, read here as unsigned
  UINT64 transact_time;                 // bytes 98 to 105
  UINT64 num_of_lots;                   // bytes 106 to 113, signed, read here as unsigned
  UINT8 exec_type;                      // byte 114
  UINT8 liquidity_indicator : 1;        // byte 115
  UINT8 deal_adjust_indicator : 1;      // byte 115
  UINT8 reserved_3_to_8 : 6;            // byte 115
  UINT32 clearing_firm_optional;        // bytes 116 to 119, signed, read here as unsigned
  UINT8 clearing_account_optional[14];  // bytes 120 to 133
  UINT8 memo[30];                       // bytes 134 to 163
  UINT64 exec_ref_id;                   // bytes 164 to 171, signed, read here as unsigned
  UINT16 no_leg_executions;             // bytes 172 to 173, signed, read here as unsigned
  UINT64 secondary_exec_id;             // bytes 174 to 181, signed, read here as unsigned
  UINT64 link_exec_id;                  // bytes 182 to 189, signed, read here as unsigned
  UINT64 last_par_px;                   // bytes 190 to 197, signed, read here as unsigned
  UINT64 delivery_start_date;           // bytes 198 to 205
  UINT64 delivery_end_date;             // bytes 206 to 213
  UINT64 cross_i_d_optional;            // bytes 214 to 221, signed, read here as unsigned
  UINT8 cross_type_optional;            // byte 222
  UINT8 waiver_indicator;               // byte 223
  UINT8 trade_type[3];                  // bytes 224 to 226
} ExecutionReportTradeMessage;

// QuoteReportMessage
typedef struct _QuoteReportMessage {
