} MassQuoteReportMessageNoQuoteSetsGroup;

// noQuoteSets Block
typedef struct _MassQuoteReportMessageNoQuoteSetsGroups {
  UINT16 block_length;                                                                                                               // bytes 0 to 1
  UINT16 num_in_group;                                                                                                               // bytes 2 to 3
  MassQuoteReportMessageNoQuoteSetsGroup mass_quote_report_message_no_quote_sets_group[:byte-size (((UINT32) num_in_group) * 121)];
} MassQuoteReportMessageNoQuoteSetsGroups;

// MassQuoteReportMessage
typedef struct _MassQuoteReportMessage {
  UINT64 quote_id;                                                                         // bytes 0 to 7, signed, read here as unsigned
  UINT8 originator_user_id[20];                                                            // bytes 8 to 27
  UINT8 risk_protection_reset;                                                             // byte 28
