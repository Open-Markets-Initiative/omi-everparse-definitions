// ---- Packet Header: 16 bytes -------------------------------------------------

// iMpact Upd market data packet header
entrypoint typedef struct _PacketHeader {
  UINT16BE session;         // bytes 0 to 1
  UINT32BE sequence;        // bytes 2 to 5
  UINT16BE number_of_msgs;  // bytes 6 to 7
  UINT64BE sent_date_time;  // bytes 8 to 15
} PacketHeader;

// ---- Message Header: 3 bytes -------------------------------------------------

// iMpact message header
entrypoint typedef struct _MessageHeader {
  UINT8 message_type;  // byte 0
  UINT16BE length;     // bytes 1 to 2
} MessageHeader;

// ---- Market Snapshot Message: 133 bytes --------------------------------------

// The market snapshot message is the same for full order depth and price level snapshot channel.
entrypoint typedef struct _MarketSnapshotMessage {
  UINT32BE market_id;                                   // bytes 0 to 3, signed, read here as unsigned
  UINT16BE market_type;                                 // bytes 4 to 5, signed, read here as unsigned
