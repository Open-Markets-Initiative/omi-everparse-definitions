  UINT32BE quantity;             // bytes 14 to 17, signed, read here as unsigned
  UINT16BE order_count;          // bytes 18 to 19, signed, read here as unsigned
  UINT32BE implied_quantity;     // bytes 20 to 23, signed, read here as unsigned
  UINT16BE implied_order_count;  // bytes 24 to 25, signed, read here as unsigned
  UINT64BE timestamp;            // bytes 26 to 33, signed, read here as unsigned
} AddPriceLevelMessage;

// ---- Change Price Level Message: 34 bytes ------------------------------------

// Upon receipt of this message, client should update the price level at the specified position in its book for the given market.
entrypoint typedef struct _ChangePriceLevelMessage {
  UINT32BE market_id;            // bytes 0 to 3, signed, read here as unsigned
  UINT8 side;                    // byte 4
  UINT8 price_level_position;    // byte 5, signed, read here as unsigned
  UINT64BE price;                // bytes 6 to 13, signed, read here as unsigned
  UINT32BE quantity;             // bytes 14 to 17, signed, read here as unsigned
  UINT16BE order_count;          // bytes 18 to 19, signed, read here as unsigned
  UINT32BE implied_quantity;     // bytes 20 to 23, signed, read here as unsigned
  UINT16BE implied_order_count;  // bytes 24 to 25, signed, read here as unsigned
  UINT64BE timestamp;            // bytes 26 to 33, signed, read here as unsigned
} ChangePriceLevelMessage;

// ---- Delete Price Level Message: 14 bytes ------------------------------------

// Upon receipt of this message, client should remove the price level at the specified position in its book for the given market.
entrypoint typedef struct _DeletePriceLevelMessage {
  UINT32BE market_id;          // bytes 0 to 3, signed, read here as unsigned
  UINT8 side;                  // byte 4
  UINT8 price_level_position;  // byte 5, signed, read here as unsigned
  UINT64BE timestamp;          // bytes 6 to 13, signed, read here as unsigned
} DeletePriceLevelMessage;

// ---- Rfq Message: 31 bytes ---------------------------------------------------

// Request for Quote Message.
entrypoint typedef struct _RfqMessage {
  UINT32BE market_id;             // bytes 0 to 3, signed, read here as unsigned
  UINT64BE message_timestamp;     // bytes 4 to 11, signed, read here as unsigned
  UINT64BE rfq_system_id;         // bytes 12 to 19, signed, read here as unsigned
  UINT16BE market_type_id;        // bytes 20 to 21, signed, read here as unsigned
  UINT32BE underlying_market_id;  // bytes 22 to 25, signed, read here as unsigned
  UINT32BE quantity;              // bytes 26 to 29, signed, read here as unsigned
  UINT8 side;                     // byte 30
} RfqMessage;

