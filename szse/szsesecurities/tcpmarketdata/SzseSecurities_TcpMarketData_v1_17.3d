// ---- Message Header: 8 bytes -------------------------------------------------

// Szse Mdgw Message Header, defining the type and body length of a message, transmitted without encryption
entrypoint typedef struct _MessageHeader {
  UINT32BE msg_type;     // bytes 0 to 3
