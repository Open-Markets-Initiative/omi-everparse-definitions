// Session Status: 4 byte code
#define SESSION_STATUS_ACTIVE_IN_SESSION 0x00000000                                                 // Active In Session
#define SESSION_STATUS_SESSION_PASSWORD_HAS_BEEN_CHANGED 0x00000001                                 // Session Password Has Been Changed
#define SESSION_STATUS_SESSION_PASSWORD_SHALL_BE_OVERDUE 0x00000002                                 // Session Password Shall Be Overdue
#define SESSION_STATUS_THE_NEW_SESSION_PASSWORD_IS_NOT_CONSISTENT_WITH_THE_INSTRUCTIONS 0x00000003  // The New Session Password Is Not Consistent With The Instructions
#define SESSION_STATUS_SESSION_LOGOUT_IS_COMPLETE 0x00000004                                        // Session Logout Is Complete
#define SESSION_STATUS_ILLEGAL_USER_NAME_OR_PASSWORD 0x00000005                                     // Illegal User Name Or Password
#define SESSION_STATUS_USER_NAME_IS_LOCKED 0x00000006                                               // User Name Is Locked
#define SESSION_STATUS_LOGON_IS_PROHIBITED_AT_THE_CURRENT_TIME 0x00000007                           // Logon Is Prohibited At The Current Time
#define SESSION_STATUS_PASSWORD_IS_OVERDUE 0x00000008                                               // Password Is Overdue
#define SESSION_STATUS_MSG_SEQ_NUM_RECEIVED_IS_TOO_SMALL 0x00000009                                 // Msg Seq Num Received Is Too Small
#define SESSION_STATUS_NEXT_EXPECTED_MSG_SEQ_NUM_RECEIVED_IS_TOO_LARGE 0x0000000A                   // Next Expected Msg Seq Num Received Is Too Large
#define SESSION_STATUS_OTHERS 0x00000065                                                            // Others
#define SESSION_STATUS_INVALID_MESSAGE 0x00000066                                                   // Invalid Message

// Resend Type: one byte code
#define RESEND_TYPE_TICK_DATA 0x01             // Tick Data
#define RESEND_TYPE_ANNOUNCEMENT_MESSAGE 0x02  // Announcement Message

// Resend Status: one byte code
#define RESEND_STATUS_FINISHED 0x01                // Finished
#define RESEND_STATUS_PARTLY_FINISHED 0x02         // Partly Finished
#define RESEND_STATUS_NO_AUTHORITY_RIGHTS 0x03     // No Authority Rights
#define RESEND_STATUS_DATA_IS_NOT_APPLICABLE 0x04  // Data Is Not Applicable

// Amounts Status: one byte code
#define AMOUNTS_STATUS_QUOTA_UNAVAILABLE 0x31  // Quota Unavailable
#define AMOUNTS_STATUS_QUOTA_AVAILABLE 0x32    // Quota Available
#define AMOUNTS_STATUS_QUOTA_ADEQUATE 0x33     // Quota Adequate

// Side: one byte code
#define SIDE_BUY 0x31     // Buy
#define SIDE_SELL 0x32    // Sell
#define SIDE_BORROW 0x47  // Borrow
#define SIDE_LEND 0x46    // Lend

// Ord Type: one byte code
#define ORD_TYPE_MARKET_PRICE 0x31              // Market Price
#define ORD_TYPE_LIMIT_PRICE 0x32               // Limit Price
#define ORD_TYPE_BEST_PRICE_OF_THIS_PARTY 0x55  // Best Price Of This Party

// Expiration Type: one byte code
#define EXPIRATION_TYPE_FIXED_TERM 0x01  // Fixed Term

// Settl Type: 2 byte code
#define SETTL_TYPE_MULTILATERAL_NETTING 0x0067  // Multilateral Netting
#define SETTL_TYPE_GROSS_SETTLEMENT 0x0068      // Gross Settlement

// Bid Trans Type: 2 byte code
#define BID_TRANS_TYPE_BID_RESERVATION_DECLARATION 0x0001  // Bid Reservation Declaration
#define BID_TRANS_TYPE_BID_INITIATION_DECLARATION 0x0002   // Bid Initiation Declaration
#define BID_TRANS_TYPE_BID_PRICE_DECLARATION 0x0003        // Bid Price Declaration

// Bid Exec Inst Type: 2 byte code
#define BID_EXEC_INST_TYPE_SINGLE_SUBJECT_WINNING_THE_BID 0x0001                    // Single Subject Winning The Bid
#define BID_EXEC_INST_TYPE_MULTIPLE_SUBJECTS_SINGLE_PRICE_WINNING_THE_BID 0x0002    // Multiple Subjects Single Price Winning The Bid
#define BID_EXEC_INST_TYPE_MULTIPLE_SUBJECTS_MULTIPLE_PRICE_WINNING_THE_BID 0x0003  // Multiple Subjects Multiple Price Winning The Bid

// Exec Type: one byte code
#define EXEC_TYPE_CANCELLED 0x34  // Cancelled
#define EXEC_TYPE_TRADED 0x46     // Traded

// ---- Message Header: 8 bytes -------------------------------------------------

// Szse Mdgw Message Header, defining the type and body length of a message, transmitted without encryption
entrypoint typedef struct _MessageHeader {
  UINT32BE msg_type;     // bytes 0 to 3, values MSG_TYPE_
  UINT32BE body_length;  // bytes 4 to 7
} MessageHeader;

// ---- Logon Message: 92 bytes -------------------------------------------------

// Logon message is the first message sent out to Market Data GateWay by Vendor Supplied System. Vendor Supplied System sets up a connection with Market Data GateWay through a logon message, and Market Data GateWay confirms the logon success through a logon message of its own, so both sides transmit this message type.
entrypoint typedef struct _LogonMessage {
  UINT8 sender_comp_id[20];       // bytes 0 to 19
  UINT8 target_comp_id[20];       // bytes 20 to 39
  UINT32BE heart_bt_int;          // bytes 40 to 43, signed, read here as unsigned
  UINT8 password[16];             // bytes 44 to 59
  UINT8 default_appl_ver_id[32];  // bytes 60 to 91
} LogonMessage;

// ---- Logout Message: 204 bytes -----------------------------------------------

// When the connection request from Vendor Supplied System is not accepted, Market Data GateWay sends a logout message to refuse the logon request. Vendor Supplied System also sends a logout message voluntarily to disconnect, so both sides transmit this message type.
entrypoint typedef struct _LogoutMessage {
  UINT32BE session_status;  // bytes 0 to 3, values SESSION_STATUS_, signed, read here as unsigned
  UINT8 text[200];          // bytes 4 to 203
} LogoutMessage;

// ---- Channel Heartbeat Message: 12 bytes -------------------------------------

// Sent on a market data channel every 3 seconds, carrying the sequence number of the last market data message on the channel.
entrypoint typedef struct _ChannelHeartbeatMessage {
  UINT16BE channel_no;         // bytes 0 to 1
  UINT64BE appl_last_seq_num;  // bytes 2 to 9, signed, read here as unsigned
  UINT16BE end_of_channel;     // bytes 10 to 11
} ChannelHeartbeatMessage;

// ---- Retransmitting Message: 44 bytes ----------------------------------------

// Vendor Supplied System sends a re-transmission message to Market Data GateWay, which returns the re-transmission data needed followed by a re-transmission message indicating completion, or the failure reason if it fails. Market Data GateWay handles multiple requests in the order in which they arrive, so this message type is transmitted by both sides; ResendStatus and RejectText are only effective on the gateway reply.
entrypoint typedef struct _RetransmittingMessage {
  UINT8 resend_type;          // byte 0, values RESEND_TYPE_
  UINT16BE channel_no;        // bytes 1 to 2
  UINT64BE appl_beg_seq_num;  // bytes 3 to 10, signed, read here as unsigned
  UINT64BE appl_end_seq_num;  // bytes 11 to 18, signed, read here as unsigned
  UINT8 news_id[8];           // bytes 19 to 26
  UINT8 resend_status;        // byte 27, values RESEND_STATUS_
  UINT8 reject_text[16];      // bytes 28 to 43
} RetransmittingMessage;

// ---- Client User Information Reporting Message: 26 bytes ---------------------

// Vendor Supplied System reports the number of client users connected to it at the current time to the Market Data GateWay front-end processor at regular intervals. Only the Vendor Supplied System of a vendor sends this message.
entrypoint typedef struct _ClientUserInformationReportingMessage {
  UINT64BE orig_time;      // bytes 0 to 7, signed, read here as unsigned
  UINT8 version_code[16];  // bytes 8 to 23
  UINT16BE user_num;       // bytes 24 to 25
} ClientUserInformationReportingMessage;

// ---- Business Reject Message: 74 bytes ---------------------------------------

// Rejects an application layer message that satisfies the session layer rules but does not satisfy the rules of the business layer. It reports on an incorrect re-transmitted message or client user information reporting message declared by the user.
entrypoint typedef struct _BusinessRejectMessage {
  UINT64BE ref_seq_num;              // bytes 0 to 7, signed, read here as unsigned
  UINT32BE ref_msg_type;             // bytes 8 to 11
  UINT8 business_reject_ref_id[10];  // bytes 12 to 21
  UINT16BE business_reject_reason;   // bytes 22 to 23
  UINT8 business_reject_text[50];    // bytes 24 to 73
} BusinessRejectMessage;

// ---- Real Time Market Status Message: 69 bytes -------------------------------

// Released every 3 seconds, carrying the trading session state of a market and, for stock connect, the daily quota balance.
entrypoint typedef struct _RealTimeMarketStatusMessage {
  UINT64BE orig_time;               // bytes 0 to 7, signed, read here as unsigned
  UINT16BE channel_no;              // bytes 8 to 9
  UINT8 market_id[8];               // bytes 10 to 17
  UINT8 market_segment_id[8];       // bytes 18 to 25
  UINT8 trading_session_id[4];      // bytes 26 to 29
  UINT8 trading_session_sub_id[4];  // bytes 30 to 33
  UINT16BE trad_ses_status;         // bytes 34 to 35
  UINT64BE trad_ses_start_time;     // bytes 36 to 43, signed, read here as unsigned
  UINT64BE trad_ses_end_time;       // bytes 44 to 51, signed, read here as unsigned
  UINT64BE thredhold_amount;        // bytes 52 to 59, signed, read here as unsigned
  UINT64BE pos_amt;                 // bytes 60 to 67, signed, read here as unsigned
  UINT8 amounts_status;             // byte 68, values AMOUNTS_STATUS_
} RealTimeMarketStatusMessage;

