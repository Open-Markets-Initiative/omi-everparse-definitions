// ---- Message Header: 4 bytes -------------------------------------------------

// Native Trading Gateway Message Header
entrypoint typedef struct _MessageHeader {
  UINT8 start_of_message;  // byte 0, signed, read here as unsigned
  UINT16 message_length;   // bytes 1 to 2, signed, read here as unsigned
