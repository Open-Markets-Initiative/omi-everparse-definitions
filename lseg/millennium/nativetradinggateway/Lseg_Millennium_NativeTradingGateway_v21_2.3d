// Allows the client and server to establish a session.
typedef struct _LogonMessage {
  UINT8 user_name[25];     // bytes 0 to 24
  UINT8 password[25];      // bytes 25 to 49
  UINT8 new_password[25];  // bytes 50 to 74
  UINT8 message_version;   // byte 75
} LogonMessage;

// Allows the server to acknowledge a client's Logon.
typedef struct _LogonReplyMessage {
  UINT32 reject_code;                   // bytes 0 to 3, signed, read here as unsigned
  UINT8 password_expiry_day_count[30];  // bytes 4 to 33
} LogonReplyMessage;

// Allows the client and server to terminate a session.
typedef struct _LogoutMessage {
  UINT8 reason[20];  // bytes 0 to 19
} LogoutMessage;

// Used to reject a message that does not comply with the Native Trading Gateway messaging protocol.
typedef struct _RejectMessage {
  UINT32 reject_code;           // bytes 0 to 3, signed, read here as unsigned
  UINT8 reject_reason[30];      // bytes 4 to 33
  UINT8 rejected_message_type;  // byte 34
  UINT8 client_order_id[20];    // bytes 35 to 54
} RejectMessage;

// Indicates service non availability of a partition, disseminated on the recovery and realtime channels.
typedef struct _SystemStatusMessage {
  UINT8 app_id;      // byte 0
  UINT8 app_status;  // byte 1
} SystemStatusMessage;

// Allows the client to submit a new order.
typedef struct _NewOrderMessage {
  UINT8 client_order_id[20];                 // bytes 0 to 19
  UINT8 trader_id[11];                       // bytes 20 to 30
  UINT8 account[10];                         // bytes 31 to 40
  UINT8 clearing_account;                    // byte 41
  UINT32 instrument_id;                      // bytes 42 to 45, signed, read here as unsigned
  UINT8 dea_flag : 1;                        // byte 46
  UINT8 liquidity_provision : 1;             // byte 46
  UINT8 algo : 1;                            // byte 46
  UINT8 reserved_37 : 5;                     // byte 46
  UINT8 client_id_qualifier : 2;             // byte 47
  UINT8 investor_information_qualifier : 2;  // byte 47
  UINT8 executing_trader_qualifier : 2;      // byte 47
  UINT8 reserved_67 : 2;                     // byte 47
  UINT8 order_type;                          // byte 48
  UINT8 tif;                                 // byte 49
  UINT32 expire_date_time;                   // bytes 50 to 53
  UINT8 side;                                // byte 54
  UINT32 order_qty;                          // bytes 55 to 58, signed, read here as unsigned
  UINT32 display_qty;                        // bytes 59 to 62, signed, read here as unsigned
  UINT64 limit_price;                        // bytes 63 to 70, signed, read here as unsigned
  UINT8 capacity;                            // byte 71
  UINT8 auto_cancel;                         // byte 72
  UINT8 new_order_order_sub_type;            // byte 73
  UINT8 anonymity;                           // byte 74
  UINT64 stop_price;                         // bytes 75 to 82, signed, read here as unsigned
  UINT8 passive_only_order;                  // byte 83
  UINT32 client_id;                          // bytes 84 to 87
  UINT32 investment_decision_maker;          // bytes 88 to 91
  UINT8 group_id;                            // byte 92
  UINT32 minimum_quantity;                   // bytes 93 to 96, signed, read here as unsigned
  UINT32 executing_trader;                   // bytes 97 to 100
  UINT32 offset;                             // bytes 101 to 104, signed, read here as unsigned
  UINT8 new_order_pegged_exec_inst;          // byte 105
  UINT8 owner_type;                          // byte 106
  UINT8 reserved_14[14];                     // bytes 107 to 120
} NewOrderMessage;

// Allows the client to submit and update a quote.
typedef struct _NewQuoteMessage {
  UINT8 client_order_id[20];                 // bytes 0 to 19
  UINT8 trader_id[11];                       // bytes 20 to 30
  UINT8 clearing_account;                    // byte 31
  UINT32 instrument_id;                      // bytes 32 to 35, signed, read here as unsigned
  UINT64 bid_price;                          // bytes 36 to 43, signed, read here as unsigned
  UINT32 bid_size;                           // bytes 44 to 47, signed, read here as unsigned
  UINT64 ask_price;                          // bytes 48 to 55, signed, read here as unsigned
  UINT32 ask_size;                           // bytes 56 to 59, signed, read here as unsigned
  UINT8 capacity;                            // byte 60
  UINT8 auto_cancel;                         // byte 61
  UINT32 client_id;                          // bytes 62 to 65
  UINT32 investment_decision_maker;          // bytes 66 to 69
  UINT32 executing_trader;                   // bytes 70 to 73
  UINT8 dea_flag : 1;                        // byte 74
  UINT8 liquidity_provision : 1;             // byte 74
  UINT8 algo : 1;                            // byte 74
  UINT8 reserved_37 : 5;                     // byte 74
  UINT8 client_id_qualifier : 2;             // byte 75
  UINT8 investor_information_qualifier : 2;  // byte 75
  UINT8 executing_trader_qualifier : 2;      // byte 75
  UINT8 reserved_67 : 2;                     // byte 75
  UINT8 new_quote_pegged_exec_inst;          // byte 76
} NewQuoteMessage;

// Allows the client to cancel or replace a live order.
typedef struct _OrderCancelReplaceRequestMessage {
  UINT8 client_order_id[20];           // bytes 0 to 19
  UINT8 original_client_order_id[20];  // bytes 20 to 39
  UINT8 order_id[12];                  // bytes 40 to 51
  UINT32 instrument_id;                // bytes 52 to 55, signed, read here as unsigned
  UINT8 group_id;                      // byte 56
  UINT8 reserved_1;                    // byte 57
  UINT32 expire_date_time;             // bytes 58 to 61
  UINT32 order_qty;                    // bytes 62 to 65, signed, read here as unsigned
  UINT32 display_qty;                  // bytes 66 to 69, signed, read here as unsigned
  UINT64 limit_price;                  // bytes 70 to 77, signed, read here as unsigned
  UINT8 account[10];                   // bytes 78 to 87
  UINT8 second_reserved_1;             // byte 88
  UINT8 side;                          // byte 89
  UINT64 stop_price;                   // bytes 90 to 97, signed, read here as unsigned
  UINT8 passive_only_order;            // byte 98
  UINT32 offset;                       // bytes 99 to 102, signed, read here as unsigned
  UINT8 reserved_5[5];                 // bytes 103 to 107
  UINT32 minimum_quantity;             // bytes 108 to 111, signed, read here as unsigned
} OrderCancelReplaceRequestMessage;

// Allows the client to cancel a live order.
typedef struct _OrderCancelRequestMessage {
  UINT8 client_order_id[20];           // bytes 0 to 19
  UINT8 original_client_order_id[20];  // bytes 20 to 39
  UINT8 order_id[12];                  // bytes 40 to 51
  UINT32 instrument_id;                // bytes 52 to 55, signed, read here as unsigned
  UINT8 reserved_1;                    // byte 56
  UINT8 second_reserved_1;             // byte 57
  UINT8 side;                          // byte 58
  UINT8 rfq_id[10];                    // bytes 59 to 68
} OrderCancelRequestMessage;

// Allows the client to mass cancel live orders, optionally scoped to an instrument or a segment.
typedef struct _OrderMassCancelRequestMessage {
  UINT8 client_order_id[20];                       // bytes 0 to 19
  UINT8 mass_cancel_request_type;                  // byte 20
  UINT32 instrument_id;                            // bytes 21 to 24, signed, read here as unsigned
  UINT8 reserved_1;                                // byte 25
  UINT8 group_id;                                  // byte 26
  UINT8 segment[4];                                // bytes 27 to 30
  UINT8 order_mass_cancel_request_order_sub_type;  // byte 31
  UINT8 reserved_10[10];                           // bytes 32 to 41
} OrderMassCancelRequestMessage;

// Composite
typedef struct _TransactTime {
  UINT32 seconds;      // bytes 0 to 3
  UINT32 nanoseconds;  // bytes 4 to 7
} TransactTime;

// Indicates order accepted, rejected, executed, expired, cancelled, cancel/replaced, restated or suspended, or a trade cancel.
typedef struct _ExecutionReportMessage {
  UINT8 app_id;                             // byte 0
  UINT32 sequence_no;                       // bytes 1 to 4, signed, read here as unsigned
  UINT8 execution_id[12];                   // bytes 5 to 16
  UINT8 client_order_id[20];                // bytes 17 to 36
  UINT8 order_id[12];                       // bytes 37 to 48
  UINT8 exec_type;                          // byte 49
  UINT8 execution_report_ref_id[12];        // bytes 50 to 61
  UINT8 execution_report_order_status;      // byte 62
  UINT32 order_reject_code;                 // bytes 63 to 66, signed, read here as unsigned
  UINT64 executed_price;                    // bytes 67 to 74, signed, read here as unsigned
  UINT32 executed_qty;                      // bytes 75 to 78, signed, read here as unsigned
  UINT32 leaves_qty;                        // bytes 79 to 82, signed, read here as unsigned
  UINT8 reserved_bit_0 : 1;                 // byte 83
  UINT8 clse : 1;                           // byte 83
  UINT8 reserved_bit_2 : 1;                 // byte 83
  UINT8 ilqd : 1;                           // byte 83
  UINT8 reserved_bit_4 : 1;                 // byte 83
  UINT8 rfpt : 1;                           // byte 83
  UINT8 reserved_67 : 2;                    // byte 83
  UINT32 display_qty;                       // bytes 84 to 87, signed, read here as unsigned
  UINT32 instrument_id;                     // bytes 88 to 91, signed, read here as unsigned
  UINT8 restatement_reason;                 // byte 92
  UINT8 execution_report_pegged_exec_inst;  // byte 93
  UINT8 side;                               // byte 94
  UINT8 owner_type;                         // byte 95
  UINT8 reserved_7[7];                      // bytes 96 to 102
  UINT8 counterparty[11];                   // bytes 103 to 113
  UINT8 trade_liquidity_indicator;          // byte 114
  UINT64 trade_match_id;                    // bytes 115 to 122
  TransactTime transact_time;               // bytes 123 to 130
  UINT8 last_market;                        // byte 131
  UINT8 type_of_trade;                      // byte 132
  UINT8 capacity;                           // byte 133
  UINT8 reserved_1;                         // byte 134
  UINT8 public_order_id[12];                // bytes 135 to 146
  UINT32 minimum_quantity;                  // bytes 147 to 150, signed, read here as unsigned
} ExecutionReportMessage;

// Indicates that an order cancel request or order cancel/replace request has been rejected.
typedef struct _OrderCancelRejectMessage {
  UINT8 app_id;                 // byte 0
  UINT32 sequence_no;           // bytes 1 to 4, signed, read here as unsigned
  UINT8 client_order_id[20];    // bytes 5 to 24
  UINT8 order_id[12];           // bytes 25 to 36
  UINT32 cancel_reject_reason;  // bytes 37 to 40, signed, read here as unsigned
  TransactTime transact_time;   // bytes 41 to 48
  UINT8 rfq_id[10];             // bytes 49 to 58
} OrderCancelRejectMessage;

// Indicates that a mass order cancel request was accepted or rejected.
typedef struct _OrderMassCancelReportMessage {
  UINT8 app_id;                      // byte 0
  UINT32 sequence_no;                // bytes 1 to 4, signed, read here as unsigned
  UINT8 client_order_id[20];         // bytes 5 to 24
  UINT8 mass_cancel_response;        // byte 25
  UINT32 mass_cancel_reject_reason;  // bytes 26 to 29, signed, read here as unsigned
  UINT8 reserved_4[4];               // bytes 30 to 33
  TransactTime transact_time;        // bytes 34 to 41
  UINT8 reserved_10[10];             // bytes 42 to 51
} OrderMassCancelReportMessage;

// Carries a Request For Quote. Sent by the Requester to submit an RFQ, and by the server to deliver it to the Market Maker.
typedef struct _QuoteRequestMessage {
  UINT8 partition_id;                        // byte 0
  UINT32 sequence_number;                    // bytes 1 to 4, signed, read here as unsigned
  UINT8 quote_req_id[10];                    // bytes 5 to 14
  UINT8 order_book;                          // byte 15
  UINT8 private_quote;                       // byte 16
  UINT32 instrument_id;                      // bytes 17 to 20, signed, read here as unsigned
  UINT8 side;                                // byte 21
  UINT32 order_quantity;                     // bytes 22 to 25, signed, read here as unsigned
  UINT32 expire_time;                        // bytes 26 to 29
  UINT8 market_makers[60];                   // bytes 30 to 89
  UINT8 contra_trader[11];                   // bytes 90 to 100
  UINT8 contra_firm[11];                     // bytes 101 to 111
  UINT8 rfq_id[10];                          // bytes 112 to 121
  UINT32 client_id;                          // bytes 122 to 125
  UINT32 investment_decision_maker;          // bytes 126 to 129
  UINT32 executing_trader;                   // bytes 130 to 133
  UINT8 dea_flag : 1;                        // byte 134
  UINT8 liquidity_provision : 1;             // byte 134
  UINT8 algo : 1;                            // byte 134
  UINT8 reserved_37 : 5;                     // byte 134
  UINT8 client_id_qualifier : 2;             // byte 135
  UINT8 investor_information_qualifier : 2;  // byte 135
  UINT8 executing_trader_qualifier : 2;      // byte 135
  UINT8 reserved_67 : 2;                     // byte 135
  UINT8 quote_request_type;                  // byte 136
  UINT64 price;                              // bytes 137 to 144, signed, read here as unsigned
  UINT8 rfq_execution_delay;                 // byte 145
  UINT8 rfq_min_quotes;                      // byte 146
  UINT8 account_type;                        // byte 147
  UINT8 order_capacity;                      // byte 148
  UINT8 rfq_disclose_side;                   // byte 149
  UINT32 expire_time_milliseconds;           // bytes 150 to 153
  UINT8 auto_rfq_exec_strategy;              // byte 154
  UINT8 num_of_competitors;                  // byte 155
  UINT8 market_maker_rank;                   // byte 156
} QuoteRequestMessage;

// Allows the server to communicate the status of the RFQ to the Requester.
typedef struct _QuoteStatusReportMessage {
  UINT8 partition_id;               // byte 0
  UINT32 sequence_number;           // bytes 1 to 4, signed, read here as unsigned
  UINT8 quote_msg_id[20];           // bytes 5 to 24
  UINT8 quote_req_id[10];           // bytes 25 to 34
  UINT8 quote_status;               // byte 35
  UINT32 reject_code;               // bytes 36 to 39, signed, read here as unsigned
  UINT8 order_book;                 // byte 40
  UINT8 market_makers[60];          // bytes 41 to 100
  UINT8 rfq_id[10];                 // bytes 101 to 110
  UINT32 expire_time;               // bytes 111 to 114
  UINT8 bid_id[12];                 // bytes 115 to 126
  UINT8 offer_id[12];               // bytes 127 to 138
  UINT32 expire_time_milliseconds;  // bytes 139 to 142
} QuoteStatusReportMessage;

// Rejects an RFQ. Sent by the Market Maker to reject, and by the server to reject or to relay a Market Maker rejection.
typedef struct _QuoteRequestRejectMessage {
  UINT8 partition_id;       // byte 0
  UINT32 sequence_number;   // bytes 1 to 4, signed, read here as unsigned
  UINT8 quote_req_id[10];   // bytes 5 to 14
  UINT32 reject_code;       // bytes 15 to 18, signed, read here as unsigned
  UINT8 order_book;         // byte 19
  UINT32 instrument_id;     // bytes 20 to 23, signed, read here as unsigned
  UINT8 side;               // byte 24
  UINT32 order_quantity;    // bytes 25 to 28, signed, read here as unsigned
  UINT8 market_makers[60];  // bytes 29 to 88
  UINT8 contra_trader[11];  // bytes 89 to 99
  UINT8 rfq_id[10];         // bytes 100 to 109
} QuoteRequestRejectMessage;

// Carries an RFQ Quote. Sent by the Market Maker to accept an RFQ, and by the server to deliver the quote to the Requester.
typedef struct _RfqQuoteMessage {
  UINT8 partition_id;                        // byte 0
  UINT32 sequence_number;                    // bytes 1 to 4, signed, read here as unsigned
  UINT8 quote_msg_id[20];                    // bytes 5 to 24
  UINT8 rfq_id[10];                          // bytes 25 to 34
  UINT32 instrument_id;                      // bytes 35 to 38, signed, read here as unsigned
  UINT64 bid_price;                          // bytes 39 to 46, signed, read here as unsigned
  UINT32 bid_quantity;                       // bytes 47 to 50, signed, read here as unsigned
  UINT64 offer_price;                        // bytes 51 to 58, signed, read here as unsigned
  UINT32 offer_quantity;                     // bytes 59 to 62, signed, read here as unsigned
  UINT8 auto_cancel;                         // byte 63
  UINT8 market_maker[11];                    // bytes 64 to 74
  UINT8 market_maker_firm[11];               // bytes 75 to 85
  UINT8 bid_id[12];                          // bytes 86 to 97
  UINT8 offer_id[12];                        // bytes 98 to 109
  UINT8 capacity;                            // byte 110
  UINT8 clearing_account;                    // byte 111
  UINT32 client_id;                          // bytes 112 to 115
  UINT32 investment_decision_maker;          // bytes 116 to 119
  UINT32 executing_trader;                   // bytes 120 to 123
  UINT8 dea_flag : 1;                        // byte 124
  UINT8 liquidity_provision : 1;             // byte 124
  UINT8 algo : 1;                            // byte 124
  UINT8 reserved_37 : 5;                     // byte 124
  UINT8 client_id_qualifier : 2;             // byte 125
  UINT8 investor_information_qualifier : 2;  // byte 125
  UINT8 executing_trader_qualifier : 2;      // byte 125
  UINT8 reserved_67 : 2;                     // byte 125
} RfqQuoteMessage;

// Allows the server to acknowledge a new or modified RFQ Quote to the Market Maker.
typedef struct _QuoteAckMessage {
  UINT8 partition_id;      // byte 0
  UINT32 sequence_number;  // bytes 1 to 4, signed, read here as unsigned
  UINT8 quote_msg_id[20];  // bytes 5 to 24
  UINT8 rfq_id[10];        // bytes 25 to 34
  UINT8 bid_id[12];        // bytes 35 to 46
  UINT8 offer_id[12];      // bytes 47 to 58
  UINT8 quote_ack_status;  // byte 59
  UINT32 reject_code;      // bytes 60 to 63, signed, read here as unsigned
  UINT8 order_book;        // byte 64
} QuoteAckMessage;

// Carries an RFQ response. Sent by the Requester to execute or cancel an RFQ Quote, and by the server to report quote and RFQ status.
typedef struct _QuoteResponseMessage {
  UINT8 partition_id;      // byte 0
  UINT32 sequence_number;  // bytes 1 to 4, signed, read here as unsigned
  UINT8 quote_msg_id[20];  // bytes 5 to 24
  UINT8 rfq_id[10];        // bytes 25 to 34
  UINT8 quote_resp_type;   // byte 35
  UINT32 instrument_id;    // bytes 36 to 39, signed, read here as unsigned
  UINT8 side;              // byte 40
  UINT32 order_quantity;   // bytes 41 to 44, signed, read here as unsigned
  UINT64 limit_price;      // bytes 45 to 52, signed, read here as unsigned
  UINT8 order_book;        // byte 53
  UINT8 bid_id[12];        // bytes 54 to 65
  UINT8 offer_id[12];      // bytes 66 to 77
  UINT8 capacity;          // byte 78
  UINT8 clearing_account;  // byte 79
  UINT8 reserved_8[8];     // bytes 80 to 87
} QuoteResponseMessage;

// Allows the system to notify the Requester and the Market Maker about a trade or the status of the quote.
typedef struct _RfqExecutionReportMessage {
  UINT8 partition_id;                       // byte 0
  UINT32 sequence_number;                   // bytes 1 to 4, signed, read here as unsigned
  UINT8 execution_id[12];                   // bytes 5 to 16
  UINT8 rfq_id[10];                         // bytes 17 to 26
  UINT8 order_id[12];                       // bytes 27 to 38
  UINT8 execution_type;                     // byte 39
  UINT64 trade_match_id;                    // bytes 40 to 47
  UINT8 side;                               // byte 48
  UINT32 executed_quantity;                 // bytes 49 to 52, signed, read here as unsigned
  UINT64 executed_price;                    // bytes 53 to 60, signed, read here as unsigned
  TransactTime transact_time;               // bytes 61 to 68
  UINT8 reserved_8[8];                      // bytes 69 to 76
  UINT8 second_reserved_8[8];               // bytes 77 to 84
  UINT8 rfq_execution_report_order_status;  // byte 85
  UINT32 leaves_quantity;                   // bytes 86 to 89, signed, read here as unsigned
  UINT32 instrument_id;                     // bytes 90 to 93, signed, read here as unsigned
  UINT8 third_reserved_8[8];                // bytes 94 to 101
  UINT8 fourth_reserved_8[8];               // bytes 102 to 109
  UINT8 contra_firm[11];                    // bytes 110 to 120
  UINT8 capacity;                           // byte 121
  UINT8 clearing_account;                   // byte 122
  UINT8 reserved_02 : 3;                    // byte 123
  UINT8 ilqd : 1;                           // byte 123
  UINT8 reserved_47 : 4;                    // byte 123
  UINT8 execution_report_ref_id[12];        // bytes 124 to 135
  UINT8 contra_order_book;                  // byte 136
  UINT64 avg_px;                            // bytes 137 to 144, signed, read here as unsigned
  UINT8 last_market;                        // byte 145
  UINT8 reserved_7[7];                      // bytes 146 to 152
} RfqExecutionReportMessage;

// Indicates that an application message could not be processed.
typedef struct _BusinessRejectMessage {
  UINT8 app_id;                // byte 0
  UINT32 sequence_no;          // bytes 1 to 4, signed, read here as unsigned
  UINT32 reject_code;          // bytes 5 to 8, signed, read here as unsigned
  UINT8 client_order_id[20];   // bytes 9 to 28
  UINT8 order_id[12];          // bytes 29 to 40
  TransactTime transact_time;  // bytes 41 to 48
  UINT8 reserved_10[10];       // bytes 49 to 58
} BusinessRejectMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: LogonMessage logon_message;
    case 0x42: LogonReplyMessage logon_reply_message;
    case 0x35: LogoutMessage logout_message;
    case 0x30: unit heartbeat_message;
    case 0x33: RejectMessage reject_message;
    case 0x6E: SystemStatusMessage system_status_message;
    case 0x44: NewOrderMessage new_order_message;
    case 0x53: NewQuoteMessage new_quote_message;
    case 0x47: OrderCancelReplaceRequestMessage order_cancel_replace_request_message;
    case 0x46: OrderCancelRequestMessage order_cancel_request_message;
    case 0x71: OrderMassCancelRequestMessage order_mass_cancel_request_message;
    case 0x38: ExecutionReportMessage execution_report_message;
    case 0x39: OrderCancelRejectMessage order_cancel_reject_message;
    case 0x72: OrderMassCancelReportMessage order_mass_cancel_report_message;
    case 0x61: QuoteRequestMessage quote_request_message;
    case 0x63: QuoteStatusReportMessage quote_status_report_message;
    case 0x62: QuoteRequestRejectMessage quote_request_reject_message;
    case 0x64: RfqQuoteMessage rfq_quote_message;
    case 0x65: QuoteAckMessage quote_ack_message;
    case 0x66: QuoteResponseMessage quote_response_message;
    case 0x67: RfqExecutionReportMessage rfq_execution_report_message;
    case 0x6A: BusinessRejectMessage business_reject_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Native Trading Gateway Message
typedef struct _Message {
  UINT8 start_of_message;                                                                                                                       // byte 0, signed, read here as unsigned
  UINT16 message_length { message_length >= 1 };                                                                                                // bytes 1 to 2, signed, read here as unsigned
  UINT8 message_type;                                                                                                                           // byte 3
  Payload(message_type, ((((UINT32) message_length) + 3) - 4)) payload[:byte-size-single-element-array ((((UINT32) message_length) + 3) - 4)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Native Trading Gateway Tcp Message Block
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

