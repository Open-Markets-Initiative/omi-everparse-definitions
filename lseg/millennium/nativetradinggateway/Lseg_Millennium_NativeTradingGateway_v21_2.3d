} OrderCancelRejectMessage;

// ---- Order Mass Cancel Report Message: 52 bytes ------------------------------

// Indicates that a mass order cancel request was accepted or rejected.
entrypoint typedef struct _OrderMassCancelReportMessage {
  UINT8 app_id;                      // byte 0
