} TransactTime;

// ---- Order Cancel Reject Message: 59 bytes -----------------------------------

// Indicates that an order cancel request or order cancel/replace request has been rejected.
entrypoint typedef struct _OrderCancelRejectMessage {
  UINT8 app_id;                 // byte 0
