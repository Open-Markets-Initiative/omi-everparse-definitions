// Message Type: one byte code
#define MESSAGE_TYPE_LOGON_MESSAGE 0x41                       // Logon Message
#define MESSAGE_TYPE_LOGON_REPLY_MESSAGE 0x42                 // Logon Reply Message
#define MESSAGE_TYPE_LOGOUT_MESSAGE 0x35                      // Logout Message
#define MESSAGE_TYPE_HEARTBEAT_MESSAGE 0x30                   // Heartbeat Message
#define MESSAGE_TYPE_MISSED_MESSAGE_REQUEST_MESSAGE 0x4D      // Missed Message Request Message
#define MESSAGE_TYPE_MISSED_MESSAGE_REQUEST_ACK_MESSAGE 0x4E  // Missed Message Request Ack Message
#define MESSAGE_TYPE_MISSED_MESSAGE_REPORT_MESSAGE 0x50       // Missed Message Report Message
#define MESSAGE_TYPE_REJECT_MESSAGE 0x33                      // Reject Message
#define MESSAGE_TYPE_SYSTEM_STATUS_MESSAGE 0x6E               // System Status Message
#define MESSAGE_TYPE_EXECUTION_REPORT_MESSAGE 0x38            // Execution Report Message
#define MESSAGE_TYPE_ORDER_MASS_CANCEL_REPORT_MESSAGE 0x72    // Order Mass Cancel Report Message
#define MESSAGE_TYPE_QUOTE_REQUEST_MESSAGE 0x61               // Quote Request Message
#define MESSAGE_TYPE_QUOTE_STATUS_REPORT_MESSAGE 0x63         // Quote Status Report Message
#define MESSAGE_TYPE_QUOTE_REQUEST_REJECT_MESSAGE 0x62        // Quote Request Reject Message
#define MESSAGE_TYPE_RFQ_QUOTE_MESSAGE 0x64                   // Rfq Quote Message
#define MESSAGE_TYPE_QUOTE_ACK_MESSAGE 0x65                   // Quote Ack Message
#define MESSAGE_TYPE_QUOTE_RESPONSE_MESSAGE 0x66              // Quote Response Message
#define MESSAGE_TYPE_RFQ_EXECUTION_REPORT_MESSAGE 0x67        // Rfq Execution Report Message

// App Id: one byte code
#define APP_ID_SYSTEM_SUSPENDED_UNKNOWN_INSTRUMENT 0x00  // System Suspended Unknown Instrument
#define APP_ID_PARTITION_1 0x01                          // Partition 1
#define APP_ID_PARTITION_2 0x02                          // Partition 2
#define APP_ID_PARTITION_3 0x03                          // Partition 3
#define APP_ID_PARTITION_4 0x04                          // Partition 4

// Missed Message Request Ack Response Type: one byte code
#define MISSED_MESSAGE_REQUEST_ACK_RESPONSE_TYPE_SUCCESSFUL 0x00                      // Successful
#define MISSED_MESSAGE_REQUEST_ACK_RESPONSE_TYPE_RECOVERY_REQUEST_LIMIT_REACHED 0x01  // Recovery Request Limit Reached
#define MISSED_MESSAGE_REQUEST_ACK_RESPONSE_TYPE_INVALID_APP_ID 0x02                  // Invalid App Id
#define MISSED_MESSAGE_REQUEST_ACK_RESPONSE_TYPE_SERVICE_UNAVAILABLE 0x03             // Service Unavailable

// Missed Message Report Response Type: one byte code
#define MISSED_MESSAGE_REPORT_RESPONSE_TYPE_DOWNLOAD_COMPLETE 0x00      // Download Complete
#define MISSED_MESSAGE_REPORT_RESPONSE_TYPE_MESSAGE_LIMIT_REACHED 0x01  // Message Limit Reached
#define MISSED_MESSAGE_REPORT_RESPONSE_TYPE_SERVICE_UNAVAILABLE 0x03    // Service Unavailable

// App Status: one byte code
#define APP_STATUS_RECOVERY_SERVICE_RESUMED 0x01                                                          // Recovery Service Resumed
#define APP_STATUS_RECOVERY_SERVICE_NOT_AVAILABLE 0x02                                                    // Recovery Service Not Available
#define APP_STATUS_REALTIME_CHANNEL_TO_INDICATE_SERVICE_NON_AVAILABILITY_OF_A_PARTITION_DUE__fv2c84 0x03  // Realtime Channel To Indicate Service Non Availability Of A Partition Due To Order Cache Outage

// Exec Type: one byte code
#define EXEC_TYPE_NEW 0x30           // New
#define EXEC_TYPE_CANCELLED 0x34     // Cancelled
#define EXEC_TYPE_REPLACED 0x35      // Replaced
#define EXEC_TYPE_REJECTED 0x38      // Rejected
#define EXEC_TYPE_EXPIRED 0x43       // Expired
#define EXEC_TYPE_RESTATED 0x44      // Restated
#define EXEC_TYPE_TRADE 0x46         // Trade
#define EXEC_TYPE_TRADE_CANCEL 0x48  // Trade Cancel
#define EXEC_TYPE_SUSPENDED 0x39     // Suspended

// Execution Report Order Status: one byte code
#define EXECUTION_REPORT_ORDER_STATUS_NEW 0x00               // New
#define EXECUTION_REPORT_ORDER_STATUS_PARTIALLY_FILLED 0x01  // Partially Filled
#define EXECUTION_REPORT_ORDER_STATUS_FILLED 0x02            // Filled
#define EXECUTION_REPORT_ORDER_STATUS_CANCELLED 0x04         // Cancelled
#define EXECUTION_REPORT_ORDER_STATUS_EXPIRED 0x06           // Expired
#define EXECUTION_REPORT_ORDER_STATUS_REJECTED 0x08          // Rejected
#define EXECUTION_REPORT_ORDER_STATUS_SUSPENDED 0x09         // Suspended

// Execution Report Pegged Exec Inst: one byte code
#define EXECUTION_REPORT_PEGGED_EXEC_INST_PERMISSIONED_FOR_EXECUTION_AGAINST_MID_PRICED_PEGGED_ORDERS 0x01      // Permissioned For Execution Against Mid Priced Pegged Orders
#define EXECUTION_REPORT_PEGGED_EXEC_INST_NOT_PERMISSIONED_FOR_EXECUTION_AGAINST_MID_PRICED_PEGGED_ORDERS 0x02  // Not Permissioned For Execution Against Mid Priced Pegged Orders

// Side: one byte code
#define SIDE_NONE 0x00  // None
#define SIDE_BUY 0x01   // Buy
#define SIDE_SELL 0x02  // Sell

// Owner Type: one byte code
#define OWNER_TYPE_DEFAULT 0x00                    // Default
#define OWNER_TYPE_RETAIL_INVESTOR 0x01            // Retail Investor
#define OWNER_TYPE_RETAIL_LIQUIDITY_PROVIDER 0x02  // Retail Liquidity Provider

// Trade Liquidity Indicator: one byte code
#define TRADE_LIQUIDITY_INDICATOR_ADDED_LIQUIDITY 0x41    // Added Liquidity
#define TRADE_LIQUIDITY_INDICATOR_REMOVED_LIQUIDITY 0x52  // Removed Liquidity
#define TRADE_LIQUIDITY_INDICATOR_AUCTION 0x43            // Auction

// Last Market: one byte code
#define LAST_MARKET_XLON_ON_EXCHANGE_LSE_RM 0x15       // Xlon On Exchange Lse Rm
#define LAST_MARKET_XLOM_ON_EXCHANGE_NON_AIM_MTF 0x16  // Xlom On Exchange Non Aim Mtf
#define LAST_MARKET_AIMX_ON_EXCHANGE_AIM_MTF 0x17      // Aimx On Exchange Aim Mtf

// Type Of Trade: one byte code
#define TYPE_OF_TRADE_VISIBLE 0x00                                                          // Visible
#define TYPE_OF_TRADE_HIDDEN 0x01                                                           // Hidden
#define TYPE_OF_TRADE_NOT_SPECIFIED_FOR_AGGRESSIVE_SIDE_AUCTION_TRADES_AND_RFQ_TRADES 0x02  // Not Specified For Aggressive Side Auction Trades And Rfq Trades

// Capacity: one byte code
#define CAPACITY_MATCHED_PRINCIPAL_MTCH 0x01           // Matched Principal Mtch
#define CAPACITY_DEALING_ON_OWN_ACCOUNT_DEAL 0x02      // Dealing On Own Account Deal
#define CAPACITY_ANY_OTHER_TRADING_CAPACITY_AOTC 0x03  // Any Other Trading Capacity Aotc

// Mass Cancel Response: one byte code
#define MASS_CANCEL_RESPONSE_REJECTED 0x00  // Rejected
#define MASS_CANCEL_RESPONSE_ACCEPTED 0x07  // Accepted

// Order Book: one byte code
#define ORDER_BOOK_RFQ_TRADES 0x0B  // Rfq Trades

// Private Quote: one byte code
#define PRIVATE_QUOTE_PRIVATE_QUOTE 0x02  // Private Quote

// Client Id: 4 byte code
#define CLIENT_ID_NONE 0x00000000  // None
#define CLIENT_ID_AGGR 0x00000001  // Aggr
#define CLIENT_ID_PNAL 0x00000002  // Pnal

// Investment Decision Maker: 4 byte code
#define INVESTMENT_DECISION_MAKER_NONE 0x00000000  // None

// Executing Trader: 4 byte code
#define EXECUTING_TRADER_CLIENT 0x00000003  // Client

// Quote Request Type: one byte code
#define QUOTE_REQUEST_TYPE_MANUAL_NAMED_IF_ANY_MARKET_MAKER_I_DS_ARE_SPECIFIED_ELSE_ANONYMOUS 0x00     // Manual Named If Any Market Maker I Ds Are Specified Else Anonymous
#define QUOTE_REQUEST_TYPE_AUTOMATIC_NAMED_IF_ANY_MARKET_MAKER_I_DS_ARE_SPECIFIED_ELSE_ANONYMOUS 0x01  // Automatic Named If Any Market Maker I Ds Are Specified Else Anonymous
#define QUOTE_REQUEST_TYPE_MANUAL_NAMED 0x02                                                           // Manual Named
#define QUOTE_REQUEST_TYPE_MANUAL_ANONYMOUS 0x03                                                       // Manual Anonymous
#define QUOTE_REQUEST_TYPE_AUTOMATIC_NAMED 0x04                                                        // Automatic Named
#define QUOTE_REQUEST_TYPE_AUTOMATIC_ANONYMOUS 0x05                                                    // Automatic Anonymous

// Account Type: one byte code
#define ACCOUNT_TYPE_CLIENT 0x01  // Client

// Order Capacity: one byte code
#define ORDER_CAPACITY_MATCHED_PRINCIPAL_MTCH 0x01           // Matched Principal Mtch
#define ORDER_CAPACITY_DEALING_ON_OWN_ACCOUNT_DEAL 0x02      // Dealing On Own Account Deal
#define ORDER_CAPACITY_ANY_OTHER_TRADING_CAPACITY_AOTC 0x03  // Any Other Trading Capacity Aotc

// Rfq Disclose Side: one byte code
#define RFQ_DISCLOSE_SIDE_DO_NOT_DISCLOSE 0x00  // Do Not Disclose
#define RFQ_DISCLOSE_SIDE_DISCLOSE 0x01         // Disclose

// Auto Rfq Exec Strategy: one byte code
#define AUTO_RFQ_EXEC_STRATEGY_SUB_LIS_AUCTION 0x01       // Sub Lis Auction
#define AUTO_RFQ_EXEC_STRATEGY_LIS_WINNER_TAKES_ALL 0x04  // Lis Winner Takes All

// Quote Status: one byte code
#define QUOTE_STATUS_ACCEPTED 0x01  // Accepted
#define QUOTE_STATUS_REJECTED 0x02  // Rejected

// Auto Cancel: one byte code
#define AUTO_CANCEL_DO_NOT_CANCEL 0x00                   // Do Not Cancel
#define AUTO_CANCEL_CONFORM_TO_USERS_CONFIGURATION 0x01  // Conform To Users Configuration

// Clearing Account: one byte code
#define CLEARING_ACCOUNT_CLIENT 0x01  // Client
#define CLEARING_ACCOUNT_HOUSE 0x03   // House

// Quote Ack Status: one byte code
#define QUOTE_ACK_STATUS_ACCEPTED 0x01  // Accepted
#define QUOTE_ACK_STATUS_REJECTED 0x02  // Rejected

// Quote Resp Type: one byte code
#define QUOTE_RESP_TYPE_HIT_LIFT 0x01                // Hit Lift
#define QUOTE_RESP_TYPE_EXPIRED 0x03                 // Expired
#define QUOTE_RESP_TYPE_END_TRADE 0x07               // End Trade
#define QUOTE_RESP_TYPE_TIMED_OUT 0x08               // Timed Out
#define QUOTE_RESP_TYPE_CANCELLED 0x0B               // Cancelled
#define QUOTE_RESP_TYPE_REPLACE 0x64                 // Replace
#define QUOTE_RESP_TYPE_EXECUTABLE 0x65              // Executable
#define QUOTE_RESP_TYPE_MAKE_RFQ_QUOTES_PUBLIC 0x66  // Make Rfq Quotes Public

// Execution Type: one byte code
#define EXECUTION_TYPE_CANCELLED 0x34     // Cancelled
#define EXECUTION_TYPE_EXPIRED 0x43       // Expired
#define EXECUTION_TYPE_RESTATED 0x44      // Restated
#define EXECUTION_TYPE_TRADE 0x46         // Trade
#define EXECUTION_TYPE_TRADE_CANCEL 0x48  // Trade Cancel

// Rfq Execution Report Order Status: one byte code
#define RFQ_EXECUTION_REPORT_ORDER_STATUS_P_FILL 0x01     // P Fill
#define RFQ_EXECUTION_REPORT_ORDER_STATUS_FILL 0x02       // Fill
#define RFQ_EXECUTION_REPORT_ORDER_STATUS_CANCELLED 0x04  // Cancelled
#define RFQ_EXECUTION_REPORT_ORDER_STATUS_EXPIRED 0x06    // Expired

// Contra Order Book: one byte code
#define CONTRA_ORDER_BOOK_REGULAR 0x01  // Regular

// ---- Types -------------------------------------------------------------------

// Allows the client and server to establish a session.
typedef struct _LogonMessage {
  UINT8 user_name[25];     // bytes 0 to 24
  UINT8 password[25];      // bytes 25 to 49
  UINT8 new_password[25];  // bytes 50 to 74
  UINT8 message_version;   // byte 75
} LogonMessage;

// Allows the server to acknowledge a client's Logon.
typedef struct _LogonReplyMessage {
  UINT32 reject_code;                   // bytes 0 to 3, signed, read here as unsigned
  UINT8 password_expiry_day_count[30];  // bytes 4 to 33
} LogonReplyMessage;

// Allows the client and server to terminate a session.
typedef struct _LogoutMessage {
  UINT8 reason[20];  // bytes 0 to 19
} LogoutMessage;

// Allows the client to subscribe to missed messages through the Recovery Channel.
typedef struct _MissedMessageRequestMessage {
  UINT8 app_id;             // byte 0
  UINT32 last_msg_seq_num;  // bytes 1 to 4, signed, read here as unsigned
} MissedMessageRequestMessage;

// Allows the server to acknowledge a client's Missed Message Request.
typedef struct _MissedMessageRequestAckMessage {
  UINT8 missed_message_request_ack_response_type;  // byte 0
} MissedMessageRequestAckMessage;

// Allows the server to communicate the result of a Missed Message Request.
typedef struct _MissedMessageReportMessage {
  UINT8 missed_message_report_response_type;  // byte 0
} MissedMessageReportMessage;

// Used to reject a message that does not comply with the Native Trading Gateway messaging protocol.
typedef struct _RejectMessage {
  UINT32 reject_code;           // bytes 0 to 3, signed, read here as unsigned
  UINT8 reject_reason[30];      // bytes 4 to 33
  UINT8 rejected_message_type;  // byte 34
  UINT8 client_order_id[20];    // bytes 35 to 54
} RejectMessage;

// Indicates service non availability of a partition, disseminated on the recovery and realtime channels.
typedef struct _SystemStatusMessage {
  UINT8 app_id;      // byte 0
  UINT8 app_status;  // byte 1
} SystemStatusMessage;

// Composite
typedef struct _TransactTime {
  UINT32 seconds;      // bytes 0 to 3
  UINT32 nanoseconds;  // bytes 4 to 7
} TransactTime;

// Indicates order accepted, rejected, executed, expired, cancelled, cancel/replaced, restated or suspended, or a trade cancel.
typedef struct _ExecutionReportMessage {
  UINT8 app_id;                             // byte 0
  UINT32 sequence_no;                       // bytes 1 to 4, signed, read here as unsigned
  UINT8 execution_id[12];                   // bytes 5 to 16
  UINT8 client_order_id[20];                // bytes 17 to 36
  UINT8 order_id[12];                       // bytes 37 to 48
  UINT8 exec_type;                          // byte 49
  UINT8 execution_report_ref_id[12];        // bytes 50 to 61
  UINT8 execution_report_order_status;      // byte 62
  UINT32 order_reject_code;                 // bytes 63 to 66, signed, read here as unsigned
  UINT64 executed_price;                    // bytes 67 to 74, signed, read here as unsigned
  UINT32 executed_qty;                      // bytes 75 to 78, signed, read here as unsigned
  UINT32 leaves_qty;                        // bytes 79 to 82, signed, read here as unsigned
  UINT8 reserved_bit_0 : 1;                 // byte 83
  UINT8 clse : 1;                           // byte 83
  UINT8 reserved_bit_2 : 1;                 // byte 83
  UINT8 ilqd : 1;                           // byte 83
  UINT8 reserved_bit_4 : 1;                 // byte 83
  UINT8 rfpt : 1;                           // byte 83
  UINT8 reserved_67 : 2;                    // byte 83
  UINT32 display_qty;                       // bytes 84 to 87, signed, read here as unsigned
  UINT32 instrument_id;                     // bytes 88 to 91, signed, read here as unsigned
  UINT8 restatement_reason;                 // byte 92
  UINT8 execution_report_pegged_exec_inst;  // byte 93
  UINT8 side;                               // byte 94
  UINT8 owner_type;                         // byte 95
  UINT8 reserved_7[7];                      // bytes 96 to 102
  UINT8 counterparty[11];                   // bytes 103 to 113
  UINT8 trade_liquidity_indicator;          // byte 114
  UINT64 trade_match_id;                    // bytes 115 to 122
  TransactTime transact_time;               // bytes 123 to 130
  UINT8 last_market;                        // byte 131
  UINT8 type_of_trade;                      // byte 132
  UINT8 capacity;                           // byte 133
  UINT8 reserved_1;                         // byte 134
  UINT8 public_order_id[12];                // bytes 135 to 146
  UINT32 minimum_quantity;                  // bytes 147 to 150, signed, read here as unsigned
} ExecutionReportMessage;

// Indicates that a mass order cancel request was accepted or rejected.
typedef struct _OrderMassCancelReportMessage {
  UINT8 app_id;                      // byte 0
  UINT32 sequence_no;                // bytes 1 to 4, signed, read here as unsigned
  UINT8 client_order_id[20];         // bytes 5 to 24
  UINT8 mass_cancel_response;        // byte 25
  UINT32 mass_cancel_reject_reason;  // bytes 26 to 29, signed, read here as unsigned
  UINT8 reserved_4[4];               // bytes 30 to 33
  TransactTime transact_time;        // bytes 34 to 41
  UINT8 reserved_10[10];             // bytes 42 to 51
} OrderMassCancelReportMessage;

// Carries a Request For Quote. Sent by the Requester to submit an RFQ, and by the server to deliver it to the Market Maker.
typedef struct _QuoteRequestMessage {
  UINT8 partition_id;                        // byte 0
  UINT32 sequence_number;                    // bytes 1 to 4, signed, read here as unsigned
  UINT8 quote_req_id[10];                    // bytes 5 to 14
  UINT8 order_book;                          // byte 15
  UINT8 private_quote;                       // byte 16
  UINT32 instrument_id;                      // bytes 17 to 20, signed, read here as unsigned
  UINT8 side;                                // byte 21
  UINT32 order_quantity;                     // bytes 22 to 25, signed, read here as unsigned
  UINT32 expire_time;                        // bytes 26 to 29
  UINT8 market_makers[60];                   // bytes 30 to 89
  UINT8 contra_trader[11];                   // bytes 90 to 100
  UINT8 contra_firm[11];                     // bytes 101 to 111
  UINT8 rfq_id[10];                          // bytes 112 to 121
  UINT32 client_id;                          // bytes 122 to 125
  UINT32 investment_decision_maker;          // bytes 126 to 129
  UINT32 executing_trader;                   // bytes 130 to 133
  UINT8 dea_flag : 1;                        // byte 134
  UINT8 liquidity_provision : 1;             // byte 134
  UINT8 algo : 1;                            // byte 134
  UINT8 reserved_37 : 5;                     // byte 134
  UINT8 client_id_qualifier : 2;             // byte 135
  UINT8 investor_information_qualifier : 2;  // byte 135
  UINT8 executing_trader_qualifier : 2;      // byte 135
  UINT8 reserved_67 : 2;                     // byte 135
  UINT8 quote_request_type;                  // byte 136
  UINT64 price;                              // bytes 137 to 144, signed, read here as unsigned
  UINT8 rfq_execution_delay;                 // byte 145
  UINT8 rfq_min_quotes;                      // byte 146
  UINT8 account_type;                        // byte 147
  UINT8 order_capacity;                      // byte 148
  UINT8 rfq_disclose_side;                   // byte 149
  UINT32 expire_time_milliseconds;           // bytes 150 to 153
  UINT8 auto_rfq_exec_strategy;              // byte 154
  UINT8 num_of_competitors;                  // byte 155
  UINT8 market_maker_rank;                   // byte 156
} QuoteRequestMessage;

// Allows the server to communicate the status of the RFQ to the Requester.
typedef struct _QuoteStatusReportMessage {
  UINT8 partition_id;               // byte 0
  UINT32 sequence_number;           // bytes 1 to 4, signed, read here as unsigned
  UINT8 quote_msg_id[20];           // bytes 5 to 24
  UINT8 quote_req_id[10];           // bytes 25 to 34
  UINT8 quote_status;               // byte 35
  UINT32 reject_code;               // bytes 36 to 39, signed, read here as unsigned
  UINT8 order_book;                 // byte 40
  UINT8 market_makers[60];          // bytes 41 to 100
  UINT8 rfq_id[10];                 // bytes 101 to 110
  UINT32 expire_time;               // bytes 111 to 114
  UINT8 bid_id[12];                 // bytes 115 to 126
  UINT8 offer_id[12];               // bytes 127 to 138
  UINT32 expire_time_milliseconds;  // bytes 139 to 142
} QuoteStatusReportMessage;

// Rejects an RFQ. Sent by the Market Maker to reject, and by the server to reject or to relay a Market Maker rejection.
typedef struct _QuoteRequestRejectMessage {
  UINT8 partition_id;       // byte 0
  UINT32 sequence_number;   // bytes 1 to 4, signed, read here as unsigned
  UINT8 quote_req_id[10];   // bytes 5 to 14
  UINT32 reject_code;       // bytes 15 to 18, signed, read here as unsigned
  UINT8 order_book;         // byte 19
  UINT32 instrument_id;     // bytes 20 to 23, signed, read here as unsigned
  UINT8 side;               // byte 24
  UINT32 order_quantity;    // bytes 25 to 28, signed, read here as unsigned
  UINT8 market_makers[60];  // bytes 29 to 88
  UINT8 contra_trader[11];  // bytes 89 to 99
  UINT8 rfq_id[10];         // bytes 100 to 109
} QuoteRequestRejectMessage;

// Carries an RFQ Quote. Sent by the Market Maker to accept an RFQ, and by the server to deliver the quote to the Requester.
typedef struct _RfqQuoteMessage {
  UINT8 partition_id;                        // byte 0
  UINT32 sequence_number;                    // bytes 1 to 4, signed, read here as unsigned
  UINT8 quote_msg_id[20];                    // bytes 5 to 24
  UINT8 rfq_id[10];                          // bytes 25 to 34
  UINT32 instrument_id;                      // bytes 35 to 38, signed, read here as unsigned
  UINT64 bid_price;                          // bytes 39 to 46, signed, read here as unsigned
  UINT32 bid_quantity;                       // bytes 47 to 50, signed, read here as unsigned
  UINT64 offer_price;                        // bytes 51 to 58, signed, read here as unsigned
  UINT32 offer_quantity;                     // bytes 59 to 62, signed, read here as unsigned
  UINT8 auto_cancel;                         // byte 63
  UINT8 market_maker[11];                    // bytes 64 to 74
  UINT8 market_maker_firm[11];               // bytes 75 to 85
  UINT8 bid_id[12];                          // bytes 86 to 97
  UINT8 offer_id[12];                        // bytes 98 to 109
  UINT8 capacity;                            // byte 110
  UINT8 clearing_account;                    // byte 111
  UINT32 client_id;                          // bytes 112 to 115
  UINT32 investment_decision_maker;          // bytes 116 to 119
  UINT32 executing_trader;                   // bytes 120 to 123
  UINT8 dea_flag : 1;                        // byte 124
  UINT8 liquidity_provision : 1;             // byte 124
  UINT8 algo : 1;                            // byte 124
  UINT8 reserved_37 : 5;                     // byte 124
  UINT8 client_id_qualifier : 2;             // byte 125
  UINT8 investor_information_qualifier : 2;  // byte 125
  UINT8 executing_trader_qualifier : 2;      // byte 125
  UINT8 reserved_67 : 2;                     // byte 125
} RfqQuoteMessage;

// Allows the server to acknowledge a new or modified RFQ Quote to the Market Maker.
typedef struct _QuoteAckMessage {
  UINT8 partition_id;      // byte 0
  UINT32 sequence_number;  // bytes 1 to 4, signed, read here as unsigned
  UINT8 quote_msg_id[20];  // bytes 5 to 24
  UINT8 rfq_id[10];        // bytes 25 to 34
  UINT8 bid_id[12];        // bytes 35 to 46
  UINT8 offer_id[12];      // bytes 47 to 58
  UINT8 quote_ack_status;  // byte 59
  UINT32 reject_code;      // bytes 60 to 63, signed, read here as unsigned
  UINT8 order_book;        // byte 64
} QuoteAckMessage;

// Carries an RFQ response. Sent by the Requester to execute or cancel an RFQ Quote, and by the server to report quote and RFQ status.
typedef struct _QuoteResponseMessage {
  UINT8 partition_id;      // byte 0
  UINT32 sequence_number;  // bytes 1 to 4, signed, read here as unsigned
  UINT8 quote_msg_id[20];  // bytes 5 to 24
  UINT8 rfq_id[10];        // bytes 25 to 34
  UINT8 quote_resp_type;   // byte 35
  UINT32 instrument_id;    // bytes 36 to 39, signed, read here as unsigned
  UINT8 side;              // byte 40
  UINT32 order_quantity;   // bytes 41 to 44, signed, read here as unsigned
  UINT64 limit_price;      // bytes 45 to 52, signed, read here as unsigned
  UINT8 order_book;        // byte 53
  UINT8 bid_id[12];        // bytes 54 to 65
  UINT8 offer_id[12];      // bytes 66 to 77
  UINT8 capacity;          // byte 78
  UINT8 clearing_account;  // byte 79
  UINT8 reserved_8[8];     // bytes 80 to 87
} QuoteResponseMessage;

// Allows the system to notify the Requester and the Market Maker about a trade or the status of the quote.
typedef struct _RfqExecutionReportMessage {
  UINT8 partition_id;                       // byte 0
  UINT32 sequence_number;                   // bytes 1 to 4, signed, read here as unsigned
  UINT8 execution_id[12];                   // bytes 5 to 16
  UINT8 rfq_id[10];                         // bytes 17 to 26
  UINT8 order_id[12];                       // bytes 27 to 38
  UINT8 execution_type;                     // byte 39
  UINT64 trade_match_id;                    // bytes 40 to 47
  UINT8 side;                               // byte 48
  UINT32 executed_quantity;                 // bytes 49 to 52, signed, read here as unsigned
  UINT64 executed_price;                    // bytes 53 to 60, signed, read here as unsigned
  TransactTime transact_time;               // bytes 61 to 68
  UINT8 reserved_8[8];                      // bytes 69 to 76
  UINT8 second_reserved_8[8];               // bytes 77 to 84
  UINT8 rfq_execution_report_order_status;  // byte 85
  UINT32 leaves_quantity;                   // bytes 86 to 89, signed, read here as unsigned
  UINT32 instrument_id;                     // bytes 90 to 93, signed, read here as unsigned
  UINT8 third_reserved_8[8];                // bytes 94 to 101
  UINT8 fourth_reserved_8[8];               // bytes 102 to 109
  UINT8 contra_firm[11];                    // bytes 110 to 120
  UINT8 capacity;                           // byte 121
  UINT8 clearing_account;                   // byte 122
  UINT8 reserved_02 : 3;                    // byte 123
  UINT8 ilqd : 1;                           // byte 123
  UINT8 reserved_47 : 4;                    // byte 123
  UINT8 execution_report_ref_id[12];        // bytes 124 to 135
  UINT8 contra_order_book;                  // byte 136
  UINT64 avg_px;                            // bytes 137 to 144, signed, read here as unsigned
  UINT8 last_market;                        // byte 145
  UINT8 reserved_7[7];                      // bytes 146 to 152
} RfqExecutionReportMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: LogonMessage logon_message;
    case 0x42: LogonReplyMessage logon_reply_message;
    case 0x35: LogoutMessage logout_message;
    case 0x30: unit heartbeat_message;
    case 0x4D: MissedMessageRequestMessage missed_message_request_message;
    case 0x4E: MissedMessageRequestAckMessage missed_message_request_ack_message;
    case 0x50: MissedMessageReportMessage missed_message_report_message;
    case 0x33: RejectMessage reject_message;
    case 0x6E: SystemStatusMessage system_status_message;
    case 0x38: ExecutionReportMessage execution_report_message;
    case 0x72: OrderMassCancelReportMessage order_mass_cancel_report_message;
    case 0x61: QuoteRequestMessage quote_request_message;
    case 0x63: QuoteStatusReportMessage quote_status_report_message;
    case 0x62: QuoteRequestRejectMessage quote_request_reject_message;
    case 0x64: RfqQuoteMessage rfq_quote_message;
    case 0x65: QuoteAckMessage quote_ack_message;
    case 0x66: QuoteResponseMessage quote_response_message;
    case 0x67: RfqExecutionReportMessage rfq_execution_report_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Native Trading Gateway Message
typedef struct _Message {
  UINT8 start_of_message;                                                                                                                       // byte 0, signed, read here as unsigned
  UINT16 message_length { message_length >= 1 };                                                                                                // bytes 1 to 2, signed, read here as unsigned
  UINT8 message_type;                                                                                                                           // byte 3
  Payload(message_type, ((((UINT32) message_length) + 3) - 4)) payload[:byte-size-single-element-array ((((UINT32) message_length) + 3) - 4)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Native Trading Gateway Tcp Message Block
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

