// ---- Unit Header: 8 bytes ----------------------------------------------------

entrypoint typedef struct _UnitHeader {
  UINT16 length;            // bytes 0 to 1
  UINT8 message_count;      // byte 2
  UINT8 market_data_group;  // byte 3
  UINT32 sequence_number;   // bytes 4 to 7
} UnitHeader;

// ---- Message Header: 2 bytes -------------------------------------------------

// Mitch Tcp Message Header
entrypoint typedef struct _MessageHeader {
  UINT8 message_length;  // byte 0
  UINT8 message_type;    // byte 1
} MessageHeader;

// ---- Login Request Message: 16 bytes -----------------------------------------

// Used by the client to log in to the recovery channel.
entrypoint typedef struct _LoginRequestMessage {
  UINT8 username[6];   // bytes 0 to 5
  UINT8 password[10];  // bytes 6 to 15
} LoginRequestMessage;

// ---- Login Response Message: 1 byte ------------------------------------------

// Used by the server to accept or reject a login request.
entrypoint typedef struct _LoginResponseMessage {
  UINT8 login_status;  // byte 0
} LoginResponseMessage;

// ---- Snapshot Request Message: 14 bytes --------------------------------------

// Used by the client to request a snapshot of the order book for a segment or an instrument.
entrypoint typedef struct _SnapshotRequestMessage {
  UINT32 sequence_number;  // bytes 0 to 3
  UINT8 segment[6];        // bytes 4 to 9
  UINT32 instrument_id;    // bytes 10 to 13
} SnapshotRequestMessage;

// ---- Snapshot Response Message: 9 bytes --------------------------------------

// Used by the server to accept or reject a snapshot request.
entrypoint typedef struct _SnapshotResponseMessage {
  UINT32 sequence_number;  // bytes 0 to 3
  UINT32 order_count;      // bytes 4 to 7
  UINT8 snapshot_status;   // byte 8
} SnapshotResponseMessage;

// ---- Time Message: 4 bytes ---------------------------------------------------

// Sent by the server for every second for which at least one application message is generated.
entrypoint typedef struct _TimeMessage {
  UINT32 seconds;  // bytes 0 to 3
} TimeMessage;

