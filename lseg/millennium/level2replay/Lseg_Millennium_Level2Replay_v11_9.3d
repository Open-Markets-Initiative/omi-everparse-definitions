// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Lseg_Millennium_Level2Replay_v11_9.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_LOGIN_REQUEST_MESSAGE 0x01                   // Login Request Message
#define MESSAGE_TYPE_LOGIN_RESPONSE_MESSAGE 0x02                  // Login Response Message
#define MESSAGE_TYPE_REPLAY_REQUEST_MESSAGE 0x03                  // Replay Request Message
#define MESSAGE_TYPE_REPLAY_RESPONSE_MESSAGE 0x04                 // Replay Response Message
#define MESSAGE_TYPE_LOGOUT_REQUEST_MESSAGE 0x05                  // Logout Request Message
#define MESSAGE_TYPE_TIME_MESSAGE 0x54                            // Time Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                    // System Event Message
#define MESSAGE_TYPE_SYMBOL_DIRECTORY_MESSAGE 0x52                // Symbol Directory Message
#define MESSAGE_TYPE_SYMBOL_STATUS_MESSAGE 0x48                   // Symbol Status Message
#define MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x41                       // Add Order Message
#define MESSAGE_TYPE_ADD_ATTRIBUTED_ORDER_MESSAGE 0x46            // Add Attributed Order Message
#define MESSAGE_TYPE_ORDER_DELETED_MESSAGE 0x44                   // Order Deleted Message
#define MESSAGE_TYPE_ORDER_MODIFIED_MESSAGE 0x55                  // Order Modified Message
#define MESSAGE_TYPE_ORDER_BOOK_CLEAR_MESSAGE 0x79                // Order Book Clear Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45                  // Order Executed Message
#define MESSAGE_TYPE_ORDER_EXECUTED_WITH_PRICE_SIZE_MESSAGE 0x43  // Order Executed With Price Size Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x50                           // Trade Message
#define MESSAGE_TYPE_AUCTION_TRADE_MESSAGE 0x51                   // Auction Trade Message
#define MESSAGE_TYPE_AUCTION_INFO_MESSAGE 0x49                    // Auction Info Message
#define MESSAGE_TYPE_STATISTICS_MESSAGE 0x77                      // Statistics Message
#define MESSAGE_TYPE_TOP_OF_BOOK_MESSAGE 0x71                     // Top Of Book Message

// Login Status: one byte code
#define LOGIN_STATUS_LOGIN_ACCEPTED 0x41            // Login Accepted
#define LOGIN_STATUS_COMP_ID_INACTIVE_LOCKED 0x61   // Comp Id Inactive Locked
#define LOGIN_STATUS_LOGIN_LIMIT_REACHED 0x62       // Login Limit Reached
#define LOGIN_STATUS_SERVICE_UNAVAILABLE 0x63       // Service Unavailable
#define LOGIN_STATUS_CONCURRENT_LIMIT_REACHED 0x64  // Concurrent Limit Reached
#define LOGIN_STATUS_FAILED_OTHER 0x65              // Failed Other

// Replay Status: one byte code
#define REPLAY_STATUS_REQUEST_ACCEPTED 0x41           // Request Accepted
#define REPLAY_STATUS_REQUEST_LIMIT_REACHED 0x44      // Request Limit Reached
#define REPLAY_STATUS_INVALID_MARKET_DATA_GROUP 0x49  // Invalid Market Data Group
#define REPLAY_STATUS_OUT_OF_RANGE 0x4F               // Out Of Range
#define REPLAY_STATUS_REPLAY_UNAVAILABLE 0x55         // Replay Unavailable
#define REPLAY_STATUS_UNSUPPORTED_MESSAGE_TYPE 0x64   // Unsupported Message Type
#define REPLAY_STATUS_FAILED_OTHER 0x65               // Failed Other
#define REPLAY_STATUS_CONCURRENT_LIMIT_REACHED 0x63   // Concurrent Limit Reached

// Event Code: one byte code
#define EVENT_CODE_END_OF_DAY 0x43    // End Of Day
#define EVENT_CODE_START_OF_DAY 0x4F  // Start Of Day

// Symbol Status: one byte code
#define SYMBOL_STATUS_ACTIVE 0x20     // Active
#define SYMBOL_STATUS_SUSPENDED 0x53  // Suspended
#define SYMBOL_STATUS_INACTIVE 0x61   // Inactive
#define SYMBOL_STATUS_HALT 0x48       // Halt

// Trading Status: one byte code
#define TRADING_STATUS_ACTIVE 0x20                                    // Active
#define TRADING_STATUS_HALT 0x48                                      // Halt
#define TRADING_STATUS_REGULAR_TRADING_START_OF_TRADE_REPORTING 0x54  // Regular Trading Start Of Trade Reporting
#define TRADING_STATUS_OPENING_FIRST_AUCTION_CALL 0x61                // Opening First Auction Call
#define TRADING_STATUS_POST_CLOSE 0x62                                // Post Close
#define TRADING_STATUS_MARKET_CLOSE_SYSTEM_SHUTDOWN 0x63              // Market Close System Shutdown
#define TRADING_STATUS_CLOSING_AUCTION_CALL 0x64                      // Closing Auction Call
#define TRADING_STATUS_AESP_AUCTION_CALL 0x65                         // Aesp Auction Call
#define TRADING_STATUS_RESUME_AUCTION_CALL 0x66                       // Resume Auction Call
#define TRADING_STATUS_PAUSE 0x6C                                     // Pause
#define TRADING_STATUS_PRE_MANDATORY 0x6D                             // Pre Mandatory
#define TRADING_STATUS_MANDATORY 0x6E                                 // Mandatory
#define TRADING_STATUS_POST_MANDATORY 0x6F                            // Post Mandatory
#define TRADING_STATUS_EDSP_AUCTION_CALL 0x71                         // Edsp Auction Call
#define TRADING_STATUS_PERIODIC_AUCTION_CALL 0x72                     // Periodic Auction Call
#define TRADING_STATUS_END_TRADE_REPORTING 0x74                       // End Trade Reporting
#define TRADING_STATUS_NO_ACTIVE_SESSION 0x77                         // No Active Session
#define TRADING_STATUS_END_OF_POST_CLOSE 0x78                         // End Of Post Close
#define TRADING_STATUS_CLOSING_PRICE_CROSSING 0x75                    // Closing Price Crossing
#define TRADING_STATUS_SCHEDULED_LEVEL_1_ONLY_AUCTION 0x47            // Scheduled Level 1 Only Auction

// Session Change Reason: one byte code
#define SESSION_CHANGE_REASON_SCHEDULED_TRANSITION 0x00               // Scheduled Transition
#define SESSION_CHANGE_REASON_EXTENDED_BY_MARKET_OPS 0x01             // Extended By Market Ops
#define SESSION_CHANGE_REASON_SHORTENED_BY_MARKET_OPS 0x02            // Shortened By Market Ops
#define SESSION_CHANGE_REASON_MARKET_ORDER_IMBALANCE 0x03             // Market Order Imbalance
#define SESSION_CHANGE_REASON_PRICE_OUTSIDE_RANGE 0x04                // Price Outside Range
#define SESSION_CHANGE_REASON_UNAVAILABLE_RECOVERY_SERVICE_ONLY 0x09  // Unavailable Recovery Service Only

// Book Type: one byte code
#define BOOK_TYPE_ON_BOOK 0x01      // On Book
#define BOOK_TYPE_OFF_BOOK 0x02     // Off Book
#define BOOK_TYPE_PRIVATE_RFQ 0x03  // Private Rfq

// Side: one byte code
#define SIDE_BUY_ORDER 0x42   // Buy Order
#define SIDE_SELL_ORDER 0x53  // Sell Order

// Printable: one byte code
#define PRINTABLE_NON_PRINTABLE 0x4E  // Non Printable
#define PRINTABLE_PRINTABLE 0x59      // Printable

// Cross Type: one byte code
#define CROSS_TYPE_INTERNAL_CROSS 0x05   // Internal Cross
#define CROSS_TYPE_INTERNAL_BTF 0x06     // Internal Btf
#define CROSS_TYPE_COMMITTED_CROSS 0x07  // Committed Cross
#define CROSS_TYPE_COMMITTED_BTF 0x08    // Committed Btf

// Sub Book: one byte code
#define SUB_BOOK_REGULAR_TRADES 0x00  // Regular Trades
#define SUB_BOOK_RFQ_TRADES 0x0B      // Rfq Trades

// Auction Type: one byte code
#define AUCTION_TYPE_CLOSING_AUCTION 0x43                 // Closing Auction
#define AUCTION_TYPE_OPENING_AUCTION 0x4F                 // Opening Auction
#define AUCTION_TYPE_AESP 0x41                            // Aesp
#define AUCTION_TYPE_EDSP 0x42                            // Edsp
#define AUCTION_TYPE_RESUME_AUCTION 0x45                  // Resume Auction
#define AUCTION_TYPE_PERIODIC_AUCTION 0x46                // Periodic Auction
#define AUCTION_TYPE_SCHEDULED_LEVEL_1_ONLY_AUCTION 0x47  // Scheduled Level 1 Only Auction

// Statistic Type: one byte code
#define STATISTIC_TYPE_OPENING_PRICE 0x4F  // Opening Price
#define STATISTIC_TYPE_CLOSING_PRICE 0x43  // Closing Price

// Open Close Price Indicator: one byte code
#define OPEN_CLOSE_PRICE_INDICATOR_UT 0x41                           // Ut
#define OPEN_CLOSE_PRICE_INDICATOR_AT 0x42                           // At
#define OPEN_CLOSE_PRICE_INDICATOR_MID_OF_BBO 0x43                   // Mid Of Bbo
#define OPEN_CLOSE_PRICE_INDICATOR_LAST_AT 0x44                      // Last At
#define OPEN_CLOSE_PRICE_INDICATOR_LAST_UT 0x45                      // Last Ut
#define OPEN_CLOSE_PRICE_INDICATOR_MANUAL 0x46                       // Manual
#define OPEN_CLOSE_PRICE_INDICATOR_DERIVED_FROM_PREVIOUS_CLOSE 0x49  // Derived From Previous Close

// ---- Types -------------------------------------------------------------------

// Used by the client to log in to the replay channel.
typedef struct _LoginRequestMessage {
  UINT8 username[6];   // bytes 0 to 5
  UINT8 password[10];  // bytes 6 to 15
} LoginRequestMessage;

// Used by the server to accept or reject a login request.
typedef struct _LoginResponseMessage {
  UINT8 login_status;  // byte 0
} LoginResponseMessage;

// Used by the client to request the retransmission of messages published on the multicast channel.
typedef struct _ReplayRequestMessage {
  UINT8 market_data_group;  // byte 0
  UINT32 first_message;     // bytes 1 to 4
  UINT16 count;             // bytes 5 to 6
} ReplayRequestMessage;

// Used by the server to accept or reject a replay request.
typedef struct _ReplayResponseMessage {
  UINT8 market_data_group;  // byte 0
  UINT32 first_message;     // bytes 1 to 4
  UINT16 count;             // bytes 5 to 6
  UINT8 replay_status;      // byte 7
} ReplayResponseMessage;

// Sent by the server for every second for which at least one application message is generated.
typedef struct _TimeMessage {
  UINT32 seconds;  // bytes 0 to 3
} TimeMessage;

// Sent to indicate the start and end of the day.
typedef struct _SystemEventMessage {
  UINT32 nanosecond;  // bytes 0 to 3
  UINT8 event_code;   // byte 4
} SystemEventMessage;

// Used to disseminate information (symbol, segment, ISIN, underlying, etc.) on each instrument
typedef struct _SymbolDirectoryMessage {
  UINT32 nanosecond;            // bytes 0 to 3
  UINT32 instrument_id;         // bytes 4 to 7
  UINT8 reserved_a;             // byte 8
  UINT8 reserved_b;             // byte 9
  UINT8 symbol_status;          // byte 10
  UINT8 isin[12];               // bytes 11 to 22
  UINT8 sedol[12];              // bytes 23 to 34
  UINT8 segment[6];             // bytes 35 to 40
  UINT8 underlying[6];          // bytes 41 to 46
  UINT8 currency[3];            // bytes 47 to 49
  UINT8 reserved_byte;          // byte 50
  UINT8 reserved_4[4];          // bytes 51 to 54
  UINT64 previous_close_price;  // bytes 55 to 62, signed, read here as unsigned
} SymbolDirectoryMessage;

// Indicates the trading session (pre-opening, regular trading, etc.) that currently applies to an instrument.
typedef struct _SymbolStatusMessage {
  UINT32 nanosecond;            // bytes 0 to 3
  UINT32 instrument_id;         // bytes 4 to 7
  UINT8 reserved_a;             // byte 8
  UINT8 reserved_b;             // byte 9
  UINT8 trading_status;         // byte 10
  UINT8 unused_5 : 5;           // byte 11
  UINT8 firm_quote : 1;         // byte 11
  UINT8 unused_2 : 2;           // byte 11
  UINT8 reason[4];              // bytes 12 to 15
  UINT8 session_change_reason;  // byte 16
  UINT8 new_end_time[8];        // bytes 17 to 24
  UINT8 book_type;              // byte 25
} SymbolStatusMessage;

// Sent to indicate that an anonymous limit or market order is added to the order book.
typedef struct _AddOrderMessage {
  UINT32 nanosecond;          // bytes 0 to 3
  UINT64 order_id;            // bytes 4 to 11
  UINT8 side;                 // byte 12
  UINT32 quantity;            // bytes 13 to 16
  UINT32 instrument_id;       // bytes 17 to 20
  UINT8 reserved_a;           // byte 21
  UINT8 reserved_b;           // byte 22
  UINT64 price;               // bytes 23 to 30, signed, read here as unsigned
  UINT8 unused_4 : 4;         // byte 31
  UINT8 market_order : 1;     // byte 31
  UINT8 unused_1 : 1;         // byte 31
  UINT8 private_rfq : 1;      // byte 31
  UINT8 second_unused_1 : 1;  // byte 31
  UINT8 reserved_10[10];      // bytes 32 to 41
} AddOrderMessage;

// Indicates that a named order is added to the order book.
typedef struct _AddAttributedOrderMessage {
  UINT32 nanosecond;             // bytes 0 to 3
  UINT64 order_id;               // bytes 4 to 11
  UINT8 side;                    // byte 12
  UINT32 quantity;               // bytes 13 to 16
  UINT32 instrument_id;          // bytes 17 to 20
  UINT8 reserved_a;              // byte 21
  UINT8 reserved_b;              // byte 22
  UINT64 price;                  // bytes 23 to 30, signed, read here as unsigned
  UINT8 attribution[11];         // bytes 31 to 41
  UINT8 unused_4 : 4;            // byte 42
  UINT8 named_market_order : 1;  // byte 42
  UINT8 firm_quote : 1;          // byte 42
  UINT8 unused_2 : 2;            // byte 42
} AddAttributedOrderMessage;

// Sent to indicate that the remainder of a displayed order is cancelled.
typedef struct _OrderDeletedMessage {
  UINT32 nanosecond;     // bytes 0 to 3
  UINT64 order_id;       // bytes 4 to 11
  UINT8 unused_5 : 5;    // byte 12
  UINT8 firm_quote : 1;  // byte 12
  UINT8 unused_2 : 2;    // byte 12
  UINT32 instrument_id;  // bytes 13 to 16
} OrderDeletedMessage;

// Indicates that the displayed quantity or price of a displayed order has been updated.
typedef struct _OrderModifiedMessage {
  UINT32 nanosecond;        // bytes 0 to 3
  UINT64 order_id;          // bytes 4 to 11
  UINT32 new_quantity;      // bytes 12 to 15
  UINT64 new_price;         // bytes 16 to 23, signed, read here as unsigned
  UINT8 priority_flag : 1;  // byte 24
  UINT8 unused_4 : 4;       // byte 24
  UINT8 firm_quote : 1;     // byte 24
  UINT8 unused_2 : 2;       // byte 24
} OrderModifiedMessage;

// Sent to instruct recipients to remove all orders from the order book for the specified instrument.
typedef struct _OrderBookClearMessage {
  UINT32 nanosecond;      // bytes 0 to 3
  UINT32 instrument_id;   // bytes 4 to 7
  UINT8 reserved_a;       // byte 8
  UINT8 reserved_b;       // byte 9
  UINT8 unused_5 : 5;     // byte 10
  UINT8 firm_quote : 1;   // byte 10
  UINT8 private_rfq : 1;  // byte 10
  UINT8 unused_1 : 1;     // byte 10
} OrderBookClearMessage;

// Indicates that the displayed portion of an order is fully or partially filled at its displayed price.
typedef struct _OrderExecutedMessage {
  UINT32 nanosecond;         // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT32 executed_quantity;  // bytes 12 to 15
  UINT64 trade_match_id;     // bytes 16 to 23
} OrderExecutedMessage;

// Sent if a displayed order is fully or partially filled at a price that is different from its displayed price.
typedef struct _OrderExecutedWithPriceSizeMessage {
  UINT32 nanosecond;         // bytes 0 to 3
  UINT64 order_id;           // bytes 4 to 11
  UINT32 executed_quantity;  // bytes 12 to 15
  UINT32 display_quantity;   // bytes 16 to 19
  UINT64 trade_match_id;     // bytes 20 to 27
  UINT8 printable;           // byte 28
  UINT64 price;              // bytes 29 to 36, signed, read here as unsigned
} OrderExecutedWithPriceSizeMessage;

// Sent if a non-display order is fully or partially filled.
typedef struct _TradeMessage {
  UINT32 nanosecond;         // bytes 0 to 3
  UINT32 executed_quantity;  // bytes 4 to 7
  UINT32 instrument_id;      // bytes 8 to 11
  UINT8 reserved_a;          // byte 12
  UINT8 reserved_b;          // byte 13
  UINT64 price;              // bytes 14 to 21, signed, read here as unsigned
  UINT64 trade_match_id;     // bytes 22 to 29
  UINT8 cross_type;          // byte 30
  UINT8 sub_book;            // byte 31
  UINT8 canc : 1;            // byte 32
  UINT8 amnd : 1;            // byte 32
  UINT8 unused_6 : 6;        // byte 32
} TradeMessage;

// Sent to report details of an auction
typedef struct _AuctionTradeMessage {
  UINT32 nanosecond;      // bytes 0 to 3
  UINT32 quantity;        // bytes 4 to 7
  UINT32 instrument_id;   // bytes 8 to 11
  UINT8 reserved_a;       // byte 12
  UINT8 reserved_b;       // byte 13
  UINT64 price;           // bytes 14 to 21, signed, read here as unsigned
  UINT64 trade_match_id;  // bytes 22 to 29
  UINT8 auction_type;     // byte 30
  UINT8 canc : 1;         // byte 31
  UINT8 amnd : 1;         // byte 31
  UINT8 unused_6 : 6;     // byte 31
} AuctionTradeMessage;

// 9 Used to disseminate the indicative auction price and the tradable quantity and imbalance at this price.
typedef struct _AuctionInfoMessage {
  UINT32 nanosecond;       // bytes 0 to 3
  UINT32 paired_quantity;  // bytes 4 to 7
  UINT8 reserved_4[4];     // bytes 8 to 11
  UINT8 reserved_1;        // byte 12
  UINT32 instrument_id;    // bytes 13 to 16
  UINT8 reserved_a;        // byte 17
  UINT8 reserved_b;        // byte 18
  UINT64 price;            // bytes 19 to 26, signed, read here as unsigned
  UINT8 auction_type;      // byte 27
} AuctionInfoMessage;

// Used to disseminate official Opening and Closing prices
typedef struct _StatisticsMessage {
  UINT32 nanosecond;                 // bytes 0 to 3
  UINT32 instrument_id;              // bytes 4 to 7
  UINT8 reserved_a;                  // byte 8
  UINT8 reserved_b;                  // byte 9
  UINT8 statistic_type;              // byte 10
  UINT64 price;                      // bytes 11 to 18, signed, read here as unsigned
  UINT8 open_close_price_indicator;  // byte 19
  UINT8 unused_8 : 8;                // byte 20
} StatisticsMessage;

// Used to disseminate top of book changes when the instrument is in a scheduled level 1 only auction.
typedef struct _TopOfBookMessage {
  UINT32 nanosecond;        // bytes 0 to 3
  UINT32 instrument_id;     // bytes 4 to 7
  UINT64 buy_limit_price;   // bytes 8 to 15, signed, read here as unsigned
  UINT32 buy_limit_size;    // bytes 16 to 19
  UINT64 sell_limit_price;  // bytes 20 to 27, signed, read here as unsigned
  UINT32 sell_limit_size;   // bytes 28 to 31
} TopOfBookMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: LoginRequestMessage login_request_message;
    case 0x02: LoginResponseMessage login_response_message;
    case 0x03: ReplayRequestMessage replay_request_message;
    case 0x04: ReplayResponseMessage replay_response_message;
    case 0x05: unit logout_request_message;
    case 0x54: TimeMessage time_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x52: SymbolDirectoryMessage symbol_directory_message;
    case 0x48: SymbolStatusMessage symbol_status_message;
    case 0x41: AddOrderMessage add_order_message;
    case 0x46: AddAttributedOrderMessage add_attributed_order_message;
    case 0x44: OrderDeletedMessage order_deleted_message;
    case 0x55: OrderModifiedMessage order_modified_message;
    case 0x79: OrderBookClearMessage order_book_clear_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceSizeMessage order_executed_with_price_size_message;
    case 0x50: TradeMessage trade_message;
    case 0x51: AuctionTradeMessage auction_trade_message;
    case 0x49: AuctionInfoMessage auction_info_message;
    case 0x77: StatisticsMessage statistics_message;
    case 0x71: TopOfBookMessage top_of_book_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT8 message_length { message_length >= 2 };                                                                                                                    // byte 0
  UINT8 message_type;                                                                                                                                              // byte 1
  Payload(message_type, (((UINT32) message_length) - 2)) payload[:byte-size-single-element-array (((UINT32) message_length) - 2)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// One unit on the tcp stream: the unit header and its payload messages
typedef struct _TcpUnit (mutable UINT32 * tally) {
  UINT16 length { length >= 8 };                                                                                            // bytes 0 to 1
  UINT8 message_count;                                                                                                      // byte 2
  UINT8 market_data_group;                                                                                                  // byte 3
  UINT32 sequence_number;                                                                                                   // bytes 4 to 7
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (((UINT32) length) - 8)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} TcpUnit;

// ---- Packet: Packet ----------------------------------------------------------

// Mitch Tcp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) {
  TcpUnit(tally) tcp_unit[:byte-size available];
} Packet;

