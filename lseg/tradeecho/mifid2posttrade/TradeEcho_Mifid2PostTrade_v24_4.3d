// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out TradeEcho_Mifid2PostTrade_v24_4.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53           // System Event Message
#define MESSAGE_TYPE_INSTRUMENT_DIRECTORY_MESSAGE 0x70   // Instrument Directory Message
#define MESSAGE_TYPE_INSTRUMENT_STATUS_MESSAGE 0x48      // Instrument Status Message
#define MESSAGE_TYPE_STATISTICS_MESSAGE 0x77             // Statistics Message
#define MESSAGE_TYPE_MIFID_II_TRADE_REPORT_MESSAGE 0x54  // Mifid Ii Trade Report Message

// Event Code: one byte code
#define EVENT_CODE_START_OF_OPEN 0x54       // Start Of Open
#define EVENT_CODE_START_OF_PRE_CLOSE 0x50  // Start Of Pre Close

// Source Venue: 2 byte code
#define SOURCE_VENUE_TRADE_ECHO 0x000B  // Trade Echo

// Trading Status: one byte code
#define TRADING_STATUS_INACTIVE_OR_UNDERLYING_SUSPENDED 0x31  // Inactive Or Underlying Suspended
#define TRADING_STATUS_SUSPENDED 0x32                         // Suspended
#define TRADING_STATUS_ACTIVE 0x33                            // Active
#define TRADING_STATUS_REGULATORY_HALT 0x50                   // Regulatory Halt

// Session Change Reason: one byte code
#define SESSION_CHANGE_REASON_SCHEDULED_TRANSITION 0x00  // Scheduled Transition

// Order Book Type: one byte code
#define ORDER_BOOK_TYPE_SI_QUOTE_BOOK 0x01  // Si Quote Book
#define ORDER_BOOK_TYPE_OFF_BOOK 0x02       // Off Book

// Venue Type: one byte code
#define VENUE_TYPE_UNSPECIFIED 0x00       // Unspecified
#define VENUE_TYPE_MTF 0x01               // Mtf
#define VENUE_TYPE_OTF 0x02               // Otf
#define VENUE_TYPE_REGULATED_MARKET 0x03  // Regulated Market

// Venue Book Definition Id: one byte code
#define VENUE_BOOK_DEFINITION_ID_UNSPECIFIED 0x00  // Unspecified
#define VENUE_BOOK_DEFINITION_ID_OFF_BOOK 0x01     // Off Book

// Transaction To Be Cleared: one byte code
#define TRANSACTION_TO_BE_CLEARED_NO 0x30   // No
#define TRANSACTION_TO_BE_CLEARED_YES 0x31  // Yes

// Market Mechanism: one byte code
#define MARKET_MECHANISM_OFF_BOOK 0x34  // Off Book

// Trading Mode: one byte code
#define TRADING_MODE_ON_EXCHANGE 0x35            // On Exchange
#define TRADING_MODE_OFF_EXCHANGE 0x36           // Off Exchange
#define TRADING_MODE_SYSTEMIC_INTERNALISER 0x37  // Systemic Internaliser

// Transaction Category: one byte code
#define TRANSACTION_CATEGORY_TRADE_THAT_HAS_RECEIVED_PRICE_IMPROVEMENT 0x52                 // Trade That Has Received Price Improvement
#define TRANSACTION_CATEGORY_PACKAGE_TRADE_EXCLUDING_EXCHANGE_FOR_PHYSICALS 0x5A            // Package Trade Excluding Exchange For Physicals
#define TRANSACTION_CATEGORY_EXCHANGE_FOR_PHYSICALS_TRADE 0x59                              // Exchange For Physicals Trade
#define TRANSACTION_CATEGORY_RFMD_GIVE_UP_TRADE 0x47                                        // Rfmd Give Up Trade
#define TRANSACTION_CATEGORY_RFMD_GIVE_UP_TRADE_GIVE_AND_EXCHANGE_FOR_PHYSICALS_TRADE 0x48  // Rfmd Give Up Trade Give And Exchange For Physicals Trade
#define TRANSACTION_CATEGORY_NONE 0x2D                                                      // None

// Negotiation Indicator: one byte code
#define NEGOTIATION_INDICATOR_NEGOTIATED_TRADE_IN_LIQUID_FINANCIAL_INSTRUMENTS 0x31                            // Negotiated Trade In Liquid Financial Instruments
#define NEGOTIATION_INDICATOR_NEGOTIATED_TRADE_IN_ILLIQUID_FINANCIAL_INSTRUMENTS 0x32                          // Negotiated Trade In Illiquid Financial Instruments
#define NEGOTIATION_INDICATOR_NEGOTIATED_TRADE_SUBJECT_TO_CONDITIONS_OTHER_THAN_THE_CURRENT_MARKET_PRICE 0x33  // Negotiated Trade Subject To Conditions Other Than The Current Market Price
#define NEGOTIATION_INDICATOR_NEGOTIATED_TRADE_LARGER_THAN_LIS_BROUGHT_ONTO_A_VENUE 0x37                       // Negotiated Trade Larger Than Lis Brought Onto A Venue
#define NEGOTIATION_INDICATOR_NEGOTIATED_TRADE_WITH_PRE_TRADE_TRANSPARENCY_WAIVER 0x38                         // Negotiated Trade With Pre Trade Transparency Waiver
#define NEGOTIATION_INDICATOR_NOT_A_NEGOTIATED_TRADE 0x2D                                                      // Not A Negotiated Trade

// Agency Cross Indicator: one byte code
#define AGENCY_CROSS_INDICATOR_AGENCY_CROSS_TRADE 0x58     // Agency Cross Trade
#define AGENCY_CROSS_INDICATOR_NO_AGENCY_CROSS_TRADE 0x2D  // No Agency Cross Trade

// Modification Indicator: one byte code
#define MODIFICATION_INDICATOR_TRADE_CANCELLATION 0x43  // Trade Cancellation
#define MODIFICATION_INDICATOR_TRADE_AMENDMENT 0x41     // Trade Amendment
#define MODIFICATION_INDICATOR_NEW_TRADE 0x2D           // New Trade

// ---- Types -------------------------------------------------------------------

// Session transition is advertised via one system event message for all instruments allocated to the same multicast channel
typedef struct _SystemEventMessage {
  UINT64 timestamp;     // bytes 0 to 7
  UINT8 event_code;     // byte 8
  UINT16 source_venue;  // bytes 9 to 10
} SystemEventMessage;

// Used to disseminate a common and limited set of data for all configured instrument types (except strategy instruments) on the real time channels
typedef struct _InstrumentDirectoryMessage {
  UINT64 timestamp;                           // bytes 0 to 7
  UINT64 instrument;                          // bytes 8 to 15
  UINT8 isin[12];                             // bytes 16 to 27
  UINT8 unused_1 : 1;                         // byte 28
  UINT8 si_quote_book : 1;                    // byte 28
  UINT8 off_book : 1;                         // byte 28
  UINT8 unused_5 : 5;                         // byte 28
  UINT16 source_venue;                        // bytes 29 to 30
  UINT8 venue_instrument_id[11];              // bytes 31 to 41
  UINT8 tick_id[2];                           // bytes 42 to 43
  UINT64 price_band_tolerances;               // bytes 44 to 51, signed, read here as unsigned
  UINT64 dynamic_circuit_breaker_tolerances;  // bytes 52 to 59, signed, read here as unsigned
  UINT64 static_circuit_breaker_tolerances;   // bytes 60 to 67, signed, read here as unsigned
  UINT8 segment[6];                           // bytes 68 to 73
  UINT8 reserved_12[12];                      // bytes 74 to 85
  UINT8 reserved_11[11];                      // bytes 86 to 96
  UINT8 currency[3];                          // bytes 97 to 99
  UINT8 reserved_1;                           // byte 100
  UINT8 reserved_4[4];                        // bytes 101 to 104
  UINT64 average_daily_turnover;              // bytes 105 to 112, signed, read here as unsigned
  UINT8 reserved_8[8];                        // bytes 113 to 120
  UINT8 second_reserved_1;                    // byte 121
  UINT8 second_reserved_8[8];                 // bytes 122 to 129
  UINT8 third_reserved_8[8];                  // bytes 130 to 137
} InstrumentDirectoryMessage;

// A specific instrument be subject to individual status change
typedef struct _InstrumentStatusMessage {
  UINT64 timestamp;             // bytes 0 to 7
  UINT64 instrument;            // bytes 8 to 15
  UINT16 source_venue;          // bytes 16 to 17
  UINT8 trading_status;         // byte 18
  UINT8 session_change_reason;  // byte 19
  UINT8 new_end_time[6];        // bytes 20 to 25
  UINT8 order_book_type;        // byte 26
} InstrumentStatusMessage;

// Contains a set of statistics that are updated frequently, usually as a result of executions
typedef struct _StatisticsMessage {
  UINT64 timestamp;                      // bytes 0 to 7
  UINT64 instrument;                     // bytes 8 to 15
  UINT16 source_venue;                   // bytes 16 to 17
  UINT64 volume;                         // bytes 18 to 25
  UINT64 volume_on_book_only;            // bytes 26 to 33
  UINT64 vwap;                           // bytes 34 to 41, signed, read here as unsigned
  UINT64 vwap_on_book_only;              // bytes 42 to 49, signed, read here as unsigned
  UINT32 number_of_trades;               // bytes 50 to 53
  UINT32 number_of_trades_on_book_only;  // bytes 54 to 57
  UINT64 turnover;                       // bytes 58 to 65, signed, read here as unsigned
  UINT64 turnover_on_book_only;          // bytes 66 to 73, signed, read here as unsigned
} StatisticsMessage;

// Sent to report the MiFID compliant details of a privately negotiated trade
typedef struct _MifidIiTradeReportMessage {
  UINT64 timestamp;                                   // bytes 0 to 7
  UINT64 instrument;                                  // bytes 8 to 15
  UINT8 transaction_identification_code[52];          // bytes 16 to 67
  UINT32 total_number_of_transactions;                // bytes 68 to 71
  UINT8 reserved_8[8];                                // bytes 72 to 79
  UINT16 source_venue;                                // bytes 80 to 81
  UINT8 mi_fid_price[20];                             // bytes 82 to 101
  UINT8 mi_fid_quantity[20];                          // bytes 102 to 121
  UINT8 mi_fid_trading_date_and_time[27];             // bytes 122 to 148
  UINT8 instrument_identification_code_type[4];       // bytes 149 to 152
  UINT8 instrument_identification_code[12];           // bytes 153 to 164
  UINT8 price_notation[4];                            // bytes 165 to 168
  UINT8 price_currency[3];                            // bytes 169 to 171
  UINT8 notional_amount[20];                          // bytes 172 to 191
  UINT8 notional_currency[3];                         // bytes 192 to 194
  UINT8 venue_of_execution[4];                        // bytes 195 to 198
  UINT8 publication_date_and_time[27];                // bytes 199 to 225
  UINT8 benchmark_transaction_flag[4];                // bytes 226 to 229
  UINT8 agency_cross_trade_flag[4];                   // bytes 230 to 233
  UINT8 non_price_forming_transactions_flag[4];       // bytes 234 to 237
  UINT8 non_price_contribution_to_discovery[4];       // bytes 238 to 241
  UINT8 special_dividend_flag[4];                     // bytes 242 to 245
  UINT8 pt_deferral_reason_flag[4];                   // bytes 246 to 249
  UINT8 reference_price_transaction_flag[4];          // bytes 250 to 253
  UINT8 nt_liquidity_flag[4];                         // bytes 254 to 257
  UINT8 nt_price_conditions_flag[4];                  // bytes 258 to 261
  UINT8 algo_transaction_flag[4];                     // bytes 262 to 265
  UINT8 pt_illiquid_flag[4];                          // bytes 266 to 269
  UINT8 price_improvement_flag[4];                    // bytes 270 to 273
  UINT8 cancellation_flag[4];                         // bytes 274 to 277
  UINT8 amendment_flag[4];                            // bytes 278 to 281
  UINT8 duplicate_flag[4];                            // bytes 282 to 285
  UINT8 exchange_for_physicals_flag[4];               // bytes 286 to 289
  UINT8 limited_details_flag[4];                      // bytes 290 to 293
  UINT8 ld_full_details_flag[4];                      // bytes 294 to 297
  UINT8 daily_aggregated_transaction_flag[4];         // bytes 298 to 301
  UINT8 da_full_details_flag[4];                      // bytes 302 to 305
  UINT8 volume_omission_flag[4];                      // bytes 306 to 309
  UINT8 vo_full_details_flag[4];                      // bytes 310 to 313
  UINT8 four_weeks_aggregation_flag[4];               // bytes 314 to 317
  UINT8 fa_full_details_flag[4];                      // bytes 318 to 321
  UINT8 indefinite_aggregation_flag[4];               // bytes 322 to 325
  UINT8 volume_omission_for_sovereign_debt_flag[4];   // bytes 326 to 329
  UINT8 consecutive_aggregation_flag[4];              // bytes 330 to 333
  UINT8 reserved_1;                                   // byte 334
  UINT8 venue_type;                                   // byte 335
  UINT8 venue_book_definition_id;                     // byte 336
  UINT8 venue_measurement_unit_notation[25];          // bytes 337 to 361
  UINT8 quantity_in_measurement_unit[20];             // bytes 362 to 381
  UINT8 transaction_to_be_cleared;                    // byte 382
  UINT8 emission_allowance_type[4];                   // bytes 383 to 386
  UINT8 venue_of_publication[4];                      // bytes 387 to 390
  UINT8 market_mechanism;                             // byte 391
  UINT8 trading_mode;                                 // byte 392
  UINT8 transaction_category;                         // byte 393
  UINT8 negotiation_indicator;                        // byte 394
  UINT8 agency_cross_indicator;                       // byte 395
  UINT8 modification_indicator;                       // byte 396
  UINT8 reference_price_indicator;                    // byte 397
  UINT8 special_dividend_indicator;                   // byte 398
  UINT8 off_book_automated_indicator;                 // byte 399
  UINT8 price_formation_indicator;                    // byte 400
  UINT8 algorithmic_indicator;                        // byte 401
  UINT8 post_trade_deferral_reason;                   // byte 402
  UINT8 deferral_enrichment_type;                     // byte 403
  UINT8 duplicative_indicator;                        // byte 404
  UINT8 third_country_trading_venue_of_execution[4];  // bytes 405 to 408
  UINT8 portfolio_transaction_flag[4];                // bytes 409 to 412
  UINT8 contingent_transaction_flag[4];               // bytes 413 to 416
  UINT8 price_conditions[4];                          // bytes 417 to 420
  UINT8 market_closing_price_flag[4];                 // bytes 421 to 424
  UINT8 nt_large_in_scale_flag[4];                    // bytes 425 to 428
  UINT8 nt_pre_trade_transparency_flag[4];            // bytes 429 to 432
} MifidIiTradeReportMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x70: InstrumentDirectoryMessage instrument_directory_message;
    case 0x48: InstrumentStatusMessage instrument_status_message;
    case 0x77: StatisticsMessage statistics_message;
    case 0x54: MifidIiTradeReportMessage mifid_ii_trade_report_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_length { message_length >= 3 };                                                                                                                   // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 3)) payload[:byte-size-single-element-array (((UINT32) message_length) - 3)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Gtp Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                            // bytes 0 to 1
  UINT8 message_count;                                                                                                      // byte 2
  UINT8 market_data_group;                                                                                                  // byte 3
  UINT32 sequence_number;                                                                                                   // bytes 4 to 7
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 8)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} Packet;

