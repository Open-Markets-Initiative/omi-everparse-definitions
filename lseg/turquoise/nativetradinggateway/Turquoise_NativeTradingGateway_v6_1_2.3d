#define SELL_EXECUTING_TRADER_CLIENT 0x00000003  // Client

// ---- Types -------------------------------------------------------------------

// Allows the Participant and server to establish a session.
typedef struct _LogonMessage {
  UINT8 comp_id[25];       // bytes 0 to 24
  UINT8 password[25];      // bytes 25 to 49
  UINT8 new_password[25];  // bytes 50 to 74
  UINT8 message_version;   // byte 75, signed, read here as unsigned
} LogonMessage;

// Allows the server to acknowledge a Participant's Logon.
typedef struct _LogonReplyMessage {
  UINT32 reject_code;                   // bytes 0 to 3, signed, read here as unsigned
  UINT8 password_expiry_day_count[30];  // bytes 4 to 33
} LogonReplyMessage;

// Allows the Participant and server to terminate a session.
typedef struct _LogoutMessage {
  UINT8 logout_reason[20];  // bytes 0 to 19
} LogoutMessage;

// Allows the Server to reject a message that does not comply with the Native Trading Gateway messaging protocol.
typedef struct _RejectMessage {
  UINT32 reject_code;           // bytes 0 to 3, signed, read here as unsigned
  UINT8 reject_reason[30];      // bytes 4 to 33
  UINT8 rejected_message_type;  // byte 34
  UINT8 client_order_id[20];    // bytes 35 to 54
} RejectMessage;

// Allows the Participant to submit a new order.
typedef struct _NewOrderMessage {
  UINT8 client_order_id[20];                 // bytes 0 to 19
  UINT8 trader_id[11];                       // bytes 20 to 30
  UINT8 account[10];                         // bytes 31 to 40
  UINT8 clearing_account;                    // byte 41
  UINT8 mtf_common_symbol[8];                // bytes 42 to 49
  UINT8 order_type;                          // byte 50
  UINT8 tif;                                 // byte 51
  UINT32 expire_date_time;                   // bytes 52 to 55
  UINT8 side;                                // byte 56, signed, read here as unsigned
  UINT32 order_qty;                          // bytes 57 to 60, signed, read here as unsigned
  UINT32 display_qty;                        // bytes 61 to 64, signed, read here as unsigned
  UINT64 limit_price;                        // bytes 65 to 72, signed, read here as unsigned
  UINT8 capacity;                            // byte 73, signed, read here as unsigned
  UINT8 auto_cancel;                         // byte 74, signed, read here as unsigned
  UINT8 order_sub_type;                      // byte 75, signed, read here as unsigned
  UINT8 owner_type;                          // byte 76
  UINT8 reserved_8[8];                       // bytes 77 to 84
  UINT8 target_book;                         // byte 85
  UINT8 exec_instruction;                    // byte 86, signed, read here as unsigned
  UINT32 minimum_quantity;                   // bytes 87 to 90, signed, read here as unsigned
  UINT8 reserved_1;                          // byte 91
  UINT8 second_reserved_1;                   // byte 92
  UINT8 peg_price_type;                      // byte 93
  UINT8 passive_only_order;                  // byte 94, signed, read here as unsigned
  UINT8 cl_ord_link_id[12];                  // bytes 95 to 106
  UINT32 client_id;                          // bytes 107 to 110
  UINT32 investment_decision_maker;          // bytes 111 to 114
  UINT32 executing_within_firm;              // bytes 115 to 118
  UINT8 dea_flag : 1;                        // byte 119
  UINT8 liquidity_provision : 1;             // byte 119
  UINT8 algo : 1;                            // byte 119
  UINT8 reserved_37 : 5;                     // byte 119
  UINT8 client_id_qualifier : 2;             // byte 120
  UINT8 investor_information_qualifier : 2;  // byte 120
  UINT8 executing_trader_qualifier : 2;      // byte 120
  UINT8 reserved_67 : 2;                     // byte 120
} NewOrderMessage;

// Allows the Participant to cancel/replace a live order.
typedef struct _OrderCancelReplaceRequestMessage {
  UINT8 client_order_id[20];           // bytes 0 to 19
  UINT8 original_client_order_id[20];  // bytes 20 to 39
  UINT8 order_id[12];                  // bytes 40 to 51
  UINT8 common_symbol[8];              // bytes 52 to 59
  UINT32 expire_date_time;             // bytes 60 to 63
  UINT32 order_qty;                    // bytes 64 to 67, signed, read here as unsigned
  UINT32 display_qty;                  // bytes 68 to 71, signed, read here as unsigned
  UINT64 limit_price;                  // bytes 72 to 79, signed, read here as unsigned
  UINT8 account[10];                   // bytes 80 to 89
  UINT8 reserved_1;                    // byte 90
  UINT8 side;                          // byte 91, signed, read here as unsigned
  UINT8 reserved_8[8];                 // bytes 92 to 99
  UINT8 target_book;                   // byte 100
  UINT8 exec_instruction;              // byte 101, signed, read here as unsigned
  UINT32 min_qty;                      // bytes 102 to 105, signed, read here as unsigned
  UINT8 passive_only_order;            // byte 106, signed, read here as unsigned
  UINT8 reserved_3[3];                 // bytes 107 to 109
} OrderCancelReplaceRequestMessage;

// Allows the Participant to cancel a live order.
typedef struct _OrderCancelRequestMessage {
  UINT8 client_order_id[20];           // bytes 0 to 19
  UINT8 original_client_order_id[20];  // bytes 20 to 39
  UINT8 order_id[12];                  // bytes 40 to 51
  UINT8 common_symbol[8];              // bytes 52 to 59
  UINT8 side;                          // byte 60, signed, read here as unsigned
  UINT8 target_book;                   // byte 61
  UINT8 reserved_10[10];               // bytes 62 to 71
} OrderCancelRequestMessage;

// Allows the Participant to mass cancel all live orders, those for an instrument or those for a segment.
typedef struct _OrderMassCancelRequestMessage {
  UINT8 client_order_id[20];  // bytes 0 to 19
  UINT8 mass_cancel_type;     // byte 20, signed, read here as unsigned
  UINT8 common_symbol[8];     // bytes 21 to 28
  UINT8 segment[4];           // bytes 29 to 32
  UINT8 reserved_1;           // byte 33
  UINT8 target_book;          // byte 34
  UINT8 reserved_9[9];        // bytes 35 to 43
} OrderMassCancelRequestMessage;

// Composite
typedef struct _TransactTime {
  UINT32 seconds;      // bytes 0 to 3
  UINT32 nanoseconds;  // bytes 4 to 7
} TransactTime;

// Indicates order accepted, rejected, executed, expired, cancelled, cancel/replaced, trade cancel, BI triggered or pending cancel.
typedef struct _ExecutionReportMessage {
  UINT8 app_id;                       // byte 0, signed, read here as unsigned
  UINT32 sequence_no;                 // bytes 1 to 4, signed, read here as unsigned
  UINT8 execution_id[12];             // bytes 5 to 16
  UINT8 client_order_id[20];          // bytes 17 to 36
  UINT8 order_id[12];                 // bytes 37 to 48
  UINT8 exec_type;                    // byte 49
  UINT8 execution_report_ref_id[12];  // bytes 50 to 61
  UINT8 order_status;                 // byte 62, signed, read here as unsigned
  UINT32 order_reject_code;           // bytes 63 to 66, signed, read here as unsigned
  UINT64 executed_price;              // bytes 67 to 74, signed, read here as unsigned
  UINT32 executed_qty;                // bytes 75 to 78, signed, read here as unsigned
  UINT32 leaves_qty;                  // bytes 79 to 82, signed, read here as unsigned
  UINT8 waiver_flags;                 // byte 83
  UINT32 display_qty;                 // bytes 84 to 87, signed, read here as unsigned
  UINT8 common_symbol[8];             // bytes 88 to 95
  UINT8 side;                         // byte 96, signed, read here as unsigned
  UINT64 secondary_order_id;          // bytes 97 to 104
  UINT8 counterparty[11];             // bytes 105 to 115
  UINT8 trade_liquidity_indicator;    // byte 116
  UINT64 trade_match_id;              // bytes 117 to 124
  TransactTime transact_time;         // bytes 125 to 132
  UINT8 target_book;                  // byte 133
  UINT8 type_of_trade;                // byte 134, signed, read here as unsigned
  UINT8 capacity;                     // byte 135, signed, read here as unsigned
  UINT8 reserved_1;                   // byte 136
  UINT8 public_order_id[12];          // bytes 137 to 148
  UINT32 minimum_quantity;            // bytes 149 to 152, signed, read here as unsigned
  UINT8 reputational_score;           // byte 153, signed, read here as unsigned
  UINT8 last_market;                  // byte 154
  UINT8 peg_price_type;               // byte 155
  UINT8 owner_type;                   // byte 156
  UINT8 waiver_flags_2;               // byte 157
  UINT8 reserved_21[21];              // bytes 158 to 178
} ExecutionReportMessage;

// Indicates that an Order Cancel Request or Order Cancel/Replace Request has been rejected.
typedef struct _OrderCancelRejectMessage {
  UINT8 app_id;                 // byte 0, signed, read here as unsigned
  UINT32 sequence_no;           // bytes 1 to 4, signed, read here as unsigned
  UINT8 client_order_id[20];    // bytes 5 to 24
  UINT8 order_id[12];           // bytes 25 to 36
  UINT32 cancel_reject_reason;  // bytes 37 to 40, signed, read here as unsigned
  TransactTime transact_time;   // bytes 41 to 48
  UINT8 reserved_10[10];        // bytes 49 to 58
} OrderCancelRejectMessage;

// Indicates a mass order cancel request was accepted or rejected.
typedef struct _OrderMassCancelReportMessage {
  UINT8 app_id;                      // byte 0, signed, read here as unsigned
  UINT32 sequence_no;                // bytes 1 to 4, signed, read here as unsigned
  UINT8 client_order_id[20];         // bytes 5 to 24
  UINT8 mass_cancel_response;        // byte 25, signed, read here as unsigned
  UINT32 mass_cancel_reject_reason;  // bytes 26 to 29, signed, read here as unsigned
  UINT8 reserved_4[4];               // bytes 30 to 33
  TransactTime transact_time;        // bytes 34 to 41
  UINT8 reserved_10[10];             // bytes 42 to 51
} OrderMassCancelReportMessage;

// Allows the client to submit a BTF pre-arranged Trade.
typedef struct _NewCrossBtfMessage {
  UINT8 cross_id[20];                          // bytes 0 to 19
  UINT8 cross_type;                            // byte 20
  UINT8 buy_side_cl_ord_id[20];                // bytes 21 to 40
  UINT8 buy_side_order_capacity;               // byte 41
  UINT8 buy_side_clearing_account;             // byte 42
  UINT32 buy_side_order_quantity;              // bytes 43 to 46, signed, read here as unsigned
  UINT8 reserved_4[4];                         // bytes 47 to 50
  UINT8 buy_side_firm_id[11];                  // bytes 51 to 61
  UINT8 buy_side_party_role;                   // byte 62
  UINT8 dea_flag : 1;                          // byte 63
  UINT8 liquidity_provision : 1;               // byte 63
  UINT8 algo : 1;                              // byte 63
  UINT8 reserved_37 : 5;                       // byte 63
  UINT32 buy_client_id;                        // bytes 64 to 67
  UINT32 buy_investment_decision_maker;        // bytes 68 to 71
  UINT32 buy_executing_trader;                 // bytes 72 to 75
  UINT8 client_id_qualifier : 2;               // byte 76
  UINT8 investor_information_qualifier : 2;    // byte 76
  UINT8 executing_trader_qualifier : 2;        // byte 76
  UINT8 reserved_67 : 2;                       // byte 76
  UINT8 sell_side_cl_ord_id[20];               // bytes 77 to 96
  UINT8 sell_side_order_capacity;              // byte 97
  UINT8 sell_side_clearing_account;            // byte 98
  UINT32 sell_side_order_quantity;             // bytes 99 to 102, signed, read here as unsigned
  UINT8 second_reserved_4[4];                  // bytes 103 to 106
  UINT8 sell_side_firm_id[11];                 // bytes 107 to 117
  UINT8 sell_side_party_role;                  // byte 118
  UINT8 dea_flag_2 : 1;                        // byte 119
  UINT8 liquidity_provision_2 : 1;             // byte 119
  UINT8 algo_2 : 1;                            // byte 119
  UINT8 reserved_37_2 : 5;                     // byte 119
  UINT32 sell_client_id;                       // bytes 120 to 123
  UINT32 sell_investment_decision_maker;       // bytes 124 to 127
  UINT32 sell_executing_trader;                // bytes 128 to 131
  UINT8 client_id_qualifier_2 : 2;             // byte 132
  UINT8 investor_information_qualifier_2 : 2;  // byte 132
  UINT8 executing_trader_qualifier_2 : 2;      // byte 132
  UINT8 reserved_67_2 : 2;                     // byte 132
  UINT8 mtf_common_symbol[8];                  // bytes 133 to 140
  UINT64 price;                                // bytes 141 to 148, signed, read here as unsigned
  UINT8 order_type;                            // byte 149
  UINT8 tif;                                   // byte 150
} NewCrossBtfMessage;

// Allows the client to cancel a Committed BTF pre-arranged Trade.
typedef struct _CrossBtfCancelRequestMessage {
  UINT8 cross_id[20];                      // bytes 0 to 19
  UINT8 original_cross_id[20];             // bytes 20 to 39
  UINT8 cross_type;                        // byte 40
  UINT8 buy_side_original_cl_ord_id[20];   // bytes 41 to 60
  UINT32 buy_side_order_quantity;          // bytes 61 to 64, signed, read here as unsigned
  UINT8 reserved_4[4];                     // bytes 65 to 68
  UINT8 sell_side_original_cl_ord_id[20];  // bytes 69 to 88
  UINT32 sell_side_order_quantity;         // bytes 89 to 92, signed, read here as unsigned
  UINT8 second_reserved_4[4];              // bytes 93 to 96
  UINT8 mtf_common_symbol[8];              // bytes 97 to 104
  UINT8 client_order_id[20];               // bytes 105 to 124
} CrossBtfCancelRequestMessage;

// Indicates that an application message could not be processed.
typedef struct _BusinessRejectMessage {
  UINT8 app_id;                // byte 0, signed, read here as unsigned
  UINT32 sequence_no;          // bytes 1 to 4, signed, read here as unsigned
  UINT32 reject_code;          // bytes 5 to 8, signed, read here as unsigned
  UINT8 client_order_id[20];   // bytes 9 to 28
  UINT8 order_id[12];          // bytes 29 to 40
  TransactTime transact_time;  // bytes 41 to 48
  UINT8 reserved_10[10];       // bytes 49 to 58
} BusinessRejectMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: LogonMessage logon_message;
    case 0x42: LogonReplyMessage logon_reply_message;
    case 0x35: LogoutMessage logout_message;
    case 0x30: unit heartbeat_message;
    case 0x33: RejectMessage reject_message;
    case 0x44: NewOrderMessage new_order_message;
    case 0x47: OrderCancelReplaceRequestMessage order_cancel_replace_request_message;
    case 0x46: OrderCancelRequestMessage order_cancel_request_message;
    case 0x71: OrderMassCancelRequestMessage order_mass_cancel_request_message;
    case 0x38: ExecutionReportMessage execution_report_message;
    case 0x39: OrderCancelRejectMessage order_cancel_reject_message;
    case 0x72: OrderMassCancelReportMessage order_mass_cancel_report_message;
    case 0x43: NewCrossBtfMessage new_cross_btf_message;
    case 0x48: CrossBtfCancelRequestMessage cross_btf_cancel_request_message;
    case 0x6A: BusinessRejectMessage business_reject_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Native Trading Gateway Message
typedef struct _Message {
  UINT8 start_of_message;                                                                                                                       // byte 0, signed, read here as unsigned
  UINT16 message_length { message_length >= 1 };                                                                                                // bytes 1 to 2, signed, read here as unsigned
  UINT8 message_type;                                                                                                                           // byte 3
  Payload(message_type, ((((UINT32) message_length) + 3) - 4)) payload[:byte-size-single-element-array ((((UINT32) message_length) + 3) - 4)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Native Trading Gateway Tcp Message Block
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

