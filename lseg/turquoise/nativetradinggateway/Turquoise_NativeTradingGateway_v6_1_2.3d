// Message Type: one byte code
#define MESSAGE_TYPE_LOGON_MESSAGE 0x41                         // Logon Message
#define MESSAGE_TYPE_LOGON_REPLY_MESSAGE 0x42                   // Logon Reply Message
#define MESSAGE_TYPE_LOGOUT_MESSAGE 0x35                        // Logout Message
#define MESSAGE_TYPE_HEARTBEAT_MESSAGE 0x30                     // Heartbeat Message
#define MESSAGE_TYPE_REJECT_MESSAGE 0x33                        // Reject Message
#define MESSAGE_TYPE_NEW_ORDER_MESSAGE 0x44                     // New Order Message
#define MESSAGE_TYPE_ORDER_CANCEL_REPLACE_REQUEST_MESSAGE 0x47  // Order Cancel Replace Request Message
#define MESSAGE_TYPE_ORDER_CANCEL_REQUEST_MESSAGE 0x46          // Order Cancel Request Message
#define MESSAGE_TYPE_ORDER_MASS_CANCEL_REQUEST_MESSAGE 0x71     // Order Mass Cancel Request Message
#define MESSAGE_TYPE_EXECUTION_REPORT_MESSAGE 0x38              // Execution Report Message
#define MESSAGE_TYPE_ORDER_CANCEL_REJECT_MESSAGE 0x39           // Order Cancel Reject Message
#define MESSAGE_TYPE_ORDER_MASS_CANCEL_REPORT_MESSAGE 0x72      // Order Mass Cancel Report Message
#define MESSAGE_TYPE_NEW_CROSS_BTF_MESSAGE 0x43                 // New Cross Btf Message
#define MESSAGE_TYPE_CROSS_BTF_CANCEL_REQUEST_MESSAGE 0x48      // Cross Btf Cancel Request Message
#define MESSAGE_TYPE_BUSINESS_REJECT_MESSAGE 0x6A               // Business Reject Message

// Clearing Account: one byte code
#define CLEARING_ACCOUNT_CLIENT 0x01  // Client
#define CLEARING_ACCOUNT_HOUSE 0x03   // House

// Order Type: one byte code
#define ORDER_TYPE_MARKET 0x01  // Market
#define ORDER_TYPE_LIMIT 0x02   // Limit

// Tif: one byte code
#define TIF_DAY 0x00                      // Day
#define TIF_IMMEDIATE_OR_CANCEL_IOC 0x03  // Immediate Or Cancel Ioc
#define TIF_FILL_OR_KILL_FOK 0x04         // Fill Or Kill Fok
#define TIF_GOOD_TILL_TIME_GTT 0x08       // Good Till Time Gtt
#define TIF_GOOD_FOR_AUCTION_GFA 0x09     // Good For Auction Gfa

// Side: one byte code
#define SIDE_BUY 0x01   // Buy
#define SIDE_SELL 0x02  // Sell

// Capacity: one byte code
#define CAPACITY_MATCHED_PRINCIPAL_MTCH 0x01           // Matched Principal Mtch
#define CAPACITY_DEALING_ON_OWN_ACCOUNT_DEAL 0x02      // Dealing On Own Account Deal
#define CAPACITY_ANY_OTHER_TRADING_CAPACITY_AOTC 0x03  // Any Other Trading Capacity Aotc

// Auto Cancel: one byte code
#define AUTO_CANCEL_DO_NOT_CANCEL_ON_DISCONNECT 0x00  // Do Not Cancel On Disconnect
#define AUTO_CANCEL_CHECK_SYSTEM_PREFERENCE 0x01      // Check System Preference

// Order Sub Type: one byte code
#define ORDER_SUB_TYPE_ORDER 0x00         // Order
#define ORDER_SUB_TYPE_BI 0x01            // Bi
#define ORDER_SUB_TYPE_ORDER_BDN 0x03     // Order Bdn
#define ORDER_SUB_TYPE_PEGGED_ORDER 0x05  // Pegged Order
#define ORDER_SUB_TYPE_RANDOM 0x33        // Random

// Owner Type: one byte code
#define OWNER_TYPE_NON_RETAIL 0x00  // Non Retail
#define OWNER_TYPE_RETAIL 0x01      // Retail
#define OWNER_TYPE_RETAIL_LP 0x02   // Retail Lp

// Target Book: one byte code
#define TARGET_BOOK_TURQUOISE_DARK_ORDER_BOOK_TRQM_OR_TQEM 0x00                   // Turquoise Dark Order Book Trqm Or Tqem
#define TARGET_BOOK_TURQUOISE_LIT_ORDER_BOOK_TRQX_OR_TQEX 0x01                    // Turquoise Lit Order Book Trqx Or Tqex
#define TARGET_BOOK_TURQUOISE_DARK_LIT_SWEEP_TRQM_AND_TRQX_OR_TQEM_AND_TQEX 0x03  // Turquoise Dark Lit Sweep Trqm And Trqx Or Tqem And Tqex
#define TARGET_BOOK_TURQUOISE_PERIODIC_AUCTIONS_ORDER_BOOK_TRQA_OR_TQEA 0x04      // Turquoise Periodic Auctions Order Book Trqa Or Tqea

// Exec Instruction: one byte code
#define EXEC_INSTRUCTION_APPLY_USER_LEVEL_DEFAULT 0x00                // Apply User Level Default
#define EXEC_INSTRUCTION_TURQUOISE_DARK_UNCROSS_ONLY 0x01             // Turquoise Dark Uncross Only
#define EXEC_INSTRUCTION_CONTINUOUS_ONLY 0x02                         // Continuous Only
#define EXEC_INSTRUCTION_CONTINUOUS_AND_TURQUOISE_DARK_UNCROSS 0x05   // Continuous And Turquoise Dark Uncross
#define EXEC_INSTRUCTION_TURQUOISE_DARK_UNCROSS_THEN_CONTINUOUS 0x06  // Turquoise Dark Uncross Then Continuous

// Peg Price Type: one byte code
#define PEG_PRICE_TYPE_DEFAULT_MIDPOINT 0x00              // Default Midpoint
#define PEG_PRICE_TYPE_CLOSING_PRICE_CLSE_TGHL_ONLY 0x01  // Closing Price Clse Tghl Only
#define PEG_PRICE_TYPE_MIDPOINT 0x02                      // Midpoint
#define PEG_PRICE_TYPE_BEST_BID 0x0A                      // Best Bid
#define PEG_PRICE_TYPE_BEST_OFFER 0x0B                    // Best Offer

// Passive Only Order: one byte code
#define PASSIVE_ONLY_ORDER_NO_CONSTRAINT 0x00                                                            // No Constraint
#define PASSIVE_ONLY_ORDER_ACCEPT_ORDER_IF_SETTING_NEW_BBO_OR_JOINING_EXISTING_BBO 0x01                  // Accept Order If Setting New Bbo Or Joining Existing Bbo
#define PASSIVE_ONLY_ORDER_ACCEPT_ORDER_IF_JOINING_EXISTING_BBO_OR_WITHIN_ONE_VISIBLE_PRICE_POINT 0x02   // Accept Order If Joining Existing Bbo Or Within One Visible Price Point
#define PASSIVE_ONLY_ORDER_ACCEPT_ORDER_IF_JOINING_EXISTING_BBO_OR_WITHIN_TWO_VISIBLE_PRICE_POINTS 0x03  // Accept Order If Joining Existing Bbo Or Within Two Visible Price Points
#define PASSIVE_ONLY_ORDER_BI_OPT_OUT_OF_MATCHING_WITH_CBI 0x32                                          // Bi Opt Out Of Matching With Cbi
#define PASSIVE_ONLY_ORDER_ACCEPT_ORDER_ONLY_IF_PASSIVE_UPON_ORDER_ENTRY 0x63                            // Accept Order Only If Passive Upon Order Entry
#define PASSIVE_ONLY_ORDER_ACCEPT_ORDER_IF_SETTING_NEW_BBO 0x64                                          // Accept Order If Setting New Bbo

// Client Id: 4 byte code
#define CLIENT_ID_NONE 0x00000000  // None
#define CLIENT_ID_AGGR 0x00000001  // Aggr
#define CLIENT_ID_PNAL 0x00000002  // Pnal

// Investment Decision Maker: 4 byte code
#define INVESTMENT_DECISION_MAKER_NONE 0x00000000  // None

// Executing Within Firm: 4 byte code
#define EXECUTING_WITHIN_FIRM_CLIENT 0x00000003  // Client

// Mass Cancel Type: one byte code
#define MASS_CANCEL_TYPE_ALL_FIRM_ORDERS_FOR_AN_INSTRUMENT 0x03                      // All Firm Orders For An Instrument
#define MASS_CANCEL_TYPE_ALL_FIRM_ORDERS_IN_A_SEGMENT 0x04                           // All Firm Orders In A Segment
#define MASS_CANCEL_TYPE_ALL_ORDERS_SUBMITTED_BY_THE_COMP_ID 0x07                    // All Orders Submitted By The Comp Id
#define MASS_CANCEL_TYPE_ALL_FIRM_ORDERS 0x08                                        // All Firm Orders
#define MASS_CANCEL_TYPE_ALL_ORDERS_SUBMITTED_BY_THE_COMP_ID_FOR_AN_INSTRUMENT 0x09  // All Orders Submitted By The Comp Id For An Instrument
#define MASS_CANCEL_TYPE_ALL_ORDERS_SUBMITTED_BY_THE_COMP_ID_FOR_A_SEGMENT 0x0F      // All Orders Submitted By The Comp Id For A Segment

// App Id: one byte code
#define APP_ID_SYSTEM_SUSPENDED_UNKNOWN_INSTRUMENT 0x00  // System Suspended Unknown Instrument
#define APP_ID_PARTITION_1 0x01                          // Partition 1
#define APP_ID_PARTITION_2 0x02                          // Partition 2
#define APP_ID_PARTITION_3 0x03                          // Partition 3

// Exec Type: one byte code
#define EXEC_TYPE_NEW 0x30             // New
#define EXEC_TYPE_CANCELLED 0x34       // Cancelled
#define EXEC_TYPE_REPLACED 0x35        // Replaced
#define EXEC_TYPE_PENDING_CANCEL 0x36  // Pending Cancel
#define EXEC_TYPE_REJECTED 0x38        // Rejected
#define EXEC_TYPE_EXPIRED 0x43         // Expired
#define EXEC_TYPE_RESTATED 0x44        // Restated
#define EXEC_TYPE_TRADE 0x46           // Trade
#define EXEC_TYPE_TRADE_CANCEL 0x48    // Trade Cancel
#define EXEC_TYPE_TRIGGERED 0x4C       // Triggered

// Order Status: one byte code
#define ORDER_STATUS_NEW 0x00               // New
#define ORDER_STATUS_PARTIALLY_FILLED 0x01  // Partially Filled
#define ORDER_STATUS_FILLED 0x02            // Filled
#define ORDER_STATUS_CANCELLED 0x04         // Cancelled
#define ORDER_STATUS_EXPIRED 0x06           // Expired
#define ORDER_STATUS_REJECTED 0x08          // Rejected
#define ORDER_STATUS_PENDING_CANCEL 0x0D    // Pending Cancel

// Trade Liquidity Indicator: one byte code
#define TRADE_LIQUIDITY_INDICATOR_ADDED_LIQUIDITY 0x41                                             // Added Liquidity
#define TRADE_LIQUIDITY_INDICATOR_REMOVED_LIQUIDITY 0x52                                           // Removed Liquidity
#define TRADE_LIQUIDITY_INDICATOR_TURQUOISE_DARK_UNCROSS_OR_PERIODIC_AUCTIONS_EXECUTION 0x43       // Turquoise Dark Uncross Or Periodic Auctions Execution
#define TRADE_LIQUIDITY_INDICATOR_TURQUOISE_BLOCK_DISCOVERY_EXECUTION_TURQUOISE_DARK_UNCROSS 0x53  // Turquoise Block Discovery Execution Turquoise Dark Uncross
#define TRADE_LIQUIDITY_INDICATOR_BTF_TRADE 0x42                                                   // Btf Trade

// Type Of Trade: one byte code
#define TYPE_OF_TRADE_VISIBLE 0x00        // Visible
#define TYPE_OF_TRADE_HIDDEN 0x01         // Hidden
#define TYPE_OF_TRADE_NOT_SPECIFIED 0x02  // Not Specified

// Last Market: one byte code
#define LAST_MARKET_TRQX_TURQUOISE_LIT_ORDER_BOOK 0x01                     // Trqx Turquoise Lit Order Book
#define LAST_MARKET_TRQM_TURQUOISE_DARK_ORDER_BOOK 0x02                    // Trqm Turquoise Dark Order Book
#define LAST_MARKET_TRQA_TURQUOISE_PERIODIC_AUCTIONS_ORDER_BOOK 0x03       // Trqa Turquoise Periodic Auctions Order Book
#define LAST_MARKET_TQEX_TURQUOISE_LIT_ORDER_BOOK_TGHE 0x05                // Tqex Turquoise Lit Order Book Tghe
#define LAST_MARKET_TQEM_TURQUOISE_DARK_ORDER_BOOK_TGHE 0x06               // Tqem Turquoise Dark Order Book Tghe
#define LAST_MARKET_TQEA_TURQUOISE_PERIODIC_AUCTIONS_ORDER_BOOK_TGHE 0x07  // Tqea Turquoise Periodic Auctions Order Book Tghe

// Mass Cancel Response: one byte code
#define MASS_CANCEL_RESPONSE_REJECTED 0x00  // Rejected
#define MASS_CANCEL_RESPONSE_ACCEPTED 0x07  // Accepted

// Cross Type: one byte code
#define CROSS_TYPE_INTERNAL_BTF 0x06   // Internal Btf
#define CROSS_TYPE_COMMITTED_BTF 0x08  // Committed Btf

// Buy Side Order Capacity: one byte code
#define BUY_SIDE_ORDER_CAPACITY_MATCHED_PRINCIPAL_MTCH 0x01           // Matched Principal Mtch
#define BUY_SIDE_ORDER_CAPACITY_DEALING_ON_OWN_ACCOUNT_DEAL 0x02      // Dealing On Own Account Deal
#define BUY_SIDE_ORDER_CAPACITY_ANY_OTHER_TRADING_CAPACITY_AOTC 0x03  // Any Other Trading Capacity Aotc

// Buy Side Clearing Account: one byte code
#define BUY_SIDE_CLEARING_ACCOUNT_CLIENT 0x01  // Client
#define BUY_SIDE_CLEARING_ACCOUNT_HOUSE 0x03   // House

// Buy Side Party Role: one byte code
#define BUY_SIDE_PARTY_ROLE_EXECUTING_FIRM 0x01     // Executing Firm
#define BUY_SIDE_PARTY_ROLE_COUNTERPARTY_FIRM 0x11  // Counterparty Firm

// Buy Client Id: 4 byte code
#define BUY_CLIENT_ID_NONE 0x00000000  // None
#define BUY_CLIENT_ID_AGGR 0x00000001  // Aggr
#define BUY_CLIENT_ID_PNAL 0x00000002  // Pnal

// Buy Investment Decision Maker: 4 byte code
#define BUY_INVESTMENT_DECISION_MAKER_NONE 0x00000000  // None

// Buy Executing Trader: 4 byte code
#define BUY_EXECUTING_TRADER_CLIENT 0x00000003  // Client

// Sell Side Order Capacity: one byte code
#define SELL_SIDE_ORDER_CAPACITY_MATCHED_PRINCIPAL_MTCH 0x01           // Matched Principal Mtch
#define SELL_SIDE_ORDER_CAPACITY_DEALING_ON_OWN_ACCOUNT_DEAL 0x02      // Dealing On Own Account Deal
#define SELL_SIDE_ORDER_CAPACITY_ANY_OTHER_TRADING_CAPACITY_AOTC 0x03  // Any Other Trading Capacity Aotc

// Sell Side Clearing Account: one byte code
#define SELL_SIDE_CLEARING_ACCOUNT_CLIENT 0x01  // Client
#define SELL_SIDE_CLEARING_ACCOUNT_HOUSE 0x03   // House

// Sell Side Party Role: one byte code
#define SELL_SIDE_PARTY_ROLE_EXECUTING_FIRM 0x01     // Executing Firm
#define SELL_SIDE_PARTY_ROLE_COUNTERPARTY_FIRM 0x11  // Counterparty Firm

// Sell Client Id: 4 byte code
#define SELL_CLIENT_ID_NONE 0x00000000  // None
#define SELL_CLIENT_ID_AGGR 0x00000001  // Aggr
#define SELL_CLIENT_ID_PNAL 0x00000002  // Pnal

// Sell Investment Decision Maker: 4 byte code
#define SELL_INVESTMENT_DECISION_MAKER_NONE 0x00000000  // None

