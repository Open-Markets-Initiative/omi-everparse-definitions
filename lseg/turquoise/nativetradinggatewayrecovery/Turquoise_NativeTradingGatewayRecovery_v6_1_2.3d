// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Turquoise_NativeTradingGatewayRecovery_v6_1_2.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_LOGON_MESSAGE 0x41                       // Logon Message
#define MESSAGE_TYPE_LOGON_REPLY_MESSAGE 0x42                 // Logon Reply Message
#define MESSAGE_TYPE_LOGOUT_MESSAGE 0x35                      // Logout Message
#define MESSAGE_TYPE_HEARTBEAT_MESSAGE 0x30                   // Heartbeat Message
#define MESSAGE_TYPE_MISSED_MESSAGE_REQUEST_MESSAGE 0x4D      // Missed Message Request Message
#define MESSAGE_TYPE_MISSED_MESSAGE_REQUEST_ACK_MESSAGE 0x4E  // Missed Message Request Ack Message
#define MESSAGE_TYPE_MISSED_MESSAGE_REPORT_MESSAGE 0x50       // Missed Message Report Message
#define MESSAGE_TYPE_REJECT_MESSAGE 0x33                      // Reject Message
#define MESSAGE_TYPE_SYSTEM_STATUS_MESSAGE 0x6E               // System Status Message
#define MESSAGE_TYPE_EXECUTION_REPORT_MESSAGE 0x38            // Execution Report Message
#define MESSAGE_TYPE_ORDER_CANCEL_REJECT_MESSAGE 0x39         // Order Cancel Reject Message
#define MESSAGE_TYPE_ORDER_MASS_CANCEL_REPORT_MESSAGE 0x72    // Order Mass Cancel Report Message
#define MESSAGE_TYPE_BUSINESS_REJECT_MESSAGE 0x6A             // Business Reject Message

// App Id: one byte code
#define APP_ID_SYSTEM_SUSPENDED_UNKNOWN_INSTRUMENT 0x00  // System Suspended Unknown Instrument
#define APP_ID_PARTITION_1 0x01                          // Partition 1
#define APP_ID_PARTITION_2 0x02                          // Partition 2
#define APP_ID_PARTITION_3 0x03                          // Partition 3

// Missed Message Request Ack Response Type: one byte code
#define MISSED_MESSAGE_REQUEST_ACK_RESPONSE_TYPE_SUCCESSFUL 0x00                      // Successful
#define MISSED_MESSAGE_REQUEST_ACK_RESPONSE_TYPE_RECOVERY_REQUEST_LIMIT_REACHED 0x01  // Recovery Request Limit Reached
#define MISSED_MESSAGE_REQUEST_ACK_RESPONSE_TYPE_INVALID_APP_ID 0x02                  // Invalid App Id
#define MISSED_MESSAGE_REQUEST_ACK_RESPONSE_TYPE_SERVICE_UNAVAILABLE 0x03             // Service Unavailable

// Missed Message Report Response Type: one byte code
#define MISSED_MESSAGE_REPORT_RESPONSE_TYPE_DOWNLOAD_COMPLETE 0x00      // Download Complete
#define MISSED_MESSAGE_REPORT_RESPONSE_TYPE_MESSAGE_LIMIT_REACHED 0x01  // Message Limit Reached
#define MISSED_MESSAGE_REPORT_RESPONSE_TYPE_SERVICE_UNAVAILABLE 0x02    // Service Unavailable

// App Status: one byte code
#define APP_STATUS_RECOVERY_SERVICE_RESUMED 0x01        // Recovery Service Resumed
#define APP_STATUS_RECOVERY_SERVICE_NOT_AVAILABLE 0x02  // Recovery Service Not Available

// Exec Type: one byte code
#define EXEC_TYPE_NEW 0x30             // New
#define EXEC_TYPE_CANCELLED 0x34       // Cancelled
#define EXEC_TYPE_REPLACED 0x35        // Replaced
#define EXEC_TYPE_PENDING_CANCEL 0x36  // Pending Cancel
#define EXEC_TYPE_REJECTED 0x38        // Rejected
#define EXEC_TYPE_EXPIRED 0x43         // Expired
#define EXEC_TYPE_RESTATED 0x44        // Restated
#define EXEC_TYPE_TRADE 0x46           // Trade
#define EXEC_TYPE_TRADE_CANCEL 0x48    // Trade Cancel
#define EXEC_TYPE_TRIGGERED 0x4C       // Triggered

// Order Status: one byte code
#define ORDER_STATUS_NEW 0x00               // New
#define ORDER_STATUS_PARTIALLY_FILLED 0x01  // Partially Filled
#define ORDER_STATUS_FILLED 0x02            // Filled
#define ORDER_STATUS_CANCELLED 0x04         // Cancelled
#define ORDER_STATUS_EXPIRED 0x06           // Expired
#define ORDER_STATUS_REJECTED 0x08          // Rejected
#define ORDER_STATUS_PENDING_CANCEL 0x0D    // Pending Cancel

// Side: one byte code
#define SIDE_BUY 0x01   // Buy
#define SIDE_SELL 0x02  // Sell

// Trade Liquidity Indicator: one byte code
#define TRADE_LIQUIDITY_INDICATOR_ADDED_LIQUIDITY 0x41                                             // Added Liquidity
#define TRADE_LIQUIDITY_INDICATOR_REMOVED_LIQUIDITY 0x52                                           // Removed Liquidity
#define TRADE_LIQUIDITY_INDICATOR_TURQUOISE_DARK_UNCROSS_OR_PERIODIC_AUCTIONS_EXECUTION 0x43       // Turquoise Dark Uncross Or Periodic Auctions Execution
#define TRADE_LIQUIDITY_INDICATOR_TURQUOISE_BLOCK_DISCOVERY_EXECUTION_TURQUOISE_DARK_UNCROSS 0x53  // Turquoise Block Discovery Execution Turquoise Dark Uncross
#define TRADE_LIQUIDITY_INDICATOR_BTF_TRADE 0x42                                                   // Btf Trade

// Target Book: one byte code
#define TARGET_BOOK_TURQUOISE_DARK_ORDER_BOOK_TRQM_OR_TQEM 0x00                   // Turquoise Dark Order Book Trqm Or Tqem
#define TARGET_BOOK_TURQUOISE_LIT_ORDER_BOOK_TRQX_OR_TQEX 0x01                    // Turquoise Lit Order Book Trqx Or Tqex
#define TARGET_BOOK_TURQUOISE_DARK_LIT_SWEEP_TRQM_AND_TRQX_OR_TQEM_AND_TQEX 0x03  // Turquoise Dark Lit Sweep Trqm And Trqx Or Tqem And Tqex
#define TARGET_BOOK_TURQUOISE_PERIODIC_AUCTIONS_ORDER_BOOK_TRQA_OR_TQEA 0x04      // Turquoise Periodic Auctions Order Book Trqa Or Tqea

// Type Of Trade: one byte code
#define TYPE_OF_TRADE_VISIBLE 0x00        // Visible
#define TYPE_OF_TRADE_HIDDEN 0x01         // Hidden
#define TYPE_OF_TRADE_NOT_SPECIFIED 0x02  // Not Specified

// Capacity: one byte code
#define CAPACITY_MATCHED_PRINCIPAL_MTCH 0x01           // Matched Principal Mtch
#define CAPACITY_DEALING_ON_OWN_ACCOUNT_DEAL 0x02      // Dealing On Own Account Deal
#define CAPACITY_ANY_OTHER_TRADING_CAPACITY_AOTC 0x03  // Any Other Trading Capacity Aotc

// Last Market: one byte code
#define LAST_MARKET_TRQX_TURQUOISE_LIT_ORDER_BOOK 0x01                     // Trqx Turquoise Lit Order Book
#define LAST_MARKET_TRQM_TURQUOISE_DARK_ORDER_BOOK 0x02                    // Trqm Turquoise Dark Order Book
#define LAST_MARKET_TRQA_TURQUOISE_PERIODIC_AUCTIONS_ORDER_BOOK 0x03       // Trqa Turquoise Periodic Auctions Order Book
#define LAST_MARKET_TQEX_TURQUOISE_LIT_ORDER_BOOK_TGHE 0x05                // Tqex Turquoise Lit Order Book Tghe
#define LAST_MARKET_TQEM_TURQUOISE_DARK_ORDER_BOOK_TGHE 0x06               // Tqem Turquoise Dark Order Book Tghe
#define LAST_MARKET_TQEA_TURQUOISE_PERIODIC_AUCTIONS_ORDER_BOOK_TGHE 0x07  // Tqea Turquoise Periodic Auctions Order Book Tghe

// Peg Price Type: one byte code
#define PEG_PRICE_TYPE_DEFAULT_MIDPOINT 0x00              // Default Midpoint
#define PEG_PRICE_TYPE_CLOSING_PRICE_CLSE_TGHL_ONLY 0x01  // Closing Price Clse Tghl Only
#define PEG_PRICE_TYPE_MIDPOINT 0x02                      // Midpoint
#define PEG_PRICE_TYPE_BEST_BID 0x0A                      // Best Bid
#define PEG_PRICE_TYPE_BEST_OFFER 0x0B                    // Best Offer

// Owner Type: one byte code
#define OWNER_TYPE_NON_RETAIL 0x00  // Non Retail
#define OWNER_TYPE_RETAIL 0x01      // Retail
#define OWNER_TYPE_RETAIL_LP 0x02   // Retail Lp

// Mass Cancel Response: one byte code
#define MASS_CANCEL_RESPONSE_REJECTED 0x00  // Rejected
#define MASS_CANCEL_RESPONSE_ACCEPTED 0x07  // Accepted

// ---- Types -------------------------------------------------------------------

// Allows the Participant and server to establish a session.
typedef struct _LogonMessage {
  UINT8 comp_id[25];       // bytes 0 to 24
  UINT8 password[25];      // bytes 25 to 49
  UINT8 new_password[25];  // bytes 50 to 74
  UINT8 message_version;   // byte 75, signed, read here as unsigned
} LogonMessage;

// Allows the server to acknowledge a Participant's Logon.
typedef struct _LogonReplyMessage {
  UINT32 reject_code;                   // bytes 0 to 3, signed, read here as unsigned
  UINT8 password_expiry_day_count[30];  // bytes 4 to 33
} LogonReplyMessage;

// Allows the Participant and server to terminate a session.
typedef struct _LogoutMessage {
  UINT8 logout_reason[20];  // bytes 0 to 19
} LogoutMessage;

// Allows the Participant to subscribe to missed messages through the Recovery Channel.
typedef struct _MissedMessageRequestMessage {
  UINT8 app_id;             // byte 0, signed, read here as unsigned
  UINT32 last_msg_seq_num;  // bytes 1 to 4, signed, read here as unsigned
} MissedMessageRequestMessage;

// Allows the server to acknowledge a Participant's Missed Message Request.
typedef struct _MissedMessageRequestAckMessage {
  UINT8 missed_message_request_ack_response_type;  // byte 0, signed, read here as unsigned
} MissedMessageRequestAckMessage;

// Allows the Server to communicate the result of a Missed Message Request.
typedef struct _MissedMessageReportMessage {
  UINT8 missed_message_report_response_type;  // byte 0, signed, read here as unsigned
} MissedMessageReportMessage;

// Allows the Server to reject a message that does not comply with the Native Trading Gateway messaging protocol.
typedef struct _RejectMessage {
  UINT32 reject_code;           // bytes 0 to 3, signed, read here as unsigned
  UINT8 reject_reason[30];      // bytes 4 to 33
  UINT8 rejected_message_type;  // byte 34
  UINT8 client_order_id[20];    // bytes 35 to 54
} RejectMessage;

// Sent to All Native Recovery Channel Participants on the event of Order Cache Outage.
typedef struct _SystemStatusMessage {
  UINT8 app_id;      // byte 0, signed, read here as unsigned
  UINT8 app_status;  // byte 1, signed, read here as unsigned
} SystemStatusMessage;

// Composite
typedef struct _TransactTime {
  UINT32 seconds;      // bytes 0 to 3
  UINT32 nanoseconds;  // bytes 4 to 7
} TransactTime;

// Indicates order accepted, rejected, executed, expired, cancelled, cancel/replaced, trade cancel, BI triggered or pending cancel.
typedef struct _ExecutionReportMessage {
  UINT8 app_id;                       // byte 0, signed, read here as unsigned
  UINT32 sequence_no;                 // bytes 1 to 4, signed, read here as unsigned
  UINT8 execution_id[12];             // bytes 5 to 16
  UINT8 client_order_id[20];          // bytes 17 to 36
  UINT8 order_id[12];                 // bytes 37 to 48
  UINT8 exec_type;                    // byte 49
  UINT8 execution_report_ref_id[12];  // bytes 50 to 61
  UINT8 order_status;                 // byte 62, signed, read here as unsigned
  UINT32 order_reject_code;           // bytes 63 to 66, signed, read here as unsigned
  UINT64 executed_price;              // bytes 67 to 74, signed, read here as unsigned
  UINT32 executed_qty;                // bytes 75 to 78, signed, read here as unsigned
  UINT32 leaves_qty;                  // bytes 79 to 82, signed, read here as unsigned
  UINT8 waiver_flags;                 // byte 83
  UINT32 display_qty;                 // bytes 84 to 87, signed, read here as unsigned
  UINT8 common_symbol[8];             // bytes 88 to 95
  UINT8 side;                         // byte 96, signed, read here as unsigned
  UINT64 secondary_order_id;          // bytes 97 to 104
  UINT8 counterparty[11];             // bytes 105 to 115
  UINT8 trade_liquidity_indicator;    // byte 116
  UINT64 trade_match_id;              // bytes 117 to 124
  TransactTime transact_time;         // bytes 125 to 132
  UINT8 target_book;                  // byte 133
  UINT8 type_of_trade;                // byte 134, signed, read here as unsigned
  UINT8 capacity;                     // byte 135, signed, read here as unsigned
  UINT8 reserved_1;                   // byte 136
  UINT8 public_order_id[12];          // bytes 137 to 148
  UINT32 minimum_quantity;            // bytes 149 to 152, signed, read here as unsigned
  UINT8 reputational_score;           // byte 153, signed, read here as unsigned
  UINT8 last_market;                  // byte 154
  UINT8 peg_price_type;               // byte 155
  UINT8 owner_type;                   // byte 156
  UINT8 waiver_flags_2;               // byte 157
  UINT8 reserved_21[21];              // bytes 158 to 178
} ExecutionReportMessage;

// Indicates that an Order Cancel Request or Order Cancel/Replace Request has been rejected.
typedef struct _OrderCancelRejectMessage {
  UINT8 app_id;                 // byte 0, signed, read here as unsigned
  UINT32 sequence_no;           // bytes 1 to 4, signed, read here as unsigned
  UINT8 client_order_id[20];    // bytes 5 to 24
  UINT8 order_id[12];           // bytes 25 to 36
  UINT32 cancel_reject_reason;  // bytes 37 to 40, signed, read here as unsigned
  TransactTime transact_time;   // bytes 41 to 48
  UINT8 reserved_10[10];        // bytes 49 to 58
} OrderCancelRejectMessage;

// Indicates a mass order cancel request was accepted or rejected.
typedef struct _OrderMassCancelReportMessage {
  UINT8 app_id;                      // byte 0, signed, read here as unsigned
  UINT32 sequence_no;                // bytes 1 to 4, signed, read here as unsigned
  UINT8 client_order_id[20];         // bytes 5 to 24
  UINT8 mass_cancel_response;        // byte 25, signed, read here as unsigned
  UINT32 mass_cancel_reject_reason;  // bytes 26 to 29, signed, read here as unsigned
  UINT8 reserved_4[4];               // bytes 30 to 33
  TransactTime transact_time;        // bytes 34 to 41
  UINT8 reserved_10[10];             // bytes 42 to 51
} OrderMassCancelReportMessage;

// Indicates that an application message could not be processed.
typedef struct _BusinessRejectMessage {
  UINT8 app_id;                // byte 0, signed, read here as unsigned
  UINT32 sequence_no;          // bytes 1 to 4, signed, read here as unsigned
  UINT32 reject_code;          // bytes 5 to 8, signed, read here as unsigned
  UINT8 client_order_id[20];   // bytes 9 to 28
  UINT8 order_id[12];          // bytes 29 to 40
  TransactTime transact_time;  // bytes 41 to 48
  UINT8 reserved_10[10];       // bytes 49 to 58
} BusinessRejectMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: LogonMessage logon_message;
    case 0x42: LogonReplyMessage logon_reply_message;
    case 0x35: LogoutMessage logout_message;
    case 0x30: unit heartbeat_message;
    case 0x4D: MissedMessageRequestMessage missed_message_request_message;
    case 0x4E: MissedMessageRequestAckMessage missed_message_request_ack_message;
    case 0x50: MissedMessageReportMessage missed_message_report_message;
    case 0x33: RejectMessage reject_message;
    case 0x6E: SystemStatusMessage system_status_message;
    case 0x38: ExecutionReportMessage execution_report_message;
    case 0x39: OrderCancelRejectMessage order_cancel_reject_message;
    case 0x72: OrderMassCancelReportMessage order_mass_cancel_report_message;
    case 0x6A: BusinessRejectMessage business_reject_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Native Trading Gateway Message
typedef struct _Message {
  UINT8 start_of_message;                                                                                                                       // byte 0, signed, read here as unsigned
  UINT16 message_length { message_length >= 1 };                                                                                                // bytes 1 to 2, signed, read here as unsigned
  UINT8 message_type;                                                                                                                           // byte 3
  Payload(message_type, ((((UINT32) message_length) + 3) - 4)) payload[:byte-size-single-element-array ((((UINT32) message_length) + 3) - 4)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Native Trading Gateway Tcp Message Block
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

