  UINT32 number_of_trades_on_book_only;  // bytes 54 to 57
  UINT64 turnover;                       // bytes 58 to 65, signed, read here as unsigned
  UINT64 turnover_on_book_only;          // bytes 66 to 73, signed, read here as unsigned
} StatisticsMessage;

// ---- Statistics Update Message: 47 bytes -------------------------------------

// Contains a set of statistics that are not updated frequently
entrypoint typedef struct _StatisticsUpdateMessage {
  UINT64 timestamp;                       // bytes 0 to 7
