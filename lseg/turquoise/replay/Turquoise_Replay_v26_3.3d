// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_LOGIN_REQUEST_MESSAGE 0x01                 // Login Request Message
#define MESSAGE_TYPE_REPLAY_REQUEST_MESSAGE 0x03                // Replay Request Message
#define MESSAGE_TYPE_LOGIN_RESPONSE_MESSAGE 0x02                // Login Response Message
#define MESSAGE_TYPE_REPLAY_RESPONSE_MESSAGE 0x04               // Replay Response Message
#define MESSAGE_TYPE_REPLAY_AND_RECOVERY_COMPLETE_MESSAGE 0x83  // Replay And Recovery Complete Message
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53                  // System Event Message
#define MESSAGE_TYPE_INSTRUMENT_DIRECTORY_MESSAGE 0x70          // Instrument Directory Message
#define MESSAGE_TYPE_INSTRUMENT_STATUS_MESSAGE 0x48             // Instrument Status Message
#define MESSAGE_TYPE_ADD_ORDER_INCREMENTAL_MESSAGE 0x46         // Add Order Incremental Message
#define MESSAGE_TYPE_MODIFY_ORDER_MESSAGE 0x55                  // Modify Order Message
#define MESSAGE_TYPE_DELETE_ORDER_MESSAGE 0x44                  // Delete Order Message
#define MESSAGE_TYPE_TOP_OF_BOOK_MESSAGE 0x69                   // Top Of Book Message
#define MESSAGE_TYPE_ORDER_BOOK_CLEAR_MESSAGE 0x79              // Order Book Clear Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x50                         // Trade Message
#define MESSAGE_TYPE_TRADE_CROSS_MESSAGE 0x71                   // Trade Cross Message
#define MESSAGE_TYPE_STATISTICS_MESSAGE 0x77                    // Statistics Message
#define MESSAGE_TYPE_STATISTICS_UPDATE_MESSAGE 0x6A             // Statistics Update Message
#define MESSAGE_TYPE_MIFID_II_TRADE_MESSAGE 0x51                // Mifid Ii Trade Message
#define MESSAGE_TYPE_MIFID_II_TRADE_CROSS_MESSAGE 0x56          // Mifid Ii Trade Cross Message
#define MESSAGE_TYPE_TRADE_SUMMARY_MESSAGE 0x57                 // Trade Summary Message
#define MESSAGE_TYPE_ANALYTICS_MESSAGE 0x61                     // Analytics Message
#define MESSAGE_TYPE_MIFID_II_ORDER_BOOK_UPDATE_MESSAGE 0x62    // Mifid Ii Order Book Update Message

// Login Status: one byte code
#define LOGIN_STATUS_LOGIN_ACCEPTED 0x41                     // Login Accepted
#define LOGIN_STATUS_COMP_ID_INACTIVE_SUSPENDED 0x61         // Comp Id Inactive Suspended
#define LOGIN_STATUS_LOGIN_LIMIT_REACHED 0x62                // Login Limit Reached
#define LOGIN_STATUS_SERVICE_UNAVAILABLE 0x63                // Service Unavailable
#define LOGIN_STATUS_MAXIMUM_CONNECTIONS_LIMIT_REACHED 0x64  // Maximum Connections Limit Reached
#define LOGIN_STATUS_FAILED_OTHER 0x65                       // Failed Other
#define LOGIN_STATUS_INVALID_COMP_ID_OR_IP_ADDRESS 0x66      // Invalid Comp Id Or Ip Address

// Replay Status: one byte code
#define REPLAY_STATUS_REQUEST_ACCEPTED 0x41          // Request Accepted
#define REPLAY_STATUS_REQUEST_LIMIT_REACHED 0x44     // Request Limit Reached
#define REPLAY_STATUS_OUT_OF_RANGE 0x4F              // Out Of Range
#define REPLAY_STATUS_REPLAY_UNAVAILABLE 0x55        // Replay Unavailable
#define REPLAY_STATUS_CONCURRENT_LIMIT_REACHED 0x63  // Concurrent Limit Reached
#define REPLAY_STATUS_FAILED_OTHER 0x65              // Failed Other

// Trading Status: one byte code
#define TRADING_STATUS_HALTED 0x48                               // Halted
#define TRADING_STATUS_HALTED_MATCHING_PARTITION_SUSPENDED 0x4A  // Halted Matching Partition Suspended
#define TRADING_STATUS_HALTED_SYSTEM_SUSPENDED 0x4B              // Halted System Suspended
#define TRADING_STATUS_HALTED_REGULATORY_HALT 0x50               // Halted Regulatory Halt
#define TRADING_STATUS_REGULAR_TRADING 0x54                      // Regular Trading
#define TRADING_STATUS_END_OF_REGULAR_TRADING 0x74               // End Of Regular Trading
#define TRADING_STATUS_CLOSED 0x63                               // Closed
#define TRADING_STATUS_SUSPENDED 0x32                            // Suspended
#define TRADING_STATUS_NO_ACTIVE_SESSION 0x77                    // No Active Session

// Event Code: one byte code
#define EVENT_CODE_END_OF_DAY 0x43    // End Of Day
#define EVENT_CODE_START_OF_DAY 0x4F  // Start Of Day

// Source Venue: 2 byte code
#define SOURCE_VENUE_TURQUOISE_LIT_ORDER_BOOK_T_G_H_L 0x0005                // Turquoise Lit Order Book TGHL
#define SOURCE_VENUE_TURQUOISE_DARK_ORDER_BOOK_T_G_H_L 0x0006               // Turquoise Dark Order Book TGHL
#define SOURCE_VENUE_TURQUOISE_PERIODIC_AUCTIONS_ORDER_BOOK_T_G_H_L 0x000C  // Turquoise Periodic Auctions Order Book TGHL
#define SOURCE_VENUE_TURQUOISE_LIT_ORDER_BOOK_T_G_H_E 0x000E                // Turquoise Lit Order Book TGHE
#define SOURCE_VENUE_TURQUOISE_DARK_ORDER_BOOK_T_G_H_E 0x000F               // Turquoise Dark Order Book TGHE
#define SOURCE_VENUE_TURQUOISE_PERIODIC_AUCTIONS_ORDER_BOOK_T_G_H_E 0x0010  // Turquoise Periodic Auctions Order Book TGHE

// Session Change Reason: one byte code
#define SESSION_CHANGE_REASON_SCHEDULED_TRANSITION 0x00          // Scheduled Transition
#define SESSION_CHANGE_REASON_EXTENDED_BY_MARKET_OPS 0x01        // Extended By Market Ops
#define SESSION_CHANGE_REASON_SHORTENED_BY_MARKET_OPS 0x02       // Shortened By Market Ops
#define SESSION_CHANGE_REASON_MARKET_ORDER_IMBALANCE 0x03        // Market Order Imbalance
#define SESSION_CHANGE_REASON_PRICE_OUTSIDE_RANGE 0x04           // Price Outside Range
#define SESSION_CHANGE_REASON_AESP_CIRCUIT_BREAKER_TRIPPED 0x05  // Aesp Circuit Breaker Tripped
#define SESSION_CHANGE_REASON_UNAVAILABLE 0x09                   // Unavailable

// Order Book Type: one byte code
#define ORDER_BOOK_TYPE_ELECTRONIC 0x03  // Electronic

// Trade Type: one byte code
#define TRADE_TYPE_REGULAR 0x00             // Regular
#define TRADE_TYPE_AUCTION_TRADE 0x02       // Auction Trade
#define TRADE_TYPE_TRADE_CANCELLATION 0x09  // Trade Cancellation

// Auction Type: one byte code
#define AUCTION_TYPE_FREQUENT_PERIODIC_AUCTIONS 0x4C  // Frequent Periodic Auctions

// Hidden Execution Indicator: one byte code
#define HIDDEN_EXECUTION_INDICATOR_NOT_APPLICABLE 0x00  // Not Applicable
#define HIDDEN_EXECUTION_INDICATOR_VISIBLE 0x01         // Visible
#define HIDDEN_EXECUTION_INDICATOR_HIDDEN 0x02          // Hidden

// Trade Qualifier: one byte code
#define TRADE_QUALIFIER_NOT_APPLICABLE 0x20  // Not Applicable
#define TRADE_QUALIFIER_TRADE_AT_LAST 0x54   // Trade At Last

// Cross Type: one byte code
#define CROSS_TYPE_INTERNAL_BTF 0x06   // Internal Btf
#define CROSS_TYPE_COMMITTED_BTF 0x08  // Committed Btf

// Statistic Type: 2 byte code
#define STATISTIC_TYPE_INDICATIVE_AUCTION_UNCROSSING_DATA 0x0001    // Indicative Auction Uncrossing Data
#define STATISTIC_TYPE_TRADE_HIGH_ON_BOOK 0x0004                    // Trade High On Book
#define STATISTIC_TYPE_TRADE_LOW_ON_BOOK 0x0005                     // Trade Low On Book
#define STATISTIC_TYPE_TRADE_HIGH_ALL_TRADES 0x0006                 // Trade High All Trades
#define STATISTIC_TYPE_TRADE_LOW_ALL_TRADES 0x0007                  // Trade Low All Trades
#define STATISTIC_TYPE_FIFTY_TWO_WEEK_TRADE_HIGH_ALL_TRADES 0x0008  // Fifty Two Week Trade High All Trades
#define STATISTIC_TYPE_FIFTY_TWO_WEEK_TRADE_LOW_ALL_TRADES 0x0009   // Fifty Two Week Trade Low All Trades

// Auction Info: one byte code
#define AUCTION_INFO_CALL_MARKET 0x4D  // Call Market

// Market Mechanism: one byte code
#define MARKET_MECHANISM_CENTRAL_LIMIT_ORDER_BOOK 0x31  // Central Limit Order Book
#define MARKET_MECHANISM_DARK_ORDER_BOOK 0x33           // Dark Order Book
#define MARKET_MECHANISM_PERIODIC_AUCTION 0x35          // Periodic Auction

// Trading Mode: one byte code
#define TRADING_MODE_UNSCHEDULED_AUCTION 0x55      // Unscheduled Auction
#define TRADING_MODE_ON_DEMAND_AUCTION 0x50        // On Demand Auction
#define TRADING_MODE_CONTINUOUS_TRADING 0x32       // Continuous Trading
#define TRADING_MODE_AT_MARKET_CLOSE_TRADING 0x33  // At Market Close Trading

// Transaction Category: one byte code
#define TRANSACTION_CATEGORY_DARK_TRADE 0x44  // Dark Trade
#define TRANSACTION_CATEGORY_NONE 0x2D        // None

// Negotiation Indicator: one byte code
#define NEGOTIATION_INDICATOR_NEGOTIATED_TRADE_WITH_PRE_TRADE_TRANSPARENCY_WAIVER 0x38  // Negotiated Trade With Pre Trade Transparency Waiver
#define NEGOTIATION_INDICATOR_NOT_A_NEGOTIATED_TRADE 0x2D                               // Not A Negotiated Trade

// Agency Cross Indicator: one byte code
#define AGENCY_CROSS_INDICATOR_NO_AGENCY_CROSS_TRADE 0x2D  // No Agency Cross Trade

// Modification Indicator: one byte code
#define MODIFICATION_INDICATOR_TRADE_CANCELLATION 0x43  // Trade Cancellation
#define MODIFICATION_INDICATOR_NEW_TRADE 0x2D           // New Trade

// Reference Price Indicator: one byte code
#define REFERENCE_PRICE_INDICATOR_REFERENCE_PRICE_TRADE 0x53                                 // Reference Price Trade
#define REFERENCE_PRICE_INDICATOR_MARKET_CLOSING_PRICE_TRADE 0x31                            // Market Closing Price Trade
#define REFERENCE_PRICE_INDICATOR_NOT_A_REFERENCE_PRICE_TRADE 0x2D                           // Not A Reference Price Trade
#define REFERENCE_PRICE_INDICATOR_REFERENCE_PRICE_TRADE_AND_MARKET_CLOSING_PRICE_TRADE 0x36  // Reference Price Trade And Market Closing Price Trade

// Special Dividend Indicator: one byte code
#define SPECIAL_DIVIDEND_INDICATOR_NO_SPECIAL_DIVIDEND_TRADE 0x2D  // No Special Dividend Trade

// Off Book Automated Indicator: one byte code
#define OFF_BOOK_AUTOMATED_INDICATOR_UNSPECIFIED_OR_DOES_NOT_APPLY 0x2D  // Unspecified Or Does Not Apply

// Price Formation Indicator: one byte code
#define PRICE_FORMATION_INDICATOR_PLAIN_VANILLA_TRADE 0x50  // Plain Vanilla Trade

// Algorithmic Indicator: one byte code
#define ALGORITHMIC_INDICATOR_ALGORITHMIC_TRADE 0x48         // Algorithmic Trade
#define ALGORITHMIC_INDICATOR_NOT_AN_ALGORITHMIC_TRADE 0x2D  // Not An Algorithmic Trade

// Post Trade Deferral Reason: one byte code
#define POST_TRADE_DEFERRAL_REASON_IMMEDIATE_PUBLICATION 0x2D  // Immediate Publication

// Deferral Enrichment Type: one byte code
#define DEFERRAL_ENRICHMENT_TYPE_NOT_APPLICABLE 0x2D  // Not Applicable

// Duplicative Indicator: one byte code
#define DUPLICATIVE_INDICATOR_UNIQUE_TRADE_REPORT 0x2D  // Unique Trade Report

// ---- Types -------------------------------------------------------------------

// Used by the client to log in to the replay or recovery channel.
typedef struct _LoginRequestMessage {
  UINT8 username[8];  // bytes 0 to 7
} LoginRequestMessage;

// Used by the client to request a retransmission of messages on the replay channel.
typedef struct _ReplayRequestMessage {
  UINT32 first_message;  // bytes 0 to 3
  UINT32 count;          // bytes 4 to 7
  UINT32 request_id;     // bytes 8 to 11
} ReplayRequestMessage;

// Used by the server to accept or reject a login request to the replay or recovery channel.
typedef struct _LoginResponseMessage {
  UINT8 login_status;  // byte 0
} LoginResponseMessage;

// Used by the server to respond to a retransmission request on the replay channel.
typedef struct _ReplayResponseMessage {
  UINT32 first_message;  // bytes 0 to 3
  UINT32 count;          // bytes 4 to 7
  UINT8 replay_status;   // byte 8
  UINT32 request_id;     // bytes 9 to 12
} ReplayResponseMessage;

// Used by the server to indicate the successful completion of servicing a message replay or a recovery request.
typedef struct _ReplayAndRecoveryCompleteMessage {
  UINT32 request_id;     // bytes 0 to 3
  UINT8 trading_status;  // byte 4
} ReplayAndRecoveryCompleteMessage;

// Sent to indicate the start and end of the day.
typedef struct _SystemEventMessage {
  UINT64 timestamp;     // bytes 0 to 7
  UINT8 event_code;     // byte 8
  UINT16 source_venue;  // bytes 9 to 10
} SystemEventMessage;

// Used to disseminate a common and limited set of data for all configured instrument types, except strategy instruments, on the real-time channels
typedef struct _InstrumentDirectoryMessage {
  UINT64 timestamp;                           // bytes 0 to 7
  UINT64 instrument;                          // bytes 8 to 15
  UINT8 isin[12];                             // bytes 16 to 27
  UINT8 unused_3 : 3;                         // byte 28
  UINT8 electronic_order_book : 1;            // byte 28
  UINT8 unused_4 : 4;                         // byte 28
  UINT16 source_venue;                        // bytes 29 to 30
  UINT8 venue_instrument_id[11];              // bytes 31 to 41
  UINT8 tick_id[2];                           // bytes 42 to 43
  UINT8 reserved_8[8];                        // bytes 44 to 51
  UINT64 dynamic_circuit_breaker_tolerances;  // bytes 52 to 59, signed, read here as unsigned
  UINT64 static_circuit_breaker_tolerances;   // bytes 60 to 67, signed, read here as unsigned
  UINT8 segment[6];                           // bytes 68 to 73
  UINT8 reserved_12[12];                      // bytes 74 to 85
  UINT8 security_exchange[11];                // bytes 86 to 96
  UINT8 currency[3];                          // bytes 97 to 99
  UINT8 partition_id;                         // byte 100
  UINT8 reserved_4[4];                        // bytes 101 to 104
  UINT64 average_daily_turnover_adt;          // bytes 105 to 112, signed, read here as unsigned
  UINT8 second_reserved_8[8];                 // bytes 113 to 120
  UINT8 reserved_1;                           // byte 121
  UINT8 third_reserved_8[8];                  // bytes 122 to 129
  UINT8 fourth_reserved_8[8];                 // bytes 130 to 137
} InstrumentDirectoryMessage;

// Used to communicate scheduled and unscheduled session changes
typedef struct _InstrumentStatusMessage {
  UINT64 timestamp;             // bytes 0 to 7
  UINT64 instrument;            // bytes 8 to 15
  UINT16 source_venue;          // bytes 16 to 17
  UINT8 trading_status;         // byte 18
  UINT8 session_change_reason;  // byte 19
  UINT8 new_end_time[6];        // bytes 20 to 25
  UINT8 order_book_type;        // byte 26
} InstrumentStatusMessage;

// Sent to instruct recipients to add a new displayable order to the retrospective order book
typedef struct _AddOrderIncrementalMessage {
  UINT64 timestamp;         // bytes 0 to 7
  UINT64 order_id;          // bytes 8 to 15
  UINT8 side;               // byte 16
  UINT64 size;              // bytes 17 to 24
  UINT64 instrument;        // bytes 25 to 32
  UINT64 price_price_8;     // bytes 33 to 40, signed, read here as unsigned
  UINT64 transaction_time;  // bytes 41 to 48
  UINT16 source_venue;      // bytes 49 to 50
  UINT8 order_book_type;    // byte 51
  UINT8 participant[11];    // bytes 52 to 62
  UINT8 order_type;         // byte 63
  UINT8 rfq_id[10];         // bytes 64 to 73
} AddOrderIncrementalMessage;

// Sent to instruct recipients to update an order's price and/or size on the retrospective order book
typedef struct _ModifyOrderMessage {
  UINT64 timestamp;          // bytes 0 to 7
  UINT64 order_id;           // bytes 8 to 15
  UINT64 instrument;         // bytes 16 to 23
  UINT8 side;                // byte 24
  UINT8 priority_flag : 1;   // byte 25
  UINT8 unused_7 : 7;        // byte 25
  UINT8 order_book_type;     // byte 26
  UINT64 new_quantity;       // bytes 27 to 34
  UINT64 new_price;          // bytes 35 to 42, signed, read here as unsigned
  UINT8 reserved_8[8];       // bytes 43 to 50
  UINT16 source_venue;       // bytes 51 to 52
  UINT64 previous_price;     // bytes 53 to 60, signed, read here as unsigned
  UINT64 previous_quantity;  // bytes 61 to 68
  UINT64 transaction_time;   // bytes 69 to 76
} ModifyOrderMessage;

// Sent to instruct recipients to delete an order from the retrospective order book
typedef struct _DeleteOrderMessage {
  UINT64 timestamp;          // bytes 0 to 7
  UINT64 order_id;           // bytes 8 to 15
  UINT64 instrument;         // bytes 16 to 23
  UINT8 side;                // byte 24
  UINT8 order_book_type;     // byte 25
  UINT16 source_venue;       // bytes 26 to 27
  UINT64 previous_price;     // bytes 28 to 35, signed, read here as unsigned
  UINT64 previous_quantity;  // bytes 36 to 43
  UINT64 transaction_time;   // bytes 44 to 51
} DeleteOrderMessage;

// Used to update the level 1 service following any change to the consolidated Best Bid and Offer
typedef struct _TopOfBookMessage {
  UINT64 timestamp;            // bytes 0 to 7
  UINT64 instrument;           // bytes 8 to 15
  UINT16 source_venue;         // bytes 16 to 17
  UINT64 bid_market_size;      // bytes 18 to 25
  UINT64 bid_limit_price;      // bytes 26 to 33, signed, read here as unsigned
  UINT8 reserved_8[8];         // bytes 34 to 41
  UINT64 bid_limit_size;       // bytes 42 to 49
  UINT64 offer_market_size;    // bytes 50 to 57
  UINT64 offer_limit_price;    // bytes 58 to 65, signed, read here as unsigned
  UINT8 second_reserved_8[8];  // bytes 66 to 73
  UINT64 offer_limit_size;     // bytes 74 to 81
  UINT8 order_book_type;       // byte 82
  UINT8 bid_depth : 1;         // byte 83
  UINT8 offer_depth : 1;       // byte 83
  UINT8 retail_lp : 1;         // byte 83
  UINT8 unused_5 : 5;          // byte 83
} TopOfBookMessage;

// Sent to instruct recipients to remove all orders from the order book for the specified instrument
typedef struct _OrderBookClearMessage {
  UINT64 timestamp;       // bytes 0 to 7
  UINT16 source_venue;    // bytes 8 to 9
  UINT64 instrument;      // bytes 10 to 17
  UINT8 order_book_type;  // byte 18
} OrderBookClearMessage;

// Sent to indicate trades executed on supported markets
typedef struct _TradeMessage {
  UINT64 timestamp;                   // bytes 0 to 7
  UINT64 transaction_time;            // bytes 8 to 15
  UINT16 source_venue;                // bytes 16 to 17
  UINT64 executed_size;               // bytes 18 to 25
  UINT64 instrument;                  // bytes 26 to 33
  UINT64 price_price_8;               // bytes 34 to 41, signed, read here as unsigned
  UINT8 venue_of_execution_u_int_81;  // byte 42
  UINT8 reserved_1;                   // byte 43
  UINT8 reserved_2[2];                // bytes 44 to 45
  UINT8 reserved_4[4];                // bytes 46 to 49
  UINT64 trade_id;                    // bytes 50 to 57
  UINT8 trade_type;                   // byte 58
  UINT8 auction_type;                 // byte 59
  UINT8 trade_cancellation : 1;       // byte 60
  UINT8 unused_7 : 7;                 // byte 60
  UINT8 hidden_execution_indicator;   // byte 61
  UINT8 trade_qualifier;              // byte 62
} TradeMessage;

// Sent to indicate a cross trade execution
typedef struct _TradeCrossMessage {
  UINT64 timestamp;              // bytes 0 to 7
  UINT64 transaction_time;       // bytes 8 to 15
  UINT16 source_venue;           // bytes 16 to 17
  UINT64 executed_size;          // bytes 18 to 25
  UINT64 instrument;             // bytes 26 to 33
  UINT64 price_price_8;          // bytes 34 to 41, signed, read here as unsigned
  UINT8 reserved_8[8];           // bytes 42 to 49
  UINT64 trade_id;               // bytes 50 to 57
  UINT8 cross_id[20];            // bytes 58 to 77
  UINT8 cross_type;              // byte 78
  UINT8 trade_cancellation : 1;  // byte 79
  UINT8 unused_7 : 7;            // byte 79
} TradeCrossMessage;

// Contains a set of statistics that are updated frequently, usually as a result of executions
typedef struct _StatisticsMessage {
  UINT64 timestamp;                      // bytes 0 to 7
  UINT64 instrument;                     // bytes 8 to 15
  UINT16 source_venue;                   // bytes 16 to 17
  UINT64 volume;                         // bytes 18 to 25
  UINT64 volume_on_book_only;            // bytes 26 to 33
  UINT64 vwap;                           // bytes 34 to 41, signed, read here as unsigned
  UINT64 vwap_on_book_only;              // bytes 42 to 49, signed, read here as unsigned
  UINT32 number_of_trades;               // bytes 50 to 53
  UINT32 number_of_trades_on_book_only;  // bytes 54 to 57
  UINT64 turnover;                       // bytes 58 to 65, signed, read here as unsigned
  UINT64 turnover_on_book_only;          // bytes 66 to 73, signed, read here as unsigned
} StatisticsMessage;

// Contains a set of statistics that are not updated frequently
typedef struct _StatisticsUpdateMessage {
  UINT64 timestamp;                       // bytes 0 to 7
  UINT64 instrument;                      // bytes 8 to 15
  UINT16 source_venue;                    // bytes 16 to 17
  UINT16 statistic_type;                  // bytes 18 to 19
  UINT64 statistic_price;                 // bytes 20 to 27, signed, read here as unsigned
  UINT64 statistic_size;                  // bytes 28 to 35
  UINT8 auction_type;                     // byte 36
  UINT64 imbalance_quantity;              // bytes 37 to 44
  UINT8 auction_info;                     // byte 45
  UINT8 opening_closing_price_indicator;  // byte 46
} StatisticsUpdateMessage;

// Sent to represent different types of MiFID compliant trades published by markets
typedef struct _MifidIiTradeMessage {
  UINT64 timestamp;                              // bytes 0 to 7
  UINT16 source_venue;                           // bytes 8 to 9
  UINT64 instrument;                             // bytes 10 to 17
  UINT8 transaction_identification_code[52];     // bytes 18 to 69
  UINT8 trade_type;                              // byte 70
  UINT8 auction_type;                            // byte 71
  UINT8 mi_fid_price[20];                        // bytes 72 to 91
  UINT8 mi_fid_quantity[20];                     // bytes 92 to 111
  UINT8 trading_date_and_time[30];               // bytes 112 to 141
  UINT8 instrument_identification_code_type[4];  // bytes 142 to 145
  UINT8 instrument_identification_code[12];      // bytes 146 to 157
  UINT8 price_notation[4];                       // bytes 158 to 161
  UINT8 price_major_currency[3];                 // bytes 162 to 164
  UINT8 notional_amount[20];                     // bytes 165 to 184
  UINT8 notional_currency[3];                    // bytes 185 to 187
  UINT8 venue_of_execution_alpha_4[4];           // bytes 188 to 191
  UINT8 publication_date_and_time[30];           // bytes 192 to 221
  UINT8 pt_ref_price_waiver_flag[4];             // bytes 222 to 225
  UINT8 trading_system[4];                       // bytes 226 to 229
  UINT8 market_closing_price_flag[4];            // bytes 230 to 233
  UINT8 pt_algo_trade[4];                        // bytes 234 to 237
  UINT8 pt_cancellation_flag[4];                 // bytes 238 to 241
  UINT8 pt_amendment_flag[4];                    // bytes 242 to 245
  UINT8 reserved_1;                              // byte 246
  UINT8 reserved_3[3];                           // bytes 247 to 249
  UINT8 reserved_20[20];                         // bytes 250 to 269
  UINT8 reserved_4[4];                           // bytes 270 to 273
  UINT8 trade_qualifier;                         // byte 274
  UINT8 market_mechanism;                        // byte 275
  UINT8 trading_mode;                            // byte 276
  UINT8 transaction_category;                    // byte 277
  UINT8 negotiation_indicator;                   // byte 278
  UINT8 agency_cross_indicator;                  // byte 279
  UINT8 modification_indicator;                  // byte 280
  UINT8 reference_price_indicator;               // byte 281
  UINT8 special_dividend_indicator;              // byte 282
  UINT8 off_book_automated_indicator;            // byte 283
  UINT8 price_formation_indicator;               // byte 284
  UINT8 algorithmic_indicator;                   // byte 285
  UINT8 post_trade_deferral_reason;              // byte 286
  UINT8 deferral_enrichment_type;                // byte 287
  UINT8 duplicative_indicator;                   // byte 288
} MifidIiTradeMessage;

// Sent to indicate a MiFID compliant cross trade
typedef struct _MifidIiTradeCrossMessage {
  UINT64 timestamp;                              // bytes 0 to 7
  UINT16 source_venue;                           // bytes 8 to 9
  UINT64 instrument;                             // bytes 10 to 17
  UINT8 transaction_identification_code[52];     // bytes 18 to 69
  UINT8 cross_id[20];                            // bytes 70 to 89
  UINT8 cross_type;                              // byte 90
  UINT8 mi_fid_price[20];                        // bytes 91 to 110
  UINT8 mi_fid_quantity[20];                     // bytes 111 to 130
  UINT8 trading_date_and_time[30];               // bytes 131 to 160
  UINT8 instrument_identification_code_type[4];  // bytes 161 to 164
  UINT8 instrument_identification_code[12];      // bytes 165 to 176
  UINT8 price_notation[4];                       // bytes 177 to 180
  UINT8 price_major_currency[3];                 // bytes 181 to 183
  UINT8 notional_amount[20];                     // bytes 184 to 203
  UINT8 notional_currency[3];                    // bytes 204 to 206
  UINT8 venue_of_execution_alpha_4[4];           // bytes 207 to 210
  UINT8 publication_date_and_time[30];           // bytes 211 to 240
  UINT8 reserved_4[4];                           // bytes 241 to 244
  UINT8 nt_pre_trade_waiver_flag[4];             // bytes 245 to 248
  UINT8 pt_algo_trade[4];                        // bytes 249 to 252
  UINT8 second_reserved_4[4];                    // bytes 253 to 256
  UINT8 pt_cancellation_flag[4];                 // bytes 257 to 260
  UINT8 pt_amendment_flag[4];                    // bytes 261 to 264
  UINT8 reserved_1;                              // byte 265
  UINT8 reserved_3[3];                           // bytes 266 to 268
  UINT8 reserved_20[20];                         // bytes 269 to 288
  UINT8 trading_system[4];                       // bytes 289 to 292
  UINT8 market_mechanism;                        // byte 293
  UINT8 trading_mode;                            // byte 294
  UINT8 transaction_category;                    // byte 295
  UINT8 negotiation_indicator;                   // byte 296
  UINT8 agency_cross_indicator;                  // byte 297
  UINT8 modification_indicator;                  // byte 298
  UINT8 reference_price_indicator;               // byte 299
  UINT8 special_dividend_indicator;              // byte 300
  UINT8 off_book_automated_indicator;            // byte 301
  UINT8 price_formation_indicator;               // byte 302
  UINT8 algorithmic_indicator;                   // byte 303
  UINT8 post_trade_deferral_reason;              // byte 304
  UINT8 deferral_enrichment_type;                // byte 305
  UINT8 duplicative_indicator;                   // byte 306
} MifidIiTradeCrossMessage;

// Trade Summary message is used to disseminate results of multi and single fill trade events
typedef struct _TradeSummaryMessage {
  UINT64 timestamp;                       // bytes 0 to 7
  UINT64 instrument;                      // bytes 8 to 15
  UINT16 source_venue;                    // bytes 16 to 17
  UINT64 transaction_time;                // bytes 18 to 25
  UINT64 far_price;                       // bytes 26 to 33, signed, read here as unsigned
  UINT64 total_executed_quantity;         // bytes 34 to 41
  UINT64 total_hidden_executed_quantity;  // bytes 42 to 49
  UINT64 deleted_order_quantity;          // bytes 50 to 57
  UINT8 side;                             // byte 58
  UINT64 best_bid_size;                   // bytes 59 to 66, signed, read here as unsigned
  UINT64 best_bid_price;                  // bytes 67 to 74, signed, read here as unsigned
  UINT64 best_offer_size;                 // bytes 75 to 82, signed, read here as unsigned
  UINT64 best_offer_price;                // bytes 83 to 90, signed, read here as unsigned
} TradeSummaryMessage;

// Used to disseminate additional statistics including order book activity statistics
typedef struct _AnalyticsMessage {
  UINT64 timestamp;                        // bytes 0 to 7
  UINT64 instrument;                       // bytes 8 to 15
  UINT16 source_venue;                     // bytes 16 to 17
  UINT64 start_time;                       // bytes 18 to 25
  UINT64 end_time;                         // bytes 26 to 33
  UINT32 buy_order_count;                  // bytes 34 to 37
  UINT32 sell_order_count;                 // bytes 38 to 41
  UINT64 buy_order_size;                   // bytes 42 to 49
  UINT64 sell_order_size;                  // bytes 50 to 57
  UINT32 buy_order_cancellations;          // bytes 58 to 61
  UINT32 sell_order_cancellations;         // bytes 62 to 65
  UINT32 buy_limit_order_cancellations;    // bytes 66 to 69
  UINT32 buy_market_order_cancellations;   // bytes 70 to 73
  UINT32 sell_limit_order_cancellations;   // bytes 74 to 77
  UINT32 sell_market_order_cancellations;  // bytes 78 to 81
  UINT64 bid_ask_spread;                   // bytes 82 to 89, signed, read here as unsigned
  UINT64 vwap_buy;                         // bytes 90 to 97, signed, read here as unsigned
  UINT64 vwap_sell;                        // bytes 98 to 105, signed, read here as unsigned
} AnalyticsMessage;

// Aggregated order book price level update published on the MiFID II Pre Trade service
typedef struct _MifidIiOrderBookUpdateMessage {
  UINT64 timestamp;                              // bytes 0 to 7
  UINT64 instrument;                             // bytes 8 to 15
  UINT16 source_venue;                           // bytes 16 to 17
  UINT8 level_identifier;                        // byte 18
  UINT8 update_date_and_time[30];                // bytes 19 to 48
  UINT8 instrument_identification_code[12];      // bytes 49 to 60
  UINT8 order_book_side[4];                      // bytes 61 to 64
  UINT8 price_mi_fid_decimal_20[20];             // bytes 65 to 84
  UINT8 price_currency[3];                       // bytes 85 to 87
  UINT8 price_notation[4];                       // bytes 88 to 91
  UINT8 quantity[20];                            // bytes 92 to 111
  UINT8 aggregated_no_of_orders_and_quotes[20];  // bytes 112 to 131
  UINT8 venue[4];                                // bytes 132 to 135
  UINT8 trading_system[4];                       // bytes 136 to 139
  UINT8 trading_system_phase[4];                 // bytes 140 to 143
  UINT8 publication_date_and_time[30];           // bytes 144 to 173
  UINT8 last_price_level : 1;                    // byte 174
  UINT8 unused_7 : 7;                            // byte 174
} MifidIiOrderBookUpdateMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: LoginRequestMessage login_request_message;
    case 0x03: ReplayRequestMessage replay_request_message;
    case 0x02: LoginResponseMessage login_response_message;
    case 0x04: ReplayResponseMessage replay_response_message;
    case 0x83: ReplayAndRecoveryCompleteMessage replay_and_recovery_complete_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x70: InstrumentDirectoryMessage instrument_directory_message;
    case 0x48: InstrumentStatusMessage instrument_status_message;
    case 0x46: AddOrderIncrementalMessage add_order_incremental_message;
    case 0x55: ModifyOrderMessage modify_order_message;
    case 0x44: DeleteOrderMessage delete_order_message;
    case 0x69: TopOfBookMessage top_of_book_message;
    case 0x79: OrderBookClearMessage order_book_clear_message;
    case 0x50: TradeMessage trade_message;
    case 0x71: TradeCrossMessage trade_cross_message;
    case 0x77: StatisticsMessage statistics_message;
    case 0x6A: StatisticsUpdateMessage statistics_update_message;
    case 0x51: MifidIiTradeMessage mifid_ii_trade_message;
    case 0x56: MifidIiTradeCrossMessage mifid_ii_trade_cross_message;
    case 0x57: TradeSummaryMessage trade_summary_message;
    case 0x61: AnalyticsMessage analytics_message;
    case 0x62: MifidIiOrderBookUpdateMessage mifid_ii_order_book_update_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Gtp Tcp Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_length { message_length >= 3 };                                                                                                                   // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 3)) payload[:byte-size-single-element-array (((UINT32) message_length) - 3)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// One unit on the tcp stream: the unit header and its payload messages
typedef struct _TcpUnit (mutable UINT32 * tally) {
  UINT16 length { length >= 8 };                                                                                            // bytes 0 to 1
  UINT8 message_count;                                                                                                      // byte 2
  UINT8 market_data_group;                                                                                                  // byte 3
  UINT32 sequence_number;                                                                                                   // bytes 4 to 7
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (((UINT32) length) - 8)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} TcpUnit;

// ---- Packet: Packet ----------------------------------------------------------

// Gtp Tcp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) {
  TcpUnit(tally) tcp_unit[:byte-size available];
} Packet;

