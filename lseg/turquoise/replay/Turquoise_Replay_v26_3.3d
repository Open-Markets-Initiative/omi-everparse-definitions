// ---- Unit Header: 8 bytes ----------------------------------------------------

// Gtp Tcp Unit Header
entrypoint typedef struct _UnitHeader {
  UINT16 length;            // bytes 0 to 1
  UINT8 message_count;      // byte 2
  UINT8 market_data_group;  // byte 3
  UINT32 sequence_number;   // bytes 4 to 7
} UnitHeader;

// ---- Message Header: 3 bytes -------------------------------------------------

// Gtp Tcp Message Header
entrypoint typedef struct _MessageHeader {
  UINT16 message_length;  // bytes 0 to 1
  UINT8 message_type;     // byte 2
} MessageHeader;

// ---- Login Request Message: 8 bytes ------------------------------------------

// Used by the client to log in to the replay or recovery channel.
entrypoint typedef struct _LoginRequestMessage {
  UINT8 username[8];  // bytes 0 to 7
} LoginRequestMessage;

// ---- Replay Request Message: 12 bytes ----------------------------------------

// Used by the client to request a retransmission of messages on the replay channel.
entrypoint typedef struct _ReplayRequestMessage {
  UINT32 first_message;  // bytes 0 to 3
  UINT32 count;          // bytes 4 to 7
  UINT32 request_id;     // bytes 8 to 11
} ReplayRequestMessage;

// ---- Login Response Message: 1 byte ------------------------------------------

// Used by the server to accept or reject a login request to the replay or recovery channel.
entrypoint typedef struct _LoginResponseMessage {
  UINT8 login_status;  // byte 0
} LoginResponseMessage;

// ---- Replay Response Message: 13 bytes ---------------------------------------

// Used by the server to respond to a retransmission request on the replay channel.
entrypoint typedef struct _ReplayResponseMessage {
  UINT32 first_message;  // bytes 0 to 3
  UINT32 count;          // bytes 4 to 7
  UINT8 replay_status;   // byte 8
  UINT32 request_id;     // bytes 9 to 12
} ReplayResponseMessage;

// ---- Replay And Recovery Complete Message: 5 bytes ---------------------------

// Used by the server to indicate the successful completion of servicing a message replay or a recovery request.
entrypoint typedef struct _ReplayAndRecoveryCompleteMessage {
  UINT32 request_id;     // bytes 0 to 3
  UINT8 trading_status;  // byte 4
} ReplayAndRecoveryCompleteMessage;

// ---- System Event Message: 11 bytes ------------------------------------------

// Sent to indicate the start and end of the day.
entrypoint typedef struct _SystemEventMessage {
  UINT64 timestamp;     // bytes 0 to 7
  UINT8 event_code;     // byte 8
  UINT16 source_venue;  // bytes 9 to 10
} SystemEventMessage;

// ---- Instrument Status Message: 27 bytes -------------------------------------

// Used to communicate scheduled and unscheduled session changes
entrypoint typedef struct _InstrumentStatusMessage {
  UINT64 timestamp;             // bytes 0 to 7
