// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53           // System Event Message
#define MESSAGE_TYPE_INSTRUMENT_DIRECTORY_MESSAGE 0x70   // Instrument Directory Message
#define MESSAGE_TYPE_INSTRUMENT_STATUS_MESSAGE 0x48      // Instrument Status Message
#define MESSAGE_TYPE_MIFID_II_TRADE_MESSAGE 0x51         // Mifid Ii Trade Message
#define MESSAGE_TYPE_MI_FID_II_TRADE_CROSS_MESSAGE 0x56  // Mi Fid Ii Trade Cross Message

// Event Code: one byte code
#define EVENT_CODE_END_OF_DAY 0x43    // End Of Day
#define EVENT_CODE_START_OF_DAY 0x4F  // Start Of Day

// Source Venue: 2 byte code
#define SOURCE_VENUE_TURQUOISE_LIT_ORDER_BOOK_T_G_H_L 0x0005                 // Turquoise Lit Order Book TGHL
#define SOURCE_VENUE_TURQUOISE_PLATO_ORDER_BOOK_T_G_H_L 0x0006               // Turquoise Plato Order Book TGHL
#define SOURCE_VENUE_TURQUOISE_PLATO_LIT_AUCTIONS_ORDER_BOOK_T_G_H_L 0x000C  // Turquoise Plato Lit Auctions Order Book TGHL
#define SOURCE_VENUE_TURQUOISE_LIT_ORDER_BOOK_T_G_H_E 0x000E                 // Turquoise Lit Order Book TGHE
#define SOURCE_VENUE_TURQUOISE_PLATO_ORDER_BOOK_T_G_H_E 0x000F               // Turquoise Plato Order Book TGHE
#define SOURCE_VENUE_TURQUOISE_PLATO_LIT_AUCTIONS_ORDER_BOOK_T_G_H_E 0x0010  // Turquoise Plato Lit Auctions Order Book TGHE

// Trading Status: one byte code
#define TRADING_STATUS_HALTED 0x48                                      // Halted
#define TRADING_STATUS_HALTED_MATCHING_PARTITION_SUSPENDED 0x4A         // Halted Matching Partition Suspended
#define TRADING_STATUS_HALTED_SYSTEM_SUSPENDED 0x4B                     // Halted System Suspended
#define TRADING_STATUS_HALTED_REGULATORY_HALT 0x50                      // Halted Regulatory Halt
#define TRADING_STATUS_REGULAR_TRADING_START_OF_TRQB_SESSION 0x54       // Regular Trading Start Of Trqb Session
#define TRADING_STATUS_END_OF_REGULAR_TRADING_END_OF_TRQB_SESSION 0x74  // End Of Regular Trading End Of Trqb Session
#define TRADING_STATUS_CLOSED 0x63                                      // Closed
#define TRADING_STATUS_SUSPENDED 0x32                                   // Suspended
#define TRADING_STATUS_NO_ACTIVE_SESSION 0x77                           // No Active Session

// Session Change Reason: one byte code
#define SESSION_CHANGE_REASON_SCHEDULED_TRANSITION 0x00          // Scheduled Transition
#define SESSION_CHANGE_REASON_EXTENDED_BY_MARKET_OPS 0x01        // Extended By Market Ops
#define SESSION_CHANGE_REASON_SHORTENED_BY_MARKET_OPS 0x02       // Shortened By Market Ops
#define SESSION_CHANGE_REASON_MARKET_ORDER_IMBALANCE 0x03        // Market Order Imbalance
#define SESSION_CHANGE_REASON_PRICE_OUTSIDE_RANGE 0x04           // Price Outside Range
#define SESSION_CHANGE_REASON_AESP_CIRCUIT_BREAKER_TRIPPED 0x05  // Aesp Circuit Breaker Tripped
#define SESSION_CHANGE_REASON_UNAVAILABLE 0x09                   // Unavailable

// Order Book Type: one byte code
#define ORDER_BOOK_TYPE_ELECTRONIC 0x03  // Electronic

// Trade Type: one byte code
#define TRADE_TYPE_REGULAR 0x00             // Regular
#define TRADE_TYPE_AUCTION_TRADE 0x02       // Auction Trade
#define TRADE_TYPE_TRADE_CANCELLATION 0x09  // Trade Cancellation

// Trade Qualifier: one byte code
#define TRADE_QUALIFIER_NOT_AVAILABLE 0x20  // Not Available
#define TRADE_QUALIFIER_TRADE_AT_LAST 0x54  // Trade At Last

// Market Mechanism: one byte code
#define MARKET_MECHANISM_CENTRAL_LIMIT_ORDER_BOOK 0x31  // Central Limit Order Book
#define MARKET_MECHANISM_DARK_ORDER_BOOK 0x33           // Dark Order Book
#define MARKET_MECHANISM_PERIODIC_AUCTION 0x35          // Periodic Auction

// Trading Mode: one byte code
#define TRADING_MODE_UNSCHEDULED_AUCTION 0x55      // Unscheduled Auction
#define TRADING_MODE_ON_DEMAND_AUCTION 0x50        // On Demand Auction
#define TRADING_MODE_CONTINUOUS_TRADING 0x32       // Continuous Trading
#define TRADING_MODE_AT_MARKET_CLOSE_TRADING 0x33  // At Market Close Trading

// Transaction Category: one byte code
#define TRANSACTION_CATEGORY_DARK_TRADE 0x44  // Dark Trade
#define TRANSACTION_CATEGORY_NONE 0x2D        // None

// Negotiation Indicator: one byte code
#define NEGOTIATION_INDICATOR_NEGOTIATED_TRADE_WITH_PRE_TRADE_TRANSPARENCY_WAIVER 0x38  // Negotiated Trade With Pre Trade Transparency Waiver
#define NEGOTIATION_INDICATOR_NOT_A_NEGOTIATED_TRADE 0x2D                               // Not A Negotiated Trade

// Agency Cross Indicator: one byte code
#define AGENCY_CROSS_INDICATOR_NO_AGENCY_CROSS_TRADE 0x2D  // No Agency Cross Trade

// Modification Indicator: one byte code
#define MODIFICATION_INDICATOR_TRADE_CANCELLATION 0x43  // Trade Cancellation
#define MODIFICATION_INDICATOR_TRADE_AMENDMENT 0x41     // Trade Amendment
#define MODIFICATION_INDICATOR_NEW_TRADE 0x2D           // New Trade

// Reference Price Indicator: one byte code
#define REFERENCE_PRICE_INDICATOR_REFERENCE_PRICE_TRADE 0x53        // Reference Price Trade
#define REFERENCE_PRICE_INDICATOR_MARKET_CLOSING_PRICE_TRADE 0x31   // Market Closing Price Trade
#define REFERENCE_PRICE_INDICATOR_NOT_A_REFERENCE_PRICE_TRADE 0x2D  // Not A Reference Price Trade

// Special Dividend Indicator: one byte code
#define SPECIAL_DIVIDEND_INDICATOR_NO_SPECIAL_DIVIDEND_TRADE 0x2D  // No Special Dividend Trade

// Off Book Automated Indicator: one byte code
#define OFF_BOOK_AUTOMATED_INDICATOR_UNSPECIFIED_OR_DOES_NOT_APPLY 0x2D  // Unspecified Or Does Not Apply

// Price Formation Indicator: one byte code
#define PRICE_FORMATION_INDICATOR_PLAIN_VANILLA_TRADE 0x50  // Plain Vanilla Trade

// Algorithmic Indicator: one byte code
#define ALGORITHMIC_INDICATOR_ALGORITHMIC_TRADE 0x48         // Algorithmic Trade
#define ALGORITHMIC_INDICATOR_NOT_AN_ALGORITHMIC_TRADE 0x2D  // Not An Algorithmic Trade

// Post Trade Deferral Reason: one byte code
#define POST_TRADE_DEFERRAL_REASON_IMMEDIATE_PUBLICATION 0x2D  // Immediate Publication

// Deferral Enrichment Type: one byte code
#define DEFERRAL_ENRICHMENT_TYPE_NOT_APPLICABLE 0x2D  // Not Applicable

// Duplicative Indicator: one byte code
#define DUPLICATIVE_INDICATOR_UNIQUE_TRADE_REPORT 0x2D  // Unique Trade Report

// Cross Type: one byte code
#define CROSS_TYPE_INTERNAL_BTF 0x06   // Internal Btf
#define CROSS_TYPE_COMMITTED_BTF 0x08  // Committed Btf

// ---- Types -------------------------------------------------------------------

// Sent to indicate the start and end of the day.
typedef struct _SystemEventMessage {
  UINT64 timestamp;     // bytes 0 to 7
  UINT8 event_code;     // byte 8
  UINT16 source_venue;  // bytes 9 to 10
} SystemEventMessage;

// Used to disseminate a common and limited set of data for all configured instrument types, except strategy instruments, on the real-time channels
typedef struct _InstrumentDirectoryMessage {
  UINT64 timestamp;                           // bytes 0 to 7
  UINT64 instrument;                          // bytes 8 to 15
  UINT8 isin[12];                             // bytes 16 to 27
  UINT8 unused_3 : 3;                         // byte 28
  UINT8 electronic_order_book : 1;            // byte 28
  UINT8 unused_4 : 4;                         // byte 28
  UINT16 source_venue;                        // bytes 29 to 30
  UINT8 venue_instrument_id[11];              // bytes 31 to 41
  UINT8 tick_id[2];                           // bytes 42 to 43
  UINT64 price_band_tolerances;               // bytes 44 to 51, signed, read here as unsigned
  UINT64 dynamic_circuit_breaker_tolerances;  // bytes 52 to 59, signed, read here as unsigned
  UINT64 static_circuit_breaker_tolerances;   // bytes 60 to 67, signed, read here as unsigned
  UINT8 segment[6];                           // bytes 68 to 73
  UINT8 reserved_12[12];                      // bytes 74 to 85
  UINT8 reserved_11[11];                      // bytes 86 to 96
  UINT8 currency[3];                          // bytes 97 to 99
  UINT8 reserved_1;                           // byte 100
  UINT8 reserved_4[4];                        // bytes 101 to 104
  UINT64 average_daily_turnover_adt;          // bytes 105 to 112, signed, read here as unsigned
  UINT8 reserved_8[8];                        // bytes 113 to 120
  UINT8 second_reserved_1;                    // byte 121
  UINT8 second_reserved_8[8];                 // bytes 122 to 129
  UINT8 third_reserved_8[8];                  // bytes 130 to 137
} InstrumentDirectoryMessage;

// Used to communicate scheduled and unscheduled session changes
typedef struct _InstrumentStatusMessage {
  UINT64 timestamp;             // bytes 0 to 7
  UINT64 instrument;            // bytes 8 to 15
  UINT16 source_venue;          // bytes 16 to 17
  UINT8 trading_status;         // byte 18
  UINT8 session_change_reason;  // byte 19
  UINT8 new_end_time[6];        // bytes 20 to 25
  UINT8 order_book_type;        // byte 26
} InstrumentStatusMessage;

// Sent to represent different types of MiFID compliant trades published by markets
typedef struct _MifidIiTradeMessage {
  UINT64 timestamp;                              // bytes 0 to 7
  UINT16 source_venue;                           // bytes 8 to 9
  UINT64 instrument;                             // bytes 10 to 17
  UINT8 transaction_identification_code[52];     // bytes 18 to 69
  UINT8 trade_type;                              // byte 70
  UINT8 auction_type;                            // byte 71
  UINT8 mi_fid_price[20];                        // bytes 72 to 91
  UINT8 mi_fid_quantity[20];                     // bytes 92 to 111
  UINT8 trading_date_and_time[27];               // bytes 112 to 138
  UINT8 instrument_identification_code_type[4];  // bytes 139 to 142
  UINT8 instrument_identification_code[12];      // bytes 143 to 154
  UINT8 price_notation[4];                       // bytes 155 to 158
  UINT8 price_major_currency[3];                 // bytes 159 to 161
  UINT8 notional_amount[20];                     // bytes 162 to 181
  UINT8 notional_currency[3];                    // bytes 182 to 184
  UINT8 venue_of_execution[4];                   // bytes 185 to 188
  UINT8 publication_date_and_time[27];           // bytes 189 to 215
  UINT8 pt_ref_price_waiver_flag[4];             // bytes 216 to 219
  UINT8 reserved_4[4];                           // bytes 220 to 223
  UINT8 market_closing_price_flag[4];            // bytes 224 to 227
  UINT8 pt_algo_trade[4];                        // bytes 228 to 231
  UINT8 pt_cancellation_flag[4];                 // bytes 232 to 235
  UINT8 pt_amendment_flag[4];                    // bytes 236 to 239
  UINT8 reserved_1;                              // byte 240
  UINT8 reserved_3[3];                           // bytes 241 to 243
  UINT8 reserved_20[20];                         // bytes 244 to 263
  UINT8 second_reserved_4[4];                    // bytes 264 to 267
  UINT8 trade_qualifier;                         // byte 268
  UINT8 market_mechanism;                        // byte 269
  UINT8 trading_mode;                            // byte 270
  UINT8 transaction_category;                    // byte 271
  UINT8 negotiation_indicator;                   // byte 272
  UINT8 agency_cross_indicator;                  // byte 273
  UINT8 modification_indicator;                  // byte 274
  UINT8 reference_price_indicator;               // byte 275
  UINT8 special_dividend_indicator;              // byte 276
  UINT8 off_book_automated_indicator;            // byte 277
  UINT8 price_formation_indicator;               // byte 278
  UINT8 algorithmic_indicator;                   // byte 279
  UINT8 post_trade_deferral_reason;              // byte 280
  UINT8 deferral_enrichment_type;                // byte 281
  UINT8 duplicative_indicator;                   // byte 282
} MifidIiTradeMessage;

// Sent to indicate a MiFID compliant cross trade
typedef struct _MiFidIiTradeCrossMessage {
  UINT64 timestamp;                              // bytes 0 to 7
  UINT16 source_venue;                           // bytes 8 to 9
  UINT64 instrument;                             // bytes 10 to 17
  UINT8 transaction_identification_code[52];     // bytes 18 to 69
  UINT8 cross_id[20];                            // bytes 70 to 89
  UINT8 cross_type;                              // byte 90
  UINT8 mi_fid_price[20];                        // bytes 91 to 110
  UINT8 mi_fid_quantity[20];                     // bytes 111 to 130
  UINT8 trading_date_and_time[27];               // bytes 131 to 157
  UINT8 instrument_identification_code_type[4];  // bytes 158 to 161
  UINT8 instrument_identification_code[12];      // bytes 162 to 173
  UINT8 price_notation[4];                       // bytes 174 to 177
  UINT8 price_major_currency[3];                 // bytes 178 to 180
  UINT8 notional_amount[20];                     // bytes 181 to 200
  UINT8 notional_currency[3];                    // bytes 201 to 203
  UINT8 venue_of_execution[4];                   // bytes 204 to 207
  UINT8 publication_date_and_time[27];           // bytes 208 to 234
  UINT8 reserved_4[4];                           // bytes 235 to 238
  UINT8 nt_pre_trade_waiver_flag[4];             // bytes 239 to 242
  UINT8 pt_algo_trade[4];                        // bytes 243 to 246
  UINT8 second_reserved_4[4];                    // bytes 247 to 250
  UINT8 pt_cancellation_flag[4];                 // bytes 251 to 254
  UINT8 pt_amendment_flag[4];                    // bytes 255 to 258
  UINT8 reserved_1;                              // byte 259
  UINT8 reserved_3[3];                           // bytes 260 to 262
  UINT8 reserved_20[20];                         // bytes 263 to 282
  UINT8 third_reserved_4[4];                     // bytes 283 to 286
  UINT8 market_mechanism;                        // byte 287
  UINT8 trading_mode;                            // byte 288
  UINT8 transaction_category;                    // byte 289
  UINT8 negotiation_indicator;                   // byte 290
  UINT8 agency_cross_indicator;                  // byte 291
  UINT8 modification_indicator;                  // byte 292
  UINT8 reference_price_indicator;               // byte 293
  UINT8 special_dividend_indicator;              // byte 294
  UINT8 off_book_automated_indicator;            // byte 295
  UINT8 price_formation_indicator;               // byte 296
  UINT8 algorithmic_indicator;                   // byte 297
  UINT8 post_trade_deferral_reason;              // byte 298
  UINT8 deferral_enrichment_type;                // byte 299
  UINT8 duplicative_indicator;                   // byte 300
} MiFidIiTradeCrossMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x53: SystemEventMessage system_event_message;
    case 0x70: InstrumentDirectoryMessage instrument_directory_message;
    case 0x48: InstrumentStatusMessage instrument_status_message;
    case 0x51: MifidIiTradeMessage mifid_ii_trade_message;
    case 0x56: MiFidIiTradeCrossMessage mi_fid_ii_trade_cross_message;
    default: UINT8 unknown[available];
  }
} Payload;

typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_length { message_length >= 3 };                                                                                                                   // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 3)) payload[:byte-size-single-element-array (((UINT32) message_length) - 3)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Gtp Udp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 8) {
  UINT16 length;                                                                                                            // bytes 0 to 1
  UINT8 message_count;                                                                                                      // byte 2
  UINT8 market_data_group;                                                                                                  // byte 3
  UINT32 sequence_number;                                                                                                   // bytes 4 to 7
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 8)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} Packet;

