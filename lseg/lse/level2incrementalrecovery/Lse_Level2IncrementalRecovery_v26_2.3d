  UINT64 dynamic_circuit_breaker_tolerances;      // bytes 77 to 84, signed, read here as unsigned
  UINT64 static_circuit_breaker_tolerances;       // bytes 85 to 92, signed, read here as unsigned
  UINT8 first_reserved_1;                         // byte 93
  UINT8 second_reserved_1;                        // byte 94
  UINT8 expiration_date[8];                       // bytes 95 to 102
  UINT8 listing_start_date[8];                    // bytes 103 to 110
  UINT8 listing_end_date[8];                      // bytes 111 to 118
  UINT64 minimum_lot_minimum_execution_size;      // bytes 119 to 126
  UINT64 last_price_in_preceding_session;         // bytes 127 to 134, signed, read here as unsigned
  UINT8 last_price_in_preceding_session_date[8];  // bytes 135 to 142
  UINT8 third_reserved_1;                         // byte 143
  UINT8 second_reserved_8[8];                     // bytes 144 to 151
  UINT8 third_reserved_8[8];                      // bytes 152 to 159
  UINT8 ex_marker_code[2];                        // bytes 160 to 161
  UINT8 security_type;                            // byte 162
  UINT8 country_of_register[3];                   // bytes 163 to 165
  UINT64 exchange_market_size;                    // bytes 166 to 173
  UINT64 minimum_peak_size_multiplier;            // bytes 174 to 181
  UINT64 security_maximum_spread;                 // bytes 182 to 189, signed, read here as unsigned
  UINT8 clearing_type;                            // byte 190
  UINT64 strike_price;                            // bytes 191 to 198, signed, read here as unsigned
  UINT8 security_exchange[11];                    // bytes 199 to 209
  UINT8 reserved_12[12];                          // bytes 210 to 221
  UINT8 reserved_1;                               // byte 222
  UINT8 fourth_reserved_8[8];                     // bytes 223 to 230
  UINT8 fifth_reserved_8[8];                      // bytes 231 to 238
  UINT8 partition_id;                             // byte 239
  UINT8 sixth_reserved_8[8];                      // bytes 240 to 247
  UINT8 seventh_reserved_8[8];                    // bytes 248 to 255
  UINT8 reserved_4[4];                            // bytes 256 to 259
  UINT8 reserved_2[2];                            // bytes 260 to 261
  UINT8 symbol[8];                                // bytes 262 to 269
  UINT8 description[40];                          // bytes 270 to 309
} InstrumentDirectoryEquitiesMessage;

// A snapshot of an instrument's statistics that is used for recovery.
typedef struct _StatisticsSnapshotMessage {
  UINT64 timestamp;                      // bytes 0 to 7
  UINT64 instrument;                     // bytes 8 to 15
  UINT16 source_venue;                   // bytes 16 to 17
  UINT64 volume;                         // bytes 18 to 25
  UINT64 volume_on_book_only;            // bytes 26 to 33
  UINT64 vwap;                           // bytes 34 to 41, signed, read here as unsigned
  UINT64 vwap_on_book_only;              // bytes 42 to 49, signed, read here as unsigned
  UINT32 number_of_trades;               // bytes 50 to 53
  UINT32 number_of_trades_on_book_only;  // bytes 54 to 57
  UINT64 turnover;                       // bytes 58 to 65, signed, read here as unsigned
  UINT64 turnover_on_book_only;          // bytes 66 to 73, signed, read here as unsigned
  UINT64 official_opening_price;         // bytes 74 to 81, signed, read here as unsigned
  UINT64 official_closing_price;         // bytes 82 to 89, signed, read here as unsigned
  UINT64 trade_high_on_book_only;        // bytes 90 to 97, signed, read here as unsigned
  UINT64 trade_low_on_book_only;         // bytes 98 to 105, signed, read here as unsigned
  UINT64 trade_high;                     // bytes 106 to 113, signed, read here as unsigned
  UINT64 trade_low;                      // bytes 114 to 121, signed, read here as unsigned
  UINT64 fifty_two_week_trade_high;      // bytes 122 to 129, signed, read here as unsigned
  UINT64 fifty_two_week_trade_low;       // bytes 130 to 137, signed, read here as unsigned
  UINT8 opening_price_indicator;         // byte 138
  UINT8 closing_price_indicator;         // byte 139
  UINT64 iau_price;                      // bytes 140 to 147, signed, read here as unsigned
  UINT64 iau_paired_size;                // bytes 148 to 155
  UINT64 imbalance_quantity;             // bytes 156 to 163
  UINT8 imbalance_direction;             // byte 164
  UINT64 best_closing_bid_price;         // bytes 165 to 172, signed, read here as unsigned
  UINT64 best_closing_ask_price;         // bytes 173 to 180, signed, read here as unsigned
  UINT64 best_closing_bid_size;          // bytes 181 to 188
  UINT64 best_closing_ask_size;          // bytes 189 to 196
  UINT8 reserved_8[8];                   // bytes 197 to 204
  UINT8 second_reserved_8[8];            // bytes 205 to 212
  UINT8 third_reserved_8[8];             // bytes 213 to 220
  UINT8 fourth_reserved_8[8];            // bytes 221 to 228
  UINT8 auction_type;                    // byte 229
  UINT64 last_trade_price;               // bytes 230 to 237, signed, read here as unsigned
  UINT64 last_trade_quantity;            // bytes 238 to 245
  UINT64 last_trade_time;                // bytes 246 to 253
  UINT64 static_reference_price;         // bytes 254 to 261, signed, read here as unsigned
  UINT64 dynamic_reference_price;        // bytes 262 to 269, signed, read here as unsigned
} StatisticsSnapshotMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: LoginRequestMessage login_request_message;
    case 0x81: RecoveryRequestMessage recovery_request_message;
    case 0x02: LoginResponseMessage login_response_message;
    case 0x82: RecoveryResponseMessage recovery_response_message;
    case 0x83: ReplayAndRecoveryCompleteMessage replay_and_recovery_complete_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x48: InstrumentStatusMessage instrument_status_message;
    case 0x46: AddOrderIncrementalMessage add_order_incremental_message;
    case 0x79: OrderBookClearMessage order_book_clear_message;
    case 0x50: TradeMessage trade_message;
    case 0x52: InstrumentDirectoryEquitiesMessage instrument_directory_equities_message;
    case 0x6B: StatisticsSnapshotMessage statistics_snapshot_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Gtp Tcp Message
typedef struct _Message (mutable UINT32 * tally) {
  UINT16 message_length { message_length >= 3 };                                                                                                                   // bytes 0 to 1
  UINT8 message_type;                                                                                                                                              // byte 2
  Payload(message_type, (((UINT32) message_length) - 3)) payload[:byte-size-single-element-array (((UINT32) message_length) - 3)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// One unit on the tcp stream: the unit header and its payload messages
typedef struct _TcpUnit (mutable UINT32 * tally) {
  UINT16 length { length >= 8 };                                                                                            // bytes 0 to 1
  UINT8 message_count;                                                                                                      // byte 2
  UINT8 market_data_group;                                                                                                  // byte 3
  UINT32 sequence_number;                                                                                                   // bytes 4 to 7
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (((UINT32) length) - 8)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} TcpUnit;

// ---- Packet: Packet ----------------------------------------------------------

// Gtp Tcp Packet
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) {
  TcpUnit(tally) tcp_unit[:byte-size available];
} Packet;

