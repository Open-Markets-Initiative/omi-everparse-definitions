// ---- Prior Day Trade Correction Message: 69 bytes ----------------------------

// Used to correct a transaction originally reported earlier than the current day.
entrypoint typedef struct _PriorDayTradeCorrectionMessage {
  UINT8 security_symbol[11];                                                  // bytes 0 to 10
  UINT8 instrument_type;                                                      // byte 11
  UINT8 corrected_sale_condition[4];                                          // bytes 12 to 15
