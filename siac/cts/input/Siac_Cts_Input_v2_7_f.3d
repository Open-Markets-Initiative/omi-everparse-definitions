// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out Siac_Cts_Input_v2_7_f.3d
//
// What this definition reads more loosely than the model states:
// - a pad ending its frame after a run of no fixed width is what is left of the frame, and is not checked to reach no further than the boundary

// ---- Values ------------------------------------------------------------------

// Message Category: one byte code
#define MESSAGE_CATEGORY_ADMINISTRATIVE 0x41  // Administrative
#define MESSAGE_CATEGORY_CONTROL 0x43         // Control
#define MESSAGE_CATEGORY_INDICES 0x49         // Indices
#define MESSAGE_CATEGORY_MARKET_STATUS 0x4D   // Market Status
#define MESSAGE_CATEGORY_PRIOR_DAY 0x50       // Prior Day
#define MESSAGE_CATEGORY_TRADE 0x54           // Trade

// Instrument Type: one byte code
#define INSTRUMENT_TYPE_CTA_ELIGIBLE_EQUITY 0x30  // Cta Eligible Equity
#define INSTRUMENT_TYPE_LOCAL_ISSUE 0x31          // Local Issue
#define INSTRUMENT_TYPE_CORPORATE_BOND 0x32       // Corporate Bond
#define INSTRUMENT_TYPE_GOVERNMENT_BOND 0x33      // Government Bond

// Trade Reporting Facility Id: one byte code
#define TRADE_REPORTING_FACILITY_ID_TRF_NOT_APPLICABLE 0x20         // Trf Not Applicable
#define TRADE_REPORTING_FACILITY_ID_FINRA_ADF 0x64                  // Finra Adf
#define TRADE_REPORTING_FACILITY_ID_FINRA_NASDAQ_TRF_CHICAGO 0x42   // Finra Nasdaq Trf Chicago
#define TRADE_REPORTING_FACILITY_ID_FINRA_NYSE_TRF 0x4E             // Finra Nyse Trf
#define TRADE_REPORTING_FACILITY_ID_FINRA_NASDAQ_TRF_CARTERET 0x54  // Finra Nasdaq Trf Carteret

// Stop Stock Indicator: one byte code
#define STOP_STOCK_INDICATOR_STOP_STOCK_NOT_APPLICABLE 0x30  // Stop Stock Not Applicable
#define STOP_STOCK_INDICATOR_STOP_STOCK 0x31                 // Stop Stock

// Trade Through Exempt Indicator: one byte code
#define TRADE_THROUGH_EXEMPT_INDICATOR_NOT_A_TRADE_THROUGH_EXEMPTION 0x30  // Not A Trade Through Exemption
#define TRADE_THROUGH_EXEMPT_INDICATOR_TRADE_THROUGH_EXEMPTION 0x31        // Trade Through Exemption

// Short Sale Restriction Indicator: one byte code
#define SHORT_SALE_RESTRICTION_INDICATOR_SHORT_SALE_RESTRICTION_NOT_APPLICABLE 0x20  // Short Sale Restriction Not Applicable
#define SHORT_SALE_RESTRICTION_INDICATOR_SHORT_SALE_RESTRICTION_ACTIVATED 0x41       // Short Sale Restriction Activated
#define SHORT_SALE_RESTRICTION_INDICATOR_SHORT_SALE_RESTRICTION_CONTINUED 0x43       // Short Sale Restriction Continued
#define SHORT_SALE_RESTRICTION_INDICATOR_SHORT_SALE_RESTRICTION_DEACTIVATED 0x44     // Short Sale Restriction Deactivated
#define SHORT_SALE_RESTRICTION_INDICATOR_SHORT_SALE_RESTRICTION_IN_EFFECT 0x45       // Short Sale Restriction In Effect

// Cancel Error Action: one byte code
#define CANCEL_ERROR_ACTION_CANCEL 0x31  // Cancel
#define CANCEL_ERROR_ACTION_ERROR 0x32   // Error

// Security Status: one byte code
#define SECURITY_STATUS_SECURITY_STATUS_NOT_APPLICABLE 0x20            // Security Status Not Applicable
#define SECURITY_STATUS_TRADING_HALT 0x32                              // Trading Halt
#define SECURITY_STATUS_RESUME 0x33                                    // Resume
#define SECURITY_STATUS_PRICE_INDICATION 0x35                          // Price Indication
#define SECURITY_STATUS_TRADING_RANGE_INDICATION 0x36                  // Trading Range Indication
#define SECURITY_STATUS_MARKET_IMBALANCE_BUY 0x37                      // Market Imbalance Buy
#define SECURITY_STATUS_MARKET_IMBALANCE_SELL 0x38                     // Market Imbalance Sell
#define SECURITY_STATUS_CLOSING_IMBALANCE_BUY 0x39                     // Closing Imbalance Buy
#define SECURITY_STATUS_CLOSING_IMBALANCE_SELL 0x41                    // Closing Imbalance Sell
#define SECURITY_STATUS_NO_MARKET_IMBALANCE 0x43                       // No Market Imbalance
#define SECURITY_STATUS_NO_CLOSING_IMBALANCE 0x44                      // No Closing Imbalance
#define SECURITY_STATUS_SHORT_SALE_RESTRICTION 0x45                    // Short Sale Restriction
#define SECURITY_STATUS_LIMIT_UP_LIMIT_DOWN_LULD_REFERENCE_PRICE 0x46  // Limit Up Limit Down Luld Reference Price

// Halt Reason: one byte code
#define HALT_REASON_HALT_REASON_NOT_APPLICABLE 0x20                    // Halt Reason Not Applicable
#define HALT_REASON_ADDITIONAL_INFORMATION_REQUESTED 0x41              // Additional Information Requested
#define HALT_REASON_REGULATORY_CONCERN 0x43                            // Regulatory Concern
#define HALT_REASON_NEWS_RELEASED 0x44                                 // News Released
#define HALT_REASON_MERGER_EFFECTIVE 0x45                              // Merger Effective
#define HALT_REASON_ETF_COMPONENT_PRICES_NOT_AVAILABLE 0x46            // Etf Component Prices Not Available
#define HALT_REASON_ORDER_IMBALANCE 0x49                               // Order Imbalance
#define HALT_REASON_LIMIT_UP_LIMIT_DOWN_LULD_TRADING_PAUSE 0x4D        // Limit Up Limit Down Luld Trading Pause
#define HALT_REASON_CORPORATE_ACTION 0x4E                              // Corporate Action
#define HALT_REASON_NEW_SECURITY_OFFERING 0x4F                         // New Security Offering
#define HALT_REASON_NEWS_PENDING 0x50                                  // News Pending
#define HALT_REASON_INTRADAY_INDICATIVE_VALUE_NOT_AVAILABLE 0x56       // Intraday Indicative Value Not Available
#define HALT_REASON_OPERATIONAL 0x58                                   // Operational
#define HALT_REASON_SUB_PENNY_TRADING 0x59                             // Sub Penny Trading
#define HALT_REASON_MARKET_WIDE_CIRCUIT_BREAKER_LEVEL_1_BREACHED 0x31  // Market Wide Circuit Breaker Level 1 Breached
#define HALT_REASON_MARKET_WIDE_CIRCUIT_BREAKER_LEVEL_2_BREACHED 0x32  // Market Wide Circuit Breaker Level 2 Breached
#define HALT_REASON_MARKET_WIDE_CIRCUIT_BREAKER_LEVEL_3_BREACHED 0x33  // Market Wide Circuit Breaker Level 3 Breached

// Sale Condition Category: one byte code
#define SALE_CONDITION_CATEGORY_SALE_CONDITION_CATEGORY_NOT_APPLICABLE 0x20  // Sale Condition Category Not Applicable
#define SALE_CONDITION_CATEGORY_SALE_CONDITION_CATEGORY_1 0x31               // Sale Condition Category 1
#define SALE_CONDITION_CATEGORY_SALE_CONDITION_CATEGORY_2 0x32               // Sale Condition Category 2
#define SALE_CONDITION_CATEGORY_SALE_CONDITION_CATEGORY_3 0x33               // Sale Condition Category 3
#define SALE_CONDITION_CATEGORY_SALE_CONDITION_CATEGORY_4 0x34               // Sale Condition Category 4

// ---- Types -------------------------------------------------------------------

// Participant-provided timestamp
typedef struct _Timestamp1 {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} Timestamp1;

// Used for all errors to notify a Participant that CTS has found an error in the Block Header, Message Header or Message body of a Participant Input message.
typedef struct _RejectionMessage {
  UINT8 error_code;                       // byte 0
  UINT32BE block_sequence_number;         // bytes 1 to 4
  UINT64BE participant_reference_number;  // bytes 5 to 12, signed, read here as unsigned
  UINT8 message_i_d;                      // byte 13
} RejectionMessage;

// Sent from CTS to a Participant in response to a Block Sequence Number Gap. The block will still be processed by CTS.
typedef struct _WarningMessage {
  UINT32BE previous_block_sequence_number;         // bytes 0 to 3
  UINT64BE previous_participant_reference_number;  // bytes 4 to 11, signed, read here as unsigned
} WarningMessage;

// Generated by CTS to a Participant in response to a Sequence Information and Message Count Inquiry message. Transmitted in a separate block.
typedef struct _SequenceInformationAndMessageCountResponseMessage {
  UINT32BE current_block_sequence_number;      // bytes 0 to 3
  UINT64BE last_participant_reference_number;  // bytes 4 to 11, signed, read here as unsigned
  UINT64BE message_count;                      // bytes 12 to 19
} SequenceInformationAndMessageCountResponseMessage;

// Generated by CTS or a Participant to exercise the line and verify transmission integrity. Transmitted as the only message in a block.
typedef struct _TestMessage {
  UINT8 data[256];  // bytes 0 to 255
} TestMessage;

// Contains the index and the index value.
typedef struct _IndexMessage {
  UINT8 index_symbol[11];  // bytes 0 to 10
  UINT64BE index_value;    // bytes 11 to 18, signed, read here as unsigned
} IndexMessage;

// Contains the Bid and Offer index values.
typedef struct _BidAndOfferIndexMessage {
  UINT8 index_symbol[11];      // bytes 0 to 10
  UINT64BE bid_index_value;    // bytes 11 to 18, signed, read here as unsigned
  UINT64BE offer_index_value;  // bytes 19 to 26, signed, read here as unsigned
} BidAndOfferIndexMessage;

// Allows a Participant to report the total trades and total dollar value of trades at their respective market centers.
typedef struct _ApproximateTradesAndTotalDollarValueMessage {
  UINT32BE total_trades;  // bytes 0 to 3
  UINT64BE dollar_value;  // bytes 4 to 11
} ApproximateTradesAndTotalDollarValueMessage;

// Used to report the total volume and dollar value of trades transacted after the close of a Participant's regular session.
typedef struct _CrossingSessionMessage {
  UINT64BE crossing_session_i_total_trades_volume;   // bytes 0 to 7
  UINT64BE crossing_session_ii_dollar_value;         // bytes 8 to 15
  UINT64BE crossing_session_ii_total_trades_volume;  // bytes 16 to 23
} CrossingSessionMessage;

// Corrected Prior Day Trade Date and Time
typedef struct _CorrectedPriorDayTradeDateAndTime {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} CorrectedPriorDayTradeDateAndTime;

// Original Prior Day Trade Date and Time
typedef struct _OriginalPriorDayTradeDateAndTime {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} OriginalPriorDayTradeDateAndTime;

// Used to correct a transaction originally reported earlier than the current day.
typedef struct _PriorDayTradeCorrectionMessage {
  UINT8 security_symbol[11];                                                  // bytes 0 to 10
  UINT8 instrument_type;                                                      // byte 11
  UINT8 corrected_sale_condition[4];                                          // bytes 12 to 15
  UINT64BE corrected_trade_price;                                             // bytes 16 to 23
  UINT32BE corrected_trade_volume;                                            // bytes 24 to 27
  UINT8 corrected_sellers_sale_days;                                          // byte 28
  UINT8 corrected_stop_stock_indicator;                                       // byte 29
  UINT8 corrected_trade_through_exempt_indicator;                             // byte 30
  UINT8 corrected_short_sale_restriction_indicator;                           // byte 31
  CorrectedPriorDayTradeDateAndTime corrected_prior_day_trade_date_and_time;  // bytes 32 to 39
  UINT8 trade_reporting_facility_id;                                          // byte 40
  UINT8 original_sale_condition[4];                                           // bytes 41 to 44
  UINT64BE original_trade_price;                                              // bytes 45 to 52
  UINT32BE original_trade_volume;                                             // bytes 53 to 56
  UINT8 original_sellers_sale_days;                                           // byte 57
  UINT8 original_stop_stock_indicator;                                        // byte 58
  UINT8 original_trade_through_exempt_indicator;                              // byte 59
  UINT8 original_short_sale_restriction_indicator;                            // byte 60
  OriginalPriorDayTradeDateAndTime original_prior_day_trade_date_and_time;    // bytes 61 to 68
} PriorDayTradeCorrectionMessage;

// Used to correct a prior day transaction when either the original or corrected volume is a fractional value.
typedef struct _FractionalPriorDayTradeCorrectionMessage {
  UINT8 security_symbol[11];                                                  // bytes 0 to 10
  UINT8 instrument_type;                                                      // byte 11
  UINT8 corrected_sale_condition[4];                                          // bytes 12 to 15
  UINT64BE corrected_trade_price;                                             // bytes 16 to 23
  UINT64BE corrected_fractional_trade_volume;                                 // bytes 24 to 31
  UINT8 corrected_sellers_sale_days;                                          // byte 32
  UINT8 corrected_stop_stock_indicator;                                       // byte 33
  UINT8 corrected_trade_through_exempt_indicator;                             // byte 34
  UINT8 corrected_short_sale_restriction_indicator;                           // byte 35
  CorrectedPriorDayTradeDateAndTime corrected_prior_day_trade_date_and_time;  // bytes 36 to 43
  UINT8 trade_reporting_facility_id;                                          // byte 44
  UINT8 original_sale_condition[4];                                           // bytes 45 to 48
  UINT64BE original_trade_price;                                              // bytes 49 to 56
  UINT64BE original_fractional_trade_volume;                                  // bytes 57 to 64
  UINT8 original_sellers_sale_days;                                           // byte 65
  UINT8 original_stop_stock_indicator;                                        // byte 66
  UINT8 original_trade_through_exempt_indicator;                              // byte 67
  UINT8 original_short_sale_restriction_indicator;                            // byte 68
  OriginalPriorDayTradeDateAndTime original_prior_day_trade_date_and_time;    // bytes 69 to 76
} FractionalPriorDayTradeCorrectionMessage;

// Prior Day Trade Date and Time
typedef struct _PriorDayTradeDateAndTime {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} PriorDayTradeDateAndTime;

// Reports a CTA eligible Equity, Local Issue or Bond transaction which occurred earlier than the current trading day and was not reported.
typedef struct _PriorDayTradeMessage {
  UINT8 security_symbol[11];                               // bytes 0 to 10
  UINT8 instrument_type;                                   // byte 11
  UINT8 sale_condition[4];                                 // bytes 12 to 15
  UINT64BE trade_price;                                    // bytes 16 to 23
  UINT32BE trade_volume;                                   // bytes 24 to 27
  UINT8 sellers_sale_days;                                 // byte 28
  UINT8 stop_stock_indicator;                              // byte 29
  UINT8 trade_through_exempt_indicator;                    // byte 30
  UINT8 short_sale_restriction_indicator;                  // byte 31
  UINT8 trade_reporting_facility_id;                       // byte 32
  PriorDayTradeDateAndTime prior_day_trade_date_and_time;  // bytes 33 to 40
} PriorDayTradeMessage;

// Reports a trade with fractional volume which occurred earlier than the current trading day and was not reported.
typedef struct _FractionalPriorDayTradeMessage {
  UINT8 security_symbol[11];                               // bytes 0 to 10
  UINT8 instrument_type;                                   // byte 11
  UINT8 sale_condition[4];                                 // bytes 12 to 15
  UINT64BE trade_price;                                    // bytes 16 to 23
  UINT64BE fractional_trade_volume;                        // bytes 24 to 31
  UINT8 sellers_sale_days;                                 // byte 32
  UINT8 stop_stock_indicator;                              // byte 33
  UINT8 trade_through_exempt_indicator;                    // byte 34
  UINT8 short_sale_restriction_indicator;                  // byte 35
  UINT8 trade_reporting_facility_id;                       // byte 36
  PriorDayTradeDateAndTime prior_day_trade_date_and_time;  // bytes 37 to 44
} FractionalPriorDayTradeMessage;

// Used to cancel or error a trade or correction originally reported earlier than the current day.
typedef struct _PriorDayTradeCancelErrorMessage {
  UINT8 security_symbol[11];                               // bytes 0 to 10
  UINT8 instrument_type;                                   // byte 11
  UINT8 sale_condition[4];                                 // bytes 12 to 15
  UINT64BE trade_price;                                    // bytes 16 to 23
  UINT32BE trade_volume;                                   // bytes 24 to 27
  UINT8 sellers_sale_days;                                 // byte 28
  UINT8 stop_stock_indicator;                              // byte 29
  UINT8 trade_through_exempt_indicator;                    // byte 30
  UINT8 short_sale_restriction_indicator;                  // byte 31
  UINT8 trade_reporting_facility_id;                       // byte 32
  PriorDayTradeDateAndTime prior_day_trade_date_and_time;  // bytes 33 to 40
  UINT8 cancel_error_action;                               // byte 41
} PriorDayTradeCancelErrorMessage;

// Reports the cancellation or error of a fractional trade or correction originally reported earlier than the current day.
typedef struct _FractionalPriorDayTradeCancelErrorMessage {
  UINT8 security_symbol[11];                               // bytes 0 to 10
  UINT8 instrument_type;                                   // byte 11
  UINT8 sale_condition[4];                                 // bytes 12 to 15
  UINT64BE trade_price;                                    // bytes 16 to 23
  UINT64BE fractional_trade_volume;                        // bytes 24 to 31
  UINT8 sellers_sale_days;                                 // byte 32
  UINT8 stop_stock_indicator;                              // byte 33
  UINT8 trade_through_exempt_indicator;                    // byte 34
  UINT8 short_sale_restriction_indicator;                  // byte 35
  UINT8 trade_reporting_facility_id;                       // byte 36
  PriorDayTradeDateAndTime prior_day_trade_date_and_time;  // bytes 37 to 44
  UINT8 cancel_error_action;                               // byte 45
} FractionalPriorDayTradeCancelErrorMessage;

// Transmitted when a Participant in a CTA eligible security requires Auction Information. Initial Auction Collar is published after the LULD Trading Pause.
typedef struct _AuctionStatusMessage {
  UINT8 security_symbol[11];                      // bytes 0 to 10
  UINT8 instrument_type;                          // byte 11
  UINT64BE auction_collar_reference_price;        // bytes 12 to 19
  UINT64BE auction_collar_upper_threshold_price;  // bytes 20 to 27
  UINT64BE auction_collar_lower_threshold_price;  // bytes 28 to 35
  UINT8 number_of_extensions;                     // byte 36
  UINT8 reserved_62[62];                          // bytes 37 to 98
} AuctionStatusMessage;

// Timestamp 2
typedef struct _Timestamp2 {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} Timestamp2;

// Used to correct CTA eligible Equity, Local Issue or Bond trade information.
typedef struct _TradeCorrectionMessage {
  UINT8 security_symbol[11];                         // bytes 0 to 10
  UINT8 instrument_type;                             // byte 11
  UINT8 corrected_sale_condition[4];                 // bytes 12 to 15
  UINT64BE corrected_trade_price;                    // bytes 16 to 23
  UINT32BE corrected_trade_volume;                   // bytes 24 to 27
  UINT8 corrected_sellers_sale_days;                 // byte 28
  UINT8 corrected_stop_stock_indicator;              // byte 29
  UINT8 corrected_trade_through_exempt_indicator;    // byte 30
  UINT8 corrected_short_sale_restriction_indicator;  // byte 31
  UINT8 trade_reporting_facility_id;                 // byte 32
  Timestamp2 timestamp_2;                            // bytes 33 to 40
  UINT64BE original_participant_reference_number;    // bytes 41 to 48, signed, read here as unsigned
} TradeCorrectionMessage;

// Used to correct a trade when the corrected Trade Volume is a fractional value.
typedef struct _FractionalTradeCorrectionMessage {
  UINT8 security_symbol[11];                         // bytes 0 to 10
  UINT8 instrument_type;                             // byte 11
  UINT8 corrected_sale_condition[4];                 // bytes 12 to 15
  UINT64BE corrected_trade_price;                    // bytes 16 to 23
  UINT64BE corrected_fractional_trade_volume;        // bytes 24 to 31
  UINT8 corrected_sellers_sale_days;                 // byte 32
  UINT8 corrected_stop_stock_indicator;              // byte 33
  UINT8 corrected_trade_through_exempt_indicator;    // byte 34
  UINT8 corrected_short_sale_restriction_indicator;  // byte 35
  UINT8 trade_reporting_facility_id;                 // byte 36
  Timestamp2 timestamp_2;                            // bytes 37 to 44
  UINT64BE original_participant_reference_number;    // bytes 45 to 52, signed, read here as unsigned
} FractionalTradeCorrectionMessage;

// Used to report trade information for CTA eligible Equity, Local Issue or Bonds.
typedef struct _LongTradeMessage {
  UINT8 security_symbol[11];             // bytes 0 to 10
  UINT8 instrument_type;                 // byte 11
  UINT8 sale_condition[4];               // bytes 12 to 15
  UINT64BE trade_price;                  // bytes 16 to 23
  UINT32BE trade_volume;                 // bytes 24 to 27
  UINT8 sellers_sale_days;               // byte 28
  UINT8 stop_stock_indicator;            // byte 29
  UINT8 trade_through_exempt_indicator;  // byte 30
  UINT8 trade_reporting_facility_id;     // byte 31
  Timestamp2 timestamp_2;                // bytes 32 to 39
} LongTradeMessage;

// Used to report trade information for CTA eligible Equity, Local Issues or Bonds in fractional volume.
typedef struct _FractionalLongTradeMessage {
  UINT8 security_symbol[11];             // bytes 0 to 10
  UINT8 instrument_type;                 // byte 11
  UINT8 sale_condition[4];               // bytes 12 to 15
  UINT64BE trade_price;                  // bytes 16 to 23
  UINT64BE fractional_trade_volume;      // bytes 24 to 31
  UINT8 sellers_sale_days;               // byte 32
  UINT8 stop_stock_indicator;            // byte 33
  UINT8 trade_through_exempt_indicator;  // byte 34
  UINT8 trade_reporting_facility_id;     // byte 35
  Timestamp2 timestamp_2;                // bytes 36 to 43
} FractionalLongTradeMessage;

// Allows a Participant that is the listing exchange to notify CTS of Trading Halts, Resumes, Indications, Imbalances, Short Sale Restriction Indicators and LULD Reference Prices. Bidirectional.
typedef struct _TradingStatusMessage {
  UINT8 security_symbol[11];                                   // bytes 0 to 10
  UINT8 instrument_type;                                       // byte 11
  UINT64BE last_price_opening_reopening_luld_reference_price;  // bytes 12 to 19
  UINT64BE high_indication_price_upper_limit_price_band;       // bytes 20 to 27
  UINT64BE low_indication_price_lower_limit_price_band;        // bytes 28 to 35
  UINT32BE buy_volume;                                         // bytes 36 to 39
  UINT32BE sell_volume;                                        // bytes 40 to 43
  UINT8 security_status;                                       // byte 44
  UINT8 halt_reason;                                           // byte 45
  UINT8 short_sale_restriction_indicator;                      // byte 46
  UINT32BE trading_status_id;                                  // bytes 47 to 50
} TradingStatusMessage;

// Reports trade information for CTA eligible Equity, Local Issues or Bonds when the trade meets all criteria for the compact Short format; otherwise the Long Trade message is used.
typedef struct _ShortTradeMessage {
  UINT8 security_symbol_short[5];  // bytes 0 to 4
  UINT8 sale_condition_short;      // byte 5
  UINT8 sale_condition_category;   // byte 6
  UINT16BE trade_price_short;      // bytes 7 to 8
  UINT16BE trade_volume_short;     // bytes 9 to 10
  UINT8 reserved_3[3];             // bytes 11 to 13
} ShortTradeMessage;

// Reports trade information with fractional volume when the trade meets all criteria for the compact Short format; otherwise the Long Trade or Fractional Long Trade message is used.
typedef struct _FractionalShortTradeMessage {
  UINT8 security_symbol_short[5];          // bytes 0 to 4
  UINT8 sale_condition_short;              // byte 5
  UINT8 sale_condition_category;           // byte 6
  UINT16BE trade_price_short;              // bytes 7 to 8
  UINT32BE fractional_trade_volume_short;  // bytes 9 to 12
  UINT8 reserved_3[3];                     // bytes 13 to 15
} FractionalShortTradeMessage;

// Allows a Participant to cancel or error trade reports for CTA eligible Equity, Local Issue or Bond originally reported using a fixed message format.
typedef struct _TradeCancelErrorMessage {
  UINT8 security_symbol[11];                       // bytes 0 to 10
  UINT8 instrument_type;                           // byte 11
  UINT8 trade_through_exempt_indicator;            // byte 12
  UINT8 trade_reporting_facility_id;               // byte 13
  UINT64BE original_participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
  Timestamp2 timestamp_2;                          // bytes 22 to 29
  UINT8 cancel_error_action;                       // byte 30
} TradeCancelErrorMessage;

// Branch
casetype _MessagePayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x4152: RejectionMessage rejection_message;
    case 0x4157: WarningMessage warning_message;
    case 0x4341: unit start_of_day_message;
    case 0x4349: unit sequence_information_and_message_count_inquiry_message;
    case 0x434E: SequenceInformationAndMessageCountResponseMessage sequence_information_and_message_count_response_message;
    case 0x4354: unit line_integrity_message;
    case 0x435A: unit end_of_day_message;
    case 0x4335: TestMessage test_message;
    case 0x4949: IndexMessage index_message;
    case 0x4951: BidAndOfferIndexMessage bid_and_offer_index_message;
    case 0x4D4F: ApproximateTradesAndTotalDollarValueMessage approximate_trades_and_total_dollar_value_message;
    case 0x4D50: CrossingSessionMessage crossing_session_message;
    case 0x5043: PriorDayTradeCorrectionMessage prior_day_trade_correction_message;
    case 0x504F: FractionalPriorDayTradeCorrectionMessage fractional_prior_day_trade_correction_message;
    case 0x5054: PriorDayTradeMessage prior_day_trade_message;
    case 0x5052: FractionalPriorDayTradeMessage fractional_prior_day_trade_message;
    case 0x5058: PriorDayTradeCancelErrorMessage prior_day_trade_cancel_error_message;
    case 0x5045: FractionalPriorDayTradeCancelErrorMessage fractional_prior_day_trade_cancel_error_message;
    case 0x5441: AuctionStatusMessage auction_status_message;
    case 0x5443: TradeCorrectionMessage trade_correction_message;
    case 0x544F: FractionalTradeCorrectionMessage fractional_trade_correction_message;
    case 0x544C: LongTradeMessage long_trade_message;
    case 0x5452: FractionalLongTradeMessage fractional_long_trade_message;
    case 0x5453: TradingStatusMessage trading_status_message;
    case 0x5454: ShortTradeMessage short_trade_message;
    case 0x5448: FractionalShortTradeMessage fractional_short_trade_message;
    case 0x5458: TradeCancelErrorMessage trade_cancel_error_message;
    default: UINT8 unknown[available];
  }
} MessagePayload;

// Cta participant input message
typedef struct _Message {
  UINT16BE message_length { message_length >= 26 };                                                                                                                                                    // bytes 0 to 1
  UINT8 message_category;                                                                                                                                                                              // byte 2
  UINT8 message_type;                                                                                                                                                                                  // byte 3
  UINT8 participant_i_d;                                                                                                                                                                               // byte 4
  Timestamp1 timestamp_1;                                                                                                                                                                              // bytes 5 to 12
  UINT8 message_i_d;                                                                                                                                                                                   // byte 13
  UINT8 reserved[4];                                                                                                                                                                                   // bytes 14 to 17
  UINT64BE participant_reference_number;                                                                                                                                                               // bytes 18 to 25, signed, read here as unsigned
  MessagePayload(((((UINT16) message_category) << 8) | ((UINT16) message_type)), (((UINT32) message_length) - 26)) message_payload[:byte-size-single-element-array (((UINT32) message_length) - 26)];
} Message;

