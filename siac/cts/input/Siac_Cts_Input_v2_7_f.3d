// ---- Block Header: 10 bytes --------------------------------------------------

// Cta participant input block header
entrypoint typedef struct _BlockHeader {
  UINT8 version;                   // byte 0
  UINT16BE block_size;             // bytes 1 to 2
  UINT32BE block_sequence_number;  // bytes 3 to 6
  UINT8 messages_in_block;         // byte 7
  UINT16BE block_checksum;         // bytes 8 to 9
} BlockHeader;

// ---- Timestamp 1: 8 bytes ----------------------------------------------------

// Participant-provided timestamp
entrypoint typedef struct _Timestamp1 {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} Timestamp1;

// ---- Message Header: 26 bytes ------------------------------------------------

// Cta participant input message header (26 bytes)
entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;                // bytes 0 to 1
  UINT8 message_category;                 // byte 2
  UINT8 message_type;                     // byte 3
  UINT8 participant_i_d;                  // byte 4
  Timestamp1 timestamp_1;                 // bytes 5 to 12
  UINT8 message_i_d;                      // byte 13
  UINT8 reserved[4];                      // bytes 14 to 17
  UINT64BE participant_reference_number;  // bytes 18 to 25, signed, read here as unsigned
} MessageHeader;

// ---- Rejection Message: 14 bytes ---------------------------------------------

// Used for all errors to notify a Participant that CTS has found an error in the Block Header, Message Header or Message body of a Participant Input message.
entrypoint typedef struct _RejectionMessage {
  UINT8 error_code;                       // byte 0
  UINT32BE block_sequence_number;         // bytes 1 to 4
  UINT64BE participant_reference_number;  // bytes 5 to 12, signed, read here as unsigned
  UINT8 message_i_d;                      // byte 13
} RejectionMessage;

// ---- Warning Message: 12 bytes -----------------------------------------------

// Sent from CTS to a Participant in response to a Block Sequence Number Gap. The block will still be processed by CTS.
entrypoint typedef struct _WarningMessage {
  UINT32BE previous_block_sequence_number;         // bytes 0 to 3
  UINT64BE previous_participant_reference_number;  // bytes 4 to 11, signed, read here as unsigned
} WarningMessage;

// ---- Sequence Information And Message Count Response Message: 20 bytes -------

// Generated by CTS to a Participant in response to a Sequence Information and Message Count Inquiry message. Transmitted in a separate block.
entrypoint typedef struct _SequenceInformationAndMessageCountResponseMessage {
  UINT32BE current_block_sequence_number;      // bytes 0 to 3
  UINT64BE last_participant_reference_number;  // bytes 4 to 11, signed, read here as unsigned
  UINT64BE message_count;                      // bytes 12 to 19
} SequenceInformationAndMessageCountResponseMessage;

// ---- Test Message: 256 bytes -------------------------------------------------

// Generated by CTS or a Participant to exercise the line and verify transmission integrity. Transmitted as the only message in a block.
entrypoint typedef struct _TestMessage {
  UINT8 data[256];  // bytes 0 to 255
} TestMessage;

// ---- Index Message: 19 bytes -------------------------------------------------

// Contains the index and the index value.
entrypoint typedef struct _IndexMessage {
  UINT8 index_symbol[11];  // bytes 0 to 10
  UINT64BE index_value;    // bytes 11 to 18, signed, read here as unsigned
} IndexMessage;

// ---- Bid And Offer Index Message: 27 bytes -----------------------------------

// Contains the Bid and Offer index values.
entrypoint typedef struct _BidAndOfferIndexMessage {
  UINT8 index_symbol[11];      // bytes 0 to 10
  UINT64BE bid_index_value;    // bytes 11 to 18, signed, read here as unsigned
  UINT64BE offer_index_value;  // bytes 19 to 26, signed, read here as unsigned
} BidAndOfferIndexMessage;

// ---- Approximate Trades And Total Dollar Value Message: 12 bytes -------------

// Allows a Participant to report the total trades and total dollar value of trades at their respective market centers.
entrypoint typedef struct _ApproximateTradesAndTotalDollarValueMessage {
  UINT32BE total_trades;  // bytes 0 to 3
  UINT64BE dollar_value;  // bytes 4 to 11
} ApproximateTradesAndTotalDollarValueMessage;

// ---- Crossing Session Message: 24 bytes --------------------------------------

// Used to report the total volume and dollar value of trades transacted after the close of a Participant's regular session.
entrypoint typedef struct _CrossingSessionMessage {
  UINT64BE crossing_session_i_total_trades_volume;   // bytes 0 to 7
  UINT64BE crossing_session_ii_dollar_value;         // bytes 8 to 15
  UINT64BE crossing_session_ii_total_trades_volume;  // bytes 16 to 23
} CrossingSessionMessage;

