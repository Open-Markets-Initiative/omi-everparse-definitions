// ---- Trading Status Message: 51 bytes ----------------------------------------

// Allows a Participant that is the listing exchange to notify CTS of Trading Halts, Resumes, Indications, Imbalances, Short Sale Restriction Indicators and LULD Reference Prices. Bidirectional.
entrypoint typedef struct _TradingStatusMessage {
  UINT8 security_symbol[11];                                   // bytes 0 to 10
  UINT8 instrument_type;                                       // byte 11
  UINT64BE last_price_opening_reopening_luld_reference_price;  // bytes 12 to 19
  UINT64BE high_indication_price_upper_limit_price_band;       // bytes 20 to 27
  UINT64BE low_indication_price_lower_limit_price_band;        // bytes 28 to 35
  UINT32BE buy_volume;                                         // bytes 36 to 39
  UINT32BE sell_volume;                                        // bytes 40 to 43
  UINT8 security_status;                                       // byte 44
  UINT8 halt_reason;                                           // byte 45
  UINT8 short_sale_restriction_indicator;                      // byte 46
  UINT32BE trading_status_id;                                  // bytes 47 to 50
} TradingStatusMessage;

// ---- Short Trade Message: 14 bytes -------------------------------------------

// Reports trade information for CTA eligible Equity, Local Issues or Bonds when the trade meets all criteria for the compact Short format; otherwise the Long Trade message is used.
entrypoint typedef struct _ShortTradeMessage {
  UINT8 security_symbol_short[5];  // bytes 0 to 4
  UINT8 sale_condition_short;      // byte 5
  UINT8 sale_condition_category;   // byte 6
  UINT16BE trade_price_short;      // bytes 7 to 8
  UINT16BE trade_volume_short;     // bytes 9 to 10
  UINT8 reserved_3[3];             // bytes 11 to 13
} ShortTradeMessage;

// ---- Fractional Short Trade Message: 16 bytes --------------------------------

// Reports trade information with fractional volume when the trade meets all criteria for the compact Short format; otherwise the Long Trade or Fractional Long Trade message is used.
entrypoint typedef struct _FractionalShortTradeMessage {
  UINT8 security_symbol_short[5];          // bytes 0 to 4
  UINT8 sale_condition_short;              // byte 5
