  UINT8 corrected_short_sale_restriction_indicator;                           // byte 31
  CorrectedPriorDayTradeDateAndTime corrected_prior_day_trade_date_and_time;  // bytes 32 to 39
  UINT8 trade_reporting_facility_id;                                          // byte 40
  UINT8 original_sale_condition[4];                                           // bytes 41 to 44
  UINT64BE original_trade_price;                                              // bytes 45 to 52
  UINT32BE original_trade_volume;                                             // bytes 53 to 56
  UINT8 original_sellers_sale_days;                                           // byte 57
  UINT8 original_stop_stock_indicator;                                        // byte 58
  UINT8 original_trade_through_exempt_indicator;                              // byte 59
  UINT8 original_short_sale_restriction_indicator;                            // byte 60
  OriginalPriorDayTradeDateAndTime original_prior_day_trade_date_and_time;    // bytes 61 to 68
} PriorDayTradeCorrectionMessage;

