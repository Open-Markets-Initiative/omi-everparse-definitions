  UINT8 corrected_short_sale_restriction_indicator;                           // byte 35
  CorrectedPriorDayTradeDateAndTime corrected_prior_day_trade_date_and_time;  // bytes 36 to 43
  UINT8 trade_reporting_facility_id;                                          // byte 44
  UINT8 original_sale_condition[4];                                           // bytes 45 to 48
  UINT64BE original_trade_price;                                              // bytes 49 to 56
  UINT64BE original_fractional_trade_volume;                                  // bytes 57 to 64
  UINT8 original_sellers_sale_days;                                           // byte 65
  UINT8 original_stop_stock_indicator;                                        // byte 66
