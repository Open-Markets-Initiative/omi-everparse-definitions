} FractionalPriorDayTradeCancelErrorMessage;

// Branch
casetype _PriorDayMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x43: PriorDayTradeCorrectionMessage prior_day_trade_correction_message;
    case 0x54: PriorDayTradeMessage prior_day_trade_message;
    case 0x58: PriorDayTradeCancelErrorMessage prior_day_trade_cancel_error_message;
    case 0x4F: FractionalPriorDayTradeCorrectionMessage fractional_prior_day_trade_correction_message;
    case 0x52: FractionalPriorDayTradeMessage fractional_prior_day_trade_message;
    case 0x45: FractionalPriorDayTradeCancelErrorMessage fractional_prior_day_trade_cancel_error_message;
    default: UINT8 unknown[available];
  }
} PriorDayMessagePayload;

// Prior Day Category Prior Day Messages Are Used To Report Cta Eligible Equity Local Issue Or Bond Trades Corrections Cancels Or Errors For Transactions That Occurred Earlier Than The Current Trading Day And Had Not Been Reported
typedef struct _PriorDayMessage (UINT32 available) where (available >= 1) {
  UINT8 prior_day_message_type;                                                                                                                // byte 0
  PriorDayMessagePayload(prior_day_message_type, (available - 1)) prior_day_message_payload[:byte-size-single-element-array (available - 1)];
} PriorDayMessage;

