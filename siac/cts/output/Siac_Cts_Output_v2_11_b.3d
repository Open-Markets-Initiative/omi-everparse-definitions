// Branch
casetype _SummaryMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: ConsolidatedStartOfDaySummaryMessage consolidated_start_of_day_summary_message;
    case 0x42: ParticipantStartOfDaySummaryMessage participant_start_of_day_summary_message;
    case 0x43: ConsolidatedEndOfDaySummaryMessage consolidated_end_of_day_summary_message;
    case 0x54: FractionalConsolidatedEndOfDaySummaryMessage fractional_consolidated_end_of_day_summary_message;
    case 0x44: ParticipantEndOfDaySummaryMessage participant_end_of_day_summary_message;
    case 0x50: FractionalParticipantEndOfDaySummaryMessage fractional_participant_end_of_day_summary_message;
    default: UINT8 unknown[available];
  }
} SummaryMessagePayload;

