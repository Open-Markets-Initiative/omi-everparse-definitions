  UINT64BE participant_reference_number;                   // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                               // bytes 22 to 32
  UINT8 instrument_type;                                   // byte 33
  SaleCondition4 sale_condition_4;                         // bytes 34 to 37
  UINT64BE trade_price;                                    // bytes 38 to 45
  UINT32BE trade_volume;                                   // bytes 46 to 49
