#define CONSOLIDATED_HIGH_LOW_LAST_INDICATOR_LOW_LAST 0x46       // Low Last
#define CONSOLIDATED_HIGH_LOW_LAST_INDICATOR_HIGH_LOW_LAST 0x47  // High Low Last
#define CONSOLIDATED_HIGH_LOW_LAST_INDICATOR_HIGH_LOW 0x48       // High Low

// Participant Open High Low Last Indicator: one byte code
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_NONE 0x41                // None
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_HIGH 0x42                // High
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_LOW 0x43                 // Low
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_LAST 0x44                // Last
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_HIGH_LAST 0x45           // High Last
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_LOW_LAST 0x46            // Low Last
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_UNUSED 0x47              // Unused
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_OPEN 0x48                // Open
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_OPEN_HIGH 0x49           // Open High
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_OPEN_LOW 0x4A            // Open Low
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_OPEN_HIGH_LOW_LAST 0x4B  // Open High Low Last
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_OPEN_LAST 0x4C           // Open Last
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_OPEN_HIGH_LOW 0x4D       // Open High Low
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_OPEN_HIGH_LAST 0x4E      // Open High Last
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_OPEN_LOW_LAST 0x4F       // Open Low Last
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_HIGH_LOW 0x50            // High Low
#define PARTICIPANT_OPEN_HIGH_LOW_LAST_INDICATOR_HIGH_LOW_LAST 0x51       // High Low Last

// Sale Condition 1: one byte code
#define SALE_CONDITION_1_REGULAR_SALE 0x20                                              // Regular Sale
#define SALE_CONDITION_1_AVERAGE_PRICE_TRADE 0x42                                       // Average Price Trade
#define SALE_CONDITION_1_CASH_TRADE_SAME_DAY_CLEARING 0x43                              // Cash Trade Same Day Clearing
#define SALE_CONDITION_1_AUTOMATIC_EXECUTION 0x45                                       // Automatic Execution
#define SALE_CONDITION_1_INTER_MARKET_SWEEP_ORDER 0x46                                  // Inter Market Sweep Order
#define SALE_CONDITION_1_PRICE_VARIATION_TRADE 0x48                                     // Price Variation Trade
#define SALE_CONDITION_1_ODD_LOT_TRADE 0x49                                             // Odd Lot Trade
#define SALE_CONDITION_1_RULE_127_NYSE_ONLY_OR_RULE_155_NYSE_AMERICAN_ONLY 0x4B         // Rule 127 Nyse Only Or Rule 155 Nyse American Only
#define SALE_CONDITION_1_SOLD_LAST_LATE_REPORTING 0x4C                                  // Sold Last Late Reporting
#define SALE_CONDITION_1_MARKET_CENTER_OFFICIAL_CLOSE 0x4D                              // Market Center Official Close
#define SALE_CONDITION_1_RESERVED_N 0x4E                                                // Reserved N
#define SALE_CONDITION_1_MARKET_CENTER_OPENING_TRADE 0x4F                               // Market Center Opening Trade
#define SALE_CONDITION_1_PRIOR_REFERENCE_PRICE 0x50                                     // Prior Reference Price
#define SALE_CONDITION_1_MARKET_CENTER_OFFICIAL_OPEN 0x51                               // Market Center Official Open
#define SALE_CONDITION_1_SELLER 0x52                                                    // Seller
#define SALE_CONDITION_1_EXTENDED_HOURS_TRADE 0x54                                      // Extended Hours Trade
#define SALE_CONDITION_1_EXTENDED_HOURS_SOLD_OUT_OF_SEQUENCE 0x55                       // Extended Hours Sold Out Of Sequence
#define SALE_CONDITION_1_CONTINGENT_TRADE 0x56                                          // Contingent Trade
#define SALE_CONDITION_1_CROSS_PERIODIC_AUCTION_TRADE 0x58                              // Cross Periodic Auction Trade
#define SALE_CONDITION_1_SOLD_OUT_OF_SEQUENCE 0x5A                                      // Sold Out Of Sequence
#define SALE_CONDITION_1_DERIVATIVELY_PRICED 0x34                                       // Derivatively Priced
#define SALE_CONDITION_1_MARKET_CENTER_REOPENING_TRADE 0x35                             // Market Center Reopening Trade
#define SALE_CONDITION_1_MARKET_CENTER_CLOSING_TRADE 0x36                               // Market Center Closing Trade
#define SALE_CONDITION_1_QUALIFIED_CONTINGENT_TRADE 0x37                                // Qualified Contingent Trade
#define SALE_CONDITION_1_RESERVED_8 0x38                                                // Reserved 8
#define SALE_CONDITION_1_CORRECTED_CONSOLIDATED_CLOSE_PRICE_AS_PER_LISTING_MARKET 0x39  // Corrected Consolidated Close Price As Per Listing Market

// Sale Condition Category: one byte code
#define SALE_CONDITION_CATEGORY_SALE_CONDITION_CATEGORY_NOT_APPLICABLE 0x20  // Sale Condition Category Not Applicable
#define SALE_CONDITION_CATEGORY_SALE_CONDITION_CATEGORY_1 0x31               // Sale Condition Category 1
#define SALE_CONDITION_CATEGORY_SALE_CONDITION_CATEGORY_2 0x32               // Sale Condition Category 2
#define SALE_CONDITION_CATEGORY_SALE_CONDITION_CATEGORY_3 0x33               // Sale Condition Category 3
#define SALE_CONDITION_CATEGORY_SALE_CONDITION_CATEGORY_4 0x34               // Sale Condition Category 4

// Security Status: one byte code
#define SECURITY_STATUS_SECURITY_STATUS_NOT_APPLICABLE 0x20  // Security Status Not Applicable
#define SECURITY_STATUS_RESERVED_1 0x31                      // Reserved 1
#define SECURITY_STATUS_TRADING_HALT 0x32                    // Trading Halt
#define SECURITY_STATUS_RESUME 0x33                          // Resume
#define SECURITY_STATUS_RESERVED_4 0x34                      // Reserved 4
#define SECURITY_STATUS_PRICE_INDICATION 0x35                // Price Indication
#define SECURITY_STATUS_TRADING_RANGE_INDICATION 0x36        // Trading Range Indication
#define SECURITY_STATUS_MARKET_IMBALANCE_BUY 0x37            // Market Imbalance Buy
#define SECURITY_STATUS_MARKET_IMBALANCE_SELL 0x38           // Market Imbalance Sell
#define SECURITY_STATUS_CLOSING_IMBALANCE_BUY 0x39           // Closing Imbalance Buy
#define SECURITY_STATUS_CLOSING_IMBALANCE_SELL 0x41          // Closing Imbalance Sell
#define SECURITY_STATUS_RESERVED_B 0x42                      // Reserved B
#define SECURITY_STATUS_NO_MARKET_IMBALANCE 0x43             // No Market Imbalance
#define SECURITY_STATUS_NO_CLOSING_IMBALANCE 0x44            // No Closing Imbalance
#define SECURITY_STATUS_SHORT_SALE_RESTRICTION 0x45          // Short Sale Restriction
#define SECURITY_STATUS_LIMIT_UP_LIMIT_DOWN 0x46             // Limit Up Limit Down

// Limit Up Limit Down Luld Indicator: one byte code
#define LIMIT_UP_LIMIT_DOWN_LULD_INDICATOR_LIMIT_UP_LIMIT_DOWN_NOT_APPLICABLE 0x20                                                // Limit Up Limit Down Not Applicable
#define LIMIT_UP_LIMIT_DOWN_LULD_INDICATOR_LIMIT_UP_LIMIT_DOWN_PRICE_BAND 0x41                                                    // Limit Up Limit Down Price Band
#define LIMIT_UP_LIMIT_DOWN_LULD_INDICATOR_REPUBLISHED_LIMIT_UP_LIMIT_DOWN_PRICE_BAND 0x42                                        // Republished Limit Up Limit Down Price Band
#define LIMIT_UP_LIMIT_DOWN_LULD_INDICATOR_NATIONAL_BEST_BID_LIMIT_STATE_ENTERED 0x43                                             // National Best Bid Limit State Entered
#define LIMIT_UP_LIMIT_DOWN_LULD_INDICATOR_NATIONAL_BEST_BID_LIMIT_STATE_EXITED 0x44                                              // National Best Bid Limit State Exited
#define LIMIT_UP_LIMIT_DOWN_LULD_INDICATOR_NATIONAL_BEST_OFFER_LIMIT_STATE_ENTERED 0x45                                           // National Best Offer Limit State Entered
#define LIMIT_UP_LIMIT_DOWN_LULD_INDICATOR_NATIONAL_BEST_OFFER_LIMIT_STATE_EXITED 0x46                                            // National Best Offer Limit State Exited
#define LIMIT_UP_LIMIT_DOWN_LULD_INDICATOR_NATIONAL_BEST_BID_AND_NATIONAL_BEST_OFFER_LIMIT_STATE_ENTERED 0x47                     // National Best Bid And National Best Offer Limit State Entered
#define LIMIT_UP_LIMIT_DOWN_LULD_INDICATOR_NATIONAL_BEST_BID_AND_NATIONAL_BEST_OFFER_LIMIT_STATE_EXITED 0x48                      // National Best Bid And National Best Offer Limit State Exited
#define LIMIT_UP_LIMIT_DOWN_LULD_INDICATOR_NATIONAL_BEST_BID_LIMIT_STATE_ENTERED_AND_NATIONAL_BEST_OFFER_LIMIT_STATE_EXITED 0x49  // National Best Bid Limit State Entered And National Best Offer Limit State Exited
#define LIMIT_UP_LIMIT_DOWN_LULD_INDICATOR_NATIONAL_BEST_BID_LIMIT_STATE_EXITED_AND_NATIONAL_BEST_OFFER_LIMIT_STATE_ENTERED 0x4A  // National Best Bid Limit State Exited And National Best Offer Limit State Entered

// ---- Types -------------------------------------------------------------------

// Cta packet timestamp
typedef struct _SIPBlockTimestamp {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} SIPBlockTimestamp;

// Timestamp 1
typedef struct _Timestamp1 {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} Timestamp1;

// Used to signal the start of Consolidated End of Day Summary and Participant End of Day Summary message iterations
typedef struct _StartOfEndOfDaySummaryMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} StartOfEndOfDaySummaryMessage;

// Used to signal the end of Consolidated End of Day Summary and Participant End of Day Summary message iterations
typedef struct _EndOfEndOfDaySummaryMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} EndOfEndOfDaySummaryMessage;

// Used to signal the start of Start of Day Summary message iterations
typedef struct _StartOfStartOfDaySummaryMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} StartOfStartOfDaySummaryMessage;

// Used to signal the end of Start of Day Summary message iterations
typedef struct _EndOfStartOfDaySummaryMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} EndOfStartOfDaySummaryMessage;

// Symbol Reference Data message
typedef struct _SymbolReferenceDataMessage {
  UINT8 participant_id;                                    // byte 0
  Timestamp1 timestamp_1;                                  // bytes 1 to 8
  UINT8 message_id;                                        // byte 9
  UINT32BE transaction_id;                                 // bytes 10 to 13
  UINT64BE participant_reference_number;                   // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                               // bytes 22 to 32
  UINT8 prior_security_symbol[11];                         // bytes 33 to 43
  UINT8 primary_listing_market_participant_id;             // byte 44
  UINT64BE primary_listing_market_previous_closing_price;  // bytes 45 to 52
  UINT64BE consolidated_closing_price;                     // bytes 53 to 60
  UINT16BE round_lot_size;                                 // bytes 61 to 62
  UINT8 minimum_price_increment_indicator;                 // byte 63
  UINT8 luld_tier;                                         // byte 64
  UINT32BE luld_leverage_ratio;                            // bytes 65 to 68
  UINT8 test;                                              // byte 69
  UINT8 ipo;                                               // byte 70
  UINT8 financial_status_indicator;                        // byte 71
  UINT8 short_sale_restriction_indicator;                  // byte 72
  UINT8 halt_reason;                                       // byte 73
  UINT8 instrument_type;                                   // byte 74
  UINT8 reserved;                                          // byte 75
  UINT8 second_reserved;                                   // byte 76
  UINT8 reserved_128[128];                                 // bytes 77 to 204
} SymbolReferenceDataMessage;

// Branch
casetype _AdministrativeMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: StartOfEndOfDaySummaryMessage start_of_end_of_day_summary_message;
    case 0x42: EndOfEndOfDaySummaryMessage end_of_end_of_day_summary_message;
    case 0x43: StartOfStartOfDaySummaryMessage start_of_start_of_day_summary_message;
    case 0x44: EndOfStartOfDaySummaryMessage end_of_start_of_day_summary_message;
    case 0x53: SymbolReferenceDataMessage symbol_reference_data_message;
    default: UINT8 unknown[available];
  }
} AdministrativeMessagePayload;

// Administrative Category
typedef struct _AdministrativeMessage (UINT32 available) where (available >= 1) {
  UINT8 administrative_message_type;                                                                                                                           // byte 0
  AdministrativeMessagePayload(administrative_message_type, (available - 1)) administrative_message_payload[:byte-size-single-element-array (available - 1)];
} AdministrativeMessage;

// Signals the start of normal data dissemination over the multicast lines
typedef struct _StartOfDayMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} StartOfDayMessage;

// Transmitted when the Block Sequence Number on an output multicast line requires resetting
typedef struct _ResetBlockSequenceNumberMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} ResetBlockSequenceNumberMessage;

// Signifies that the Consolidated Tape System has switched processing from the Primary Data Center to the Disaster Recovery Data Center
typedef struct _DisasterRecoveryDataCenterActivationMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} DisasterRecoveryDataCenterActivationMessage;

// Transmitted over the multicast lines at frequent intervals to verify continued integrity of multicast transmission
typedef struct _LineIntegrityMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} LineIntegrityMessage;

// Transmitted over the multicast lines to advise all Data Recipients that there are no further messages to be transmitted for the day
typedef struct _EndOfDayMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} EndOfDayMessage;

// Branch
casetype _ControlMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: StartOfDayMessage start_of_day_message;
    case 0x4C: ResetBlockSequenceNumberMessage reset_block_sequence_number_message;
    case 0x50: DisasterRecoveryDataCenterActivationMessage disaster_recovery_data_center_activation_message;
    case 0x54: LineIntegrityMessage line_integrity_message;
    case 0x5A: EndOfDayMessage end_of_day_message;
    default: UINT8 unknown[available];
  }
} ControlMessagePayload;

// Control Category
typedef struct _ControlMessage (UINT32 available) where (available >= 1) {
  UINT8 control_message_type;                                                                                                             // byte 0
  ControlMessagePayload(control_message_type, (available - 1)) control_message_payload[:byte-size-single-element-array (available - 1)];
} ControlMessage;

// The Index message contains the index and the index value
typedef struct _IndexMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 index_symbol[11];                 // bytes 22 to 32
  UINT64BE index_value;                   // bytes 33 to 40, signed, read here as unsigned
} IndexMessage;

// The Bid and Offer Index message contains the index Bid and Offer index values
typedef struct _BidAndOfferIndexMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 index_symbol[11];                 // bytes 22 to 32
  UINT64BE bid_index_value;               // bytes 33 to 40, signed, read here as unsigned
  UINT64BE offer_index_value;             // bytes 41 to 48, signed, read here as unsigned
} BidAndOfferIndexMessage;

// Branch
casetype _IndicesMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x49: IndexMessage index_message;
    case 0x51: BidAndOfferIndexMessage bid_and_offer_index_message;
    default: UINT8 unknown[available];
  }
} IndicesMessagePayload;

// Index Category Index Messages Are Used To Provide Index Value Information Of A Security
typedef struct _IndicesMessage (UINT32 available) where (available >= 1) {
  UINT8 indices_message_type;                                                                                                             // byte 0
  IndicesMessagePayload(indices_message_type, (available - 1)) indices_message_payload[:byte-size-single-element-array (available - 1)];
} IndicesMessage;

// Reports the calculated Level 1, Level 2 and Level 3 threshold values for the current trading day necessary to trigger a circuit breaker
typedef struct _MarketWideCircuitBreakerDeclineLevelStatusMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
  UINT64BE mwcb_level_1;                  // bytes 22 to 29, signed, read here as unsigned
  UINT64BE mwcb_level_2;                  // bytes 30 to 37, signed, read here as unsigned
  UINT64BE mwcb_level_3;                  // bytes 38 to 45, signed, read here as unsigned
  UINT8 reserved;                         // byte 46
} MarketWideCircuitBreakerDeclineLevelStatusMessage;

// Reports the Market-Wide Circuit Breaker threshold Level that has been breached
typedef struct _MarketWideCircuitBreakerStatusMessage {
  UINT8 participant_id;                               // byte 0
  Timestamp1 timestamp_1;                             // bytes 1 to 8
  UINT8 message_id;                                   // byte 9
  UINT32BE transaction_id;                            // bytes 10 to 13
  UINT64BE participant_reference_number;              // bytes 14 to 21, signed, read here as unsigned
  UINT8 market_wide_circuit_breaker_level_indicator;  // byte 22
  UINT8 reserved;                                     // byte 23
} MarketWideCircuitBreakerStatusMessage;

// Active Participants for Approximate Adjusted Volume Market Center
typedef struct _ApproximateVolumeParticipant {
  UINT8 participant_id;         // byte 0
  UINT64BE trade_total_volume;  // bytes 1 to 8
} ApproximateVolumeParticipant;

// Used to report the volume of adjusted trading activity for each Participant. To be descoped when Fractional Trade Volume publication is activated
typedef struct _ApproximateAdjustedVolumeMarketCenterMessage {
  UINT8 participant_id;                                                                                             // byte 0
  Timestamp1 timestamp_1;                                                                                           // bytes 1 to 8
  UINT8 message_id;                                                                                                 // byte 9
  UINT32BE transaction_id;                                                                                          // bytes 10 to 13
  UINT64BE participant_reference_number;                                                                            // bytes 14 to 21, signed, read here as unsigned
  UINT8 number_of_participants;                                                                                     // byte 22
  ApproximateVolumeParticipant approximate_volume_participant[:byte-size (((UINT32) number_of_participants) * 9)];
} ApproximateAdjustedVolumeMarketCenterMessage;

// Active Participants
typedef struct _Participant {
  UINT8 participant_id;                    // byte 0
  UINT64BE fractional_trade_total_volume;  // bytes 1 to 8
} Participant;

// Used to report the volume of adjusted trading activity for each Participant. Volume is represented as a fractional value
typedef struct _FractionalApproximateAdjustedVolumeMarketCenterMessage {
  UINT8 participant_id;                                                         // byte 0
  Timestamp1 timestamp_1;                                                       // bytes 1 to 8
  UINT8 message_id;                                                             // byte 9
  UINT32BE transaction_id;                                                      // bytes 10 to 13
  UINT64BE participant_reference_number;                                        // bytes 14 to 21, signed, read here as unsigned
  UINT8 number_of_participants;                                                 // byte 22
  Participant participant[:byte-size (((UINT32) number_of_participants) * 9)];
} FractionalApproximateAdjustedVolumeMarketCenterMessage;

// Allows a Participant to report the total trades and total dollar value of trades at their respective market centers
typedef struct _ApproximateTradesAndTotalDollarValueMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
  UINT32BE total_trades;                  // bytes 22 to 25
  UINT64BE dollar_value;                  // bytes 26 to 33
} ApproximateTradesAndTotalDollarValueMessage;

// Used to report the total volume and dollar value of trades transacted after the close of a Participant's regular session
typedef struct _CrossingSessionSummaryMessage {
  UINT8 participant_id;                              // byte 0
  Timestamp1 timestamp_1;                            // bytes 1 to 8
  UINT8 message_id;                                  // byte 9
  UINT32BE transaction_id;                           // bytes 10 to 13
  UINT64BE participant_reference_number;             // bytes 14 to 21, signed, read here as unsigned
  UINT64BE crossing_session_i_total_trades_volume;   // bytes 22 to 29
  UINT64BE crossing_session_ii_dollar_value;         // bytes 30 to 37
  UINT64BE crossing_session_ii_total_trades_volume;  // bytes 38 to 45
} CrossingSessionSummaryMessage;

// Branch
casetype _MarketStatusMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x4B: MarketWideCircuitBreakerDeclineLevelStatusMessage market_wide_circuit_breaker_decline_level_status_message;
    case 0x4C: MarketWideCircuitBreakerStatusMessage market_wide_circuit_breaker_status_message;
    case 0x4E: ApproximateAdjustedVolumeMarketCenterMessage approximate_adjusted_volume_market_center_message;
    case 0x56: FractionalApproximateAdjustedVolumeMarketCenterMessage fractional_approximate_adjusted_volume_market_center_message;
    case 0x4F: ApproximateTradesAndTotalDollarValueMessage approximate_trades_and_total_dollar_value_message;
    case 0x50: CrossingSessionSummaryMessage crossing_session_summary_message;
    default: UINT8 unknown[available];
  }
} MarketStatusMessagePayload;

// Market Status Category Market Status Messages Are Used To Provide Market Data Information
typedef struct _MarketStatusMessage (UINT32 available) where (available >= 1) {
  UINT8 market_status_message_type;                                                                                                                        // byte 0
  MarketStatusMessagePayload(market_status_message_type, (available - 1)) market_status_message_payload[:byte-size-single-element-array (available - 1)];
} MarketStatusMessage;

// The corrected prior day trade date and time
typedef struct _CorrectedPriorDayTradeDateAndTime {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} CorrectedPriorDayTradeDateAndTime;

// The original prior day trade date and time
typedef struct _OriginalPriorDayTradeDateAndTime {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} OriginalPriorDayTradeDateAndTime;

// Used to correct a transaction originally reported on a trading day earlier than the current trading day. To be descoped when Fractional Trade Volume publication is activated
typedef struct _PriorDayTradeCorrectionMessage {
  UINT8 participant_id;                                                       // byte 0
  Timestamp1 timestamp_1;                                                     // bytes 1 to 8
  UINT8 message_id;                                                           // byte 9
  UINT32BE transaction_id;                                                    // bytes 10 to 13
  UINT64BE participant_reference_number;                                      // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                                                  // bytes 22 to 32
  UINT8 instrument_type;                                                      // byte 33
  UINT8 corrected_sale_condition[4];                                          // bytes 34 to 37
  UINT64BE corrected_trade_price;                                             // bytes 38 to 45
  UINT32BE corrected_trade_volume;                                            // bytes 46 to 49
  UINT8 corrected_sellers_sale_days;                                          // byte 50
  UINT8 corrected_stop_stock_indicator;                                       // byte 51
  UINT8 corrected_trade_through_exempt_indicator;                             // byte 52
  UINT8 corrected_short_sale_restriction_indicator;                           // byte 53
  CorrectedPriorDayTradeDateAndTime corrected_prior_day_trade_date_and_time;  // bytes 54 to 61
  UINT8 trade_reporting_facility_id;                                          // byte 62
  UINT8 original_sale_condition[4];                                           // bytes 63 to 66
  UINT64BE original_trade_price;                                              // bytes 67 to 74
  UINT32BE original_trade_volume;                                             // bytes 75 to 78
  UINT8 original_sellers_sale_days;                                           // byte 79
  UINT8 original_stop_stock_indicator;                                        // byte 80
  UINT8 original_trade_through_exempt_indicator;                              // byte 81
  UINT8 original_short_sale_restriction_indicator;                            // byte 82
  OriginalPriorDayTradeDateAndTime original_prior_day_trade_date_and_time;    // bytes 83 to 90
} PriorDayTradeCorrectionMessage;

// Sale Condition 4
typedef struct _SaleCondition4 {
  UINT8 category_1;  // byte 0
  UINT8 category_2;  // byte 1
  UINT8 category_3;  // byte 2
  UINT8 category_4;  // byte 3
} SaleCondition4;

// The date and time the prior day trade was executed
typedef struct _PriorDayTradeDateAndTime {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} PriorDayTradeDateAndTime;

// Used to report a CTA Equity, Local Issue or Bond transaction which occurred earlier than the current trading day and was not reported. To be descoped when Fractional Trade Volume publication is activated
typedef struct _PriorDayTradeMessage {
  UINT8 participant_id;                                    // byte 0
  Timestamp1 timestamp_1;                                  // bytes 1 to 8
  UINT8 message_id;                                        // byte 9
  UINT32BE transaction_id;                                 // bytes 10 to 13
  UINT64BE participant_reference_number;                   // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                               // bytes 22 to 32
  UINT8 instrument_type;                                   // byte 33
  SaleCondition4 sale_condition_4;                         // bytes 34 to 37
  UINT64BE trade_price;                                    // bytes 38 to 45
  UINT32BE trade_volume;                                   // bytes 46 to 49
  UINT8 sellers_sale_days;                                 // byte 50
  UINT8 stop_stock_indicator;                              // byte 51
  UINT8 trade_through_exempt_indicator;                    // byte 52
  UINT8 short_sale_restriction_indicator;                  // byte 53
  UINT8 trade_reporting_facility_id;                       // byte 54
  PriorDayTradeDateAndTime prior_day_trade_date_and_time;  // bytes 55 to 62
} PriorDayTradeMessage;

// Used to report the cancellation of a trade or error a trade that never took place but was reported, for transactions originally reported earlier than the current day. To be descoped when Fractional Trade Volume publication is activated
typedef struct _PriorDayTradeCancelErrorMessage {
