  UINT8 instrument_type;                                  // byte 33
  UINT64BE last_price;                                    // bytes 34 to 41
  UINT64BE high_indication_price_upper_limit_price_band;  // bytes 42 to 49
  UINT64BE low_indication_price_lower_limit_price_band;   // bytes 50 to 57
  UINT32BE buy_volume;                                    // bytes 58 to 61
  UINT32BE sell_volume;                                   // bytes 62 to 65
  UINT8 security_status;                                  // byte 66
  UINT8 halt_reason;                                      // byte 67
  UINT8 short_sale_restriction_indicator;                 // byte 68
  UINT8 primary_listing_market_participant_id;            // byte 69
  UINT8 financial_status_indicator;                       // byte 70
  UINT8 limit_up_limit_down_luld_indicator;               // byte 71
} TradingStatusMessage;

// Used to report trade information for CTA eligible Equity only. Volume is represented as a fractional value. Not published by CTS currently, message type is reserved for future use
typedef struct _FractionalShortTradeMessage {
  UINT8 participant_id;                            // byte 0
  Timestamp1 timestamp_1;                          // bytes 1 to 8
  UINT8 message_id;                                // byte 9
  UINT32BE transaction_id;                         // bytes 10 to 13
  UINT64BE participant_reference_number;           // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol_5[5];                      // bytes 22 to 26
  UINT8 sale_condition_1;                          // byte 27
  UINT8 sale_condition_category;                   // byte 28
  UINT16BE trade_price_2;                          // bytes 29 to 30
  UINT32BE fractional_trade_volume_4;              // bytes 31 to 34
  UINT8 primary_listing_market_participant_id;     // byte 35
  UINT8 consolidated_high_low_last_indicator;      // byte 36
  UINT8 participant_open_high_low_last_indicator;  // byte 37
} FractionalShortTradeMessage;

// Used to cancel or error CTA eligible securities, Local Issues or Bond information. Volume is represented as a fractional value
typedef struct _FractionalTradeCancelErrorMessage {
  UINT8 participant_id;                             // byte 0
  Timestamp1 timestamp_1;                           // bytes 1 to 8
  UINT8 message_id;                                 // byte 9
  UINT32BE transaction_id;                          // bytes 10 to 13
  UINT64BE participant_reference_number;            // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                        // bytes 22 to 32
  UINT8 instrument_type;                            // byte 33
  SaleCondition4 sale_condition_4;                  // bytes 34 to 37
  UINT64BE trade_price;                             // bytes 38 to 45
  UINT64BE fractional_trade_volume;                 // bytes 46 to 53
  UINT8 sellers_sale_days;                          // byte 54
  UINT8 stop_stock_indicator;                       // byte 55
  UINT8 trade_through_exempt_indicator;             // byte 56
  UINT8 trade_reporting_facility_id;                // byte 57
  UINT64BE original_participant_reference_number;   // bytes 58 to 65, signed, read here as unsigned
  Timestamp2 timestamp_2;                           // bytes 66 to 73
  UINT8 cancel_error_action;                        // byte 74
  UINT8 short_sale_restriction_indicator;           // byte 75
  UINT8 primary_listing_market_participant_id;      // byte 76
  UINT8 financial_status_indicator;                 // byte 77
  UINT32BE consolidated_previous_close_price_date;  // bytes 78 to 81
  UINT8 consolidated_last_participant_id;           // byte 82
  UINT64BE consolidated_last_price;                 // bytes 83 to 90
  UINT64BE consolidated_high_price;                 // bytes 91 to 98
  UINT64BE consolidated_low_price;                  // bytes 99 to 106
  UINT64BE consolidated_fractional_total_volume;    // bytes 107 to 114
  UINT8 consolidated_tick;                          // byte 115
  UINT32BE participant_previous_close_price_date;   // bytes 116 to 119
  UINT64BE participant_last_price;                  // bytes 120 to 127
  UINT64BE participant_high_price;                  // bytes 128 to 135
  UINT64BE participant_low_price;                   // bytes 136 to 143
  UINT64BE participant_open_price;                  // bytes 144 to 151
  UINT64BE participant_fractional_total_volume;     // bytes 152 to 159
  UINT8 participant_tick;                           // byte 160
} FractionalTradeCancelErrorMessage;

// Branch
casetype _TradeMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: AuctionStatusMessage auction_status_message;
    case 0x43: TradeCorrectionMessage trade_correction_message;
    case 0x4C: LongTradeMessage long_trade_message;
    case 0x54: ShortTradeMessage short_trade_message;
    case 0x58: TradeCancelErrorMessage trade_cancel_error_message;
    case 0x4F: FractionalTradeCorrectionMessage fractional_trade_correction_message;
    case 0x52: FractionalLongTradeMessage fractional_long_trade_message;
    case 0x53: TradingStatusMessage trading_status_message;
    case 0x48: FractionalShortTradeMessage fractional_short_trade_message;
    case 0x45: FractionalTradeCancelErrorMessage fractional_trade_cancel_error_message;
    default: UINT8 unknown[available];
  }
} TradeMessagePayload;

// Trade Category Trade Messages Are Used To Report Cta Eligible Equity Local Issue Or Bond Information
typedef struct _TradeMessage (UINT32 available) where (available >= 1) {
  UINT8 trade_message_type;                                                                                                         // byte 0
  TradeMessagePayload(trade_message_type, (available - 1)) trade_message_payload[:byte-size-single-element-array (available - 1)];
} TradeMessage;

// Branch
casetype _CategoryPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: AdministrativeMessage(available) administrative_message;
    case 0x43: ControlMessage(available) control_message;
    case 0x49: IndicesMessage(available) indices_message;
    case 0x4D: MarketStatusMessage(available) market_status_message;
    case 0x50: PriorDayMessage(available) prior_day_message;
    case 0x53: SummaryMessage(available) summary_message;
    case 0x54: TradeMessage(available) trade_message;
    default: UINT8 unknown[available];
  }
} CategoryPayload;

// Repeating message block
typedef struct _Message {
  UINT16BE message_length { message_length >= 3 };                                                                                                       // bytes 0 to 1
  UINT8 message_category;                                                                                                                                // byte 2
  CategoryPayload(message_category, (((UINT32) message_length) - 3)) category_payload[:byte-size-single-element-array (((UINT32) message_length) - 3)];
} Message;

// Repeating message block
casetype _MessagePart1 (Bool present) {
  switch (present) {
    case true: Message block;
    case false: unit none;
  }
} MessagePart1;

// Repeating message block
typedef struct _MessageBlock2 {
  Message first;
  Message second;
} MessageBlock2;

// Repeating message block
casetype _MessagePart2 (Bool present) {
  switch (present) {
    case true: MessageBlock2 block;
    case false: unit none;
  }
} MessagePart2;

// Repeating message block
typedef struct _MessageBlock4 {
  MessageBlock2 first;
  MessageBlock2 second;
} MessageBlock4;

// Repeating message block
casetype _MessagePart4 (Bool present) {
  switch (present) {
    case true: MessageBlock4 block;
    case false: unit none;
  }
} MessagePart4;

// Repeating message block
typedef struct _MessageBlock8 {
  MessageBlock4 first;
  MessageBlock4 second;
} MessageBlock8;

// Repeating message block
casetype _MessagePart8 (Bool present) {
  switch (present) {
    case true: MessageBlock8 block;
    case false: unit none;
  }
} MessagePart8;

// Repeating message block
typedef struct _MessageBlock16 {
  MessageBlock8 first;
  MessageBlock8 second;
} MessageBlock16;

// Repeating message block
casetype _MessagePart16 (Bool present) {
  switch (present) {
    case true: MessageBlock16 block;
    case false: unit none;
  }
} MessagePart16;

// Repeating message block
typedef struct _MessageBlock32 {
  MessageBlock16 first;
  MessageBlock16 second;
} MessageBlock32;

// Repeating message block
casetype _MessagePart32 (Bool present) {
  switch (present) {
    case true: MessageBlock32 block;
    case false: unit none;
  }
} MessagePart32;

// Repeating message block
typedef struct _MessageBlock64 {
  MessageBlock32 first;
  MessageBlock32 second;
} MessageBlock64;

// Repeating message block
casetype _MessagePart64 (Bool present) {
  switch (present) {
    case true: MessageBlock64 block;
    case false: unit none;
  }
} MessagePart64;

// Repeating message block
typedef struct _MessageBlock128 {
  MessageBlock64 first;
  MessageBlock64 second;
} MessageBlock128;

// Repeating message block
casetype _MessagePart128 (Bool present) {
  switch (present) {
    case true: MessageBlock128 block;
    case false: unit none;
  }
} MessagePart128;

// Repeating message block
typedef struct _MessageCounted (UINT32 count) {
  MessagePart128(((count & 128) != 0)) part128;
  MessagePart64(((count & 64) != 0)) part64;
  MessagePart32(((count & 32) != 0)) part32;
  MessagePart16(((count & 16) != 0)) part16;
  MessagePart8(((count & 8) != 0)) part8;
  MessagePart4(((count & 4) != 0)) part4;
  MessagePart2(((count & 2) != 0)) part2;
  MessagePart1(((count & 1) != 0)) part1;
} MessageCounted;

// ---- Packet: Packet ----------------------------------------------------------

// Cta Udp Packet
entrypoint typedef struct _Packet {
  UINT8 version;                                         // byte 0
  UINT16BE block_size;                                   // bytes 1 to 2
  UINT8 data_feed_indicator;                             // byte 3
  UINT8 retransmission_indicator;                        // byte 4
  UINT32BE block_sequence_number;                        // bytes 5 to 8
  UINT8 messages_in_block;                               // byte 9
  SIPBlockTimestamp s_i_p_block_timestamp;               // bytes 10 to 17
  UINT16BE block_checksum;                               // bytes 18 to 19
  MessageCounted(((UINT32) messages_in_block)) message;
  UINT8 block_pad_byte[:consume-all];
} Packet;

