#define HALT_REASON_ORDER_IMBALANCE 0x49                               // Order Imbalance
#define HALT_REASON_LIMIT_UP_LIMIT_DOWN_TRADING_PAUSE 0x4D             // Limit Up Limit Down Trading Pause
#define HALT_REASON_CORPORATE_ACTION 0x4E                              // Corporate Action
#define HALT_REASON_NEW_SECURITY_OFFERING 0x4F                         // New Security Offering
#define HALT_REASON_NEWS_PENDING 0x50                                  // News Pending
#define HALT_REASON_INTRADAY_INDICATIVE_VALUE_NOT_AVAILABLE 0x56       // Intraday Indicative Value Not Available
#define HALT_REASON_OPERATIONAL 0x58                                   // Operational
#define HALT_REASON_SUBPENNY_TRADING 0x59                              // Subpenny Trading
#define HALT_REASON_MARKET_WIDE_CIRCUIT_BREAKER_LEVEL_1_BREACHED 0x31  // Market Wide Circuit Breaker Level 1 Breached
#define HALT_REASON_MARKET_WIDE_CIRCUIT_BREAKER_LEVEL_2_BREACHED 0x32  // Market Wide Circuit Breaker Level 2 Breached
#define HALT_REASON_MARKET_WIDE_CIRCUIT_BREAKER_LEVEL_3_BREACHED 0x33  // Market Wide Circuit Breaker Level 3 Breached

// Limit Up Limit Down Indicator: one byte code
#define LIMIT_UP_LIMIT_DOWN_INDICATOR_NOT_APPLICABLE 0x20                                                                    // Not Applicable
#define LIMIT_UP_LIMIT_DOWN_INDICATOR_LIMIT_UP_LIMIT_DOWN_PRICE_BAND 0x41                                                    // Limit Up Limit Down Price Band
#define LIMIT_UP_LIMIT_DOWN_INDICATOR_REPUBLISHED_LIMIT_UP_LIMIT_DOWN_PRICE_BAND 0x42                                        // Republished Limit Up Limit Down Price Band
#define LIMIT_UP_LIMIT_DOWN_INDICATOR_NATIONAL_BEST_BID_LIMIT_STATE_ENTERED 0x43                                             // National Best Bid Limit State Entered
#define LIMIT_UP_LIMIT_DOWN_INDICATOR_NATIONAL_BEST_BID_LIMIT_STATE_EXITED 0x44                                              // National Best Bid Limit State Exited
#define LIMIT_UP_LIMIT_DOWN_INDICATOR_NATIONAL_BEST_OFFER_LIMIT_STATE_ENTERED 0x45                                           // National Best Offer Limit State Entered
#define LIMIT_UP_LIMIT_DOWN_INDICATOR_NATIONAL_BEST_OFFER_LIMIT_STATE_EXITED 0x46                                            // National Best Offer Limit State Exited
#define LIMIT_UP_LIMIT_DOWN_INDICATOR_NATIONAL_BEST_BID_AND_NATIONAL_BEST_OFFER_LIMIT_STATE_ENTERED 0x47                     // National Best Bid And National Best Offer Limit State Entered
#define LIMIT_UP_LIMIT_DOWN_INDICATOR_NATIONAL_BEST_BID_AND_NATIONAL_BEST_OFFER_LIMIT_STATE_EXITED 0x48                      // National Best Bid And National Best Offer Limit State Exited
#define LIMIT_UP_LIMIT_DOWN_INDICATOR_NATIONAL_BEST_BID_LIMIT_STATE_ENTERED_AND_NATIONAL_BEST_OFFER_LIMIT_STATE_EXITED 0x49  // National Best Bid Limit State Entered And National Best Offer Limit State Exited
#define LIMIT_UP_LIMIT_DOWN_INDICATOR_NATIONAL_BEST_BID_LIMIT_STATE_EXITED_AND_NATIONAL_BEST_OFFER_LIMIT_STATE_ENTERED 0x4A  // National Best Bid Limit State Exited And National Best Offer Limit State Entered

// Sale Condition: one byte code
#define SALE_CONDITION_REGULAR_SALE 0x20                                              // Regular Sale
#define SALE_CONDITION_AVERAGE_PRICE_TRADE 0x42                                       // Average Price Trade
#define SALE_CONDITION_CASH_TRADE 0x43                                                // Cash Trade
#define SALE_CONDITION_AUTOMATIC_EXECUTION 0x45                                       // Automatic Execution
#define SALE_CONDITION_INTERMARKET_SWEEP_ORDER 0x46                                   // Intermarket Sweep Order
#define SALE_CONDITION_PRICE_VARIATION_TRADE 0x48                                     // Price Variation Trade
#define SALE_CONDITION_ODD_LOT_TRADE 0x49                                             // Odd Lot Trade
#define SALE_CONDITION_RULE_127_OR_155 0x4B                                           // Rule 127 Or 155
#define SALE_CONDITION_SOLD_LAST 0x4C                                                 // Sold Last
#define SALE_CONDITION_MARKET_CENTER_OFFICIAL_CLOSE 0x4D                              // Market Center Official Close
#define SALE_CONDITION_NEXT_DAY_TRADE 0x4E                                            // Next Day Trade
#define SALE_CONDITION_MARKET_CENTER_OPENING_TRADE 0x4F                               // Market Center Opening Trade
#define SALE_CONDITION_PRIOR_REFERENCE_PRICE 0x50                                     // Prior Reference Price
#define SALE_CONDITION_MARKET_CENTER_OFFICIAL_OPEN 0x51                               // Market Center Official Open
#define SALE_CONDITION_SELLER 0x52                                                    // Seller
#define SALE_CONDITION_EXTENDED_HOURS_TRADE 0x54                                      // Extended Hours Trade
#define SALE_CONDITION_EXTENDED_HOURS_SOLD 0x55                                       // Extended Hours Sold
#define SALE_CONDITION_CONTINGENT_TRADE 0x56                                          // Contingent Trade
#define SALE_CONDITION_CROSS_TRADE 0x58                                               // Cross Trade
#define SALE_CONDITION_SOLD 0x5A                                                      // Sold
#define SALE_CONDITION_DERIVATIVELY_PRICED 0x34                                       // Derivatively Priced
#define SALE_CONDITION_MARKET_CENTER_REOPENING_TRADE 0x35                             // Market Center Reopening Trade
#define SALE_CONDITION_MARKET_CENTER_CLOSING_TRADE 0x36                               // Market Center Closing Trade
#define SALE_CONDITION_QUALIFIED_CONTINGENT_TRADE 0x37                                // Qualified Contingent Trade
#define SALE_CONDITION_RESERVED 0x38                                                  // Reserved
#define SALE_CONDITION_CORRECTED_CONSOLIDATED_CLOSE_PRICE_AS_PER_LISTING_MARKET 0x39  // Corrected Consolidated Close Price As Per Listing Market

// Sale Condition Category: one byte code
#define SALE_CONDITION_CATEGORY_NOT_APPLICABLE 0x20  // Not Applicable
#define SALE_CONDITION_CATEGORY_CATEGORY_1 0x31      // Category 1
#define SALE_CONDITION_CATEGORY_CATEGORY_2 0x32      // Category 2
#define SALE_CONDITION_CATEGORY_CATEGORY_3 0x33      // Category 3
#define SALE_CONDITION_CATEGORY_CATEGORY_4 0x34      // Category 4

// ---- Types -------------------------------------------------------------------

// Sip Block Timestamp
typedef struct _SipBlockTimestamp {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} SipBlockTimestamp;

// Timestamp 1
typedef struct _Timestamp1 {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} Timestamp1;

// The Start of End of Day message signals the start of Consolidated End of Day Summary and Participant End of Day Summary message iterations
typedef struct _StartOfEndOfDaySummaryMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} StartOfEndOfDaySummaryMessage;

// The End of End of Day message signals the end of Consolidated End of Day Summary and Participant End of Day Summary message iterations
typedef struct _EndOfEndOfDaySummaryMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} EndOfEndOfDaySummaryMessage;

// The Start of Start of Day message signals the end of Consolidated End of Day Summary and Participant End of Day Summary message iterations
typedef struct _StartOfStartOfDaySummaryMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} StartOfStartOfDaySummaryMessage;

// The End of Start of Day message signals the start of Start of Day Summary message iterations
typedef struct _EndOfStartOfDaySummaryMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} EndOfStartOfDaySummaryMessage;

// Branch
casetype _AdministrativeMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: StartOfEndOfDaySummaryMessage start_of_end_of_day_summary_message;
    case 0x42: EndOfEndOfDaySummaryMessage end_of_end_of_day_summary_message;
    case 0x43: StartOfStartOfDaySummaryMessage start_of_start_of_day_summary_message;
    case 0x44: EndOfStartOfDaySummaryMessage end_of_start_of_day_summary_message;
    default: UINT8 unknown[available];
  }
} AdministrativeMessagePayload;

// Administrative Message Header
typedef struct _AdministrativeMessage (UINT32 available) where (available >= 1) {
  UINT8 administrative_message_type;                                                                                                                           // byte 0
  AdministrativeMessagePayload(administrative_message_type, (available - 1)) administrative_message_payload[:byte-size-single-element-array (available - 1)];
} AdministrativeMessage;

// The Start of Day message signals the start of normal data dissemination over the multicast lines
typedef struct _StartOfDayMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} StartOfDayMessage;

// The Reset Block Sequence Number message is transmitted when the block sequence number on an output multicast line requires resetting.
typedef struct _ResetBlockSequenceNumberMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} ResetBlockSequenceNumberMessage;

// The Disaster Recovery Data Center Activation message is transmitted to signify that the Consolidated Quotation System (CQS) has switched processing from the Primary Data Center to the Disaster Recovery Data Center
typedef struct _DisasterRecoveryDataCenterActivationMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} DisasterRecoveryDataCenterActivationMessage;

// The Line Integrity message is transmitted over the multicast lines at intervals of sixty (60) seconds to verify continued integrity of multicast transmission
typedef struct _LineIntegrityMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} LineIntegrityMessage;

// The End of Day message is transmitted over the multicast lines to advise all Data Recipients that there are no further messages of any type transmitted for the day
typedef struct _EndOfDayMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
} EndOfDayMessage;

// Branch
casetype _ControlMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: StartOfDayMessage start_of_day_message;
    case 0x4C: ResetBlockSequenceNumberMessage reset_block_sequence_number_message;
    case 0x50: DisasterRecoveryDataCenterActivationMessage disaster_recovery_data_center_activation_message;
    case 0x54: LineIntegrityMessage line_integrity_message;
    case 0x5A: EndOfDayMessage end_of_day_message;
    default: UINT8 unknown[available];
  }
} ControlMessagePayload;

// Control Message Header
typedef struct _ControlMessage (UINT32 available) where (available >= 1) {
  UINT8 control_message_type;                                                                                                             // byte 0
  ControlMessagePayload(control_message_type, (available - 1)) control_message_payload[:byte-size-single-element-array (available - 1)];
} ControlMessage;

// The Index message contains the index and the index value
typedef struct _IndexMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 index_symbol[11];                 // bytes 22 to 32
  UINT64BE index_value;                   // bytes 33 to 40, signed, read here as unsigned
} IndexMessage;

// The Bid and Offer Index message contains the index Bid and Offer index values
typedef struct _BidAndOfferIndexMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 index_symbol[11];                 // bytes 22 to 32
  UINT64BE bid_index_value;               // bytes 33 to 40, signed, read here as unsigned
  UINT64BE offer_index_value;             // bytes 41 to 48, signed, read here as unsigned
} BidAndOfferIndexMessage;

// Branch
casetype _IndicesMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x49: IndexMessage index_message;
    case 0x51: BidAndOfferIndexMessage bid_and_offer_index_message;
    default: UINT8 unknown[available];
  }
} IndicesMessagePayload;

// Index Messages Header
typedef struct _IndicesMessage (UINT32 available) where (available >= 1) {
  UINT8 indices_message_type;                                                                                                             // byte 0
  IndicesMessagePayload(indices_message_type, (available - 1)) indices_message_payload[:byte-size-single-element-array (available - 1)];
} IndicesMessage;

// The Market-Wide Circuit Breaker Decline Level Status message is used to report the calculated Level 1, Level 2 and Level 3 threshold values for the current trading day necessary to trigger a circuit breaker
typedef struct _MarketWideCircuitBreakerDeclineLevelStatusMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
  UINT64BE mwcb_level_1;                  // bytes 22 to 29, signed, read here as unsigned
  UINT64BE mwcb_level_2;                  // bytes 30 to 37, signed, read here as unsigned
  UINT64BE mwcb_level_3;                  // bytes 38 to 45, signed, read here as unsigned
  UINT8 reserved;                         // byte 46
} MarketWideCircuitBreakerDeclineLevelStatusMessage;

// The Market-Wide Circuit Breaker Status message is used to report the Market-Wide Circuit Breaker threshold Level that has been breached.
typedef struct _MarketWideCircuitBreakerStatusMessage {
  UINT8 participant_id;                               // byte 0
  Timestamp1 timestamp_1;                             // bytes 1 to 8
  UINT8 message_id;                                   // byte 9
  UINT32BE transaction_id;                            // bytes 10 to 13
  UINT64BE participant_reference_number;              // bytes 14 to 21, signed, read here as unsigned
  UINT8 market_wide_circuit_breaker_level_indicator;  // byte 22
  UINT8 reserved;                                     // byte 23
} MarketWideCircuitBreakerStatusMessage;

// Active Participants
typedef struct _Participants {
  UINT8 participant_id;         // byte 0
  UINT64BE trade_total_volume;  // bytes 1 to 8
} Participants;

// Approximate Adjusted Volume Market Center message is used to report the volume of adjusted trading activity for each Participant.
typedef struct _ApproximateAdjustedVolumeMarketCenterMessage {
  UINT8 participant_id;                                                           // byte 0
  Timestamp1 timestamp_1;                                                         // bytes 1 to 8
  UINT8 message_id;                                                               // byte 9
  UINT32BE transaction_id;                                                        // bytes 10 to 13
  UINT64BE participant_reference_number;                                          // bytes 14 to 21, signed, read here as unsigned
  UINT8 number_of_participants;                                                   // byte 22
  Participants participants[:byte-size (((UINT32) number_of_participants) * 9)];
} ApproximateAdjustedVolumeMarketCenterMessage;

// The Approximate Trades and Total Dollar Value message allows a Participant to report the total trades and total dollar value of trades at their respective market centers.
typedef struct _ApproximateTradesAndTotalDollarValueMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
  UINT32BE total_trades;                  // bytes 22 to 25
  UINT64BE dollar_value;                  // bytes 26 to 33
} ApproximateTradesAndTotalDollarValueMessage;

// The Crossing Session message is used to report the total volume and dollar value of trades transacted after the close of a Participant s regular session.
typedef struct _CrossingSessionSummaryMessage {
  UINT8 participant_id;                              // byte 0
  Timestamp1 timestamp_1;                            // bytes 1 to 8
  UINT8 message_id;                                  // byte 9
  UINT32BE transaction_id;                           // bytes 10 to 13
  UINT64BE participant_reference_number;             // bytes 14 to 21, signed, read here as unsigned
  UINT64BE crossing_session_i_total_trades_volume;   // bytes 22 to 29
  UINT64BE crossing_session_ii_dollar_value;         // bytes 30 to 37
  UINT64BE crossing_session_ii_total_trades_volume;  // bytes 38 to 45
} CrossingSessionSummaryMessage;

// Branch
casetype _MarketStatusMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x4B: MarketWideCircuitBreakerDeclineLevelStatusMessage market_wide_circuit_breaker_decline_level_status_message;
    case 0x4C: MarketWideCircuitBreakerStatusMessage market_wide_circuit_breaker_status_message;
    case 0x4E: ApproximateAdjustedVolumeMarketCenterMessage approximate_adjusted_volume_market_center_message;
    case 0x4F: ApproximateTradesAndTotalDollarValueMessage approximate_trades_and_total_dollar_value_message;
    case 0x50: CrossingSessionSummaryMessage crossing_session_summary_message;
    default: UINT8 unknown[available];
  }
} MarketStatusMessagePayload;

// Market Status Message Header
typedef struct _MarketStatusMessage (UINT32 available) where (available >= 1) {
  UINT8 market_status_message_type;                                                                                                                        // byte 0
  MarketStatusMessagePayload(market_status_message_type, (available - 1)) market_status_message_payload[:byte-size-single-element-array (available - 1)];
} MarketStatusMessage;

// Sale Conditions
typedef struct _SaleConditions {
  UINT8 settlement_type;                  // byte 0
  UINT8 trade_through_exempt_reason;      // byte 1
  UINT8 extended_hours_or_sequence_type;  // byte 2
  UINT8 sro_trade_detail;                 // byte 3
} SaleConditions;

// Prior Day Trade Date and Time
typedef struct _PriorDayTradeDateAndTime {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} PriorDayTradeDateAndTime;

// Corrected Trade
typedef struct _CorrectedTrade {
  SaleConditions sale_conditions;                          // bytes 0 to 3
  UINT64BE trade_price;                                    // bytes 4 to 11
  UINT32BE trade_volume;                                   // bytes 12 to 15
  UINT8 sellers_sale_days;                                 // byte 16
  UINT8 stop_stock_indicator;                              // byte 17
  UINT8 trade_through_exempt_indicator;                    // byte 18
  UINT8 short_sale_restriction_indicator;                  // byte 19
  PriorDayTradeDateAndTime prior_day_trade_date_and_time;  // bytes 20 to 27
} CorrectedTrade;

// Original Trade
typedef struct _OriginalTrade {
  SaleConditions sale_conditions;                          // bytes 0 to 3
  UINT64BE trade_price;                                    // bytes 4 to 11
  UINT32BE trade_volume;                                   // bytes 12 to 15
  UINT8 sellers_sale_days;                                 // byte 16
  UINT8 stop_stock_indicator;                              // byte 17
  UINT8 trade_through_exempt_indicator;                    // byte 18
  UINT8 short_sale_restriction_indicator;                  // byte 19
  PriorDayTradeDateAndTime prior_day_trade_date_and_time;  // bytes 20 to 27
} OriginalTrade;

// Prior Day messages are used to report CTA eligible Equity, Local Issue or Bond trades, corrections, cancels or errors for transactions that occurred earlier than the current trading day and had not been reported
typedef struct _PriorDayTradeCorrectionMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];              // bytes 22 to 32
  UINT8 instrument_type;                  // byte 33
  CorrectedTrade corrected_trade;         // bytes 34 to 61
  UINT8 trade_reporting_facility_id;      // byte 62
  OriginalTrade original_trade;           // bytes 63 to 90
} PriorDayTradeCorrectionMessage;

// The Prior Day Trade message is used to report a Cta Equity, Local Issue or Bond transaction which occurred earlier than the current trading day and was not reported.
typedef struct _PriorDayTradeMessage {
  UINT8 participant_id;                                    // byte 0
  Timestamp1 timestamp_1;                                  // bytes 1 to 8
  UINT8 message_id;                                        // byte 9
  UINT32BE transaction_id;                                 // bytes 10 to 13
  UINT64BE participant_reference_number;                   // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                               // bytes 22 to 32
  UINT8 instrument_type;                                   // byte 33
  SaleConditions sale_conditions;                          // bytes 34 to 37
  UINT64BE trade_price;                                    // bytes 38 to 45
  UINT32BE trade_volume;                                   // bytes 46 to 49
  UINT8 sellers_sale_days;                                 // byte 50
  UINT8 stop_stock_indicator;                              // byte 51
  UINT8 trade_through_exempt_indicator;                    // byte 52
  UINT8 short_sale_restriction_indicator;                  // byte 53
  UINT8 trade_reporting_facility_id;                       // byte 54
  PriorDayTradeDateAndTime prior_day_trade_date_and_time;  // bytes 55 to 62
} PriorDayTradeMessage;

// The Prior Day Trade message is used to report a Cta Equity, Local Issue or Bond transaction which occurred earlier than the current trading day and was not reported.
typedef struct _PriorDayTradeCancelErrorMessage {
  UINT8 participant_id;                                    // byte 0
  Timestamp1 timestamp_1;                                  // bytes 1 to 8
  UINT8 message_id;                                        // byte 9
  UINT32BE transaction_id;                                 // bytes 10 to 13
  UINT64BE participant_reference_number;                   // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                               // bytes 22 to 32
  UINT8 instrument_type;                                   // byte 33
  SaleConditions sale_conditions;                          // bytes 34 to 37
  UINT64BE trade_price;                                    // bytes 38 to 45
  UINT32BE trade_volume;                                   // bytes 46 to 49
  UINT8 sellers_sale_days;                                 // byte 50
  UINT8 stop_stock_indicator;                              // byte 51
  UINT8 trade_through_exempt_indicator;                    // byte 52
  UINT8 short_sale_restriction_indicator;                  // byte 53
  UINT8 trade_reporting_facility_id;                       // byte 54
  PriorDayTradeDateAndTime prior_day_trade_date_and_time;  // bytes 55 to 62
  UINT8 cancel_error_action;                               // byte 63
} PriorDayTradeCancelErrorMessage;

// Branch
casetype _PriorDayMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x43: PriorDayTradeCorrectionMessage prior_day_trade_correction_message;
    case 0x54: PriorDayTradeMessage prior_day_trade_message;
    case 0x58: PriorDayTradeCancelErrorMessage prior_day_trade_cancel_error_message;
    default: UINT8 unknown[available];
  }
} PriorDayMessagePayload;

// Prior Day Messages
typedef struct _PriorDayMessage (UINT32 available) where (available >= 1) {
  UINT8 prior_day_message_type;                                                                                                                // byte 0
  PriorDayMessagePayload(prior_day_message_type, (available - 1)) prior_day_message_payload[:byte-size-single-element-array (available - 1)];
} PriorDayMessage;

// The Consolidated Start of Day Summary messages are transmitted shortly after the Multicast Line Start of Day message
typedef struct _ConsolidatedStartOfDaySummaryMessage {
  UINT8 participant_id;                         // byte 0
  Timestamp1 timestamp_1;                       // bytes 1 to 8
  UINT8 message_id;                             // byte 9
  UINT32BE transaction_id;                      // bytes 10 to 13
  UINT64BE participant_reference_number;        // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                    // bytes 22 to 32
  UINT8 instrument_type;                        // byte 33
  UINT8 summary_participant_id;                 // byte 34
  UINT32BE previous_close_price_date;           // bytes 35 to 38
  UINT64BE previous_close_price;                // bytes 39 to 46
  UINT8 short_sale_restriction_indicator;       // byte 47
  UINT8 primary_listing_market_participant_id;  // byte 48
  UINT8 financial_status_indicator;             // byte 49
  UINT8 number_of_participants;                 // byte 50
} ConsolidatedStartOfDaySummaryMessage;

// The Participant Start of Day Summary messages are transmitted shortly after the Multicast Line Start of Day message
typedef struct _ParticipantStartOfDaySummaryMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];              // bytes 22 to 32
  UINT8 instrument_type;                  // byte 33
  UINT8 summary_participant_id;           // byte 34
  UINT32BE previous_close_price_date;     // bytes 35 to 38
  UINT64BE previous_close_price;          // bytes 39 to 46
} ParticipantStartOfDaySummaryMessage;

// The Consolidated End of Day Summary messages are transmitted shortly before the Goodnight messages
typedef struct _ConsolidatedEndOfDaySummaryMessage {
  UINT8 participant_id;                         // byte 0
  Timestamp1 timestamp_1;                       // bytes 1 to 8
  UINT8 message_id;                             // byte 9
  UINT32BE transaction_id;                      // bytes 10 to 13
  UINT64BE participant_reference_number;        // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                    // bytes 22 to 32
  UINT8 instrument_type;                        // byte 33
  UINT8 last_participant_id;                    // byte 34
  UINT32BE previous_close_price_date;           // bytes 35 to 38
  UINT64BE last_price;                          // bytes 39 to 46
  UINT64BE high_price;                          // bytes 47 to 54
  UINT64BE low_price;                           // bytes 55 to 62
  UINT64BE total_volume;                        // bytes 63 to 70
  UINT8 short_sale_restriction_indicator;       // byte 71
  UINT8 primary_listing_market_participant_id;  // byte 72
  UINT8 financial_status_indicator;             // byte 73
  UINT8 number_of_participants;                 // byte 74
} ConsolidatedEndOfDaySummaryMessage;

// The Participant End of Day Summary messages are transmitted shortly before the Goodnight messages.
typedef struct _ParticipantEndOfDaySummaryMessage {
  UINT8 participant_id;                   // byte 0
  Timestamp1 timestamp_1;                 // bytes 1 to 8
  UINT8 message_id;                       // byte 9
  UINT32BE transaction_id;                // bytes 10 to 13
  UINT64BE participant_reference_number;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];              // bytes 22 to 32
  UINT8 instrument_type;                  // byte 33
  UINT8 initiating_participant_id;        // byte 34
  UINT32BE previous_close_price_date;     // bytes 35 to 38
  UINT64BE last_price;                    // bytes 39 to 46
  UINT64BE high_price;                    // bytes 47 to 54
  UINT64BE low_price;                     // bytes 55 to 62
  UINT64BE open_price;                    // bytes 63 to 70
  UINT64BE total_volume;                  // bytes 71 to 78
  UINT8 tick;                             // byte 79
} ParticipantEndOfDaySummaryMessage;

// Branch
casetype _SummaryMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: ConsolidatedStartOfDaySummaryMessage consolidated_start_of_day_summary_message;
    case 0x42: ParticipantStartOfDaySummaryMessage participant_start_of_day_summary_message;
    case 0x43: ConsolidatedEndOfDaySummaryMessage consolidated_end_of_day_summary_message;
    case 0x44: ParticipantEndOfDaySummaryMessage participant_end_of_day_summary_message;
    default: UINT8 unknown[available];
  }
} SummaryMessagePayload;

// Summary Messages
typedef struct _SummaryMessage (UINT32 available) where (available >= 1) {
  UINT8 summary_message_type;                                                                                                             // byte 0
  SummaryMessagePayload(summary_message_type, (available - 1)) summary_message_payload[:byte-size-single-element-array (available - 1)];
} SummaryMessage;

// The Auction Status message is used when a Participant in a Cta eligible security, Local Issue or a Bond requires Auction Information
typedef struct _AuctionStatusMessage {
  UINT8 participant_id;                           // byte 0
  Timestamp1 timestamp_1;                         // bytes 1 to 8
  UINT8 message_id;                               // byte 9
  UINT32BE transaction_id;                        // bytes 10 to 13
  UINT64BE participant_reference_number;          // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                      // bytes 22 to 32
  UINT8 instrument_type;                          // byte 33
  UINT64BE auction_collar_reference_price;        // bytes 34 to 41
  UINT64BE auction_collar_upper_threshold_price;  // bytes 42 to 49
  UINT64BE auction_collar_lower_threshold_price;  // bytes 50 to 57
  UINT8 number_of_extensions;                     // byte 58
  UINT8 short_sale_restriction_indicator;         // byte 59
  UINT8 primary_listing_market_participant_id;    // byte 60
  UINT8 financial_status_indicator;               // byte 61
  UINT8 future_use[62];                           // bytes 62 to 123
} AuctionStatusMessage;

// Timestamp 2
typedef struct _Timestamp2 {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} Timestamp2;

// Consolidated Data
typedef struct _ConsolidatedData {
  UINT32BE previous_close_price_date;  // bytes 0 to 3
  UINT8 last_participant_id;           // byte 4
  UINT64BE last_price;                 // bytes 5 to 12
  UINT64BE high_price;                 // bytes 13 to 20
  UINT64BE low_price;                  // bytes 21 to 28
  UINT32BE total_volume_short;         // bytes 29 to 32
  UINT8 tick;                          // byte 33
} ConsolidatedData;

// Participant Data
typedef struct _ParticipantData {
  UINT32BE previous_close_price_date;  // bytes 0 to 3
  UINT64BE last_price;                 // bytes 4 to 11
  UINT64BE high_price;                 // bytes 12 to 19
  UINT64BE low_price;                  // bytes 20 to 27
  UINT64BE open_price;                 // bytes 28 to 35
  UINT32BE total_volume_short;         // bytes 36 to 39
  UINT8 tick;                          // byte 40
} ParticipantData;

// The Trade Correction message is used to correct Cta eligible Equity, Local Issue or Bond information.
typedef struct _TradeCorrectionMessage {
  UINT8 participant_id;                            // byte 0
  Timestamp1 timestamp_1;                          // bytes 1 to 8
  UINT8 message_id;                                // byte 9
  UINT32BE transaction_id;                         // bytes 10 to 13
  UINT64BE participant_reference_number;           // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                       // bytes 22 to 32
  UINT8 instrument_type;                           // byte 33
  CorrectedTrade corrected_trade;                  // bytes 34 to 61
  UINT8 trade_reporting_facility_id;               // byte 62
  Timestamp2 timestamp_2;                          // bytes 63 to 70
  UINT64BE original_participant_reference_number;  // bytes 71 to 78, signed, read here as unsigned
  OriginalTrade original_trade;                    // bytes 79 to 106
  UINT8 primary_listing_market_participant_id;     // byte 107
  UINT8 financial_status_indicator;                // byte 108
  ConsolidatedData consolidated_data;              // bytes 109 to 142
  ParticipantData participant_data;                // bytes 143 to 183
} TradeCorrectionMessage;

// The Long Trade message is used to report trade information for Cta eligible Equity, Local Issue or Bonds.
typedef struct _LongTradeMessage {
  UINT8 participant_id;                            // byte 0
  Timestamp1 timestamp_1;                          // bytes 1 to 8
  UINT8 message_id;                                // byte 9
  UINT32BE transaction_id;                         // bytes 10 to 13
  UINT64BE participant_reference_number;           // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                       // bytes 22 to 32
  UINT8 instrument_type;                           // byte 33
  SaleConditions sale_conditions;                  // bytes 34 to 37
  UINT64BE trade_price;                            // bytes 38 to 45
  UINT32BE trade_volume;                           // bytes 46 to 49
  UINT8 sellers_sale_days;                         // byte 50
  UINT8 stop_stock_indicator;                      // byte 51
  UINT8 trade_through_exempt_indicator;            // byte 52
  UINT8 trade_reporting_facility_id;               // byte 53
  Timestamp2 timestamp_2;                          // bytes 54 to 61
  UINT8 short_sale_restriction_indicator;          // byte 62
  UINT8 primary_listing_market_participant_id;     // byte 63
  UINT8 financial_status_indicator;                // byte 64
  UINT8 held_trade_indicator;                      // byte 65
  UINT8 consolidated_high_low_last_indicator;      // byte 66
  UINT8 participant_open_high_low_last_indicator;  // byte 67
} LongTradeMessage;

// The Trading Status message is transmitted when a Participant in a Cta eligible security, Local Issue or a Bond elects to notify CTS of an Opening Delay, a Trading Halt, a Trading Resume, a Price Indication or a Market Imbalance.
typedef struct _TradingStatusMessage {
  UINT8 participant_id;                                   // byte 0
  Timestamp1 timestamp_1;                                 // bytes 1 to 8
  UINT8 message_id;                                       // byte 9
  UINT32BE transaction_id;                                // bytes 10 to 13
  UINT64BE participant_reference_number;                  // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                              // bytes 22 to 32
  UINT8 instrument_type;                                  // byte 33
  UINT64BE last_price;                                    // bytes 34 to 41
  UINT64BE high_indication_price_upper_limit_price_band;  // bytes 42 to 49
  UINT64BE low_indication_price_lower_limit_price_band;   // bytes 50 to 57
  UINT32BE buy_volume;                                    // bytes 58 to 61
  UINT32BE sell_volume;                                   // bytes 62 to 65
  UINT8 security_status;                                  // byte 66
  UINT8 halt_reason;                                      // byte 67
  UINT8 short_sale_restriction_indicator;                 // byte 68
  UINT8 primary_listing_market_participant_id;            // byte 69
  UINT8 financial_status_indicator;                       // byte 70
  UINT8 limit_up_limit_down_indicator;                    // byte 71
} TradingStatusMessage;

// The Short Trade message is used to report trade information for Cta eligible Equity only (not used for Local Issues or Bonds) if the trade meets message format requirements otherwise Long Trade message is used.
typedef struct _ShortTradeMessage {
  UINT8 participant_id;                            // byte 0
  Timestamp1 timestamp_1;                          // bytes 1 to 8
  UINT8 message_id;                                // byte 9
  UINT32BE transaction_id;                         // bytes 10 to 13
  UINT64BE participant_reference_number;           // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol_short[5];                  // bytes 22 to 26
  UINT8 sale_condition;                            // byte 27
  UINT8 sale_condition_category;                   // byte 28
  UINT16BE trade_price_short;                      // bytes 29 to 30
  UINT16BE trade_volume_short;                     // bytes 31 to 32
  UINT8 primary_listing_market_participant_id;     // byte 33
  UINT8 consolidated_high_low_last_indicator;      // byte 34
  UINT8 participant_open_high_low_last_indicator;  // byte 35
} ShortTradeMessage;

// The Trade Cancel/Error message is used cancel or error Cta eligible securities, Local Issues or Bond information.
typedef struct _TradeCancelErrorMessage {
  UINT8 participant_id;                            // byte 0
  Timestamp1 timestamp_1;                          // bytes 1 to 8
  UINT8 message_id;                                // byte 9
  UINT32BE transaction_id;                         // bytes 10 to 13
  UINT64BE participant_reference_number;           // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                       // bytes 22 to 32
  UINT8 instrument_type;                           // byte 33
  SaleConditions sale_conditions;                  // bytes 34 to 37
  UINT64BE trade_price;                            // bytes 38 to 45
  UINT32BE trade_volume;                           // bytes 46 to 49
  UINT8 sellers_sale_days;                         // byte 50
  UINT8 stop_stock_indicator;                      // byte 51
  UINT8 trade_through_exempt_indicator;            // byte 52
  UINT8 trade_reporting_facility_id;               // byte 53
  UINT64BE original_participant_reference_number;  // bytes 54 to 61, signed, read here as unsigned
  Timestamp2 timestamp_2;                          // bytes 62 to 69
  UINT8 cancel_error_action;                       // byte 70
  UINT8 short_sale_restriction_indicator;          // byte 71
  UINT8 primary_listing_market_participant_id;     // byte 72
  UINT8 financial_status_indicator;                // byte 73
  ConsolidatedData consolidated_data;              // bytes 74 to 107
  ParticipantData participant_data;                // bytes 108 to 148
} TradeCancelErrorMessage;

// Branch
casetype _TradeMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: AuctionStatusMessage auction_status_message;
    case 0x43: TradeCorrectionMessage trade_correction_message;
    case 0x4C: LongTradeMessage long_trade_message;
    case 0x53: TradingStatusMessage trading_status_message;
    case 0x54: ShortTradeMessage short_trade_message;
    case 0x58: TradeCancelErrorMessage trade_cancel_error_message;
    default: UINT8 unknown[available];
  }
} TradeMessagePayload;

// Trade Messages
typedef struct _TradeMessage (UINT32 available) where (available >= 1) {
  UINT8 trade_message_type;                                                                                                         // byte 0
  TradeMessagePayload(trade_message_type, (available - 1)) trade_message_payload[:byte-size-single-element-array (available - 1)];
} TradeMessage;

// Branch
casetype _CategoryPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: AdministrativeMessage(available) administrative_message;
    case 0x43: ControlMessage(available) control_message;
    case 0x49: IndicesMessage(available) indices_message;
    case 0x4D: MarketStatusMessage(available) market_status_message;
    case 0x50: PriorDayMessage(available) prior_day_message;
    case 0x53: SummaryMessage(available) summary_message;
    case 0x54: TradeMessage(available) trade_message;
    default: UINT8 unknown[available];
  }
} CategoryPayload;

// Repeating message block
typedef struct _Message {
  UINT16BE message_length { message_length >= 3 };                                                                                                       // bytes 0 to 1
  UINT8 message_category;                                                                                                                                // byte 2
  CategoryPayload(message_category, (((UINT32) message_length) - 3)) category_payload[:byte-size-single-element-array (((UINT32) message_length) - 3)];
} Message;

// Repeating message block
casetype _MessagePart1 (Bool present) {
  switch (present) {
    case true: Message block;
    case false: unit none;
  }
} MessagePart1;

// Repeating message block
typedef struct _MessageBlock2 {
  Message first;
  Message second;
} MessageBlock2;

// Repeating message block
casetype _MessagePart2 (Bool present) {
  switch (present) {
    case true: MessageBlock2 block;
    case false: unit none;
  }
} MessagePart2;

// Repeating message block
typedef struct _MessageBlock4 {
  MessageBlock2 first;
  MessageBlock2 second;
} MessageBlock4;

// Repeating message block
casetype _MessagePart4 (Bool present) {
  switch (present) {
    case true: MessageBlock4 block;
    case false: unit none;
  }
} MessagePart4;

// Repeating message block
typedef struct _MessageBlock8 {
  MessageBlock4 first;
  MessageBlock4 second;
} MessageBlock8;

// Repeating message block
casetype _MessagePart8 (Bool present) {
  switch (present) {
    case true: MessageBlock8 block;
    case false: unit none;
  }
} MessagePart8;

// Repeating message block
typedef struct _MessageBlock16 {
  MessageBlock8 first;
  MessageBlock8 second;
} MessageBlock16;

// Repeating message block
casetype _MessagePart16 (Bool present) {
  switch (present) {
    case true: MessageBlock16 block;
    case false: unit none;
  }
} MessagePart16;

// Repeating message block
typedef struct _MessageBlock32 {
  MessageBlock16 first;
  MessageBlock16 second;
} MessageBlock32;

// Repeating message block
casetype _MessagePart32 (Bool present) {
  switch (present) {
    case true: MessageBlock32 block;
    case false: unit none;
  }
} MessagePart32;

// Repeating message block
typedef struct _MessageBlock64 {
  MessageBlock32 first;
  MessageBlock32 second;
} MessageBlock64;

// Repeating message block
casetype _MessagePart64 (Bool present) {
  switch (present) {
    case true: MessageBlock64 block;
    case false: unit none;
  }
} MessagePart64;

// Repeating message block
typedef struct _MessageBlock128 {
  MessageBlock64 first;
  MessageBlock64 second;
} MessageBlock128;

// Repeating message block
casetype _MessagePart128 (Bool present) {
  switch (present) {
    case true: MessageBlock128 block;
    case false: unit none;
  }
} MessagePart128;

// Repeating message block
typedef struct _MessageCounted (UINT32 count) {
  MessagePart128(((count & 128) != 0)) part128;
  MessagePart64(((count & 64) != 0)) part64;
  MessagePart32(((count & 32) != 0)) part32;
  MessagePart16(((count & 16) != 0)) part16;
  MessagePart8(((count & 8) != 0)) part8;
  MessagePart4(((count & 4) != 0)) part4;
  MessagePart2(((count & 2) != 0)) part2;
  MessagePart1(((count & 1) != 0)) part1;
} MessageCounted;

// ---- Packet: Packet ----------------------------------------------------------

// Cta Udp Packet
entrypoint typedef struct _Packet {
  UINT8 version;                                         // byte 0
  UINT16BE block_size;                                   // bytes 1 to 2
  UINT8 data_feed_indicator;                             // byte 3
  UINT8 retransmission_indicator;                        // byte 4
  UINT32BE block_sequence_number;                        // bytes 5 to 8
  UINT8 messages_in_block;                               // byte 9
  SipBlockTimestamp sip_block_timestamp;                 // bytes 10 to 17
  UINT16BE block_checksum;                               // bytes 18 to 19
  MessageCounted(((UINT32) messages_in_block)) message;
  UINT8 block_pad_byte[:consume-all];
} Packet;

