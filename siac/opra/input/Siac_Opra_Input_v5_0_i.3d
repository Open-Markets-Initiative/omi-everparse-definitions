// ---- Block Timestamp: 8 bytes ------------------------------------------------

// Opra block timestamp
entrypoint typedef struct _BlockTimestamp {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} BlockTimestamp;

// ---- Block Header: 21 bytes --------------------------------------------------

// Opra Tcp block header
entrypoint typedef struct _BlockHeader {
  UINT8 version;                   // byte 0
  UINT16BE block_size;             // bytes 1 to 2
  UINT8 reserved;                  // byte 3
  UINT8 second_reserved;           // byte 4
  UINT8 third_reserved;            // byte 5
  UINT32BE block_sequence_number;  // bytes 6 to 9
  UINT8 messages_in_block;         // byte 10
  BlockTimestamp block_timestamp;  // bytes 11 to 18
  UINT16BE block_checksum;         // bytes 19 to 20
} BlockHeader;

// ---- Message Header: 2 bytes -------------------------------------------------

// Opra Message Header first level dispatch
entrypoint typedef struct _MessageHeader {
  UINT8 participant_id;    // byte 0
  UINT8 message_category;  // byte 1
} MessageHeader;

// ---- Expiration Block: 3 bytes -----------------------------------------------

// Expiration Block
entrypoint typedef struct _ExpirationBlock {
  UINT8 expiration_month;  // byte 0
  UINT8 expiration_day;    // byte 1
  UINT8 expiration_year;   // byte 2
} ExpirationBlock;

// ---- Equity And Index Last Sale Message: 36 bytes ----------------------------

// Equity and Index Last Sale message used to report equity and index options last sale information
entrypoint typedef struct _EquityAndIndexLastSaleMessage {
  UINT8 session_indicator;                // byte 0
