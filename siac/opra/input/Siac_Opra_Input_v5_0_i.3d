// ---- Types -------------------------------------------------------------------

// Opra block timestamp
typedef struct _BlockTimestamp {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} BlockTimestamp;

// Expiration Block
typedef struct _ExpirationBlock {
  UINT8 expiration_month;  // byte 0
  UINT8 expiration_day;    // byte 1
  UINT8 expiration_year;   // byte 2
} ExpirationBlock;

// Equity and Index Last Sale message used to report equity and index options last sale information
typedef struct _EquityAndIndexLastSaleMessage {
  UINT8 session_indicator;                // byte 0
  UINT32BE participant_reference_number;  // bytes 1 to 4
  UINT8 security_symbol[5];               // bytes 5 to 9
  UINT8 reserved_1;                       // byte 10
  ExpirationBlock expiration_block;       // bytes 11 to 13
  UINT8 strike_price_denominator_code;    // byte 14
  UINT32BE strike_price;                  // bytes 15 to 18, signed, read here as unsigned
  UINT32BE volume;                        // bytes 19 to 22
  UINT8 premium_price_denominator_code;   // byte 23
  UINT32BE premium_price;                 // bytes 24 to 27, signed, read here as unsigned
  UINT32BE trade_identifier;              // bytes 28 to 31
  UINT8 reserved_4[4];                    // bytes 32 to 35
} EquityAndIndexLastSaleMessage;

// Branch
casetype _EquityAndIndexLastSaleMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x41: EquityAndIndexLastSaleMessage equity_and_index_last_sale_message;
  }
} EquityAndIndexLastSaleMessagePayload;

// Equity And Index Last Sale Message Used To Report Equity And Index Options Last Sale Information
typedef struct _EquityAndIndexLastSaleCategory {
  UINT8 equity_and_index_last_sale_message_type;                                                                             // byte 0
  EquityAndIndexLastSaleMessagePayload(equity_and_index_last_sale_message_type) equity_and_index_last_sale_message_payload;
} EquityAndIndexLastSaleCategory;

// Equity and Index End of Day Summary message providing per symbol open high low last net change and underlying information
typedef struct _EquityAndIndexEndOfDaySummaryMessage {
  UINT8 session_indicator;                  // byte 0
  UINT32BE participant_reference_number;    // bytes 1 to 4
  UINT8 security_symbol[5];                 // bytes 5 to 9
  UINT8 reserved_1;                         // byte 10
  ExpirationBlock expiration_block;         // bytes 11 to 13
  UINT8 strike_price_denominator_code;      // byte 14
  UINT32BE strike_price;                    // bytes 15 to 18, signed, read here as unsigned
  UINT32BE volume;                          // bytes 19 to 22
  UINT32BE open_interest_volume;            // bytes 23 to 26
  UINT8 premium_price_denominator_code;     // byte 27
  UINT32BE open_price;                      // bytes 28 to 31, signed, read here as unsigned
  UINT32BE high_price;                      // bytes 32 to 35, signed, read here as unsigned
  UINT32BE low_price;                       // bytes 36 to 39, signed, read here as unsigned
  UINT32BE last_price;                      // bytes 40 to 43, signed, read here as unsigned
  UINT32BE net_change;                      // bytes 44 to 47, signed, read here as unsigned
  UINT8 underlying_price_denominator_code;  // byte 48
  UINT64BE underlying_price;                // bytes 49 to 56, signed, read here as unsigned
  UINT32BE bid_price;                       // bytes 57 to 60, signed, read here as unsigned
  UINT32BE offer_price;                     // bytes 61 to 64, signed, read here as unsigned
} EquityAndIndexEndOfDaySummaryMessage;

// Branch
casetype _EquityAndIndexEndOfDaySummaryMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x20: EquityAndIndexEndOfDaySummaryMessage equity_and_index_end_of_day_summary_message;
  }
} EquityAndIndexEndOfDaySummaryMessagePayload;

// Equity And Index End Of Day Summary Message Providing Per Symbol Open High Low Last Net Change And Underlying Information
typedef struct _EquityAndIndexEndOfDaySummaryCategory {
  UINT8 equity_and_index_end_of_day_summary_message_type;                                                                                             // byte 0
  EquityAndIndexEndOfDaySummaryMessagePayload(equity_and_index_end_of_day_summary_message_type) equity_and_index_end_of_day_summary_message_payload;
} EquityAndIndexEndOfDaySummaryCategory;

// Long Equity and Index Quote message containing a full quote using four byte integers for prices and sizes
typedef struct _LongEquityAndIndexQuoteMessage {
  UINT8 session_indicator;                // byte 0
  UINT32BE participant_reference_number;  // bytes 1 to 4
  UINT8 security_symbol[5];               // bytes 5 to 9
  UINT8 reserved_1;                       // byte 10
  ExpirationBlock expiration_block;       // bytes 11 to 13
  UINT8 strike_price_denominator_code;    // byte 14
  UINT32BE strike_price;                  // bytes 15 to 18, signed, read here as unsigned
  UINT8 premium_price_denominator_code;   // byte 19
  UINT32BE bid_price;                     // bytes 20 to 23, signed, read here as unsigned
  UINT32BE bid_size;                      // bytes 24 to 27
  UINT32BE offer_price;                   // bytes 28 to 31, signed, read here as unsigned
  UINT32BE offer_size;                    // bytes 32 to 35
} LongEquityAndIndexQuoteMessage;

// Branch
casetype _LongEquityAndIndexQuoteMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x20: LongEquityAndIndexQuoteMessage long_equity_and_index_quote_message;
  }
} LongEquityAndIndexQuoteMessagePayload;

// Long Equity And Index Quote Message Containing A Full Quote Using Four Byte Integers For Prices And Sizes
typedef struct _LongEquityAndIndexQuoteCategory {
  UINT8 long_equity_and_index_quote_message_type;                                                                               // byte 0
  LongEquityAndIndexQuoteMessagePayload(long_equity_and_index_quote_message_type) long_equity_and_index_quote_message_payload;
} LongEquityAndIndexQuoteCategory;

// Short Equity and Index Quote message containing a short quote using two byte unsigned integers for prices and sizes
typedef struct _ShortEquityAndIndexQuoteMessage {
  UINT8 session_indicator;                // byte 0
  UINT32BE participant_reference_number;  // bytes 1 to 4
  UINT8 security_symbol_short[4];         // bytes 5 to 8
  ExpirationBlock expiration_block;       // bytes 9 to 11
  UINT16BE strike_price_short;            // bytes 12 to 13
  UINT16BE bid_price_short;               // bytes 14 to 15
  UINT16BE bid_size_short;                // bytes 16 to 17
  UINT16BE offer_price_short;             // bytes 18 to 19
  UINT16BE offer_size_short;              // bytes 20 to 21
} ShortEquityAndIndexQuoteMessage;

// Branch
casetype _ShortEquityAndIndexQuoteMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x20: ShortEquityAndIndexQuoteMessage short_equity_and_index_quote_message;
  }
} ShortEquityAndIndexQuoteMessagePayload;

// Short Equity And Index Quote Message Containing A Short Quote Using Two Byte Unsigned Integers For Prices And Sizes
typedef struct _ShortEquityAndIndexQuoteCategory {
  UINT8 short_equity_and_index_quote_message_type;                                                                                 // byte 0
  ShortEquityAndIndexQuoteMessagePayload(short_equity_and_index_quote_message_type) short_equity_and_index_quote_message_payload;
} ShortEquityAndIndexQuoteCategory;

// Variable length printable Ascii text up to 200 characters.
casetype _OptionalMessageData (Bool present, UINT32 length) {
  switch (present) {
    case true: UINT8 message_data[length];
    case false: unit absent;
  }
} OptionalMessageData;

// Administrative unformatted message carrying free form printable Ascii text up to 200 characters
typedef struct _AdministrativeMessage {
  UINT8 session_indicator;                                                                           // byte 0
  UINT32BE participant_reference_number;                                                             // bytes 1 to 4
  UINT16BE message_data_length;                                                                      // bytes 5 to 6
  OptionalMessageData((message_data_length > 0x0000), ((UINT32) message_data_length)) message_data;
} AdministrativeMessage;

// Branch
casetype _AdministrativeMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x20: AdministrativeMessage administrative_message;
  }
} AdministrativeMessagePayload;

// Administrative Unformatted Message Carrying Free Form Printable Ascii Text Up To 200 Characters
typedef struct _AdministrativeCategory {
  UINT8 administrative_message_type;                                                         // byte 0
  AdministrativeMessagePayload(administrative_message_type) administrative_message_payload;
} AdministrativeCategory;

// Control message performs specified control functions consists of standard Message Header only
typedef struct _ControlMessage {
  UINT8 session_indicator;                // byte 0
  UINT32BE participant_reference_number;  // bytes 1 to 4
} ControlMessage;

// Branch
casetype _ControlMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x43: ControlMessage control_message;
  }
} ControlMessagePayload;

// Control Message Performs Specified Control Functions Consists Of Standard Message Header Only
typedef struct _ControlCategory {
  UINT8 control_message_type;                                           // byte 0
  ControlMessagePayload(control_message_type) control_message_payload;
} ControlCategory;

// Block Sequence Number Status Inquiry Request sent by the Participant to request the last Block Sequence Number received on that line
typedef struct _BlockSequenceNumberStatusInquiryRequestMessage {
  UINT8 session_indicator;                // byte 0
  UINT32BE participant_reference_number;  // bytes 1 to 4
  UINT8 reserved_4[4];                    // bytes 5 to 8
  UINT8 second_reserved_4[4];             // bytes 9 to 12
} BlockSequenceNumberStatusInquiryRequestMessage;

// Block Sequence Number Status Response sent to the Participant by Opra in response to a Type L message contains the last Block Sequence Number received on that input line
typedef struct _BlockSequenceNumberStatusResponseMessage {
  UINT8 session_indicator;                // byte 0
  UINT32BE participant_reference_number;  // bytes 1 to 4
  UINT32BE block_sequence_number;         // bytes 5 to 8
  UINT8 reserved_4[4];                    // bytes 9 to 12
} BlockSequenceNumberStatusResponseMessage;

// Message Count Status Inquiry Request sent by the Participant to request the message count on that line
typedef struct _MessageCountStatusInquiryRequestMessage {
  UINT8 session_indicator;                // byte 0
  UINT32BE participant_reference_number;  // bytes 1 to 4
  UINT8 reserved_8[8];                    // bytes 5 to 12
} MessageCountStatusInquiryRequestMessage;

// Message Count Status Response sent from Opra to the Participant containing the count of messages received on an individual line since startup
typedef struct _MessageCountStatusResponseMessage {
  UINT8 session_indicator;                // byte 0
  UINT32BE participant_reference_number;  // bytes 1 to 4
  UINT64BE message_count;                 // bytes 5 to 12
} MessageCountStatusResponseMessage;

// Branch
casetype _SequenceNumberStatusMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x4C: BlockSequenceNumberStatusInquiryRequestMessage block_sequence_number_status_inquiry_request_message;
    case 0x4D: BlockSequenceNumberStatusResponseMessage block_sequence_number_status_response_message;
    case 0x52: MessageCountStatusInquiryRequestMessage message_count_status_inquiry_request_message;
    case 0x53: MessageCountStatusResponseMessage message_count_status_response_message;
  }
} SequenceNumberStatusMessagePayload;

// Sequence Number Status Messages Synchronize Block Sequence Numbers And Retrieve Message Counts
typedef struct _SequenceNumberStatusCategory {
  UINT8 sequence_number_status_message_type;                                                                       // byte 0
  SequenceNumberStatusMessagePayload(sequence_number_status_message_type) sequence_number_status_message_payload;
} SequenceNumberStatusCategory;

// Underlying Value Last Sale message containing the Last Sale Index Value
typedef struct _UnderlyingValueLastSaleMessage {
  UINT8 session_indicator;                // byte 0
  UINT32BE participant_reference_number;  // bytes 1 to 4
  UINT8 security_symbol[5];               // bytes 5 to 9
  UINT8 reserved_1;                       // byte 10
  UINT8 index_value_denominator_code;     // byte 11
  UINT32BE index_value;                   // bytes 12 to 15, signed, read here as unsigned
  UINT8 reserved_4[4];                    // bytes 16 to 19
} UnderlyingValueLastSaleMessage;

// Underlying Value Bid and Offer message containing the Last Sale Bid Offer Index Value
typedef struct _UnderlyingValueBidAndOfferMessage {
  UINT8 session_indicator;                // byte 0
  UINT32BE participant_reference_number;  // bytes 1 to 4
  UINT8 security_symbol[5];               // bytes 5 to 9
  UINT8 reserved_1;                       // byte 10
  UINT8 index_value_denominator_code;     // byte 11
  UINT32BE bid_index_value;               // bytes 12 to 15, signed, read here as unsigned
  UINT32BE offer_index_value;             // bytes 16 to 19, signed, read here as unsigned
} UnderlyingValueBidAndOfferMessage;

// Branch
casetype _UnderlyingValueMessageMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x20: UnderlyingValueLastSaleMessage underlying_value_last_sale_message;
    case 0x49: UnderlyingValueBidAndOfferMessage underlying_value_bid_and_offer_message;
  }
} UnderlyingValueMessageMessagePayload;

// Underlying Value Message Containing Index Values For The Underlying Security
typedef struct _UnderlyingValueMessageCategory {
  UINT8 underlying_value_message_message_type;                                                                           // byte 0
  UnderlyingValueMessageMessagePayload(underlying_value_message_message_type) underlying_value_message_message_payload;
} UnderlyingValueMessageCategory;

// Branch
casetype _Payload (UINT8 selector) {
  switch (selector) {
    case 0x61: EquityAndIndexLastSaleCategory equity_and_index_last_sale_category;
    case 0x66: EquityAndIndexEndOfDaySummaryCategory equity_and_index_end_of_day_summary_category;
    case 0x6B: LongEquityAndIndexQuoteCategory long_equity_and_index_quote_category;
    case 0x71: ShortEquityAndIndexQuoteCategory short_equity_and_index_quote_category;
    case 0x43: AdministrativeCategory administrative_category;
    case 0x48: ControlCategory control_category;
    case 0x4E: SequenceNumberStatusCategory sequence_number_status_category;
    case 0x59: UnderlyingValueMessageCategory underlying_value_message_category;
  }
} Payload;

// Opra Obi Block Data containing messages
typedef struct _Message {
  UINT8 participant_id;               // byte 0
  UINT8 message_category;             // byte 1
  Payload(message_category) payload;
} Message;

// Opra Obi Block Data containing messages
casetype _MessagePart1 (Bool present) {
  switch (present) {
    case true: Message block;
    case false: unit none;
  }
} MessagePart1;

// Opra Obi Block Data containing messages
typedef struct _MessageBlock2 {
  Message first;
  Message second;
} MessageBlock2;

// Opra Obi Block Data containing messages
casetype _MessagePart2 (Bool present) {
  switch (present) {
    case true: MessageBlock2 block;
    case false: unit none;
  }
} MessagePart2;

// Opra Obi Block Data containing messages
typedef struct _MessageBlock4 {
  MessageBlock2 first;
  MessageBlock2 second;
} MessageBlock4;

// Opra Obi Block Data containing messages
casetype _MessagePart4 (Bool present) {
  switch (present) {
    case true: MessageBlock4 block;
    case false: unit none;
  }
} MessagePart4;

// Opra Obi Block Data containing messages
typedef struct _MessageBlock8 {
  MessageBlock4 first;
  MessageBlock4 second;
} MessageBlock8;

// Opra Obi Block Data containing messages
casetype _MessagePart8 (Bool present) {
  switch (present) {
    case true: MessageBlock8 block;
    case false: unit none;
  }
} MessagePart8;

// Opra Obi Block Data containing messages
typedef struct _MessageBlock16 {
  MessageBlock8 first;
  MessageBlock8 second;
} MessageBlock16;

// Opra Obi Block Data containing messages
casetype _MessagePart16 (Bool present) {
  switch (present) {
    case true: MessageBlock16 block;
    case false: unit none;
  }
} MessagePart16;

// Opra Obi Block Data containing messages
typedef struct _MessageBlock32 {
  MessageBlock16 first;
  MessageBlock16 second;
} MessageBlock32;

// Opra Obi Block Data containing messages
casetype _MessagePart32 (Bool present) {
  switch (present) {
    case true: MessageBlock32 block;
    case false: unit none;
  }
} MessagePart32;

// Opra Obi Block Data containing messages
typedef struct _MessageBlock64 {
  MessageBlock32 first;
  MessageBlock32 second;
} MessageBlock64;

// Opra Obi Block Data containing messages
casetype _MessagePart64 (Bool present) {
  switch (present) {
    case true: MessageBlock64 block;
    case false: unit none;
  }
} MessagePart64;

// Opra Obi Block Data containing messages
typedef struct _MessageBlock128 {
  MessageBlock64 first;
  MessageBlock64 second;
} MessageBlock128;

// Opra Obi Block Data containing messages
casetype _MessagePart128 (Bool present) {
  switch (present) {
    case true: MessageBlock128 block;
    case false: unit none;
  }
} MessagePart128;

// Opra Obi Block Data containing messages
typedef struct _MessageCounted (UINT32 count) {
  MessagePart128(((count & 128) != 0)) part128;
  MessagePart64(((count & 64) != 0)) part64;
  MessagePart32(((count & 32) != 0)) part32;
  MessagePart16(((count & 16) != 0)) part16;
  MessagePart8(((count & 8) != 0)) part8;
  MessagePart4(((count & 4) != 0)) part4;
  MessagePart2(((count & 2) != 0)) part2;
  MessagePart1(((count & 1) != 0)) part1;
} MessageCounted;

// ---- Packet: Packet ----------------------------------------------------------

// Opra Tcp Block
entrypoint typedef struct _Packet {
  UINT16BE block_separator;                              // bytes 0 to 1
  UINT8 version;                                         // byte 2
  UINT16BE block_size;                                   // bytes 3 to 4
  UINT8 reserved;                                        // byte 5
  UINT8 second_reserved;                                 // byte 6
  UINT8 third_reserved;                                  // byte 7
  UINT32BE block_sequence_number;                        // bytes 8 to 11
  UINT8 messages_in_block;                               // byte 12
  BlockTimestamp block_timestamp;                        // bytes 13 to 20
  UINT16BE block_checksum;                               // bytes 21 to 22
  MessageCounted(((UINT32) messages_in_block)) message;
  UINT8 block_pad_byte[:consume-all];
} Packet;

