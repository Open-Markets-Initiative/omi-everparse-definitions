  UINT8 strike_price_denominator_code;    // byte 18
  UINT32BE strike_price;                  // bytes 19 to 22, signed, read here as unsigned
  UINT32BE open_interest_volume;          // bytes 23 to 26
} OpenInterestMessage;

// Branch
casetype _OpenInterestMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x20: OpenInterestMessage open_interest_message;
  }
} OpenInterestMessagePayload;

// Open Interest Message
typedef struct _OpenInterestCategory {
  UINT8 open_interest_message_type;                                                      // byte 0
  OpenInterestMessagePayload(open_interest_message_type) open_interest_message_payload;
} OpenInterestCategory;

// Equity and Index End of Day Summary Message
typedef struct _EquityAndIndexEndOfDaySummaryMessage {
  UINT8 message_indicator;                  // byte 0
  UINT32BE transaction_id;                  // bytes 1 to 4
  UINT32BE participant_reference_number;    // bytes 5 to 8
  UINT8 security_symbol[5];                 // bytes 9 to 13
  UINT8 reserved_1;                         // byte 14
  ExpirationBlock expiration_block;         // bytes 15 to 17
  UINT8 strike_price_denominator_code;      // byte 18
  UINT32BE strike_price;                    // bytes 19 to 22, signed, read here as unsigned
  UINT32BE volume;                          // bytes 23 to 26
  UINT32BE open_interest_volume;            // bytes 27 to 30
  UINT8 premium_price_denominator_code;     // byte 31
  UINT32BE open_price;                      // bytes 32 to 35, signed, read here as unsigned
  UINT32BE high_price;                      // bytes 36 to 39, signed, read here as unsigned
  UINT32BE low_price;                       // bytes 40 to 43, signed, read here as unsigned
  UINT32BE last_price;                      // bytes 44 to 47, signed, read here as unsigned
  UINT32BE net_change;                      // bytes 48 to 51, signed, read here as unsigned
  UINT8 underlying_price_denominator_code;  // byte 52
  UINT64BE underlying_price;                // bytes 53 to 60, signed, read here as unsigned
  UINT32BE bid_price;                       // bytes 61 to 64, signed, read here as unsigned
  UINT32BE offer_price;                     // bytes 65 to 68, signed, read here as unsigned
} EquityAndIndexEndOfDaySummaryMessage;

// Branch
casetype _EquityAndIndexEndOfDaySummaryMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x20: EquityAndIndexEndOfDaySummaryMessage equity_and_index_end_of_day_summary_message;
  }
} EquityAndIndexEndOfDaySummaryMessagePayload;

// Equity And Index End Of Day Summary Message
typedef struct _EquityAndIndexEndOfDaySummaryCategory {
  UINT8 equity_and_index_end_of_day_summary_message_type;                                                                                             // byte 0
  EquityAndIndexEndOfDaySummaryMessagePayload(equity_and_index_end_of_day_summary_message_type) equity_and_index_end_of_day_summary_message_payload;
} EquityAndIndexEndOfDaySummaryCategory;

// Best Bid Appendage
typedef struct _BestBidAppendage {
  UINT8 best_bid_participant_id;    // byte 0
  UINT8 best_bid_denominator_code;  // byte 1
  UINT32BE best_bid_price;          // bytes 2 to 5, signed, read here as unsigned
  UINT32BE best_bid_size;           // bytes 6 to 9
} BestBidAppendage;

// Best Bid Appendage
casetype _OptionalBestBidAppendage (Bool present) {
  switch (present) {
    case true: BestBidAppendage best_bid_appendage;
    case false: unit absent;
  }
} OptionalBestBidAppendage;

// Best Offer Appendage
typedef struct _BestOfferAppendage {
  UINT8 best_offer_participant_id;    // byte 0
