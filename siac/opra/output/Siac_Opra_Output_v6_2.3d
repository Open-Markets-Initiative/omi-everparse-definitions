// ---- Types -------------------------------------------------------------------

// Opra packet timestamp
typedef struct _BlockTimestamp {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} BlockTimestamp;

// Represents the Message Data field.
casetype _OptionalMessageData (Bool present, UINT32 length) {
  switch (present) {
    case true: UINT8 message_data[length];
    case false: unit absent;
  }
} OptionalMessageData;

// Administrative Message
typedef struct _AdministrativeMessage {
  UINT8 message_indicator;                                                                           // byte 0
  UINT32BE transaction_id;                                                                           // bytes 1 to 4
  UINT32BE participant_reference_number;                                                             // bytes 5 to 8
  UINT16BE message_data_length;                                                                      // bytes 9 to 10
  OptionalMessageData((message_data_length > 0x0000), ((UINT32) message_data_length)) message_data;
} AdministrativeMessage;

// Branch
casetype _AdministrativeMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x20: AdministrativeMessage administrative_message;
  }
} AdministrativeMessagePayload;

// Administrative Message
typedef struct _AdministrativeCategory {
  UINT8 administrative_message_type;                                                         // byte 0
  AdministrativeMessagePayload(administrative_message_type) administrative_message_payload;
} AdministrativeCategory;

// Control Message
typedef struct _ControlMessage {
  UINT8 message_indicator;                // byte 0
  UINT32BE transaction_id;                // bytes 1 to 4
  UINT32BE participant_reference_number;  // bytes 5 to 8
} ControlMessage;

// Branch
casetype _ControlMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x43: ControlMessage control_message;
  }
} ControlMessagePayload;

// Control Message
typedef struct _ControlCategory {
  UINT8 control_message_type;                                           // byte 0
  ControlMessagePayload(control_message_type) control_message_payload;
} ControlCategory;

// Expiration Block
typedef struct _ExpirationBlock {
  UINT8 expiration_month;  // byte 0
  UINT8 expiration_day;    // byte 1
  UINT8 expiration_year;   // byte 2
} ExpirationBlock;

// Equity and Index Last Sale Message
typedef struct _EquityAndIndexLastSaleMessage {
  UINT8 message_indicator;                // byte 0
  UINT32BE transaction_id;                // bytes 1 to 4
  UINT32BE participant_reference_number;  // bytes 5 to 8
  UINT8 security_symbol[5];               // bytes 9 to 13
  UINT8 reserved_1;                       // byte 14
  ExpirationBlock expiration_block;       // bytes 15 to 17
  UINT8 strike_price_denominator_code;    // byte 18
  UINT32BE strike_price;                  // bytes 19 to 22, signed, read here as unsigned
  UINT32BE volume;                        // bytes 23 to 26
  UINT8 premium_price_denominator_code;   // byte 27
  UINT32BE premium_price;                 // bytes 28 to 31, signed, read here as unsigned
  UINT32BE trade_identifier;              // bytes 32 to 35
  UINT8 reserved_4[4];                    // bytes 36 to 39
} EquityAndIndexLastSaleMessage;

// Branch
casetype _EquityAndIndexLastSaleMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x41: EquityAndIndexLastSaleMessage equity_and_index_last_sale_message;
  }
} EquityAndIndexLastSaleMessagePayload;

// Equity And Index Last Sale Message
typedef struct _EquityAndIndexLastSaleCategory {
  UINT8 equity_and_index_last_sale_message_type;                                                                             // byte 0
  EquityAndIndexLastSaleMessagePayload(equity_and_index_last_sale_message_type) equity_and_index_last_sale_message_payload;
} EquityAndIndexLastSaleCategory;

