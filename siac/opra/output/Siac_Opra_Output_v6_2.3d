    case false: unit absent;
  }
} OptionalBestOfferAppendage;

// Best Bid and Offer Appendage
typedef struct _BestBidAndOfferAppendage {
  UINT8 best_bid_participant_id;      // byte 0
  UINT8 best_bid_denominator_code;    // byte 1
  UINT32BE best_bid_price;            // bytes 2 to 5, signed, read here as unsigned
  UINT32BE best_bid_size;             // bytes 6 to 9
  UINT8 best_offer_participant_id;    // byte 10
  UINT8 best_offer_denominator_code;  // byte 11
  UINT32BE best_offer_price;          // bytes 12 to 15, signed, read here as unsigned
  UINT32BE best_offer_size;           // bytes 16 to 19
} BestBidAndOfferAppendage;

// Best Bid and Offer Appendage
casetype _OptionalBestBidAndOfferAppendage (Bool present) {
