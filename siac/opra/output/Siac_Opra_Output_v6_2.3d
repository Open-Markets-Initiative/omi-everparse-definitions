    case true: BestBidAndOfferAppendage best_bid_and_offer_appendage;
    case false: unit absent;
  }
} OptionalBestBidAndOfferAppendage;

// Long Equity and Index Quote Message
typedef struct _LongEquityAndIndexQuoteMessage {
  UINT8 bbo_indicator;                                                                                                                 // byte 0
  UINT32BE transaction_id;                                                                                                             // bytes 1 to 4
  UINT32BE participant_reference_number;                                                                                               // bytes 5 to 8
  UINT8 security_symbol[5];                                                                                                            // bytes 9 to 13
  UINT8 reserved_1;                                                                                                                    // byte 14
  ExpirationBlock expiration_block;                                                                                                    // bytes 15 to 17
  UINT8 strike_price_denominator_code;                                                                                                 // byte 18
  UINT32BE strike_price;                                                                                                               // bytes 19 to 22, signed, read here as unsigned
  UINT8 premium_price_denominator_code;                                                                                                // byte 23
  UINT32BE bid_price;                                                                                                                  // bytes 24 to 27, signed, read here as unsigned
  UINT32BE bid_size;                                                                                                                   // bytes 28 to 31
  UINT32BE offer_price;                                                                                                                // bytes 32 to 35, signed, read here as unsigned
  UINT32BE offer_size;                                                                                                                 // bytes 36 to 39
  OptionalBestBidAppendage((((bbo_indicator == 0x4D) || (bbo_indicator == 0x4E)) || (bbo_indicator == 0x50))) best_bid_appendage;
  OptionalBestOfferAppendage((((bbo_indicator == 0x43) || (bbo_indicator == 0x47)) || (bbo_indicator == 0x4B))) best_offer_appendage;
  OptionalBestBidAndOfferAppendage((bbo_indicator == 0x4F)) best_bid_and_offer_appendage;
} LongEquityAndIndexQuoteMessage;

// Branch
casetype _LongEquityAndIndexQuoteMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x20: LongEquityAndIndexQuoteMessage long_equity_and_index_quote_message;
  }
} LongEquityAndIndexQuoteMessagePayload;

// Long Equity And Index Quote Message
typedef struct _LongEquityAndIndexQuoteCategory {
  UINT8 long_equity_and_index_quote_message_type;                                                                               // byte 0
  LongEquityAndIndexQuoteMessagePayload(long_equity_and_index_quote_message_type) long_equity_and_index_quote_message_payload;
} LongEquityAndIndexQuoteCategory;

// Short Equity and Index Quote Message
typedef struct _ShortEquityAndIndexQuoteMessage {
  UINT8 bbo_indicator;                                                                                                                 // byte 0
  UINT32BE transaction_id;                                                                                                             // bytes 1 to 4
  UINT32BE participant_reference_number;                                                                                               // bytes 5 to 8
  UINT8 security_symbol_short[4];                                                                                                      // bytes 9 to 12
  ExpirationBlock expiration_block;                                                                                                    // bytes 13 to 15
  UINT16BE strike_price_short;                                                                                                         // bytes 16 to 17
  UINT16BE bid_price_short;                                                                                                            // bytes 18 to 19
  UINT16BE bid_size_short;                                                                                                             // bytes 20 to 21
  UINT16BE offer_price_short;                                                                                                          // bytes 22 to 23
  UINT16BE offer_size_short;                                                                                                           // bytes 24 to 25
  OptionalBestBidAppendage((((bbo_indicator == 0x4D) || (bbo_indicator == 0x4E)) || (bbo_indicator == 0x50))) best_bid_appendage;
  OptionalBestOfferAppendage((((bbo_indicator == 0x43) || (bbo_indicator == 0x47)) || (bbo_indicator == 0x4B))) best_offer_appendage;
  OptionalBestBidAndOfferAppendage((bbo_indicator == 0x4F)) best_bid_and_offer_appendage;
} ShortEquityAndIndexQuoteMessage;

// Branch
casetype _ShortEquityAndIndexQuoteMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x20: ShortEquityAndIndexQuoteMessage short_equity_and_index_quote_message;
  }
} ShortEquityAndIndexQuoteMessagePayload;

// Short Equity And Index Quote Message
typedef struct _ShortEquityAndIndexQuoteCategory {
  UINT8 short_equity_and_index_quote_message_type;                                                                                 // byte 0
  ShortEquityAndIndexQuoteMessagePayload(short_equity_and_index_quote_message_type) short_equity_and_index_quote_message_payload;
} ShortEquityAndIndexQuoteCategory;

// Underlying Value last sale Message
typedef struct _UnderlyingValueLastSaleMessage {
  UINT8 message_indicator;                // byte 0
  UINT32BE transaction_id;                // bytes 1 to 4
  UINT32BE participant_reference_number;  // bytes 5 to 8
  UINT8 security_symbol[5];               // bytes 9 to 13
  UINT8 reserved_1;                       // byte 14
  UINT8 index_value_denominator_code;     // byte 15
  UINT32BE index_value;                   // bytes 16 to 19, signed, read here as unsigned
  UINT8 reserved_4[4];                    // bytes 20 to 23
} UnderlyingValueLastSaleMessage;

// Underlying value bid and offer message
typedef struct _UnderlyingValueBidAndOfferMessage {
  UINT8 message_indicator;                // byte 0
  UINT32BE transaction_id;                // bytes 1 to 4
  UINT32BE participant_reference_number;  // bytes 5 to 8
  UINT8 security_symbol[5];               // bytes 9 to 13
  UINT8 reserved_1;                       // byte 14
  UINT8 index_value_denominator_code;     // byte 15
  UINT32BE bid_index_value;               // bytes 16 to 19, signed, read here as unsigned
  UINT64BE offer_index_value;             // bytes 20 to 27, signed, read here as unsigned
} UnderlyingValueBidAndOfferMessage;

// Branch
casetype _UnderlyingValueMessagePayload (UINT8 selector) {
  switch (selector) {
    case 0x20: UnderlyingValueLastSaleMessage underlying_value_last_sale_message;
    case 0x49: UnderlyingValueBidAndOfferMessage underlying_value_bid_and_offer_message;
  }
} UnderlyingValueMessagePayload;

// Underlying Value Message
typedef struct _UnderlyingValueCategory {
  UINT8 underlying_value_message_type;                                                            // byte 0
  UnderlyingValueMessagePayload(underlying_value_message_type) underlying_value_message_payload;
} UnderlyingValueCategory;

// Branch
casetype _Payload (UINT8 selector) {
  switch (selector) {
    case 0x43: AdministrativeCategory administrative_category;
    case 0x48: ControlCategory control_category;
    case 0x61: EquityAndIndexLastSaleCategory equity_and_index_last_sale_category;
    case 0x64: OpenInterestCategory open_interest_category;
    case 0x66: EquityAndIndexEndOfDaySummaryCategory equity_and_index_end_of_day_summary_category;
    case 0x6B: LongEquityAndIndexQuoteCategory long_equity_and_index_quote_category;
    case 0x71: ShortEquityAndIndexQuoteCategory short_equity_and_index_quote_category;
    case 0x59: UnderlyingValueCategory underlying_value_category;
  }
} Payload;

// Opra Obi Block Data containing messages
typedef struct _Message {
  UINT8 participant_id;               // byte 0
  UINT8 message_category;             // byte 1
  Payload(message_category) payload;
} Message;

// Opra Obi Block Data containing messages
casetype _MessagePart1 (Bool present) {
  switch (present) {
    case true: Message block;
    case false: unit none;
  }
} MessagePart1;

// Opra Obi Block Data containing messages
typedef struct _MessageBlock2 {
  Message first;
  Message second;
} MessageBlock2;

