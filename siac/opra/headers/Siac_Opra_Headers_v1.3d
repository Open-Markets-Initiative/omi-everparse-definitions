// The Securities Industry Automation Corporation Headers
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out Siac_Opra_Headers_v1.3d
//
// What this definition does not state, and the model does:
// - a run counted by a field
// - a length prefix framing what follows
//
// License: MIT No Attribution

// ---- Block Timestamp: 8 bytes ------------------------------------------------

// Opra packet timestamp
entrypoint typedef struct _BlockTimestamp {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} BlockTimestamp;

// ---- Block Header: 21 bytes --------------------------------------------------

// Opra packet header
entrypoint typedef struct _BlockHeader {
  UINT8 version;                   // byte 0
  UINT16BE block_size;             // bytes 1 to 2
  UINT8 data_feed_indicator;       // byte 3
  UINT8 retransmission_indicator;  // byte 4
  UINT8 session_indicator;         // byte 5
  UINT32BE block_sequence_number;  // bytes 6 to 9
  UINT8 messages_in_block;         // byte 10
  BlockTimestamp block_timestamp;  // bytes 11 to 18
  UINT16BE block_checksum;         // bytes 19 to 20
} BlockHeader;

// ---- Control Message: 10 bytes -----------------------------------------------

// Control message
entrypoint typedef struct _ControlMessage {
  UINT8 control_message_type;             // byte 0
  UINT8 message_indicator;                // byte 1
  UINT32BE transaction_id;                // bytes 2 to 5
  UINT32BE participant_reference_number;  // bytes 6 to 9
} ControlMessage;

