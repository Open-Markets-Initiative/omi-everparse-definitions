// ---- Values ------------------------------------------------------------------

// Message Category: one byte code
#define MESSAGE_CATEGORY_ADMINISTRATIVE 0x41  // Administrative
#define MESSAGE_CATEGORY_CONTROL 0x43         // Control
#define MESSAGE_CATEGORY_QUOTE 0x51           // Quote
#define MESSAGE_CATEGORY_TRADE 0x54           // Trade

// Odd Lot Quote Appendage Type: one byte code
#define ODD_LOT_QUOTE_APPENDAGE_TYPE_ODD_LOT_QUOTE_SHORT_APPENDAGE 0x53     // Odd Lot Quote Short Appendage
#define ODD_LOT_QUOTE_APPENDAGE_TYPE_ODD_LOT_QUOTE_LONG_APPENDAGE 0x4C      // Odd Lot Quote Long Appendage
#define ODD_LOT_QUOTE_APPENDAGE_TYPE_ODD_LOT_QUOTE_EXTENDED_APPENDAGE 0x45  // Odd Lot Quote Extended Appendage

// Instrument Type: one byte code
#define INSTRUMENT_TYPE_CTA_ELIGIBLE_EQUITY 0x30  // Cta Eligible Equity
#define INSTRUMENT_TYPE_LOCAL_ISSUE 0x31          // Local Issue
#define INSTRUMENT_TYPE_CORPORATE_BOND 0x32       // Corporate Bond
#define INSTRUMENT_TYPE_GOVERNMENT_BOND 0x33      // Government Bond

// Quote Condition: one byte code
#define QUOTE_CONDITION_SLOW_QUOTE_ON_OFFER_SIDE 0x41                              // Slow Quote On Offer Side
#define QUOTE_CONDITION_SLOW_QUOTE_ON_BID_SIDE 0x42                                // Slow Quote On Bid Side
#define QUOTE_CONDITION_CLOSING 0x43                                               // Closing
#define QUOTE_CONDITION_SLOW_QUOTE_DUE_TO_LRP_OR_GAP_QUOTE_ON_THE_BID_SIDE 0x45    // Slow Quote Due To Lrp Or Gap Quote On The Bid Side
#define QUOTE_CONDITION_SLOW_QUOTE_DUE_TO_LRP_OR_GAP_QUOTE_ON_THE_OFFER_SIDE 0x46  // Slow Quote Due To Lrp Or Gap Quote On The Offer Side
#define QUOTE_CONDITION_SLOW_QUOTE_ON_THE_BID_AND_OFFER_SIDES 0x48                 // Slow Quote On The Bid And Offer Sides
#define QUOTE_CONDITION_CLOSED_MARKET_MAKER_FINRA 0x4C                             // Closed Market Maker Finra
#define QUOTE_CONDITION_NON_FIRM_QUOTE 0x4E                                        // Non Firm Quote
#define QUOTE_CONDITION_OPENING_QUOTE 0x4F                                         // Opening Quote
#define QUOTE_CONDITION_REGULAR 0x52                                               // Regular
#define QUOTE_CONDITION_SLOW_QUOTE_DUE_TO_LRP_OR_GAP_QUOTE_ON_BOTH_SIDES 0x55      // Slow Quote Due To Lrp Or Gap Quote On Both Sides
#define QUOTE_CONDITION_SLOW_QUOTE_DUE_TO_SET_SLOW_LIST_ON_BOTH_SIDES 0x57         // Slow Quote Due To Set Slow List On Both Sides
#define QUOTE_CONDITION_ON_DEMAND_INTRA_DAY_AUCTION 0x34                           // On Demand Intra Day Auction

// Retail Interest Indicator: one byte code
#define RETAIL_INTEREST_INDICATOR_RETAIL_INTEREST_NOT_APPLICABLE 0x20                    // Retail Interest Not Applicable
#define RETAIL_INTEREST_INDICATOR_RETAIL_INTEREST_ON_BID_QUOTE 0x41                      // Retail Interest On Bid Quote
#define RETAIL_INTEREST_INDICATOR_RETAIL_INTEREST_ON_OFFER_QUOTE 0x42                    // Retail Interest On Offer Quote
#define RETAIL_INTEREST_INDICATOR_RETAIL_INTEREST_ON_BOTH_THE_BID_AND_OFFER_QUOTES 0x43  // Retail Interest On Both The Bid And Offer Quotes

// Settlement Condition: one byte code
#define SETTLEMENT_CONDITION_REGULAR_WAY_SETTLEMENT 0x20    // Regular Way Settlement
#define SETTLEMENT_CONDITION_CASH_ONLY_SETTLEMENT 0x41      // Cash Only Settlement
#define SETTLEMENT_CONDITION_NEXT_DAY_ONLY_SETTLEMENT 0x42  // Next Day Only Settlement

// Market Condition: one byte code
#define MARKET_CONDITION_NORMAL_AUCTION_MARKET 0x20  // Normal Auction Market
#define MARKET_CONDITION_CROSSED_MARKET 0x41         // Crossed Market
#define MARKET_CONDITION_LOCKED_MARKET 0x42          // Locked Market

// Finra Bbo Indicator: one byte code
#define FINRA_BBO_INDICATOR_FINRA_BBO_INDICATOR_NOT_APPLICABLE 0x20  // Finra Bbo Indicator Not Applicable
#define FINRA_BBO_INDICATOR_NO_FINRA_BBO_CHANGE 0x41                 // No Finra Bbo Change
#define FINRA_BBO_INDICATOR_NO_FINRA_BBO_EXISTS 0x42                 // No Finra Bbo Exists

// Short Sale Restriction Indicator: one byte code
#define SHORT_SALE_RESTRICTION_INDICATOR_SHORT_SALE_RESTRICTION_NOT_APPLICABLE 0x20  // Short Sale Restriction Not Applicable
#define SHORT_SALE_RESTRICTION_INDICATOR_SHORT_SALE_RESTRICTION_ACTIVATED 0x41       // Short Sale Restriction Activated
#define SHORT_SALE_RESTRICTION_INDICATOR_SHORT_SALE_RESTRICTION_CONTINUED 0x43       // Short Sale Restriction Continued
#define SHORT_SALE_RESTRICTION_INDICATOR_SHORT_SALE_RESTRICTION_DEACTIVATED 0x44     // Short Sale Restriction Deactivated

// Clear Prior Odd Lot Quotes: one byte code
#define CLEAR_PRIOR_ODD_LOT_QUOTES_NOT_APPLICABLE 0x20                              // Not Applicable
#define CLEAR_PRIOR_ODD_LOT_QUOTES_CLEAR_ALL_PREVIOUS_ODD_LOT_BIDS 0x42             // Clear All Previous Odd Lot Bids
#define CLEAR_PRIOR_ODD_LOT_QUOTES_CLEAR_ALL_PREVIOUS_ODD_LOT_OFFERS 0x53           // Clear All Previous Odd Lot Offers
#define CLEAR_PRIOR_ODD_LOT_QUOTES_CLEAR_ALL_PREVIOUS_ODD_LOT_BIDS_AND_OFFERS 0x58  // Clear All Previous Odd Lot Bids And Offers

// Security Status: one byte code
#define SECURITY_STATUS_SECURITY_STATUS_NOT_APPLICABLE 0x20            // Security Status Not Applicable
#define SECURITY_STATUS_TRADING_HALT 0x32                              // Trading Halt
#define SECURITY_STATUS_RESUME 0x33                                    // Resume
#define SECURITY_STATUS_PRICE_INDICATION 0x35                          // Price Indication
#define SECURITY_STATUS_TRADING_RANGE_INDICATION 0x36                  // Trading Range Indication
#define SECURITY_STATUS_MARKET_IMBALANCE_BUY 0x37                      // Market Imbalance Buy
#define SECURITY_STATUS_MARKET_IMBALANCE_SELL 0x38                     // Market Imbalance Sell
#define SECURITY_STATUS_CLOSING_IMBALANCE_BUY 0x39                     // Closing Imbalance Buy
#define SECURITY_STATUS_CLOSING_IMBALANCE_SELL 0x41                    // Closing Imbalance Sell
#define SECURITY_STATUS_NO_MARKET_IMBALANCE 0x43                       // No Market Imbalance
#define SECURITY_STATUS_NO_CLOSING_IMBALANCE 0x44                      // No Closing Imbalance
#define SECURITY_STATUS_SHORT_SALE_RESTRICTION 0x45                    // Short Sale Restriction
#define SECURITY_STATUS_LIMIT_UP_LIMIT_DOWN_LULD_REFERENCE_PRICE 0x46  // Limit Up Limit Down Luld Reference Price

// Halt Reason: one byte code
#define HALT_REASON_HALT_REASON_NOT_APPLICABLE 0x20                    // Halt Reason Not Applicable
#define HALT_REASON_ADDITIONAL_INFORMATION_REQUESTED 0x41              // Additional Information Requested
#define HALT_REASON_REGULATORY_CONCERN 0x43                            // Regulatory Concern
#define HALT_REASON_NEWS_RELEASED 0x44                                 // News Released
#define HALT_REASON_MERGER_EFFECTIVE 0x45                              // Merger Effective
#define HALT_REASON_ETF_COMPONENT_PRICES_NOT_AVAILABLE 0x46            // Etf Component Prices Not Available
#define HALT_REASON_ORDER_IMBALANCE 0x49                               // Order Imbalance
#define HALT_REASON_LIMIT_UP_LIMIT_DOWN_LULD_TRADING_PAUSE 0x4D        // Limit Up Limit Down Luld Trading Pause
#define HALT_REASON_CORPORATE_ACTION 0x4E                              // Corporate Action
#define HALT_REASON_NEW_SECURITY_OFFERING 0x4F                         // New Security Offering
#define HALT_REASON_NEWS_PENDING 0x50                                  // News Pending
#define HALT_REASON_INTRADAY_INDICATIVE_VALUE_NOT_AVAILABLE 0x56       // Intraday Indicative Value Not Available
#define HALT_REASON_OPERATIONAL 0x58                                   // Operational
#define HALT_REASON_SUB_PENNY_TRADING 0x59                             // Sub Penny Trading
#define HALT_REASON_MARKET_WIDE_CIRCUIT_BREAKER_LEVEL_1_BREACHED 0x31  // Market Wide Circuit Breaker Level 1 Breached
#define HALT_REASON_MARKET_WIDE_CIRCUIT_BREAKER_LEVEL_2_BREACHED 0x32  // Market Wide Circuit Breaker Level 2 Breached
#define HALT_REASON_MARKET_WIDE_CIRCUIT_BREAKER_LEVEL_3_BREACHED 0x33  // Market Wide Circuit Breaker Level 3 Breached

// ---- Types -------------------------------------------------------------------

// Participant-provided timestamp
typedef struct _Timestamp1 {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} Timestamp1;

// Used for all errors to notify a Participant that CQS has found an error in the Block Header, Message Header or Message body of a Participant Input message.
typedef struct _RejectionMessage {
  UINT8 error_code;                       // byte 0
  UINT32BE block_sequence_number;         // bytes 1 to 4
  UINT64BE participant_reference_number;  // bytes 5 to 12, signed, read here as unsigned
  UINT8 message_i_d;                      // byte 13
} RejectionMessage;

// Partial Reject Odd Lot Short Quote Appendage for the bid side, applicable when Odd Lot Quote Appendage Type = S
typedef struct _PartialRejectOddLotBidShortQuoteAppendage {
  UINT16BE odd_lot_quote_price_2;  // bytes 0 to 1
  UINT8 odd_lot_quote_size;        // byte 2
} PartialRejectOddLotBidShortQuoteAppendage;

// Partial Reject Odd Lot Short Quote Appendage for the bid side, applicable when Odd Lot Quote Appendage Type = S
casetype _OptionalPartialRejectOddLotBidShortQuoteAppendage (Bool present, UINT32 length) {
  switch (present) {
    case true: PartialRejectOddLotBidShortQuoteAppendage partial_reject_odd_lot_bid_short_quote_appendage[:byte-size length];
    case false: unit absent;
  }
} OptionalPartialRejectOddLotBidShortQuoteAppendage;

// Partial Reject Odd Lot Short Quote Appendage for the offer side, applicable when Odd Lot Quote Appendage Type = S
typedef struct _PartialRejectOddLotOfferShortQuoteAppendage {
