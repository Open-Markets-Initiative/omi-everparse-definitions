  UINT8 odd_lot_quote_size;        // byte 2
} PartialRejectOddLotOfferShortQuoteAppendage;

// Partial Reject Odd Lot Short Quote Appendage for the offer side, applicable when Odd Lot Quote Appendage Type = S
casetype _OptionalPartialRejectOddLotOfferShortQuoteAppendage (Bool present, UINT32 length) {
  switch (present) {
    case true: PartialRejectOddLotOfferShortQuoteAppendage partial_reject_odd_lot_offer_short_quote_appendage[:byte-size length];
    case false: unit absent;
  }
} OptionalPartialRejectOddLotOfferShortQuoteAppendage;

