typedef struct _PartialRejectOddLotBidLongQuoteAppendage {
  UINT64BE odd_lot_quote_price;  // bytes 0 to 7
  UINT8 odd_lot_quote_size;      // byte 8
} PartialRejectOddLotBidLongQuoteAppendage;

// Partial Reject Odd Lot Long Quote Appendage for the bid side, applicable when Odd Lot Quote Appendage Type = L
casetype _OptionalPartialRejectOddLotBidLongQuoteAppendage (Bool present, UINT32 length) {
