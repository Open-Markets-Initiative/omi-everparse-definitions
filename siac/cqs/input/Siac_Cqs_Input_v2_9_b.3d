typedef struct _PartialRejectOddLotOfferLongQuoteAppendage {
  UINT64BE odd_lot_quote_price;  // bytes 0 to 7
  UINT8 odd_lot_quote_size;      // byte 8
} PartialRejectOddLotOfferLongQuoteAppendage;

// Partial Reject Odd Lot Long Quote Appendage for the offer side, applicable when Odd Lot Quote Appendage Type = L
casetype _OptionalPartialRejectOddLotOfferLongQuoteAppendage (Bool present, UINT32 length) {
  switch (present) {
    case true: PartialRejectOddLotOfferLongQuoteAppendage partial_reject_odd_lot_offer_long_quote_appendage[:byte-size length];
    case false: unit absent;
  }
} OptionalPartialRejectOddLotOfferLongQuoteAppendage;

// Partial Reject Odd Lot Extended Quote Appendage for the bid side, applicable when Odd Lot Quote Appendage Type = E
typedef struct _PartialRejectOddLotBidExtendedQuoteAppendage {
  UINT64BE odd_lot_quote_price;            // bytes 0 to 7
  UINT8 odd_lot_quote_size;                // byte 8
  UINT8 odd_lot_finra_market_maker_id[4];  // bytes 9 to 12
} PartialRejectOddLotBidExtendedQuoteAppendage;

// Partial Reject Odd Lot Extended Quote Appendage for the bid side, applicable when Odd Lot Quote Appendage Type = E
casetype _OptionalPartialRejectOddLotBidExtendedQuoteAppendage (Bool present, UINT32 length) {
  switch (present) {
    case true: PartialRejectOddLotBidExtendedQuoteAppendage partial_reject_odd_lot_bid_extended_quote_appendage[:byte-size length];
    case false: unit absent;
  }
} OptionalPartialRejectOddLotBidExtendedQuoteAppendage;

// Partial Reject Odd Lot Extended Quote Appendage for the offer side, applicable when Odd Lot Quote Appendage Type = E
typedef struct _PartialRejectOddLotOfferExtendedQuoteAppendage {
  UINT64BE odd_lot_quote_price;            // bytes 0 to 7
  UINT8 odd_lot_quote_size;                // byte 8
  UINT8 odd_lot_finra_market_maker_id[4];  // bytes 9 to 12
} PartialRejectOddLotOfferExtendedQuoteAppendage;

// Partial Reject Odd Lot Extended Quote Appendage for the offer side, applicable when Odd Lot Quote Appendage Type = E
casetype _OptionalPartialRejectOddLotOfferExtendedQuoteAppendage (Bool present, UINT32 length) {
  switch (present) {
    case true: PartialRejectOddLotOfferExtendedQuoteAppendage partial_reject_odd_lot_offer_extended_quote_appendage[:byte-size length];
    case false: unit absent;
  }
} OptionalPartialRejectOddLotOfferExtendedQuoteAppendage;

// Used for input quote messages containing multiple odd lot quotes when some quotes were successfully processed before an error caused the remaining quotes to be rejected. Identifies non-processed odd lot quotes via Odd Lot Quote Appendages.
typedef struct _PartialRejectionMessage {
  UINT8 error_code;                                                                                                                                                                                           // byte 0
  UINT32BE block_sequence_number;                                                                                                                                                                             // bytes 1 to 4
  UINT64BE participant_reference_number;                                                                                                                                                                      // bytes 5 to 12, signed, read here as unsigned
  UINT8 message_i_d;                                                                                                                                                                                          // byte 13
  UINT8 odd_lot_quote_appendage_type;                                                                                                                                                                         // byte 14
  UINT8 count_of_odd_lot_bid_appendages;                                                                                                                                                                      // byte 15
  UINT8 count_of_odd_lot_offer_appendages;                                                                                                                                                                    // byte 16
  OptionalPartialRejectOddLotBidShortQuoteAppendage((odd_lot_quote_appendage_type == 0x53), (((UINT32) count_of_odd_lot_bid_appendages) * 3)) partial_reject_odd_lot_bid_short_quote_appendage;
  OptionalPartialRejectOddLotOfferShortQuoteAppendage((odd_lot_quote_appendage_type == 0x53), (((UINT32) count_of_odd_lot_offer_appendages) * 3)) partial_reject_odd_lot_offer_short_quote_appendage;
  OptionalPartialRejectOddLotBidLongQuoteAppendage((odd_lot_quote_appendage_type == 0x4C), (((UINT32) count_of_odd_lot_bid_appendages) * 9)) partial_reject_odd_lot_bid_long_quote_appendage;
  OptionalPartialRejectOddLotOfferLongQuoteAppendage((odd_lot_quote_appendage_type == 0x4C), (((UINT32) count_of_odd_lot_offer_appendages) * 9)) partial_reject_odd_lot_offer_long_quote_appendage;
  OptionalPartialRejectOddLotBidExtendedQuoteAppendage((odd_lot_quote_appendage_type == 0x45), (((UINT32) count_of_odd_lot_bid_appendages) * 13)) partial_reject_odd_lot_bid_extended_quote_appendage;
  OptionalPartialRejectOddLotOfferExtendedQuoteAppendage((odd_lot_quote_appendage_type == 0x45), (((UINT32) count_of_odd_lot_offer_appendages) * 13)) partial_reject_odd_lot_offer_extended_quote_appendage;
} PartialRejectionMessage;

// Sent from CQS to a Participant in response to a Block Sequence Number Gap. The block will still be processed by CQS.
typedef struct _WarningMessage {
  UINT32BE previous_block_sequence_number;         // bytes 0 to 3
  UINT64BE previous_participant_reference_number;  // bytes 4 to 11, signed, read here as unsigned
} WarningMessage;

// Generated by CQS to a Participant in response to a Sequence Information and Message Count Inquiry message. Transmitted in a separate block.
typedef struct _SequenceInformationAndMessageCountResponseMessage {
  UINT32BE current_block_sequence_number;      // bytes 0 to 3
  UINT64BE last_participant_reference_number;  // bytes 4 to 11, signed, read here as unsigned
  UINT64BE message_count;                      // bytes 12 to 19
} SequenceInformationAndMessageCountResponseMessage;

// Generated by CQS to a Participant in case of a CQS failure where CQS may inadvertently lose quotes previously reported by the Participant. Provides start and end symbol ranges for affected symbols.
typedef struct _OddLotRefreshRequestMessage {
  UINT8 security_symbol_begin_range[11];  // bytes 0 to 10
  UINT8 security_symbol_end_range[11];    // bytes 11 to 21
  UINT8 reserved_8[8];                    // bytes 22 to 29
} OddLotRefreshRequestMessage;

// Generated by CQS or a Participant to exercise the line and verify transmission integrity. Transmitted as the only message in a block.
typedef struct _TestMessage {
  UINT8 data[256];  // bytes 0 to 255
} TestMessage;

// Transmitted when a Participant in a CTA eligible security requires Auction Information. Initial Auction Collar is published after the LULD Trading Pause.
typedef struct _AuctionStatusMessage {
  UINT8 security_symbol[11];                      // bytes 0 to 10
  UINT8 instrument_type;                          // byte 11
  UINT64BE auction_collar_reference_price;        // bytes 12 to 19
  UINT64BE auction_collar_upper_threshold_price;  // bytes 20 to 27
  UINT64BE auction_collar_lower_threshold_price;  // bytes 28 to 35
  UINT8 number_of_extensions;                     // byte 36
  UINT8 reserved_62[62];                          // bytes 37 to 98
} AuctionStatusMessage;

// Reports Bid and Offer quote information for a CTA eligible Equity, Local Issue or Bond meeting the Short Quote criteria. Will be discontinued in favor of Round Lot Short Quote.
typedef struct _ShortQuoteMessage {
  UINT8 security_symbol_short[5];  // bytes 0 to 4
  UINT16BE bid_price_short;        // bytes 5 to 6
  UINT16BE bid_size_short;         // bytes 7 to 8
  UINT16BE offer_price_short;      // bytes 9 to 10
  UINT16BE offer_size_short;       // bytes 11 to 12
  UINT8 reserved_2[2];             // bytes 13 to 14
} ShortQuoteMessage;

// Timestamp 2
typedef struct _Timestamp2 {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} Timestamp2;

// Reports quote information for a CTA eligible Equity, Local Issue or Bond. Used to report trading suspensions, price indications and trading range indications on the CQS input lines. Will be discontinued in favor of Round Lot Long Quote.
typedef struct _LongQuoteMessage {
  UINT8 security_symbol[11];               // bytes 0 to 10
  UINT8 instrument_type;                   // byte 11
  UINT8 quote_condition;                   // byte 12
  UINT8 security_status_indicator;         // byte 13
  UINT64BE bid_price;                      // bytes 14 to 21
  UINT32BE bid_size;                       // bytes 22 to 25
  UINT64BE offer_price;                    // bytes 26 to 33
  UINT32BE offer_size;                     // bytes 34 to 37
  UINT8 retail_interest_indicator;         // byte 38
  UINT8 settlement_condition;              // byte 39
  UINT8 market_condition;                  // byte 40
  UINT8 finra_market_maker_id[4];          // bytes 41 to 44
  UINT8 finra_bbo_indicator;               // byte 45
  Timestamp2 timestamp_2;                  // bytes 46 to 53
  UINT8 short_sale_restriction_indicator;  // byte 54
} LongQuoteMessage;

// Used only by FINRA ADF for CTA eligible Equity, Local Issue or Bond to identify the FINRA Best Bid and Best Offer at the Bid and/or Offer side. Will be discontinued in favor of Round Lot FINRA ADF Quote.
typedef struct _SpecialLongQuoteMessage {
  UINT8 security_symbol[11];                  // bytes 0 to 10
  UINT8 instrument_type;                      // byte 11
  UINT8 quote_condition;                      // byte 12
  UINT8 security_status_indicator;            // byte 13
  UINT64BE bid_price;                         // bytes 14 to 21
  UINT32BE bid_size;                          // bytes 22 to 25
  UINT64BE offer_price;                       // bytes 26 to 33
  UINT32BE offer_size;                        // bytes 34 to 37
  UINT8 retail_interest_indicator;            // byte 38
  UINT8 settlement_condition;                 // byte 39
  UINT8 market_condition;                     // byte 40
  UINT8 finra_market_maker_id[4];             // bytes 41 to 44
  UINT8 finra_best_bid_quote_condition;       // byte 45
  UINT64BE finra_best_bid_price;              // bytes 46 to 53
  UINT32BE finra_best_bid_size;               // bytes 54 to 57
  UINT8 finra_best_bid_market_maker_id[4];    // bytes 58 to 61
  UINT8 finra_best_offer_quote_condition;     // byte 62
  UINT64BE finra_best_offer_price;            // bytes 63 to 70
  UINT32BE finra_best_offer_size;             // bytes 71 to 74
  UINT8 finra_best_offer_market_maker_id[4];  // bytes 75 to 78
  Timestamp2 timestamp_2;                     // bytes 79 to 86
  UINT8 short_sale_restriction_indicator;     // byte 87
} SpecialLongQuoteMessage;

// Repeating Odd Lot Short Quote Appendage for the bid side
typedef struct _OddLotBidShortQuoteAppendage {
  UINT16BE odd_lot_quote_price_2;  // bytes 0 to 1
  UINT8 odd_lot_quote_size;        // byte 2
} OddLotBidShortQuoteAppendage;

// Repeating Odd Lot Short Quote Appendage for the offer side
typedef struct _OddLotOfferShortQuoteAppendage {
  UINT16BE odd_lot_quote_price_2;  // bytes 0 to 1
  UINT8 odd_lot_quote_size;        // byte 2
} OddLotOfferShortQuoteAppendage;

// Reports round lot quotes for a symbol when the quote meets Short Quote criteria. Odd lot bids and/or offers can be included via optional Odd Lot Short Quote Appendages.
typedef struct _RoundLotShortQuoteMessage {
  UINT8 security_symbol_short[5];                                                                                                     // bytes 0 to 4
  UINT16BE round_lot_bid_price_short;                                                                                                 // bytes 5 to 6
  UINT16BE round_lot_bid_size_short;                                                                                                  // bytes 7 to 8
  UINT16BE round_lot_offer_price_short;                                                                                               // bytes 9 to 10
  UINT16BE round_lot_offer_size_short;                                                                                                // bytes 11 to 12
  UINT8 clear_prior_odd_lot_quotes;                                                                                                   // byte 13
  UINT8 count_of_odd_lot_bid_appendages;                                                                                              // byte 14
  UINT8 count_of_odd_lot_offer_appendages;                                                                                            // byte 15
  OddLotBidShortQuoteAppendage odd_lot_bid_short_quote_appendage[:byte-size (((UINT32) count_of_odd_lot_bid_appendages) * 3)];
  OddLotOfferShortQuoteAppendage odd_lot_offer_short_quote_appendage[:byte-size (((UINT32) count_of_odd_lot_offer_appendages) * 3)];
} RoundLotShortQuoteMessage;

// Repeating Odd Lot Long Quote Appendage for the bid side
typedef struct _OddLotBidLongQuoteAppendage {
  UINT64BE odd_lot_quote_price;  // bytes 0 to 7
  UINT8 odd_lot_quote_size;      // byte 8
} OddLotBidLongQuoteAppendage;

// Repeating Odd Lot Long Quote Appendage for the offer side
typedef struct _OddLotOfferLongQuoteAppendage {
  UINT64BE odd_lot_quote_price;  // bytes 0 to 7
  UINT8 odd_lot_quote_size;      // byte 8
} OddLotOfferLongQuoteAppendage;

// Reports round lot quotes for a symbol using Long Quote format. May be used by FINRA ADF for round lot quotes when no FINRA BBO exists or no FINRA BBO change. Odd lot bids and/or offers can be included via optional Odd Lot Long Quote Appendages.
typedef struct _RoundLotLongQuoteMessage {
  UINT8 security_symbol[11];                                                                                                        // bytes 0 to 10
  UINT8 quote_condition;                                                                                                            // byte 11
  UINT64BE round_lot_bid_price;                                                                                                     // bytes 12 to 19
  UINT32BE round_lot_bid_size;                                                                                                      // bytes 20 to 23
  UINT64BE round_lot_offer_price;                                                                                                   // bytes 24 to 31
  UINT32BE round_lot_offer_size;                                                                                                    // bytes 32 to 35
  UINT8 retail_interest_indicator;                                                                                                  // byte 36
  UINT8 settlement_condition;                                                                                                       // byte 37
  UINT8 market_condition;                                                                                                           // byte 38
  UINT8 finra_market_maker_id[4];                                                                                                   // bytes 39 to 42
  UINT8 finra_bbo_indicator;                                                                                                        // byte 43
  Timestamp2 timestamp_2;                                                                                                           // bytes 44 to 51
  UINT8 clear_prior_odd_lot_quotes;                                                                                                 // byte 52
  UINT8 count_of_odd_lot_bid_appendages;                                                                                            // byte 53
  UINT8 count_of_odd_lot_offer_appendages;                                                                                          // byte 54
  OddLotBidLongQuoteAppendage odd_lot_bid_long_quote_appendage[:byte-size (((UINT32) count_of_odd_lot_bid_appendages) * 9)];
  OddLotOfferLongQuoteAppendage odd_lot_offer_long_quote_appendage[:byte-size (((UINT32) count_of_odd_lot_offer_appendages) * 9)];
} RoundLotLongQuoteMessage;

// Repeating Odd Lot Extended Quote Appendage for the bid side, including FINRA Market Maker ID
typedef struct _OddLotBidExtendedQuoteAppendage {
  UINT64BE odd_lot_quote_price;            // bytes 0 to 7
  UINT8 odd_lot_quote_size;                // byte 8
  UINT8 odd_lot_finra_market_maker_id[4];  // bytes 9 to 12
} OddLotBidExtendedQuoteAppendage;

// Repeating Odd Lot Extended Quote Appendage for the offer side, including FINRA Market Maker ID
typedef struct _OddLotOfferExtendedQuoteAppendage {
  UINT64BE odd_lot_quote_price;            // bytes 0 to 7
  UINT8 odd_lot_quote_size;                // byte 8
  UINT8 odd_lot_finra_market_maker_id[4];  // bytes 9 to 12
} OddLotOfferExtendedQuoteAppendage;

// Used only by FINRA ADF to identify the FINRA Best Bid and Best Offer for Market Makers inclusive of changes to any existing FINRA BBO. Odd lot quotes can be included via optional Odd Lot Extended Quote Appendages.
typedef struct _RoundLotFinraAdfQuoteMessage {
  UINT8 security_symbol[11];                                                                                                                 // bytes 0 to 10
  UINT8 quote_condition;                                                                                                                     // byte 11
  UINT64BE round_lot_bid_price;                                                                                                              // bytes 12 to 19
  UINT32BE round_lot_bid_size;                                                                                                               // bytes 20 to 23
  UINT64BE round_lot_offer_price;                                                                                                            // bytes 24 to 31
  UINT32BE round_lot_offer_size;                                                                                                             // bytes 32 to 35
  UINT8 retail_interest_indicator;                                                                                                           // byte 36
  UINT8 settlement_condition;                                                                                                                // byte 37
  UINT8 market_condition;                                                                                                                    // byte 38
  UINT8 finra_market_maker_id[4];                                                                                                            // bytes 39 to 42
  UINT8 finra_best_bid_quote_condition;                                                                                                      // byte 43
  UINT64BE finra_best_bid_price;                                                                                                             // bytes 44 to 51
  UINT32BE finra_best_bid_size;                                                                                                              // bytes 52 to 55
  UINT8 finra_best_bid_market_maker_id[4];                                                                                                   // bytes 56 to 59
  UINT8 finra_best_offer_quote_condition;                                                                                                    // byte 60
  UINT64BE finra_best_offer_price;                                                                                                           // bytes 61 to 68
  UINT32BE finra_best_offer_size;                                                                                                            // bytes 69 to 72
  UINT8 finra_best_offer_market_maker_id[4];                                                                                                 // bytes 73 to 76
  Timestamp2 timestamp_2;                                                                                                                    // bytes 77 to 84
  UINT8 clear_prior_odd_lot_quotes;                                                                                                          // byte 85
  UINT8 count_of_odd_lot_bid_appendages;                                                                                                     // byte 86
  UINT8 count_of_odd_lot_offer_appendages;                                                                                                   // byte 87
  OddLotBidExtendedQuoteAppendage odd_lot_bid_extended_quote_appendage[:byte-size (((UINT32) count_of_odd_lot_bid_appendages) * 13)];
  OddLotOfferExtendedQuoteAppendage odd_lot_offer_extended_quote_appendage[:byte-size (((UINT32) count_of_odd_lot_offer_appendages) * 13)];
} RoundLotFinraAdfQuoteMessage;

// Reports odd lot bids and offers via optional repeatable Odd Lot Short Quote Appendages. Used when there is no round lot update.
typedef struct _OddLotShortQuoteMessage {
  UINT8 security_symbol_short[5];                                                                                                     // bytes 0 to 4
  UINT8 clear_prior_odd_lot_quotes;                                                                                                   // byte 5
  UINT8 count_of_odd_lot_bid_appendages;                                                                                              // byte 6
  UINT8 count_of_odd_lot_offer_appendages;                                                                                            // byte 7
  OddLotBidShortQuoteAppendage odd_lot_bid_short_quote_appendage[:byte-size (((UINT32) count_of_odd_lot_bid_appendages) * 3)];
  OddLotOfferShortQuoteAppendage odd_lot_offer_short_quote_appendage[:byte-size (((UINT32) count_of_odd_lot_offer_appendages) * 3)];
} OddLotShortQuoteMessage;

// Reports odd lot bids and offers via optional repeatable Odd Lot Long Quote Appendages. Used when there is no round lot update.
typedef struct _OddLotLongQuoteMessage {
  UINT8 security_symbol[11];                                                                                                        // bytes 0 to 10
  UINT8 clear_prior_odd_lot_quotes;                                                                                                 // byte 11
  UINT8 count_of_odd_lot_bid_appendages;                                                                                            // byte 12
  UINT8 count_of_odd_lot_offer_appendages;                                                                                          // byte 13
  OddLotBidLongQuoteAppendage odd_lot_bid_long_quote_appendage[:byte-size (((UINT32) count_of_odd_lot_bid_appendages) * 9)];
  OddLotOfferLongQuoteAppendage odd_lot_offer_long_quote_appendage[:byte-size (((UINT32) count_of_odd_lot_offer_appendages) * 9)];
} OddLotLongQuoteMessage;

// Used only by FINRA ADF to report odd lot bids and offers via optional repeatable Odd Lot Extended Quote Appendages.
typedef struct _OddLotFinraAdfQuoteMessage {
  UINT8 security_symbol[11];                                                                                                                 // bytes 0 to 10
  UINT8 clear_prior_odd_lot_quotes;                                                                                                          // byte 11
  UINT8 count_of_odd_lot_bid_appendages;                                                                                                     // byte 12
  UINT8 count_of_odd_lot_offer_appendages;                                                                                                   // byte 13
  OddLotBidExtendedQuoteAppendage odd_lot_bid_extended_quote_appendage[:byte-size (((UINT32) count_of_odd_lot_bid_appendages) * 13)];
  OddLotOfferExtendedQuoteAppendage odd_lot_offer_extended_quote_appendage[:byte-size (((UINT32) count_of_odd_lot_offer_appendages) * 13)];
} OddLotFinraAdfQuoteMessage;

// Allows a Participant that is the listing exchange to notify CQS of Trading Halts, Resumes, Indications, Imbalances, Short Sale Restriction Indicators and LULD Reference Prices. Bidirectional. Supported on both CQS and CTS input lines for redundancy.
typedef struct _TradingStatusMessage {
  UINT8 security_symbol[11];                                   // bytes 0 to 10
  UINT8 instrument_type;                                       // byte 11
  UINT64BE last_price_opening_reopening_luld_reference_price;  // bytes 12 to 19
  UINT64BE high_indication_price_upper_limit_price_band;       // bytes 20 to 27
  UINT64BE low_indication_price_lower_limit_price_band;        // bytes 28 to 35
  UINT32BE buy_volume;                                         // bytes 36 to 39
  UINT32BE sell_volume;                                        // bytes 40 to 43
  UINT8 security_status;                                       // byte 44
  UINT8 halt_reason;                                           // byte 45
  UINT8 short_sale_restriction_indicator;                      // byte 46
  UINT32BE trading_status_id;                                  // bytes 47 to 50
} TradingStatusMessage;

// Branch
casetype _MessagePayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x4152: RejectionMessage rejection_message;
    case 0x4150: PartialRejectionMessage partial_rejection_message;
    case 0x4157: WarningMessage warning_message;
    case 0x4341: unit start_of_day_message;
    case 0x4343: unit finra_close_message;
    case 0x4349: unit sequence_information_and_message_count_inquiry_message;
    case 0x434E: SequenceInformationAndMessageCountResponseMessage sequence_information_and_message_count_response_message;
    case 0x434F: unit finra_open_message;
    case 0x4352: OddLotRefreshRequestMessage odd_lot_refresh_request_message;
    case 0x4354: unit line_integrity_message;
    case 0x435A: unit end_of_day_message;
    case 0x4335: TestMessage test_message;
    case 0x5141: AuctionStatusMessage auction_status_message;
    case 0x5151: ShortQuoteMessage short_quote_message;
    case 0x514C: LongQuoteMessage long_quote_message;
    case 0x5153: SpecialLongQuoteMessage special_long_quote_message;
    case 0x5150: RoundLotShortQuoteMessage round_lot_short_quote_message;
    case 0x514B: RoundLotLongQuoteMessage round_lot_long_quote_message;
    case 0x5155: RoundLotFinraAdfQuoteMessage round_lot_finra_adf_quote_message;
    case 0x5152: OddLotShortQuoteMessage odd_lot_short_quote_message;
    case 0x514D: OddLotLongQuoteMessage odd_lot_long_quote_message;
    case 0x5154: OddLotFinraAdfQuoteMessage odd_lot_finra_adf_quote_message;
    case 0x5453: TradingStatusMessage trading_status_message;
    default: UINT8 unknown[available];
  }
} MessagePayload;

// Cta participant input message
typedef struct _Message {
  UINT16BE message_length { message_length >= 26 };                                                                                                                                                    // bytes 0 to 1
  UINT8 message_category;                                                                                                                                                                              // byte 2
  UINT8 message_type;                                                                                                                                                                                  // byte 3
  UINT8 participant_i_d;                                                                                                                                                                               // byte 4
  Timestamp1 timestamp_1;                                                                                                                                                                              // bytes 5 to 12
  UINT8 message_i_d;                                                                                                                                                                                   // byte 13
  UINT8 reserved[4];                                                                                                                                                                                   // bytes 14 to 17
  UINT64BE participant_reference_number;                                                                                                                                                               // bytes 18 to 25, signed, read here as unsigned
  MessagePayload(((((UINT16) message_category) << 8) | ((UINT16) message_type)), (((UINT32) message_length) - 26)) message_payload[:byte-size-single-element-array (((UINT32) message_length) - 26)];
} Message;

// Cta participant input message
casetype _MessagePart1 (Bool present) {
  switch (present) {
    case true: Message block;
    case false: unit none;
  }
} MessagePart1;

// Cta participant input message
typedef struct _MessageBlock2 {
  Message first;
  Message second;
} MessageBlock2;

// Cta participant input message
casetype _MessagePart2 (Bool present) {
  switch (present) {
    case true: MessageBlock2 block;
    case false: unit none;
  }
} MessagePart2;

// Cta participant input message
typedef struct _MessageBlock4 {
  MessageBlock2 first;
  MessageBlock2 second;
} MessageBlock4;

// Cta participant input message
casetype _MessagePart4 (Bool present) {
  switch (present) {
    case true: MessageBlock4 block;
    case false: unit none;
  }
} MessagePart4;

// Cta participant input message
typedef struct _MessageBlock8 {
  MessageBlock4 first;
  MessageBlock4 second;
} MessageBlock8;

// Cta participant input message
casetype _MessagePart8 (Bool present) {
  switch (present) {
    case true: MessageBlock8 block;
    case false: unit none;
  }
} MessagePart8;

// Cta participant input message
typedef struct _MessageBlock16 {
  MessageBlock8 first;
  MessageBlock8 second;
} MessageBlock16;

// Cta participant input message
casetype _MessagePart16 (Bool present) {
  switch (present) {
    case true: MessageBlock16 block;
    case false: unit none;
  }
} MessagePart16;

// Cta participant input message
typedef struct _MessageBlock32 {
  MessageBlock16 first;
  MessageBlock16 second;
} MessageBlock32;

// Cta participant input message
casetype _MessagePart32 (Bool present) {
  switch (present) {
    case true: MessageBlock32 block;
    case false: unit none;
  }
} MessagePart32;

// Cta participant input message
typedef struct _MessageBlock64 {
  MessageBlock32 first;
  MessageBlock32 second;
} MessageBlock64;

// Cta participant input message
casetype _MessagePart64 (Bool present) {
  switch (present) {
    case true: MessageBlock64 block;
    case false: unit none;
  }
} MessagePart64;

// Cta participant input message
typedef struct _MessageBlock128 {
  MessageBlock64 first;
  MessageBlock64 second;
} MessageBlock128;

// Cta participant input message
casetype _MessagePart128 (Bool present) {
  switch (present) {
    case true: MessageBlock128 block;
    case false: unit none;
  }
} MessagePart128;

// Cta participant input message
typedef struct _MessageCounted (UINT32 count) {
  MessagePart128(((count & 128) != 0)) part128;
  MessagePart64(((count & 64) != 0)) part64;
  MessagePart32(((count & 32) != 0)) part32;
  MessagePart16(((count & 16) != 0)) part16;
  MessagePart8(((count & 8) != 0)) part8;
  MessagePart4(((count & 4) != 0)) part4;
  MessagePart2(((count & 2) != 0)) part2;
  MessagePart1(((count & 1) != 0)) part1;
} MessageCounted;

// ---- Packet: Packet ----------------------------------------------------------

// Cta Tcp Participant Input Block
entrypoint typedef struct _Packet {
  UINT16BE block_separator;                              // bytes 0 to 1
  UINT8 version;                                         // byte 2
  UINT16BE block_size;                                   // bytes 3 to 4
  UINT32BE block_sequence_number;                        // bytes 5 to 8
  UINT8 messages_in_block;                               // byte 9
  UINT16BE block_checksum;                               // bytes 10 to 11
  MessageCounted(((UINT32) messages_in_block)) message;
  UINT8 block_pad_byte[:consume-all];
} Packet;

