// ---- Block Header: 10 bytes --------------------------------------------------

// Cta participant input block header
entrypoint typedef struct _BlockHeader {
  UINT8 version;                   // byte 0
  UINT16BE block_size;             // bytes 1 to 2
  UINT32BE block_sequence_number;  // bytes 3 to 6
  UINT8 messages_in_block;         // byte 7
  UINT16BE block_checksum;         // bytes 8 to 9
} BlockHeader;

// ---- Timestamp 1: 8 bytes ----------------------------------------------------

// Participant-provided timestamp
entrypoint typedef struct _Timestamp1 {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} Timestamp1;

// ---- Message Header: 26 bytes ------------------------------------------------

// Cta participant input message header (26 bytes)
entrypoint typedef struct _MessageHeader {
  UINT16BE message_length;                // bytes 0 to 1
  UINT8 message_category;                 // byte 2
  UINT8 message_type;                     // byte 3
  UINT8 participant_i_d;                  // byte 4
  Timestamp1 timestamp_1;                 // bytes 5 to 12
  UINT8 message_i_d;                      // byte 13
  UINT8 reserved[4];                      // bytes 14 to 17
  UINT64BE participant_reference_number;  // bytes 18 to 25, signed, read here as unsigned
} MessageHeader;

// ---- Rejection Message: 14 bytes ---------------------------------------------

// Used for all errors to notify a Participant that CQS has found an error in the Block Header, Message Header or Message body of a Participant Input message.
entrypoint typedef struct _RejectionMessage {
  UINT8 error_code;                       // byte 0
  UINT32BE block_sequence_number;         // bytes 1 to 4
  UINT64BE participant_reference_number;  // bytes 5 to 12, signed, read here as unsigned
  UINT8 message_i_d;                      // byte 13
} RejectionMessage;

// ---- Warning Message: 12 bytes -----------------------------------------------

// Sent from CQS to a Participant in response to a Block Sequence Number Gap. The block will still be processed by CQS.
entrypoint typedef struct _WarningMessage {
  UINT32BE previous_block_sequence_number;         // bytes 0 to 3
  UINT64BE previous_participant_reference_number;  // bytes 4 to 11, signed, read here as unsigned
} WarningMessage;

// ---- Sequence Information And Message Count Response Message: 20 bytes -------

// Generated by CQS to a Participant in response to a Sequence Information and Message Count Inquiry message. Transmitted in a separate block.
entrypoint typedef struct _SequenceInformationAndMessageCountResponseMessage {
  UINT32BE current_block_sequence_number;      // bytes 0 to 3
  UINT64BE last_participant_reference_number;  // bytes 4 to 11, signed, read here as unsigned
  UINT64BE message_count;                      // bytes 12 to 19
} SequenceInformationAndMessageCountResponseMessage;

// ---- Odd Lot Refresh Request Message: 30 bytes -------------------------------

// Generated by CQS to a Participant in case of a CQS failure where CQS may inadvertently lose quotes previously reported by the Participant. Provides start and end symbol ranges for affected symbols.
entrypoint typedef struct _OddLotRefreshRequestMessage {
  UINT8 security_symbol_begin_range[11];  // bytes 0 to 10
  UINT8 security_symbol_end_range[11];    // bytes 11 to 21
  UINT8 reserved_8[8];                    // bytes 22 to 29
} OddLotRefreshRequestMessage;

// ---- Test Message: 256 bytes -------------------------------------------------

// Generated by CQS or a Participant to exercise the line and verify transmission integrity. Transmitted as the only message in a block.
entrypoint typedef struct _TestMessage {
  UINT8 data[256];  // bytes 0 to 255
} TestMessage;

// ---- Auction Status Message: 99 bytes ----------------------------------------

// Transmitted when a Participant in a CTA eligible security requires Auction Information. Initial Auction Collar is published after the LULD Trading Pause.
entrypoint typedef struct _AuctionStatusMessage {
  UINT8 security_symbol[11];                      // bytes 0 to 10
  UINT8 instrument_type;                          // byte 11
  UINT64BE auction_collar_reference_price;        // bytes 12 to 19
  UINT64BE auction_collar_upper_threshold_price;  // bytes 20 to 27
  UINT64BE auction_collar_lower_threshold_price;  // bytes 28 to 35
  UINT8 number_of_extensions;                     // byte 36
  UINT8 reserved_62[62];                          // bytes 37 to 98
} AuctionStatusMessage;

// ---- Short Quote Message: 15 bytes -------------------------------------------

// Reports Bid and Offer quote information for a CTA eligible Equity, Local Issue or Bond meeting the Short Quote criteria. Will be discontinued in favor of Round Lot Short Quote.
entrypoint typedef struct _ShortQuoteMessage {
  UINT8 security_symbol_short[5];  // bytes 0 to 4
  UINT16BE bid_price_short;        // bytes 5 to 6
  UINT16BE bid_size_short;         // bytes 7 to 8
  UINT16BE offer_price_short;      // bytes 9 to 10
  UINT16BE offer_size_short;       // bytes 11 to 12
  UINT8 reserved_2[2];             // bytes 13 to 14
} ShortQuoteMessage;

// ---- Timestamp 2: 8 bytes ----------------------------------------------------

// Timestamp 2
entrypoint typedef struct _Timestamp2 {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} Timestamp2;

// ---- Long Quote Message: 55 bytes --------------------------------------------

// Reports quote information for a CTA eligible Equity, Local Issue or Bond. Used to report trading suspensions, price indications and trading range indications on the CQS input lines. Will be discontinued in favor of Round Lot Long Quote.
entrypoint typedef struct _LongQuoteMessage {
  UINT8 security_symbol[11];               // bytes 0 to 10
  UINT8 instrument_type;                   // byte 11
  UINT8 quote_condition;                   // byte 12
  UINT8 security_status_indicator;         // byte 13
  UINT64BE bid_price;                      // bytes 14 to 21
  UINT32BE bid_size;                       // bytes 22 to 25
  UINT64BE offer_price;                    // bytes 26 to 33
  UINT32BE offer_size;                     // bytes 34 to 37
  UINT8 retail_interest_indicator;         // byte 38
  UINT8 settlement_condition;              // byte 39
  UINT8 market_condition;                  // byte 40
  UINT8 finra_market_maker_id[4];          // bytes 41 to 44
  UINT8 finra_bbo_indicator;               // byte 45
  Timestamp2 timestamp_2;                  // bytes 46 to 53
  UINT8 short_sale_restriction_indicator;  // byte 54
} LongQuoteMessage;

// ---- Special Long Quote Message: 88 bytes ------------------------------------

// Used only by FINRA ADF for CTA eligible Equity, Local Issue or Bond to identify the FINRA Best Bid and Best Offer at the Bid and/or Offer side. Will be discontinued in favor of Round Lot FINRA ADF Quote.
entrypoint typedef struct _SpecialLongQuoteMessage {
  UINT8 security_symbol[11];                  // bytes 0 to 10
  UINT8 instrument_type;                      // byte 11
  UINT8 quote_condition;                      // byte 12
  UINT8 security_status_indicator;            // byte 13
  UINT64BE bid_price;                         // bytes 14 to 21
  UINT32BE bid_size;                          // bytes 22 to 25
  UINT64BE offer_price;                       // bytes 26 to 33
  UINT32BE offer_size;                        // bytes 34 to 37
  UINT8 retail_interest_indicator;            // byte 38
  UINT8 settlement_condition;                 // byte 39
  UINT8 market_condition;                     // byte 40
  UINT8 finra_market_maker_id[4];             // bytes 41 to 44
  UINT8 finra_best_bid_quote_condition;       // byte 45
  UINT64BE finra_best_bid_price;              // bytes 46 to 53
  UINT32BE finra_best_bid_size;               // bytes 54 to 57
  UINT8 finra_best_bid_market_maker_id[4];    // bytes 58 to 61
  UINT8 finra_best_offer_quote_condition;     // byte 62
  UINT64BE finra_best_offer_price;            // bytes 63 to 70
  UINT32BE finra_best_offer_size;             // bytes 71 to 74
  UINT8 finra_best_offer_market_maker_id[4];  // bytes 75 to 78
  Timestamp2 timestamp_2;                     // bytes 79 to 86
  UINT8 short_sale_restriction_indicator;     // byte 87
} SpecialLongQuoteMessage;

// ---- Trading Status Message: 51 bytes ----------------------------------------

// Allows a Participant that is the listing exchange to notify CQS of Trading Halts, Resumes, Indications, Imbalances, Short Sale Restriction Indicators and LULD Reference Prices. Bidirectional. Supported on both CQS and CTS input lines for redundancy.
entrypoint typedef struct _TradingStatusMessage {
  UINT8 security_symbol[11];                                   // bytes 0 to 10
  UINT8 instrument_type;                                       // byte 11
  UINT64BE last_price_opening_reopening_luld_reference_price;  // bytes 12 to 19
  UINT64BE high_indication_price_upper_limit_price_band;       // bytes 20 to 27
  UINT64BE low_indication_price_lower_limit_price_band;        // bytes 28 to 35
  UINT32BE buy_volume;                                         // bytes 36 to 39
  UINT32BE sell_volume;                                        // bytes 40 to 43
  UINT8 security_status;                                       // byte 44
  UINT8 halt_reason;                                           // byte 45
  UINT8 short_sale_restriction_indicator;                      // byte 46
  UINT32BE trading_status_id;                                  // bytes 47 to 50
} TradingStatusMessage;

