// Finra Best Bid Quote Condition: one byte code
#define FINRA_BEST_BID_QUOTE_CONDITION_QUOTE_CONDITION_NOT_APPLICABLE 0x20                                                    // Quote Condition Not Applicable
#define FINRA_BEST_BID_QUOTE_CONDITION_SLOW_QUOTE_ON_OFFER_SIDE 0x41                                                          // Slow Quote On Offer Side
#define FINRA_BEST_BID_QUOTE_CONDITION_SLOW_QUOTE_ON_BID_SIDE 0x42                                                            // Slow Quote On Bid Side
#define FINRA_BEST_BID_QUOTE_CONDITION_CLOSING 0x43                                                                           // Closing
#define FINRA_BEST_BID_QUOTE_CONDITION_SLOW_QUOTE_DUE_TO_LRP_OR_GAP_QUOTE_ON_THE_BID_SIDE 0x45                                // Slow Quote Due To Lrp Or Gap Quote On The Bid Side
#define FINRA_BEST_BID_QUOTE_CONDITION_SLOW_QUOTE_DUE_TO_LRP_OR_GAP_QUOTE_ON_THE_OFFER_SIDE 0x46                              // Slow Quote Due To Lrp Or Gap Quote On The Offer Side
#define FINRA_BEST_BID_QUOTE_CONDITION_SLOW_QUOTE_ON_THE_BID_AND_OFFER_SIDES 0x48                                             // Slow Quote On The Bid And Offer Sides
#define FINRA_BEST_BID_QUOTE_CONDITION_CLOSED_MARKET_MAKER 0x4C                                                               // Closed Market Maker
#define FINRA_BEST_BID_QUOTE_CONDITION_NON_FIRM_QUOTE 0x4E                                                                    // Non Firm Quote
#define FINRA_BEST_BID_QUOTE_CONDITION_OPENING_QUOTE 0x4F                                                                     // Opening Quote
#define FINRA_BEST_BID_QUOTE_CONDITION_REGULAR_FINRA_OPEN 0x52                                                                // Regular Finra Open
#define FINRA_BEST_BID_QUOTE_CONDITION_SLOW_QUOTE_DUE_TO_LIQUIDITY_REPLENISHMENT_POINT_OR_GAP_QUOTE_ON_BOTH_THE__doi3p9 0x55  // Slow Quote Due To Liquidity Replenishment Point Or Gap Quote On Both The Bid And Offer Sides
#define FINRA_BEST_BID_QUOTE_CONDITION_SLOW_QUOTE_DUE_TO_SET_SLOW_LIST_ON_BOTH_THE_BID_AND_OFFER_SIDES 0x57                   // Slow Quote Due To Set Slow List On Both The Bid And Offer Sides
#define FINRA_BEST_BID_QUOTE_CONDITION_ON_DEMAND_INTRA_DAY_AUCTION 0x34                                                       // On Demand Intra Day Auction

// Finra Best Offer Quote Condition: one byte code
#define FINRA_BEST_OFFER_QUOTE_CONDITION_QUOTE_CONDITION_NOT_APPLICABLE 0x20                                                    // Quote Condition Not Applicable
#define FINRA_BEST_OFFER_QUOTE_CONDITION_SLOW_QUOTE_ON_OFFER_SIDE 0x41                                                          // Slow Quote On Offer Side
#define FINRA_BEST_OFFER_QUOTE_CONDITION_SLOW_QUOTE_ON_BID_SIDE 0x42                                                            // Slow Quote On Bid Side
#define FINRA_BEST_OFFER_QUOTE_CONDITION_CLOSING 0x43                                                                           // Closing
#define FINRA_BEST_OFFER_QUOTE_CONDITION_SLOW_QUOTE_DUE_TO_LRP_OR_GAP_QUOTE_ON_THE_BID_SIDE 0x45                                // Slow Quote Due To Lrp Or Gap Quote On The Bid Side
#define FINRA_BEST_OFFER_QUOTE_CONDITION_SLOW_QUOTE_DUE_TO_LRP_OR_GAP_QUOTE_ON_THE_OFFER_SIDE 0x46                              // Slow Quote Due To Lrp Or Gap Quote On The Offer Side
#define FINRA_BEST_OFFER_QUOTE_CONDITION_SLOW_QUOTE_ON_THE_BID_AND_OFFER_SIDES 0x48                                             // Slow Quote On The Bid And Offer Sides
#define FINRA_BEST_OFFER_QUOTE_CONDITION_CLOSED_MARKET_MAKER 0x4C                                                               // Closed Market Maker
#define FINRA_BEST_OFFER_QUOTE_CONDITION_NON_FIRM_QUOTE 0x4E                                                                    // Non Firm Quote
#define FINRA_BEST_OFFER_QUOTE_CONDITION_OPENING_QUOTE 0x4F                                                                     // Opening Quote
#define FINRA_BEST_OFFER_QUOTE_CONDITION_REGULAR_FINRA_OPEN 0x52                                                                // Regular Finra Open
#define FINRA_BEST_OFFER_QUOTE_CONDITION_SLOW_QUOTE_DUE_TO_LIQUIDITY_REPLENISHMENT_POINT_OR_GAP_QUOTE_ON_BOTH_THE__doi3p9 0x55  // Slow Quote Due To Liquidity Replenishment Point Or Gap Quote On Both The Bid And Offer Sides
#define FINRA_BEST_OFFER_QUOTE_CONDITION_SLOW_QUOTE_DUE_TO_SET_SLOW_LIST_ON_BOTH_THE_BID_AND_OFFER_SIDES 0x57                   // Slow Quote Due To Set Slow List On Both The Bid And Offer Sides
#define FINRA_BEST_OFFER_QUOTE_CONDITION_ON_DEMAND_INTRA_DAY_AUCTION 0x34                                                       // On Demand Intra Day Auction

// Finra Bbo Luld Indicator: one byte code
#define FINRA_BBO_LULD_INDICATOR_LIMIT_UP_LIMIT_DOWN_NOT_APPLICABLE 0x20                                                // Limit Up Limit Down Not Applicable
#define FINRA_BBO_LULD_INDICATOR_FINRA_BEST_BID_AND_OR_FINRA_BEST_OFFER_ARE_EXECUTABLE 0x41                             // Finra Best Bid And Or Finra Best Offer Are Executable
#define FINRA_BBO_LULD_INDICATOR_FINRA_BEST_BID_BELOW_LOWER_LIMIT_PRICE_BAND_AND_FINRA_BEST_BID_IS_NON_EXECUTABLE 0x42  // Finra Best Bid Below Lower Limit Price Band And Finra Best Bid Is Non Executable
#define FINRA_BBO_LULD_INDICATOR_FINRA_BEST_OFFER_ABOVE_UPPER_LIMIT_PRICE_BAND_AND_FINRA_BEST_OFFER_IS_NON_9oay8p 0x43  // Finra Best Offer Above Upper Limit Price Band And Finra Best Offer Is Non Executable
#define FINRA_BBO_LULD_INDICATOR_BEST_BID_BELOW_LOWER_LIMIT_PRICE_BAND_AND_BEST_OFFER_ABOVE_UPPER_LIMIT_PR_6qca7w 0x44  // Best Bid Below Lower Limit Price Band And Best Offer Above Upper Limit Price Band Best Bid And Best Offer Are Non Executable For Finra

// ---- Types -------------------------------------------------------------------

// Sip Block Timestamp
typedef struct _SipBlockTimestamp {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} SipBlockTimestamp;

// transmitted over the multicast lines at intervals of ten (10) seconds to verify continued integrity of multicast transmission
typedef struct _LineIntegrityMessage {
  UINT8 participant_id;  // byte 0
} LineIntegrityMessage;

// The Market-Wide Circuit Breaker Decline Level Status Snapshot Message is used to report the calculated Level 1, Level 2 and Level 3 threshold values for the current trading day necessary to trigger a circuit breaker
typedef struct _MarketWideCircuitBreakerDeclineLevelStatusSnapshotMessage {
  UINT8 participant_id;   // byte 0
  UINT64BE mwcb_level_1;  // bytes 1 to 8, signed, read here as unsigned
  UINT64BE mwcb_level_2;  // bytes 9 to 16, signed, read here as unsigned
  UINT64BE mwcb_level_3;  // bytes 17 to 24, signed, read here as unsigned
  UINT8 reserved;         // byte 25
} MarketWideCircuitBreakerDeclineLevelStatusSnapshotMessage;

// a SIP Generated Message used to report information for each Security Symbol
typedef struct _ConsolidatedSnapshotMessage {
  UINT8 participant_id;                           // byte 0
  UINT8 security_symbol[11];                      // bytes 1 to 11
  UINT8 instrument_type;                          // byte 12
  UINT64BE lower_limit_price_band;                // bytes 13 to 20
  UINT64BE upper_limit_price_band;                // bytes 21 to 28
  UINT64BE auction_collar_reference_price;        // bytes 29 to 36
  UINT64BE auction_collar_upper_threshold_price;  // bytes 37 to 44
  UINT64BE auction_collar_lower_threshold_price;  // bytes 45 to 52
  UINT8 number_of_extensions;                     // byte 53
  UINT8 national_best_bid_participant_id;         // byte 54
  UINT8 national_best_bid_quote_condition;        // byte 55
  UINT64BE national_best_bid_price;               // bytes 56 to 63
  UINT32BE national_best_bid_size;                // bytes 64 to 67
  UINT8 finra_best_bid_market_maker_id[4];        // bytes 68 to 71
  UINT8 national_best_offer_participant_id;       // byte 72
  UINT8 national_best_offer_quote_condition;      // byte 73
  UINT64BE national_best_offer_price;             // bytes 74 to 81
  UINT32BE national_best_offer_size;              // bytes 82 to 85
  UINT8 finra_best_offer_market_maker_id[4];      // bytes 86 to 89
  UINT8 national_bbo_luld_indicator;              // byte 90
  UINT8 primary_listing_market_participant_id;    // byte 91
  UINT8 financial_status_indicator;               // byte 92
  UINT8 short_sale_restriction_indicator;         // byte 93
  UINT8 halt_reason;                              // byte 94
  UINT8 future;                                   // byte 95
} ConsolidatedSnapshotMessage;

// a SIP Generated Message used to report information for each Security Symbol
typedef struct _ParticipantSnapshotMessage {
  UINT8 participant_id;             // byte 0
  UINT8 security_symbol[11];        // bytes 1 to 11
  UINT8 quote_condition;            // byte 12
  UINT64BE bid_price;               // bytes 13 to 20
  UINT32BE bid_size;                // bytes 21 to 24
  UINT64BE offer_price;             // bytes 25 to 32
  UINT32BE offer_size;              // bytes 33 to 36
  UINT8 retail_interest_indicator;  // byte 37
  UINT8 settlement_condition;       // byte 38
  UINT8 market_condition;           // byte 39
  UINT8 luld_indicator;             // byte 40
  UINT64BE high_indication_price;   // bytes 41 to 48
  UINT64BE low_indication_price;    // bytes 49 to 56
  UINT8 halt_reason;                // byte 57
} ParticipantSnapshotMessage;

// The FINRA Snapshot message is a SIP Generated Message used to report FINRA Best Bid and Offer
typedef struct _FinraSnapshotMessage {
  UINT8 participant_id;                       // byte 0
  UINT8 security_symbol[11];                  // bytes 1 to 11
  UINT8 finra_best_bid_quote_condition;       // byte 12
  UINT64BE finra_best_bid_price;              // bytes 13 to 20
  UINT32BE finra_best_bid_size;               // bytes 21 to 24
  UINT8 finra_best_bid_market_maker_id[4];    // bytes 25 to 28
  UINT8 finra_best_offer_quote_condition;     // byte 29
  UINT64BE finra_best_offer_price;            // bytes 30 to 37
  UINT32BE finra_best_offer_size;             // bytes 38 to 41
  UINT8 finra_best_offer_market_maker_id[4];  // bytes 42 to 45
  UINT8 finra_bbo_luld_indicator;             // byte 46
  UINT64BE high_indication_price;             // bytes 47 to 54
  UINT64BE low_indication_price;              // bytes 55 to 62
  UINT8 halt_reason;                          // byte 63
} FinraSnapshotMessage;

// Branch
casetype _SnapshotMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: LineIntegrityMessage line_integrity_message;
    case 0x4B: MarketWideCircuitBreakerDeclineLevelStatusSnapshotMessage market_wide_circuit_breaker_decline_level_status_snapshot_message;
    case 0x43: ConsolidatedSnapshotMessage consolidated_snapshot_message;
    case 0x50: ParticipantSnapshotMessage participant_snapshot_message;
    case 0x46: FinraSnapshotMessage finra_snapshot_message;
    default: UINT8 unknown[available];
  }
} SnapshotMessagePayload;

// Snapshot Message Header
typedef struct _SnapshotMessage (UINT32 available) where (available >= 1) {
  UINT8 snapshot_message_type;                                                                                                               // byte 0
  SnapshotMessagePayload(snapshot_message_type, (available - 1)) snapshot_message_payload[:byte-size-single-element-array (available - 1)];
} SnapshotMessage;

// Branch
casetype _CategoryPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x52: SnapshotMessage(available) snapshot_message;
    default: UINT8 unknown[available];
  }
} CategoryPayload;

// Repeating message block
typedef struct _Message {
  UINT16BE message_length { message_length >= 3 };                                                                                                       // bytes 0 to 1
  UINT8 message_category;                                                                                                                                // byte 2
  CategoryPayload(message_category, (((UINT32) message_length) - 3)) category_payload[:byte-size-single-element-array (((UINT32) message_length) - 3)];
} Message;

// Repeating message block
casetype _MessagePart1 (Bool present) {
  switch (present) {
    case true: Message block;
    case false: unit none;
  }
} MessagePart1;

// Repeating message block
typedef struct _MessageBlock2 {
  Message first;
  Message second;
} MessageBlock2;

// Repeating message block
casetype _MessagePart2 (Bool present) {
  switch (present) {
    case true: MessageBlock2 block;
    case false: unit none;
  }
} MessagePart2;

// Repeating message block
typedef struct _MessageBlock4 {
  MessageBlock2 first;
  MessageBlock2 second;
} MessageBlock4;

// Repeating message block
casetype _MessagePart4 (Bool present) {
  switch (present) {
    case true: MessageBlock4 block;
    case false: unit none;
  }
} MessagePart4;

// Repeating message block
typedef struct _MessageBlock8 {
  MessageBlock4 first;
  MessageBlock4 second;
} MessageBlock8;

// Repeating message block
casetype _MessagePart8 (Bool present) {
  switch (present) {
    case true: MessageBlock8 block;
    case false: unit none;
  }
} MessagePart8;

// Repeating message block
typedef struct _MessageBlock16 {
  MessageBlock8 first;
  MessageBlock8 second;
} MessageBlock16;

// Repeating message block
casetype _MessagePart16 (Bool present) {
  switch (present) {
    case true: MessageBlock16 block;
    case false: unit none;
  }
} MessagePart16;

// Repeating message block
typedef struct _MessageBlock32 {
  MessageBlock16 first;
  MessageBlock16 second;
} MessageBlock32;

// Repeating message block
casetype _MessagePart32 (Bool present) {
  switch (present) {
    case true: MessageBlock32 block;
    case false: unit none;
  }
} MessagePart32;

// Repeating message block
typedef struct _MessageBlock64 {
  MessageBlock32 first;
  MessageBlock32 second;
} MessageBlock64;

// Repeating message block
casetype _MessagePart64 (Bool present) {
  switch (present) {
    case true: MessageBlock64 block;
    case false: unit none;
  }
} MessagePart64;

// Repeating message block
typedef struct _MessageBlock128 {
  MessageBlock64 first;
  MessageBlock64 second;
} MessageBlock128;

// Repeating message block
casetype _MessagePart128 (Bool present) {
  switch (present) {
    case true: MessageBlock128 block;
    case false: unit none;
  }
} MessagePart128;

// Repeating message block
typedef struct _MessageCounted (UINT32 count) {
  MessagePart128(((count & 128) != 0)) part128;
  MessagePart64(((count & 64) != 0)) part64;
  MessagePart32(((count & 32) != 0)) part32;
  MessagePart16(((count & 16) != 0)) part16;
  MessagePart8(((count & 8) != 0)) part8;
  MessagePart4(((count & 4) != 0)) part4;
  MessagePart2(((count & 2) != 0)) part2;
  MessagePart1(((count & 1) != 0)) part1;
} MessageCounted;

// ---- Packet: Packet ----------------------------------------------------------

// Cqs Udp Packet
entrypoint typedef struct _Packet {
  UINT8 version;                                         // byte 0
  UINT16BE block_size;                                   // bytes 1 to 2
  UINT32BE block_sequence_number;                        // bytes 3 to 6
  UINT8 messages_in_block;                               // byte 7
  UINT8 deliveryflag;                                    // byte 8
  UINT32BE lastseqnum;                                   // bytes 9 to 12
  UINT8 totpubseqrollover;                               // byte 13
  SipBlockTimestamp sip_block_timestamp;                 // bytes 14 to 21
  UINT16BE block_checksum;                               // bytes 22 to 23
  MessageCounted(((UINT32) messages_in_block)) message;
  UINT8 block_pad_byte[:consume-all];
} Packet;

