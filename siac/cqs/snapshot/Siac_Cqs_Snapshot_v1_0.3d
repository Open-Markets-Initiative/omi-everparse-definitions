  UINT8 national_best_bid_participant_id;         // byte 54
  UINT8 national_best_bid_quote_condition;        // byte 55
  UINT64BE national_best_bid_price;               // bytes 56 to 63
  UINT32BE national_best_bid_size;                // bytes 64 to 67
