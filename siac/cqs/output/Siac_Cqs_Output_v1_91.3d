#define BEST_OFFER_PARTICIPANT_ID_CBOE_BZX 0x5A       // Cboe Bzx

// Finra Bbo Luld Indicator: one byte code
#define FINRA_BBO_LULD_INDICATOR_LIMIT_UP_LIMIT_DOWN_NOT_APPLICABLE 0x20                                                // Limit Up Limit Down Not Applicable
#define FINRA_BBO_LULD_INDICATOR_FINRA_BEST_BID_AND_OR_FINRA_BEST_OFFER_ARE_EXECUTABLE 0x41                             // Finra Best Bid And Or Finra Best Offer Are Executable
#define FINRA_BBO_LULD_INDICATOR_FINRA_BEST_BID_BELOW_LOWER_LIMIT_PRICE_BAND_AND_FINRA_BEST_BID_IS_NON_EXECUTABLE 0x42  // Finra Best Bid Below Lower Limit Price Band And Finra Best Bid Is Non Executable
#define FINRA_BBO_LULD_INDICATOR_FINRA_BEST_OFFER_ABOVE_UPPER_LIMIT_PRICE_BAND_AND_FINRA_BEST_OFFER_IS_NON_9oay8p 0x43  // Finra Best Offer Above Upper Limit Price Band And Finra Best Offer Is Non Executable
#define FINRA_BBO_LULD_INDICATOR_BEST_BID_BELOW_LOWER_LIMIT_PRICE_BAND_AND_BEST_OFFER_ABOVE_UPPER_LIMIT_PR_6qca7w 0x44  // Best Bid Below Lower Limit Price Band And Best Offer Above Upper Limit Price Band Best Bid And Best Offer Are Non Executable For Finra

// ---- Types -------------------------------------------------------------------

// Sip Block Timestamp
typedef struct _SipBlockTimestamp {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} SipBlockTimestamp;

// Participant Timestamp
typedef struct _ParticipantTimestamp {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} ParticipantTimestamp;

// The Administrative Unformatted (free form text) Category A message is designed to facilitate non-computerized miscellaneous information messages to CQS
typedef struct _AdministrativeUnformattedMessage {
  UINT8 participant_id;                        // byte 0
  ParticipantTimestamp participant_timestamp;  // bytes 1 to 8
  UINT8 message_id;                            // byte 9
  UINT32BE transaction_id;                     // bytes 10 to 13
  UINT64BE participant_reference_number;       // bytes 14 to 21, signed, read here as unsigned
  UINT8 text[4];                               // bytes 22 to 25
} AdministrativeUnformattedMessage;

// Branch
casetype _AdministrativeMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x48: AdministrativeUnformattedMessage administrative_unformatted_message;
    default: UINT8 unknown[available];
  }
} AdministrativeMessagePayload;

// Administrative Messages Header
typedef struct _AdministrativeMessage (UINT32 available) where (available >= 1) {
  UINT8 administrative_message_type;                                                                                                                           // byte 0
  AdministrativeMessagePayload(administrative_message_type, (available - 1)) administrative_message_payload[:byte-size-single-element-array (available - 1)];
} AdministrativeMessage;

// The Start of Day message signals the start of normal data dissemination over the multicast lines
typedef struct _StartOfDayMessage {
  UINT8 participant_id;                        // byte 0
  ParticipantTimestamp participant_timestamp;  // bytes 1 to 8
  UINT8 message_id;                            // byte 9
  UINT32BE transaction_id;                     // bytes 10 to 13
  UINT64BE participant_reference_number;       // bytes 14 to 21, signed, read here as unsigned
} StartOfDayMessage;

// The FINRA Close message is transmitted by FINRA to CQS to indicate the Close state of FINRA Market Maker(s).
typedef struct _FinraCloseMessage {
  UINT8 participant_id;                        // byte 0
  ParticipantTimestamp participant_timestamp;  // bytes 1 to 8
  UINT8 message_id;                            // byte 9
  UINT32BE transaction_id;                     // bytes 10 to 13
  UINT64BE participant_reference_number;       // bytes 14 to 21, signed, read here as unsigned
} FinraCloseMessage;

// The Reset Block Sequence Number message is transmitted when the block sequence number on an output multicast line requires resetting.
typedef struct _ResetBlockSequenceNumberMessage {
  UINT8 participant_id;                        // byte 0
  ParticipantTimestamp participant_timestamp;  // bytes 1 to 8
  UINT8 message_id;                            // byte 9
  UINT32BE transaction_id;                     // bytes 10 to 13
  UINT64BE participant_reference_number;       // bytes 14 to 21, signed, read here as unsigned
} ResetBlockSequenceNumberMessage;

// The Start of Test Cycle message is transmitted to signal the beginning of the transmission of test message cycles
typedef struct _StartOfTestCycleMessage {
  UINT8 participant_id;                        // byte 0
  ParticipantTimestamp participant_timestamp;  // bytes 1 to 8
  UINT8 message_id;                            // byte 9
  UINT32BE transaction_id;                     // bytes 10 to 13
  UINT64BE participant_reference_number;       // bytes 14 to 21, signed, read here as unsigned
} StartOfTestCycleMessage;

// The End of Test Cycle message is transmitted to signal the end of the transmission of the repeated free form text test message cycles
typedef struct _EndOfTestCycleMessage {
  UINT8 participant_id;                        // byte 0
  ParticipantTimestamp participant_timestamp;  // bytes 1 to 8
  UINT8 message_id;                            // byte 9
  UINT32BE transaction_id;                     // bytes 10 to 13
  UINT64BE participant_reference_number;       // bytes 14 to 21, signed, read here as unsigned
} EndOfTestCycleMessage;

// The FINRA Open message is transmitted by FINRA to CQS
typedef struct _FinraOpenMessage {
  UINT8 participant_id;                        // byte 0
  ParticipantTimestamp participant_timestamp;  // bytes 1 to 8
  UINT8 message_id;                            // byte 9
  UINT32BE transaction_id;                     // bytes 10 to 13
  UINT64BE participant_reference_number;       // bytes 14 to 21, signed, read here as unsigned
} FinraOpenMessage;

// The Disaster Recovery Data Center Activation message is transmitted to signify that the Consolidated Quotation System (CQS) has switched processing from the Primary Data Center to the Disaster Recovery Data Center
typedef struct _DisasterRecoveryDataCenterActivationMessage {
  UINT8 participant_id;                        // byte 0
  ParticipantTimestamp participant_timestamp;  // bytes 1 to 8
  UINT8 message_id;                            // byte 9
  UINT32BE transaction_id;                     // bytes 10 to 13
  UINT64BE participant_reference_number;       // bytes 14 to 21, signed, read here as unsigned
} DisasterRecoveryDataCenterActivationMessage;

// The Line Integrity message is transmitted over the multicast lines at intervals of sixty (60) seconds to verify continued integrity of multicast transmission
typedef struct _LineIntegrityMessage {
  UINT8 participant_id;                        // byte 0
  ParticipantTimestamp participant_timestamp;  // bytes 1 to 8
  UINT8 message_id;                            // byte 9
  UINT32BE transaction_id;                     // bytes 10 to 13
  UINT64BE participant_reference_number;       // bytes 14 to 21, signed, read here as unsigned
} LineIntegrityMessage;

// The End of Day message is transmitted over the multicast lines to advise all Data Recipients that there are no further messages of any type transmitted for the day
typedef struct _EndOfDayMessage {
  UINT8 participant_id;                        // byte 0
  ParticipantTimestamp participant_timestamp;  // bytes 1 to 8
  UINT8 message_id;                            // byte 9
  UINT32BE transaction_id;                     // bytes 10 to 13
  UINT64BE participant_reference_number;       // bytes 14 to 21, signed, read here as unsigned
} EndOfDayMessage;

// Branch
casetype _ControlMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: StartOfDayMessage start_of_day_message;
    case 0x43: FinraCloseMessage finra_close_message;
    case 0x4C: ResetBlockSequenceNumberMessage reset_block_sequence_number_message;
    case 0x4D: StartOfTestCycleMessage start_of_test_cycle_message;
    case 0x4E: EndOfTestCycleMessage end_of_test_cycle_message;
    case 0x4F: FinraOpenMessage finra_open_message;
    case 0x50: DisasterRecoveryDataCenterActivationMessage disaster_recovery_data_center_activation_message;
    case 0x54: LineIntegrityMessage line_integrity_message;
    case 0x5A: EndOfDayMessage end_of_day_message;
    default: UINT8 unknown[available];
  }
} ControlMessagePayload;

// Control Messages Header
typedef struct _ControlMessage (UINT32 available) where (available >= 1) {
  UINT8 control_message_type;                                                                                                             // byte 0
  ControlMessagePayload(control_message_type, (available - 1)) control_message_payload[:byte-size-single-element-array (available - 1)];
} ControlMessage;

// The Market-Wide Circuit Breaker Decline Level Status message is used to report the calculated Level 1, Level 2 and Level 3 threshold values for the current trading day necessary to trigger a circuit breaker
typedef struct _MarketWideCircuitBreakerDeclineLevelStatusMessage {
  UINT8 participant_id;                        // byte 0
  ParticipantTimestamp participant_timestamp;  // bytes 1 to 8
  UINT8 message_id;                            // byte 9
  UINT32BE transaction_id;                     // bytes 10 to 13
  UINT64BE participant_reference_number;       // bytes 14 to 21, signed, read here as unsigned
  UINT64BE mwcb_level_1;                       // bytes 22 to 29, signed, read here as unsigned
  UINT64BE mwcb_level_2;                       // bytes 30 to 37, signed, read here as unsigned
  UINT64BE mwcb_level_3;                       // bytes 38 to 45, signed, read here as unsigned
  UINT8 reserved;                              // byte 46
} MarketWideCircuitBreakerDeclineLevelStatusMessage;

// The Market-Wide Circuit Breaker Status message is used to report the Market-Wide Circuit Breaker threshold Level that has been breached.
typedef struct _MarketWideCircuitBreakerStatusMessage {
  UINT8 participant_id;                               // byte 0
  ParticipantTimestamp participant_timestamp;         // bytes 1 to 8
  UINT8 message_id;                                   // byte 9
  UINT32BE transaction_id;                            // bytes 10 to 13
  UINT64BE participant_reference_number;              // bytes 14 to 21, signed, read here as unsigned
  UINT8 market_wide_circuit_breaker_level_indicator;  // byte 22
  UINT8 reserved;                                     // byte 23
} MarketWideCircuitBreakerStatusMessage;

// Branch
casetype _MarketStatusMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x4B: MarketWideCircuitBreakerDeclineLevelStatusMessage market_wide_circuit_breaker_decline_level_status_message;
    case 0x4C: MarketWideCircuitBreakerStatusMessage market_wide_circuit_breaker_status_message;
    default: UINT8 unknown[available];
  }
} MarketStatusMessagePayload;

// Market Status Messages Header
typedef struct _MarketStatusMessage (UINT32 available) where (available >= 1) {
  UINT8 market_status_message_type;                                                                                                                        // byte 0
  MarketStatusMessagePayload(market_status_message_type, (available - 1)) market_status_message_payload[:byte-size-single-element-array (available - 1)];
} MarketStatusMessage;

// The Auction Status message is used when a Participant in a Cta eligible security
typedef struct _AuctionStatusMessage {
  UINT8 participant_id;                           // byte 0
  ParticipantTimestamp participant_timestamp;     // bytes 1 to 8
  UINT8 message_id;                               // byte 9
  UINT32BE transaction_id;                        // bytes 10 to 13
  UINT64BE participant_reference_number;          // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol_long[11];                 // bytes 22 to 32
  UINT8 instrument_type;                          // byte 33
  UINT64BE auction_collar_reference_price;        // bytes 34 to 41
  UINT64BE auction_collar_upper_threshold_price;  // bytes 42 to 49
  UINT64BE auction_collar_lower_threshold_price;  // bytes 50 to 57
  UINT8 number_of_extensions;                     // byte 58
  UINT8 short_sale_restriction_indicator;         // byte 59
  UINT8 primary_listing_market_participant_id;    // byte 60
  UINT8 financial_status_indicator;               // byte 61
  UINT8 future;                                   // byte 62
} AuctionStatusMessage;

// Adf Timestamp
typedef struct _AdfTimestamp {
  UINT32BE seconds;      // bytes 0 to 3
  UINT32BE nanoseconds;  // bytes 4 to 7
} AdfTimestamp;

// National Best Bid Long Appendage
typedef struct _NationalBestBidLongAppendage {
  UINT8 best_bid_participant_id;            // byte 0
  UINT8 best_bid_quote_condition;           // byte 1
  UINT64BE best_bid_price_long;             // bytes 2 to 9
  UINT32BE best_bid_size_long;              // bytes 10 to 13
  UINT8 finra_best_bid_market_maker_id[4];  // bytes 14 to 17
} NationalBestBidLongAppendage;

// National Best Bid Long Appendage
casetype _OptionalNationalBestBidLongAppendage (Bool present) {
  switch (present) {
    case true: NationalBestBidLongAppendage national_best_bid_long_appendage;
    case false: unit absent;
  }
} OptionalNationalBestBidLongAppendage;

// National Best Offer Long Appendage
typedef struct _NationalBestOfferLongAppendage {
  UINT8 best_offer_participant_id;            // byte 0
  UINT8 best_offer_quote_condition;           // byte 1
  UINT64BE best_offer_price_long;             // bytes 2 to 9
  UINT32BE best_offer_size_long;              // bytes 10 to 13
  UINT8 finra_best_offer_market_maker_id[4];  // bytes 14 to 17
} NationalBestOfferLongAppendage;

// National Best Offer Long Appendage
casetype _OptionalNationalBestOfferLongAppendage (Bool present) {
  switch (present) {
    case true: NationalBestOfferLongAppendage national_best_offer_long_appendage;
    case false: unit absent;
  }
} OptionalNationalBestOfferLongAppendage;

// National Best Bid Short Appendage
typedef struct _NationalBestBidShortAppendage {
  UINT8 best_bid_participant_id;  // byte 0
  UINT16BE best_bid_price_short;  // bytes 1 to 2
  UINT16BE best_bid_size_short;   // bytes 3 to 4
} NationalBestBidShortAppendage;

// National Best Bid Short Appendage
casetype _OptionalNationalBestBidShortAppendage (Bool present) {
  switch (present) {
    case true: NationalBestBidShortAppendage national_best_bid_short_appendage;
    case false: unit absent;
  }
} OptionalNationalBestBidShortAppendage;

// National Best Offer Short Appendage
typedef struct _NationalBestOfferShortAppendage {
  UINT8 best_offer_participant_id;  // byte 0
  UINT16BE best_offer_price_short;  // bytes 1 to 2
  UINT16BE best_offer_size_short;   // bytes 3 to 4
} NationalBestOfferShortAppendage;

// National Best Offer Short Appendage
casetype _OptionalNationalBestOfferShortAppendage (Bool present) {
  switch (present) {
    case true: NationalBestOfferShortAppendage national_best_offer_short_appendage;
    case false: unit absent;
  }
} OptionalNationalBestOfferShortAppendage;

// The Long Quote message is used to report quote data for a Cta eligible Equity, Local Issue or Bonds.
typedef struct _LongQuoteMessage {
  UINT8 participant_id;                                                                                           // byte 0
  ParticipantTimestamp participant_timestamp;                                                                     // bytes 1 to 8
  UINT8 message_id;                                                                                               // byte 9
  UINT32BE transaction_id;                                                                                        // bytes 10 to 13
  UINT64BE participant_reference_number;                                                                          // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol_long[11];                                                                                 // bytes 22 to 32
  UINT8 instrument_type;                                                                                          // byte 33
  UINT8 quote_condition;                                                                                          // byte 34
  UINT8 security_status_indicator;                                                                                // byte 35
  UINT64BE bid_price_lower_limit_price_band;                                                                      // bytes 36 to 43
  UINT32BE bid_size_long;                                                                                         // bytes 44 to 47
  UINT64BE offer_price_upper_limit_price_band;                                                                    // bytes 48 to 55
  UINT32BE offer_size_long;                                                                                       // bytes 56 to 59
  UINT8 retail_interest_indicator;                                                                                // byte 60
  UINT8 settlement_condition;                                                                                     // byte 61
  UINT8 market_condition;                                                                                         // byte 62
  UINT8 finra_market_maker_id[4];                                                                                 // bytes 63 to 66
  UINT8 finra_bbo_indicator;                                                                                      // byte 67
  AdfTimestamp adf_timestamp;                                                                                     // bytes 68 to 75
  UINT8 short_sale_restriction_indicator;                                                                         // byte 76
  UINT8 primary_listing_market_participant_id;                                                                    // byte 77
  UINT8 financial_status_indicator;                                                                               // byte 78
  UINT8 sip_generated_message_identifier;                                                                         // byte 79
  UINT8 luld_indicator;                                                                                           // byte 80
  UINT8 national_bbo_luld_indicator;                                                                              // byte 81
  UINT8 national_bbo_indicator;                                                                                   // byte 82
  OptionalNationalBestBidLongAppendage((national_bbo_indicator == 0x55)) national_best_bid_long_appendage;
  OptionalNationalBestOfferLongAppendage((national_bbo_indicator == 0x55)) national_best_offer_long_appendage;
  OptionalNationalBestBidShortAppendage((national_bbo_indicator == 0x54)) national_best_bid_short_appendage;
  OptionalNationalBestOfferShortAppendage((national_bbo_indicator == 0x54)) national_best_offer_short_appendage;
} LongQuoteMessage;

// The Auction Status message is used when a Participant in a Cta eligible security
typedef struct _ShortQuoteMessage {
  UINT8 participant_id;                                                                                           // byte 0
  ParticipantTimestamp participant_timestamp;                                                                     // bytes 1 to 8
  UINT8 message_id;                                                                                               // byte 9
  UINT32BE transaction_id;                                                                                        // bytes 10 to 13
  UINT64BE participant_reference_number;                                                                          // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol_short[5];                                                                                 // bytes 22 to 26
  UINT16BE bid_price_short;                                                                                       // bytes 27 to 28
  UINT16BE bid_size_short;                                                                                        // bytes 29 to 30
  UINT16BE offer_price_short;                                                                                     // bytes 31 to 32
  UINT16BE offer_size_short;                                                                                      // bytes 33 to 34
  UINT8 primary_listing_market_participant_id;                                                                    // byte 35
  UINT8 national_bbo_indicator;                                                                                   // byte 36
  OptionalNationalBestBidLongAppendage((national_bbo_indicator == 0x55)) national_best_bid_long_appendage;
  OptionalNationalBestOfferLongAppendage((national_bbo_indicator == 0x55)) national_best_offer_long_appendage;
  OptionalNationalBestBidShortAppendage((national_bbo_indicator == 0x54)) national_best_bid_short_appendage;
  OptionalNationalBestOfferShortAppendage((national_bbo_indicator == 0x54)) national_best_offer_short_appendage;
} ShortQuoteMessage;

// The Special Quote (FINRA ADF) with FINRA BBO Information message is used only by FINRA to report the FINRA Best Bid and FINRA Best Offer for their Market Makers for Cta eligible Equity, Local Issue or Bond information Makers inclusive of changes to any existing FINRA BBO.
typedef struct _SpecialLongQuoteMessage {
  UINT8 participant_id;                                                                                           // byte 0
  ParticipantTimestamp participant_timestamp;                                                                     // bytes 1 to 8
  UINT8 message_id;                                                                                               // byte 9
  UINT32BE transaction_id;                                                                                        // bytes 10 to 13
  UINT64BE participant_reference_number;                                                                          // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol_long[11];                                                                                 // bytes 22 to 32
  UINT8 instrument_type;                                                                                          // byte 33
  UINT8 quote_condition;                                                                                          // byte 34
  UINT8 security_status_indicator;                                                                                // byte 35
  UINT64BE bid_price_long;                                                                                        // bytes 36 to 43
  UINT32BE bid_size_long;                                                                                         // bytes 44 to 47
  UINT64BE offer_price_long;                                                                                      // bytes 48 to 55
  UINT32BE offer_size_long;                                                                                       // bytes 56 to 59
  UINT8 retail_interest_indicator;                                                                                // byte 60
  UINT8 settlement_condition;                                                                                     // byte 61
  UINT8 market_condition;                                                                                         // byte 62
  UINT8 finra_market_maker_id[4];                                                                                 // bytes 63 to 66
  UINT8 finra_best_bid_quote_condition;                                                                           // byte 67
  UINT64BE finra_best_bid_price;                                                                                  // bytes 68 to 75
  UINT32BE finra_best_bid_size;                                                                                   // bytes 76 to 79
  UINT8 finra_best_bid_market_maker_id[4];                                                                        // bytes 80 to 83
  UINT8 finra_best_offer_quote_condition;                                                                         // byte 84
  UINT64BE finra_best_offer_price;                                                                                // bytes 85 to 92
  UINT32BE finra_best_offer_size;                                                                                 // bytes 93 to 96
  UINT8 finra_best_offer_market_maker_id[4];                                                                      // bytes 97 to 100
  AdfTimestamp adf_timestamp;                                                                                     // bytes 101 to 108
  UINT8 short_sale_restriction_indicator;                                                                         // byte 109
  UINT8 primary_listing_market_participant_id;                                                                    // byte 110
  UINT8 financial_status_indicator;                                                                               // byte 111
  UINT8 sip_generated_message_identifier;                                                                         // byte 112
  UINT8 finra_bbo_luld_indicator;                                                                                 // byte 113
  UINT8 national_bbo_luld_indicator;                                                                              // byte 114
  UINT8 national_bbo_indicator;                                                                                   // byte 115
  OptionalNationalBestBidLongAppendage((national_bbo_indicator == 0x55)) national_best_bid_long_appendage;
  OptionalNationalBestOfferLongAppendage((national_bbo_indicator == 0x55)) national_best_offer_long_appendage;
  OptionalNationalBestBidShortAppendage((national_bbo_indicator == 0x54)) national_best_bid_short_appendage;
  OptionalNationalBestOfferShortAppendage((national_bbo_indicator == 0x54)) national_best_offer_short_appendage;
} SpecialLongQuoteMessage;

// Branch
casetype _QuoteMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: AuctionStatusMessage auction_status_message;
    case 0x4C: LongQuoteMessage long_quote_message;
    case 0x51: ShortQuoteMessage short_quote_message;
    case 0x53: SpecialLongQuoteMessage special_long_quote_message;
    default: UINT8 unknown[available];
  }
} QuoteMessagePayload;

// Quote Messages
typedef struct _QuoteMessage (UINT32 available) where (available >= 1) {
  UINT8 quote_message_type;                                                                                                         // byte 0
  QuoteMessagePayload(quote_message_type, (available - 1)) quote_message_payload[:byte-size-single-element-array (available - 1)];
} QuoteMessage;

// Branch
casetype _CategoryPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: AdministrativeMessage(available) administrative_message;
    case 0x43: ControlMessage(available) control_message;
    case 0x4D: MarketStatusMessage(available) market_status_message;
    case 0x51: QuoteMessage(available) quote_message;
    default: UINT8 unknown[available];
  }
} CategoryPayload;

// Repeating message block
typedef struct _Message {
  UINT16BE message_length { message_length >= 3 };                                                                                                       // bytes 0 to 1
  UINT8 message_category;                                                                                                                                // byte 2
  CategoryPayload(message_category, (((UINT32) message_length) - 3)) category_payload[:byte-size-single-element-array (((UINT32) message_length) - 3)];
} Message;

// Repeating message block
casetype _MessagePart1 (Bool present) {
  switch (present) {
    case true: Message block;
    case false: unit none;
  }
} MessagePart1;

// Repeating message block
typedef struct _MessageBlock2 {
  Message first;
  Message second;
} MessageBlock2;

// Repeating message block
casetype _MessagePart2 (Bool present) {
  switch (present) {
    case true: MessageBlock2 block;
    case false: unit none;
  }
} MessagePart2;

// Repeating message block
typedef struct _MessageBlock4 {
  MessageBlock2 first;
  MessageBlock2 second;
} MessageBlock4;

// Repeating message block
casetype _MessagePart4 (Bool present) {
  switch (present) {
    case true: MessageBlock4 block;
    case false: unit none;
  }
} MessagePart4;

// Repeating message block
typedef struct _MessageBlock8 {
  MessageBlock4 first;
  MessageBlock4 second;
} MessageBlock8;

// Repeating message block
casetype _MessagePart8 (Bool present) {
  switch (present) {
    case true: MessageBlock8 block;
    case false: unit none;
  }
} MessagePart8;

// Repeating message block
typedef struct _MessageBlock16 {
  MessageBlock8 first;
  MessageBlock8 second;
} MessageBlock16;

// Repeating message block
casetype _MessagePart16 (Bool present) {
  switch (present) {
    case true: MessageBlock16 block;
    case false: unit none;
  }
} MessagePart16;

// Repeating message block
typedef struct _MessageBlock32 {
  MessageBlock16 first;
  MessageBlock16 second;
} MessageBlock32;

// Repeating message block
casetype _MessagePart32 (Bool present) {
  switch (present) {
    case true: MessageBlock32 block;
    case false: unit none;
  }
} MessagePart32;

// Repeating message block
typedef struct _MessageBlock64 {
  MessageBlock32 first;
  MessageBlock32 second;
} MessageBlock64;

// Repeating message block
casetype _MessagePart64 (Bool present) {
  switch (present) {
    case true: MessageBlock64 block;
    case false: unit none;
  }
} MessagePart64;

// Repeating message block
typedef struct _MessageBlock128 {
  MessageBlock64 first;
  MessageBlock64 second;
} MessageBlock128;

// Repeating message block
casetype _MessagePart128 (Bool present) {
  switch (present) {
    case true: MessageBlock128 block;
    case false: unit none;
  }
} MessagePart128;

// Repeating message block
typedef struct _MessageCounted (UINT32 count) {
  MessagePart128(((count & 128) != 0)) part128;
  MessagePart64(((count & 64) != 0)) part64;
  MessagePart32(((count & 32) != 0)) part32;
  MessagePart16(((count & 16) != 0)) part16;
  MessagePart8(((count & 8) != 0)) part8;
  MessagePart4(((count & 4) != 0)) part4;
  MessagePart2(((count & 2) != 0)) part2;
  MessagePart1(((count & 1) != 0)) part1;
} MessageCounted;

// ---- Packet: Packet ----------------------------------------------------------

// Cta Udp Packet
entrypoint typedef struct _Packet {
  UINT8 version;                                         // byte 0
  UINT16BE block_size;                                   // bytes 1 to 2
  UINT8 data_feed_indicator;                             // byte 3
  UINT8 retransmission_indicator;                        // byte 4
  UINT32BE block_sequence_number;                        // bytes 5 to 8
  UINT8 messages_in_block;                               // byte 9
  SipBlockTimestamp sip_block_timestamp;                 // bytes 10 to 17
  UINT16BE block_checksum;                               // bytes 18 to 19
  MessageCounted(((UINT32) messages_in_block)) message;
  UINT8 block_pad_byte[:consume-all];
} Packet;

