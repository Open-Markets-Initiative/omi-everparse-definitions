  UINT8 data_feed_indicator;              // byte 3
  UINT8 retransmission_indicator;         // byte 4
  UINT32BE block_sequence_number;         // bytes 5 to 8
  UINT8 messages_in_block;                // byte 9
  SipBlockTimestamp sip_block_timestamp;  // bytes 10 to 17
  UINT16BE block_checksum;                // bytes 18 to 19
} BlockHeader;

