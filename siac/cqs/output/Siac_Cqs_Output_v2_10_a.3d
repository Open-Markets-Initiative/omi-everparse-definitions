  UINT8 market_wide_circuit_breaker_level_indicator;  // byte 22
  UINT8 reserved;                                     // byte 23
} MarketWideCircuitBreakerStatusMessage;

// Branch
casetype _MarketStatusMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
