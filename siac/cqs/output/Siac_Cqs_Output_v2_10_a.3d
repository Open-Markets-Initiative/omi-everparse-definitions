// Reports quote data for a CTA eligible Equity, Local Issue or Bonds, including trading suspensions, price indications and trading range indications
typedef struct _LongQuoteMessage {
  UINT8 participant_id;                                                                                                                                                                   // byte 0
  Timestamp1 timestamp_1;                                                                                                                                                                 // bytes 1 to 8
  UINT8 message_id;                                                                                                                                                                       // byte 9
  UINT32BE transaction_id;                                                                                                                                                                // bytes 10 to 13
  UINT64BE participant_reference_number;                                                                                                                                                  // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                                                                                                                                                              // bytes 22 to 32
  UINT8 instrument_type;                                                                                                                                                                  // byte 33
  UINT8 quote_condition;                                                                                                                                                                  // byte 34
  UINT8 security_status_indicator;                                                                                                                                                        // byte 35
  UINT64BE bid_price_lower_limit_price_band;                                                                                                                                              // bytes 36 to 43
  UINT32BE bid_size_long;                                                                                                                                                                 // bytes 44 to 47
  UINT64BE offer_price_upper_limit_price_band;                                                                                                                                            // bytes 48 to 55
  UINT32BE offer_size_long;                                                                                                                                                               // bytes 56 to 59
  UINT8 retail_interest_indicator;                                                                                                                                                        // byte 60
  UINT8 settlement_condition;                                                                                                                                                             // byte 61
  UINT8 market_condition;                                                                                                                                                                 // byte 62
  UINT8 finra_market_maker_id[4];                                                                                                                                                         // bytes 63 to 66
  UINT8 finra_bbo_indicator;                                                                                                                                                              // byte 67
  Timestamp2 timestamp_2;                                                                                                                                                                 // bytes 68 to 75
  UINT8 short_sale_restriction_indicator;                                                                                                                                                 // byte 76
  UINT8 primary_listing_market_participant_id;                                                                                                                                            // byte 77
  UINT8 financial_status_indicator;                                                                                                                                                       // byte 78
  UINT8 sip_generated_message_identifier;                                                                                                                                                 // byte 79
  UINT8 limit_up_limit_down_luld_indicator;                                                                                                                                               // byte 80
  UINT8 national_bbo_luld_indicator;                                                                                                                                                      // byte 81
  UINT8 national_bbo_indicator;                                                                                                                                                           // byte 82
  OptionalNationalBestBidLongAppendage((((national_bbo_indicator == 0x51) || (national_bbo_indicator == 0x53)) || (national_bbo_indicator == 0x57))) national_best_bid_long_appendage;
  OptionalNationalBestOfferLongAppendage(((national_bbo_indicator == 0x49) || (national_bbo_indicator == 0x4E))) national_best_offer_long_appendage;
  OptionalNationalBestBidAndOfferLongAppendage((national_bbo_indicator == 0x55)) national_best_bid_and_offer_long_appendage;
  OptionalNationalBestBidShortAppendage((((national_bbo_indicator == 0x50) || (national_bbo_indicator == 0x52)) || (national_bbo_indicator == 0x56))) national_best_bid_short_appendage;
  OptionalNationalBestOfferShortAppendage(((national_bbo_indicator == 0x48) || (national_bbo_indicator == 0x4D))) national_best_offer_short_appendage;
  OptionalNationalBestBidAndOfferShortAppendage((national_bbo_indicator == 0x54)) national_best_bid_and_offer_short_appendage;
} LongQuoteMessage;

// Reports Bid and Offer quote information for CTA eligible Equity only if the quote meets all criteria and message format requirements
typedef struct _ShortQuoteMessage {
  UINT8 participant_id;                                                                                                                                                                   // byte 0
  Timestamp1 timestamp_1;                                                                                                                                                                 // bytes 1 to 8
  UINT8 message_id;                                                                                                                                                                       // byte 9
  UINT32BE transaction_id;                                                                                                                                                                // bytes 10 to 13
  UINT64BE participant_reference_number;                                                                                                                                                  // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                                                                                                                                                              // bytes 22 to 32
  UINT16BE bid_price_short;                                                                                                                                                               // bytes 33 to 34
  UINT16BE bid_size_short;                                                                                                                                                                // bytes 35 to 36
  UINT16BE offer_price_short;                                                                                                                                                             // bytes 37 to 38
  UINT16BE offer_size_short;                                                                                                                                                              // bytes 39 to 40
  UINT8 primary_listing_market_participant_id;                                                                                                                                            // byte 41
  UINT8 national_bbo_indicator;                                                                                                                                                           // byte 42
  OptionalNationalBestBidLongAppendage((((national_bbo_indicator == 0x51) || (national_bbo_indicator == 0x53)) || (national_bbo_indicator == 0x57))) national_best_bid_long_appendage;
  OptionalNationalBestOfferLongAppendage(((national_bbo_indicator == 0x49) || (national_bbo_indicator == 0x4E))) national_best_offer_long_appendage;
  OptionalNationalBestBidAndOfferLongAppendage((national_bbo_indicator == 0x55)) national_best_bid_and_offer_long_appendage;
  OptionalNationalBestBidShortAppendage((((national_bbo_indicator == 0x50) || (national_bbo_indicator == 0x52)) || (national_bbo_indicator == 0x56))) national_best_bid_short_appendage;
  OptionalNationalBestOfferShortAppendage(((national_bbo_indicator == 0x48) || (national_bbo_indicator == 0x4D))) national_best_offer_short_appendage;
  OptionalNationalBestBidAndOfferShortAppendage((national_bbo_indicator == 0x54)) national_best_bid_and_offer_short_appendage;
} ShortQuoteMessage;

// Used only by FINRA to report the FINRA Best Bid and FINRA Best Offer for their Market Makers for CTA eligible Equity, Local Issue or Bond information inclusive of changes to any existing FINRA BBO
typedef struct _SpecialLongQuoteMessage {
  UINT8 participant_id;                                                                                                                                                                   // byte 0
  Timestamp1 timestamp_1;                                                                                                                                                                 // bytes 1 to 8
  UINT8 message_id;                                                                                                                                                                       // byte 9
  UINT32BE transaction_id;                                                                                                                                                                // bytes 10 to 13
  UINT64BE participant_reference_number;                                                                                                                                                  // bytes 14 to 21, signed, read here as unsigned
  UINT8 security_symbol[11];                                                                                                                                                              // bytes 22 to 32
  UINT8 instrument_type;                                                                                                                                                                  // byte 33
  UINT8 quote_condition;                                                                                                                                                                  // byte 34
  UINT8 security_status_indicator;                                                                                                                                                        // byte 35
  UINT64BE bid_price_long;                                                                                                                                                                // bytes 36 to 43
  UINT32BE bid_size_long;                                                                                                                                                                 // bytes 44 to 47
  UINT64BE offer_price_long;                                                                                                                                                              // bytes 48 to 55
  UINT32BE offer_size_long;                                                                                                                                                               // bytes 56 to 59
  UINT8 retail_interest_indicator;                                                                                                                                                        // byte 60
  UINT8 settlement_condition;                                                                                                                                                             // byte 61
  UINT8 market_condition;                                                                                                                                                                 // byte 62
  UINT8 finra_market_maker_id[4];                                                                                                                                                         // bytes 63 to 66
  UINT8 finra_best_bid_quote_condition;                                                                                                                                                   // byte 67
  UINT64BE finra_best_bid_price;                                                                                                                                                          // bytes 68 to 75
  UINT32BE finra_best_bid_size;                                                                                                                                                           // bytes 76 to 79
  UINT8 finra_best_bid_market_maker_id[4];                                                                                                                                                // bytes 80 to 83
  UINT8 finra_best_offer_quote_condition;                                                                                                                                                 // byte 84
  UINT64BE finra_best_offer_price;                                                                                                                                                        // bytes 85 to 92
  UINT32BE finra_best_offer_size;                                                                                                                                                         // bytes 93 to 96
  UINT8 finra_best_offer_market_maker_id[4];                                                                                                                                              // bytes 97 to 100
  Timestamp2 timestamp_2;                                                                                                                                                                 // bytes 101 to 108
  UINT8 short_sale_restriction_indicator;                                                                                                                                                 // byte 109
  UINT8 primary_listing_market_participant_id;                                                                                                                                            // byte 110
  UINT8 financial_status_indicator;                                                                                                                                                       // byte 111
  UINT8 sip_generated_message_identifier;                                                                                                                                                 // byte 112
  UINT8 finra_bbo_luld_indicator;                                                                                                                                                         // byte 113
  UINT8 national_bbo_luld_indicator;                                                                                                                                                      // byte 114
  UINT8 national_bbo_indicator;                                                                                                                                                           // byte 115
  OptionalNationalBestBidLongAppendage((((national_bbo_indicator == 0x51) || (national_bbo_indicator == 0x53)) || (national_bbo_indicator == 0x57))) national_best_bid_long_appendage;
  OptionalNationalBestOfferLongAppendage(((national_bbo_indicator == 0x49) || (national_bbo_indicator == 0x4E))) national_best_offer_long_appendage;
  OptionalNationalBestBidAndOfferLongAppendage((national_bbo_indicator == 0x55)) national_best_bid_and_offer_long_appendage;
  OptionalNationalBestBidShortAppendage((((national_bbo_indicator == 0x50) || (national_bbo_indicator == 0x52)) || (national_bbo_indicator == 0x56))) national_best_bid_short_appendage;
  OptionalNationalBestOfferShortAppendage(((national_bbo_indicator == 0x48) || (national_bbo_indicator == 0x4D))) national_best_offer_short_appendage;
  OptionalNationalBestBidAndOfferShortAppendage((national_bbo_indicator == 0x54)) national_best_bid_and_offer_short_appendage;
} SpecialLongQuoteMessage;

// Branch
casetype _QuoteMessagePayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: AuctionStatusMessage auction_status_message;
    case 0x4C: LongQuoteMessage long_quote_message;
    case 0x51: ShortQuoteMessage short_quote_message;
    case 0x53: SpecialLongQuoteMessage special_long_quote_message;
    default: UINT8 unknown[available];
  }
} QuoteMessagePayload;

// Quote Category
typedef struct _QuoteMessage (UINT32 available) where (available >= 1) {
  UINT8 quote_message_type;                                                                                                         // byte 0
  QuoteMessagePayload(quote_message_type, (available - 1)) quote_message_payload[:byte-size-single-element-array (available - 1)];
} QuoteMessage;

// Branch
casetype _CategoryPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x41: AdministrativeMessage(available) administrative_message;
    case 0x43: ControlMessage(available) control_message;
    case 0x4D: MarketStatusMessage(available) market_status_message;
    case 0x51: QuoteMessage(available) quote_message;
    default: UINT8 unknown[available];
  }
} CategoryPayload;

// Repeating message block
typedef struct _Message {
  UINT16BE message_length { message_length >= 3 };                                                                                                       // bytes 0 to 1
  UINT8 message_category;                                                                                                                                // byte 2
  CategoryPayload(message_category, (((UINT32) message_length) - 3)) category_payload[:byte-size-single-element-array (((UINT32) message_length) - 3)];
} Message;

// Repeating message block
casetype _MessagePart1 (Bool present) {
  switch (present) {
    case true: Message block;
    case false: unit none;
  }
} MessagePart1;

// Repeating message block
typedef struct _MessageBlock2 {
  Message first;
  Message second;
} MessageBlock2;

// Repeating message block
casetype _MessagePart2 (Bool present) {
  switch (present) {
    case true: MessageBlock2 block;
    case false: unit none;
  }
} MessagePart2;

// Repeating message block
typedef struct _MessageBlock4 {
  MessageBlock2 first;
  MessageBlock2 second;
} MessageBlock4;

// Repeating message block
casetype _MessagePart4 (Bool present) {
  switch (present) {
    case true: MessageBlock4 block;
    case false: unit none;
  }
} MessagePart4;

// Repeating message block
typedef struct _MessageBlock8 {
  MessageBlock4 first;
  MessageBlock4 second;
} MessageBlock8;

// Repeating message block
casetype _MessagePart8 (Bool present) {
  switch (present) {
    case true: MessageBlock8 block;
    case false: unit none;
  }
} MessagePart8;

// Repeating message block
typedef struct _MessageBlock16 {
  MessageBlock8 first;
  MessageBlock8 second;
} MessageBlock16;

// Repeating message block
casetype _MessagePart16 (Bool present) {
  switch (present) {
    case true: MessageBlock16 block;
    case false: unit none;
  }
} MessagePart16;

// Repeating message block
typedef struct _MessageBlock32 {
  MessageBlock16 first;
  MessageBlock16 second;
} MessageBlock32;

// Repeating message block
casetype _MessagePart32 (Bool present) {
  switch (present) {
    case true: MessageBlock32 block;
    case false: unit none;
  }
} MessagePart32;

// Repeating message block
typedef struct _MessageBlock64 {
  MessageBlock32 first;
  MessageBlock32 second;
} MessageBlock64;

// Repeating message block
casetype _MessagePart64 (Bool present) {
  switch (present) {
    case true: MessageBlock64 block;
    case false: unit none;
  }
} MessagePart64;

// Repeating message block
typedef struct _MessageBlock128 {
  MessageBlock64 first;
  MessageBlock64 second;
} MessageBlock128;

// Repeating message block
casetype _MessagePart128 (Bool present) {
  switch (present) {
    case true: MessageBlock128 block;
    case false: unit none;
  }
} MessagePart128;

// Repeating message block
typedef struct _MessageCounted (UINT32 count) {
  MessagePart128(((count & 128) != 0)) part128;
  MessagePart64(((count & 64) != 0)) part64;
  MessagePart32(((count & 32) != 0)) part32;
  MessagePart16(((count & 16) != 0)) part16;
  MessagePart8(((count & 8) != 0)) part8;
  MessagePart4(((count & 4) != 0)) part4;
  MessagePart2(((count & 2) != 0)) part2;
  MessagePart1(((count & 1) != 0)) part1;
} MessageCounted;

// ---- Packet: Packet ----------------------------------------------------------

// Cta Udp Packet
entrypoint typedef struct _Packet {
  UINT8 version;                                         // byte 0
  UINT16BE block_size;                                   // bytes 1 to 2
  UINT8 data_feed_indicator;                             // byte 3
  UINT8 retransmission_indicator;                        // byte 4
  UINT32BE block_sequence_number;                        // bytes 5 to 8
  UINT8 messages_in_block;                               // byte 9
  SIPBlockTimestamp s_i_p_block_timestamp;               // bytes 10 to 17
  UINT16BE block_checksum;                               // bytes 18 to 19
  MessageCounted(((UINT32) messages_in_block)) message;
  UINT8 block_pad_byte[:consume-all];
} Packet;

