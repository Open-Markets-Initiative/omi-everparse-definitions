// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NeeqSecurities_MulticastMarketData_v1_1.3d
//
// What this definition does not state, and the model does:
// - a field read in bits
// - a Conversion rule
// - a field present only on a condition
// - a run counted by a field
// - a length prefix framing what follows
// - a Integrity rule
// - the packet as a whole, which is padding to a boundary from a position that is not fixed, at packet.packetheader.padding

// ---- Values ------------------------------------------------------------------

// Msg Type: 4 byte code
#define MSG_TYPE_CHANNEL_HEARTBEAT_MESSAGE 0x000497C8                    // Channel Heartbeat Message
#define MSG_TYPE_RETRANSMISSION_MESSAGE 0x00049BB0                       // Retransmission Message
#define MSG_TYPE_SNAPSHOT_CHANNEL_STATISTICS_MESSAGE 0x00049F98          // Snapshot Channel Statistics Message
#define MSG_TYPE_BUSINESS_REJECT_MESSAGE 0x00000008                      // Business Reject Message
#define MSG_TYPE_SECURITY_REAL_TIME_STATUS_MESSAGE 0x0004A380            // Security Real Time Status Message
#define MSG_TYPE_ANNOUNCEMENT_MESSAGE 0x0004A768                         // Announcement Message
#define MSG_TYPE_BOND_SPOT_TRADING_SNAPSHOT_MESSAGE 0x0004AB51           // Bond Spot Trading Snapshot Message
#define MSG_TYPE_AUCTION_TRADING_SNAPSHOT_MESSAGE 0x0004AB52             // Auction Trading Snapshot Message
#define MSG_TYPE_INDEX_SNAPSHOT_MESSAGE 0x0004AB53                       // Index Snapshot Message
#define MSG_TYPE_BOND_SPOT_MATCHING_LARGE_ORDER_TICK_MESSAGE 0x0004AF43  // Bond Spot Matching Large Order Tick Message
#define MSG_TYPE_AGREEMENT_TRADING_ORDER_TICK_MESSAGE 0x0004AF4D         // Agreement Trading Order Tick Message
#define MSG_TYPE_SECURITIES_LENDING_ORDER_TICK_MESSAGE 0x0004AF4F        // Securities Lending Order Tick Message
#define MSG_TYPE_BOND_SPOT_MATCHING_LARGE_TRADE_TICK_MESSAGE 0x0004B32B  // Bond Spot Matching Large Trade Tick Message
#define MSG_TYPE_BOND_SPOT_NEGOTIATED_TRADE_TICK_MESSAGE 0x0004B32C      // Bond Spot Negotiated Trade Tick Message
#define MSG_TYPE_SECURITIES_LENDING_TRADE_TICK_MESSAGE 0x0004B337        // Securities Lending Trade Tick Message

// End Of Channel: 2 byte code
#define END_OF_CHANNEL_NO 0x0000   // No
#define END_OF_CHANNEL_YES 0x0001  // Yes

// Resend Type: one byte code
#define RESEND_TYPE_TICK_DATA 0x01     // Tick Data
#define RESEND_TYPE_ANNOUNCEMENT 0x02  // Announcement

// Resend Status: one byte code
#define RESEND_STATUS_COMPLETE 0x01            // Complete
#define RESEND_STATUS_PARTIALLY_COMPLETE 0x02  // Partially Complete
#define RESEND_STATUS_NO_PERMISSION 0x03       // No Permission
#define RESEND_STATUS_DATA_UNAVAILABLE 0x04    // Data Unavailable

// Side: one byte code
#define SIDE_BUY 0x31     // Buy
#define SIDE_SELL 0x32    // Sell
#define SIDE_BORROW 0x47  // Borrow
#define SIDE_LEND 0x46    // Lend

// Ord Type: one byte code
#define ORD_TYPE_MARKET 0x31         // Market
#define ORD_TYPE_LIMIT 0x32          // Limit
#define ORD_TYPE_BEST_OWN_SIDE 0x55  // Best Own Side

// Settl Type: one byte code
#define SETTL_TYPE_GROSS 0x31             // Gross
#define SETTL_TYPE_MULTILATERAL_NET 0x32  // Multilateral Net

// Settl Period: one byte code
#define SETTL_PERIOD_T_PLUS_0 0x30  // T Plus 0
#define SETTL_PERIOD_T_PLUS_1 0x31  // T Plus 1
#define SETTL_PERIOD_T_PLUS_2 0x32  // T Plus 2
#define SETTL_PERIOD_T_PLUS_3 0x33  // T Plus 3

// Expiration Type: one byte code
#define EXPIRATION_TYPE_FIXED_TERM 0x01  // Fixed Term

// Exec Type: one byte code
#define EXEC_TYPE_CANCELLED 0x34  // Cancelled
#define EXEC_TYPE_TRADE 0x46      // Trade

// ---- Message Header: 8 bytes -------------------------------------------------

// Bjse Binary message header, defining the type and body length of a message
entrypoint typedef struct _MessageHeader {
  UINT32BE msg_type;     // bytes 0 to 3, values MSG_TYPE_
  UINT32BE body_length;  // bytes 4 to 7
} MessageHeader;

// ---- Channel Heartbeat Message: 20 bytes -------------------------------------

// Sent on a market data channel every 3 seconds, carrying the sequence number of the last tick message on the channel.
entrypoint typedef struct _ChannelHeartbeatMessage {
  UINT16BE channel_no;         // bytes 0 to 1
  UINT64BE appl_last_seq_num;  // bytes 2 to 9, signed, read here as unsigned
  UINT16BE end_of_channel;     // bytes 10 to 11, values END_OF_CHANNEL_
  UINT64BE orig_time;          // bytes 12 to 19, signed, read here as unsigned
} ChannelHeartbeatMessage;

// ---- Retransmission Message: 52 bytes ----------------------------------------

// Sent by the Vendor Supplied System to request tick data or announcements again; the gateway returns the data and then the same message type to mark the retransmission complete or report why it failed, so both sides transmit this message type.
entrypoint typedef struct _RetransmissionMessage {
  UINT8 resend_type;          // byte 0, values RESEND_TYPE_
  UINT16BE channel_no;        // bytes 1 to 2
  UINT64BE appl_beg_seq_num;  // bytes 3 to 10, signed, read here as unsigned
  UINT64BE appl_end_seq_num;  // bytes 11 to 18, signed, read here as unsigned
  UINT8 news_id[16];          // bytes 19 to 34
  UINT8 resend_status;        // byte 35, values RESEND_STATUS_
  UINT8 reject_text[16];      // bytes 36 to 51
} RetransmissionMessage;

// ---- Business Reject Message: 74 bytes ---------------------------------------

// Rejects an application message that satisfies the session layer rules but not the business layer rules, mainly an invalid retransmission request.
entrypoint typedef struct _BusinessRejectMessage {
  UINT64BE ref_seq_num;              // bytes 0 to 7, signed, read here as unsigned
  UINT32BE ref_msg_type;             // bytes 8 to 11
  UINT8 business_reject_ref_id[10];  // bytes 12 to 21
  UINT16BE business_reject_reason;   // bytes 22 to 23
  UINT8 business_reject_text[50];    // bytes 24 to 73
} BusinessRejectMessage;

// ---- Bond Spot Matching Large Order Tick Message: 53 bytes -------------------

// Order tick of large lot matching in spot bond trading, market data category 011, published in real time.
entrypoint typedef struct _BondSpotMatchingLargeOrderTickMessage {
  UINT16BE channel_no;          // bytes 0 to 1
  UINT64BE appl_seq_num;        // bytes 2 to 9, signed, read here as unsigned
  UINT8 md_stream_id[3];        // bytes 10 to 12
  UINT8 security_id[8];         // bytes 13 to 20
  UINT8 security_id_source[4];  // bytes 21 to 24
  UINT64BE price;               // bytes 25 to 32, signed, read here as unsigned
  UINT64BE order_qty;           // bytes 33 to 40, signed, read here as unsigned
  UINT8 side;                   // byte 41, values SIDE_
  UINT64BE transact_time;       // bytes 42 to 49, signed, read here as unsigned
  UINT8 ord_type;               // byte 50, values ORD_TYPE_
  UINT8 settl_type;             // byte 51, values SETTL_TYPE_
  UINT8 settl_period;           // byte 52, values SETTL_PERIOD_
} BondSpotMatchingLargeOrderTickMessage;

// ---- Agreement Trading Order Tick Message: 54 bytes --------------------------

// Order tick of agreement trading on the trading support platform, market data category 021, published in real time; not yet enabled.
entrypoint typedef struct _AgreementTradingOrderTickMessage {
  UINT16BE channel_no;          // bytes 0 to 1
  UINT64BE appl_seq_num;        // bytes 2 to 9, signed, read here as unsigned
  UINT8 md_stream_id[3];        // bytes 10 to 12
  UINT8 security_id[8];         // bytes 13 to 20
  UINT8 security_id_source[4];  // bytes 21 to 24
  UINT64BE price;               // bytes 25 to 32, signed, read here as unsigned
  UINT64BE order_qty;           // bytes 33 to 40, signed, read here as unsigned
  UINT8 side;                   // byte 41, values SIDE_
  UINT64BE transact_time;       // bytes 42 to 49, signed, read here as unsigned
  UINT32BE confirm_id;          // bytes 50 to 53
} AgreementTradingOrderTickMessage;

// ---- Securities Lending Order Tick Message: 53 bytes -------------------------

