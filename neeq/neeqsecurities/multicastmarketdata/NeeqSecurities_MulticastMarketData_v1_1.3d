  UINT8 md_stream_id[3];        // bytes 10 to 12
  UINT8 security_id[8];         // bytes 13 to 20
  UINT8 security_id_source[4];  // bytes 21 to 24
  UINT64BE price;               // bytes 25 to 32, signed, read here as unsigned
  UINT64BE order_qty;           // bytes 33 to 40, signed, read here as unsigned
  UINT8 side;                   // byte 41, values SIDE_
  UINT64BE transact_time;       // bytes 42 to 49, signed, read here as unsigned
  UINT16BE expiration_days;     // bytes 50 to 51
  UINT8 expiration_type;        // byte 52, values EXPIRATION_TYPE_
} SecuritiesLendingOrderTickMessage;

// ---- Bond Spot Matching Large Trade Tick Message: 76 bytes -------------------

// Trade tick of large lot matching in spot bond trading, market data category 011, published in real time.
entrypoint typedef struct _BondSpotMatchingLargeTradeTickMessage {
  UINT16BE channel_no;          // bytes 0 to 1
  UINT64BE appl_seq_num;        // bytes 2 to 9, signed, read here as unsigned
  UINT8 md_stream_id[3];        // bytes 10 to 12
  UINT8 security_id[8];         // bytes 13 to 20
  UINT8 security_id_source[4];  // bytes 21 to 24
  UINT64BE bid_appl_seq_num;    // bytes 25 to 32, signed, read here as unsigned
  UINT64BE ask_appl_seq_num;    // bytes 33 to 40, signed, read here as unsigned
  UINT64BE trade_price;         // bytes 41 to 48, signed, read here as unsigned
  UINT64BE trade_qty;           // bytes 49 to 56, signed, read here as unsigned
  UINT64BE trade_money;         // bytes 57 to 64, signed, read here as unsigned
  UINT8 exec_type;              // byte 65, values EXEC_TYPE_
  UINT64BE transact_time;       // bytes 66 to 73, signed, read here as unsigned
  UINT8 settl_period;           // byte 74, values SETTL_PERIOD_
  UINT8 settl_type;             // byte 75, values SETTL_TYPE_
} BondSpotMatchingLargeTradeTickMessage;

