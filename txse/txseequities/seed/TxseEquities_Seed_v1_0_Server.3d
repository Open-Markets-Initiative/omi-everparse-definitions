  UINT64 order_id;                                                                                                                       // bytes 10 to 17, signed, read here as unsigned
  UINT64 cl_ord_id;                                                                                                                      // bytes 18 to 25, signed, read here as unsigned
  UINT64 orig_cl_ord_id;                                                                                                                 // bytes 26 to 33, signed, read here as unsigned
  UINT16 side : 3;                                                                                                                       // bytes 34 to 35
  UINT16 is_locate_required : 1;                                                                                                         // bytes 34 to 35
  UINT16 is_iso : 1;                                                                                                                     // bytes 34 to 35
  UINT16 is_post_only : 1;                                                                                                               // bytes 34 to 35
  UINT16 cancel_at_entry_if_crossed : 1;                                                                                                 // bytes 34 to 35
  UINT16 reserved_9 : 9;                                                                                                                 // bytes 34 to 35
  UINT32 leaves_qty;                                                                                                                     // bytes 36 to 39, signed, read here as unsigned
  OptionalOrderReplacedPrice((has_order_replaced_price == 1)) order_replaced_price;
  OptionalOrderReplacedOrderQty((has_order_replaced_order_qty == 1)) order_replaced_order_qty;
  OptionalOrderReplacedMaxFloorQty((has_order_replaced_max_floor_qty == 1)) order_replaced_max_floor_qty;
  OptionalOrderReplacedSelfMatchScope((has_order_replaced_self_match_scope == 1)) order_replaced_self_match_scope;
  OptionalOrderReplacedSelfMatchInstruction((has_order_replaced_self_match_instruction == 1)) order_replaced_self_match_instruction;
  OptionalOrderReplacedPriceSlideInstruction((has_order_replaced_price_slide_instruction == 1)) order_replaced_price_slide_instruction;
  OptionalOrderReplacedReferencePriceTarget((has_order_replaced_reference_price_target == 1)) order_replaced_reference_price_target;
  OptionalOrderReplacedLocateBroker((has_order_replaced_locate_broker == 1)) order_replaced_locate_broker;
  OptionalOrderReplacedRankPrice((has_order_replaced_rank_price == 1)) order_replaced_rank_price;
  OptionalOrderReplacedDisplayPrice((has_order_replaced_display_price == 1)) order_replaced_display_price;
} OrderReplacedMessage;

