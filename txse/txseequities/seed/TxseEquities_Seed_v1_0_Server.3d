// The submitted limit order has been rejected by the Exchange.
typedef struct _LimitOrderRejectedMessage {
  UINT32 has_limit_order_rejected_self_match_scope : 1;                                                                                                     // bytes 0 to 3
  UINT32 has_limit_order_rejected_self_match_instruction : 1;                                                                                               // bytes 0 to 3
  UINT32 has_limit_order_rejected_price_slide_instruction : 1;                                                                                              // bytes 0 to 3
  UINT32 has_limit_order_rejected_min_qty : 1;                                                                                                              // bytes 0 to 3
  UINT32 has_limit_order_rejected_max_floor_qty : 1;                                                                                                        // bytes 0 to 3
  UINT32 has_limit_order_rejected_max_replenish_qty_range : 1;                                                                                              // bytes 0 to 3
  UINT32 has_limit_order_rejected_max_replenish_time_range : 1;                                                                                             // bytes 0 to 3
  UINT32 has_limit_order_rejected_reference_price_target : 1;                                                                                               // bytes 0 to 3
  UINT32 has_limit_order_rejected_expire_time : 1;                                                                                                          // bytes 0 to 3
  UINT32 has_limit_order_rejected_user_data : 1;                                                                                                            // bytes 0 to 3
  UINT32 has_limit_order_rejected_mpid : 1;                                                                                                                 // bytes 0 to 3
  UINT32 has_limit_order_rejected_member_group : 1;                                                                                                         // bytes 0 to 3
  UINT32 has_limit_order_rejected_locate_broker : 1;                                                                                                        // bytes 0 to 3
  UINT32 reserved_19 : 19;                                                                                                                                  // bytes 0 to 3
  UINT64 transact_time;                                                                                                                                     // bytes 4 to 11, signed, read here as unsigned
  UINT64 cl_ord_id;                                                                                                                                         // bytes 12 to 19, signed, read here as unsigned
  UINT32 order_qty;                                                                                                                                         // bytes 20 to 23, signed, read here as unsigned
  UINT32 side : 3;                                                                                                                                          // bytes 24 to 27
  UINT32 is_locate_required : 1;                                                                                                                            // bytes 24 to 27
  UINT32 time_in_force : 4;                                                                                                                                 // bytes 24 to 27
  UINT32 order_capacity : 3;                                                                                                                                // bytes 24 to 27
  UINT32 is_iso : 1;                                                                                                                                        // bytes 24 to 27
  UINT32 is_hidden : 1;                                                                                                                                     // bytes 24 to 27
  UINT32 is_post_only : 1;                                                                                                                                  // bytes 24 to 27
  UINT32 cancel_at_entry_if_crossed : 1;                                                                                                                    // bytes 24 to 27
  UINT32 reserved_17 : 17;                                                                                                                                  // bytes 24 to 27
  UINT16 symbol_id;                                                                                                                                         // bytes 28 to 29, signed, read here as unsigned
  UINT64 price;                                                                                                                                             // bytes 30 to 37, signed, read here as unsigned
  UINT8 limit_order_rejected_reason;                                                                                                                        // byte 38, signed, read here as unsigned
  OptionalLimitOrderRejectedSelfMatchScope((has_limit_order_rejected_self_match_scope == 1)) limit_order_rejected_self_match_scope;
  OptionalLimitOrderRejectedSelfMatchInstruction((has_limit_order_rejected_self_match_instruction == 1)) limit_order_rejected_self_match_instruction;
  OptionalLimitOrderRejectedPriceSlideInstruction((has_limit_order_rejected_price_slide_instruction == 1)) limit_order_rejected_price_slide_instruction;
  OptionalLimitOrderRejectedMinQty((has_limit_order_rejected_min_qty == 1)) limit_order_rejected_min_qty;
  OptionalLimitOrderRejectedMaxFloorQty((has_limit_order_rejected_max_floor_qty == 1)) limit_order_rejected_max_floor_qty;
  OptionalLimitOrderRejectedMaxReplenishQtyRange((has_limit_order_rejected_max_replenish_qty_range == 1)) limit_order_rejected_max_replenish_qty_range;
  OptionalLimitOrderRejectedMaxReplenishTimeRange((has_limit_order_rejected_max_replenish_time_range == 1)) limit_order_rejected_max_replenish_time_range;
  OptionalLimitOrderRejectedReferencePriceTarget((has_limit_order_rejected_reference_price_target == 1)) limit_order_rejected_reference_price_target;
  OptionalLimitOrderRejectedExpireTime((has_limit_order_rejected_expire_time == 1)) limit_order_rejected_expire_time;
  OptionalLimitOrderRejectedUserData((has_limit_order_rejected_user_data == 1)) limit_order_rejected_user_data;
  OptionalLimitOrderRejectedMpid((has_limit_order_rejected_mpid == 1)) limit_order_rejected_mpid;
  OptionalLimitOrderRejectedMemberGroup((has_limit_order_rejected_member_group == 1)) limit_order_rejected_member_group;
