#define MESSAGE_TYPE_ORDER_REPLACED_MESSAGE 0x4A          // Order Replaced Message
#define MESSAGE_TYPE_REPLACE_REJECTED_MESSAGE 0x4B        // Replace Rejected Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45          // Order Executed Message
#define MESSAGE_TYPE_ORDER_RESTATED_MESSAGE 0x46          // Order Restated Message
#define MESSAGE_TYPE_SELF_MATCH_PREVENTED_MESSAGE 0x5A    // Self Match Prevented Message
#define MESSAGE_TYPE_MASS_CANCEL_ACCEPTED_MESSAGE 0x4F    // Mass Cancel Accepted Message
#define MESSAGE_TYPE_MASS_CANCEL_REJECTED_MESSAGE 0x50    // Mass Cancel Rejected Message
#define MESSAGE_TYPE_MASS_CANCEL_RESULT_MESSAGE 0x51      // Mass Cancel Result Message

