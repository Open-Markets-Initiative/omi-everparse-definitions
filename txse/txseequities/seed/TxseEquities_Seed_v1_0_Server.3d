// Enum LiquidityIndicator. Added in 0.14.draft; absent in pre-0.14 senders, so it is a length-tolerant trailing field - present only when the frame extends past the preceding fields.
casetype _OptionalLiquidityIndicator (Bool present) {
  switch (present) {
    case true: UINT8 liquidity_indicator;
    case false: unit absent;
  }
} OptionalLiquidityIndicator;

// An order has executed.
typedef struct _OrderExecutedMessage (UINT32 available) where (available >= 48) {
  UINT64 transact_time;                                                    // bytes 0 to 7, signed, read here as unsigned
  UINT64 order_id;                                                         // bytes 8 to 15, signed, read here as unsigned
  UINT64 cl_ord_id;                                                        // bytes 16 to 23, signed, read here as unsigned
  UINT64 exec_price;                                                       // bytes 24 to 31, signed, read here as unsigned
  UINT64 exec_id;                                                          // bytes 32 to 39, signed, read here as unsigned
  UINT32 exec_qty;                                                         // bytes 40 to 43, signed, read here as unsigned
  UINT32 leaves_qty;                                                       // bytes 44 to 47, signed, read here as unsigned
  OptionalLiquidityIndicator(((available - 48) > 0)) liquidity_indicator;
} OrderExecutedMessage;

