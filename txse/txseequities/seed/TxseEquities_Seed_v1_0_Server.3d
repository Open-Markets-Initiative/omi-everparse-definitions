// Texas Stock Exchange Session Enabled Entry Daemon
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out TxseEquities_Seed_v1_0_Server.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - a length prefix framing what follows
// - a field read in bits
// - a field present only on a condition
//
// License: MIT No Attribution

// ---- Rake Message Header: 3 bytes --------------------------------------------

// Rake Tcp per-message header carrying the frame length and packet-level dispatch byte
entrypoint typedef struct _RakeMessageHeader {
  UINT16 message_length;  // bytes 0 to 1
  UINT8 packet_type;      // byte 2
} RakeMessageHeader;

// ---- Logon Response Message: 30 bytes ----------------------------------------

// Response to a logon request
entrypoint typedef struct _LogonResponseMessage {
  UINT64 session;                        // bytes 0 to 7
  UINT64 next_sequence_number;           // bytes 8 to 15
  UINT64 highest_known_sequence_number;  // bytes 16 to 23
  UINT8 logon_response_code;             // byte 24
  UINT8 number_stream_ids;               // byte 25
  UINT32 instance_;                      // bytes 26 to 29
} LogonResponseMessage;

// ---- Order Canceled Message: 25 bytes ----------------------------------------

// This order has been canceled. No shares are left on the Exchange. The Member will receive this message in response to a CancelOrder message, as well as unsolicited messages from the Exchange for various reasons.
entrypoint typedef struct _OrderCanceledMessage {
  UINT64 transact_time;   // bytes 0 to 7, signed, read here as unsigned
  UINT64 order_id;        // bytes 8 to 15, signed, read here as unsigned
  UINT64 orig_cl_ord_id;  // bytes 16 to 23, signed, read here as unsigned
  UINT8 cancel_reason;    // byte 24, signed, read here as unsigned
} OrderCanceledMessage;

// ---- Cancel Rejected Message: 17 bytes ---------------------------------------

// The requested CancelOrder has been rejected.
entrypoint typedef struct _CancelRejectedMessage {
  UINT64 transact_time;          // bytes 0 to 7, signed, read here as unsigned
  UINT64 orig_cl_ord_id;         // bytes 8 to 15, signed, read here as unsigned
  UINT8 cancel_rejected_reason;  // byte 16, signed, read here as unsigned
} CancelRejectedMessage;

// ---- Mass Cancel Result Message: 28 bytes ------------------------------------

// Confirms sweep completion. Sent after all affected orders have been canceled.
entrypoint typedef struct _MassCancelResultMessage {
  UINT64 transact_time;           // bytes 0 to 7, signed, read here as unsigned
  UINT64 mass_cancel_request_id;  // bytes 8 to 15, signed, read here as unsigned
  UINT64 mass_cancel_id;          // bytes 16 to 23, signed, read here as unsigned
  UINT32 canceled_count;          // bytes 24 to 27, signed, read here as unsigned
} MassCancelResultMessage;

