  UINT16 has_order_replaced_locate_broker : 1;                                                                                           // bytes 0 to 1
  UINT16 has_order_replaced_rank_price : 1;                                                                                              // bytes 0 to 1
  UINT16 has_order_replaced_display_price : 1;                                                                                           // bytes 0 to 1
  UINT16 reserved_6 : 6;                                                                                                                 // bytes 0 to 1
