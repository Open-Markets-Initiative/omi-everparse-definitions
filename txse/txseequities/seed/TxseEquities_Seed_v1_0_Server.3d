// Informational message from the Exchange. Sent when the Exchange performs work on the Member's order, such as repricing after entry or a reserve replenishment. For a replenishment, the OrderId refers to the new displayed portion of the order. For a repricing, the OrderId is the new OrderId for the entire order. This message is informational.
typedef struct _OrderRestatedMessage {
  UINT8 has_order_restated_rank_price : 1;                                                                  // byte 0
  UINT8 has_order_restated_display_price : 1;                                                               // byte 0
  UINT8 has_display_qty : 1;                                                                                // byte 0
  UINT8 reserved_5 : 5;                                                                                     // byte 0
  UINT64 transact_time;                                                                                     // bytes 1 to 8, signed, read here as unsigned
  UINT64 order_id;                                                                                          // bytes 9 to 16, signed, read here as unsigned
  UINT64 cl_ord_id;                                                                                         // bytes 17 to 24, signed, read here as unsigned
  UINT8 restatement_reason;                                                                                 // byte 25, signed, read here as unsigned
  OptionalOrderRestatedRankPrice((has_order_restated_rank_price == 1)) order_restated_rank_price;
  OptionalOrderRestatedDisplayPrice((has_order_restated_display_price == 1)) order_restated_display_price;
  OptionalDisplayQty((has_display_qty == 1)) display_qty;
} OrderRestatedMessage;

// Notification that a self-match was detected and prevented according to the order's self-match prevention instructions. The message reports the quantity that would have executed, the quantity that was canceled, and the remaining quantity still active on the book.
typedef struct _SelfMatchPreventedMessage (UINT32 available) where (available >= 52) {
  UINT64 transact_time;                                                    // bytes 0 to 7, signed, read here as unsigned
  UINT64 order_id;                                                         // bytes 8 to 15, signed, read here as unsigned
  UINT64 cl_ord_id;                                                        // bytes 16 to 23, signed, read here as unsigned
  UINT64 exec_price;                                                       // bytes 24 to 31, signed, read here as unsigned
  UINT64 exec_id;                                                          // bytes 32 to 39, signed, read here as unsigned
  UINT32 exec_qty;                                                         // bytes 40 to 43, signed, read here as unsigned
  UINT32 canceled_qty;                                                     // bytes 44 to 47, signed, read here as unsigned
  UINT32 leaves_qty;                                                       // bytes 48 to 51, signed, read here as unsigned
  OptionalLiquidityIndicator(((available - 52) > 0)) liquidity_indicator;
} SelfMatchPreventedMessage;

// Market Participant Identifier.
casetype _OptionalMassCancelAcceptedMpid (Bool present) {
  switch (present) {
    case true: UINT8 mass_cancel_accepted_mpid[4];
    case false: unit absent;
  }
} OptionalMassCancelAcceptedMpid;

// Narrows the cancel to orders entered on the specified order entry port.
casetype _OptionalMassCancelAcceptedSenderComp (Bool present) {
  switch (present) {
    case true: UINT8 mass_cancel_accepted_sender_comp[8];
    case false: unit absent;
  }
} OptionalMassCancelAcceptedSenderComp;

// Member supplied grouping.
casetype _OptionalMassCancelAcceptedMemberGroup (Bool present) {
  switch (present) {
    case true: UINT8 mass_cancel_accepted_member_group[2];
    case false: unit absent;
  }
} OptionalMassCancelAcceptedMemberGroup;

// Scopes the mass cancel to this specific order.
casetype _OptionalMassCancelAcceptedClOrdId (Bool present) {
  switch (present) {
    case true: UINT64 mass_cancel_accepted_cl_ord_id;
    case false: unit absent;
  }
} OptionalMassCancelAcceptedClOrdId;

// The Mass Cancel has been accepted and is being processed.
typedef struct _MassCancelAcceptedMessage {
  UINT8 has_mass_cancel_accepted_mpid : 1;                                                                                // byte 0
  UINT8 has_mass_cancel_accepted_sender_comp : 1;                                                                         // byte 0
  UINT8 has_mass_cancel_accepted_member_group : 1;                                                                        // byte 0
  UINT8 has_mass_cancel_accepted_cl_ord_id : 1;                                                                           // byte 0
  UINT8 reserved_4 : 4;                                                                                                   // byte 0
  UINT64 transact_time;                                                                                                   // bytes 1 to 8, signed, read here as unsigned
  UINT64 mass_cancel_request_id;                                                                                          // bytes 9 to 16, signed, read here as unsigned
  UINT8 mass_cancel_accepted_scope;                                                                                       // byte 17, signed, read here as unsigned
  UINT8 exclude_auction_orders : 1;                                                                                       // byte 18
  UINT8 reserved_7 : 7;                                                                                                   // byte 18
  UINT64 mass_cancel_id;                                                                                                  // bytes 19 to 26, signed, read here as unsigned
  OptionalMassCancelAcceptedMpid((has_mass_cancel_accepted_mpid == 1)) mass_cancel_accepted_mpid;
  OptionalMassCancelAcceptedSenderComp((has_mass_cancel_accepted_sender_comp == 1)) mass_cancel_accepted_sender_comp;
  OptionalMassCancelAcceptedMemberGroup((has_mass_cancel_accepted_member_group == 1)) mass_cancel_accepted_member_group;
  OptionalMassCancelAcceptedClOrdId((has_mass_cancel_accepted_cl_ord_id == 1)) mass_cancel_accepted_cl_ord_id;
} MassCancelAcceptedMessage;

// Market Participant Identifier.
casetype _OptionalMassCancelRejectedMpid (Bool present) {
  switch (present) {
    case true: UINT8 mass_cancel_rejected_mpid[4];
    case false: unit absent;
  }
} OptionalMassCancelRejectedMpid;

// Narrows the cancel to orders entered on the specified order entry port.
casetype _OptionalMassCancelRejectedSenderComp (Bool present) {
  switch (present) {
    case true: UINT8 mass_cancel_rejected_sender_comp[8];
    case false: unit absent;
  }
} OptionalMassCancelRejectedSenderComp;

