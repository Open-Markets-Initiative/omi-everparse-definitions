#define MASS_CANCEL_REJECTED_REASON_INVALID_ORDER_QUANTITY 0x07                 // Invalid Order Quantity
#define MASS_CANCEL_REJECTED_REASON_INVALID_REFERENCE_PRICE_TARGET 0x08         // Invalid Reference Price Target
#define MASS_CANCEL_REJECTED_REASON_INVALID_IS_HIDDEN_FLAG 0x09                 // Invalid Is Hidden Flag
#define MASS_CANCEL_REJECTED_REASON_INVALID_ORDER_TYPE 0x0A                     // Invalid Order Type
#define MASS_CANCEL_REJECTED_REASON_INVALID_SIDE 0x0B                           // Invalid Side
#define MASS_CANCEL_REJECTED_REASON_INVALID_MAX_FLOOR_QUANTITY 0x0C             // Invalid Max Floor Quantity
#define MASS_CANCEL_REJECTED_REASON_INVALID_MAX_REPLENISH_QUANTITY_RANGE 0x0D   // Invalid Max Replenish Quantity Range
#define MASS_CANCEL_REJECTED_REASON_INVALID_MAX_REPLENISH_TIME_RANGE 0x0E       // Invalid Max Replenish Time Range
#define MASS_CANCEL_REJECTED_REASON_INVALID_MINIMUM_QUANTITY 0x0F               // Invalid Minimum Quantity
#define MASS_CANCEL_REJECTED_REASON_INVALID_LOCATE_REQUIRED_FLAG 0x10           // Invalid Locate Required Flag
#define MASS_CANCEL_REJECTED_REASON_INVALID_TIME_IN_FORCE 0x11                  // Invalid Time In Force
#define MASS_CANCEL_REJECTED_REASON_MODIFICATION_NOT_PERMITTED 0x12             // Modification Not Permitted
#define MASS_CANCEL_REJECTED_REASON_INVALID_MPID 0x13                           // Invalid Mpid
#define MASS_CANCEL_REJECTED_REASON_INVALID_SENDER_COMP 0x14                    // Invalid Sender Comp
#define MASS_CANCEL_REJECTED_REASON_INVALID_IS_POST_ONLY_FLAG 0x15              // Invalid Is Post Only Flag
#define MASS_CANCEL_REJECTED_REASON_INVALID_EXPIRE_TIME 0x16                    // Invalid Expire Time
#define MASS_CANCEL_REJECTED_REASON_INVALID_FOR_TRADING_SESSION 0x17            // Invalid For Trading Session
#define MASS_CANCEL_REJECTED_REASON_INVALID_FOR_TRADING_STATUS 0x18             // Invalid For Trading Status
#define MASS_CANCEL_REJECTED_REASON_INVALID_FOR_SYMBOL_STATUS 0x19              // Invalid For Symbol Status
#define MASS_CANCEL_REJECTED_REASON_INVALID_IS_ISO_FLAG 0x1A                    // Invalid Is Iso Flag
#define MASS_CANCEL_REJECTED_REASON_TRADING_DISABLED_FOR_MPID_ON_PORT 0x1B      // Trading Disabled For Mpid On Port
#define MASS_CANCEL_REJECTED_REASON_TRADING_DISABLED_FOR_NON_TEST_SYMBOLS 0x1C  // Trading Disabled For Non Test Symbols
#define MASS_CANCEL_REJECTED_REASON_TRADING_DISABLED_FOR_ORDER_CAPACITY 0x1D    // Trading Disabled For Order Capacity
#define MASS_CANCEL_REJECTED_REASON_TRADING_DISABLED_FOR_ISO 0x1E               // Trading Disabled For Iso
#define MASS_CANCEL_REJECTED_REASON_MAXIMUM_ORDER_QUANTITY_BREACHED 0x1F        // Maximum Order Quantity Breached
#define MASS_CANCEL_REJECTED_REASON_MAXIMUM_PRICE_BREACHED 0x20                 // Maximum Price Breached
#define MASS_CANCEL_REJECTED_REASON_MAXIMUM_NOTIONAL_BREACHED 0x21              // Maximum Notional Breached
#define MASS_CANCEL_REJECTED_REASON_INVALID_MASS_CANCEL_REQUEST_ID 0x22         // Invalid Mass Cancel Request Id
#define MASS_CANCEL_REJECTED_REASON_SYMBOL_ON_RESTRICTED_LIST 0x23              // Symbol On Restricted List
#define MASS_CANCEL_REJECTED_REASON_LULD_BAND_BREACHED 0x24                     // Luld Band Breached
#define MASS_CANCEL_REJECTED_REASON_INVALID_PRICE_INCREMENT 0x25                // Invalid Price Increment
#define MASS_CANCEL_REJECTED_REASON_AUCTION_ORDER_NOT_CANCELABLE 0x26           // Auction Order Not Cancelable
#define MASS_CANCEL_REJECTED_REASON_INVALID_FOR_AUCTION_ORDER 0x27              // Invalid For Auction Order

// ---- Types -------------------------------------------------------------------

// human readable debug message
typedef struct _DebugMessage (UINT16 message_length) where (message_length >= 1) {
  UINT8 text[(((UINT32) message_length) - 1)];
} DebugMessage;

// Response to a logon request
typedef struct _LogonResponseMessage {
  UINT64 session;                        // bytes 0 to 7
  UINT64 next_sequence_number;           // bytes 8 to 15
  UINT64 highest_known_sequence_number;  // bytes 16 to 23
  UINT8 logon_response_code;             // byte 24
  UINT8 number_stream_ids;               // byte 25
  UINT32 instance_;                      // bytes 26 to 29
} LogonResponseMessage;

// Enum TradingSessionStatusOperationalHaltReason.
casetype _OptionalTradingSessionStatusOperationalHaltReason (Bool present) {
  switch (present) {
    case true: UINT8 trading_session_status_operational_halt_reason;
    case false: unit absent;
  }
} OptionalTradingSessionStatusOperationalHaltReason;

// Enum TradingSessionStatusRegulatoryHaltReason.
casetype _OptionalTradingSessionStatusRegulatoryHaltReason (Bool present) {
  switch (present) {
    case true: UINT8 trading_session_status_regulatory_halt_reason;
    case false: unit absent;
  }
} OptionalTradingSessionStatusRegulatoryHaltReason;

// Market-wide status representing the overall state of the trading session.
typedef struct _TradingSessionStatusMessage {
  UINT8 has_trading_session_status_operational_halt_reason : 1;                                                                                                 // byte 0
  UINT8 has_trading_session_status_regulatory_halt_reason : 1;                                                                                                  // byte 0
  UINT8 reserved_6 : 6;                                                                                                                                         // byte 0
  UINT64 transact_time;                                                                                                                                         // bytes 1 to 8, signed, read here as unsigned
  UINT8 market_hours_state;                                                                                                                                     // byte 9, signed, read here as unsigned
  UINT8 session_trading_state;                                                                                                                                  // byte 10, signed, read here as unsigned
  OptionalTradingSessionStatusOperationalHaltReason((has_trading_session_status_operational_halt_reason == 1)) trading_session_status_operational_halt_reason;
  OptionalTradingSessionStatusRegulatoryHaltReason((has_trading_session_status_regulatory_halt_reason == 1)) trading_session_status_regulatory_halt_reason;
} TradingSessionStatusMessage;

// Enum ListingMarket. Added in 0.20.draft; absent in pre-0.20 senders, so it is a length-tolerant trailing field - present only when the frame extends past lotSize.
casetype _OptionalListingMarket (Bool present) {
  switch (present) {
    case true: UINT8 listing_market;
    case false: unit absent;
  }
} OptionalListingMarket;

// Symbol definition containing instrument details and trading parameters. A DefineSymbol will be followed by a SymbolStatus message establishing the initial trading state for the symbol. Clients must treat a symbol as operationally HALTED while awaiting the accompanying SymbolStatus.
typedef struct _DefineSymbolMessage (UINT32 available) where (available >= 32) {
  UINT64 transact_time;                                          // bytes 0 to 7, signed, read here as unsigned
  UINT16 symbol_id;                                              // bytes 8 to 9, signed, read here as unsigned
  UINT8 symbol[8];                                               // bytes 10 to 17
  UINT8 suffix[8];                                               // bytes 18 to 25
  UINT8 matching_engine_id;                                      // byte 26, signed, read here as unsigned
  UINT8 is_test : 1;                                             // byte 27
  UINT8 reserved_7 : 7;                                          // byte 27
  UINT32 lot_size;                                               // bytes 28 to 31, signed, read here as unsigned
  OptionalListingMarket(((available - 32) > 0)) listing_market;
} DefineSymbolMessage;

// Enum SymbolStatusOperationalHaltReason.
casetype _OptionalSymbolStatusOperationalHaltReason (Bool present) {
  switch (present) {
    case true: UINT8 symbol_status_operational_halt_reason;
    case false: unit absent;
  }
} OptionalSymbolStatusOperationalHaltReason;

// Enum SymbolStatusRegulatoryHaltReason.
casetype _OptionalSymbolStatusRegulatoryHaltReason (Bool present) {
  switch (present) {
    case true: UINT8 symbol_status_regulatory_halt_reason;
    case false: unit absent;
  }
} OptionalSymbolStatusRegulatoryHaltReason;

// Symbol-specific trading status representing the current state and restrictions for an individual security. A SymbolStatus is sent for every symbol, including those that open in the TRADING state. Clients must treat a symbol as operationally HALTED while awaiting the first SymbolStatus. Subsequent SymbolStatus messages are sent whenever the trading state or short-sale restriction changes.
typedef struct _SymbolStatusMessage {
  UINT8 has_symbol_status_operational_halt_reason : 1;                                                                                // byte 0
  UINT8 has_symbol_status_regulatory_halt_reason : 1;                                                                                 // byte 0
  UINT8 reserved_6 : 6;                                                                                                               // byte 0
  UINT64 transact_time;                                                                                                               // bytes 1 to 8, signed, read here as unsigned
  UINT16 symbol_id;                                                                                                                   // bytes 9 to 10, signed, read here as unsigned
  UINT8 symbol_trading_state;                                                                                                         // byte 11, signed, read here as unsigned
  UINT8 short_sale_restriction_state;                                                                                                 // byte 12, signed, read here as unsigned
  OptionalSymbolStatusOperationalHaltReason((has_symbol_status_operational_halt_reason == 1)) symbol_status_operational_halt_reason;
  OptionalSymbolStatusRegulatoryHaltReason((has_symbol_status_regulatory_halt_reason == 1)) symbol_status_regulatory_halt_reason;
} SymbolStatusMessage;

