// Acknowledges acceptance of a submitted LimitOrder.
typedef struct _LimitOrderAcceptedMessage {
  UINT32 has_limit_order_accepted_self_match_scope : 1;                                                                                                     // bytes 0 to 3
  UINT32 has_limit_order_accepted_self_match_instruction : 1;                                                                                               // bytes 0 to 3
  UINT32 has_limit_order_accepted_price_slide_instruction : 1;                                                                                              // bytes 0 to 3
  UINT32 has_limit_order_accepted_min_qty : 1;                                                                                                              // bytes 0 to 3
  UINT32 has_limit_order_accepted_max_floor_qty : 1;                                                                                                        // bytes 0 to 3
  UINT32 has_limit_order_accepted_max_replenish_qty_range : 1;                                                                                              // bytes 0 to 3
  UINT32 has_limit_order_accepted_max_replenish_time_range : 1;                                                                                             // bytes 0 to 3
  UINT32 has_limit_order_accepted_reference_price_target : 1;                                                                                               // bytes 0 to 3
  UINT32 has_limit_order_accepted_expire_time : 1;                                                                                                          // bytes 0 to 3
  UINT32 has_limit_order_accepted_user_data : 1;                                                                                                            // bytes 0 to 3
  UINT32 has_limit_order_accepted_mpid : 1;                                                                                                                 // bytes 0 to 3
  UINT32 has_limit_order_accepted_member_group : 1;                                                                                                         // bytes 0 to 3
  UINT32 has_limit_order_accepted_locate_broker : 1;                                                                                                        // bytes 0 to 3
  UINT32 has_limit_order_accepted_rank_price : 1;                                                                                                           // bytes 0 to 3
  UINT32 has_limit_order_accepted_display_price : 1;                                                                                                        // bytes 0 to 3
  UINT32 reserved_17 : 17;                                                                                                                                  // bytes 0 to 3
  UINT64 transact_time;                                                                                                                                     // bytes 4 to 11, signed, read here as unsigned
  UINT64 order_id;                                                                                                                                          // bytes 12 to 19, signed, read here as unsigned
  UINT64 cl_ord_id;                                                                                                                                         // bytes 20 to 27, signed, read here as unsigned
  UINT32 order_qty;                                                                                                                                         // bytes 28 to 31, signed, read here as unsigned
  UINT32 side : 3;                                                                                                                                          // bytes 32 to 35
  UINT32 is_locate_required : 1;                                                                                                                            // bytes 32 to 35
  UINT32 time_in_force : 4;                                                                                                                                 // bytes 32 to 35
  UINT32 order_capacity : 3;                                                                                                                                // bytes 32 to 35
  UINT32 is_iso : 1;                                                                                                                                        // bytes 32 to 35
  UINT32 is_hidden : 1;                                                                                                                                     // bytes 32 to 35
  UINT32 is_post_only : 1;                                                                                                                                  // bytes 32 to 35
  UINT32 cancel_at_entry_if_crossed : 1;                                                                                                                    // bytes 32 to 35
  UINT32 reserved_17_2 : 17;                                                                                                                                // bytes 32 to 35
  UINT16 symbol_id;                                                                                                                                         // bytes 36 to 37, signed, read here as unsigned
  UINT64 price;                                                                                                                                             // bytes 38 to 45, signed, read here as unsigned
  OptionalLimitOrderAcceptedSelfMatchScope((has_limit_order_accepted_self_match_scope == 1)) limit_order_accepted_self_match_scope;
  OptionalLimitOrderAcceptedSelfMatchInstruction((has_limit_order_accepted_self_match_instruction == 1)) limit_order_accepted_self_match_instruction;
  OptionalLimitOrderAcceptedPriceSlideInstruction((has_limit_order_accepted_price_slide_instruction == 1)) limit_order_accepted_price_slide_instruction;
  OptionalLimitOrderAcceptedMinQty((has_limit_order_accepted_min_qty == 1)) limit_order_accepted_min_qty;
  OptionalLimitOrderAcceptedMaxFloorQty((has_limit_order_accepted_max_floor_qty == 1)) limit_order_accepted_max_floor_qty;
  OptionalLimitOrderAcceptedMaxReplenishQtyRange((has_limit_order_accepted_max_replenish_qty_range == 1)) limit_order_accepted_max_replenish_qty_range;
  OptionalLimitOrderAcceptedMaxReplenishTimeRange((has_limit_order_accepted_max_replenish_time_range == 1)) limit_order_accepted_max_replenish_time_range;
  OptionalLimitOrderAcceptedReferencePriceTarget((has_limit_order_accepted_reference_price_target == 1)) limit_order_accepted_reference_price_target;
  OptionalLimitOrderAcceptedExpireTime((has_limit_order_accepted_expire_time == 1)) limit_order_accepted_expire_time;
  OptionalLimitOrderAcceptedUserData((has_limit_order_accepted_user_data == 1)) limit_order_accepted_user_data;
  OptionalLimitOrderAcceptedMpid((has_limit_order_accepted_mpid == 1)) limit_order_accepted_mpid;
  OptionalLimitOrderAcceptedMemberGroup((has_limit_order_accepted_member_group == 1)) limit_order_accepted_member_group;
  OptionalLimitOrderAcceptedLocateBroker((has_limit_order_accepted_locate_broker == 1)) limit_order_accepted_locate_broker;
  OptionalLimitOrderAcceptedRankPrice((has_limit_order_accepted_rank_price == 1)) limit_order_accepted_rank_price;
  OptionalLimitOrderAcceptedDisplayPrice((has_limit_order_accepted_display_price == 1)) limit_order_accepted_display_price;
} LimitOrderAcceptedMessage;

