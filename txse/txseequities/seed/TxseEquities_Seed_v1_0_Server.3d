#define PACKET_TYPE_LOGON_RESPONSE_MESSAGE 0x31    // Logon Response Message
#define PACKET_TYPE_SERVER_HEARTBEAT_MESSAGE 0x33  // Server Heartbeat Message
#define PACKET_TYPE_TCP_SEQUENCED_MESSAGE 0x32     // Tcp Sequenced Message

// Logon Response Code: one byte code
#define LOGON_RESPONSE_CODE_SUCCESS 0x00                // Success
