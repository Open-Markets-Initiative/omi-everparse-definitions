casetype _OptionalMassCancelRejectedMemberGroup (Bool present) {
  switch (present) {
    case true: UINT8 mass_cancel_rejected_member_group[2];
    case false: unit absent;
  }
} OptionalMassCancelRejectedMemberGroup;

// Scopes the mass cancel to this specific order.
casetype _OptionalMassCancelRejectedClOrdId (Bool present) {
  switch (present) {
    case true: UINT64 mass_cancel_rejected_cl_ord_id;
    case false: unit absent;
  }
} OptionalMassCancelRejectedClOrdId;

// The Mass Cancel has been rejected.
typedef struct _MassCancelRejectedMessage {
  UINT8 has_mass_cancel_rejected_mpid : 1;                                                                                // byte 0
  UINT8 has_mass_cancel_rejected_sender_comp : 1;                                                                         // byte 0
  UINT8 has_mass_cancel_rejected_member_group : 1;                                                                        // byte 0
  UINT8 has_mass_cancel_rejected_cl_ord_id : 1;                                                                           // byte 0
  UINT8 reserved_4 : 4;                                                                                                   // byte 0
  UINT64 transact_time;                                                                                                   // bytes 1 to 8, signed, read here as unsigned
  UINT64 mass_cancel_request_id;                                                                                          // bytes 9 to 16, signed, read here as unsigned
  UINT8 mass_cancel_rejected_scope;                                                                                       // byte 17, signed, read here as unsigned
  UINT8 exclude_auction_orders : 1;                                                                                       // byte 18
  UINT8 reserved_7 : 7;                                                                                                   // byte 18
  UINT8 mass_cancel_rejected_reason;                                                                                      // byte 19, signed, read here as unsigned
  OptionalMassCancelRejectedMpid((has_mass_cancel_rejected_mpid == 1)) mass_cancel_rejected_mpid;
  OptionalMassCancelRejectedSenderComp((has_mass_cancel_rejected_sender_comp == 1)) mass_cancel_rejected_sender_comp;
  OptionalMassCancelRejectedMemberGroup((has_mass_cancel_rejected_member_group == 1)) mass_cancel_rejected_member_group;
  OptionalMassCancelRejectedClOrdId((has_mass_cancel_rejected_cl_ord_id == 1)) mass_cancel_rejected_cl_ord_id;
} MassCancelRejectedMessage;

// Confirms sweep completion. Sent after all affected orders have been canceled.
typedef struct _MassCancelResultMessage {
  UINT64 transact_time;           // bytes 0 to 7, signed, read here as unsigned
  UINT64 mass_cancel_request_id;  // bytes 8 to 15, signed, read here as unsigned
  UINT64 mass_cancel_id;          // bytes 16 to 23, signed, read here as unsigned
  UINT32 canceled_count;          // bytes 24 to 27, signed, read here as unsigned
} MassCancelResultMessage;

// Branch
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x69: TradingSessionStatusMessage trading_session_status_message;
    case 0x73: DefineSymbolMessage(available) define_symbol_message;
    case 0x79: SymbolStatusMessage symbol_status_message;
    case 0x49: LimitOrderAcceptedMessage limit_order_accepted_message;
    case 0x55: LimitOrderRejectedMessage limit_order_rejected_message;
    case 0x44: MarketOrderAcceptedMessage market_order_accepted_message;
    case 0x54: MarketOrderRejectedMessage market_order_rejected_message;
    case 0x58: OrderCanceledMessage order_canceled_message;
    case 0x57: CancelRejectedMessage cancel_rejected_message;
    case 0x59: OrderModifiedMessage order_modified_message;
    case 0x4E: ModifyRejectedMessage modify_rejected_message;
    case 0x4A: OrderReplacedMessage order_replaced_message;
    case 0x4B: ReplaceRejectedMessage replace_rejected_message;
    case 0x45: OrderExecutedMessage(available) order_executed_message;
    case 0x46: OrderRestatedMessage order_restated_message;
    case 0x5A: SelfMatchPreventedMessage(available) self_match_prevented_message;
    case 0x4F: MassCancelAcceptedMessage mass_cancel_accepted_message;
    case 0x50: MassCancelRejectedMessage mass_cancel_rejected_message;
    case 0x51: MassCancelResultMessage mass_cancel_result_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// A sequenced message from the exchange
typedef struct _TcpSequencedMessage (UINT16 message_length) where (message_length >= 3) {
  UINT8 stream_id;                                                                                                                                     // byte 0
  UINT8 message_type;                                                                                                                                  // byte 1
  SequencedMessage(message_type, (((UINT32) message_length) - 3)) sequenced_message[:byte-size-single-element-array (((UINT32) message_length) - 3)];
} TcpSequencedMessage;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 message_length, UINT32 available) {
  switch (selector) {
    case 0x30: DebugMessage(message_length) debug_message;
    case 0x34: unit end_of_session_message;
    case 0x31: LogonResponseMessage logon_response_message;
    case 0x32: TcpSequencedMessage(message_length) tcp_sequenced_message[:byte-size-single-element-array length];
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Rake Tcp Message sent by the Exchange to the Member
typedef struct _ServerRakeTcpMessage {
  UINT16 message_length { message_length >= 1 };                                                                                                                                                             // bytes 0 to 1
  UINT8 packet_type;                                                                                                                                                                                         // byte 2
  ServerPayload(packet_type, (((UINT32) message_length) - 1), message_length, ((((UINT32) message_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) message_length) + 2) - 3)];
} ServerRakeTcpMessage;

// ---- Packet: ServerPacket ----------------------------------------------------

// Rake Packet sent by the Exchange
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerRakeTcpMessage server_rake_tcp_message[:byte-size available];
} ServerPacket;

