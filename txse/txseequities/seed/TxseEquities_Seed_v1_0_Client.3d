// Client-specified limit order.
typedef struct _LimitOrderMessage {
  UINT32 has_limit_order_self_match_scope : 1;                                                                                    // bytes 0 to 3
  UINT32 has_limit_order_self_match_instruction : 1;                                                                              // bytes 0 to 3
  UINT32 has_limit_order_price_slide_instruction : 1;                                                                             // bytes 0 to 3
  UINT32 has_limit_order_min_qty : 1;                                                                                             // bytes 0 to 3
  UINT32 has_limit_order_max_floor_qty : 1;                                                                                       // bytes 0 to 3
  UINT32 has_limit_order_max_replenish_qty_range : 1;                                                                             // bytes 0 to 3
  UINT32 has_limit_order_max_replenish_time_range : 1;                                                                            // bytes 0 to 3
  UINT32 has_limit_order_reference_price_target : 1;                                                                              // bytes 0 to 3
  UINT32 has_limit_order_expire_time : 1;                                                                                         // bytes 0 to 3
  UINT32 has_limit_order_user_data : 1;                                                                                           // bytes 0 to 3
  UINT32 has_limit_order_mpid : 1;                                                                                                // bytes 0 to 3
  UINT32 has_limit_order_member_group : 1;                                                                                        // bytes 0 to 3
  UINT32 has_limit_order_locate_broker : 1;                                                                                       // bytes 0 to 3
  UINT32 reserved_19 : 19;                                                                                                        // bytes 0 to 3
  UINT64 cl_ord_id;                                                                                                               // bytes 4 to 11, signed, read here as unsigned
  UINT32 order_qty;                                                                                                               // bytes 12 to 15, signed, read here as unsigned
  UINT32 side : 3;                                                                                                                // bytes 16 to 19
  UINT32 is_locate_required : 1;                                                                                                  // bytes 16 to 19
  UINT32 time_in_force : 4;                                                                                                       // bytes 16 to 19
  UINT32 order_capacity : 3;                                                                                                      // bytes 16 to 19
  UINT32 is_iso : 1;                                                                                                              // bytes 16 to 19
  UINT32 is_hidden : 1;                                                                                                           // bytes 16 to 19
  UINT32 is_post_only : 1;                                                                                                        // bytes 16 to 19
  UINT32 cancel_at_entry_if_crossed : 1;                                                                                          // bytes 16 to 19
  UINT32 reserved_17 : 17;                                                                                                        // bytes 16 to 19
  UINT16 symbol_id;                                                                                                               // bytes 20 to 21, signed, read here as unsigned
  UINT64 price;                                                                                                                   // bytes 22 to 29, signed, read here as unsigned
  OptionalLimitOrderSelfMatchScope((has_limit_order_self_match_scope == 1)) limit_order_self_match_scope;
  OptionalLimitOrderSelfMatchInstruction((has_limit_order_self_match_instruction == 1)) limit_order_self_match_instruction;
  OptionalLimitOrderPriceSlideInstruction((has_limit_order_price_slide_instruction == 1)) limit_order_price_slide_instruction;
  OptionalLimitOrderMinQty((has_limit_order_min_qty == 1)) limit_order_min_qty;
  OptionalLimitOrderMaxFloorQty((has_limit_order_max_floor_qty == 1)) limit_order_max_floor_qty;
  OptionalLimitOrderMaxReplenishQtyRange((has_limit_order_max_replenish_qty_range == 1)) limit_order_max_replenish_qty_range;
  OptionalLimitOrderMaxReplenishTimeRange((has_limit_order_max_replenish_time_range == 1)) limit_order_max_replenish_time_range;
  OptionalLimitOrderReferencePriceTarget((has_limit_order_reference_price_target == 1)) limit_order_reference_price_target;
  OptionalLimitOrderExpireTime((has_limit_order_expire_time == 1)) limit_order_expire_time;
  OptionalLimitOrderUserData((has_limit_order_user_data == 1)) limit_order_user_data;
  OptionalLimitOrderMpid((has_limit_order_mpid == 1)) limit_order_mpid;
  OptionalLimitOrderMemberGroup((has_limit_order_member_group == 1)) limit_order_member_group;
  OptionalLimitOrderLocateBroker((has_limit_order_locate_broker == 1)) limit_order_locate_broker;
} LimitOrderMessage;

