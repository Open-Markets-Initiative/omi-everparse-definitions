// Replace an existing order with a new order, always losing priority.
typedef struct _ReplaceOrderMessage {
  UINT16 has_replace_order_price : 1;                                                                                                 // bytes 0 to 1
  UINT16 has_replace_order_order_qty : 1;                                                                                             // bytes 0 to 1
  UINT16 has_replace_order_max_floor_qty : 1;                                                                                         // bytes 0 to 1
  UINT16 has_replace_order_self_match_scope : 1;                                                                                      // bytes 0 to 1
  UINT16 has_replace_order_self_match_instruction : 1;                                                                                // bytes 0 to 1
  UINT16 has_replace_order_price_slide_instruction : 1;                                                                               // bytes 0 to 1
  UINT16 has_replace_order_reference_price_target : 1;                                                                                // bytes 0 to 1
  UINT16 has_replace_order_locate_broker : 1;                                                                                         // bytes 0 to 1
  UINT16 reserved_8 : 8;                                                                                                              // bytes 0 to 1
  UINT64 cl_ord_id;                                                                                                                   // bytes 2 to 9, signed, read here as unsigned
  UINT64 orig_cl_ord_id;                                                                                                              // bytes 10 to 17, signed, read here as unsigned
  UINT16 side : 3;                                                                                                                    // bytes 18 to 19
  UINT16 is_locate_required : 1;                                                                                                      // bytes 18 to 19
  UINT16 is_iso : 1;                                                                                                                  // bytes 18 to 19
  UINT16 is_post_only : 1;                                                                                                            // bytes 18 to 19
  UINT16 cancel_at_entry_if_crossed : 1;                                                                                              // bytes 18 to 19
  UINT16 reserved_9 : 9;                                                                                                              // bytes 18 to 19
  OptionalReplaceOrderPrice((has_replace_order_price == 1)) replace_order_price;
  OptionalReplaceOrderOrderQty((has_replace_order_order_qty == 1)) replace_order_order_qty;
  OptionalReplaceOrderMaxFloorQty((has_replace_order_max_floor_qty == 1)) replace_order_max_floor_qty;
  OptionalReplaceOrderSelfMatchScope((has_replace_order_self_match_scope == 1)) replace_order_self_match_scope;
  OptionalReplaceOrderSelfMatchInstruction((has_replace_order_self_match_instruction == 1)) replace_order_self_match_instruction;
  OptionalReplaceOrderPriceSlideInstruction((has_replace_order_price_slide_instruction == 1)) replace_order_price_slide_instruction;
  OptionalReplaceOrderReferencePriceTarget((has_replace_order_reference_price_target == 1)) replace_order_reference_price_target;
  OptionalReplaceOrderLocateBroker((has_replace_order_locate_broker == 1)) replace_order_locate_broker;
} ReplaceOrderMessage;

// Market Participant Identifier.
casetype _OptionalMassCancelMpid (Bool present) {
  switch (present) {
    case true: UINT8 mass_cancel_mpid[4];
    case false: unit absent;
  }
} OptionalMassCancelMpid;

// Narrows the cancel to orders entered on the specified order entry port (SenderComp).
casetype _OptionalMassCancelSenderComp (Bool present) {
  switch (present) {
    case true: UINT8 mass_cancel_sender_comp[8];
    case false: unit absent;
  }
} OptionalMassCancelSenderComp;

// Member supplied grouping.
casetype _OptionalMassCancelMemberGroup (Bool present) {
  switch (present) {
    case true: UINT8 mass_cancel_member_group[2];
    case false: unit absent;
  }
} OptionalMassCancelMemberGroup;

// Scopes the mass cancel to this specific order. SenderComp is required when ClOrdId is supplied.
casetype _OptionalMassCancelClOrdId (Bool present) {
  switch (present) {
    case true: UINT64 mass_cancel_cl_ord_id;
    case false: unit absent;
  }
} OptionalMassCancelClOrdId;

// Cancels all resting orders matching the specified scope and optional filters.
typedef struct _MassCancelMessage {
  UINT8 has_mass_cancel_mpid : 1;                                                               // byte 0
  UINT8 has_mass_cancel_sender_comp : 1;                                                        // byte 0
  UINT8 has_mass_cancel_member_group : 1;                                                       // byte 0
  UINT8 has_mass_cancel_cl_ord_id : 1;                                                          // byte 0
  UINT8 reserved_4 : 4;                                                                         // byte 0
  UINT64 mass_cancel_request_id;                                                                // bytes 1 to 8, signed, read here as unsigned
  UINT8 mass_cancel_scope;                                                                      // byte 9, signed, read here as unsigned
  UINT8 exclude_auction_orders : 1;                                                             // byte 10
  UINT8 reserved_7 : 7;                                                                         // byte 10
  OptionalMassCancelMpid((has_mass_cancel_mpid == 1)) mass_cancel_mpid;
  OptionalMassCancelSenderComp((has_mass_cancel_sender_comp == 1)) mass_cancel_sender_comp;
  OptionalMassCancelMemberGroup((has_mass_cancel_member_group == 1)) mass_cancel_member_group;
  OptionalMassCancelClOrdId((has_mass_cancel_cl_ord_id == 1)) mass_cancel_cl_ord_id;
} MassCancelMessage;

// Branch
casetype _UnsequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x4C: LimitOrderMessage limit_order_message;
    case 0x41: MarketOrderMessage market_order_message;
    case 0x43: CancelOrderMessage cancel_order_message;
    case 0x4D: ModifyOrderMessage modify_order_message;
    case 0x52: ReplaceOrderMessage replace_order_message;
    case 0x56: MassCancelMessage mass_cancel_message;
    default: UINT8 unknown[available];
  }
} UnsequencedMessage;

// Send message from member to higher level protocol at exchange
typedef struct _TcpUnsequencedMessage (UINT16 message_length) where (message_length >= 2) {
  UINT8 message_type;                                                                                                                                      // byte 0
  UnsequencedMessage(message_type, (((UINT32) message_length) - 2)) unsequenced_message[:byte-size-single-element-array (((UINT32) message_length) - 2)];
} TcpUnsequencedMessage;

// Branch
casetype _ClientPayload (UINT8 selector, UINT32 length, UINT16 message_length, UINT32 available) {
  switch (selector) {
    case 0x35: LogonRequestPacket logon_request_packet;
    case 0x36: TcpUnsequencedMessage(message_length) tcp_unsequenced_message[:byte-size-single-element-array length];
    default: UINT8 unknown[available];
  }
} ClientPayload;

// Rake Tcp Message sent by the Member to the Exchange
typedef struct _ClientRakeTcpMessage {
  UINT16 message_length { message_length >= 1 };                                                                                                                                                             // bytes 0 to 1
  UINT8 packet_type;                                                                                                                                                                                         // byte 2
  ClientPayload(packet_type, (((UINT32) message_length) - 1), message_length, ((((UINT32) message_length) + 2) - 3)) client_payload[:byte-size-single-element-array ((((UINT32) message_length) + 2) - 3)];
} ClientRakeTcpMessage;

// ---- Packet: ClientPacket ----------------------------------------------------

// Rake Packet sent by the Member
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientRakeTcpMessage client_rake_tcp_message[:byte-size available];
} ClientPacket;

