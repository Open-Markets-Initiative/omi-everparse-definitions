// Client-specified market order.
typedef struct _MarketOrderMessage {
  UINT16 has_market_order_self_match_scope : 1;                                                                                 // bytes 0 to 1
  UINT16 has_market_order_self_match_instruction : 1;                                                                           // bytes 0 to 1
  UINT16 has_market_order_user_data : 1;                                                                                        // bytes 0 to 1
  UINT16 has_market_order_mpid : 1;                                                                                             // bytes 0 to 1
  UINT16 has_market_order_member_group : 1;                                                                                     // bytes 0 to 1
  UINT16 has_market_order_locate_broker : 1;                                                                                    // bytes 0 to 1
  UINT16 reserved_10 : 10;                                                                                                      // bytes 0 to 1
  UINT64 cl_ord_id;                                                                                                             // bytes 2 to 9, signed, read here as unsigned
  UINT32 order_qty;                                                                                                             // bytes 10 to 13, signed, read here as unsigned
  UINT16 side : 3;                                                                                                              // bytes 14 to 15
  UINT16 is_locate_required : 1;                                                                                                // bytes 14 to 15
  UINT16 time_in_force : 4;                                                                                                     // bytes 14 to 15
  UINT16 order_capacity : 3;                                                                                                    // bytes 14 to 15
  UINT16 reserved_5 : 5;                                                                                                        // bytes 14 to 15
  UINT16 symbol_id;                                                                                                             // bytes 16 to 17, signed, read here as unsigned
  OptionalMarketOrderSelfMatchScope((has_market_order_self_match_scope == 1)) market_order_self_match_scope;
  OptionalMarketOrderSelfMatchInstruction((has_market_order_self_match_instruction == 1)) market_order_self_match_instruction;
  OptionalMarketOrderUserData((has_market_order_user_data == 1)) market_order_user_data;
  OptionalMarketOrderMpid((has_market_order_mpid == 1)) market_order_mpid;
  OptionalMarketOrderMemberGroup((has_market_order_member_group == 1)) market_order_member_group;
  OptionalMarketOrderLocateBroker((has_market_order_locate_broker == 1)) market_order_locate_broker;
} MarketOrderMessage;

