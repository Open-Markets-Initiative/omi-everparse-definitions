// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out TxseEquities_Seed_v1_0_Client.3d

// ---- Values ------------------------------------------------------------------

// Packet Type: one byte code
#define PACKET_TYPE_LOGON_REQUEST_PACKET 0x35      // Logon Request Packet
#define PACKET_TYPE_MEMBER_HEARTBEAT_PACKET 0x37   // Member Heartbeat Packet
#define PACKET_TYPE_TCP_UNSEQUENCED_MESSAGE 0x36   // Tcp Unsequenced Message
#define PACKET_TYPE_DEBUG_MESSAGE 0x30             // Debug Message
#define PACKET_TYPE_END_OF_SESSION_MESSAGE 0x34    // End Of Session Message
#define PACKET_TYPE_LOGON_RESPONSE_MESSAGE 0x31    // Logon Response Message
#define PACKET_TYPE_SERVER_HEARTBEAT_MESSAGE 0x33  // Server Heartbeat Message
#define PACKET_TYPE_TCP_SEQUENCED_MESSAGE 0x32     // Tcp Sequenced Message

// Message Type: one byte code
#define MESSAGE_TYPE_LIMIT_ORDER_MESSAGE 0x4C             // Limit Order Message
#define MESSAGE_TYPE_MARKET_ORDER_MESSAGE 0x41            // Market Order Message
#define MESSAGE_TYPE_CANCEL_ORDER_MESSAGE 0x43            // Cancel Order Message
#define MESSAGE_TYPE_MODIFY_ORDER_MESSAGE 0x4D            // Modify Order Message
#define MESSAGE_TYPE_REPLACE_ORDER_MESSAGE 0x52           // Replace Order Message
#define MESSAGE_TYPE_MASS_CANCEL_MESSAGE 0x56             // Mass Cancel Message
#define MESSAGE_TYPE_TRADING_SESSION_STATUS_MESSAGE 0x69  // Trading Session Status Message
#define MESSAGE_TYPE_DEFINE_SYMBOL_MESSAGE 0x73           // Define Symbol Message
#define MESSAGE_TYPE_SYMBOL_STATUS_MESSAGE 0x79           // Symbol Status Message
#define MESSAGE_TYPE_LIMIT_ORDER_ACCEPTED_MESSAGE 0x49    // Limit Order Accepted Message
#define MESSAGE_TYPE_LIMIT_ORDER_REJECTED_MESSAGE 0x55    // Limit Order Rejected Message
#define MESSAGE_TYPE_MARKET_ORDER_ACCEPTED_MESSAGE 0x44   // Market Order Accepted Message
#define MESSAGE_TYPE_MARKET_ORDER_REJECTED_MESSAGE 0x54   // Market Order Rejected Message
#define MESSAGE_TYPE_ORDER_CANCELED_MESSAGE 0x58          // Order Canceled Message
#define MESSAGE_TYPE_CANCEL_REJECTED_MESSAGE 0x57         // Cancel Rejected Message
#define MESSAGE_TYPE_ORDER_MODIFIED_MESSAGE 0x59          // Order Modified Message
#define MESSAGE_TYPE_MODIFY_REJECTED_MESSAGE 0x4E         // Modify Rejected Message
#define MESSAGE_TYPE_ORDER_REPLACED_MESSAGE 0x4A          // Order Replaced Message
#define MESSAGE_TYPE_REPLACE_REJECTED_MESSAGE 0x4B        // Replace Rejected Message
#define MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45          // Order Executed Message
#define MESSAGE_TYPE_ORDER_RESTATED_MESSAGE 0x46          // Order Restated Message
#define MESSAGE_TYPE_SELF_MATCH_PREVENTED_MESSAGE 0x5A    // Self Match Prevented Message
#define MESSAGE_TYPE_MASS_CANCEL_ACCEPTED_MESSAGE 0x4F    // Mass Cancel Accepted Message
#define MESSAGE_TYPE_MASS_CANCEL_REJECTED_MESSAGE 0x50    // Mass Cancel Rejected Message
#define MESSAGE_TYPE_MASS_CANCEL_RESULT_MESSAGE 0x51      // Mass Cancel Result Message

// Limit Order Self Match Instruction: one byte code
#define LIMIT_ORDER_SELF_MATCH_INSTRUCTION_NO_SELF_MATCH_PREVENTION 0x00  // No Self Match Prevention
#define LIMIT_ORDER_SELF_MATCH_INSTRUCTION_CANCEL_NEWEST 0x01             // Cancel Newest
#define LIMIT_ORDER_SELF_MATCH_INSTRUCTION_CANCEL_OLDEST 0x02             // Cancel Oldest
#define LIMIT_ORDER_SELF_MATCH_INSTRUCTION_CANCEL_BOTH 0x03               // Cancel Both
#define LIMIT_ORDER_SELF_MATCH_INSTRUCTION_CANCEL_SMALLEST 0x04           // Cancel Smallest
#define LIMIT_ORDER_SELF_MATCH_INSTRUCTION_DECREMENT_AND_CANCEL 0x05      // Decrement And Cancel

// Limit Order Price Slide Instruction: one byte code
#define LIMIT_ORDER_PRICE_SLIDE_INSTRUCTION_NO_PRICE_SLIDE 0x00                           // No Price Slide
#define LIMIT_ORDER_PRICE_SLIDE_INSTRUCTION_SINGLE_PRICE_SLIDE_ON_LOCK_AND_CROSS 0x01     // Single Price Slide On Lock And Cross
#define LIMIT_ORDER_PRICE_SLIDE_INSTRUCTION_MULTIPLE_PRICE_SLIDES_ON_LOCK_AND_CROSS 0x02  // Multiple Price Slides On Lock And Cross
#define LIMIT_ORDER_PRICE_SLIDE_INSTRUCTION_SINGLE_PRICE_SLIDE_LOCK_ONLY 0x03             // Single Price Slide Lock Only

// Market Order Self Match Instruction: one byte code
#define MARKET_ORDER_SELF_MATCH_INSTRUCTION_NO_SELF_MATCH_PREVENTION 0x00  // No Self Match Prevention
#define MARKET_ORDER_SELF_MATCH_INSTRUCTION_CANCEL_NEWEST 0x01             // Cancel Newest
#define MARKET_ORDER_SELF_MATCH_INSTRUCTION_CANCEL_OLDEST 0x02             // Cancel Oldest
#define MARKET_ORDER_SELF_MATCH_INSTRUCTION_CANCEL_BOTH 0x03               // Cancel Both
#define MARKET_ORDER_SELF_MATCH_INSTRUCTION_CANCEL_SMALLEST 0x04           // Cancel Smallest
#define MARKET_ORDER_SELF_MATCH_INSTRUCTION_DECREMENT_AND_CANCEL 0x05      // Decrement And Cancel

// Replace Order Self Match Instruction: one byte code
#define REPLACE_ORDER_SELF_MATCH_INSTRUCTION_NO_SELF_MATCH_PREVENTION 0x00  // No Self Match Prevention
#define REPLACE_ORDER_SELF_MATCH_INSTRUCTION_CANCEL_NEWEST 0x01             // Cancel Newest
#define REPLACE_ORDER_SELF_MATCH_INSTRUCTION_CANCEL_OLDEST 0x02             // Cancel Oldest
#define REPLACE_ORDER_SELF_MATCH_INSTRUCTION_CANCEL_BOTH 0x03               // Cancel Both
#define REPLACE_ORDER_SELF_MATCH_INSTRUCTION_CANCEL_SMALLEST 0x04           // Cancel Smallest
#define REPLACE_ORDER_SELF_MATCH_INSTRUCTION_DECREMENT_AND_CANCEL 0x05      // Decrement And Cancel

// Replace Order Price Slide Instruction: one byte code
#define REPLACE_ORDER_PRICE_SLIDE_INSTRUCTION_NO_PRICE_SLIDE 0x00                           // No Price Slide
#define REPLACE_ORDER_PRICE_SLIDE_INSTRUCTION_SINGLE_PRICE_SLIDE_ON_LOCK_AND_CROSS 0x01     // Single Price Slide On Lock And Cross
#define REPLACE_ORDER_PRICE_SLIDE_INSTRUCTION_MULTIPLE_PRICE_SLIDES_ON_LOCK_AND_CROSS 0x02  // Multiple Price Slides On Lock And Cross
#define REPLACE_ORDER_PRICE_SLIDE_INSTRUCTION_SINGLE_PRICE_SLIDE_LOCK_ONLY 0x03             // Single Price Slide Lock Only

// Mass Cancel Scope: one byte code
#define MASS_CANCEL_SCOPE_BY_MEMBER_OWNED_SENDER_COMPS 0x00  // By Member Owned Sender Comps
#define MASS_CANCEL_SCOPE_BY_MEMBER_OWNED_MPIDS 0x01         // By Member Owned Mpids

