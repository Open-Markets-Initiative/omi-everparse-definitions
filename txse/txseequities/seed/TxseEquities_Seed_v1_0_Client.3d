// Must be the first message a Member sends to the Exchange after establishing a TCP/IP connection
typedef struct _LogonRequestPacket {
  UINT64 session;               // bytes 0 to 7
  UINT8 sender_comp[8];         // bytes 8 to 15
  UINT8 token[8];               // bytes 16 to 23
  UINT64 next_sequence_number;  // bytes 24 to 31
} LogonRequestPacket;

// Enum SelfMatchScope. Determines the scope for self-match prevention.
casetype _OptionalLimitOrderSelfMatchScope (Bool present) {
  switch (present) {
    case true: UINT8 limit_order_self_match_scope;
    case false: unit absent;
  }
} OptionalLimitOrderSelfMatchScope;

// Enum LimitOrderSelfMatchInstruction. Determines the behavior when orders from the same entity would match.
casetype _OptionalLimitOrderSelfMatchInstruction (Bool present) {
