// ---- Rake Message Header: 3 bytes --------------------------------------------

// Rake Tcp per-message header carrying the frame length and packet-level dispatch byte
entrypoint typedef struct _RakeMessageHeader {
  UINT16 message_length;  // bytes 0 to 1
  UINT8 packet_type;      // byte 2
} RakeMessageHeader;

// ---- Logon Request Packet: 32 bytes ------------------------------------------

// Must be the first message a Member sends to the Exchange after establishing a TCP/IP connection
entrypoint typedef struct _LogonRequestPacket {
  UINT64 session;               // bytes 0 to 7
  UINT8 sender_comp[8];         // bytes 8 to 15
  UINT8 token[8];               // bytes 16 to 23
  UINT64 next_sequence_number;  // bytes 24 to 31
} LogonRequestPacket;

