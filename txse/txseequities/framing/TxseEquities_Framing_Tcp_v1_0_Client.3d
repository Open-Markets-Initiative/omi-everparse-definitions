// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out TxseEquities_Framing_Tcp_v1_0_Client.3d

// ---- Values ------------------------------------------------------------------

// Packet Type: one byte code
#define PACKET_TYPE_LOGON_REQUEST_PACKET 0x35      // Logon Request Packet
#define PACKET_TYPE_MEMBER_HEARTBEAT_PACKET 0x37   // Member Heartbeat Packet
#define PACKET_TYPE_TCP_UNSEQUENCED_MESSAGE 0x36   // Tcp Unsequenced Message
#define PACKET_TYPE_DEBUG_MESSAGE 0x30             // Debug Message
#define PACKET_TYPE_END_OF_SESSION_MESSAGE 0x34    // End Of Session Message
#define PACKET_TYPE_LOGON_RESPONSE_MESSAGE 0x31    // Logon Response Message
#define PACKET_TYPE_SERVER_HEARTBEAT_MESSAGE 0x33  // Server Heartbeat Message
#define PACKET_TYPE_TCP_SEQUENCED_MESSAGE 0x32     // Tcp Sequenced Message

// ---- Types -------------------------------------------------------------------

// Must be the first message a Member sends to the Exchange after establishing a TCP/IP connection
typedef struct _LogonRequestPacket {
  UINT64 session;               // bytes 0 to 7
  UINT8 sender_comp[8];         // bytes 8 to 15
  UINT8 token[8];               // bytes 16 to 23
  UINT64 next_sequence_number;  // bytes 24 to 31
} LogonRequestPacket;

// Send message from member to higher level protocol at exchange
typedef struct _TcpUnsequencedMessage (UINT16 message_length) where (message_length >= 2) {
  UINT8 message_type;                                          // byte 0
  UINT8 unsequenced_message[(((UINT32) message_length) - 2)];
} TcpUnsequencedMessage;

// Branch
casetype _ClientPayload (UINT8 selector, UINT32 length, UINT16 message_length, UINT32 available) {
  switch (selector) {
    case 0x35: LogonRequestPacket logon_request_packet;
    case 0x36: TcpUnsequencedMessage(message_length) tcp_unsequenced_message[:byte-size-single-element-array length];
    default: UINT8 unknown[available];
  }
} ClientPayload;

// Rake Tcp Message sent by the Member to the Exchange
typedef struct _ClientRakeTcpMessage {
  UINT16 message_length { message_length >= 1 };                                                                                                                                                             // bytes 0 to 1
  UINT8 packet_type;                                                                                                                                                                                         // byte 2
  ClientPayload(packet_type, (((UINT32) message_length) - 1), message_length, ((((UINT32) message_length) + 2) - 3)) client_payload[:byte-size-single-element-array ((((UINT32) message_length) + 2) - 3)];
} ClientRakeTcpMessage;

// ---- Packet: ClientPacket ----------------------------------------------------

// Rake Packet sent by the Member
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientRakeTcpMessage client_rake_tcp_message[:byte-size available];
} ClientPacket;

