// ---- Stream Header: 8 bytes --------------------------------------------------

// STREAM_HEADER
entrypoint typedef struct _StreamHeader {
  UINT16 message_length;   // bytes 0 to 1, signed, read here as unsigned
  UINT16 stream_id;        // bytes 2 to 3, signed, read here as unsigned
  UINT32 sequence_number;  // bytes 4 to 7
} StreamHeader;

// ---- Heartbeat Message: 4 bytes ----------------------------------------------

// Sent when there is no data available for a few seconds, on all Streams. The sequence number field in the Stream Header will have the value 0 (zero) for this message.
entrypoint typedef struct _HeartbeatMessage {
  UINT32 last_sequence_no;  // bytes 0 to 3, signed, read here as unsigned
} HeartbeatMessage;

