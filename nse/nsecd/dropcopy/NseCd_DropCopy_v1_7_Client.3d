// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NseCd_DropCopy_v1_7_Client.3d

// ---- Values ------------------------------------------------------------------

// Transaction Code: 2 byte code
#define TRANSACTION_CODE_SIGNON_IN_MESSAGE 0x08FC              // Signon In Message
#define TRANSACTION_CODE_SIGN_ON_OUT_MESSAGE 0x08FD            // Sign On Out Message
#define TRANSACTION_CODE_HEARTBEAT_MESSAGE 0x5BD2              // Heartbeat Message
#define TRANSACTION_CODE_DC_DOWNLOAD_REQUEST_MESSAGE 0x1F40    // Dc Download Request Message
#define TRANSACTION_CODE_TRADE_CONFIRMATION_MESSAGE 0x08AE     // Trade Confirmation Message
#define TRANSACTION_CODE_TRADE_CANCEL_CONFIRM_MESSAGE 0x08EA   // Trade Cancel Confirm Message
#define TRANSACTION_CODE_TRADE_CANCEL_REJECT_MESSAGE 0x08EE    // Trade Cancel Reject Message
#define TRANSACTION_CODE_TRADE_MODIFY_CONFIRM_MESSAGE 0x08EF   // Trade Modify Confirm Message
#define TRANSACTION_CODE_TRADE_MODIFY_REJECT_MESSAGE 0x08F0    // Trade Modify Reject Message
#define TRANSACTION_CODE_GIVEUP_APP_CONFIRM_TM_MESSAGE 0x119A  // Giveup App Confirm Tm Message
#define TRANSACTION_CODE_GIVEUP_REJ_CONFIRM_TM_MESSAGE 0x119B  // Giveup Rej Confirm Tm Message

// ---- Types -------------------------------------------------------------------

// Logs the user on to the drop copy feed
typedef struct _SignonInMessage {
  UINT32BE user_id;              // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_8[8];           // bytes 4 to 11
  UINT8 password[12];            // bytes 12 to 23
  UINT8 reserved_4[4];           // bytes 24 to 27
  UINT8 reserved_38[38];         // bytes 28 to 65
  UINT8 broker_id[5];            // bytes 66 to 70
  UINT8 reserved_119[119];       // bytes 71 to 189
  UINT8 reserved_16[16];         // bytes 190 to 205
  UINT8 second_reserved_16[16];  // bytes 206 to 221
  UINT8 third_reserved_16[16];   // bytes 222 to 237
} SignonInMessage;

// Requests the trade download for one stream, named in the first byte of Alpha Char, from the time given in Sequence Number
typedef struct _DcDownloadRequestMessage {
  UINT8 sequence_number[8];  // bytes 0 to 7
} DcDownloadRequestMessage;

// Branch
casetype _ClientMessagePayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x08FC: SignonInMessage signon_in_message;
    case 0x5BD2: unit heartbeat_message;
    case 0x1F40: DcDownloadRequestMessage dc_download_request_message;
    default: UINT8 unknown[available];
  }
} ClientMessagePayload;

// One framed interactive message sent by the firm
typedef struct _ClientDirectPacket {
  UINT16BE packet_length { packet_length >= 62 };                                                                                                                   // bytes 0 to 1
  UINT32BE packet_sequence_number;                                                                                                                                  // bytes 2 to 5
  UINT8 checksum[16];                                                                                                                                               // bytes 6 to 21
  UINT16BE transaction_code;                                                                                                                                        // bytes 22 to 23, signed, read here as unsigned
  UINT32BE log_time;                                                                                                                                                // bytes 24 to 27, signed, read here as unsigned
  UINT8 alpha_char[2];                                                                                                                                              // bytes 28 to 29
  UINT32BE trader_id;                                                                                                                                               // bytes 30 to 33, signed, read here as unsigned
  UINT16BE error_code;                                                                                                                                              // bytes 34 to 35, signed, read here as unsigned
  UINT64BE header_timestamp;                                                                                                                                        // bytes 36 to 43, signed, read here as unsigned
  UINT8 time_stamp_1[8];                                                                                                                                            // bytes 44 to 51
  UINT8 time_stamp_2[8];                                                                                                                                            // bytes 52 to 59
  UINT16BE message_length;                                                                                                                                          // bytes 60 to 61, signed, read here as unsigned
  ClientMessagePayload(transaction_code, (((UINT32) packet_length) - 62)) client_message_payload[:byte-size-single-element-array (((UINT32) packet_length) - 62)];
} ClientDirectPacket;

// ---- Packet: ClientPacket ----------------------------------------------------

// Nnf direct interface Tcp block of one or more packets sent by the firm
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientDirectPacket client_direct_packet[:byte-size available];
} ClientPacket;

