// National Stock Exchange of India Ltd Mtbt Order Book Snapshot Recovery
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out NseCd_Snapshot_v7_1_Tcp.3d
//
// What this definition does not state, and the model does:
// - a Reassemble rule
// - a run counted by a field
// - a Composite rule
//
// License: MIT No Attribution

// ---- Snapshot Header: 16 bytes -----------------------------------------------

// Snapshot header has a size of 16 bytes
entrypoint typedef struct _SnapshotHeader {
  UINT16 trans_code;            // bytes 0 to 1, signed, read here as unsigned
  UINT32 size;                  // bytes 2 to 5, signed, read here as unsigned
  UINT32 number_of_records;     // bytes 6 to 9, signed, read here as unsigned
  UINT32 last_sequence_number;  // bytes 10 to 13
  UINT16 stream_id;             // bytes 14 to 15, signed, read here as unsigned
} SnapshotHeader;

