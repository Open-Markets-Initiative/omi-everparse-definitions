// ---- Values ------------------------------------------------------------------

// Environment Type: one byte code
#define ENVIRONMENT_TYPE_PRODUCTION_ENVIRONMENT 0x31          // Production Environment
#define ENVIRONMENT_TYPE_PROD_PARALLEL_MOCK_ENVIRONMENT 0x32  // Prod Parallel Mock Environment
#define ENVIRONMENT_TYPE_TESTING_ENVIRONMENT 0x33             // Testing Environment

// Compression Indicator: one byte code
#define COMPRESSION_INDICATOR_NO_COMPRESSION_DONE 0x30  // No Compression Done
#define COMPRESSION_INDICATOR_DATA_IS_COMPRESSED 0x31   // Data Is Compressed

// Transaction Code: 2 byte code
#define TRANSACTION_CODE_GR_REQUEST_MESSAGE 0x0960                            // Gr Request Message
#define TRANSACTION_CODE_GR_RESPONSE_MESSAGE 0x0961                           // Gr Response Message
#define TRANSACTION_CODE_GR_SECURE_USER_REGISTRATION_REQUEST_MESSAGE 0x59E0   // Gr Secure User Registration Request Message
#define TRANSACTION_CODE_GR_SECURE_USER_REGISTRATION_RESPONSE_MESSAGE 0x59E1  // Gr Secure User Registration Response Message
#define TRANSACTION_CODE_HEARTBEAT_MESSAGE 0x5BD2                             // Heartbeat Message
#define TRANSACTION_CODE_DC_SIGNON_IN_MESSAGE 0x09C4                          // Dc Signon In Message
#define TRANSACTION_CODE_DC_SIGNON_OUT_MESSAGE 0x09C5                         // Dc Signon Out Message
#define TRANSACTION_CODE_DC_TRD_SUBSCRIPTION_REQUEST_MESSAGE 0x1F40           // Dc Trd Subscription Request Message
#define TRANSACTION_CODE_DC_ONT_SUBSCRIPTION_REQUEST_MESSAGE 0x2328           // Dc Ont Subscription Request Message
#define TRANSACTION_CODE_DC_ERROR_RESPONSE_TRADE_MESSAGE 0x1F46               // Dc Error Response Trade Message
#define TRANSACTION_CODE_DC_ERROR_RESPONSE_ORDER_MESSAGE 0x232E               // Dc Error Response Order Message
#define TRANSACTION_CODE_TRADE_CONFIRMATION_MESSAGE 0x08AE                    // Trade Confirmation Message
#define TRANSACTION_CODE_TRADE_CANCEL_CONFIRM_MESSAGE 0x08EA                  // Trade Cancel Confirm Message
#define TRANSACTION_CODE_TRADE_CANCEL_REJECT_MESSAGE 0x08EE                   // Trade Cancel Reject Message
#define TRANSACTION_CODE_TRADE_MODIFY_CONFIRM_MESSAGE 0x08EF                  // Trade Modify Confirm Message
#define TRANSACTION_CODE_PRICE_CONFIRMATION_MESSAGE 0x07DC                    // Price Confirmation Message
#define TRANSACTION_CODE_ORDER_MOD_REJECT_MESSAGE 0x07FA                      // Order Mod Reject Message
#define TRANSACTION_CODE_ORDER_CANCEL_REJECT_MESSAGE 0x0818                   // Order Cancel Reject Message
#define TRANSACTION_CODE_ORDER_CONFIRMATION_MESSAGE 0x0819                    // Order Confirmation Message
#define TRANSACTION_CODE_ORDER_MOD_CONFIRMATION_MESSAGE 0x081A                // Order Mod Confirmation Message
#define TRANSACTION_CODE_ORDER_CANCEL_CONFIRMATION_MESSAGE 0x081B             // Order Cancel Confirmation Message
#define TRANSACTION_CODE_FREEZE_TO_CONTROL_MESSAGE 0x087A                     // Freeze To Control Message
#define TRANSACTION_CODE_ON_STOP_NOTIFICATION_MESSAGE 0x08A4                  // On Stop Notification Message
#define TRANSACTION_CODE_ORDER_ERROR_MESSAGE 0x08B7                           // Order Error Message
#define TRANSACTION_CODE_BATCH_ORDER_CANCEL_MESSAGE 0x232A                    // Batch Order Cancel Message

// Message Indicator: 2 byte code
#define MESSAGE_INDICATOR_INTERIM_MESSAGE 0x0000  // Interim Message
#define MESSAGE_INDICATOR_LAST_MESSAGE 0x0001     // Last Message

// Buy Sell: 2 byte code
#define BUY_SELL_BUY_ORDER 0x0001   // Buy Order
#define BUY_SELL_SELL_ORDER 0x0002  // Sell Order

// Book Type: 2 byte code
#define BOOK_TYPE_REGULAR_LOT_ORDER 0x0001    // Regular Lot Order
#define BOOK_TYPE_SPECIAL_TERMS_ORDER 0x0002  // Special Terms Order
#define BOOK_TYPE_STOP_LOSS_ORDER 0x0003      // Stop Loss Order
#define BOOK_TYPE_NEGOTIATED_ORDER 0x0004     // Negotiated Order
#define BOOK_TYPE_ODD_LOT_ORDER 0x0005        // Odd Lot Order
#define BOOK_TYPE_SPOT_ORDER 0x0006           // Spot Order
#define BOOK_TYPE_AUCTION_ORDER 0x0007        // Auction Order
#define BOOK_TYPE_CALL_AUCTION_1 0x000B       // Call Auction 1
#define BOOK_TYPE_CALL_AUCTION_2 0x000C       // Call Auction 2

// Pro Client: 2 byte code
#define PRO_CLIENT_CLIENTS_ORDER 0x0001      // Clients Order
#define PRO_CLIENT_BROKERS_ORDER 0x0002      // Brokers Order
#define PRO_CLIENT_WAREHOUSING_ORDER 0x0004  // Warehousing Order

// Segment: 2 byte code
#define SEGMENT_EQUITY_DERIVATIVES_FO 0x0001        // Equity Derivatives Fo
#define SEGMENT_CURRENCY_DERIVATIVES 0x0002         // Currency Derivatives
#define SEGMENT_CAPITAL_MARKETS_CASH_EQUITY 0x0003  // Capital Markets Cash Equity
#define SEGMENT_SLBM_MARKETS 0x0004                 // Slbm Markets
#define SEGMENT_COMMODITY_DERIVATIVES 0x0005        // Commodity Derivatives

// Participant Type: one byte code
#define PARTICIPANT_TYPE_INITIATOR 0x49         // Initiator
#define PARTICIPANT_TYPE_COMPETITOR_ORDER 0x43  // Competitor Order
#define PARTICIPANT_TYPE_SOLICITOR_ORDER 0x53   // Solicitor Order

// Settlement Type: one byte code
#define SETTLEMENT_TYPE_T_0_SETTLEMENT 0x30  // T 0 Settlement
#define SETTLEMENT_TYPE_T_1_SETTLEMENT 0x31  // T 1 Settlement
#define SETTLEMENT_TYPE_T_2_SETTLEMENT 0x32  // T 2 Settlement

