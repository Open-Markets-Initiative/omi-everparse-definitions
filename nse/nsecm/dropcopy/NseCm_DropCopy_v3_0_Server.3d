  UINT32BE algo_id;                     // bytes 56 to 59, signed, read here as unsigned
  UINT64BE activity_time_in_nanos;      // bytes 60 to 67, signed, read here as unsigned
  UINT16BE competitor_period;           // bytes 68 to 69, signed, read here as unsigned
  UINT16BE solicitor_period;            // bytes 70 to 71, signed, read here as unsigned
  UINT16BE auction_number;              // bytes 72 to 73, signed, read here as unsigned
  UINT8 suspended;                      // byte 74
  UINT8 filler;                         // byte 75
