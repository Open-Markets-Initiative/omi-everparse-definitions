  UINT8 participant_type;               // byte 87
  UINT8 account_number[10];             // bytes 88 to 97
  UINT8 pro_client_char;                // byte 98
  UINT8 settlement_type;                // byte 99
  UINT8 settlor[12];                    // bytes 100 to 111
} OrderCancelRejectMessage;

