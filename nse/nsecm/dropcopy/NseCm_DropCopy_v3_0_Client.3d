// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NseCm_DropCopy_v3_0_Client.3d

// ---- Values ------------------------------------------------------------------

// Transaction Code: 2 byte code
#define TRANSACTION_CODE_GR_REQUEST_MESSAGE 0x0960                            // Gr Request Message
#define TRANSACTION_CODE_GR_RESPONSE_MESSAGE 0x0961                           // Gr Response Message
#define TRANSACTION_CODE_GR_SECURE_USER_REGISTRATION_REQUEST_MESSAGE 0x59E0   // Gr Secure User Registration Request Message
#define TRANSACTION_CODE_GR_SECURE_USER_REGISTRATION_RESPONSE_MESSAGE 0x59E1  // Gr Secure User Registration Response Message
#define TRANSACTION_CODE_HEARTBEAT_MESSAGE 0x5BD2                             // Heartbeat Message
#define TRANSACTION_CODE_DC_SIGNON_IN_MESSAGE 0x09C4                          // Dc Signon In Message
#define TRANSACTION_CODE_DC_SIGNON_OUT_MESSAGE 0x09C5                         // Dc Signon Out Message
#define TRANSACTION_CODE_DC_TRD_SUBSCRIPTION_REQUEST_MESSAGE 0x1F40           // Dc Trd Subscription Request Message
#define TRANSACTION_CODE_DC_ONT_SUBSCRIPTION_REQUEST_MESSAGE 0x2328           // Dc Ont Subscription Request Message
#define TRANSACTION_CODE_DC_ERROR_RESPONSE_TRADE_MESSAGE 0x1F46               // Dc Error Response Trade Message
#define TRANSACTION_CODE_DC_ERROR_RESPONSE_ORDER_MESSAGE 0x232E               // Dc Error Response Order Message
#define TRANSACTION_CODE_TRADE_CONFIRMATION_MESSAGE 0x08AE                    // Trade Confirmation Message
#define TRANSACTION_CODE_TRADE_CANCEL_CONFIRM_MESSAGE 0x08EA                  // Trade Cancel Confirm Message
#define TRANSACTION_CODE_TRADE_CANCEL_REJECT_MESSAGE 0x08EE                   // Trade Cancel Reject Message
#define TRANSACTION_CODE_TRADE_MODIFY_CONFIRM_MESSAGE 0x08EF                  // Trade Modify Confirm Message
#define TRANSACTION_CODE_PRICE_CONFIRMATION_MESSAGE 0x07DC                    // Price Confirmation Message
#define TRANSACTION_CODE_ORDER_MOD_REJECT_MESSAGE 0x07FA                      // Order Mod Reject Message
#define TRANSACTION_CODE_ORDER_CANCEL_REJECT_MESSAGE 0x0818                   // Order Cancel Reject Message
#define TRANSACTION_CODE_ORDER_CONFIRMATION_MESSAGE 0x0819                    // Order Confirmation Message
#define TRANSACTION_CODE_ORDER_MOD_CONFIRMATION_MESSAGE 0x081A                // Order Mod Confirmation Message
#define TRANSACTION_CODE_ORDER_CANCEL_CONFIRMATION_MESSAGE 0x081B             // Order Cancel Confirmation Message
#define TRANSACTION_CODE_FREEZE_TO_CONTROL_MESSAGE 0x087A                     // Freeze To Control Message
#define TRANSACTION_CODE_ON_STOP_NOTIFICATION_MESSAGE 0x08A4                  // On Stop Notification Message
#define TRANSACTION_CODE_ORDER_ERROR_MESSAGE 0x08B7                           // Order Error Message
#define TRANSACTION_CODE_BATCH_ORDER_CANCEL_MESSAGE 0x232A                    // Batch Order Cancel Message

// ---- Types -------------------------------------------------------------------

// Logs the member on to a partition of the drop copy service
typedef struct _DcSignonInMessage {
  UINT8 password[8];     // bytes 0 to 7
  UINT8 session_key[8];  // bytes 8 to 15
} DcSignonInMessage;

// Subscribes to the trade only drop copy on this partition from the named sequence number
typedef struct _DcTrdSubscriptionRequestMessage {
  UINT64BE sequence_number;  // bytes 0 to 7, signed, read here as unsigned
} DcTrdSubscriptionRequestMessage;

// Subscribes to the order and trade drop copy on this partition from the named sequence number
typedef struct _DcOntSubscriptionRequestMessage {
  UINT64BE sequence_number;  // bytes 0 to 7, signed, read here as unsigned
} DcOntSubscriptionRequestMessage;

// Branch
casetype _ClientMessagePayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0960: unit gr_request_message;
    case 0x59E0: unit gr_secure_user_registration_request_message;
    case 0x5BD2: unit heartbeat_message;
    case 0x09C4: DcSignonInMessage dc_signon_in_message;
    case 0x1F40: DcTrdSubscriptionRequestMessage dc_trd_subscription_request_message;
    case 0x2328: DcOntSubscriptionRequestMessage dc_ont_subscription_request_message;
    default: UINT8 unknown[available];
  }
} ClientMessagePayload;

// One drop copy packet sent by the member, carrying a single message
typedef struct _ClientDropCopyPacket {
  UINT16BE packet_length { packet_length >= 46 };                                                                                                                   // bytes 0 to 1
  UINT32BE packet_sequence_number;                                                                                                                                  // bytes 2 to 5
  UINT8 checksum[16];                                                                                                                                               // bytes 6 to 21
  UINT16BE transaction_code;                                                                                                                                        // bytes 22 to 23, signed, read here as unsigned
  UINT32BE trader_id;                                                                                                                                               // bytes 24 to 27, signed, read here as unsigned
  UINT64BE request_sequence_number;                                                                                                                                 // bytes 28 to 35, signed, read here as unsigned
  UINT8 partition_id[6];                                                                                                                                            // bytes 36 to 41
  UINT16BE concurrent_login_id;                                                                                                                                     // bytes 42 to 43, signed, read here as unsigned
  UINT8 func_indc;                                                                                                                                                  // byte 44
  UINT8 reserve;                                                                                                                                                    // byte 45
  ClientMessagePayload(transaction_code, (((UINT32) packet_length) - 46)) client_message_payload[:byte-size-single-element-array (((UINT32) packet_length) - 46)];
} ClientDropCopyPacket;

// ---- Packet: ClientPacket ----------------------------------------------------

// Drop copy Tcp block of one or more packets sent by the member
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientDropCopyPacket client_drop_copy_packet[:byte-size available];
} ClientPacket;

