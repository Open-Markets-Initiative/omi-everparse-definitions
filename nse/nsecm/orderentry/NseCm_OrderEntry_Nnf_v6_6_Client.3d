// Branch
casetype _ClientMessagePayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x1654: BranchOrderValueLimitUpdateInMessage branch_order_value_limit_update_in_message;
    case 0x169E: CancelOnLogoutStatusRequestMessage cancel_on_logout_status_request_message;
    case 0x1B58: MessageDownloadRequestMessage message_download_request_message;
    case 0x4660: AuctionInquiryRequestMessage auction_inquiry_request_message;
    case 0x4F62: BoxSignOffMessage box_sign_off_message;
    case 0x59D8: BoxSignOnRequestMessage box_sign_on_request_message;
    case 0x0960: GatewayRouterRequestMessage gateway_router_request_message;
    case 0x07D0: OrderEntryInMessage order_entry_in_message;
    case 0x07F8: OrderEntryInMessage order_entry_in_message_2;
    case 0x080E: OrderEntryInMessage order_entry_in_message_3;
    case 0x0816: OrderEntryInMessage order_entry_in_message_4;
    case 0x1659: OrderLimitUpdateInMessage order_limit_update_in_message;
    case 0x166A: PasswordResetInMessage password_reset_in_message;
    case 0x08FC: SignOnRequestInMessage sign_on_request_in_message;
    case 0x165B: SignOnRequestInMessage sign_on_request_in_message_2;
    case 0x1540: TradeInquiryInMessage trade_inquiry_in_message;
    case 0x1545: TradeInquiryInMessage trade_inquiry_in_message_2;
    case 0x1C84: UpdateLocalDatabaseRequestMessage update_local_database_request_message;
    case 0x16A0: TradeModificationCancellationStatusRequestMessage trade_modification_cancellation_status_request_message;
    case 0x1530: UserUnlockRequestMessage user_unlock_request_message;
    case 0x1657: UserOrderValueLimitUpdateInMessage user_order_value_limit_update_in_message;
    case 0x0640: unit system_information_request_message;
    default: UINT8 unknown[available];
  }
} ClientMessagePayload;

// Nnf interactive message sent by the firm
typedef struct _ClientMessage {
  UINT16BE transaction_code;                                                                                                                                          // bytes 0 to 1, signed, read here as unsigned
  UINT32BE log_time;                                                                                                                                                  // bytes 2 to 5, signed, read here as unsigned
  UINT8 alpha_char[2];                                                                                                                                                // bytes 6 to 7
  UINT32BE trader_id;                                                                                                                                                 // bytes 8 to 11, signed, read here as unsigned
  UINT16BE error_code;                                                                                                                                                // bytes 12 to 13, signed, read here as unsigned
  UINT64BE header_timestamp;                                                                                                                                          // bytes 14 to 21, signed, read here as unsigned
  UINT8 time_stamp_1[8];                                                                                                                                              // bytes 22 to 29
  UINT8 time_stamp_2[8];                                                                                                                                              // bytes 30 to 37
  UINT16BE message_length { message_length >= 40 };                                                                                                                   // bytes 38 to 39, signed, read here as unsigned
  ClientMessagePayload(transaction_code, (((UINT32) message_length) - 40)) client_message_payload[:byte-size-single-element-array (((UINT32) message_length) - 40)];
} ClientMessage;

// ---- Packet: ClientPacket ----------------------------------------------------

// Nnf Tcp block of one or more messages sent by the firm
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientMessage client_message[:byte-size available];
} ClientPacket;

