  UINT32BE user_id;  // bytes 0 to 3, signed, read here as unsigned
} UserUnlockApprovalRejectionMessage;

// Sent as USER_ADDR_UNLOCK_OUT
typedef struct _UserUnlockRequestedResponseMessage {
  UINT32BE user_id;  // bytes 0 to 3, signed, read here as unsigned
