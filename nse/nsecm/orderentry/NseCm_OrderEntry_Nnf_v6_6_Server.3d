  UINT32BE fill_qty;              // bytes 16 to 19, signed, read here as unsigned
  UINT32BE fill_price;            // bytes 20 to 23, signed, read here as unsigned
  UINT16BE market_type;           // bytes 24 to 25, signed, read here as unsigned
  UINT32BE new_volume;            // bytes 26 to 29, signed, read here as unsigned
  UINT8 reserved_24[24];          // bytes 30 to 53
  UINT8 buy_broker_id[5];         // bytes 54 to 58
  UINT8 sell_broker_id[5];        // bytes 59 to 63
  UINT32BE trader_id;             // bytes 64 to 67, signed, read here as unsigned
  UINT16BE requested_by;          // bytes 68 to 69, signed, read here as unsigned
  UINT8 buy_account_number[10];   // bytes 70 to 79
  UINT8 sell_account_number[10];  // bytes 80 to 89
  UINT8 buy_pan[10];              // bytes 90 to 99
  UINT8 sell_pan[10];             // bytes 100 to 109
  UINT8 reserved_60[60];          // bytes 110 to 169
} TradeInquiryOutMessage;

