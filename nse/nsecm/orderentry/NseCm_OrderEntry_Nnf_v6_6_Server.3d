// Sent as TRD_MOD_CXL_STATUS_CHANGE _OUT
typedef struct _TradeModificationCancellationStatusResponseMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 trd_mod_cxl_bit;  // byte 4
  UINT8 reserved_1;       // byte 5
} TradeModificationCancellationStatusResponseMessage;

// Forty byte header prefacing each downloaded record
typedef struct _InnerHeader {
  UINT32BE inner_trader_id;         // bytes 0 to 3, signed, read here as unsigned
  UINT32BE inner_log_time;          // bytes 4 to 7, signed, read here as unsigned
  UINT8 inner_alpha_char[2];        // bytes 8 to 9
  UINT16BE inner_transaction_code;  // bytes 10 to 11, signed, read here as unsigned
  UINT16BE inner_error_code;        // bytes 12 to 13, signed, read here as unsigned
  UINT64BE inner_timestamp;         // bytes 14 to 21, signed, read here as unsigned
  UINT8 inner_time_stamp_1[8];      // bytes 22 to 29
  UINT8 inner_time_stamp_2[8];      // bytes 30 to 37
  UINT16BE inner_message_length;    // bytes 38 to 39, signed, read here as unsigned
} InnerHeader;

// Record body selected by Inner Transaction Code
typedef struct _LocalDatabaseData (UINT32 available) {
  UINT8 data_payload[available];
} LocalDatabaseData;

// Carries one local database record wrapped in an inner header
typedef struct _UpdateLocalDatabaseDataMessage (UINT16 message_length) {
  InnerHeader inner_header;                                                                                                     // bytes 0 to 39
  LocalDatabaseData(((UINT32) message_length)) local_database_data[:byte-size-single-element-array ((UINT32) message_length)];
} UpdateLocalDatabaseDataMessage;

// Branch
casetype _ServerMessagePayload (UINT16 selector, UINT16 message_length, UINT32 available) {
  switch (selector) {
    case 0x4661: AuctionInquiryResponseMessage auction_inquiry_response_message;
    case 0x1655: BranchOrderValueLimitUpdateOutMessage branch_order_value_limit_update_out_message;
    case 0x169F: CancelOnLogoutStatusResponseMessage cancel_on_logout_status_response_message;
    case 0x08FE: ErrorResponseMessage error_response_message;
    case 0x59D9: BoxSignOnResponseMessage box_sign_on_response_message;
    case 0x0961: GatewayRouterResponseMessage(message_length, available) gateway_router_response_message;
    case 0x14AF: ControlMessageToTraderMessage control_message_to_trader_message;
    case 0x08A4: TradeConfirmationMessage trade_confirmation_message;
    case 0x08AE: TradeConfirmationMessage trade_confirmation_message_2;
    case 0x08EA: TradeConfirmationMessage trade_confirmation_message_3;
    case 0x08EE: TradeConfirmationMessage trade_confirmation_message_4;
    case 0x08EF: TradeConfirmationMessage trade_confirmation_message_5;
    case 0x07DC: OrderEntryOutMessage order_entry_out_message;
    case 0x07FA: OrderEntryOutMessage order_entry_out_message_2;
    case 0x080D: OrderEntryOutMessage order_entry_out_message_3;
    case 0x0818: OrderEntryOutMessage order_entry_out_message_4;
    case 0x0819: OrderEntryOutMessage order_entry_out_message_5;
    case 0x081A: OrderEntryOutMessage order_entry_out_message_6;
    case 0x081B: OrderEntryOutMessage order_entry_out_message_7;
    case 0x087A: OrderEntryOutMessage order_entry_out_message_8;
    case 0x08B7: OrderEntryOutMessage order_entry_out_message_9;
    case 0x232A: OrderEntryOutMessage order_entry_out_message_10;
    case 0x07D1: OrderEntryShortMessage order_entry_short_message;
    case 0x0817: OrderEntryShortMessage order_entry_short_message_2;
    case 0x165A: OrderLimitUpdateOutMessage order_limit_update_out_message;
    case 0x166B: PasswordResetOutMessage password_reset_out_message;
    case 0x46D2: SecurityStatusChangeMessage security_status_change_message;
    case 0x4913: SecurityStatusChangeMessage security_status_change_message_2;
    case 0x4920: SecurityMasterChangeMessage security_master_change_message;
    case 0x165C: SignOnRequestOutMessage sign_on_request_out_message;
    case 0x08FD: SignOnResponseMessage sign_on_response_message;
    case 0x0641: SystemInformationMessage system_information_message;
    case 0x1C99: SystemInformationMessage system_information_message_2;
    case 0x08AF: TradeInquiryOutMessage trade_inquiry_out_message;
    case 0x1541: TradeInquiryOutMessage trade_inquiry_out_message_2;
    case 0x1C8B: UpdateLocalDatabaseHeaderMessage update_local_database_header_message;
    case 0x1C8C: UpdateLocalDatabaseTrailerMessage update_local_database_trailer_message;
    case 0x15C7: UserUnlockApprovalRejectionMessage user_unlock_approval_rejection_message;
    case 0x15CB: UserUnlockApprovalRejectionMessage user_unlock_approval_rejection_message_2;
    case 0x1531: UserUnlockRequestedResponseMessage user_unlock_requested_response_message;
    case 0x1658: UserOrderValueLimitUpdateOutMessage user_order_value_limit_update_out_message;
    case 0x16A1: TradeModificationCancellationStatusResponseMessage trade_modification_cancellation_status_response_message;
    case 0x0911: unit sign_off_confirmation_message;
    case 0x1B63: unit header_record_message;
    case 0x1B6D: unit message_record_message;
    case 0x1B77: unit trailer_record_message;
    case 0x59E1: unit secure_box_registration_response_message;
    case 0x1C88: UpdateLocalDatabaseDataMessage(message_length) update_local_database_data_message;
    default: UINT8 unknown[available];
  }
} ServerMessagePayload;

// Nnf interactive message sent by the exchange
typedef struct _ServerMessage {
  UINT16BE transaction_code;                                                                                                                                                          // bytes 0 to 1, signed, read here as unsigned
  UINT32BE log_time;                                                                                                                                                                  // bytes 2 to 5, signed, read here as unsigned
  UINT8 alpha_char[2];                                                                                                                                                                // bytes 6 to 7
  UINT32BE trader_id;                                                                                                                                                                 // bytes 8 to 11, signed, read here as unsigned
  UINT16BE error_code;                                                                                                                                                                // bytes 12 to 13, signed, read here as unsigned
  UINT64BE header_timestamp;                                                                                                                                                          // bytes 14 to 21, signed, read here as unsigned
  UINT8 time_stamp_1[8];                                                                                                                                                              // bytes 22 to 29
  UINT8 time_stamp_2[8];                                                                                                                                                              // bytes 30 to 37
  UINT16BE message_length { message_length >= 40 };                                                                                                                                   // bytes 38 to 39, signed, read here as unsigned
  ServerMessagePayload(transaction_code, message_length, (((UINT32) message_length) - 40)) server_message_payload[:byte-size-single-element-array (((UINT32) message_length) - 40)];
} ServerMessage;

// ---- Packet: ServerPacket ----------------------------------------------------

// Nnf Tcp block of one or more messages sent by the exchange
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerMessage server_message[:byte-size available];
} ServerPacket;

