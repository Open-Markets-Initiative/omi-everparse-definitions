// Initialisation vector used by the existing encryption
typedef struct _ExistingEncryptionTail {
  UINT8 cryptographic_iv[16];  // bytes 0 to 15
} ExistingEncryptionTail;

// Initialisation vectors used by the new authenticated encryption
typedef struct _NewEncryptionTail {
  UINT8 static_cryptographic_iv[8];        // bytes 0 to 7
  UINT64BE dynamic_cryptographic_iv;       // bytes 8 to 15, signed, read here as unsigned
  UINT8 cryptographic_additional_key[12];  // bytes 16 to 27
} NewEncryptionTail;

// Branch
casetype _CryptographicPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x007C: ExistingEncryptionTail existing_encryption_tail;
    case 0x0088: NewEncryptionTail new_encryption_tail;
    default: UINT8 unknown[available];
  }
} CryptographicPayload;

// Initialisation vectors, layout selected by Message Length
typedef struct _CryptographicTail (UINT16 message_length, UINT32 available) {
  CryptographicPayload(message_length, available) cryptographic_payload[:byte-size-single-element-array available];
} CryptographicTail;

// Sent as GR_RESPONSE
typedef struct _GatewayRouterResponseMessage (UINT16 message_length, UINT32 available) where (available >= 68) {
  UINT16BE box_id;                                                         // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];                                                      // bytes 2 to 6
  UINT8 filler;                                                            // byte 7
  UINT8 ip_address[16];                                                    // bytes 8 to 23
  UINT32BE port;                                                           // bytes 24 to 27, signed, read here as unsigned
  UINT8 session_key[8];                                                    // bytes 28 to 35
  UINT8 cryptographic_key[32];                                             // bytes 36 to 67
  CryptographicTail(message_length, (available - 68)) cryptographic_tail;
} GatewayRouterResponseMessage;

