  UINT8 reserved_10[10];  // bytes 2 to 11
} BoxSignOnResponseMessage;

// ---- Existing Encryption Tail: 16 bytes --------------------------------------

// Initialisation vector used by the existing encryption
entrypoint typedef struct _ExistingEncryptionTail {
  UINT8 cryptographic_iv[16];  // bytes 0 to 15
} ExistingEncryptionTail;

// ---- New Encryption Tail: 28 bytes -------------------------------------------

// Initialisation vectors used by the new authenticated encryption
entrypoint typedef struct _NewEncryptionTail {
  UINT8 static_cryptographic_iv[8];        // bytes 0 to 7
  UINT64BE dynamic_cryptographic_iv;       // bytes 8 to 15, signed, read here as unsigned
  UINT8 cryptographic_additional_key[12];  // bytes 16 to 27
} NewEncryptionTail;

// ---- Control Message To Trader Message: 250 bytes ----------------------------

// Sent as CTRL_MSG_TO_TRADER
entrypoint typedef struct _ControlMessageToTraderMessage {
  UINT32BE trader_id;    // bytes 0 to 3, signed, read here as unsigned
  UINT8 action_code[3];  // bytes 4 to 6
  UINT8 reserved_1;      // byte 7
  UINT16BE msg_length;   // bytes 8 to 9, signed, read here as unsigned
  UINT8 msg[240];        // bytes 10 to 249
} ControlMessageToTraderMessage;

// ---- Password Reset Out Message: 18 bytes ------------------------------------

// Sent as RESET_PASSWORD_OUT
entrypoint typedef struct _PasswordResetOutMessage {
