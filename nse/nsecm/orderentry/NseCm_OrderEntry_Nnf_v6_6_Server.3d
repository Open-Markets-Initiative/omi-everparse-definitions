// INQUIRYDATA
typedef struct _Inquirydata {
  UINT32BE token;              // bytes 0 to 3, signed, read here as unsigned
  UINT16BE auction_number;     // bytes 4 to 5, signed, read here as unsigned
  UINT16BE auction_status;     // bytes 6 to 7, signed, read here as unsigned
  UINT16BE initiator_type;     // bytes 8 to 9, signed, read here as unsigned
  UINT32BE total_buy;          // bytes 10 to 13, signed, read here as unsigned
  UINT32BE best_buy_price;     // bytes 14 to 17, signed, read here as unsigned
  UINT32BE total_sell;         // bytes 18 to 21, signed, read here as unsigned
  UINT32BE best_sell_price;    // bytes 22 to 25, signed, read here as unsigned
  UINT32BE auctioin_price;     // bytes 26 to 29, signed, read here as unsigned
  UINT32BE auction_quantity;   // bytes 30 to 33, signed, read here as unsigned
  UINT16BE settlement_period;  // bytes 34 to 35, signed, read here as unsigned
} Inquirydata;

// Sent as AUCTION_INQUIRY_OUT
typedef struct _AuctionInquiryResponseMessage {
  UINT16BE number_of_records;               // bytes 0 to 1, signed, read here as unsigned
  Inquirydata inquirydata[:byte-size 180];  // bytes 2 to 181
} AuctionInquiryResponseMessage;

