// ---- Trade Inquiry Out Message: 170 bytes ------------------------------------

// Sent as TRADE_ERROR, TRADE_CANCEL_OUT
entrypoint typedef struct _TradeInquiryOutMessage {
  SecInfo sec_info;               // bytes 0 to 11
