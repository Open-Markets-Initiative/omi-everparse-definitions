  UINT16BE second_default_settlement_period;                // bytes 18 to 19, signed, read here as unsigned
  UINT16BE third_default_settlement_period;                 // bytes 20 to 21, signed, read here as unsigned
  UINT16BE competitor_period;                               // bytes 22 to 23, signed, read here as unsigned
  UINT16BE solicitor_period;                                // bytes 24 to 25, signed, read here as unsigned
  UINT16BE warning_percent;                                 // bytes 26 to 27, signed, read here as unsigned
