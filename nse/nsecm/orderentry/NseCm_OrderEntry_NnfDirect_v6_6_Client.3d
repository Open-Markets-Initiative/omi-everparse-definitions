// Market Type: 2 byte code
#define MARKET_TYPE_NORMAL_MARKET 0x0001          // Normal Market
#define MARKET_TYPE_ODD_LOT_MARKET 0x0002         // Odd Lot Market
#define MARKET_TYPE_SPOT_MARKET 0x0003            // Spot Market
#define MARKET_TYPE_AUCTION_MARKET 0x0004         // Auction Market
#define MARKET_TYPE_CALL_AUCTION_1_MARKET 0x0005  // Call Auction 1 Market
#define MARKET_TYPE_CALL_AUCTION_2_MARKET 0x0006  // Call Auction 2 Market

// ---- Packet Header: 6 bytes --------------------------------------------------

// Packet Length and Sequence number, the first six bytes of the direct interface's twenty two byte packet header; its last sixteen open each packet body branch
entrypoint typedef struct _PacketHeader {
  UINT16BE packet_length;           // bytes 0 to 1
  UINT32BE packet_sequence_number;  // bytes 2 to 5
} PacketHeader;

// ---- Message Header: 40 bytes ------------------------------------------------

// MESSAGE_HEADER
entrypoint typedef struct _MessageHeader {
  UINT16BE transaction_code;  // bytes 0 to 1, values TRANSACTION_CODE_, signed, read here as unsigned
  UINT32BE log_time;          // bytes 2 to 5, signed, read here as unsigned
  UINT8 alpha_char[2];        // bytes 6 to 7
  UINT32BE trader_id;         // bytes 8 to 11, signed, read here as unsigned
  UINT16BE error_code;        // bytes 12 to 13, signed, read here as unsigned
  UINT64BE header_timestamp;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 time_stamp_1[8];      // bytes 22 to 29
  UINT8 time_stamp_2[8];      // bytes 30 to 37
  UINT16BE message_length;    // bytes 38 to 39, signed, read here as unsigned
} MessageHeader;

// ---- Cancel On Logout Status Request Message: 12 bytes -----------------------

// Sent as COL_USER_STATUS_CHANGE _IN
entrypoint typedef struct _CancelOnLogoutStatusRequestMessage {
  UINT32BE user_id;     // bytes 0 to 3, signed, read here as unsigned
  UINT8 colo_user_bit;  // byte 4
  UINT8 reserved_7[7];  // bytes 5 to 11
} CancelOnLogoutStatusRequestMessage;

// ---- Sec Info: 12 bytes ------------------------------------------------------

// SEC_INFO
entrypoint typedef struct _SecInfo {
  UINT8 symbol[10];  // bytes 0 to 9
  UINT8 series[2];   // bytes 10 to 11
} SecInfo;

// ---- Auction Inquiry Request Message: 16 bytes -------------------------------

// Sent as AUCTION_INQUIRY_IN
entrypoint typedef struct _AuctionInquiryRequestMessage {
  SecInfo sec_info;      // bytes 0 to 11
  UINT16BE auction_no;   // bytes 12 to 13, signed, read here as unsigned
  UINT8 page_indicator;  // byte 14
  UINT8 filler;          // byte 15
} AuctionInquiryRequestMessage;

// ---- Box Sign Off Message: 2 bytes -------------------------------------------

// Sent as BOX_SIGN_OFF
entrypoint typedef struct _BoxSignOffMessage {
  UINT16BE box_id;  // bytes 0 to 1, signed, read here as unsigned
} BoxSignOffMessage;

// ---- Box Sign On Request Message: 20 bytes -----------------------------------

// Sent as BOX_SIGN_ON_REQUEST_IN
entrypoint typedef struct _BoxSignOnRequestMessage {
  UINT16BE box_id;       // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];    // bytes 2 to 6
  UINT8 reserved_5[5];   // bytes 7 to 11
  UINT8 session_key[8];  // bytes 12 to 19
} BoxSignOnRequestMessage;

// ---- Gateway Router Request Message: 8 bytes ---------------------------------

// Sent as GR_REQUEST
entrypoint typedef struct _GatewayRouterRequestMessage {
  UINT16BE box_id;     // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];  // bytes 2 to 6
  UINT8 filler;        // byte 7
} GatewayRouterRequestMessage;

// ---- Password Reset In Message: 18 bytes -------------------------------------

// Sent as RESET_PASSWORD_IN
entrypoint typedef struct _PasswordResetInMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_14[14];  // bytes 4 to 17
} PasswordResetInMessage;

// ---- Trade Inquiry In Message: 170 bytes -------------------------------------

// Sent as TRADE_CANCEL_IN, TRADE_MOD_IN
entrypoint typedef struct _TradeInquiryInMessage {
  SecInfo sec_info;               // bytes 0 to 11
  UINT32BE fill_number;           // bytes 12 to 15, signed, read here as unsigned
  UINT32BE fill_qty;              // bytes 16 to 19, signed, read here as unsigned
  UINT32BE fill_price;            // bytes 20 to 23, signed, read here as unsigned
  UINT16BE market_type;           // bytes 24 to 25, values MARKET_TYPE_, signed, read here as unsigned
  UINT32BE new_volume;            // bytes 26 to 29, signed, read here as unsigned
  UINT8 reserved_24[24];          // bytes 30 to 53
  UINT8 buy_broker_id[5];         // bytes 54 to 58
  UINT8 sell_broker_id[5];        // bytes 59 to 63
  UINT32BE trader_id;             // bytes 64 to 67, signed, read here as unsigned
  UINT16BE requested_by;          // bytes 68 to 69, signed, read here as unsigned
  UINT8 buy_account_number[10];   // bytes 70 to 79
  UINT8 sell_account_number[10];  // bytes 80 to 89
  UINT8 buy_pan[10];              // bytes 90 to 99
  UINT8 sell_pan[10];             // bytes 100 to 109
  UINT8 reserved_60[60];          // bytes 110 to 169
} TradeInquiryInMessage;

// ---- Update Local Database Request Message: 22 bytes -------------------------

// Sent as UPDATE_LOCALDB_IN
entrypoint typedef struct _UpdateLocalDatabaseRequestMessage {
  UINT32BE last_update_security_time;     // bytes 0 to 3, signed, read here as unsigned
  UINT32BE last_update_participant_time;  // bytes 4 to 7, signed, read here as unsigned
  UINT8 request_for_open_orders;          // byte 8
  UINT8 reserved_1;                       // byte 9
  UINT16BE normal_market_status;          // bytes 10 to 11, signed, read here as unsigned
  UINT16BE odd_lot_market_status;         // bytes 12 to 13, signed, read here as unsigned
  UINT16BE spot_market_status;            // bytes 14 to 15, signed, read here as unsigned
  UINT16BE auction_market_status;         // bytes 16 to 17, signed, read here as unsigned
  UINT16BE call_auction_1_market_status;  // bytes 18 to 19, signed, read here as unsigned
  UINT16BE call_auction_2_market_status;  // bytes 20 to 21, signed, read here as unsigned
} UpdateLocalDatabaseRequestMessage;

// ---- Trade Modification Cancellation Status Request Message: 12 bytes --------

// Sent as TRD_MOD_CXL_STATUS_CHANGE _IN
entrypoint typedef struct _TradeModificationCancellationStatusRequestMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 trd_mod_cxl_bit;  // byte 4
  UINT8 reserved_7[7];    // bytes 5 to 11
} TradeModificationCancellationStatusRequestMessage;

// ---- User Unlock Request Message: 28 bytes -----------------------------------

// Sent as USER_ADDR_UNLOCK_IN
entrypoint typedef struct _UserUnlockRequestMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_24[24];  // bytes 4 to 27
} UserUnlockRequestMessage;

