// National Stock Exchange of India Ltd Order Entry
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out NseCm_OrderEntry_NnfTrimmed_v6_6.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - a field read in bits
// - a Composite rule
//
// License: MIT No Attribution

// ---- Sec Info: 12 bytes ------------------------------------------------------

// SEC_INFO
entrypoint typedef struct _SecInfo {
  UINT8 symbol[10];  // bytes 0 to 9
  UINT8 series[2];   // bytes 10 to 11
} SecInfo;

// ---- Quick Acknowledgement Message: 22 bytes ---------------------------------

// Immediate acknowledgement of a trimmed order entry, modification or cancellation request, answered on the separate port of the gateway router server
entrypoint typedef struct _QuickAcknowledgementMessage {
  UINT16BE transaction_code;  // bytes 0 to 1, signed, read here as unsigned
  UINT32BE trader_id;         // bytes 2 to 5, signed, read here as unsigned
  UINT64BE timestamp;         // bytes 6 to 13, signed, read here as unsigned
  UINT32BE reference;         // bytes 14 to 17, signed, read here as unsigned
  UINT16BE error_code;        // bytes 18 to 19, signed, read here as unsigned
  UINT16BE message_length;    // bytes 20 to 21, signed, read here as unsigned
} QuickAcknowledgementMessage;

