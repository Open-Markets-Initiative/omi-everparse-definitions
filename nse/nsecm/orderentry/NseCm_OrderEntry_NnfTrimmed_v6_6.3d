// Transaction Code: 2 byte code
#define TRANSACTION_CODE_ORDER_ENTRY_REQUEST_TRIMMED_MESSAGE 0x4E20                 // Order Entry Request Trimmed Message
#define TRANSACTION_CODE_ORDER_ENTRY_REQUEST_TRIMMED_MESSAGE_X4FB0 0x4FB0           // Order Entry Request Trimmed Message
#define TRANSACTION_CODE_ORDER_MODIFY_CANCEL_REQUEST_TRIMMED_MESSAGE 0x4E48         // Order Modify Cancel Request Trimmed Message
#define TRANSACTION_CODE_ORDER_MODIFY_CANCEL_REQUEST_TRIMMED_MESSAGE_X4E66 0x4E66   // Order Modify Cancel Request Trimmed Message
#define TRANSACTION_CODE_ORDER_MODIFY_CANCEL_REQUEST_TRIMMED_MESSAGE_X4FB2 0x4FB2   // Order Modify Cancel Request Trimmed Message
#define TRANSACTION_CODE_ORDER_MODIFY_CANCEL_REQUEST_TRIMMED_MESSAGE_X4FB4 0x4FB4   // Order Modify Cancel Request Trimmed Message
#define TRANSACTION_CODE_ORDER_MODIFY_CANCEL_RESPONSE_TRIMMED_MESSAGE 0x4E2C        // Order Modify Cancel Response Trimmed Message
#define TRANSACTION_CODE_ORDER_MODIFY_CANCEL_RESPONSE_TRIMMED_MESSAGE_X4E4A 0x4E4A  // Order Modify Cancel Response Trimmed Message
#define TRANSACTION_CODE_ORDER_MODIFY_CANCEL_RESPONSE_TRIMMED_MESSAGE_X4E68 0x4E68  // Order Modify Cancel Response Trimmed Message
#define TRANSACTION_CODE_ORDER_MODIFY_CANCEL_RESPONSE_TRIMMED_MESSAGE_X4E69 0x4E69  // Order Modify Cancel Response Trimmed Message
#define TRANSACTION_CODE_ORDER_MODIFY_CANCEL_RESPONSE_TRIMMED_MESSAGE_X4E6A 0x4E6A  // Order Modify Cancel Response Trimmed Message
#define TRANSACTION_CODE_ORDER_MODIFY_CANCEL_RESPONSE_TRIMMED_MESSAGE_X4E6B 0x4E6B  // Order Modify Cancel Response Trimmed Message
#define TRANSACTION_CODE_ORDER_MODIFY_CANCEL_RESPONSE_TRIMMED_MESSAGE_X4F07 0x4F07  // Order Modify Cancel Response Trimmed Message
#define TRANSACTION_CODE_TRADE_CONFIRMATION_TRIMMED_MESSAGE 0x4EFE                  // Trade Confirmation Trimmed Message
#define TRANSACTION_CODE_QUICK_ACKNOWLEDGEMENT_MESSAGE 0x4FB1                       // Quick Acknowledgement Message
#define TRANSACTION_CODE_QUICK_ACKNOWLEDGEMENT_MESSAGE_X4FB3 0x4FB3                 // Quick Acknowledgement Message
#define TRANSACTION_CODE_QUICK_ACKNOWLEDGEMENT_MESSAGE_X4FB5 0x4FB5                 // Quick Acknowledgement Message

// ---- Types -------------------------------------------------------------------

// SEC_INFO
typedef struct _SecInfo {
  UINT8 symbol[10];  // bytes 0 to 9
  UINT8 series[2];   // bytes 10 to 11
} SecInfo;

// Trimmed order entry request, and the same structure sent as an immediate acknowledgement request. Chapter 4 directs an order of book type 1, 11 or 12 to this structure rather than to the interactive MS_OE_REQUEST, under transaction code 20000 or 20400
typedef struct _OrderEntryRequestTrimmedMessage {
  UINT16BE transcode;        // bytes 0 to 1, signed, read here as unsigned
  UINT32BE trader_id;        // bytes 2 to 5, signed, read here as unsigned
  SecInfo sec_info;          // bytes 6 to 17
  UINT8 account_number[10];  // bytes 18 to 27
  UINT16BE book_type;        // bytes 28 to 29, signed, read here as unsigned
  UINT16BE buy_sell;         // bytes 30 to 31, signed, read here as unsigned
  UINT32BE disclosed_vol;    // bytes 32 to 35, signed, read here as unsigned
  UINT32BE volume;           // bytes 36 to 39, signed, read here as unsigned
  UINT32BE price;            // bytes 40 to 43, signed, read here as unsigned
  UINT32BE good_till_date;   // bytes 44 to 47, signed, read here as unsigned
  UINT16BE ato : 1;          // bytes 48 to 49
  UINT16BE mkt : 1;          // bytes 48 to 49
  UINT16BE on_stop : 1;      // bytes 48 to 49
  UINT16BE day : 1;          // bytes 48 to 49
  UINT16BE gtc : 1;          // bytes 48 to 49
  UINT16BE ioc : 1;          // bytes 48 to 49
  UINT16BE aon : 1;          // bytes 48 to 49
  UINT16BE mf : 1;           // bytes 48 to 49
  UINT16BE matched_ind : 1;  // bytes 48 to 49
  UINT16BE traded : 1;       // bytes 48 to 49
  UINT16BE modified : 1;     // bytes 48 to 49
  UINT16BE frozen : 1;       // bytes 48 to 49
  UINT16BE preopen : 1;      // bytes 48 to 49
  UINT16BE reserved_3 : 1;   // bytes 48 to 49
  UINT16BE stpc : 1;         // bytes 48 to 49
  UINT16BE reserved_1 : 1;   // bytes 48 to 49
  UINT16BE branch_id;        // bytes 50 to 51, signed, read here as unsigned
  UINT32BE user_id;          // bytes 52 to 55, signed, read here as unsigned
  UINT8 broker_id[5];        // bytes 56 to 60
  UINT8 suspended;           // byte 61
  UINT8 settlor[12];         // bytes 62 to 73
  UINT16BE pro_client;       // bytes 74 to 75, signed, read here as unsigned
  UINT8 nnf_field[8];        // bytes 76 to 83
  UINT32BE transaction_id;   // bytes 84 to 87, signed, read here as unsigned
  UINT8 pan[10];             // bytes 88 to 97
  UINT32BE algo_id;          // bytes 98 to 101, signed, read here as unsigned
  UINT8 reserved_2[2];       // bytes 102 to 103
  UINT8 reserved_32[32];     // bytes 104 to 135
} OrderEntryRequestTrimmedMessage;

// Trimmed order modification and cancellation request, and the same structure sent as an immediate acknowledgement request. The body text names it MS_OM_REQUEST_TR where the appendix table names it ORDER_OM_REQUEST_TR
typedef struct _OrderModifyCancelRequestTrimmedMessage {
  UINT16BE transaction_code;         // bytes 0 to 1, signed, read here as unsigned
  UINT32BE log_time;                 // bytes 2 to 5, signed, read here as unsigned
  UINT32BE user_id;                  // bytes 6 to 9, signed, read here as unsigned
  UINT16BE error_code;               // bytes 10 to 11, signed, read here as unsigned
  UINT64BE time_stamp_1;             // bytes 12 to 19, signed, read here as unsigned
  UINT8 time_stamp_2;                // byte 20
  UINT8 modified_cancelled_by;       // byte 21
  UINT16BE reason_code;              // bytes 22 to 23, signed, read here as unsigned
  SecInfo sec_info;                  // bytes 24 to 35
  UINT8 order_number[8];             // bytes 36 to 43
  UINT8 account_number[10];          // bytes 44 to 53
  UINT16BE book_type;                // bytes 54 to 55, signed, read here as unsigned
  UINT16BE buy_sell;                 // bytes 56 to 57, signed, read here as unsigned
  UINT32BE disclosed_vol;            // bytes 58 to 61, signed, read here as unsigned
  UINT32BE disclosed_vol_remaining;  // bytes 62 to 65, signed, read here as unsigned
  UINT32BE total_vol_remaining;      // bytes 66 to 69, signed, read here as unsigned
  UINT32BE volume;                   // bytes 70 to 73, signed, read here as unsigned
  UINT32BE volume_filled_today;      // bytes 74 to 77, signed, read here as unsigned
  UINT32BE price;                    // bytes 78 to 81, signed, read here as unsigned
  UINT32BE entry_date_time;          // bytes 82 to 85, signed, read here as unsigned
  UINT32BE last_modified;            // bytes 86 to 89, signed, read here as unsigned
  UINT16BE ato : 1;                  // bytes 90 to 91
  UINT16BE mkt : 1;                  // bytes 90 to 91
  UINT16BE on_stop : 1;              // bytes 90 to 91
  UINT16BE day : 1;                  // bytes 90 to 91
  UINT16BE gtc : 1;                  // bytes 90 to 91
  UINT16BE ioc : 1;                  // bytes 90 to 91
  UINT16BE aon : 1;                  // bytes 90 to 91
  UINT16BE mf : 1;                   // bytes 90 to 91
  UINT16BE matched_ind : 1;          // bytes 90 to 91
  UINT16BE traded : 1;               // bytes 90 to 91
  UINT16BE modified : 1;             // bytes 90 to 91
  UINT16BE frozen : 1;               // bytes 90 to 91
  UINT16BE preopen : 1;              // bytes 90 to 91
  UINT16BE reserved_3 : 1;           // bytes 90 to 91
  UINT16BE stpc : 1;                 // bytes 90 to 91
  UINT16BE reserved_1 : 1;           // bytes 90 to 91
  UINT16BE branch_id;                // bytes 92 to 93, signed, read here as unsigned
  UINT32BE second_user_id;           // bytes 94 to 97, signed, read here as unsigned
  UINT8 broker_id[5];                // bytes 98 to 102
  UINT8 suspended;                   // byte 103
  UINT8 settlor[12];                 // bytes 104 to 115
  UINT16BE pro_client;               // bytes 116 to 117, signed, read here as unsigned
  UINT16BE settlement_type;          // bytes 118 to 119, signed, read here as unsigned
  UINT8 nnf_field[8];                // bytes 120 to 127
  UINT32BE transaction_id;           // bytes 128 to 131, signed, read here as unsigned
  UINT8 pan[10];                     // bytes 132 to 141
  UINT32BE algo_id;                  // bytes 142 to 145, signed, read here as unsigned
  UINT8 reserved_2[2];               // bytes 146 to 147
  UINT64BE last_activity_reference;  // bytes 148 to 155, signed, read here as unsigned
  UINT8 reserved_24[24];             // bytes 156 to 179
} OrderModifyCancelRequestTrimmedMessage;

// Trimmed response to an order entry, modification or cancellation: a confirmation, a rejection, a price confirmation or an order error
typedef struct _OrderModifyCancelResponseTrimmedMessage {
  UINT16BE transaction_code;         // bytes 0 to 1, signed, read here as unsigned
  UINT32BE log_time;                 // bytes 2 to 5, signed, read here as unsigned
  UINT32BE user_id;                  // bytes 6 to 9, signed, read here as unsigned
  UINT16BE error_code;               // bytes 10 to 11, signed, read here as unsigned
  UINT64BE time_stamp_1;             // bytes 12 to 19, signed, read here as unsigned
  UINT8 time_stamp_2;                // byte 20
  UINT8 modified_cancelled_by;       // byte 21
  UINT16BE reason_code;              // bytes 22 to 23, signed, read here as unsigned
  SecInfo sec_info;                  // bytes 24 to 35
  UINT8 order_number[8];             // bytes 36 to 43
  UINT8 account_number[10];          // bytes 44 to 53
  UINT16BE book_type;                // bytes 54 to 55, signed, read here as unsigned
  UINT16BE buy_sell;                 // bytes 56 to 57, signed, read here as unsigned
  UINT32BE disclosed_vol;            // bytes 58 to 61, signed, read here as unsigned
  UINT32BE disclosed_vol_remaining;  // bytes 62 to 65, signed, read here as unsigned
  UINT32BE total_vol_remaining;      // bytes 66 to 69, signed, read here as unsigned
  UINT32BE volume;                   // bytes 70 to 73, signed, read here as unsigned
  UINT32BE volume_filled_today;      // bytes 74 to 77, signed, read here as unsigned
  UINT32BE price;                    // bytes 78 to 81, signed, read here as unsigned
  UINT32BE entry_date_time;          // bytes 82 to 85, signed, read here as unsigned
  UINT32BE last_modified;            // bytes 86 to 89, signed, read here as unsigned
  UINT16BE ato : 1;                  // bytes 90 to 91
  UINT16BE mkt : 1;                  // bytes 90 to 91
  UINT16BE on_stop : 1;              // bytes 90 to 91
  UINT16BE day : 1;                  // bytes 90 to 91
  UINT16BE gtc : 1;                  // bytes 90 to 91
  UINT16BE ioc : 1;                  // bytes 90 to 91
  UINT16BE aon : 1;                  // bytes 90 to 91
  UINT16BE mf : 1;                   // bytes 90 to 91
  UINT16BE matched_ind : 1;          // bytes 90 to 91
  UINT16BE traded : 1;               // bytes 90 to 91
  UINT16BE modified : 1;             // bytes 90 to 91
  UINT16BE frozen : 1;               // bytes 90 to 91
  UINT16BE preopen : 1;              // bytes 90 to 91
  UINT16BE reserved_3 : 1;           // bytes 90 to 91
  UINT16BE stpc : 1;                 // bytes 90 to 91
  UINT16BE reserved_1 : 1;           // bytes 90 to 91
  UINT16BE branch_id;                // bytes 92 to 93, signed, read here as unsigned
  UINT32BE second_user_id;           // bytes 94 to 97, signed, read here as unsigned
  UINT8 broker_id[5];                // bytes 98 to 102
  UINT8 suspended;                   // byte 103
  UINT8 settlor[12];                 // bytes 104 to 115
  UINT16BE pro_client;               // bytes 116 to 117, signed, read here as unsigned
  UINT16BE settlement_type;          // bytes 118 to 119, signed, read here as unsigned
  UINT8 nnf_field[8];                // bytes 120 to 127
  UINT32BE transaction_id;           // bytes 128 to 131, signed, read here as unsigned
  UINT64BE timestamp;                // bytes 132 to 139, signed, read here as unsigned
  UINT8 pan[10];                     // bytes 140 to 149
  UINT32BE algo_id;                  // bytes 150 to 153, signed, read here as unsigned
  UINT8 reserved_2[2];               // bytes 154 to 155
  UINT64BE last_activity_reference;  // bytes 156 to 163, signed, read here as unsigned
  UINT8 reserved_52[52];             // bytes 164 to 215
} OrderModifyCancelResponseTrimmedMessage;

// Trimmed trade confirmation, sent when an order of a trimmed book type trades
typedef struct _TradeConfirmationTrimmedMessage {
  UINT16BE transaction_code;         // bytes 0 to 1, signed, read here as unsigned
  UINT32BE log_time;                 // bytes 2 to 5, signed, read here as unsigned
  UINT32BE user_id;                  // bytes 6 to 9, signed, read here as unsigned
  UINT64BE timestamp;                // bytes 10 to 17, signed, read here as unsigned
  UINT8 time_stamp_1_char[8];        // bytes 18 to 25
  UINT8 response_order_number[8];    // bytes 26 to 33
  UINT8 time_stamp_2;                // byte 34
  UINT8 broker_id[5];                // bytes 35 to 39
  UINT32BE trader_num;               // bytes 40 to 43, signed, read here as unsigned
  UINT16BE buy_sell;                 // bytes 44 to 45, signed, read here as unsigned
  UINT8 account_num[10];             // bytes 46 to 55
  UINT32BE original_vol;             // bytes 56 to 59, signed, read here as unsigned
  UINT32BE disclosed_vol;            // bytes 60 to 63, signed, read here as unsigned
  UINT32BE remaining_vol;            // bytes 64 to 67, signed, read here as unsigned
  UINT32BE disclosed_vol_remaining;  // bytes 68 to 71, signed, read here as unsigned
  UINT32BE price;                    // bytes 72 to 75, signed, read here as unsigned
  UINT16BE ato : 1;                  // bytes 76 to 77
  UINT16BE mkt : 1;                  // bytes 76 to 77
  UINT16BE on_stop : 1;              // bytes 76 to 77
  UINT16BE day : 1;                  // bytes 76 to 77
  UINT16BE gtc : 1;                  // bytes 76 to 77
  UINT16BE ioc : 1;                  // bytes 76 to 77
  UINT16BE aon : 1;                  // bytes 76 to 77
  UINT16BE mf : 1;                   // bytes 76 to 77
  UINT16BE matched_ind : 1;          // bytes 76 to 77
  UINT16BE traded : 1;               // bytes 76 to 77
  UINT16BE modified : 1;             // bytes 76 to 77
  UINT16BE frozen : 1;               // bytes 76 to 77
  UINT16BE preopen : 1;              // bytes 76 to 77
  UINT16BE reserved_3 : 1;           // bytes 76 to 77
  UINT16BE stpc : 1;                 // bytes 76 to 77
  UINT16BE reserved_1 : 1;           // bytes 76 to 77
  UINT32BE fill_number;              // bytes 78 to 81, signed, read here as unsigned
  UINT32BE fill_qty;                 // bytes 82 to 85, signed, read here as unsigned
  UINT32BE fill_price;               // bytes 86 to 89, signed, read here as unsigned
  UINT32BE vol_filled_today;         // bytes 90 to 93, signed, read here as unsigned
  UINT8 activity_type[2];            // bytes 94 to 95
  UINT32BE activity_time;            // bytes 96 to 99, signed, read here as unsigned
  SecInfo sec_info;                  // bytes 100 to 111
  UINT16BE book_type;                // bytes 112 to 113, signed, read here as unsigned
  UINT16BE pro_client;               // bytes 114 to 115, signed, read here as unsigned
  UINT8 pan[10];                     // bytes 116 to 125
  UINT32BE algo_id;                  // bytes 126 to 129, signed, read here as unsigned
  UINT8 reserved_2[2];               // bytes 130 to 131
  UINT64BE last_activity_reference;  // bytes 132 to 139, signed, read here as unsigned
  UINT8 reserved_52[52];             // bytes 140 to 191
} TradeConfirmationTrimmedMessage;

// Immediate acknowledgement of a trimmed order entry, modification or cancellation request, answered on the separate port of the gateway router server
typedef struct _QuickAcknowledgementMessage {
  UINT16BE transaction_code;  // bytes 0 to 1, signed, read here as unsigned
  UINT32BE trader_id;         // bytes 2 to 5, signed, read here as unsigned
  UINT64BE timestamp;         // bytes 6 to 13, signed, read here as unsigned
  UINT32BE reference;         // bytes 14 to 17, signed, read here as unsigned
  UINT16BE error_code;        // bytes 18 to 19, signed, read here as unsigned
  UINT16BE message_length;    // bytes 20 to 21, signed, read here as unsigned
} QuickAcknowledgementMessage;

// Branch
casetype _MessagePayload (UINT16 selector) {
  switch (selector) {
    case 0x4E20: OrderEntryRequestTrimmedMessage order_entry_request_trimmed_message;
    case 0x4FB0: OrderEntryRequestTrimmedMessage order_entry_request_trimmed_message_2;
    case 0x4E48: OrderModifyCancelRequestTrimmedMessage order_modify_cancel_request_trimmed_message;
    case 0x4E66: OrderModifyCancelRequestTrimmedMessage order_modify_cancel_request_trimmed_message_2;
    case 0x4FB2: OrderModifyCancelRequestTrimmedMessage order_modify_cancel_request_trimmed_message_3;
    case 0x4FB4: OrderModifyCancelRequestTrimmedMessage order_modify_cancel_request_trimmed_message_4;
    case 0x4E2C: OrderModifyCancelResponseTrimmedMessage order_modify_cancel_response_trimmed_message;
    case 0x4E4A: OrderModifyCancelResponseTrimmedMessage order_modify_cancel_response_trimmed_message_2;
    case 0x4E68: OrderModifyCancelResponseTrimmedMessage order_modify_cancel_response_trimmed_message_3;
    case 0x4E69: OrderModifyCancelResponseTrimmedMessage order_modify_cancel_response_trimmed_message_4;
    case 0x4E6A: OrderModifyCancelResponseTrimmedMessage order_modify_cancel_response_trimmed_message_5;
    case 0x4E6B: OrderModifyCancelResponseTrimmedMessage order_modify_cancel_response_trimmed_message_6;
    case 0x4F07: OrderModifyCancelResponseTrimmedMessage order_modify_cancel_response_trimmed_message_7;
    case 0x4EFE: TradeConfirmationTrimmedMessage trade_confirmation_trimmed_message;
    case 0x4FB1: QuickAcknowledgementMessage quick_acknowledgement_message;
    case 0x4FB3: QuickAcknowledgementMessage quick_acknowledgement_message_2;
    case 0x4FB5: QuickAcknowledgementMessage quick_acknowledgement_message_3;
  }
} MessagePayload;

// Nnf trimmed message
typedef struct _Message {
  UINT16BE transaction_code;                         // bytes 0 to 1, signed, read here as unsigned
  MessagePayload(transaction_code) message_payload;
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// NnfTrimmed Tcp block of one or more messages
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

