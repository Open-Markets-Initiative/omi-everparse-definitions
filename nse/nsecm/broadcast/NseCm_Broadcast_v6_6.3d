// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NseCm_Broadcast_v6_6.3d
//
// What this definition does not state, and the model does:
// - a run counted by a field
// - a Conversion rule
// - a field read in bits
// - a Composite rule
// - a run of a stated number of entries
// - the packet as a whole, which is a Conversion rule, at packet.bcastpackdata.packedpacket.broadcastdata

// ---- Values ------------------------------------------------------------------

// Transaction Code: 2 byte code
#define TRANSACTION_CODE_BROADCAST_JOURNAL_VCT_MESSAGE 0x1965                // Broadcast Journal Vct Message
#define TRANSACTION_CODE_SECURITY_MASTER_CHANGE_MESSAGE 0x4920               // Security Master Change Message
#define TRANSACTION_CODE_PARTICIPANT_MASTER_CHANGE_MESSAGE 0x1C8A            // Participant Master Change Message
#define TRANSACTION_CODE_SECURITY_STATUS_CHANGE_MESSAGE 0x46D2               // Security Status Change Message
#define TRANSACTION_CODE_SECURITY_STATUS_CHANGE_PREOPEN_MESSAGE 0x4913       // Security Status Change Preopen Message
#define TRANSACTION_CODE_TURNOVER_EXCEEDED_MESSAGE 0x2332                    // Turnover Exceeded Message
#define TRANSACTION_CODE_BROKER_REACTIVATED_MESSAGE 0x2333                   // Broker Reactivated Message
#define TRANSACTION_CODE_AUCTION_INQUIRY_MESSAGE 0x490C                      // Auction Inquiry Message
#define TRANSACTION_CODE_AUCTION_STATUS_CHANGE_MESSAGE 0x19B5                // Auction Status Change Message
#define TRANSACTION_CODE_PREOPEN_SHUTDOWN_MESSAGE 0x1983                     // Preopen Shutdown Message
#define TRANSACTION_CODE_PREOPEN_MARKET_ORDER_RESTRICTED_MESSAGE 0x1A08      // Preopen Market Order Restricted Message
#define TRANSACTION_CODE_NORMAL_MARKET_PREOPEN_ENDED_MESSAGE 0x19AB          // Normal Market Preopen Ended Message
#define TRANSACTION_CODE_MARKET_OPEN_MESSAGE 0x196F                          // Market Open Message
#define TRANSACTION_CODE_CTS_CLOSE_FOR_CAS_MESSAGE 0x19FB                    // Cts Close For Cas Message
#define TRANSACTION_CODE_REVISED_PRICE_BAND_COMPLETED_MESSAGE 0x19FC         // Revised Price Band Completed Message
#define TRANSACTION_CODE_CAS_START_MESSAGE 0x19FD                            // Cas Start Message
#define TRANSACTION_CODE_MARKET_ORDER_RESTRICTED_MESSAGE 0x19FE              // Market Order Restricted Message
#define TRANSACTION_CODE_CAS_END_MESSAGE 0x19FF                              // Cas End Message
#define TRANSACTION_CODE_MARKET_CLOSE_MESSAGE 0x1979                         // Market Close Message
#define TRANSACTION_CODE_CLOSING_START_MESSAGE 0x19B7                        // Closing Start Message
#define TRANSACTION_CODE_CLOSING_END_MESSAGE 0x19B8                          // Closing End Message
#define TRANSACTION_CODE_SYMBOL_STATUS_CHANGE_ACTION_MESSAGE 0x1E54          // Symbol Status Change Action Message
#define TRANSACTION_CODE_TICKER_AND_MARKET_INDEX_MESSAGE 0x490F              // Ticker And Market Index Message
#define TRANSACTION_CODE_MARKET_BY_ORDER_AND_MARKET_BY_PRICE_MESSAGE 0x1C20  // Market By Order And Market By Price Message
#define TRANSACTION_CODE_ONLY_MARKET_BY_PRICE_MESSAGE 0x1C28                 // Only Market By Price Message
#define TRANSACTION_CODE_MARKET_WATCH_ROUND_ROBIN_MESSAGE 0x1C21             // Market Watch Round Robin Message
#define TRANSACTION_CODE_CALL_AUCTION_MARKET_BY_PRICE_MESSAGE 0x1C2E         // Call Auction Market By Price Message
#define TRANSACTION_CODE_CALL_AUCTION_MARKET_WATCH_MESSAGE 0x1C2F            // Call Auction Market Watch Message
#define TRANSACTION_CODE_SECURITY_OPEN_PRICE_MESSAGE 0x177D                  // Security Open Price Message
#define TRANSACTION_CODE_CIRCUIT_CHECK_MESSAGE 0x198D                        // Circuit Check Message
#define TRANSACTION_CODE_INDICES_MESSAGE 0x1C27                              // Indices Message
#define TRANSACTION_CODE_INDICATIVE_INDICES_MESSAGE 0x200F                   // Indicative Indices Message
#define TRANSACTION_CODE_INDICES_VIX_MESSAGE 0x1C30                          // Indices Vix Message
#define TRANSACTION_CODE_INDUSTRY_INDICES_MESSAGE 0x1C23                     // Industry Indices Message
#define TRANSACTION_CODE_BUY_BACK_MESSAGE 0x4914                             // Buy Back Message
#define TRANSACTION_CODE_CALL_AUCTION_ORDER_CANCEL_UPDATE_MESSAGE 0x1C2A     // Call Auction Order Cancel Update Message
#define TRANSACTION_CODE_CAS_REFERENCE_PRICE_MESSAGE 0x1CAA                  // Cas Reference Price Message

// Participant Status: one byte code
#define PARTICIPANT_STATUS_SUSPENDED 0x53  // Suspended
#define PARTICIPANT_STATUS_ACTIVE 0x41     // Active

// Warning Type: 2 byte code
#define WARNING_TYPE_TURNOVER_LIMIT_ABOUT_TO_BE_EXCEEDED 0x0001                 // Turnover Limit About To Be Exceeded
#define WARNING_TYPE_TURNOVER_LIMIT_EXCEEDED_AND_THE_BROKER_DEACTIVATED 0x0002  // Turnover Limit Exceeded And The Broker Deactivated

// Market Type: 2 byte code
#define MARKET_TYPE_NORMAL 0x0001            // Normal
#define MARKET_TYPE_ODD_LOT 0x0002           // Odd Lot
#define MARKET_TYPE_SPOT 0x0003              // Spot
#define MARKET_TYPE_AUCTION 0x0004           // Auction
#define MARKET_TYPE_CALL_AUCTION_ONE 0x0005  // Call Auction One
#define MARKET_TYPE_CALL_AUCTION_TWO 0x0006  // Call Auction Two

// Action Code Short: 2 byte code
#define ACTION_CODE_SHORT_SECURITY_PREOPENED 0x1983                                                                // Security Preopened
#define ACTION_CODE_SHORT_SECURITY_PREOPEN_PERIOD_ENDED 0x19AB                                                     // Security Preopen Period Ended
#define ACTION_CODE_SHORT_SECURITY_OPENED 0x196F                                                                   // Security Opened
#define ACTION_CODE_SHORT_SECURITY_CLOSED 0x1979                                                                   // Security Closed
#define ACTION_CODE_SHORT_SECURITY_CLOSING_SESSION_OPENED 0x19B7                                                   // Security Closing Session Opened
#define ACTION_CODE_SHORT_SECURITY_CLOSING_SESSION_CLOSED 0x19B8                                                   // Security Closing Session Closed
#define ACTION_CODE_SHORT_NORMAL_MARKET_CLOSED_FOR_SECURITIES_PARTICIPATING_IN_THE_CLOSING_AUCTION_SESSION 0x19FB  // Normal Market Closed For Securities Participating In The Closing Auction Session
#define ACTION_CODE_SHORT_PRICE_BAND_OF_SECURITIES_REVISED_FOR_THE_CLOSING_AUCTION_SESSION 0x19FC                  // Price Band Of Securities Revised For The Closing Auction Session
#define ACTION_CODE_SHORT_CLOSING_AUCTION_SESSION_STARTED 0x19FD                                                   // Closing Auction Session Started
#define ACTION_CODE_SHORT_MARKET_ORDERS_RESTRICTED_FOR_THE_CLOSING_AUCTION_SESSION 0x19FE                          // Market Orders Restricted For The Closing Auction Session
#define ACTION_CODE_SHORT_CLOSING_AUCTION_SESSION_ENDED 0x19FF                                                     // Closing Auction Session Ended

// ---- Bcast Header: 40 bytes --------------------------------------------------

// BCAST_HEADER
entrypoint typedef struct _BcastHeader {
  UINT8 reserved_0[2];        // bytes 0 to 1
  UINT8 reserved_2[2];        // bytes 2 to 3
  UINT32BE log_time;          // bytes 4 to 7, signed, read here as unsigned
  UINT8 alpha_char[2];        // bytes 8 to 9
  UINT16BE transaction_code;  // bytes 10 to 11, values TRANSACTION_CODE_, signed, read here as unsigned
  UINT16BE error_code;        // bytes 12 to 13, signed, read here as unsigned
  UINT32BE bc_seq_no;         // bytes 14 to 17, signed, read here as unsigned
  UINT8 reserved_18;          // byte 18
  UINT8 reserved_19[3];       // bytes 19 to 21
  UINT8 time_stamp_2[8];      // bytes 22 to 29
  UINT8 filler_2[8];          // bytes 30 to 37
  UINT16BE message_length;    // bytes 38 to 39, signed, read here as unsigned
} BcastHeader;

// ---- Sec Info: 12 bytes ------------------------------------------------------

// SEC_INFO
entrypoint typedef struct _SecInfo {
  UINT8 symbol[10];  // bytes 0 to 9
  UINT8 series[2];   // bytes 10 to 11
} SecInfo;

// ---- Participant Master Change Message: 44 bytes -----------------------------

// Sent whenever there is any participant change
entrypoint typedef struct _ParticipantMasterChangeMessage {
  UINT8 participant_id[12];               // bytes 0 to 11
  UINT8 participant_name[25];             // bytes 12 to 36
  UINT8 participant_status;               // byte 37, values PARTICIPANT_STATUS_
  UINT32BE participant_update_date_time;  // bytes 38 to 41, signed, read here as unsigned
  UINT8 delete_flag;                      // byte 42
  UINT8 reserved_1;                       // byte 43
} ParticipantMasterChangeMessage;

// ---- Turnover Exceeded Message: 37 bytes -------------------------------------

// Sent when a broker turnover is about to exceed or has already exceeded the limit, deactivating the broker
entrypoint typedef struct _TurnoverExceededMessage {
  UINT8 broker_code[5];          // bytes 0 to 4
  UINT8 counter_broker_code[5];  // bytes 5 to 9
  UINT16BE warning_type;         // bytes 10 to 11, values WARNING_TYPE_, signed, read here as unsigned
  SecInfo sec_info;              // bytes 12 to 23
  UINT32BE trade_number;         // bytes 24 to 27, signed, read here as unsigned
  UINT32BE trade_price;          // bytes 28 to 31, signed, read here as unsigned
  UINT32BE trade_volume;         // bytes 32 to 35, signed, read here as unsigned
  UINT8 final;                   // byte 36
} TurnoverExceededMessage;

// ---- Broker Reactivated Message: 37 bytes ------------------------------------

// Sent when a broker is reactivated after being deactivated
entrypoint typedef struct _BrokerReactivatedMessage {
  UINT8 broker_code[5];          // bytes 0 to 4
  UINT8 counter_broker_code[5];  // bytes 5 to 9
  UINT16BE warning_type;         // bytes 10 to 11, values WARNING_TYPE_, signed, read here as unsigned
  SecInfo sec_info;              // bytes 12 to 23
  UINT32BE trade_number;         // bytes 24 to 27, signed, read here as unsigned
  UINT32BE trade_price;          // bytes 28 to 31, signed, read here as unsigned
  UINT32BE trade_volume;         // bytes 32 to 35, signed, read here as unsigned
  UINT8 final;                   // byte 36
} BrokerReactivatedMessage;

// ---- St Auction Inq Info: 36 bytes -------------------------------------------

// ST_AUCTION_INQ_INFO
entrypoint typedef struct _StAuctionInqInfo {
  UINT32BE token;              // bytes 0 to 3, signed, read here as unsigned
  UINT16BE auction_number;     // bytes 4 to 5, signed, read here as unsigned
  UINT16BE auction_status;     // bytes 6 to 7, signed, read here as unsigned
  UINT16BE initiator_type;     // bytes 8 to 9, signed, read here as unsigned
  UINT32BE total_buy_qty;      // bytes 10 to 13, signed, read here as unsigned
  UINT32BE best_buy_price;     // bytes 14 to 17, signed, read here as unsigned
  UINT32BE total_sell_qty;     // bytes 18 to 21, signed, read here as unsigned
  UINT32BE best_sell_price;    // bytes 22 to 25, signed, read here as unsigned
  UINT32BE auction_price;      // bytes 26 to 29, signed, read here as unsigned
  UINT32BE auction_qty;        // bytes 30 to 33, signed, read here as unsigned
  UINT16BE settlement_period;  // bytes 34 to 35, signed, read here as unsigned
} StAuctionInqInfo;

// ---- Auction Inquiry Message: 36 bytes ---------------------------------------

// Sent whenever there is any auction related activity, including a change in the auction market by order
entrypoint typedef struct _AuctionInquiryMessage {
  StAuctionInqInfo st_auction_inq_info;  // bytes 0 to 35
} AuctionInquiryMessage;

// ---- Symbol Status Change Action Message: 18 bytes ---------------------------

// Carries a security level trading or market status change
entrypoint typedef struct _SymbolStatusChangeActionMessage {
  SecInfo sec_info;            // bytes 0 to 11
  UINT16BE market_type;        // bytes 12 to 13, values MARKET_TYPE_, signed, read here as unsigned
  UINT8 reserved_2[2];         // bytes 14 to 15
  UINT16BE action_code_short;  // bytes 16 to 17, values ACTION_CODE_SHORT_, signed, read here as unsigned
} SymbolStatusChangeActionMessage;

// ---- Security Open Price Message: 18 bytes -----------------------------------

// Carries the open price of a security when the market opens. The document states this transaction code is not sent by the exchange
entrypoint typedef struct _SecurityOpenPriceMessage {
  SecInfo sec_info;        // bytes 0 to 11
  UINT16BE token_short;    // bytes 12 to 13, signed, read here as unsigned
  UINT32BE opening_price;  // bytes 14 to 17, signed, read here as unsigned
} SecurityOpenPriceMessage;

