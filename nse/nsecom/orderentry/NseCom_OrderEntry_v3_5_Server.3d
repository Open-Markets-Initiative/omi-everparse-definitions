// Branch
casetype _ServerMessagePayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0641: SystemInformationOutMessage system_information_out_message;
    case 0x1C99: PartialSystemInformationMessage partial_system_information_message;
    case 0x071D: OpenOrderReportMessage open_order_report_message;
    case 0x07C8: SpreadOrderLogReportMessage spread_order_log_report_message;
    case 0x07C9: SpreadTradeReportMessage spread_trade_report_message;
    case 0x07D1: BoardLotOutMessage board_lot_out_message;
    case 0x07D8: NegOrderToBlMessage neg_order_to_bl_message;
    case 0x07F9: OrderModOutMessage order_mod_out_message;
    case 0x07FA: OrderModRejectMessage order_mod_reject_message;
    case 0x0817: OrderCancelOutMessage order_cancel_out_message;
    case 0x0818: OrderCancelRejectMessage order_cancel_reject_message;
    case 0x0819: OrderConfirmationMessage order_confirmation_message;
    case 0x081A: OrderModConfirmationMessage order_mod_confirmation_message;
    case 0x081B: OrderCancelConfirmationMessage order_cancel_confirmation_message;
    case 0x081C: CancelNegOrderMessage cancel_neg_order_message;
    case 0x087A: FreezeToControlMessage freeze_to_control_message;
    case 0x08B7: OrderErrorMessage order_error_message;
    case 0x232A: BatchOrderCancelMessage batch_order_cancel_message;
    case 0x0835: SpBoardLotOutMessage sp_board_lot_out_message;
    case 0x0837: TwolBoardLotOutMessage twol_board_lot_out_message;
    case 0x0839: ThrlBoardLotOutMessage thrl_board_lot_out_message;
    case 0x083B: SpOrderCancelOutMessage sp_order_cancel_out_message;
    case 0x0847: SpOrderModOutMessage sp_order_mod_out_message;
    case 0x084C: SpOrderConfirmationMessage sp_order_confirmation_message;
    case 0x084D: TwolOrderConfirmationMessage twol_order_confirmation_message;
    case 0x084E: ThrlOrderConfirmationMessage thrl_order_confirmation_message;
    case 0x084F: SpOrderCxlRejOutMessage sp_order_cxl_rej_out_message;
    case 0x0852: SpOrderCxlConfirmationMessage sp_order_cxl_confirmation_message;
    case 0x0853: TwolOrderCxlConfirmationMessage twol_order_cxl_confirmation_message;
    case 0x0854: ThrlOrderCxlConfirmationMessage thrl_order_cxl_confirmation_message;
    case 0x0855: SpOrderModRejOutMessage sp_order_mod_rej_out_message;
    case 0x0858: SpOrderModConOutMessage sp_order_mod_con_out_message;
    case 0x086B: TwolOrderErrorMessage twol_order_error_message;
    case 0x086C: ThrlOrderErrorMessage thrl_order_error_message;
    case 0x08A4: OnStopNotificationMessage on_stop_notification_message;
    case 0x08AE: TradeConfirmationMessage trade_confirmation_message;
    case 0x08EA: TradeCancelConfirmMessage trade_cancel_confirm_message;
    case 0x08EE: TradeCancelRejectMessage trade_cancel_reject_message;
    case 0x08F0: TradeModifyRejectMessage trade_modify_reject_message;
    case 0x08AF: TradeErrorMessage trade_error_message;
    case 0x1541: TradeCancelOutMessage trade_cancel_out_message;
    case 0x08EF: TradeModifyConfirmMessage trade_modify_confirm_message;
    case 0x08FD: SignOnRequestOutMessage sign_on_request_out_message;
    case 0x15D1: SignOffTraderOutMessage sign_off_trader_out_message;
    case 0x08FE: ErrorResponseOutMessage error_response_out_message;
    case 0x0961: GrResponseMessage gr_response_message;
    case 0x1534: UserAddrUnlockConfirmOutMessage user_addr_unlock_confirm_out_message;
    case 0x156B: UserAddrUnlockApproveOutMessage user_addr_unlock_approve_out_message;
    case 0x156C: UserAddrUnlockRejectOutMessage user_addr_unlock_reject_out_message;
    case 0x1655: BranchOrdValLimitUpdateOuMessage branch_ord_val_limit_update_ou_message;
    case 0x1663: UserOrderLimitUpdateOutMessage user_order_limit_update_out_message;
    case 0x1665: DealerLimitUpdateOutMessage dealer_limit_update_out_message;
    case 0x166D: ResetUserPasswordOutMessage reset_user_password_out_message;
    case 0x1671: ColUserStatusChangeOutMessage col_user_status_change_out_message;
    case 0x168C: SpdOrdLimitUpdateOutMessage spd_ord_limit_update_out_message;
    case 0x1B63: unit header_record_message;
    case 0x1B6D: unit message_record_message;
    case 0x1B77: unit trailer_record_message;
    case 0x1C8B: UpdateLocaldbHeaderMessage update_localdb_header_message;
    case 0x1C8C: UpdateLocaldbTrailerMessage update_localdb_trailer_message;
    case 0x1C9D: BcastAssetMstrChgMessage bcast_asset_mstr_chg_message;
    case 0x59D9: BoxSignOnRequestOutMessage box_sign_on_request_out_message;
    case 0x59E1: unit secure_box_registration_response_out_message;
    case 0x4F62: BoxSignOffMessage box_sign_off_message;
    default: UINT8 unknown[available];
  }
} ServerMessagePayload;

// Nnf interactive message sent by the exchange
typedef struct _ServerMessage {
  UINT16BE transaction_code;                                                                                                                                          // bytes 0 to 1, signed, read here as unsigned
  UINT32BE log_time;                                                                                                                                                  // bytes 2 to 5, signed, read here as unsigned
  UINT8 alpha_char[2];                                                                                                                                                // bytes 6 to 7
  UINT32BE trader_id;                                                                                                                                                 // bytes 8 to 11, signed, read here as unsigned
  UINT16BE error_code;                                                                                                                                                // bytes 12 to 13, signed, read here as unsigned
  UINT64BE header_timestamp;                                                                                                                                          // bytes 14 to 21, signed, read here as unsigned
  UINT8 time_stamp_1[8];                                                                                                                                              // bytes 22 to 29
  UINT8 time_stamp_2[8];                                                                                                                                              // bytes 30 to 37
  UINT16BE message_length { message_length >= 40 };                                                                                                                   // bytes 38 to 39, signed, read here as unsigned
  ServerMessagePayload(transaction_code, (((UINT32) message_length) - 40)) server_message_payload[:byte-size-single-element-array (((UINT32) message_length) - 40)];
} ServerMessage;

// ---- Packet: ServerPacket ----------------------------------------------------

// Nnf Tcp block of one or more messages sent by the exchange
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerMessage server_message[:byte-size available];
} ServerPacket;

