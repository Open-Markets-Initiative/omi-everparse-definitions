// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NseCom_DropCopy_v1_5_Client.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - a Integrity rule
// - a Composite rule
// - the dispatch that chooses a message by its type
// - the packet as a whole, which is an arm not leading with what the choice is made on, at clientpacket.clientdirectpacket.clientpacketbody.clientsessionpacket

// ---- Values ------------------------------------------------------------------

// Transaction Code: 2 byte code
#define TRANSACTION_CODE_SIGNON_IN_MESSAGE 0x08FC              // Signon In Message
#define TRANSACTION_CODE_SIGN_ON_OUT_MESSAGE 0x08FD            // Sign On Out Message
#define TRANSACTION_CODE_HEARTBEAT_MESSAGE 0x5BD2              // Heartbeat Message
#define TRANSACTION_CODE_DC_DOWNLOAD_REQUEST_MESSAGE 0x1F40    // Dc Download Request Message
#define TRANSACTION_CODE_TRADE_CONFIRMATION_MESSAGE 0x08AE     // Trade Confirmation Message
#define TRANSACTION_CODE_TRADE_CANCEL_CONFIRM_MESSAGE 0x08EA   // Trade Cancel Confirm Message
#define TRANSACTION_CODE_TRADE_CANCEL_REJECT_MESSAGE 0x08EE    // Trade Cancel Reject Message
#define TRANSACTION_CODE_TRADE_MODIFY_CONFIRM_MESSAGE 0x08EF   // Trade Modify Confirm Message
#define TRANSACTION_CODE_TRADE_MODIFY_REJECT_MESSAGE 0x08F0    // Trade Modify Reject Message
#define TRANSACTION_CODE_GIVEUP_APP_CONFIRM_TM_MESSAGE 0x119A  // Giveup App Confirm Tm Message
#define TRANSACTION_CODE_GIVEUP_REJ_CONFIRM_TM_MESSAGE 0x119B  // Giveup Rej Confirm Tm Message

// ---- Packet Header: 6 bytes --------------------------------------------------

// Packet Length and Sequence number, the first six bytes of the direct interface's twenty two byte packet header; its last sixteen open each packet body branch
entrypoint typedef struct _PacketHeader {
  UINT16BE packet_length;           // bytes 0 to 1
  UINT32BE packet_sequence_number;  // bytes 2 to 5
} PacketHeader;

// ---- Message Header: 40 bytes ------------------------------------------------

// MESSAGE_HEADER
entrypoint typedef struct _MessageHeader {
  UINT16BE transaction_code;  // bytes 0 to 1, values TRANSACTION_CODE_, signed, read here as unsigned
  UINT32BE log_time;          // bytes 2 to 5, signed, read here as unsigned
  UINT8 alpha_char[2];        // bytes 6 to 7
  UINT32BE trader_id;         // bytes 8 to 11, signed, read here as unsigned
  UINT16BE error_code;        // bytes 12 to 13, signed, read here as unsigned
  UINT64BE header_timestamp;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 time_stamp_1[8];      // bytes 22 to 29
  UINT8 time_stamp_2[8];      // bytes 30 to 37
  UINT16BE message_length;    // bytes 38 to 39, signed, read here as unsigned
} MessageHeader;

// ---- Signon In Message: 238 bytes --------------------------------------------

// Logs the user on to the drop copy feed
entrypoint typedef struct _SignonInMessage {
  UINT32BE user_id;              // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_8[8];           // bytes 4 to 11
  UINT8 password[8];             // bytes 12 to 19
  UINT8 second_reserved_8[8];    // bytes 20 to 27
  UINT8 reserved_38[38];         // bytes 28 to 65
  UINT8 broker_id[5];            // bytes 66 to 70
  UINT8 reserved_119[119];       // bytes 71 to 189
  UINT8 reserved_16[16];         // bytes 190 to 205
  UINT8 second_reserved_16[16];  // bytes 206 to 221
  UINT8 third_reserved_16[16];   // bytes 222 to 237
} SignonInMessage;

