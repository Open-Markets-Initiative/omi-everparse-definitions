// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ServerPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NseCom_DropCopy_v1_5_Server.3d

// ---- Values ------------------------------------------------------------------

// Transaction Code: 2 byte code
#define TRANSACTION_CODE_SIGNON_IN_MESSAGE 0x08FC              // Signon In Message
#define TRANSACTION_CODE_SIGN_ON_OUT_MESSAGE 0x08FD            // Sign On Out Message
#define TRANSACTION_CODE_HEARTBEAT_MESSAGE 0x5BD2              // Heartbeat Message
#define TRANSACTION_CODE_DC_DOWNLOAD_REQUEST_MESSAGE 0x1F40    // Dc Download Request Message
#define TRANSACTION_CODE_TRADE_CONFIRMATION_MESSAGE 0x08AE     // Trade Confirmation Message
#define TRANSACTION_CODE_TRADE_CANCEL_CONFIRM_MESSAGE 0x08EA   // Trade Cancel Confirm Message
#define TRANSACTION_CODE_TRADE_CANCEL_REJECT_MESSAGE 0x08EE    // Trade Cancel Reject Message
#define TRANSACTION_CODE_TRADE_MODIFY_CONFIRM_MESSAGE 0x08EF   // Trade Modify Confirm Message
#define TRANSACTION_CODE_TRADE_MODIFY_REJECT_MESSAGE 0x08F0    // Trade Modify Reject Message
#define TRANSACTION_CODE_GIVEUP_APP_CONFIRM_TM_MESSAGE 0x119A  // Giveup App Confirm Tm Message
#define TRANSACTION_CODE_GIVEUP_REJ_CONFIRM_TM_MESSAGE 0x119B  // Giveup Rej Confirm Tm Message

// Buy Sell: 2 byte code
#define BUY_SELL_BUY_ORDER 0x0001   // Buy Order
#define BUY_SELL_SELL_ORDER 0x0002  // Sell Order

// Open Close: one byte code
#define OPEN_CLOSE_OPEN 0x4F   // Open
#define OPEN_CLOSE_CLOSE 0x43  // Close

// Book Type: 2 byte code
#define BOOK_TYPE_REGULAR_LOT_ORDER 0x0001          // Regular Lot Order
#define BOOK_TYPE_SPECIAL_TERMS_ORDER 0x0002        // Special Terms Order
#define BOOK_TYPE_STOP_LOSS_MIT_ORDER 0x0003        // Stop Loss Mit Order
#define BOOK_TYPE_NEGOTIATED_ORDER_NOT_USED 0x0004  // Negotiated Order Not Used
#define BOOK_TYPE_ODD_LOT_ORDER_NOT_USED 0x0005     // Odd Lot Order Not Used
#define BOOK_TYPE_SPOT_ORDER_NOT_USED 0x0006        // Spot Order Not Used
#define BOOK_TYPE_AUCTION_ORDER_NOT_USED 0x0007     // Auction Order Not Used

// ---- Types -------------------------------------------------------------------

// Confirms the logon. Alpha Char carries the number of streams the drop copy feed is sent from, one download request being needed per stream. On an error the same transaction code carries the Error Response layout instead, distinguished only by a non zero Error Code
typedef struct _SignOnOutMessage {
  UINT32BE user_id;              // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_8[8];           // bytes 4 to 11
  UINT8 password[8];             // bytes 12 to 19
  UINT8 second_reserved_8[8];    // bytes 20 to 27
  UINT8 reserved_38[38];         // bytes 28 to 65
  UINT8 broker_id[5];            // bytes 66 to 70
  UINT8 reserved_119[119];       // bytes 71 to 189
  UINT8 reserved_16[16];         // bytes 190 to 205
  UINT8 second_reserved_16[16];  // bytes 206 to 221
  UINT8 third_reserved_16[16];   // bytes 222 to 237
} SignOnOutMessage;

// CONTRACT_DESC
typedef struct _ContractDesc {
  UINT8 instrument_name[6];  // bytes 0 to 5
  UINT8 symbol[10];          // bytes 6 to 15
  UINT32BE expiry_date;      // bytes 16 to 19, signed, read here as unsigned
  UINT32BE strike_price;     // bytes 20 to 23, signed, read here as unsigned
  UINT8 option_type[2];      // bytes 24 to 25
  UINT16BE ca_level;         // bytes 26 to 27, signed, read here as unsigned
} ContractDesc;

// Confirms a trade
typedef struct _TradeConfirmationMessage {
  UINT8 response_order_number[8];                // bytes 0 to 7
  UINT8 broker_id[5];                            // bytes 8 to 12
  UINT8 reserved_1;                              // byte 13
  UINT32BE trader_num;                           // bytes 14 to 17, signed, read here as unsigned
  UINT8 account_num[10];                         // bytes 18 to 27
  UINT16BE buy_sell;                             // bytes 28 to 29, signed, read here as unsigned
  UINT32BE original_vol;                         // bytes 30 to 33, signed, read here as unsigned
  UINT32BE disclosed_vol;                        // bytes 34 to 37, signed, read here as unsigned
  UINT32BE remaining_vol;                        // bytes 38 to 41, signed, read here as unsigned
  UINT32BE disclosed_vol_remaining;              // bytes 42 to 45, signed, read here as unsigned
  UINT32BE price;                                // bytes 46 to 49, signed, read here as unsigned
  UINT16BE ato : 1;                              // bytes 50 to 51
  UINT16BE market : 1;                           // bytes 50 to 51
  UINT16BE sl : 1;                               // bytes 50 to 51
  UINT16BE mit : 1;                              // bytes 50 to 51
  UINT16BE day : 1;                              // bytes 50 to 51
  UINT16BE gtc : 1;                              // bytes 50 to 51
  UINT16BE ioc : 1;                              // bytes 50 to 51
  UINT16BE aon : 1;                              // bytes 50 to 51
  UINT16BE mf : 1;                               // bytes 50 to 51
  UINT16BE matched_ind : 1;                      // bytes 50 to 51
  UINT16BE traded : 1;                           // bytes 50 to 51
  UINT16BE modified : 1;                         // bytes 50 to 51
  UINT16BE frozen : 1;                           // bytes 50 to 51
  UINT16BE reserved_13 : 3;                      // bytes 50 to 51
  UINT32BE gtd;                                  // bytes 52 to 55, signed, read here as unsigned
  UINT32BE fill_number;                          // bytes 56 to 59, signed, read here as unsigned
  UINT32BE fill_qty;                             // bytes 60 to 63, signed, read here as unsigned
  UINT32BE fill_price;                           // bytes 64 to 67, signed, read here as unsigned
  UINT32BE vol_filled_today;                     // bytes 68 to 71, signed, read here as unsigned
  UINT8 activity_type[2];                        // bytes 72 to 73
  UINT32BE activity_time;                        // bytes 74 to 77, signed, read here as unsigned
  UINT8 op_order_number[8];                      // bytes 78 to 85
  UINT8 op_broker_id[5];                         // bytes 86 to 90
  UINT8 second_reserved_1;                       // byte 91
  UINT32BE token;                                // bytes 92 to 95, signed, read here as unsigned
  ContractDesc contract_desc;                    // bytes 96 to 123
  UINT8 open_close;                              // byte 124
  UINT8 old_open_close;                          // byte 125
  UINT8 trade_book_type;                         // byte 126
  UINT8 third_reserved_1;                        // byte 127
  UINT32BE new_volume;                           // bytes 128 to 131, signed, read here as unsigned
  UINT8 old_account_number[10];                  // bytes 132 to 141
  UINT8 participant[12];                         // bytes 142 to 153
  UINT8 old_participant[12];                     // bytes 154 to 165
  UINT8 additional_order_flags_reserved_1 : 1;   // byte 166
  UINT8 col : 1;                                 // byte 166
  UINT8 additional_order_flags_reserved_38 : 6;  // byte 166
  UINT8 fourth_reserved_1;                       // byte 167
  UINT8 give_up_trade;                           // byte 168
  UINT8 fifth_reserved_1;                        // byte 169
  UINT8 pan[10];                                 // bytes 170 to 179
  UINT8 old_pan[10];                             // bytes 180 to 189
  UINT32BE algo_id;                              // bytes 190 to 193, signed, read here as unsigned
  UINT8 reserved_2[2];                           // bytes 194 to 195
  UINT64BE last_activity_reference;              // bytes 196 to 203, signed, read here as unsigned
  UINT8 nnf_field[8];                            // bytes 204 to 211
  UINT8 reserved_44[44];                         // bytes 212 to 255
} TradeConfirmationMessage;

