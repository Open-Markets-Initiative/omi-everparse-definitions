  UINT8 instrument_name[6];          // bytes 14 to 19
  UINT8 symbol[10];                  // bytes 20 to 29
  UINT32BE expiry_date;              // bytes 30 to 33, signed, read here as unsigned
  UINT32BE strike_price;             // bytes 34 to 37, signed, read here as unsigned
  UINT8 option_type[2];              // bytes 38 to 39
  UINT16BE ca_level;                 // bytes 40 to 41, signed, read here as unsigned
  UINT32BE fill_volume;              // bytes 42 to 45, signed, read here as unsigned
  UINT32BE fill_price;               // bytes 46 to 49, signed, read here as unsigned
  UINT8 broker_id[5];                // bytes 50 to 54
  UINT8 filler;                      // byte 55
  UINT16BE buy_sell;                 // bytes 56 to 57, signed, read here as unsigned
  UINT16BE book_type;                // bytes 58 to 59, signed, read here as unsigned
  UINT32BE last_modified_date_time;  // bytes 60 to 63, signed, read here as unsigned
  UINT8 initiated_by_control;        // byte 64
