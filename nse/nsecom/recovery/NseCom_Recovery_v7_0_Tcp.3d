// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NseCom_Recovery_v7_0_Tcp.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_NEW_ORDER_MESSAGE 0x4E                    // New Order Message
#define MESSAGE_TYPE_ORDER_MODIFICATION_MESSAGE 0x4D           // Order Modification Message
#define MESSAGE_TYPE_ORDER_CANCELLATION_MESSAGE 0x58           // Order Cancellation Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x54                        // Trade Message
#define MESSAGE_TYPE_NEW_SPREAD_ORDER_MESSAGE 0x47             // New Spread Order Message
#define MESSAGE_TYPE_SPREAD_ORDER_MODIFICATION_MESSAGE 0x48    // Spread Order Modification Message
#define MESSAGE_TYPE_SPREAD_ORDER_CANCELLATION_MESSAGE 0x4A    // Spread Order Cancellation Message
#define MESSAGE_TYPE_SPREAD_TRADE_MESSAGE 0x4B                 // Spread Trade Message
#define MESSAGE_TYPE_TRADE_CANCEL_MESSAGE 0x43                 // Trade Cancel Message
#define MESSAGE_TYPE_HEARTBEAT_MESSAGE 0x5A                    // Heartbeat Message
#define MESSAGE_TYPE_TICK_DATA_RECOVERY_RESPONSE_MESSAGE 0x59  // Tick Data Recovery Response Message

// Order Type: one byte code
#define ORDER_TYPE_BUY_ORDER 0x42   // Buy Order
#define ORDER_TYPE_SELL_ORDER 0x53  // Sell Order

// Request Status: one byte code
#define REQUEST_STATUS_SUCCESS 0x53  // Success
#define REQUEST_STATUS_ERROR 0x45    // Error

// ---- Types -------------------------------------------------------------------

// For every new order request, this message is sent.
typedef struct _NewOrderMessage {
  UINT64 timestamp;   // bytes 0 to 7, signed, read here as unsigned
  UINT8 order_id[8];  // bytes 8 to 15
  UINT32 token;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 order_type;   // byte 20
  UINT32 price;       // bytes 21 to 24, signed, read here as unsigned
  UINT32 quantity;    // bytes 25 to 28, signed, read here as unsigned
} NewOrderMessage;

// For every order modification request, this message is sent.
typedef struct _OrderModificationMessage {
  UINT64 timestamp;   // bytes 0 to 7, signed, read here as unsigned
  UINT8 order_id[8];  // bytes 8 to 15
  UINT32 token;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 order_type;   // byte 20
  UINT32 price;       // bytes 21 to 24, signed, read here as unsigned
  UINT32 quantity;    // bytes 25 to 28, signed, read here as unsigned
} OrderModificationMessage;

// For every order cancellation request, this message is sent.
typedef struct _OrderCancellationMessage {
  UINT64 timestamp;   // bytes 0 to 7, signed, read here as unsigned
  UINT8 order_id[8];  // bytes 8 to 15
  UINT32 token;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 order_type;   // byte 20
  UINT32 price;       // bytes 21 to 24, signed, read here as unsigned
  UINT32 quantity;    // bytes 25 to 28, signed, read here as unsigned
} OrderCancellationMessage;

// This message is sent whenever an order in the order book gets executed fully or partially.
typedef struct _TradeMessage {
  UINT64 timestamp;        // bytes 0 to 7, signed, read here as unsigned
  UINT8 buy_order_id[8];   // bytes 8 to 15
  UINT8 sell_order_id[8];  // bytes 16 to 23
  UINT32 token;            // bytes 24 to 27, signed, read here as unsigned
  UINT32 trade_price;      // bytes 28 to 31, signed, read here as unsigned
  UINT32 trade_quantity;   // bytes 32 to 35, signed, read here as unsigned
} TradeMessage;

// FO and CD segments only. For every new spread order request, this message is sent.
typedef struct _NewSpreadOrderMessage {
  UINT64 timestamp;   // bytes 0 to 7, signed, read here as unsigned
  UINT8 order_id[8];  // bytes 8 to 15
  UINT32 token;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 order_type;   // byte 20
  UINT32 price;       // bytes 21 to 24, signed, read here as unsigned
  UINT32 quantity;    // bytes 25 to 28, signed, read here as unsigned
} NewSpreadOrderMessage;

// FO and CD segments only. For every spread order modification request, this message is sent.
typedef struct _SpreadOrderModificationMessage {
  UINT64 timestamp;   // bytes 0 to 7, signed, read here as unsigned
  UINT8 order_id[8];  // bytes 8 to 15
  UINT32 token;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 order_type;   // byte 20
  UINT32 price;       // bytes 21 to 24, signed, read here as unsigned
  UINT32 quantity;    // bytes 25 to 28, signed, read here as unsigned
} SpreadOrderModificationMessage;

// FO and CD segments only. For every spread order cancellation request, this message is sent.
typedef struct _SpreadOrderCancellationMessage {
  UINT64 timestamp;   // bytes 0 to 7, signed, read here as unsigned
  UINT8 order_id[8];  // bytes 8 to 15
  UINT32 token;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 order_type;   // byte 20
  UINT32 price;       // bytes 21 to 24, signed, read here as unsigned
  UINT32 quantity;    // bytes 25 to 28, signed, read here as unsigned
} SpreadOrderCancellationMessage;

// FO and CD segments only. This message is sent whenever a spread order in the order book gets executed fully or partially.
typedef struct _SpreadTradeMessage {
  UINT64 timestamp;        // bytes 0 to 7, signed, read here as unsigned
  UINT8 buy_order_id[8];   // bytes 8 to 15
  UINT8 sell_order_id[8];  // bytes 16 to 23
  UINT32 token;            // bytes 24 to 27, signed, read here as unsigned
  UINT32 trade_price;      // bytes 28 to 31, signed, read here as unsigned
  UINT32 quantity;         // bytes 32 to 35, signed, read here as unsigned
} SpreadTradeMessage;

// For CM and FO segments only. This message is sent whenever a Trade gets cancelled.
typedef struct _TradeCancelMessage {
  UINT64 timestamp;        // bytes 0 to 7, signed, read here as unsigned
  UINT8 buy_order_id[8];   // bytes 8 to 15
  UINT8 sell_order_id[8];  // bytes 16 to 23
  UINT32 token;            // bytes 24 to 27, signed, read here as unsigned
  UINT32 trade_price;      // bytes 28 to 31, signed, read here as unsigned
  UINT32 trade_quantity;   // bytes 32 to 35, signed, read here as unsigned
} TradeCancelMessage;

// Heartbeat message will be sent when there is no data available for a few seconds. Only applicable for UDP TBT multicast channels.
typedef struct _HeartbeatMessage {
  UINT32 last_sequence_no;  // bytes 0 to 3
} HeartbeatMessage;

// First message sent by the Recovery Server, indicating whether the request was processed successfully.
typedef struct _TickDataRecoveryResponseMessage {
  UINT8 request_status;  // byte 0
} TickDataRecoveryResponseMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x4E: NewOrderMessage new_order_message;
    case 0x4D: OrderModificationMessage order_modification_message;
    case 0x58: OrderCancellationMessage order_cancellation_message;
    case 0x54: TradeMessage trade_message;
    case 0x47: NewSpreadOrderMessage new_spread_order_message;
    case 0x48: SpreadOrderModificationMessage spread_order_modification_message;
    case 0x4A: SpreadOrderCancellationMessage spread_order_cancellation_message;
    case 0x4B: SpreadTradeMessage spread_trade_message;
    case 0x43: TradeCancelMessage trade_cancel_message;
    case 0x5A: HeartbeatMessage heartbeat_message;
    case 0x59: TickDataRecoveryResponseMessage tick_data_recovery_response_message;
    default: UINT8 unknown[available];
  }
} Payload;

// STREAM_DATA. First field is always Message Type and must be read/interpreted first.
typedef struct _Message (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                               // byte 0
  Payload(message_type, (available - 1)) payload[:byte-size-single-element-array (available - 1)];
} Message;

// Mtbt Tcp Packet. One STREAM_DATA message per packet, same framing as the multicast feed.
typedef struct _StreamPacket {
  UINT16 message_length { message_length >= 8 };     // bytes 0 to 1, signed, read here as unsigned
  UINT16 stream_id;                                  // bytes 2 to 3, signed, read here as unsigned
  UINT32 sequence_number;                            // bytes 4 to 7
  Message((((UINT32) message_length) - 8)) message;
} StreamPacket;

// ---- Packet: Packet ----------------------------------------------------------

// Mtbt Tcp Recovery root. The stream carries Stream-Header framed packets back to back.
entrypoint typedef struct _Packet (UINT32 available) {
  StreamPacket stream_packet[:byte-size available];
} Packet;

