// Sent as CTRL_MSG_TO_TRADER for a message from NSE-Control to a particular user, and for a counter party's trade cancellation request
typedef struct _ControlMessageToTraderMessage {
  UINT32BE trader_id;    // bytes 0 to 3, signed, read here as unsigned
  UINT8 action_code[3];  // bytes 4 to 6
  UINT8 reserved_1;      // byte 7
  UINT16BE msg_length;   // bytes 8 to 9, signed, read here as unsigned
  UINT8 msg[239];        // bytes 10 to 248
} ControlMessageToTraderMessage;

// Sent as ERROR_RESPONSE_OUT when the Error Code of the header is not zero
typedef struct _ErrorResponseMessage {
  SecInfo sec_info;          // bytes 0 to 11
  UINT8 error_message[128];  // bytes 12 to 139
} ErrorResponseMessage;

// Sent as GR_RESPONSE with the allocated gateway server, its session key and the cryptographic key and vector
typedef struct _GatewayRouterResponseMessage {
  UINT16BE box_id;                                   // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];                                // bytes 2 to 6
  UINT8 filler;                                      // byte 7
  UINT8 ip_address[16];                              // bytes 8 to 23
  UINT32BE port;                                     // bytes 24 to 27, signed, read here as unsigned
  UINT8 session_key[8];                              // bytes 28 to 35
  UINT8 cryptographic_key[32];                       // bytes 36 to 67
  UINT8 cryptographic_iv_initialization_vector[16];  // bytes 68 to 83
} GatewayRouterResponseMessage;

// Sent as BOX_SIGN_ON_REQUEST_OUT; an error terminates the box connection
typedef struct _BoxSignOnResponseMessage {
  UINT16BE box_id;        // bytes 0 to 1, signed, read here as unsigned
  UINT8 reserved_10[10];  // bytes 2 to 11
} BoxSignOnResponseMessage;

// Sent as BOX_SIGN_OFF with an error code when the exchange terminates the connection
typedef struct _BoxSignOffMessage {
  UINT16BE box_id;  // bytes 0 to 1, signed, read here as unsigned
} BoxSignOffMessage;

// Branch
casetype _ServerMessagePayload (UINT16 selector, UINT32 length, UINT32 length_2, UINT16 message_length, UINT32 available) {
  switch (selector) {
    case 0x08FD: LogonResponseMessage(message_length, available) logon_response_message;
    case 0x0641: SystemInformationResponseMessage system_information_response_message;
    case 0x1C99: PartialSystemInformationResponseMessage partial_system_information_response_message;
    case 0x1C8B: UpdateLocalDatabaseHeaderMessage update_local_database_header_message;
    case 0x1C88: UpdateLocalDatabaseDataMessage(length) update_local_database_data_message[:byte-size-single-element-array length];
    case 0x1C8C: UpdateLocalDatabaseTrailerMessage update_local_database_trailer_message;
    case 0x1B63: unit message_download_header_message;
    case 0x1B6D: MessageDownloadDataMessage(length_2) message_download_data_message[:byte-size-single-element-array length_2];
    case 0x1B77: unit message_download_trailer_message;
    case 0x0911: unit logoff_confirmation_response_message;
    case 0x07D1: BoardLotOutMessage board_lot_out_message;
    case 0x0819: OrderConfirmationResponseMessage order_confirmation_response_message;
    case 0x07DC: MarketPriceConfirmationResponseMessage market_price_confirmation_response_message;
    case 0x087A: OrderFreezeResponseMessage order_freeze_response_message;
    case 0x08B7: OrderErrorResponseMessage order_error_response_message;
    case 0x07F9: OrderModificationResponseMessage order_modification_response_message;
    case 0x081A: OrderModificationConfirmationResponseMessage order_modification_confirmation_response_message;
    case 0x07FA: OrderModificationErrorResponseMessage order_modification_error_response_message;
    case 0x0817: OrderCancellationResponseMessage order_cancellation_response_message;
    case 0x081B: OrderCancellationConfirmationResponseMessage order_cancellation_confirmation_response_message;
    case 0x0818: OrderCancellationErrorResponseMessage order_cancellation_error_response_message;
    case 0x232A: CancellationOfOrdersInBatchMessage cancellation_of_orders_in_batch_message;
    case 0x07D9: NegotiatedOrderEnteredByCounterPartyMessage negotiated_order_entered_by_counter_party_message;
    case 0x07D8: NegotiatedOrderToRegularLotMessage negotiated_order_to_regular_lot_message;
    case 0x081C: CancelNegotiatedOrderMessage cancel_negotiated_order_message;
    case 0x1541: TradeCancellationRequestedResponseMessage trade_cancellation_requested_response_message;
    case 0x08AF: TradeCancellationErrorMessage trade_cancellation_error_message;
    case 0x1546: TradeModificationRequestedResponseMessage trade_modification_requested_response_message;
    case 0x08AE: TradeConfirmationMessage trade_confirmation_message;
    case 0x08A4: StopLossOrderTriggeringMessage stop_loss_order_triggering_message;
    case 0x08EA: TradeCancellationConfirmationResponseMessage trade_cancellation_confirmation_response_message;
    case 0x08EE: TradeCancellationRejectionMessage trade_cancellation_rejection_message;
    case 0x08EF: TradeModificationConfirmationMessage trade_modification_confirmation_message;
    case 0x08F0: TradeModificationRejectionMessage trade_modification_rejection_message;
    case 0x14AF: ControlMessageToTraderMessage control_message_to_trader_message;
    case 0x08FE: ErrorResponseMessage error_response_message;
    case 0x0961: GatewayRouterResponseMessage gateway_router_response_message;
    case 0x59E1: unit secure_box_registration_response_message;
    case 0x59D9: BoxSignOnResponseMessage box_sign_on_response_message;
    case 0x4F62: BoxSignOffMessage box_sign_off_message;
    default: UINT8 unknown[available];
  }
} ServerMessagePayload;

// One framed interactive message sent by the exchange
typedef struct _ServerDirectPacket {
  UINT16BE packet_length { packet_length >= 62 };                                                                                                                                                                                                       // bytes 0 to 1
  UINT32BE packet_sequence_number;                                                                                                                                                                                                                      // bytes 2 to 5
  UINT8 checksum[16];                                                                                                                                                                                                                                   // bytes 6 to 21
  UINT16BE transaction_code;                                                                                                                                                                                                                            // bytes 22 to 23, signed, read here as unsigned
  UINT32BE log_time;                                                                                                                                                                                                                                    // bytes 24 to 27, signed, read here as unsigned
  UINT8 alpha_char[2];                                                                                                                                                                                                                                  // bytes 28 to 29
  UINT32BE trader_id;                                                                                                                                                                                                                                   // bytes 30 to 33, signed, read here as unsigned
  UINT16BE error_code;                                                                                                                                                                                                                                  // bytes 34 to 35, signed, read here as unsigned
  UINT64BE header_timestamp;                                                                                                                                                                                                                            // bytes 36 to 43, signed, read here as unsigned
  UINT8 time_stamp_1[8];                                                                                                                                                                                                                                // bytes 44 to 51
  UINT8 time_stamp_2[8];                                                                                                                                                                                                                                // bytes 52 to 59
  UINT16BE message_length { message_length >= 40 };                                                                                                                                                                                                     // bytes 60 to 61, signed, read here as unsigned
  ServerMessagePayload(transaction_code, (((UINT32) message_length) - 40), (((UINT32) message_length) - 40), message_length, (((UINT32) packet_length) - 62)) server_message_payload[:byte-size-single-element-array (((UINT32) packet_length) - 62)];
} ServerDirectPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// Nnf direct interface Tcp block of one or more packets sent by the exchange
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerDirectPacket server_direct_packet[:byte-size available];
} ServerPacket;

