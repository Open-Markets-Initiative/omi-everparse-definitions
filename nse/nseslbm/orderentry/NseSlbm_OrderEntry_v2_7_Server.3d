  UINT16BE mkt : 1;                         // bytes 100 to 101
  UINT16BE on_stop : 1;                     // bytes 100 to 101
  UINT16BE day : 1;                         // bytes 100 to 101
  UINT16BE gtc : 1;                         // bytes 100 to 101
  UINT16BE fok : 1;                         // bytes 100 to 101
  UINT16BE aon : 1;                         // bytes 100 to 101
  UINT16BE mf : 1;                          // bytes 100 to 101
