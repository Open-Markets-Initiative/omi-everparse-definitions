// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NseSlbm_OrderEntry_v2_7_Server.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - a Integrity rule
// - the dispatch that chooses a message by its type
// - a Composite rule
// - a field read in bits
// - a length prefix framing what follows
// - the packet as a whole, which is an arm not leading with what the choice is made on, at serverpacket.serverdirectpacket.serverpacketbody.serversessionpacket

// ---- Values ------------------------------------------------------------------

// Transaction Code: 2 byte code
#define TRANSACTION_CODE_LOGON_REQUEST_MESSAGE 0x08FC                              // Logon Request Message
#define TRANSACTION_CODE_LOGON_RESPONSE_MESSAGE 0x08FD                             // Logon Response Message
#define TRANSACTION_CODE_SYSTEM_INFORMATION_REQUEST_MESSAGE 0x0640                 // System Information Request Message
#define TRANSACTION_CODE_SYSTEM_INFORMATION_RESPONSE_MESSAGE 0x0641                // System Information Response Message
#define TRANSACTION_CODE_PARTIAL_SYSTEM_INFORMATION_RESPONSE_MESSAGE 0x1C99        // Partial System Information Response Message
#define TRANSACTION_CODE_UPDATE_LOCAL_DATABASE_REQUEST_MESSAGE 0x1C84              // Update Local Database Request Message
#define TRANSACTION_CODE_UPDATE_LOCAL_DATABASE_HEADER_MESSAGE 0x1C8B               // Update Local Database Header Message
#define TRANSACTION_CODE_UPDATE_LOCAL_DATABASE_DATA_MESSAGE 0x1C88                 // Update Local Database Data Message
#define TRANSACTION_CODE_UPDATE_LOCAL_DATABASE_TRAILER_MESSAGE 0x1C8C              // Update Local Database Trailer Message
#define TRANSACTION_CODE_MESSAGE_DOWNLOAD_REQUEST_MESSAGE 0x1B58                   // Message Download Request Message
#define TRANSACTION_CODE_MESSAGE_DOWNLOAD_HEADER_MESSAGE 0x1B63                    // Message Download Header Message
#define TRANSACTION_CODE_MESSAGE_DOWNLOAD_DATA_MESSAGE 0x1B6D                      // Message Download Data Message
#define TRANSACTION_CODE_MESSAGE_DOWNLOAD_TRAILER_MESSAGE 0x1B77                   // Message Download Trailer Message
#define TRANSACTION_CODE_LOGOFF_REQUEST_MESSAGE 0x0910                             // Logoff Request Message
#define TRANSACTION_CODE_LOGOFF_CONFIRMATION_RESPONSE_MESSAGE 0x0911               // Logoff Confirmation Response Message
#define TRANSACTION_CODE_ORDER_ENTRY_REQUEST_MESSAGE 0x07D0                        // Order Entry Request Message
#define TRANSACTION_CODE_BOARD_LOT_OUT_MESSAGE 0x07D1                              // Board Lot Out Message
#define TRANSACTION_CODE_ORDER_CONFIRMATION_RESPONSE_MESSAGE 0x0819                // Order Confirmation Response Message
#define TRANSACTION_CODE_MARKET_PRICE_CONFIRMATION_RESPONSE_MESSAGE 0x07DC         // Market Price Confirmation Response Message
#define TRANSACTION_CODE_ORDER_FREEZE_RESPONSE_MESSAGE 0x087A                      // Order Freeze Response Message
#define TRANSACTION_CODE_ORDER_ERROR_RESPONSE_MESSAGE 0x08B7                       // Order Error Response Message
#define TRANSACTION_CODE_ORDER_MODIFICATION_REQUEST_MESSAGE 0x07F8                 // Order Modification Request Message
#define TRANSACTION_CODE_ORDER_MODIFICATION_RESPONSE_MESSAGE 0x07F9                // Order Modification Response Message
#define TRANSACTION_CODE_ORDER_MODIFICATION_CONFIRMATION_RESPONSE_MESSAGE 0x081A   // Order Modification Confirmation Response Message
#define TRANSACTION_CODE_ORDER_MODIFICATION_ERROR_RESPONSE_MESSAGE 0x07FA          // Order Modification Error Response Message
#define TRANSACTION_CODE_ORDER_CANCELLATION_REQUEST_MESSAGE 0x0816                 // Order Cancellation Request Message
#define TRANSACTION_CODE_ORDER_CANCELLATION_RESPONSE_MESSAGE 0x0817                // Order Cancellation Response Message
#define TRANSACTION_CODE_ORDER_CANCELLATION_CONFIRMATION_RESPONSE_MESSAGE 0x081B   // Order Cancellation Confirmation Response Message
#define TRANSACTION_CODE_ORDER_CANCELLATION_ERROR_RESPONSE_MESSAGE 0x0818          // Order Cancellation Error Response Message
#define TRANSACTION_CODE_CANCELLATION_OF_ORDERS_IN_BATCH_MESSAGE 0x232A            // Cancellation Of Orders In Batch Message
#define TRANSACTION_CODE_NEGOTIATED_ORDER_ENTERED_BY_COUNTER_PARTY_MESSAGE 0x07D9  // Negotiated Order Entered By Counter Party Message
#define TRANSACTION_CODE_NEGOTIATED_ORDER_TO_REGULAR_LOT_MESSAGE 0x07D8            // Negotiated Order To Regular Lot Message
#define TRANSACTION_CODE_CANCEL_NEGOTIATED_ORDER_MESSAGE 0x081C                    // Cancel Negotiated Order Message
#define TRANSACTION_CODE_TRADE_CANCELLATION_REQUEST_MESSAGE 0x1540                 // Trade Cancellation Request Message
#define TRANSACTION_CODE_TRADE_CANCELLATION_REQUESTED_RESPONSE_MESSAGE 0x1541      // Trade Cancellation Requested Response Message
#define TRANSACTION_CODE_TRADE_CANCELLATION_ERROR_MESSAGE 0x08AF                   // Trade Cancellation Error Message
#define TRANSACTION_CODE_TRADE_MODIFICATION_REQUEST_MESSAGE 0x1545                 // Trade Modification Request Message
#define TRANSACTION_CODE_TRADE_MODIFICATION_REQUESTED_RESPONSE_MESSAGE 0x1546      // Trade Modification Requested Response Message
#define TRANSACTION_CODE_TRADE_CONFIRMATION_MESSAGE 0x08AE                         // Trade Confirmation Message
#define TRANSACTION_CODE_STOP_LOSS_ORDER_TRIGGERING_MESSAGE 0x08A4                 // Stop Loss Order Triggering Message
#define TRANSACTION_CODE_TRADE_CANCELLATION_CONFIRMATION_RESPONSE_MESSAGE 0x08EA   // Trade Cancellation Confirmation Response Message
#define TRANSACTION_CODE_TRADE_CANCELLATION_REJECTION_MESSAGE 0x08EE               // Trade Cancellation Rejection Message
#define TRANSACTION_CODE_TRADE_MODIFICATION_CONFIRMATION_MESSAGE 0x08EF            // Trade Modification Confirmation Message
#define TRANSACTION_CODE_TRADE_MODIFICATION_REJECTION_MESSAGE 0x08F0               // Trade Modification Rejection Message
#define TRANSACTION_CODE_CONTROL_MESSAGE_TO_TRADER_MESSAGE 0x14AF                  // Control Message To Trader Message
#define TRANSACTION_CODE_ERROR_RESPONSE_MESSAGE 0x08FE                             // Error Response Message
#define TRANSACTION_CODE_GATEWAY_ROUTER_REQUEST_MESSAGE 0x0960                     // Gateway Router Request Message
#define TRANSACTION_CODE_GATEWAY_ROUTER_RESPONSE_MESSAGE 0x0961                    // Gateway Router Response Message
#define TRANSACTION_CODE_SECURE_BOX_REGISTRATION_REQUEST_MESSAGE 0x59E0            // Secure Box Registration Request Message
#define TRANSACTION_CODE_SECURE_BOX_REGISTRATION_RESPONSE_MESSAGE 0x59E1           // Secure Box Registration Response Message
#define TRANSACTION_CODE_BOX_SIGN_ON_REQUEST_MESSAGE 0x59D8                        // Box Sign On Request Message
#define TRANSACTION_CODE_BOX_SIGN_ON_RESPONSE_MESSAGE 0x59D9                       // Box Sign On Response Message
#define TRANSACTION_CODE_HEARTBEAT_MESSAGE 0x5BD2                                  // Heartbeat Message
#define TRANSACTION_CODE_BOX_SIGN_OFF_MESSAGE 0x4F62                               // Box Sign Off Message

// ---- Packet Header: 6 bytes --------------------------------------------------

// Packet Length and Sequence number, the first six bytes of the direct interface's twenty two byte packet header; its last sixteen open each packet body branch
entrypoint typedef struct _PacketHeader {
  UINT16BE packet_length;           // bytes 0 to 1
  UINT32BE packet_sequence_number;  // bytes 2 to 5
} PacketHeader;

// ---- Message Header: 40 bytes ------------------------------------------------

// MESSAGE_HEADER
entrypoint typedef struct _MessageHeader {
  UINT16BE transaction_code;  // bytes 0 to 1, values TRANSACTION_CODE_, signed, read here as unsigned
  UINT32BE log_time;          // bytes 2 to 5, signed, read here as unsigned
  UINT8 alpha_char[2];        // bytes 6 to 7
  UINT32BE trader_id;         // bytes 8 to 11, signed, read here as unsigned
  UINT16BE error_code;        // bytes 12 to 13, signed, read here as unsigned
  UINT64BE header_timestamp;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 time_stamp_1[8];      // bytes 22 to 29
  UINT8 time_stamp_2[8];      // bytes 30 to 37
  UINT16BE message_length;    // bytes 38 to 39, signed, read here as unsigned
} MessageHeader;

// ---- Sec Info: 12 bytes ------------------------------------------------------

// SEC_INFO
entrypoint typedef struct _SecInfo {
  UINT8 symbol[10];  // bytes 0 to 9
  UINT8 series[2];   // bytes 10 to 11
} SecInfo;

// ---- Logon Error Body: 140 bytes ---------------------------------------------

// Logon Error Body
entrypoint typedef struct _LogonErrorBody {
  SecInfo sec_info;          // bytes 0 to 11
  UINT8 error_message[128];  // bytes 12 to 139
} LogonErrorBody;

// ---- Update Local Database Header Message: 2 bytes ---------------------------

// Sent as UPDATE_LOCALDB_HEADER to signal that the local database download is starting
entrypoint typedef struct _UpdateLocalDatabaseHeaderMessage {
  UINT8 reserved_2[2];  // bytes 0 to 1
} UpdateLocalDatabaseHeaderMessage;

// ---- Update Local Database Trailer Message: 2 bytes --------------------------

// Sent as UPDATE_LOCALDB_TRAILER to signal that the local database download is complete
entrypoint typedef struct _UpdateLocalDatabaseTrailerMessage {
  UINT8 reserved_2[2];  // bytes 0 to 1
} UpdateLocalDatabaseTrailerMessage;

// ---- Trade Cancellation Requested Response Message: 74 bytes -----------------

// Sent as TRADE_CANCEL_OUT to acknowledge that the request reached the trading system
entrypoint typedef struct _TradeCancellationRequestedResponseMessage {
  SecInfo sec_info;                 // bytes 0 to 11
  UINT32BE reverse_leg_settl_date;  // bytes 12 to 15, signed, read here as unsigned
  UINT32BE l_fill_number;           // bytes 16 to 19, signed, read here as unsigned
  UINT32BE l_fill_qty;              // bytes 20 to 23, signed, read here as unsigned
  UINT32BE l_fill_price;            // bytes 24 to 27, signed, read here as unsigned
  UINT16BE i_mkt_type;              // bytes 28 to 29, signed, read here as unsigned
  UINT32BE l_new_volume;            // bytes 30 to 33, signed, read here as unsigned
  UINT8 buy_participant_id[12];     // bytes 34 to 45
  UINT8 sell_participant_id[12];    // bytes 46 to 57
  UINT8 buy_broker_id[5];           // bytes 58 to 62
  UINT8 sell_broker_id[5];          // bytes 63 to 67
  UINT32BE trader_id;               // bytes 68 to 71, signed, read here as unsigned
  UINT16BE requested_by;            // bytes 72 to 73, signed, read here as unsigned
} TradeCancellationRequestedResponseMessage;

// ---- Trade Cancellation Error Message: 74 bytes ------------------------------

// Sent as TRADE_ERROR when an error is detected in the request
entrypoint typedef struct _TradeCancellationErrorMessage {
  SecInfo sec_info;                 // bytes 0 to 11
  UINT32BE reverse_leg_settl_date;  // bytes 12 to 15, signed, read here as unsigned
  UINT32BE l_fill_number;           // bytes 16 to 19, signed, read here as unsigned
  UINT32BE l_fill_qty;              // bytes 20 to 23, signed, read here as unsigned
  UINT32BE l_fill_price;            // bytes 24 to 27, signed, read here as unsigned
  UINT16BE i_mkt_type;              // bytes 28 to 29, signed, read here as unsigned
  UINT32BE l_new_volume;            // bytes 30 to 33, signed, read here as unsigned
  UINT8 buy_participant_id[12];     // bytes 34 to 45
  UINT8 sell_participant_id[12];    // bytes 46 to 57
  UINT8 buy_broker_id[5];           // bytes 58 to 62
  UINT8 sell_broker_id[5];          // bytes 63 to 67
  UINT32BE trader_id;               // bytes 68 to 71, signed, read here as unsigned
  UINT16BE requested_by;            // bytes 72 to 73, signed, read here as unsigned
} TradeCancellationErrorMessage;

// ---- Trade Modification Requested Response Message: 74 bytes -----------------

// Sent as TRADE_MOD_OUT; trade modification is currently not allowed
entrypoint typedef struct _TradeModificationRequestedResponseMessage {
  SecInfo sec_info;                 // bytes 0 to 11
  UINT32BE reverse_leg_settl_date;  // bytes 12 to 15, signed, read here as unsigned
  UINT32BE l_fill_number;           // bytes 16 to 19, signed, read here as unsigned
  UINT32BE l_fill_qty;              // bytes 20 to 23, signed, read here as unsigned
  UINT32BE l_fill_price;            // bytes 24 to 27, signed, read here as unsigned
  UINT16BE i_mkt_type;              // bytes 28 to 29, signed, read here as unsigned
  UINT32BE l_new_volume;            // bytes 30 to 33, signed, read here as unsigned
  UINT8 buy_participant_id[12];     // bytes 34 to 45
  UINT8 sell_participant_id[12];    // bytes 46 to 57
  UINT8 buy_broker_id[5];           // bytes 58 to 62
  UINT8 sell_broker_id[5];          // bytes 63 to 67
  UINT32BE trader_id;               // bytes 68 to 71, signed, read here as unsigned
  UINT16BE requested_by;            // bytes 72 to 73, signed, read here as unsigned
} TradeModificationRequestedResponseMessage;

// ---- Control Message To Trader Message: 249 bytes ----------------------------

// Sent as CTRL_MSG_TO_TRADER for a message from NSE-Control to a particular user, and for a counter party's trade cancellation request
entrypoint typedef struct _ControlMessageToTraderMessage {
  UINT32BE trader_id;    // bytes 0 to 3, signed, read here as unsigned
  UINT8 action_code[3];  // bytes 4 to 6
  UINT8 reserved_1;      // byte 7
  UINT16BE msg_length;   // bytes 8 to 9, signed, read here as unsigned
  UINT8 msg[239];        // bytes 10 to 248
} ControlMessageToTraderMessage;

// ---- Error Response Message: 140 bytes ---------------------------------------

// Sent as ERROR_RESPONSE_OUT when the Error Code of the header is not zero
entrypoint typedef struct _ErrorResponseMessage {
  SecInfo sec_info;          // bytes 0 to 11
  UINT8 error_message[128];  // bytes 12 to 139
} ErrorResponseMessage;

// ---- Gateway Router Response Message: 84 bytes -------------------------------

// Sent as GR_RESPONSE with the allocated gateway server, its session key and the cryptographic key and vector
entrypoint typedef struct _GatewayRouterResponseMessage {
  UINT16BE box_id;                                   // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];                                // bytes 2 to 6
  UINT8 filler;                                      // byte 7
  UINT8 ip_address[16];                              // bytes 8 to 23
  UINT32BE port;                                     // bytes 24 to 27, signed, read here as unsigned
  UINT8 session_key[8];                              // bytes 28 to 35
  UINT8 cryptographic_key[32];                       // bytes 36 to 67
  UINT8 cryptographic_iv_initialization_vector[16];  // bytes 68 to 83
} GatewayRouterResponseMessage;

// ---- Box Sign On Response Message: 12 bytes ----------------------------------

// Sent as BOX_SIGN_ON_REQUEST_OUT; an error terminates the box connection
entrypoint typedef struct _BoxSignOnResponseMessage {
  UINT16BE box_id;        // bytes 0 to 1, signed, read here as unsigned
  UINT8 reserved_10[10];  // bytes 2 to 11
} BoxSignOnResponseMessage;

// ---- Box Sign Off Message: 2 bytes -------------------------------------------

// Sent as BOX_SIGN_OFF with an error code when the exchange terminates the connection
entrypoint typedef struct _BoxSignOffMessage {
  UINT16BE box_id;  // bytes 0 to 1, signed, read here as unsigned
} BoxSignOffMessage;

