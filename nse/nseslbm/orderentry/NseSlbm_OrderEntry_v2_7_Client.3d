// Transaction Code: 2 byte code
#define TRANSACTION_CODE_LOGON_REQUEST_MESSAGE 0x08FC                              // Logon Request Message
#define TRANSACTION_CODE_LOGON_RESPONSE_MESSAGE 0x08FD                             // Logon Response Message
#define TRANSACTION_CODE_SYSTEM_INFORMATION_REQUEST_MESSAGE 0x0640                 // System Information Request Message
#define TRANSACTION_CODE_SYSTEM_INFORMATION_RESPONSE_MESSAGE 0x0641                // System Information Response Message
#define TRANSACTION_CODE_PARTIAL_SYSTEM_INFORMATION_RESPONSE_MESSAGE 0x1C99        // Partial System Information Response Message
#define TRANSACTION_CODE_UPDATE_LOCAL_DATABASE_REQUEST_MESSAGE 0x1C84              // Update Local Database Request Message
#define TRANSACTION_CODE_UPDATE_LOCAL_DATABASE_HEADER_MESSAGE 0x1C8B               // Update Local Database Header Message
#define TRANSACTION_CODE_UPDATE_LOCAL_DATABASE_DATA_MESSAGE 0x1C88                 // Update Local Database Data Message
#define TRANSACTION_CODE_UPDATE_LOCAL_DATABASE_TRAILER_MESSAGE 0x1C8C              // Update Local Database Trailer Message
#define TRANSACTION_CODE_MESSAGE_DOWNLOAD_REQUEST_MESSAGE 0x1B58                   // Message Download Request Message
#define TRANSACTION_CODE_MESSAGE_DOWNLOAD_HEADER_MESSAGE 0x1B63                    // Message Download Header Message
#define TRANSACTION_CODE_MESSAGE_DOWNLOAD_DATA_MESSAGE 0x1B6D                      // Message Download Data Message
#define TRANSACTION_CODE_MESSAGE_DOWNLOAD_TRAILER_MESSAGE 0x1B77                   // Message Download Trailer Message
#define TRANSACTION_CODE_LOGOFF_REQUEST_MESSAGE 0x0910                             // Logoff Request Message
#define TRANSACTION_CODE_LOGOFF_CONFIRMATION_RESPONSE_MESSAGE 0x0911               // Logoff Confirmation Response Message
#define TRANSACTION_CODE_ORDER_ENTRY_REQUEST_MESSAGE 0x07D0                        // Order Entry Request Message
#define TRANSACTION_CODE_BOARD_LOT_OUT_MESSAGE 0x07D1                              // Board Lot Out Message
#define TRANSACTION_CODE_ORDER_CONFIRMATION_RESPONSE_MESSAGE 0x0819                // Order Confirmation Response Message
#define TRANSACTION_CODE_MARKET_PRICE_CONFIRMATION_RESPONSE_MESSAGE 0x07DC         // Market Price Confirmation Response Message
#define TRANSACTION_CODE_ORDER_FREEZE_RESPONSE_MESSAGE 0x087A                      // Order Freeze Response Message
#define TRANSACTION_CODE_ORDER_ERROR_RESPONSE_MESSAGE 0x08B7                       // Order Error Response Message
#define TRANSACTION_CODE_ORDER_MODIFICATION_REQUEST_MESSAGE 0x07F8                 // Order Modification Request Message
#define TRANSACTION_CODE_ORDER_MODIFICATION_RESPONSE_MESSAGE 0x07F9                // Order Modification Response Message
#define TRANSACTION_CODE_ORDER_MODIFICATION_CONFIRMATION_RESPONSE_MESSAGE 0x081A   // Order Modification Confirmation Response Message
#define TRANSACTION_CODE_ORDER_MODIFICATION_ERROR_RESPONSE_MESSAGE 0x07FA          // Order Modification Error Response Message
#define TRANSACTION_CODE_ORDER_CANCELLATION_REQUEST_MESSAGE 0x0816                 // Order Cancellation Request Message
#define TRANSACTION_CODE_ORDER_CANCELLATION_RESPONSE_MESSAGE 0x0817                // Order Cancellation Response Message
#define TRANSACTION_CODE_ORDER_CANCELLATION_CONFIRMATION_RESPONSE_MESSAGE 0x081B   // Order Cancellation Confirmation Response Message
#define TRANSACTION_CODE_ORDER_CANCELLATION_ERROR_RESPONSE_MESSAGE 0x0818          // Order Cancellation Error Response Message
#define TRANSACTION_CODE_CANCELLATION_OF_ORDERS_IN_BATCH_MESSAGE 0x232A            // Cancellation Of Orders In Batch Message
#define TRANSACTION_CODE_NEGOTIATED_ORDER_ENTERED_BY_COUNTER_PARTY_MESSAGE 0x07D9  // Negotiated Order Entered By Counter Party Message
#define TRANSACTION_CODE_NEGOTIATED_ORDER_TO_REGULAR_LOT_MESSAGE 0x07D8            // Negotiated Order To Regular Lot Message
#define TRANSACTION_CODE_CANCEL_NEGOTIATED_ORDER_MESSAGE 0x081C                    // Cancel Negotiated Order Message
#define TRANSACTION_CODE_TRADE_CANCELLATION_REQUEST_MESSAGE 0x1540                 // Trade Cancellation Request Message
#define TRANSACTION_CODE_TRADE_CANCELLATION_REQUESTED_RESPONSE_MESSAGE 0x1541      // Trade Cancellation Requested Response Message
#define TRANSACTION_CODE_TRADE_CANCELLATION_ERROR_MESSAGE 0x08AF                   // Trade Cancellation Error Message
#define TRANSACTION_CODE_TRADE_MODIFICATION_REQUEST_MESSAGE 0x1545                 // Trade Modification Request Message
#define TRANSACTION_CODE_TRADE_MODIFICATION_REQUESTED_RESPONSE_MESSAGE 0x1546      // Trade Modification Requested Response Message
#define TRANSACTION_CODE_TRADE_CONFIRMATION_MESSAGE 0x08AE                         // Trade Confirmation Message
#define TRANSACTION_CODE_STOP_LOSS_ORDER_TRIGGERING_MESSAGE 0x08A4                 // Stop Loss Order Triggering Message
#define TRANSACTION_CODE_TRADE_CANCELLATION_CONFIRMATION_RESPONSE_MESSAGE 0x08EA   // Trade Cancellation Confirmation Response Message
#define TRANSACTION_CODE_TRADE_CANCELLATION_REJECTION_MESSAGE 0x08EE               // Trade Cancellation Rejection Message
#define TRANSACTION_CODE_TRADE_MODIFICATION_CONFIRMATION_MESSAGE 0x08EF            // Trade Modification Confirmation Message
#define TRANSACTION_CODE_TRADE_MODIFICATION_REJECTION_MESSAGE 0x08F0               // Trade Modification Rejection Message
#define TRANSACTION_CODE_CONTROL_MESSAGE_TO_TRADER_MESSAGE 0x14AF                  // Control Message To Trader Message
#define TRANSACTION_CODE_ERROR_RESPONSE_MESSAGE 0x08FE                             // Error Response Message
#define TRANSACTION_CODE_GATEWAY_ROUTER_REQUEST_MESSAGE 0x0960                     // Gateway Router Request Message
#define TRANSACTION_CODE_GATEWAY_ROUTER_RESPONSE_MESSAGE 0x0961                    // Gateway Router Response Message
#define TRANSACTION_CODE_SECURE_BOX_REGISTRATION_REQUEST_MESSAGE 0x59E0            // Secure Box Registration Request Message
#define TRANSACTION_CODE_SECURE_BOX_REGISTRATION_RESPONSE_MESSAGE 0x59E1           // Secure Box Registration Response Message
#define TRANSACTION_CODE_BOX_SIGN_ON_REQUEST_MESSAGE 0x59D8                        // Box Sign On Request Message
#define TRANSACTION_CODE_BOX_SIGN_ON_RESPONSE_MESSAGE 0x59D9                       // Box Sign On Response Message
#define TRANSACTION_CODE_HEARTBEAT_MESSAGE 0x5BD2                                  // Heartbeat Message
#define TRANSACTION_CODE_BOX_SIGN_OFF_MESSAGE 0x4F62                               // Box Sign Off Message

// User Type: 2 byte code
#define USER_TYPE_DEALER 0x0000             // Dealer
#define USER_TYPE_CORPORATE_MANAGER 0x0004  // Corporate Manager
#define USER_TYPE_BRANCH_MANAGER 0x0005     // Branch Manager

// Broker Status: one byte code
#define BROKER_STATUS_BLANK 0x20        // Blank
#define BROKER_STATUS_SUSPENDED 0x53    // Suspended
#define BROKER_STATUS_ACTIVE 0x41       // Active
#define BROKER_STATUS_DEACTIVATED 0x44  // Deactivated
#define BROKER_STATUS_CLOSEOUT 0x43     // Closeout

// Request For Open Orders: one byte code
#define REQUEST_FOR_OPEN_ORDERS_DOWNLOAD_GTC_AND_GTD_ORDERS 0x47  // Download Gtc And Gtd Orders
#define REQUEST_FOR_OPEN_ORDERS_NO_OPEN_ORDERS 0x4E               // No Open Orders

// Normal Market Status: 2 byte code
#define NORMAL_MARKET_STATUS_PREOPEN 0x0000        // Preopen
#define NORMAL_MARKET_STATUS_OPEN 0x0001           // Open
#define NORMAL_MARKET_STATUS_CLOSED 0x0002         // Closed
#define NORMAL_MARKET_STATUS_PREOPEN_ENDED 0x0003  // Preopen Ended

// Odd Lot Market Status: 2 byte code
#define ODD_LOT_MARKET_STATUS_PREOPEN 0x0000        // Preopen
#define ODD_LOT_MARKET_STATUS_OPEN 0x0001           // Open
#define ODD_LOT_MARKET_STATUS_CLOSED 0x0002         // Closed
#define ODD_LOT_MARKET_STATUS_PREOPEN_ENDED 0x0003  // Preopen Ended

// Spot Market Status: 2 byte code
#define SPOT_MARKET_STATUS_PREOPEN 0x0000        // Preopen
#define SPOT_MARKET_STATUS_OPEN 0x0001           // Open
#define SPOT_MARKET_STATUS_CLOSED 0x0002         // Closed
#define SPOT_MARKET_STATUS_PREOPEN_ENDED 0x0003  // Preopen Ended

// Auction Market Status: 2 byte code
#define AUCTION_MARKET_STATUS_PREOPEN 0x0000        // Preopen
#define AUCTION_MARKET_STATUS_OPEN 0x0001           // Open
#define AUCTION_MARKET_STATUS_CLOSED 0x0002         // Closed
#define AUCTION_MARKET_STATUS_PREOPEN_ENDED 0x0003  // Preopen Ended

// Participant Type: one byte code
#define PARTICIPANT_TYPE_COMPETITOR 0x43  // Competitor
#define PARTICIPANT_TYPE_SOLICITOR 0x53   // Solicitor
#define PARTICIPANT_TYPE_INITIATOR 0x49   // Initiator

// Mod Cxl By: one byte code
#define MOD_CXL_BY_TRADER 0x54             // Trader
#define MOD_CXL_BY_BRANCH_MANAGER 0x42     // Branch Manager
#define MOD_CXL_BY_CORPORATE_MANAGER 0x4D  // Corporate Manager
#define MOD_CXL_BY_CONTROL 0x43            // Control

// Reason Code: 2 byte code
#define REASON_CODE_NOT_SET 0x0000          // Not Set
#define REASON_CODE_SECURITY 0x0005         // Security
#define REASON_CODE_BROKER 0x0006           // Broker
#define REASON_CODE_BRANCH 0x0007           // Branch
#define REASON_CODE_USER 0x0008             // User
#define REASON_CODE_PARTICIPANT 0x0009      // Participant
#define REASON_CODE_COUNTER_PARTY 0x000A    // Counter Party
#define REASON_CODE_ORDER_NUMBER 0x000B     // Order Number
#define REASON_CODE_AUCTION_NUMBER 0x000F   // Auction Number
#define REASON_CODE_PRICE_FREEZE 0x0011     // Price Freeze
#define REASON_CODE_QUANTITY_FREEZE 0x0012  // Quantity Freeze

// Book Type: 2 byte code
#define BOOK_TYPE_REGULAR_LOT_ORDER 0x0001    // Regular Lot Order
#define BOOK_TYPE_SPECIAL_TERMS_ORDER 0x0002  // Special Terms Order
#define BOOK_TYPE_STOP_LOSS_ORDER 0x0003      // Stop Loss Order
#define BOOK_TYPE_NEGOTIATED_ORDER 0x0004     // Negotiated Order
#define BOOK_TYPE_ODD_LOT_ORDER 0x0005        // Odd Lot Order
#define BOOK_TYPE_SPOT_ORDER 0x0006           // Spot Order
#define BOOK_TYPE_AUCTION_ORDER 0x0007        // Auction Order

// Buy Sell: 2 byte code
#define BUY_SELL_BUY 0x0001   // Buy
#define BUY_SELL_SELL 0x0002  // Sell

// Pro Client: 2 byte code
#define PRO_CLIENT_CLIENT 0x0001       // Client
#define PRO_CLIENT_BROKER 0x0002       // Broker
#define PRO_CLIENT_WAREHOUSING 0x0004  // Warehousing

// ---- Types -------------------------------------------------------------------

// Sent as SIGN_ON_REQUEST_IN to establish an interactive circuit with the host
typedef struct _LogonRequestMessage {
  UINT32BE user_id;                         // bytes 0 to 3, signed, read here as unsigned
  UINT8 password[8];                        // bytes 4 to 11
  UINT8 new_password[8];                    // bytes 12 to 19
  UINT8 trader_name[26];                    // bytes 20 to 45
  UINT32BE last_password_change_date_time;  // bytes 46 to 49, signed, read here as unsigned
  UINT8 broker_id[5];                       // bytes 50 to 54
  UINT8 reserved_1;                         // byte 55
  UINT16BE branch_id;                       // bytes 56 to 57, signed, read here as unsigned
  UINT32BE version_number;                  // bytes 58 to 61, signed, read here as unsigned
  UINT8 reserved_56[56];                    // bytes 62 to 117
  UINT16BE user_type;                       // bytes 118 to 119, signed, read here as unsigned
  UINT8 sequence_number[8];                 // bytes 120 to 127
  UINT8 workstation_number[14];             // bytes 128 to 141
  UINT8 broker_status;                      // byte 142
  UINT8 show_index;                         // byte 143
  UINT16BE normal_market : 1;               // bytes 144 to 145
  UINT16BE oddlot_market : 1;               // bytes 144 to 145
  UINT16BE spot_market : 1;                 // bytes 144 to 145
  UINT16BE auction_market : 1;              // bytes 144 to 145
  UINT16BE reserved_112 : 12;               // bytes 144 to 145
  UINT8 logon_request_broker_name[26];      // bytes 146 to 171
} LogonRequestMessage;

// Sent as UPDATE_LOCALDB_IN to request the local database download
typedef struct _UpdateLocalDatabaseRequestMessage {
  UINT32BE last_update_security_time;     // bytes 0 to 3, signed, read here as unsigned
  UINT32BE last_update_participant_time;  // bytes 4 to 7, signed, read here as unsigned
  UINT8 request_for_open_orders;          // byte 8
  UINT8 reserved_1;                       // byte 9
  UINT16BE normal_market_status;          // bytes 10 to 11, signed, read here as unsigned
  UINT16BE odd_lot_market_status;         // bytes 12 to 13, signed, read here as unsigned
  UINT16BE spot_market_status;            // bytes 14 to 15, signed, read here as unsigned
  UINT16BE auction_market_status;         // bytes 16 to 17, signed, read here as unsigned
} UpdateLocalDatabaseRequestMessage;

// Sent as DOWNLOAD_REQUEST to download the messages intended for the trader
typedef struct _MessageDownloadRequestMessage {
  UINT8 sequence_number[8];  // bytes 0 to 7
} MessageDownloadRequestMessage;

// SEC_INFO
typedef struct _SecInfo {
  UINT8 symbol[10];  // bytes 0 to 9
  UINT8 series[2];   // bytes 10 to 11
} SecInfo;

// Sent as BOARD_LOT_IN to place an order
typedef struct _OrderEntryRequestMessage {
  UINT8 participant_type;                   // byte 0
  UINT8 reserved_1;                         // byte 1
  UINT16BE competitor_period;               // bytes 2 to 3, signed, read here as unsigned
  UINT16BE solicitor_period;                // bytes 4 to 5, signed, read here as unsigned
  UINT8 mod_cxl_by;                         // byte 6
  UINT8 filler_9;                           // byte 7
  UINT16BE reason_code;                     // bytes 8 to 9, signed, read here as unsigned
  UINT8 reserved_4[4];                      // bytes 10 to 13
  SecInfo sec_info;                         // bytes 14 to 25
  UINT16BE auction_number;                  // bytes 26 to 27, signed, read here as unsigned
  UINT8 op_broker_id[5];                    // bytes 28 to 32
  UINT8 suspended;                          // byte 33
  UINT8 order_number[8];                    // bytes 34 to 41
  UINT8 account_number[10];                 // bytes 42 to 51
  UINT16BE book_type;                       // bytes 52 to 53, signed, read here as unsigned
  UINT16BE buy_sell;                        // bytes 54 to 55, signed, read here as unsigned
  UINT32BE disclosed_vol;                   // bytes 56 to 59, signed, read here as unsigned
  UINT32BE disclosed_vol_remaining;         // bytes 60 to 63, signed, read here as unsigned
  UINT32BE total_vol_remaining;             // bytes 64 to 67, signed, read here as unsigned
  UINT32BE volume;                          // bytes 68 to 71, signed, read here as unsigned
  UINT32BE volume_filled_today;             // bytes 72 to 75, signed, read here as unsigned
  UINT32BE price;                           // bytes 76 to 79, signed, read here as unsigned
  UINT32BE trigger_price;                   // bytes 80 to 83, signed, read here as unsigned
  UINT32BE reverse_leg_settl_date;          // bytes 84 to 87, signed, read here as unsigned
  UINT32BE entry_date_time;                 // bytes 88 to 91, signed, read here as unsigned
  UINT32BE min_fill_aon;                    // bytes 92 to 95, signed, read here as unsigned
  UINT32BE last_modified;                   // bytes 96 to 99, signed, read here as unsigned
  UINT16BE ato : 1;                         // bytes 100 to 101
  UINT16BE mkt : 1;                         // bytes 100 to 101
  UINT16BE on_stop : 1;                     // bytes 100 to 101
  UINT16BE day : 1;                         // bytes 100 to 101
  UINT16BE gtc : 1;                         // bytes 100 to 101
  UINT16BE fok : 1;                         // bytes 100 to 101
  UINT16BE aon : 1;                         // bytes 100 to 101
  UINT16BE mf : 1;                          // bytes 100 to 101
  UINT16BE matched_ind : 1;                 // bytes 100 to 101
  UINT16BE traded : 1;                      // bytes 100 to 101
  UINT16BE modified : 1;                    // bytes 100 to 101
  UINT16BE frozen : 1;                      // bytes 100 to 101
  UINT16BE filler_1 : 1;                    // bytes 100 to 101
  UINT16BE order_flags_reserved_three : 1;  // bytes 100 to 101
  UINT16BE stpc : 1;                        // bytes 100 to 101
  UINT16BE order_flags_reserved_one : 1;    // bytes 100 to 101
  UINT16BE branch_id;                       // bytes 102 to 103, signed, read here as unsigned
  UINT32BE trader_id;                       // bytes 104 to 107, signed, read here as unsigned
  UINT8 broker_id[5];                       // bytes 108 to 112
  UINT8 oe_remarks[21];                     // bytes 113 to 133
  UINT32BE transaction_id;                  // bytes 134 to 137, signed, read here as unsigned
  UINT8 settlor[12];                        // bytes 138 to 149
  UINT16BE pro_client;                      // bytes 150 to 151, signed, read here as unsigned
  UINT16BE settlement_period;               // bytes 152 to 153, signed, read here as unsigned
  UINT8 nnf_field[8];                       // bytes 154 to 161
  UINT8 exec_time_stamp[8];                 // bytes 162 to 169
  UINT8 reserved_2[2];                      // bytes 170 to 171
  UINT8 order_type[2];                      // bytes 172 to 173
} OrderEntryRequestMessage;

