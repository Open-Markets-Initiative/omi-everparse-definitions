// Sent as TRADE_CANCEL_IN to request cancellation of a trade
typedef struct _TradeCancellationRequestMessage {
  SecInfo sec_info;                 // bytes 0 to 11
  UINT32BE reverse_leg_settl_date;  // bytes 12 to 15, signed, read here as unsigned
  UINT32BE l_fill_number;           // bytes 16 to 19, signed, read here as unsigned
  UINT32BE l_fill_qty;              // bytes 20 to 23, signed, read here as unsigned
  UINT32BE l_fill_price;            // bytes 24 to 27, signed, read here as unsigned
  UINT16BE i_mkt_type;              // bytes 28 to 29, signed, read here as unsigned
  UINT32BE l_new_volume;            // bytes 30 to 33, signed, read here as unsigned
  UINT8 buy_participant_id[12];     // bytes 34 to 45
  UINT8 sell_participant_id[12];    // bytes 46 to 57
  UINT8 buy_broker_id[5];           // bytes 58 to 62
  UINT8 sell_broker_id[5];          // bytes 63 to 67
  UINT32BE trader_id;               // bytes 68 to 71, signed, read here as unsigned
  UINT16BE requested_by;            // bytes 72 to 73, signed, read here as unsigned
} TradeCancellationRequestMessage;

// Sent as TRADE_MOD_IN; trade modification is currently not allowed
typedef struct _TradeModificationRequestMessage {
  SecInfo sec_info;                 // bytes 0 to 11
  UINT32BE reverse_leg_settl_date;  // bytes 12 to 15, signed, read here as unsigned
  UINT32BE l_fill_number;           // bytes 16 to 19, signed, read here as unsigned
  UINT32BE l_fill_qty;              // bytes 20 to 23, signed, read here as unsigned
  UINT32BE l_fill_price;            // bytes 24 to 27, signed, read here as unsigned
  UINT16BE i_mkt_type;              // bytes 28 to 29, signed, read here as unsigned
  UINT32BE l_new_volume;            // bytes 30 to 33, signed, read here as unsigned
  UINT8 buy_participant_id[12];     // bytes 34 to 45
  UINT8 sell_participant_id[12];    // bytes 46 to 57
  UINT8 buy_broker_id[5];           // bytes 58 to 62
  UINT8 sell_broker_id[5];          // bytes 63 to 67
  UINT32BE trader_id;               // bytes 68 to 71, signed, read here as unsigned
  UINT16BE requested_by;            // bytes 72 to 73, signed, read here as unsigned
} TradeModificationRequestMessage;

// Sent as GR_REQUEST to the gateway router over a TLS connection
typedef struct _GatewayRouterRequestMessage {
  UINT16BE box_id;     // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];  // bytes 2 to 6
  UINT8 filler;        // byte 7
} GatewayRouterRequestMessage;

// Sent as SECURE_BOX_REGISTRATION_REQUEST_IN on the new connection to the allocated gateway server
typedef struct _SecureBoxRegistrationRequestMessage {
  UINT16BE box_id;  // bytes 0 to 1, signed, read here as unsigned
} SecureBoxRegistrationRequestMessage;

// Sent as BOX_SIGN_ON_REQUEST_IN, the first encrypted message on the box connection
typedef struct _BoxSignOnRequestMessage {
  UINT16BE box_id;       // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];    // bytes 2 to 6
  UINT8 reserved_5[5];   // bytes 7 to 11
  UINT8 session_key[8];  // bytes 12 to 19
} BoxSignOnRequestMessage;

// Branch
casetype _ClientMessagePayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x08FC: LogonRequestMessage logon_request_message;
    case 0x0640: unit system_information_request_message;
    case 0x1C84: UpdateLocalDatabaseRequestMessage update_local_database_request_message;
    case 0x1B58: MessageDownloadRequestMessage message_download_request_message;
    case 0x0910: unit logoff_request_message;
    case 0x07D0: OrderEntryRequestMessage order_entry_request_message;
    case 0x07F8: OrderModificationRequestMessage order_modification_request_message;
    case 0x0816: OrderCancellationRequestMessage order_cancellation_request_message;
    case 0x1540: TradeCancellationRequestMessage trade_cancellation_request_message;
    case 0x1545: TradeModificationRequestMessage trade_modification_request_message;
    case 0x0960: GatewayRouterRequestMessage gateway_router_request_message;
    case 0x59E0: SecureBoxRegistrationRequestMessage secure_box_registration_request_message;
    case 0x59D8: BoxSignOnRequestMessage box_sign_on_request_message;
    case 0x5BD2: unit heartbeat_message;
    default: UINT8 unknown[available];
  }
} ClientMessagePayload;

// One framed interactive message sent by the firm
typedef struct _ClientDirectPacket {
  UINT16BE packet_length { packet_length >= 62 };                                                                                                                   // bytes 0 to 1
  UINT32BE packet_sequence_number;                                                                                                                                  // bytes 2 to 5
  UINT8 checksum[16];                                                                                                                                               // bytes 6 to 21
  UINT16BE transaction_code;                                                                                                                                        // bytes 22 to 23, signed, read here as unsigned
  UINT32BE log_time;                                                                                                                                                // bytes 24 to 27, signed, read here as unsigned
  UINT8 alpha_char[2];                                                                                                                                              // bytes 28 to 29
  UINT32BE trader_id;                                                                                                                                               // bytes 30 to 33, signed, read here as unsigned
  UINT16BE error_code;                                                                                                                                              // bytes 34 to 35, signed, read here as unsigned
  UINT64BE header_timestamp;                                                                                                                                        // bytes 36 to 43, signed, read here as unsigned
  UINT8 time_stamp_1[8];                                                                                                                                            // bytes 44 to 51
  UINT8 time_stamp_2[8];                                                                                                                                            // bytes 52 to 59
  UINT16BE message_length;                                                                                                                                          // bytes 60 to 61, signed, read here as unsigned
  ClientMessagePayload(transaction_code, (((UINT32) packet_length) - 62)) client_message_payload[:byte-size-single-element-array (((UINT32) packet_length) - 62)];
} ClientDirectPacket;

// ---- Packet: ClientPacket ----------------------------------------------------

// Nnf direct interface Tcp block of one or more packets sent by the firm
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientDirectPacket client_direct_packet[:byte-size available];
} ClientPacket;

