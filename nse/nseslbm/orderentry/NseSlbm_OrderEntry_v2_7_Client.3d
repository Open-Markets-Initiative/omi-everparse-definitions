// ---- Packet Header: 22 bytes -------------------------------------------------

// Direct interface twenty two byte packet header
entrypoint typedef struct _PacketHeader {
  UINT16BE packet_length;           // bytes 0 to 1
  UINT32BE packet_sequence_number;  // bytes 2 to 5
  UINT8 checksum[16];               // bytes 6 to 21
} PacketHeader;

// ---- Message Header: 40 bytes ------------------------------------------------

// MESSAGE_HEADER
entrypoint typedef struct _MessageHeader {
  UINT16BE transaction_code;  // bytes 0 to 1, signed, read here as unsigned
  UINT32BE log_time;          // bytes 2 to 5, signed, read here as unsigned
  UINT8 alpha_char[2];        // bytes 6 to 7
  UINT32BE trader_id;         // bytes 8 to 11, signed, read here as unsigned
  UINT16BE error_code;        // bytes 12 to 13, signed, read here as unsigned
  UINT64BE header_timestamp;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 time_stamp_1[8];      // bytes 22 to 29
  UINT8 time_stamp_2[8];      // bytes 30 to 37
  UINT16BE message_length;    // bytes 38 to 39, signed, read here as unsigned
} MessageHeader;

// ---- Update Local Database Request Message: 18 bytes -------------------------

// Sent as UPDATE_LOCALDB_IN to request the local database download
entrypoint typedef struct _UpdateLocalDatabaseRequestMessage {
  UINT32BE last_update_security_time;     // bytes 0 to 3, signed, read here as unsigned
  UINT32BE last_update_participant_time;  // bytes 4 to 7, signed, read here as unsigned
  UINT8 request_for_open_orders;          // byte 8
  UINT8 reserved_1;                       // byte 9
  UINT16BE normal_market_status;          // bytes 10 to 11, signed, read here as unsigned
  UINT16BE odd_lot_market_status;         // bytes 12 to 13, signed, read here as unsigned
  UINT16BE spot_market_status;            // bytes 14 to 15, signed, read here as unsigned
  UINT16BE auction_market_status;         // bytes 16 to 17, signed, read here as unsigned
} UpdateLocalDatabaseRequestMessage;

// ---- Sec Info: 12 bytes ------------------------------------------------------

// SEC_INFO
entrypoint typedef struct _SecInfo {
  UINT8 symbol[10];  // bytes 0 to 9
  UINT8 series[2];   // bytes 10 to 11
} SecInfo;

// ---- Trade Cancellation Request Message: 74 bytes ----------------------------

// Sent as TRADE_CANCEL_IN to request cancellation of a trade
entrypoint typedef struct _TradeCancellationRequestMessage {
  SecInfo sec_info;                 // bytes 0 to 11
  UINT32BE reverse_leg_settl_date;  // bytes 12 to 15, signed, read here as unsigned
  UINT32BE l_fill_number;           // bytes 16 to 19, signed, read here as unsigned
  UINT32BE l_fill_qty;              // bytes 20 to 23, signed, read here as unsigned
  UINT32BE l_fill_price;            // bytes 24 to 27, signed, read here as unsigned
  UINT16BE i_mkt_type;              // bytes 28 to 29, signed, read here as unsigned
  UINT32BE l_new_volume;            // bytes 30 to 33, signed, read here as unsigned
  UINT8 buy_participant_id[12];     // bytes 34 to 45
  UINT8 sell_participant_id[12];    // bytes 46 to 57
  UINT8 buy_broker_id[5];           // bytes 58 to 62
  UINT8 sell_broker_id[5];          // bytes 63 to 67
  UINT32BE trader_id;               // bytes 68 to 71, signed, read here as unsigned
  UINT16BE requested_by;            // bytes 72 to 73, signed, read here as unsigned
} TradeCancellationRequestMessage;

// ---- Trade Modification Request Message: 74 bytes ----------------------------

// Sent as TRADE_MOD_IN; trade modification is currently not allowed
entrypoint typedef struct _TradeModificationRequestMessage {
  SecInfo sec_info;                 // bytes 0 to 11
  UINT32BE reverse_leg_settl_date;  // bytes 12 to 15, signed, read here as unsigned
  UINT32BE l_fill_number;           // bytes 16 to 19, signed, read here as unsigned
  UINT32BE l_fill_qty;              // bytes 20 to 23, signed, read here as unsigned
  UINT32BE l_fill_price;            // bytes 24 to 27, signed, read here as unsigned
  UINT16BE i_mkt_type;              // bytes 28 to 29, signed, read here as unsigned
  UINT32BE l_new_volume;            // bytes 30 to 33, signed, read here as unsigned
  UINT8 buy_participant_id[12];     // bytes 34 to 45
  UINT8 sell_participant_id[12];    // bytes 46 to 57
  UINT8 buy_broker_id[5];           // bytes 58 to 62
  UINT8 sell_broker_id[5];          // bytes 63 to 67
  UINT32BE trader_id;               // bytes 68 to 71, signed, read here as unsigned
  UINT16BE requested_by;            // bytes 72 to 73, signed, read here as unsigned
} TradeModificationRequestMessage;

// ---- Gateway Router Request Message: 8 bytes ---------------------------------

// Sent as GR_REQUEST to the gateway router over a TLS connection
entrypoint typedef struct _GatewayRouterRequestMessage {
  UINT16BE box_id;     // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];  // bytes 2 to 6
  UINT8 filler;        // byte 7
} GatewayRouterRequestMessage;

// ---- Secure Box Registration Request Message: 2 bytes ------------------------

// Sent as SECURE_BOX_REGISTRATION_REQUEST_IN on the new connection to the allocated gateway server
entrypoint typedef struct _SecureBoxRegistrationRequestMessage {
  UINT16BE box_id;  // bytes 0 to 1, signed, read here as unsigned
} SecureBoxRegistrationRequestMessage;

// ---- Box Sign On Request Message: 20 bytes -----------------------------------

// Sent as BOX_SIGN_ON_REQUEST_IN, the first encrypted message on the box connection
entrypoint typedef struct _BoxSignOnRequestMessage {
  UINT16BE box_id;       // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];    // bytes 2 to 6
  UINT8 reserved_5[5];   // bytes 7 to 11
  UINT8 session_key[8];  // bytes 12 to 19
} BoxSignOnRequestMessage;

