  UINT32BE trade_number;         // bytes 24 to 27, signed, read here as unsigned
  UINT32BE trade_price;          // bytes 28 to 31, signed, read here as unsigned
  UINT32BE trade_volume;         // bytes 32 to 35, signed, read here as unsigned
  UINT8 final;                   // byte 36
} TurnoverLimitExceededMessage;

// ---- Broker Reactivated Message: 37 bytes ------------------------------------

// Sent as BROADCAST_BROKER_ACTIVATED when a deactivated broker is reactivated
entrypoint typedef struct _BrokerReactivatedMessage {
  UINT8 broker_code[5];          // bytes 0 to 4
  UINT8 counter_broker_code[5];  // bytes 5 to 9
  UINT16BE warning_type;         // bytes 10 to 11, signed, read here as unsigned
  SecInfo sec_info;              // bytes 12 to 23
  UINT32BE trade_number;         // bytes 24 to 27, signed, read here as unsigned
  UINT32BE trade_price;          // bytes 28 to 31, signed, read here as unsigned
  UINT32BE trade_volume;         // bytes 32 to 35, signed, read here as unsigned
  UINT8 final;                   // byte 36
} BrokerReactivatedMessage;

