  UINT32BE log_time;          // bytes 4 to 7, signed, read here as unsigned
  UINT8 alpha_char[2];        // bytes 8 to 9
  UINT16BE transaction_code;  // bytes 10 to 11, signed, read here as unsigned
  UINT16BE error_code;        // bytes 12 to 13, signed, read here as unsigned
  UINT32BE bc_seq_no;         // bytes 14 to 17, signed, read here as unsigned
  UINT8 reserved_18;          // byte 18
  UINT8 reserved_19[3];       // bytes 19 to 21
  UINT8 time_stamp_2[8];      // bytes 22 to 29
  UINT8 filler_2[8];          // bytes 30 to 37
  UINT16BE message_length;    // bytes 38 to 39, signed, read here as unsigned
} BcastHeader;

// ---- Sec Info: 12 bytes ------------------------------------------------------

// SEC_INFO
entrypoint typedef struct _SecInfo {
  UINT8 symbol[10];  // bytes 0 to 9
