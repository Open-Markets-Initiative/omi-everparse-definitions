// Branch
casetype _ServerMessagePayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x08FD: SignOnOutMessage sign_on_out_message;
    case 0x08AE: TradeConfirmationMessage trade_confirmation_message;
    case 0x08EF: TradeModifyConfirmMessage trade_modify_confirm_message;
    case 0x08F0: TradeModifyRejectMessage trade_modify_reject_message;
    case 0x08EA: TradeCancelConfirmMessage trade_cancel_confirm_message;
    case 0x08EE: TradeCancelRejectMessage trade_cancel_reject_message;
    case 0x082A: NltTradeConfirmationMessage nlt_trade_confirmation_message;
    case 0x1549: NltTrdModConfirmationMessage nlt_trd_mod_confirmation_message;
    case 0x154A: NltTrdModRejectMessage nlt_trd_mod_reject_message;
    case 0x154C: NltTrdCxlConfirmationMessage nlt_trd_cxl_confirmation_message;
    case 0x154D: NltTrdCxlRejectMessage nlt_trd_cxl_reject_message;
    case 0x119A: GiveupAppConfirmTmMessage giveup_app_confirm_tm_message;
    case 0x119B: GiveupRejConfirmTmMessage giveup_rej_confirm_tm_message;
    case 0x07D1: BoardLotOutMessage board_lot_out_message;
    case 0x07F9: OrderModOutMessage order_mod_out_message;
    case 0x07FA: OrderModRejectMessage order_mod_reject_message;
    case 0x0817: OrderCancelOutMessage order_cancel_out_message;
    case 0x0818: OrderCancelRejectMessage order_cancel_reject_message;
    case 0x0819: OrderConfirmationMessage order_confirmation_message;
    case 0x081A: OrderModConfirmationMessage order_mod_confirmation_message;
    case 0x081B: OrderCancelConfirmationMessage order_cancel_confirmation_message;
    case 0x087A: FreezeToControlMessage freeze_to_control_message;
    case 0x08B7: OrderErrorMessage order_error_message;
    case 0x232A: BatchOrderCancelMessage batch_order_cancel_message;
    case 0x69DC: NetOrderErrorMessage net_order_error_message;
    case 0x0823: NltConfirmationMessage nlt_confirmation_message;
    case 0x0825: NltModConfirmationMessage nlt_mod_confirmation_message;
    case 0x0827: NltCxlConfirmationMessage nlt_cxl_confirmation_message;
    case 0x0828: NltModRejectMessage nlt_mod_reject_message;
    case 0x0829: NltCxlRejectMessage nlt_cxl_reject_message;
    case 0x084C: SpreadOrderConfirmationMessage spread_order_confirmation_message;
    case 0x086A: SpOrderErrorMessage sp_order_error_message;
    case 0x69DE: SpNetOrderErrorMessage sp_net_order_error_message;
    case 0x0852: SpreadCxlConfirmationMessage spread_cxl_confirmation_message;
    case 0x0858: SpreadModConfirmationMessage spread_mod_confirmation_message;
    case 0x0855: SpreadModRejectMessage spread_mod_reject_message;
    case 0x084F: SpreadCxlRejectMessage spread_cxl_reject_message;
    case 0x232C: BatchSpreadOrderCancelMessage batch_spread_order_cancel_message;
    case 0x084D: TwolOrderConfirmationMessage twol_order_confirmation_message;
    case 0x084E: ThrlOrderConfirmationMessage thrl_order_confirmation_message;
    case 0x086B: TwolOrderErrorMessage twol_order_error_message;
    case 0x086C: ThrlOrderErrorMessage thrl_order_error_message;
    case 0x69DF: TwolOrderErrorMessage twol_net_order_error_message;
    case 0x69E0: ThrlOrderErrorMessage thrl_net_order_error_message;
    case 0x0853: TwolOrderCxlConfirmationMessage twol_order_cxl_confirmation_message;
    case 0x0854: ThrlOrderCxlConfirmationMessage thrl_order_cxl_confirmation_message;
    default: UINT8 unknown[available];
  }
} ServerMessagePayload;

// One framed interactive message sent by the exchange
typedef struct _ServerDirectPacket {
  UINT16BE packet_length { packet_length >= 62 };                                                                                                                   // bytes 0 to 1
  UINT32BE packet_sequence_number;                                                                                                                                  // bytes 2 to 5
  UINT8 checksum[16];                                                                                                                                               // bytes 6 to 21
  UINT16BE transaction_code;                                                                                                                                        // bytes 22 to 23, signed, read here as unsigned
  UINT32BE log_time;                                                                                                                                                // bytes 24 to 27, signed, read here as unsigned
  UINT8 alpha_char[2];                                                                                                                                              // bytes 28 to 29
  UINT32BE trader_id;                                                                                                                                               // bytes 30 to 33, signed, read here as unsigned
  UINT16BE error_code;                                                                                                                                              // bytes 34 to 35, signed, read here as unsigned
  UINT64BE header_timestamp;                                                                                                                                        // bytes 36 to 43, signed, read here as unsigned
  UINT8 time_stamp_1[8];                                                                                                                                            // bytes 44 to 51
  UINT8 time_stamp_2[8];                                                                                                                                            // bytes 52 to 59
  UINT16BE message_length;                                                                                                                                          // bytes 60 to 61, signed, read here as unsigned
  ServerMessagePayload(transaction_code, (((UINT32) packet_length) - 62)) server_message_payload[:byte-size-single-element-array (((UINT32) packet_length) - 62)];
} ServerDirectPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// Nnf direct interface Tcp block of one or more packets sent by the exchange
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerDirectPacket server_direct_packet[:byte-size available];
} ServerPacket;

