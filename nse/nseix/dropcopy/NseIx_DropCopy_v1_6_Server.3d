// ---- Types -------------------------------------------------------------------

// Confirms the logon. Alpha Char carries the number of streams the drop copy feed is sent from, one download request being needed per stream. On an error the same transaction code carries the Error Response layout instead, distinguished only by a non zero Error Code
typedef struct _SignOnOutMessage {
  UINT32BE user_id;         // bytes 0 to 3, signed, read here as unsigned
  UINT8 password[8];        // bytes 4 to 11
  UINT8 reserved_8[8];      // bytes 12 to 19
  UINT8 reserved_30[30];    // bytes 20 to 49
  UINT8 broker_id[5];       // bytes 50 to 54
  UINT8 reserved_119[119];  // bytes 55 to 173
} SignOnOutMessage;

// CONTRACT_DESC
typedef struct _ContractDesc {
  UINT8 instrument_name[6];  // bytes 0 to 5
  UINT8 symbol[10];          // bytes 6 to 15
  UINT32BE expiry_date;      // bytes 16 to 19, signed, read here as unsigned
  UINT32BE strike_price;     // bytes 20 to 23, signed, read here as unsigned
  UINT8 option_type[2];      // bytes 24 to 25
  UINT16BE ca_level;         // bytes 26 to 27, signed, read here as unsigned
} ContractDesc;

// Confirms a trade
typedef struct _TradeConfirmationMessage {
  UINT8 response_order_number[8];                // bytes 0 to 7
  UINT8 broker_id[5];                            // bytes 8 to 12
  UINT8 reserved_1;                              // byte 13
  UINT32BE trader_num;                           // bytes 14 to 17, signed, read here as unsigned
  UINT8 account_num[10];                         // bytes 18 to 27
  UINT16BE buy_sell;                             // bytes 28 to 29, signed, read here as unsigned
  UINT32BE original_vol;                         // bytes 30 to 33, signed, read here as unsigned
  UINT32BE disclosed_vol;                        // bytes 34 to 37, signed, read here as unsigned
  UINT32BE remaining_vol;                        // bytes 38 to 41, signed, read here as unsigned
  UINT32BE disclosed_vol_remaining;              // bytes 42 to 45, signed, read here as unsigned
  UINT32BE price;                                // bytes 46 to 49, signed, read here as unsigned
  UINT16BE ato : 1;                              // bytes 50 to 51
  UINT16BE market : 1;                           // bytes 50 to 51
  UINT16BE sl : 1;                               // bytes 50 to 51
  UINT16BE mit : 1;                              // bytes 50 to 51
  UINT16BE day : 1;                              // bytes 50 to 51
  UINT16BE gtc : 1;                              // bytes 50 to 51
  UINT16BE ioc : 1;                              // bytes 50 to 51
  UINT16BE aon : 1;                              // bytes 50 to 51
  UINT16BE mf : 1;                               // bytes 50 to 51
  UINT16BE matched_ind : 1;                      // bytes 50 to 51
  UINT16BE traded : 1;                           // bytes 50 to 51
  UINT16BE modified : 1;                         // bytes 50 to 51
  UINT16BE frozen : 1;                           // bytes 50 to 51
  UINT16BE nlt_indc : 1;                         // bytes 50 to 51
  UINT16BE preclose : 1;                         // bytes 50 to 51
  UINT16BE preopen : 1;                          // bytes 50 to 51
  UINT32BE gtd;                                  // bytes 52 to 55, signed, read here as unsigned
  UINT32BE fill_number;                          // bytes 56 to 59, signed, read here as unsigned
  UINT32BE fill_qty;                             // bytes 60 to 63, signed, read here as unsigned
  UINT32BE fill_price;                           // bytes 64 to 67, signed, read here as unsigned
  UINT32BE vol_filled_today;                     // bytes 68 to 71, signed, read here as unsigned
  UINT8 activity_type[2];                        // bytes 72 to 73
  UINT32BE activity_time;                        // bytes 74 to 77, signed, read here as unsigned
  UINT8 op_order_number[8];                      // bytes 78 to 85
  UINT8 op_broker_id[5];                         // bytes 86 to 90
  UINT8 second_reserved_1;                       // byte 91
  UINT32BE token;                                // bytes 92 to 95, signed, read here as unsigned
  ContractDesc contract_desc;                    // bytes 96 to 123
  UINT8 open_close;                              // byte 124
  UINT8 old_open_close;                          // byte 125
  UINT8 trade_book_type;                         // byte 126
  UINT8 third_reserved_1;                        // byte 127
  UINT32BE new_volume;                           // bytes 128 to 131, signed, read here as unsigned
  UINT8 old_account_number[10];                  // bytes 132 to 141
  UINT8 participant[12];                         // bytes 142 to 153
  UINT8 old_participant[12];                     // bytes 154 to 165
  UINT8 additional_order_flags_reserved_1 : 1;   // byte 166
  UINT8 col : 1;                                 // byte 166
  UINT8 additional_order_flags_reserved_3 : 1;   // byte 166
  UINT8 additional_order_flags_reserved_4 : 1;   // byte 166
  UINT8 stpc : 1;                                // byte 166
  UINT8 session_ind : 1;                         // byte 166
  UINT8 additional_order_flags_reserved_78 : 2;  // byte 166
  UINT8 fourth_reserved_1;                       // byte 167
  UINT8 give_up_trade;                           // byte 168
  UINT8 fifth_reserved_1;                        // byte 169
  UINT8 reserved_10[10];                         // bytes 170 to 179
  UINT8 echo_back[16];                           // bytes 180 to 195
  UINT8 reserved_60[60];                         // bytes 196 to 255
} TradeConfirmationMessage;

