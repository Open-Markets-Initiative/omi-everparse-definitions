#define ERROR_CODE_E_HEARBEAT_NOT_RECEIVED 0x42CE                        // E Hearbeat Not Received
#define ERROR_CODE_E_SINGLE_USER_LOGIN_ALLOWED 0x42CF                    // E Single User Login Allowed
#define ERROR_CODE_E_INVALID_BOX_ID 0x42D0                               // E Invalid Box Id
#define ERROR_CODE_E_SEQ_NO_MISMATCH 0x42D1                              // E Seq No Mismatch
#define ERROR_CODE_E_BOX_RATE_EXCEEDED 0x42D2                            // E Box Rate Exceeded
#define ERROR_CODE_E_INVALID_BOX_IP_COMBINATION 0x4013                   // E Invalid Box Ip Combination
#define ERROR_CODE_ERR_INVALID_ALGO_ID 0x431B                            // Err Invalid Algo Id
#define ERROR_CODE_ERR_USER_HAVING_NULL_RIGHTS 0x4320                    // Err User Having Null Rights
#define ERROR_CODE_ERR_CHECKSUM_FAILED_GR 0x4A54                         // Err Checksum Failed Gr
#define ERROR_CODE_ERR_MULTIPLE_GR_QUERY_RCV 0x4A55                      // Err Multiple Gr Query Rcv
#define ERROR_CODE_ERR_ENCRYPTION_FLAG_MISMATCH 0x4A56                   // Err Encryption Flag Mismatch
#define ERROR_CODE_ERR_MD_5_CHECKSUM_FAILURE 0x4A57                      // Err Md 5 Checksum Failure

// Normal: 2 byte code
#define NORMAL_PREOPEN 0x0000        // Preopen
#define NORMAL_OPEN 0x0001           // Open
#define NORMAL_CLOSED 0x0002         // Closed
#define NORMAL_PREOPEN_END 0x0003    // Preopen End
#define NORMAL_PRE_CLOSE 0x0004      // Pre Close
#define NORMAL_PRE_CLOSE_END 0x0005  // Pre Close End

// Oddlot: 2 byte code
#define ODDLOT_PREOPEN 0x0000        // Preopen
#define ODDLOT_OPEN 0x0001           // Open
#define ODDLOT_CLOSED 0x0002         // Closed
#define ODDLOT_PREOPEN_END 0x0003    // Preopen End
#define ODDLOT_PRE_CLOSE 0x0004      // Pre Close
#define ODDLOT_PRE_CLOSE_END 0x0005  // Pre Close End

// Spot: 2 byte code
#define SPOT_PREOPEN 0x0000        // Preopen
#define SPOT_OPEN 0x0001           // Open
#define SPOT_CLOSED 0x0002         // Closed
#define SPOT_PREOPEN_END 0x0003    // Preopen End
#define SPOT_PRE_CLOSE 0x0004      // Pre Close
#define SPOT_PRE_CLOSE_END 0x0005  // Pre Close End

// Auction: 2 byte code
#define AUCTION_PREOPEN 0x0000        // Preopen
#define AUCTION_OPEN 0x0001           // Open
#define AUCTION_CLOSED 0x0002         // Closed
#define AUCTION_PREOPEN_END 0x0003    // Preopen End
#define AUCTION_PRE_CLOSE 0x0004      // Pre Close
#define AUCTION_PRE_CLOSE_END 0x0005  // Pre Close End

// Request For Open Orders: one byte code
#define REQUEST_FOR_OPEN_ORDERS_DOWNLOAD_GTC_AND_GTD_ORDERS 0x47  // Download Gtc And Gtd Orders
#define REQUEST_FOR_OPEN_ORDERS_NO_OPEN_ORDERS 0x4E               // No Open Orders

// Mkt Type: one byte code
#define MKT_TYPE_NORMAL_MARKET 0x31   // Normal Market
#define MKT_TYPE_ODD_LOT_MARKET 0x32  // Odd Lot Market
#define MKT_TYPE_SPOT_MARKET 0x33     // Spot Market
#define MKT_TYPE_AUCTION_MARKET 0x34  // Auction Market

// Buy Open Close: one byte code
#define BUY_OPEN_CLOSE_OPEN 0x4F   // Open
#define BUY_OPEN_CLOSE_CLOSE 0x43  // Close

// Requested By: one byte code
#define REQUESTED_BY_BUY 0x31   // Buy
#define REQUESTED_BY_SELL 0x32  // Sell
#define REQUESTED_BY_BOTH 0x33  // Both

// Sell Open Close: one byte code
#define SELL_OPEN_CLOSE_OPEN 0x4F   // Open
#define SELL_OPEN_CLOSE_CLOSE 0x43  // Close

// Col User Bit: one byte code
#define COL_USER_BIT_DISABLE_COL_STATUS 0x30  // Disable Col Status
#define COL_USER_BIT_ENABLE_COL_STATUS 0x31   // Enable Col Status

// Trd Mod Cxl Bit: one byte code
#define TRD_MOD_CXL_BIT_ENABLE 0x59   // Enable
#define TRD_MOD_CXL_BIT_DISABLE 0x4E  // Disable

// ---- Packet Header: 6 bytes --------------------------------------------------

// Packet Length and Sequence number, the first six bytes of the direct interface's twenty two byte packet header; its last sixteen open each packet body branch
entrypoint typedef struct _PacketHeader {
  UINT16BE packet_length;           // bytes 0 to 1
  UINT32BE packet_sequence_number;  // bytes 2 to 5
} PacketHeader;

// ---- Message Header: 40 bytes ------------------------------------------------

// MESSAGE_HEADER
entrypoint typedef struct _MessageHeader {
  UINT16BE transaction_code;  // bytes 0 to 1, values TRANSACTION_CODE_, signed, read here as unsigned
  UINT32BE log_time;          // bytes 2 to 5, signed, read here as unsigned
  UINT8 alpha_char[2];        // bytes 6 to 7
  UINT32BE trader_id;         // bytes 8 to 11, signed, read here as unsigned
  UINT16BE error_code;        // bytes 12 to 13, values ERROR_CODE_, signed, read here as unsigned
  UINT8 header_timestamp[8];  // bytes 14 to 21
  UINT8 time_stamp_1[8];      // bytes 22 to 29
  UINT8 time_stamp_2[8];      // bytes 30 to 37
  UINT16BE message_length;    // bytes 38 to 39, signed, read here as unsigned
} MessageHeader;

// ---- System Information In Message: 4 bytes ----------------------------------

// Requests the system information of the trading system
entrypoint typedef struct _SystemInformationInMessage {
  UINT32BE last_update_portfolio_time;  // bytes 0 to 3, signed, read here as unsigned
} SystemInformationInMessage;

// ---- St Market Status: 8 bytes -----------------------------------------------

// ST_MARKET_STATUS
entrypoint typedef struct _StMarketStatus {
  UINT16BE normal;   // bytes 0 to 1, values NORMAL_, signed, read here as unsigned
  UINT16BE oddlot;   // bytes 2 to 3, values ODDLOT_, signed, read here as unsigned
  UINT16BE spot;     // bytes 4 to 5, values SPOT_, signed, read here as unsigned
  UINT16BE auction;  // bytes 6 to 7, values AUCTION_, signed, read here as unsigned
} StMarketStatus;

// ---- St Ex Market Status: 8 bytes --------------------------------------------

// ST_EX_MARKET_STATUS
entrypoint typedef struct _StExMarketStatus {
  UINT16BE normal;   // bytes 0 to 1, values NORMAL_, signed, read here as unsigned
  UINT16BE oddlot;   // bytes 2 to 3, values ODDLOT_, signed, read here as unsigned
  UINT16BE spot;     // bytes 4 to 5, values SPOT_, signed, read here as unsigned
  UINT16BE auction;  // bytes 6 to 7, values AUCTION_, signed, read here as unsigned
} StExMarketStatus;

// ---- St Pl Market Status: 8 bytes --------------------------------------------

// ST_PL_MARKET_STATUS
entrypoint typedef struct _StPlMarketStatus {
  UINT16BE normal;   // bytes 0 to 1, values NORMAL_, signed, read here as unsigned
  UINT16BE oddlot;   // bytes 2 to 3, values ODDLOT_, signed, read here as unsigned
  UINT16BE spot;     // bytes 4 to 5, values SPOT_, signed, read here as unsigned
  UINT16BE auction;  // bytes 6 to 7, values AUCTION_, signed, read here as unsigned
} StPlMarketStatus;

// ---- Update Local Database In Message: 42 bytes ------------------------------

// Requests the local database download of securities, participants and open orders
entrypoint typedef struct _UpdateLocalDatabaseInMessage {
  UINT32BE last_update_security_time;     // bytes 0 to 3, signed, read here as unsigned
  UINT32BE last_update_participant_time;  // bytes 4 to 7, signed, read here as unsigned
  UINT32BE last_update_instrument_time;   // bytes 8 to 11, signed, read here as unsigned
  UINT32BE last_update_index_time;        // bytes 12 to 15, signed, read here as unsigned
  UINT8 request_for_open_orders;          // byte 16, values REQUEST_FOR_OPEN_ORDERS_
  UINT8 c_filler;                         // byte 17
  StMarketStatus st_market_status;        // bytes 18 to 25
  StExMarketStatus st_ex_market_status;   // bytes 26 to 33
  StPlMarketStatus st_pl_market_status;   // bytes 34 to 41
} UpdateLocalDatabaseInMessage;

// ---- Contract Desc: 28 bytes -------------------------------------------------

// CONTRACT_DESC
entrypoint typedef struct _ContractDesc {
  UINT8 instrument_name[6];  // bytes 0 to 5
  UINT8 symbol[10];          // bytes 6 to 15
  UINT32BE expiry_date;      // bytes 16 to 19, signed, read here as unsigned
  UINT32BE strike_price;     // bytes 20 to 23, signed, read here as unsigned
  UINT8 option_type[2];      // bytes 24 to 25
  UINT16BE ca_level;         // bytes 26 to 27, signed, read here as unsigned
} ContractDesc;

// ---- Trade Inquiry Body: 194 bytes -------------------------------------------

// Trade Inquiry Body
entrypoint typedef struct _TradeInquiryBody {
  UINT32BE token_no;              // bytes 0 to 3, signed, read here as unsigned
  ContractDesc contract_desc;     // bytes 4 to 31
  UINT32BE fill_number;           // bytes 32 to 35, signed, read here as unsigned
  UINT32BE fill_quantity;         // bytes 36 to 39, signed, read here as unsigned
  UINT32BE fill_price;            // bytes 40 to 43, signed, read here as unsigned
  UINT8 mkt_type;                 // byte 44, values MKT_TYPE_
  UINT8 buy_open_close;           // byte 45, values BUY_OPEN_CLOSE_
  UINT32BE new_volume;            // bytes 46 to 49, signed, read here as unsigned
  UINT8 buy_broker_id[5];         // bytes 50 to 54
  UINT8 sell_broker_id[5];        // bytes 55 to 59
  UINT32BE trader_id;             // bytes 60 to 63, signed, read here as unsigned
  UINT8 requested_by;             // byte 64, values REQUESTED_BY_
  UINT8 sell_open_close;          // byte 65, values SELL_OPEN_CLOSE_
  UINT8 buy_account_number[10];   // bytes 66 to 75
  UINT8 sell_account_number[10];  // bytes 76 to 85
  UINT8 buy_participant[12];      // bytes 86 to 97
  UINT8 sell_participant[12];     // bytes 98 to 109
  UINT8 reserved_2[2];            // bytes 110 to 111
  UINT8 buy_giveup_flag;          // byte 112
  UINT8 sell_giveup_flag;         // byte 113
  UINT8 reserved_80[80];          // bytes 114 to 193
} TradeInquiryBody;

// ---- Trade Inquiry Message: 194 bytes ----------------------------------------

// Trade modification and cancellation requests, including the negotiated large trade forms, carried in the shared trade structure
entrypoint typedef struct _TradeInquiryMessage {
  TradeInquiryBody trade_inquiry_body;  // bytes 0 to 193
} TradeInquiryMessage;

// ---- Gateway Router Request Message: 8 bytes ---------------------------------

// Asks the gateway router which gateway server to connect to
entrypoint typedef struct _GatewayRouterRequestMessage {
  UINT16BE box_id;     // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];  // bytes 2 to 6
  UINT8 filler;        // byte 7
} GatewayRouterRequestMessage;

// ---- Secure Box Registration Request In Message: 2 bytes ---------------------

// Registers the box with the allocated gateway server
entrypoint typedef struct _SecureBoxRegistrationRequestInMessage {
  UINT16BE box_id;  // bytes 0 to 1, signed, read here as unsigned
} SecureBoxRegistrationRequestInMessage;

// ---- Box Sign On Request In Message: 20 bytes --------------------------------

// Signs the box on to the allocated gateway server
entrypoint typedef struct _BoxSignOnRequestInMessage {
  UINT16BE box_id;       // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];    // bytes 2 to 6
  UINT8 reserved_5[5];   // bytes 7 to 11
  UINT8 session_key[8];  // bytes 12 to 19
} BoxSignOnRequestInMessage;

// ---- Reset User Password Message: 18 bytes -----------------------------------

// Requests a reset of a user's password to the default
entrypoint typedef struct _ResetUserPasswordMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_14[14];  // bytes 4 to 17
} ResetUserPasswordMessage;

// ---- Collateral User Status Change Request Message: 12 bytes -----------------

// Enables or disables cancel on logout for a user
entrypoint typedef struct _CollateralUserStatusChangeRequestMessage {
  UINT32BE user_id;     // bytes 0 to 3, signed, read here as unsigned
  UINT8 col_user_bit;   // byte 4, values COL_USER_BIT_
  UINT8 reserved_7[7];  // bytes 5 to 11
} CollateralUserStatusChangeRequestMessage;

// ---- User Trade Modify Cancel Status Change Request Message: 12 bytes --------

// Enables or disables trade modification or, with Alpha Char TX, trade cancellation for a user
entrypoint typedef struct _UserTradeModifyCancelStatusChangeRequestMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 trd_mod_cxl_bit;  // byte 4, values TRD_MOD_CXL_BIT_
  UINT8 reserved_7[7];    // bytes 5 to 11
} UserTradeModifyCancelStatusChangeRequestMessage;

// ---- User Address Unlock Request Message: 74 bytes ---------------------------

// Requests that a locked user be unlocked
entrypoint typedef struct _UserAddressUnlockRequestMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_70[70];  // bytes 4 to 73
} UserAddressUnlockRequestMessage;

// ---- Nlt Order Inquiry Request Message: 6 bytes ------------------------------

// One time inquiry by a corporate manager for the negotiated large trade counter orders placed against the member
entrypoint typedef struct _NltOrderInquiryRequestMessage {
  UINT8 broker_id[5];  // bytes 0 to 4
  UINT8 reserved_1;    // byte 5
} NltOrderInquiryRequestMessage;

