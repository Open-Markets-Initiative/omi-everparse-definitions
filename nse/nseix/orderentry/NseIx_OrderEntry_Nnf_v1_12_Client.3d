// User Type: 2 byte code
#define USER_TYPE_DEALER 0x0000             // Dealer
#define USER_TYPE_CORPORATE_MANAGER 0x0004  // Corporate Manager
#define USER_TYPE_BRANCH_MANAGER 0x0005     // Branch Manager

// Broker Status: one byte code
#define BROKER_STATUS_SUSPENDED 0x53            // Suspended
#define BROKER_STATUS_ACTIVE 0x41               // Active
#define BROKER_STATUS_DEACTIVATED 0x44          // Deactivated
#define BROKER_STATUS_CLOSEOUT 0x43             // Closeout
#define BROKER_STATUS_VOLUNTARY_CLOSE_OUT 0x56  // Voluntary Close Out

// Member Type: 2 byte code
#define MEMBER_TYPE_TRADING_MEMBER_ONLY 0x0001                              // Trading Member Only
#define MEMBER_TYPE_TRADING_AND_CLEARING_MEMBER 0x0002                      // Trading And Clearing Member
#define MEMBER_TYPE_CLEARING_MEMBER_ONLY 0x0003                             // Clearing Member Only
#define MEMBER_TYPE_PROFESSIONAL_CLEARING_MEMBER_AND_TRADING_MEMBER 0x0004  // Professional Clearing Member And Trading Member

// Clearing Status: one byte code
#define CLEARING_STATUS_ACTIVE 0x41               // Active
#define CLEARING_STATUS_SUSPENDED 0x53            // Suspended
#define CLEARING_STATUS_DEACTIVATED 0x44          // Deactivated
#define CLEARING_STATUS_VOLUNTARY_CLOSE_OUT 0x56  // Voluntary Close Out

// Request For Open Orders: one byte code
#define REQUEST_FOR_OPEN_ORDERS_DOWNLOAD_GTC_AND_GTD_ORDERS 0x47  // Download Gtc And Gtd Orders
#define REQUEST_FOR_OPEN_ORDERS_NO_OPEN_ORDERS 0x4E               // No Open Orders

// Normal: 2 byte code
#define NORMAL_PREOPEN 0x0000        // Preopen
#define NORMAL_OPEN 0x0001           // Open
#define NORMAL_CLOSED 0x0002         // Closed
#define NORMAL_PREOPEN_END 0x0003    // Preopen End
#define NORMAL_PRE_CLOSE 0x0004      // Pre Close
#define NORMAL_PRE_CLOSE_END 0x0005  // Pre Close End

// Oddlot: 2 byte code
#define ODDLOT_PREOPEN 0x0000        // Preopen
#define ODDLOT_OPEN 0x0001           // Open
#define ODDLOT_CLOSED 0x0002         // Closed
#define ODDLOT_PREOPEN_END 0x0003    // Preopen End
#define ODDLOT_PRE_CLOSE 0x0004      // Pre Close
#define ODDLOT_PRE_CLOSE_END 0x0005  // Pre Close End

// Spot: 2 byte code
#define SPOT_PREOPEN 0x0000        // Preopen
#define SPOT_OPEN 0x0001           // Open
#define SPOT_CLOSED 0x0002         // Closed
#define SPOT_PREOPEN_END 0x0003    // Preopen End
#define SPOT_PRE_CLOSE 0x0004      // Pre Close
#define SPOT_PRE_CLOSE_END 0x0005  // Pre Close End

// Auction: 2 byte code
#define AUCTION_PREOPEN 0x0000        // Preopen
#define AUCTION_OPEN 0x0001           // Open
#define AUCTION_CLOSED 0x0002         // Closed
#define AUCTION_PREOPEN_END 0x0003    // Preopen End
#define AUCTION_PRE_CLOSE 0x0004      // Pre Close
#define AUCTION_PRE_CLOSE_END 0x0005  // Pre Close End

// Modified Cancelled By: one byte code
#define MODIFIED_CANCELLED_BY_TRADER 0x54             // Trader
#define MODIFIED_CANCELLED_BY_BRANCH_MANAGER 0x42     // Branch Manager
#define MODIFIED_CANCELLED_BY_CORPORATE_MANAGER 0x4D  // Corporate Manager
#define MODIFIED_CANCELLED_BY_EXCHANGE 0x43           // Exchange

// Reason Code: 2 byte code
#define REASON_CODE_EXERCISE 0x0002                // Exercise
#define REASON_CODE_POSITION_LIQUIDATION 0x0003    // Position Liquidation
#define REASON_CODE_SECURITY 0x0005                // Security
#define REASON_CODE_BROKER 0x0006                  // Broker
#define REASON_CODE_BRANCH 0x0007                  // Branch
#define REASON_CODE_USER 0x0008                    // User
#define REASON_CODE_PARTICIPANT 0x0009             // Participant
#define REASON_CODE_COUNTER_PARTY 0x000A           // Counter Party
#define REASON_CODE_ORDER_NUMBER 0x000B            // Order Number
#define REASON_CODE_AUCTION_NUMBER 0x000F          // Auction Number
#define REASON_CODE_PRICE_FREEZE 0x0011            // Price Freeze
#define REASON_CODE_QUANTITY_FREEZE 0x0012         // Quantity Freeze
#define REASON_CODE_INVALID_EXPL 0x001D            // Invalid Expl
#define REASON_CODE_EXERCISE_MODE_MISMATCH 0x001E  // Exercise Mode Mismatch
#define REASON_CODE_EX_PL_NUMBER 0x001F            // Ex Pl Number

// Book Type: 2 byte code
#define BOOK_TYPE_REGULAR_LOT_ORDER 0x0001        // Regular Lot Order
#define BOOK_TYPE_SPECIAL_TERMS_ORDER 0x0002      // Special Terms Order
#define BOOK_TYPE_STOP_LOSS_OR_MIT_ORDER 0x0003   // Stop Loss Or Mit Order
#define BOOK_TYPE_NEGOTIATED_ORDER_OR_NLT 0x0004  // Negotiated Order Or Nlt
#define BOOK_TYPE_ODD_LOT_ORDER 0x0005            // Odd Lot Order
#define BOOK_TYPE_SPOT_ORDER 0x0006               // Spot Order
#define BOOK_TYPE_AUCTION_ORDER 0x0007            // Auction Order

// Buy Sell Indicator: 2 byte code
#define BUY_SELL_INDICATOR_BUY_ORDER 0x0001   // Buy Order
#define BUY_SELL_INDICATOR_SELL_ORDER 0x0002  // Sell Order

// Open Close: one byte code
#define OPEN_CLOSE_OPEN 0x4F   // Open
#define OPEN_CLOSE_CLOSE 0x43  // Close

// Pro Client Indicator: 2 byte code
#define PRO_CLIENT_INDICATOR_CLIENT_ORDER 0x0001  // Client Order
#define PRO_CLIENT_INDICATOR_BROKER_ORDER 0x0002  // Broker Order

// Buy Sell: 2 byte code
#define BUY_SELL_BUY_ORDER 0x0001   // Buy Order
#define BUY_SELL_SELL_ORDER 0x0002  // Sell Order

// Mkt Type: one byte code
#define MKT_TYPE_NORMAL_MARKET 0x31   // Normal Market
#define MKT_TYPE_ODD_LOT_MARKET 0x32  // Odd Lot Market
#define MKT_TYPE_SPOT_MARKET 0x33     // Spot Market
#define MKT_TYPE_AUCTION_MARKET 0x34  // Auction Market

// Buy Open Close: one byte code
#define BUY_OPEN_CLOSE_OPEN 0x4F   // Open
#define BUY_OPEN_CLOSE_CLOSE 0x43  // Close

// Requested By: one byte code
#define REQUESTED_BY_BUY 0x31   // Buy
#define REQUESTED_BY_SELL 0x32  // Sell
#define REQUESTED_BY_BOTH 0x33  // Both

// Sell Open Close: one byte code
#define SELL_OPEN_CLOSE_OPEN 0x4F   // Open
#define SELL_OPEN_CLOSE_CLOSE 0x43  // Close

// Book Type 1: 2 byte code
#define BOOK_TYPE_1_REGULAR_LOT_ORDER 0x0001    // Regular Lot Order
#define BOOK_TYPE_1_SPECIAL_TERMS_ORDER 0x0002  // Special Terms Order

// Col User Bit: one byte code
#define COL_USER_BIT_DISABLE_COL_STATUS 0x30  // Disable Col Status
#define COL_USER_BIT_ENABLE_COL_STATUS 0x31   // Enable Col Status

// Trd Mod Cxl Bit: one byte code
#define TRD_MOD_CXL_BIT_ENABLE 0x59   // Enable
#define TRD_MOD_CXL_BIT_DISABLE 0x4E  // Disable

// ---- Types -------------------------------------------------------------------

// Logs a trader on to the trading system, and the same structure sent by a corporate or branch manager to reset a user's session
typedef struct _SignOnRequestInMessage {
  UINT32BE user_id;                    // bytes 0 to 3, signed, read here as unsigned
  UINT8 password[8];                   // bytes 4 to 11
  UINT8 new_password[8];               // bytes 12 to 19
  UINT8 trader_name[26];               // bytes 20 to 45
  UINT32BE last_password_change_date;  // bytes 46 to 49, signed, read here as unsigned
  UINT8 broker_id[5];                  // bytes 50 to 54
  UINT8 reserved_1;                    // byte 55
  UINT16BE branch_id;                  // bytes 56 to 57, signed, read here as unsigned
  UINT32BE version_number;             // bytes 58 to 61, signed, read here as unsigned
  UINT32BE batch_2_start_time;         // bytes 62 to 65, signed, read here as unsigned
  UINT8 host_switch_context;           // byte 66
  UINT8 colour[50];                    // bytes 67 to 116
  UINT8 second_reserved_1;             // byte 117
  UINT16BE user_type;                  // bytes 118 to 119, signed, read here as unsigned
  UINT8 sequence_number[8];            // bytes 120 to 127
  UINT8 ws_class_name[14];             // bytes 128 to 141
  UINT8 broker_status;                 // byte 142
  UINT8 third_reserved_1;              // byte 143
  UINT16BE normal_market : 1;          // bytes 144 to 145
  UINT16BE oddlot_market : 1;          // bytes 144 to 145
  UINT16BE spot_market : 1;            // bytes 144 to 145
  UINT16BE auction_market : 1;         // bytes 144 to 145
  UINT16BE preopen : 1;                // bytes 144 to 145
  UINT16BE pre_close : 1;              // bytes 144 to 145
  UINT16BE nlt : 1;                    // bytes 144 to 145
  UINT16BE reserved_19 : 9;            // bytes 144 to 145
  UINT16BE member_type;                // bytes 146 to 147, signed, read here as unsigned
  UINT8 clearing_status;               // byte 148
  UINT8 broker_name[25];               // bytes 149 to 173
} SignOnRequestInMessage;

// Requests the system information of the trading system
typedef struct _SystemInformationInMessage {
  UINT32BE last_update_portfolio_time;  // bytes 0 to 3, signed, read here as unsigned
} SystemInformationInMessage;

// ST_MARKET_STATUS
typedef struct _StMarketStatus {
  UINT16BE normal;   // bytes 0 to 1, signed, read here as unsigned
  UINT16BE oddlot;   // bytes 2 to 3, signed, read here as unsigned
  UINT16BE spot;     // bytes 4 to 5, signed, read here as unsigned
  UINT16BE auction;  // bytes 6 to 7, signed, read here as unsigned
} StMarketStatus;

// ST_EX_MARKET_STATUS
typedef struct _StExMarketStatus {
  UINT16BE normal;   // bytes 0 to 1, signed, read here as unsigned
  UINT16BE oddlot;   // bytes 2 to 3, signed, read here as unsigned
  UINT16BE spot;     // bytes 4 to 5, signed, read here as unsigned
  UINT16BE auction;  // bytes 6 to 7, signed, read here as unsigned
} StExMarketStatus;

// ST_PL_MARKET_STATUS
typedef struct _StPlMarketStatus {
  UINT16BE normal;   // bytes 0 to 1, signed, read here as unsigned
  UINT16BE oddlot;   // bytes 2 to 3, signed, read here as unsigned
  UINT16BE spot;     // bytes 4 to 5, signed, read here as unsigned
  UINT16BE auction;  // bytes 6 to 7, signed, read here as unsigned
} StPlMarketStatus;

// Requests the local database download of securities, participants and open orders
typedef struct _UpdateLocalDatabaseInMessage {
  UINT32BE last_update_security_time;     // bytes 0 to 3, signed, read here as unsigned
  UINT32BE last_update_participant_time;  // bytes 4 to 7, signed, read here as unsigned
  UINT32BE last_update_instrument_time;   // bytes 8 to 11, signed, read here as unsigned
  UINT32BE last_update_index_time;        // bytes 12 to 15, signed, read here as unsigned
  UINT8 request_for_open_orders;          // byte 16
  UINT8 c_filler;                         // byte 17
  StMarketStatus st_market_status;        // bytes 18 to 25
  StExMarketStatus st_ex_market_status;   // bytes 26 to 33
  StPlMarketStatus st_pl_market_status;   // bytes 34 to 41
} UpdateLocalDatabaseInMessage;

// Requests the message download for one stream
typedef struct _DownloadRequestMessage {
  UINT8 sequence_number[8];  // bytes 0 to 7
} DownloadRequestMessage;

// CONTRACT_DESC
typedef struct _ContractDesc {
  UINT8 instrument_name[6];  // bytes 0 to 5
  UINT8 symbol[10];          // bytes 6 to 15
  UINT32BE expiry_date;      // bytes 16 to 19, signed, read here as unsigned
  UINT32BE strike_price;     // bytes 20 to 23, signed, read here as unsigned
  UINT8 option_type[2];      // bytes 24 to 25
  UINT16BE ca_level;         // bytes 26 to 27, signed, read here as unsigned
} ContractDesc;

// Order Entry Body
typedef struct _OrderEntryBody {
  UINT8 participant_type;               // byte 0
  UINT8 reserved_1;                     // byte 1
  UINT16BE competitor_period;           // bytes 2 to 3, signed, read here as unsigned
  UINT16BE solicitor_period;            // bytes 4 to 5, signed, read here as unsigned
  UINT8 modified_cancelled_by;          // byte 6
  UINT8 second_reserved_1;              // byte 7
  UINT16BE reason_code;                 // bytes 8 to 9, signed, read here as unsigned
  UINT8 reserved_4[4];                  // bytes 10 to 13
  UINT32BE token_no;                    // bytes 14 to 17, signed, read here as unsigned
  ContractDesc contract_desc;           // bytes 18 to 45
  UINT8 counter_party_broker_id[5];     // bytes 46 to 50
  UINT8 third_reserved_1;               // byte 51
  UINT8 reserved_2[2];                  // bytes 52 to 53
  UINT8 closeout_flag;                  // byte 54
  UINT8 fourth_reserved_1;              // byte 55
  UINT16BE order_type;                  // bytes 56 to 57, signed, read here as unsigned
  UINT8 order_number[8];                // bytes 58 to 65
  UINT8 account_number[10];             // bytes 66 to 75
  UINT16BE book_type;                   // bytes 76 to 77, signed, read here as unsigned
  UINT16BE buy_sell_indicator;          // bytes 78 to 79, signed, read here as unsigned
  UINT32BE disclosed_volume;            // bytes 80 to 83, signed, read here as unsigned
  UINT32BE disclosed_volume_remaining;  // bytes 84 to 87, signed, read here as unsigned
  UINT32BE total_volume_remaining;      // bytes 88 to 91, signed, read here as unsigned
  UINT32BE volume;                      // bytes 92 to 95, signed, read here as unsigned
  UINT32BE volume_filled_today;         // bytes 96 to 99, signed, read here as unsigned
  UINT32BE price;                       // bytes 100 to 103, signed, read here as unsigned
  UINT32BE trigger_price;               // bytes 104 to 107, signed, read here as unsigned
  UINT8 good_till_date[4];              // bytes 108 to 111
  UINT32BE entry_date_time;             // bytes 112 to 115, signed, read here as unsigned
  UINT32BE minimum_fill_aon_volume;     // bytes 116 to 119, signed, read here as unsigned
  UINT32BE last_modified;               // bytes 120 to 123, signed, read here as unsigned
  UINT16BE ato : 1;                     // bytes 124 to 125
  UINT16BE market : 1;                  // bytes 124 to 125
  UINT16BE sl : 1;                      // bytes 124 to 125
  UINT16BE mit : 1;                     // bytes 124 to 125
  UINT16BE day : 1;                     // bytes 124 to 125
  UINT16BE gtc : 1;                     // bytes 124 to 125
  UINT16BE ioc : 1;                     // bytes 124 to 125
  UINT16BE aon : 1;                     // bytes 124 to 125
  UINT16BE mf : 1;                      // bytes 124 to 125
  UINT16BE matched_ind : 1;             // bytes 124 to 125
  UINT16BE traded : 1;                  // bytes 124 to 125
  UINT16BE modified : 1;                // bytes 124 to 125
  UINT16BE frozen : 1;                  // bytes 124 to 125
  UINT16BE preopen : 1;                 // bytes 124 to 125
  UINT16BE pre_close : 1;               // bytes 124 to 125
  UINT16BE nlt_indc : 1;                // bytes 124 to 125
  UINT16BE branch_id;                   // bytes 126 to 127, signed, read here as unsigned
  UINT32BE trader_id;                   // bytes 128 to 131, signed, read here as unsigned
  UINT8 broker_id[5];                   // bytes 132 to 136
  UINT8 c_ord_filler[24];               // bytes 137 to 160
  UINT8 open_close;                     // byte 161
  UINT8 settlor[12];                    // bytes 162 to 173
  UINT16BE pro_client_indicator;        // bytes 174 to 175, signed, read here as unsigned
  UINT16BE settlement_period;           // bytes 176 to 177, signed, read here as unsigned
  UINT8 reserved_bit_1 : 1;             // byte 178
  UINT8 col : 1;                        // byte 178
  UINT8 reserved_34 : 2;                // byte 178
  UINT8 stpc : 1;                       // byte 178
  UINT8 session_ind : 1;                // byte 178
  UINT8 reserved_78 : 2;                // byte 178
  UINT8 giveup_flag;                    // byte 179
  UINT8 reference[4];                   // bytes 180 to 183
  UINT8 nnf_field[8];                   // bytes 184 to 191
  UINT8 mkt_replay[8];                  // bytes 192 to 199
  UINT8 echo_back[16];                  // bytes 200 to 215
  UINT64BE last_activity_reference;     // bytes 216 to 223, signed, read here as unsigned
  UINT8 reserved_52[52];                // bytes 224 to 275
} OrderEntryBody;

// Order entry request, and the negotiated large trade order entry, carried in the shared order entry structure
typedef struct _OrderEntryRequestMessage {
  OrderEntryBody order_entry_body;  // bytes 0 to 275
} OrderEntryRequestMessage;

// Order modification request, and the negotiated large trade modification, carried in the shared order entry structure
typedef struct _OrderModificationRequestMessage {
  OrderEntryBody order_entry_body;  // bytes 0 to 275
} OrderModificationRequestMessage;

// Order cancellation request, and the negotiated large trade cancellation, carried in the shared order entry structure
typedef struct _OrderCancellationRequestMessage {
  OrderEntryBody order_entry_body;  // bytes 0 to 275
} OrderCancellationRequestMessage;

// Cancels all of a trader's orders, or with a Trader Id of zero all of the trading member's, carried in the shared order entry structure
typedef struct _KillSwitchRequestMessage {
  OrderEntryBody order_entry_body;  // bytes 0 to 275
} KillSwitchRequestMessage;

// Modifies the price of a live regular lot order
typedef struct _PriceModificationMessage {
  UINT32BE token_no;                 // bytes 0 to 3, signed, read here as unsigned
  UINT32BE trader_id;                // bytes 4 to 7, signed, read here as unsigned
  UINT8 order_number[8];             // bytes 8 to 15
  UINT16BE buy_sell;                 // bytes 16 to 17, signed, read here as unsigned
  UINT32BE price;                    // bytes 18 to 21, signed, read here as unsigned
  UINT32BE volume;                   // bytes 22 to 25, signed, read here as unsigned
  UINT32BE last_modified;            // bytes 26 to 29, signed, read here as unsigned
  UINT8 reference[4];                // bytes 30 to 33
  UINT64BE last_activity_reference;  // bytes 34 to 41, signed, read here as unsigned
  UINT8 reserved_24[24];             // bytes 42 to 65
} PriceModificationMessage;

// Trade Inquiry Body
typedef struct _TradeInquiryBody {
  UINT32BE token_no;              // bytes 0 to 3, signed, read here as unsigned
  ContractDesc contract_desc;     // bytes 4 to 31
  UINT32BE fill_number;           // bytes 32 to 35, signed, read here as unsigned
  UINT32BE fill_quantity;         // bytes 36 to 39, signed, read here as unsigned
  UINT32BE fill_price;            // bytes 40 to 43, signed, read here as unsigned
  UINT8 mkt_type;                 // byte 44
  UINT8 buy_open_close;           // byte 45
  UINT32BE new_volume;            // bytes 46 to 49, signed, read here as unsigned
  UINT8 buy_broker_id[5];         // bytes 50 to 54
  UINT8 sell_broker_id[5];        // bytes 55 to 59
  UINT32BE trader_id;             // bytes 60 to 63, signed, read here as unsigned
  UINT8 requested_by;             // byte 64
  UINT8 sell_open_close;          // byte 65
  UINT8 buy_account_number[10];   // bytes 66 to 75
  UINT8 sell_account_number[10];  // bytes 76 to 85
  UINT8 buy_participant[12];      // bytes 86 to 97
  UINT8 sell_participant[12];     // bytes 98 to 109
  UINT8 reserved_2[2];            // bytes 110 to 111
