  UINT16BE buy_sell_1;                           // bytes 78 to 79, signed, read here as unsigned
  UINT32BE disclosed_vol_1;                      // bytes 80 to 83, signed, read here as unsigned
  UINT32BE disclosed_vol_remaining_1;            // bytes 84 to 87, signed, read here as unsigned
