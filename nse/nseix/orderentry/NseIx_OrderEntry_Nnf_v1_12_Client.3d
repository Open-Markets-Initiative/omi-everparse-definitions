  UINT32BE min_fill_aon_1;                       // bytes 116 to 119, signed, read here as unsigned
  UINT32BE last_modified_1;                      // bytes 120 to 123, signed, read here as unsigned
  UINT16BE ato : 1;                              // bytes 124 to 125
  UINT16BE market : 1;                           // bytes 124 to 125
  UINT16BE sl : 1;                               // bytes 124 to 125
  UINT16BE mit : 1;                              // bytes 124 to 125
  UINT16BE day : 1;                              // bytes 124 to 125
  UINT16BE gtc : 1;                              // bytes 124 to 125
  UINT16BE ioc : 1;                              // bytes 124 to 125
  UINT16BE aon : 1;                              // bytes 124 to 125
  UINT16BE mf : 1;                               // bytes 124 to 125
  UINT16BE matched_ind : 1;                      // bytes 124 to 125
  UINT16BE traded : 1;                           // bytes 124 to 125
  UINT16BE modified : 1;                         // bytes 124 to 125
  UINT16BE frozen : 1;                           // bytes 124 to 125
  UINT16BE preopen : 1;                          // bytes 124 to 125
  UINT16BE pre_close : 1;                        // bytes 124 to 125
  UINT16BE nlt_indc : 1;                         // bytes 124 to 125
  UINT16BE branch_id_1;                          // bytes 126 to 127, signed, read here as unsigned
  UINT32BE trader_id_1;                          // bytes 128 to 131, signed, read here as unsigned
  UINT8 broker_id_1[5];                          // bytes 132 to 136
  UINT8 c_ord_filler[24];                        // bytes 137 to 160
  UINT8 open_close_1;                            // byte 161
  UINT8 settlor_1[12];                           // bytes 162 to 173
  UINT16BE pro_client_1;                         // bytes 174 to 175, signed, read here as unsigned
  UINT16BE settlement_period_1;                  // bytes 176 to 177, signed, read here as unsigned
  UINT8 reserved_bit_1 : 1;                      // byte 178
  UINT8 col : 1;                                 // byte 178
  UINT8 reserved_34 : 2;                         // byte 178
  UINT8 stpc : 1;                                // byte 178
  UINT8 session_ind : 1;                         // byte 178
  UINT8 reserved_78 : 2;                         // byte 178
  UINT8 giveup_flag_1;                           // byte 179
  UINT8 filler_116[2];                           // bytes 180 to 181
  UINT8 filler_17;                               // byte 182
  UINT8 filler_18;                               // byte 183
