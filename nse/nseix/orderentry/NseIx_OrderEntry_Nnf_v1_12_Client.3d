} SpreadOrderBody;

// Spread, two leg and three leg order entry, and spread modification and cancellation, carried in the shared spread structure. Transaction Code in the header names the request
typedef struct _SpreadOrderEntryRequestMessage {
  SpreadOrderBody spread_order_body;  // bytes 0 to 439
} SpreadOrderEntryRequestMessage;

// Mba Inquiry Definition
typedef struct _MbaInquiryDefinition {
  UINT32BE cumulative_quantity;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 total_value[8];          // bytes 4 to 11
  UINT32BE wap;                  // bytes 12 to 15, signed, read here as unsigned
} MbaInquiryDefinition;

// Requests the market by aggregate details for a user defined quantity, total value or weighted average price
typedef struct _MbaInquiryRequestMessage {
  UINT32BE token;                               // bytes 0 to 3, signed, read here as unsigned
  UINT16BE book;                                // bytes 4 to 5, signed, read here as unsigned
  UINT16BE buy_sell;                            // bytes 6 to 7, signed, read here as unsigned
  MbaInquiryDefinition mba_inquiry_definition;  // bytes 8 to 23
} MbaInquiryRequestMessage;

// Asks the gateway router which gateway server to connect to
typedef struct _GatewayRouterRequestMessage {
  UINT16BE box_id;     // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];  // bytes 2 to 6
  UINT8 filler;        // byte 7
} GatewayRouterRequestMessage;

// Registers the box with the allocated gateway server
typedef struct _SecureBoxRegistrationRequestInMessage {
  UINT16BE box_id;  // bytes 0 to 1, signed, read here as unsigned
} SecureBoxRegistrationRequestInMessage;

// Signs the box on to the allocated gateway server
typedef struct _BoxSignOnRequestInMessage {
  UINT16BE box_id;       // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];    // bytes 2 to 6
  UINT8 reserved_5[5];   // bytes 7 to 11
  UINT8 session_key[8];  // bytes 12 to 19
} BoxSignOnRequestInMessage;

// BRANCH_LIMITS
typedef struct _BranchLimits {
  UINT8 branch_buy_value_limit[8];   // bytes 0 to 7
  UINT8 branch_sell_value_limit[8];  // bytes 8 to 15
  UINT8 reserved_16[16];             // bytes 16 to 31
} BranchLimits;

// Branch Order Value Limit Body
typedef struct _BranchOrderValueLimitBody {
  UINT8 broker_id[5];       // bytes 0 to 4
  UINT8 reserved_25[25];    // bytes 5 to 29
  UINT16BE branch_id;       // bytes 30 to 31, signed, read here as unsigned
  UINT8 branch_limits[64];  // bytes 32 to 95
} BranchOrderValueLimitBody;

// Sets the buy and sell value limits for a branch
typedef struct _BranchOrderValueLimitUpdateRequestMessage {
  BranchOrderValueLimitBody branch_order_value_limit_body;  // bytes 0 to 95
} BranchOrderValueLimitUpdateRequestMessage;

// USER_LIMITS
typedef struct _UserLimits {
  UINT8 reserved_32[32];                 // bytes 0 to 31
  UINT8 user_order_buy_value_limit[8];   // bytes 32 to 39
  UINT8 user_order_sell_value_limit[8];  // bytes 40 to 47
  UINT8 reserved_16[16];                 // bytes 48 to 63
} UserLimits;

// User Order Value Limit Body
typedef struct _UserOrderValueLimitBody {
  UINT8 broker_id[5];      // bytes 0 to 4
  UINT8 reserved_1;        // byte 5
  UINT16BE branch_id;      // bytes 6 to 7, signed, read here as unsigned
  UINT8 reserved_26[26];   // bytes 8 to 33
  UINT32BE user_id;        // bytes 34 to 37, signed, read here as unsigned
  UINT8 reserved_2[2];     // bytes 38 to 39
  UINT8 user_limits[128];  // bytes 40 to 167
} UserOrderValueLimitBody;

// Sets the buy and sell order value limits for a user
typedef struct _UserOrderValueLimitUpdateMessage {
  UserOrderValueLimitBody user_order_value_limit_body;  // bytes 0 to 167
} UserOrderValueLimitUpdateMessage;

// Sets the order quantity and value limits for a user, or with 5771 the spread order limits
typedef struct _NormalOrderLimitUpdateMessage {
  UINT8 broker_id[5];        // bytes 0 to 4
  UINT8 reserved_1;          // byte 5
  UINT32BE user_id;          // bytes 6 to 9, signed, read here as unsigned
  UINT8 order_qty_limit[8];  // bytes 10 to 17
  UINT8 order_val_limit[8];  // bytes 18 to 25
} NormalOrderLimitUpdateMessage;

// Requests a reset of a user's password to the default
typedef struct _ResetUserPasswordMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_14[14];  // bytes 4 to 17
} ResetUserPasswordMessage;

// Enables or disables cancel on logout for a user
typedef struct _CollateralUserStatusChangeRequestMessage {
  UINT32BE user_id;     // bytes 0 to 3, signed, read here as unsigned
  UINT8 col_user_bit;   // byte 4
  UINT8 reserved_7[7];  // bytes 5 to 11
} CollateralUserStatusChangeRequestMessage;

// Enables or disables trade modification or, with Alpha Char TX, trade cancellation for a user
typedef struct _UserTradeModifyCancelStatusChangeRequestMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 trd_mod_cxl_bit;  // byte 4
  UINT8 reserved_7[7];    // bytes 5 to 11
} UserTradeModifyCancelStatusChangeRequestMessage;

// Requests that a locked user be unlocked
typedef struct _UserAddressUnlockRequestMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_70[70];  // bytes 4 to 73
} UserAddressUnlockRequestMessage;

// One time inquiry by a corporate manager for the negotiated large trade counter orders placed against the member
typedef struct _NltOrderInquiryRequestMessage {
  UINT8 broker_id[5];  // bytes 0 to 4
  UINT8 reserved_1;    // byte 5
} NltOrderInquiryRequestMessage;

// Branch
casetype _ClientMessagePayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x08FC: SignOnRequestInMessage sign_on_request_in_message;
    case 0x15D0: SignOnRequestInMessage sign_on_request_in_message_2;
    case 0x0910: unit sign_off_request_in_message;
    case 0x0640: SystemInformationInMessage system_information_in_message;
    case 0x1C84: UpdateLocalDatabaseInMessage update_local_database_in_message;
    case 0x1B58: DownloadRequestMessage download_request_message;
    case 0x07D0: OrderEntryRequestMessage order_entry_request_message;
    case 0x0822: OrderEntryRequestMessage order_entry_request_message_2;
    case 0x07F8: OrderModificationRequestMessage order_modification_request_message;
    case 0x0824: OrderModificationRequestMessage order_modification_request_message_2;
    case 0x0816: OrderCancellationRequestMessage order_cancellation_request_message;
    case 0x0826: OrderCancellationRequestMessage order_cancellation_request_message_2;
    case 0x080E: KillSwitchRequestMessage kill_switch_request_message;
    case 0x07DD: PriceModificationMessage price_modification_message;
    case 0x1540: TradeInquiryMessage trade_inquiry_message;
    case 0x1545: TradeInquiryMessage trade_inquiry_message_2;
    case 0x1548: TradeInquiryMessage trade_inquiry_message_3;
    case 0x154B: TradeInquiryMessage trade_inquiry_message_4;
    case 0x0834: SpreadOrderEntryRequestMessage spread_order_entry_request_message;
    case 0x0836: SpreadOrderEntryRequestMessage spread_order_entry_request_message_2;
    case 0x0838: SpreadOrderEntryRequestMessage spread_order_entry_request_message_3;
    case 0x083A: SpreadOrderEntryRequestMessage spread_order_entry_request_message_4;
    case 0x0846: SpreadOrderEntryRequestMessage spread_order_entry_request_message_5;
    case 0x0694: MbaInquiryRequestMessage mba_inquiry_request_message;
    case 0x0696: MbaInquiryRequestMessage mba_inquiry_request_message_2;
    case 0x0698: MbaInquiryRequestMessage mba_inquiry_request_message_3;
    case 0x0960: GatewayRouterRequestMessage gateway_router_request_message;
    case 0x59E0: SecureBoxRegistrationRequestInMessage secure_box_registration_request_in_message;
    case 0x59D8: BoxSignOnRequestInMessage box_sign_on_request_in_message;
    case 0x5BD2: unit heartbeat_message;
    case 0x1654: BranchOrderValueLimitUpdateRequestMessage branch_order_value_limit_update_request_message;
    case 0x1662: UserOrderValueLimitUpdateMessage user_order_value_limit_update_message;
    case 0x1664: NormalOrderLimitUpdateMessage normal_order_limit_update_message;
    case 0x168B: NormalOrderLimitUpdateMessage normal_order_limit_update_message_2;
    case 0x166C: ResetUserPasswordMessage reset_user_password_message;
    case 0x1670: CollateralUserStatusChangeRequestMessage collateral_user_status_change_request_message;
    case 0x166A: UserTradeModifyCancelStatusChangeRequestMessage user_trade_modify_cancel_status_change_request_message;
    case 0x1533: UserAddressUnlockRequestMessage user_address_unlock_request_message;
    case 0x04DA: NltOrderInquiryRequestMessage nlt_order_inquiry_request_message;
    default: UINT8 unknown[available];
  }
} ClientMessagePayload;

// Nnf interactive message sent by the firm
typedef struct _ClientMessage {
  UINT16BE transaction_code;                                                                                                                                          // bytes 0 to 1, signed, read here as unsigned
  UINT32BE log_time;                                                                                                                                                  // bytes 2 to 5, signed, read here as unsigned
  UINT8 alpha_char[2];                                                                                                                                                // bytes 6 to 7
  UINT32BE trader_id;                                                                                                                                                 // bytes 8 to 11, signed, read here as unsigned
  UINT16BE error_code;                                                                                                                                                // bytes 12 to 13, signed, read here as unsigned
  UINT8 header_timestamp[8];                                                                                                                                          // bytes 14 to 21
  UINT8 time_stamp_1[8];                                                                                                                                              // bytes 22 to 29
  UINT8 time_stamp_2[8];                                                                                                                                              // bytes 30 to 37
  UINT16BE message_length { message_length >= 40 };                                                                                                                   // bytes 38 to 39, signed, read here as unsigned
  ClientMessagePayload(transaction_code, (((UINT32) message_length) - 40)) client_message_payload[:byte-size-single-element-array (((UINT32) message_length) - 40)];
} ClientMessage;

// ---- Packet: ClientPacket ----------------------------------------------------

// Nnf Tcp block of one or more messages sent by the firm
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientMessage client_message[:byte-size available];
} ClientPacket;

