#define ERROR_CODE_E_INVALID_BOX_ID 0x42D0                               // E Invalid Box Id
#define ERROR_CODE_E_SEQ_NO_MISMATCH 0x42D1                              // E Seq No Mismatch
#define ERROR_CODE_E_BOX_RATE_EXCEEDED 0x42D2                            // E Box Rate Exceeded
#define ERROR_CODE_E_INVALID_BOX_IP_COMBINATION 0x4013                   // E Invalid Box Ip Combination
#define ERROR_CODE_ERR_INVALID_ALGO_ID 0x431B                            // Err Invalid Algo Id
#define ERROR_CODE_ERR_USER_HAVING_NULL_RIGHTS 0x4320                    // Err User Having Null Rights
#define ERROR_CODE_ERR_CHECKSUM_FAILED_GR 0x4A54                         // Err Checksum Failed Gr
#define ERROR_CODE_ERR_MULTIPLE_GR_QUERY_RCV 0x4A55                      // Err Multiple Gr Query Rcv
#define ERROR_CODE_ERR_ENCRYPTION_FLAG_MISMATCH 0x4A56                   // Err Encryption Flag Mismatch
#define ERROR_CODE_ERR_MD_5_CHECKSUM_FAILURE 0x4A57                      // Err Md 5 Checksum Failure

// ---- Types -------------------------------------------------------------------

// CONTRACT_DESC_TR
typedef struct _ContractDescTr {
  UINT8 instrument_name[6];  // bytes 0 to 5
  UINT8 symbol[10];          // bytes 6 to 15
  UINT32BE expiry_date;      // bytes 16 to 19, signed, read here as unsigned
  UINT32BE strike_price;     // bytes 20 to 23, signed, read here as unsigned
  UINT8 option_type[2];      // bytes 24 to 25
} ContractDescTr;

// Trimmed order entry request
typedef struct _BoardLotInTrimmedMessage {
  UINT32BE user_id;                  // bytes 0 to 3, signed, read here as unsigned
  UINT16BE reason_code;              // bytes 4 to 5, signed, read here as unsigned
  UINT32BE token_no;                 // bytes 6 to 9, signed, read here as unsigned
  ContractDescTr contract_desc_tr;   // bytes 10 to 35
  UINT8 account_number[10];          // bytes 36 to 45
  UINT16BE book_type;                // bytes 46 to 47, signed, read here as unsigned
  UINT16BE buy_sell_indicator;       // bytes 48 to 49, signed, read here as unsigned
  UINT32BE disclosed_volume;         // bytes 50 to 53, signed, read here as unsigned
  UINT32BE volume;                   // bytes 54 to 57, signed, read here as unsigned
  UINT32BE price;                    // bytes 58 to 61, signed, read here as unsigned
  UINT8 good_till_date[4];           // bytes 62 to 65
  UINT16BE ato : 1;                  // bytes 66 to 67
  UINT16BE market : 1;               // bytes 66 to 67
  UINT16BE sl : 1;                   // bytes 66 to 67
  UINT16BE mit : 1;                  // bytes 66 to 67
  UINT16BE day : 1;                  // bytes 66 to 67
  UINT16BE gtc : 1;                  // bytes 66 to 67
  UINT16BE ioc : 1;                  // bytes 66 to 67
  UINT16BE aon : 1;                  // bytes 66 to 67
  UINT16BE mf : 1;                   // bytes 66 to 67
  UINT16BE matched_ind : 1;          // bytes 66 to 67
  UINT16BE traded : 1;               // bytes 66 to 67
  UINT16BE modified : 1;             // bytes 66 to 67
  UINT16BE frozen : 1;               // bytes 66 to 67
  UINT16BE preopen : 1;              // bytes 66 to 67
  UINT16BE preclose : 1;             // bytes 66 to 67
  UINT16BE nlt_indc : 1;             // bytes 66 to 67
  UINT16BE branch_id;                // bytes 68 to 69, signed, read here as unsigned
  UINT32BE trader_id;                // bytes 70 to 73, signed, read here as unsigned
  UINT8 broker_id[5];                // bytes 74 to 78
  UINT8 open_close;                  // byte 79
  UINT8 settlor[12];                 // bytes 80 to 91
  UINT16BE pro_client_indicator;     // bytes 92 to 93, signed, read here as unsigned
  UINT8 reserved_bit_1 : 1;          // byte 94
  UINT8 col : 1;                     // byte 94
  UINT8 reserved_34 : 2;             // byte 94
  UINT8 stpc : 1;                    // byte 94
  UINT8 session_ind : 1;             // byte 94
  UINT8 reserved_78 : 2;             // byte 94
  UINT8 reserved_1;                  // byte 95
  UINT8 filler_4[4];                 // bytes 96 to 99
  UINT8 nnf_field[8];                // bytes 100 to 107
  UINT8 echo_back[16];               // bytes 108 to 123
  UINT64BE last_activity_reference;  // bytes 124 to 131, signed, read here as unsigned
  UINT8 reserved_24[24];             // bytes 132 to 155
} BoardLotInTrimmedMessage;

// Trimmed order modification, quick cancellation and cancellation requests
typedef struct _OrderModifyCancelTrimmedMessage {
  UINT32BE user_id;                     // bytes 0 to 3, signed, read here as unsigned
  UINT8 modified_cancelled_by;          // byte 4
  UINT8 filler_1;                       // byte 5
  UINT32BE token_no;                    // bytes 6 to 9, signed, read here as unsigned
  ContractDescTr contract_desc_tr;      // bytes 10 to 35
  UINT8 order_number[8];                // bytes 36 to 43
  UINT8 account_number[10];             // bytes 44 to 53
  UINT16BE book_type;                   // bytes 54 to 55, signed, read here as unsigned
  UINT16BE buy_sell_indicator;          // bytes 56 to 57, signed, read here as unsigned
  UINT32BE disclosed_volume;            // bytes 58 to 61, signed, read here as unsigned
  UINT32BE disclosed_volume_remaining;  // bytes 62 to 65, signed, read here as unsigned
  UINT32BE total_volume_remaining;      // bytes 66 to 69, signed, read here as unsigned
  UINT32BE volume;                      // bytes 70 to 73, signed, read here as unsigned
  UINT32BE volume_filled_today;         // bytes 74 to 77, signed, read here as unsigned
  UINT32BE price;                       // bytes 78 to 81, signed, read here as unsigned
  UINT8 good_till_date[4];              // bytes 82 to 85
  UINT32BE entry_date_time;             // bytes 86 to 89, signed, read here as unsigned
  UINT32BE last_modified;               // bytes 90 to 93, signed, read here as unsigned
  UINT16BE ato : 1;                     // bytes 94 to 95
  UINT16BE market : 1;                  // bytes 94 to 95
  UINT16BE sl : 1;                      // bytes 94 to 95
  UINT16BE mit : 1;                     // bytes 94 to 95
  UINT16BE day : 1;                     // bytes 94 to 95
  UINT16BE gtc : 1;                     // bytes 94 to 95
  UINT16BE ioc : 1;                     // bytes 94 to 95
  UINT16BE aon : 1;                     // bytes 94 to 95
  UINT16BE mf : 1;                      // bytes 94 to 95
  UINT16BE matched_ind : 1;             // bytes 94 to 95
  UINT16BE traded : 1;                  // bytes 94 to 95
  UINT16BE modified : 1;                // bytes 94 to 95
  UINT16BE frozen : 1;                  // bytes 94 to 95
  UINT16BE preopen : 1;                 // bytes 94 to 95
  UINT16BE preclose : 1;                // bytes 94 to 95
  UINT16BE nlt_indc : 1;                // bytes 94 to 95
  UINT16BE branch_id;                   // bytes 96 to 97, signed, read here as unsigned
  UINT32BE trader_id;                   // bytes 98 to 101, signed, read here as unsigned
  UINT8 broker_id[5];                   // bytes 102 to 106
  UINT8 open_close;                     // byte 107
  UINT8 settlor[12];                    // bytes 108 to 119
  UINT16BE pro_client_indicator;        // bytes 120 to 121, signed, read here as unsigned
  UINT8 reserved_bit_1 : 1;             // byte 122
  UINT8 col : 1;                        // byte 122
  UINT8 reserved_34 : 2;                // byte 122
  UINT8 stpc : 1;                       // byte 122
  UINT8 session_ind : 1;                // byte 122
  UINT8 reserved_78 : 2;                // byte 122
  UINT8 second_filler_1;                // byte 123
  UINT8 filler_4[4];                    // bytes 124 to 127
  UINT8 nnf_field[8];                   // bytes 128 to 135
  UINT8 echo_back[16];                  // bytes 136 to 151
  UINT64BE last_activity_reference;     // bytes 152 to 159, signed, read here as unsigned
  UINT8 reserved_24[24];                // bytes 160 to 183
} OrderModifyCancelTrimmedMessage;

// Trimmed price confirmation, order, modification and cancellation confirmations, modification and cancellation rejections and order error. Transaction Code names the response
typedef struct _OrderResponseTrimmedMessage {
  UINT32BE log_time;                    // bytes 0 to 3, signed, read here as unsigned
  UINT32BE user_id;                     // bytes 4 to 7, signed, read here as unsigned
  UINT16BE error_code;                  // bytes 8 to 9, signed, read here as unsigned
  UINT8 time_stamp_1[8];                // bytes 10 to 17
  UINT8 timestamp_2_char;               // byte 18
  UINT8 modified_cancelled_by;          // byte 19
  UINT16BE reason_code;                 // bytes 20 to 21, signed, read here as unsigned
  UINT32BE token_no;                    // bytes 22 to 25, signed, read here as unsigned
  ContractDescTr contract_desc_tr;      // bytes 26 to 51
  UINT8 closeout_flag;                  // byte 52
  UINT8 reserved_1;                     // byte 53
  UINT8 order_number[8];                // bytes 54 to 61
  UINT8 account_number[10];             // bytes 62 to 71
  UINT16BE book_type;                   // bytes 72 to 73, signed, read here as unsigned
  UINT16BE buy_sell_indicator;          // bytes 74 to 75, signed, read here as unsigned
  UINT32BE disclosed_volume;            // bytes 76 to 79, signed, read here as unsigned
  UINT32BE disclosed_volume_remaining;  // bytes 80 to 83, signed, read here as unsigned
  UINT32BE total_volume_remaining;      // bytes 84 to 87, signed, read here as unsigned
  UINT32BE volume;                      // bytes 88 to 91, signed, read here as unsigned
  UINT32BE volume_filled_today;         // bytes 92 to 95, signed, read here as unsigned
  UINT32BE price;                       // bytes 96 to 99, signed, read here as unsigned
  UINT8 good_till_date[4];              // bytes 100 to 103
  UINT32BE entry_date_time;             // bytes 104 to 107, signed, read here as unsigned
  UINT32BE last_modified;               // bytes 108 to 111, signed, read here as unsigned
  UINT16BE ato : 1;                     // bytes 112 to 113
  UINT16BE market : 1;                  // bytes 112 to 113
  UINT16BE sl : 1;                      // bytes 112 to 113
  UINT16BE mit : 1;                     // bytes 112 to 113
  UINT16BE day : 1;                     // bytes 112 to 113
  UINT16BE gtc : 1;                     // bytes 112 to 113
  UINT16BE ioc : 1;                     // bytes 112 to 113
  UINT16BE aon : 1;                     // bytes 112 to 113
  UINT16BE mf : 1;                      // bytes 112 to 113
  UINT16BE matched_ind : 1;             // bytes 112 to 113
  UINT16BE traded : 1;                  // bytes 112 to 113
  UINT16BE modified : 1;                // bytes 112 to 113
  UINT16BE frozen : 1;                  // bytes 112 to 113
  UINT16BE preopen : 1;                 // bytes 112 to 113
  UINT16BE preclose : 1;                // bytes 112 to 113
  UINT16BE nlt_indc : 1;                // bytes 112 to 113
  UINT16BE branch_id;                   // bytes 114 to 115, signed, read here as unsigned
  UINT32BE trader_id;                   // bytes 116 to 119, signed, read here as unsigned
  UINT8 broker_id[5];                   // bytes 120 to 124
  UINT8 open_close;                     // byte 125
  UINT8 settlor[12];                    // bytes 126 to 137
  UINT16BE pro_client_indicator;        // bytes 138 to 139, signed, read here as unsigned
  UINT8 reserved_bit_1 : 1;             // byte 140
  UINT8 col : 1;                        // byte 140
  UINT8 reserved_34 : 2;                // byte 140
  UINT8 stpc : 1;                       // byte 140
  UINT8 session_ind : 1;                // byte 140
  UINT8 reserved_78 : 2;                // byte 140
  UINT8 second_reserved_1;              // byte 141
  UINT8 filler_4[4];                    // bytes 142 to 145
  UINT8 nnf_field[8];                   // bytes 146 to 153
  UINT8 reserved_8[8];                  // bytes 154 to 161
  UINT8 echo_back[16];                  // bytes 162 to 177
  UINT64BE last_activity_reference;     // bytes 178 to 185, signed, read here as unsigned
  UINT8 reserved_52[52];                // bytes 186 to 237
} OrderResponseTrimmedMessage;

// Trimmed trade confirmation
typedef struct _TradeConfirmationTrimmedMessage {
  UINT32BE log_time;                    // bytes 0 to 3, signed, read here as unsigned
  UINT32BE trader_id;                   // bytes 4 to 7, signed, read here as unsigned
  UINT8 time_stamp[8];                  // bytes 8 to 15
  UINT8 time_stamp_1[8];                // bytes 16 to 23
  UINT8 timestamp_2_double[8];          // bytes 24 to 31
  UINT8 response_order_number[8];       // bytes 32 to 39
  UINT8 broker_id[5];                   // bytes 40 to 44
  UINT8 reserved_1;                     // byte 45
  UINT8 account_number[10];             // bytes 46 to 55
  UINT16BE buy_sell_indicator;          // bytes 56 to 57, signed, read here as unsigned
  UINT32BE original_volume;             // bytes 58 to 61, signed, read here as unsigned
  UINT32BE disclosed_volume;            // bytes 62 to 65, signed, read here as unsigned
  UINT32BE remaining_volume;            // bytes 66 to 69, signed, read here as unsigned
  UINT32BE disclosed_volume_remaining;  // bytes 70 to 73, signed, read here as unsigned
  UINT32BE price;                       // bytes 74 to 77, signed, read here as unsigned
  UINT16BE ato : 1;                     // bytes 78 to 79
  UINT16BE market : 1;                  // bytes 78 to 79
  UINT16BE sl : 1;                      // bytes 78 to 79
  UINT16BE mit : 1;                     // bytes 78 to 79
  UINT16BE day : 1;                     // bytes 78 to 79
  UINT16BE gtc : 1;                     // bytes 78 to 79
  UINT16BE ioc : 1;                     // bytes 78 to 79
  UINT16BE aon : 1;                     // bytes 78 to 79
  UINT16BE mf : 1;                      // bytes 78 to 79
  UINT16BE matched_ind : 1;             // bytes 78 to 79
  UINT16BE traded : 1;                  // bytes 78 to 79
  UINT16BE modified : 1;                // bytes 78 to 79
  UINT16BE frozen : 1;                  // bytes 78 to 79
  UINT16BE preopen : 1;                 // bytes 78 to 79
  UINT16BE preclose : 1;                // bytes 78 to 79
  UINT16BE nlt_indc : 1;                // bytes 78 to 79
  UINT8 good_till_date[4];              // bytes 80 to 83
  UINT32BE fill_number;                 // bytes 84 to 87, signed, read here as unsigned
  UINT32BE fill_quantity;               // bytes 88 to 91, signed, read here as unsigned
  UINT32BE fill_price;                  // bytes 92 to 95, signed, read here as unsigned
  UINT32BE volume_filled_today;         // bytes 96 to 99, signed, read here as unsigned
  UINT8 activity_type[2];               // bytes 100 to 101
  UINT32BE activity_time;               // bytes 102 to 105, signed, read here as unsigned
  UINT32BE token;                       // bytes 106 to 109, signed, read here as unsigned
  ContractDescTr contract_desc_tr;      // bytes 110 to 135
  UINT8 open_close;                     // byte 136
  UINT8 trade_book_type;                // byte 137
  UINT8 participant[12];                // bytes 138 to 149
  UINT8 reserved_bit_1 : 1;             // byte 150
  UINT8 col : 1;                        // byte 150
  UINT8 reserved_34 : 2;                // byte 150
  UINT8 stpc : 1;                       // byte 150
  UINT8 session_ind : 1;                // byte 150
  UINT8 reserved_78 : 2;                // byte 150
  UINT8 second_reserved_1;              // byte 151
  UINT8 echo_back[16];                  // bytes 152 to 167
  UINT64BE last_activity_reference;     // bytes 168 to 175, signed, read here as unsigned
  UINT8 reserved_52[52];                // bytes 176 to 227
} TradeConfirmationTrimmedMessage;

// Branch
casetype _MessagePayload (UINT16 selector) {
  switch (selector) {
    case 0x4E20: BoardLotInTrimmedMessage board_lot_in_trimmed_message;
    case 0x4E48: OrderModifyCancelTrimmedMessage order_modify_cancel_trimmed_message;
    case 0x4E5C: OrderModifyCancelTrimmedMessage order_modify_cancel_trimmed_message_2;
    case 0x4E66: OrderModifyCancelTrimmedMessage order_modify_cancel_trimmed_message_3;
    case 0x4E2C: OrderResponseTrimmedMessage order_response_trimmed_message;
    case 0x4E4A: OrderResponseTrimmedMessage order_response_trimmed_message_2;
    case 0x4E68: OrderResponseTrimmedMessage order_response_trimmed_message_3;
    case 0x4E69: OrderResponseTrimmedMessage order_response_trimmed_message_4;
    case 0x4E6A: OrderResponseTrimmedMessage order_response_trimmed_message_5;
    case 0x4E6B: OrderResponseTrimmedMessage order_response_trimmed_message_6;
    case 0x4F07: OrderResponseTrimmedMessage order_response_trimmed_message_7;
    case 0x4EFE: TradeConfirmationTrimmedMessage trade_confirmation_trimmed_message;
  }
} MessagePayload;

// Nnf trimmed message
typedef struct _Message {
  UINT16BE transaction_code;                         // bytes 0 to 1, signed, read here as unsigned
  MessagePayload(transaction_code) message_payload;
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// NnfTrimmed Tcp block of one or more messages
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

