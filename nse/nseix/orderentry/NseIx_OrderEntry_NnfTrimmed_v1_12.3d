#define ERROR_CODE_PARTIAL_QUICK_ORDER_CXL_REJ 0x4144                    // Partial Quick Order Cxl Rej
#define ERROR_CODE_E_PRICE_DIFF_OUT_OF_RANGE 0x4149                      // E Price Diff Out Of Range
#define ERROR_CODE_ERROR_ALGO_MKT_NOT_ALLOWED 0x415C                     // Error Algo Mkt Not Allowed
#define ERROR_CODE_ERROR_INVALID_NNFID_REJECTION 0x415D                  // Error Invalid Nnfid Rejection
#define ERROR_CODE_E_VC_ORDER_REJECTED 0x4199                            // E Vc Order Rejected
#define ERROR_CODE_E_SSD_ORDER_REJECTED 0x419A                           // E Ssd Order Rejected
#define ERROR_CODE_E_ORDER_CANCELLED_FOR_VC 0x419B                       // E Order Cancelled For Vc
#define ERROR_CODE_E_ORDER_CANCELLED_FOR_SSD 0x419C                      // E Order Cancelled For Ssd
#define ERROR_CODE_E_ACCOUNT_DEBARRED 0x41A7                             // E Account Debarred
#define ERROR_CODE_E_MBA_INQ_NOT_ALLOWED 0x428C                          // E Mba Inq Not Allowed
#define ERROR_CODE_E_MBA_INSUFF_RECORD 0x428D                            // E Mba Insuff Record
#define ERROR_CODE_E_OUTSTANDING_ORDER_PRESENT 0x428E                    // E Outstanding Order Present
#define ERROR_CODE_E_PRO_CLI_MOD_NOT_ALLOWED 0x428F                      // E Pro Cli Mod Not Allowed
#define ERROR_CODE_E_ORD_QTY_EXCEEDS_QTY_VAL_LIM 0x4295                  // E Ord Qty Exceeds Qty Val Lim
#define ERROR_CODE_E_USER_TYPE_TRD_MOD_DISABLED 0x4296                   // E User Type Trd Mod Disabled
#define ERROR_CODE_E_TM_TRADE_MOD_NOT_ALLOWED 0x4297                     // E Tm Trade Mod Not Allowed
#define ERROR_CODE_E_USER_TRD_MOD_DISABLED 0x4298                        // E User Trd Mod Disabled
#define ERROR_CODE_E_TRD_PRICE_OUT_OF_STOCK_TPP 0x42AE                   // E Trd Price Out Of Stock Tpp
#define ERROR_CODE_E_ORDER_CANCELLED_FOR_SELF_TRADE 0x42AF               // E Order Cancelled For Self Trade
#define ERROR_CODE_E_INVALID_PACKET 0x42CD                               // E Invalid Packet
#define ERROR_CODE_E_HEARBEAT_NOT_RECEIVED 0x42CE                        // E Hearbeat Not Received
