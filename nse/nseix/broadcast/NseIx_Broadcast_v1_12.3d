// ---- Values ------------------------------------------------------------------

// Transaction Code: 2 byte code
#define TRANSACTION_CODE_BROADCAST_JOURNAL_VCT_MESSAGE 0x1965                   // Broadcast Journal Vct Message
#define TRANSACTION_CODE_SECURITY_MASTER_CHANGE_MESSAGE 0x1C89                  // Security Master Change Message
#define TRANSACTION_CODE_SECURITY_MASTER_CHANGE_MESSAGE_X1CAC 0x1CAC            // Security Master Change Message
#define TRANSACTION_CODE_INSTRUMENT_MASTER_CHANGE_MESSAGE 0x1C9C                // Instrument Master Change Message
#define TRANSACTION_CODE_PARTICIPANT_MASTER_CHANGE_MESSAGE 0x1C8A               // Participant Master Change Message
#define TRANSACTION_CODE_SECURITY_STATUS_CHANGE_MESSAGE 0x1C98                  // Security Status Change Message
#define TRANSACTION_CODE_SECURITY_STATUS_CHANGE_MESSAGE_X1C2A 0x1C2A            // Security Status Change Message
#define TRANSACTION_CODE_TURNOVER_EXCEEDED_MESSAGE 0x2332                       // Turnover Exceeded Message
#define TRANSACTION_CODE_TURNOVER_EXCEEDED_MESSAGE_X2333 0x2333                 // Turnover Exceeded Message
#define TRANSACTION_CODE_MARKET_STATUS_MESSAGE 0x196F                           // Market Status Message
#define TRANSACTION_CODE_MARKET_STATUS_MESSAGE_X1979 0x1979                     // Market Status Message
#define TRANSACTION_CODE_MARKET_STATUS_MESSAGE_X197A 0x197A                     // Market Status Message
#define TRANSACTION_CODE_MARKET_STATUS_MESSAGE_X1983 0x1983                     // Market Status Message
#define TRANSACTION_CODE_MARKET_STATUS_MESSAGE_X1997 0x1997                     // Market Status Message
#define TRANSACTION_CODE_MARKET_STATUS_MESSAGE_X19AB 0x19AB                     // Market Status Message
#define TRANSACTION_CODE_TICKER_AND_MARKET_INDEX_MESSAGE 0x1C22                 // Ticker And Market Index Message
#define TRANSACTION_CODE_MARKET_BY_ORDER_AND_MARKET_BY_PRICE_MESSAGE 0x1C20     // Market By Order And Market By Price Message
#define TRANSACTION_CODE_ONLY_MARKET_BY_PRICE_MESSAGE 0x1C28                    // Only Market By Price Message
#define TRANSACTION_CODE_ONLY_MARKET_BY_PRICE_MESSAGE_X1CAF 0x1CAF              // Only Market By Price Message
#define TRANSACTION_CODE_MARKET_WATCH_ROUND_ROBIN_MESSAGE 0x1C21                // Market Watch Round Robin Message
#define TRANSACTION_CODE_CURRENCY_ASSETS_MESSAGE 0x1C2D                         // Currency Assets Message
#define TRANSACTION_CODE_INTEREST_RATE_ASSETS_MESSAGE 0x1C2E                    // Interest Rate Assets Message
#define TRANSACTION_CODE_CIRCUIT_CHECK_MESSAGE 0x198D                           // Circuit Check Message
#define TRANSACTION_CODE_SPREAD_MARKET_BY_PRICE_DELTA_MESSAGE 0x1C2B            // Spread Market By Price Delta Message
#define TRANSACTION_CODE_ASSET_OPEN_INTEREST_MESSAGE 0x1BDA                     // Asset Open Interest Message
#define TRANSACTION_CODE_ASSET_INTEREST_RATE_CHANGE_MESSAGE 0x1967              // Asset Interest Rate Change Message
#define TRANSACTION_CODE_TRADE_EXECUTION_RANGE_MESSAGE 0x1C34                   // Trade Execution Range Message
#define TRANSACTION_CODE_TRADE_EXECUTION_RANGE_MESSAGE_X1C35 0x1C35             // Trade Execution Range Message
#define TRANSACTION_CODE_TRADE_EXECUTION_RANGE_MESSAGE_X1CAE 0x1CAE             // Trade Execution Range Message
#define TRANSACTION_CODE_MARKET_BY_AGGREGATE_DELTA_MESSAGE 0x1C2F               // Market By Aggregate Delta Message
#define TRANSACTION_CODE_MARKET_BY_AGGREGATE_DELTA_MESSAGE_X1C30 0x1C30         // Market By Aggregate Delta Message
#define TRANSACTION_CODE_SPREAD_COMBINATION_MASTER_CHANGE_MESSAGE 0x1C8D        // Spread Combination Master Change Message
#define TRANSACTION_CODE_SPREAD_COMBINATION_MASTER_CHANGE_MESSAGE_X1CAD 0x1CAD  // Spread Combination Master Change Message

// Delete Flag: one byte code
#define DELETE_FLAG_DELETED 0x59  // Deleted
#define DELETE_FLAG_ACTIVE 0x4E   // Active

// Participant Status: one byte code
#define PARTICIPANT_STATUS_SUSPENDED 0x53  // Suspended
#define PARTICIPANT_STATUS_ACTIVE 0x41     // Active

// Warning Type: 2 byte code
#define WARNING_TYPE_TURNOVER_LIMIT_ABOUT_TO_EXCEED 0x0001  // Turnover Limit About To Exceed
#define WARNING_TYPE_TURNOVER_LIMIT_EXCEEDED 0x0002         // Turnover Limit Exceeded

// ---- Bcast Header: 40 bytes --------------------------------------------------

// BCAST_HEADER
entrypoint typedef struct _BcastHeader {
  UINT8 reserved_0[2];        // bytes 0 to 1
  UINT8 reserved_2[2];        // bytes 2 to 3
  UINT32BE log_time;          // bytes 4 to 7, signed, read here as unsigned
  UINT8 alpha_char[2];        // bytes 8 to 9
  UINT16BE transaction_code;  // bytes 10 to 11, values TRANSACTION_CODE_, signed, read here as unsigned
  UINT16BE error_code;        // bytes 12 to 13, signed, read here as unsigned
  UINT32BE bc_seq_no;         // bytes 14 to 17, signed, read here as unsigned
  UINT8 reserved_18;          // byte 18
  UINT8 reserved_19[3];       // bytes 19 to 21
  UINT8 time_stamp_2[8];      // bytes 22 to 29
  UINT8 filler_2[8];          // bytes 30 to 37
  UINT16BE message_length;    // bytes 38 to 39, signed, read here as unsigned
} BcastHeader;

// ---- Sec Info: 30 bytes ------------------------------------------------------

// SEC_INFO
entrypoint typedef struct _SecInfo {
  UINT8 instrument_name[6];  // bytes 0 to 5
  UINT8 symbol[10];          // bytes 6 to 15
  UINT8 series[2];           // bytes 16 to 17
  UINT32BE expiry_date;      // bytes 18 to 21, signed, read here as unsigned
  UINT32BE strike_price;     // bytes 22 to 25, signed, read here as unsigned
  UINT8 option_type[2];      // bytes 26 to 27
  UINT16BE ca_level;         // bytes 28 to 29, signed, read here as unsigned
} SecInfo;

// ---- Instrument Master Change Message: 39 bytes ------------------------------

// Broadcasts a change to the instrument master
entrypoint typedef struct _InstrumentMasterChangeMessage {
  UINT16BE instrument_id;                // bytes 0 to 1, signed, read here as unsigned
  UINT8 instrument_name[6];              // bytes 2 to 7
  UINT8 instrument_description[26];      // bytes 8 to 33
  UINT32BE instrument_update_date_time;  // bytes 34 to 37, signed, read here as unsigned
  UINT8 delete_flag;                     // byte 38, values DELETE_FLAG_
} InstrumentMasterChangeMessage;

// ---- Participant Master Change Message: 43 bytes -----------------------------

// Broadcasts a change to a participant
entrypoint typedef struct _ParticipantMasterChangeMessage {
  UINT8 participant_id[12];               // bytes 0 to 11
  UINT8 participant_name[25];             // bytes 12 to 36
  UINT8 participant_status;               // byte 37, values PARTICIPANT_STATUS_
  UINT32BE participant_update_date_time;  // bytes 38 to 41, signed, read here as unsigned
  UINT8 delete_flag;                      // byte 42, values DELETE_FLAG_
} ParticipantMasterChangeMessage;

// ---- Turnover Exceeded Message: 58 bytes -------------------------------------

// Broadcast when a broker's turnover limit is about to exceed or has exceeded, or when the broker is reactivated
entrypoint typedef struct _TurnoverExceededMessage {
  UINT8 broker_code[5];          // bytes 0 to 4
  UINT8 counter_broker_code[5];  // bytes 5 to 9
  UINT16BE warning_type;         // bytes 10 to 11, values WARNING_TYPE_, signed, read here as unsigned
  UINT32BE token;                // bytes 12 to 15, signed, read here as unsigned
  UINT8 instrument_name[6];      // bytes 16 to 21
  UINT8 symbol[10];              // bytes 22 to 31
  UINT32BE expiry_date;          // bytes 32 to 35, signed, read here as unsigned
  UINT32BE strike_price;         // bytes 36 to 39, signed, read here as unsigned
  UINT8 option_type[2];          // bytes 40 to 41
  UINT16BE ca_level;             // bytes 42 to 43, signed, read here as unsigned
  UINT32BE trade_number;         // bytes 44 to 47, signed, read here as unsigned
  UINT32BE trade_price;          // bytes 48 to 51, signed, read here as unsigned
  UINT32BE trade_volume;         // bytes 52 to 55, signed, read here as unsigned
  UINT8 final;                   // byte 56
  UINT8 c_filler;                // byte 57
} TurnoverExceededMessage;

// ---- Currency Assets Message: 36 bytes ---------------------------------------

// Broadcasts the price details of an asset
entrypoint typedef struct _CurrencyAssetsMessage {
  UINT32BE token;          // bytes 0 to 3, signed, read here as unsigned
  UINT32BE bid_price;      // bytes 4 to 7, signed, read here as unsigned
  UINT32BE ask_price;      // bytes 8 to 11, signed, read here as unsigned
  UINT32BE deal_price;     // bytes 12 to 15, signed, read here as unsigned
  UINT8 symbol[10];        // bytes 16 to 25
  UINT8 instrument[6];     // bytes 26 to 31
  UINT32BE closing_price;  // bytes 32 to 35, signed, read here as unsigned
} CurrencyAssetsMessage;

// ---- Asset Interest Rate Change Message: 12 bytes ----------------------------

// Broadcast when the interest rates or volatility of an asset change
entrypoint typedef struct _AssetInterestRateChangeMessage {
  UINT32BE token;                   // bytes 0 to 3, signed, read here as unsigned
  UINT16BE foreign_interest_rate;   // bytes 4 to 5, signed, read here as unsigned
  UINT32BE volatility;              // bytes 6 to 9, signed, read here as unsigned
  UINT16BE domestic_interest_rate;  // bytes 10 to 11, signed, read here as unsigned
} AssetInterestRateChangeMessage;

// ---- Sec Info 1: 30 bytes ----------------------------------------------------

// SecInfo1
entrypoint typedef struct _SecInfo1 {
  UINT8 instrument_name[6];  // bytes 0 to 5
  UINT8 symbol[10];          // bytes 6 to 15
  UINT8 series[2];           // bytes 16 to 17
  UINT32BE expiry_date;      // bytes 18 to 21, signed, read here as unsigned
  UINT32BE strike_price;     // bytes 22 to 25, signed, read here as unsigned
  UINT8 option_type[2];      // bytes 26 to 27
  UINT16BE ca_level;         // bytes 28 to 29, signed, read here as unsigned
} SecInfo1;

// ---- Sec Info 2: 30 bytes ----------------------------------------------------

// SecInfo2
entrypoint typedef struct _SecInfo2 {
  UINT8 instrument_name[6];  // bytes 0 to 5
  UINT8 symbol[10];          // bytes 6 to 15
  UINT8 series[2];           // bytes 16 to 17
  UINT32BE expiry_date;      // bytes 18 to 21, signed, read here as unsigned
  UINT32BE strike_price;     // bytes 22 to 25, signed, read here as unsigned
  UINT8 option_type[2];      // bytes 26 to 27
  UINT16BE ca_level;         // bytes 28 to 29, signed, read here as unsigned
} SecInfo2;

