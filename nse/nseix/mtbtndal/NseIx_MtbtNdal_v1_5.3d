// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NseIx_MtbtNdal_v1_5.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_CONTRACT_INFORMATION_MESSAGE 0x63           // Contract Information Message
#define MESSAGE_TYPE_SPREAD_CONTRACT_INFORMATION_MESSAGE 0x64    // Spread Contract Information Message
#define MESSAGE_TYPE_NEW_ORDER_MESSAGE 0x4E                      // New Order Message
#define MESSAGE_TYPE_ORDER_MODIFICATION_MESSAGE 0x4D             // Order Modification Message
#define MESSAGE_TYPE_ORDER_CANCELLATION_MESSAGE 0x58             // Order Cancellation Message
#define MESSAGE_TYPE_TRADE_MESSAGE 0x54                          // Trade Message
#define MESSAGE_TYPE_NEW_SPREAD_ORDER_MESSAGE 0x47               // New Spread Order Message
#define MESSAGE_TYPE_SPREAD_ORDER_MODIFICATION_MESSAGE 0x48      // Spread Order Modification Message
#define MESSAGE_TYPE_SPREAD_ORDER_CANCELLATION_MESSAGE 0x4A      // Spread Order Cancellation Message
#define MESSAGE_TYPE_SPREAD_TRADE_MESSAGE 0x4B                   // Spread Trade Message
#define MESSAGE_TYPE_MARKET_STATUS_MESSAGE 0x53                  // Market Status Message
#define MESSAGE_TYPE_INDICATIVE_PRICE_AND_QUANTITY_MESSAGE 0x50  // Indicative Price And Quantity Message
#define MESSAGE_TYPE_MARKET_STATISTICS_INFORMATION_MESSAGE 0x66  // Market Statistics Information Message
#define MESSAGE_TYPE_OPEN_INTEREST_MESSAGE 0x6F                  // Open Interest Message
#define MESSAGE_TYPE_HEARTBEAT_MESSAGE 0x5A                      // Heartbeat Message

// Daily Contract Indicator: one byte code
#define DAILY_CONTRACT_INDICATOR_DAILY_CONTRACT 0x44  // Daily Contract
#define DAILY_CONTRACT_INDICATOR_NOT_APPLICABLE 0x4E  // Not Applicable

// Order Type: one byte code
#define ORDER_TYPE_BUY_ORDER 0x42   // Buy Order
#define ORDER_TYPE_SELL_ORDER 0x53  // Sell Order

// Status: 2 byte code
#define STATUS_PRE_OPEN 0x0000       // Pre Open
#define STATUS_OPEN 0x0001           // Open
#define STATUS_CLOSED 0x0002         // Closed
#define STATUS_PRE_OPEN_END 0x0003   // Pre Open End
#define STATUS_PRE_CLOSE 0x0004      // Pre Close
#define STATUS_PRE_CLOSE_END 0x0005  // Pre Close End

// Session Indicator: 2 byte code
#define SESSION_INDICATOR_T_SESSION 0x0001    // T Session
#define SESSION_INDICATOR_T_1_SESSION 0x0002  // T 1 Session

// Identifier: one byte code
#define IDENTIFIER_INDICATIVE_OPEN_PRICE 0x4F   // Indicative Open Price
#define IDENTIFIER_INDICATIVE_CLOSE_PRICE 0x43  // Indicative Close Price

// ---- Types -------------------------------------------------------------------

// Beginning of day contract master information, sent before the market opens on Stream Id no. 99, for contracts valid in the NSE IX market.
typedef struct _ContractInformationMessage {
  UINT64 timestamp;                // bytes 0 to 7, signed, read here as unsigned
  UINT16 contract_stream_id;       // bytes 8 to 9, signed, read here as unsigned
  UINT32 token_number;             // bytes 10 to 13, signed, read here as unsigned
  UINT8 instrument[6];             // bytes 14 to 19
  UINT8 symbol[10];                // bytes 20 to 29
  UINT32 expiry_date;              // bytes 30 to 33, signed, read here as unsigned
  UINT32 strike_price;             // bytes 34 to 37, signed, read here as unsigned
  UINT8 option_type[2];            // bytes 38 to 39
  UINT32 low_price_range;          // bytes 40 to 43, signed, read here as unsigned
  UINT32 high_price_range;         // bytes 44 to 47, signed, read here as unsigned
  UINT8 daily_contract_indicator;  // byte 48
} ContractInformationMessage;

// Information about the spread contracts valid in the NSE IX market, sent on Stream Id no. 99.
typedef struct _SpreadContractInformationMessage {
  UINT64 timestamp;                              // bytes 0 to 7, signed, read here as unsigned
  UINT16 contract_stream_id;                     // bytes 8 to 9, signed, read here as unsigned
  UINT32 token_1;                                // bytes 10 to 13, signed, read here as unsigned
  UINT32 token_2;                                // bytes 14 to 17, signed, read here as unsigned
  UINT32 day_low_price_diff_range;               // bytes 18 to 21, signed, read here as unsigned
  UINT32 day_high_price_diff_range;              // bytes 22 to 25, signed, read here as unsigned
  UINT32 operating_range_low_price_diff_range;   // bytes 26 to 29, signed, read here as unsigned
  UINT32 operating_range_high_price_diff_range;  // bytes 30 to 33, signed, read here as unsigned
} SpreadContractInformationMessage;

// For every new order request, this message is sent. All new order requests are sent, including the active orders.
typedef struct _NewOrderMessage {
  UINT64 timestamp;   // bytes 0 to 7, signed, read here as unsigned
  UINT8 order_id[8];  // bytes 8 to 15
  UINT32 token;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 order_type;   // byte 20
  UINT32 price;       // bytes 21 to 24, signed, read here as unsigned
  UINT32 quantity;    // bytes 25 to 28, signed, read here as unsigned
} NewOrderMessage;

// For every order modification request, this message is sent. Modifications must be handled on the basis of Order Id and not on Price; one whose original Order Id is not found should be treated as a New Order.
typedef struct _OrderModificationMessage {
  UINT64 timestamp;   // bytes 0 to 7, signed, read here as unsigned
  UINT8 order_id[8];  // bytes 8 to 15
  UINT32 token;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 order_type;   // byte 20
  UINT32 price;       // bytes 21 to 24, signed, read here as unsigned
  UINT32 quantity;    // bytes 25 to 28, signed, read here as unsigned
} OrderModificationMessage;

// For every order cancellation request, this message is sent. Cancellations must be handled on the basis of Order Id and not on Price; one whose original Order Id is not found should be ignored.
typedef struct _OrderCancellationMessage {
  UINT64 timestamp;   // bytes 0 to 7, signed, read here as unsigned
  UINT8 order_id[8];  // bytes 8 to 15
  UINT32 token;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 order_type;   // byte 20
  UINT32 price;       // bytes 21 to 24, signed, read here as unsigned
  UINT32 quantity;    // bytes 25 to 28, signed, read here as unsigned
} OrderCancellationMessage;

// Sent whenever an order in the order book gets executed fully or partially. Either Buy Order ID or Sell Order ID can be zero, in which case that Order ID should be ignored; both are never zero at the same time.
typedef struct _TradeMessage {
  UINT64 timestamp;        // bytes 0 to 7, signed, read here as unsigned
  UINT8 buy_order_id[8];   // bytes 8 to 15
  UINT8 sell_order_id[8];  // bytes 16 to 23
  UINT32 token;            // bytes 24 to 27, signed, read here as unsigned
  UINT32 trade_price;      // bytes 28 to 31, signed, read here as unsigned
  UINT32 trade_quantity;   // bytes 32 to 35, signed, read here as unsigned
} TradeMessage;

// For every new spread order request, this message is sent. All new spread order requests are sent, including the active orders.
typedef struct _NewSpreadOrderMessage {
  UINT64 timestamp;   // bytes 0 to 7, signed, read here as unsigned
  UINT8 order_id[8];  // bytes 8 to 15
  UINT32 token;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 order_type;   // byte 20
  UINT32 price;       // bytes 21 to 24, signed, read here as unsigned
  UINT32 quantity;    // bytes 25 to 28, signed, read here as unsigned
} NewSpreadOrderMessage;

// For every spread order modification request, this message is sent.
typedef struct _SpreadOrderModificationMessage {
  UINT64 timestamp;   // bytes 0 to 7, signed, read here as unsigned
  UINT8 order_id[8];  // bytes 8 to 15
  UINT32 token;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 order_type;   // byte 20
  UINT32 price;       // bytes 21 to 24, signed, read here as unsigned
  UINT32 quantity;    // bytes 25 to 28, signed, read here as unsigned
} SpreadOrderModificationMessage;

// For every spread order cancellation request, this message is sent.
typedef struct _SpreadOrderCancellationMessage {
  UINT64 timestamp;   // bytes 0 to 7, signed, read here as unsigned
  UINT8 order_id[8];  // bytes 8 to 15
  UINT32 token;       // bytes 16 to 19, signed, read here as unsigned
  UINT8 order_type;   // byte 20
  UINT32 price;       // bytes 21 to 24, signed, read here as unsigned
  UINT32 quantity;    // bytes 25 to 28, signed, read here as unsigned
} SpreadOrderCancellationMessage;

// Sent whenever a spread order in the order book gets executed fully or partially. Either Buy Order ID or Sell Order ID can be zero, in which case that Order ID should be ignored.
typedef struct _SpreadTradeMessage {
  UINT64 timestamp;        // bytes 0 to 7, signed, read here as unsigned
  UINT8 buy_order_id[8];   // bytes 8 to 15
  UINT8 sell_order_id[8];  // bytes 16 to 23
  UINT32 token;            // bytes 24 to 27, signed, read here as unsigned
  UINT32 trade_price;      // bytes 28 to 31, signed, read here as unsigned
  UINT32 quantity;         // bytes 32 to 35, signed, read here as unsigned
} SpreadTradeMessage;

// Sent whenever the status of the market is changed to pre-open, pre-open end, open, closed, pre-close or pre-close end, for both T and T+1 sessions.
typedef struct _MarketStatusMessage {
  UINT64 timestamp;          // bytes 0 to 7, signed, read here as unsigned
  UINT8 instrument[6];       // bytes 8 to 13
  UINT16 status;             // bytes 14 to 15, signed, read here as unsigned
  UINT16 session_indicator;  // bytes 16 to 17, signed, read here as unsigned
} MarketStatusMessage;

// Indicative equilibrium price and quantity, sent for contracts with pre-open and pre-close sessions, only between the pre-open or pre-close and the pre-open end or pre-close end statuses, when the indicative price and quantity are determined or updated during order collection.
typedef struct _IndicativePriceAndQuantityMessage {
  UINT64 timestamp;            // bytes 0 to 7, signed, read here as unsigned
  UINT32 token;                // bytes 8 to 11, signed, read here as unsigned
  UINT8 identifier;            // byte 12
  UINT32 indicative_price;     // bytes 13 to 16, signed, read here as unsigned
  UINT32 indicative_quantity;  // bytes 17 to 20, signed, read here as unsigned
} IndicativePriceAndQuantityMessage;

// End of session market statistics (Bhavcopy), sent on Stream Id no. 99.
typedef struct _MarketStatisticsInformationMessage {
  UINT64 timestamp;                 // bytes 0 to 7, signed, read here as unsigned
  UINT32 token;                     // bytes 8 to 11, signed, read here as unsigned
  UINT8 opening_price[8];           // bytes 12 to 19
  UINT8 trade_high_price[8];        // bytes 20 to 27
  UINT8 trade_low_price[8];         // bytes 28 to 35
  UINT8 closing_price[8];           // bytes 36 to 43
  UINT8 last_traded_price[8];       // bytes 44 to 51
  UINT8 previous_close_price[8];    // bytes 52 to 59
  UINT8 settlement_price[8];        // bytes 60 to 67
  UINT32 total_traded_quantity;     // bytes 68 to 71, signed, read here as unsigned
  UINT8 total_traded_value[8];      // bytes 72 to 79
  UINT32 statistics_open_interest;  // bytes 80 to 83, signed, read here as unsigned
  UINT32 change_in_open_interest;   // bytes 84 to 87, signed, read here as unsigned
  UINT16 session_indicator;         // bytes 88 to 89, signed, read here as unsigned
} MarketStatisticsInformationMessage;

// Open interest of the contracts traded, sent during trading hours on Stream Id no. 99.
typedef struct _OpenInterestMessage {
  UINT64 timestamp;      // bytes 0 to 7, signed, read here as unsigned
  UINT32 token;          // bytes 8 to 11, signed, read here as unsigned
  UINT32 open_interest;  // bytes 12 to 15, signed, read here as unsigned
} OpenInterestMessage;

// Sent when there is no data available for a few seconds. The sequence number field in the Stream Header will have the value 0 (zero) for this message.
typedef struct _HeartbeatMessage {
  UINT32 last_sequence_no;  // bytes 0 to 3, signed, read here as unsigned
} HeartbeatMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x63: ContractInformationMessage contract_information_message;
    case 0x64: SpreadContractInformationMessage spread_contract_information_message;
    case 0x4E: NewOrderMessage new_order_message;
    case 0x4D: OrderModificationMessage order_modification_message;
    case 0x58: OrderCancellationMessage order_cancellation_message;
    case 0x54: TradeMessage trade_message;
    case 0x47: NewSpreadOrderMessage new_spread_order_message;
    case 0x48: SpreadOrderModificationMessage spread_order_modification_message;
    case 0x4A: SpreadOrderCancellationMessage spread_order_cancellation_message;
    case 0x4B: SpreadTradeMessage spread_trade_message;
    case 0x53: MarketStatusMessage market_status_message;
    case 0x50: IndicativePriceAndQuantityMessage indicative_price_and_quantity_message;
    case 0x66: MarketStatisticsInformationMessage market_statistics_information_message;
    case 0x6F: OpenInterestMessage open_interest_message;
    case 0x5A: HeartbeatMessage heartbeat_message;
    default: UINT8 unknown[available];
  }
} Payload;

// STREAM_DATA. First field is always Message Type and must be read/interpreted first.
typedef struct _Message (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                               // byte 0
  Payload(message_type, (available - 1)) payload[:byte-size-single-element-array (available - 1)];
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// Mtbt Udp Packet. One STREAM_DATA message per packet.
entrypoint typedef struct _Packet {
  UINT16 message_length { message_length >= 8 };                                                                      // bytes 0 to 1, signed, read here as unsigned
  UINT16 stream_id;                                                                                                   // bytes 2 to 3, signed, read here as unsigned
  UINT32 sequence_number;                                                                                             // bytes 4 to 7
  Message((((UINT32) message_length) - 8)) message[:byte-size-single-element-array (((UINT32) message_length) - 8)];
} Packet;

