// Spread Order Body
typedef struct _SpreadOrderBody {
  UINT8 participant_type_1;                      // byte 0
  UINT8 filler_1;                                // byte 1
  UINT16BE competitor_period_1;                  // bytes 2 to 3, signed, read here as unsigned
  UINT16BE solicitor_period_1;                   // bytes 4 to 5, signed, read here as unsigned
  UINT8 mod_cxl_by_1;                            // byte 6
  UINT8 filler_9;                                // byte 7
  UINT16BE reason_code_1;                        // bytes 8 to 9, signed, read here as unsigned
  UINT8 start_alpha_1[2];                        // bytes 10 to 11
  UINT8 end_alpha_1[2];                          // bytes 12 to 13
  UINT32BE token_1;                              // bytes 14 to 17, signed, read here as unsigned
  ContractDesc contract_desc;                    // bytes 18 to 45
  UINT8 op_broker_id_1[5];                       // bytes 46 to 50
  UINT8 fillerx_1;                               // byte 51
  UINT8 filler_options_1[3];                     // bytes 52 to 54
  UINT8 fillery_1;                               // byte 55
  UINT16BE order_type_1;                         // bytes 56 to 57, signed, read here as unsigned
  UINT8 order_number_1[8];                       // bytes 58 to 65
  UINT8 account_number_1[10];                    // bytes 66 to 75
  UINT16BE book_type_1;                          // bytes 76 to 77, signed, read here as unsigned
  UINT16BE buy_sell_1;                           // bytes 78 to 79, signed, read here as unsigned
  UINT32BE disclosed_vol_1;                      // bytes 80 to 83, signed, read here as unsigned
  UINT32BE disclosed_vol_remaining_1;            // bytes 84 to 87, signed, read here as unsigned
  UINT32BE total_vol_remaining_1;                // bytes 88 to 91, signed, read here as unsigned
  UINT32BE volume_1;                             // bytes 92 to 95, signed, read here as unsigned
  UINT32BE volume_filled_today_1;                // bytes 96 to 99, signed, read here as unsigned
  UINT32BE price_1;                              // bytes 100 to 103, signed, read here as unsigned
  UINT32BE trigger_price_1;                      // bytes 104 to 107, signed, read here as unsigned
  UINT32BE good_till_date_1;                     // bytes 108 to 111, signed, read here as unsigned
  UINT32BE entry_date_time_1;                    // bytes 112 to 115, signed, read here as unsigned
  UINT32BE min_fill_aon_1;                       // bytes 116 to 119, signed, read here as unsigned
  UINT32BE last_modified_1;                      // bytes 120 to 123, signed, read here as unsigned
  UINT16BE ato : 1;                              // bytes 124 to 125
  UINT16BE market : 1;                           // bytes 124 to 125
  UINT16BE sl : 1;                               // bytes 124 to 125
  UINT16BE mit : 1;                              // bytes 124 to 125
  UINT16BE day : 1;                              // bytes 124 to 125
  UINT16BE gtc : 1;                              // bytes 124 to 125
  UINT16BE ioc : 1;                              // bytes 124 to 125
  UINT16BE aon : 1;                              // bytes 124 to 125
  UINT16BE mf : 1;                               // bytes 124 to 125
  UINT16BE matched_ind : 1;                      // bytes 124 to 125
  UINT16BE traded : 1;                           // bytes 124 to 125
  UINT16BE modified : 1;                         // bytes 124 to 125
  UINT16BE frozen : 1;                           // bytes 124 to 125
  UINT16BE order_pre_open : 1;                   // bytes 124 to 125
  UINT16BE reserved_12 : 2;                      // bytes 124 to 125
  UINT16BE branch_id_1;                          // bytes 126 to 127, signed, read here as unsigned
  UINT32BE trader_id_1;                          // bytes 128 to 131, signed, read here as unsigned
  UINT8 broker_id_1[5];                          // bytes 132 to 136
  UINT8 c_ord_filler[24];                        // bytes 137 to 160
  UINT8 open_close_1;                            // byte 161
  UINT8 settlor_1[12];                           // bytes 162 to 173
  UINT16BE pro_client_1;                         // bytes 174 to 175, signed, read here as unsigned
  UINT16BE settlement_period_1;                  // bytes 176 to 177, signed, read here as unsigned
  UINT8 boc : 1;                                 // byte 178
  UINT8 col : 1;                                 // byte 178
  UINT8 reserved_34 : 2;                         // byte 178
  UINT8 stpc : 1;                                // byte 178
  UINT8 reserved_68 : 3;                         // byte 178
  UINT8 reserved_1;                              // byte 179
  UINT8 filler_116[2];                           // bytes 180 to 181
  UINT8 filler_17;                               // byte 182
  UINT8 filler_18;                               // byte 183
  UINT8 nnf_field[8];                            // bytes 184 to 191
  UINT64BE mkt_replay;                           // bytes 192 to 199, signed, read here as unsigned
  UINT8 pan[10];                                 // bytes 200 to 209
  UINT32BE algo_id;                              // bytes 210 to 213, signed, read here as unsigned
  UINT8 reserved_2[2];                           // bytes 214 to 215
  UINT64BE last_activity_reference;              // bytes 216 to 223, signed, read here as unsigned
  UINT8 reserved_52[52];                         // bytes 224 to 275
