// Book Type 1: 2 byte code
#define BOOK_TYPE_1_REGULAR_LOT_ORDER 0x0001    // Regular Lot Order
#define BOOK_TYPE_1_SPECIAL_TERMS_ORDER 0x0002  // Special Terms Order

// ---- Types -------------------------------------------------------------------

// Confirms that the trader has been signed on
typedef struct _SignOnRequestOutMessage {
  UINT32BE user_id;                    // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_8[8];                 // bytes 4 to 11
  UINT8 password[8];                   // bytes 12 to 19
  UINT8 second_reserved_8[8];          // bytes 20 to 27
  UINT8 new_password[8];               // bytes 28 to 35
  UINT8 trader_name[26];               // bytes 36 to 61
  UINT32BE last_password_change_date;  // bytes 62 to 65, signed, read here as unsigned
  UINT8 broker_id[5];                  // bytes 66 to 70
  UINT8 reserved_1;                    // byte 71
  UINT16BE branch_id;                  // bytes 72 to 73, signed, read here as unsigned
  UINT32BE version_number;             // bytes 74 to 77, signed, read here as unsigned
  UINT32BE end_time;                   // bytes 78 to 81, signed, read here as unsigned
  UINT8 second_reserved_1;             // byte 82
  UINT8 colour[50];                    // bytes 83 to 132
  UINT8 third_reserved_1;              // byte 133
  UINT16BE user_type;                  // bytes 134 to 135, signed, read here as unsigned
  UINT8 sequence_number[8];            // bytes 136 to 143
  UINT8 reserved_14[14];               // bytes 144 to 157
  UINT8 broker_status;                 // byte 158
  UINT8 show_index;                    // byte 159
  UINT16BE normal_market : 1;          // bytes 160 to 161
  UINT16BE oddlot_market : 1;          // bytes 160 to 161
  UINT16BE spot_market : 1;            // bytes 160 to 161
  UINT16BE auction_market : 1;         // bytes 160 to 161
  UINT16BE reserved_212 : 11;          // bytes 160 to 161
  UINT16BE pre_open : 1;               // bytes 160 to 161
  UINT16BE member_type;                // bytes 162 to 163, signed, read here as unsigned
  UINT8 clearing_status;               // byte 164
  UINT8 broker_name[25];               // bytes 165 to 189
  UINT8 reserved_16[16];               // bytes 190 to 205
  UINT8 second_reserved_16[16];        // bytes 206 to 221
  UINT8 third_reserved_16[16];         // bytes 222 to 237
} SignOnRequestOutMessage;

// Breaks the virtual circuit between the host and the front end
typedef struct _SignOffRequestOutMessage {
  UINT32BE user_id;         // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_145[145];  // bytes 4 to 148
} SignOffRequestOutMessage;

// ST_MARKET_STATUS
typedef struct _StMarketStatus {
  UINT16BE market_status_normal;   // bytes 0 to 1, signed, read here as unsigned
  UINT16BE market_status_oddlot;   // bytes 2 to 3, signed, read here as unsigned
  UINT16BE market_status_spot;     // bytes 4 to 5, signed, read here as unsigned
  UINT16BE market_status_auction;  // bytes 6 to 7, signed, read here as unsigned
} StMarketStatus;

// ST_EX_MARKET_STATUS
typedef struct _StExMarketStatus {
  UINT16BE ex_market_status_normal;   // bytes 0 to 1, signed, read here as unsigned
  UINT16BE ex_market_status_oddlot;   // bytes 2 to 3, signed, read here as unsigned
  UINT16BE ex_market_status_spot;     // bytes 4 to 5, signed, read here as unsigned
  UINT16BE ex_market_status_auction;  // bytes 6 to 7, signed, read here as unsigned
} StExMarketStatus;

// ST_PL_MARKET_STATUS
typedef struct _StPlMarketStatus {
  UINT16BE pl_market_status_normal;   // bytes 0 to 1, signed, read here as unsigned
  UINT16BE pl_market_status_oddlot;   // bytes 2 to 3, signed, read here as unsigned
  UINT16BE pl_market_status_spot;     // bytes 4 to 5, signed, read here as unsigned
  UINT16BE pl_market_status_auction;  // bytes 6 to 7, signed, read here as unsigned
} StPlMarketStatus;

// Carries the system information of the trading system
typedef struct _SystemInformationOutMessage {
  StMarketStatus st_market_status;              // bytes 0 to 7
  StExMarketStatus st_ex_market_status;         // bytes 8 to 15
  StPlMarketStatus st_pl_market_status;         // bytes 16 to 23
  UINT8 update_portfolio;                       // byte 24
  UINT8 reserved_1;                             // byte 25
  UINT32BE market_index;                        // bytes 26 to 29, signed, read here as unsigned
  UINT16BE default_settlement_period_normal;    // bytes 30 to 31, signed, read here as unsigned
  UINT16BE default_settlement_period_spot;      // bytes 32 to 33, signed, read here as unsigned
  UINT16BE default_settlement_period_auction;   // bytes 34 to 35, signed, read here as unsigned
  UINT16BE competitor_period;                   // bytes 36 to 37, signed, read here as unsigned
  UINT16BE solicitor_period;                    // bytes 38 to 39, signed, read here as unsigned
  UINT16BE warning_percent;                     // bytes 40 to 41, signed, read here as unsigned
  UINT16BE volume_freeze_percent;               // bytes 42 to 43, signed, read here as unsigned
  UINT16BE snap_quote_time;                     // bytes 44 to 45, signed, read here as unsigned
  UINT8 reserved_2[2];                          // bytes 46 to 47
  UINT32BE board_lot_quantity;                  // bytes 48 to 51, signed, read here as unsigned
  UINT32BE tick_size;                           // bytes 52 to 55, signed, read here as unsigned
  UINT16BE maximum_gtc_days;                    // bytes 56 to 57, signed, read here as unsigned
  UINT16BE eligible_aon : 1;                    // bytes 58 to 59
  UINT16BE minimum_fill : 1;                    // bytes 58 to 59
  UINT16BE books_merged : 1;                    // bytes 58 to 59
  UINT16BE reserved_113 : 13;                   // bytes 58 to 59
  UINT16BE disclosed_quantity_percent_allowed;  // bytes 60 to 61, signed, read here as unsigned
  UINT32BE risk_free_interest_rate;             // bytes 62 to 65, signed, read here as unsigned
} SystemInformationOutMessage;

// Initialisation vector used by the existing encryption
typedef struct _ExistingEncryptionTail {
  UINT8 cryptographic_iv[16];  // bytes 0 to 15
} ExistingEncryptionTail;

// Initialisation vectors used by the new authenticated encryption
typedef struct _NewEncryptionTail {
  UINT8 static_cryptographic_iv[8];        // bytes 0 to 7
  UINT64BE dynamic_cryptographic_iv;       // bytes 8 to 15, signed, read here as unsigned
  UINT8 cryptographic_additional_key[12];  // bytes 16 to 27
} NewEncryptionTail;

// Branch
casetype _CryptographicPayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x007C: ExistingEncryptionTail existing_encryption_tail;
    case 0x0088: NewEncryptionTail new_encryption_tail;
    default: UINT8 unknown[available];
  }
} CryptographicPayload;

// Initialisation vectors, layout selected by Message Length
typedef struct _CryptographicTail (UINT16 message_length, UINT32 available) {
  CryptographicPayload(message_length, available) cryptographic_payload[:byte-size-single-element-array available];
} CryptographicTail;

// Returns the allocated gateway server and the keys used to encrypt the session
typedef struct _GatewayRouterResponseMessage (UINT16 message_length, UINT32 available) where (available >= 68) {
  UINT16BE box_id;                                                         // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];                                                      // bytes 2 to 6
  UINT8 filler;                                                            // byte 7
  UINT8 ip_address[16];                                                    // bytes 8 to 23
  UINT32BE port;                                                           // bytes 24 to 27, signed, read here as unsigned
  UINT8 session_key[8];                                                    // bytes 28 to 35
  UINT8 cryptographic_key[32];                                             // bytes 36 to 67
  CryptographicTail(message_length, (available - 68)) cryptographic_tail;
} GatewayRouterResponseMessage;

// Opens the local database download
typedef struct _UpdateLocalDatabaseHeaderMessage {
  UINT8 reserved_2[2];  // bytes 0 to 1
} UpdateLocalDatabaseHeaderMessage;

// Closes the local database download
typedef struct _UpdateLocalDatabaseTrailerMessage {
  UINT8 reserved_2[2];  // bytes 0 to 1
} UpdateLocalDatabaseTrailerMessage;

// INNER_MESSAGE_HEADER
typedef struct _InnerHeader {
  UINT32BE inner_trader_id;         // bytes 0 to 3, signed, read here as unsigned
  UINT32BE inner_log_time;          // bytes 4 to 7, signed, read here as unsigned
  UINT8 inner_alpha_char[2];        // bytes 8 to 9
  UINT16BE inner_transaction_code;  // bytes 10 to 11, signed, read here as unsigned
  UINT16BE inner_error_code;        // bytes 12 to 13, signed, read here as unsigned
  UINT64BE inner_timestamp;         // bytes 14 to 21, signed, read here as unsigned
  UINT8 inner_time_stamp_1[8];      // bytes 22 to 29
  UINT8 inner_time_stamp_2[8];      // bytes 30 to 37
  UINT16BE inner_message_length;    // bytes 38 to 39, signed, read here as unsigned
} InnerHeader;

// Record body selected by Inner Transaction Code
typedef struct _LocalDatabaseData (UINT32 available) {
  UINT8 data_payload[available];
} LocalDatabaseData;

// Carries one local database record wrapped in an inner header
typedef struct _UpdateLocalDatabaseDataMessage (UINT16 message_length) where (message_length >= 80) {
  InnerHeader inner_header;                                                                                                                   // bytes 0 to 39
  LocalDatabaseData((((UINT32) message_length) - 80)) local_database_data[:byte-size-single-element-array (((UINT32) message_length) - 80)];
} UpdateLocalDatabaseDataMessage;

// MESSAGE_HEADER of the downloaded message
typedef struct _DownloadHeader {
  UINT16BE inner_transaction_code;  // bytes 0 to 1, signed, read here as unsigned
  UINT32BE inner_log_time;          // bytes 2 to 5, signed, read here as unsigned
  UINT8 inner_alpha_char[2];        // bytes 6 to 7
  UINT32BE inner_trader_id;         // bytes 8 to 11, signed, read here as unsigned
  UINT16BE inner_error_code;        // bytes 12 to 13, signed, read here as unsigned
  UINT64BE inner_timestamp;         // bytes 14 to 21, signed, read here as unsigned
  UINT8 inner_time_stamp_1[8];      // bytes 22 to 29
  UINT8 inner_time_stamp_2[8];      // bytes 30 to 37
  UINT16BE inner_message_length;    // bytes 38 to 39, signed, read here as unsigned
} DownloadHeader;

// Downloaded record body selected by Inner Transaction Code
typedef struct _MessageDownloadData (UINT32 available) {
  UINT8 download_payload[available];
} MessageDownloadData;

// Carries one downloaded message wrapped in a second message header
typedef struct _MessageRecordMessage (UINT16 message_length) where (message_length >= 80) {
  DownloadHeader download_header;                                                                                                                 // bytes 0 to 39
  MessageDownloadData((((UINT32) message_length) - 80)) message_download_data[:byte-size-single-element-array (((UINT32) message_length) - 80)];
} MessageRecordMessage;

// CONTRACT_DESC
typedef struct _ContractDesc {
  UINT8 instrument_name[6];  // bytes 0 to 5
  UINT8 symbol[10];          // bytes 6 to 15
  UINT32BE expiry_date;      // bytes 16 to 19, signed, read here as unsigned
  UINT32BE strike_price;     // bytes 20 to 23, signed, read here as unsigned
  UINT8 option_type[2];      // bytes 24 to 25
  UINT16BE ca_level;         // bytes 26 to 27, signed, read here as unsigned
} ContractDesc;

// Order Entry Body
typedef struct _OrderEntryBody {
  UINT8 participant_type;               // byte 0
  UINT8 reserved_1;                     // byte 1
  UINT16BE competitor_period;           // bytes 2 to 3, signed, read here as unsigned
  UINT16BE solicitor_period;            // bytes 4 to 5, signed, read here as unsigned
  UINT8 modified_cancelled_by;          // byte 6
  UINT8 second_reserved_1;              // byte 7
  UINT16BE reason_code;                 // bytes 8 to 9, signed, read here as unsigned
  UINT8 reserved_4[4];                  // bytes 10 to 13
  UINT32BE token_no;                    // bytes 14 to 17, signed, read here as unsigned
  ContractDesc contract_desc;           // bytes 18 to 45
  UINT8 counter_party_broker_id[5];     // bytes 46 to 50
  UINT8 third_reserved_1;               // byte 51
  UINT8 reserved_2[2];                  // bytes 52 to 53
  UINT8 closeout_flag;                  // byte 54
  UINT8 fourth_reserved_1;              // byte 55
  UINT16BE order_type;                  // bytes 56 to 57, signed, read here as unsigned
  UINT8 order_number[8];                // bytes 58 to 65
  UINT8 account_number[10];             // bytes 66 to 75
  UINT16BE book_type;                   // bytes 76 to 77, signed, read here as unsigned
  UINT16BE buy_sell_indicator;          // bytes 78 to 79, signed, read here as unsigned
  UINT32BE disclosed_volume;            // bytes 80 to 83, signed, read here as unsigned
  UINT32BE disclosed_volume_remaining;  // bytes 84 to 87, signed, read here as unsigned
  UINT32BE total_volume_remaining;      // bytes 88 to 91, signed, read here as unsigned
  UINT32BE volume;                      // bytes 92 to 95, signed, read here as unsigned
  UINT32BE volume_filled_today;         // bytes 96 to 99, signed, read here as unsigned
  UINT32BE price;                       // bytes 100 to 103, signed, read here as unsigned
  UINT32BE trigger_price;               // bytes 104 to 107, signed, read here as unsigned
  UINT32BE good_till_date;              // bytes 108 to 111, signed, read here as unsigned
  UINT32BE entry_date_time;             // bytes 112 to 115, signed, read here as unsigned
  UINT32BE minimum_fill_aon_volume;     // bytes 116 to 119, signed, read here as unsigned
  UINT32BE last_modified;               // bytes 120 to 123, signed, read here as unsigned
  UINT16BE ato : 1;                     // bytes 124 to 125
  UINT16BE market : 1;                  // bytes 124 to 125
  UINT16BE sl : 1;                      // bytes 124 to 125
  UINT16BE mit : 1;                     // bytes 124 to 125
  UINT16BE day : 1;                     // bytes 124 to 125
  UINT16BE gtc : 1;                     // bytes 124 to 125
  UINT16BE ioc : 1;                     // bytes 124 to 125
  UINT16BE aon : 1;                     // bytes 124 to 125
  UINT16BE mf : 1;                      // bytes 124 to 125
  UINT16BE matched_ind : 1;             // bytes 124 to 125
  UINT16BE traded : 1;                  // bytes 124 to 125
  UINT16BE modified : 1;                // bytes 124 to 125
  UINT16BE frozen : 1;                  // bytes 124 to 125
  UINT16BE order_pre_open : 1;          // bytes 124 to 125
  UINT16BE reserved_12 : 2;             // bytes 124 to 125
  UINT16BE branch_id;                   // bytes 126 to 127, signed, read here as unsigned
  UINT32BE trader_id;                   // bytes 128 to 131, signed, read here as unsigned
  UINT8 broker_id[5];                   // bytes 132 to 136
  UINT8 c_ord_filler[24];               // bytes 137 to 160
  UINT8 open_close;                     // byte 161
  UINT8 settlor[12];                    // bytes 162 to 173
  UINT16BE pro_client_indicator;        // bytes 174 to 175, signed, read here as unsigned
  UINT16BE settlement_period;           // bytes 176 to 177, signed, read here as unsigned
  UINT8 boc : 1;                        // byte 178
  UINT8 col : 1;                        // byte 178
  UINT8 reserved_34 : 2;                // byte 178
  UINT8 stpc : 1;                       // byte 178
  UINT8 reserved_68 : 3;                // byte 178
  UINT8 fifth_reserved_1;               // byte 179
  UINT8 filler_116[2];                  // bytes 180 to 181
  UINT8 filler_17;                      // byte 182
  UINT8 filler_18;                      // byte 183
  UINT8 nnf_field[8];                   // bytes 184 to 191
  UINT64BE mkt_replay;                  // bytes 192 to 199, signed, read here as unsigned
  UINT8 pan[10];                        // bytes 200 to 209
  UINT32BE algo_id;                     // bytes 210 to 213, signed, read here as unsigned
  UINT8 second_reserved_2[2];           // bytes 214 to 215
  UINT64BE last_activity_reference;     // bytes 216 to 223, signed, read here as unsigned
  UINT8 reserved_52[52];                // bytes 224 to 275
} OrderEntryBody;

// Order entry confirmation, carried in the shared order entry structure
typedef struct _OrderConfirmationMessage {
  OrderEntryBody order_entry_body;  // bytes 0 to 275
} OrderConfirmationMessage;

// Order modification confirmation, carried in the shared order entry structure
typedef struct _OrderModificationConfirmationMessage {
  OrderEntryBody order_entry_body;  // bytes 0 to 275
} OrderModificationConfirmationMessage;

// Price confirmation, modification and cancellation rejections, freeze, order error and batch cancellation, all carried in the shared order entry structure. Transaction Code in the header names the response
typedef struct _OrderResponseMessage {
  OrderEntryBody order_entry_body;  // bytes 0 to 275
} OrderResponseMessage;

// Trade confirmation, stop loss trigger notification, and trade cancellation and modification confirmations and rejections. Transaction Code in the header names the operation
typedef struct _TradeConfirmationMessage {
  UINT8 response_order_number[8];        // bytes 0 to 7
  UINT8 broker_id[5];                    // bytes 8 to 12
  UINT8 reserved_1;                      // byte 13
  UINT32BE trader_number;                // bytes 14 to 17, signed, read here as unsigned
  UINT8 account_number[10];              // bytes 18 to 27
  UINT16BE buy_sell_indicator;           // bytes 28 to 29, signed, read here as unsigned
  UINT32BE original_volume;              // bytes 30 to 33, signed, read here as unsigned
  UINT32BE disclosed_volume;             // bytes 34 to 37, signed, read here as unsigned
  UINT32BE remaining_volume;             // bytes 38 to 41, signed, read here as unsigned
  UINT32BE disclosed_volume_remaining;   // bytes 42 to 45, signed, read here as unsigned
  UINT32BE price;                        // bytes 46 to 49, signed, read here as unsigned
  UINT16BE ato : 1;                      // bytes 50 to 51
  UINT16BE market : 1;                   // bytes 50 to 51
  UINT16BE sl : 1;                       // bytes 50 to 51
  UINT16BE mit : 1;                      // bytes 50 to 51
  UINT16BE day : 1;                      // bytes 50 to 51
  UINT16BE gtc : 1;                      // bytes 50 to 51
  UINT16BE ioc : 1;                      // bytes 50 to 51
  UINT16BE aon : 1;                      // bytes 50 to 51
  UINT16BE mf : 1;                       // bytes 50 to 51
  UINT16BE matched_ind : 1;              // bytes 50 to 51
  UINT16BE traded : 1;                   // bytes 50 to 51
  UINT16BE modified : 1;                 // bytes 50 to 51
  UINT16BE frozen : 1;                   // bytes 50 to 51
  UINT16BE order_pre_open : 1;           // bytes 50 to 51
  UINT16BE reserved_12 : 2;              // bytes 50 to 51
  UINT32BE good_till_date;               // bytes 52 to 55, signed, read here as unsigned
  UINT32BE fill_number;                  // bytes 56 to 59, signed, read here as unsigned
  UINT32BE fill_quantity;                // bytes 60 to 63, signed, read here as unsigned
  UINT32BE fill_price;                   // bytes 64 to 67, signed, read here as unsigned
  UINT32BE volume_filled_today;          // bytes 68 to 71, signed, read here as unsigned
  UINT8 activity_type[2];                // bytes 72 to 73
  UINT32BE activity_time;                // bytes 74 to 77, signed, read here as unsigned
  UINT8 counter_trader_order_number[8];  // bytes 78 to 85
  UINT8 counter_broker_id[5];            // bytes 86 to 90
  UINT8 second_reserved_1;               // byte 91
  UINT32BE token;                        // bytes 92 to 95, signed, read here as unsigned
  ContractDesc contract_desc;            // bytes 96 to 123
  UINT8 open_close;                      // byte 124
  UINT8 old_open_close;                  // byte 125
  UINT8 trade_book_type;                 // byte 126
  UINT8 third_reserved_1;                // byte 127
  UINT8 reserved_4[4];                   // bytes 128 to 131
  UINT8 old_account_number[10];          // bytes 132 to 141
  UINT8 participant[12];                 // bytes 142 to 153
  UINT8 old_participant[12];             // bytes 154 to 165
  UINT8 boc : 1;                         // byte 166
  UINT8 col : 1;                         // byte 166
  UINT8 reserved_34 : 2;                 // byte 166
  UINT8 stpc : 1;                        // byte 166
  UINT8 reserved_68 : 3;                 // byte 166
  UINT8 fourth_reserved_1;               // byte 167
  UINT8 fifth_reserved_1;                // byte 168
  UINT8 sixth_reserved_1;                // byte 169
  UINT8 pan[10];                         // bytes 170 to 179
  UINT8 old_pan[10];                     // bytes 180 to 189
  UINT32BE algo_id;                      // bytes 190 to 193, signed, read here as unsigned
  UINT8 reserved_2[2];                   // bytes 194 to 195
  UINT64BE last_activity_reference;      // bytes 196 to 203, signed, read here as unsigned
  UINT8 reserved_52[52];                 // bytes 204 to 255
} TradeConfirmationMessage;

// INSTRUMENT_USER
typedef struct _InstrumentUser {
  UINT8 branch_buy_value_limit[8];            // bytes 0 to 7
  UINT8 branch_sell_value_limit[8];           // bytes 8 to 15
  UINT8 branch_used_buy_value_limit[8];       // bytes 16 to 23
  UINT8 branch_used_sell_value_limit[8];      // bytes 24 to 31
  UINT8 user_order_buy_value_limit[8];        // bytes 32 to 39
  UINT8 user_order_sell_value_limit[8];       // bytes 40 to 47
  UINT8 user_order_used_buy_value_limit[8];   // bytes 48 to 55
  UINT8 user_order_used_sell_value_limit[8];  // bytes 56 to 63
} InstrumentUser;

// Carries the branch and user order value limits
typedef struct _UserOrderLimitUpdateMessage {
  UINT8 broker_id[5];          // bytes 0 to 4
  UINT16BE branch_id;          // bytes 5 to 6, signed, read here as unsigned
  UINT8 user_name[25];         // bytes 7 to 31
  UINT32BE user_id;            // bytes 32 to 35, signed, read here as unsigned
  UINT16BE user_type;          // bytes 36 to 37, signed, read here as unsigned
  UINT8 instrument_user[128];  // bytes 38 to 165
} UserOrderLimitUpdateMessage;

// Carries the dealer order quantity and value limits
typedef struct _DealerLimitUpdateMessage {
  UINT8 broker_id[5];     // bytes 0 to 4
  UINT32BE user_id;       // bytes 5 to 8, signed, read here as unsigned
  UINT8 ord_qty_buff[8];  // bytes 9 to 16
  UINT8 ord_val_buff[8];  // bytes 17 to 24
} DealerLimitUpdateMessage;

// Carries the spread order quantity and value limits
typedef struct _SpreadOrderLimitUpdateMessage {
  UINT8 broker_id[5];         // bytes 0 to 4
  UINT32BE user_id;           // bytes 5 to 8, signed, read here as unsigned
  UINT8 spd_ord_qty_buff[8];  // bytes 9 to 16
  UINT8 spd_ord_val_buff[8];  // bytes 17 to 24
} SpreadOrderLimitUpdateMessage;

// Interactive message sent to the trader from Nse Control
typedef struct _ControlMessageToTraderMessage {
  UINT32BE trader_id;                  // bytes 0 to 3, signed, read here as unsigned
  UINT8 action_code[3];                // bytes 4 to 6
  UINT8 reserved_1;                    // byte 7
  UINT16BE broad_cast_message_length;  // bytes 8 to 9, signed, read here as unsigned
  UINT8 broad_cast_message[239];       // bytes 10 to 248
} ControlMessageToTraderMessage;

// Report Header Body
typedef struct _ReportHeaderBody {
  UINT8 org_scope;         // byte 0
  UINT32BE report_date;    // bytes 1 to 4, signed, read here as unsigned
  UINT16BE user_type;      // bytes 5 to 6, signed, read here as unsigned
  UINT8 broker_id[5];      // bytes 7 to 11
  UINT8 firm_name[25];     // bytes 12 to 36
  UINT32BE trader_number;  // bytes 37 to 40, signed, read here as unsigned
  UINT8 trader_name[26];   // bytes 41 to 66
} ReportHeaderBody;

// MKT_STATS_DATA
typedef struct _MktStatsData {
  ContractDesc contract_desc;           // bytes 0 to 27
  UINT16BE market_type;                 // bytes 28 to 29, signed, read here as unsigned
  UINT32BE open_price;                  // bytes 30 to 33, signed, read here as unsigned
  UINT32BE high_price;                  // bytes 34 to 37, signed, read here as unsigned
  UINT32BE low_price;                   // bytes 38 to 41, signed, read here as unsigned
  UINT32BE closing_price;               // bytes 42 to 45, signed, read here as unsigned
  UINT64BE total_quantity_traded_long;  // bytes 46 to 53, signed, read here as unsigned
  UINT8 total_value_traded[8];          // bytes 54 to 61
  UINT32BE previous_close_price;        // bytes 62 to 65, signed, read here as unsigned
  UINT64BE open_interest_long;          // bytes 66 to 73, signed, read here as unsigned
  UINT64BE chg_open_interest;           // bytes 74 to 81, signed, read here as unsigned
  UINT8 indicator[4];                   // bytes 82 to 85
} MktStatsData;

// Report Statistics Body
typedef struct _ReportStatisticsBody {
  UINT8 reserved_1;                             // byte 0
  UINT16BE number_of_records;                   // bytes 1 to 2, signed, read here as unsigned
  MktStatsData mkt_stats_data[:byte-size 344];  // bytes 3 to 346
} ReportStatisticsBody;

// Report Trailer Body
typedef struct _ReportTrailerBody {
  UINT32BE number_of_packets;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_1;            // byte 4
} ReportTrailerBody;

// Branch
casetype _ReportBody (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x48: ReportHeaderBody report_header_body;
    case 0x58: ReportHeaderBody report_header_body_2;
    case 0x4C: ReportHeaderBody report_header_body_3;
    case 0x52: ReportStatisticsBody report_statistics_body;
    case 0x59: ReportStatisticsBody report_statistics_body_2;
    case 0x4D: ReportStatisticsBody report_statistics_body_3;
    case 0x54: ReportTrailerBody report_trailer_body;
    case 0x5A: ReportTrailerBody report_trailer_body_2;
    case 0x4E: ReportTrailerBody report_trailer_body_3;
    default: UINT8 unknown[available];
  }
} ReportBody;

// Bhavcopy header, market statistics records or trailer. Message Type selects which
typedef struct _MarketStatisticsReportMessage (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                                      // byte 0
  ReportBody(message_type, (available - 1)) report_body[:byte-size-single-element-array (available - 1)];
} MarketStatisticsReportMessage;

// ENHNCD_MKT_STATS_DATA
typedef struct _EnhncdMktStatsData {
  ContractDesc contract_desc;            // bytes 0 to 27
  UINT16BE market_type;                  // bytes 28 to 29, signed, read here as unsigned
  UINT32BE open_price;                   // bytes 30 to 33, signed, read here as unsigned
  UINT32BE high_price;                   // bytes 34 to 37, signed, read here as unsigned
  UINT32BE low_price;                    // bytes 38 to 41, signed, read here as unsigned
  UINT32BE closing_price;                // bytes 42 to 45, signed, read here as unsigned
  UINT32BE total_quantity_traded_short;  // bytes 46 to 49
  UINT8 total_value_traded[8];           // bytes 50 to 57
  UINT32BE previous_close_price;         // bytes 58 to 61, signed, read here as unsigned
  UINT64BE open_interest_long;           // bytes 62 to 69, signed, read here as unsigned
  UINT64BE chg_open_interest;            // bytes 70 to 77, signed, read here as unsigned
  UINT8 indicator[4];                    // bytes 78 to 81
} EnhncdMktStatsData;

// Enhanced bhavcopy market statistics records
typedef struct _EnhancedMarketStatisticsReportMessage {
  UINT8 message_type;                                        // byte 0
  UINT8 reserved_1;                                          // byte 1
  UINT16BE number_of_records;                                // bytes 2 to 3, signed, read here as unsigned
  EnhncdMktStatsData enhncd_mkt_stats_data[:byte-size 328];  // bytes 4 to 331
} EnhancedMarketStatisticsReportMessage;

// MKT_INDEX
typedef struct _MktIndex {
  UINT16BE market_opening_index;  // bytes 0 to 1, signed, read here as unsigned
  UINT16BE market_high_index;     // bytes 2 to 3, signed, read here as unsigned
  UINT16BE market_low_index;      // bytes 4 to 5, signed, read here as unsigned
  UINT16BE market_closing_index;  // bytes 6 to 7, signed, read here as unsigned
  UINT16BE market_start_index;    // bytes 8 to 9, signed, read here as unsigned
} MktIndex;

// Bhavcopy market index report
typedef struct _MarketIndexReportMessage {
