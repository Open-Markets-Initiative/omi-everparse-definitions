// CONTRACTS_DETAILS
typedef struct _ContractsDetails {
  UINT32BE token;                 // bytes 0 to 3, signed, read here as unsigned
  UINT8 nse_symbol[16];           // bytes 4 to 19
  UINT8 instrument_name[6];       // bytes 20 to 25
  UINT16BE exp_day;               // bytes 26 to 27, signed, read here as unsigned
  UINT16BE exp_month;             // bytes 28 to 29, signed, read here as unsigned
  UINT16BE exp_year;              // bytes 30 to 31, signed, read here as unsigned
  UINT8 option_type[2];           // bytes 32 to 33
  UINT32BE strike_price;          // bytes 34 to 37, signed, read here as unsigned
  UINT32BE bid_price;             // bytes 38 to 41, signed, read here as unsigned
  UINT32BE ask_price;             // bytes 42 to 45, signed, read here as unsigned
  UINT8 bid_size[8];              // bytes 46 to 53
  UINT8 ask_size[8];              // bytes 54 to 61
  UINT32BE open_;                 // bytes 62 to 65, signed, read here as unsigned
  UINT32BE high;                  // bytes 66 to 69, signed, read here as unsigned
  UINT32BE low;                   // bytes 70 to 73, signed, read here as unsigned
  UINT32BE last;                  // bytes 74 to 77, signed, read here as unsigned
  UINT32BE close;                 // bytes 78 to 81, signed, read here as unsigned
  UINT32BE prev_close;            // bytes 82 to 85, signed, read here as unsigned
  UINT32BE limit_high;            // bytes 86 to 89, signed, read here as unsigned
  UINT32BE limit_low;             // bytes 90 to 93, signed, read here as unsigned
  UINT8 total_trades[8];          // bytes 94 to 101
  UINT8 open_interest_double[8];  // bytes 102 to 109
  UINT8 filler_4[4];              // bytes 110 to 113
  UINT8 filler_2[4];              // bytes 114 to 117
  UINT8 filler_3[4];              // bytes 118 to 121
} ContractsDetails;

// Carries the values of a global contract
typedef struct _GlobalContractsMessage {
  ContractsDetails contracts_details;  // bytes 0 to 121
} GlobalContractsMessage;

// Confirms the box sign on
typedef struct _BoxSignOnRequestOutMessage {
  UINT16BE box_id;        // bytes 0 to 1, signed, read here as unsigned
  UINT8 reserved_10[10];  // bytes 2 to 11
} BoxSignOnRequestOutMessage;

// Signals the start or end of an outage on one or all matching engine streams
typedef struct _ContingencyBroadcastMessage {
  UINT16BE stream_number;   // bytes 0 to 1, signed, read here as unsigned
  UINT16BE status;          // bytes 2 to 3, signed, read here as unsigned
  UINT8 reserved_200[200];  // bytes 4 to 203
} ContingencyBroadcastMessage;

// Confirms the collateral status change
typedef struct _CollateralUserStatusChangeResponseMessage {
  UINT32BE user_id;    // bytes 0 to 3, signed, read here as unsigned
  UINT8 col_user_bit;  // byte 4
  UINT8 reserved_1;    // byte 5
} CollateralUserStatusChangeResponseMessage;

// Confirms the trade modify and cancel permission change
typedef struct _UserTradeModifyCancelStatusChangeResponseMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 trd_mod_cxl_bit;  // byte 4
  UINT8 reserved_1;       // byte 5
} UserTradeModifyCancelStatusChangeResponseMessage;

// Confirms that the unlock request was received
typedef struct _UserAddressUnlockConfirmMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_36[36];  // bytes 4 to 39
} UserAddressUnlockConfirmMessage;

// Approves the unlock of a user address
typedef struct _UserAddressUnlockApproveMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_36[36];  // bytes 4 to 39
} UserAddressUnlockApproveMessage;

// GIVEUP
typedef struct _Giveup {
  UINT8 order_number[8];             // bytes 0 to 7
  UINT32BE fill_number;              // bytes 8 to 11, signed, read here as unsigned
  UINT8 instrument_name[6];          // bytes 12 to 17
  UINT8 symbol[10];                  // bytes 18 to 27
  UINT32BE expiry_date;              // bytes 28 to 31, signed, read here as unsigned
  UINT32BE strike_price;             // bytes 32 to 35, signed, read here as unsigned
  UINT8 option_type[2];              // bytes 36 to 37
  UINT16BE ca_level;                 // bytes 38 to 39, signed, read here as unsigned
  UINT32BE fill_volume;              // bytes 40 to 43, signed, read here as unsigned
  UINT32BE fill_price;               // bytes 44 to 47, signed, read here as unsigned
  UINT8 broker_id[5];                // bytes 48 to 52
  UINT8 filler;                      // byte 53
  UINT16BE buy_sell;                 // bytes 54 to 55, signed, read here as unsigned
  UINT16BE book_type;                // bytes 56 to 57, signed, read here as unsigned
  UINT32BE last_modified_date_time;  // bytes 58 to 61, signed, read here as unsigned
  UINT8 initiated_by_control;        // byte 62
  UINT8 open_close;                  // byte 63
  UINT8 reserved_1;                  // byte 64
  UINT8 participant[12];             // bytes 65 to 76
  UINT8 giveup_flag;                 // byte 77
  UINT8 deleted;                     // byte 78
} Giveup;

// Confirms or rejects a give up of a trade to another trading member. Transaction Code in the header names which
typedef struct _GiveupConfirmationMessage {
  UINT16BE reason_code;  // bytes 0 to 1, signed, read here as unsigned
  Giveup giveup;         // bytes 2 to 80
} GiveupConfirmationMessage;

