  MsSpdLegInfo ms_spd_leg_info[:byte-size 160];  // bytes 280 to 439
} SpreadOrderBody;

// Branch
casetype _CancellationConfirmationBody (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x013C: OrderEntryBody order_entry_body;
    case 0x01E0: SpreadOrderBody spread_order_body;
    default: UINT8 unknown[available];
  }
} CancellationConfirmationBody;

// Confirms an order cancellation. Message Length selects the ordinary or the two and three leg layout
typedef struct _OrderCancellationConfirmationMessage (UINT16 message_length, UINT32 available) {
  CancellationConfirmationBody(message_length, available) cancellation_confirmation_body[:byte-size-single-element-array available];
} OrderCancellationConfirmationMessage;

// Branch
casetype _ServerMessagePayload (UINT16 selector, UINT16 message_length, UINT32 available) {
  switch (selector) {
    case 0x08FD: SignOnRequestOutMessage sign_on_request_out_message;
    case 0x0911: SignOffRequestOutMessage sign_off_request_out_message;
    case 0x0641: SystemInformationOutMessage system_information_out_message;
    case 0x0961: GatewayRouterResponseMessage(message_length, available) gateway_router_response_message;
    case 0x1C8B: UpdateLocalDatabaseHeaderMessage update_local_database_header_message;
    case 0x1C8C: UpdateLocalDatabaseTrailerMessage update_local_database_trailer_message;
    case 0x1C88: UpdateLocalDatabaseDataMessage(message_length) update_local_database_data_message;
    case 0x1B63: unit header_record_message;
    case 0x1B6D: MessageRecordMessage(message_length) message_record_message;
    case 0x1B77: unit trailer_record_message;
    case 0x0819: OrderConfirmationMessage order_confirmation_message;
    case 0x081A: OrderModificationConfirmationMessage order_modification_confirmation_message;
    case 0x07DC: OrderResponseMessage order_response_message;
    case 0x07FA: OrderResponseMessage order_response_message_2;
    case 0x0818: OrderResponseMessage order_response_message_3;
    case 0x087A: OrderResponseMessage order_response_message_4;
    case 0x08B7: OrderResponseMessage order_response_message_5;
    case 0x232A: OrderResponseMessage order_response_message_6;
    case 0x08AE: TradeConfirmationMessage trade_confirmation_message;
    case 0x08A4: TradeConfirmationMessage trade_confirmation_message_2;
    case 0x08EA: TradeConfirmationMessage trade_confirmation_message_3;
    case 0x08EE: TradeConfirmationMessage trade_confirmation_message_4;
    case 0x08EF: TradeConfirmationMessage trade_confirmation_message_5;
    case 0x08F0: TradeConfirmationMessage trade_confirmation_message_6;
    case 0x1663: UserOrderLimitUpdateMessage user_order_limit_update_message;
    case 0x1665: DealerLimitUpdateMessage dealer_limit_update_message;
    case 0x168C: SpreadOrderLimitUpdateMessage spread_order_limit_update_message;
    case 0x14AF: ControlMessageToTraderMessage control_message_to_trader_message;
    case 0x0729: MarketStatisticsReportMessage(available) market_statistics_report_message;
    case 0x2E39: EnhancedMarketStatisticsReportMessage enhanced_market_statistics_report_message;
    case 0x072C: MarketIndexReportMessage market_index_report_message;
    case 0x072D: IndustryIndexReportMessage industry_index_report_message;
    case 0x072E: SectorIndexReportMessage sector_index_report_message;
    case 0x0746: SpreadBhavcopyMessage(available) spread_bhavcopy_message;
    case 0x1E34: GlobalIndicesMessage global_indices_message;
    case 0x1E35: GlobalContractsMessage global_contracts_message;
    case 0x59E1: unit secure_box_registration_response_out_message;
    case 0x59D9: BoxSignOnRequestOutMessage box_sign_on_request_out_message;
    case 0x14AE: ContingencyBroadcastMessage contingency_broadcast_message;
    case 0x1671: CollateralUserStatusChangeResponseMessage collateral_user_status_change_response_message;
    case 0x166B: UserTradeModifyCancelStatusChangeResponseMessage user_trade_modify_cancel_status_change_response_message;
    case 0x1534: UserAddressUnlockConfirmMessage user_address_unlock_confirm_message;
    case 0x156B: UserAddressUnlockApproveMessage user_address_unlock_approve_message;
    case 0x119A: GiveupConfirmationMessage giveup_confirmation_message;
    case 0x119B: GiveupConfirmationMessage giveup_confirmation_message_2;
    case 0x081B: OrderCancellationConfirmationMessage(message_length, available) order_cancellation_confirmation_message;
    default: UINT8 unknown[available];
  }
} ServerMessagePayload;

// One framed interactive message sent by the exchange
typedef struct _ServerDirectPacket {
  UINT16BE packet_length { packet_length >= 62 };                                                                                                                                   // bytes 0 to 1
  UINT32BE packet_sequence_number;                                                                                                                                                  // bytes 2 to 5
  UINT8 checksum[16];                                                                                                                                                               // bytes 6 to 21
  UINT16BE transaction_code;                                                                                                                                                        // bytes 22 to 23, signed, read here as unsigned
  UINT32BE log_time;                                                                                                                                                                // bytes 24 to 27, signed, read here as unsigned
  UINT8 alpha_char[2];                                                                                                                                                              // bytes 28 to 29
  UINT32BE trader_id;                                                                                                                                                               // bytes 30 to 33, signed, read here as unsigned
  UINT16BE error_code;                                                                                                                                                              // bytes 34 to 35, signed, read here as unsigned
  UINT64BE header_timestamp;                                                                                                                                                        // bytes 36 to 43, signed, read here as unsigned
  UINT8 time_stamp_1[8];                                                                                                                                                            // bytes 44 to 51
  UINT8 time_stamp_2[8];                                                                                                                                                            // bytes 52 to 59
  UINT16BE message_length;                                                                                                                                                          // bytes 60 to 61, signed, read here as unsigned
  ServerMessagePayload(transaction_code, message_length, (((UINT32) packet_length) - 62)) server_message_payload[:byte-size-single-element-array (((UINT32) packet_length) - 62)];
} ServerDirectPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// Nnf direct interface Tcp block of one or more packets sent by the exchange
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerDirectPacket server_direct_packet[:byte-size available];
} ServerPacket;

