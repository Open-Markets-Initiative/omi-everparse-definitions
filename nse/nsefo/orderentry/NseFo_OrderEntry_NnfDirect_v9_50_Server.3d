  UINT32BE volume_filled_today_2;      // bytes 58 to 61, signed, read here as unsigned
  UINT32BE price_2;                    // bytes 62 to 65, signed, read here as unsigned
  UINT32BE trigger_price_2;            // bytes 66 to 69, signed, read here as unsigned
  UINT32BE min_fill_aon_2;             // bytes 70 to 73, signed, read here as unsigned
  UINT16BE ato : 1;                    // bytes 74 to 75
  UINT16BE market : 1;                 // bytes 74 to 75
  UINT16BE sl : 1;                     // bytes 74 to 75
  UINT16BE mit : 1;                    // bytes 74 to 75
  UINT16BE day : 1;                    // bytes 74 to 75
  UINT16BE gtc : 1;                    // bytes 74 to 75
  UINT16BE ioc : 1;                    // bytes 74 to 75
  UINT16BE aon : 1;                    // bytes 74 to 75
  UINT16BE mf : 1;                     // bytes 74 to 75
  UINT16BE matched_ind : 1;            // bytes 74 to 75
  UINT16BE traded : 1;                 // bytes 74 to 75
  UINT16BE modified : 1;               // bytes 74 to 75
  UINT16BE frozen : 1;                 // bytes 74 to 75
  UINT16BE order_pre_open : 1;         // bytes 74 to 75
  UINT16BE reserved_12 : 2;            // bytes 74 to 75
  UINT8 open_close_2;                  // byte 76
  UINT8 boc : 1;                       // byte 77
  UINT8 col : 1;                       // byte 77
