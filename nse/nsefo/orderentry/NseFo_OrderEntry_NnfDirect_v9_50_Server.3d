} MarketIndexReportMessage;

// INDUSTRY_INDEX
typedef struct _IndustryIndex {
  UINT8 industry_name[15];  // bytes 0 to 14
  UINT32BE opening;         // bytes 15 to 18, signed, read here as unsigned
  UINT32BE high;            // bytes 19 to 22, signed, read here as unsigned
  UINT32BE low;             // bytes 23 to 26, signed, read here as unsigned
  UINT32BE closing;         // bytes 27 to 30, signed, read here as unsigned
  UINT32BE start;           // bytes 31 to 34, signed, read here as unsigned
} IndustryIndex;

// Bhavcopy industry index report
typedef struct _IndustryIndexReportMessage {
  UINT8 message_type;                            // byte 0
  UINT8 reserved_1;                              // byte 1
  UINT16BE number_of_industry_records;           // bytes 2 to 3, signed, read here as unsigned
