} IndexData;

// Bhavcopy sector index report
typedef struct _SectorIndexReportMessage {
  UINT8 message_type;                    // byte 0
  UINT8 industry_name[15];               // bytes 1 to 15
  UINT16BE number_of_industry_records;   // bytes 16 to 17, signed, read here as unsigned
  IndexData index_data[:byte-size 190];  // bytes 18 to 207
} SectorIndexReportMessage;

// Spread Report Header Body
typedef struct _SpreadReportHeaderBody {
  UINT8 org_scope;         // byte 0
  UINT32BE report_date;    // bytes 1 to 4, signed, read here as unsigned
  UINT16BE user_type;      // bytes 5 to 6, signed, read here as unsigned
  UINT8 broker_number[5];  // bytes 7 to 11
  UINT8 broker_name[25];   // bytes 12 to 36
  UINT32BE trader_number;  // bytes 37 to 40, signed, read here as unsigned
  UINT8 trader_name[26];   // bytes 41 to 66
} SpreadReportHeaderBody;

// SPD_STATS_DATA
typedef struct _SpdStatsData {
  UINT16BE market_type;          // bytes 0 to 1, signed, read here as unsigned
  UINT8 instrumentname_1[6];     // bytes 2 to 7
  UINT8 symbol_1[10];            // bytes 8 to 17
  UINT32BE expirydate_1;         // bytes 18 to 21, signed, read here as unsigned
  UINT32BE strikeprice_1;        // bytes 22 to 25, signed, read here as unsigned
  UINT8 optiontype_1[2];         // bytes 26 to 27
  UINT16BE calevel_1;            // bytes 28 to 29, signed, read here as unsigned
  UINT8 instrumentname_2[6];     // bytes 30 to 35
  UINT8 symbol_2[10];            // bytes 36 to 45
  UINT32BE expirydate_2;         // bytes 46 to 49, signed, read here as unsigned
  UINT32BE strikeprice_2;        // bytes 50 to 53, signed, read here as unsigned
  UINT8 optiontype_2[2];         // bytes 54 to 55
  UINT16BE calevel_2;            // bytes 56 to 57, signed, read here as unsigned
  UINT32BE openpd;               // bytes 58 to 61, signed, read here as unsigned
  UINT32BE hipd;                 // bytes 62 to 65, signed, read here as unsigned
  UINT32BE lowpd;                // bytes 66 to 69, signed, read here as unsigned
  UINT32BE lasttradedpd;         // bytes 70 to 73, signed, read here as unsigned
  UINT32BE noofcontractstraded;  // bytes 74 to 77, signed, read here as unsigned
} SpdStatsData;

// Spread Report Statistics Body
typedef struct _SpreadReportStatisticsBody {
  UINT8 reserved_1;                             // byte 0
  UINT16BE no_of_records;                       // bytes 1 to 2, signed, read here as unsigned
  SpdStatsData spd_stats_data[:byte-size 234];  // bytes 3 to 236
} SpreadReportStatisticsBody;

// Branch
casetype _SpreadReportBody (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x48: SpreadReportHeaderBody spread_report_header_body;
    case 0x58: SpreadReportHeaderBody spread_report_header_body_2;
    case 0x4C: SpreadReportHeaderBody spread_report_header_body_3;
    case 0x52: SpreadReportStatisticsBody spread_report_statistics_body;
    case 0x59: SpreadReportStatisticsBody spread_report_statistics_body_2;
    case 0x4D: SpreadReportStatisticsBody spread_report_statistics_body_3;
    case 0x54: ReportTrailerBody report_trailer_body;
    case 0x5A: ReportTrailerBody report_trailer_body_2;
    case 0x4E: ReportTrailerBody report_trailer_body_3;
    default: UINT8 unknown[available];
  }
} SpreadReportBody;

// Spread bhavcopy header, spread statistics records or trailer. Message Type selects which
typedef struct _SpreadBhavcopyMessage (UINT32 available) where (available >= 1) {
  UINT8 message_type;                                                                                                   // byte 0
  SpreadReportBody(message_type, (available - 1)) spread_report_body[:byte-size-single-element-array (available - 1)];
} SpreadBhavcopyMessage;

// INDEX_DETAILS
typedef struct _IndexDetails {
  UINT32BE token;       // bytes 0 to 3, signed, read here as unsigned
