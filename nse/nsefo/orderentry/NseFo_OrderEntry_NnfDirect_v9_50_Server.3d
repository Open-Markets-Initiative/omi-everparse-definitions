// Status: 2 byte code
#define STATUS_END_OF_OUTAGE 0x0000    // End Of Outage
#define STATUS_START_OF_OUTAGE 0x0001  // Start Of Outage

// ---- Packet Header: 6 bytes --------------------------------------------------

// Packet Length and Sequence number, the first six bytes of the direct interface's twenty two byte packet header; its last sixteen open each packet body branch
entrypoint typedef struct _PacketHeader {
  UINT16BE packet_length;           // bytes 0 to 1
  UINT32BE packet_sequence_number;  // bytes 2 to 5
} PacketHeader;

// ---- Message Header: 40 bytes ------------------------------------------------

// MESSAGE_HEADER
entrypoint typedef struct _MessageHeader {
  UINT16BE transaction_code;  // bytes 0 to 1, values TRANSACTION_CODE_, signed, read here as unsigned
  UINT32BE log_time;          // bytes 2 to 5, signed, read here as unsigned
  UINT8 alpha_char[2];        // bytes 6 to 7
  UINT32BE trader_id;         // bytes 8 to 11, signed, read here as unsigned
  UINT16BE error_code;        // bytes 12 to 13, values ERROR_CODE_, signed, read here as unsigned
  UINT64BE header_timestamp;  // bytes 14 to 21, signed, read here as unsigned
  UINT8 time_stamp_1[8];      // bytes 22 to 29
  UINT8 time_stamp_2[8];      // bytes 30 to 37
  UINT16BE message_length;    // bytes 38 to 39, signed, read here as unsigned
} MessageHeader;

// ---- Sign Off Request Out Message: 149 bytes ---------------------------------

// Breaks the virtual circuit between the host and the front end
entrypoint typedef struct _SignOffRequestOutMessage {
  UINT32BE user_id;         // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_145[145];  // bytes 4 to 148
} SignOffRequestOutMessage;

// ---- St Market Status: 8 bytes -----------------------------------------------

// ST_MARKET_STATUS
entrypoint typedef struct _StMarketStatus {
  UINT16BE market_status_normal;   // bytes 0 to 1, values MARKET_STATUS_NORMAL_, signed, read here as unsigned
  UINT16BE market_status_oddlot;   // bytes 2 to 3, values MARKET_STATUS_ODDLOT_, signed, read here as unsigned
  UINT16BE market_status_spot;     // bytes 4 to 5, values MARKET_STATUS_SPOT_, signed, read here as unsigned
  UINT16BE market_status_auction;  // bytes 6 to 7, values MARKET_STATUS_AUCTION_, signed, read here as unsigned
} StMarketStatus;

// ---- St Ex Market Status: 8 bytes --------------------------------------------

// ST_EX_MARKET_STATUS
entrypoint typedef struct _StExMarketStatus {
  UINT16BE ex_market_status_normal;   // bytes 0 to 1, values EX_MARKET_STATUS_NORMAL_, signed, read here as unsigned
  UINT16BE ex_market_status_oddlot;   // bytes 2 to 3, values EX_MARKET_STATUS_ODDLOT_, signed, read here as unsigned
  UINT16BE ex_market_status_spot;     // bytes 4 to 5, values EX_MARKET_STATUS_SPOT_, signed, read here as unsigned
  UINT16BE ex_market_status_auction;  // bytes 6 to 7, values EX_MARKET_STATUS_AUCTION_, signed, read here as unsigned
} StExMarketStatus;

// ---- St Pl Market Status: 8 bytes --------------------------------------------

// ST_PL_MARKET_STATUS
entrypoint typedef struct _StPlMarketStatus {
  UINT16BE pl_market_status_normal;   // bytes 0 to 1, values PL_MARKET_STATUS_NORMAL_, signed, read here as unsigned
  UINT16BE pl_market_status_oddlot;   // bytes 2 to 3, values PL_MARKET_STATUS_ODDLOT_, signed, read here as unsigned
  UINT16BE pl_market_status_spot;     // bytes 4 to 5, values PL_MARKET_STATUS_SPOT_, signed, read here as unsigned
  UINT16BE pl_market_status_auction;  // bytes 6 to 7, values PL_MARKET_STATUS_AUCTION_, signed, read here as unsigned
} StPlMarketStatus;

// ---- Existing Encryption Tail: 16 bytes --------------------------------------

// Initialisation vector used by the existing encryption
entrypoint typedef struct _ExistingEncryptionTail {
  UINT8 cryptographic_iv[16];  // bytes 0 to 15
} ExistingEncryptionTail;

// ---- New Encryption Tail: 28 bytes -------------------------------------------

// Initialisation vectors used by the new authenticated encryption
entrypoint typedef struct _NewEncryptionTail {
  UINT8 static_cryptographic_iv[8];        // bytes 0 to 7
  UINT64BE dynamic_cryptographic_iv;       // bytes 8 to 15, signed, read here as unsigned
  UINT8 cryptographic_additional_key[12];  // bytes 16 to 27
} NewEncryptionTail;

// ---- Update Local Database Header Message: 2 bytes ---------------------------

// Opens the local database download
entrypoint typedef struct _UpdateLocalDatabaseHeaderMessage {
  UINT8 reserved_2[2];  // bytes 0 to 1
} UpdateLocalDatabaseHeaderMessage;

// ---- Update Local Database Trailer Message: 2 bytes --------------------------

// Closes the local database download
entrypoint typedef struct _UpdateLocalDatabaseTrailerMessage {
  UINT8 reserved_2[2];  // bytes 0 to 1
} UpdateLocalDatabaseTrailerMessage;

// ---- Inner Header: 40 bytes --------------------------------------------------

// INNER_MESSAGE_HEADER
entrypoint typedef struct _InnerHeader {
  UINT32BE inner_trader_id;         // bytes 0 to 3, signed, read here as unsigned
  UINT32BE inner_log_time;          // bytes 4 to 7, signed, read here as unsigned
  UINT8 inner_alpha_char[2];        // bytes 8 to 9
  UINT16BE inner_transaction_code;  // bytes 10 to 11, signed, read here as unsigned
  UINT16BE inner_error_code;        // bytes 12 to 13, signed, read here as unsigned
  UINT64BE inner_timestamp;         // bytes 14 to 21, signed, read here as unsigned
  UINT8 inner_time_stamp_1[8];      // bytes 22 to 29
  UINT8 inner_time_stamp_2[8];      // bytes 30 to 37
  UINT16BE inner_message_length;    // bytes 38 to 39, signed, read here as unsigned
} InnerHeader;

// ---- Download Header: 40 bytes -----------------------------------------------

// MESSAGE_HEADER of the downloaded message
entrypoint typedef struct _DownloadHeader {
  UINT16BE inner_transaction_code;  // bytes 0 to 1, signed, read here as unsigned
  UINT32BE inner_log_time;          // bytes 2 to 5, signed, read here as unsigned
  UINT8 inner_alpha_char[2];        // bytes 6 to 7
  UINT32BE inner_trader_id;         // bytes 8 to 11, signed, read here as unsigned
  UINT16BE inner_error_code;        // bytes 12 to 13, signed, read here as unsigned
  UINT64BE inner_timestamp;         // bytes 14 to 21, signed, read here as unsigned
  UINT8 inner_time_stamp_1[8];      // bytes 22 to 29
  UINT8 inner_time_stamp_2[8];      // bytes 30 to 37
  UINT16BE inner_message_length;    // bytes 38 to 39, signed, read here as unsigned
} DownloadHeader;

// ---- Contract Desc: 28 bytes -------------------------------------------------

// CONTRACT_DESC
entrypoint typedef struct _ContractDesc {
  UINT8 instrument_name[6];  // bytes 0 to 5
  UINT8 symbol[10];          // bytes 6 to 15
  UINT32BE expiry_date;      // bytes 16 to 19, signed, read here as unsigned
  UINT32BE strike_price;     // bytes 20 to 23, signed, read here as unsigned
  UINT8 option_type[2];      // bytes 24 to 25
  UINT16BE ca_level;         // bytes 26 to 27, signed, read here as unsigned
} ContractDesc;

// ---- Control Message To Trader Message: 249 bytes ----------------------------

// Interactive message sent to the trader from Nse Control
entrypoint typedef struct _ControlMessageToTraderMessage {
  UINT32BE trader_id;                  // bytes 0 to 3, signed, read here as unsigned
  UINT8 action_code[3];                // bytes 4 to 6
  UINT8 reserved_1;                    // byte 7
  UINT16BE broad_cast_message_length;  // bytes 8 to 9, signed, read here as unsigned
  UINT8 broad_cast_message[239];       // bytes 10 to 248
} ControlMessageToTraderMessage;

// ---- Report Header Body: 67 bytes --------------------------------------------

// Report Header Body
entrypoint typedef struct _ReportHeaderBody {
  UINT8 org_scope;         // byte 0
  UINT32BE report_date;    // bytes 1 to 4, signed, read here as unsigned
  UINT16BE user_type;      // bytes 5 to 6, signed, read here as unsigned
  UINT8 broker_id[5];      // bytes 7 to 11
  UINT8 firm_name[25];     // bytes 12 to 36
  UINT32BE trader_number;  // bytes 37 to 40, signed, read here as unsigned
  UINT8 trader_name[26];   // bytes 41 to 66
} ReportHeaderBody;

// ---- Report Trailer Body: 5 bytes --------------------------------------------

// Report Trailer Body
entrypoint typedef struct _ReportTrailerBody {
  UINT32BE number_of_packets;  // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_1;            // byte 4
} ReportTrailerBody;

// ---- Mkt Index: 10 bytes -----------------------------------------------------

// MKT_INDEX
entrypoint typedef struct _MktIndex {
  UINT16BE market_opening_index;  // bytes 0 to 1, signed, read here as unsigned
  UINT16BE market_high_index;     // bytes 2 to 3, signed, read here as unsigned
  UINT16BE market_low_index;      // bytes 4 to 5, signed, read here as unsigned
  UINT16BE market_closing_index;  // bytes 6 to 7, signed, read here as unsigned
  UINT16BE market_start_index;    // bytes 8 to 9, signed, read here as unsigned
} MktIndex;

// ---- Market Index Report Message: 26 bytes -----------------------------------

// Bhavcopy market index report
entrypoint typedef struct _MarketIndexReportMessage {
  UINT8 message_type;    // byte 0
  UINT8 index_name[15];  // bytes 1 to 15
  MktIndex mkt_index;    // bytes 16 to 25
} MarketIndexReportMessage;

// ---- Spread Report Header Body: 67 bytes -------------------------------------

// Spread Report Header Body
entrypoint typedef struct _SpreadReportHeaderBody {
  UINT8 org_scope;         // byte 0
  UINT32BE report_date;    // bytes 1 to 4, signed, read here as unsigned
  UINT16BE user_type;      // bytes 5 to 6, signed, read here as unsigned
  UINT8 broker_number[5];  // bytes 7 to 11
  UINT8 broker_name[25];   // bytes 12 to 36
  UINT32BE trader_number;  // bytes 37 to 40, signed, read here as unsigned
  UINT8 trader_name[26];   // bytes 41 to 66
} SpreadReportHeaderBody;

// ---- Index Details: 98 bytes -------------------------------------------------

// INDEX_DETAILS
entrypoint typedef struct _IndexDetails {
  UINT32BE token;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 name[50];       // bytes 4 to 53
  UINT32BE open_;       // bytes 54 to 57, signed, read here as unsigned
  UINT32BE high;        // bytes 58 to 61, signed, read here as unsigned
  UINT32BE low;         // bytes 62 to 65, signed, read here as unsigned
  UINT32BE last;        // bytes 66 to 69, signed, read here as unsigned
  UINT32BE close;       // bytes 70 to 73, signed, read here as unsigned
  UINT32BE prev_close;  // bytes 74 to 77, signed, read here as unsigned
  UINT32BE life_high;   // bytes 78 to 81, signed, read here as unsigned
  UINT32BE life_low;    // bytes 82 to 85, signed, read here as unsigned
  UINT8 filler_4[4];    // bytes 86 to 89
  UINT8 filler_2[4];    // bytes 90 to 93
  UINT8 filler_3[4];    // bytes 94 to 97
} IndexDetails;

// ---- Global Indices Message: 98 bytes ----------------------------------------

// Carries the values of a global index
entrypoint typedef struct _GlobalIndicesMessage {
  IndexDetails index_details;  // bytes 0 to 97
} GlobalIndicesMessage;

// ---- Box Sign On Request Out Message: 12 bytes -------------------------------

// Confirms the box sign on
entrypoint typedef struct _BoxSignOnRequestOutMessage {
  UINT16BE box_id;        // bytes 0 to 1, signed, read here as unsigned
  UINT8 reserved_10[10];  // bytes 2 to 11
} BoxSignOnRequestOutMessage;

// ---- Contingency Broadcast Message: 204 bytes --------------------------------

// Signals the start or end of an outage on one or all matching engine streams
entrypoint typedef struct _ContingencyBroadcastMessage {
  UINT16BE stream_number;   // bytes 0 to 1, signed, read here as unsigned
  UINT16BE status;          // bytes 2 to 3, values STATUS_, signed, read here as unsigned
  UINT8 reserved_200[200];  // bytes 4 to 203
} ContingencyBroadcastMessage;

// ---- Collateral User Status Change Response Message: 6 bytes -----------------

// Confirms the collateral status change
entrypoint typedef struct _CollateralUserStatusChangeResponseMessage {
  UINT32BE user_id;    // bytes 0 to 3, signed, read here as unsigned
  UINT8 col_user_bit;  // byte 4
  UINT8 reserved_1;    // byte 5
} CollateralUserStatusChangeResponseMessage;

// ---- User Trade Modify Cancel Status Change Response Message: 6 bytes --------

// Confirms the trade modify and cancel permission change
entrypoint typedef struct _UserTradeModifyCancelStatusChangeResponseMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 trd_mod_cxl_bit;  // byte 4
  UINT8 reserved_1;       // byte 5
} UserTradeModifyCancelStatusChangeResponseMessage;

// ---- User Address Unlock Confirm Message: 40 bytes ---------------------------

// Confirms that the unlock request was received
entrypoint typedef struct _UserAddressUnlockConfirmMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_36[36];  // bytes 4 to 39
} UserAddressUnlockConfirmMessage;

// ---- User Address Unlock Approve Message: 40 bytes ---------------------------

// Approves the unlock of a user address
entrypoint typedef struct _UserAddressUnlockApproveMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_36[36];  // bytes 4 to 39
} UserAddressUnlockApproveMessage;

