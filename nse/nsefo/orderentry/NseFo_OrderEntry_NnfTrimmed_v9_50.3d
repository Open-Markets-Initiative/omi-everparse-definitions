// Immediate acknowledgement that an order related request reached the exchange
typedef struct _QuickAcknowledgementMessage {
  UINT32BE trader_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT64BE time_stamp;      // bytes 4 to 11, signed, read here as unsigned
  UINT32BE reference;       // bytes 12 to 15, signed, read here as unsigned
  UINT16BE error_code;      // bytes 16 to 17, signed, read here as unsigned
  UINT16BE message_length;  // bytes 18 to 19, signed, read here as unsigned
} QuickAcknowledgementMessage;

// Branch
casetype _MessagePayload (UINT16 selector) {
  switch (selector) {
    case 0x4E20: BoardLotInTrimmedMessage board_lot_in_trimmed_message;
    case 0x4FB0: BoardLotInTrimmedMessage board_lot_in_trimmed_message_2;
    case 0x4E48: OrderModifyCancelTrimmedMessage order_modify_cancel_trimmed_message;
    case 0x4E5C: OrderModifyCancelTrimmedMessage order_modify_cancel_trimmed_message_2;
    case 0x4E66: OrderModifyCancelTrimmedMessage order_modify_cancel_trimmed_message_3;
    case 0x4FB2: OrderModifyCancelTrimmedMessage order_modify_cancel_trimmed_message_4;
    case 0x4FB4: OrderModifyCancelTrimmedMessage order_modify_cancel_trimmed_message_5;
    case 0x4E69: OrderConfirmationTrimmedMessage order_confirmation_trimmed_message;
    case 0x4E6A: OrderConfirmationTrimmedMessage order_confirmation_trimmed_message_2;
    case 0x4E6B: OrderConfirmationTrimmedMessage order_confirmation_trimmed_message_3;
    case 0x4EFE: TradeConfirmationTrimmedMessage trade_confirmation_trimmed_message;
    case 0x4FB1: QuickAcknowledgementMessage quick_acknowledgement_message;
    case 0x4FB3: QuickAcknowledgementMessage quick_acknowledgement_message_2;
    case 0x4FB5: QuickAcknowledgementMessage quick_acknowledgement_message_3;
    case 0x4FB7: QuickAcknowledgementMessage quick_acknowledgement_message_4;
    case 0x4FB9: QuickAcknowledgementMessage quick_acknowledgement_message_5;
    case 0x4FBB: QuickAcknowledgementMessage quick_acknowledgement_message_6;
    case 0x4FBD: QuickAcknowledgementMessage quick_acknowledgement_message_7;
    case 0x4FBF: QuickAcknowledgementMessage quick_acknowledgement_message_8;
    case 0x4FC1: QuickAcknowledgementMessage quick_acknowledgement_message_9;
  }
} MessagePayload;

// Nnf trimmed message
typedef struct _Message {
  UINT16BE transaction_code;                         // bytes 0 to 1, signed, read here as unsigned
  MessagePayload(transaction_code) message_payload;
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// NnfTrimmed Tcp block of one or more messages
entrypoint typedef struct _Packet (UINT32 available) {
  Message message[:byte-size available];
} Packet;

