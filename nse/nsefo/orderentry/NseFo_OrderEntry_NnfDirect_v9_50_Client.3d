  UINT8 fillerx_2;                     // byte 37
  UINT16BE order_type_2;               // bytes 38 to 39, signed, read here as unsigned
  UINT16BE buy_sell_2;                 // bytes 40 to 41, signed, read here as unsigned
  UINT32BE disclosed_vol_2;            // bytes 42 to 45, signed, read here as unsigned
  UINT32BE disclosed_vol_remaining_2;  // bytes 46 to 49, signed, read here as unsigned
  UINT32BE total_vol_remaining_2;      // bytes 50 to 53, signed, read here as unsigned
  UINT32BE volume_2;                   // bytes 54 to 57, signed, read here as unsigned
  UINT32BE volume_filled_today_2;      // bytes 58 to 61, signed, read here as unsigned
  UINT32BE price_2;                    // bytes 62 to 65, signed, read here as unsigned
  UINT32BE trigger_price_2;            // bytes 66 to 69, signed, read here as unsigned
  UINT32BE min_fill_aon_2;             // bytes 70 to 73, signed, read here as unsigned
  UINT16BE ato : 1;                    // bytes 74 to 75
  UINT16BE market : 1;                 // bytes 74 to 75
  UINT16BE sl : 1;                     // bytes 74 to 75
  UINT16BE mit : 1;                    // bytes 74 to 75
  UINT16BE day : 1;                    // bytes 74 to 75
  UINT16BE gtc : 1;                    // bytes 74 to 75
  UINT16BE ioc : 1;                    // bytes 74 to 75
  UINT16BE aon : 1;                    // bytes 74 to 75
  UINT16BE mf : 1;                     // bytes 74 to 75
  UINT16BE matched_ind : 1;            // bytes 74 to 75
  UINT16BE traded : 1;                 // bytes 74 to 75
  UINT16BE modified : 1;               // bytes 74 to 75
  UINT16BE frozen : 1;                 // bytes 74 to 75
  UINT16BE order_pre_open : 1;         // bytes 74 to 75
  UINT16BE reserved_12 : 2;            // bytes 74 to 75
  UINT8 open_close_2;                  // byte 76
  UINT8 boc : 1;                       // byte 77
  UINT8 col : 1;                       // byte 77
  UINT8 reserved_34 : 2;               // byte 77
  UINT8 stpc : 1;                      // byte 77
  UINT8 reserved_68 : 3;               // byte 77
  UINT8 reserved_1;                    // byte 78
  UINT8 filler_y;                      // byte 79
} MsSpdLegInfo;

// Spread Order Body
typedef struct _SpreadOrderBody {
  UINT8 participant_type_1;                      // byte 0
  UINT8 filler_1;                                // byte 1
  UINT16BE competitor_period_1;                  // bytes 2 to 3, signed, read here as unsigned
  UINT16BE solicitor_period_1;                   // bytes 4 to 5, signed, read here as unsigned
  UINT8 mod_cxl_by_1;                            // byte 6
  UINT8 filler_9;                                // byte 7
  UINT16BE reason_code_1;                        // bytes 8 to 9, signed, read here as unsigned
  UINT8 start_alpha_1[2];                        // bytes 10 to 11
  UINT8 end_alpha_1[2];                          // bytes 12 to 13
  UINT32BE token_1;                              // bytes 14 to 17, signed, read here as unsigned
  ContractDesc contract_desc;                    // bytes 18 to 45
  UINT8 op_broker_id_1[5];                       // bytes 46 to 50
  UINT8 fillerx_1;                               // byte 51
  UINT8 filler_options_1[3];                     // bytes 52 to 54
  UINT8 fillery_1;                               // byte 55
  UINT16BE order_type_1;                         // bytes 56 to 57, signed, read here as unsigned
  UINT8 order_number_1[8];                       // bytes 58 to 65
  UINT8 account_number_1[10];                    // bytes 66 to 75
  UINT16BE book_type_1;                          // bytes 76 to 77, signed, read here as unsigned
  UINT16BE buy_sell_1;                           // bytes 78 to 79, signed, read here as unsigned
  UINT32BE disclosed_vol_1;                      // bytes 80 to 83, signed, read here as unsigned
  UINT32BE disclosed_vol_remaining_1;            // bytes 84 to 87, signed, read here as unsigned
  UINT32BE total_vol_remaining_1;                // bytes 88 to 91, signed, read here as unsigned
  UINT32BE volume_1;                             // bytes 92 to 95, signed, read here as unsigned
  UINT32BE volume_filled_today_1;                // bytes 96 to 99, signed, read here as unsigned
  UINT32BE price_1;                              // bytes 100 to 103, signed, read here as unsigned
  UINT32BE trigger_price_1;                      // bytes 104 to 107, signed, read here as unsigned
  UINT32BE good_till_date_1;                     // bytes 108 to 111, signed, read here as unsigned
  UINT32BE entry_date_time_1;                    // bytes 112 to 115, signed, read here as unsigned
  UINT32BE min_fill_aon_1;                       // bytes 116 to 119, signed, read here as unsigned
  UINT32BE last_modified_1;                      // bytes 120 to 123, signed, read here as unsigned
  UINT16BE ato : 1;                              // bytes 124 to 125
  UINT16BE market : 1;                           // bytes 124 to 125
  UINT16BE sl : 1;                               // bytes 124 to 125
  UINT16BE mit : 1;                              // bytes 124 to 125
  UINT16BE day : 1;                              // bytes 124 to 125
  UINT16BE gtc : 1;                              // bytes 124 to 125
  UINT16BE ioc : 1;                              // bytes 124 to 125
  UINT16BE aon : 1;                              // bytes 124 to 125
  UINT16BE mf : 1;                               // bytes 124 to 125
  UINT16BE matched_ind : 1;                      // bytes 124 to 125
  UINT16BE traded : 1;                           // bytes 124 to 125
  UINT16BE modified : 1;                         // bytes 124 to 125
  UINT16BE frozen : 1;                           // bytes 124 to 125
  UINT16BE order_pre_open : 1;                   // bytes 124 to 125
  UINT16BE reserved_12 : 2;                      // bytes 124 to 125
  UINT16BE branch_id_1;                          // bytes 126 to 127, signed, read here as unsigned
  UINT32BE trader_id_1;                          // bytes 128 to 131, signed, read here as unsigned
  UINT8 broker_id_1[5];                          // bytes 132 to 136
  UINT8 c_ord_filler[24];                        // bytes 137 to 160
  UINT8 open_close_1;                            // byte 161
  UINT8 settlor_1[12];                           // bytes 162 to 173
  UINT16BE pro_client_1;                         // bytes 174 to 175, signed, read here as unsigned
  UINT16BE settlement_period_1;                  // bytes 176 to 177, signed, read here as unsigned
  UINT8 boc : 1;                                 // byte 178
  UINT8 col : 1;                                 // byte 178
  UINT8 reserved_34 : 2;                         // byte 178
  UINT8 stpc : 1;                                // byte 178
  UINT8 reserved_68 : 3;                         // byte 178
  UINT8 reserved_1;                              // byte 179
  UINT8 filler_116[2];                           // bytes 180 to 181
  UINT8 filler_17;                               // byte 182
  UINT8 filler_18;                               // byte 183
  UINT8 nnf_field[8];                            // bytes 184 to 191
  UINT64BE mkt_replay;                           // bytes 192 to 199, signed, read here as unsigned
  UINT8 pan[10];                                 // bytes 200 to 209
  UINT32BE algo_id;                              // bytes 210 to 213, signed, read here as unsigned
  UINT8 reserved_2[2];                           // bytes 214 to 215
  UINT64BE last_activity_reference;              // bytes 216 to 223, signed, read here as unsigned
  UINT8 reserved_52[52];                         // bytes 224 to 275
  UINT32BE price_diff;                           // bytes 276 to 279, signed, read here as unsigned
  MsSpdLegInfo ms_spd_leg_info[:byte-size 160];  // bytes 280 to 439
} SpreadOrderBody;

// Spread and 2L and 3L order entry, modification and cancellation, and their confirmations and errors, all carried in the shared spread structure. Transaction Code in the header names the operation
typedef struct _SpreadOrderEntryMessage {
  SpreadOrderBody spread_order_body;  // bytes 0 to 439
} SpreadOrderEntryMessage;

// Registers the box with the allocated gateway server
typedef struct _SecureBoxRegistrationRequestInMessage {
  UINT16BE box_id;  // bytes 0 to 1, signed, read here as unsigned
} SecureBoxRegistrationRequestInMessage;

// Signs the box on to the allocated gateway server
typedef struct _BoxSignOnRequestInMessage {
  UINT16BE box_id;       // bytes 0 to 1, signed, read here as unsigned
  UINT8 broker_id[5];    // bytes 2 to 6
  UINT8 reserved_5[5];   // bytes 7 to 11
  UINT8 session_key[8];  // bytes 12 to 19
} BoxSignOnRequestInMessage;

// Signs the box off the gateway server
typedef struct _BoxSignOffMessage {
  UINT16BE box_id;  // bytes 0 to 1, signed, read here as unsigned
} BoxSignOffMessage;

// BRANCH_LIMITS
typedef struct _BranchLimits {
  UINT8 branch_buy_value_limit[8];   // bytes 0 to 7
  UINT8 branch_sell_value_limit[8];  // bytes 8 to 15
  UINT8 reserved_16[16];             // bytes 16 to 31
} BranchLimits;

// Sets the buy and sell value limits for a branch
typedef struct _BranchOrderValueLimitUpdateMessage {
  UINT8 broker_id[5];       // bytes 0 to 4
  UINT8 reserved_25[25];    // bytes 5 to 29
  UINT16BE branch_id;       // bytes 30 to 31, signed, read here as unsigned
  UINT8 branch_limits[64];  // bytes 32 to 95
} BranchOrderValueLimitUpdateMessage;

// USER_LIMITS
typedef struct _UserLimits {
  UINT8 reserved_32[32];                 // bytes 0 to 31
  UINT8 user_order_buy_value_limit[8];   // bytes 32 to 39
  UINT8 user_order_sell_value_limit[8];  // bytes 40 to 47
  UINT8 reserved_16[16];                 // bytes 48 to 63
} UserLimits;

// Sets the buy and sell order value limits for a user
typedef struct _UserOrderValueLimitUpdateMessage {
  UINT8 broker_id[5];      // bytes 0 to 4
  UINT8 reserved_1;        // byte 5
  UINT16BE branch_id;      // bytes 6 to 7, signed, read here as unsigned
  UINT8 reserved_26[26];   // bytes 8 to 33
  UINT32BE user_id;        // bytes 34 to 37, signed, read here as unsigned
  UINT8 reserved_2[2];     // bytes 38 to 39
  UINT8 user_limits[128];  // bytes 40 to 167
} UserOrderValueLimitUpdateMessage;

// Sets the order quantity and value limits for a user
typedef struct _NormalOrderLimitUpdateMessage {
  UINT8 broker_id[5];        // bytes 0 to 4
  UINT8 reserved_1;          // byte 5
  UINT32BE user_id;          // bytes 6 to 9, signed, read here as unsigned
  UINT8 order_qty_limit[8];  // bytes 10 to 17
  UINT8 order_val_limit[8];  // bytes 18 to 25
} NormalOrderLimitUpdateMessage;

// Requests a reset of the user password
typedef struct _ResetUserPasswordMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_14[14];  // bytes 4 to 17
} ResetUserPasswordMessage;

// Changes the collateral status of a user
typedef struct _CollateralUserStatusChangeRequestMessage {
  UINT32BE user_id;     // bytes 0 to 3, signed, read here as unsigned
  UINT8 col_user_bit;   // byte 4
  UINT8 reserved_7[7];  // bytes 5 to 11
} CollateralUserStatusChangeRequestMessage;

// Changes whether a user may modify or cancel trades
typedef struct _UserTradeModifyCancelStatusChangeRequestMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 trd_mod_cxl_bit;  // byte 4
  UINT8 reserved_7[7];    // bytes 5 to 11
} UserTradeModifyCancelStatusChangeRequestMessage;

// Requests that a locked user address be unlocked
typedef struct _UserAddressUnlockRequestMessage {
  UINT32BE user_id;       // bytes 0 to 3, signed, read here as unsigned
  UINT8 reserved_70[70];  // bytes 4 to 73
} UserAddressUnlockRequestMessage;

// Branch
casetype _ClientMessagePayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x08FC: SignOnRequestInMessage sign_on_request_in_message;
    case 0x0640: SystemInformationInMessage system_information_in_message;
    case 0x0960: GatewayRouterRequestMessage gateway_router_request_message;
    case 0x0910: unit sign_off_request_in_message;
    case 0x1C84: UpdateLocalDatabaseInMessage update_local_database_in_message;
    case 0x1B58: DownloadRequestMessage download_request_message;
    case 0x07D0: OrderEntryRequestMessage order_entry_request_message;
    case 0x07F8: OrderModificationRequestMessage order_modification_request_message;
    case 0x0816: OrderCancellationRequestMessage order_cancellation_request_message;
    case 0x080E: KillSwitchRequestMessage kill_switch_request_message;
    case 0x07DD: PriceModificationMessage price_modification_message;
    case 0x4FB6: PriceModificationMessage price_modification_message_2;
    case 0x1545: TradeInquiryMessage trade_inquiry_message;
    case 0x1540: TradeInquiryMessage trade_inquiry_message_2;
    case 0x1541: TradeInquiryMessage trade_inquiry_message_3;
    case 0x08AF: TradeInquiryMessage trade_inquiry_message_4;
    case 0x0834: SpreadOrderEntryMessage spread_order_entry_message;
    case 0x0836: SpreadOrderEntryMessage spread_order_entry_message_2;
    case 0x0838: SpreadOrderEntryMessage spread_order_entry_message_3;
    case 0x083A: SpreadOrderEntryMessage spread_order_entry_message_4;
    case 0x0846: SpreadOrderEntryMessage spread_order_entry_message_5;
    case 0x084C: SpreadOrderEntryMessage spread_order_entry_message_6;
    case 0x084D: SpreadOrderEntryMessage spread_order_entry_message_7;
    case 0x084E: SpreadOrderEntryMessage spread_order_entry_message_8;
    case 0x084F: SpreadOrderEntryMessage spread_order_entry_message_9;
    case 0x0852: SpreadOrderEntryMessage spread_order_entry_message_10;
    case 0x0853: SpreadOrderEntryMessage spread_order_entry_message_11;
    case 0x0854: SpreadOrderEntryMessage spread_order_entry_message_12;
    case 0x0855: SpreadOrderEntryMessage spread_order_entry_message_13;
    case 0x0858: SpreadOrderEntryMessage spread_order_entry_message_14;
    case 0x086A: SpreadOrderEntryMessage spread_order_entry_message_15;
    case 0x086B: SpreadOrderEntryMessage spread_order_entry_message_16;
    case 0x086C: SpreadOrderEntryMessage spread_order_entry_message_17;
    case 0x232C: SpreadOrderEntryMessage spread_order_entry_message_18;
    case 0x4FB8: SpreadOrderEntryMessage spread_order_entry_message_19;
    case 0x4FBA: SpreadOrderEntryMessage spread_order_entry_message_20;
    case 0x4FBC: SpreadOrderEntryMessage spread_order_entry_message_21;
    case 0x4FBE: SpreadOrderEntryMessage spread_order_entry_message_22;
    case 0x4FC0: SpreadOrderEntryMessage spread_order_entry_message_23;
    case 0x59E0: SecureBoxRegistrationRequestInMessage secure_box_registration_request_in_message;
    case 0x59D8: BoxSignOnRequestInMessage box_sign_on_request_in_message;
    case 0x5BD2: unit heartbeat_message;
    case 0x4F62: BoxSignOffMessage box_sign_off_message;
    case 0x1654: BranchOrderValueLimitUpdateMessage branch_order_value_limit_update_message;
    case 0x1662: UserOrderValueLimitUpdateMessage user_order_value_limit_update_message;
    case 0x1664: NormalOrderLimitUpdateMessage normal_order_limit_update_message;
    case 0x166C: ResetUserPasswordMessage reset_user_password_message;
    case 0x1670: CollateralUserStatusChangeRequestMessage collateral_user_status_change_request_message;
    case 0x166A: UserTradeModifyCancelStatusChangeRequestMessage user_trade_modify_cancel_status_change_request_message;
    case 0x1533: UserAddressUnlockRequestMessage user_address_unlock_request_message;
    default: UINT8 unknown[available];
  }
} ClientMessagePayload;

// One framed interactive message sent by the firm
typedef struct _ClientDirectPacket {
  UINT16BE packet_length { packet_length >= 62 };                                                                                                                   // bytes 0 to 1
  UINT32BE packet_sequence_number;                                                                                                                                  // bytes 2 to 5
  UINT8 checksum[16];                                                                                                                                               // bytes 6 to 21
  UINT16BE transaction_code;                                                                                                                                        // bytes 22 to 23, signed, read here as unsigned
  UINT32BE log_time;                                                                                                                                                // bytes 24 to 27, signed, read here as unsigned
  UINT8 alpha_char[2];                                                                                                                                              // bytes 28 to 29
  UINT32BE trader_id;                                                                                                                                               // bytes 30 to 33, signed, read here as unsigned
  UINT16BE error_code;                                                                                                                                              // bytes 34 to 35, signed, read here as unsigned
  UINT64BE header_timestamp;                                                                                                                                        // bytes 36 to 43, signed, read here as unsigned
  UINT8 time_stamp_1[8];                                                                                                                                            // bytes 44 to 51
  UINT8 time_stamp_2[8];                                                                                                                                            // bytes 52 to 59
  UINT16BE message_length;                                                                                                                                          // bytes 60 to 61, signed, read here as unsigned
  ClientMessagePayload(transaction_code, (((UINT32) packet_length) - 62)) client_message_payload[:byte-size-single-element-array (((UINT32) packet_length) - 62)];
} ClientDirectPacket;

// ---- Packet: ClientPacket ----------------------------------------------------

// Nnf direct interface Tcp block of one or more packets sent by the firm
entrypoint typedef struct _ClientPacket (UINT32 available) {
  ClientDirectPacket client_direct_packet[:byte-size available];
} ClientPacket;

