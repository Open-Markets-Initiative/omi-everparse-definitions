// Market Status Normal: 2 byte code
#define MARKET_STATUS_NORMAL_PRE_OPEN 0x0000        // Pre Open
#define MARKET_STATUS_NORMAL_OPEN 0x0001            // Open
#define MARKET_STATUS_NORMAL_CLOSED 0x0002          // Closed
#define MARKET_STATUS_NORMAL_PRE_OPEN_ENDED 0x0003  // Pre Open Ended
#define MARKET_STATUS_NORMAL_POSTCLOSE 0x0004       // Postclose

// Market Status Oddlot: 2 byte code
#define MARKET_STATUS_ODDLOT_PRE_OPEN 0x0000        // Pre Open
#define MARKET_STATUS_ODDLOT_OPEN 0x0001            // Open
#define MARKET_STATUS_ODDLOT_CLOSED 0x0002          // Closed
