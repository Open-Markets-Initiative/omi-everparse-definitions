// RESPONSE_MESSAGE_HEADER, present once per packet however many messages are packed behind it
typedef struct _ResponseMessageHeader {
  UINT8 environment_type;       // byte 0
  UINT8 compression_indicator;  // byte 1
} ResponseMessageHeader;

// IP_DETAILS_PARTITION_WISE
typedef struct _IpDetailsPartitionWise {
  UINT8 ip_address[16];   // bytes 0 to 15
  UINT32BE port;          // bytes 16 to 19, signed, read here as unsigned
  UINT8 partition_id[6];  // bytes 20 to 25
} IpDetailsPartitionWise;

// Returns the addresses of every partition the member must connect to, together with the session key and the cryptographic material for those connections
typedef struct _GrResponseMessage {
  UINT16BE message_indicator;                        // bytes 0 to 1, signed, read here as unsigned
  UINT16BE partition_count;                          // bytes 2 to 3, signed, read here as unsigned
  IpDetailsPartitionWise ip_details_partition_wise;  // bytes 4 to 29
  UINT8 session_key[8];                              // bytes 30 to 37
  UINT8 cryptographic_key[32];                       // bytes 38 to 69
  UINT8 static_cryptographic_iv[8];                  // bytes 70 to 77
  UINT64BE dynamic_cryptographic_iv;                 // bytes 78 to 85, signed, read here as unsigned
  UINT8 cryptographic_additional_key[12];            // bytes 86 to 97
} GrResponseMessage;

// Confirms the logon, or terminates the connection when Error Code is set
typedef struct _DcSignonOutMessage {
  UINT32BE user_id;              // bytes 0 to 3, signed, read here as unsigned
  UINT8 partition_id[6];         // bytes 4 to 9
  UINT16BE concurrent_login_id;  // bytes 10 to 11, signed, read here as unsigned
} DcSignonOutMessage;

// Signs the user off the partition
typedef struct _DcSignOffMessage {
  UINT32BE user_id;              // bytes 0 to 3, signed, read here as unsigned
  UINT8 partition_id[6];         // bytes 4 to 9
  UINT16BE concurrent_login_id;  // bytes 10 to 11, signed, read here as unsigned
} DcSignOffMessage;

// Rejects a trade only request, the reason given in the Error Code of the Message Header
typedef struct _DcErrorResponseTradeMessage {
  UINT8 error_message[128];  // bytes 0 to 127
} DcErrorResponseTradeMessage;

// Rejects an order and trade request, the reason given in the Error Code of the Message Header
typedef struct _DcErrorResponseOrderMessage {
  UINT8 error_message[128];  // bytes 0 to 127
} DcErrorResponseOrderMessage;

// Confirms a trade
typedef struct _TradeConfirmationMessage {
  UINT8 order_number[8];                // bytes 0 to 7
  UINT32BE trader_number;               // bytes 8 to 11, signed, read here as unsigned
  UINT16BE buy_sell;                    // bytes 12 to 13, signed, read here as unsigned
  UINT32BE original_volume;             // bytes 14 to 17, signed, read here as unsigned
  UINT32BE disclosed_volume;            // bytes 18 to 21, signed, read here as unsigned
  UINT32BE remaining_volume;            // bytes 22 to 25, signed, read here as unsigned
  UINT32BE disclosed_vol_remaining;     // bytes 26 to 29, signed, read here as unsigned
  UINT32BE price;                       // bytes 30 to 33, signed, read here as unsigned
  UINT16BE mf : 1;                      // bytes 34 to 35
  UINT16BE aon : 1;                     // bytes 34 to 35
  UINT16BE ioc : 1;                     // bytes 34 to 35
  UINT16BE gtc : 1;                     // bytes 34 to 35
  UINT16BE day : 1;                     // bytes 34 to 35
  UINT16BE on_stop : 1;                 // bytes 34 to 35
  UINT16BE mkt : 1;                     // bytes 34 to 35
  UINT16BE ato : 1;                     // bytes 34 to 35
  UINT16BE order_flags_reserved_7 : 1;  // bytes 34 to 35
  UINT16BE stpc : 1;                    // bytes 34 to 35
  UINT16BE boc : 1;                     // bytes 34 to 35
  UINT16BE preopen : 1;                 // bytes 34 to 35
  UINT16BE frozen : 1;                  // bytes 34 to 35
  UINT16BE modified : 1;                // bytes 34 to 35
  UINT16BE traded : 1;                  // bytes 34 to 35
  UINT16BE matched_ind : 1;             // bytes 34 to 35
  UINT32BE fill_number;                 // bytes 36 to 39, signed, read here as unsigned
  UINT32BE fill_qty;                    // bytes 40 to 43, signed, read here as unsigned
  UINT32BE fill_price;                  // bytes 44 to 47, signed, read here as unsigned
  UINT32BE token;                       // bytes 48 to 51, signed, read here as unsigned
  UINT16BE book_type;                   // bytes 52 to 53, signed, read here as unsigned
  UINT16BE pro_client;                  // bytes 54 to 55, signed, read here as unsigned
  UINT32BE algo_id;                     // bytes 56 to 59, signed, read here as unsigned
  UINT64BE activity_time_in_nanos;      // bytes 60 to 67, signed, read here as unsigned
  UINT8 nnf_field[8];                   // bytes 68 to 75
  UINT16BE segment;                     // bytes 76 to 77, signed, read here as unsigned
  UINT8 broker_id[5];                   // bytes 78 to 82
  UINT8 filler;                         // byte 83
  UINT8 pan[10];                        // bytes 84 to 93
  UINT8 account_number[10];             // bytes 94 to 103
  UINT8 settlor[12];                    // bytes 104 to 115
  UINT8 giveup_flag;                    // byte 116
  UINT8 open_close;                     // byte 117
  UINT8 participant[12];                // bytes 118 to 129
  UINT16BE reason_code;                 // bytes 130 to 131, signed, read here as unsigned
} TradeConfirmationMessage;

