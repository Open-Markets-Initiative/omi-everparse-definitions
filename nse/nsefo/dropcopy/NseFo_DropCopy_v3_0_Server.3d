#define TRANSACTION_CODE_TRADE_MODIFY_CONFIRM_MESSAGE 0x08EF                  // Trade Modify Confirm Message
#define TRANSACTION_CODE_TRADE_MODIFY_REJECTED_MESSAGE 0x08F0                 // Trade Modify Rejected Message
#define TRANSACTION_CODE_GIVEUP_APP_CONFIRM_MESSAGE 0x119A                    // Giveup App Confirm Message
#define TRANSACTION_CODE_GIVEUP_REJ_CONFIRM_MESSAGE 0x119B                    // Giveup Rej Confirm Message
