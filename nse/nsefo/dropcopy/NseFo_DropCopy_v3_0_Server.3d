// Branch
casetype _ServerMessagePayload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0961: GrResponseMessage gr_response_message;
    case 0x59E1: unit gr_secure_user_registration_response_message;
    case 0x09C5: DcSignonOutMessage dc_signon_out_message;
    case 0x0910: DcSignOffMessage dc_sign_off_message;
    case 0x1F46: DcErrorResponseTradeMessage dc_error_response_trade_message;
    case 0x232E: DcErrorResponseOrderMessage dc_error_response_order_message;
    case 0x08AE: TradeConfirmationMessage trade_confirmation_message;
    case 0x08EA: TradeCancelConfirmMessage trade_cancel_confirm_message;
    case 0x08EE: TradeCancelRejectMessage trade_cancel_reject_message;
    case 0x08EF: TradeModifyConfirmMessage trade_modify_confirm_message;
    case 0x08F0: TradeModifyRejectedMessage trade_modify_rejected_message;
    case 0x119A: GiveupAppConfirmMessage giveup_app_confirm_message;
    case 0x119B: GiveupRejConfirmMessage giveup_rej_confirm_message;
    case 0x07DC: PriceConfirmationMessage price_confirmation_message;
    case 0x07FA: OrderModRejectMessage order_mod_reject_message;
    case 0x0818: OrderCancelRejectMessage order_cancel_reject_message;
    case 0x0819: OrderConfirmationMessage order_confirmation_message;
    case 0x081A: OrderModConfirmationMessage order_mod_confirmation_message;
    case 0x081B: OrderCancelConfirmationMessage order_cancel_confirmation_message;
    case 0x087A: FreezeToControlMessage freeze_to_control_message;
    case 0x08A4: OnStopNotificationMessage on_stop_notification_message;
    case 0x08B7: OrderErrorMessage order_error_message;
    case 0x232A: BatchOrderCancelMessage batch_order_cancel_message;
    case 0x084C: SpOrderConfirmationMessage sp_order_confirmation_message;
    case 0x084D: TwolOrderConfirmationMessage twol_order_confirmation_message;
    case 0x084E: ThrlOrderConfirmationMessage thrl_order_confirmation_message;
    case 0x084F: SpOrderCxlRejectedMessage sp_order_cxl_rejected_message;
    case 0x0852: SpOrderCxlConfirmationMessage sp_order_cxl_confirmation_message;
    case 0x0853: TwolOrderCxlConfirmationMessage twol_order_cxl_confirmation_message;
    case 0x0854: ThrlOrderCxlConfirmationMessage thrl_order_cxl_confirmation_message;
    case 0x0855: SpOrderModRejectMessage sp_order_mod_reject_message;
    case 0x0858: SpOrderModConfirmationMessage sp_order_mod_confirmation_message;
    case 0x086A: SpOrderRejectedMessage sp_order_rejected_message;
    case 0x086B: TwolOrderErrorMessage twol_order_error_message;
    case 0x086C: ThrlOrderErrorMessage thrl_order_error_message;
    case 0x232C: BatchSpreadCxlOutMessage batch_spread_cxl_out_message;
    default: UINT8 unknown[available];
  }
} ServerMessagePayload;

// One packed drop copy message sent by the host
typedef struct _ServerMessage {
  UINT16BE transaction_code;                                                                                                                                          // bytes 0 to 1, signed, read here as unsigned
  UINT16BE error_code;                                                                                                                                                // bytes 2 to 3, signed, read here as unsigned
  UINT64BE sequence_number;                                                                                                                                           // bytes 4 to 11, signed, read here as unsigned
  UINT16BE message_length { message_length >= 14 };                                                                                                                   // bytes 12 to 13, signed, read here as unsigned
  ServerMessagePayload(transaction_code, (((UINT32) message_length) - 14)) server_message_payload[:byte-size-single-element-array (((UINT32) message_length) - 14)];
} ServerMessage;

// Messages packed in Fifo order, inflated first when Compression Indicator says they arrive compressed
typedef struct _MessageBuffer (UINT32 available) {
  ServerMessage server_message[:byte-size available];
} MessageBuffer;

// One drop copy packet sent by the host, carrying a packed buffer of messages
typedef struct _ServerDropCopyPacket {
  UINT16BE packet_length { packet_length >= 24 };                                                                                  // bytes 0 to 1
  UINT32BE packet_sequence_number;                                                                                                 // bytes 2 to 5
  UINT8 checksum[16];                                                                                                              // bytes 6 to 21
  ResponseMessageHeader response_message_header;                                                                                   // bytes 22 to 23
  MessageBuffer((((UINT32) packet_length) - 24)) message_buffer[:byte-size-single-element-array (((UINT32) packet_length) - 24)];
} ServerDropCopyPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// Drop copy Tcp block of one or more packets sent by the host
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerDropCopyPacket server_drop_copy_packet[:byte-size available];
} ServerPacket;

