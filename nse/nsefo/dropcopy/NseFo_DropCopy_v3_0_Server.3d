  UINT16BE aon : 1;                     // bytes 42 to 43
  UINT16BE ioc : 1;                     // bytes 42 to 43
  UINT16BE gtc : 1;                     // bytes 42 to 43
  UINT16BE day : 1;                     // bytes 42 to 43
  UINT16BE on_stop : 1;                 // bytes 42 to 43
  UINT16BE mkt : 1;                     // bytes 42 to 43
  UINT16BE ato : 1;                     // bytes 42 to 43
