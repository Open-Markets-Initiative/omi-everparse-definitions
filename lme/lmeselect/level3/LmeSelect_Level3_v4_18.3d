// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out LmeSelect_Level3_v4_18.3d

// ---- Values ------------------------------------------------------------------

// Msg Type: 2 byte code
#define MSG_TYPE_SEQUENCE_RESET_MESSAGE 0x0064            // Sequence Reset Message
#define MSG_TYPE_MARKET_STATE_CONTRACT_MESSAGE 0x0137     // Market State Contract Message
#define MSG_TYPE_MARKET_STATE_INSTRUMENT_MESSAGE 0x0138   // Market State Instrument Message
#define MSG_TYPE_INDICATIVE_OPENING_PRICE_MESSAGE 0x0140  // Indicative Opening Price Message
#define MSG_TYPE_QUOTE_REQUEST_MESSAGE 0x0149             // Quote Request Message
#define MSG_TYPE_ORDER_BOOK_CLEAR_MESSAGE 0x0147          // Order Book Clear Message
#define MSG_TYPE_CROSS_REQUEST_MESSAGE 0x014A             // Cross Request Message
#define MSG_TYPE_ORDER_ADD_MESSAGE 0x0143                 // Order Add Message
#define MSG_TYPE_ORDER_AMEND_MESSAGE 0x0144               // Order Amend Message
#define MSG_TYPE_ORDER_CANCEL_MESSAGE 0x0145              // Order Cancel Message
#define MSG_TYPE_ORDER_EXECUTED_MESSAGE 0x0146            // Order Executed Message

// Trading State: one byte code
#define TRADING_STATE_PRE_OPEN 0x01        // Pre Open
#define TRADING_STATE_OPEN 0x02            // Open
#define TRADING_STATE_POST_TRADE 0x03      // Post Trade
#define TRADING_STATE_CLOSE 0x04           // Close
#define TRADING_STATE_TECHNICAL_HALT 0x06  // Technical Halt

// Trading State Condition: one byte code
#define TRADING_STATE_CONDITION_PAUSE 0x50   // Pause
#define TRADING_STATE_CONDITION_HALT 0x48    // Halt
#define TRADING_STATE_CONDITION_ACTIVE 0x20  // Active

// Timetable Control Type: one byte code
#define TIMETABLE_CONTROL_TYPE_AUTOMATIC_THE_DEFAULT_TRADING_SCHEDULE 0x41  // Automatic The Default Trading Schedule
#define TIMETABLE_CONTROL_TYPE_MANUAL_A_TEMPORARY_TRADING_SCHEDULE 0x4D     // Manual A Temporary Trading Schedule

// Quote Request Type: one byte code
#define QUOTE_REQUEST_TYPE_MANUAL_A_SINGLE_QUOTE_REQUEST 0x01   // Manual A Single Quote Request
#define QUOTE_REQUEST_TYPE_AUTO_A_STREAMING_QUOTE_REQUEST 0x02  // Auto A Streaming Quote Request

// Buy Sell: one byte code
#define BUY_SELL_BUY 0x42              // Buy
#define BUY_SELL_SELL 0x53             // Sell
#define BUY_SELL_TWO_SIDED_QUOTE 0x20  // Two Sided Quote

// Trade Cancel Flag: one byte code
#define TRADE_CANCEL_FLAG_FALSE 0x00  // False
#define TRADE_CANCEL_FLAG_TRUE 0x01   // True

// Sub Type Of Trade: one byte code
#define SUB_TYPE_OF_TRADE_THE_TRADE_RESULTED_FROM_AN_EXPLICIT_ORDER 0x01            // The Trade Resulted From An Explicit Order
#define SUB_TYPE_OF_TRADE_THE_TRADE_RESULTED_FROM_UNCROSSING 0x02                   // The Trade Resulted From Uncrossing
#define SUB_TYPE_OF_TRADE_THE_TRADE_RESULTED_FROM_AN_IMPLIED_ORDER 0x07             // The Trade Resulted From An Implied Order
#define SUB_TYPE_OF_TRADE_THE_TRADE_RESULTED_FROM_TWO_IMPLIED_ORDERS_MATCHING 0x08  // The Trade Resulted From Two Implied Orders Matching
#define SUB_TYPE_OF_TRADE_THE_TRADE_RESULTED_FROM_AN_OFF_BOOK_CROSS_TRADE 0x09      // The Trade Resulted From An Off Book Cross Trade

// Trade Buy Sell: one byte code
#define TRADE_BUY_SELL_BUY 0x42   // Buy
#define TRADE_BUY_SELL_SELL 0x53  // Sell

// Leg Buy Sell: one byte code
#define LEG_BUY_SELL_BUY 0x42   // Buy
#define LEG_BUY_SELL_SELL 0x53  // Sell

// ---- Types -------------------------------------------------------------------

// Sent on each multicast channel at start of day, and intraday in case of a disaster recovery. The client must ignore the sequence number of the Sequence Reset message itself and set the next expected sequence number to NewSeqNo, clear all cached data for all instruments and subscribe to the refresh channels to receive the current state of the market.
typedef struct _SequenceResetMessage {
  UINT32 new_seq_no;  // bytes 0 to 3
} SequenceResetMessage;

// Indicates the trading state of instruments at the contract level, for example Copper Futures or Aluminium Options. The ContractCode field is common across the Market State - Contract, Outright Definition and Strategy Definition messages and links the contract state to individual tradable instruments.
typedef struct _MarketStateContractMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT8 contract_code[12];        // bytes 10 to 21
  UINT8 trading_state;            // byte 22
  UINT64 start_time;              // bytes 23 to 30
  UINT64 end_time;                // bytes 31 to 38
  UINT8 trading_state_condition;  // byte 39
  UINT8 filler_string_2[2];       // bytes 40 to 41
} MarketStateContractMessage;

// Indicates the trading state of an individual tradable instrument. Sent when the instrument state differs from that at contract level, for example when TOM goes into Post Trade before the contract.
typedef struct _MarketStateInstrumentMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT64 tradable_instrument_id;  // bytes 10 to 17
  UINT8 timetable_control_type;   // byte 18
  UINT8 trading_state;            // byte 19
  UINT64 start_time;              // bytes 20 to 27
  UINT64 end_time;                // bytes 28 to 35
  UINT8 trading_state_condition;  // byte 36
  UINT8 filler_string_3[3];       // bytes 37 to 39
} MarketStateInstrumentMessage;

// Carries the price at which a tradable instrument would open, computed by the uncrossing algorithm during Pre-Open. If there are no crossed prices no IOP is calculated or disseminated; where the book is not crossed but has both a bid and an offer, a mid price is calculated and published instead. At the transition from Pre-Open to Open an IOP message is published for every tradable instrument with both prices null and the volume zero, to indicate the prices are no longer valid.
typedef struct _IndicativeOpeningPriceMessage {
  UINT8 trading_venue[2];               // bytes 0 to 1
  UINT64 time_of_event;                 // bytes 2 to 9
  UINT64 tradable_instrument_id;        // bytes 10 to 17
  UINT64 indicative_opening_price;      // bytes 18 to 25, signed, read here as unsigned
  UINT32 indicative_opening_volume;     // bytes 26 to 29
  UINT64 indicative_opening_mid_price;  // bytes 30 to 37, signed, read here as unsigned
  UINT8 filler_string_2[2];             // bytes 38 to 39
} IndicativeOpeningPriceMessage;

// Generated when a request for quote is accepted by the Matching Engine.
typedef struct _QuoteRequestMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT64 tradable_instrument_id;  // bytes 10 to 17
  UINT8 quote_request_type;       // byte 18
  UINT8 buy_sell;                 // byte 19
  UINT32 volume;                  // bytes 20 to 23
  UINT8 filler_string_2[2];       // bytes 24 to 25
} QuoteRequestMessage;

// Generated when the order book is required to be cleared, for example after the transition between certain market states, or when an instrument's Trading State Condition is Trade Halt. Following an Order Book Clear, if an instrument is subsequently open for trading any resting orders are sent as Top Of Book, Aggregate Order Book or Order Add messages to allow clients to rebuild the order book. It is not published when an instrument enters or leaves Trade Pause.
typedef struct _OrderBookClearMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT64 tradable_instrument_id;  // bytes 10 to 17
} OrderBookClearMessage;

// Generated when a cross request is created on LMEselect.
typedef struct _CrossRequestMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT64 tradable_instrument_id;  // bytes 10 to 17
  UINT64 cross_id;                // bytes 18 to 25
  UINT32 volume;                  // bytes 26 to 29
  UINT64 expire_time;             // bytes 30 to 37
  UINT8 filler_string_2[2];       // bytes 38 to 39
} CrossRequestMessage;

// Generated when an order is placed in the order book. An incoming, aggressing order that matches against one or more resting orders is not published as an Order Add unless it has residual volume after matching. For orders submitted during Pre-Open and reloaded GTC and GTD orders the TimeOfEvent reflects the uncrossing event time at market open.
typedef struct _OrderAddMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT64 t_1;                     // bytes 10 to 17
  UINT64 t_2;                     // bytes 18 to 25
  UINT64 t_3;                     // bytes 26 to 33
  UINT64 tradable_instrument_id;  // bytes 34 to 41
  UINT64 order_id;                // bytes 42 to 49
  UINT8 buy_sell;                 // byte 50
  UINT32 volume;                  // bytes 51 to 54
  UINT64 price;                   // bytes 55 to 62, signed, read here as unsigned
  UINT32 order_book_position;     // bytes 63 to 66
  UINT8 filler_string_1;          // byte 67
} OrderAddMessage;

// Generated when an order amendment updates the volume downward or the position in the order book.
typedef struct _OrderAmendMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT64 t_1;                     // bytes 10 to 17
  UINT64 t_2;                     // bytes 18 to 25
  UINT64 t_3;                     // bytes 26 to 33
  UINT64 tradable_instrument_id;  // bytes 34 to 41
  UINT64 order_id;                // bytes 42 to 49
  UINT8 buy_sell;                 // byte 50
  UINT32 volume;                  // bytes 51 to 54
  UINT64 price;                   // bytes 55 to 62, signed, read here as unsigned
  UINT32 order_book_position;     // bytes 63 to 66
  UINT8 filler_string_1;          // byte 67
} OrderAmendMessage;

// Generated when an order is cancelled from the order book.
typedef struct _OrderCancelMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT64 t_1;                     // bytes 10 to 17
  UINT64 t_2;                     // bytes 18 to 25
  UINT64 t_3;                     // bytes 26 to 33
  UINT64 tradable_instrument_id;  // bytes 34 to 41
  UINT64 order_id;                // bytes 42 to 49
  UINT8 buy_sell;                 // byte 50
  UINT8 filler_string_1;          // byte 51
} OrderCancelMessage;

// One leg of an executed strategy trade
typedef struct _ExecutedLegs {
  UINT64 leg_tradable_instrument_id;  // bytes 0 to 7
  UINT8 leg_buy_sell;                 // byte 8
  UINT64 leg_price;                   // bytes 9 to 16, signed, read here as unsigned
  UINT32 leg_volume;                  // bytes 17 to 20
  UINT64 leg_match_id;                // bytes 21 to 28
} ExecutedLegs;

// Generated when an order is executed. Not published for an aggressing order unless it matches with a resting implied order; publishing for a resting implied order occurs only when two implied orders are matched. If an electronic cross order is matched against itself off book, the message is published with a SubTypeOfTrade of nine.
typedef struct _OrderExecutedMessage {
  UINT8 trading_venue[2];                                            // bytes 0 to 1
  UINT64 time_of_event;                                              // bytes 2 to 9
  UINT64 tradable_instrument_id;                                     // bytes 10 to 17
  UINT64 price;                                                      // bytes 18 to 25, signed, read here as unsigned
  UINT32 volume;                                                     // bytes 26 to 29
  UINT64 order_id;                                                   // bytes 30 to 37
  UINT64 match_id;                                                   // bytes 38 to 45
  UINT8 trade_cancel_flag;                                           // byte 46
  UINT8 sub_type_of_trade;                                           // byte 47
  UINT8 trade_buy_sell;                                              // byte 48
  UINT32 strategy_leg_count { strategy_leg_count <= 148102320 };     // bytes 49 to 52
  ExecutedLegs executed_legs[:byte-size (strategy_leg_count * 29)];
} OrderExecutedMessage;

// Branch
casetype _Payload (UINT16 selector, UINT32 available) {
  switch (selector) {
    case 0x0064: SequenceResetMessage sequence_reset_message;
    case 0x0137: MarketStateContractMessage market_state_contract_message;
    case 0x0138: MarketStateInstrumentMessage market_state_instrument_message;
    case 0x0140: IndicativeOpeningPriceMessage indicative_opening_price_message;
    case 0x0149: QuoteRequestMessage quote_request_message;
    case 0x0147: OrderBookClearMessage order_book_clear_message;
    case 0x014A: CrossRequestMessage cross_request_message;
    case 0x0143: OrderAddMessage order_add_message;
    case 0x0144: OrderAmendMessage order_amend_message;
    case 0x0145: OrderCancelMessage order_cancel_message;
    case 0x0146: OrderExecutedMessage order_executed_message;
    default: UINT8 unknown[available];
  }
} Payload;

// LMEsource application messages carried by this packet; a message is never fragmented across packets
typedef struct _Message (mutable UINT32 * tally) {
  UINT16 msg_size { msg_size >= 4 };                                                                                                                               // bytes 0 to 1
  UINT16 msg_type;                                                                                                                                                 // bytes 2 to 3
  Payload(msg_type, (((UINT32) msg_size) - 4)) payload[:byte-size-single-element-array (((UINT32) msg_size) - 4)];
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// ---- Packet: Packet ----------------------------------------------------------

// LMEsource multicast packet, a packet header followed by Msg Count complete messages
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 16) {
  UINT16 pkt_size;                                                                                                      // bytes 0 to 1
  UINT8 msg_count;                                                                                                      // byte 2
  UINT8 filler;                                                                                                         // byte 3
  UINT32 seq_num;                                                                                                       // bytes 4 to 7
  UINT64 send_time;                                                                                                     // bytes 8 to 15
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 16)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) msg_count); };
} Packet;

