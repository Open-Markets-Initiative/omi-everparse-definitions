// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out LmeSelect_DailySummariesSnapshot_v4_18.3d
//
// What this definition does not state, and the model does:
// - a run counted by a field
// - the packet as a whole, which is a counted run of entries of no fixed width, with more read after it or none read by an entry, counted in 32 bits, more than the 16 everparse extracts in reasonable time, at packet.message.payload.positionbandmessage.longpositionbands

// ---- Values ------------------------------------------------------------------

// Msg Type: 2 byte code
#define MSG_TYPE_SEQUENCE_RESET_MESSAGE 0x0064      // Sequence Reset Message
#define MSG_TYPE_OPEN_INTEREST_MESSAGE 0x01A4       // Open Interest Message
#define MSG_TYPE_OPEN_INTEREST_BAND_MESSAGE 0x01A5  // Open Interest Band Message
#define MSG_TYPE_POSITION_BAND_MESSAGE 0x01A6       // Position Band Message
#define MSG_TYPE_WARRANT_BAND_MESSAGE 0x01A7        // Warrant Band Message
#define MSG_TYPE_TRADING_VOLUME_MESSAGE 0x01A8      // Trading Volume Message
#define MSG_TYPE_REFRESH_COMPLETE_MESSAGE 0x00CB    // Refresh Complete Message

// Open Interest Type: one byte code
#define OPEN_INTEREST_TYPE_EXCHANGE 0x45  // Exchange
#define OPEN_INTEREST_TYPE_MARKET 0x4D    // Market

// Contract Type: one byte code
#define CONTRACT_TYPE_FUTURE 0x46  // Future
#define CONTRACT_TYPE_OPTION 0x4F  // Option

// Calculation Type: one byte code
#define CALCULATION_TYPE_DAILY 0x44     // Daily
#define CALCULATION_TYPE_INTRADAY 0x49  // Intraday

// ---- Packet Header: 16 bytes -------------------------------------------------

// LMEsource packet header, giving the packet size, the number of messages it carries, the sequence number of the first of them and the time the packet was sent
entrypoint typedef struct _PacketHeader {
  UINT16 pkt_size;   // bytes 0 to 1
  UINT8 msg_count;   // byte 2
  UINT8 filler;      // byte 3
  UINT32 seq_num;    // bytes 4 to 7
  UINT64 send_time;  // bytes 8 to 15
} PacketHeader;

// ---- Message Header: 4 bytes -------------------------------------------------

// LMEsource message header, giving the size of the message and its type
entrypoint typedef struct _MessageHeader {
  UINT16 msg_size;  // bytes 0 to 1
  UINT16 msg_type;  // bytes 2 to 3, values MSG_TYPE_
} MessageHeader;

// ---- Sequence Reset Message: 4 bytes -----------------------------------------

// Sent on each multicast channel at start of day, and intraday in case of a disaster recovery. The client must ignore the sequence number of the Sequence Reset message itself and set the next expected sequence number to NewSeqNo, clear all cached data for all instruments and subscribe to the refresh channels to receive the current state of the market.
entrypoint typedef struct _SequenceResetMessage {
  UINT32 new_seq_no;  // bytes 0 to 3
} SequenceResetMessage;

// ---- Open Interest Message: 32 bytes -----------------------------------------

// Reports Exchange and Market Open Interest for open positions in futures and options contracts. Exchange open interest volumes are provided per currency, by contract code, and not aggregated across currencies, whereas market open interest volumes are aggregated across currencies and reported against USD denominated instruments.
entrypoint typedef struct _OpenInterestMessage {
  UINT32 business_date;      // bytes 0 to 3
  UINT8 open_interest_type;  // byte 4, values OPEN_INTEREST_TYPE_
  UINT64 instrument_id;      // bytes 5 to 12
  UINT8 product_code[2];     // bytes 13 to 14
  UINT8 contract_code[12];   // bytes 15 to 26
  UINT8 contract_type;       // byte 27, values CONTRACT_TYPE_
  UINT32 volume;             // bytes 28 to 31
} OpenInterestMessage;

// ---- Trading Volume Message: 36 bytes ----------------------------------------

// Provides the traded volume in lots for matched trades in futures and options instruments. All trades resulting from Cross Order execution, whether off-book or not, are included in the trading volume calculation.
entrypoint typedef struct _TradingVolumeMessage {
  UINT32 business_date;     // bytes 0 to 3
  UINT32 trade_date;        // bytes 4 to 7
  UINT8 calculation_type;   // byte 8, values CALCULATION_TYPE_
  UINT64 instrument_id;     // bytes 9 to 16
  UINT8 product_code[2];    // bytes 17 to 18
  UINT8 contract_code[12];  // bytes 19 to 30
  UINT8 contract_type;      // byte 31, values CONTRACT_TYPE_
  UINT32 volume;            // bytes 32 to 35
} TradingVolumeMessage;

// ---- Refresh Complete Message: 4 bytes ---------------------------------------

// Published to mark the end of a refresh cycle.
entrypoint typedef struct _RefreshCompleteMessage {
  UINT32 last_seq_num;  // bytes 0 to 3
} RefreshCompleteMessage;

