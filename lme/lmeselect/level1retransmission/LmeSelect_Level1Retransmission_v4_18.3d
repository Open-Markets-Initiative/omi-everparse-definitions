// The London Metal Exchange LMEsource Level1 Retransmission
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out LmeSelect_Level1Retransmission_v4_18.3d
//
// What this definition does not state, and the model does:
// - a run counted by a field
//
// License: MIT No Attribution

// ---- Packet Header: 16 bytes -------------------------------------------------

// LMEsource packet header, giving the packet size, the number of messages it carries, the sequence number of the first of them and the time the packet was sent
entrypoint typedef struct _PacketHeader {
  UINT16 pkt_size;   // bytes 0 to 1
  UINT8 msg_count;   // byte 2
  UINT8 filler;      // byte 3
  UINT32 seq_num;    // bytes 4 to 7
  UINT64 send_time;  // bytes 8 to 15
} PacketHeader;

// ---- Message Header: 4 bytes -------------------------------------------------

// LMEsource message header, giving the size of the message and its type
entrypoint typedef struct _MessageHeader {
  UINT16 msg_size;  // bytes 0 to 1
  UINT16 msg_type;  // bytes 2 to 3
} MessageHeader;

// ---- Sequence Reset Message: 4 bytes -----------------------------------------

// Sent on each multicast channel at start of day, and intraday in case of a disaster recovery. The client must ignore the sequence number of the Sequence Reset message itself and set the next expected sequence number to NewSeqNo, clear all cached data for all instruments and subscribe to the refresh channels to receive the current state of the market.
entrypoint typedef struct _SequenceResetMessage {
  UINT32 new_seq_no;  // bytes 0 to 3
} SequenceResetMessage;

// ---- Market State Contract Message: 42 bytes ---------------------------------

// Indicates the trading state of instruments at the contract level, for example Copper Futures or Aluminium Options. The ContractCode field is common across the Market State - Contract, Outright Definition and Strategy Definition messages and links the contract state to individual tradable instruments.
entrypoint typedef struct _MarketStateContractMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT8 contract_code[12];        // bytes 10 to 21
  UINT8 trading_state;            // byte 22
  UINT64 start_time;              // bytes 23 to 30
  UINT64 end_time;                // bytes 31 to 38
  UINT8 trading_state_condition;  // byte 39
  UINT8 filler_string_2[2];       // bytes 40 to 41
} MarketStateContractMessage;

// ---- Market State Instrument Message: 40 bytes -------------------------------

// Indicates the trading state of an individual tradable instrument. Sent when the instrument state differs from that at contract level, for example when TOM goes into Post Trade before the contract.
entrypoint typedef struct _MarketStateInstrumentMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT64 tradable_instrument_id;  // bytes 10 to 17
  UINT8 timetable_control_type;   // byte 18
  UINT8 trading_state;            // byte 19
  UINT64 start_time;              // bytes 20 to 27
  UINT64 end_time;                // bytes 28 to 35
  UINT8 trading_state_condition;  // byte 36
  UINT8 filler_string_3[3];       // bytes 37 to 39
} MarketStateInstrumentMessage;

// ---- Indicative Opening Price Message: 40 bytes ------------------------------

// Carries the price at which a tradable instrument would open, computed by the uncrossing algorithm during Pre-Open. If there are no crossed prices no IOP is calculated or disseminated; where the book is not crossed but has both a bid and an offer, a mid price is calculated and published instead. At the transition from Pre-Open to Open an IOP message is published for every tradable instrument with both prices null and the volume zero, to indicate the prices are no longer valid.
entrypoint typedef struct _IndicativeOpeningPriceMessage {
  UINT8 trading_venue[2];               // bytes 0 to 1
  UINT64 time_of_event;                 // bytes 2 to 9
  UINT64 tradable_instrument_id;        // bytes 10 to 17
  UINT64 indicative_opening_price;      // bytes 18 to 25, signed, read here as unsigned
  UINT32 indicative_opening_volume;     // bytes 26 to 29
  UINT64 indicative_opening_mid_price;  // bytes 30 to 37, signed, read here as unsigned
  UINT8 filler_string_2[2];             // bytes 38 to 39
} IndicativeOpeningPriceMessage;

// ---- Quote Request Message: 26 bytes -----------------------------------------

// Generated when a request for quote is accepted by the Matching Engine.
entrypoint typedef struct _QuoteRequestMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT64 tradable_instrument_id;  // bytes 10 to 17
  UINT8 quote_request_type;       // byte 18
  UINT8 buy_sell;                 // byte 19
  UINT32 volume;                  // bytes 20 to 23
  UINT8 filler_string_2[2];       // bytes 24 to 25
} QuoteRequestMessage;

// ---- Order Book Clear Message: 18 bytes --------------------------------------

// Generated when the order book is required to be cleared, for example after the transition between certain market states, or when an instrument's Trading State Condition is Trade Halt. Following an Order Book Clear, if an instrument is subsequently open for trading any resting orders are sent as Top Of Book, Aggregate Order Book or Order Add messages to allow clients to rebuild the order book. It is not published when an instrument enters or leaves Trade Pause.
entrypoint typedef struct _OrderBookClearMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT64 tradable_instrument_id;  // bytes 10 to 17
} OrderBookClearMessage;

// ---- Cross Request Message: 40 bytes -----------------------------------------

// Generated when a cross request is created on LMEselect.
entrypoint typedef struct _CrossRequestMessage {
  UINT8 trading_venue[2];         // bytes 0 to 1
  UINT64 time_of_event;           // bytes 2 to 9
  UINT64 tradable_instrument_id;  // bytes 10 to 17
  UINT64 cross_id;                // bytes 18 to 25
  UINT32 volume;                  // bytes 26 to 29
  UINT64 expire_time;             // bytes 30 to 37
  UINT8 filler_string_2[2];       // bytes 38 to 39
} CrossRequestMessage;

// ---- Top Of Book Message: 98 bytes -------------------------------------------

// Generated when the top price level has been modified. There are no New, Change or Delete actions for Top Of Book: whenever the price, quantity or number of orders at the top of book changes a new message is sent. When an order book is emptied as a result of market activity, a Top Of Book message is sent with the price fields null and the aggregate quantity and number of orders zero. The TimeOfEvent is the latest incoming event timestamp regardless of the event that caused the update; for orders submitted during Pre-Open and reloaded GTC and GTD orders it reflects the uncrossing event time at market open.
entrypoint typedef struct _TopOfBookMessage {
  UINT8 trading_venue[2];             // bytes 0 to 1
  UINT64 time_of_event;               // bytes 2 to 9
  UINT64 tradable_instrument_id;      // bytes 10 to 17
  UINT64 aggregate_bid_volume;        // bytes 18 to 25
  UINT64 aggregate_ask_volume;        // bytes 26 to 33
  UINT64 bid_price;                   // bytes 34 to 41, signed, read here as unsigned
  UINT64 ask_price;                   // bytes 42 to 49, signed, read here as unsigned
  UINT32 number_bid_explicit_orders;  // bytes 50 to 53
  UINT64 bid_qty_explicit_orders;     // bytes 54 to 61
  UINT32 number_ask_explicit_orders;  // bytes 62 to 65
  UINT64 ask_qty_explicit_orders;     // bytes 66 to 73
  UINT32 number_bid_implied_orders;   // bytes 74 to 77
  UINT64 bid_qty_implied_orders;      // bytes 78 to 85
  UINT32 number_ask_implied_orders;   // bytes 86 to 89
  UINT64 ask_qty_implied_orders;      // bytes 90 to 97
} TopOfBookMessage;

// ---- Logon Message: 12 bytes -------------------------------------------------

// Enables client authentication. Not required for multicast channels and only used for retransmission requests. The client sends a Logon containing a username, to which LMEsource responds with a Logon Response.
entrypoint typedef struct _LogonMessage {
  UINT8 username[12];  // bytes 0 to 11
} LogonMessage;

// ---- Logon Response Message: 4 bytes -----------------------------------------

// Response to a Logon, carrying the status of the session.
entrypoint typedef struct _LogonResponseMessage {
  UINT8 session_status;      // byte 0
  UINT8 filler_string_3[3];  // bytes 1 to 3
} LogonResponseMessage;

// ---- Retransmission Request Message: 12 bytes --------------------------------

// Requests the retransmission of a range of messages on a multicast channel.
entrypoint typedef struct _RetransmissionRequestMessage {
  UINT16 channel_id;         // bytes 0 to 1
  UINT8 filler_string_2[2];  // bytes 2 to 3
  UINT32 begin_seq_num;      // bytes 4 to 7
  UINT32 end_seq_num;        // bytes 8 to 11
} RetransmissionRequestMessage;

// ---- Retransmission Response Message: 12 bytes -------------------------------

// Response to a Retransmission Request, carrying the status of the request and the sequence range being resent.
entrypoint typedef struct _RetransmissionResponseMessage {
  UINT16 channel_id;      // bytes 0 to 1
  UINT8 retrans_status;   // byte 2
  UINT8 filler_string_1;  // byte 3
  UINT32 begin_seq_num;   // bytes 4 to 7
  UINT32 end_seq_num;     // bytes 8 to 11
} RetransmissionResponseMessage;

