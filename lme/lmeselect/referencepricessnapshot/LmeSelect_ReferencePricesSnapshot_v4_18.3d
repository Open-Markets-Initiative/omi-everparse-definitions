// The London Metal Exchange LMEsource ReferencePrices Refresh
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out LmeSelect_ReferencePricesSnapshot_v4_18.3d
//
// What this definition does not state, and the model does:
// - a run counted by a field
//
// License: MIT No Attribution

// ---- Packet Header: 16 bytes -------------------------------------------------

// LMEsource packet header, giving the packet size, the number of messages it carries, the sequence number of the first of them and the time the packet was sent
entrypoint typedef struct _PacketHeader {
  UINT16 pkt_size;   // bytes 0 to 1
  UINT8 msg_count;   // byte 2
  UINT8 filler;      // byte 3
  UINT32 seq_num;    // bytes 4 to 7
  UINT64 send_time;  // bytes 8 to 15
} PacketHeader;

// ---- Message Header: 4 bytes -------------------------------------------------

// LMEsource message header, giving the size of the message and its type
entrypoint typedef struct _MessageHeader {
  UINT16 msg_size;  // bytes 0 to 1
  UINT16 msg_type;  // bytes 2 to 3
} MessageHeader;

// ---- Sequence Reset Message: 4 bytes -----------------------------------------

// Sent on each multicast channel at start of day, and intraday in case of a disaster recovery. The client must ignore the sequence number of the Sequence Reset message itself and set the next expected sequence number to NewSeqNo, clear all cached data for all instruments and subscribe to the refresh channels to receive the current state of the market.
entrypoint typedef struct _SequenceResetMessage {
  UINT32 new_seq_no;  // bytes 0 to 3
} SequenceResetMessage;

// ---- Reference Price Message: 94 bytes ---------------------------------------

// Reference prices are published for instruments with an InstrumentID for the Official, Settlement, Closing and Index price types. Instruments are published in the Instrument Definition message.
entrypoint typedef struct _ReferencePriceMessage {
  UINT64 time_of_event;            // bytes 0 to 7
  UINT8 reference_price_category;  // byte 8
  UINT8 reference_price_type[32];  // bytes 9 to 40
  UINT8 price_status[12];          // bytes 41 to 52
  UINT32 business_date;            // bytes 53 to 56
  UINT64 instrument_id;            // bytes 57 to 64
  UINT8 product_code[2];           // bytes 65 to 66
  UINT8 currency_code[3];          // bytes 67 to 69
  UINT64 bid;                      // bytes 70 to 77, signed, read here as unsigned
  UINT64 price;                    // bytes 78 to 85, signed, read here as unsigned
  UINT64 ask;                      // bytes 86 to 93, signed, read here as unsigned
} ReferencePriceMessage;

// ---- Reference Fx Rate Message: 25 bytes -------------------------------------

// Exchange FX rates are published for the Cash prompt. Daily and Monthly Moving Average Exchange FX rates are published each day, with the Monthly Average Exchange FX rate published on the last business day of the month. MonthlyMovingAverage and MonthlyAverage are published only for the Exchange category.
entrypoint typedef struct _ReferenceFxRateMessage {
  UINT8 fx_rate_category;         // byte 0
  UINT8 fx_rate_type[2];          // bytes 1 to 2
  UINT32 business_date;           // bytes 3 to 6
  UINT32 maturity_date;           // bytes 7 to 10
  UINT8 base_currency_code[3];    // bytes 11 to 13
  UINT8 target_currency_code[3];  // bytes 14 to 16
  UINT64 conversion_rate;         // bytes 17 to 24, signed, read here as unsigned
} ReferenceFxRateMessage;

// ---- Refresh Complete Message: 4 bytes ---------------------------------------

// Published to mark the end of a refresh cycle.
entrypoint typedef struct _RefreshCompleteMessage {
  UINT32 last_seq_num;  // bytes 0 to 3
} RefreshCompleteMessage;

