// The Members Exchange Member Order Information Record Depth
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out MemxOptions_MemoirDepth_v1_3.3d
//
// What this definition does not state, and the model does:
// - the dispatch that chooses a message by its type
// - a run counted by a field
// - a field read in bits
// - a block whose stated length holds more than its fields
//
// License: MIT No Attribution

// ---- Common Header: 18 bytes -------------------------------------------------

// Common Header
entrypoint typedef struct _CommonHeader {
  UINT8 message_type;        // byte 0
  UINT8 header_length;       // byte 1
  UINT64BE session_id;       // bytes 2 to 9
  UINT64BE sequence_number;  // bytes 10 to 17
} CommonHeader;

// ---- Sbe Header: 6 bytes -----------------------------------------------------

// Sbe Header
entrypoint typedef struct _SbeHeader {
  UINT16BE block_length;  // bytes 0 to 1
  UINT8 template_id;      // byte 2
  UINT8 schema_id;        // byte 3
  UINT16BE version;       // bytes 4 to 5
} SbeHeader;

