} CpMarketOrderNetNotionalThresholdChangeReqMessage;

// CPDuplicateOrderThresholdChangeReqMessage
typedef struct _CpDuplicateOrderThresholdChangeReqMessage {
  UINT8 cl_ord_id[20];                          // bytes 0 to 19
  UINT8 underlier_optional[6];                  // bytes 20 to 25
  UINT8 efid_optional[4];                       // bytes 26 to 29
  UINT16BE risk_group_id;                       // bytes 30 to 31
  UINT32BE max_dup_orders;                      // bytes 32 to 35
  UINT8 use_order_price_in_dup_check_optional;  // byte 36
  UINT32BE period_in_milli_seconds;             // bytes 37 to 40
} CpDuplicateOrderThresholdChangeReqMessage;

// CPOrderRateThresholdChangeReqMessage
typedef struct _CpOrderRateThresholdChangeReqMessage {
  UINT8 cl_ord_id[20];               // bytes 0 to 19
  UINT8 underlier_optional[6];       // bytes 20 to 25
  UINT8 efid_optional[4];            // bytes 26 to 29
  UINT16BE risk_group_id;            // bytes 30 to 31
  UINT32BE max_order_msgs;           // bytes 32 to 35
  UINT32BE period_in_milli_seconds;  // bytes 36 to 39
} CpOrderRateThresholdChangeReqMessage;

// Message body sent by the firm to Memx
casetype _ClientPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: RiskSettingsQueryMessage risk_settings_query_message;
    case 0x02: ActiveRiskThresholdChangeReqMessage active_risk_threshold_change_req_message;
    case 0x03: ActiveRiskAcknowledgementReqMessage active_risk_acknowledgement_req_message;
    case 0x04: CpVolumeThresholdChangeReqMessage cp_volume_threshold_change_req_message;
    case 0x05: CpExecutedNotionalThresholdChangeReqMessage cp_executed_notional_threshold_change_req_message;
    case 0x06: CpTotalExecutionsThresholdChangeReqMessage cp_total_executions_threshold_change_req_message;
    case 0x07: CpPercentOutstandingContractsThresholdChangeReqMessage cp_percent_outstanding_contracts_threshold_change_req_message;
    case 0x08: CpBreachCountThresholdChangeReqMessage cp_breach_count_threshold_change_req_message;
    case 0x09: ManualCpBreachTriggerReqMessage manual_cp_breach_trigger_req_message;
    case 0x0A: CpClearBreachReqMessage cp_clear_breach_req_message;
    case 0x0B: SingleOrderAllowIsoOrdersChangeReqMessage single_order_allow_iso_orders_change_req_message;
    case 0x0C: SingleOrderAllowOrdersInCrossedMarketChangeReqMessage single_order_allow_orders_in_crossed_market_change_req_message;
    case 0x0D: SingleOrderMaxNotionalChangeReqMessage single_order_max_notional_change_req_message;
    case 0x0E: SingleOrderMaxContractsChangeReqMessage single_order_max_contracts_change_req_message;
    case 0x12: CpGrossNotionalThresholdChangeReqMessage cp_gross_notional_threshold_change_req_message;
    case 0x13: CpMarketOrderGrossNotionalThresholdChangeReqMessage cp_market_order_gross_notional_threshold_change_req_message;
    case 0x14: CpNetNotionalThresholdChangeReqMessage cp_net_notional_threshold_change_req_message;
    case 0x15: CpMarketOrderNetNotionalThresholdChangeReqMessage cp_market_order_net_notional_threshold_change_req_message;
    case 0x16: CpDuplicateOrderThresholdChangeReqMessage cp_duplicate_order_threshold_change_req_message;
    case 0x17: CpOrderRateThresholdChangeReqMessage cp_order_rate_threshold_change_req_message;
    default: UINT8 unknown[available];
  }
} ClientPayload;

// Sbe message sent by the firm to Memx
typedef struct _ClientSbeMessage (UINT32 available) where (available >= 6) {
  UINT16BE block_length;                                                                                        // bytes 0 to 1
  UINT8 template_id;                                                                                            // byte 2
  UINT8 schema_id;                                                                                              // byte 3
  UINT16BE version;                                                                                             // bytes 4 to 5
  ClientPayload(template_id, (available - 6)) client_payload[:byte-size-single-element-array (available - 6)];
} ClientSbeMessage;

// Memx Tcp unsequenced message
typedef struct _UnsequencedMessage (UINT32 available) {
  ClientSbeMessage(available) client_sbe_message;
} UnsequencedMessage;

// Session message body sent by the firm to Memx, dispatched on the message type
casetype _ClientData (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x64: LoginRequestMessage login_request_message;
    case 0x65: ReplayRequestMessage replay_request_message;
    case 0x66: ReplayAllRequestMessage replay_all_request_message;
    case 0x67: StreamRequestMessage stream_request_message;
    case 0x68: UnsequencedMessage(available) unsequenced_message;
    default: UINT8 unknown[available];
  }
} ClientData;

// ---- Packet: ClientPacket ----------------------------------------------------

// Memx Tcp packet sent by the firm to Memx
entrypoint typedef struct _ClientPacket {
  UINT8 message_type;                                                                                                          // byte 0
  UINT16BE message_length;                                                                                                     // bytes 1 to 2
  ClientData(message_type, ((UINT32) message_length)) client_data[:byte-size-single-element-array ((UINT32) message_length)];
} ClientPacket;

