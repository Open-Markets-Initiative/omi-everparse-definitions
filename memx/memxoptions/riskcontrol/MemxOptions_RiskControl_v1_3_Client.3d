typedef struct _CpNetNotionalThresholdChangeReqMessage {
  UINT8 cl_ord_id[20];          // bytes 0 to 19
  UINT8 underlier_optional[6];  // bytes 20 to 25
  UINT8 efid_optional[4];       // bytes 26 to 29
  UINT16BE risk_group_id;       // bytes 30 to 31
