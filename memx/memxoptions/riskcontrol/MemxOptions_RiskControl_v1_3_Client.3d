// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_HEARTBEAT 0x00            // Heartbeat
#define MESSAGE_TYPE_LOGIN_REQUEST 0x64        // Login Request
#define MESSAGE_TYPE_REPLAY_REQUEST 0x65       // Replay Request
#define MESSAGE_TYPE_REPLAY_ALL_REQUEST 0x66   // Replay All Request
#define MESSAGE_TYPE_STREAM_REQUEST 0x67       // Stream Request
#define MESSAGE_TYPE_UNSEQUENCED_MESSAGE 0x68  // Unsequenced Message
#define MESSAGE_TYPE_LOGIN_ACCEPTED 0x01       // Login Accepted
#define MESSAGE_TYPE_LOGIN_REJECTED 0x02       // Login Rejected
#define MESSAGE_TYPE_START_OF_SESSION 0x03     // Start Of Session
#define MESSAGE_TYPE_END_OF_SESSION 0x04       // End Of Session
#define MESSAGE_TYPE_REPLAY_BEGIN 0x05         // Replay Begin
#define MESSAGE_TYPE_REPLAY_REJECTED 0x06      // Replay Rejected
#define MESSAGE_TYPE_REPLAY_COMPLETE 0x07      // Replay Complete
#define MESSAGE_TYPE_STREAM_BEGIN 0x08         // Stream Begin
#define MESSAGE_TYPE_STREAM_REJECTED 0x09      // Stream Rejected
#define MESSAGE_TYPE_STREAM_COMPLETE 0x0A      // Stream Complete
#define MESSAGE_TYPE_SEQUENCED_MESSAGE 0x0B    // Sequenced Message

// Template Id: one byte code
#define TEMPLATE_ID_RISK_SETTINGS_QUERY_MESSAGE 0x01                                     // Risk Settings Query Message
#define TEMPLATE_ID_ACTIVE_RISK_THRESHOLD_CHANGE_REQ_MESSAGE 0x02                        // Active Risk Threshold Change Req Message
#define TEMPLATE_ID_ACTIVE_RISK_ACKNOWLEDGEMENT_REQ_MESSAGE 0x03                         // Active Risk Acknowledgement Req Message
#define TEMPLATE_ID_CP_VOLUME_THRESHOLD_CHANGE_REQ_MESSAGE 0x04                          // Cp Volume Threshold Change Req Message
#define TEMPLATE_ID_CP_EXECUTED_NOTIONAL_THRESHOLD_CHANGE_REQ_MESSAGE 0x05               // Cp Executed Notional Threshold Change Req Message
#define TEMPLATE_ID_CP_TOTAL_EXECUTIONS_THRESHOLD_CHANGE_REQ_MESSAGE 0x06                // Cp Total Executions Threshold Change Req Message
#define TEMPLATE_ID_CP_PERCENT_OUTSTANDING_CONTRACTS_THRESHOLD_CHANGE_REQ_MESSAGE 0x07   // Cp Percent Outstanding Contracts Threshold Change Req Message
#define TEMPLATE_ID_CP_BREACH_COUNT_THRESHOLD_CHANGE_REQ_MESSAGE 0x08                    // Cp Breach Count Threshold Change Req Message
#define TEMPLATE_ID_MANUAL_CP_BREACH_TRIGGER_REQ_MESSAGE 0x09                            // Manual Cp Breach Trigger Req Message
#define TEMPLATE_ID_CP_CLEAR_BREACH_REQ_MESSAGE 0x0A                                     // Cp Clear Breach Req Message
#define TEMPLATE_ID_SINGLE_ORDER_ALLOW_ISO_ORDERS_CHANGE_REQ_MESSAGE 0x0B                // Single Order Allow Iso Orders Change Req Message
#define TEMPLATE_ID_SINGLE_ORDER_ALLOW_ORDERS_IN_CROSSED_MARKET_CHANGE_REQ_MESSAGE 0x0C  // Single Order Allow Orders In Crossed Market Change Req Message
#define TEMPLATE_ID_SINGLE_ORDER_MAX_NOTIONAL_CHANGE_REQ_MESSAGE 0x0D                    // Single Order Max Notional Change Req Message
#define TEMPLATE_ID_SINGLE_ORDER_MAX_CONTRACTS_CHANGE_REQ_MESSAGE 0x0E                   // Single Order Max Contracts Change Req Message
#define TEMPLATE_ID_CP_GROSS_NOTIONAL_THRESHOLD_CHANGE_REQ_MESSAGE 0x12                  // Cp Gross Notional Threshold Change Req Message
#define TEMPLATE_ID_CP_MARKET_ORDER_GROSS_NOTIONAL_THRESHOLD_CHANGE_REQ_MESSAGE 0x13     // Cp Market Order Gross Notional Threshold Change Req Message
#define TEMPLATE_ID_CP_NET_NOTIONAL_THRESHOLD_CHANGE_REQ_MESSAGE 0x14                    // Cp Net Notional Threshold Change Req Message
#define TEMPLATE_ID_CP_MARKET_ORDER_NET_NOTIONAL_THRESHOLD_CHANGE_REQ_MESSAGE 0x15       // Cp Market Order Net Notional Threshold Change Req Message
#define TEMPLATE_ID_CP_DUPLICATE_ORDER_THRESHOLD_CHANGE_REQ_MESSAGE 0x16                 // Cp Duplicate Order Threshold Change Req Message
#define TEMPLATE_ID_CP_ORDER_RATE_THRESHOLD_CHANGE_REQ_MESSAGE 0x17                      // Cp Order Rate Threshold Change Req Message
#define TEMPLATE_ID_ACTIVE_RISK_THRESHOLD_STATE_MESSAGE 0x1E                             // Active Risk Threshold State Message
#define TEMPLATE_ID_ACTIVE_RISK_THRESHOLD_CHANGE_REJ_MESSAGE 0x1F                        // Active Risk Threshold Change Rej Message
#define TEMPLATE_ID_ACTIVE_RISK_ACKNOWLEDGED_MESSAGE 0x20                                // Active Risk Acknowledged Message
#define TEMPLATE_ID_ACTIVE_RISK_ACKNOWLEDGE_REJ_MESSAGE 0x21                             // Active Risk Acknowledge Rej Message
#define TEMPLATE_ID_ACTIVE_RISK_QUANTITY_UPDATE_NOTIFICATION_MESSAGE 0x22                // Active Risk Quantity Update Notification Message
#define TEMPLATE_ID_CP_VOLUME_THRESHOLD_STATE_MESSAGE 0x23                               // Cp Volume Threshold State Message
#define TEMPLATE_ID_CP_EXECUTED_NOTIONAL_THRESHOLD_STATE_MESSAGE 0x24                    // Cp Executed Notional Threshold State Message
#define TEMPLATE_ID_CP_TOTAL_EXECUTIONS_THRESHOLD_STATE_MESSAGE 0x25                     // Cp Total Executions Threshold State Message
#define TEMPLATE_ID_CP_PERCENT_OUTSTANDING_CONTRACTS_THRESHOLD_STATE_MESSAGE 0x26        // Cp Percent Outstanding Contracts Threshold State Message
#define TEMPLATE_ID_CP_BREACH_COUNT_THRESHOLD_STATE_MESSAGE 0x27                         // Cp Breach Count Threshold State Message
#define TEMPLATE_ID_MANUAL_CP_BREACH_TRIGGER_PENDING_MESSAGE 0x28                        // Manual Cp Breach Trigger Pending Message
#define TEMPLATE_ID_MANUAL_CP_BREACH_TRIGGER_DONE_MESSAGE 0x29                           // Manual Cp Breach Trigger Done Message
#define TEMPLATE_ID_RISK_THRESHOLD_UPDATE_REJ_MESSAGE 0x2A                               // Risk Threshold Update Rej Message
#define TEMPLATE_ID_PASSIVE_RISK_THRESHOLD_NOTIFICATION_MESSAGE 0x2B                     // Passive Risk Threshold Notification Message
#define TEMPLATE_ID_SINGLE_ORDER_ALLOW_ISO_ORDERS_STATE_MESSAGE 0x2C                     // Single Order Allow Iso Orders State Message
#define TEMPLATE_ID_SINGLE_ORDER_ALLOW_ORDERS_IN_CROSSED_MARKET_STATE_MESSAGE 0x2D       // Single Order Allow Orders In Crossed Market State Message
#define TEMPLATE_ID_SINGLE_ORDER_MAX_NOTIONAL_THRESHOLD_STATE_MESSAGE 0x2E               // Single Order Max Notional Threshold State Message
#define TEMPLATE_ID_SINGLE_ORDER_MAX_CONTRACTS_THRESHOLD_STATE_MESSAGE 0x2F              // Single Order Max Contracts Threshold State Message
#define TEMPLATE_ID_RISK_SETTINGS_QUERY_DONE_MESSAGE 0x30                                // Risk Settings Query Done Message
#define TEMPLATE_ID_RISK_SETTINGS_QUERY_REJ_MESSAGE 0x31                                 // Risk Settings Query Rej Message
#define TEMPLATE_ID_MANUAL_CP_BREACH_TRIGGER_REJ_MESSAGE 0x32                            // Manual Cp Breach Trigger Rej Message
#define TEMPLATE_ID_BREACH_CLEAR_REJ_MESSAGE 0x33                                        // Breach Clear Rej Message
#define TEMPLATE_ID_BREACH_CLEARED_MESSAGE 0x34                                          // Breach Cleared Message
#define TEMPLATE_ID_CP_GROSS_NOTIONAL_THRESHOLD_STATE_MESSAGE 0x3C                       // Cp Gross Notional Threshold State Message
#define TEMPLATE_ID_CP_MARKET_ORDER_GROSS_NOTIONAL_THRESHOLD_STATE_MESSAGE 0x3D          // Cp Market Order Gross Notional Threshold State Message
#define TEMPLATE_ID_CP_NET_NOTIONAL_THRESHOLD_STATE_MESSAGE 0x3E                         // Cp Net Notional Threshold State Message
#define TEMPLATE_ID_CP_MARKET_ORDER_NET_NOTIONAL_THRESHOLD_STATE_MESSAGE 0x3F            // Cp Market Order Net Notional Threshold State Message
#define TEMPLATE_ID_CP_DUPLICATE_ORDER_THRESHOLD_STATE_MESSAGE 0x40                      // Cp Duplicate Order Threshold State Message
#define TEMPLATE_ID_CP_ORDER_RATE_THRESHOLD_STATE_MESSAGE 0x41                           // Cp Order Rate Threshold State Message

// Send Cancels: one byte code
#define SEND_CANCELS_FALSE 0x00  // False
#define SEND_CANCELS_TRUE 0x01   // True

// Allow Iso Orders: one byte code
#define ALLOW_ISO_ORDERS_FALSE 0x00  // False
#define ALLOW_ISO_ORDERS_TRUE 0x01   // True

// Allow Orders: one byte code
#define ALLOW_ORDERS_FALSE 0x00  // False
#define ALLOW_ORDERS_TRUE 0x01   // True

// Use Order Price In Dup Check Optional: one byte code
#define USE_ORDER_PRICE_IN_DUP_CHECK_OPTIONAL_FALSE 0x00  // False
#define USE_ORDER_PRICE_IN_DUP_CHECK_OPTIONAL_TRUE 0x01   // True

// ---- Types -------------------------------------------------------------------

// Memx Tcp Login message
typedef struct _LoginRequestMessage {
  UINT8 token_type;  // byte 0
  UINT8 token;       // byte 1
} LoginRequestMessage;

// Memx Tcp Replay Request message
typedef struct _ReplayRequestMessage {
  UINT64BE session_id;            // bytes 0 to 7
  UINT64BE next_sequence_number;  // bytes 8 to 15
  UINT32BE count;                 // bytes 16 to 19
} ReplayRequestMessage;

// Memx Tcp Replay All Request message
typedef struct _ReplayAllRequestMessage {
  UINT64BE session_id;  // bytes 0 to 7
} ReplayAllRequestMessage;

// Memx Tcp Stream Request message
typedef struct _StreamRequestMessage {
  UINT64BE session_id;            // bytes 0 to 7
  UINT64BE next_sequence_number;  // bytes 8 to 15
} StreamRequestMessage;

// RiskSettingsQueryMessage
typedef struct _RiskSettingsQueryMessage {
  UINT8 cl_ord_id[20];  // bytes 0 to 19
} RiskSettingsQueryMessage;

// ActiveRiskThresholdChangeReqMessage
typedef struct _ActiveRiskThresholdChangeReqMessage {
  UINT8 cl_ord_id[20];          // bytes 0 to 19
  UINT8 underlier[6];           // bytes 20 to 25
  UINT8 efid[4];                // bytes 26 to 29
  UINT32BE threshold_quantity;  // bytes 30 to 33
} ActiveRiskThresholdChangeReqMessage;

// ActiveRiskAcknowledgementReqMessage
typedef struct _ActiveRiskAcknowledgementReqMessage {
  UINT8 cl_ord_id[20];  // bytes 0 to 19
  UINT8 underlier[6];   // bytes 20 to 25
  UINT8 efid[4];        // bytes 26 to 29
  UINT32BE quantity;    // bytes 30 to 33
} ActiveRiskAcknowledgementReqMessage;

// CPVolumeThresholdChangeReqMessage
typedef struct _CpVolumeThresholdChangeReqMessage {
  UINT8 cl_ord_id[20];               // bytes 0 to 19
  UINT8 underlier_optional[6];       // bytes 20 to 25
  UINT8 efid_optional[4];            // bytes 26 to 29
  UINT16BE risk_group_id;            // bytes 30 to 31
  UINT64BE volume;                   // bytes 32 to 39
  UINT32BE period_in_milli_seconds;  // bytes 40 to 43
} CpVolumeThresholdChangeReqMessage;

// CPExecutedNotionalThresholdChangeReqMessage
typedef struct _CpExecutedNotionalThresholdChangeReqMessage {
  UINT8 cl_ord_id[20];               // bytes 0 to 19
  UINT8 underlier_optional[6];       // bytes 20 to 25
  UINT8 efid_optional[4];            // bytes 26 to 29
  UINT16BE risk_group_id;            // bytes 30 to 31
  UINT32BE price_in_dollars;         // bytes 32 to 35
  UINT32BE period_in_milli_seconds;  // bytes 36 to 39
} CpExecutedNotionalThresholdChangeReqMessage;

// CPTotalExecutionsThresholdChangeReqMessage
typedef struct _CpTotalExecutionsThresholdChangeReqMessage {
  UINT8 cl_ord_id[20];               // bytes 0 to 19
  UINT8 underlier_optional[6];       // bytes 20 to 25
  UINT8 efid_optional[4];            // bytes 26 to 29
  UINT16BE risk_group_id;            // bytes 30 to 31
  UINT32BE total_executions;         // bytes 32 to 35
  UINT32BE period_in_milli_seconds;  // bytes 36 to 39
} CpTotalExecutionsThresholdChangeReqMessage;

// CPPercentOutstandingContractsThresholdChangeReqMessage
typedef struct _CpPercentOutstandingContractsThresholdChangeReqMessage {
  UINT8 cl_ord_id[20];               // bytes 0 to 19
  UINT8 underlier_optional[6];       // bytes 20 to 25
  UINT8 efid_optional[4];            // bytes 26 to 29
  UINT32BE percent;                  // bytes 30 to 33, signed, read here as unsigned
  UINT32BE period_in_milli_seconds;  // bytes 34 to 37
} CpPercentOutstandingContractsThresholdChangeReqMessage;

// CPBreachCountThresholdChangeReqMessage
typedef struct _CpBreachCountThresholdChangeReqMessage {
  UINT8 cl_ord_id[20];               // bytes 0 to 19
  UINT8 underlier_optional[6];       // bytes 20 to 25
  UINT8 efid_optional[4];            // bytes 26 to 29
  UINT16BE risk_group_id;            // bytes 30 to 31
  UINT32BE count;                    // bytes 32 to 35
  UINT32BE period_in_milli_seconds;  // bytes 36 to 39
} CpBreachCountThresholdChangeReqMessage;

// ManualCPBreachTriggerReqMessage
typedef struct _ManualCpBreachTriggerReqMessage {
  UINT8 cl_ord_id[20];          // bytes 0 to 19
