} CpClearBreachReqMessage;

// SingleOrderAllowISOOrdersChangeReqMessage
typedef struct _SingleOrderAllowIsoOrdersChangeReqMessage {
  UINT8 cl_ord_id[20];          // bytes 0 to 19
  UINT8 underlier_optional[6];  // bytes 20 to 25
  UINT8 efid_optional[4];       // bytes 26 to 29
  UINT16BE risk_group_id;       // bytes 30 to 31
  UINT8 allow_iso_orders;       // byte 32
} SingleOrderAllowIsoOrdersChangeReqMessage;

// SingleOrderAllowOrdersInCrossedMarketChangeReqMessage
typedef struct _SingleOrderAllowOrdersInCrossedMarketChangeReqMessage {
  UINT8 cl_ord_id[20];          // bytes 0 to 19
