  UINT32BE period_in_milli_seconds;  // bytes 36 to 39
} CpOrderRateThresholdStateMessage;

// Message body sent by Memx to the firm
casetype _ServerPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x1E: ActiveRiskThresholdStateMessage active_risk_threshold_state_message;
    case 0x1F: ActiveRiskThresholdChangeRejMessage active_risk_threshold_change_rej_message;
    case 0x20: ActiveRiskAcknowledgedMessage active_risk_acknowledged_message;
    case 0x21: ActiveRiskAcknowledgeRejMessage active_risk_acknowledge_rej_message;
    case 0x22: ActiveRiskQuantityUpdateNotificationMessage active_risk_quantity_update_notification_message;
    case 0x23: CpVolumeThresholdStateMessage cp_volume_threshold_state_message;
    case 0x24: CpExecutedNotionalThresholdStateMessage cp_executed_notional_threshold_state_message;
    case 0x25: CpTotalExecutionsThresholdStateMessage cp_total_executions_threshold_state_message;
    case 0x26: CpPercentOutstandingContractsThresholdStateMessage cp_percent_outstanding_contracts_threshold_state_message;
    case 0x27: CpBreachCountThresholdStateMessage cp_breach_count_threshold_state_message;
    case 0x28: ManualCpBreachTriggerPendingMessage manual_cp_breach_trigger_pending_message;
    case 0x29: ManualCpBreachTriggerDoneMessage manual_cp_breach_trigger_done_message;
    case 0x2A: RiskThresholdUpdateRejMessage risk_threshold_update_rej_message;
    case 0x2B: PassiveRiskThresholdNotificationMessage passive_risk_threshold_notification_message;
    case 0x2C: SingleOrderAllowIsoOrdersStateMessage single_order_allow_iso_orders_state_message;
    case 0x2D: SingleOrderAllowOrdersInCrossedMarketStateMessage single_order_allow_orders_in_crossed_market_state_message;
    case 0x2E: SingleOrderMaxNotionalThresholdStateMessage single_order_max_notional_threshold_state_message;
    case 0x2F: SingleOrderMaxContractsThresholdStateMessage single_order_max_contracts_threshold_state_message;
    case 0x30: RiskSettingsQueryDoneMessage risk_settings_query_done_message;
    case 0x31: RiskSettingsQueryRejMessage risk_settings_query_rej_message;
    case 0x32: ManualCpBreachTriggerRejMessage manual_cp_breach_trigger_rej_message;
    case 0x33: BreachClearRejMessage breach_clear_rej_message;
    case 0x34: BreachClearedMessage breach_cleared_message;
    case 0x3C: CpGrossNotionalThresholdStateMessage cp_gross_notional_threshold_state_message;
    case 0x3D: CpMarketOrderGrossNotionalThresholdStateMessage cp_market_order_gross_notional_threshold_state_message;
    case 0x3E: CpNetNotionalThresholdStateMessage cp_net_notional_threshold_state_message;
    case 0x3F: CpMarketOrderNetNotionalThresholdStateMessage cp_market_order_net_notional_threshold_state_message;
    case 0x40: CpDuplicateOrderThresholdStateMessage cp_duplicate_order_threshold_state_message;
    case 0x41: CpOrderRateThresholdStateMessage cp_order_rate_threshold_state_message;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Sbe message sent by Memx to the firm
typedef struct _ServerSbeMessage (UINT32 available) where (available >= 6) {
  UINT16BE block_length;                                                                                        // bytes 0 to 1
  UINT8 template_id;                                                                                            // byte 2
  UINT8 schema_id;                                                                                              // byte 3
  UINT16BE version;                                                                                             // bytes 4 to 5
  ServerPayload(template_id, (available - 6)) server_payload[:byte-size-single-element-array (available - 6)];
} ServerSbeMessage;

// Memx Tcp sequenced message
typedef struct _SequencedMessage (UINT32 available) {
  ServerSbeMessage(available) server_sbe_message;
} SequencedMessage;

// Session message body sent by Memx to the firm, dispatched on the message type
casetype _ServerData (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: LoginAcceptedMessage login_accepted_message;
    case 0x02: LoginRejectedMessage login_rejected_message;
    case 0x03: StartOfSessionMessage start_of_session_message;
    case 0x05: ReplayBeginMessage replay_begin_message;
    case 0x06: ReplayRejectedMessage replay_rejected_message;
    case 0x07: ReplayCompleteMessage replay_complete_message;
    case 0x08: StreamBeginMessage stream_begin_message;
    case 0x09: StreamRejectedMessage stream_rejected_message;
    case 0x0A: StreamCompleteMessage stream_complete_message;
    case 0x0B: SequencedMessage(available) sequenced_message;
    default: UINT8 unknown[available];
  }
} ServerData;

// ---- Packet: ServerPacket ----------------------------------------------------

// Memx Tcp packet sent by Memx to the firm
entrypoint typedef struct _ServerPacket {
  UINT8 message_type;                                                                                                          // byte 0
  UINT16BE message_length;                                                                                                     // bytes 1 to 2
  ServerData(message_type, ((UINT32) message_length)) server_data[:byte-size-single-element-array ((UINT32) message_length)];
} ServerPacket;

