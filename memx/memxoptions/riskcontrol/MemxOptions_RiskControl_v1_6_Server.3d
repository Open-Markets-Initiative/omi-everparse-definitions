typedef struct _PassiveRiskThresholdNotificationMessage {
  UINT8 underlier_optional[6];  // bytes 0 to 5
  UINT8 efid_optional[4];       // bytes 6 to 9
  UINT16BE risk_group_id;       // bytes 10 to 11
  UINT8 rule_type;              // byte 12
  UINT8 latest_percentage;      // byte 13
  UINT64BE breach_id_optional;  // bytes 14 to 21
  UINT64BE transact_time;       // bytes 22 to 29
} PassiveRiskThresholdNotificationMessage;

