#define TEMPLATE_ID_SINGLE_ORDER_MAX_NOTIONAL_THRESHOLD_STATE_MESSAGE 0x2E                   // Single Order Max Notional Threshold State Message
#define TEMPLATE_ID_SINGLE_ORDER_MAX_CONTRACTS_THRESHOLD_STATE_MESSAGE 0x2F                  // Single Order Max Contracts Threshold State Message
#define TEMPLATE_ID_SINGLE_ORDER_ALLOW_MARKET_ORDERS_STATE_MESSAGE 0x42                      // Single Order Allow Market Orders State Message
#define TEMPLATE_ID_SINGLE_ORDER_RESTRICTED_UNDERLIER_STATE_MESSAGE 0x43                     // Single Order Restricted Underlier State Message
#define TEMPLATE_ID_RISK_SETTINGS_QUERY_DONE_MESSAGE 0x30                                    // Risk Settings Query Done Message
#define TEMPLATE_ID_RISK_SETTINGS_QUERY_REJECTED_MESSAGE 0x31                                // Risk Settings Query Rejected Message
#define TEMPLATE_ID_MANUAL_CP_BREACH_TRIGGER_REJECTED_MESSAGE 0x32                           // Manual Cp Breach Trigger Rejected Message
