#define TEMPLATE_ID_CP_MARKET_ORDER_GROSS_NOTIONAL_THRESHOLD_STATE_MESSAGE 0x3D              // Cp Market Order Gross Notional Threshold State Message
#define TEMPLATE_ID_CP_NET_NOTIONAL_THRESHOLD_STATE_MESSAGE 0x3E                             // Cp Net Notional Threshold State Message
