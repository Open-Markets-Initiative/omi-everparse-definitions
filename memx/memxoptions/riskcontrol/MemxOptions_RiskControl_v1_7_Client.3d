#define TEMPLATE_ID_BREACH_CLEARED_MESSAGE 0x34                                              // Breach Cleared Message
#define TEMPLATE_ID_BREACH_CLEAR_ALL_ACCEPTED_MESSAGE 0x35                                   // Breach Clear All Accepted Message
#define TEMPLATE_ID_BREACH_CLEAR_ALL_REJECTED_MESSAGE 0x45                                   // Breach Clear All Rejected Message
#define TEMPLATE_ID_BREACH_CLEAR_ALL_BY_EFID_OR_UNDERLIER_ACCEPTED_MESSAGE 0x36              // Breach Clear All By Efid Or Underlier Accepted Message
