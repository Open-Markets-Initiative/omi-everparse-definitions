#define TEMPLATE_ID_CP_ORDER_RATE_THRESHOLD_STATE_MESSAGE 0x41                               // Cp Order Rate Threshold State Message

// Send Cancels: one byte code
#define SEND_CANCELS_FALSE 0x00  // False
#define SEND_CANCELS_TRUE 0x01   // True

// Allow Iso Orders: one byte code
#define ALLOW_ISO_ORDERS_FALSE 0x00  // False
#define ALLOW_ISO_ORDERS_TRUE 0x01   // True

// Allow Orders: one byte code
#define ALLOW_ORDERS_FALSE 0x00  // False
#define ALLOW_ORDERS_TRUE 0x01   // True

// Allow Market Orders: one byte code
#define ALLOW_MARKET_ORDERS_FALSE 0x00  // False
#define ALLOW_MARKET_ORDERS_TRUE 0x01   // True

// Restricted: one byte code
#define RESTRICTED_FALSE 0x00  // False
#define RESTRICTED_TRUE 0x01   // True

// Use Order Price In Dup Check Optional: one byte code
#define USE_ORDER_PRICE_IN_DUP_CHECK_OPTIONAL_FALSE 0x00  // False
#define USE_ORDER_PRICE_IN_DUP_CHECK_OPTIONAL_TRUE 0x01   // True

// ---- Types -------------------------------------------------------------------

// Memx Tcp Login message
typedef struct _LoginRequestMessage {
  UINT8 token_type;  // byte 0
  UINT8 token;       // byte 1
} LoginRequestMessage;

// Memx Tcp Replay Request message
typedef struct _ReplayRequestMessage {
  UINT64BE session_id;            // bytes 0 to 7
  UINT64BE next_sequence_number;  // bytes 8 to 15
  UINT32BE count;                 // bytes 16 to 19
} ReplayRequestMessage;

// Memx Tcp Replay All Request message
typedef struct _ReplayAllRequestMessage {
  UINT64BE session_id;  // bytes 0 to 7
} ReplayAllRequestMessage;

// Memx Tcp Stream Request message
typedef struct _StreamRequestMessage {
  UINT64BE session_id;            // bytes 0 to 7
  UINT64BE next_sequence_number;  // bytes 8 to 15
} StreamRequestMessage;

// RiskSettingsQueryMessage
typedef struct _RiskSettingsQueryMessage {
