#define TEMPLATE_ID_CP_BREACH_COUNT_THRESHOLD_CHANGE_REQUEST_MESSAGE 0x08                    // Cp Breach Count Threshold Change Request Message
#define TEMPLATE_ID_MANUAL_CP_BREACH_TRIGGER_REQUEST_MESSAGE 0x09                            // Manual Cp Breach Trigger Request Message
