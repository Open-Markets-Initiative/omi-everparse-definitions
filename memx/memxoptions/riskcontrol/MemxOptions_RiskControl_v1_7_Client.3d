// Message body sent by the firm to Memx
casetype _ClientPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: RiskSettingsQueryMessage risk_settings_query_message;
    case 0x02: ActiveRiskThresholdChangeRequestMessage active_risk_threshold_change_request_message;
    case 0x03: ActiveRiskAcknowledgementRequestMessage active_risk_acknowledgement_request_message;
    case 0x04: CpVolumeThresholdChangeRequestMessage cp_volume_threshold_change_request_message;
    case 0x05: CpExecutedNotionalThresholdChangeRequestMessage cp_executed_notional_threshold_change_request_message;
    case 0x06: CpTotalExecutionsThresholdChangeRequestMessage cp_total_executions_threshold_change_request_message;
    case 0x07: CpPercentOutstandingContractsThresholdChangeRequestMessage cp_percent_outstanding_contracts_threshold_change_request_message;
    case 0x08: CpBreachCountThresholdChangeRequestMessage cp_breach_count_threshold_change_request_message;
    case 0x09: ManualCpBreachTriggerRequestMessage manual_cp_breach_trigger_request_message;
    case 0x0A: CpClearBreachRequestMessage cp_clear_breach_request_message;
    case 0x0B: SingleOrderAllowIsoOrdersChangeRequestMessage single_order_allow_iso_orders_change_request_message;
    case 0x0C: SingleOrderAllowOrdersInCrossedMarketChangeRequestMessage single_order_allow_orders_in_crossed_market_change_request_message;
    case 0x0D: SingleOrderMaxNotionalChangeRequestMessage single_order_max_notional_change_request_message;
    case 0x0E: SingleOrderMaxContractsChangeRequestMessage single_order_max_contracts_change_request_message;
    case 0x0F: SingleOrderAllowMarketOrdersChangeRequestMessage single_order_allow_market_orders_change_request_message;
    case 0x10: SingleOrderRestrictedUnderlierChangeRequestMessage single_order_restricted_underlier_change_request_message;
    case 0x12: CpGrossNotionalThresholdChangeRequestMessage cp_gross_notional_threshold_change_request_message;
    case 0x13: CpMarketOrderGrossNotionalThresholdChangeRequestMessage cp_market_order_gross_notional_threshold_change_request_message;
    case 0x14: CpNetNotionalThresholdChangeRequestMessage cp_net_notional_threshold_change_request_message;
    case 0x15: CpMarketOrderNetNotionalThresholdChangeRequestMessage cp_market_order_net_notional_threshold_change_request_message;
    case 0x16: CpDuplicateOrderThresholdChangeRequestMessage cp_duplicate_order_threshold_change_request_message;
    case 0x17: CpOrderRateThresholdChangeRequestMessage cp_order_rate_threshold_change_request_message;
    case 0x18: CpClearAllBreachesRequestMessage cp_clear_all_breaches_request_message;
    case 0x19: CpClearAllBreachesByEfidOrUnderlierRequestMessage cp_clear_all_breaches_by_efid_or_underlier_request_message;
    case 0x1A: ActiveRiskAcknowledgeAllRequestMessage active_risk_acknowledge_all_request_message;
    default: UINT8 unknown[available];
  }
} ClientPayload;

// Sbe message sent by the firm to Memx
typedef struct _ClientSbeMessage (UINT32 available) where (available >= 6) {
  UINT16BE block_length;                                                                                        // bytes 0 to 1
  UINT8 template_id;                                                                                            // byte 2
  UINT8 schema_id;                                                                                              // byte 3
  UINT16BE version;                                                                                             // bytes 4 to 5
  ClientPayload(template_id, (available - 6)) client_payload[:byte-size-single-element-array (available - 6)];
} ClientSbeMessage;

// Memx Tcp unsequenced message
typedef struct _UnsequencedMessage (UINT32 available) {
  ClientSbeMessage(available) client_sbe_message;
} UnsequencedMessage;

// Session message body sent by the firm to Memx, dispatched on the message type
casetype _ClientData (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x64: LoginRequestMessage login_request_message;
    case 0x65: ReplayRequestMessage replay_request_message;
    case 0x66: ReplayAllRequestMessage replay_all_request_message;
    case 0x67: StreamRequestMessage stream_request_message;
    case 0x68: UnsequencedMessage(available) unsequenced_message;
    default: UINT8 unknown[available];
  }
} ClientData;

// ---- Packet: ClientPacket ----------------------------------------------------

// Memx Tcp packet sent by the firm to Memx
entrypoint typedef struct _ClientPacket {
  UINT8 message_type;                                                                                                          // byte 0
  UINT16BE message_length;                                                                                                     // bytes 1 to 2
  ClientData(message_type, ((UINT32) message_length)) client_data[:byte-size-single-element-array ((UINT32) message_length)];
} ClientPacket;

