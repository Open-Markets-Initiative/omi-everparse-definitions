// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, Packet, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out MemxOptions_MemoirTop_v1_6_a.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_HEARTBEAT_MESSAGE 0x00         // Heartbeat Message
#define MESSAGE_TYPE_SESSION_SHUTDOWN_MESSAGE 0x01  // Session Shutdown Message
#define MESSAGE_TYPE_SEQUENCED_MESSAGE 0x02         // Sequenced Message

// Template Id: one byte code
#define TEMPLATE_ID_INSTRUMENT_DIRECTORY_MESSAGE 0x01         // Instrument Directory Message
#define TEMPLATE_ID_OPTIONS_INSTRUMENT_STATUS_MESSAGE 0x02    // Options Instrument Status Message
#define TEMPLATE_ID_UNDERLIER_INSTRUMENT_STATUS_MESSAGE 0x03  // Underlier Instrument Status Message
#define TEMPLATE_ID_BROKEN_TRADE_MESSAGE 0x05                 // Broken Trade Message
#define TEMPLATE_ID_CORRECTED_TRADE_MESSAGE 0x06              // Corrected Trade Message
#define TEMPLATE_ID_SNAPSHOT_COMPLETE_MESSAGE 0x07            // Snapshot Complete Message
#define TEMPLATE_ID_BEST_BID_OFFER_MESSAGE 0x0A               // Best Bid Offer Message
#define TEMPLATE_ID_BEST_BID_MESSAGE 0x0B                     // Best Bid Message
#define TEMPLATE_ID_BEST_OFFER_MESSAGE 0x0C                   // Best Offer Message
#define TEMPLATE_ID_BEST_BID_SHORT_MESSAGE 0x0D               // Best Bid Short Message
#define TEMPLATE_ID_BEST_OFFER_SHORT_MESSAGE 0x0E             // Best Offer Short Message
#define TEMPLATE_ID_TRADE_MESSAGE 0x0F                        // Trade Message
#define TEMPLATE_ID_CLEAR_BOOK_MESSAGE 0x10                   // Clear Book Message

// Options Product Type: one byte code
#define OPTIONS_PRODUCT_TYPE_EQUITY_UNDERLYING 0x00  // Equity Underlying
#define OPTIONS_PRODUCT_TYPE_INDEX_UNDERLYING 0x01   // Index Underlying

// Strike Put Or Call: one byte code
#define STRIKE_PUT_OR_CALL_PUT 0x00   // Put
#define STRIKE_PUT_OR_CALL_CALL 0x01  // Call

// Closing Only: one byte code
#define CLOSING_ONLY_FALSE 0x00  // False
#define CLOSING_ONLY_TRUE 0x01   // True

// Is Test Symbol: one byte code
#define IS_TEST_SYMBOL_FALSE 0x00  // False
#define IS_TEST_SYMBOL_TRUE 0x01   // True

// Instrument Trading Status: one byte code
#define INSTRUMENT_TRADING_STATUS_HALTED 0x48   // Halted
#define INSTRUMENT_TRADING_STATUS_TRADING 0x54  // Trading

// Instrument Trading Status Reason: one byte code
#define INSTRUMENT_TRADING_STATUS_REASON_NONE 0x58            // None
#define INSTRUMENT_TRADING_STATUS_REASON_ADMINISTRATIVE 0x41  // Administrative

// Trading Session: one byte code
#define TRADING_SESSION_OPEN 0x31    // Open
#define TRADING_SESSION_CLOSED 0x32  // Closed

// Side: one byte code
#define SIDE_BUY 0x42   // Buy
#define SIDE_SELL 0x53  // Sell

// Capacity: one byte code
#define CAPACITY_CUSTOMER 0x43      // Customer
#define CAPACITY_NON_CUSTOMER 0x4E  // Non Customer

// ---- Types -------------------------------------------------------------------

// InstrumentDirectoryMessage
typedef struct _InstrumentDirectoryMessage {
  UINT64BE timestamp;          // bytes 0 to 7
  UINT8 symbol[8];             // bytes 8 to 15
  UINT8 options_product_type;  // byte 16
  UINT8 underlier[6];          // bytes 17 to 22
  UINT8 osi_root[6];           // bytes 23 to 28
  UINT8 maturity_date[8];      // bytes 29 to 36
  UINT8 strike_put_or_call;    // byte 37
  UINT64BE strike_price;       // bytes 38 to 45
  UINT8 closing_only;          // byte 46
  UINT64BE closing_time;       // bytes 47 to 54
  UINT8 is_test_symbol;        // byte 55
} InstrumentDirectoryMessage;

// OptionsInstrumentStatusMessage
typedef struct _OptionsInstrumentStatusMessage {
  UINT64BE timestamp;                      // bytes 0 to 7
  UINT8 symbol[8];                         // bytes 8 to 15
  UINT8 instrument_trading_status;         // byte 16
  UINT8 instrument_trading_status_reason;  // byte 17
  UINT8 trading_session;                   // byte 18
} OptionsInstrumentStatusMessage;

// UnderlierInstrumentStatusMessage
typedef struct _UnderlierInstrumentStatusMessage {
  UINT64BE timestamp;     // bytes 0 to 7
  UINT8 trading_session;  // byte 8
  UINT8 underlier[6];     // bytes 9 to 14
} UnderlierInstrumentStatusMessage;

// BrokenTradeMessage
typedef struct _BrokenTradeMessage {
  UINT64BE timestamp;          // bytes 0 to 7
  UINT8 symbol[8];             // bytes 8 to 15
  UINT64BE trade_id;           // bytes 16 to 23
  UINT32BE original_quantity;  // bytes 24 to 27
  UINT64BE original_price;     // bytes 28 to 35
} BrokenTradeMessage;

// CorrectedTradeMessage
typedef struct _CorrectedTradeMessage {
  UINT64BE timestamp;           // bytes 0 to 7
  UINT8 symbol[8];              // bytes 8 to 15
  UINT64BE trade_id;            // bytes 16 to 23
  UINT32BE original_quantity;   // bytes 24 to 27
  UINT64BE original_price;      // bytes 28 to 35
  UINT32BE corrected_quantity;  // bytes 36 to 39
  UINT64BE corrected_price;     // bytes 40 to 47
} CorrectedTradeMessage;

// SnapshotCompleteMessage
typedef struct _SnapshotCompleteMessage {
  UINT64BE timestamp;              // bytes 0 to 7
  UINT64BE as_of_sequence_number;  // bytes 8 to 15
} SnapshotCompleteMessage;

// BestBidOfferMessage
typedef struct _BestBidOfferMessage {
  UINT64BE timestamp;         // bytes 0 to 7
  UINT8 symbol[8];            // bytes 8 to 15
  UINT32BE total_bid_size;    // bytes 16 to 19
  UINT32BE cust_bid_size;     // bytes 20 to 23
  UINT64BE bid_price;         // bytes 24 to 31
  UINT32BE total_offer_size;  // bytes 32 to 35
  UINT32BE cust_offer_size;   // bytes 36 to 39
  UINT64BE offer_price;       // bytes 40 to 47
} BestBidOfferMessage;

// BestBidMessage
typedef struct _BestBidMessage {
  UINT64BE timestamp;       // bytes 0 to 7
  UINT8 symbol[8];          // bytes 8 to 15
  UINT32BE total_bid_size;  // bytes 16 to 19
  UINT32BE cust_bid_size;   // bytes 20 to 23
  UINT64BE bid_price;       // bytes 24 to 31
} BestBidMessage;

// BestOfferMessage
typedef struct _BestOfferMessage {
  UINT64BE timestamp;         // bytes 0 to 7
  UINT8 symbol[8];            // bytes 8 to 15
  UINT32BE total_offer_size;  // bytes 16 to 19
  UINT32BE cust_offer_size;   // bytes 20 to 23
  UINT64BE offer_price;       // bytes 24 to 31
} BestOfferMessage;

// BestBidShortMessage
typedef struct _BestBidShortMessage {
  UINT64BE timestamp;             // bytes 0 to 7
  UINT8 symbol[8];                // bytes 8 to 15
  UINT16BE total_bid_size_short;  // bytes 16 to 17
  UINT16BE cust_bid_size_short;   // bytes 18 to 19
  UINT16BE bid_price_short;       // bytes 20 to 21
} BestBidShortMessage;

// BestOfferShortMessage
typedef struct _BestOfferShortMessage {
  UINT64BE timestamp;               // bytes 0 to 7
  UINT8 symbol[8];                  // bytes 8 to 15
  UINT16BE total_offer_size_short;  // bytes 16 to 17
  UINT16BE cust_offer_size_short;   // bytes 18 to 19
  UINT16BE offer_price_short;       // bytes 20 to 21
} BestOfferShortMessage;

// TradeMessage
typedef struct _TradeMessage {
  UINT64BE timestamp;           // bytes 0 to 7
  UINT8 symbol[8];              // bytes 8 to 15
  UINT64BE trade_id;            // bytes 16 to 23
  UINT8 intermarket_sweep : 1;  // byte 24
  UINT8 reserved_7 : 7;         // byte 24
  UINT8 side;                   // byte 25
  UINT32BE quantity;            // bytes 26 to 29
  UINT64BE price;               // bytes 30 to 37
  UINT32BE cust_quantity;       // bytes 38 to 41
  UINT8 capacity;               // byte 42
} TradeMessage;

// ClearBookMessage
typedef struct _ClearBookMessage {
  UINT64BE timestamp;  // bytes 0 to 7
  UINT8 symbol[8];     // bytes 8 to 15
} ClearBookMessage;

// Branch
casetype _Payload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: InstrumentDirectoryMessage instrument_directory_message;
    case 0x02: OptionsInstrumentStatusMessage options_instrument_status_message;
    case 0x03: UnderlierInstrumentStatusMessage underlier_instrument_status_message;
    case 0x05: BrokenTradeMessage broken_trade_message;
    case 0x06: CorrectedTradeMessage corrected_trade_message;
    case 0x07: SnapshotCompleteMessage snapshot_complete_message;
    case 0x0A: BestBidOfferMessage best_bid_offer_message;
    case 0x0B: BestBidMessage best_bid_message;
    case 0x0C: BestOfferMessage best_offer_message;
    case 0x0D: BestBidShortMessage best_bid_short_message;
    case 0x0E: BestOfferShortMessage best_offer_short_message;
    case 0x0F: TradeMessage trade_message;
    case 0x10: ClearBookMessage clear_book_message;
    default: UINT8 unknown[available];
  }
} Payload;

// Sbe Message
typedef struct _SbeMessage (UINT32 available) where (available >= 6) {
  UINT16BE block_length;                                                                           // bytes 0 to 1
  UINT8 template_id;                                                                               // byte 2
  UINT8 schema_id;                                                                                 // byte 3
  UINT16BE version;                                                                                // bytes 4 to 5
  Payload(template_id, (available - 6)) payload[:byte-size-single-element-array (available - 6)];
} SbeMessage;

// Message List Element
typedef struct _Message (mutable UINT32 * tally) {
  UINT16BE message_length;                                                                                                                                         // bytes 0 to 1
  SbeMessage(((((UINT32) message_length) + 2) - 2)) sbe_message;
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} Message;

// Sequenced Message
typedef struct _SequencedMessage (UINT32 available, mutable UINT32 * tally) where (available >= 2) {
  UINT16BE message_count;                                                                                                   // bytes 0 to 1
  unit message_tally_start {:on-success *tally = 0; return true; };
  Message(tally) message[:byte-size (available - 2)];
  unit message_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) message_count); };
} SequencedMessage;

// Branch
casetype _SequencedMessages (UINT8 selector, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x00: unit heartbeat;
    case 0x01: unit session_shutdown;
    case 0x02: SequencedMessage(available, tally) sequenced_message;
    default: UINT8 unknown[available];
  }
} SequencedMessages;

// ---- Packet: Packet ----------------------------------------------------------

// Datagram
entrypoint typedef struct _Packet (UINT32 available, mutable UINT32 * tally) where (available >= 18) {
  UINT8 message_type;                                                                                                             // byte 0
  UINT8 header_length;                                                                                                            // byte 1
  UINT64BE session_id;                                                                                                            // bytes 2 to 9
  UINT64BE sequence_number;                                                                                                       // bytes 10 to 17
  SequencedMessages(message_type, (available - 18), tally) sequenced_messages[:byte-size-single-element-array (available - 18)];
} Packet;

