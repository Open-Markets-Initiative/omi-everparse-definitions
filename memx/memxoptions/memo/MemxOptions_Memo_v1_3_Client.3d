  LongOneSidedQuotesGroups long_one_sided_quotes_groups;
} LongOneSidedBulkQuoteMessage;

// OrderCancelReplaceRequestMessage
typedef struct _OrderCancelReplaceRequestMessage {
  UINT64BE sending_time;       // bytes 0 to 7
  UINT64BE order_id_optional;  // bytes 8 to 15
  UINT8 cl_ord_id[20];         // bytes 16 to 35
  UINT8 list_seq_no;           // byte 36
  UINT8 orig_cl_ord_id[20];    // bytes 37 to 56
  UINT8 security_id[8];        // bytes 57 to 64
  UINT8 side;                  // byte 65
  UINT32BE order_qty;          // bytes 66 to 69
  UINT8 ord_type;              // byte 70
  UINT64BE price_optional;     // bytes 71 to 78
} OrderCancelReplaceRequestMessage;

// OrderCancelRequestMessage
typedef struct _OrderCancelRequestMessage {
  UINT64BE sending_time;              // bytes 0 to 7
  UINT64BE order_id_optional;         // bytes 8 to 15
  UINT8 cl_ord_id[20];                // bytes 16 to 35
  UINT8 list_seq_no;                  // byte 36
  UINT8 orig_cl_ord_id_optional[20];  // bytes 37 to 56
  UINT8 security_id[8];               // bytes 57 to 64
  UINT8 side_optional;                // byte 65
} OrderCancelRequestMessage;

// MassCancelRequestMessage
typedef struct _MassCancelRequestMessage {
  UINT64BE sending_time;                        // bytes 0 to 7
  UINT8 cl_ord_id[20];                          // bytes 8 to 27
  UINT8 efid_optional[4];                       // bytes 28 to 31
  UINT8 underlying_or_series;                   // byte 32
  UINT8 underlier_optional[6];                  // bytes 33 to 38
  UINT8 options_security_id_optional[8];        // bytes 39 to 46
  UINT16BE cancel_group_id;                     // bytes 47 to 48
  UINT8 lockout : 1;                            // byte 49
  UINT8 send_cancels : 1;                       // byte 49
  UINT8 cancel_orders_from_this_port_only : 1;  // byte 49
  UINT8 reserved_4_to_8 : 5;                    // byte 49
} MassCancelRequestMessage;

// MassCancelClearLockoutRequestMessage
typedef struct _MassCancelClearLockoutRequestMessage {
  UINT64BE sending_time;  // bytes 0 to 7
  UINT8 cl_ord_id[20];    // bytes 8 to 27
  UINT64BE lockout_id;    // bytes 28 to 35
} MassCancelClearLockoutRequestMessage;

// Parties Block
typedef struct _NestedPartiesGroups {
  UINT8 block_length_short;                                                      // byte 0
  UINT8 num_in_group;                                                            // byte 1
  PartiesGroup nested_parties_group[:byte-size (((UINT32) num_in_group) * 18)];
} NestedPartiesGroups;

// Allocations
typedef struct _AllocationInstructionMessageAllocationsGroup (mutable UINT32 * tally) {
  UINT32BE alloc_qty;                                                                                                                                              // bytes 0 to 3
  UINT8 trading_capacity;                                                                                                                                          // byte 4
  UINT8 open_or_close;                                                                                                                                             // byte 5
  NestedPartiesGroups nested_parties_groups;
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} AllocationInstructionMessageAllocationsGroup;

// Allocations Block
typedef struct _AllocationInstructionMessageAllocationsGroups (UINT32 available, mutable UINT32 * tally) where (available >= 2) {
  UINT8 block_length_short;                                                                                                                                         // byte 0
  UINT8 num_in_group;                                                                                                                                               // byte 1
  unit allocation_instruction_message_allocations_group_tally_start {:on-success *tally = 0; return true; };
  AllocationInstructionMessageAllocationsGroup(tally) allocation_instruction_message_allocations_group[:byte-size (available - 2)];
  unit allocation_instruction_message_allocations_group_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) num_in_group); };
} AllocationInstructionMessageAllocationsGroups;

// AllocationInstructionMessage
typedef struct _AllocationInstructionMessage (UINT32 available, mutable UINT32 * tally) where (available >= 75) {
  UINT64BE sending_time;                                                                                                     // bytes 0 to 7
  UINT8 alloc_id[20];                                                                                                        // bytes 8 to 27
  UINT8 alloc_trans_type;                                                                                                    // byte 28
  UINT8 alloc_type;                                                                                                          // byte 29
  UINT64BE ref_alloc_report_id;                                                                                              // bytes 30 to 37
  UINT64BE exec_ref_id_optional;                                                                                             // bytes 38 to 45
  UINT64BE trd_match_id;                                                                                                     // bytes 46 to 53
  UINT8 security_id[8];                                                                                                      // bytes 54 to 61
  UINT8 side;                                                                                                                // byte 62
  UINT32BE quantity_long;                                                                                                    // bytes 63 to 66
  UINT8 trade_date[8];                                                                                                       // bytes 67 to 74
  AllocationInstructionMessageAllocationsGroups((available - 75), tally) allocation_instruction_message_allocations_groups;
} AllocationInstructionMessage;

// Memo message body sent by the firm to Memx
casetype _ClientPayload (UINT8 selector, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x01: NewOrderSingleMessage new_order_single_message;
    case 0x02: ShortTwoSidedBulkQuoteMessage short_two_sided_bulk_quote_message;
    case 0x03: LongTwoSidedBulkQuoteMessage long_two_sided_bulk_quote_message;
    case 0x04: ShortOneSidedBulkQuoteMessage short_one_sided_bulk_quote_message;
    case 0x05: LongOneSidedBulkQuoteMessage long_one_sided_bulk_quote_message;
    case 0x06: OrderCancelReplaceRequestMessage order_cancel_replace_request_message;
    case 0x07: OrderCancelRequestMessage order_cancel_request_message;
    case 0x08: MassCancelRequestMessage mass_cancel_request_message;
    case 0x09: MassCancelClearLockoutRequestMessage mass_cancel_clear_lockout_request_message;
    case 0x0A: AllocationInstructionMessage(available, tally) allocation_instruction_message;
    default: UINT8 unknown[available];
  }
} ClientPayload;

// Sbe message sent by the firm to Memx
typedef struct _ClientSbeMessage (UINT32 available, mutable UINT32 * tally) where (available >= 7) {
  UINT16BE block_length;                                                                                               // bytes 0 to 1
  UINT8 template_id;                                                                                                   // byte 2
  UINT8 schema_id;                                                                                                     // byte 3
  UINT16BE version;                                                                                                    // bytes 4 to 5
  UINT8 num_groups;                                                                                                    // byte 6
  ClientPayload(template_id, (available - 7), tally) client_payload[:byte-size-single-element-array (available - 7)];
} ClientSbeMessage;

// Memx Tcp unsequenced message
typedef struct _UnsequencedMessage (UINT32 available, mutable UINT32 * tally) {
  ClientSbeMessage(available, tally) client_sbe_message;
} UnsequencedMessage;

// Session message body sent by the firm to Memx, dispatched on the message type
casetype _ClientData (UINT8 selector, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x64: LoginRequestMessage login_request_message;
    case 0x65: ReplayRequestMessage replay_request_message;
    case 0x66: ReplayAllRequestMessage replay_all_request_message;
    case 0x67: StreamRequestMessage stream_request_message;
    case 0x68: UnsequencedMessage(available, tally) unsequenced_message;
    default: UINT8 unknown[available];
  }
} ClientData;

// ---- Packet: ClientPacket ----------------------------------------------------

// Memx Tcp packet sent by the firm to Memx
entrypoint typedef struct _ClientPacket (mutable UINT32 * tally) {
  UINT8 message_type;                                                                                                                 // byte 0
  UINT16BE message_length;                                                                                                            // bytes 1 to 2
  ClientData(message_type, ((UINT32) message_length), tally) client_data[:byte-size-single-element-array ((UINT32) message_length)];
} ClientPacket;

