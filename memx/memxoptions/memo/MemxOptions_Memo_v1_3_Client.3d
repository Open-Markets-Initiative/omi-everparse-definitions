  UINT64BE bid_px_price_type;                                                  // bytes 13 to 20
  UINT32BE offer_size_uint_32;                                                 // bytes 21 to 24
  UINT64BE offer_px_price_type;                                                // bytes 25 to 32
} LongTwoSidedQuotesGroup;

// Quotes Block
typedef struct _LongTwoSidedQuotesGroups {
  UINT8 block_length_short;                                                                        // byte 0
  UINT8 num_in_group;                                                                              // byte 1
  LongTwoSidedQuotesGroup long_two_sided_quotes_group[:byte-size (((UINT32) num_in_group) * 33)];
} LongTwoSidedQuotesGroups;

// LongTwoSidedBulkQuoteMessage
typedef struct _LongTwoSidedBulkQuoteMessage {
  UINT64BE sending_time;                                  // bytes 0 to 7
  UINT8 cl_ord_id[20];                                    // bytes 8 to 27
  UINT8 time_in_force;                                    // byte 28
  UINT16BE reserved_4_to_16 : 13;                         // bytes 29 to 30
  UINT16BE external_routing_not_allowed : 1;              // bytes 29 to 30
  UINT16BE intermarket_sweep : 1;                         // bytes 29 to 30
  UINT16BE participate_do_not_initiate : 1;               // bytes 29 to 30
  UINT8 trading_capacity;                                 // byte 31
  UINT16BE mtp_group_id;                                  // bytes 32 to 33
  UINT8 match_trade_prevention;                           // byte 34
  UINT16BE cancel_group_id;                               // bytes 35 to 36
  UINT16BE risk_group_id;                                 // bytes 37 to 38
  PartiesGroups parties_groups;
  LongTwoSidedQuotesGroups long_two_sided_quotes_groups;
} LongTwoSidedBulkQuoteMessage;

