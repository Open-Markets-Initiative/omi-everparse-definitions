  UINT16BE bid_px;       // bytes 11 to 12
  UINT16BE offer_size;   // bytes 13 to 14
  UINT16BE offer_px;     // bytes 15 to 16
} TwoSidedQuotesGroup;

// Quotes Block
typedef struct _TwoSidedQuotesGroups {
  UINT8 block_length_short;                                                               // byte 0
  UINT8 num_in_group;                                                                     // byte 1
  TwoSidedQuotesGroup two_sided_quotes_group[:byte-size (((UINT32) num_in_group) * 17)];
} TwoSidedQuotesGroups;

