} ShortOneSidedBulkQuoteMessage;

// Quotes
typedef struct _LongOneSidedQuotesGroup {
  UINT8 list_seq_no;                                                           // byte 0
  UINT8 options_security_id_long_one_sided_bulk_quote_options_security_id[8];  // bytes 1 to 8
  UINT8 side;                                                                  // byte 9
