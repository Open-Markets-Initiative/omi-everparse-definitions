// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for the packet, ClientPacket, and proves of that C that it reads
// no byte outside the buffer it is given, reads no byte twice, and accepts exactly the byte
// strings the packet describes: its header, its messages, the choice of each message by its
// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out MemxOptions_Memo_v1_3_Client.3d

// ---- Values ------------------------------------------------------------------

// Message Type: one byte code
#define MESSAGE_TYPE_HEARTBEAT 0x00            // Heartbeat
#define MESSAGE_TYPE_LOGIN_REQUEST 0x64        // Login Request
#define MESSAGE_TYPE_REPLAY_REQUEST 0x65       // Replay Request
#define MESSAGE_TYPE_REPLAY_ALL_REQUEST 0x66   // Replay All Request
#define MESSAGE_TYPE_STREAM_REQUEST 0x67       // Stream Request
#define MESSAGE_TYPE_UNSEQUENCED_MESSAGE 0x68  // Unsequenced Message
#define MESSAGE_TYPE_LOGIN_ACCEPTED 0x01       // Login Accepted
#define MESSAGE_TYPE_LOGIN_REJECTED 0x02       // Login Rejected
#define MESSAGE_TYPE_START_OF_SESSION 0x03     // Start Of Session
#define MESSAGE_TYPE_END_OF_SESSION 0x04       // End Of Session
#define MESSAGE_TYPE_REPLAY_BEGIN 0x05         // Replay Begin
#define MESSAGE_TYPE_REPLAY_REJECTED 0x06      // Replay Rejected
#define MESSAGE_TYPE_REPLAY_COMPLETE 0x07      // Replay Complete
#define MESSAGE_TYPE_STREAM_BEGIN 0x08         // Stream Begin
#define MESSAGE_TYPE_STREAM_REJECTED 0x09      // Stream Rejected
#define MESSAGE_TYPE_STREAM_COMPLETE 0x0A      // Stream Complete
#define MESSAGE_TYPE_SEQUENCED_MESSAGE 0x0B    // Sequenced Message

// Template Id: one byte code
#define TEMPLATE_ID_NEW_ORDER_SINGLE_MESSAGE 0x01                           // New Order Single Message
#define TEMPLATE_ID_SHORT_TWO_SIDED_BULK_QUOTE_MESSAGE 0x02                 // Short Two Sided Bulk Quote Message
#define TEMPLATE_ID_LONG_TWO_SIDED_BULK_QUOTE_MESSAGE 0x03                  // Long Two Sided Bulk Quote Message
#define TEMPLATE_ID_SHORT_ONE_SIDED_BULK_QUOTE_MESSAGE 0x04                 // Short One Sided Bulk Quote Message
#define TEMPLATE_ID_LONG_ONE_SIDED_BULK_QUOTE_MESSAGE 0x05                  // Long One Sided Bulk Quote Message
#define TEMPLATE_ID_ORDER_CANCEL_REPLACE_REQUEST_MESSAGE 0x06               // Order Cancel Replace Request Message
#define TEMPLATE_ID_ORDER_CANCEL_REQUEST_MESSAGE 0x07                       // Order Cancel Request Message
#define TEMPLATE_ID_MASS_CANCEL_REQUEST_MESSAGE 0x08                        // Mass Cancel Request Message
#define TEMPLATE_ID_MASS_CANCEL_CLEAR_LOCKOUT_REQUEST_MESSAGE 0x09          // Mass Cancel Clear Lockout Request Message
#define TEMPLATE_ID_ALLOCATION_INSTRUCTION_MESSAGE 0x0A                     // Allocation Instruction Message
#define TEMPLATE_ID_EXECUTION_REPORT_NEW_MESSAGE 0x0B                       // Execution Report New Message
#define TEMPLATE_ID_EXECUTION_REPORT_BULK_QUOTE_PENDING_NEW_MESSAGE 0x0C    // Execution Report Bulk Quote Pending New Message
#define TEMPLATE_ID_EXECUTION_REPORT_BULK_QUOTE_COMPONENT_NEW_MESSAGE 0x0D  // Execution Report Bulk Quote Component New Message
#define TEMPLATE_ID_EXECUTION_REPORT_REJECTED_MESSAGE 0x0E                  // Execution Report Rejected Message
#define TEMPLATE_ID_EXECUTION_REPORT_TRADE_MESSAGE 0x0F                     // Execution Report Trade Message
#define TEMPLATE_ID_EXECUTION_REPORT_PENDING_CANCEL_MESSAGE 0x10            // Execution Report Pending Cancel Message
#define TEMPLATE_ID_EXECUTION_REPORT_CANCELED_MESSAGE 0x11                  // Execution Report Canceled Message
#define TEMPLATE_ID_EXECUTION_REPORT_PENDING_REPLACE_MESSAGE 0x12           // Execution Report Pending Replace Message
#define TEMPLATE_ID_EXECUTION_REPORT_REPLACED_MESSAGE 0x13                  // Execution Report Replaced Message
#define TEMPLATE_ID_EXECUTION_REPORT_TRADE_CORRECTION_MESSAGE 0x14          // Execution Report Trade Correction Message
#define TEMPLATE_ID_EXECUTION_REPORT_TRADE_BREAK_MESSAGE 0x15               // Execution Report Trade Break Message
#define TEMPLATE_ID_EXECUTION_REPORT_RESTATEMENT_MESSAGE 0x16               // Execution Report Restatement Message
#define TEMPLATE_ID_PENDING_MASS_CANCEL_MESSAGE 0x17                        // Pending Mass Cancel Message
#define TEMPLATE_ID_MASS_CANCEL_REJECT_MESSAGE 0x18                         // Mass Cancel Reject Message
#define TEMPLATE_ID_MASS_CANCEL_DONE_MESSAGE 0x19                           // Mass Cancel Done Message
#define TEMPLATE_ID_ORDER_CANCEL_REJECT_MESSAGE 0x1A                        // Order Cancel Reject Message
#define TEMPLATE_ID_ALLOCATION_INSTRUCTION_ACK_MESSAGE 0x1B                 // Allocation Instruction Ack Message
#define TEMPLATE_ID_ALLOCATION_REPORT_MESSAGE 0x1C                          // Allocation Report Message
#define TEMPLATE_ID_USER_NOTIFICATION_MESSAGE 0x1D                          // User Notification Message
#define TEMPLATE_ID_MASS_CANCEL_CLEAR_LOCKOUT_REJECT_MESSAGE 0x1E           // Mass Cancel Clear Lockout Reject Message
#define TEMPLATE_ID_MASS_CANCEL_CLEAR_LOCKOUT_DONE_MESSAGE 0x1F             // Mass Cancel Clear Lockout Done Message

// Side: one byte code
#define SIDE_BUY 0x31         // Buy
#define SIDE_SELL 0x32        // Sell
#define SIDE_AS_DEFINED 0x42  // As Defined

// Ord Type: one byte code
#define ORD_TYPE_MARKET 0x31  // Market
#define ORD_TYPE_LIMIT 0x32   // Limit

// Time In Force: one byte code
#define TIME_IN_FORCE_DAY 0x30                  // Day
#define TIME_IN_FORCE_IMMEDIATE_OR_CANCEL 0x33  // Immediate Or Cancel

// Open Or Close Optional: one byte code
#define OPEN_OR_CLOSE_OPTIONAL_OPEN 0x4F        // Open
#define OPEN_OR_CLOSE_OPTIONAL_CLOSE 0x43       // Close
#define OPEN_OR_CLOSE_OPTIONAL_NULL_VALUE 0x30  // Null Value

// Trading Capacity: one byte code
#define TRADING_CAPACITY_CUSTOMER 0x01                // Customer
#define TRADING_CAPACITY_PROFESSIONAL_CUSTOMER 0x02   // Professional Customer
#define TRADING_CAPACITY_BROKER_DEALER 0x03           // Broker Dealer
#define TRADING_CAPACITY_BROKER_DEALER_CUSTOMER 0x04  // Broker Dealer Customer
#define TRADING_CAPACITY_FIRM 0x05                    // Firm
#define TRADING_CAPACITY_MARKET_MAKER 0x06            // Market Maker
#define TRADING_CAPACITY_AWAY_MARKET_MAKER 0x07       // Away Market Maker
#define TRADING_CAPACITY_NULL_VALUE 0xFF              // Null Value

// Reprice Frequency: one byte code
#define REPRICE_FREQUENCY_SINGLE_REPRICE 0x00      // Single Reprice
#define REPRICE_FREQUENCY_CONTINUOUS_REPRICE 0x01  // Continuous Reprice
#define REPRICE_FREQUENCY_NONE 0x02                // None
#define REPRICE_FREQUENCY_NULL_VALUE 0xFF          // Null Value

// Reprice Behavior: one byte code
#define REPRICE_BEHAVIOR_REPRICE_LOCK_CANCEL_CROSS 0x01   // Reprice Lock Cancel Cross
#define REPRICE_BEHAVIOR_REPRICE_LOCK_REPRICE_CROSS 0x02  // Reprice Lock Reprice Cross
#define REPRICE_BEHAVIOR_NULL_VALUE 0xFF                  // Null Value

// Match Trade Prevention: one byte code
#define MATCH_TRADE_PREVENTION_CANCEL_NEWEST 0x00  // Cancel Newest
#define MATCH_TRADE_PREVENTION_CANCEL_OLDEST 0x01  // Cancel Oldest
#define MATCH_TRADE_PREVENTION_CANCEL_BOTH 0x03    // Cancel Both
#define MATCH_TRADE_PREVENTION_NULL_VALUE 0xFF     // Null Value

// Party Role: one byte code
#define PARTY_ROLE_EXECUTING_FIRM_ID 0x01         // Executing Firm Id
#define PARTY_ROLE_ACTIONABLE_IDENTIFIER 0x03     // Actionable Identifier
#define PARTY_ROLE_GIVE_UP_CLEARING_FIRM 0x0E     // Give Up Clearing Firm
#define PARTY_ROLE_CONTRA_EFID 0x11               // Contra Efid
#define PARTY_ROLE_CONTRA_GIVE_UP 0x12            // Contra Give Up
#define PARTY_ROLE_OPTIONAL_OCC_DATA 0x18         // Optional Occ Data
#define PARTY_ROLE_CONTRA_MM_SUB_ACCOUNT 0x25     // Contra Mm Sub Account
#define PARTY_ROLE_CMTA 0x28                      // Cmta
#define PARTY_ROLE_CONTRA_CMTA 0x29               // Contra Cmta
#define PARTY_ROLE_MARKET_MAKER_SUB_ACCOUNT 0x42  // Market Maker Sub Account

// Side Optional: one byte code
#define SIDE_OPTIONAL_BUY 0x31         // Buy
#define SIDE_OPTIONAL_SELL 0x32        // Sell
#define SIDE_OPTIONAL_AS_DEFINED 0x42  // As Defined

// Underlying Or Series: one byte code
#define UNDERLYING_OR_SERIES_CANCEL_ALL_ON_UNDERLYING 0x00  // Cancel All On Underlying
#define UNDERLYING_OR_SERIES_CANCEL_ALL_ON_SERIES 0x01      // Cancel All On Series
#define UNDERLYING_OR_SERIES_NULL_VALUE 0xFF                // Null Value

// Alloc Trans Type: one byte code
#define ALLOC_TRANS_TYPE_NEW 0x00         // New
#define ALLOC_TRANS_TYPE_REPLACE 0x01     // Replace
#define ALLOC_TRANS_TYPE_NULL_VALUE 0xFF  // Null Value

// Alloc Type: one byte code
#define ALLOC_TYPE_POST_TRADE_EDIT 0x64  // Post Trade Edit
#define ALLOC_TYPE_NULL_VALUE 0xFF       // Null Value

// Open Or Close: one byte code
#define OPEN_OR_CLOSE_OPEN 0x4F        // Open
#define OPEN_OR_CLOSE_CLOSE 0x43       // Close
#define OPEN_OR_CLOSE_NULL_VALUE 0x30  // Null Value

// ---- Types -------------------------------------------------------------------

// Memx Tcp Login message
typedef struct _LoginRequestMessage {
  UINT8 token_type;  // byte 0
  UINT8 token;       // byte 1
} LoginRequestMessage;

// Memx Tcp Replay Request message
typedef struct _ReplayRequestMessage {
  UINT64BE session_id;            // bytes 0 to 7
  UINT64BE next_sequence_number;  // bytes 8 to 15
  UINT32BE count;                 // bytes 16 to 19
} ReplayRequestMessage;

// Memx Tcp Replay All Request message
typedef struct _ReplayAllRequestMessage {
  UINT64BE session_id;  // bytes 0 to 7
} ReplayAllRequestMessage;

// Memx Tcp Stream Request message
typedef struct _StreamRequestMessage {
  UINT64BE session_id;            // bytes 0 to 7
  UINT64BE next_sequence_number;  // bytes 8 to 15
} StreamRequestMessage;

// Parties
typedef struct _PartiesGroup {
  UINT8 party_id[16];     // bytes 0 to 15
  UINT8 party_id_source;  // byte 16
  UINT8 party_role;       // byte 17
} PartiesGroup;

// Parties Block
typedef struct _PartiesGroups {
  UINT8 block_length_short;                                               // byte 0
  UINT8 num_in_group;                                                     // byte 1
  PartiesGroup parties_group[:byte-size (((UINT32) num_in_group) * 18)];
} PartiesGroups;

// NewOrderSingleMessage
typedef struct _NewOrderSingleMessage {
  UINT64BE sending_time;                      // bytes 0 to 7
  UINT8 cl_ord_id[20];                        // bytes 8 to 27
  UINT8 security_id[8];                       // bytes 28 to 35
  UINT8 side;                                 // byte 36
  UINT32BE order_qty;                         // bytes 37 to 40
  UINT8 ord_type;                             // byte 41
  UINT64BE price_optional;                    // bytes 42 to 49
  UINT8 time_in_force;                        // byte 50
  UINT8 open_or_close_optional;               // byte 51
  UINT16BE reserved_4_to_16 : 13;             // bytes 52 to 53
  UINT16BE external_routing_not_allowed : 1;  // bytes 52 to 53
  UINT16BE intermarket_sweep : 1;             // bytes 52 to 53
  UINT16BE participate_do_not_initiate : 1;   // bytes 52 to 53
  UINT8 trading_capacity;                     // byte 54
  UINT8 reprice_frequency;                    // byte 55
  UINT8 reprice_behavior;                     // byte 56
  UINT16BE mtp_group_id;                      // bytes 57 to 58
  UINT8 match_trade_prevention;               // byte 59
  UINT16BE cancel_group_id;                   // bytes 60 to 61
  UINT16BE risk_group_id;                     // bytes 62 to 63
  PartiesGroups parties_groups;
} NewOrderSingleMessage;

