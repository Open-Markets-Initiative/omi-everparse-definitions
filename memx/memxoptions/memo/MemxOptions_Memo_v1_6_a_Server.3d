// Cxl Rej Response To: one byte code
#define CXL_REJ_RESPONSE_TO_ORDER_CANCEL_REQUEST 0x31          // Order Cancel Request
#define CXL_REJ_RESPONSE_TO_ORDER_CANCEL_REPLACE_REQUEST 0x32  // Order Cancel Replace Request

// Cxl Rej Reason: 2 byte code
#define CXL_REJ_REASON_TOO_LATE_TO_CANCEL 0x0000                                   // Too Late To Cancel
#define CXL_REJ_REASON_UNKNOWN_ORDER 0x0001                                        // Unknown Order
#define CXL_REJ_REASON_ORDER_ALREADY_PENDING_CANCEL_OR_REPLACE 0x0003              // Order Already Pending Cancel Or Replace
#define CXL_REJ_REASON_DUPLICATE_CL_ORD_ID 0x0006                                  // Duplicate Cl Ord Id
#define CXL_REJ_REASON_PRICE_EXCEEDS_CURRENT_PRICE_BAND 0x0008                     // Price Exceeds Current Price Band
#define CXL_REJ_REASON_INVALID_PRICE_INCREMENT 0x0012                              // Invalid Price Increment
#define CXL_REJ_REASON_OTHER 0x0063                                                // Other
#define CXL_REJ_REASON_MISSING_SYMBOL 0x0064                                       // Missing Symbol
#define CXL_REJ_REASON_INVALID_SYMBOL 0x0065                                       // Invalid Symbol
#define CXL_REJ_REASON_MISSING_CL_ORD_ID 0x0066                                    // Missing Cl Ord Id
#define CXL_REJ_REASON_INVALID_CL_ORD_ID 0x0067                                    // Invalid Cl Ord Id
#define CXL_REJ_REASON_MISSING_SIDE 0x0068                                         // Missing Side
#define CXL_REJ_REASON_INVALID_SIDE 0x0069                                         // Invalid Side
#define CXL_REJ_REASON_MISSING_ORDER_QTY 0x006A                                    // Missing Order Qty
#define CXL_REJ_REASON_INVALID_ORDER_QTY 0x006B                                    // Invalid Order Qty
#define CXL_REJ_REASON_MISSING_ORDER_TYPE 0x006C                                   // Missing Order Type
#define CXL_REJ_REASON_INVALID_ORDER_TYPE 0x006D                                   // Invalid Order Type
#define CXL_REJ_REASON_MISSING_LIMIT_PRICE 0x006E                                  // Missing Limit Price
#define CXL_REJ_REASON_INVALID_LIMIT_PRICE 0x006F                                  // Invalid Limit Price
#define CXL_REJ_REASON_MISSING_LIST_SEQ_NO 0x0072                                  // Missing List Seq No
#define CXL_REJ_REASON_INVALID_LIST_SEQ_NO 0x0073                                  // Invalid List Seq No
#define CXL_REJ_REASON_MISSING_ORIG_CL_ORD_ID 0x0074                               // Missing Orig Cl Ord Id
#define CXL_REJ_REASON_INVALID_ORIG_CL_ORD_ID 0x0075                               // Invalid Orig Cl Ord Id
#define CXL_REJ_REASON_MISSING_ORDER_ID 0x0076                                     // Missing Order Id
#define CXL_REJ_REASON_INVALID_ORDER_ID 0x0077                                     // Invalid Order Id
#define CXL_REJ_REASON_MISSING_SENDING_TIME 0x0078                                 // Missing Sending Time
#define CXL_REJ_REASON_INVALID_SENDING_TIME 0x0079                                 // Invalid Sending Time
#define CXL_REJ_REASON_HALTED 0x00C8                                               // Halted
#define CXL_REJ_REASON_FIRM_DISABLED 0x00C9                                        // Firm Disabled
#define CXL_REJ_REASON_EFID_DISABLED 0x00CA                                        // Efid Disabled
#define CXL_REJ_REASON_ACCOUNT_DISABLED 0x00CB                                     // Account Disabled
#define CXL_REJ_REASON_UNSUPPORTED_ORD_TYPE_CHANGE 0x00CC                          // Unsupported Ord Type Change
#define CXL_REJ_REASON_UNSUPPORTED_SIDE_CHANGE 0x00CD                              // Unsupported Side Change
#define CXL_REJ_REASON_SYMBOL_MISMATCH 0x00CE                                      // Symbol Mismatch
#define CXL_REJ_REASON_ORIG_ORDER_ID_MISMATCH 0x00CF                               // Orig Order Id Mismatch
#define CXL_REJ_REASON_UNSUPPORTED_ORDER_PROPERTY_CHANGE 0x00D0                    // Unsupported Order Property Change
#define CXL_REJ_REASON_NON_TEST_SYMBOLS_BLOCKED 0x012C                             // Non Test Symbols Blocked
#define CXL_REJ_REASON_NOTIONAL_VALUE_EXCEEDS_THRESHOLD 0x012D                     // Notional Value Exceeds Threshold
#define CXL_REJ_REASON_MAX_NOTIONAL_VALUE_PER_ORDER_RISK_RULE_VIOLATED 0x012E      // Max Notional Value Per Order Risk Rule Violated
#define CXL_REJ_REASON_BLOCK_NON_TEST_SYMBOL_RISK_RULE_VIOLATED 0x012F             // Block Non Test Symbol Risk Rule Violated
#define CXL_REJ_REASON_MAX_CONTRACTS_PER_ORDER_RISK_RULE_VIOLATED 0x0130           // Max Contracts Per Order Risk Rule Violated
#define CXL_REJ_REASON_NBBO_WIDTH_EXCEEDS_THRESHOLD 0x0131                         // Nbbo Width Exceeds Threshold
#define CXL_REJ_REASON_EXCHANGE_PRICE_VALUE_COLLAR_RISK_RULE_VIOLATED 0x0132       // Exchange Price Value Collar Risk Rule Violated
#define CXL_REJ_REASON_EXECUTION_PRICE_HIGHER_THAN_STRIKE_PRICE 0x0133             // Execution Price Higher Than Strike Price
#define CXL_REJ_REASON_MARKET_BUY_WHEN_NBO_IS_ZERO 0x0134                          // Market Buy When Nbo Is Zero
#define CXL_REJ_REASON_MARKET_SELL_WHEN_NBB_GREATER_THAN_THRESHOLD 0x0135          // Market Sell When Nbb Greater Than Threshold
#define CXL_REJ_REASON_QUOTE_PRICE_OUTSIDE_EXCHANGE_THRESHOLD 0x0136               // Quote Price Outside Exchange Threshold
#define CXL_REJ_REASON_NUM_CONTRACTS_EXECUTED_EXCEEDS_THRESHOLD 0x0138             // Num Contracts Executed Exceeds Threshold
#define CXL_REJ_REASON_NOTIONAL_VALUE_OF_EXECUTIONS_EXCEEDS_THRESHOLD 0x0139       // Notional Value Of Executions Exceeds Threshold
#define CXL_REJ_REASON_COUNT_OF_EXECUTIONS_EXCEEDS_THRESHOLD 0x013A                // Count Of Executions Exceeds Threshold
#define CXL_REJ_REASON_OUTSTANDING_PERCENTAGE_THRESHOLD_EXCEEDED 0x013B            // Outstanding Percentage Threshold Exceeded
#define CXL_REJ_REASON_TRIPS_THRESHOLD_EXCEEDED 0x013C                             // Trips Threshold Exceeded
#define CXL_REJ_REASON_ISO_ORDERS_NOT_ALLOWED 0x013D                               // Iso Orders Not Allowed
#define CXL_REJ_REASON_MARKET_IS_CROSSED 0x013E                                    // Market Is Crossed
#define CXL_REJ_REASON_ACTIVE_RISK_BREACH 0x013F                                   // Active Risk Breach
#define CXL_REJ_REASON_MANUAL_RISK_BREACH 0x0140                                   // Manual Risk Breach
#define CXL_REJ_REASON_GROSS_NOTIONAL_VALUE_EXCEEDS_THRESHOLD 0x0141               // Gross Notional Value Exceeds Threshold
#define CXL_REJ_REASON_NET_NOTIONAL_VALUE_EXCEEDS_THRESHOLD 0x0142                 // Net Notional Value Exceeds Threshold
#define CXL_REJ_REASON_DUPLICATE_ORDER_THRESHOLD_EXCEEDED 0x0143                   // Duplicate Order Threshold Exceeded
#define CXL_REJ_REASON_ORDER_RATE_THRESHOLD_EXCEEDED 0x0144                        // Order Rate Threshold Exceeded
#define CXL_REJ_REASON_MASS_CANCEL_LOCKOUT_IN_EFFECT 0x0145                        // Mass Cancel Lockout In Effect
#define CXL_REJ_REASON_MARKET_ORDER_GROSS_NOTIONAL_VALUE_EXCEEDS_THRESHOLD 0x0146  // Market Order Gross Notional Value Exceeds Threshold
#define CXL_REJ_REASON_MARKET_ORDER_NET_NOTIONAL_VALUE_EXCEEDS_THRESHOLD 0x0147    // Market Order Net Notional Value Exceeds Threshold
#define CXL_REJ_REASON_LIMIT_ORDER_FAT_FINGER_CHECK 0x0148                         // Limit Order Fat Finger Check
#define CXL_REJ_REASON_BULK_QUOTE_FAT_FINGER_CHECK 0x0149                          // Bulk Quote Fat Finger Check
#define CXL_REJ_REASON_NULL_VALUE 0xFFFF                                           // Null Value

// User Status: one byte code
#define USER_STATUS_SESSION_SHUTDOWN_WARNING 0x08   // Session Shutdown Warning
#define USER_STATUS_END_OF_EVENTS_FOR_SESSION 0x64  // End Of Events For Session
#define USER_STATUS_NULL_VALUE 0xFF                 // Null Value

// Rej Reason: 2 byte code
#define REJ_REASON_OTHER 0x0000               // Other
#define REJ_REASON_MISSING_CL_ORD_ID 0x0001   // Missing Cl Ord Id
#define REJ_REASON_INVALID_CL_ORD_ID 0x0002   // Invalid Cl Ord Id
#define REJ_REASON_MISSING_LOCKOUT_ID 0x0003  // Missing Lockout Id
#define REJ_REASON_INVALID_LOCKOUT_ID 0x0004  // Invalid Lockout Id
#define REJ_REASON_UNKNOWN_LOCKOUT_ID 0x0005  // Unknown Lockout Id
#define REJ_REASON_NO_LOCKOUTS_ACTIVE 0x0006  // No Lockouts Active
#define REJ_REASON_NULL_VALUE 0xFFFF          // Null Value

// ---- Common Header: 3 bytes --------------------------------------------------

// Tcp Common Header
entrypoint typedef struct _CommonHeader {
  UINT8 message_type;       // byte 0, values MESSAGE_TYPE_
  UINT16BE message_length;  // bytes 1 to 2
} CommonHeader;

// ---- Login Accepted Message: 1 byte ------------------------------------------

// Memx Tcp Login Accepted Message
entrypoint typedef struct _LoginAcceptedMessage {
  UINT8 supported_request_mode;  // byte 0, values SUPPORTED_REQUEST_MODE_
} LoginAcceptedMessage;

// ---- Login Rejected Message: 1 byte ------------------------------------------

// Memx Tcp Login Rejected Message
entrypoint typedef struct _LoginRejectedMessage {
  UINT8 login_reject_code;  // byte 0, values LOGIN_REJECT_CODE_
} LoginRejectedMessage;

// ---- Start Of Session Message: 8 bytes ---------------------------------------

// Memx Tcp Start of Session Message
entrypoint typedef struct _StartOfSessionMessage {
  UINT64BE session_id;  // bytes 0 to 7
} StartOfSessionMessage;

// ---- Replay Begin Message: 12 bytes ------------------------------------------

// Memx Tcp Replay Begin Message
entrypoint typedef struct _ReplayBeginMessage {
  UINT64BE next_sequence_number;   // bytes 0 to 7
  UINT32BE pending_message_count;  // bytes 8 to 11
} ReplayBeginMessage;

// ---- Replay Rejected Message: 1 byte -----------------------------------------

// Memx Tcp Replay Rejected Message
entrypoint typedef struct _ReplayRejectedMessage {
  UINT8 replay_reject_code;  // byte 0, values REPLAY_REJECT_CODE_
} ReplayRejectedMessage;

// ---- Replay Complete Message: 8 bytes ----------------------------------------

// Memx Tcp Replay Complete Message
entrypoint typedef struct _ReplayCompleteMessage {
  UINT64BE message_count;  // bytes 0 to 7
} ReplayCompleteMessage;

// ---- Stream Begin Message: 16 bytes ------------------------------------------

// Memx Tcp Stream Begin Message
entrypoint typedef struct _StreamBeginMessage {
  UINT64BE next_sequence_number;  // bytes 0 to 7
  UINT64BE max_sequence_number;   // bytes 8 to 15
} StreamBeginMessage;

// ---- Stream Rejected Message: 1 byte -----------------------------------------

// Memx Tcp Stream Rejected Message
entrypoint typedef struct _StreamRejectedMessage {
  UINT8 stream_reject_code;  // byte 0, values STREAM_REJECT_CODE_
} StreamRejectedMessage;

// ---- Stream Complete Message: 8 bytes ----------------------------------------

// Memx Tcp Stream Complete Message
entrypoint typedef struct _StreamCompleteMessage {
  UINT64BE total_sequence_count;  // bytes 0 to 7
} StreamCompleteMessage;

// ---- Sbe Header: 7 bytes -----------------------------------------------------

// Sbe Header
entrypoint typedef struct _SbeHeader {
  UINT16BE block_length;  // bytes 0 to 1
  UINT8 template_id;      // byte 2, values TEMPLATE_ID_
  UINT8 schema_id;        // byte 3
  UINT16BE version;       // bytes 4 to 5
  UINT8 num_groups;       // byte 6
} SbeHeader;

// ---- Repeating Group Dimensions: 2 bytes -------------------------------------

// RepeatingGroupDimensions
entrypoint typedef struct _RepeatingGroupDimensions {
  UINT8 block_length_short;  // byte 0
  UINT8 num_in_group;        // byte 1
} RepeatingGroupDimensions;

// ---- Execution Report Bulk Quote Component New Message: 83 bytes -------------

// ExecutionReport_BulkQuote_ComponentNewMessage
entrypoint typedef struct _ExecutionReportBulkQuoteComponentNewMessage {
  UINT64BE order_id;        // bytes 0 to 7
  UINT8 cl_ord_id[20];      // bytes 8 to 27
  UINT8 list_seq_no;        // byte 28
  UINT64BE exec_id;         // bytes 29 to 36
  UINT8 ord_status;         // byte 37, values ORD_STATUS_
  UINT8 security_id[8];     // bytes 38 to 45
  UINT8 side;               // byte 46, values SIDE_
  UINT32BE order_qty;       // bytes 47 to 50
  UINT64BE price_optional;  // bytes 51 to 58
  UINT32BE leaves_qty;      // bytes 59 to 62
  UINT32BE cum_qty;         // bytes 63 to 66
  UINT64BE sending_time;    // bytes 67 to 74
  UINT64BE transact_time;   // bytes 75 to 82
} ExecutionReportBulkQuoteComponentNewMessage;

// ---- Execution Report Rejected Message: 57 bytes -----------------------------

// ExecutionReport_RejectedMessage
entrypoint typedef struct _ExecutionReportRejectedMessage {
  UINT8 cl_ord_id[20];           // bytes 0 to 19
  UINT8 list_seq_no;             // byte 20
  UINT64BE exec_id;              // bytes 21 to 28
  UINT8 ord_status;              // byte 29, values ORD_STATUS_
  UINT16BE order_reject_reason;  // bytes 30 to 31, values ORDER_REJECT_REASON_
  UINT8 security_id[8];          // bytes 32 to 39
  UINT8 side;                    // byte 40, values SIDE_
  UINT32BE leaves_qty;           // bytes 41 to 44
  UINT32BE cum_qty;              // bytes 45 to 48
  UINT64BE sending_time;         // bytes 49 to 56
} ExecutionReportRejectedMessage;

