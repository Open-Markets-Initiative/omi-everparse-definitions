  UINT32BE leaves_qty;                // bytes 68 to 71
  UINT32BE cum_qty;                   // bytes 72 to 75
  UINT64BE sending_time;              // bytes 76 to 83
  UINT64BE transact_time;             // bytes 84 to 91
  UINT8 orig_list_seq_no;             // byte 92
} ExecutionReportCanceledMessage;

