  UINT8 list_seq_no;         // byte 28
  UINT8 orig_cl_ord_id[20];  // bytes 29 to 48
  UINT8 ord_status;          // byte 49, values ORD_STATUS_
  UINT8 security_id[8];      // bytes 50 to 57
  UINT8 side_optional;       // byte 58, values SIDE_OPTIONAL_
  UINT32BE leaves_qty;       // bytes 59 to 62
  UINT32BE cum_qty;          // bytes 63 to 66
  UINT64BE sending_time;     // bytes 67 to 74
