#define MASS_CANCEL_REJECT_REASON_INVALID_UNDERLYING_OR_SERIES 0x0007  // Invalid Underlying Or Series
#define MASS_CANCEL_REJECT_REASON_MISSING_UNDERLIER 0x0008             // Missing Underlier
#define MASS_CANCEL_REJECT_REASON_INVALID_UNDERLIER 0x0009             // Invalid Underlier
#define MASS_CANCEL_REJECT_REASON_MISSING_OPTIONS_SECURITY_ID 0x000A   // Missing Options Security Id
#define MASS_CANCEL_REJECT_REASON_INVALID_OPTIONS_SECURITY_ID 0x000B   // Invalid Options Security Id
#define MASS_CANCEL_REJECT_REASON_MISSING_CANCEL_GROUP_ID 0x000C       // Missing Cancel Group Id
#define MASS_CANCEL_REJECT_REASON_INVALID_CANCEL_GROUP_ID 0x000D       // Invalid Cancel Group Id
#define MASS_CANCEL_REJECT_REASON_MISSING_MASS_CANCEL_INST 0x000E      // Missing Mass Cancel Inst
#define MASS_CANCEL_REJECT_REASON_INVALID_MASS_CANCEL_INST 0x000F      // Invalid Mass Cancel Inst
#define MASS_CANCEL_REJECT_REASON_MASS_CANCEL_IN_PROGRESS 0x0011       // Mass Cancel In Progress
#define MASS_CANCEL_REJECT_REASON_NULL_VALUE 0xFFFF                    // Null Value

// Cxl Rej Response To: one byte code
#define CXL_REJ_RESPONSE_TO_ORDER_CANCEL_REQUEST 0x31          // Order Cancel Request
#define CXL_REJ_RESPONSE_TO_ORDER_CANCEL_REPLACE_REQUEST 0x32  // Order Cancel Replace Request

