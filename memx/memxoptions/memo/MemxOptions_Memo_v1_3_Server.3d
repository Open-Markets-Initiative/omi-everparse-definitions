// ExecutionReport_TradeBreakMessage
typedef struct _ExecutionReportTradeBreakMessage {
  UINT64BE order_id;      // bytes 0 to 7
  UINT8 cl_ord_id[20];    // bytes 8 to 27
  UINT64BE trd_match_id;  // bytes 28 to 35
  UINT64BE exec_id;       // bytes 36 to 43
  UINT64BE exec_ref_id;   // bytes 44 to 51
  UINT8 ord_status;       // byte 52
  UINT32BE leaves_qty;    // bytes 53 to 56
  UINT32BE cum_qty;       // bytes 57 to 60
  UINT64BE sending_time;  // bytes 61 to 68
} ExecutionReportTradeBreakMessage;

// ExecutionReport_RestatementMessage
typedef struct _ExecutionReportRestatementMessage {
  UINT64BE order_id;                  // bytes 0 to 7
  UINT8 cl_ord_id[20];                // bytes 8 to 27
  UINT8 list_seq_no;                  // byte 28
  UINT64BE exec_id;                   // bytes 29 to 36
  UINT8 ord_status;                   // byte 37
  UINT8 security_id[8];               // bytes 38 to 45
  UINT8 exec_restatement_reason;      // byte 46
  UINT8 extended_restatement_reason;  // byte 47
  UINT8 side;                         // byte 48
  UINT64BE last_px;                   // bytes 49 to 56
  UINT32BE last_qty_optional;         // bytes 57 to 60
  UINT32BE leaves_qty;                // bytes 61 to 64
  UINT32BE cum_qty;                   // bytes 65 to 68
  UINT64BE sending_time;              // bytes 69 to 76
  UINT64BE transact_time;             // bytes 77 to 84
} ExecutionReportRestatementMessage;

// PendingMassCancelMessage
typedef struct _PendingMassCancelMessage {
  UINT8 cl_ord_id[20];                          // bytes 0 to 19
  UINT8 lockout : 1;                            // byte 20
  UINT8 send_cancels : 1;                       // byte 20
  UINT8 cancel_orders_from_this_port_only : 1;  // byte 20
  UINT8 reserved_5 : 5;                         // byte 20
  UINT64BE lockout_id_optional;                 // bytes 21 to 28
  UINT8 efid_optional[4];                       // bytes 29 to 32
  UINT8 underlying_or_series;                   // byte 33
  UINT8 underlier_optional[6];                  // bytes 34 to 39
  UINT8 options_security_id_optional[8];        // bytes 40 to 47
  UINT16BE cancel_group_id;                     // bytes 48 to 49
  UINT64BE sending_time;                        // bytes 50 to 57
} PendingMassCancelMessage;

// MassCancelRejectMessage
typedef struct _MassCancelRejectMessage {
  UINT8 cl_ord_id[20];                          // bytes 0 to 19
  UINT16BE mass_cancel_reject_reason;           // bytes 20 to 21
  UINT8 efid_optional[4];                       // bytes 22 to 25
  UINT8 underlying_or_series;                   // byte 26
  UINT8 underlier_optional[6];                  // bytes 27 to 32
  UINT8 options_security_id_optional[8];        // bytes 33 to 40
  UINT16BE cancel_group_id;                     // bytes 41 to 42
  UINT8 lockout : 1;                            // byte 43
  UINT8 send_cancels : 1;                       // byte 43
  UINT8 cancel_orders_from_this_port_only : 1;  // byte 43
  UINT8 reserved_5 : 5;                         // byte 43
  UINT64BE sending_time;                        // bytes 44 to 51
} MassCancelRejectMessage;

// MassCancelDoneMessage
typedef struct _MassCancelDoneMessage {
  UINT8 cl_ord_id[20];             // bytes 0 to 19
  UINT32BE total_affected_orders;  // bytes 20 to 23
  UINT64BE sending_time;           // bytes 24 to 31
} MassCancelDoneMessage;

// OrderCancelRejectMessage
typedef struct _OrderCancelRejectMessage {
  UINT8 cl_ord_id[20];                    // bytes 0 to 19
  UINT8 list_seq_no;                      // byte 20
  UINT8 cxl_rej_response_to;              // byte 21
  UINT16BE cxl_rej_reason;                // bytes 22 to 23
  UINT8 options_security_id_optional[8];  // bytes 24 to 31
  UINT8 side_optional;                    // byte 32
  UINT64BE sending_time;                  // bytes 33 to 40
} OrderCancelRejectMessage;

// AllocationInstructionAckMessage
typedef struct _AllocationInstructionAckMessage {
  UINT64BE alloc_report_id;  // bytes 0 to 7
  UINT8 alloc_id[20];        // bytes 8 to 27
  UINT8 alloc_status;        // byte 28
  UINT16BE alloc_rej_code;   // bytes 29 to 30
  UINT64BE sending_time;     // bytes 31 to 38
} AllocationInstructionAckMessage;

// Parties Block
typedef struct _AllocationReportMessagePartiesGroups {
  UINT8 block_length_short;                                                                         // byte 0
  UINT8 num_in_group;                                                                               // byte 1
  PartiesGroup allocation_report_message_parties_group[:byte-size (((UINT32) num_in_group) * 18)];
} AllocationReportMessagePartiesGroups;

// Allocations
typedef struct _AllocationReportMessageAllocationsGroup (mutable UINT32 * tally) {
  UINT32BE alloc_qty;                                                                                                                                              // bytes 0 to 3
  UINT8 trading_capacity;                                                                                                                                          // byte 4
  UINT8 open_or_close;                                                                                                                                             // byte 5
  AllocationReportMessagePartiesGroups allocation_report_message_parties_groups;
  unit counted {:on-success var counted_so_far = *tally; if (counted_so_far < 4294967295) { *tally = counted_so_far + 1; return true; } else { return false; } };
} AllocationReportMessageAllocationsGroup;

// Allocations Block
typedef struct _AllocationReportMessageAllocationsGroups (UINT32 available, mutable UINT32 * tally) where (available >= 2) {
  UINT8 block_length_short;                                                                                                                                    // byte 0
  UINT8 num_in_group;                                                                                                                                          // byte 1
  unit allocation_report_message_allocations_group_tally_start {:on-success *tally = 0; return true; };
  AllocationReportMessageAllocationsGroup(tally) allocation_report_message_allocations_group[:byte-size (available - 2)];
  unit allocation_report_message_allocations_group_tally_check {:on-success var counted_so_far = *tally; return counted_so_far == ((UINT32) num_in_group); };
} AllocationReportMessageAllocationsGroups;

// AllocationReportMessage
typedef struct _AllocationReportMessage (UINT32 available, mutable UINT32 * tally) where (available >= 76) {
  UINT64BE alloc_report_id;                                                                                        // bytes 0 to 7
  UINT8 alloc_id[20];                                                                                              // bytes 8 to 27
  UINT8 alloc_trans_type;                                                                                          // byte 28
  UINT8 alloc_type;                                                                                                // byte 29
  UINT8 alloc_status;                                                                                              // byte 30
  UINT64BE exec_ref_id;                                                                                            // bytes 31 to 38
  UINT64BE trd_match_id;                                                                                           // bytes 39 to 46
  UINT8 security_id[8];                                                                                            // bytes 47 to 54
  UINT8 side;                                                                                                      // byte 55
  UINT32BE quantity_long;                                                                                          // bytes 56 to 59
  UINT8 trade_date[8];                                                                                             // bytes 60 to 67
  UINT64BE sending_time;                                                                                           // bytes 68 to 75
  AllocationReportMessageAllocationsGroups((available - 76), tally) allocation_report_message_allocations_groups;
} AllocationReportMessage;

// UserNotificationMessage
typedef struct _UserNotificationMessage {
  UINT64BE sending_time;  // bytes 0 to 7
  UINT8 user_status;      // byte 8
} UserNotificationMessage;

// MassCancelClearLockoutRejectMessage
typedef struct _MassCancelClearLockoutRejectMessage {
  UINT8 cl_ord_id[20];    // bytes 0 to 19
  UINT64BE lockout_id;    // bytes 20 to 27
  UINT16BE rej_reason;    // bytes 28 to 29
  UINT64BE sending_time;  // bytes 30 to 37
} MassCancelClearLockoutRejectMessage;

// MassCancelClearLockoutDoneMessage
typedef struct _MassCancelClearLockoutDoneMessage {
  UINT8 cl_ord_id[20];    // bytes 0 to 19
  UINT64BE lockout_id;    // bytes 20 to 27
  UINT64BE sending_time;  // bytes 28 to 35
} MassCancelClearLockoutDoneMessage;

// Memo message body sent by Memx to the firm
casetype _ServerPayload (UINT8 selector, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x0B: ExecutionReportNewMessage execution_report_new_message;
    case 0x0C: ExecutionReportBulkQuotePendingNewMessage execution_report_bulk_quote_pending_new_message;
    case 0x0D: ExecutionReportBulkQuoteComponentNewMessage execution_report_bulk_quote_component_new_message;
    case 0x0E: ExecutionReportRejectedMessage execution_report_rejected_message;
    case 0x0F: ExecutionReportTradeMessage execution_report_trade_message;
    case 0x10: ExecutionReportPendingCancelMessage execution_report_pending_cancel_message;
    case 0x11: ExecutionReportCanceledMessage execution_report_canceled_message;
    case 0x12: ExecutionReportPendingReplaceMessage execution_report_pending_replace_message;
    case 0x13: ExecutionReportReplacedMessage execution_report_replaced_message;
    case 0x14: ExecutionReportTradeCorrectionMessage execution_report_trade_correction_message;
    case 0x15: ExecutionReportTradeBreakMessage execution_report_trade_break_message;
    case 0x16: ExecutionReportRestatementMessage execution_report_restatement_message;
    case 0x17: PendingMassCancelMessage pending_mass_cancel_message;
    case 0x18: MassCancelRejectMessage mass_cancel_reject_message;
    case 0x19: MassCancelDoneMessage mass_cancel_done_message;
    case 0x1A: OrderCancelRejectMessage order_cancel_reject_message;
    case 0x1B: AllocationInstructionAckMessage allocation_instruction_ack_message;
    case 0x1C: AllocationReportMessage(available, tally) allocation_report_message;
    case 0x1D: UserNotificationMessage user_notification_message;
    case 0x1E: MassCancelClearLockoutRejectMessage mass_cancel_clear_lockout_reject_message;
    case 0x1F: MassCancelClearLockoutDoneMessage mass_cancel_clear_lockout_done_message;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Sbe message sent by Memx to the firm
typedef struct _ServerSbeMessage (UINT32 available, mutable UINT32 * tally) where (available >= 7) {
  UINT16BE block_length;                                                                                               // bytes 0 to 1
  UINT8 template_id;                                                                                                   // byte 2
  UINT8 schema_id;                                                                                                     // byte 3
  UINT16BE version;                                                                                                    // bytes 4 to 5
  UINT8 num_groups;                                                                                                    // byte 6
  ServerPayload(template_id, (available - 7), tally) server_payload[:byte-size-single-element-array (available - 7)];
} ServerSbeMessage;

// Memx Tcp sequenced message
typedef struct _SequencedMessage (UINT32 available, mutable UINT32 * tally) {
  ServerSbeMessage(available, tally) server_sbe_message;
} SequencedMessage;

// Session message body sent by Memx to the firm, dispatched on the message type
casetype _ServerData (UINT8 selector, UINT32 available, mutable UINT32 * tally) {
  switch (selector) {
    case 0x01: LoginAcceptedMessage login_accepted_message;
    case 0x02: LoginRejectedMessage login_rejected_message;
    case 0x03: StartOfSessionMessage start_of_session_message;
    case 0x05: ReplayBeginMessage replay_begin_message;
    case 0x06: ReplayRejectedMessage replay_rejected_message;
    case 0x07: ReplayCompleteMessage replay_complete_message;
    case 0x08: StreamBeginMessage stream_begin_message;
    case 0x09: StreamRejectedMessage stream_rejected_message;
    case 0x0A: StreamCompleteMessage stream_complete_message;
    case 0x0B: SequencedMessage(available, tally) sequenced_message;
    default: UINT8 unknown[available];
  }
} ServerData;

// ---- Packet: ServerPacket ----------------------------------------------------

// Memx Tcp packet sent by Memx to the firm
entrypoint typedef struct _ServerPacket (mutable UINT32 * tally) {
  UINT8 message_type;                                                                                                                 // byte 0
  UINT16BE message_length;                                                                                                            // bytes 1 to 2
  ServerData(message_type, ((UINT32) message_length), tally) server_data[:byte-size-single-element-array ((UINT32) message_length)];
} ServerPacket;

