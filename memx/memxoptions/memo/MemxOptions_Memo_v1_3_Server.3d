#define CANCEL_REASON_DUPLICATE_ORDER_THRESHOLD_EXCEEDED 0x20                   // Duplicate Order Threshold Exceeded
#define CANCEL_REASON_ORDER_RATE_THRESHOLD_EXCEEDED 0x21                        // Order Rate Threshold Exceeded
#define CANCEL_REASON_MARKET_ORDER_GROSS_NOTIONAL_VALUE_EXCEEDS_THRESHOLD 0x22  // Market Order Gross Notional Value Exceeds Threshold
#define CANCEL_REASON_MARKET_ORDER_NET_NOTIONAL_VALUE_EXCEEDS_THRESHOLD 0x23    // Market Order Net Notional Value Exceeds Threshold
#define CANCEL_REASON_NULL_VALUE 0xFF                                           // Null Value

// Exec Restatement Reason: one byte code
#define EXEC_RESTATEMENT_REASON_ORDER_REPRICE 0x03           // Order Reprice
#define EXEC_RESTATEMENT_REASON_MATCH_TRADE_PREVENTION 0x05  // Match Trade Prevention
#define EXEC_RESTATEMENT_REASON_OTHER 0x63                   // Other
#define EXEC_RESTATEMENT_REASON_NULL_VALUE 0xFF              // Null Value

// Extended Restatement Reason: one byte code
#define EXTENDED_RESTATEMENT_REASON_NONE 0x00                       // None
#define EXTENDED_RESTATEMENT_REASON_MATCH_TRADE_CANCEL_NEWEST 0x03  // Match Trade Cancel Newest
#define EXTENDED_RESTATEMENT_REASON_MATCH_TRADE_CANCEL_OLDEST 0x04  // Match Trade Cancel Oldest
#define EXTENDED_RESTATEMENT_REASON_MATCH_TRADE_CANCEL_BOTH 0x06    // Match Trade Cancel Both
#define EXTENDED_RESTATEMENT_REASON_NULL_VALUE 0xFF                 // Null Value

// Underlying Or Series: one byte code
#define UNDERLYING_OR_SERIES_CANCEL_ALL_ON_UNDERLYING 0x00  // Cancel All On Underlying
#define UNDERLYING_OR_SERIES_CANCEL_ALL_ON_SERIES 0x01      // Cancel All On Series
#define UNDERLYING_OR_SERIES_NULL_VALUE 0xFF                // Null Value

// Mass Cancel Reject Reason: 2 byte code
#define MASS_CANCEL_REJECT_REASON_OTHER 0x0000                         // Other
#define MASS_CANCEL_REJECT_REASON_DUPLICATE_CL_ORD_ID 0x0001           // Duplicate Cl Ord Id
#define MASS_CANCEL_REJECT_REASON_MISSING_CL_ORD_ID 0x0002             // Missing Cl Ord Id
#define MASS_CANCEL_REJECT_REASON_INVALID_CL_ORD_ID 0x0003             // Invalid Cl Ord Id
