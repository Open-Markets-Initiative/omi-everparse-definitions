#define CANCEL_REASON_ORDER_EXPIRED 0x08                    // Order Expired
#define CANCEL_REASON_LOCK_OR_CROSS_BOOK 0x09               // Lock Or Cross Book
#define CANCEL_REASON_SELF_TRADE_PREVENTION 0x0A            // Self Trade Prevention
#define CANCEL_REASON_INSUFFICIENT_QUOTES 0x0B              // Insufficient Quotes
#define CANCEL_REASON_NON_COMPLIANT_PRICE 0x0C              // Non Compliant Price
#define CANCEL_REASON_PARTICIPANT_DISCONNECT 0x0D           // Participant Disconnect
#define CANCEL_REASON_ORDER_NOT_BOOKABLE 0x0E               // Order Not Bookable
#define CANCEL_REASON_TRADE_PROTECTION_LIMITS 0x0F          // Trade Protection Limits
#define CANCEL_REASON_UNABLE_TO_ROUTE 0x10                  // Unable To Route
#define CANCEL_REASON_FIRM_DISABLED 0x11                    // Firm Disabled
#define CANCEL_REASON_MPID_DISABLED 0x12                    // Mpid Disabled
#define CANCEL_REASON_ACCOUNT_DISABLED 0x13                 // Account Disabled
#define CANCEL_REASON_NOTIONAL_EXPOSURE_RISK_BREACHED 0x14  // Notional Exposure Risk Breached
#define CANCEL_REASON_NULL_VALUE 0xFF                       // Null Value

// Exec Restatement Reason: one byte code
#define EXEC_RESTATEMENT_REASON_ORDER_REPRICE 0x03          // Order Reprice
#define EXEC_RESTATEMENT_REASON_SELF_TRADE_PREVENTION 0x05  // Self Trade Prevention
#define EXEC_RESTATEMENT_REASON_OTHER 0x63                  // Other
#define EXEC_RESTATEMENT_REASON_NULL_VALUE 0xFF             // Null Value

// Extended Restatement Reason: one byte code
#define EXTENDED_RESTATEMENT_REASON_NONE 0x00                             // None
#define EXTENDED_RESTATEMENT_REASON_SET_NBBO 0x01                         // Set Nbbo
#define EXTENDED_RESTATEMENT_REASON_JOINED_NBBO 0x02                      // Joined Nbbo
#define EXTENDED_RESTATEMENT_REASON_SELF_TRADE_CANCEL_NEWEST 0x03         // Self Trade Cancel Newest
#define EXTENDED_RESTATEMENT_REASON_SELF_TRADE_CANCEL_OLDEST 0x04         // Self Trade Cancel Oldest
#define EXTENDED_RESTATEMENT_REASON_SELF_TRADE_DECREMENT_AND_CANCEL 0x05  // Self Trade Decrement And Cancel
#define EXTENDED_RESTATEMENT_REASON_SELF_TRADE_CANCEL_BOTH 0x06           // Self Trade Cancel Both
#define EXTENDED_RESTATEMENT_REASON_SELF_TRADE_CANCEL_SMALLEST 0x07       // Self Trade Cancel Smallest
#define EXTENDED_RESTATEMENT_REASON_NULL_VALUE 0xFF                       // Null Value

// Cxl Rej Response To: one byte code
#define CXL_REJ_RESPONSE_TO_ORDER_CANCEL_REQUEST 0x31          // Order Cancel Request
#define CXL_REJ_RESPONSE_TO_ORDER_CANCEL_REPLACE_REQUEST 0x32  // Order Cancel Replace Request

// Cxl Rej Reason: one byte code
#define CXL_REJ_REASON_UNKNOWN_ORIG_ORDER 0x01                             // Unknown Orig Order
#define CXL_REJ_REASON_ORDER_IN_PENDING_STATE 0x03                         // Order In Pending State
#define CXL_REJ_REASON_DUPLICATE_CL_ORD_ID 0x06                            // Duplicate Cl Ord Id
#define CXL_REJ_REASON_INVALID_LIMIT_PRICE_INCREMENT 0x12                  // Invalid Limit Price Increment
#define CXL_REJ_REASON_OTHER 0x63                                          // Other
#define CXL_REJ_REASON_MISSING_SYMBOL 0x64                                 // Missing Symbol
#define CXL_REJ_REASON_MISSING_LOCATE 0x65                                 // Missing Locate
#define CXL_REJ_REASON_MISSING_CL_ORD_ID 0x66                              // Missing Cl Ord Id
#define CXL_REJ_REASON_INVALID_ORDER_QUANTITY 0x67                         // Invalid Order Quantity
#define CXL_REJ_REASON_INVALID_SYMBOL 0x68                                 // Invalid Symbol
#define CXL_REJ_REASON_INVALID_LIMIT_PRICE 0x69                            // Invalid Limit Price
#define CXL_REJ_REASON_SYMBOL_HALTED_OR_PAUSED 0x6B                        // Symbol Halted Or Paused
#define CXL_REJ_REASON_ORDER_SIZE_EXCEEDS_LIMIT 0x6C                       // Order Size Exceeds Limit
#define CXL_REJ_REASON_EXCEEDED_MAX_NOTIONAL_ORDER_AMT 0x6D                // Exceeded Max Notional Order Amt
#define CXL_REJ_REASON_MISSING_ORIG_ORDER_IDENTIFIERS 0x6E                 // Missing Orig Order Identifiers
#define CXL_REJ_REASON_AMBIGUOUS_ORIG_ORDER_IDENTIFIERS 0x6F               // Ambiguous Orig Order Identifiers
#define CXL_REJ_REASON_ORIG_ORDER_SYMBOL_NOT_MATCHING_REQUEST_SYMBOL 0x70  // Orig Order Symbol Not Matching Request Symbol
#define CXL_REJ_REASON_UNSUPPORTED_DISPLAY_QUANTITY_CHANGE 0x71            // Unsupported Display Quantity Change
#define CXL_REJ_REASON_UNSUPPORTED_ORD_TYPE_CHANGE 0x72                    // Unsupported Ord Type Change
#define CXL_REJ_REASON_UNSUPPORTED_SIDE_CHANGE 0x73                        // Unsupported Side Change
#define CXL_REJ_REASON_UNSUPPORTED_QUANTITY_CHANGE 0x74                    // Unsupported Quantity Change
#define CXL_REJ_REASON_INVALID_LOCATE 0x75                                 // Invalid Locate
#define CXL_REJ_REASON_EXCHANGE_CLOSED 0x76                                // Exchange Closed
#define CXL_REJ_REASON_BLOCK_SESSION_RISK_RULE_VIOLATED 0x77               // Block Session Risk Rule Violated
#define CXL_REJ_REASON_BLOCK_SELL_SHORT_RISK_RULE_VIOLATED 0x78            // Block Sell Short Risk Rule Violated
#define CXL_REJ_REASON_MAX_SHARES_PER_ORDER_RISK_RULE_BREACH 0x79          // Max Shares Per Order Risk Rule Breach
#define CXL_REJ_REASON_NO_NBBO_AVAILABLE 0x7A                              // No Nbbo Available
#define CXL_REJ_REASON_MAX_NOTIONAL_VALUE_PER_ORDER_RISK_RULE_BREACH 0x7B  // Max Notional Value Per Order Risk Rule Breach
#define CXL_REJ_REASON_MAX_ADV_PERCENT_PER_ORDER_RISK_RULE_BREACH 0x7C     // Max Adv Percent Per Order Risk Rule Breach
#define CXL_REJ_REASON_PRICE_PERCENT_COLLAR_RISK_RULE_VIOLATED 0x7D        // Price Percent Collar Risk Rule Violated
#define CXL_REJ_REASON_PRICE_VALUE_COLLAR_RISK_RULE_VIOLATED 0x7E          // Price Value Collar Risk Rule Violated
#define CXL_REJ_REASON_HARD_TO_BORROW_SECURITY_RISK_RULE_VIOLATED 0x7F     // Hard To Borrow Security Risk Rule Violated
#define CXL_REJ_REASON_INVALID_SIDE 0x80                                   // Invalid Side
#define CXL_REJ_REASON_INVALID_ORD_TYPE 0x81                               // Invalid Ord Type
#define CXL_REJ_REASON_INVALID_CL_ORD_ID 0x82                              // Invalid Cl Ord Id
#define CXL_REJ_REASON_INVALID_LNK_ID 0x83                                 // Invalid Lnk Id
#define CXL_REJ_REASON_NULL_VALUE 0xFF                                     // Null Value

// Mass Cancel Reject Reason: one byte code
#define MASS_CANCEL_REJECT_REASON_OTHER 0x00                                       // Other
#define MASS_CANCEL_REJECT_REASON_UNKNOWN_PRODUCT 0x01                             // Unknown Product
#define MASS_CANCEL_REJECT_REASON_UNKNOWN_SIDE 0x02                                // Unknown Side
#define MASS_CANCEL_REJECT_REASON_UNKNOWN_GROUP_ID 0x03                            // Unknown Group Id
#define MASS_CANCEL_REJECT_REASON_HIGHER_PRICE_LOWER_OR_EQUAL_TO_LOWER_PRICE 0x04  // Higher Price Lower Or Equal To Lower Price
#define MASS_CANCEL_REJECT_REASON_PRODUCT_MISSING_FOR_PRICE_RESTRICTION 0x05       // Product Missing For Price Restriction
#define MASS_CANCEL_REJECT_REASON_DUPLICATE_CL_ORD_ID 0x06                         // Duplicate Cl Ord Id
#define MASS_CANCEL_REJECT_REASON_MALFORMED_REQUEST_MISSING_CL_ORD_ID_FIELD 0x07   // Malformed Request Missing Cl Ord Id Field
#define MASS_CANCEL_REJECT_REASON_INVALID_CANCEL_GROUP_ID 0x08                     // Invalid Cancel Group Id
#define MASS_CANCEL_REJECT_REASON_INVALID_CL_ORD_ID 0x09                           // Invalid Cl Ord Id
#define MASS_CANCEL_REJECT_REASON_INVALID_LOWER_PRICE 0x0A                         // Invalid Lower Price
#define MASS_CANCEL_REJECT_REASON_INVALID_HIGHER_PRICE 0x0B                        // Invalid Higher Price
#define MASS_CANCEL_REJECT_REASON_NULL_VALUE 0xFF                                  // Null Value

// ---- Types -------------------------------------------------------------------

// Memx Tcp Login Accepted Message
typedef struct _LoginAcceptedMessage {
  UINT8 supported_request_mode;  // byte 0
} LoginAcceptedMessage;

// Memx Tcp Login Rejected Message
typedef struct _LoginRejectedMessage {
  UINT8 login_reject_code;  // byte 0
} LoginRejectedMessage;

// Memx Tcp Start of Session Message
typedef struct _StartOfSessionMessage {
  UINT64BE session_id;  // bytes 0 to 7
} StartOfSessionMessage;

// Memx Tcp Replay Begin Message
typedef struct _ReplayBeginMessage {
  UINT64BE next_sequence_number;   // bytes 0 to 7
  UINT32BE pending_message_count;  // bytes 8 to 11
} ReplayBeginMessage;

// Memx Tcp Replay Rejected Message
typedef struct _ReplayRejectedMessage {
  UINT8 replay_reject_code;  // byte 0
} ReplayRejectedMessage;

// Memx Tcp Replay Complete Message
typedef struct _ReplayCompleteMessage {
  UINT64BE message_count;  // bytes 0 to 7
} ReplayCompleteMessage;

// Memx Tcp Stream Begin Message
typedef struct _StreamBeginMessage {
  UINT64BE next_sequence_number;  // bytes 0 to 7
  UINT64BE max_sequence_number;   // bytes 8 to 15
} StreamBeginMessage;

// Memx Tcp Stream Rejected Message
typedef struct _StreamRejectedMessage {
  UINT8 stream_reject_code;  // byte 0
} StreamRejectedMessage;

// Memx Tcp Stream Complete Message
typedef struct _StreamCompleteMessage {
  UINT64BE total_sequence_count;  // bytes 0 to 7
} StreamCompleteMessage;

// ExecutionReport_PendingNewMessage
typedef struct _ExecutionReportPendingNewMessage {
  UINT64BE sending_time;                      // bytes 0 to 7
  UINT64BE order_id;                          // bytes 8 to 15
  UINT8 cl_ord_id[16];                        // bytes 16 to 31
  UINT64BE exec_id;                           // bytes 32 to 39
  UINT8 mpid_optional[4];                     // bytes 40 to 43
  UINT8 ord_status;                           // byte 44
  UINT8 symbol[6];                            // bytes 45 to 50
  UINT8 symbol_sfx[6];                        // bytes 51 to 56
  UINT8 side;                                 // byte 57
  UINT8 ord_type;                             // byte 58
  UINT32BE order_qty;                         // bytes 59 to 62
  UINT64BE price;                             // bytes 63 to 70, signed, read here as unsigned
  UINT8 time_in_force;                        // byte 71
  UINT8 order_capacity;                       // byte 72
  UINT8 cust_order_capacity;                  // byte 73
  UINT16BE reserved_4_to_16 : 13;             // bytes 74 to 75
  UINT16BE external_routing_not_allowed : 1;  // bytes 74 to 75
  UINT16BE intermarket_sweep : 1;             // bytes 74 to 75
  UINT16BE participate_do_not_initiate : 1;   // bytes 74 to 75
  UINT64BE peg_offset_value;                  // bytes 76 to 83, signed, read here as unsigned
  UINT8 peg_price_type;                       // byte 84
  UINT64BE expire_time;                       // bytes 85 to 92
  UINT32BE min_qty;                           // bytes 93 to 96
  UINT32BE display_qty;                       // bytes 97 to 100
  UINT8 display_method;                       // byte 101
  UINT8 reserve_replenish_timing;             // byte 102
  UINT32BE display_min_incr;                  // bytes 103 to 106
  UINT8 locate_reqd;                          // byte 107
  UINT8 reprice_frequency;                    // byte 108
  UINT8 reprice_behavior;                     // byte 109
  UINT16BE cancel_group_id;                   // bytes 110 to 111
  UINT16BE stp_group_id;                      // bytes 112 to 113
  UINT8 self_trade_prevention;                // byte 114
  UINT16BE risk_group_id;                     // bytes 115 to 116
  UINT32BE leaves_qty;                        // bytes 117 to 120
  UINT32BE cum_qty;                           // bytes 121 to 124
  UINT8 link_id_optional[4];                  // bytes 125 to 128
} ExecutionReportPendingNewMessage;

// ExecutionReport_NewMessage
typedef struct _ExecutionReportNewMessage {
  UINT64BE sending_time;                      // bytes 0 to 7
  UINT64BE order_id;                          // bytes 8 to 15
  UINT8 cl_ord_id[16];                        // bytes 16 to 31
  UINT64BE exec_id;                           // bytes 32 to 39
  UINT8 mpid_optional[4];                     // bytes 40 to 43
  UINT8 ord_status;                           // byte 44
  UINT8 symbol[6];                            // bytes 45 to 50
  UINT8 symbol_sfx[6];                        // bytes 51 to 56
  UINT8 side;                                 // byte 57
  UINT8 ord_type;                             // byte 58
  UINT32BE order_qty;                         // bytes 59 to 62
  UINT64BE price;                             // bytes 63 to 70, signed, read here as unsigned
  UINT8 time_in_force;                        // byte 71
  UINT8 order_capacity;                       // byte 72
  UINT8 cust_order_capacity;                  // byte 73
  UINT16BE reserved_4_to_16 : 13;             // bytes 74 to 75
  UINT16BE external_routing_not_allowed : 1;  // bytes 74 to 75
  UINT16BE intermarket_sweep : 1;             // bytes 74 to 75
  UINT16BE participate_do_not_initiate : 1;   // bytes 74 to 75
  UINT64BE peg_offset_value;                  // bytes 76 to 83, signed, read here as unsigned
  UINT8 peg_price_type;                       // byte 84
  UINT64BE expire_time;                       // bytes 85 to 92
  UINT32BE min_qty;                           // bytes 93 to 96
  UINT32BE display_qty;                       // bytes 97 to 100
  UINT8 display_method;                       // byte 101
  UINT8 reserve_replenish_timing;             // byte 102
  UINT32BE display_min_incr;                  // bytes 103 to 106
  UINT8 locate_reqd;                          // byte 107
  UINT8 reprice_frequency;                    // byte 108
  UINT8 reprice_behavior;                     // byte 109
  UINT16BE cancel_group_id;                   // bytes 110 to 111
  UINT16BE stp_group_id;                      // bytes 112 to 113
  UINT8 self_trade_prevention;                // byte 114
  UINT16BE risk_group_id;                     // bytes 115 to 116
  UINT32BE leaves_qty;                        // bytes 117 to 120
  UINT32BE cum_qty;                           // bytes 121 to 124
  UINT64BE transact_time;                     // bytes 125 to 132
  UINT8 link_id_optional[4];                  // bytes 133 to 136
} ExecutionReportNewMessage;

// ExecutionReport_RejectedMessage
typedef struct _ExecutionReportRejectedMessage {
  UINT64BE sending_time;      // bytes 0 to 7
  UINT8 cl_ord_id[16];        // bytes 8 to 23
  UINT64BE exec_id;           // bytes 24 to 31
  UINT8 ord_status;           // byte 32
  UINT8 symbol[6];            // bytes 33 to 38
  UINT8 symbol_sfx[6];        // bytes 39 to 44
  UINT32BE leaves_qty;        // bytes 45 to 48
  UINT32BE cum_qty;           // bytes 49 to 52
  UINT8 order_reject_reason;  // byte 53
  UINT8 link_id_optional[4];  // bytes 54 to 57
} ExecutionReportRejectedMessage;

// ExecutionReport_TradeMessage
typedef struct _ExecutionReportTradeMessage {
  UINT64BE sending_time;      // bytes 0 to 7
  UINT64BE order_id;          // bytes 8 to 15
  UINT8 cl_ord_id[16];        // bytes 16 to 31
  UINT64BE exec_id;           // bytes 32 to 39
  UINT8 ord_status;           // byte 40
  UINT32BE last_qty;          // bytes 41 to 44
  UINT64BE last_px;           // bytes 45 to 52, signed, read here as unsigned
  UINT32BE leaves_qty;        // bytes 53 to 56
  UINT32BE cum_qty;           // bytes 57 to 60
  UINT64BE transact_time;     // bytes 61 to 68
  UINT8 last_liquidity_ind;   // byte 69
  UINT8 last_mkt;             // byte 70
  UINT64BE trd_matching_id;   // bytes 71 to 78
  UINT8 link_id_optional[4];  // bytes 79 to 82
} ExecutionReportTradeMessage;

// ExecutionReport_PendingCancelMessage
typedef struct _ExecutionReportPendingCancelMessage {
  UINT64BE sending_time;              // bytes 0 to 7
  UINT64BE order_id;                  // bytes 8 to 15
  UINT8 cl_ord_id[16];                // bytes 16 to 31
  UINT8 orig_cl_ord_id_optional[16];  // bytes 32 to 47
  UINT64BE exec_id;                   // bytes 48 to 55
  UINT8 symbol[6];                    // bytes 56 to 61
  UINT8 symbol_sfx[6];                // bytes 62 to 67
  UINT8 ord_status;                   // byte 68
  UINT32BE leaves_qty;                // bytes 69 to 72
  UINT32BE cum_qty;                   // bytes 73 to 76
  UINT8 link_id_optional[4];          // bytes 77 to 80
} ExecutionReportPendingCancelMessage;

// PendingMassCancelMessage
typedef struct _PendingMassCancelMessage {
  UINT64BE sending_time;       // bytes 0 to 7
  UINT8 cl_ord_id[16];         // bytes 8 to 23
  UINT8 symbol[6];             // bytes 24 to 29
  UINT8 symbol_sfx[6];         // bytes 30 to 35
  UINT8 side_optional;         // byte 36
  UINT64BE lower_than_price;   // bytes 37 to 44, signed, read here as unsigned
  UINT64BE higher_than_price;  // bytes 45 to 52, signed, read here as unsigned
  UINT16BE cancel_group_id;    // bytes 53 to 54
} PendingMassCancelMessage;

// ExecutionReport_CanceledMessage
typedef struct _ExecutionReportCanceledMessage {
  UINT64BE sending_time;              // bytes 0 to 7
  UINT8 cl_ord_id[16];                // bytes 8 to 23
  UINT8 orig_cl_ord_id_optional[16];  // bytes 24 to 39
  UINT64BE order_id;                  // bytes 40 to 47
  UINT64BE exec_id;                   // bytes 48 to 55
  UINT8 ord_status;                   // byte 56
  UINT32BE leaves_qty;                // bytes 57 to 60
  UINT32BE cum_qty;                   // bytes 61 to 64
  UINT8 cancel_reason;                // byte 65
  UINT64BE transact_time;             // bytes 66 to 73
  UINT8 link_id_optional[4];          // bytes 74 to 77
} ExecutionReportCanceledMessage;

// MassCancelDoneMessage
typedef struct _MassCancelDoneMessage {
  UINT64BE sending_time;  // bytes 0 to 7
  UINT8 cl_ord_id[16];    // bytes 8 to 23
} MassCancelDoneMessage;

// ExecutionReport_PendingReplaceMessage
typedef struct _ExecutionReportPendingReplaceMessage {
  UINT64BE sending_time;              // bytes 0 to 7
  UINT64BE order_id;                  // bytes 8 to 15
  UINT8 cl_ord_id[16];                // bytes 16 to 31
  UINT8 orig_cl_ord_id_optional[16];  // bytes 32 to 47
  UINT64BE exec_id;                   // bytes 48 to 55
  UINT8 symbol[6];                    // bytes 56 to 61
  UINT8 symbol_sfx[6];                // bytes 62 to 67
  UINT8 side;                         // byte 68
  UINT32BE order_qty;                 // bytes 69 to 72
  UINT8 ord_type;                     // byte 73
  UINT64BE price;                     // bytes 74 to 81, signed, read here as unsigned
  UINT32BE display_qty;               // bytes 82 to 85
  UINT8 locate_reqd;                  // byte 86
  UINT8 ord_status;                   // byte 87
  UINT32BE leaves_qty;                // bytes 88 to 91
  UINT32BE cum_qty;                   // bytes 92 to 95
  UINT8 link_id_optional[4];          // bytes 96 to 99
} ExecutionReportPendingReplaceMessage;

// ExecutionReport_ReplacedMessage
typedef struct _ExecutionReportReplacedMessage {
  UINT64BE sending_time;              // bytes 0 to 7
  UINT64BE order_id;                  // bytes 8 to 15
  UINT8 cl_ord_id[16];                // bytes 16 to 31
  UINT8 orig_cl_ord_id_optional[16];  // bytes 32 to 47
  UINT64BE exec_id;                   // bytes 48 to 55
  UINT8 symbol[6];                    // bytes 56 to 61
  UINT8 symbol_sfx[6];                // bytes 62 to 67
  UINT8 side;                         // byte 68
  UINT32BE order_qty;                 // bytes 69 to 72
  UINT8 ord_type;                     // byte 73
  UINT64BE price;                     // bytes 74 to 81, signed, read here as unsigned
  UINT32BE display_qty;               // bytes 82 to 85
  UINT8 locate_reqd;                  // byte 86
  UINT8 ord_status;                   // byte 87
  UINT32BE leaves_qty;                // bytes 88 to 91
  UINT32BE cum_qty;                   // bytes 92 to 95
  UINT64BE transact_time;             // bytes 96 to 103
  UINT8 link_id_optional[4];          // bytes 104 to 107
} ExecutionReportReplacedMessage;

// ExecutionReport_TradeCorrectionMessage
typedef struct _ExecutionReportTradeCorrectionMessage {
  UINT64BE sending_time;       // bytes 0 to 7
  UINT64BE order_id;           // bytes 8 to 15
  UINT8 cl_ord_id[16];         // bytes 16 to 31
  UINT64BE exec_id;            // bytes 32 to 39
  UINT64BE exec_ref_id;        // bytes 40 to 47
  UINT64BE trd_match_id;       // bytes 48 to 55
  UINT8 ord_status;            // byte 56
  UINT64BE last_px;            // bytes 57 to 64, signed, read here as unsigned
  UINT32BE last_qty_optional;  // bytes 65 to 68
  UINT32BE leaves_qty;         // bytes 69 to 72
  UINT32BE cum_qty;            // bytes 73 to 76
  UINT8 link_id_optional[4];   // bytes 77 to 80
} ExecutionReportTradeCorrectionMessage;

// ExecutionReport_TradeBreakMessage
typedef struct _ExecutionReportTradeBreakMessage {
  UINT64BE sending_time;      // bytes 0 to 7
  UINT64BE order_id;          // bytes 8 to 15
  UINT8 cl_ord_id[16];        // bytes 16 to 31
  UINT64BE exec_id;           // bytes 32 to 39
  UINT64BE exec_ref_id;       // bytes 40 to 47
  UINT64BE trd_match_id;      // bytes 48 to 55
  UINT8 ord_status;           // byte 56
  UINT32BE leaves_qty;        // bytes 57 to 60
  UINT32BE cum_qty;           // bytes 61 to 64
  UINT8 link_id_optional[4];  // bytes 65 to 68
} ExecutionReportTradeBreakMessage;

// ExecutionReport_RestatementMessage
typedef struct _ExecutionReportRestatementMessage {
  UINT64BE sending_time;              // bytes 0 to 7
  UINT64BE order_id;                  // bytes 8 to 15
  UINT8 cl_ord_id[16];                // bytes 16 to 31
  UINT64BE exec_id;                   // bytes 32 to 39
  UINT8 ord_status;                   // byte 40
  UINT64BE last_px_optional;          // bytes 41 to 48, signed, read here as unsigned
  UINT32BE leaves_qty;                // bytes 49 to 52
  UINT32BE cum_qty;                   // bytes 53 to 56
  UINT32BE last_shares;               // bytes 57 to 60
  UINT8 exec_restatement_reason;      // byte 61
  UINT64BE transact_time;             // bytes 62 to 69
  UINT8 extended_restatement_reason;  // byte 70
  UINT8 link_id_optional[4];          // bytes 71 to 74
} ExecutionReportRestatementMessage;

// OrderCancelRejectMessage
typedef struct _OrderCancelRejectMessage {
  UINT64BE sending_time;      // bytes 0 to 7
  UINT8 cl_ord_id[16];        // bytes 8 to 23
  UINT8 cxl_rej_response_to;  // byte 24
  UINT8 cxl_rej_reason;       // byte 25
  UINT8 link_id_optional[4];  // bytes 26 to 29
} OrderCancelRejectMessage;

// MassCancelRejectMessage
typedef struct _MassCancelRejectMessage {
  UINT64BE sending_time;            // bytes 0 to 7
  UINT8 cl_ord_id[16];              // bytes 8 to 23
  UINT8 symbol[6];                  // bytes 24 to 29
  UINT8 symbol_sfx[6];              // bytes 30 to 35
  UINT8 side_optional;              // byte 36
  UINT64BE lower_than_price;        // bytes 37 to 44, signed, read here as unsigned
  UINT64BE higher_than_price;       // bytes 45 to 52, signed, read here as unsigned
  UINT16BE cancel_group_id;         // bytes 53 to 54
  UINT8 mass_cancel_reject_reason;  // byte 55
} MassCancelRejectMessage;

// Memo message body sent by Memx to the firm
casetype _ServerPayload (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x05: ExecutionReportPendingNewMessage execution_report_pending_new_message;
    case 0x06: ExecutionReportNewMessage execution_report_new_message;
    case 0x07: ExecutionReportRejectedMessage execution_report_rejected_message;
    case 0x08: ExecutionReportTradeMessage execution_report_trade_message;
    case 0x09: ExecutionReportPendingCancelMessage execution_report_pending_cancel_message;
    case 0x0A: PendingMassCancelMessage pending_mass_cancel_message;
    case 0x0B: ExecutionReportCanceledMessage execution_report_canceled_message;
    case 0x0C: MassCancelDoneMessage mass_cancel_done_message;
    case 0x0D: ExecutionReportPendingReplaceMessage execution_report_pending_replace_message;
    case 0x0E: ExecutionReportReplacedMessage execution_report_replaced_message;
    case 0x0F: ExecutionReportTradeCorrectionMessage execution_report_trade_correction_message;
    case 0x10: ExecutionReportTradeBreakMessage execution_report_trade_break_message;
    case 0x11: ExecutionReportRestatementMessage execution_report_restatement_message;
    case 0x12: OrderCancelRejectMessage order_cancel_reject_message;
    case 0x14: MassCancelRejectMessage mass_cancel_reject_message;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Sbe message sent by Memx to the firm
typedef struct _ServerSbeMessage (UINT32 available) where (available >= 6) {
  UINT16BE block_length;                                                                                        // bytes 0 to 1
  UINT8 template_id;                                                                                            // byte 2
  UINT8 schema_id;                                                                                              // byte 3
  UINT16BE version;                                                                                             // bytes 4 to 5
  ServerPayload(template_id, (available - 6)) server_payload[:byte-size-single-element-array (available - 6)];
} ServerSbeMessage;

// Memx Tcp sequenced message
typedef struct _SequencedMessage (UINT32 available) {
  ServerSbeMessage(available) server_sbe_message;
} SequencedMessage;

// Session message body sent by Memx to the firm, dispatched on the message type
casetype _ServerData (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x01: LoginAcceptedMessage login_accepted_message;
    case 0x02: LoginRejectedMessage login_rejected_message;
    case 0x03: StartOfSessionMessage start_of_session_message;
    case 0x05: ReplayBeginMessage replay_begin_message;
    case 0x06: ReplayRejectedMessage replay_rejected_message;
    case 0x07: ReplayCompleteMessage replay_complete_message;
    case 0x08: StreamBeginMessage stream_begin_message;
    case 0x09: StreamRejectedMessage stream_rejected_message;
    case 0x0A: StreamCompleteMessage stream_complete_message;
    case 0x0B: SequencedMessage(available) sequenced_message;
    default: UINT8 unknown[available];
  }
} ServerData;

// ---- Packet: ServerPacket ----------------------------------------------------

// Memx Tcp packet sent by Memx to the firm
entrypoint typedef struct _ServerPacket {
  UINT8 message_type;                                                                                                          // byte 0
  UINT16BE message_length;                                                                                                     // bytes 1 to 2
  ServerData(message_type, ((UINT32) message_length)) server_data[:byte-size-single-element-array ((UINT32) message_length)];
} ServerPacket;

