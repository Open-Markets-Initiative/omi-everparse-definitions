  UINT8 schema_id;        // byte 3
  UINT16BE version;       // bytes 4 to 5
} SbeHeader;

// ---- Order Cancel Replace Request Message: 63 bytes --------------------------

// OrderCancelReplaceRequestMessage
entrypoint typedef struct _OrderCancelReplaceRequestMessage {
