// ---- Common Header: 3 bytes --------------------------------------------------

// Tcp Common Header
entrypoint typedef struct _CommonHeader {
  UINT8 message_type;       // byte 0
  UINT16BE message_length;  // bytes 1 to 2
} CommonHeader;

// ---- Login Request Message: 2 bytes ------------------------------------------

// Memx Tcp Login message
entrypoint typedef struct _LoginRequestMessage {
  UINT8 token_type;  // byte 0
  UINT8 token;       // byte 1
} LoginRequestMessage;

// ---- Replay Request Message: 20 bytes ----------------------------------------

// Memx Tcp Replay Request message
entrypoint typedef struct _ReplayRequestMessage {
  UINT64BE session_id;            // bytes 0 to 7
  UINT64BE next_sequence_number;  // bytes 8 to 15
  UINT32BE count;                 // bytes 16 to 19
} ReplayRequestMessage;

// ---- Replay All Request Message: 8 bytes -------------------------------------

// Memx Tcp Replay All Request message
entrypoint typedef struct _ReplayAllRequestMessage {
  UINT64BE session_id;  // bytes 0 to 7
} ReplayAllRequestMessage;

// ---- Stream Request Message: 16 bytes ----------------------------------------

// Memx Tcp Stream Request message
entrypoint typedef struct _StreamRequestMessage {
  UINT64BE session_id;            // bytes 0 to 7
  UINT64BE next_sequence_number;  // bytes 8 to 15
} StreamRequestMessage;

// ---- Sbe Header: 6 bytes -----------------------------------------------------

// Sbe Header
entrypoint typedef struct _SbeHeader {
  UINT16BE block_length;  // bytes 0 to 1
