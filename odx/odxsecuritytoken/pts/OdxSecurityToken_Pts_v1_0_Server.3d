// ---- Server Packet Header: 3 bytes -------------------------------------------

// Packet header of a packet sent by the server
entrypoint typedef struct _ServerPacketHeader {
  UINT16BE packet_length;    // bytes 0 to 1
  UINT8 server_packet_type;  // byte 2
} ServerPacketHeader;

// ---- Login Accepted Packet: 30 bytes -----------------------------------------

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
entrypoint typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// ---- Login Rejected Packet: 1 byte -------------------------------------------

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
entrypoint typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// ---- Seconds Message: 4 bytes ------------------------------------------------

// Reflects the number of seconds past midnight.
entrypoint typedef struct _SecondsMessage {
  UINT32BE seconds;  // bytes 0 to 3
} SecondsMessage;

// ---- System Event Message: 9 bytes -------------------------------------------

// System Event Messages signal data feed, system and market events.
entrypoint typedef struct _SystemEventMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT8 group[4];        // bytes 4 to 7
  UINT8 system_event;    // byte 8
} SystemEventMessage;

// ---- Price Tick Size Message: 16 bytes ---------------------------------------

// The Price Tick Size Message is used to communicate tick size information for a given price range.
entrypoint typedef struct _PriceTickSizeMessage {
  UINT32BE nanoseconds;               // bytes 0 to 3
  UINT32BE price_tick_size_table_id;  // bytes 4 to 7
  UINT32BE price_tick_size;           // bytes 8 to 11
  UINT32BE price_start;               // bytes 12 to 15
} PriceTickSizeMessage;

// ---- Orderbook Directory Message: 59 bytes -----------------------------------

// The Orderbook Directory Message is used to disseminate orderbook information for all active orderbooks.
entrypoint typedef struct _OrderbookDirectoryMessage {
  UINT32BE nanoseconds;               // bytes 0 to 3
  UINT8 orderbook_id[4];              // bytes 4 to 7
  UINT8 orderbook_code[12];           // bytes 8 to 19
  UINT8 exchange_symbol[12];          // bytes 20 to 31
  UINT8 group[4];                     // bytes 32 to 35
  UINT32BE round_lot_size;            // bytes 36 to 39
  UINT32BE price_tick_size_table_id;  // bytes 40 to 43
  UINT32BE price_decimals;            // bytes 44 to 47
  UINT32BE upper_price_limit;         // bytes 48 to 51
  UINT32BE lower_price_limit;         // bytes 52 to 55
  UINT8 restriction_of_market_order;  // byte 56
  UINT8 attention_flag;               // byte 57
  UINT8 termination_flag;             // byte 58
} OrderbookDirectoryMessage;

// ---- Trading State Message: 13 bytes -----------------------------------------

// The Trading State Message is used to indicate the current trading state of an orderbook.
entrypoint typedef struct _TradingStateMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT8 orderbook_id[4];  // bytes 4 to 7
  UINT8 group[4];         // bytes 8 to 11
  UINT8 trading_state;    // byte 12
} TradingStateMessage;

// ---- Order Added Message: 29 bytes -------------------------------------------

// An Order Added Message is generated each time a new order is accepted by the ODX PTS execution system.
entrypoint typedef struct _OrderAddedMessage {
  UINT32BE nanoseconds;      // bytes 0 to 3
  UINT64BE order_number;     // bytes 4 to 11
  UINT8 buy_sell_indicator;  // byte 12
  UINT32BE quantity;         // bytes 13 to 16
  UINT8 orderbook_id[4];     // bytes 17 to 20
  UINT8 group[4];            // bytes 21 to 24
  UINT32BE price;            // bytes 25 to 28
} OrderAddedMessage;

// ---- Order Executed With Price Message: 29 bytes -----------------------------

// An Order Executed with Price Message is sent whenever an order on the book is executed in whole or in part with a specific trade price.
entrypoint typedef struct _OrderExecutedWithPriceMessage {
  UINT32BE nanoseconds;        // bytes 0 to 3
  UINT64BE order_number;       // bytes 4 to 11
  UINT32BE executed_quantity;  // bytes 12 to 15
  UINT64BE match_number;       // bytes 16 to 23
  UINT32BE trade_price;        // bytes 24 to 27
  UINT8 occurred_as_cross;     // byte 28
} OrderExecutedWithPriceMessage;

// ---- Order Deleted Message: 12 bytes -----------------------------------------

// An Order Deleted Message is sent whenever an order on the book is cancelled.
entrypoint typedef struct _OrderDeletedMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT64BE order_number;  // bytes 4 to 11
} OrderDeletedMessage;

// ---- Order Replaced Message: 28 bytes ----------------------------------------

// An Order Replaced Message is sent whenever an order on the book is replaced.
entrypoint typedef struct _OrderReplacedMessage {
  UINT32BE nanoseconds;            // bytes 0 to 3
  UINT64BE original_order_number;  // bytes 4 to 11
  UINT64BE new_order_number;       // bytes 12 to 19
  UINT32BE quantity;               // bytes 20 to 23
  UINT32BE price;                  // bytes 24 to 27
} OrderReplacedMessage;

// ---- Order Book State Message: 28 bytes --------------------------------------

// The Order Book State Message is used to communicate the state of an orderbook.
entrypoint typedef struct _OrderBookStateMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT8 orderbook_id[4];  // bytes 4 to 7
  UINT8 state_name[20];   // bytes 8 to 27
} OrderBookStateMessage;

// ---- Equilibrium Price Update Message: 12 bytes ------------------------------

// The Equilibrium Price Update Message is used to communicate the equilibrium price of an orderbook during an auction period.
entrypoint typedef struct _EquilibriumPriceUpdateMessage {
  UINT32BE nanoseconds;        // bytes 0 to 3
  UINT8 orderbook_id[4];       // bytes 4 to 7
  UINT32BE equilibrium_price;  // bytes 8 to 11
} EquilibriumPriceUpdateMessage;

