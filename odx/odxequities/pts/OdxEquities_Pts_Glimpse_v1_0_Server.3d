// Osaka Digital Exchange Proprietary Trading System
//
// Generated from the binary model, in the 3d language of EverParse. From this file everparse
// writes a C validator for each record below and proves, of that C, that it reads no byte
// outside the buffer it is given, reads no byte twice, and accepts exactly the byte strings
// the record describes.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
//
// Verify and write the validators: everparse.sh --odir out OdxEquities_Pts_Glimpse_v1_0_Server.3d
//
// What this definition does not state, and the model does:
// - a run filling what frames it
// - a length prefix framing what follows
//
// License: MIT No Attribution

// ---- Server Packet Header: 3 bytes -------------------------------------------

// Packet header of a packet sent by the server
entrypoint typedef struct _ServerPacketHeader {
  UINT16BE packet_length;    // bytes 0 to 1
  UINT8 server_packet_type;  // byte 2
} ServerPacketHeader;

// ---- Login Accepted Packet: 30 bytes -----------------------------------------

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
entrypoint typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// ---- Login Rejected Packet: 1 byte -------------------------------------------

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
entrypoint typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// ---- Seconds Message: 4 bytes ------------------------------------------------

// Reflects the number of seconds past midnight
entrypoint typedef struct _SecondsMessage {
  UINT32BE seconds;  // bytes 0 to 3
} SecondsMessage;

// ---- System Event Message: 9 bytes -------------------------------------------

// System Event Messages signal data feed, system and market events
entrypoint typedef struct _SystemEventMessage {
  UINT32BE nanoseconds;  // bytes 0 to 3
  UINT8 group[4];        // bytes 4 to 7
  UINT8 system_event;    // byte 8
} SystemEventMessage;

// ---- Price Tick Size Message: 16 bytes ---------------------------------------

// Price Tick Size Messages define a set of price tick size tables
entrypoint typedef struct _PriceTickSizeMessage {
  UINT32BE nanoseconds;               // bytes 0 to 3
  UINT32BE price_tick_size_table_id;  // bytes 4 to 7
  UINT32BE price_tick_size;           // bytes 8 to 11
  UINT32BE price_start;               // bytes 12 to 15
} PriceTickSizeMessage;

// ---- Orderbook Directory Message: 44 bytes -----------------------------------

// Orderbook Directory Messages provide information about orderbooks available in the ODX PTS execution system
entrypoint typedef struct _OrderbookDirectoryMessage {
  UINT32BE nanoseconds;               // bytes 0 to 3
  UINT32BE orderbook_id;              // bytes 4 to 7
  UINT8 orderbook_code[12];           // bytes 8 to 19
  UINT8 group[4];                     // bytes 20 to 23
  UINT32BE round_lot_size;            // bytes 24 to 27
  UINT32BE price_tick_size_table_id;  // bytes 28 to 31
  UINT32BE price_decimals;            // bytes 32 to 35
  UINT32BE upper_price_limit;         // bytes 36 to 39
  UINT32BE lower_price_limit;         // bytes 40 to 43
} OrderbookDirectoryMessage;

// ---- Trading State Message: 13 bytes -----------------------------------------

// A Trading State Message indicates the current trading status of an orderbook
entrypoint typedef struct _TradingStateMessage {
  UINT32BE nanoseconds;   // bytes 0 to 3
  UINT32BE orderbook_id;  // bytes 4 to 7
  UINT8 group[4];         // bytes 8 to 11
  UINT8 trading_state;    // byte 12
} TradingStateMessage;

// ---- Short Selling Price Restriction State Message: 13 bytes -----------------

// A Short Selling Price Restriction State Message indicates the current short selling price restriction status of an orderbook
entrypoint typedef struct _ShortSellingPriceRestrictionStateMessage {
  UINT32BE nanoseconds;       // bytes 0 to 3
  UINT32BE orderbook_id;      // bytes 4 to 7
  UINT8 group[4];             // bytes 8 to 11
  UINT8 short_selling_state;  // byte 12
} ShortSellingPriceRestrictionStateMessage;

// ---- Order Added Message: 29 bytes -------------------------------------------

// An Order Added Message indicates that an order exists in the ODX PTS execution system displayable book
entrypoint typedef struct _OrderAddedMessage {
  UINT32BE nanoseconds;      // bytes 0 to 3
  UINT64BE order_number;     // bytes 4 to 11
  UINT8 buy_sell_indicator;  // byte 12
  UINT32BE quantity;         // bytes 13 to 16
  UINT32BE orderbook_id;     // bytes 17 to 20
  UINT8 group[4];            // bytes 21 to 24
  UINT32BE price;            // bytes 25 to 28
} OrderAddedMessage;

// ---- Order Added With Attributes Message: 34 bytes ---------------------------

// An Order Added with Attributes Message is generated for orders with market specific attributes present in the system
entrypoint typedef struct _OrderAddedWithAttributesMessage {
  UINT32BE nanoseconds;      // bytes 0 to 3
  UINT64BE order_number;     // bytes 4 to 11
  UINT8 buy_sell_indicator;  // byte 12
  UINT32BE quantity;         // bytes 13 to 16
  UINT32BE orderbook_id;     // bytes 17 to 20
  UINT8 group[4];            // bytes 21 to 24
  UINT32BE price;            // bytes 25 to 28
  UINT8 attribution[4];      // bytes 29 to 32
  UINT8 order_type;          // byte 33
} OrderAddedWithAttributesMessage;

// ---- End Of Snapshot Message: 8 bytes ----------------------------------------

// The End of Snapshot Message provides the next sequence number of the real-time Itch market data feed at the time the snapshot was taken
entrypoint typedef struct _EndOfSnapshotMessage {
  UINT64BE sequence_number;  // bytes 0 to 7
} EndOfSnapshotMessage;

