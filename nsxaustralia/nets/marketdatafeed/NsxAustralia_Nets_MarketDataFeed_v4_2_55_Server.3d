// type, every length framing what it measures and every count of what it counts.
//
// An integer is read at its width and in its byte order. 3d has unsigned integers only, so a
// signed field is declared unsigned and marked. Every other field is the bytes it occupies.
// A field the protocol lists values for names them as constants, which document the codes and
// do not constrain them: a code the document does not list is still accepted.
//
// Verify and write the validators: everparse.sh --odir out NsxAustralia_Nets_MarketDataFeed_v4_2_55_Server.3d

// ---- Values ------------------------------------------------------------------

// Server Packet Type: one byte code
#define SERVER_PACKET_TYPE_DEBUG_PACKET 0x2B             // Debug Packet
#define SERVER_PACKET_TYPE_LOGIN_ACCEPTED_PACKET 0x41    // Login Accepted Packet
#define SERVER_PACKET_TYPE_LOGIN_REJECTED_PACKET 0x4A    // Login Rejected Packet
#define SERVER_PACKET_TYPE_SEQUENCED_DATA_PACKET 0x53    // Sequenced Data Packet
#define SERVER_PACKET_TYPE_SERVER_HEARTBEAT_PACKET 0x48  // Server Heartbeat Packet
#define SERVER_PACKET_TYPE_END_OF_SESSION_PACKET 0x5A    // End Of Session Packet

// Reject Reason Code: one byte code
#define REJECT_REASON_CODE_NOT_AUTHORIZED 0x41         // Not Authorized
#define REJECT_REASON_CODE_SESSION_NOT_AVAILABLE 0x53  // Session Not Available

// Sequenced Message Type: one byte code
#define SEQUENCED_MESSAGE_TYPE_TIMESTAMP_MESSAGE 0x54                  // Timestamp Message
#define SEQUENCED_MESSAGE_TYPE_SYSTEM_EVENT_MESSAGE 0x53               // System Event Message
#define SEQUENCED_MESSAGE_TYPE_PRICE_TICK_SIZE_MESSAGE 0x4C            // Price Tick Size Message
#define SEQUENCED_MESSAGE_TYPE_QUANTITY_TICK_SIZE_MESSAGE 0x4D         // Quantity Tick Size Message
#define SEQUENCED_MESSAGE_TYPE_ORDERBOOK_DIRECTORY_MESSAGE 0x52        // Orderbook Directory Message
#define SEQUENCED_MESSAGE_TYPE_ORDERBOOK_TRADING_ACTION_MESSAGE 0x48   // Orderbook Trading Action Message
#define SEQUENCED_MESSAGE_TYPE_ORDERBOOK_ATTRIBUTE_MESSAGE 0x58        // Orderbook Attribute Message
#define SEQUENCED_MESSAGE_TYPE_FIRM_DIRECTORY_MESSAGE 0x46             // Firm Directory Message
#define SEQUENCED_MESSAGE_TYPE_ADD_ORDER_MESSAGE 0x41                  // Add Order Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_EXECUTED_MESSAGE 0x45             // Order Executed Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_EXECUTED_WITH_PRICE_MESSAGE 0x43  // Order Executed With Price Message
#define SEQUENCED_MESSAGE_TYPE_BROKEN_TRADE_MESSAGE 0x42               // Broken Trade Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_DELETE_MESSAGE 0x44               // Order Delete Message
#define SEQUENCED_MESSAGE_TYPE_ORDER_REPLACE_MESSAGE 0x55              // Order Replace Message
#define SEQUENCED_MESSAGE_TYPE_INDICATIVE_PRICE_QUANTITY_MESSAGE 0x49  // Indicative Price Quantity Message
#define SEQUENCED_MESSAGE_TYPE_TRADE_MESSAGE 0x50                      // Trade Message
#define SEQUENCED_MESSAGE_TYPE_NEWS_MESSAGE 0x4E                       // News Message
#define SEQUENCED_MESSAGE_TYPE_INDEX_MEMBER_DIRECTORY_MESSAGE 0x59     // Index Member Directory Message
#define SEQUENCED_MESSAGE_TYPE_INDEX_VALUE_MESSAGE 0x5A                // Index Value Message

// Event Status: one byte code
#define EVENT_STATUS_SCHEDULED 0x53  // Scheduled
#define EVENT_STATUS_CANCELED 0x43   // Canceled
#define EVENT_STATUS_TRIGGERED 0x54  // Triggered

// Asset Type: one byte code
#define ASSET_TYPE_DEBT 0x44    // Debt
#define ASSET_TYPE_EQUITY 0x45  // Equity
#define ASSET_TYPE_INDEX 0x49   // Index

// Trading State: one byte code
#define TRADING_STATE_NORMAL_TRADING 0x54  // Normal Trading
#define TRADING_STATE_SUSPENDED 0x56       // Suspended

// Reason: one byte code
#define REASON_NORMAL_TRADING 0x4E                     // Normal Trading
#define REASON_HALTED_DUE_TO_EXTREME_TRADE_RANGE 0x48  // Halted Due To Extreme Trade Range
#define REASON_SUPERVISORY 0x53                        // Supervisory

// Attribute Type: one byte code
#define ATTRIBUTE_TYPE_PREVIOUS_DAY_CLOSE 0x52          // Previous Day Close
#define ATTRIBUTE_TYPE_CLOSE_PRICE 0x43                 // Close Price
#define ATTRIBUTE_TYPE_ETR_UPPER_LIMIT_PERCENTAGE 0x44  // Etr Upper Limit Percentage
#define ATTRIBUTE_TYPE_ETR_LOWER_LIMIT_PERCENTAGE 0x64  // Etr Lower Limit Percentage
#define ATTRIBUTE_TYPE_AOT_UPPER_LIMIT_PERCENTAGE 0x50  // Aot Upper Limit Percentage
#define ATTRIBUTE_TYPE_AOT_LOWER_LIMIT_PERCENTAGE 0x70  // Aot Lower Limit Percentage
#define ATTRIBUTE_TYPE_AOT_REFERENCE_PRICE 0x41         // Aot Reference Price
#define ATTRIBUTE_TYPE_ETR_REFERENCE_PRICE 0x42         // Etr Reference Price

// Order Verb: one byte code
#define ORDER_VERB_BUY 0x42   // Buy
#define ORDER_VERB_SELL 0x53  // Sell

// Printable: one byte code
#define PRINTABLE_YES 0x59  // Yes
#define PRINTABLE_NO 0x4E   // No

// Cross Type: one byte code
#define CROSS_TYPE_OPENING_AUCTION 0x4F   // Opening Auction
#define CROSS_TYPE_INTRADAY_AUCTION 0x49  // Intraday Auction
#define CROSS_TYPE_CLOSING_AUCTION 0x43   // Closing Auction

// Trade Indicator: one byte code
#define TRADE_INDICATOR_BLOCK_SPECIAL 0x42  // Block Special

// Trade Source: one byte code
#define TRADE_SOURCE_AUTOTRADE 0x41                                                    // Autotrade
#define TRADE_SOURCE_BEST_EXECUTION 0x42                                               // Best Execution
#define TRADE_SOURCE_OFF_MARKET_AUTOMATIC_CROSSING 0x43                                // Off Market Automatic Crossing
#define TRADE_SOURCE_DIRECTED_REPORTING_OR_OFF_MARKET_TRADES_CROSSING 0x44             // Directed Reporting Or Off Market Trades Crossing
#define TRADE_SOURCE_SPECIAL_CROSSING_LESS_THAN_A_MARKETABLE_PARCEL_CROSSING 0x45      // Special Crossing Less Than A Marketable Parcel Crossing
#define TRADE_SOURCE_FORWARD_DELIVERY 0x46                                             // Forward Delivery
#define TRADE_SOURCE_APPROVED_INDEX_CROSSING 0x49                                      // Approved Index Crossing
#define TRADE_SOURCE_BUY_BACK_SALES 0x4B                                               // Buy Back Sales
#define TRADE_SOURCE_MARRIAGE_CROSSING 0x4D                                            // Marriage Crossing
#define TRADE_SOURCE_TRADES_INCLUDING_CROSSINGS_OUTSIDE_OF_MARKET_HOURS 0x4E           // Trades Including Crossings Outside Of Market Hours
#define TRADE_SOURCE_FOREIGN_RESIDENTS_OR_RECOGNISED_OVERSEAS_EXCHANGE 0x4F            // Foreign Residents Or Recognised Overseas Exchange
#define TRADE_SOURCE_BLOCK_SPECIAL_CROSSING_OR_LOAN_SECURITIES 0x50                    // Block Special Crossing Or Loan Securities
#define TRADE_SOURCE_SPECIAL_CROSSING_LESS_THAN_A_MARKETABLE_PARCEL 0x51               // Special Crossing Less Than A Marketable Parcel
#define TRADE_SOURCE_STRATEGY 0x52                                                     // Strategy
#define TRADE_SOURCE_SHORT_SALES 0x53                                                  // Short Sales
#define TRADE_SOURCE_FOR_FOREIGN_TO_FOREIGN_SECURITIES 0x55                            // For Foreign To Foreign Securities
#define TRADE_SOURCE_BOOK_VALUE_SWITCH_SALES 0x56                                      // Book Value Switch Sales
#define TRADE_SOURCE_PORTFOLIO_SPECIAL_CROSSING 0x58                                   // Portfolio Special Crossing
#define TRADE_SOURCE_SPECIAL 0x59                                                      // Special
#define TRADE_SOURCE_SPECIAL_CROSSING_UNDERWRITING_DISPOSAL_OR_EXCHANGE_APPROVAL 0x5A  // Special Crossing Underwriting Disposal Or Exchange Approval

// ---- Types -------------------------------------------------------------------

// Debug packets are intended to provide human readable text that may aid in debugging problems
typedef struct _DebugPacket (UINT16 packet_length) where (packet_length >= 1) {
  UINT8 debug_text[(((UINT32) packet_length) - 1)];
} DebugPacket;

// The SoupBinTCP server sends a Login Accepted Packet in response to receiving a valid Login Request from the client
typedef struct _LoginAcceptedPacket {
  UINT8 accepted_session[10];          // bytes 0 to 9
  UINT8 accepted_sequence_number[20];  // bytes 10 to 29
} LoginAcceptedPacket;

// The SoupBinTCP server sends this packet in response to an invalid Login Request Packet from the client
typedef struct _LoginRejectedPacket {
  UINT8 reject_reason_code;  // byte 0
} LoginRejectedPacket;

// This message is sent to provide the time since Epoch. It should be used in combination with the Timestamp field of individual messages to determine the exact time for each message.
typedef struct _TimestampMessage {
  UINT64BE nanosecond;  // bytes 0 to 7
} TimestampMessage;

// This message will be sent to provide information about events that are scheduled or triggered by the system. Events may occur at Orderbook, Board, Board+Product or System level.
typedef struct _SystemEventMessage {
  UINT32BE timestamp;       // bytes 0 to 3
  UINT8 group[20];          // bytes 4 to 23
  UINT8 product[12];        // bytes 24 to 35
  UINT32BE orderbook;       // bytes 36 to 39
  UINT8 event_code[12];     // bytes 40 to 51
  UINT8 event_status;       // byte 52
  UINT64BE scheduled_time;  // bytes 53 to 60
} SystemEventMessage;

// This message provides the price ticks (steps) for the orderbooks in the system. It should be used as a lookup from Orderbook Directory R messages.
typedef struct _PriceTickSizeMessage {
  UINT32BE timestamp;           // bytes 0 to 3
  UINT32BE tick_size_table_id;  // bytes 4 to 7
  UINT64BE tick_size;           // bytes 8 to 15
  UINT64BE price_start;         // bytes 16 to 23
} PriceTickSizeMessage;

// This message provides the quantity ticks (steps) for the orderbooks in the system. It should be used as a lookup from Orderbook Directory R messages.
typedef struct _QuantityTickSizeMessage {
  UINT32BE timestamp;           // bytes 0 to 3
  UINT32BE tick_size_table_id;  // bytes 4 to 7
  UINT64BE tick_size;           // bytes 8 to 15
  UINT64BE quantity_start;      // bytes 16 to 23
} QuantityTickSizeMessage;

// Orderbook Directory Messages are transmitted during the reference data spin. Static data messages are sent at the beginning of the feed and contain exchange reference information.
typedef struct _OrderbookDirectoryMessage {
  UINT32BE timestamp;                    // bytes 0 to 3
  UINT32BE orderbook;                    // bytes 4 to 7
  UINT8 isin[12];                        // bytes 8 to 19
  UINT8 security_code[100];              // bytes 20 to 119
  UINT8 security_name[100];              // bytes 120 to 219
  UINT8 currency[3];                     // bytes 220 to 222
  UINT8 board[20];                       // bytes 223 to 242
  UINT8 product[12];                     // bytes 243 to 254
  UINT64BE minimum_quantity;             // bytes 255 to 262
  UINT32BE quantity_tick_size_table_id;  // bytes 263 to 266
  UINT32BE quantity_decimals;            // bytes 267 to 270
  UINT32BE price_tick_size_table_id;     // bytes 271 to 274
  UINT32BE price_decimals;               // bytes 275 to 278
  UINT64BE listing;                      // bytes 279 to 286
  UINT64BE expiry;                       // bytes 287 to 294
  UINT8 asset_type;                      // byte 295
  UINT32BE settle_date;                  // bytes 296 to 299
  UINT8 reference_alpha_12[12];          // bytes 300 to 311
  UINT8 remarks[8];                      // bytes 312 to 319
} OrderbookDirectoryMessage;

// This message indicates the current trading state of an orderbook.
typedef struct _OrderbookTradingActionMessage {
  UINT32BE timestamp;   // bytes 0 to 3
  UINT32BE orderbook;   // bytes 4 to 7
  UINT8 trading_state;  // byte 8
  UINT8 reason;         // byte 9
} OrderbookTradingActionMessage;

// This message provides dynamic reference values for an orderbook.
typedef struct _OrderbookAttributeMessage {
  UINT32BE timestamp;        // bytes 0 to 3
  UINT32BE orderbook;        // bytes 4 to 7
  UINT64BE attribute_value;  // bytes 8 to 15, signed, read here as unsigned
  UINT8 attribute_type;      // byte 16
  UINT8 reason;              // byte 17
} OrderbookAttributeMessage;

// This message provides reference information about system participants.
typedef struct _FirmDirectoryMessage {
  UINT32BE timestamp;   // bytes 0 to 3
  UINT32BE firm_id;     // bytes 4 to 7
  UINT8 firm_code[30];  // bytes 8 to 37
} FirmDirectoryMessage;

// This message is sent when an order is added to the orderbook.
typedef struct _AddOrderMessage {
  UINT32BE timestamp;     // bytes 0 to 3
  UINT64BE order_number;  // bytes 4 to 11
  UINT8 order_verb;       // byte 12
  UINT64BE quantity;      // bytes 13 to 20
  UINT32BE orderbook;     // bytes 21 to 24
  UINT64BE price;         // bytes 25 to 32, signed, read here as unsigned
  UINT32BE firm_id;       // bytes 33 to 36
} AddOrderMessage;

// This message is sent when an order on the book is executed in whole or in part.
typedef struct _OrderExecutedMessage {
  UINT32BE timestamp;          // bytes 0 to 3
  UINT64BE order_number;       // bytes 4 to 11
  UINT64BE executed_quantity;  // bytes 12 to 19
  UINT64BE match_number;       // bytes 20 to 27
  UINT8 printable;             // byte 28
  UINT32BE aggressor_firm_id;  // bytes 29 to 32
} OrderExecutedMessage;

// This message is sent when an order on the book is executed in whole or in part at a negotiated price different from the order price.
typedef struct _OrderExecutedWithPriceMessage {
  UINT32BE timestamp;          // bytes 0 to 3
  UINT64BE order_number;       // bytes 4 to 11
  UINT64BE executed_quantity;  // bytes 12 to 19
  UINT64BE match_number;       // bytes 20 to 27
  UINT8 printable;             // byte 28
  UINT64BE execution_price;    // bytes 29 to 36, signed, read here as unsigned
} OrderExecutedWithPriceMessage;

// This message is sent when a trade is cancelled.
typedef struct _BrokenTradeMessage {
  UINT32BE timestamp;     // bytes 0 to 3
  UINT64BE match_number;  // bytes 4 to 11
  UINT8 reason;           // byte 12
} BrokenTradeMessage;

// This message indicates when an order has been removed from the orderbook.
typedef struct _OrderDeleteMessage {
  UINT32BE timestamp;     // bytes 0 to 3
  UINT64BE order_number;  // bytes 4 to 11
} OrderDeleteMessage;

// This message indicates when an order in the orderbook has been modified.
typedef struct _OrderReplaceMessage {
  UINT32BE timestamp;              // bytes 0 to 3
  UINT64BE original_order_number;  // bytes 4 to 11
  UINT64BE new_order_number;       // bytes 12 to 19
  UINT64BE quantity;               // bytes 20 to 27
  UINT64BE price;                  // bytes 28 to 35, signed, read here as unsigned
} OrderReplaceMessage;

// This message provides auction information including the theoretical opening price and quantity.
typedef struct _IndicativePriceQuantityMessage {
  UINT32BE timestamp;                     // bytes 0 to 3
  UINT64BE theoretical_opening_quantity;  // bytes 4 to 11
  UINT32BE orderbook;                     // bytes 12 to 15
  UINT64BE best_bid;                      // bytes 16 to 23, signed, read here as unsigned
  UINT64BE best_offer;                    // bytes 24 to 31, signed, read here as unsigned
  UINT64BE theoretical_opening_price;     // bytes 32 to 39, signed, read here as unsigned
  UINT8 cross_type;                       // byte 40
  UINT64BE best_bid_size;                 // bytes 41 to 48
  UINT64BE best_offer_size;               // bytes 49 to 56
} IndicativePriceQuantityMessage;

// This message is sent to provide information about off-book matching.
typedef struct _TradeMessage {
  UINT32BE timestamp;          // bytes 0 to 3
  UINT64BE executed_quantity;  // bytes 4 to 11
  UINT32BE orderbook;          // bytes 12 to 15
  UINT8 printable;             // byte 16
  UINT64BE execution_price;    // bytes 17 to 24, signed, read here as unsigned
  UINT64BE match_number;       // bytes 25 to 32
  UINT8 trade_indicator;       // byte 33
  UINT32BE buy_firm_id;        // bytes 34 to 37
  UINT32BE sell_firm_id;       // bytes 38 to 41
  UINT8 trade_source;          // byte 42
} TradeMessage;

// This message disseminates exchange news.
typedef struct _NewsMessage {
  UINT32BE timestamp;                             // bytes 0 to 3
  UINT32BE orderbook;                             // bytes 4 to 7
  UINT32BE news_id;                               // bytes 8 to 11
  UINT8 firm_code[30];                            // bytes 12 to 41
  UINT8 title[81];                                // bytes 42 to 122
  UINT8 reference_null_terminated_char_256[256];  // bytes 123 to 378
  UINT8 news_text[512];                           // bytes 379 to 890
} NewsMessage;

// This message provides details about index members and their respective weightings within an index.
typedef struct _IndexMemberDirectoryMessage {
  UINT32BE timestamp;         // bytes 0 to 3
  UINT32BE index_orderbook;   // bytes 4 to 7
  UINT32BE member_orderbook;  // bytes 8 to 11
  UINT64BE weight;            // bytes 12 to 19
} IndexMemberDirectoryMessage;

// This message disseminates index values to market participants.
typedef struct _IndexValueMessage {
  UINT32BE timestamp;        // bytes 0 to 3
  UINT32BE index_orderbook;  // bytes 4 to 7
  UINT64BE index_value;      // bytes 8 to 15
} IndexValueMessage;

// The sequenced (server to client) message carried by the packet, opaque bytes unless an application source dispatches it
casetype _SequencedMessage (UINT8 selector, UINT32 available) {
  switch (selector) {
    case 0x54: TimestampMessage timestamp_message;
    case 0x53: SystemEventMessage system_event_message;
    case 0x4C: PriceTickSizeMessage price_tick_size_message;
    case 0x4D: QuantityTickSizeMessage quantity_tick_size_message;
    case 0x52: OrderbookDirectoryMessage orderbook_directory_message;
    case 0x48: OrderbookTradingActionMessage orderbook_trading_action_message;
    case 0x58: OrderbookAttributeMessage orderbook_attribute_message;
    case 0x46: FirmDirectoryMessage firm_directory_message;
    case 0x41: AddOrderMessage add_order_message;
    case 0x45: OrderExecutedMessage order_executed_message;
    case 0x43: OrderExecutedWithPriceMessage order_executed_with_price_message;
    case 0x42: BrokenTradeMessage broken_trade_message;
    case 0x44: OrderDeleteMessage order_delete_message;
    case 0x55: OrderReplaceMessage order_replace_message;
    case 0x49: IndicativePriceQuantityMessage indicative_price_quantity_message;
    case 0x50: TradeMessage trade_message;
    case 0x4E: NewsMessage news_message;
    case 0x59: IndexMemberDirectoryMessage index_member_directory_message;
    case 0x5A: IndexValueMessage index_value_message;
    default: UINT8 unknown[available];
  }
} SequencedMessage;

// The Sequenced Data Packets act as an envelope to carry the actual sequenced data messages that are transferred from the server to the client. Each Sequenced Data Packet carries one message from the higher-lever protocol
typedef struct _SequencedDataPacket (UINT16 packet_length) where (packet_length >= 2) {
  UINT8 sequenced_message_type;                                                                                                                                // byte 0
  SequencedMessage(sequenced_message_type, (((UINT32) packet_length) - 2)) sequenced_message[:byte-size-single-element-array (((UINT32) packet_length) - 2)];
} SequencedDataPacket;

// Branch
casetype _ServerPayload (UINT8 selector, UINT32 length, UINT16 packet_length, UINT32 available) {
  switch (selector) {
    case 0x2B: DebugPacket(packet_length) debug_packet;
    case 0x41: LoginAcceptedPacket login_accepted_packet;
    case 0x4A: LoginRejectedPacket login_rejected_packet;
    case 0x53: SequencedDataPacket(packet_length) sequenced_data_packet[:byte-size-single-element-array length];
    case 0x48: unit server_heartbeat;
    case 0x5A: unit end_of_session;
    default: UINT8 unknown[available];
  }
} ServerPayload;

// Soup Bin Tcp Packet sent by the server
typedef struct _ServerSoupBinTcpPacket {
  UINT16BE packet_length { packet_length >= 1 };                                                                                                                                                                // bytes 0 to 1
  UINT8 server_packet_type;                                                                                                                                                                                     // byte 2
  ServerPayload(server_packet_type, (((UINT32) packet_length) - 1), packet_length, ((((UINT32) packet_length) + 2) - 3)) server_payload[:byte-size-single-element-array ((((UINT32) packet_length) + 2) - 3)];
} ServerSoupBinTcpPacket;

// ---- Packet: ServerPacket ----------------------------------------------------

// SoupBinTCP Packet sent by the server
entrypoint typedef struct _ServerPacket (UINT32 available) {
  ServerSoupBinTcpPacket server_soup_bin_tcp_packet[:byte-size available];
} ServerPacket;

